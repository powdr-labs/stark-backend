    let d_input_ptrs = input_ptrs.to_device()?;\n2030\t            let d_output_ptrs = output_ptrs.to_device()?;\n2031\t            let d_log_output_heights = log_output_heights.to_device()?;\n2032\t            let d_widths = widths.to_device()?;\n2033\t\n2034\t            unsafe {\n2035\t                batch_fold_mle(\n2036\t                    &d_input_ptrs,\n2037\t                    &d_output_ptrs,\n2038\t                    &d_widths,\n2039\t                    num_matrices.try_into().unwrap(),\n2040\t                    &d_log_output_heights,\n2041\t                    max_output_cells.try_into().unwrap(),\n2042\t                    r_round,\n2043\t                )\n2044\t                .map_err(LogupZerocheckError::BatchFoldMle)?;\n2045\t            }\n2046\t            output_mats.extend_from_slice(&input_mats[num_matrices..]);\n2047\t            Ok(output_mats)\n2048\t        };\n2049\t\n2050\t        // Fold mat_evals_per_trace: Vec<Vec<DeviceMatrix<EF>>>\n2051\t        self.mat_evals_per_trace = {\n2052\t            let lengths = self\n2053\t                .mat_evals_per_trace\n2054\t                .iter()\n2055\t                .map(|v| v.len())\n2056\t                .collect_vec();\n2057\t            let input_mats = std::mem::take(&mut self.mat_evals_per_trace)\n2058\t                .into_iter()\n2059\t                .flatten()\n2060\t                .collect_vec();\n2061\t            let mut output_mats = batch_fold(input_mats)?.into_iter();\n2062\t            lengths\n2063\t                .into_iter()\n2064\t                .map(|len| output_mats.by_ref().take(len).collect())\n2065\t                .collect()\n2066\t        };\n2067\t        if self.save_memory {\n2068\t            self.memory_limit_bytes = self.gkr_mem_contribution.saturating_sub(\n2069\t                self.mat_evals_per_trace\n2070\t                    .iter()\n2071\t                    .flatten()\n2072\t                    .map(|m| m.buffer().len() * size_of::<EF>())\n20