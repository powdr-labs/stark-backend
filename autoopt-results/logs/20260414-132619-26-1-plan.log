orig: Vec<EF> = (0..air_width)\n2132\t                        .map(|col| values[col * height]) // height=1, so values[col]\n2133\t                        .collect();\n2134\t                    let rot: Option<Vec<EF>> = if need_rot {\n2135\t                        Some(\n2136\t                            (air_width..width)\n2137\t                                .map(|col| values[col * height]) // height=1, so values[col]\n2138\t                                .collect(),\n2139\t                        )\n2140\t                    } else {\n2141\t                        None\n2142\t                    };\n2143\t\n2144\t                    Ok(vec![\n2145\t                        Some(ColMajorMatrix::new(orig, air_width)),\n2146\t                        rot.map(|mat| ColMajorMatrix::new(mat, air_width)),\n2147\t                    ])\n2148\t                })\n2149\t                .collect::<Result<Vec<_>, MemCopyError>>()?\n2150\t                .into_iter()\n2151\t                .flatten()\n2152\t                .collect();\n2153\t\n2154\t            // Order of mats after splitting is:\n2155\t            // - preprocessed (if has_preprocessed),\n2156\t            // - preprocessed_rot (if has_preprocessed),\n2157\t            // - cached(0), cached(0)_rot, ...\n2158\t            // - common_main\n2159\t            // - common_main_rot\n2160\t            // For column openings, we pop common_main, common_main_rot and put it at the front\n2161\t            assert_eq!(\n2162\t                split_mats.len() % 2,\n2163\t                0,\n2164\t                \"Should have even number of matrices after splitting\"\n2165\t            );\n2166\t            let common_main_rot = split_mats.pop().unwrap();\n2167\t            let common_main = split_mats.pop().unwrap();\n2168\t\n2169\t            let openings_of_air = iter::once(&[common_main, common_main_rot] as &[_])\n2170\t                .chain(split_mats.chunks_exact(2))\n2171\t                .map(|pair| {\n2172\t