{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013LDc6jPoZEMxd1cQJT1sT2","type":"tool_result","content":"120\t}\n121\t\n122\t/// `d` must be the stacked pcs data of a single trace matrix.\n123\t/// This function will transport `d` to device and then unstack it (allocating device memory) to\n124\t/// return `CommittedTraceData<F, Digest>`.\n125\tpub fn transport_and_unstack_single_data_h2d<HS: GpuHashScheme>(\n126\t    d: &StackedPcsData<F, HS::Digest>,\n127\t    prover_config: &GpuProverConfig,\n128\t) -> Result<CommittedTraceData<GenericGpuBackend<HS>>, ProverError> {\n129\t    let _span = info_span!(\"transport_unstack_h2d\").entered();\n130\t    debug_assert!(d\n131\t        .layout\n132\t        .sorted_cols\n133\t        .iter()\n134\t        .all(|(mat_idx, _, _)| *mat_idx == 0));\n135\t    let l_skip = d.layout.l_skip();\n136\t    let trace_view = d.mat_view(0);\n137\t    let height = trace_view.height();\n138\t    let width = trace_view.width();\n139\t    let stride = trace_view.stride();\n140\t    let lifted_height = height * stride;\n141\t    debug_assert_eq!(lifted_height, max(height, 1 << l_skip));\n142\t    debug_assert_eq!(lifted_height * width, trace_view.values().len());\n143\t    debug_assert!(d.matrix.values.len() >= lifted_height * width);\n144\t    let stacked_width = d.matrix.width();\n145\t    let stacked_height = d.matrix.height();\n146\t    let d_matrix_evals = d.matrix.values.to_device()?;\n147\t    let strided_trace = DeviceBuffer::<F>::with_capacity(lifted_height * width);\n148\t    // SAFETY: D2D copy\n149\t    // - `d_matrix_evals` is the stacked matrix, guaranteed to have length `>= lifted_height *\n150\t    //   width` by definition of stacking\n151\t    // - `d_matrix_evals` stacks a single trace matrix\n152\t    unsafe {\n153\t        cuda_memcpy::<true, true>(\n154\t            strided_trace.as_mut_raw_ptr(),\n155\t            d_matrix_evals.as_raw_ptr(),\n156\t            lifted_height * width * size_of::<F>(),\n157\t        )?;\n158\t    }\n159\t    let trace_buffer = if stride == 1 {\n160\t        strided_trace\n161\t    } else {\n162\t        let buf = DeviceBuffer::<F>::with_capacity(height * width);\n163\t        unsafe {\n164\t            collapse_strided_matrix(\n165\t                buf.as_mut_ptr(),\n166\t                strided_trace.as_ptr(),\n167\t                width as u32,\n168\t                height as u32,\n169\t                stride as u32,\n170\t            )\n171\t            .map_err(ProverError::CollapseStrided)?;\n172\t        }\n173\t        // Wait for kernel to finish so we can safely drop strided_trace\n174\t        current_stream_sync().map_err(ProverError::CurrentStreamSync)?;\n175\t        drop(strided_trace);\n176\t        buf\n177\t    };\n178\t    let d_matrix = prover_config\n179\t        .cache_stacked_matrix\n180\t        .then(|| PleMatrix::from_evals(l_skip, d_matrix_evals, stacked_height, stacked_width));\n181\t    let d_tree = transport_merkle_tree_h2d(&d.tree, prover_config.cache_rs_code_matrix)?;\n182\t    let d_data = StackedPcsDataGpu {\n183\t        layout: d.layout.clone(),\n184\t        matrix: d_matrix,\n185\t        tree: d_tree,\n186\t    };\n187\t    // Sanity check. Not a strong assert because we transport the merkle tree\n188\t    // instead of recomputing it above.\n189\t    assert!(\n190\t        d_data.tree.root() == d.commit().unwrap(),\n191\t        \"transported tree root mismatch\"\n192\t    );\n193\t    Ok(CommittedTraceData {\n194\t        commitment: d.commit().unwrap(),\n195\t        trace: DeviceMatrix::new(Arc::new(trace_buffer), height, width),\n196\t        data: Arc::new(d_data),\n197\t    })\n198\t}\n199\t\n200\t/// Transports backing matrix and tree digest layers from host to device.\n201\tpub fn transport_merkle_tree_h2d<F, Digest: Clone>(\n202\t    tree: &MerkleTree<F, Digest>,\n203\t    cache_backing_matrix: bool,\n204\t) -> Result<MerkleTreeGpu<F, Digest>, MemCopyError> {\n205\t    let backing_matrix = if cache_backing_matrix {\n206\t        Some(transport_matrix_h2d_col_major(tree.backing_matrix())?)\n207\t    } else {\n208\t        None\n209\t    };\n210\t    let digest_layers = tree\n211\t        .digest_layers()\n212\t        .iter()\n213\t        .map(|layer| layer.to_device())\n214\t        .collect::<Result<Vec<_>, _>>()?;\n215\t    Ok(MerkleTreeGpu {\n216\t        backing_matrix,\n217\t        digest_layers,\n218\t        rows_per_query: tree.rows_per_query(),\n219\t        root: tree.root().unwrap(),"}]},"parent_tool_use_id":"toolu_014JXRbR5bfC35FtcEqUqv8a","session_id":"c8f518d6-4de0-4c05-9b5a-ade72ff81f39","uuid":"51527416-eebd-4e9f-8d50-c575b0b24e3c","timestamp":"2026-04-14T14:07:34.457Z"}
