{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017qW7nTKekSPieBD3AuMhRY","type":"tool_result","content":"1\tuse std::{fmt::Debug, marker::PhantomData, sync::Arc};\n2\t\n3\tuse openvm_cuda_common::{copy::MemCopyD2H, d_buffer::DeviceBuffer, error::MemCopyError};\n4\tuse openvm_stark_backend::prover::MatrixDimensions;\n5\t\n6\tpub struct DeviceMatrix<T> {\n7\t    buffer: Arc<DeviceBuffer<T>>,\n8\t    height: usize,\n9\t    width: usize,\n10\t}\n11\t\n12\tunsafe impl<T> Send for DeviceMatrix<T> {}\n13\tunsafe impl<T> Sync for DeviceMatrix<T> {}\n14\t\n15\timpl<T> Clone for DeviceMatrix<T> {\n16\t    fn clone(&self) -> Self {\n17\t        Self {\n18\t            buffer: Arc::clone(&self.buffer),\n19\t            height: self.height,\n20\t            width: self.width,\n21\t        }\n22\t    }\n23\t}\n24\t\n25\timpl<T> Drop for DeviceMatrix<T> {\n26\t    fn drop(&mut self) {\n27\t        tracing::debug!(\n28\t            \"Dropping DeviceMatrix of size {} with Arc strong count={}\",\n29\t            self.buffer.len(),\n30\t            self.strong_count()\n31\t        );\n32\t    }\n33\t}\n34\t\n35\timpl<T> DeviceMatrix<T> {\n36\t    pub fn new(buffer: Arc<DeviceBuffer<T>>, height: usize, width: usize) -> Self {\n37\t        assert_ne!(\n38\t            height * width,\n39\t            0,\n40\t            \"Zero dimensions h {} w {} are wrong\",\n41\t            height,\n42\t            width\n43\t        );\n44\t        assert_eq!(\n45\t            buffer.len(),\n46\t            height * width,\n47\t            \"Buffer size must match dimensions\"\n48\t        );\n49\t        Self {\n50\t            buffer,\n51\t            height,\n52\t            width,\n53\t        }\n54\t    }\n55\t\n56\t    pub fn with_capacity(height: usize, width: usize) -> Self {\n57\t        Self {\n58\t            buffer: Arc::new(DeviceBuffer::with_capacity(height * width)),\n59\t            height,\n60\t            width,\n61\t        }\n62\t    }\n63\t\n64\t    pub fn dummy() -> Self {\n65\t        Self {\n66\t            buffer: Arc::new(DeviceBuffer::new()),\n67\t            height: 0,\n68\t            width: 0,\n69\t        }\n70\t    }\n71\t\n72\t    pub fn buffer(&self) -> &DeviceBuffer<T> {\n73\t        &self.buffer\n74\t    }\n75\t\n76\t    pub fn strong_count(&self) -> usize {\n77\t        Arc::strong_count(&self.buffer)\n78\t    }\n79\t\n80\t    pub fn as_view(&self) -> DeviceMatrixView<'_, T> {\n81\t        // SAFETY: buffer is borrowed for lifetime 'a of the view\n82\t        unsafe { DeviceMatrixView::from_raw_parts(self.buffer.as_ptr(), self.height, self.width) }\n83\t    }\n84\t}\n85\t\n86\timpl<T> MatrixDimensions for DeviceMatrix<T> {\n87\t    #[inline]\n88\t    fn height(&self) -> usize {\n89\t        self.height\n90\t    }\n91\t\n92\t    #[inline]\n93\t    fn width(&self) -> usize {\n94\t        self.width\n95\t    }\n96\t}\n97\t\n98\timpl<T> MemCopyD2H<T> for DeviceMatrix<T> {\n99\t    fn to_host(&self) -> Result<Vec<T>, MemCopyError> {\n100\t        self.buffer.to_host()\n101\t    }\n102\t}\n103\t\n104\timpl<T: Debug> Debug for DeviceMatrix<T> {\n105\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n106\t        write!(\n107\t            f,\n108\t            \"DeviceMatrix (height = {}, width = {}): {:?}\",\n109\t            self.height(),\n110\t            self.width(),\n111\t            self.buffer()\n112\t        )\n113\t    }\n114\t}\n115\t\n116\t/// View of a device matrix. Dropping does not free memory.\n117\t#[derive(Clone, Copy)]\n118\tpub struct DeviceMatrixView<'a, T> {\n119\t    ptr: *const T,\n120\t    height: usize,"}]},"parent_tool_use_id":"toolu_01XsRFEy25idBbydpheWmVzS","session_id":"c8f518d6-4de0-4c05-9b5a-ade72ff81f39","uuid":"9670cf7c-2faa-42fc-adf4-c34a3e620a6a","timestamp":"2026-04-14T15:07:40.738Z"}
