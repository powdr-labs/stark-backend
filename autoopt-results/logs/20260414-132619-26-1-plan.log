{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JiErC58bhuavCifeHQa7Z9","type":"tool_result","content":"1\t//! CPU [ProverBackend] trait implementation.\n2\t\n3\tuse std::marker::PhantomData;\n4\t\n5\tuse getset::Getters;\n6\tuse itertools::Itertools;\n7\tuse p3_field::{ExtensionField, TwoAdicField};\n8\t\n9\tuse crate::{\n10\t    keygen::types::MultiStarkProvingKey,\n11\t    poly_common::Squarable,\n12\t    proof::{BatchConstraintProof, GkrProof, StackingProof, WhirProof},\n13\t    prover::{\n14\t        error::RefProverError,\n15\t        prove_zerocheck_and_logup,\n16\t        stacked_pcs::{stacked_commit, StackedPcsData},\n17\t        stacked_reduction::{prove_stacked_opening_reduction, StackedReductionCpu},\n18\t        whir::WhirProver,\n19\t        ColMajorMatrix, CommittedTraceData, DeviceDataTransporter, DeviceMultiStarkProvingKey,\n20\t        DeviceStarkProvingKey, MultiRapProver, OpeningProver, ProverBackend, ProverDevice,\n21\t        ProvingContext, TraceCommitter,\n22\t    },\n23\t    FiatShamirTranscript, StarkProtocolConfig, SystemParams,\n24\t};\n25\t\n26\t#[derive(Clone, Copy)]\n27\tpub struct CpuColMajorBackend<SC: StarkProtocolConfig>(PhantomData<SC>);\n28\t\n29\timpl<SC: StarkProtocolConfig> CpuColMajorBackend<SC> {\n30\t    pub fn new() -> Self {\n31\t        Self(PhantomData)\n32\t    }\n33\t}\n34\t\n35\timpl<SC: StarkProtocolConfig> Default for CpuColMajorBackend<SC> {\n36\t    fn default() -> Self {\n37\t        Self::new()\n38\t    }\n39\t}\n40\t\n41\t#[derive(Clone, Getters, derive_new::new)]\n42\tpub struct ReferenceDevice<SC> {\n43\t    #[getset(get = \"pub\")]\n44\t    config: SC,\n45\t}\n46\t\n47\timpl<SC: StarkProtocolConfig> ReferenceDevice<SC> {\n48\t    pub fn params(&self) -> &SystemParams {\n49\t        self.config.params()\n50\t    }\n51\t}\n52\t\n53\timpl<SC: StarkProtocolConfig> ProverBackend for CpuColMajorBackend<SC> {\n54\t    const CHALLENGE_EXT_DEGREE: u8 = SC::D_EF as u8;\n55\t\n56\t    type Val = SC::F;\n57\t    type Challenge = SC::EF;\n58\t    type Commitment = SC::Digest;\n59\t    type Matrix = ColMajorMatrix<SC::F>;\n60\t    type OtherAirData = ();\n61\t    type PcsData = StackedPcsData<SC::F, SC::Digest>;\n62\t}\n63\t\n64\timpl<SC, TS> ProverDevice<CpuColMajorBackend<SC>, TS> for ReferenceDevice<SC>\n65\twhere\n66\t    SC: StarkProtocolConfig,\n67\t    SC::F: Ord,\n68\t    SC::EF: TwoAdicField + ExtensionField<SC::F> + Ord,\n69\t    TS: FiatShamirTranscript<SC>,\n70\t{\n71\t    type Error = RefProverError;\n72\t}\n73\t\n74\timpl<SC: StarkProtocolConfig> TraceCommitter<CpuColMajorBackend<SC>> for ReferenceDevice<SC>\n75\twhere\n76\t    SC::F: Ord,\n77\t{\n78\t    type Error = RefProverError;\n79\t\n80\t    fn commit(\n81\t        &self,\n82\t        traces: &[&ColMajorMatrix<SC::F>],\n83\t    ) -> Result<(SC::Digest, StackedPcsData<SC::F, SC::Digest>), Self::Error> {\n84\t        Ok(stacked_commit(\n85\t            self.config().hasher(),\n86\t            self.params().l_skip,\n87\t            self.params().n_stack,\n88\t            self.params().log_blowup,\n89\t            self.params().k_whir(),\n90\t            traces,\n91\t        )?)\n92\t    }\n93\t}\n94\t\n95\timpl<SC, TS> MultiRapProver<CpuColMajorBackend<SC>, TS> for ReferenceDevice<SC>\n96\twhere\n97\t    SC: StarkProtocolConfig,\n98\t    SC::EF: TwoAdicField + ExtensionField<SC::F>,\n99\t    TS: FiatShamirTranscript<SC>,\n100\t{\n101\t    type PartialProof = (GkrProof<SC>, BatchConstraintProof<SC>);\n102\t    /// The random opening point `r` where the batch constraint sumcheck reduces to evaluation\n103\t    /// claims of trace matrices `T, T_{rot}` at `r_{n_T}`.\n104\t    type Artifacts = Vec<SC::EF>;\n105\t\n106\t    type Error = RefProverError;\n107\t\n108\t    fn prove_rap_constraints(\n109\t        &self,\n110\t        transcript: &mut TS,\n111\t        mpk: &DeviceMultiStarkProvingKey<CpuColMajorBackend<SC>>,\n112\t        ctx: &ProvingContext<CpuColMajorBackend<SC>>,\n113\t        _common_main_pcs_data: &StackedPcsData<SC::F, SC::Digest>,\n114\t    ) -> Result<((GkrProof<SC>, BatchConstraintProof<SC>), Vec<SC::EF>), Self::Error> {\n115\t        let (gkr_proof, batch_constraint_proof, r) =\n116\t            prove_zerocheck_and_logup::<SC, _>(transcript, mpk, ctx)?;\n117\t        Ok(((gkr_proof, batch_constraint_proof), r))\n118\t    }\n119\t}\n120\t\n121\timpl<SC, TS> OpeningProver<CpuColMajorBackend<SC>, TS> for ReferenceDevice<SC>\n122\twhere\n123\t    SC: StarkProtocolConfig,\n124\t    SC::F: Ord,\n125\t    SC::EF: TwoAdicField + ExtensionField<SC::F> + Ord,\n126\t    TS: FiatShamirTranscript<SC>,\n127\t{\n128\t    type OpeningProof = (StackingProof<SC>, WhirProof<SC>);\n129\t    /// The shared vector `r` where each trace matrix `T, T_{rot}` is opened at `r_{n_T}`.\n130\t    type OpeningPoints = Vec<SC::EF>;\n131\t\n132\t    type Error = RefProverError;\n133\t\n134\t    fn prove_openings(\n135\t        &self,\n136\t        transcript: &mut TS,\n137\t        mpk: &DeviceMultiStarkProvingKey<CpuColMajorBackend<SC>>,\n138\t        ctx: ProvingContext<CpuColMajorBackend<SC>>,\n139\t        common_main_pcs_data: StackedPcsData<SC::F, SC::Digest>,\n140\t        r: Vec<SC::EF>,\n141\t    ) -> Result<(StackingProof<SC>, WhirProof<SC>), Self::Error> {\n142\t        let params = self.params();\n143\t\n144\t        let need_rot_per_trace = ctx\n145\t            .per_trace\n146\t            .iter()\n147\t            .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n148\t            .collect_vec();\n149\t\n150\t        // Currently alternates between preprocessed and cached pcs data\n151\t        let pre_cached_pcs_data_per_commit: Vec<_> = ctx\n152\t            .per_trace\n153\t            .iter()\n154\t            .flat_map(|(air_idx, trace_ctx)| {\n155\t                mpk.per_air[*air_idx]\n156\t                    .preprocessed_data\n157\t                    .iter()\n158\t                    .chain(&trace_ctx.cached_mains)\n159\t                    .map(|cd| cd.data.clone())\n160\t            })\n161\t            .collect();\n162\t\n163\t        let mut stacked_per_commit = vec![&common_main_pcs_data];\n164\t        for data in &pre_cached_pcs_data_per_commit {\n165\t            stacked_per_commit.push(data);\n166\t        }\n167\t        #[cfg(debug_assertions)]\n168\t        {\n169\t            let total_stacked_width: usize =\n170\t                stacked_per_commit.iter().map(|d| d.layout.width()).sum();\n171\t            debug_assert!(\n172\t                total_stacked_width <= params.w_stack,\n173\t                \"total stacked width across commits ({total_stacked_width}) exceeds w_stack ({})\",\n174\t                params.w_stack\n175\t            );\n176\t        }\n177\t\n178\t        let mut need_rot_per_commit = vec![need_rot_per_trace];\n179\t        for (air_idx, trace_ctx) in &ctx.per_trace {\n180\t            let need_rot = mpk.per_air[*air_idx].vk.params.need_rot;\n181\t            if mpk.per_air[*air_idx].preprocessed_data.is_some() {\n182\t                need_rot_per_commit.push(vec![need_rot]);\n183\t            }\n184\t            for _ in &trace_ctx.cached_mains {\n185\t                need_rot_per_commit.push(vec![need_rot]);\n186\t            }\n187\t        }\n188\t        let (stacking_proof, u_prisma) =\n189\t            prove_stacked_opening_reduction::<SC, _, _, _, StackedReductionCpu<SC>>(\n190\t                self,\n191\t                transcript,\n192\t                params.n_stack,\n193\t                stacked_per_commit,\n194\t                need_rot_per_commit,\n195\t                &r,\n196\t            );\n197\t\n198\t        let (&u0, u_rest) = u_prisma\n199\t            .split_first()\n200\t            .ok_or(crate::prover::error::WhirProverError::UPrismaEmpty)?;"}]},"parent_tool_use_id":"toolu_017Zaq9ARo5bBFNLVwx7o4Ct","session_id":"c8f518d6-4de0-4c05-9b5a-ade72ff81f39","uuid":"4eda1ca5-8560-4a5f-8863-0f4ab6d9122f","timestamp":"2026-04-14T14:51:27.975Z"}
