\t                self.logup_tilde_evals[trace_idx][1] *= eq_sharp_r_acc;\n1949\t            }\n1950\t            if round <= n_lift {\n1951\t                for i in 0..constraint_degree {\n1952\t                    sp_head_zc[i] += mu_pows[zc_idx] * sp_round_evals[zc_idx][i];\n1953\t                    sp_head_logup[i] += mu_pows[numer_idx] * sp_round_evals[numer_idx][i]\n1954\t                        + mu_pows[denom_idx] * sp_round_evals[denom_idx][i];\n1955\t                }\n1956\t            } else {\n1957\t                sp_tail += mu_pows[zc_idx] * self.zerocheck_tilde_evals[trace_idx]\n1958\t                    + mu_pows[numer_idx] * self.logup_tilde_evals[trace_idx][0]\n1959\t                    + mu_pows[denom_idx] * self.logup_tilde_evals[trace_idx][1];\n1960\t            }\n1961\t        }\n1962\t        let s_deg = constraint_degree + 1;\n1963\t        let l_skip = self.l_skip;\n1964\t        // With eq(xi,r) contributions\n1965\t        let mut sp_head_evals = vec![EF::ZERO; s_deg];\n1966\t        for i in 0..constraint_degree {\n1967\t            sp_head_evals[i + 1] = self.eq_ns[round - 1] * sp_head_zc[i]\n1968\t                + self.eq_sharp_ns[round - 1] * sp_head_logup[i];\n1969\t        }\n1970\t        // We need to derive s'(0).\n1971\t        // We use that s_j(0) + s_j(1) = s_{j-1}(r_{j-1})\n1972\t        let xi_cur = self.xi[l_skip + round - 1];\n1973\t        {\n1974\t            let eq_xi_0 = EF::ONE - xi_cur;\n1975\t            let eq_xi_1 = xi_cur;\n1976\t            sp_head_evals[0] =\n1977\t                (self.prev_s_eval - eq_xi_1 * sp_head_evals[1] - sp_tail) * eq_xi_0.inverse();\n1978\t        }\n1979\t        // s' has degree s_deg - 1\n1980\t        let sp_head = UnivariatePoly::lagrange_interpolate(\n1981\t            &(0..s_deg).map(F::from_usize).collect_vec(),\n1982\t            &sp_head_evals,\n1983\t        );\n1984\t        // eq(xi, X) = (2 * xi - 1) * X + (1 - xi)\n1985\t        // Compute s(X) = eq(xi, X) * s'_head(X) + s'_tail * X (s'_head now contains eq(..,r))\n1986\t        // s(X) has degree s_deg\n1987\t        let mut coeffs = sp_head.into_coeffs();\n1988\t        coeffs.push(EF::ZERO);\n1989\t        let b = EF::ONE - xi_cur;\n1990\t        let a = xi_cur - b;\n1991\t        for i in (0..s_deg).rev() {\n1992\t            coeffs[i + 1] = a * coeffs[i] + b * coeffs[i + 1];\n1993\t        }\n1994\t        coeffs[0] *= b;\n1995\t        coeffs[1] += sp_tail;\n1996\t        UnivariatePoly::new(coeffs)\n1997\t    }\n1998\t\n1999\t    #[instrument(name = \"LogupZerocheck::fold_mle_evals\", level = \"debug\", skip_all, fields(round = round))]\n2000\t    fn fold_mle_evals(&mut self, round: usize, r_round: EF) -> Result<(), LogupZerocheckError> {\n2001\t        // Assumes that input_mats are sorted by height\n2002\t        let batch_fold = |input_mats: Vec<DeviceMatrix<EF>>| -> Result<Vec<DeviceMatrix<EF>>, LogupZerocheckError> {\n2003\t            let num_matrices = input_mats.partition_point(|mat| mat.height() > 1);\n2004\t            let mut max_output_cells = 0;\n2005\t            let (log_output_heights, widths, mut output_mats): (Vec<_>, Vec<_>, Vec<_>) =\n2006\t                input_mats\n2007\t                    .iter()\n2008\t                    .take(num_matrices)\n2009\t                    .map(|mat| {\n2010\t                        let height = mat.height();\n2011\t                        let width = mat.width();\n2012\t                        let output_height = height >> 1;\n2013\t                        max_output_cells = max(max_output_cells, output_height * width);\n2014\t                        let output_mat = DeviceMatrix::<EF>::with_capacity(output_height, width);\n2015\t                        (output_height.ilog2() as u8, width as u32, output_mat)\n2016\t                    })\n2017\t                    .multiunzip();\n2018\t\n2019\t            let input_ptrs = input_mats\n2020\t                .iter()\n2021\t                .take(num_matrices)\n2022\t  