{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019WWDoPHqT3XqwENh7GEynK","type":"tool_result","content":"1\t#include \"fp.h\"\n2\t#include \"fpext.h\"\n3\t#include \"launcher.cuh\"\n4\t#include \"poseidon2.cuh\"\n5\t#include <cstddef>\n6\t#include <cstdint>\n7\t\n8\tstruct digest_t {\n9\t    Fp cells[CELLS_OUT];\n10\t};\n11\t\n12\t// This kernel computes the row hash of each row, and then computes the merkle root of `rows_per_query` strided rows at a time, where the stride is `height / rows_per_query`.\n13\t// - height = query_stride * 2^log_rows_per_query\n14\t// - blockDim.y = 2^log_rows_per_query\n15\t// - gridDim.y = 1\n16\t__global__ void poseidon2_compressing_row_hashes_kernel(\n17\t    digest_t *out,    // [query_stride]\n18\t    const Fp *matrix, // [width][height]\n19\t    size_t width,\n20\t    size_t height,\n21\t    size_t query_stride,\n22\t    size_t log_rows_per_query\n23\t) {\n24\t    extern __shared__ char smem[]; // Fp[CELLS_OUT][blockDim.y / 2 * blockDim.x]\n25\t    Fp *shared = reinterpret_cast<Fp *>(smem);\n26\t    const uint32_t shared_stride = blockDim.x * (blockDim.y >> 1);\n27\t\n28\t    const uint32_t stride_idx = blockDim.x * blockIdx.x + threadIdx.x;\n29\t    uint32_t leaf_idx = threadIdx.y;\n30\t    const uint32_t row = leaf_idx * query_stride + stride_idx;\n31\t\n32\t    size_t used = 0;\n33\t    Fp cells[CELLS];\n34\t#pragma unroll\n35\t    for (int i = 0; i < CELLS; i++) {\n36\t        cells[i] = Fp(0);\n37\t    }\n38\t\n39\t    if (stride_idx < query_stride) {\n40\t        // compute row hash\n41\t        for (int col = 0; col < width; col++) {\n42\t            cells[used++] = matrix[col * height + row];\n43\t            if (used == CELLS_RATE) {\n44\t                poseidon2::poseidon2_mix(cells);\n45\t                used = 0;\n46\t            }\n47\t        }\n48\t        if (used != 0) {\n49\t            poseidon2::poseidon2_mix(cells);\n50\t        }\n51\t    }\n52\t\n53\t    for (int layer = 0; layer < log_rows_per_query; ++layer) {\n54\t        uint32_t mask = (1 << (layer + 1)) - 1;\n55\t        auto shared_offset = ((leaf_idx >> (layer + 1)) << layer) * blockDim.x + threadIdx.x;\n56\t        if ((leaf_idx & mask) == (1 << layer)) {\n57\t#pragma unroll\n58\t            for (int i = 0; i < CELLS_OUT; i++) {\n59\t                shared[i * shared_stride + shared_offset] = cells[i];\n60\t            }\n61\t        }\n62\t        __syncthreads();\n63\t        if ((leaf_idx & mask) == 0) {\n64\t#pragma unroll\n65\t            for (int i = 0; i < CELLS_OUT; i++) {\n66\t                cells[CELLS_OUT + i] = shared[i * shared_stride + shared_offset];\n67\t            }\n68\t            poseidon2::poseidon2_mix(cells);\n69\t        }\n70\t        __syncthreads(); // Ensure all reads complete before next iteration's writes\n71\t    }\n72\t\n73\t    if (leaf_idx == 0) {\n74\t#pragma unroll\n75\t        for (int i = 0; i < CELLS_OUT; i++) {\n76\t            out[stride_idx].cells[i] = cells[i];\n77\t        }\n78\t    }\n79\t}\n80\t\n81\t__global__ void poseidon2_compressing_row_hashes_ext_kernel(\n82\t    digest_t *out,\n83\t    const FpExt *matrix,\n84\t    size_t width,\n85\t    size_t height,\n86\t    size_t query_stride,\n87\t    size_t log_rows_per_query\n88\t) {\n89\t    extern __shared__ char smem[]; // Fp[CELLS_OUT][blockDim.y / 2 * blockDim.x]\n90\t    Fp *shared = reinterpret_cast<Fp *>(smem);\n91\t    const uint32_t shared_stride = blockDim.x * (blockDim.y >> 1);\n92\t\n93\t    const uint32_t stride_idx = blockDim.x * blockIdx.x + threadIdx.x;\n94\t    uint32_t leaf_idx = threadIdx.y;\n95\t    const uint32_t row = leaf_idx * query_stride + stride_idx;\n96\t\n97\t    size_t used = 0;\n98\t    Fp cells[CELLS];\n99\t#pragma unroll\n100\t    for (int i = 0; i < CELLS; i++) {\n101\t        cells[i] = Fp(0);\n102\t    }\n103\t\n104\t    if (stride_idx < query_stride) {\n105\t        // compute row hash\n106\t        for (int col = 0; col < width; col++) {\n107\t#pragma unroll\n108\t            // Extension field degree is 4\n109\t            for (int i = 0; i < 4; i++) {\n110\t                cells[used++] = matrix[col * height + row].elems[i];\n111\t            }\n112\t            if (used == CELLS_RATE) {\n113\t                poseidon2::poseidon2_mix(cells);\n114\t                used = 0;\n115\t            }\n116\t        }\n117\t        if (used != 0) {\n118\t            poseidon2::poseidon2_mix(cells);\n119\t        }\n120\t    }\n121\t\n122\t    // This part is same as for poseidon2_compressing_row_hashes_kernel\n123\t    for (int layer = 0; layer < log_rows_per_query; ++layer) {\n124\t        uint32_t mask = (1 << (layer + 1)) - 1;\n125\t        auto shared_offset = ((leaf_idx >> (layer + 1)) << layer) * blockDim.x + threadIdx.x;\n126\t        if ((leaf_idx & mask) == (1 << layer)) {\n127\t#pragma unroll\n128\t            for (int i = 0; i < CELLS_OUT; i++) {\n129\t                shared[i * shared_stride + shared_offset] = cells[i];\n130\t            }\n131\t        }\n132\t        __syncthreads();\n133\t        if ((leaf_idx & mask) == 0) {\n134\t#pragma unroll\n135\t            for (int i = 0; i < CELLS_OUT; i++) {\n136\t                cells[CELLS_OUT + i] = shared[i * shared_stride + shared_offset];\n137\t            }\n138\t            poseidon2::poseidon2_mix(cells);\n139\t        }\n140\t        __syncthreads(); // Ensure all reads complete before next iteration's writes\n141\t    }\n142\t\n143\t    if (leaf_idx == 0) {\n144\t#pragma unroll\n145\t        for (int i = 0; i < CELLS_OUT; i++) {\n146\t            out[stride_idx].cells[i] = cells[i];\n147\t        }\n148\t    }\n149\t}\n150\tstatic_assert(CELLS_RATE % 4 == 0, \"CELLS_RATE must be multiple of FpExt degree (4)\");\n151\t\n152\t// Striding keeps memory coalesced with two cache lines within a warp\n153\t__global__ void poseidon2_strided_compress_layer_kernel(\n154\t    digest_t *output,\n155\t    const digest_t *prev_layer,\n156\t    size_t output_size,\n157\t    size_t stride\n158\t) {\n159\t    uint32_t gid = blockDim.x * blockIdx.x + threadIdx.x;\n160\t    if (gid >= output_size) {\n161\t        return;\n162\t    }\n163\t    uint32_t x = gid / stride;\n164\t    uint32_t y = gid % stride;\n165\t\n166\t    Fp cells[CELLS];\n167\t    for (int i = 0; i < CELLS_OUT; i++) {\n168\t        cells[i] = prev_layer[2 * x * stride + y].cells[i];\n169\t        cells[i + CELLS_OUT] = prev_layer[(2 * x + 1) * stride + y].cells[i];\n170\t    }\n171\t\n172\t    poseidon2::poseidon2_mix(cells);\n173\t\n174\t    for (int i = 0; i < CELLS_OUT; i++) {\n175\t        output[gid].cells[i] = cells[i];\n176\t    }\n177\t}\n178\t\n179\t/*\n180\tquery[0][0,...layers-1]\n181\tquery[1][0,...layers-1]\n182\t...\n183\tquery[k][0,...layers-1]\n184\t*/\n185\t__global__ void query_digest_layers(\n186\t    Fp *d_digest_matrix,          // Fp*, also Digest: CELLS_OUT=8 Fp elements\n187\t    const uint64_t *d_layers_ptr, // array of Digest layers\n188\t    uint64_t *d_indices,          // uint64_t*, indices to query, size = num_query * num_layer\n189\t    uint64_t num_query,           // e.g. 100\n190\t    uint64_t num_layer\n191\t) // e.g. 23\n192\t{\n193\t    const uint32_t ELEM_PER_DIGEST = CELLS_OUT; // 8 * Fp\n194\t    uint64_t gidx = blockIdx.x * blockDim.x + threadIdx.x;\n195\t    uint64_t layer_idx = gidx / ELEM_PER_DIGEST;\n196\t    uint64_t elem_offset = gidx % ELEM_PER_DIGEST; // thread group: [0,..7]\n197\t    uint64_t query_idx = blockIdx.y;               // [0, num_query -1]\n198\t    if (layer_idx >= num_layer) {                  // [0, layers - 1]\n199\t        return;\n200\t    }\n201\t\n202\t    Fp *d_layer = (Fp *)d_layers_ptr[layer_idx];\n203\t    uint64_t digest_offset = d_indices[query_idx * num_layer + layer_idx];\n204\t    Fp digest_elem = d_layer[digest_offset * ELEM_PER_DIGEST + elem_offset];\n205\t    // now each thread get 1/ELEM_PER_DIGEST of the digest\n206\t\n207\t    uint64_t output_query_offset = query_idx * num_layer * ELEM_PER_DIGEST;\n208\t    uint64_t output_layer_offset = layer_idx * ELEM_PER_DIGEST + elem_offset;\n209\t    d_digest_matrix[output_query_offset + output_layer_offset] = digest_elem;\n210\t}\n211\t\n212\t// LAUNCHERS\n213\t\n214\textern \"C\" int _poseidon2_compressing_row_hashes(\n215\t    digest_t *out,\n216\t    const Fp *matrix,\n217\t    size_t width,\n218\t    size_t query_stride,\n219\t    size_t log_rows_per_query\n220\t) {\n221\t    auto [grid, block] = kernel_launch_params(query_stride, 512 >> log_rows_per_query);\n222\t    block.y = 1 << log_rows_per_query;\n223\t    size_t shared_stride = block.x * div_ceil(block.y, 2);\n224\t    size_t shmem_bytes = CELLS_OUT * shared_stride * sizeof(Fp);\n225\t    auto height = query_stride << log_rows_per_query;\n226\t\n227\t    poseidon2_compressing_row_hashes_kernel<<<grid, block, shmem_bytes>>>(\n228\t        out, matrix, width, height, query_stride, log_rows_per_query\n229\t    );\n230\t    return CHECK_KERNEL();\n231\t}\n232\t\n233\textern \"C\" int _poseidon2_compressing_row_hashes_ext(\n234\t    digest_t *out,\n235\t    const FpExt *matrix,\n236\t    size_t width,\n237\t    size_t query_stride,\n238\t    size_t log_rows_per_query\n239\t) {\n240\t    auto [grid, block] = kernel_launch_params(query_stride, 512 >> log_rows_per_query);\n241\t    block.y = 1 << log_rows_per_query;\n242\t    size_t shared_stride = block.x * div_ceil(block.y, 2);\n243\t    size_t shmem_bytes = CELLS_OUT * shared_stride * sizeof(Fp);\n244\t    auto height = query_stride << log_rows_per_query;\n245\t\n246\t    poseidon2_compressing_row_hashes_ext_kernel<<<grid, block, shmem_bytes>>>(\n247\t        out, matrix, width, height, query_stride, log_rows_per_query\n248\t    );\n249\t    return CHECK_KERNEL();\n250\t}\n251\t\n252\textern \"C\" int _poseidon2_strided_compress_layer(\n253\t    digest_t *output,\n254\t    const digest_t *prev_layer,\n255\t    size_t output_size,\n256\t    size_t stride\n257\t) {\n258\t    auto [grid, block] = kernel_launch_params(output_size);\n259\t    poseidon2_strided_compress_layer_kernel<<<grid, block>>>(\n260\t        output, prev_layer, output_size, stride\n261\t    );\n262\t    return CHECK_KERNEL();\n263\t}\n264\t\n265\t// NOTE[jpw]: adding this function in CUDA to ensure the compiler can optimize stride = 1 (not sure this would happen across FFI boundary).\n266\t// For 32 byte digest, adjacent memory read still keeps memory coalesced in a warp\n267\textern \"C\" int _poseidon2_adjacent_compress_layer(\n268\t    digest_t *output,\n269\t    const digest_t *prev_layer,\n270\t    size_t output_size\n271\t) {\n272\t    auto [grid, block] = kernel_launch_params(output_size);\n273\t    poseidon2_strided_compress_layer_kernel<<<grid, block>>>(output, prev_layer, output_size, 1);\n274\t    return CHECK_KERNEL();\n275\t}\n276\t\n277\textern \"C\" int _query_digest_layers(\n278\t    Fp *d_digest_matrix,\n279\t    const uint64_t *d_layers_ptr,\n280\t    uint64_t *d_indices,\n281\t    uint64_t num_query,\n282\t    uint64_t num_layer\n283\t) {\n284\t    const size_t QUERY_DIGEST_THREADS = 128;\n285\t    const size_t DIGEST_WIDTH = 8;\n286\t\n287\t    auto block = QUERY_DIGEST_THREADS;\n288\t    dim3 grid = dim3(div_ceil(num_layer * DIGEST_WIDTH, block), num_query);\n289\t    query_digest_layers<<<grid, block>>>(\n290\t        d_digest_matrix, d_layers_ptr, d_indices, num_query, num_layer\n291\t    );\n292\t    return CHECK_KERNEL();\n293\t}\n294\t"}]},"parent_tool_use_id":"toolu_014JXRbR5bfC35FtcEqUqv8a","session_id":"c8f518d6-4de0-4c05-9b5a-ade72ff81f39","uuid":"16ef2e3e-e222-4c08-aa13-b4654db0b73f","timestamp":"2026-04-14T14:06:30.792Z"}
