 Vec::new();\n1569\t        let mut all_columns: Vec<*const EF> = Vec::new();\n1570\t        let mut total_interp_elems: usize = 0;\n1571\t\n1572\t        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n1573\t            self.n_per_trace.iter(),\n1574\t            self.mat_evals_per_trace.iter(),\n1575\t            self.sels_per_trace.iter(),\n1576\t            self.d_eq_3b_per_trace.iter(),\n1577\t            self.public_values_per_trace.iter(),\n1578\t            self.air_indices_per_trace.iter()\n1579\t        )\n1580\t        .enumerate()\n1581\t        {\n1582\t            let pk = &self.pk.per_air[air_idx];\n1583\t            let dag = &pk.vk.symbolic_constraints;\n1584\t            let has_constraints = dag.constraints.num_constraints() > 0;\n1585\t            let has_interactions = !dag.interactions.is_empty();\n1586\t            if !has_constraints && !has_interactions {\n1587\t                continue;\n1588\t            }\n1589\t\n1590\t            let n_lift = n.max(0) as usize;\n1591\t            let norm_factor_denom = 1 << (-n).max(0);\n1592\t            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n1593\t            let has_preprocessed = pk.preprocessed_data.is_some();\n1594\t            let need_rot = pk.vk.params.need_rot;\n1595\t            let first_main_idx = usize::from(has_preprocessed);\n1596\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n1597\t\n1598\t            if round > n_lift {\n1599\t                // Case A\n1600\t                if round == n_lift + 1 {\n1601\t                    // A.1: evaluate directly at (num_x=1, num_y=1)\n1602\t                    let prep_ptr = if has_preprocessed {\n1603\t                        MainMatrixPtrs {\n1604\t                            data: mats[0].buffer().as_ptr(),\n1605\t                            air_width: air_width_for_mat(need_rot, mats[0].width()),\n1606\t                        }\n1607\t                    } else {\n1608\t                        MainMatrixPtrs {\n1609\t                            data: std::ptr::null(),\n1610\t                            air_width: 0,\n1611\t                        }\n1612\t                    };\n1613\t                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1614\t                        .iter()\n1615\t                        .map(|m| MainMatrixPtrs {\n1616\t                            data: m.buffer().as_ptr(),\n1617\t                            air_width: air_width_for_mat(need_rot, m.width()),\n1618\t                        })\n1619\t                        .collect_vec();\n1620\t                    let main_ptrs_dev = main_ptrs.to_device()?;\n1621\t\n1622\t                    late_eval.push(TraceCtx {\n1623\t                        trace_idx,\n1624\t                        air_idx,\n1625\t                        n_lift,\n1626\t                        num_y: 1,\n1627\t                        has_constraints,\n1628\t                        has_interactions,\n1629\t                        norm_factor,\n1630\t                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n1631\t                        sels_ptr: sels.buffer().as_ptr(),\n1632\t                        prep_ptr,\n1633\t                        main_ptrs_dev,\n1634\t                        public_ptr: public_vals.as_ptr(),\n1635\t                        eq_3bs_ptr: eq_3bs.as_ptr(),\n1636\t                    });\n1637\t                } else {\n1638\t                    // A.2: scale tilde evals only\n1639\t                    if has_constraints {\n1640\t                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n1641\t                        *tilde_eval *= r_prev;\n1642\t                    }\n1643\t                    if has_interactions {\n1644\t                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n1645\t                            *x *= r_prev;\n1646\t                        }\n1647\t                    }\n1648\t                }\n1649\t            } else {\n1650\t                // Case B: collect metadata for batched interpolation\n1651\t                let log_num_y = n_lift - round;\n1652\t                let num_y = 1 << log_num_y;\n1653\t                let height = 2 * num_y;\n1654\t                debug_assert_eq!(height, mats[0].height());\n1655\t\n1656\t                let col_start = all_columns.len();\n1657\t                // Collect all column pointers: selectors + all matrices (preprocessed + mains)\n1658\t                all_columns.extend(\n1659\t                    iter::once(sels)\n1660\t                        .chain(mats.iter())\n1661\t                        .flat_map(|m| {\n1662\t                            assert_eq!(m.height(), height);\n1663\t                            (0..m.width())\n1664\t                                .map(|col| m.buffer().as_ptr().wrapping_add(col * m.height()))\n1665\t                        }),\n1666\t                );\n1667\t                let num_columns = all_columns.len() - col_start;\n1668\t                let interp_size = sp_deg * num_y * num_columns;\n1669\t\n1670\t                case_b_traces.push(CaseBMeta {\n1671\t                    trace_idx,\n1672\t                    air_idx,\n1673\t                    n_lift,\n1674\t                    num_y,\n1675\t                    num_columns,\n1676\t                    interp_offset: total_interp_elems,\n1677\t                    col_start,\n1678\t                    has_preprocessed,\n1679\t                    need_rot,\n1680\t                    has_constraints,\n1681\t                    has_interactions,\n1682\t                    norm_factor,\n1683\t                });\n1684\t                total_interp_elems += interp_size;\n1685\t            }\n1686\t        }\n1687\t\n1688\t        // ── Phase 2: Batch allocate + single kernel launch ──\n1689\t        // One big buffer for all interpolated data, one kernel launch for all Case B traces.\n1690\t        let _keepalive_