bda,\n778\t                            prev_r,\n779\t                            transcript,\n780\t                            &mut d_sum_evals,\n781\t                            &mut tmp_block_sums,\n782\t                            &mut round_polys_eval,\n783\t                            &mut r_vec,\n784\t                            &mut prev_s_eval,\n785\t                            xi_j,\n786\t                            &mut eq_r_acc,\n787\t                        )?,\n788\t                    };\n789\t\n790\t                    pq_size >>= 1;\n791\t                    prev_r = r;\n792\t                }\n793\t\n794\t                // Final fold after last r (no next compute to fuse with).\n795\t                active = match scheduler.final_fold_target(last_outer_round) {\n796\t                    BufferTarget::InPlaceWork => {\n797\t                        unsafe {\n798\t                            fold_ef_frac_columns_inplace(&mut work_buffer, pq_size, prev_r)\n799\t                                .map_err(FractionalSumcheckError::FoldColumns)?;\n800\t                        }\n801\t                        &mut work_buffer\n802\t                    }\n803\t                    BufferTarget::InPlaceLayer => {\n804\t                        unsafe {\n805\t                            fold_ef_frac_columns_inplace(&mut layer, pq_size, prev_r)\n806\t                                .map_err(FractionalSumcheckError::FoldColumns)?;\n807\t                        }\n808\t                        &mut layer\n809\t                    }\n810\t                    BufferTarget::LayerToWork => {\n811\t                        unsafe {\n812\t                            fold_ef_frac_columns(&layer, &mut work_buffer, pq_size, prev_r)\n813\t                                .map_err(FractionalSumcheckError::FoldColumns)?;\n814\t                        }\n815\t                        &mut work_buffer\n816\t                    }\n817\t                    BufferTarget::WorkToLayer => unreachable!(),\n818\t                };\n819\t                pq_size >>= 1;\n820\t            }\n821\t            GkrRoundStrategy::PrecomputeM => {\n822\t                let base = 1usize;\n823\t                let stop = round.div_ceil(2);\n824\t\n825\t                // First window reads from `layer` with pending_fold=true\n826\t                // (M-build folds prev_r inline). Multifold writes to\n827\t                // `active_pq` (work_buffer for non-last rounds, layer for\n828\t                // last). After the first window, subsequent windows\n829\t                // read/write active_pq with pending_fold=false.\n830\t                let mut pending_fold = true;\n831\t                let layer_read_ptr = layer.as_ptr();\n832\t                let active_pq = if last_outer_round {\n833\t                    &mut layer\n834\t                } else {\n835\t                    &mut work_buffer\n836\t                };\n837\t\n838\t                // w+1 to accommodate r_prev prepended to window challenges\n839\t                // on the first iteration (inline fold on last outer round).\n840\t                let mut eq_r_window_host = vec![EF::ZERO; 1 << (GKR_WINDOW_SIZE + 1)];\n841\t                let mut eq_r_prefix_host = vec![EF::ZERO; 1 << GKR_WINDOW_SIZE];\n842\t                let mut eq_suffix_host = vec![EF::ZERO; 1 << GKR_WINDOW_SIZE];\n843\t\n844\t                if eq_r_prefix_buffer.is_empty() {\n845\t                    eq_r_prefix_buffer =\n846\t                        DeviceBuffer::<EF>::with_capacity(1usize << GKR_WINDOW_SIZE);\n847\t                }\n848\t                if eq_suffix_buffer.is_empty() {\n849\t                    eq_suffix_buffer = DeviceBuffer::<EF>::with_capacity(1usize << GKR_WINDOW_SIZE);\n850\t                }\n851\t\n852\t                let mut base = base;\n853\t                while base < stop {\n854\t                    let rem_n = round - base;"}]},"parent_tool_use_id":"toolu_01KC762CigJ45P58NxaMv5Wb","session_i