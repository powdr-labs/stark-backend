{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012oAUHptXLW9dT8k5X9fnae","type":"tool_result","content":"391\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n392\t    transcript: &mut TS,\n393\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n394\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n395\t    save_memory: bool,\n396\t    monomial_num_y_threshold: u32,\n397\t    sm_count: u32,\n398\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n399\twhere\n400\t    HS: GpuHashScheme,\n401\t    TS: GpuFiatShamirTranscript<HS::SC>,\n402\t{\n403\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n404\t    let l_skip = mpk.params.l_skip;\n405\t    let constraint_degree = mpk.max_constraint_degree;\n406\t    let num_traces = ctx.per_trace.len();\n407\t\n408\t    // Traces are sorted\n409\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n410\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n411\t    // heights\n412\t    let mut total_interactions = 0u64;\n413\t    let interactions_meta: Vec<_> = ctx\n414\t        .per_trace\n415\t        .iter()\n416\t        .map(|(air_idx, air_ctx)| {\n417\t            let pk = &mpk.per_air[*air_idx];\n418\t\n419\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n420\t            let height = air_ctx.common_main.height();\n421\t            let log_height = log2_strict_usize(height);\n422\t            let log_lifted_height = log_height.max(l_skip);\n423\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n424\t            (num_interactions, log_lifted_height)\n425\t        })\n426\t        .collect();\n427\t    // Implicitly, the width of this stacking should be 1\n428\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n429\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n430\t    // GKR\n431\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n432\t\n433\t    // Grind to increase soundness of random sampling for LogUp\n434\t    let logup_pow_witness = transcript\n435\t        .grind_gpu(mpk.params.logup.pow_bits)\n436\t        .map_err(LogupZerocheckError::Grind)?;\n437\t    let alpha_logup = transcript.sample_ext();\n438\t    let beta_logup = transcript.sample_ext();\n439\t    debug!(%alpha_logup, %beta_logup);\n440\t\n441\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n442\t    let mut prover = LogupZerocheckGpu::new(\n443\t        mpk,\n444\t        ctx,\n445\t        n_logup,\n446\t        interactions_layout,\n447\t        alpha_logup,\n448\t        beta_logup,\n449\t        save_memory,\n450\t        monomial_num_y_threshold,\n451\t        sm_count,\n452\t    )?;\n453\t    let n_global = prover.n_global;\n454\t\n455\t    let total_leaves = 1 << (l_skip + n_logup);\n456\t    prover\n457\t        .mem\n458\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n459\t    prover.mem.reset_peak();\n460\t    let (inputs, alpha) = if has_interactions {\n461\t        log_gkr_input_evals(\n462\t            &prover.trace_interactions,\n463\t            mpk,\n464\t            ctx,\n465\t            l_skip,\n466\t            alpha_logup,\n467\t            &prover.d_challenges,\n468\t            total_leaves,\n469\t        )?\n470\t    } else {\n471\t        (DeviceBuffer::new(), EF::ZERO)\n472\t    };\n473\t    // Set memory limit for batch MLE based on inputs buffer size\n474\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n475\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n476\t    if !prover.save_memory {\n477\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n478\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n479\t            tracing::warn!(\n480\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n481\t                prover.memory_limit_bytes\n482\t            );\n483\t        }\n484\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n485\t    }\n486\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n487\t\n488\t    let (frac_sum_proof, mut xi) =\n489\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n490\t    while xi.len() != l_skip + n_global {\n491\t        xi.push(transcript.sample_ext());\n492\t    }\n493\t    debug!(?xi);\n494\t    prover.xi = xi;\n495\t\n496\t    logup_gkr_span.exit();\n497\t\n498\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does\n499\t    // not include the kernel times for the actual folding\n500\t    let round0_span = info_span!(\"prover.rap_constraints.round0\", phase = \"prover\").entered();\n501\t    // begin batch sumcheck\n502\t    let mut sumcheck_round_polys = Vec::with_capacity(n_max);\n503\t    let mut r = Vec::with_capacity(n_max + 1);\n504\t    // batching randomness\n505\t    let lambda = transcript.sample_ext();\n506\t    debug!(%lambda);\n507\t\n508\t    let sp_0_polys = prover.sumcheck_uni_round0_polys(ctx, lambda)?;\n509\t    let s_0_cpu_span = info_span!(\"s'_0 -> s_0 cpu interpolations\").entered();\n510\t    let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_degree);\n511\t    let s_deg = constraint_degree + 1;\n512\t    let s_0_deg = sumcheck_round0_deg(l_skip, s_deg);\n513\t    let large_uni_domain = (s_0_deg + 1).next_power_of_two();\n514\t    let dft = Radix2BowersSerial;\n515\t    let s_0_logup_polys = {\n516\t        let eq_sharp_uni = eq_sharp_uni_poly(&prover.xi[..l_skip]);\n517\t        let mut eq_coeffs = eq_sharp_uni.into_coeffs();\n518\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n519\t        let eq_evals = dft.dft(eq_coeffs);\n520\t\n521\t        let width = 2 * num_traces;\n522\t        let mut sp_coeffs_mat = EF::zero_vec(width * large_uni_domain);\n523\t        for (i, coeffs) in sp_0_polys[..2 * num_traces].iter().enumerate() {\n524\t            for (j, &c_j) in coeffs.coeffs().iter().enumerate().take(sp_0_deg + 1) {\n525\t                // SAFETY:\n526\t                // - coeffs length is <= sp_0_deg + 1 <= s_0_deg < large_uni_domain\n527\t                // - sp_coeffs_mat allocated for width\n528\t                unsafe {\n529\t                    *sp_coeffs_mat.get_unchecked_mut(j * width + i) = c_j;\n530\t                }\n531\t            }\n532\t        }\n533\t        let mut s_evals = dft.dft_batch(RowMajorMatrix::new(sp_coeffs_mat, width));\n534\t        for (eq, row) in zip(eq_evals, s_evals.values.chunks_mut(width)) {\n535\t            for x in row {\n536\t                *x *= eq;\n537\t            }\n538\t        }\n539\t        dft.idft_batch(s_evals)\n540\t    };\n541\t    let skip_domain_size = F::from_usize(1 << l_skip);\n542\t    // logup sum claims (sum_{\\hat p}, sum_{\\hat q}) per present AIR\n543\t    let (numerator_term_per_air, denominator_term_per_air): (Vec<_>, Vec<_>) = (0..num_traces)\n544\t        .map(|trace_idx| {\n545\t            let [sum_claim_p, sum_claim_q] = [0, 1].map(|is_denom| {\n546\t                // Compute sum over D of s_0(Z) to get the sum claim\n547\t                (0..=s_0_deg)\n548\t                    .step_by(1 << l_skip)\n549\t                    .map(|j| unsafe {\n550\t                        // SAFETY: matrix is 2 * num_trace x large_uni_domain, s_0_deg <\n551\t                        // large_uni_domain\n552\t                        *s_0_logup_polys\n553\t                            .values\n554\t                            .get_unchecked(j * 2 * num_traces + 2 * trace_idx + is_denom)\n555\t                    })\n556\t                    .sum::<EF>()\n557\t                    * skip_domain_size\n558\t            });\n559\t            transcript.observe_ext(sum_claim_p);\n560\t            transcript.observe_ext(sum_claim_q);\n561\t\n562\t            (sum_claim_p, sum_claim_q)\n563\t        })\n564\t        .unzip();\n565\t\n566\t    let mu = transcript.sample_ext();\n567\t    debug!(%mu);\n568\t    let mu_pows = mu.powers().take(3 * num_traces).collect_vec();\n569\t\n570\t    let s_0_zc_poly = {\n571\t        let eq_uni = eq_uni_poly::<F, _>(l_skip, prover.xi[0]);\n572\t        let mut eq_coeffs = eq_uni.into_coeffs();\n573\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n574\t        let eq_evals = dft.dft(eq_coeffs);\n575\t\n576\t        // Algebraically batch\n577\t        let mut sp_coeffs = EF::zero_vec(large_uni_domain);\n578\t        let mus = &mu_pows[2 * num_traces..];\n579\t        let polys = &sp_0_polys[2 * num_traces..];\n580\t        for (j, batch_coeff) in sp_coeffs.iter_mut().enumerate().take(sp_0_deg + 1) {\n581\t            for (&mu, poly) in zip(mus, polys) {\n582\t                *batch_coeff += mu * *poly.coeffs().get(j).unwrap_or(&EF::ZERO);\n583\t            }\n584\t        }\n585\t        let mut s_evals = dft.dft(sp_coeffs);\n586\t        for (eq, x) in zip(eq_evals, &mut s_evals) {\n587\t            *x *= eq;\n588\t        }\n589\t        dft.idft(s_evals)\n590\t    };\n591\t\n592\t    // Algebraically batch\n593\t    let s_0_poly = UnivariatePoly::new(\n594\t        zip(\n595\t            s_0_logup_polys.values.chunks_exact(2 * num_traces),\n596\t            s_0_zc_poly,\n597\t        )\n598\t        .take(s_0_deg + 1)\n599\t        .map(|(logup_row, batched_zc)| {\n600\t            let coeff = batched_zc\n601\t                + zip(&mu_pows, logup_row)\n602\t                    .map(|(&mu_j, &x)| mu_j * x)\n603\t                    .sum::<EF>();\n604\t            transcript.observe_ext(coeff);\n605\t            coeff\n606\t        })\n607\t        .collect(),\n608\t    );\n609\t    drop(s_0_cpu_span);\n610\t\n611\t    let r_0 = transcript.sample_ext();\n612\t    r.push(r_0);\n613\t    debug!(round = 0, r_round = %r_0);\n614\t    prover.prev_s_eval = s_0_poly.eval_at_point(r_0);\n615\t    debug!(\"s_0(r_0) = {}\", prover.prev_s_eval);\n616\t\n617\t    prover.fold_ple_evals(ctx, r_0)?;\n618\t    drop(round0_span);\n619\t\n620\t    // Sumcheck rounds:\n621\t    // - each round the prover needs to compute univariate polynomial `s_round`. This poly is linear\n622\t    //   since we are taking MLE of `evals`.\n623\t    // - at end of each round, sample random `r_round` in `EF`\n624\t    //\n625\t    // `s_round` is degree `s_deg` so we evaluate it at `0, ..., =s_deg`. The prover skips\n626\t    // evaluation at `0` because the verifier can infer it from the previous round's\n627\t    // `s_{round-1}(r)` claim. The degree is constraint_degree + 1, where + 1 is from eq term\n628\t    let mle_rounds_span =\n629\t        info_span!(\"prover.rap_constraints.mle_rounds\", phase = \"prover\").entered();\n630\t    debug!(%s_deg);\n631\t    for round in 1..=n_max {\n632\t        let sp_round_evals = prover.sumcheck_polys_batch_eval(round, r[round - 1])?;\n633\t        let batch_s = prover.compute_batch_s_poly(sp_round_evals, num_traces, round, &mu_pows);\n634\t        let batch_s_evals = (1..=s_deg)\n635\t            .map(|i| batch_s.eval_at_point(EF::from_usize(i)))\n636\t            .collect_vec();\n637\t        for &eval in &batch_s_evals {\n638\t            transcript.observe_ext(eval);\n639\t        }\n640\t        sumcheck_round_polys.push(batch_s_evals);"}]},"parent_tool_use_id":"toolu_017Zaq9ARo5bBFNLVwx7o4Ct","session_id":"c8f518d6-4de0-4c05-9b5a-ade72ff81f39","uuid":"7f669790-9b8d-4d72-8ba5-dce1f7ef8be2","timestamp":"2026-04-14T14:51:50.715Z"}
