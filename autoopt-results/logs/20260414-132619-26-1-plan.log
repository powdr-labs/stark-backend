\t    let temp_sums_buffer_capacity = unsafe { _zerocheck_mle_temp_sums_buffer_size(num_x, num_y) };\n45\t    debug!(\"zerocheck:temp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n46\t    let mut temp_sums_buffer = DeviceBuffer::<EF>::with_capacity(temp_sums_buffer_capacity);\n47\t    let mut output = DeviceBuffer::<EF>::with_capacity(num_x as usize);\n48\t\n49\t    unsafe {\n50\t        zerocheck_eval_mle(\n51\t            &mut temp_sums_buffer,\n52\t            &mut output,\n53\t            eq_xi_ptr,\n54\t            sels_ptr,\n55\t            prep_ptr,\n56\t            d_main_ptrs.as_ptr(),\n57\t            lambda_pows.as_ptr(),\n58\t            lambda_pows.len(),\n59\t            public_ptr,\n60\t            rules.inner.d_rules.as_raw_ptr(),\n61\t            rules.inner.d_rules.len(),\n62\t            rules.inner.d_used_nodes.as_ptr(),\n63\t            rules.inner.d_used_nodes.len(),\n64\t            buffer_size,\n65\t            &mut intermediates,\n66\t            num_y,\n67\t            num_x,\n68\t        )?;\n69\t    }\n70\t    Ok(output)\n71\t}\n72\t\n73\t/// Evaluate MLE interactions on GPU.\n74\t///\n75\t/// Takes device pointers directly, avoiding H2D copies when data is already on device.\n76\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n77\t#[allow(clippy::too_many_arguments)]\n78\tpub fn evaluate_mle_interactions_gpu(\n79\t    eq_xi_ptr: *const EF,\n80\t    sels_ptr: *const EF,\n81\t    prep_ptr: MainMatrixPtrs<EF>,\n82\t    d_main_ptrs: &DeviceBuffer<MainMatrixPtrs<EF>>,\n83\t    public_ptr: *const F,\n84\t    challenges_ptr: *const EF,\n85\t    eq_3bs_ptr: *const EF,\n86\t    rules: &InteractionEvalRules,\n87\t    num_y: u32,\n88\t    num_x: u32,\n89\t) -> Result<DeviceBuffer<Frac<EF>>, KernelError> {\n90\t    let buffer_size = rules.inner.buffer_size;\n91\t    let intermed_capacity =\n92\t        unsafe { _logup_mle_intermediates_buffer_size(buffer_size, num_x, num_y) };\n93\t    let mut intermediat