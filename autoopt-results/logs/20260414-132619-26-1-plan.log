{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018BvQVUSwYFQBHanbndD4me","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    sync::Arc,\n15\t};\n16\t\n17\tuse itertools::{izip, Itertools};\n18\tuse openvm_cuda_common::{\n19\t    copy::{MemCopyD2H, MemCopyH2D},\n20\t    d_buffer::DeviceBuffer,\n21\t    error::{CudaError, MemCopyError},\n22\t    memory_manager::MemTracker,\n23\t    stream::current_stream_sync,\n24\t};\n25\tuse openvm_stark_backend::{\n26\t    air_builders::symbolic::SymbolicConstraints,\n27\t    calculate_n_logup,\n28\t    dft::Radix2BowersSerial,\n29\t    p3_matrix::dense::RowMajorMatrix,\n30\t    poly_common::{\n31\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n32\t        UnivariatePoly,\n33\t    },\n34\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n35\t    prover::{\n36\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n37\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n38\t        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n39\t    },\n40\t};\n41\tuse p3_dft::TwoAdicSubgroupDft;\n42\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n43\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n44\tuse rustc_hash::FxHashMap;\n45\tuse tracing::{debug, info, info_span, instrument};\n46\t\n47\tuse crate::{\n48\t    base::DeviceMatrix,\n49\t    cuda::{\n50\t        logup_zerocheck::{\n51\t            batched_interpolate_columns_gpu, fold_selectors_round0, InterpColDesc, MainMatrixPtrs,\n52\t        },\n53\t        sumcheck::batch_fold_mle,\n54\t    },\n55\t    data_transporter::transport_matrix_d2h_col_major,\n56\t    error::LogupZerocheckError,\n57\t    gpu_backend::GenericGpuBackend,\n58\t    hash_scheme::GpuHashScheme,\n59\t    cuda::logup_zerocheck::{\n60\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n61\t        _round0_extract_logup_polys, _round0_extract_zerocheck_poly,\n62\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n63\t    },\n64\t    logup_zerocheck::{\n65\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n66\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n67\t    },\n68\t    poly::EqEvalLayers,\n69\t    prelude::{EF, F},\n70\t    sponge::GpuFiatShamirTranscript,\n71\t    utils::compute_barycentric_inv_lagrange_denoms,\n72\t};\n73\t\n74\tpub(crate) mod batch_mle;\n75\tpub(crate) mod batch_mle_monomial;\n76\tmod errors;\n77\tpub(crate) mod fold_ple;\n78\t/// Fraction sumcheck via GKR\n79\tmod fractional;\n80\t/// Logup interaction evaluations for GKR input\n81\tmod gkr_input;\n82\tmod mle_round;\n83\tmod round0;\n84\tpub(crate) mod rules;\n85\t\n86\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n87\tuse batch_mle_monomial::{\n88\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n89\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n90\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n91\t};\n92\tpub use errors::*;\n93\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n94\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n95\tuse round0::evaluate_round0_constraints_gpu;\n96\t\n97\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n98\t/// More threads = more concurrent kernels but more peak GPU memory and more\n99\t/// MemoryManager mutex contention. 8 provides good SM utilization on the RTX 4090.\n100\tconst NUM_ROUND0_STREAMS: usize = 8;\n101\t\n102\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n103\t/// instead of the monomial kernel for high num_y traces.\n104\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n105\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n106\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n107\t\n108\t#[inline]\n109\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n110\t    if need_rot {\n111\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n112\t        (mat_width / 2) as u32\n113\t    } else {\n114\t        mat_width as u32\n115\t    }\n116\t}\n117\t\n118\t/// Pre-computed transformation matrices for GPU-side polynomial extraction in Round 0.\n119\t/// Captures the entire pipeline: transpose + iDFT + unshift + Lagrange interpolation\n120\t/// + coefficient adjustment (for zerocheck only).\n121\tstruct Round0ExtractTables {\n122\t    /// Zerocheck: maps eval values to final poly coefficients (with adjustment).\n123\t    /// Row-major [output_size × input_size].\n124\t    zc_transform: DeviceBuffer<EF>,\n125\t    zc_input_size: u32,\n126\t    zc_output_size: u32,\n127\t    /// Logup: maps eval values to poly coefficients (no adjustment).\n128\t    /// Row-major [size × size].\n129\t    logup_transform: DeviceBuffer<EF>,\n130\t    logup_size: u32,\n131\t}\n132\t\n133\t/// Compute transform matrices for a given constraint degree `d` and `l_skip`.\n134\t/// These are pre-computed on the CPU by running the polynomial extraction pipeline\n135\t/// on unit vectors, then uploaded to the GPU.\n136\tfn compute_round0_extract_tables(d: usize, l_skip: usize) -> Result<Round0ExtractTables, MemCopyError> {\n137\t    let skip_domain = 1usize << l_skip;\n138\t    let omega_root = F::two_adic_generator(log2_ceil_usize(d << l_skip));\n139\t\n140\t    // Zerocheck transform: input is (d-1)*skip_domain evals, output is sp_0_deg+1 coefficients\n141\t    let (zc_host, zc_in, zc_out) = {\n142\t        let w = d.saturating_sub(1); // num_cosets_zc\n143\t        if w == 0 {\n144\t            (vec![], 0u32, 0u32)\n145\t        } else {\n146\t            let input_size = w * skip_domain;\n147\t            let output_size = sumcheck_round0_deg(l_skip, d) + 1;\n148\t            let mut transform = vec![EF::ZERO; output_size * input_size];\n149\t            for j in 0..input_size {\n150\t                let src_c = j / skip_domain;\n151\t                let src_i = j % skip_domain;\n152\t                let mut values = EF::zero_vec(input_size);\n153\t                values[src_i * w + src_c] = EF::ONE; // transpose baked in\n154\t                let q = UnivariatePoly::<EF>::from_geometric_cosets_evals_idft(\n155\t                    RowMajorMatrix::new(values, w),\n156\t                    omega_root,\n157\t                    omega_root,\n158\t                );\n159\t                for i in 0..output_size {\n160\t                    let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n161\t                    if i >= skip_domain {\n162\t                        c += q.coeffs()[i - skip_domain];\n163\t                    }\n164\t                    transform[i * input_size + j] = c;\n165\t                }\n166\t            }\n167\t            (transform, input_size as u32, output_size as u32)\n168\t        }\n169\t    };\n170\t\n171\t    // Logup transform: input and output are both d*skip_domain\n172\t    let (logup_host, logup_sz) = {\n173\t        let w = d; // num_cosets_logup\n174\t        let size = w * skip_domain;\n175\t        let mut transform = vec![EF::ZERO; size * size];\n176\t        for j in 0..size {\n177\t            let src_c = j / skip_domain;\n178\t            let src_i = j % skip_domain;\n179\t            let mut values = EF::zero_vec(size);\n180\t            values[src_i * w + src_c] = EF::ONE;\n181\t            let poly = UnivariatePoly::<EF>::from_geometric_cosets_evals_idft(\n182\t                RowMajorMatrix::new(values, w),\n183\t                omega_root,\n184\t                F::ONE,\n185\t            );\n186\t            for i in 0..size {\n187\t                transform[i * size + j] = *poly.coeffs().get(i).unwrap_or(&EF::ZERO);\n188\t            }\n189\t        }\n190\t        (transform, size as u32)\n191\t    };\n192\t\n193\t    let d_zc = if zc_host.is_empty() {\n194\t        DeviceBuffer::new()\n195\t    } else {\n196\t        zc_host.to_device()?\n197\t    };\n198\t    let d_logup = logup_host.to_device()?;\n199\t\n200\t    Ok(Round0ExtractTables {"}]},"parent_tool_use_id":"toolu_017Zaq9ARo5bBFNLVwx7o4Ct","session_id":"c8f518d6-4de0-4c05-9b5a-ade72ff81f39","uuid":"57a9bf07-4a56-4287-b21d-d94089482daf","timestamp":"2026-04-14T14:51:47.050Z"}
