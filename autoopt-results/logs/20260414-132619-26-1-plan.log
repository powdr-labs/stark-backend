n1866\t\n1867\t        // DAG evaluation for high num_y traces with high monomial-to-rules ratio\n1868\t        if !high_dag_traces.is_empty() {\n1869\t            let lambda_pows = self.lambda_pows.as_ref().unwrap();\n1870\t            evaluate_zerocheck_batched(\n1871\t                high_dag_traces,\n1872\t                self.pk,\n1873\t                lambda_pows,\n1874\t                sp_deg as u32,\n1875\t                &mut zc_out,\n1876\t                self.memory_limit_bytes,\n1877\t            )\n1878\t            .map_err(LogupZerocheckError::MleConstraintEval)?;\n1879\t        }\n1880\t\n1881\t        // Par-Y monomial kernel for high num_y traces\n1882\t        if !high_mono_traces.is_empty() {\n1883\t            let lambda_combs: Vec<_> = high_mono_traces\n1884\t                .iter()\n1885\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1886\t                .collect();\n1887\t            let batch = ZerocheckMonomialParYBatch::new(\n1888\t                high_mono_traces,\n1889\t                self.pk,\n1890\t                &lambda_combs,\n1891\t                self.sm_count,\n1892\t                sp_deg as u32,\n1893\t                None,\n1894\t            )?;\n1895\t            let out = batch\n1896\t                .evaluate(sp_deg as u32)\n1897\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1898\t            let host = out.to_host()?;\n1899\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1900\t                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n1901\t            }\n1902\t        }\n1903\t\n1904\t        // Monomial zerocheck for low num_y traces\n1905\t        let low_mono_traces = low_early;\n1906\t        if !low_mono_traces.is_empty() {\n1907\t            let lambda_combs: Vec<_> = low_mono_traces\n1908\t                .iter()\n1909\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\