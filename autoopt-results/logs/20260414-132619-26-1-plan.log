_per_trace[meta.trace_idx];\n1731\t            let first_main_idx = usize::from(meta.has_preprocessed);\n1732\t            let eq_xi_tree = &self.eq_xis[&meta.n_lift];\n1733\t            let log_num_y = meta.n_lift - round;\n1734\t            let interpolated_height = sp_deg * meta.num_y;\n1735\t\n1736\t            let base_ptr = _keepalive_interpolated\n1737\t                .as_ref()\n1738\t                .unwrap()\n1739\t                .as_ptr()\n1740\t                .wrapping_add(meta.interp_offset);\n1741\t\n1742\t            let mut widths_so_far = 0usize;\n1743\t            let sels_ptr = base_ptr.wrapping_add(widths_so_far * interpolated_height);\n1744\t            widths_so_far += 3; // selector width is always 3\n1745\t\n1746\t            let prep_ptr = if meta.has_preprocessed {\n1747\t                MainMatrixPtrs {\n1748\t                    data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1749\t                    air_width: air_width_for_mat(meta.need_rot, mats[0].width()),\n1750\t                }\n1751\t            } else {\n1752\t                MainMatrixPtrs {\n1753\t                    data: std::ptr::null(),\n1754\t                    air_width: 0,\n1755\t                }\n1756\t            };\n1757\t            if meta.has_preprocessed {\n1758\t                widths_so_far += mats[0].width();\n1759\t            }\n1760\t            let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1761\t                .iter()\n1762\t                .map(|m| {\n1763\t                    let main_ptr = MainMatrixPtrs {\n1764\t                        data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1765\t                        air_width: air_width_for_mat(meta.need_rot, m.width()),\n1766\t                    };\n1767\t                    widths_so_far += m.width();\n1768\t                    main_ptr\n1769\t                })\n1770\t                .collect_vec();\n1771\t            debug_assert_eq!(width