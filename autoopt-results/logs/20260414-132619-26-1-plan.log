{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QYGK9bS9dVYxCSqocT9qGx","type":"tool_result","content":"38\t/// FFI binding for the `cudaMemcpyAsync` function on the default cuda stream.\n39\t///\n40\t/// # Safety\n41\t/// Must follow the rules of the `cudaMemcpyAsync` function from the CUDA runtime API.\n42\tpub unsafe fn cuda_memcpy<const SRC_DEVICE: bool, const DST_DEVICE: bool>(\n43\t    dst: *mut c_void,\n44\t    src: *const c_void,\n45\t    size_bytes: usize,\n46\t) -> Result<(), MemCopyError> {\n47\t    check(unsafe {\n48\t        cudaMemcpyAsync(\n49\t            dst,\n50\t            src,\n51\t            size_bytes,\n52\t            std::mem::transmute::<i32, cudaMemcpyKind>(\n53\t                if DST_DEVICE { 1 } else { 0 } + if SRC_DEVICE { 2 } else { 0 },\n54\t            ),\n55\t            cudaStreamPerThread,\n56\t        )\n57\t    })\n58\t    .map_err(MemCopyError::from)\n59\t}\n60\t\n61\t// Host -> Device\n62\tpub trait MemCopyH2D<T> {\n63\t    fn copy_to(&self, dst: &mut DeviceBuffer<T>) -> Result<(), MemCopyError>;\n64\t    fn to_device(&self) -> Result<DeviceBuffer<T>, MemCopyError>;\n65\t}\n66\t\n67\timpl<T> MemCopyH2D<T> for [T] {"}]},"parent_tool_use_id":"toolu_01B6PshVC9TeSKyqWgdvXfMu","session_id":"c8f518d6-4de0-4c05-9b5a-ade72ff81f39","uuid":"fc68b66e-9549-411b-8ce3-21063f7edddc","timestamp":"2026-04-14T15:00:17.960Z"}
