{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012KsWSaL7okSCi36BuW2j4T","type":"tool_result","content":"1\tuse std::{fmt::Debug, marker::PhantomData, sync::Arc};\n2\t\n3\tuse openvm_cuda_common::{copy::MemCopyD2H, d_buffer::DeviceBuffer, error::MemCopyError};\n4\tuse openvm_stark_backend::prover::MatrixDimensions;\n5\t\n6\tpub struct DeviceMatrix<T> {\n7\t    buffer: Arc<DeviceBuffer<T>>,\n8\t    height: usize,\n9\t    width: usize,\n10\t}\n11\t\n12\tunsafe impl<T> Send for DeviceMatrix<T> {}\n13\tunsafe impl<T> Sync for DeviceMatrix<T> {}\n14\t\n15\timpl<T> Clone for DeviceMatrix<T> {\n16\t    fn clone(&self) -> Self {\n17\t        Self {\n18\t            buffer: Arc::clone(&self.buffer),\n19\t            height: self.height,\n20\t            width: self.width,\n21\t        }\n22\t    }\n23\t}\n24\t\n25\timpl<T> Drop for DeviceMatrix<T> {\n26\t    fn drop(&mut self) {\n27\t        tracing::debug!(\n28\t            \"Dropping DeviceMatrix of size {} with Arc strong count={}\",\n29\t            self.buffer.len(),\n30\t            self.strong_count()\n31\t        );\n32\t    }\n33\t}\n34\t\n35\timpl<T> DeviceMatrix<T> {\n36\t    pub fn new(buffer: Arc<DeviceBuffer<T>>, height: usize, width: usize) -> Self {\n37\t        assert_ne!(\n38\t            height * width,\n39\t            0,\n40\t            \"Zero dimensions h {} w {} are wrong\",\n41\t            height,\n42\t            width\n43\t        );\n44\t        assert_eq!(\n45\t            buffer.len(),\n46\t            height * width,\n47\t            \"Buffer size must match dimensions\"\n48\t        );\n49\t        Self {\n50\t            buffer,\n51\t            height,\n52\t            width,\n53\t        }\n54\t    }\n55\t\n56\t    pub fn with_capacity(height: usize, width: usize) -> Self {\n57\t        Self {\n58\t            buffer: Arc::new(DeviceBuffer::with_capacity(height * width)),\n59\t            height,\n60\t            width,\n61\t        }\n62\t    }\n63\t\n64\t    pub fn dummy() -> Self {\n65\t        Self {\n66\t            buffer: Arc::new(DeviceBuffer::new()),\n67\t            height: 0,\n68\t            width: 0,\n69\t        }\n70\t    }\n71\t\n72\t    pub fn buffer(&self) -> &DeviceBuffer<T> {\n73\t        &self.buffer\n74\t    }\n75\t\n76\t    pub fn strong_count(&self) -> usize {\n77\t        Arc::strong_count(&self.buffer)\n78\t    }\n79\t\n80\t    pub fn as_view(&self) -> DeviceMatrixView<'_, T> {\n81\t        // SAFETY: buffer is borrowed for lifetime 'a of the view\n82\t        unsafe { DeviceMatrixView::from_raw_parts(self.buffer.as_ptr(), self.height, self.width) }\n83\t    }\n84\t}\n85\t\n86\timpl<T> MatrixDimensions for DeviceMatrix<T> {\n87\t    #[inline]\n88\t    fn height(&self) -> usize {\n89\t        self.height\n90\t    }\n91\t\n92\t    #[inline]\n93\t    fn width(&self) -> usize {\n94\t        self.width\n95\t    }\n96\t}\n97\t\n98\timpl<T> MemCopyD2H<T> for DeviceMatrix<T> {\n99\t    fn to_host(&self) -> Result<Vec<T>, MemCopyError> {\n100\t        self.buffer.to_host()\n101\t    }\n102\t}\n103\t\n104\timpl<T: Debug> Debug for DeviceMatrix<T> {\n105\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n106\t        write!(\n107\t            f,\n108\t            \"DeviceMatrix (height = {}, width = {}): {:?}\",\n109\t            self.height(),\n110\t            self.width(),\n111\t            self.buffer()\n112\t        )\n113\t    }\n114\t}\n115\t\n116\t/// View of a device matrix. Dropping does not free memory.\n117\t#[derive(Clone, Copy)]\n118\tpub struct DeviceMatrixView<'a, T> {\n119\t    ptr: *const T,\n120\t    height: usize,\n121\t    width: usize,\n122\t    _ptr_lifetime: PhantomData<&'a T>,\n123\t}\n124\t\n125\tunsafe impl<T> Send for DeviceMatrixView<'_, T> {}\n126\tunsafe impl<T> Sync for DeviceMatrixView<'_, T> {}\n127\t\n128\timpl<T> DeviceMatrixView<'_, T> {\n129\t    /// # Safety\n130\t    /// - The pointer must be valid for the lifetime of the view.\n131\t    /// - The pointer must have memory allocated for the following `height * width` elements of `T`.\n132\t    pub unsafe fn from_raw_parts(ptr: *const T, height: usize, width: usize) -> Self {\n133\t        Self {\n134\t            ptr,\n135\t            height,\n136\t            width,\n137\t            _ptr_lifetime: PhantomData,\n138\t        }\n139\t    }\n140\t\n141\t    pub fn as_ptr(&self) -> *const T {\n142\t        self.ptr\n143\t    }\n144\t}\n145\t\n146\timpl<T> MatrixDimensions for DeviceMatrixView<'_, T> {\n147\t    #[inline]\n148\t    fn height(&self) -> usize {\n149\t        self.height\n150\t    }\n151\t\n152\t    #[inline]\n153\t    fn width(&self) -> usize {\n154\t        self.width\n155\t    }\n156\t}\n157\t\n158\t/// The following trait and types are borrowed from [halo2](https:://github.com/zcash/halo2).\n159\t/// The basis over which a polynomial is described.\n160\tpub trait Basis: Copy + Debug + Send + Sync {}\n161\t\n162\t/// The polynomial is defined as coefficients\n163\t#[derive(Clone, Copy, Debug)]\n164\tpub struct Coeff;\n165\timpl Basis for Coeff {}\n166\t\n167\t/// The polynomial is defined as coefficients of Lagrange basis polynomials\n168\t#[derive(Clone, Copy, Debug)]\n169\tpub struct LagrangeCoeff;\n170\timpl Basis for LagrangeCoeff {}\n171\t\n172\t/// The polynomial is defined as coefficients of Lagrange basis polynomials in\n173\t/// an extended size domain which supports multiplication\n174\t#[derive(Clone, Copy, Debug)]\n175\tpub struct ExtendedLagrangeCoeff;\n176\timpl Basis for ExtendedLagrangeCoeff {}\n177\t\n178\tpub struct DevicePoly<T, B> {\n179\t    pub is_bit_reversed: bool,\n180\t    pub coeff: DeviceBuffer<T>,\n181\t    _marker: PhantomData<B>,\n182\t}\n183\t\n184\timpl<T, B> DevicePoly<T, B> {\n185\t    pub fn new(is_bit_reversed: bool, coeff: DeviceBuffer<T>) -> Self {\n186\t        Self {\n187\t            is_bit_reversed,\n188\t            coeff,\n189\t            _marker: PhantomData,\n190\t        }\n191\t    }\n192\t\n193\t    #[inline]\n194\t    pub fn len(&self) -> usize {\n195\t        self.coeff.len()\n196\t    }\n197\t\n198\t    #[inline]\n199\t    pub fn is_empty(&self) -> bool {\n200\t        self.len() == 0\n201\t    }\n202\t}\n203\t\n204\t#[cfg(test)]\n205\tmod tests {\n206\t    use super::*;\n207\t\n208\t    #[test]\n209\t    fn test_device_matrix() {\n210\t        let buffer = Arc::new(DeviceBuffer::<i32>::with_capacity(12));\n211\t        let matrix = DeviceMatrix::<i32>::new(buffer, 3, 4);\n212\t        assert_eq!(matrix.height(), 3);\n213\t        assert_eq!(matrix.width(), 4);\n214\t    }\n215\t}\n216\t"}]},"parent_tool_use_id":"toolu_01Rb1ToMNTPVjYSi67xrAiL7","session_id":"d2c41f48-5b80-4de8-b307-355a7b8c0ec2","uuid":"199f525a-344e-47f7-a897-06aff793df75","timestamp":"2026-04-14T15:14:19.669Z"}
