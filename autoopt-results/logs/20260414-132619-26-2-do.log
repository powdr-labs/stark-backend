lse {\n1608\t                        MainMatrixPtrs {\n1609\t                            data: std::ptr::null(),\n1610\t                            air_width: 0,\n1611\t                        }\n1612\t                    };\n1613\t                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1614\t                        .iter()\n1615\t                        .map(|m| MainMatrixPtrs {\n1616\t                            data: m.buffer().as_ptr(),\n1617\t                            air_width: air_width_for_mat(need_rot, m.width()),\n1618\t                        })\n1619\t                        .collect_vec();\n1620\t                    let main_ptrs_dev = main_ptrs.to_device()?;\n1621\t\n1622\t                    late_eval.push(TraceCtx {\n1623\t                        trace_idx,\n1624\t                        air_idx,\n1625\t                        n_lift,\n1626\t                        num_y: 1,\n1627\t                        has_constraints,\n1628\t                        has_interactions,\n1629\t                        norm_factor,\n1630\t                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n1631\t                        sels_ptr: sels.buffer().as_ptr(),\n1632\t                        prep_ptr,\n1633\t                        main_ptrs_dev,\n1634\t                        public_ptr: public_vals.as_ptr(),\n1635\t                        eq_3bs_ptr: eq_3bs.as_ptr(),\n1636\t                    });\n1637\t                } else {\n1638\t                    // A.2: scale tilde evals only\n1639\t                    if has_constraints {\n1640\t                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n1641\t                        *tilde_eval *= r_prev;\n1642\t                    }\n1643\t                    if has_interactions {\n1644\t                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n1645\t                            *x *= r_prev;\n1646\t                        }\n1647\t                    }\n1648\t                }\n1649\t            } else {\n1650\t                // Case B: collect metadata for batched interpolation\n1651\t                let log_num_y = n_lift - round;\n1652\t                let num_y = 1 << log_num_y;\n1653\t                let height = 2 * num_y;\n1654\t                debug_assert_eq!(height, mats[0].height());\n1655\t\n1656\t                let col_start = all_columns.len();\n1657\t                // Collect all column pointers: selectors + all matrices (preprocessed + mains)\n1658\t                all_columns.extend(\n1659\t                    iter::once(sels)\n1660\t                        .chain(mats.iter())\n1661\t                        .flat_map(|m| {\n1662\t                            assert_eq!(m.height(), height);\n1663\t                            (0..m.width())\n1664\t                                .map(|col| m.buffer().as_ptr().wrapping_add(col * m.height()))\n1665\t                        }),\n1666\t                );\n1667\t                let num_columns = all_columns.len() - col_start;\n1668\t                let interp_size = sp_deg * num_y * num_columns;\n1669\t\n1670\t                case_b_traces.push(CaseBMeta {\n1671\t                    trace_idx,\n1672\t                    air_idx,\n1673\t                    n_lift,\n1674\t                    num_y,\n1675\t                    num_columns,\n1676\t                    interp_offset: total_interp_elems,\n1677\t                    col_start,\n1678\t                    has_preprocessed,\n1679\t                    need_rot,\n1680\t                    has_constraints,\n1681\t                    has_interactions,\n1682\t                    norm_factor,\n1683\t                });\n1684\t                total_interp_elems += interp_size;\n1685\t            }\n1686\t        }\n1687\t\n1688\t        // ── Phase 2: Batch allocate + single kernel launch ──\n1689\t        // One big buffer for all interpolated data, one kernel launch for all Case B traces.\n1690\t        let _keepalive_interpolated = if !case_b_traces.is_empty() {\n1691\t            let big_buf = DeviceBuffer::<EF>::with_capacity(total_interp_elems);\n1692\t            let big_ptr = big_buf.as_mut_ptr();\n1693\t\n1694\t            // Build descriptors with multi-block-per-trace assignment\n1695\t            const THREADS_PER_BLOCK: u32 = 512;\n1696\t            let mut block_offset: u32 = 0;\n1697\t            let descs: Vec<InterpColDesc> = case_b_traces\n1698\t                .iter()\n1699\t                .map(|meta| {\n1700\t                    let total_threads = (meta.num_y * meta.num_columns) as u32;\n1701\t                    let blocks = total_threads.div_ceil(THREADS_PER_BLOCK);\n1702\t                    let desc = InterpColDesc {\n1703\t                        output: unsafe { big_ptr.add(meta.interp_offset) },\n1704\t                        columns_offset: meta.col_start as u32,\n1705\t                        num_y: meta.num_y as u32,\n1706\t                        num_columns: meta.num_columns as u32,\n1707\t                        total_threads,\n1708\t                        block_start: block_offset,\n1709\t                    };"}]},"parent_tool_use_id":null,"session_id":"d2c41f48-5b80-4de8-b307-355a7b8c0ec2","uuid":"72e559e8-cbed-4bd5-8119-3170f6815c9f","timestamp":"2026-04-14T15:10:05.210Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/mod.rs","content":"    #[instrument(\n        name = \"LogupZerocheck::sumcheck_polys_batch_eval\",\n        level = \"info\",\n        skip_all,\n        fields(round = round)\n    )]\n    fn sumcheck_polys_batch_eval(\n        &mut self,\n        round: usize,\n        r_prev: EF,\n    ) -> Result<Vec<Vec<EF>>, LogupZerocheckError> {\n        let sp_deg = self.constraint_degree;\n\n        // Per-trace outputs (filled as we go)\n        let mut zc_out: Vec<Vec<EF>> = vec![vec![EF::ZERO; sp_deg]; self.n_per_trace.len()];\n        let mut logup_out: Vec<[Vec<EF>; 2]> =\n            vec![[vec![EF::ZERO; sp_deg], vec![EF::ZERO; sp_deg]]; self.n_per_trace.len()];\n\n        let mut late_eval: Vec<TraceCtx> = Vec::new(); // round == n_lift + 1\n        let mut early_eval: Vec<TraceCtx> = Vec::new(); // round <= n_lift\n\n        // ── Phase 1: Collect metadata, split into Case A / Case B (no CUDA calls) ──\n        // For Case B traces, we collect column pointers and sizing info to batch the\n        // interpolation into a single kernel launch.\n        struct CaseBMeta {\n            trace_idx: usize,\n            air_idx: usize,\n            n_lift: usize,\n            num_y: usize,\n            num_columns: usize, // total columns (selectors + preprocessed + mains)\n            interp_offset: usize, // element offset within the big interpolated buffer\n            col_start: usize,   // start index in the flat all_columns array\n            has_preprocessed: bool,\n            need_rot: bool,\n            has_constraints: bool,\n            has_interactions: bool,\n            norm_factor: F,\n        }\n        let mut case_b_traces: Vec<CaseBMeta> = Vec::new();\n        let mut all_columns: Vec<*const EF> = Vec::new();\n        let mut total_interp_elems: usize = 0;\n\n        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n            self.n_per_trace.iter(),\n            self.mat_evals_per_trace.iter(),\n            self.sels_per_trace.iter(),\n            self.d_eq_3b_per_trace.iter(),\n            self.public_values_per_trace.iter(),\n            self.air_indices_per_trace.iter()\n        )\n        .enumerate()\n        {\n            let pk = &self.pk.per_air[air_idx];\n            let dag = &pk.vk.symbolic_constraints;\n            let has_constraints = dag.constraints.num_constraints() > 0;\n            let has_interactions = !dag.interactions.is_empty();\n            if !has_constraints && !has_interactions {\n                continue;\n            }\n\n            let n_lift = n.max(0) as usize;\n            let norm_factor_denom = 1 << (-n).max(0);\n            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n            let has_preprocessed = pk.preprocessed_data.is_some();\n            let need_rot = pk.vk.params.need_rot;\n            let first_main_idx = usize::from(has_preprocessed);\n            let eq_xi_tree = &self.eq_xis[&n_lift];\n\n            if round > n_lift {\n                // Case A\n                if round == n_lift + 1 {\n                    // A.1: evaluate directly at (num_x=1, num_y=1)\n                    let prep_ptr = if has_preprocessed {\n                        MainMatrixPtrs {\n                            data: mats[0].buffer().as_ptr(),\n                            air_width: air_width_for_mat(need_rot, mats[0].width()),\n                        }\n                    } else {\n                        MainMatrixPtrs {\n                            data: std::ptr::null(),\n                            air_width: 0,\n                        }\n                    };\n                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n                        .iter()\n                        .map(|m| MainMatrixPtrs {\n                            data: m.buffer().as_ptr(),\n                            air_width: air_width_for_mat(need_rot, m.width()),\n                        })\n                        .collect_vec();\n                    let main_ptrs_dev = main_ptrs.to_device()?;\n\n                    late_eval.push(TraceCtx {\n                        trace_idx,\n                        air_idx,\n                        n_lift,\n                        num_y: 1,\n                        has_constraints,\n                        has_interactions,\n                        norm_factor,\n                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n                        sels_ptr: sels.buffer().as_ptr(),\n                        prep_ptr,\n                        main_ptrs_dev,\n                        public_ptr: public_vals.as_ptr(),\n                        eq_3bs_ptr: eq_3bs.as_ptr(),\n                    });\n                } else {\n                    // A.2: scale tilde evals only\n                    if has_constraints {\n                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n                        *tilde_eval *= r_prev;\n                    }\n                    if has_interactions {\n                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n                            *x *= r_prev;\n                        }\n                    }\n                }\n            } else {\n                // Case B: collect metadata for batched interpolation\n                let log_num_y = n_lift - round;\n                let num_y = 1 << log_num_y;\n                let height = 2 * num_y;\n                debug_assert_eq!(height, mats[0].height());\n\n                let col_start = all_columns.len();\n                // Collect all column pointers: selectors + all matrices (preprocessed + mains)\n                all_columns.extend(\n                    iter::once(sels)\n                        .chain(mats.iter())\n                        .flat_map(|m| {\n                            assert_eq!(m.height(), height);\n                            (0..m.width())\n                                .map(|col| m.buffer().as_ptr().wrapping_add(col * m.height()))\n                        }),\n                );\n                let num_columns = all_columns.len() - col_start;\n                let interp_size = sp_deg * num_y * num_columns;\n\n                case_b_traces.push(CaseBMeta {\n                    trace_idx,\n                    air_idx,\n                    n_lift,\n                    num_y,\n                    num_columns,\n                    interp_offset: total_interp_elems,\n                    col_start,\n                    has_preprocessed,\n                    need_rot,\n                    has_constraints,\n                    has_interactions,\n                    norm_factor,\n                });\n                total_interp_elems += interp_size;\n            }\n        }\n\n        // ── Phase 2: Batch allocate + single kernel launch ──\n        // One big buffer for all interpolated data, one kernel launch for all Case B traces.\n        let _keepalive_interpolated = if !case_b_traces.is_empty() {\n            let big_buf = DeviceBuffer::<EF>::with_capacity(total_interp_elems);\n            let big_ptr = big_buf.as_mut_ptr();\n\n            // Build descriptors with multi-block-per-trace assignment\n            const THREADS_PER_BLOCK: u32 = 512;\n            let mut block_offset: u32 = 0;\n            let descs: Vec<InterpColDesc> = case_b_traces\n                .iter()\n                .map(|meta| {\n                    let total_threads = (meta.num_y * meta.num_columns) as u32;\n                    let blocks = total_threads.div_ceil(THREADS_PER_BLOCK);\n                    let desc = InterpColDesc {\n                        output: unsafe { big_ptr.add(meta.interp_offset) },\n                        columns_offset: meta.col_start as u32,\n                        num_y: meta.num_y as u32,\n                        num_columns: meta.num_columns as u32,\n                        total_threads,\n                        block_start: block_offset,\n                    };","numLines":180,"startLine":1530,"totalLines":2197}}}
