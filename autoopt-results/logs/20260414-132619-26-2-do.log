{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SW2fLRcAVuTURXzvzJLr7M","type":"tool_result","content":"1\tuse std::{cmp::max, fmt::Debug, sync::Arc};\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::{\n5\t    copy::{cuda_memcpy, MemCopyD2H, MemCopyH2D},\n6\t    d_buffer::DeviceBuffer,\n7\t    error::MemCopyError,\n8\t    stream::current_stream_sync,\n9\t};\n10\tuse openvm_stark_backend::{\n11\t    keygen::types::MultiStarkProvingKey,\n12\t    p3_matrix::{dense::RowMajorMatrix, Matrix},\n13\t    prover::{\n14\t        stacked_pcs::{MerkleTree, StackedPcsData},\n15\t        AirProvingContext, ColMajorMatrix, CommittedTraceData, CpuColMajorBackend,\n16\t        DeviceDataTransporter, DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions,\n17\t        MatrixView, ProvingContext,\n18\t    },\n19\t};\n20\tuse tracing::{debug, info_span};\n21\t\n22\tuse crate::{\n23\t    base::DeviceMatrix,\n24\t    cuda::matrix::{collapse_strided_matrix, matrix_transpose_fp},\n25\t    gpu_backend::GenericGpuBackend,\n26\t    hash_scheme::GpuHashScheme,\n27\t    merkle_tree::MerkleTreeGpu,\n28\t    poly::PleMatrix,\n29\t    prelude::{Digest, F, SC},\n30\t    stacked_pcs::StackedPcsDataGpu,\n31\t    AirDataGpu, GpuBackend, GpuDevice, GpuProverConfig, ProverError,\n32\t};\n33\t\n34\timpl<HS: GpuHashScheme> DeviceDataTransporter<HS::SC, GenericGpuBackend<HS>> for GpuDevice {\n35\t    fn transport_pk_to_device(\n36\t        &self,\n37\t        mpk: &MultiStarkProvingKey<HS::SC>,\n38\t    ) -> DeviceMultiStarkProvingKey<GenericGpuBackend<HS>> {\n39\t        let _span = info_span!(\"transport_pk_to_device\").entered();\n40\t        let per_air = mpk\n41\t            .per_air\n42\t            .iter()\n43\t            .map(|pk| {\n44\t                let preprocessed_data = pk.preprocessed_data.as_ref().map(|d| {\n45\t                    transport_and_unstack_single_data_h2d::<HS>(d.as_ref(), &self.prover_config)\n46\t                        .unwrap()\n47\t                });\n48\t                let other_data = AirDataGpu::new(pk).unwrap();\n49\t                let num_monomials = other_data\n50\t                    .zerocheck_monomials\n51\t                    .as_ref()\n52\t                    .map(|m| m.num_monomials)\n53\t                    .unwrap_or(0);\n54\t                debug!(air = %pk.air_name, num_monomials, \"monomial expansion\");\n55\t\n56\t                DeviceStarkProvingKey {\n57\t                    air_name: pk.air_name.clone(),\n58\t                    vk: pk.vk.clone(),\n59\t                    preprocessed_data,\n60\t                    other_data,\n61\t                }\n62\t            })\n63\t            .collect();\n64\t        // Synchronize in case the proving key is shared between threads/streams\n65\t        current_stream_sync().unwrap();\n66\t\n67\t        DeviceMultiStarkProvingKey::new(\n68\t            per_air,\n69\t            mpk.trace_height_constraints.clone(),\n70\t            mpk.max_constraint_degree,\n71\t            mpk.params.clone(),\n72\t            mpk.vk_pre_hash,\n73\t        )\n74\t    }\n75\t\n76\t    fn transport_matrix_to_device(&self, matrix: &ColMajorMatrix<F>) -> DeviceMatrix<F> {\n77\t        transport_matrix_h2d_col_major(matrix).unwrap()\n78\t    }\n79\t\n80\t    fn transport_pcs_data_to_device(\n81\t        &self,\n82\t        pcs_data: &StackedPcsData<F, HS::Digest>,\n83\t    ) -> StackedPcsDataGpu<F, HS::Digest> {\n84\t        transport_pcs_data_h2d::<HS::Digest>(pcs_data, &self.prover_config).unwrap()\n85\t    }\n86\t\n87\t    fn transport_matrix_from_device_to_host(&self, matrix: &DeviceMatrix<F>) -> ColMajorMatrix<F> {\n88\t        transport_matrix_d2h_col_major(matrix).unwrap()\n89\t    }\n90\t}\n91\t\n92\tpub fn transport_matrix_h2d_col_major<T>(\n93\t    matrix: &ColMajorMatrix<T>,\n94\t) -> Result<DeviceMatrix<T>, MemCopyError> {\n95\t    // matrix is already col-major, so this is just H2D buffer transfer\n96\t    let buffer = matrix.values.to_device()?;\n97\t    Ok(DeviceMatrix::new(\n98\t        Arc::new(buffer),\n99\t        matrix.height(),\n100\t        matrix.width(),\n101\t    ))\n102\t}\n103\t\n104\tpub fn transport_matrix_h2d_row(\n105\t    matrix: &RowMajorMatrix<F>,\n106\t) -> Result<DeviceMatrix<F>, MemCopyError> {\n107\t    let data = matrix.values.as_slice();\n108\t    let input_buffer = data.to_device().unwrap();\n109\t    let output = DeviceMatrix::<F>::with_capacity(Matrix::height(matrix), Matrix::width(matrix));\n110\t    unsafe {\n111\t        matrix_transpose_fp(\n112\t            output.buffer(),\n113\t            &input_buffer,\n114\t            Matrix::width(matrix),\n115\t            Matrix::height(matrix),\n116\t        )?;\n117\t    }\n118\t    assert_eq!(output.strong_count(), 1);\n119\t    Ok(output)\n120\t}\n121\t\n122\t/// `d` must be the stacked pcs data of a single trace matrix.\n123\t/// This function will transport `d` to device and then unstack it (allocating device memory) to\n124\t/// return `CommittedTraceData<F, Digest>`.\n125\tpub fn transport_and_unstack_single_data_h2d<HS: GpuHashScheme>(\n126\t    d: &StackedPcsData<F, HS::Digest>,\n127\t    prover_config: &GpuProverConfig,\n128\t) -> Result<CommittedTraceData<GenericGpuBackend<HS>>, ProverError> {\n129\t    let _span = info_span!(\"transport_unstack_h2d\").entered();\n130\t    debug_assert!(d\n131\t        .layout\n132\t        .sorted_cols\n133\t        .iter()\n134\t        .all(|(mat_idx, _, _)| *mat_idx == 0));\n135\t    let l_skip = d.layout.l_skip();\n136\t    let trace_view = d.mat_view(0);\n137\t    let height = trace_view.height();\n138\t    let width = trace_view.width();\n139\t    let stride = trace_view.stride();\n140\t    let lifted_height = height * stride;\n141\t    debug_assert_eq!(lifted_height, max(height, 1 << l_skip));\n142\t    debug_assert_eq!(lifted_height * width, trace_view.values().len());\n143\t    debug_assert!(d.matrix.values.len() >= lifted_height * width);\n144\t    let stacked_width = d.matrix.width();\n145\t    let stacked_height = d.matrix.height();\n146\t    let d_matrix_evals = d.matrix.values.to_device()?;\n147\t    let strided_trace = DeviceBuffer::<F>::with_capacity(lifted_height * width);\n148\t    // SAFETY: D2D copy\n149\t    // - `d_matrix_evals` is the stacked matrix, guaranteed to have length `>= lifted_height *\n150\t    //   width` by definition of stacking\n151\t    // - `d_matrix_evals` stacks a single trace matrix\n152\t    unsafe {\n153\t        cuda_memcpy::<true, true>(\n154\t            strided_trace.as_mut_raw_ptr(),\n155\t            d_matrix_evals.as_raw_ptr(),\n156\t            lifted_height * width * size_of::<F>(),\n157\t        )?;\n158\t    }\n159\t    let trace_buffer = if stride == 1 {\n160\t        strided_trace\n161\t    } else {\n162\t        let buf = DeviceBuffer::<F>::with_capacity(height * width);\n163\t        unsafe {\n164\t            collapse_strided_matrix(\n165\t                buf.as_mut_ptr(),\n166\t                strided_trace.as_ptr(),\n167\t                width as u32,\n168\t                height as u32,\n169\t                stride as u32,\n170\t            )\n171\t            .map_err(ProverError::CollapseStrided)?;\n172\t        }\n173\t        // Wait for kernel to finish so we can safely drop strided_trace\n174\t        current_stream_sync().map_err(ProverError::CurrentStreamSync)?;\n175\t        drop(strided_trace);\n176\t        buf\n177\t    };\n178\t    let d_matrix = prover_config\n179\t        .cache_stacked_matrix\n180\t        .then(|| PleMatrix::from_evals(l_skip, d_matrix_evals, stacked_height, stacked_width));\n181\t    let d_tree = transport_merkle_tree_h2d(&d.tree, prover_config.cache_rs_code_matrix)?;\n182\t    let d_data = StackedPcsDataGpu {\n183\t        layout: d.layout.clone(),\n184\t        matrix: d_matrix,\n185\t        tree: d_tree,\n186\t    };\n187\t    // Sanity check. Not a strong assert because we transport the merkle tree\n188\t    // instead of recomputing it above.\n189\t    assert!(\n190\t        d_data.tree.root() == d.commit().unwrap(),\n191\t        \"transported tree root mismatch\"\n192\t    );\n193\t    Ok(CommittedTraceData {\n194\t        commitment: d.commit().unwrap(),\n195\t        trace: DeviceMatrix::new(Arc::new(trace_buffer), height, width),\n196\t        data: Arc::new(d_data),\n197\t    })\n198\t}\n199\t\n200\t/// Transports backing matrix and tree digest layers from host to device.\n201\tpub fn transport_merkle_tree_h2d<F, Digest: Clone>(\n202\t    tree: &MerkleTree<F, Digest>,\n203\t    cache_backing_matrix: bool,\n204\t) -> Result<MerkleTreeGpu<F, Digest>, MemCopyError> {\n205\t    let backing_matrix = if cache_backing_matrix {\n206\t        Some(transport_matrix_h2d_col_major(tree.backing_matrix())?)\n207\t    } else {\n208\t        None\n209\t    };\n210\t    let digest_layers = tree\n211\t        .digest_layers()\n212\t        .iter()\n213\t        .map(|layer| layer.to_device())\n214\t        .collect::<Result<Vec<_>, _>>()?;\n215\t    Ok(MerkleTreeGpu {\n216\t        backing_matrix,\n217\t        digest_layers,\n218\t        rows_per_query: tree.rows_per_query(),\n219\t        root: tree.root().unwrap(),\n220\t    })\n221\t}\n222\t\n223\tpub fn transport_pcs_data_h2d<D: Copy + Clone + PartialEq + Send + Sync + 'static>(\n224\t    pcs_data: &StackedPcsData<F, D>,\n225\t    prover_config: &GpuProverConfig,\n226\t) -> Result<StackedPcsDataGpu<F, D>, ProverError> {\n227\t    let _span = info_span!(\"transport_pcs_data_h2d\").entered();\n228\t    let StackedPcsData {\n229\t        layout,\n230\t        matrix,\n231\t        tree,\n232\t    } = pcs_data;\n233\t    let width = matrix.width();\n234\t    let height = matrix.height();\n235\t    let d_matrix_evals = matrix.values.to_device()?;\n236\t    let d_matrix = prover_config\n237\t        .cache_stacked_matrix\n238\t        .then(|| PleMatrix::from_evals(layout.l_skip(), d_matrix_evals, height, width));\n239\t    let d_tree = transport_merkle_tree_h2d(tree, prover_config.cache_rs_code_matrix)?;\n240\t\n241\t    Ok(StackedPcsDataGpu {\n242\t        layout: layout.clone(),\n243\t        matrix: d_matrix,\n244\t        tree: d_tree,\n245\t    })\n246\t}\n247\t\n248\tpub fn transport_air_proving_ctx_to_device<HS: GpuHashScheme>(\n249\t    cpu_ctx: AirProvingContext<CpuColMajorBackend<SC>>,\n250\t) -> AirProvingContext<GenericGpuBackend<HS>> {\n251\t    let _span = info_span!(\"transport_air_ctx_h2d\").entered();\n252\t    assert!(\n253\t        cpu_ctx.cached_mains.is_empty(),\n254\t        \"CPU to GPU transfer of cached traces not supported\"\n255\t    );\n256\t    let trace = transport_matrix_h2d_col_major(&cpu_ctx.common_main).unwrap();\n257\t    AirProvingContext {\n258\t        cached_mains: vec![],\n259\t        common_main: trace,\n260\t        public_values: cpu_ctx.public_values,\n261\t    }\n262\t}\n263\t\n264\tpub fn transport_proving_ctx_to_host(\n265\t    gpu_ctx: ProvingContext<GpuBackend>,\n266\t    l_skip: usize,\n267\t) -> ProvingContext<CpuColMajorBackend<SC>> {\n268\t    let per_trace = gpu_ctx\n269\t        .per_trace\n270\t        .into_iter()\n271\t        .map(|(i, ctx)| (i, transport_air_proving_ctx_to_host(ctx, l_skip)))\n272\t        .collect_vec();\n273\t    ProvingContext { per_trace }\n274\t}\n275\t\n276\tpub fn transport_air_proving_ctx_to_host(\n277\t    gpu_ctx: AirProvingContext<GpuBackend>,\n278\t    l_skip: usize,\n279\t) -> AirProvingContext<CpuColMajorBackend<SC>> {\n280\t    let trace = transport_matrix_d2h_col_major(&gpu_ctx.common_main).unwrap();\n281\t    let cached_mains = gpu_ctx\n282\t        .cached_mains\n283\t        .into_iter()\n284\t        .map(|mat| {\n285\t            // WARNING: By default this matrix isn't cached. For this to work, ensure that\n286\t            // GpuProverConfig fields cache_stacked_matrix and cache_rs_code_matrix are set\n287\t            // to be true.\n288\t            let evals_matrix = mat.data.matrix.as_ref().unwrap().to_evals(l_skip).unwrap();\n289\t            CommittedTraceData {\n290\t                commitment: mat.commitment,\n291\t                trace: transport_matrix_d2h_col_major(&mat.trace).unwrap(),\n292\t                data: Arc::new(StackedPcsData {\n293\t                    layout: mat.data.layout.clone(),\n294\t                    matrix: transport_matrix_d2h_col_major(&evals_matrix).unwrap(),\n295\t                    tree: transport_merkle_tree_to_host(&mat.data.tree),\n296\t                }),\n297\t            }\n298\t        })\n299\t        .collect_vec();\n300\t    AirProvingContext {\n301\t        cached_mains,\n302\t        common_main: trace,\n303\t        public_values: gpu_ctx.public_values,\n304\t    }\n305\t}\n306\t\n307\tpub fn transport_matrix_d2h_col_major<T>(\n308\t    matrix: &DeviceMatrix<T>,\n309\t) -> Result<ColMajorMatrix<T>, MemCopyError> {\n310\t    let values_host = matrix.buffer().to_host()?;\n311\t    Ok(ColMajorMatrix::new(values_host, matrix.width()))\n312\t}\n313\t\n314\tpub fn transport_matrix_d2h_row_major(\n315\t    matrix: &DeviceMatrix<F>,\n316\t) -> Result<RowMajorMatrix<F>, MemCopyError> {\n317\t    let matrix_buffer = DeviceBuffer::<F>::with_capacity(matrix.height() * matrix.width());\n318\t    unsafe {\n319\t        matrix_transpose_fp(\n320\t            &matrix_buffer,\n321\t            matrix.buffer(),\n322\t            matrix.height(),\n323\t            matrix.width(),\n324\t        )?;\n325\t    }\n326\t    Ok(RowMajorMatrix::<F>::new(\n327\t        matrix_buffer.to_host()?,\n328\t        matrix.width(),\n329\t    ))\n330\t}\n331\t\n332\t/// For debugging purposes only.\n333\t///\n334\t/// # Panics\n335\t/// If `tree.backing_matrix` is `None`.\n336\tpub fn transport_merkle_tree_to_host(tree: &MerkleTreeGpu<F, Digest>) -> MerkleTree<F, Digest> {\n337\t    let backing_matrix =\n338\t        transport_matrix_d2h_col_major(tree.backing_matrix.as_ref().unwrap()).unwrap();\n339\t    let digest_layers = tree\n340\t        .digest_layers\n341\t        .iter()\n342\t        .map(|layer| layer.to_host().unwrap())\n343\t        .collect_vec();\n344\t    // Safety: assuming the tree is properly constructed on device, the layers are correct after D2H\n345\t    // transfer.\n346\t    unsafe {\n347\t        MerkleTree::<F, Digest>::from_raw_parts(backing_matrix, digest_layers, tree.rows_per_query)\n348\t    }\n349\t}\n350\t\n351\tpub fn assert_eq_host_and_device_matrix_col_maj<T: Clone + Send + Sync + PartialEq + Debug>(\n352\t    cpu: &ColMajorMatrix<T>,\n353\t    gpu: &DeviceMatrix<T>,\n354\t) {\n355\t    assert_eq!(gpu.width(), cpu.width());\n356\t    assert_eq!(gpu.height(), cpu.height());\n357\t    let gpu = gpu.to_host().unwrap();\n358\t    for r in 0..cpu.height() {\n359\t        for c in 0..cpu.width() {\n360\t            assert_eq!(\n361\t                gpu[c * cpu.height() + r],\n362\t                *cpu.get(r, c).unwrap(),\n363\t                \"Mismatch at row {} column {}\",\n364\t                r,\n365\t                c\n366\t            );\n367\t        }\n368\t    }\n369\t}\n370\t\n371\tpub fn assert_eq_device_matrix<T: Clone + Send + Sync + PartialEq + Debug>(\n372\t    a: &DeviceMatrix<T>,\n373\t    b: &DeviceMatrix<T>,\n374\t) {\n375\t    assert_eq!(a.height(), b.height());\n376\t    assert_eq!(a.width(), b.width());\n377\t    assert_eq!(a.buffer().len(), b.buffer().len());\n378\t    let a_host = a.to_host().unwrap();\n379\t    let b_host = b.to_host().unwrap();\n380\t    for r in 0..a.height() {\n381\t        for c in 0..a.width() {\n382\t            assert_eq!(\n383\t                a_host[c * a.height() + r],\n384\t                b_host[c * b.height() + r],\n385\t                \"Mismatch at row {} column {}\",\n386\t                r,\n387\t                c\n388\t            );\n389\t        }\n390\t    }\n391\t}\n392\t\n393\tpub fn assert_eq_host_and_device_matrix<T: Clone + Send + Sync + PartialEq + Debug>(\n394\t    cpu: Arc<RowMajorMatrix<T>>,\n395\t    gpu: &DeviceMatrix<T>,\n396\t) {\n397\t    assert_eq!(gpu.width(), Matrix::width(cpu.as_ref()));\n398\t    assert_eq!(gpu.height(), Matrix::height(cpu.as_ref()));\n399\t    let gpu = gpu.to_host().unwrap();\n400\t    for r in 0..Matrix::height(cpu.as_ref()) {\n401\t        for c in 0..Matrix::width(cpu.as_ref()) {\n402\t            assert_eq!(\n403\t                gpu[c * Matrix::height(cpu.as_ref()) + r],\n404\t                cpu.get(r, c).expect(\"matrix index out of bounds\"),\n405\t                \"Mismatch at row {} column {}\",\n406\t                r,\n407\t                c\n408\t            );\n409\t        }\n410\t    }\n411\t}\n412\t"}]},"parent_tool_use_id":"toolu_01Rb1ToMNTPVjYSi67xrAiL7","session_id":"d2c41f48-5b80-4de8-b307-355a7b8c0ec2","uuid":"046b548c-da4a-428e-bed7-5fc69f9a1277","timestamp":"2026-04-14T15:14:23.234Z"}
