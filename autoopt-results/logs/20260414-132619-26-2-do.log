uf_a\n664\t            for (meta, m) in mat_meta.iter().zip(prover.mat_evals_per_trace.iter().flatten()) {\n665\t                let cells = meta.height * meta.width;\n666\t                unsafe {\n667\t                    cuda_memcpy::<true, true>(\n668\t                        mat_buf_a.as_mut_ptr().add(meta.offset) as *mut c_void,\n669\t                        m.buffer().as_ptr() as *const c_void,\n670\t                        cells * size_of::<EF>(),\n671\t                    )\n672\t                    .expect(\"D2D copy for ping-pong mat init failed\");\n673\t                }\n674\t            }\n675\t\n676\t            // Drop originals (free individual GPU allocations)\n677\t            drop(std::mem::take(&mut prover.mat_evals_per_trace));\n678\t\n679\t            // Create non-owning DeviceMatrix views from buf_a\n680\t            let buf_a_ptr = mat_buf_a.as_mut_ptr();\n681\t            let mut flat_idx = 0usize;\n682\t            prover.mat_evals_per_trace = mat_per_trace\n683\t                .iter()\n684\t                .map(|&count| {\n685\t                    (0..count)\n686\t                        .map(|_| {\n687\t                            let meta = &mat_meta[flat_idx];\n688\t                            flat_idx += 1;\n689\t                            unsafe {\n690\t                                DeviceMatrix::non_owning_view(\n691\t                                    buf_a_ptr.add(meta.offset),\n692\t                                    meta.height,\n693\t                                    meta.width,\n694\t                                )\n695\t                            }\n696\t                        })\n697\t                        .collect()\n698\t                })\n699\t                .collect();\n700\t\n701\t            prover.fold_mat_buf_a = Some(mat_buf_a);\n702\t            prover.fold_mat_buf_b = Some(mat_buf_b);\n703\t        }\n704\t\n705\t        if sel_total_cells > 0 {\n706\t            // Allocate two ping-pong buffers