{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015YyRsLEdj8wPGxY5BeHhDZ","type":"tool_result","content":"1\tuse std::marker::PhantomData;\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::memory_manager::MemTracker;\n5\tuse openvm_stark_backend::{\n6\t    poly_common::Squarable,\n7\t    proof::*,\n8\t    prover::{\n9\t        DeviceMultiStarkProvingKey, MultiRapProver, OpeningProver, ProverBackend, ProverDevice,\n10\t        ProvingContext, TraceCommitter,\n11\t    },\n12\t};\n13\tuse tracing::instrument;\n14\t\n15\tuse crate::{\n16\t    base::DeviceMatrix,\n17\t    hash_scheme::{DefaultHashScheme, GpuHashScheme},\n18\t    logup_zerocheck::prove_zerocheck_and_logup_gpu,\n19\t    merkle_tree::{MerkleProofQueryDigest, MerkleTreeConstructor},\n20\t    prelude::{D_EF, EF, F},\n21\t    sponge::GpuFiatShamirTranscript,\n22\t    stacked_pcs::{stacked_commit, StackedPcsDataGpu},\n23\t    stacked_reduction::prove_stacked_opening_reduction_gpu,\n24\t    whir::prove_whir_opening_gpu,\n25\t    AirDataGpu, GpuDevice, ProverError,\n26\t};\n27\t\n28\t/// Generic GPU prover backend parameterised by a hash scheme `HS`.\n29\t///\n30\t/// Use the [`GpuBackend`] type alias to refer to the concrete BabyBear-Poseidon2\n31\t/// backend without spelling out the generic parameter.\n32\t#[derive(Clone, Copy)]\n33\tpub struct GenericGpuBackend<HS: GpuHashScheme>(PhantomData<HS>);\n34\t\n35\timpl<HS: GpuHashScheme> Default for GenericGpuBackend<HS> {\n36\t    fn default() -> Self {\n37\t        Self(PhantomData)\n38\t    }\n39\t}\n40\t\n41\t/// Concrete GPU backend using the default BabyBear-Poseidon2 hash scheme.\n42\tpub type GpuBackend = GenericGpuBackend<DefaultHashScheme>;\n43\t\n44\timpl<HS: GpuHashScheme> ProverBackend for GenericGpuBackend<HS> {\n45\t    const CHALLENGE_EXT_DEGREE: u8 = D_EF as u8;\n46\t\n47\t    type Val = F;\n48\t    type Challenge = EF;\n49\t    type Commitment = HS::Digest;\n50\t    type Matrix = DeviceMatrix<F>;\n51\t    type PcsData = StackedPcsDataGpu<F, HS::Digest>;\n52\t    type OtherAirData = AirDataGpu;\n53\t}\n54\t\n55\timpl<HS: GpuHashScheme> TraceCommitter<GenericGpuBackend<HS>> for GpuDevice\n56\twhere\n57\t    HS::MerkleHash: MerkleTreeConstructor,\n58\t{\n59\t    type Error = ProverError;\n60\t\n61\t    fn commit(\n62\t        &self,\n63\t        traces: &[&DeviceMatrix<F>],\n64\t    ) -> Result<(HS::Digest, StackedPcsDataGpu<F, HS::Digest>), Self::Error> {\n65\t        stacked_commit::<HS::MerkleHash>(\n66\t            self.config.l_skip,\n67\t            self.config.n_stack,\n68\t            self.config.log_blowup,\n69\t            self.config.k_whir(),\n70\t            traces,\n71\t            self.prover_config,\n72\t        )\n73\t    }\n74\t}\n75\t\n76\timpl<HS: GpuHashScheme, TS: GpuFiatShamirTranscript<HS::SC>> ProverDevice<GenericGpuBackend<HS>, TS>\n77\t    for GpuDevice\n78\twhere\n79\t    HS::MerkleHash: MerkleTreeConstructor,\n80\t    HS::Digest: MerkleProofQueryDigest,\n81\t{\n82\t    type Error = ProverError;\n83\t}\n84\t\n85\timpl<HS: GpuHashScheme, TS: GpuFiatShamirTranscript<HS::SC>>\n86\t    MultiRapProver<GenericGpuBackend<HS>, TS> for GpuDevice\n87\t{\n88\t    type PartialProof = (GkrProof<HS::SC>, BatchConstraintProof<HS::SC>);\n89\t    /// The random opening point `r` where the batch constraint sumcheck reduces to evaluation\n90\t    /// claims of trace matrices `T, T_{rot}` at `r_{n_T}`.\n91\t    type Artifacts = Vec<EF>;\n92\t    type Error = ProverError;\n93\t\n94\t    #[allow(clippy::type_complexity)]\n95\t    #[instrument(name = \"prover.rap_constraints\", skip_all, fields(phase = \"prover\"))]\n96\t    fn prove_rap_constraints(\n97\t        &self,\n98\t        transcript: &mut TS,\n99\t        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n100\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,"}]},"parent_tool_use_id":"toolu_015R7XAoWMT37K5muJH8oEXu","session_id":"da7aeca3-2690-42a7-b268-944d05bc2153","uuid":"058ea518-5e0b-4921-8e5e