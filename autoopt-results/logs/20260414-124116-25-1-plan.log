   break;\n184\t                        case OP_NEG:\n185\t                            result = -x;\n186\t                            break;\n187\t                        case OP_VAR:\n188\t                            result = x;\n189\t                            break;\n190\t                        default:\n191\t                            assert(0);\n192\t                        }\n193\t\n194\t                        if (header.buffer_result) {\n195\t                            uint32_t z_index = decode_z_index(rule);\n196\t                            intermediates_ptr[z_index * intermediate_stride] = result;\n197\t                        }\n198\t                    }\n199\t                }\n200\t\n201\t                uint32_t pair_idx = d_pair_idxs[used_idx];\n202\t                size_t interaction_idx = pair_idx >> 1;\n203\t                size_t out_idx = (interaction_idx * permutation_height + row) * 2;\n204\t                reinterpret_cast<FpExt *>(d_fracs)[out_idx + (pair_idx & 1)] = result;\n205\t            }\n206\t        }\n207\t    }\n208\t}\n209\t\n210\t// ============================================================================\n211\t// LAUNCHERS\n212\t// ============================================================================\n213\t\n214\tconstexpr uint32_t TASK_SIZE = 1 << 16;\n215\t\n216\textern \"C\" int _logup_gkr_input_eval(\n217\t    bool is_global,\n218\t    FracExt *d_fracs,\n219\t    const Fp *d_preprocessed,\n220\t    const uint64_t *d_main,\n221\t    const Fp *d_public_values,\n222\t    const FpExt *d_challenges,\n223\t    const FpExt *d_intermediates,\n224\t    const Rule *d_rules,\n225\t    const size_t *d_used_nodes,\n226\t    const uint32_t *d_pair_idxs,\n227\t    size_t used_nodes_len,\n228\t    uint32_t permutation_height,\n229\t    uint32_t num_rows_per_tile\n230\t) {\n231\t    auto count = is_global ? TASK_SIZE : permutation_height;\n232\t    auto [grid, block] = kernel_launch_params(count, 256);\n233\t    if (is_global