{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nq4p4HzXfhZkSjMYxSRUfu","type":"tool_result","content":"575\tpub unsafe fn batched_interpolate_columns_gpu(\n576\t    descs: &DeviceBuffer<InterpColDesc>,\n577\t    all_columns: &DeviceBuffer<*const EF>,\n578\t    s_deg: usize,\n579\t    total_blocks: usize,\n580\t) -> Result<(), CudaError> {\n581\t    CudaError::from_result(_batched_interpolate_columns(\n582\t        descs.as_ptr(),\n583\t        all_columns.as_ptr(),\n584\t        s_deg,\n585\t        descs.len(),\n586\t        total_blocks,\n587\t    ))\n588\t}\n589\t\n590\tpub unsafe fn frac_build_tree_layer(\n591\t    layer: &mut DeviceBuffer<Frac<EF>>,\n592\t    layer_size: usize,\n593\t    revert: bool,\n594\t    alpha: EF,\n595\t    apply_alpha: bool,\n596\t) -> Result<(), CudaError> {\n597\t    debug_assert!(layer.len() >= layer_size);\n598\t    CudaError::from_result(_frac_build_tree_layer(\n599\t        layer.as_mut_ptr(),\n600\t        layer_size,\n601\t        revert,\n602\t        alpha,\n603\t        apply_alpha,\n604\t    ))\n605\t}\n606\t\n607\t/// Fused two-layer tree build kernel.\n608\t/// `half_i1` = N >> (i+2), where i is the first of the two layers being fused.\n609\tpub unsafe fn frac_build_tree_two_layers(\n610\t    layer: &mut DeviceBuffer<Frac<EF>>,\n611\t    half_i1: usize,\n612\t) -> Result<(), CudaError> {\n613\t    CudaError::from_result(_frac_build_tree_two_layers(layer.as_mut_ptr(), half_i1))\n614\t}\n615\t\n616\t// `eq_xi` will not store evaluations for the first hypercube coordinate because the prover factors\n617\t// out the first eq term.\n618\t#[allow(clippy::too_many_arguments)]\n619\tpub unsafe fn frac_compute_round(\n620\t    eq_xi: &SqrtEqLayers,\n621\t    pq_buffer: &DeviceBuffer<Frac<EF>>,\n622\t    num_x: usize,\n623\t    lambda: EF,\n624\t    out_device: &mut DeviceBuffer<EF>,\n625\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n626\t) -> Result<(), CudaError> {\n627\t    let low_n = eq_xi.low_n();\n628\t    let high_n = eq_xi.high_n();\n629\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n630\t    debug_assert!(pq_buffer.len() >= 2 * num_x);\n631\t    #[cfg(debug_assertions)]\n632\t    {\n633\t        let len = tmp_block_sums.len();\n634\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n635\t        assert!(\n636\t            len >= required as usize,\n637\t            \"tmp_block_sums len={len} < required={required}\"\n638\t        );\n639\t    }\n640\t    CudaError::from_result(_frac_compute_round(\n641\t        eq_xi.low.get_ptr(low_n),\n642\t        eq_xi.high.get_ptr(high_n),\n643\t        pq_buffer.as_ptr(),\n644\t        num_x,\n645\t        1 << low_n,\n646\t        lambda,\n647\t        out_device.as_mut_ptr(),\n648\t        tmp_block_sums.as_mut_ptr(),\n649\t    ))\n650\t}\n651\t\n652\t/// Fused compute round + tree layer revert kernel.\n653\t///\n654\t/// Combines `frac_build_tree_layer(revert=true)` with `compute_round` for the first inner round.\n655\t/// The revert operation modifies `layer` in-place: `layer[i] = layer[i] - layer[i + half]` for `i <\n656\t/// half`.\n657\t///\n658\t/// This eliminates one kernel launch per outer round.\n659\t#[allow(clippy::too_many_arguments)]\n660\tpub unsafe fn frac_compute_round_and_revert(\n661\t    eq_xi: &SqrtEqLayers,\n662\t    layer: &mut DeviceBuffer<Frac<EF>>,\n663\t    num_x: usize,\n664\t    lambda: EF,\n665\t    out_device: &mut DeviceBuffer<EF>,\n666\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n667\t) -> Result<(), CudaError> {\n668\t    let low_n = eq_xi.low_n();\n669\t    let high_n = eq_xi.high_n();\n670\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n671\t    #[cfg(debug_assertions)]\n672\t    {\n673\t        let len = tmp_block_sums.len();\n674\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());"}]},"parent_tool_use_id":"toolu_01LrJQFXzZeLiEoCaJBv1n5v","session_id":"da7aeca3-2690-42a7-b268-944d05bc2153","uuid":"589e73cf-67c7-4118-9fe8-a7a0852d3772","timestamp":"2026-04-14T10:47:36.271Z"}
