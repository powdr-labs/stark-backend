{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GL7eEdj2gZywzagtUZDmJh","type":"tool_result","content":"0\t//! Batch MLE evaluation for zerocheck and logup.\n1\t//!\n2\t//! This module provides builders for batching MLE evaluations across multiple AIRs,\n3\t//! enabling efficient GPU kernel launches that process multiple traces in parallel.\n4\t\n5\tuse openvm_cuda_common::{\n6\t    copy::{MemCopyD2H, MemCopyH2D},\n7\t    d_buffer::DeviceBuffer,\n8\t    error::MemCopyError,\n9\t};\n10\tuse openvm_stark_backend::prover::{fractional_sumcheck_gkr::Frac, DeviceMultiStarkProvingKey};\n11\t\n12\tuse crate::{\n13\t    cuda::logup_zerocheck::{\n14\t        _logup_batch_mle_intermediates_buffer_size, _zerocheck_batch_mle_intermediates_buffer_size,\n15\t        logup_batch_eval_mle, zerocheck_batch_eval_mle, BlockCtx, EvalCoreCtx, LogupCtx,\n16\t        MainMatrixPtrs, ZerocheckCtx,\n17\t    },\n18\t    error::KernelError,\n19\t    gpu_backend::GenericGpuBackend,\n20\t    hash_scheme::GpuHashScheme,\n21\t    logup_zerocheck::{\n22\t        batch_mle_monomial::{LogupCombinations, LogupMonomialBatch},\n23\t        mle_round::{evaluate_mle_constraints_gpu, evaluate_mle_interactions_gpu},\n24\t    },\n25\t    prelude::{EF, F},\n26\t};\n27\t\n28\tconst MAX_THREADS_PER_BLOCK: u32 = 128;\n29\t\n30\t// ============================================================================\n31\t// Memory calculation helpers\n32\t// ============================================================================\n33\t\n34\t/// Computes zerocheck intermediate buffer memory in bytes for a trace.\n35\tfn zerocheck_batch_mle_intermediates_buffer_bytes(\n36\t    buffer_size: u32,\n37\t    num_x: u32,\n38\t    num_y: u32,\n39\t) -> usize {\n40\t    unsafe {\n41\t        _zerocheck_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n42\t            * std::mem::size_of::<EF>()\n43\t    }\n44\t}\n45\t\n46\t/// Computes logup intermediate buffer memory in bytes for a trace.\n47\tfn logup_batch_mle_intermediates_buffer_bytes(buffer_size: u32, num_x: u32, num_y: u32) -> usize {\n48\t    unsafe {\n49\t        _logup_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n50\t            * std::mem::size_of::<EF>()\n51\t    }\n52\t}\n53\t\n54\t// ============================================================================\n55\t// Batching helpers\n56\t// ============================================================================\n57\t\n58\t/// Find how many traces fit in the memory budget.\n59\t/// Returns (count, total_memory_of_batch).\n60\tfn find_batch_end<T, M>(traces: &[T], memory_fn: M, memory_limit_bytes: usize) -> (usize, usize)\n61\twhere\n62\t    M: Fn(&T) -> usize,\n63\t{\n64\t    let mut batch_end = 0;\n65\t    let mut batch_memory = 0usize;\n66\t\n67\t    while batch_end < traces.len() {\n68\t        let trace_memory = memory_fn(&traces[batch_end]);\n69\t\n70\t        if batch_end == 0 {\n71\t            // First trace always included (even if oversized)\n72\t            batch_memory = trace_memory;\n73\t            batch_end = 1;\n74\t            if trace_memory > memory_limit_bytes {\n75\t                break; // Single oversized trace\n76\t            }\n77\t        } else if batch_memory + trace_memory <= memory_limit_bytes {\n78\t            batch_memory += trace_memory;\n79\t            batch_end += 1;\n80\t        } else {\n81\t            break; // Would exceed limit\n82\t        }\n83\t    }\n84\t    (batch_end, batch_memory)\n85\t}\n86\t\n87\t/// Context for a single trace used in batch MLE evaluation.\n88\tpub(crate) struct TraceCtx {\n89\t    pub trace_idx: usize,"}]},"parent_tool_use_id":null,"session_id":"99b5c9b4-0f89-4520-88f7-472cfcafbeff","uuid":"704e43e9-a039-4b19-91d5-ca0d046d1223","timestamp":"2026-04-15T03:07:33.101Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/batch_mle.rs","content":"//! Batch MLE evaluation for zerocheck and logup.\n//!\n//! This module provides builders for batching MLE evaluations across multiple AIRs,\n//! enabling efficient GPU kernel launches that process multiple traces in parallel.\n\nuse openvm_cuda_common::{\n    copy::{MemCopyD2H, MemCopyH2D},\n    d_buffer::DeviceBuffer,\n    error::MemCopyError,\n};\nuse openvm_stark_backend::prover::{fractional_sumcheck_gkr::Frac, DeviceMultiStarkProvingKey};\n\nuse crate::{\n    cuda::logup_zerocheck::{\n        _logup_batch_mle_intermediates_buffer_size, _zerocheck_batch_mle_intermediates_buffer_size,\n        logup_batch_eval_mle, zerocheck_batch_eval_mle, BlockCtx, EvalCoreCtx, LogupCtx,\n        MainMatrixPtrs, ZerocheckCtx,\n    },\n    error::KernelError,\n    gpu_backend::GenericGpuBackend,\n    hash_scheme::GpuHashScheme,\n    logup_zerocheck::{\n        batch_mle_monomial::{LogupCombinations, LogupMonomialBatch},\n        mle_round::{evaluate_mle_constraints_gpu, evaluate_mle_interactions_gpu},\n    },\n    prelude::{EF, F},\n};\n\nconst MAX_THREADS_PER_BLOCK: u32 = 128;\n\n// ============================================================================\n// Memory calculation helpers\n// ============================================================================\n\n/// Computes zerocheck intermediate buffer memory in bytes for a trace.\nfn zerocheck_batch_mle_intermediates_buffer_bytes(\n    buffer_size: u32,\n    num_x: u32,\n    num_y: u32,\n) -> usize {\n    unsafe {\n        _zerocheck_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n            * std::mem::size_of::<EF>()\n    }\n}\n\n/// Computes logup intermediate buffer memory in bytes for a trace.\nfn logup_batch_mle_intermediates_buffer_bytes(buffer_size: u32, num_x: u32, num_y: u32) -> usize {\n    unsafe {\n        _logup_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n            * std::mem::size_of::<EF>()\n    }\n}\n\n// ============================================================================\n// Batching helpers\n// ============================================================================\n\n/// Find how many traces fit in the memory budget.\n/// Returns (count, total_memory_of_batch).\nfn find_batch_end<T, M>(traces: &[T], memory_fn: M, memory_limit_bytes: usize) -> (usize, usize)\nwhere\n    M: Fn(&T) -> usize,\n{\n    let mut batch_end = 0;\n    let mut batch_memory = 0usize;\n\n    while batch_end < traces.len() {\n        let trace_memory = memory_fn(&traces[batch_end]);\n\n        if batch_end == 0 {\n            // First trace always included (even if oversized)\n            batch_memory = trace_memory;\n            batch_end = 1;\n            if trace_memory > memory_limit_bytes {\n                break; // Single oversized trace\n            }\n        } else if batch_memory + trace_memory <= memory_limit_bytes {\n            batch_memory += trace_memory;\n            batch_end += 1;\n        } else {\n            break; // Would exceed limit\n        }\n    }\n    (batch_end, batch_memory)\n}\n\n/// Context for a single trace used in batch MLE evaluation.\npub(crate) struct TraceCtx {\n    pub trace_idx: usize,","numLines":90,"startLine":0,"totalLines":736}}}
