     has_interactions,\n1728\t                    norm_factor,\n1729\t                });\n1730\t                total_interp_elems += interp_size;\n1731\t            }\n1732\t        }\n1733\t\n1734\t        // ── Phase 2: Batch allocate + single kernel launch ──\n1735\t        // One big buffer for all interpolated data, one kernel launch for all Case B traces.\n1736\t        let _keepalive_interpolated = if !case_b_traces.is_empty() {\n1737\t            let big_buf = DeviceBuffer::<EF>::with_capacity(total_interp_elems);\n1738\t            let big_ptr = big_buf.as_mut_ptr();\n1739\t\n1740\t            // Build descriptors with multi-block-per-trace assignment\n1741\t            const THREADS_PER_BLOCK: u32 = 512;\n1742\t            let mut block_offset: u32 = 0;\n1743\t            let descs: Vec<InterpTraceDescM> = case_b_traces\n1744\t                .iter()\n1745\t                .map(|meta| {\n1746\t                    let total_threads = (meta.num_y * meta.num_columns) as u32;\n1747\t                    let blocks = total_threads.div_ceil(THREADS_PER_BLOCK);\n1748\t                    let desc = InterpTraceDescM {\n1749\t                        output: unsafe { big_ptr.add(meta.interp_offset) },\n1750\t                        matrix_offset: meta.matrix_offset as u32,\n1751\t                        num_matrices: meta.num_matrices as u32,\n1752\t                        num_y: meta.num_y as u32,\n1753\t                        num_columns: meta.num_columns as u32,\n1754\t                        total_threads,\n1755\t                        block_start: block_offset,\n1756\t                    };\n1757\t                    block_offset += blocks;\n1758\t                    desc\n1759\t                })\n1760\t                .collect();\n1761\t            let total_blocks = block_offset as usize;\n1762\t\n1763\t            let d_matrices = all_matrices.to_device()?;\n1764\t            let d_descs = descs.to_device()?;\n1765\t            unsafe {\n1766\t                batched_interpolate_columns_matrix_gpu(\n1767\t                    &d_descs,\n1768\t                    &d_matrices,\n1769\t                    sp_deg,\n1770\t                    total_blocks,\n1771\t                )\n1772\t                .map_err(|e| LogupZerocheckError::InterpolateColumns(e.into()))?;\n1773\t            }\n1774\t\n1775\t            Some(big_buf)\n1776\t        } else {\n1777\t            None\n1778\t        };\n1779\t\n1780\t        // ── Phase 3: Build TraceCtx for each Case B trace ──\n1781\t        for meta in &case_b_traces {\n1782\t            let mats = &self.mat_evals_per_trace[meta.trace_idx];\n1783\t            let first_main_idx = usize::from(meta.has_preprocessed);\n1784\t            let eq_xi_tree = &self.eq_xis[&meta.n_lift];\n1785\t            let log_num_y = meta.n_lift - round;\n1786\t            let interpolated_height = sp_deg * meta.num_y;\n1787\t\n1788\t            let base_ptr = _keepalive_interpolated\n1789\t                .as_ref()\n1790\t                .unwrap()\n1791\t                .as_ptr()\n1792\t                .wrapping_add(meta.interp_offset);\n1793\t\n1794\t            let mut widths_so_far = 0usize;\n1795\t            let sels_ptr = base_ptr.wrapping_add(widths_so_far * interpolated_height);\n1796\t            widths_so_far += 3; // selector width is always 3\n1797\t\n1798\t            let prep_ptr = if meta.has_preprocessed {\n1799\t                MainMatrixPtrs {\n1800\t                    data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1801\t                    air_width: air_width_for_mat(meta.need_rot, mats[0].width()),\n1802\t                }\n1803\t            } else {\n1804\t                MainMatrixPtrs {\n1805\t                    data: std::ptr::null(),\n1806\t                    air_width: 0,\n1807\t                }\n1808\t            };\n1809\t            if meta.has_preprocessed {\n1810\t                widths_so_far += mats[0].width();\n1811\t            }\n1812\t            let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1813\t                .iter()\n1814\t                .map(|m| {\n1815\t                    let main_ptr = MainMatrixPtrs {\n1816\t                        data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1817\t                        air_width: air_width_for_mat(meta.need_rot, m.width()),\n1818\t                    };\n1819\t                    widths_so_far += m.width();\n1820\t                    main_ptr\n1821\t                })\n1822\t                .collect_vec();\n1823\t            debug_assert_eq!(widths_so_far, meta.num_columns);\n1824\t            let main_ptrs_dev = main_ptrs.to_device()?;\n1825\t\n1826\t            early_eval.push(TraceCtx {\n1827\t                trace_idx: meta.trace_idx,\n1828\t                air_idx: meta.air_idx,\n1829\t                n_lift: meta.n_lift,\n1830\t                num_y: meta.num_y as u32,\n1831\t                has_constraints: meta.has_constraints,\n1832\t                has_interactions: meta.has_interactions,\n1833\t                norm_factor: meta.norm_factor,\n1834\t                eq_xi_ptr: eq_xi_tree.get_ptr(log_num_y),\n1835\t                sels_ptr,\n1836\t                prep_ptr,\n1837\t                main_ptrs_dev,\n1838\t                public_ptr: self.public_values_per_trace[meta.trace_idx].as_ptr(),\n1839\t                eq_3bs_ptr: self.d_eq_3b_per_trace[meta.trace_idx].as_ptr(),\n1840\t            });\n1841\t        }\n1842\t\n1843\t        let d_challenges_ptr = self.d_challenges.as_ptr();\n1844\t\n1845\t        // Late traces (num_y=1): always use monomial\n1846\t        let late_logup_traces: Vec<_> = late_eval.iter().filter(|t| t.has_interactions).collect();\n1847\t        if !late_logup_traces.is_empty() {\n1848\t            let logup_combs: Vec<_> = late_logup_traces\n1849\t                .iter()\n1850\t                .map(|t| {\n1851\t                    self.logup_combinations[t.trace_idx]\n1852\t                        .as_ref()\n1853\t                        .expect(\"missing logup monomial combinations for late trace\")\n1854\t                })\n1855\t                .collect();\n1856\t            let batch =\n1857\t                LogupMonomialBatch::new(late_logup_traces.iter().copied(), self.pk, &logup_combs)?;\n1858\t            let out = batch\n1859\t                .evaluate(1)\n1860\t                .map_err(LogupZerocheckError::MleInteractionEval)?;\n1861\t            let host = out.to_host()?;\n1862\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1863\t                self.logup_tilde_evals[trace_idx][0] = host[i].p * late_logup_traces[i].norm_factor;\n1864\t                self.logup_tilde_evals[trace_idx][1] = host[i].q;\n1865\t            }\n1866\t        }\n1867\t        let late_mono_traces: Vec<_> = late_eval\n1868\t            .iter()\n1869\t            .filter(|t| trace_has_monomials(t, self.pk))\n1870\t            .collect();\n1871\t        if !late_mono_traces.is_empty() {\n1872\t            let lambda_combs: Vec<_> = late_mono_traces\n1873\t                .iter()\n1874\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1875\t                .collect();\n1876\t            let batch = ZerocheckMonomialBatch::new(late_mono_traces, self.pk, &lambda_combs)?;\n1877\t            let out = batch\n1878\t                .evaluate(1)\n1879\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1880\t            let host = out.to_host()?;\n1881\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1882\t                self.zerocheck_tilde_evals[trace_idx] = host[i];\n1883\t                // zc_out not set for num_x=1, handled from tilde_eval in compute_batch_s\n1884\t            }\n1885\t        }\n1886\t\n1887\t        // Logup for early traces: partition by num_y threshold\n1888\t        if !early_eval.is_empty() {\n1889\t            evaluate_logup_batched(\n1890\t                &early_eval,\n1891\t                self.pk,\n1892\t                d_challenges_ptr,\n1893\t                sp_deg as u32,\n1894\t                self.monomial_num_y_threshold,\n1895\t                &self.logup_combinations,\n1896\t                &mut logup_out,\n1897\t                &mut self.logup_tilde_evals,\n1898\t                self.memory_limit_bytes,\n1899\t            )\n1900\t            .map_err(LogupZerocheckError::MleInteractionEval)?;\n1901\t        }\n1902\t\n1903\t        // Early traces (num_y>1): partition by threshold for zerocheck path\n1904\t        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n1905\t            .iter()\n1906\t            .filter(|t| t.has_constraints)\n1907\t            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n1908\t\n1909\t        // Partition high num_y traces by monomial-to-rules ratio\n1910\t        // (traces without monomials are skipped - they contribute zero)\n1911\t        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n1912\t            high_early.iter().partition(|t| {\n1913\t                let num_monomials = get_num_monomials(t, self.pk);\n1914\t                let rules_len = get_zerocheck_rules_len(t, self.pk);\n1915\t                // Use DAG when monomial expansion significantly increased the term count\n1916\t                num_monomials as usize >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len\n1917\t            });\n1918\t\n1919\t        // DAG evaluation for high num_y traces with high monomial-to-rules ratio\n1920\t        if !high_dag_traces.is_empty() {\n1921\t            let lambda_pows = self.lambda_pows.as_ref().unwrap();\n1922\t            evaluate_zerocheck_batched(\n1923\t                high_dag_traces,\n1924\t                self.pk,\n1925\t                lambda_pows,\n1926\t                sp_deg as u32,\n1927\t                &mut zc_out,\n1928\t                self.memory_limit_bytes,\n1929\t            )\n1930\t            .map_err(LogupZerocheckError::MleConstraintEval)?;\n1931\t        }\n1932\t\n1933\t        // Par-Y monomial kernel for high num_y traces\n1934\t        if !high_mono_traces.is_empty() {\n1935\t            let lambda_combs: Vec<_> = high_mono_traces\n1936\t                .iter()\n1937\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1938\t                .collect();\n1939\t            let batch = ZerocheckMonomialParYBatch::new(\n1940\t                high_mono_traces,\n1941\t                self.pk,\n1942\t                &lambda_combs,\n1943\t                self.sm_count,\n1944\t                sp_deg as u32,\n1945\t                None,\n1946\t            )?;\n1947\t            let out = batch\n1948\t                .evaluate(sp_deg as u32)\n1949\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1950\t            let host = out.to_host()?;\n1951\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1952\t                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n1953\t            }\n1954\t        }\n1955\t\n1956\t        // Monomial zerocheck for low num_y traces\n1957\t        let low_mono_traces = low_early;\n1958\t        if !low_mono_traces.is_empty() {\n1959\t            let lambda_combs: Vec<_> = low_mono_traces\n1960\t                .iter()\n1961\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1962\t                .collect();\n1963\t            let batch = ZerocheckMonomialBatch::new(low_mono_traces, self.pk, &lambda_combs)?;\n1964\t            let out = batch\n1965\t                .evaluate(sp_deg as u32)\n1966\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1967\t            let host = out.to_host()?;\n1968\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1969\t                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n1970\t            }\n1971\t        }\n1972\t\n1973\t        Ok(logup_out.into_iter().flatten().chain(zc_out).collect())\n1974\t    }\n1975\t\n1976\t    #[instrument(level = \"debug\", skip_all, fields(round = round))]\n1977\t    fn compute_batch_s_poly(\n1978\t        &mut self,\n1979\t        sp_round_evals: Vec<Vec<EF>>,\n1980\t        num_traces: usize,\n1981\t        round: usize,\n1982\t        mu_pows: &[EF],\n1983\t    ) -> UnivariatePoly<EF> {\n1984\t        debug_assert_eq!(sp_round_evals.len(), 3 * num_traces);\n1985\t        debug_assert_eq!(sp_round_evals.len(), mu_pows.len());\n1986\t        let constraint_degree = self.constraint_degree;\n1987\t        let mut sp_head_zc = vec![EF::ZERO; constraint_degree];\n1988\t        let mut sp_head_logup = vec![EF::ZERO; constraint_degree];\n1989\t        let mut sp_tail = EF::ZERO;"}]},"parent_tool_use_id":null,"session_id":"99b5c9b4-0f89-4520-88f7-472cfcafbeff","uuid":"1add24a8-e974-471a-8d64-d53bd82157c2","timestamp":"2026-04-15T03:03:07.148Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/mod.rs","content":"    #[instrument(\n        name = \"LogupZerocheck::sumcheck_polys_batch_eval\",\n        level = \"info\",\n        skip_all,\n        fields(round = round)\n    )]\n    fn sumcheck_polys_batch_eval(\n        &mut self,\n        round: usize,\n        r_prev: EF,\n    ) -> Result<Vec<Vec<EF>>, LogupZerocheckError> {\n        let sp_deg = self.constraint_degree;\n\n        // Per-trace outputs (filled as we go)\n        let mut zc_out: Vec<Vec<EF>> = vec![vec![EF::ZERO; sp_deg]; self.n_per_trace.len()];\n        let mut logup_out: Vec<[Vec<EF>; 2]> =\n            vec![[vec![EF::ZERO; sp_deg], vec![EF::ZERO; sp_deg]]; self.n_per_trace.len()];\n\n        let mut late_eval: Vec<TraceCtx> = Vec::new(); // round == n_lift + 1\n        let mut early_eval: Vec<TraceCtx> = Vec::new(); // round <= n_lift\n\n        // ── Phase 1: Collect metadata, split into Case A / Case B (no CUDA calls) ──\n        // For Case B traces, we collect column pointers and sizing info to batch the\n        // interpolation into a single kernel launch.\n        struct CaseBMeta {\n            trace_idx: usize,\n            air_idx: usize,\n            n_lift: usize,\n            num_y: usize,\n            num_columns: usize, // total columns (selectors + preprocessed + mains)\n            interp_offset: usize, // element offset within the big interpolated buffer\n            matrix_offset: usize, // start index in the all_matrices array\n            num_matrices: usize,  // number of matrices for this trace\n            has_preprocessed: bool,\n            need_rot: bool,\n            has_constraints: bool,\n            has_interactions: bool,\n            norm_factor: F,\n        }\n        let mut case_b_traces: Vec<CaseBMeta> = Vec::new();\n        let mut all_matrices: Vec<InterpMatrixInfo> = Vec::new();\n        let mut total_interp_elems: usize = 0;\n\n        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n            self.n_per_trace.iter(),\n            self.mat_evals_per_trace.iter(),\n            self.sels_per_trace.iter(),\n            self.d_eq_3b_per_trace.iter(),\n            self.public_values_per_trace.iter(),\n            self.air_indices_per_trace.iter()\n        )\n        .enumerate()\n        {\n            let pk = &self.pk.per_air[air_idx];\n            let dag = &pk.vk.symbolic_constraints;\n            let has_constraints = dag.constraints.num_constraints() > 0;\n            let has_interactions = !dag.interactions.is_empty();\n            if !has_constraints && !has_interactions {\n                continue;\n            }\n\n            let n_lift = n.max(0) as usize;\n            let norm_factor_denom = 1 << (-n).max(0);\n            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n            let has_preprocessed = pk.preprocessed_data.is_some();\n            let need_rot = pk.vk.params.need_rot;\n            let first_main_idx = usize::from(has_preprocessed);\n            let eq_xi_tree = &self.eq_xis[&n_lift];\n\n            if round > n_lift {\n                // Case A\n                if round == n_lift + 1 {\n                    // A.1: evaluate directly at (num_x=1, num_y=1)\n                    let prep_ptr = if has_preprocessed {\n                        MainMatrixPtrs {\n                            data: mats[0].buffer().as_ptr(),\n                            air_width: air_width_for_mat(need_rot, mats[0].width()),\n                        }\n                    } else {\n                        MainMatrixPtrs {\n                            data: std::ptr::null(),\n                            air_width: 0,\n                        }\n                    };\n                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n                        .iter()\n                        .map(|m| MainMatrixPtrs {\n                            data: m.buffer().as_ptr(),\n                            air_width: air_width_for_mat(need_rot, m.width()),\n                        })\n                        .collect_vec();\n                    let main_ptrs_dev = main_ptrs.to_device()?;\n\n                    late_eval.push(TraceCtx {\n                        trace_idx,\n                        air_idx,\n                        n_lift,\n                        num_y: 1,\n                        has_constraints,\n                        has_interactions,\n                        norm_factor,\n                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n                        sels_ptr: sels.buffer().as_ptr(),\n                        prep_ptr,\n                        main_ptrs_dev,\n                        public_ptr: public_vals.as_ptr(),\n                        eq_3bs_ptr: eq_3bs.as_ptr(),\n                    });\n                } else {\n                    // A.2: scale tilde evals only\n                    if has_constraints {\n                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n                        *tilde_eval *= r_prev;\n                    }\n                    if has_interactions {\n                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n                            *x *= r_prev;\n                        }\n                    }\n                }\n            } else {\n                // Case B: collect metadata for batched interpolation\n                let log_num_y = n_lift - round;\n                let num_y = 1 << log_num_y;\n                let height = 2 * num_y;\n                debug_assert_eq!(height, mats[0].height());\n\n                let matrix_offset = all_matrices.len();\n                // Collect per-matrix base pointers: selectors + all matrices (preprocessed + mains)\n                debug_assert_eq!(sels.height(), height);\n                all_matrices.push(InterpMatrixInfo {\n                    base: sels.buffer().as_ptr(),\n                    width: sels.width() as u32,\n                });\n                for m in mats.iter() {\n                    debug_assert_eq!(m.height(), height);\n                    all_matrices.push(InterpMatrixInfo {\n                        base: m.buffer().as_ptr(),\n                        width: m.width() as u32,\n                    });\n                }\n                let num_matrices = 1 + mats.len();\n                let num_columns = sels.width() + mats.iter().map(|m| m.width()).sum::<usize>();\n                let interp_size = sp_deg * num_y * num_columns;\n\n                case_b_traces.push(CaseBMeta {\n                    trace_idx,\n                    air_idx,\n                    n_lift,\n                    num_y,\n                    num_columns,\n                    interp_offset: total_interp_elems,\n                    matrix_offset,\n                    num_matrices,\n                    has_preprocessed,\n                    need_rot,\n                    has_constraints,\n                    has_interactions,\n                    norm_factor,\n                });\n                total_interp_elems += interp_size;\n            }\n        }\n\n        // ── Phase 2: Batch allocate + single kernel launch ──\n        // One big buffer for all interpolated data, one kernel launch for all Case B traces.\n        let _keepalive_interpolated = if !case_b_traces.is_empty() {\n            let big_buf = DeviceBuffer::<EF>::with_capacity(total_interp_elems);\n            let big_ptr = big_buf.as_mut_ptr();\n\n            // Build descriptors with multi-block-per-trace assignment\n            const THREADS_PER_BLOCK: u32 = 512;\n            let mut block_offset: u32 = 0;\n            let descs: Vec<InterpTraceDescM> = case_b_traces\n                .iter()\n                .map(|meta| {\n                    let total_threads = (meta.num_y * meta.num_columns) as u32;\n                    let blocks = total_threads.div_ceil(THREADS_PER_BLOCK);\n                    let desc = InterpTraceDescM {\n                        output: unsafe { big_ptr.add(meta.interp_offset) },\n                        matrix_offset: meta.matrix_offset as u32,\n                        num_matrices: meta.num_matrices as u32,\n                        num_y: meta.num_y as u32,\n                        num_columns: meta.num_columns as u32,\n                        total_threads,\n                        block_start: block_offset,\n                    };\n                    block_offset += blocks;\n                    desc\n                })\n                .collect();\n            let total_blocks = block_offset as usize;\n\n            let d_matrices = all_matrices.to_device()?;\n            let d_descs = descs.to_device()?;\n            unsafe {\n                batched_interpolate_columns_matrix_gpu(\n                    &d_descs,\n                    &d_matrices,\n                    sp_deg,\n                    total_blocks,\n                )\n                .map_err(|e| LogupZerocheckError::InterpolateColumns(e.into()))?;\n            }\n\n            Some(big_buf)\n        } else {\n            None\n        };\n\n        // ── Phase 3: Build TraceCtx for each Case B trace ──\n        for meta in &case_b_traces {\n            let mats = &self.mat_evals_per_trace[meta.trace_idx];\n            let first_main_idx = usize::from(meta.has_preprocessed);\n            let eq_xi_tree = &self.eq_xis[&meta.n_lift];\n            let log_num_y = meta.n_lift - round;\n            let interpolated_height = sp_deg * meta.num_y;\n\n            let base_ptr = _keepalive_interpolated\n                .as_ref()\n                .unwrap()\n                .as_ptr()\n                .wrapping_add(meta.interp_offset);\n\n            let mut widths_so_far = 0usize;\n            let sels_ptr = base_ptr.wrapping_add(widths_so_far * interpolated_height);\n            widths_so_far += 3; // selector width is always 3\n\n            let prep_ptr = if meta.has_preprocessed {\n                MainMatrixPtrs {\n                    data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n                    air_width: air_width_for_mat(meta.need_rot, mats[0].width()),\n                }\n            } else {\n                MainMatrixPtrs {\n                    data: std::ptr::null(),\n                    air_width: 0,\n                }\n            };\n            if meta.has_preprocessed {\n                widths_so_far += mats[0].width();\n            }\n            let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n                .iter()\n                .map(|m| {\n                    let main_ptr = MainMatrixPtrs {\n                        data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n                        air_width: air_width_for_mat(meta.need_rot, m.width()),\n                    };\n                    widths_so_far += m.width();\n                    main_ptr\n                })\n                .collect_vec();\n            debug_assert_eq!(widths_so_far, meta.num_columns);\n            let main_ptrs_dev = main_ptrs.to_device()?;\n\n            early_eval.push(TraceCtx {\n                trace_idx: meta.trace_idx,\n                air_idx: meta.air_idx,\n                n_lift: meta.n_lift,\n                num_y: meta.num_y as u32,\n                has_constraints: meta.has_constraints,\n                has_interactions: meta.has_interactions,\n                norm_factor: meta.norm_factor,\n                eq_xi_ptr: eq_xi_tree.get_ptr(log_num_y),\n                sels_ptr,\n                prep_ptr,\n                main_ptrs_dev,\n                public_ptr: self.public_values_per_trace[meta.trace_idx].as_ptr(),\n                eq_3bs_ptr: self.d_eq_3b_per_trace[meta.trace_idx].as_ptr(),\n            });\n        }\n\n        let d_challenges_ptr = self.d_challenges.as_ptr();\n\n        // Late traces (num_y=1): always use monomial\n        let late_logup_traces: Vec<_> = late_eval.iter().filter(|t| t.has_interactions).collect();\n        if !late_logup_traces.is_empty() {\n            let logup_combs: Vec<_> = late_logup_traces\n                .iter()\n                .map(|t| {\n                    self.logup_combinations[t.trace_idx]\n                        .as_ref()\n                        .expect(\"missing logup monomial combinations for late trace\")\n                })\n                .collect();\n            let batch =\n                LogupMonomialBatch::new(late_logup_traces.iter().copied(), self.pk, &logup_combs)?;\n            let out = batch\n                .evaluate(1)\n                .map_err(LogupZerocheckError::MleInteractionEval)?;\n            let host = out.to_host()?;\n            for (i, trace_idx) in batch.trace_indices().enumerate() {\n                self.logup_tilde_evals[trace_idx][0] = host[i].p * late_logup_traces[i].norm_factor;\n                self.logup_tilde_evals[trace_idx][1] = host[i].q;\n            }\n        }\n        let late_mono_traces: Vec<_> = late_eval\n            .iter()\n            .filter(|t| trace_has_monomials(t, self.pk))\n            .collect();\n        if !late_mono_traces.is_empty() {\n            let lambda_combs: Vec<_> = late_mono_traces\n                .iter()\n                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n                .collect();\n            let batch = ZerocheckMonomialBatch::new(late_mono_traces, self.pk, &lambda_combs)?;\n            let out = batch\n                .evaluate(1)\n                .map_err(LogupZerocheckError::MleConstraintEval)?;\n            let host = out.to_host()?;\n            for (i, trace_idx) in batch.trace_indices().enumerate() {\n                self.zerocheck_tilde_evals[trace_idx] = host[i];\n                // zc_out not set for num_x=1, handled from tilde_eval in compute_batch_s\n            }\n        }\n\n        // Logup for early traces: partition by num_y threshold\n        if !early_eval.is_empty() {\n            evaluate_logup_batched(\n                &early_eval,\n                self.pk,\n                d_challenges_ptr,\n                sp_deg as u32,\n                self.monomial_num_y_threshold,\n                &self.logup_combinations,\n                &mut logup_out,\n                &mut self.logup_tilde_evals,\n                self.memory_limit_bytes,\n            )\n            .map_err(LogupZerocheckError::MleInteractionEval)?;\n        }\n\n        // Early traces (num_y>1): partition by threshold for zerocheck path\n        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n            .iter()\n            .filter(|t| t.has_constraints)\n            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n\n        // Partition high num_y traces by monomial-to-rules ratio\n        // (traces without monomials are skipped - they contribute zero)\n        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n            high_early.iter().partition(|t| {\n                let num_monomials = get_num_monomials(t, self.pk);\n                let rules_len = get_zerocheck_rules_len(t, self.pk);\n                // Use DAG when monomial expansion significantly increased the term count\n                num_monomials as usize >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len\n            });\n\n        // DAG evaluation for high num_y traces with high monomial-to-rules ratio\n        if !high_dag_traces.is_empty() {\n            let lambda_pows = self.lambda_pows.as_ref().unwrap();\n            evaluate_zerocheck_batched(\n                high_dag_traces,\n                self.pk,\n                lambda_pows,\n                sp_deg as u32,\n                &mut zc_out,\n                self.memory_limit_bytes,\n            )\n            .map_err(LogupZerocheckError::MleConstraintEval)?;\n        }\n\n        // Par-Y monomial kernel for high num_y traces\n        if !high_mono_traces.is_empty() {\n            let lambda_combs: Vec<_> = high_mono_traces\n                .iter()\n                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n                .collect();\n            let batch = ZerocheckMonomialParYBatch::new(\n                high_mono_traces,\n                self.pk,\n                &lambda_combs,\n                self.sm_count,\n                sp_deg as u32,\n                None,\n            )?;\n            let out = batch\n                .evaluate(sp_deg as u32)\n                .map_err(LogupZerocheckError::MleConstraintEval)?;\n            let host = out.to_host()?;\n            for (i, trace_idx) in batch.trace_indices().enumerate() {\n                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n            }\n        }\n\n        // Monomial zerocheck for low num_y traces\n        let low_mono_traces = low_early;\n        if !low_mono_traces.is_empty() {\n            let lambda_combs: Vec<_> = low_mono_traces\n                .iter()\n                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n                .collect();\n            let batch = ZerocheckMonomialBatch::new(low_mono_traces, self.pk, &lambda_combs)?;\n            let out = batch\n                .evaluate(sp_deg as u32)\n                .map_err(LogupZerocheckError::MleConstraintEval)?;\n            let host = out.to_host()?;\n            for (i, trace_idx) in batch.trace_indices().enumerate() {\n                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n            }\n        }\n\n        Ok(logup_out.into_iter().flatten().chain(zc_out).collect())\n    }\n\n    #[instrument(level = \"debug\", skip_all, fields(round = round))]\n    fn compute_batch_s_poly(\n        &mut self,\n        sp_round_evals: Vec<Vec<EF>>,\n        num_traces: usize,\n        round: usize,\n        mu_pows: &[EF],\n    ) -> UnivariatePoly<EF> {\n        debug_assert_eq!(sp_round_evals.len(), 3 * num_traces);\n        debug_assert_eq!(sp_round_evals.len(), mu_pows.len());\n        let constraint_degree = self.constraint_degree;\n        let mut sp_head_zc = vec![EF::ZERO; constraint_degree];\n        let mut sp_head_logup = vec![EF::ZERO; constraint_degree];\n        let mut sp_tail = EF::ZERO;","numLines":420,"startLine":1570,"totalLines":2310}}}
