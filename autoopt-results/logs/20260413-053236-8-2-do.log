{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jope69Vhe7nBaQ4v6W4bVm","type":"tool_result","content":"1\tuse std::{ffi::c_void, sync::Mutex};\n2\t\n3\tuse lazy_static::lazy_static;\n4\t\n5\tuse crate::{\n6\t    d_buffer::DeviceBuffer,\n7\t    error::{check, MemCopyError},\n8\t    stream::{current_stream_sync, cudaStreamPerThread, cudaStream_t, CudaEvent},\n9\t};\n10\t\n11\tlazy_static! {\n12\t    static ref COPY_EVENT: Mutex<CudaEvent> = Mutex::new(CudaEvent::new().unwrap());\n13\t}\n14\t\n15\t#[repr(i32)]\n16\t#[non_exhaustive]\n17\t#[allow(non_camel_case_types)]\n18\t#[derive(Debug, Copy, Clone, Hash, PartialEq, Eq)]\n19\tpub enum cudaMemcpyKind {\n20\t    cudaMemcpyHostToHost = 0,\n21\t    cudaMemcpyHostToDevice = 1,\n22\t    cudaMemcpyDeviceToHost = 2,\n23\t    cudaMemcpyDeviceToDevice = 3,\n24\t    cudaMemcpyDefault = 4,\n25\t}\n26\t\n27\t#[link(name = \"cudart\")]\n28\textern \"C\" {\n29\t    fn cudaMemcpyAsync(\n30\t        dst: *mut c_void,\n31\t        src: *const c_void,\n32\t        count: usize,\n33\t        kind: cudaMemcpyKind,\n34\t        stream: cudaStream_t,\n35\t    ) -> i32;\n36\t}\n37\t\n38\t/// FFI binding for the `cudaMemcpyAsync` function on the default cuda stream.\n39\t///\n40\t/// # Safety\n41\t/// Must follow the rules of the `cudaMemcpyAsync` function from the CUDA runtime API.\n42\tpub unsafe fn cuda_memcpy<const SRC_DEVICE: bool, const DST_DEVICE: bool>(\n43\t    dst: *mut c_void,\n44\t    src: *const c_void,\n45\t    size_bytes: usize,\n46\t) -> Result<(), MemCopyError> {\n47\t    check(unsafe {\n48\t        cudaMemcpyAsync(\n49\t            dst,\n50\t            src,\n51\t            size_bytes,\n52\t            std::mem::transmute::<i32, cudaMemcpyKind>(\n53\t                if DST_DEVICE { 1 } else { 0 } + if SRC_DEVICE { 2 } else { 0 },\n54\t            ),\n55\t            cudaStreamPerThread,\n56\t        )\n57\t    })\n58\t    .map_err(MemCopyError::from)\n59\t}\n60\t\n61\t// Host -> Device\n62\tpub trait MemCopyH2D<T> {\n63\t    fn copy_to(&self, dst: &mut DeviceBuffer<T>) -> Result<(), MemCopyError>;\n64\t    fn to_device(&self) -> Result<DeviceBuffer<T>, MemCopyError>;\n65\t}\n66\t\n67\timpl<T> MemCopyH2D<T> for [T] {\n68\t    fn copy_to(&self, dst: &mut DeviceBuffer<T>) -> Result<(), MemCopyError> {\n69\t        if self.len() > dst.len() {\n70\t            return Err(MemCopyError::SizeMismatch {\n71\t                operation: \"copy_to_device\",\n72\t                host_len: self.len(),\n73\t                device_len: dst.len(),\n74\t            });\n75\t        }\n76\t        let size_bytes = std::mem::size_of_val(self);\n77\t        check(unsafe {\n78\t            cudaMemcpyAsync(\n79\t                dst.as_mut_raw_ptr(),\n80\t                self.as_ptr() as *const c_void,\n81\t                size_bytes,\n82\t                cudaMemcpyKind::cudaMemcpyHostToDevice,\n83\t                cudaStreamPerThread,\n84\t            )\n85\t        })\n86\t        .map_err(MemCopyError::from)\n87\t    }\n88\t\n89\t    fn to_device(&self) -> Result<DeviceBuffer<T>, MemCopyError> {\n90\t        let mut dst = DeviceBuffer::with_capacity(self.len());\n91\t        self.copy_to(&mut dst)?;\n92\t        Ok(dst)\n93\t    }\n94\t}\n95\t\n96\t// Device -> Host\n97\tpub trait MemCopyD2H<T> {\n98\t    fn to_host(&self) -> Result<Vec<T>, MemCopyError>;\n99\t}\n100\t\n101\timpl<T> MemCopyD2H<T> for DeviceBuffer<T> {\n102\t    fn to_host(&self) -> Result<Vec<T>, MemCopyError> {\n103\t        let mut host_vec = Vec::with_capacity(self.len());\n104\t        let size_bytes = std::mem::size_of::<T>() * self.len();\n105\t\n106\t        check(unsafe {\n107\t            cudaMemcpyAsync(\n108\t                host_vec.as_mut_ptr() as *mut c_void,\n109\t                self.as_raw_ptr(),\n110\t                size_bytes,\n111\t                cudaMemcpyKind::cudaMemcpyDeviceToHost,\n112\t                cudaStreamPerThread,\n113\t            )\n114\t        })?;\n115\t        unsafe {\n116\t            COPY_EVENT\n117\t                .lock()\n118\t                .unwrap()\n119\t                .record_and_wait(cudaStreamPerThread)?;\n120\t\n121\t            host_vec.set_len(self.len());\n122\t        }\n123\t\n124\t        Ok(host_vec)\n125\t    }\n126\t}\n127\t\n128\t/// Like [`MemCopyD2H`], but syncs on the calling thread's per-thread stream instead of the global\n129\t/// `COPY_EVENT` mutex. Safe to call from multiple threads without mutex contention.\n130\tpub trait MemCopyD2HStreamSync<T> {\n131\t    fn to_host_on_current_stream(&self) -> Result<Vec<T>, MemCopyError>;\n132\t}\n133\t\n134\timpl<T> MemCopyD2HStreamSync<T> for DeviceBuffer<T> {\n135\t    fn to_host_on_current_stream(&self) -> Result<Vec<T>, MemCopyError> {\n136\t        let mut host_vec = Vec::with_capacity(self.len());\n137\t        let size_bytes = std::mem::size_of::<T>() * self.len();\n138\t        check(unsafe {\n139\t            cudaMemcpyAsync(\n140\t                host_vec.as_mut_ptr() as *mut c_void,\n141\t                self.as_raw_ptr(),\n142\t                size_bytes,\n143\t                cudaMemcpyKind::cudaMemcpyDeviceToHost,\n144\t                cudaStreamPerThread,\n145\t            )\n146\t        })?;\n147\t        current_stream_sync().map_err(MemCopyError::from)?;\n148\t        unsafe {\n149\t            host_vec.set_len(self.len());\n150\t        }\n151\t        Ok(host_vec)\n152\t    }\n153\t}\n154\t\n155\tpub trait MemCopyD2D<T> {\n156\t    fn device_copy(&self) -> Result<DeviceBuffer<T>, MemCopyError>;\n157\t    fn device_copy_to(&self, dst: &mut DeviceBuffer<T>) -> Result<(), MemCopyError>;\n158\t}\n159\t\n160\timpl<T> MemCopyD2D<T> for DeviceBuffer<T> {\n161\t    fn device_copy(&self) -> Result<DeviceBuffer<T>, MemCopyError> {\n162\t        let mut dst = DeviceBuffer::<T>::with_capacity(self.len());\n163\t        self.device_copy_to(&mut dst)?;\n164\t        Ok(dst)\n165\t    }\n166\t\n167\t    fn device_copy_to(&self, dst: &mut DeviceBuffer<T>) -> Result<(), MemCopyError> {\n168\t        let size_bytes = std::mem::size_of::<T>() * self.len();\n169\t\n170\t        check(unsafe {\n171\t            cudaMemcpyAsync(\n172\t                dst.as_mut_raw_ptr(),\n173\t                self.as_raw_ptr(),\n174\t                size_bytes,\n175\t                cudaMemcpyKind::cudaMemcpyDeviceToDevice,\n176\t                cudaStreamPerThread,\n177\t            )\n178\t        })\n179\t        .map_err(MemCopyError::from)\n180\t    }\n181\t}\n182\t\n183\t#[cfg(test)]\n184\tmod tests {\n185\t    use super::*;\n186\t    use crate::d_buffer::DeviceBuffer;\n187\t\n188\t    #[test]\n189\t    fn test_mem_copy() {\n190\t        // Our source data on the host\n191\t        let h = vec![1, 2, 3, 4, 5];\n192\t\n193\t        // 1) Copy to a newly allocated device buffer\n194\t        let d1 = h.to_device().unwrap();\n195\t\n196\t        // 2) Create another device buffer of the same size\n197\t        let mut d2 = DeviceBuffer::<i32>::with_capacity(h.len());\n198\t\n199\t        // 3) Copy into that existing buffer\n200\t        h.copy_to(&mut d2).unwrap();\n201\t\n202\t        // 4) Copy both buffers back to host\n203\t        let h1 = d1.to_host().unwrap();\n204\t        let h2 = d2.to_host().unwrap();\n205\t\n206\t        assert_eq!(h, h1, \"First device buffer mismatch\");\n207\t        assert_eq!(h, h2, \"Second device buffer mismatch\");\n208\t    }\n209\t}\n210\t"}]},"parent_tool_use_id":"toolu_01KZTsGaJitvUofdgMP834ae","session_id":"7bfaeea3-63f2-45dc-8806-130a2a5b3639","uuid":"c4305da0-e683-4c47-9f8f-7c537755386f","timestamp":"2026-04-13T04:14:33.082Z"}
