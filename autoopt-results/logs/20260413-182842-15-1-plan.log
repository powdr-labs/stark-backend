{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015P59KfymtiqsnEppRVKWPs","type":"tool_result","content":"1\tuse std::fmt::Display;\n2\t\n3\tuse itertools::zip_eq;\n4\tuse serde::{Deserialize, Serialize};\n5\tuse tracing::{debug, info};\n6\t\n7\tuse crate::{\n8\t    keygen::types::TraceWidth,\n9\t    proof::TraceVData,\n10\t    prover::{DeviceMultiStarkProvingKey, ProverBackend},\n11\t    StarkProtocolConfig,\n12\t};\n13\t\n14\t#[derive(Clone, Debug, Serialize, Deserialize)]\n15\tpub struct TraceMetrics {\n16\t    pub per_air: Vec<SingleTraceMetrics>,\n17\t    /// Total base field cells from all traces, excludes preprocessed.\n18\t    pub total_cells: usize,\n19\t    /// For each trace height constraint, the (weighted sum, threshold)\n20\t    pub trace_height_inequalities: Vec<(usize, usize)>,\n21\t}\n22\t\n23\t#[derive(Clone, Debug, Serialize, Deserialize)]\n24\tpub struct SingleTraceMetrics {\n25\t    pub air_name: String,\n26\t    pub air_id: usize,\n27\t    pub height: usize,\n28\t    /// The after challenge width is adjusted to be in terms of **base field** elements.\n29\t    pub width: TraceWidth,\n30\t    pub cells: TraceCells,\n31\t    // TODO[jpw]: update this calculation accordingly\n32\t    /// Omitting preprocessed trace, the total base field cells from main and after challenge\n33\t    /// traces.\n34\t    pub total_cells: usize,\n35\t}\n36\t\n37\t/// Trace cells, counted in terms of number of **base field** elements.\n38\t#[derive(Clone, Debug, Serialize, Deserialize)]\n39\tpub struct TraceCells {\n40\t    pub preprocessed: Option<usize>,\n41\t    pub cached_mains: Vec<usize>,\n42\t    pub common_main: usize,\n43\t    pub after_challenge: Vec<usize>,\n44\t}\n45\t\n46\timpl Display for TraceMetrics {\n47\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n48\t        for (i, (weighted_sum, threshold)) in self.trace_height_inequalities.iter().enumerate() {\n49\t            writeln!(\n50\t                f,\n51\t                \"trace_height_constraint_{i} | weighted_sum = {:<10} | threshold = {:<10}\",\n52\t                format_number_with_underscores(*weighted_sum),\n53\t                format_number_with_underscores(*threshold)\n54\t            )?;\n55\t        }\n56\t        for trace_metrics in &self.per_air {\n57\t            writeln!(f, \"{}\", trace_metrics)?;\n58\t        }\n59\t        Ok(())\n60\t    }\n61\t}\n62\t\n63\timpl Display for SingleTraceMetrics {\n64\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n65\t        write!(\n66\t            f,\n67\t            \"{:<20} | Rows = {:<10} | Cells = {:<11} | Prep Cols = {:<5} | Main Cols = {:<5} | Perm Cols = {:<5}\",\n68\t            self.air_name, format_number_with_underscores(self.height), format_number_with_underscores(self.total_cells), self.width.preprocessed.unwrap_or(0),\n69\t            format!(\"{:?}\", self.width.main_widths()),\n70\t            format!(\"{:?}\",self.width.after_challenge),\n71\t        )?;\n72\t        Ok(())\n73\t    }\n74\t}\n75\t\n76\t/// heights are the trace heights for each air\n77\tpub fn trace_metrics<SC: StarkProtocolConfig, PB: ProverBackend>(\n78\t    mpk: &DeviceMultiStarkProvingKey<PB>,\n79\t    trace_vdata: &[Option<TraceVData<SC>>],\n80\t) -> TraceMetrics {\n81\t    let heights = trace_vdata\n82\t        .iter()\n83\t        .map(|vdata| vdata.as_ref().map(|v| 1 << v.log_height).unwrap_or(0))\n84\t        .collect::<Vec<_>>();\n85\t    let trace_height_inequalities = mpk\n86\t        .trace_height_constraints\n87\t        .iter()\n88\t        .map(|trace_height_constraint| {\n89\t            let weighted_sum = heights\n90\t                .iter()\n91\t                .enumerate()\n92\t                .map(|(air_idx, h)| (trace_height_constraint.coefficients[air_idx] as usize) * h)\n93\t                .sum::<usize>();\n94\t            (weighted_sum, trace_height_constraint.threshold as usize)\n95\t        })\n96\t        .collect::<Vec<_>>();\n97\t    let per_air: Vec<_> = zip_eq(&mpk.per_air, heights)\n98\t        .enumerate()\n99\t        .filter(|(_, (_, height))| *height > 0)\n100\t        .map(|(air_idx, (pk, height))| {\n101\t            let air_name = &pk.air_name;\n102\t            let width = pk.vk.params.width.clone();\n103\t            let cells = TraceCells {\n104\t                preprocessed: width.preprocessed.map(|w| w * height),\n105\t                cached_mains: width.cached_mains.iter().map(|w| w * height).collect(),\n106\t                common_main: width.common_main * height,\n107\t                // In OpenVM 2.0, there are no trace cells due to bus interactions.\n108\t                after_challenge: vec![0],\n109\t            };\n110\t            let total_cells = cells\n111\t                .cached_mains\n112\t                .iter()\n113\t                .chain([&cells.common_main])\n114\t                .chain(cells.after_challenge.iter())\n115\t                .sum::<usize>();\n116\t            SingleTraceMetrics {\n117\t                air_name: air_name.to_string(),\n118\t                air_id: air_idx,\n119\t                height,\n120\t                width,\n121\t                cells,\n122\t                total_cells,\n123\t            }\n124\t        })\n125\t        .collect();\n126\t    let total_cells = per_air.iter().map(|m| m.total_cells).sum();\n127\t    let metrics = TraceMetrics {\n128\t        per_air,\n129\t        total_cells,\n130\t        trace_height_inequalities,\n131\t    };\n132\t    info!(\n133\t        \"total_trace_cells = {} (excluding preprocessed)\",\n134\t        format_number_with_underscores(metrics.total_cells)\n135\t    );\n136\t    info!(\n137\t        \"preprocessed_trace_cells = {}\",\n138\t        format_number_with_underscores(\n139\t            metrics\n140\t                .per_air\n141\t                .iter()\n142\t                .map(|m| m.cells.preprocessed.unwrap_or(0))\n143\t                .sum::<usize>()\n144\t        )\n145\t    );\n146\t    info!(\n147\t        \"main_trace_cells = {}\",\n148\t        format_number_with_underscores(\n149\t            metrics\n150\t                .per_air\n151\t                .iter()\n152\t                .map(|m| m.cells.cached_mains.iter().sum::<usize>() + m.cells.common_main)\n153\t                .sum::<usize>()\n154\t        )\n155\t    );\n156\t    info!(\n157\t        \"perm_trace_cells = {}\",\n158\t        format_number_with_underscores(\n159\t            metrics\n160\t                .per_air\n161\t                .iter()\n162\t                .map(|m| m.cells.after_challenge.iter().sum::<usize>())\n163\t                .sum::<usize>()\n164\t        )\n165\t    );\n166\t    debug!(\"{}\", metrics);\n167\t    metrics\n168\t}\n169\t\n170\tpub fn format_number_with_underscores(n: usize) -> String {\n171\t    let num_str = n.to_string();\n172\t    let mut result = String::new();\n173\t\n174\t    // Start adding characters from the end of num_str\n175\t    for (i, c) in num_str.chars().rev().enumerate() {\n176\t        if i > 0 && i % 3 == 0 {\n177\t            result.push('_');\n178\t        }\n179\t        result.push(c);\n180\t    }\n181\t\n182\t    // Reverse the result to get the correct order\n183\t    result.chars().rev().collect()\n184\t}\n185\t\n186\t#[cfg(feature = \"metrics\")]\n187\tmod emit {\n188\t    use metrics::counter;\n189\t\n190\t    use super::{SingleTraceMetrics, TraceMetrics};\n191\t\n192\t    impl TraceMetrics {\n193\t        pub fn emit(&self) {\n194\t            for (i, (weighted_sum, threshold)) in self.trace_height_inequalities.iter().enumerate()\n195\t            {\n196\t                let labels = [(\"trace_height_constraint\", i.to_string())];\n197\t                counter!(\"weighted_sum\", &labels).absolute(*weighted_sum as u64);\n198\t                counter!(\"threshold\", &labels).absolute(*threshold as u64);\n199\t            }\n200\t            for trace_metrics in &self.per_air {"}]},"parent_to