{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S4dArvmjwYkMtVrrrzMpjv","type":"tool_result","content":"140\tfn process_air_round0<HS: GpuHashScheme>(\n141\t    w: &Round0AirWorkItem<HS>,\n142\t) -> Result<Round0AirResult, LogupZerocheckError> {\n143\t    let single_pk = w.single_pk;\n144\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n145\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n146\t    assert!(\n147\t        local_constraint_deg <= w.constraint_degree,\n148\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n149\t        w.constraint_degree\n150\t    );\n151\t\n152\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n153\t    let omega_root = F::two_adic_generator(log_large_domain);\n154\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n155\t\n156\t    let height = w.common_main.height();\n157\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n158\t    for committed in w.cached_mains {\n159\t        main_parts.push(committed.trace.buffer().as_ptr());\n160\t    }\n161\t    main_parts.push(w.common_main.buffer().as_ptr());\n162\t    let d_main_parts = main_parts.to_device()?;\n163\t\n164\t    let n_lift = w.n.max(0) as usize;\n165\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n166\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n167\t\n168\t    let sum_buffer = evaluate_round0_constraints_gpu(\n169\t        single_pk,\n170\t        w.selectors_cube.buffer(),\n171\t        &d_main_parts,\n172\t        w.public_values,\n173\t        eq_xi_tree.get_ptr(n_lift),\n174\t        w.d_lambda_pows,\n175\t        1 << w.l_skip,\n176\t        1 << n_lift,\n177\t        height as u32,\n178\t        num_cosets_zc as u32,\n179\t        omega_root,\n180\t        w.max_temp_bytes,\n181\t    )?;\n182\t\n183\t    let zerocheck_poly = if !sum_buffer.is_empty() {\n184\t        let q_evals = sum_buffer.to_host_on_current_stream()?;\n185\t        let q = {\n186\t            let mut values = EF::zero_vec(num_cosets_zc << w.l_skip);\n187\t            for coset_idx in 0..num_cosets_zc {\n188\t                for i in 0..1 << w.l_skip {\n189\t                    values[i * num_cosets_zc + coset_idx] = q_evals[(coset_idx << w.l_skip) + i];\n190\t                }\n191\t            }\n192\t            UnivariatePoly::from_geometric_cosets_evals_idft(\n193\t                RowMajorMatrix::new(values, num_cosets_zc),\n194\t                omega_root,\n195\t                omega_root,\n196\t            )\n197\t        };\n198\t        let sp_0_deg = sumcheck_round0_deg(w.l_skip, local_constraint_deg);\n199\t        let coeffs = (0..=sp_0_deg)\n200\t            .map(|i| {\n201\t                let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n202\t                if i >= 1 << w.l_skip {\n203\t                    c += q.coeffs()[i - (1 << w.l_skip)];\n204\t                }\n205\t                c\n206\t            })\n207\t            .collect_vec();\n208\t        Some(UnivariatePoly::new(coeffs))\n209\t    } else {\n210\t        None\n211\t    };\n212\t\n213\t    let num_cosets_logup = local_constraint_deg;\n214\t    let sum = evaluate_round0_interactions_gpu(\n215\t        single_pk,\n216\t        &single_air_constraints,\n217\t        w.selectors_cube.buffer(),\n218\t        &d_main_parts,\n219\t        w.public_values,\n220\t        eq_xi_tree.get_ptr(n_lift),\n221\t        w.beta_pows,\n222\t        w.eq_3bs,\n223\t        1 << w.l_skip,\n224\t        1 << n_lift,\n225\t        height as u32,\n226\t        num_cosets_logup as u32,\n227\t        omega_root,\n228\t        w.max_temp_bytes,\n229\t    )?;\n230\t\n231\t    let (logup_numer_poly, logup_denom_poly) = if !sum.is_empty() {\n232\t        let evals = sum.to_host_on_current_stream()?;\n233\t        let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n234\t            evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n235\t        if w.n.is_negative() {\n236\t            let norm_factor = F::from_u32(1 << w.n.unsigned_abs()).inverse();\n237\t            for s in &mut numer {\n238\t                *s *= norm_factor;\n239\t            }\n240\t        }\n241\t        let mut numer_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n242\t        let mut denom_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n243\t        for coset_idx in 0..num_cosets_logup {\n244\t            for i in 0..1 << w.l_skip {\n245\t                let src = (coset_idx << w.l_skip) + i;\n246\t                let dst = i * num_cosets_logup + coset_idx;\n247\t                numer_values[dst] = numer[src];\n248\t                denom_values[dst] = denom[src];\n249\t            }\n250\t        }\n251\t        let numer_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n252\t            RowMajorMatrix::new(numer_values, num_cosets_logup),\n253\t            omega_root,\n254\t            F::ONE,\n255\t        );\n256\t        let denom_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n257\t            RowMajorMatrix::new(denom_values, num_cosets_logup),\n258\t            omega_root,\n259\t            F::ONE,\n260\t        );\n261\t        (Some(numer_poly), Some(denom_poly))\n262\t    } else {\n263\t        (None, None)\n264\t    };\n265\t\n266\t    Ok(Round0AirResult {\n267\t        trace_idx: w.trace_idx,\n268\t        zerocheck_poly,\n269\t        logup_numer_poly,\n270\t        logup_denom_poly,\n271\t    })\n272\t}\n273\t\n274\t#[allow(clippy::type_complexity)]\n275\t#[instrument(level = \"info\", skip_all)]\n276\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n277\t    transcript: &mut TS,\n278\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n279\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n280\t    save_memory: bool,\n281\t    monomial_num_y_threshold: u32,\n282\t    sm_count: u32,\n283\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n284\twhere\n285\t    HS: GpuHashScheme,\n286\t    TS: GpuFiatShamirTranscript<HS::SC>,\n287\t{\n288\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n289\t    let l_skip = mpk.params.l_skip;\n290\t    let constraint_degree = mpk.max_constraint_degree;\n291\t    let num_traces = ctx.per_trace.len();\n292\t\n293\t    // Traces are sorted\n294\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n295\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n296\t    // heights\n297\t    let mut total_interactions = 0u64;\n298\t    let interactions_meta: Vec<_> = ctx\n299\t        .per_trace\n300\t        .iter()\n301\t        .map(|(air_idx, air_ctx)| {\n302\t            let pk = &mpk.per_air[*air_idx];\n303\t\n304\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n305\t            let height = air_ctx.common_main.height();\n306\t            let log_height = log2_strict_usize(height);\n307\t            let log_lifted_height = log_height.max(l_skip);\n308\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n309\t            (num_interactions, log_lifted_height)\n310\t        })\n311\t        .collect();\n312\t    // Implicitly, the width of this stacking should be 1\n313\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n314\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n315\t    // GKR\n316\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n317\t\n318\t    // Grind to increase soundness of random sampling for LogUp\n319\t    let logup_pow_witness = transcript\n320\t        .grind_gpu(mpk.params.logup.pow_bits)\n321\t        .map_err(LogupZerocheckError::Grind)?;\n322\t    let alpha_logup = transcript.sample_ext();\n323\t    let beta_logup = transcript.sample_ext();\n324\t    debug!(%alpha_logup, %beta_logup);\n325\t\n326\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n327\t    let mut prover = LogupZerocheckGpu::new(\n328\t        mpk,\n329\t        ctx,\n330\t        n_logup,\n331\t        interactions_layout,\n332\t        alpha_logup,\n333\t        beta_logup,\n334\t        save_memory,\n335\t        monomial_num_y_threshold,\n336\t        sm_count,\n337\t    )?;\n338\t    let n_global = prover.n_global;\n339\t\n340\t    let total_leaves = 1 << (l_skip + n_logup);\n341\t    prover\n342\t        .mem\n343\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n344\t    prover.mem.reset_peak();\n345\t    let (inputs, alpha) = if has_interactions {\n346\t        log_gkr_input_evals(\n347\t            &prover.trace_interactions,\n348\t            mpk,\n349\t            ctx,\n350\t            l_skip,\n351\t            alpha_logup,\n352\t            &prover.d_challenges,\n353\t            total_leaves,\n354\t        )?\n355\t    } else {\n356\t        (DeviceBuffer::new(), EF::ZERO)\n357\t    };\n358\t    // Set memory limit for batch MLE based on inputs buffer size\n359\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n360\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n361\t    if !prover.save_memory {\n362\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n363\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n364\t            tracing::warn!(\n365\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n366\t                prover.memory_limit_bytes\n367\t            );\n368\t        }\n369\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n370\t    }\n371\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n372\t\n373\t    let (frac_sum_proof, mut xi) =\n374\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n375\t    while xi.len() != l_skip + n_global {\n376\t        xi.push(transcript.sample_ext());\n377\t    }\n378\t    debug!(?xi);\n379\t    prover.xi = xi;\n380\t\n381\t    logup_gkr_span.exit();\n382\t\n383\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does\n384\t    // not include the kernel times for the actual folding\n385\t    let round0_span = info_span!(\"prover.rap_constraints.round0\", phase = \"prover\").entered();\n386\t    // begin batch sumcheck\n387\t    let mut sumcheck_round_polys = Vec::with_capacity(n_max);\n388\t    let mut r = Vec::with_capacity(n_max + 1);\n389\t    // batching randomness\n390\t    let lambda = transcript.sample_ext();\n391\t    debug!(%lambda);\n392\t\n393\t    let sp_0_polys = prover.sumcheck_uni_round0_polys(ctx, lambda)?;\n394\t    let s_0_cpu_span = info_span!(\"s'_0 -> s_0 cpu interpolations\").entered();\n395\t    let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_degree);\n396\t    let s_deg = constraint_degree + 1;\n397\t    let s_0_deg = sumcheck_round0_deg(l_skip, s_deg);\n398\t    let large_uni_domain = (s_0_deg + 1).next_power_of_two();\n399\t    let dft = Radix2BowersSerial;\n400\t    let s_0_logup_polys = {\n401\t        let eq_sharp_uni = eq_sharp_uni_poly(&prover.xi[..l_skip]);\n402\t        let mut eq_coeffs = eq_sharp_uni.into_coeffs();\n403\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n404\t        let eq_evals = dft.dft(eq_coeffs);\n405\t\n406\t        let width = 2 * num_traces;\n407\t        let mut sp_coeffs_mat = EF::zero_vec(width * large_uni_domain);\n408\t        for (i, coeffs) in sp_0_polys[..2 * num_traces].iter().enumerate() {\n409\t            for (j, &c_j) in coeffs.coeffs().iter().enumerate().take(sp_0_deg + 1) {\n410\t                // SAFETY:\n411\t                // - coeffs length is <= sp_0_deg + 1 <= s_0_deg < large_uni_domain\n412\t                // - sp_coeffs_mat allocated for width\n413\t                unsafe {\n414\t                    *sp_coeffs_mat.get_unchecked_mut(j * width + i) = c_j;\n415\t                }\n416\t            }\n417\t        }\n418\t        let mut s_evals = dft.dft_batch(RowMajorMatrix::new(sp_coeffs_mat, width));\n419\t        for (eq, row) in zip(eq_evals, s_evals.values.chunks_mut(width)) {\n420\t            for x in row {\n421\t                *x *= eq;\n422\t            }\n423\t        }\n424\t        dft.idft_batch(s_evals)\n425\t    };\n426\t    let skip_domain_size = F::from_usize(1 << l_skip);\n427\t    // logup sum claims (sum_{\\hat p}, sum_{\\hat q}) per present AIR\n428\t    let (numerator_term_per_air, denominator_term_per_air): (Vec<_>, Vec<_>) = (0..num_traces)\n429\t        .map(|trace_idx| {\n430\t            let [sum_claim_p, sum_claim_q] = [0, 1].map(|is_denom| {\n431\t                // Compute sum over D of s_0(Z) to get the sum claim\n432\t                (0..=s_0_deg)\n433\t                    .step_by(1 << l_skip)\n434\t                    .map(|j| unsafe {\n435\t                        // SAFETY: matrix is 2 * num_trace x large_uni_domain, s_0_deg <\n436\t                        // large_uni_domain\n437\t                        *s_0_logup_polys\n438\t                            .values\n439\t                            .get_unchecked(j * 2 * num_traces + 2 * trace_idx + is_denom)"}]},"parent_tool_use_id":"toolu_01LxePP8FrMSYBv54z7JdkgN","session_id":"794cedb4-74b2-4dd2-b512-5aabd1b44ebc","uuid":"2f3532ba-76c8-4e23-b747-b8fec9f8bb1a","timestamp":"2026-04-13T16:39:59.921Z"}
