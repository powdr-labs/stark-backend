{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HnC1mNiRNokxanhkVfA2Xo","type":"tool_result","content":"1\tuse std::{array::from_fn, cmp::max, ffi::c_void, iter::zip, mem, sync::Arc};\n2\t\n3\tuse itertools::{zip_eq, Itertools};\n4\tuse openvm_cuda_common::{\n5\t    copy::{cuda_memcpy, MemCopyD2H, MemCopyH2D},\n6\t    d_buffer::DeviceBuffer,\n7\t    memory_manager::MemTracker,\n8\t};\n9\tuse openvm_stark_backend::{\n10\t    dft::Radix2BowersSerial,\n11\t    p3_matrix::dense::RowMajorMatrix,\n12\t    poly_common::{\n13\t        eq_uni_poly, eval_eq_mle, eval_eq_uni, eval_eq_uni_at_one, eval_in_uni, Squarable,\n14\t        UnivariatePoly,\n15\t    },\n16\t    proof::StackingProof,\n17\t    prover::{\n18\t        stacked_pcs::StackedLayout, sumcheck::sumcheck_round0_deg, DeviceMultiStarkProvingKey,\n19\t        MatrixDimensions, ProvingContext,\n20\t    },\n21\t};\n22\tuse p3_dft::TwoAdicSubgroupDft;\n23\tuse p3_field::{PrimeCharacteristicRing, TwoAdicField};\n24\tuse tracing::{debug, info_span, instrument};\n25\t\n26\tuse crate::{\n27\t    base::DeviceMatrix,\n28\t    cuda::{\n29\t        batch_ntt_small::ensure_device_ntt_twiddles_initialized,\n30\t        poly::vector_scalar_multiply_ext,\n31\t        stacked_reduction::{\n32\t            _stacked_reduction_r0_required_temp_buffer_size,\n33\t            batched_stacked_reduction_sumcheck_mle_round,\n34\t            batched_stacked_reduction_sumcheck_mle_round_degenerate,\n35\t            compute_mle_launch_params, initialize_k_rot_from_eq_segments,\n36\t            stacked_reduction_fold_ple, stacked_reduction_sumcheck_round0, DegenMleDesc,\n37\t            NonDegenMleDesc, NUM_G,\n38\t        },\n39\t        sumcheck::{fold_mle, triangular_fold_mle},\n40\t    },\n41\t    gpu_backend::GenericGpuBackend,\n42\t    hash_scheme::GpuHashScheme,\n43\t    poly::EqEvalSegments,\n44\t    prelude::{Digest, D_EF, EF, F},\n45\t    sponge::GpuFiatShamirTranscript,\n46\t    stacked_pcs::StackedPcsDataGpu,\n47\t    utils::{compute_barycentric_inv_lagrange_denoms, reduce_raw_u64_to_ef},\n48\t    GpuDevice, StackedReductionError,\n49\t};\n50\t\n51\t/// Degree of the sumcheck polynomial for stacked reduction.\n52\tpub const STACKED_REDUCTION_S_DEG: usize = 2;\n53\t\n54\tpub struct StackedReductionGpu<D = Digest> {\n55\t    sm_count: u32,\n56\t\n57\t    l_skip: usize,\n58\t    n_stack: usize,\n59\t\n60\t    omega_skip: F,\n61\t    omega_skip_pows: Vec<F>,\n62\t    d_omega_skip_pows: DeviceBuffer<F>,\n63\t\n64\t    r_0: EF,\n65\t    d_lambda_pows: DeviceBuffer<EF>,\n66\t    eq_const: EF,\n67\t\n68\t    pub(crate) stacked_per_commit: Vec<StackedPcsData2<D>>,\n69\t    d_q_widths: DeviceBuffer<u32>,\n70\t    q_width_max: u32,\n71\t    d_q_eval_ptrs: DeviceBuffer<*const EF>,\n72\t\n73\t    trace_ptrs: Vec<(\n74\t        *const F, /* trace_ptr */\n75\t        usize,    /* height */\n76\t        usize,    /* width */\n77\t    )>,\n78\t    unstacked_cols: Vec<UnstackedSlice>,\n79\t    d_unstacked_cols: DeviceBuffer<UnstackedSlice>,\n80\t    // boundary indices where heights change. all columns between two boundaries must have the same\n81\t    // height. We can have multiple chunks of the same height if that is needed to reduce peak GPU\n82\t    // memory.\n83\t    ht_diff_idxs: Vec<usize>,\n84\t    n_max: usize,\n85\t\n86\t    // Initially holds eq(r[1..=n], H_n) for n=0..=n_max but gets updated after each sumcheck round\n87\t    // by some custom folding\n88\t    eq_r_ns: EqEvalSegments<EF>,\n89\t\n90\t    // == After round 0 ==\n91\t    q_evals: Vec<DeviceBuffer<EF>>, // get width from stacked_per_commit\n92\t    // Stores folded eq values that won't change anymore (no more folding)\n93\t    // Corresponds to log_height in 0..l_skip+round-1 _before_ round `round`. Gets updated with one\n94\t    // new element after each round.\n95\t    eq_stable: Vec<EF>,\n96\t    k_rot_stable: Vec<EF>,\n97\t\n98\t    /// Stores the folded k_rot evaluations for `\\kappa_\\rot(x, r) = eq_n(rot^{-1}(x), r)` for each\n99\t    /// `n` after each round. We use the [EqEvalSegments] type to guard the segment-based\n100\t    /// memory layout.\n101\t    k_rot_ns: EqEvalSegments<EF>,\n102\t    /// Stores eq(u[1+n_T..round-1], b_{T,j}[..round-n_T-1])\n103\t    eq_ub_per_trace: Vec<EF>,\n104\t    d_eq_ub_all: DeviceBuffer<EF>,\n105\t\n106\t    d_block_sums: DeviceBuffer<EF>,\n107\t    d_accum: DeviceBuffer<u64>,\n108\t    d_input_ptrs: DeviceBuffer<*const EF>,\n109\t    d_output_ptrs: DeviceBuffer<*mut EF>,\n110\t\n111\t    mem: MemTracker,\n112\t}\n113\t\n114\t/// A struct for holding stacked pcs data. We only need the `MerkleTreeGpu` from `StackedPcsDataGpu`\n115\t/// but we wrap the latter in an `Arc` to provide uniformity in dealing with common main and\n116\t/// preprocessed/cached traces. This struct stores the unstacked `traces`, in prismalinear\n117\t/// evaluation form, corresponding to the stacked pcs data.\n118\t///\n119\t/// Generic over the Merkle digest type `D`.  The default `D = Digest` preserves the existing\n120\t/// BabyBear-Poseidon2 behaviour.\n121\tpub struct StackedPcsData2<D = Digest> {\n122\t    pub(crate) inner: Arc<StackedPcsDataGpu<F, D>>,\n123\t    /// The unstacked traces corresponding to `inner`'s commitment.\n124\t    pub(crate) traces: Vec<DeviceMatrix<F>>,\n125\t}\n126\t\n127\timpl<D> StackedPcsData2<D> {\n128\t    /// # Safety\n129\t    /// `traces` must be the traces that were committed to in `pcs_data`.\n130\t    pub unsafe fn from_raw(\n131\t        pcs_data: Arc<StackedPcsDataGpu<F, D>>,\n132\t        traces: Vec<DeviceMatrix<F>>,\n133\t    ) -> Self {\n134\t        Self {\n135\t            inner: pcs_data,\n136\t            traces,\n137\t        }\n138\t    }\n139\t\n140\t    pub fn layout(&self) -> &StackedLayout {\n141\t        &self.inner.layout\n142\t    }\n143\t}\n144\t\n145\t/// Pointer with length to location in a big device buffer. The device buffer is identified by\n146\t/// `commit_idx`. Due to pecuarlities with `l_skip`, the length of the slice is defined as\n147\t/// `max(2^log_height, 2^l_skip)`. In other words, this is a pointer to the slice\n148\t/// `q[commit_idx].column(stacked_col_idx)[stacked_row_idx..stacked_row_idx + len]`.\n149\t///\n150\t/// # Safety\n151\t/// - this type is `repr(C)` as it will cross FFI boundaries for CUDA usage.\n152\t#[repr(C)]\n153\t#[derive(Clone, Copy, Debug)]\n154\tpub(crate) struct UnstackedSlice {\n155\t    commit_idx: u32,\n156\t    log_height: u32,\n157\t    stacked_row_idx: u32,\n158\t    stacked_col_idx: u32,\n159\t}\n160\t\n161\timpl<D> StackedReductionGpu<D> {\n162\t    fn log_stacked_height(&self, round: usize) -> usize {\n163\t        self.n_stack - (round - 1)\n164\t    }\n165\t\n166\t    fn stacked_height(&self, round: usize) -> usize {\n167\t        1 << self.log_stacked_height(round)\n168\t    }\n169\t\n170\t    /// Current maximum `n` supported by eq_r_ns\n171\t    fn cur_max_n(&self, round: usize) -> usize {\n172\t        self.n_max - (round - 1)\n173\t    }\n174\t}\n175\t\n176\t/// Batch sumcheck to reduce trace openings, including rotations, to stacked matrix opening.\n177\t///\n178\t/// The `stacked_matrix, stacked_layout` should be the result of stacking the `traces` with\n179\t/// parameters `l_skip` and `n_stack`.\n180\t#[allow(clippy::type_complexity)]\n181\t#[instrument(\n182\t    name = \"prover.openings.stacked_reduction\",\n183\t    level = \"info\",\n184\t    skip_all,\n185\t    fields(phase = \"prover\")\n186\t)]\n187\tpub fn prove_stacked_opening_reduction_gpu<HS, TS>(\n188\t    device: &GpuDevice,\n189\t    transcript: &mut TS,\n190\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n191\t    ctx: ProvingContext<GenericGpuBackend<HS>>,\n192\t    common_main_pcs_data: StackedPcsDataGpu<F, HS::Digest>,\n193\t    r: &[EF],\n194\t) -> Result<\n195\t    (\n196\t        StackingProof<HS::SC>,\n197\t        Vec<EF>,\n198\t        Vec<StackedPcsData2<HS::Digest>>,\n199\t    ),\n200\t    StackedReductionError,\n201\t>\n202\twhere\n203\t    HS: GpuHashScheme,\n204\t    TS: GpuFiatShamirTranscript<HS::SC>,\n205\t{\n206\t    let n_stack = device.config.n_stack;\n207\t    // Batching randomness\n208\t    let lambda = transcript.sample_ext();\n209\t\n210\t    let _round0_span =\n211\t        info_span!(\"prover.openings.stacked_reduction.round0\", phase = \"prover\").entered();\n212\t    let mut prover = StackedReductionGpu::new::<HS>(\n213\t        mpk,\n214\t        ctx,\n215\t        common_main_pcs_data,\n216\t        r,\n217\t        lambda,\n218\t        device.sm_count(),\n219\t    )?;\n220\t\n221\t    // Round 0: univariate sumcheck\n222\t    let s_0 = prover.batch_sumcheck_uni_round0_poly()?;\n223\t    for &coeff in s_0.coeffs() {\n224\t        transcript.observe_ext(coeff);\n225\t    }\n226\t\n227\t    let mut u_vec = Vec::with_capacity(n_stack + 1);\n228\t    let u_0 = transcript.sample_ext();\n229\t    u_vec.push(u_0);\n230\t    debug!(round = 0, u_round = %u_0);\n231\t\n232\t    prover.fold_ple_evals(u_0)?;\n233\t    drop(_round0_span);\n234\t    // end round 0\n235\t\n236\t    let mut sumcheck_round_polys = Vec::with_capacity(n_stack);\n237\t\n238\t    // Rounds 1..=n_stack: MLE sumcheck\n239\t    let _mle_rounds_span = info_span!(\n240\t        \"prover.openings.stacked_reduction.mle_rounds\",\n241\t        phase = \"prover\"\n242\t    )\n243\t    .entered();\n244\t    #[allow(clippy::needless_range_loop)]\n245\t    for round in 1..=n_stack {\n246\t        let batch_s_evals = prover.batch_sumcheck_poly_eval(round, u_vec[round - 1])?;\n247\t\n248\t        for &eval in &batch_s_evals {\n249\t            transcript.observe_ext(eval);\n250\t        }\n251\t        sumcheck_round_polys.push(batch_s_evals);\n252\t\n253\t        let u_round = transcript.sample_ext();\n254\t        u_vec.push(u_round);\n255\t        debug!(%round, %u_round);\n256\t\n257\t        prover.fold_mle_evals(round, u_round)?;\n258\t    }\n259\t    let stacking_openings = prover.get_stacked_openings()?;\n260\t    for claims_for_com in &stacking_openings {\n261\t        for &claim in claims_for_com {\n262\t            transcript.observe_ext(claim);\n263\t        }\n264\t    }\n265\t    drop(_mle_rounds_span);\n266\t    let proof = StackingProof {\n267\t        univariate_round_coeffs: s_0.into_coeffs(),\n268\t        sumcheck_round_polys,\n269\t        stacking_openings,\n270\t    };\n271\t    Ok((proof, u_vec, prover.stacked_per_commit))\n272\t}\n273\t\n274\timpl<D: Copy + Clone + Send + Sync + 'static> StackedReductionGpu<D> {\n275\t    #[instrument(\"stacked_reduction_new\", level = \"debug\", skip_all)]\n276\t    fn new<HS: GpuHashScheme<Digest = D>>(\n277\t        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n278\t        ctx: ProvingContext<GenericGpuBackend<HS>>,\n279\t        common_main_pcs_data: StackedPcsDataGpu<F, D>,\n280\t        r: &[EF],\n281\t        lambda: EF,\n282\t        sm_count: u32,\n283\t    ) -> Result<Self, StackedReductionError> {\n284\t        ensure_device_ntt_twiddles_initialized();\n285\t        let mem = MemTracker::start(\"prover.stacked_reduction_new\");\n286\t        let l_skip = mpk.params.l_skip;\n287\t        let n_stack = mpk.params.n_stack;\n288\t\n289\t        let omega_skip = F::two_adic_generator(l_skip);\n290\t        let omega_skip_pows = omega_skip.powers().take(1 << l_skip).collect_vec();\n291\t        let d_omega_skip_pows = omega_skip_pows.to_device()?;\n292\t\n293\t        // NOTE: DeviceMatrix contains an Arc, so clone is lightweight [for now].\n294\t        // PERF[jpw]: stack the traces all at once. To save memory, we could either stack and drop\n295\t        // traces as we go or even at commit time only store the stacked matrix and drop the traces\n296\t        // much earlier.\n297\t        let common_main_traces = ctx\n298\t            .per_trace\n299\t            .iter()\n300\t            .map(|(_, air_ctx)| air_ctx.common_main.clone())\n301\t            .collect_vec();\n302\t        // SAFETY: common_main_traces commits to common_main_pcs_data\n303\t        let common_main_stacked = unsafe {\n304\t            StackedPcsData2::from_raw(Arc::new(common_main_pcs_data), common_main_traces)\n305\t        };\n306\t        let mut stacked_per_commit = vec![common_main_stacked];\n307\t        for (air_idx, air_ctx) in ctx.per_trace.iter() {\n308\t            for committed in mpk.per_air[*air_idx]\n309\t                .preprocessed_data\n310\t                .iter()\n311\t                .chain(air_ctx.cached_mains.iter())\n312\t            {\n313\t                // SAFETY: committed.trace commits to committed.data\n314\t                let stacked = unsafe {\n315\t                    StackedPcsData2::from_raw(committed.data.clone(), vec![committed.trace.clone()])\n316\t                };\n317\t                stacked_per_commit.push(stacked);\n318\t            }\n319\t        }\n320\t\n321\t        debug_assert!(stacked_per_commit\n322\t            .iter()\n323\t            .all(|d| d.layout().height() == 1 << (l_skip + n_stack)));\n324\t\n325\t        let need_rot_per_trace = ctx\n326\t            .per_trace\n327\t            .iter()\n328\t            .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n329\t            .collect_vec();\n330\t        let mut need_rot_per_commit = vec![need_rot_per_trace];\n331\t        for (air_idx, air_ctx) in ctx.per_trace.iter() {\n332\t            let need_rot = mpk.per_air[*air_idx].vk.params.need_rot;\n333\t            if mpk.per_air[*air_idx].preprocessed_data.is_some() {\n334\t                need_rot_per_commit.push(vec![need_rot]);\n335\t            }\n336\t            for _ in &air_ctx.cached_mains {\n337\t                need_rot_per_commit.push(vec![need_rot]);\n338\t            }\n339\t        }\n340\t        let q_widths = stacked_per_commit\n341\t            .iter()\n342\t            .map(|d| d.layout().width() as u32)\n343\t            .collect_vec();\n344\t        let q_width_max = *q_widths.iter().max().unwrap();\n345\t        let d_q_widths = q_widths.to_device()?;\n346\t\n347\t        let total_num_cols: usize = stacked_per_commit\n348\t            .iter()\n349\t            .map(|d| d.layout().sorted_cols.len())\n350\t            .sum();\n351\t        let mut unstacked_cols = Vec::with_capacity(total_num_cols);\n352\t        let mut need_rot_per_col = Vec::with_capacity(total_num_cols);\n353\t        let mut ht_diff_idxs = Vec::new();\n354\t        let mut trace_ptrs = Vec::new();\n355\t        for (commit_idx, stacked) in stacked_per_commit.iter().enumerate() {\n356\t            let layout = stacked.layout();\n357\t            let need_rot_for_commit = &need_rot_per_commit[commit_idx];\n358\t            debug_assert_eq!(need_rot_for_commit.len(), layout.mat_starts.len());\n359\t            for (mat_idx, (trace, &idx)) in zip_eq(&stacked.traces, &layout.mat_starts).enumerate()\n360\t            {\n361\t                debug_assert_ne!(trace.width(), 0);\n362\t                debug_assert_ne!(trace.height(), 0);\n363\t                ht_diff_idxs.push(unstacked_cols.len());\n364\t                trace_ptrs.push((trace.buffer().as_ptr(), trace.height(), trace.width()));\n365\t                let need_rot = need_rot_for_commit[mat_idx];\n366\t                for j in 0..trace.width() {\n367\t                    let (_, _j, s) = layout.sorted_cols[idx + j];\n368\t                    debug_assert_eq!(_j, j);\n369\t                    debug_assert_eq!(1 << s.log_height(), trace.height());\n370\t                    unstacked_cols.push(UnstackedSlice {\n371\t                        commit_idx: commit_idx as u32,\n372\t                        log_height: s.log_height() as u32,\n373\t                        stacked_row_idx: s.row_idx as u32,\n374\t                        stacked_col_idx: s.col_idx as u32,\n375\t                    });\n376\t                    need_rot_per_col.push(need_rot);\n377\t                }\n378\t            }\n379\t        }\n380\t        debug_assert_eq!(unstacked_cols.len(), total_num_cols);\n381\t        ht_diff_idxs.push(unstacked_cols.len());\n382\t\n383\t        let lambda_pows_used = lambda.powers().take(total_num_cols * 2).collect_vec();\n384\t        let mut lambda_pows = vec![EF::ZERO; total_num_cols * 2];\n385\t        for (col_idx, need_rot) in need_rot_per_col.into_iter().enumerate() {\n386\t            let lambda_eq_idx = 2 * col_idx;\n387\t            let lambda_rot_idx = 2 * col_idx + 1;\n388\t            lambda_pows[lambda_eq_idx] = lambda_pows_used[lambda_eq_idx];\n389\t            if need_rot {\n390\t                lambda_pows[lambda_rot_idx] = lambda_pows_used[lambda_rot_idx];\n391\t            }\n392\t        }\n393\t        let d_lambda_pows = lambda_pows.to_device()?;\n394\t\n395\t        let d_unstacked_cols = unstacked_cols.to_device()?;\n396\t\n397\t        // layout per commit is sorted, first height is largest\n398\t        let n_max = r.len() - 1;\n399\t        debug_assert_eq!(\n400\t            n_max,"}]},"parent_tool_use_id":"toolu_019wqGWSkPXuYFUbgtiP716f","session_id":"794cedb4-74b2-4dd2-b512-5aabd1b44ebc","uuid":"2743fb41-3490-4472-be43-e9f2cd5456a2","timestamp":"2026-04-13T16:40:02.711Z"}
