{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Acwp5eBocJ3F8BWdpX2e7n","type":"tool_result","content":"0\t// GKR fractional sumcheck CUDA kernels. See docs/cuda-backend/gkr-prover.md (repo root)\n1\t// for the protocol and implementation details.\n2\t\n3\t#include \"fp.h\"\n4\t#include \"fpext.h\"\n5\t#include \"frac_ext.cuh\"\n6\t#include \"launcher.cuh\"\n7\t#include \"sumcheck.cuh\"\n8\t#include \"utils.cuh\"\n9\t#include <algorithm>\n10\t#include <cassert>\n11\t#include <cstddef>\n12\t#include <cstdint>\n13\t#include <cuda_runtime_api.h>\n14\t#include <driver_types.h>\n15\t#include <utility>\n16\t#include <vector_types.h>\n17\t\n18\t// Includes GKR for fractional sumcheck\n19\t// The LogUp specific input to GKR is calculated in interactions.cu\n20\tnamespace fractional_sumcheck_gkr {\n21\t// Degree of s' polynomial (factored out the first eq term)\n22\tconstexpr int GKR_SP_DEG = 2;\n23\t// ============================================================================\n24\t// KERNELS\n25\t// ============================================================================\n26\ttemplate <bool revert, bool apply_alpha = false>\n27\t__global__ void frac_build_tree_layer_kernel(\n28\t    FracExt *__restrict__ layer,\n29\t    uint32_t half,\n30\t    FpExt alpha = FpExt(Fp(0))\n31\t) {\n32\t    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;\n33\t    if (idx >= half) {\n34\t        return;\n35\t    }\n36\t\n37\t    if constexpr (apply_alpha) {\n38\t        // When applying alpha, we need to modify both operands before combining\n39\t        // Read both values, apply alpha to denominators, then combine\n40\t        FracExt lhs_val = layer[idx];\n41\t        FracExt rhs_val = layer[idx | half];\n42\t        lhs_val.q = lhs_val.q + alpha;\n43\t        rhs_val.q = rhs_val.q + alpha;\n44\t\n45\t        if constexpr (revert) {\n46\t            frac_unadd_inplace(lhs_val, rhs_val);\n47\t        } else {\n48\t            frac_add_inplace(lhs_val, rhs_val);\n49\t        }\n50\t\n51\t        layer[idx] = lhs_val;\n52\t    } else {\n53\t        // Original fast path: use references for in-place modification\n54\t        FracExt &lhs = layer[idx];\n55\t        FracExt const &rhs = layer[idx | half];\n56\t\n57\t        if constexpr (revert) {\n58\t            frac_unadd_inplace(lhs, rhs);\n59\t        } else {\n60\t            frac_add_inplace(lhs, rhs);\n61\t        }\n62\t    }\n63\t}\n64\t\n65\t// Reconstruct eq weight from sqrt-decomposed buffers.\n66\t// See docs/cuda-backend/gkr-prover.md § \"Eq buffer sqrt decomposition\".\n67\t__device__ __forceinline__ FpExt sqrt_buffer_get(\n68\t    const FpExt *__restrict__ eq_xi_low,\n69\t    const FpExt *__restrict__ eq_xi_high,\n70\t    uint32_t const log_eq_low_cap,\n71\t    uint32_t const idx\n72\t) {\n73\t    return eq_xi_low[idx & ((1u << log_eq_low_cap) - 1)] * eq_xi_high[idx >> log_eq_low_cap];\n74\t}\n75\t\n76\t// Accumulate GKR sumcheck contributions for s'_t(1) and s'_t(2).\n77\t// See docs/cuda-backend/gkr-prover.md § \"Sumcheck round implementation\".\n78\t__device__ __forceinline__ void accumulate_compute_contributions(\n79\t    const FpExt *__restrict__ eq_xi_low,\n80\t    const FpExt *__restrict__ eq_xi_high,\n81\t    uint32_t idx,\n82\t    uint32_t log_eq_low_cap,\n83\t    FpExt lambda,\n84\t    FpExt p0_even, FpExt q0_even, FpExt p0_odd, FpExt q0_odd,\n85\t    FpExt p1_even, FpExt q1_even, FpExt p1_odd, FpExt q1_odd,\n86\t    FpExt &local0, FpExt &local1\n87\t) {\n88\t    FpExt eq_val = sqrt_buffer_get(eq_xi_low, eq_xi_high, log_eq_low_cap, idx);\n89\t\n90\t    FpExt p0_diff = p0_odd - p0_even;\n91\t    FpExt q0_diff = q0_odd - q0_even;\n92\t    FpExt p1_diff = p1_odd - p1_even;\n93\t    FpExt q1_diff = q1_odd - q1_even;\n94\t\n95\t    FpExt p_j0 = p0_even + lambda * q0_even;\n96\t    FpExt q_j0 = q0_even;\n97\t    FpExt p_j1 = p1_even;\n98\t    FpExt q_j1 = q1_even;\n99\t\n100\t    auto const lambda_times_q0_diff = lambda * q0_diff;\n101\t\n102\t#pragma unroll\n103\t    for (int i = 0; i < GKR_SP_DEG; ++i) {\n104\t        p_j0 += p0_diff;\n105\t        p_j0 += lambda_times_q0_diff;\n106\t        q_j0 += q0_diff;\n107\t        p_j1 += p1_diff;\n108\t        q_j1 += q1_diff;\n109\t\n110\t        FpExt contrib = eq_val * (p_j0 * q_j1 + p_j1 * q_j0);\n111\t        if (i == 0) local0 += contrib;\n112\t        else local1 += contrib;\n113\t    }\n114\t}\n115\t\n116\t// Helper: Perform block reduction on two accumulators and write to block_sums.\n117\t__device__ __forceinline__ void reduce_block_sums(\n118\t    FpExt *shared,\n119\t    FpExt local0, FpExt local1,\n120\t    FpExt *__restrict__ block_sums\n121\t) {\n122\t    {\n123\t        FpExt reduced = sumcheck::block_reduce_sum(local0, shared);\n124\t        if (threadIdx.x == 0) block_sums[blockIdx.x * GKR_SP_DEG + 0] = reduced;\n125\t    }\n126\t    __syncthreads();\n127\t    {\n128\t        FpExt reduced = sumcheck::block_reduce_sum(local1, shared);\n129\t        if (threadIdx.x == 0) block_sums[blockIdx.x * GKR_SP_DEG + 1] = reduced;\n130\t    }\n131\t}\n132\t\n133\t// shared memory size requirement: max(num_warps,1) * sizeof(FpExt)\n134\t// Computes s' polynomial evaluations at 1 and 2 (first eq term factored out).\n135\t__global__ void compute_round_block_sum_kernel(\n136\t    const FpExt *__restrict__ eq_xi_low,\n137\t    const FpExt *__restrict__ eq_xi_high,\n138\t    const FracExt *__restrict__ pq_buffer,\n139\t    uint32_t num_x,\n140\t    uint32_t log_eq_low_cap,\n141\t    FpExt lambda,\n142\t    FpExt *__restrict__ block_sums // Output: [gridDim.x][2]\n143\t) {\n144\t    extern __shared__ FpExt shared[];\n145\t    const uint32_t pq_size = 2 * num_x;\n146\t\n147\t    const FpExt zero(Fp::zero());\n148\t    FpExt local[GKR_SP_DEG] = {zero, zero};\n149\t    uint32_t idx_base = threadIdx.x + blockIdx.x * blockDim.x;"}]},"parent_tool_use_id":"toolu_01Dp5KkZAhmqRxX8kHPvjXQH","session_id":"794cedb4-74b2-4dd2-b512-5aabd1b44ebc","uuid":"ecc74240-4a24-41e9-a907-d5