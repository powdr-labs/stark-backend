92\textern \"C\" int _frac_vector_scalar_multiply_ext_fp(FracExt *frac_vec, Fp scalar, uint32_t length) {\n1293\t    auto [grid, block] = kernel_launch_params(length);\n1294\t    frac_vector_scalar_multiply_kernel<Fp, FpExt>\n1295\t        <<<grid, block>>>(reinterpret_cast<std::pair<FpExt, FpExt> *>(frac_vec), scalar, length);\n1296\t    return CHECK_KERNEL();\n1297\t}\n1298\t\n1299\t\n1300\t// ============================================================================\n1301\t// Fused bit-reversal + K=2 GKR tree-build\n1302\t// ============================================================================\n1303\t\n1304\t// bit_rev() and index_t redeclared from supra/include/ntt/{ntt.cuh,parameters.cuh}\n1305\t// because the supra include path is not on the cuda-backend build search path.\n1306\ttypedef unsigned int index_t;\n1307\ttemplate<typename T>\n1308\t__device__ __forceinline__\n1309\tT bit_rev(T i, unsigned int nbits)\n1310\t{\n1311\t    return __brev(i) >> (8 * sizeof(unsigned int) - nbits);\n1312\t}\n1313\t\n1314\t// Fused bit-reversal + K=2 GKR tree-build kernel for FracExt.\n1315\t//\n1316\t// DERIVED FROM: bit_rev_permutation_z<T, Z_COUNT> in supra/ntt_bitrev.cu.\n1317\t// Diff vs the original template kernel:\n1318\t//   - Z_COUNT = 8 hardcoded (not a template param)\n1319\t//   - In-place: single `inout` pointer (original has separate `out`/`in`)\n1320\t//   - No poly_count / no 2-D grid: operates on one poly only\n1321\t//   - Extra `alpha` parameter: adds alpha to every denominator after bit-reversing\n1322\t//   - Two GKR tree layers (K=2) are computed inside shmem before writing to global mem,\n1323\t//     eliminating two separate kernel passes"}]},"parent_tool_use_id":"toolu_01Dp5KkZAhmqRxX8kHPvjXQH","session_id":"794cedb4-74b2-4dd2-b512-5aabd1b44ebc","uuid":"8069ec30-6710-4b37-8fa6-66989dec1316","timestamp":"2026-04-13T16:40:03.782Z"}
