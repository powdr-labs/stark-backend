t        self.mat_evals_per_trace = ctx\n1000\t            .per_trace\n1001\t            .iter()\n1002\t            .map(|(air_idx, air_ctx)| {\n1003\t                let air_pk = &self.pk.per_air[*air_idx];\n1004\t                let need_rot = air_pk.vk.params.need_rot;\n1005\t                let mut results: Vec<DeviceMatrix<EF>> = Vec::new();\n1006\t\n1007\t                // Preprocessed (if exists)\n1008\t                if let Some(committed) = &air_pk.preprocessed_data {\n1009\t                    let trace = &committed.trace;\n1010\t                    let folded = fold_ple_evals_rotate(\n1011\t                        l_skip,\n1012\t                        &self.d_omega_skip_pows,\n1013\t                        trace,\n1014\t                        &d_inv_lagrange_denoms_r0,\n1015\t                        need_rot,\n1016\t                    )?;\n1017\t                    results.push(folded);\n1018\t                }\n1019\t\n1020\t                // Cached mains\n1021\t                for committed in &air_ctx.cached_mains {\n1022\t                    let trace = &committed.trace;\n1023\t                    let folded = fold_ple_evals_rotate(\n1024\t                        l_skip,\n1025\t                        &self.d_omega_skip_pows,\n1026\t                        trace,\n1027\t                        &d_inv_lagrange_denoms_r0,\n1028\t                        need_rot,\n1029\t                    )?;\n1030\t                    results.push(folded);\n1031\t                }\n1032\t\n1033\t                // Common main\n1034\t                let trace = &air_ctx.common_main;\n1035\t                let folded = fold_ple_evals_rotate(\n1036\t                    l_skip,\n1037\t                    &self.d_omega_skip_pows,\n1038\t                    trace,\n1039\t                    &d_inv_lagrange_denoms_r0,\n1040\t                    need_rot,\n1041\t                )?;\n1042\t                mem_limit = mem_limit.saturating_sub(folded.buffer().len() * size_of::<EF>());\n1043\t                results.push(folded);\n1044\t\n1045\t                Ok(results)\n1046\t            })\n1047\t            .collect::<Result<Vec<_>, FoldPleError>>()?;\n1048\t        if self.save_memory {\n1049\t            self.memory_limit_bytes = mem_limit;\n1050\t        }\n1051\t\n1052\t        // GPU folding for sels_per_trace (rotate=false, only need offset=0)\n1053\t        self.sels_per_trace = std::mem::take(&mut self.sels_per_trace_base)\n1054\t            .into_iter()\n1055\t            .enumerate()\n1056\t            .map(|(trace_idx, selectors_cube)| {\n1057\t                let n = self.n_per_trace[trace_idx];\n1058\t                let num_x = selectors_cube.height();\n1059\t                debug_assert_eq!(num_x, 1 << n.max(0));"}]},"parent_tool_use_id":"toolu_01LxePP8FrMSYBv54z7JdkgN","session_id":"794cedb4-74b2-4dd2-b512-5aabd1b44ebc","uuid":"70db4a73-942b-401f-985c-77499c3edf9e","timestamp":"2026-04-13T16:40:09.763Z"}
