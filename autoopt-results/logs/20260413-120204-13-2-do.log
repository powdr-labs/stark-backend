{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01QuC3rLo8CoWRQ5W4YmXQen","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NMzvZoXnzrUw7wLBgbB1yo","name":"Edit","input":{"replace_all":false,"file_path":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/round0.rs","old_string":"    Ok(s_evals)\n}","new_string":"    Ok(s_evals)\n}\n\n/// Descriptor for one AIR in a batched Round 0 group.\npub(crate) struct BatchedR0AirDesc {\n    /// Index into the original work_items/trace order\n    pub trace_idx: usize,\n    pub num_x: u32,\n    pub height: u32,\n    pub g_shift: F,\n    pub buffer_size_zc: u32,\n    pub buffer_size_logup: u32,\n    pub num_cosets_zc: u32,\n    pub num_cosets_logup: u32,\n    // Pointers — valid for the duration of the kernel launch\n    pub selectors_cube: *const F,\n    pub preprocessed: *const F,\n    pub d_main_parts: *const *const F,\n    pub eq_cube: *const EF,\n    pub lambda_pows: *const EF,\n    pub public_values: *const F,\n    // Zerocheck rules (from pkey)\n    pub d_zc_rules: *const std::ffi::c_void,\n    pub d_zc_used_nodes: *const usize,\n    pub zc_rules_len: usize,\n    pub zc_used_nodes_len: usize,\n    pub lambda_len: usize,\n    // Logup rules (built at prove time) — None if no interactions\n    pub logup_rules: Option<BatchedR0LogupRules>,\n}\n\n/// Pre-built logup rules for one AIR.\npub(crate) struct BatchedR0LogupRules {\n    pub d_rules: DeviceBuffer<u128>,\n    pub rules_len: usize,\n    pub buffer_size: u32,\n    pub d_numer_weights: DeviceBuffer<EF>,\n    pub d_denom_weights: DeviceBuffer<EF>,\n    pub denom_sum_init: EF,\n}\n\n/// Build logup rules for a single AIR (same logic as evaluate_round0_interactions_gpu).\n#[allow(clippy::too_many_arguments)]\npub(crate) fn build_logup_rules_for_air<HS: GpuHashScheme>(\n    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n    symbolic: &SymbolicConstraints<F>,\n    beta_pows: &[EF],\n    eq_3bs: &[EF],\n) -> Result<Option<BatchedR0LogupRules>, Round0EvalError> {\n    if eq_3bs.is_empty() {\n        return Ok(None);\n    }\n\n    let mut dag_builder = SymbolicDagBuilder::new();\n    let mut sorted_used_dag_idxs = Vec::new();\n    for interaction in &symbolic.interactions {\n        let count = dag_builder.add_expr(&interaction.count);\n        sorted_used_dag_idxs.push(count);\n        sorted_used_dag_idxs.extend(\n            interaction\n                .message\n                .iter()\n                .map(|field_expr| dag_builder.add_expr(field_expr)),\n        );\n    }\n    sorted_used_dag_idxs.sort();\n    sorted_used_dag_idxs.dedup();\n    let dag = SymbolicExpressionDag {\n        nodes: dag_builder.nodes,\n        constraint_idx: sorted_used_dag_idxs,\n    };\n    let rules = SymbolicRulesGpu::new(&dag, true);\n    let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n    let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n    let mut denom_sum_init = EF::ZERO;\n    for (interaction_idx, interaction) in symbolic.interactions.iter().enumerate() {\n        let count_dag_idx =\n            dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];\n        let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n        numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n        denom_sum_init += eq_3bs[interaction_idx]\n            * beta_pows[interaction.message.len()]\n            * F::from_u32(interaction.bus_index as u32 + 1);\n\n        for (message_idx, message) in interaction.message.iter().enumerate() {\n            let message_dag_idx =\n                dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n            let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n            denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];\n        }\n    }\n    let d_numer_weights = numer_weights.to_device()?;\n    let d_denom_weights = denom_weights.to_device()?;\n    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n    let d_rules = encoded_rules.to_device()?;\n\n    Ok(Some(BatchedR0LogupRules {\n        d_rules,\n        rules_len: rules.rules.len(),\n        buffer_size: rules.buffer_size.try_into().unwrap(),\n        d_numer_weights,\n        d_denom_weights,\n        denom_sum_init,\n    }))\n}\n\nconst COSET_PARALLEL_THRESHOLD: u32 = 32768;\nconst MAX_THREADS: u32 = 128;\n\n/// Evaluate batched Round 0 zerocheck constraints for a group of AIRs with the same num_cosets.\n///\n/// Returns a flat buffer of `[num_airs][num_cosets * skip_domain]` EF values.\n#[allow(clippy::too_many_arguments)]\npub(crate) fn evaluate_batched_zerocheck_group(\n    descs: &[&BatchedR0AirDesc],\n    num_cosets: u32,\n    skip_domain: u32,\n) -> Result<DeviceBuffer<EF>, Round0EvalError> {\n    if descs.is_empty() || num_cosets == 0 {\n        return Ok(DeviceBuffer::new());\n    }\n\n    let l_skip = skip_domain.trailing_zeros();\n    let max_num_x = descs.iter().map(|d| d.num_x).max().unwrap_or(1);\n    let block_x = std::cmp::min(MAX_THREADS, skip_domain * max_num_x);\n    // Ensure block_x is a multiple of skip_domain\n    let block_x = (block_x / skip_domain) * skip_domain;\n    let x_per_block = block_x / skip_domain;\n\n    // Build block contexts and compute offsets\n    let mut block_ctxs_h = Vec::new();\n    let mut air_offsets_h: Vec<u32> = vec![0];\n    let mut total_intermediates: usize = 0;\n\n    // Pre-compute per-AIR intermediates sizes and buffer_strides\n    struct AirLayout {\n        num_x_blocks: u32,\n        blocks_per_air: u32,\n        buffer_stride: u32,\n        intermediates_size: usize,\n    }\n    let layouts: Vec<AirLayout> = descs\n        .iter()\n        .map(|d| {\n            let num_x_blocks = d.num_x.div_ceil(x_per_block);\n            let blocks_per_air = num_x_blocks * num_cosets;\n            let buffer_stride = num_cosets * num_x_blocks * block_x;\n            let intermediates_size = if d.buffer_size_zc > BUFFER_THRESHOLD {\n                buffer_stride as usize * d.buffer_size_zc as usize\n            } else {\n                0\n            };\n            AirLayout {\n                num_x_blocks,\n                blocks_per_air,\n                buffer_stride,\n                intermediates_size,\n            }\n        })\n        .collect();\n\n    for (local_air_idx, (d, layout)) in descs.iter().zip(&layouts).enumerate() {\n        for local_block in 0..layout.blocks_per_air {\n            block_ctxs_h.push(Round0BlockCtx {\n                local_block_idx: local_block,\n                air_idx: local_air_idx as u32,\n            });\n        }\n        air_offsets_h.push(*air_offsets_h.last().unwrap() + layout.blocks_per_air);\n        total_intermediates += layout.intermediates_size;\n    }\n\n    let total_blocks = block_ctxs_h.len() as u32;\n    if total_blocks == 0 {\n        return Ok(DeviceBuffer::new());\n    }\n\n    // Allocate shared intermediates buffer\n    let mut intermediates = if total_intermediates > 0 {\n        DeviceBuffer::<F>::with_capacity(total_intermediates)\n    } else {\n        DeviceBuffer::<F>::new()\n    };\n\n    // Build per-AIR context structs\n    let mut zc_ctxs_h = Vec::with_capacity(descs.len());\n    let mut intermediates_offset: usize = 0;\n    for (d, layout) in descs.iter().zip(&layouts) {\n        let d_intermediates = if layout.intermediates_size > 0 {\n            let ptr = unsafe { intermediates.as_mut_ptr().add(intermediates_offset) };\n            intermediates_offset += layout.intermediates_size;\n            ptr\n        } else {\n            std::ptr::null_mut()\n        };\n\n        zc_ctxs_h.push(Round0ZcCtx {\n            selectors_cube: d.selectors_cube,\n            preprocessed: d.preprocessed,\n            main_parts: d.d_main_parts,\n            eq_cube: d.eq_cube,\n            lambda_pows: d.lambda_pows,\n            public_values: d.public_values,\n            d_rules: d.d_zc_rules,\n            d_used_nodes: d.d_zc_used_nodes,\n            rules_len: d.zc_rules_len,\n            used_nodes_len: d.zc_used_nodes_len,\n            lambda_len: d.lambda_len,\n            buffer_size: d.buffer_size_zc,\n            d_intermediates,\n            buffer_stride: layout.buffer_stride,\n            num_x: d.num_x,\n            height: d.height,\n            g_shift: d.g_shift,\n        });\n    }\n\n    // Upload to device\n    let d_block_ctxs = block_ctxs_h.to_device()?;\n    let d_zc_ctxs = zc_ctxs_h.to_device()?;\n    let d_air_offsets = air_offsets_h.to_device()?;\n\n    // Allocate output buffers\n    let output_size = descs.len() * num_cosets as usize * skip_domain as usize;\n    let tmp_sums_size = total_blocks as usize * num_cosets as usize * skip_domain as usize;\n    let mut tmp_sums_buffer = DeviceBuffer::<EF>::with_capacity(tmp_sums_size);\n    let mut output = DeviceBuffer::<EF>::with_capacity(output_size);\n\n    // Launch\n    unsafe {\n        batched_zerocheck_r0_eval_constraints(\n            &mut tmp_sums_buffer,\n            &mut output,\n            &d_block_ctxs,\n            &d_zc_ctxs,\n            &d_air_offsets,\n            total_blocks,\n            descs.len() as u32,\n            num_cosets,\n            skip_domain,\n            block_x,\n        )?;\n    }\n\n    Ok(output)\n}\n\nconst BUFFER_THRESHOLD: u32 = 16;\n\n/// Evaluate batched Round 0 logup interactions for a group of AIRs with the same num_cosets.\n///\n/// Returns a flat buffer of `[num_airs][num_cosets * skip_domain]` Frac<EF> values.\n#[allow(clippy::too_many_arguments)]\npub(crate) fn evaluate_batched_logup_group(\n    descs: &[&BatchedR0AirDesc],\n    num_cosets: u32,\n    skip_domain: u32,\n) -> Result<DeviceBuffer<Frac<EF>>, Round0EvalError> {\n    if descs.is_empty() || num_cosets == 0 {\n        return Ok(DeviceBuffer::new());\n    }\n\n    let max_num_x = descs.iter().map(|d| d.num_x).max().unwrap_or(1);\n    let block_x = std::cmp::min(MAX_THREADS, skip_domain * max_num_x);\n    let block_x = (block_x / skip_domain) * skip_domain;\n    let x_per_block = block_x / skip_domain;\n\n    let mut block_ctxs_h = Vec::new();\n    let mut air_offsets_h: Vec<u32> = vec![0];\n    let mut total_intermediates: usize = 0;\n\n    struct AirLayout {\n        num_x_blocks: u32,\n        blocks_per_air: u32,\n        buffer_stride: u32,\n        intermediates_size: usize,\n    }\n    let layouts: Vec<AirLayout> = descs\n        .iter()\n        .map(|d| {\n            let num_x_blocks = d.num_x.div_ceil(x_per_block);\n            let blocks_per_air = num_x_blocks * num_cosets;\n            let buffer_stride = num_cosets * num_x_blocks * block_x;\n            let intermediates_size = if d.buffer_size_logup > BUFFER_THRESHOLD {\n                buffer_stride as usize * d.buffer_size_logup as usize\n            } else {\n                0\n            };\n            AirLayout {\n                num_x_blocks,\n                blocks_per_air,\n                buffer_stride,\n                intermediates_size,\n            }\n        })\n        .collect();\n\n    for (local_air_idx, (_d, layout)) in descs.iter().zip(&layouts).enumerate() {\n        for local_block in 0..layout.blocks_per_air {\n            block_ctxs_h.push(Round0BlockCtx {\n                local_block_idx: local_block,\n                air_idx: local_air_idx as u32,\n            });\n        }\n        air_offsets_h.push(*air_offsets_h.last().unwrap() + layout.blocks_per_air);\n        total_intermediates += layout.intermediates_size;\n    }\n\n    let total_blocks = block_ctxs_h.len() as u32;\n    if total_blocks == 0 {\n        return Ok(DeviceBuffer::new());\n    }\n\n    let mut intermediates = if total_intermediates > 0 {\n        DeviceBuffer::<F>::with_capacity(total_intermediates)\n    } else {\n        DeviceBuffer::<F>::new()\n    };\n\n    let mut logup_ctxs_h = Vec::with_capacity(descs.len());\n    let mut intermediates_offset: usize = 0;\n    for (d, layout) in descs.iter().zip(&layouts) {\n        let logup = d\n            .logup_rules\n            .as_ref()\n            .expect(\"logup group desc must have logup_rules\");\n\n        let d_intermediates = if layout.intermediates_size > 0 {\n            let ptr = unsafe { intermediates.as_mut_ptr().add(intermediates_offset) };\n            intermediates_offset += layout.intermediates_size;\n            ptr\n        } else {\n            std::ptr::null_mut()\n        };\n\n        logup_ctxs_h.push(Round0LogupCtx {\n            selectors_cube: d.selectors_cube,\n            preprocessed: d.preprocessed,\n            main_parts: d.d_main_parts,\n            eq_cube: d.eq_cube,\n            public_values: d.public_values,\n            d_rules: logup.d_rules.as_raw_ptr() as *const std::ffi::c_void,\n            rules_len: logup.rules_len,\n            buffer_size: logup.buffer_size,\n            d_intermediates,\n            buffer_stride: layout.buffer_stride,\n            numer_weights: logup.d_numer_weights.as_ptr(),\n            denom_weights: logup.d_denom_weights.as_ptr(),\n            denom_sum_init: logup.denom_sum_init,\n            num_x: d.num_x,\n            height: d.height,\n            g_shift: d.g_shift,\n        });\n    }\n\n    let d_block_ctxs = block_ctxs_h.to_device()?;\n    let d_logup_ctxs = logup_ctxs_h.to_device()?;\n    let d_air_offsets = air_offsets_h.to_device()?;\n\n    let output_size = descs.len() * num_cosets as usize * skip_domain as usize;\n    let tmp_sums_size = total_blocks as usize * num_cosets as usize * skip_domain as usize;\n    let mut tmp_sums_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(tmp_sums_size);\n    let mut output = DeviceBuffer::<Frac<EF>>::with_capacity(output_size);\n\n    unsafe {\n        batched_logup_r0_eval_interactions(\n            &mut tmp_sums_buffer,\n            &mut output,\n            &d_block_ctxs,\n            &d_logup_ctxs,\n            &d_air_offsets,\n            total_blocks,\n            descs.len() as u32,\n            num_cosets,\n            skip_domain,\n            block_x,\n        )?;\n    }\n\n    Ok(output)\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":215,"cache_read_input_tokens":138219,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":215},"output_tokens":72,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"3eab5b9b-40e0-4e43-bd71-fd448feabe6e","uuid":"6c9ed69d-14c6-430a-8994-44f614b32226"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NMzvZoXnzrUw7wLBgbB1yo","type":"tool_result","content":"The file /home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/round0.rs has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"3eab5b9b-40e0-4e43-bd71-fd448feabe6e","uuid":"308aec46-3c86-462e-a3b2-faeace53e7d9","timestamp":"2026-04-13T13:21:09.267Z","tool_use_result":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/round0.rs","oldString":"    Ok(s_evals)\n}","newString":"    Ok(s_evals)\n}\n\n/// Descriptor for one AIR in a batched Round 0 group.\npub(crate) struct BatchedR0AirDesc {\n    /// Index into the original work_items/trace order\n    pub trace_idx: usize,\n    pub num_x: u32,\n    pub height: u32,\n    pub g_shift: F,\n    pub buffer_size_zc: u32,\n    pub buffer_size_logup: u32,\n    pub num_cosets_zc: u32,\n    pub num_cosets_logup: u32,\n    // Pointers — valid for the duration of the kernel launch\n    pub selectors_cube: *const F,\n    pub preprocessed: *const F,\n    pub d_main_parts: *const *const F,\n    pub eq_cube: *const EF,\n    pub lambda_pows: *const EF,\n    pub public_values: *const F,\n    // Zerocheck rules (from pkey)\n    pub d_zc_rules: *const std::ffi::c_void,\n    pub d_zc_used_nodes: *const usize,\n    pub zc_rules_len: usize,\n    pub zc_used_nodes_len: usize,\n    pub lambda_len: usize,\n    // Logup rules (built at prove time) — None if no interactions\n    pub logup_rules: Option<BatchedR0LogupRules>,\n}\n\n/// Pre-built logup rules for one AIR.\npub(crate) struct BatchedR0LogupRules {\n    pub d_rules: DeviceBuffer<u128>,\n    pub rules_len: usize,\n    pub buffer_size: u32,\n    pub d_numer_weights: DeviceBuffer<EF>,\n    pub d_denom_weights: DeviceBuffer<EF>,\n    pub denom_sum_init: EF,\n}\n\n/// Build logup rules for a single AIR (same logic as evaluate_round0_interactions_gpu).\n#[allow(clippy::too_many_arguments)]\npub(crate) fn build_logup_rules_for_air<HS: GpuHashScheme>(\n    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n    symbolic: &SymbolicConstraints<F>,\n    beta_pows: &[EF],\n    eq_3bs: &[EF],\n) -> Result<Option<BatchedR0LogupRules>, Round0EvalError> {\n    if eq_3bs.is_empty() {\n        return Ok(None);\n    }\n\n    let mut dag_builder = SymbolicDagBuilder::new();\n    let mut sorted_used_dag_idxs = Vec::new();\n    for interaction in &symbolic.interactions {\n        let count = dag_builder.add_expr(&interaction.count);\n        sorted_used_dag_idxs.push(count);\n        sorted_used_dag_idxs.extend(\n            interaction\n                .message\n                .iter()\n                .map(|field_expr| dag_builder.add_expr(field_expr)),\n        );\n    }\n    sorted_used_dag_idxs.sort();\n    sorted_used_dag_idxs.dedup();\n    let dag = SymbolicExpressionDag {\n        nodes: dag_builder.nodes,\n        constraint_idx: sorted_used_dag_idxs,\n    };\n    let rules = SymbolicRulesGpu::new(&dag, true);\n    let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n    let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n    let mut denom_sum_init = EF::ZERO;\n    for (interaction_idx, interaction) in symbolic.interactions.iter().enumerate() {\n        let count_dag_idx =\n            dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];\n        let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n        numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n        denom_sum_init += eq_3bs[interaction_idx]\n            * beta_pows[interaction.message.len()]\n            * F::from_u32(interaction.bus_index as u32 + 1);\n\n        for (message_idx, message) in interaction.message.iter().enumerate() {\n            let message_dag_idx =\n                dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n            let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n            denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];\n        }\n    }\n    let d_numer_weights = numer_weights.to_device()?;\n    let d_denom_weights = denom_weights.to_device()?;\n    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n    let d_rules = encoded_rules.to_device()?;\n\n    Ok(Some(BatchedR0LogupRules {\n        d_rules,\n        rules_len: rules.rules.len(),\n        buffer_size: rules.buffer_size.try_into().unwrap(),\n        d_numer_weights,\n        d_denom_weights,\n        denom_sum_init,\n    }))\n}\n\nconst COSET_PARALLEL_THRESHOLD: u32 = 32768;\nconst MAX_THREADS: u32 = 128;\n\n/// Evaluate batched Round 0 zerocheck constraints for a group of AIRs with the same num_cosets.\n///\n/// Returns a flat buffer of `[num_airs][num_cosets * skip_domain]` EF values.\n#[allow(clippy::too_many_arguments)]\npub(crate) fn evaluate_batched_zerocheck_group(\n    descs: &[&BatchedR0AirDesc],\n    num_cosets: u32,\n    skip_domain: u32,\n) -> Result<DeviceBuffer<EF>, Round0EvalError> {\n    if descs.is_empty() || num_cosets == 0 {\n        return Ok(DeviceBuffer::new());\n    }\n\n    let l_skip = skip_domain.trailing_zeros();\n    let max_num_x = descs.iter().map(|d| d.num_x).max().unwrap_or(1);\n    let block_x = std::cmp::min(MAX_THREADS, skip_domain * max_num_x);\n    // Ensure block_x is a multiple of skip_domain\n    let block_x = (block_x / skip_domain) * skip_domain;\n    let x_per_block = block_x / skip_domain;\n\n    // Build block contexts and compute offsets\n    let mut block_ctxs_h = Vec::new();\n    let mut air_offsets_h: Vec<u32> = vec![0];\n    let mut total_intermediates: usize = 0;\n\n    // Pre-compute per-AIR intermediates sizes and buffer_strides\n    struct AirLayout {\n        num_x_blocks: u32,\n        blocks_per_air: u32,\n        buffer_stride: u32,\n        intermediates_size: usize,\n    }\n    let layouts: Vec<AirLayout> = descs\n        .iter()\n        .map(|d| {\n            let num_x_blocks = d.num_x.div_ceil(x_per_block);\n            let blocks_per_air = num_x_blocks * num_cosets;\n            let buffer_stride = num_cosets * num_x_blocks * block_x;\n            let intermediates_size = if d.buffer_size_zc > BUFFER_THRESHOLD {\n                buffer_stride as usize * d.buffer_size_zc as usize\n            } else {\n                0\n            };\n            AirLayout {\n                num_x_blocks,\n                blocks_per_air,\n                buffer_stride,\n                intermediates_size,\n            }\n        })\n        .collect();\n\n    for (local_air_idx, (d, layout)) in descs.iter().zip(&layouts).enumerate() {\n        for local_block in 0..layout.blocks_per_air {\n            block_ctxs_h.push(Round0BlockCtx {\n                local_block_idx: local_block,\n                air_idx: local_air_idx as u32,\n            });\n        }\n        air_offsets_h.push(*air_offsets_h.last().unwrap() + layout.blocks_per_air);\n        total_intermediates += layout.intermediates_size;\n    }\n\n    let total_blocks = block_ctxs_h.len() as u32;\n    if total_blocks == 0 {\n        return Ok(DeviceBuffer::new());\n    }\n\n    // Allocate shared intermediates buffer\n    let mut intermediates = if total_intermediates > 0 {\n        DeviceBuffer::<F>::with_capacity(total_intermediates)\n    } else {\n        DeviceBuffer::<F>::new()\n    };\n\n    // Build per-AIR context structs\n    let mut zc_ctxs_h = Vec::with_capacity(descs.len());\n    let mut intermediates_offset: usize = 0;\n    for (d, layout) in descs.iter().zip(&layouts) {\n        let d_intermediates = if layout.intermediates_size > 0 {\n            let ptr = unsafe { intermediates.as_mut_ptr().add(intermediates_offset) };\n            intermediates_offset += layout.intermediates_size;\n            ptr\n        } else {\n            std::ptr::null_mut()\n        };\n\n        zc_ctxs_h.push(Round0ZcCtx {\n            selectors_cube: d.selectors_cube,\n            preprocessed: d.preprocessed,\n            main_parts: d.d_main_parts,\n            eq_cube: d.eq_cube,\n            lambda_pows: d.lambda_pows,\n            public_values: d.public_values,\n            d_rules: d.d_zc_rules,\n            d_used_nodes: d.d_zc_used_nodes,\n            rules_len: d.zc_rules_len,\n            used_nodes_len: d.zc_used_nodes_len,\n            lambda_len: d.lambda_len,\n            buffer_size: d.buffer_size_zc,\n            d_intermediates,\n            buffer_stride: layout.buffer_stride,\n            num_x: d.num_x,\n            height: d.height,\n            g_shift: d.g_shift,\n        });\n    }\n\n    // Upload to device\n    let d_block_ctxs = block_ctxs_h.to_device()?;\n    let d_zc_ctxs = zc_ctxs_h.to_device()?;\n    let d_air_offsets = air_offsets_h.to_device()?;\n\n    // Allocate output buffers\n    let output_size = descs.len() * num_cosets as usize * skip_domain as usize;\n    let tmp_sums_size = total_blocks as usize * num_cosets as usize * skip_domain as usize;\n    let mut tmp_sums_buffer = DeviceBuffer::<EF>::with_capacity(tmp_sums_size);\n    let mut output = DeviceBuffer::<EF>::with_capacity(output_size);\n\n    // Launch\n    unsafe {\n        batched_zerocheck_r0_eval_constraints(\n            &mut tmp_sums_buffer,\n            &mut output,\n            &d_block_ctxs,\n            &d_zc_ctxs,\n            &d_air_offsets,\n            total_blocks,\n            descs.len() as u32,\n            num_cosets,\n            skip_domain,\n            block_x,\n        )?;\n    }\n\n    Ok(output)\n}\n\nconst BUFFER_THRESHOLD: u32 = 16;\n\n/// Evaluate batched Round 0 logup interactions for a group of AIRs with the same num_cosets.\n///\n/// Returns a flat buffer of `[num_airs][num_cosets * skip_domain]` Frac<EF> values.\n#[allow(clippy::too_many_arguments)]\npub(crate) fn evaluate_batched_logup_group(\n    descs: &[&BatchedR0AirDesc],\n    num_cosets: u32,\n    skip_domain: u32,\n) -> Result<DeviceBuffer<Frac<EF>>, Round0EvalError> {\n    if descs.is_empty() || num_cosets == 0 {\n        return Ok(DeviceBuffer::new());\n    }\n\n    let max_num_x = descs.iter().map(|d| d.num_x).max().unwrap_or(1);\n    let block_x = std::cmp::min(MAX_THREADS, skip_domain * max_num_x);\n    let block_x = (block_x / skip_domain) * skip_domain;\n    let x_per_block = block_x / skip_domain;\n\n    let mut block_ctxs_h = Vec::new();\n    let mut air_offsets_h: Vec<u32> = vec![0];\n    let mut total_intermediates: usize = 0;\n\n    struct AirLayout {\n        num_x_blocks: u32,\n        blocks_per_air: u32,\n        buffer_stride: u32,\n        intermediates_size: usize,\n    }\n    let layouts: Vec<AirLayout> = descs\n        .iter()\n        .map(|d| {\n            let num_x_blocks = d.num_x.div_ceil(x_per_block);\n            let blocks_per_air = num_x_blocks * num_cosets;\n            let buffer_stride = num_cosets * num_x_blocks * block_x;\n            let intermediates_size = if d.buffer_size_logup > BUFFER_THRESHOLD {\n                buffer_stride as usize * d.buffer_size_logup as usize\n            } else {\n                0\n            };\n            AirLayout {\n                num_x_blocks,\n                blocks_per_air,\n                buffer_stride,\n                intermediates_size,\n            }\n        })\n        .collect();\n\n    for (local_air_idx, (_d, layout)) in descs.iter().zip(&layouts).enumerate() {\n        for local_block in 0..layout.blocks_per_air {\n            block_ctxs_h.push(Round0BlockCtx {\n                local_block_idx: local_block,\n                air_idx: local_air_idx as u32,\n            });\n        }\n        air_offsets_h.push(*air_offsets_h.last().unwrap() + layout.blocks_per_air);\n        total_intermediates += layout.intermediates_size;\n    }\n\n    let total_blocks = block_ctxs_h.len() as u32;\n    if total_blocks == 0 {\n        return Ok(DeviceBuffer::new());\n    }\n\n    let mut intermediates = if total_intermediates > 0 {\n        DeviceBuffer::<F>::with_capacity(total_intermediates)\n    } else {\n        DeviceBuffer::<F>::new()\n    };\n\n    let mut logup_ctxs_h = Vec::with_capacity(descs.len());\n    let mut intermediates_offset: usize = 0;\n    for (d, layout) in descs.iter().zip(&layouts) {\n        let logup = d\n            .logup_rules\n            .as_ref()\n            .expect(\"logup group desc must have logup_rules\");\n\n        let d_intermediates = if layout.intermediates_size > 0 {\n            let ptr = unsafe { intermediates.as_mut_ptr().add(intermediates_offset) };\n            intermediates_offset += layout.intermediates_size;\n            ptr\n        } else {\n            std::ptr::null_mut()\n        };\n\n        logup_ctxs_h.push(Round0LogupCtx {\n            selectors_cube: d.selectors_cube,\n            preprocessed: d.preprocessed,\n            main_parts: d.d_main_parts,\n            eq_cube: d.eq_cube,\n            public_values: d.public_values,\n            d_rules: logup.d_rules.as_raw_ptr() as *const std::ffi::c_void,\n            rules_len: logup.rules_len,\n            buffer_size: logup.buffer_size,\n            d_intermediates,\n            buffer_stride: layout.buffer_stride,\n            numer_weights: logup.d_numer_weights.as_ptr(),\n            denom_weights: logup.d_denom_weights.as_ptr(),\n            denom_sum_init: logup.denom_sum_init,\n            num_x: d.num_x,\n            height: d.height,\n            g_shift: d.g_shift,\n        });\n    }\n\n    let d_block_ctxs = block_ctxs_h.to_device()?;\n    let d_logup_ctxs = logup_ctxs_h.to_device()?;\n    let d_air_offsets = air_offsets_h.to_device()?;\n\n    let output_size = descs.len() * num_cosets as usize * skip_domain as usize;\n    let tmp_sums_size = total_blocks as usize * num_cosets as usize * skip_domain as usize;\n    let mut tmp_sums_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(tmp_sums_size);\n    let mut output = DeviceBuffer::<Frac<EF>>::with_capacity(output_size);\n\n    unsafe {\n        batched_logup_r0_eval_interactions(\n            &mut tmp_sums_buffer,\n            &mut output,\n            &d_block_ctxs,\n            &d_logup_ctxs,\n            &d_air_offsets,\n            total_blocks,\n            descs.len() as u32,\n            num_cosets,\n            skip_domain,\n            block_x,\n        )?;\n    }\n\n    Ok(output)\n}","originalFile":"use std::collections::BTreeMap;\n\nuse itertools::Itertools;\nuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer};\nuse openvm_stark_backend::{\n    air_builders::symbolic::{\n        symbolic_expression::SymbolicExpression, SymbolicConstraints, SymbolicDagBuilder,\n        SymbolicExpressionDag,\n    },\n    prover::{fractional_sumcheck_gkr::Frac, DeviceStarkProvingKey},\n};\nuse p3_field::PrimeCharacteristicRing;\nuse tracing::{debug, info, warn};\n\nuse super::errors::Round0EvalError;\nuse crate::{\n    cuda::logup_zerocheck::{\n        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n        batched_logup_r0_eval_interactions, batched_zerocheck_r0_eval_constraints,\n        logup_bary_eval_interactions_round0, zerocheck_ntt_eval_constraints, Round0BlockCtx,\n        Round0LogupCtx, Round0ZcCtx,\n    },\n    gpu_backend::GenericGpuBackend,\n    hash_scheme::GpuHashScheme,\n    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n    prelude::{EF, F},\n};\n\n/// Evaluate plain AIR constraints (not interactions) for a single AIR, given prepared trace input.\n///\n/// `num_cosets` should equal `constraint_degree - 1` because we evaluate the quotient polynomial.\n/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n#[allow(clippy::too_many_arguments)]\npub fn evaluate_round0_constraints_gpu<HS: GpuHashScheme>(\n    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n    selectors_cube: &DeviceBuffer<F>,\n    main_parts: &DeviceBuffer<*const F>,\n    public_values: &DeviceBuffer<F>,\n    eq_cube: *const EF,\n    lambda_pows: &DeviceBuffer<EF>,\n    skip_domain: u32,\n    num_x: u32,\n    height: u32,\n    num_cosets: u32,\n    g_shift: F,\n    max_temp_bytes: usize,\n) -> Result<DeviceBuffer<EF>, Round0EvalError> {\n    let constraints_dag = &pk.vk.symbolic_constraints;\n    if constraints_dag.constraints.constraint_idx.is_empty() || num_cosets == 0 {\n        // No plain AIR constraints, return empty buffer\n        return Ok(DeviceBuffer::new());\n    }\n\n    let rules = &pk.other_data.zerocheck_round0;\n\n    let buffer_size: u32 = rules.inner.buffer_size;\n    let intermed_capacity = unsafe {\n        _zerocheck_r0_intermediates_buffer_size(\n            buffer_size,\n            skip_domain,\n            num_x,\n            num_cosets,\n            max_temp_bytes,\n        )\n    };\n    let mut intermediates = if intermed_capacity > 0 {\n        debug!(\"zerocheck:intermediates_capacity={intermed_capacity}\");\n        DeviceBuffer::<F>::with_capacity(intermed_capacity)\n    } else {\n        DeviceBuffer::<F>::new()\n    };\n\n    let temp_sums_buffer_capacity = unsafe {\n        _zerocheck_r0_temp_sums_buffer_size(\n            buffer_size,\n            skip_domain,\n            num_x,\n            num_cosets,\n            max_temp_bytes,\n        )\n    };\n    debug!(\"zerocheck:temp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n    let mut temp_sums_buffer = DeviceBuffer::<EF>::with_capacity(temp_sums_buffer_capacity);\n    let used_temp_bytes =\n        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<EF>();\n    if used_temp_bytes > max_temp_bytes {\n        // We do not error if the required bytes is greater than the requested max, but this may\n        // lead to unexpected peak memory usage.\n        warn!(\"zerocheck used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\");\n    }\n\n    let preprocessed_ptr = pk\n        .preprocessed_data\n        .as_ref()\n        .map(|cd| cd.trace.buffer().as_ptr())\n        .unwrap_or(std::ptr::null());\n\n    let mut sp_evals =\n        DeviceBuffer::<EF>::with_capacity(num_cosets as usize * skip_domain as usize);\n    // SAFETY:\n    // - No bounds checks are done in this kernel. It fully assumes that the Rules are trusted and\n    //   all nodes are valid.\n    unsafe {\n        zerocheck_ntt_eval_constraints(\n            &mut temp_sums_buffer,\n            &mut sp_evals,\n            selectors_cube,\n            preprocessed_ptr,\n            main_parts,\n            eq_cube,\n            lambda_pows,\n            public_values,\n            &rules.inner.d_rules,\n            &rules.inner.d_used_nodes,\n            buffer_size,\n            &mut intermediates,\n            skip_domain,\n            num_x,\n            height,\n            num_cosets,\n            g_shift,\n            max_temp_bytes,\n        )?;\n    }\n\n    Ok(sp_evals)\n}\n\n/// Evaluate interaction constraints (excluding plain AIR constraints) for a single AIR, given\n/// prepared trace input.\n///\n/// `constraints` includes interaction expressions for the AIR.\n/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n#[allow(clippy::too_many_arguments)]\npub fn evaluate_round0_interactions_gpu<HS: GpuHashScheme>(\n    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n    symbolic: &SymbolicConstraints<F>,\n    selectors_cube: &DeviceBuffer<F>,\n    main_parts: &DeviceBuffer<*const F>,\n    public_values: &DeviceBuffer<F>,\n    eq_cube: *const EF,\n    beta_pows: &[EF],\n    eq_3bs: &[EF],\n    skip_domain: u32,\n    num_x: u32,\n    height: u32,\n    num_cosets: u32,\n    g_shift: F,\n    max_temp_bytes: usize,\n) -> Result<DeviceBuffer<Frac<EF>>, Round0EvalError> {\n    // Check if this trace has interactions\n    if eq_3bs.is_empty() {\n        return Ok(DeviceBuffer::new());\n    }\n    let large_domain = num_cosets * skip_domain;\n\n    // We create a new \"interactions DAG\" where the new .constraints are the interaction [count,\n    // message_0, message_1, ..] expressions themselves, while the .interactions are empty\n    // We track the indices with InteractionNode\n\n    // Copied from build_symbolic_constraints_dag to handle sorting of constraints\n    // NOTE: For logup round0, the kernel uses weights indexed by rule_idx, not constraint_idx.\n    // So we deduplicate constraint_idx and use dag_idx_to_rule_idx for weight mapping.\n    let (rules, d_numer_weights, d_denom_weights, denom_sum_init) = {\n        let mut dag_builder = SymbolicDagBuilder::new();\n        let mut sorted_used_dag_idxs = Vec::new();\n        for interaction in &symbolic.interactions {\n            let count = dag_builder.add_expr(&interaction.count);\n            sorted_used_dag_idxs.push(count);\n            sorted_used_dag_idxs.extend(\n                interaction\n                    .message\n                    .iter()\n                    .map(|field_expr| dag_builder.add_expr(field_expr)),\n            );\n        }\n        sorted_used_dag_idxs.sort();\n        // Deduplicate for the dag since logup round0 kernel doesn't use used_nodes\n        sorted_used_dag_idxs.dedup();\n        let dag = SymbolicExpressionDag {\n            nodes: dag_builder.nodes,\n            constraint_idx: sorted_used_dag_idxs,\n        };\n        let rules = SymbolicRulesGpu::new(&dag, true);\n        let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n        let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n        let mut denom_sum_init = EF::ZERO;\n        for (interaction_idx, interaction) in symbolic.interactions.iter().enumerate() {\n            // CAUTION: an expression node could be used in multiple interactions, and might even be\n            // used as `count` in one, but message field in another. We only care about their\n            // weighted sum with eq_3b, so we compute the weights ahead of time.\n            let count_dag_idx =\n                dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];\n            let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n            numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n            denom_sum_init += eq_3bs[interaction_idx]\n                * beta_pows[interaction.message.len()]\n                * F::from_u32(interaction.bus_index as u32 + 1);\n\n            for (message_idx, message) in interaction.message.iter().enumerate() {\n                let message_dag_idx =\n                    dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n                let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n                denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];\n            }\n        }\n        let d_numer_weights = numer_weights.to_device()?;\n        let d_denom_weights = denom_weights.to_device()?;\n        (rules, d_numer_weights, d_denom_weights, denom_sum_init)\n    };\n\n    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n    let d_rules = encoded_rules.to_device()?;\n\n    let buffer_size: u32 = rules.buffer_size.try_into().unwrap();\n    let intermed_capacity = unsafe {\n        _logup_r0_intermediates_buffer_size(\n            buffer_size,\n            skip_domain,\n            num_x,\n            num_cosets,\n            max_temp_bytes,\n        )\n    };\n    let mut intermediates = if intermed_capacity > 0 {\n        debug!(\"logup_r0:intermediates_capacity={intermed_capacity}\");\n        DeviceBuffer::<F>::with_capacity(intermed_capacity)\n    } else {\n        DeviceBuffer::<F>::new()\n    };\n\n    let temp_sums_buffer_capacity = unsafe {\n        _logup_r0_temp_sums_buffer_size(buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes)\n    };\n    debug!(\"logup_r0:tmp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n    let mut temp_sums_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(temp_sums_buffer_capacity);\n    let used_temp_bytes =\n        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<Frac<EF>>();\n    if used_temp_bytes > max_temp_bytes {\n        warn!(\n            \"logup_round0 used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\"\n        );\n    }\n\n    let preprocessed_ptr = pk\n        .preprocessed_data\n        .as_ref()\n        .map(|cd| cd.trace.buffer().as_ptr())\n        .unwrap_or(std::ptr::null());\n\n    let mut s_evals = DeviceBuffer::<Frac<EF>>::with_capacity(large_domain as usize);\n\n    unsafe {\n        logup_bary_eval_interactions_round0(\n            &mut temp_sums_buffer,\n            &mut s_evals,\n            selectors_cube,\n            preprocessed_ptr,\n            main_parts,\n            eq_cube,\n            public_values,\n            &d_numer_weights,\n            &d_denom_weights,\n            denom_sum_init,\n            &d_rules,\n            buffer_size,\n            &mut intermediates,\n            skip_domain,\n            num_x,\n            height,\n            num_cosets,\n            g_shift,\n            max_temp_bytes,\n        )?;\n    }\n\n    Ok(s_evals)\n}\n","structuredPatch":[{"oldStart":277,"oldLines":3,"newStart":277,"newLines":382,"lines":[" ","     Ok(s_evals)"," }","+","+/// Descriptor for one AIR in a batched Round 0 group.","+pub(crate) struct BatchedR0AirDesc {","+    /// Index into the original work_items/trace order","+    pub trace_idx: usize,","+    pub num_x: u32,","+    pub height: u32,","+    pub g_shift: F,","+    pub buffer_size_zc: u32,","+    pub buffer_size_logup: u32,","+    pub num_cosets_zc: u32,","+    pub num_cosets_logup: u32,","+    // Pointers — valid for the duration of the kernel launch","+    pub selectors_cube: *const F,","+    pub preprocessed: *const F,","+    pub d_main_parts: *const *const F,","+    pub eq_cube: *const EF,","+    pub lambda_pows: *const EF,","+    pub public_values: *const F,","+    // Zerocheck rules (from pkey)","+    pub d_zc_rules: *const std::ffi::c_void,","+    pub d_zc_used_nodes: *const usize,","+    pub zc_rules_len: usize,","+    pub zc_used_nodes_len: usize,","+    pub lambda_len: usize,","+    // Logup rules (built at prove time) — None if no interactions","+    pub logup_rules: Option<BatchedR0LogupRules>,","+}","+","+/// Pre-built logup rules for one AIR.","+pub(crate) struct BatchedR0LogupRules {","+    pub d_rules: DeviceBuffer<u128>,","+    pub rules_len: usize,","+    pub buffer_size: u32,","+    pub d_numer_weights: DeviceBuffer<EF>,","+    pub d_denom_weights: DeviceBuffer<EF>,","+    pub denom_sum_init: EF,","+}","+","+/// Build logup rules for a single AIR (same logic as evaluate_round0_interactions_gpu).","+#[allow(clippy::too_many_arguments)]","+pub(crate) fn build_logup_rules_for_air<HS: GpuHashScheme>(","+    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,","+    symbolic: &SymbolicConstraints<F>,","+    beta_pows: &[EF],","+    eq_3bs: &[EF],","+) -> Result<Option<BatchedR0LogupRules>, Round0EvalError> {","+    if eq_3bs.is_empty() {","+        return Ok(None);","+    }","+","+    let mut dag_builder = SymbolicDagBuilder::new();","+    let mut sorted_used_dag_idxs = Vec::new();","+    for interaction in &symbolic.interactions {","+        let count = dag_builder.add_expr(&interaction.count);","+        sorted_used_dag_idxs.push(count);","+        sorted_used_dag_idxs.extend(","+            interaction","+                .message","+                .iter()","+                .map(|field_expr| dag_builder.add_expr(field_expr)),","+        );","+    }","+    sorted_used_dag_idxs.sort();","+    sorted_used_dag_idxs.dedup();","+    let dag = SymbolicExpressionDag {","+        nodes: dag_builder.nodes,","+        constraint_idx: sorted_used_dag_idxs,","+    };","+    let rules = SymbolicRulesGpu::new(&dag, true);","+    let mut numer_weights = vec![EF::ZERO; rules.rules.len()];","+    let mut denom_weights = vec![EF::ZERO; rules.rules.len()];","+    let mut denom_sum_init = EF::ZERO;","+    for (interaction_idx, interaction) in symbolic.interactions.iter().enumerate() {","+        let count_dag_idx =","+            dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];","+        let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];","+        numer_weights[count_rule_idx] += eq_3bs[interaction_idx];","+        denom_sum_init += eq_3bs[interaction_idx]","+            * beta_pows[interaction.message.len()]","+            * F::from_u32(interaction.bus_index as u32 + 1);","+","+        for (message_idx, message) in interaction.message.iter().enumerate() {","+            let message_dag_idx =","+                dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];","+            let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];","+            denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];","+        }","+    }","+    let d_numer_weights = numer_weights.to_device()?;","+    let d_denom_weights = denom_weights.to_device()?;","+    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();","+    let d_rules = encoded_rules.to_device()?;","+","+    Ok(Some(BatchedR0LogupRules {","+        d_rules,","+        rules_len: rules.rules.len(),","+        buffer_size: rules.buffer_size.try_into().unwrap(),","+        d_numer_weights,","+        d_denom_weights,","+        denom_sum_init,","+    }))","+}","+","+const COSET_PARALLEL_THRESHOLD: u32 = 32768;","+const MAX_THREADS: u32 = 128;","+","+/// Evaluate batched Round 0 zerocheck constraints for a group of AIRs with the same num_cosets.","+///","+/// Returns a flat buffer of `[num_airs][num_cosets * skip_domain]` EF values.","+#[allow(clippy::too_many_arguments)]","+pub(crate) fn evaluate_batched_zerocheck_group(","+    descs: &[&BatchedR0AirDesc],","+    num_cosets: u32,","+    skip_domain: u32,","+) -> Result<DeviceBuffer<EF>, Round0EvalError> {","+    if descs.is_empty() || num_cosets == 0 {","+        return Ok(DeviceBuffer::new());","+    }","+","+    let l_skip = skip_domain.trailing_zeros();","+    let max_num_x = descs.iter().map(|d| d.num_x).max().unwrap_or(1);","+    let block_x = std::cmp::min(MAX_THREADS, skip_domain * max_num_x);","+    // Ensure block_x is a multiple of skip_domain","+    let block_x = (block_x / skip_domain) * skip_domain;","+    let x_per_block = block_x / skip_domain;","+","+    // Build block contexts and compute offsets","+    let mut block_ctxs_h = Vec::new();","+    let mut air_offsets_h: Vec<u32> = vec![0];","+    let mut total_intermediates: usize = 0;","+","+    // Pre-compute per-AIR intermediates sizes and buffer_strides","+    struct AirLayout {","+        num_x_blocks: u32,","+        blocks_per_air: u32,","+        buffer_stride: u32,","+        intermediates_size: usize,","+    }","+    let layouts: Vec<AirLayout> = descs","+        .iter()","+        .map(|d| {","+            let num_x_blocks = d.num_x.div_ceil(x_per_block);","+            let blocks_per_air = num_x_blocks * num_cosets;","+            let buffer_stride = num_cosets * num_x_blocks * block_x;","+            let intermediates_size = if d.buffer_size_zc > BUFFER_THRESHOLD {","+                buffer_stride as usize * d.buffer_size_zc as usize","+            } else {","+                0","+            };","+            AirLayout {","+                num_x_blocks,","+                blocks_per_air,","+                buffer_stride,","+                intermediates_size,","+            }","+        })","+        .collect();","+","+    for (local_air_idx, (d, layout)) in descs.iter().zip(&layouts).enumerate() {","+        for local_block in 0..layout.blocks_per_air {","+            block_ctxs_h.push(Round0BlockCtx {","+                local_block_idx: local_block,","+                air_idx: local_air_idx as u32,","+            });","+        }","+        air_offsets_h.push(*air_offsets_h.last().unwrap() + layout.blocks_per_air);","+        total_intermediates += layout.intermediates_size;","+    }","+","+    let total_blocks = block_ctxs_h.len() as u32;","+    if total_blocks == 0 {","+        return Ok(DeviceBuffer::new());","+    }","+","+    // Allocate shared intermediates buffer","+    let mut intermediates = if total_intermediates > 0 {","+        DeviceBuffer::<F>::with_capacity(total_intermediates)","+    } else {","+        DeviceBuffer::<F>::new()","+    };","+","+    // Build per-AIR context structs","+    let mut zc_ctxs_h = Vec::with_capacity(descs.len());","+    let mut intermediates_offset: usize = 0;","+    for (d, layout) in descs.iter().zip(&layouts) {","+        let d_intermediates = if layout.intermediates_size > 0 {","+            let ptr = unsafe { intermediates.as_mut_ptr().add(intermediates_offset) };","+            intermediates_offset += layout.intermediates_size;","+            ptr","+        } else {","+            std::ptr::null_mut()","+        };","+","+        zc_ctxs_h.push(Round0ZcCtx {","+            selectors_cube: d.selectors_cube,","+            preprocessed: d.preprocessed,","+            main_parts: d.d_main_parts,","+            eq_cube: d.eq_cube,","+            lambda_pows: d.lambda_pows,","+            public_values: d.public_values,","+            d_rules: d.d_zc_rules,","+            d_used_nodes: d.d_zc_used_nodes,","+            rules_len: d.zc_rules_len,","+            used_nodes_len: d.zc_used_nodes_len,","+            lambda_len: d.lambda_len,","+            buffer_size: d.buffer_size_zc,","+            d_intermediates,","+            buffer_stride: layout.buffer_stride,","+            num_x: d.num_x,","+            height: d.height,","+            g_shift: d.g_shift,","+        });","+    }","+","+    // Upload to device","+    let d_block_ctxs = block_ctxs_h.to_device()?;","+    let d_zc_ctxs = zc_ctxs_h.to_device()?;","+    let d_air_offsets = air_offsets_h.to_device()?;","+","+    // Allocate output buffers","+    let output_size = descs.len() * num_cosets as usize * skip_domain as usize;","+    let tmp_sums_size = total_blocks as usize * num_cosets as usize * skip_domain as usize;","+    let mut tmp_sums_buffer = DeviceBuffer::<EF>::with_capacity(tmp_sums_size);","+    let mut output = DeviceBuffer::<EF>::with_capacity(output_size);","+","+    // Launch","+    unsafe {","+        batched_zerocheck_r0_eval_constraints(","+            &mut tmp_sums_buffer,","+            &mut output,","+            &d_block_ctxs,","+            &d_zc_ctxs,","+            &d_air_offsets,","+            total_blocks,","+            descs.len() as u32,","+            num_cosets,","+            skip_domain,","+            block_x,","+        )?;","+    }","+","+    Ok(output)","+}","+","+const BUFFER_THRESHOLD: u32 = 16;","+","+/// Evaluate batched Round 0 logup interactions for a group of AIRs with the same num_cosets.","+///","+/// Returns a flat buffer of `[num_airs][num_cosets * skip_domain]` Frac<EF> values.","+#[allow(clippy::too_many_arguments)]","+pub(crate) fn evaluate_batched_logup_group(","+    descs: &[&BatchedR0AirDesc],","+    num_cosets: u32,","+    skip_domain: u32,","+) -> Result<DeviceBuffer<Frac<EF>>, Round0EvalError> {","+    if descs.is_empty() || num_cosets == 0 {","+        return Ok(DeviceBuffer::new());","+    }","+","+    let max_num_x = descs.iter().map(|d| d.num_x).max().unwrap_or(1);","+    let block_x = std::cmp::min(MAX_THREADS, skip_domain * max_num_x);","+    let block_x = (block_x / skip_domain) * skip_domain;","+    let x_per_block = block_x / skip_domain;","+","+    let mut block_ctxs_h = Vec::new();","+    let mut air_offsets_h: Vec<u32> = vec![0];","+    let mut total_intermediates: usize = 0;","+","+    struct AirLayout {","+        num_x_blocks: u32,","+        blocks_per_air: u32,","+        buffer_stride: u32,","+        intermediates_size: usize,","+    }","+    let layouts: Vec<AirLayout> = descs","+        .iter()","+        .map(|d| {","+            let num_x_blocks = d.num_x.div_ceil(x_per_block);","+            let blocks_per_air = num_x_blocks * num_cosets;","+            let buffer_stride = num_cosets * num_x_blocks * block_x;","+            let intermediates_size = if d.buffer_size_logup > BUFFER_THRESHOLD {","+                buffer_stride as usize * d.buffer_size_logup as usize","+            } else {","+                0","+            };","+            AirLayout {","+                num_x_blocks,","+                blocks_per_air,","+                buffer_stride,","+                intermediates_size,","+            }","+        })","+        .collect();","+","+    for (local_air_idx, (_d, layout)) in descs.iter().zip(&layouts).enumerate() {","+        for local_block in 0..layout.blocks_per_air {","+            block_ctxs_h.push(Round0BlockCtx {","+                local_block_idx: local_block,","+                air_idx: local_air_idx as u32,","+            });","+        }","+        air_offsets_h.push(*air_offsets_h.last().unwrap() + layout.blocks_per_air);","+        total_intermediates += layout.intermediates_size;","+    }","+","+    let total_blocks = block_ctxs_h.len() as u32;","+    if total_blocks == 0 {","+        return Ok(DeviceBuffer::new());","+    }","+","+    let mut intermediates = if total_intermediates > 0 {","+        DeviceBuffer::<F>::with_capacity(total_intermediates)","+    } else {","+        DeviceBuffer::<F>::new()","+    };","+","+    let mut logup_ctxs_h = Vec::with_capacity(descs.len());","+    let mut intermediates_offset: usize = 0;","+    for (d, layout) in descs.iter().zip(&layouts) {","+        let logup = d","+            .logup_rules","+            .as_ref()","+            .expect(\"logup group desc must have logup_rules\");","+","+        let d_intermediates = if layout.intermediates_size > 0 {","+            let ptr = unsafe { intermediates.as_mut_ptr().add(intermediates_offset) };","+            intermediates_offset += layout.intermediates_size;","+            ptr","+        } else {","+            std::ptr::null_mut()","+        };","+","+        logup_ctxs_h.push(Round0LogupCtx {","+            selectors_cube: d.selectors_cube,","+            preprocessed: d.preprocessed,","+            main_parts: d.d_main_parts,","+            eq_cube: d.eq_cube,","+            public_values: d.public_values,","+            d_rules: logup.d_rules.as_raw_ptr() as *const std::ffi::c_void,","+            rules_len: logup.rules_len,","+            buffer_size: logup.buffer_size,","+            d_intermediates,","+            buffer_stride: layout.buffer_stride,","+            numer_weights: logup.d_numer_weights.as_ptr(),","+            denom_weights: logup.d_denom_weights.as_ptr(),","+            denom_sum_init: logup.denom_sum_init,","+            num_x: d.num_x,","+            height: d.height,","+            g_shift: d.g_shift,","+        });","+    }","+","+    let d_block_ctxs = block_ctxs_h.to_device()?;","+    let d_logup_ctxs = logup_ctxs_h.to_device()?;","+    let d_air_offsets = air_offsets_h.to_device()?;","+","+    let output_size = descs.len() * num_cosets as usize * skip_domain as usize;","+    let tmp_sums_size = total_blocks as usize * num_cosets as usize * skip_domain as usize;","+    let mut tmp_sums_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(tmp_sums_size);","+    let mut output = DeviceBuffer::<Frac<EF>>::with_capacity(output_size);","+","+    unsafe {","+        batched_logup_r0_eval_interactions(","+            &mut tmp_sums_buffer,","+            &mut output,","+            &d_block_ctxs,","+            &d_logup_ctxs,","+            &d_air_offsets,","+            total_blocks,","+            descs.len() as u32,","+            num_cosets,","+            skip_domain,","+            block_x,","+        )?;","+    }","+","+    Ok(output)","+}"]}],"userModified":false,"replaceAll":false}}
