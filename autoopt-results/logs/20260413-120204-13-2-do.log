{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EddiMxHaffSnh2rBypdztw","type":"tool_result","content":"1\t#pragma once\n2\t\n3\t#include \"fp.h\"\n4\t#include \"fpext.h\"\n5\t#include \"launcher.cuh\"\n6\t#include <cstdint>\n7\t#include <device_atomic_functions.h>\n8\t\n9\tnamespace sumcheck {\n10\t\n11\ttemplate <typename Field>\n12\t__device__ __forceinline__ Field\n13\tmle_interpolate_single(const Field *__restrict__ column, Fp x, uint32_t y_int) {\n14\t    auto t0 = column[y_int << 1];\n15\t    auto t1 = column[(y_int << 1) | 1];\n16\t    return t0 + (t1 - t0) * x;\n17\t}\n18\t\n19\t// Warp-level reduction: sums FpExt values across threads in a warp (32 threads)\n20\t// Uses shuffle instructions for efficient communication within a warp\n21\tstatic __device__ inline FpExt warp_reduce_sum(FpExt val) {\n22\t    unsigned mask = __activemask();\n23\t\n24\t#pragma unroll\n25\t    for (int offset = 16; offset > 0; offset /= 2) {\n26\t        FpExt other;\n27\t        other.elems[0] = Fp::fromRaw(__shfl_down_sync(mask, val.elems[0].asRaw(), offset));\n28\t        other.elems[1] = Fp::fromRaw(__shfl_down_sync(mask, val.elems[1].asRaw(), offset));\n29\t        other.elems[2] = Fp::fromRaw(__shfl_down_sync(mask, val.elems[2].asRaw(), offset));\n30\t        other.elems[3] = Fp::fromRaw(__shfl_down_sync(mask, val.elems[3].asRaw(), offset));\n31\t        val = val + other;\n32\t    }\n33\t    return val;\n34\t}\n35\t\n36\t// Reduce FpExt across n threads using warp shuffles (butterfly pattern)\n37\t// n must be a power of 2, 1 <= n <= 32\n38\t// All participating threads must call this function\n39\t__device__ __forceinline__ FpExt warp_reduce_sum_n(FpExt val, uint32_t n) {\n40\t    for (uint32_t offset = n >> 1; offset > 0; offset >>= 1) {\n41\t        FpExt other;\n42\t#pragma unroll\n43\t        for (int i = 0; i < 4; i++) {\n44\t            other.elems[i] =\n45\t                Fp::fromRaw(__shfl_xor_sync(0xffffffff, val.elems[i].asRaw(), offset));\n46\t        }\n47\t        val = val + other;\n48\t    }\n49\t    return val;\n50\t}\n51\t\n52\t// Reduce FpExt across chunk_size threads within a block\n53\t// chunk_size must be a power of 2\n54\t// tid_in_chunk: thread's index within its chunk [0, chunk_size)\n55\t// chunk_in_block: which chunk this thread belongs to\n56\t// smem: shared memory for cross-warp reduction (size >= total_warps_in_block)\n57\t//\n58\t// Note: When chunk_size > 32, writes to chunk_smem[warp_in_chunk] from different chunks\n59\t// may hit the same bank (FpExt = 16 bytes = 4 words). This is a minor inefficiency in the\n60\t// reduction phase, not a correctness issue.\n61\t__device__ inline FpExt chunk_reduce_sum(\n62\t    FpExt val,\n63\t    FpExt *smem,\n64\t    uint32_t tid_in_chunk,\n65\t    uint32_t chunk_size,\n66\t    uint32_t chunk_in_block\n67\t) {\n68\t    if (chunk_size <= 32) {\n69\t        return warp_reduce_sum_n(val, chunk_size);\n70\t    }\n71\t\n72\t    // Cross-warp case (chunk_size > 32)\n73\t    uint32_t warps_per_chunk = chunk_size >> 5;\n74\t    uint32_t warp_in_chunk = tid_in_chunk >> 5;\n75\t    uint32_t lane_id = tid_in_chunk & 31;\n76\t\n77\t    // Step 1: Warp-level reduction\n78\t    val = warp_reduce_sum(val);\n79\t\n80\t    // Step 2: Store warp result to shared memory\n81\t    FpExt *chunk_smem = smem + chunk_in_block * warps_per_chunk;\n82\t    if (lane_id == 0) {\n83\t        chunk_smem[warp_in_chunk] = val;\n84\t    }\n85\t    __syncthreads();\n86\t\n87\t    // Step 3: First warp of chunk reads and reduces warp results\n88\t    if (warp_in_chunk == 0) {\n89\t        FpExt zero = {0, 0, 0, 0};\n90\t        FpExt warp_val = (lane_id < warps_per_chunk) ? chunk_smem[lane_id] : zero;\n91\t        val = warp_reduce_sum(warp_val);\n92\t    }\n93\t\n94\t    return val;\n95\t}\n96\t\n97\t// ============================================================================\n98\t// ATOMIC U64 ACCUMULATION (delayed modular reduction to CPU)\n99\t// ============================================================================\n100\t//\n101\t// BabyBear elements in Montgomery form are < 2^31. Summing N elements in uint64_t\n102\t// overflows when N * 2^31 > 2^64, i.e., N > 2^33. Safe for typical GPU workloads.\n103\t// Final modular reduction is done on CPU after kernel completion.\n104\t\n105\t// Atomically add Fp raw value to uint64_t accumulator\n106\t__device__ __forceinline__ void atomic_add_fp_to_u64(uint64_t *output, Fp val) {\n107\t    atomicAdd((unsigned long long *)output, static_cast<uint64_t>(val.asRaw()));\n108\t}\n109\t\n110\t// Atomically add FpExt to uint64_t[4] accumulator\n111\t// Layout: output[0..3] correspond to elems[0..3]\n112\t__device__ __forceinline__ void atomic_add_fpext_to_u64(uint64_t *output, FpExt val) {\n113\t#pragma unroll\n114\t    for (int i = 0; i < 4; ++i) {\n115\t        atomic_add_fp_to_u64(output + i, val.elems[i]);\n116\t    }\n117\t}\n118\t\n119\t// ============================================================================\n120\t// WARP-AGGREGATED ATOMIC REDUCTION\n121\t// ============================================================================\n122\t//\n123\t// Modern best practice for block-wide sums on Volta+ architectures:\n124\t// 1. Warp-level reduction via __shfl_down_sync (zero memory latency)\n125\t// 2. Lane 0 of each warp does one atomicAdd to global memory\n126\t// 3. No __syncthreads() or shared memory required\n127\t//\n128\t// Trade-off: More atomics than full block reduction (num_warps vs 1), but\n129\t// eliminates barrier latency and shared memory bank conflicts. Modern L2\n130\t// caches handle concurrent atomics efficiently.\n131\t\n132\t// Warp-aggregated atomic: reduce within warp, lane 0 does single atomic add\n133\t__device__ __forceinline__ void warp_aggregated_atomic_add_fpext(\n134\t    uint64_t *output, // Global memory, uint64_t[4] for one FpExt\n135\t    FpExt val\n136\t) {\n137\t    // Step 1: Warp-level reduction via shuffles\n138\t    val = warp_reduce_sum(val);\n139\t\n140\t    // Step 2: Lane 0 does the atomic add\n141\t    int lane_id = threadIdx.x % WARP_SIZE;\n142\t    if (lane_id == 0) {\n143\t        atomic_add_fpext_to_u64(output, val);\n144\t    }\n145\t}\n146\t\n147\t// Indexed version for arrays of FpExt outputs\n148\t// Layout: output[idx * 4 .. idx * 4 + 3]\n149\t__device__ __forceinline__ void warp_aggregated_atomic_add_fpext_indexed(\n150\t    uint64_t *output, // Global memory, uint64_t[d * 4]\n151\t    uint32_t idx,\n152\t    FpExt val\n153\t) {\n154\t    warp_aggregated_atomic_add_fpext(output + idx * 4, val);\n155\t}\n156\t\n157\t// Block-level reduction: sums FpExt values across all threads in a block\n158\t// Two-stage process: warp-level reduction, then inter-warp reduction\n159\t// Returns result in all threads of first warp (typically only thread 0 uses it)\n160\tstatic __device__ inline FpExt block_reduce_sum(FpExt val, FpExt *shared) {\n161\t    int tid = threadIdx.x;\n162\t    int warp_id = tid / 32;\n163\t    int lane_id = tid % 32;\n164\t    int num_warps = (blockDim.x + 31) / 32; // Round up for blocks < 32 threads\n165\t\n166\t    // Stage 1: Each warp reduces its values\n167\t    val = warp_reduce_sum(val);\n168\t\n169\t    // Lane 0 of each warp writes result to shared memory\n170\t    if (lane_id == 0) {\n171\t        shared[warp_id] = val;\n172\t    }\n173\t    __syncthreads();\n174\t\n175\t    // Stage 2: First warp reduces the per-warp results\n176\t    FpExt zero = {0, 0, 0, 0};\n177\t    if (warp_id == 0) {\n178\t        // Only the first warp participates in the second reduction. Within that warp we\n179\t        // reuse the lane id to index the number of warps stored in shared memory.\n180\t        FpExt warp_val = (lane_id < num_warps) ? shared[lane_id] : zero;\n181\t        val = warp_reduce_sum(warp_val);\n182\t    }\n183\t\n184\t    return val;\n185\t}\n186\t\n187\t// Final reduction: combines partial block sums into final result\n188\t// Grid dimension: D blocks (one per output value)\n189\t// Each block reduces num_blocks partial sums for its assigned output\n190\t//\n191\t// The number of blocks is constant and determined by template parameter D.\n192\ttemplate <int D>\n193\tstatic __global__ void static_final_reduce_block_sums(\n194\t    const FpExt *block_sums, // [num_blocks][D]\n195\t    FpExt *output,           // [D]\n196\t    uint32_t num_blocks\n197\t) {\n198\t    extern __shared__ char smem[];\n199\t    FpExt *shared = (FpExt *)smem;\n200\t\n201\t    int tid = threadIdx.x;\n202\t\n203\t    // blockIdx.x selects which of the D outputs we're computing\n204\t    int out_idx = blockIdx.x;\n205\t    if (out_idx >= D)\n206\t        return;\n207\t\n208\t    FpExt sum = {0, 0, 0, 0};\n209\t\n210\t    // Each thread accumulates subset of blocks\n211\t    for (int block_id = tid; block_id < num_blocks; block_id += blockDim.x) {\n212\t        sum += block_sums[block_id * D + out_idx];\n213\t    }\n214\t\n215\t    // Block-level reduction\n216\t    sum = block_reduce_sum(sum, shared);\n217\t\n218\t    if (tid == 0) {\n219\t        output[out_idx] = sum;\n220\t    }\n221\t}\n222\t\n223\t// gridDim.x must be set to equal `d`\n224\ttemplate <bool ADD_TO_OUTPUT = false>\n225\tstatic __global__ void final_reduce_block_sums(\n226\t    const FpExt *block_sums, // [num_blocks][d]\n227\t    FpExt *output,           // [d]\n228\t    uint32_t num_blocks\n229\t) {\n230\t    extern __shared__ char smem[];\n231\t    FpExt *shared = (FpExt *)smem;\n232\t\n233\t    int tid = threadIdx.x;\n234\t\n235\t    // blockIdx.x selects which of the D outputs we're computing\n236\t    int out_idx = blockIdx.x;\n237\t    int d = gridDim.x;\n238\t\n239\t    FpExt sum = {0, 0, 0, 0};\n240\t\n241\t    // Each thread accumulates subset of blocks\n242\t    for (int block_id = tid; block_id < num_blocks; block_id += blockDim.x) {\n243\t        sum += block_sums[block_id * d + out_idx];\n244\t    }\n245\t\n246\t    // Block-level reduction\n247\t    sum = block_reduce_sum(sum, shared);\n248\t\n249\t    if (tid == 0) {\n250\t        if constexpr (ADD_TO_OUTPUT) {\n251\t            output[out_idx] += sum;\n252\t        } else {\n253\t            output[out_idx] = sum;\n254\t        }\n255\t    }\n256\t}\n257\t\n258\t// Batched version: reduces partial sums for multiple segments (e.g., AIRs) in a single launch.\n259\t// Grid: (num_segments, d) where each block (seg, x) reduces blocks for segment `seg` at output index `x`.\n260\t// segment_offsets[seg] gives the start block index; segment_offsets[seg+1] gives the end.\n261\tstatic __global__ void batched_final_reduce_block_sums(\n262\t    const FpExt *block_sums,           // [total_blocks][d]\n263\t    FpExt *output,                     // [num_segments][d]\n264\t    const uint32_t *segment_offsets,   // [num_segments + 1], device memory\n265\t    uint32_t d\n266\t) {\n267\t    extern __shared__ char smem[];\n268\t    FpExt *shared = (FpExt *)smem;\n269\t\n270\t    uint32_t seg_idx = blockIdx.x;\n271\t    uint32_t out_idx = blockIdx.y;\n272\t    int tid = threadIdx.x;\n273\t\n274\t    uint32_t start = segment_offsets[seg_idx];\n275\t    uint32_t end = segment_offsets[seg_idx + 1];\n276\t    uint32_t num_blocks = end - start;\n277\t\n278\t    FpExt sum = {0, 0, 0, 0};\n279\t\n280\t    // Each thread accumulates a strided subset of this segment's blocks\n281\t    for (uint32_t i = tid; i < num_blocks; i += blockDim.x) {\n282\t        sum += block_sums[(start + i) * d + out_idx];\n283\t    }\n284\t\n285\t    // Block-level reduction\n286\t    sum = block_reduce_sum(sum, shared);\n287\t\n288\t    if (tid == 0) {\n289\t        output[seg_idx * d + out_idx] = sum;\n290\t    }\n291\t}\n292\t\n293\t// Folds MLE evaluations using challenge r: output[y] = input[2*y] + r*(input[2*y+1] - input[2*y])\n294\t__device__ __forceinline__ void fold_mle(\n295\t    const FpExt *__restrict__ const *__restrict__ input_matrices,\n296\t    FpExt *__restrict__ const *__restrict__ output_matrices,\n297\t    const uint32_t *widths, // Width of each matrix\n298\t    const uint8_t log_output_height,\n299\t    const FpExt &r_val,\n300\t    uint32_t tidx,\n301\t    uint32_t mat_idx\n302\t) {\n303\t    uint32_t width = widths[mat_idx];\n304\t    uint32_t output_height = 1 << log_output_height;\n305\t    if (tidx >= output_height * width)\n306\t        return;\n307\t    uint32_t row_idx = tidx & (output_height - 1);\n308\t    uint32_t col_idx = tidx >> log_output_height;\n309\t\n310\t    const FpExt *input = input_matrices[mat_idx];\n311\t    FpExt *output = output_matrices[mat_idx];\n312\t\n313\t    auto col_offset_out = col_idx * output_height;\n314\t    auto col_offset_in = col_offset_out << 1;\n315\t\n316\t    auto idx_0 = col_offset_in + (row_idx << 1);\n317\t    auto idx_1 = col_offset_in + (row_idx << 1) + 1;\n318\t    auto out_idx = col_offset_out + row_idx;\n319\t\n320\t    FpExt t0 = input[idx_0];\n321\t    FpExt t1 = input[idx_1];\n322\t\n323\t    output[out_idx] = t0 + r_val * (t1 - t0);\n324\t}\n325\t\n326\t} // namespace sumcheck\n327\t"}]},"parent_tool_use_id":"toolu_01Ms7oxXZjHmbUorCdjoQ5hr","session_id":"3eab5b9b-40e0-4e43-bd71-fd448feabe6e","uuid":"89c2f817-965c-4711-a0f7-400f87d1a60b","timestamp":"2026-04-13T13:12:27.118Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HzE6r35jjXUq5YJaTrXb3C","type":"tool_result","content":"1\t#include \"fp.h\"\n2\t#include \"fpext.h\"\n3\t#include \"launcher.cuh\"\n4\t#include \"sumcheck.cuh\"\n5\t#include <algorithm>\n6\t#include <cstddef>\n7\t#include <cstdint>\n8\t#include <utility>\n9\t#include <vector_types.h>\n10\t\n11\tnamespace plain_sumcheck {\n12\t\n13\t// Reduces evaluations over x and column dimensions for PLE round 0\n14\t// Input:  [num_x * num_cols * large_domain_size] - evaluations on large domain\n15\t// Output: [large_domain_size] - summed evaluations\n16\t// Each thread handles one z value, summing over all (x, col) pairs\n17\t// Memory: Column-major layout where each (x,col) is a column of size large_domain_size\n18\t__global__ void reduce_over_x_and_cols_kernel(\n19\t    const Fp *input, // [num_x * num_cols * large_domain_size]\n20\t    Fp *output,      // [large_domain_size]\n21\t    uint32_t num_x,\n22\t    uint32_t num_cols,\n23\t    uint32_t large_domain_size\n24\t) {\n25\t    // Each thread handles one z value\n26\t    int z = blockIdx.x * blockDim.x + threadIdx.x;\n27\t    if (z >= large_domain_size)\n28\t        return;\n29\t\n30\t    Fp sum = Fp::zero();\n31\t\n32\t    // Sum input[(x * num_cols + col) * large_domain_size + z] over all (x, col)\n33\t    for (uint32_t x = 0; x < num_x; x++) {\n34\t        for (uint32_t col = 0; col < num_cols; col++) {\n35\t            // Column-major layout: [x * num_cols + col][z]\n36\t            uint32_t offset = (x * num_cols + col) * large_domain_size;\n37\t            sum = sum + input[offset + z];\n38\t        }\n39\t    }\n40\t\n41\t    output[z] = sum;\n42\t}\n43\t\n44\t// Computes univariate polynomial evaluations for MLE sumcheck round\n45\t// For each X ∈ {1, ..., d}, computes: s(X) = Σ_{y ∈ H_{n-1}} f̂(X, y)\n46\t// where f̂(X, y) is obtained by linear interpolation: f(0,y) + X*(f(1,y) - f(0,y))\n47\t//\n48\t// Memory layout: Column-major matrices with height = 2^n\n49\t// - For each y: reads indices [2*y, 2*y+1] (even/odd pairs)\n50\t// - Outputs partial sums per block, final reduction done in separate kernel\n51\t//\n52\t// Template parameter WD: Number of output polynomials (typically 1)\n53\t// NOTE: This implements identity W function. For custom W, modify accumulation section.\n54\ttemplate <int WD>\n55\t__global__ void sumcheck_mle_round_kernel(\n56\t    const uintptr_t *input_matrices,\n57\t    FpExt *block_sums, // Output: [gridDim.x][d][WD] partial sums\n58\t    const uint32_t *widths,\n59\t    const uint32_t num_matrices,\n60\t    const uint32_t height, // = 2^n\n61\t    const uint32_t d       // degree (runtime parameter)\n62\t) {\n63\t    extern __shared__ char smem[];\n64\t    FpExt *shared = (FpExt *)smem;\n65\t\n66\t    int half_height = height >> 1;\n67\t\n68\t    // Local accumulators for all (d, WD) pairs\n69\t    constexpr int MAX_D = 5; // [TODO] Mark this in doc that it's max degree 4 + 1\n70\t    FpExt local_sums[WD * MAX_D];\n71\t\n72\t    // Initialize accumulators\n73\t    for (int i = 0; i < d * WD; i++) {\n74\t        local_sums[i] = {0, 0, 0, 0};\n75\t    }\n76\t\n77\t    // Map phase: each thread processes multiple y values\n78\t    for (int y = blockIdx.x * blockDim.x + threadIdx.x; y < half_height;\n79\t         y += gridDim.x * blockDim.x) {\n80\t\n81\t        // For each evaluation point X in {1, 2, ..., d}\n82\t        for (uint32_t x_int = 1; x_int <= d; x_int++) {\n83\t            FpExt X = FpExt(Fp(x_int));\n84\t\n85\t            // For identity W: we simply sum all matrix column evaluations\n86\t            // For each matrix\n87\t            for (int mat_idx = 0; mat_idx < num_matrices; mat_idx++) {\n88\t                const FpExt *input = reinterpret_cast<const FpExt *>(input_matrices[mat_idx]);\n89\t                int width = widths[mat_idx];\n90\t\n91\t                // For each column\n92\t                for (int col = 0; col < width; col++) {\n93\t                    int col_offset = col * height;\n94\t                    int idx_0 = col_offset + (y << 1);\n95\t                    int idx_1 = col_offset + (y << 1) + 1;\n96\t\n97\t                    FpExt eval_0 = input[idx_0];\n98\t                    FpExt eval_1 = input[idx_1];\n99\t\n100\t                    FpExt eval_X = eval_0 + X * (eval_1 - eval_0);\n101\t\n102\t                    // For identity W and WD=1: accumulate directly\n103\t                    // TODO: When implementing custom W, replace this section\n104\t                    local_sums[(x_int - 1) * WD + 0] += eval_X;\n105\t                }\n106\t            }\n107\t        }\n108\t    }\n109\t\n110\t    // Reduce phase: for each (x_int, wd) pair\n111\t    for (int x_int = 0; x_int < d; x_int++) {\n112\t        for (int wd = 0; wd < WD; wd++) {\n113\t            int idx = x_int * WD + wd;\n114\t            FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n115\t\n116\t            if (threadIdx.x == 0) {\n117\t                block_sums[blockIdx.x * d * WD + idx] = reduced;\n118\t            }\n119\t            __syncthreads(); // Needed before reusing shared memory\n120\t        }\n121\t    }\n122\t}\n123\t\n124\t// Final reduction: combines partial block sums into final result\n125\t// Grid dimension: d * WD blocks (one per output value)\n126\t// Each block reduces num_blocks partial sums for its assigned output\n127\ttemplate <int WD>\n128\t__global__ void reduce_blocks_sumcheck(\n129\t    const FpExt *block_sums, // [num_blocks][d * WD]\n130\t    FpExt *output,           // [d * WD]\n131\t    uint32_t num_blocks,\n132\t    uint32_t d\n133\t) {\n134\t    extern __shared__ char smem[];\n135\t    FpExt *shared = (FpExt *)smem;\n136\t\n137\t    int tid = threadIdx.x;\n138\t\n139\t    // blockIdx.x selects which of the (d * WD) outputs we're computing\n140\t    int out_idx = blockIdx.x;\n141\t    if (out_idx >= d * WD)\n142\t        return;\n143\t\n144\t    FpExt sum = {0, 0, 0, 0};\n145\t\n146\t    // Each thread accumulates subset of blocks\n147\t    for (int block_id = tid; block_id < num_blocks; block_id += blockDim.x) {\n148\t        sum += block_sums[block_id * d * WD + out_idx];\n149\t    }\n150\t\n151\t    // Block-level reduction\n152\t    sum = sumcheck::block_reduce_sum(sum, shared);\n153\t\n154\t    if (tid == 0) {\n155\t        output[out_idx] = sum;\n156\t    }\n157\t}\n158\t\n159\t// Folds MLE evaluations using challenge r: output[y] = input[2*y] + r*(input[2*y+1] - input[2*y])\n160\t// Memory: Column-major layout, each column folded independently\n161\t// - Input:  height = 2^n per column\n162\t// - Output: height = 2^(n-1) per column\n163\t// Grid: (blocks for height/2, num_matrices) to parallelize over both dimensions\n164\t__global__ void fold_mle_kernel(\n165\t    const FpExt *__restrict__ const *__restrict__ input_matrices, // Array of input matrix pointers\n166\t    FpExt *__restrict__ const *__restrict__ output_matrices,      // Array of output matrix pointers\n167\t    const uint32_t *widths,                                       // Width of each matrix\n168\t    const uint8_t log_output_height,\n169\t    const FpExt r_val\n170\t) {\n171\t    uint32_t mat_idx = blockIdx.y * blockDim.y + threadIdx.y;\n172\t    uint32_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n173\t\n174\t    // blockIdx.y selects which matrix we're working on\n175\t    sumcheck::fold_mle(\n176\t        input_matrices, output_matrices, widths, log_output_height, r_val, tidx, mat_idx\n177\t    );\n178\t}\n179\t\n180\t__global__ void fold_mle_column_kernel(FpExt *buffer, size_t half, FpExt r) {\n181\t    size_t idx = blockIdx.x * blockDim.x + threadIdx.x;\n182\t    if (idx >= half) {\n183\t        return;\n184\t    }\n185\t\n186\t    FpExt &t0 = buffer[idx];\n187\t    FpExt const &t1 = buffer[idx | half];\n188\t    t0 += r * (t1 - t0);\n189\t}\n190\t\n191\t// Folds MLE evaluations as in fold_mle_kernel above, but supports matrices of different heights\n192\t__global__ void batch_fold_mle_kernel(\n193\t    const FpExt *__restrict__ const *__restrict__ input_matrices, // Array of input matrix pointers\n194\t    FpExt *__restrict__ const *__restrict__ output_matrices,      // Array of output matrix pointers\n195\t    const uint32_t *widths,                                       // Width of each matrix\n196\t    const uint8_t *log_output_heights,\n197\t    const FpExt r_val\n198\t) {\n199\t    uint32_t mat_idx = blockIdx.y * blockDim.y + threadIdx.y;\n200\t    uint32_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n201\t\n202\t    uint8_t log_output_height = log_output_heights[mat_idx];\n203\t\n204\t    sumcheck::fold_mle(\n205\t        input_matrices, output_matrices, widths, log_output_height, r_val, tidx, mat_idx\n206\t    );\n207\t}\n208\t\n209\t// Evaluates univariate polynomials at challenge point r using Horner's method\n210\t// Input: Polynomial coefficients (from iDFT in round 0) in natural order\n211\t// Output: Evaluations in extension field\n212\t//\n213\t// Memory layout: Column-major with domain_size coefficients per polynomial\n214\t// - input_coeffs[(x * width + col) * domain_size + i] = coefficient c_i for polynomial (x, col)\n215\t// - Evaluates: c_0 + c_1*r + c_2*r^2 + ... using Horner's method\n216\t//\n217\t// Why this works: During PLE round 0, we performed iDFT with bit_reverse=true,\n218\t// converting evaluations to coefficients in natural order. We reuse those\n219\t// coefficients here instead of re-interpolating from evaluations (more efficient).\n220\t__global__ void fold_ple_from_coeffs_kernel(\n221\t    const Fp *__restrict__ input_coeffs, // [num_x * width * domain_size] after iDFT\n222\t    FpExt *__restrict__ output,          // [num_x * width]\n223\t    uint32_t num_x,\n224\t    uint32_t width,\n225\t    uint32_t domain_size, // 2^l_skip\n226\t    FpExt r_val\n227\t) {\n228\t    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n229\t    int total_polys = num_x * width;\n230\t\n231\t    if (idx >= total_polys)\n232\t        return;\n233\t\n234\t    // Coefficients for this (x, col) are at offset idx * domain_size\n235\t    const Fp *coeffs = input_coeffs + idx * domain_size;\n236\t\n237\t    // Horner's method: evaluate polynomial at r\n238\t    FpExt result = FpExt(Fp(coeffs[domain_size - 1]));\n239\t    for (int i = domain_size - 2; i >= 0; i--) {\n240\t        result = result * r_val + FpExt(Fp(coeffs[i]));\n241\t    }\n242\t\n243\t    output[idx] = result;\n244\t}\n245\t\n246\t// output should be segment tree of size 2 * 2^{output_max_n},\n247\t// input should be segment tree of size 2 * 2^{output_max_n + 1}\n248\t// We fold each segment of input and write to corresponding segment of output\n249\t// The input[1] is ignored.\n250\t__global__ void triangular_fold_mle_kernel(FpExt *output, const FpExt *input, FpExt r) {\n251\t    uint32_t x = blockIdx.x * blockDim.x + threadIdx.x;\n252\t    uint32_t n = blockIdx.y;\n253\t    uint32_t out_num_x = 1 << n;\n254\t    uint32_t in_num_x = 2 * out_num_x;\n255\t\n256\t    if (x >= out_num_x)\n257\t        return;\n258\t    FpExt t0 = input[in_num_x + (x << 1)];\n259\t    FpExt t1 = input[in_num_x + (x << 1) + 1];\n260\t    output[out_num_x + x] = t0 + (t1 - t0) * r;\n261\t}\n262\t\n263\t// ============================================================================\n264\t// LAUNCHERS\n265\t// ============================================================================\n266\t\n267\tstd::pair<dim3, dim3> fold_mle_launch_params(uint32_t max_output_cells, uint32_t num_matrices) {\n268\t    if (max_output_cells <= WARP_SIZE) {\n269\t        return kernel_launch_2d_params(max_output_cells, num_matrices);\n270\t    } else {\n271\t        auto [grid, block] = kernel_launch_params(max_output_cells);\n272\t        grid.y = num_matrices;\n273\t        return {grid, block};\n274\t    }\n275\t}\n276\t\n277\textern \"C\" int _fold_mle(\n278\t    const FpExt *const *input_matrices,\n279\t    FpExt *const *output_matrices,\n280\t    const uint32_t *widths,\n281\t    const uint16_t num_matrices,\n282\t    const uint32_t output_height,\n283\t    const uint32_t max_output_cells,\n284\t    const FpExt r_val\n285\t) {\n286\t    auto [grid, block] = fold_mle_launch_params(max_output_cells, num_matrices);\n287\t    uint8_t log_output_height = static_cast<uint8_t>(31 - __builtin_clz(output_height));\n288\t    fold_mle_kernel<<<grid, block>>>(\n289\t        input_matrices, output_matrices, widths, log_output_height, r_val\n290\t    );\n291\t    return CHECK_KERNEL();\n292\t}\n293\t\n294\textern \"C\" int _fold_mle_column(FpExt *buffer, size_t size, FpExt r) {\n295\t    if (size <= 1) {\n296\t        return 0;\n297\t    }\n298\t    size_t half = size >> 1;\n299\t    auto [grid, block] = kernel_launch_params(half);\n300\t    fold_mle_column_kernel<<<grid, block>>>(buffer, half, r);\n301\t    return CHECK_KERNEL();\n302\t}\n303\t\n304\textern \"C\" int _batch_fold_mle(\n305\t    const FpExt *const *input_matrices,\n306\t    FpExt *const *output_matrices,\n307\t    const uint32_t *widths,\n308\t    const uint16_t num_matrices,\n309\t    const uint8_t *log_output_heights,\n310\t    const uint32_t max_output_cells, // max(height * width)\n311\t    const FpExt r_val\n312\t) {\n313\t    auto [grid, block] = fold_mle_launch_params(max_output_cells, num_matrices);\n314\t    batch_fold_mle_kernel<<<grid, block>>>(\n315\t        input_matrices, output_matrices, widths, log_output_heights, r_val\n316\t    );\n317\t    return CHECK_KERNEL();\n318\t}\n319\t\n320\textern \"C\" int _fold_ple_from_coeffs(\n321\t    const Fp *input_coeffs,\n322\t    FpExt *output,\n323\t    const uint32_t num_x,\n324\t    const uint32_t width,\n325\t    const uint32_t domain_size,\n326\t    const FpExt r_val\n327\t) {\n328\t    int total_polys = num_x * width;\n329\t    auto [grid, block] = kernel_launch_params(total_polys);\n330\t\n331\t    fold_ple_from_coeffs_kernel<<<grid, block>>>(\n332\t        input_coeffs, output, num_x, width, domain_size, r_val\n333\t    );\n334\t\n335\t    return CHECK_KERNEL();\n336\t}\n337\t\n338\textern \"C\" int _reduce_over_x_and_cols(\n339\t    const Fp *input,\n340\t    Fp *output,\n341\t    uint32_t num_x,\n342\t    uint32_t num_cols,\n343\t    uint32_t large_domain_size\n344\t) {\n345\t    auto [grid, block] = kernel_launch_params(large_domain_size);\n346\t    reduce_over_x_and_cols_kernel<<<grid, block>>>(\n347\t        input, output, num_x, num_cols, large_domain_size\n348\t    );\n349\t    return CHECK_KERNEL();\n350\t}\n351\t\n352\t// WD = 1\n353\textern \"C\" int _sumcheck_mle_round(\n354\t    const uintptr_t *input_matrices,\n355\t    FpExt *output,         // Output: [d * WD] final results\n356\t    FpExt *tmp_block_sums, // Temporary buffer: [num_blocks * d * WD]\n357\t    const uint32_t *widths,\n358\t    const uint32_t num_matrices,\n359\t    const uint32_t height,\n360\t    const uint32_t d\n361\t) {\n362\t    int half_height = height >> 1;\n363\t    auto [grid, block] = kernel_launch_params(half_height);\n364\t    unsigned int num_warps = (block.x + WARP_SIZE - 1) / WARP_SIZE;\n365\t    size_t shmem_bytes = std::max(1u, num_warps) * sizeof(FpExt);\n366\t\n367\t    // Launch main kernel - writes to tmp_block_sums\n368\t    sumcheck_mle_round_kernel<1><<<grid, block, shmem_bytes>>>(\n369\t        input_matrices, tmp_block_sums, widths, num_matrices, height, d\n370\t    );\n371\t\n372\t    int err = CHECK_KERNEL();\n373\t    if (err != 0)\n374\t        return err;\n375\t\n376\t    // Launch final reduction kernel - reads from tmp_block_sums, writes to output\n377\t    auto num_blocks = grid.x;\n378\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n379\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n380\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n381\t    reduce_blocks_sumcheck<1>\n382\t        <<<d, reduce_block, reduce_shmem>>>(tmp_block_sums, output, num_blocks, d);\n383\t\n384\t    return CHECK_KERNEL();\n385\t}\n386\t\n387\textern \"C\" int _triangular_fold_mle(\n388\t    FpExt *output,\n389\t    const FpExt *input,\n390\t    FpExt r,\n391\t    uint32_t output_max_n\n392\t) {\n393\t    auto [grid, block] = kernel_launch_params(1 << output_max_n);\n394\t    grid.y = output_max_n + 1;\n395\t\n396\t    triangular_fold_mle_kernel<<<grid, block>>>(output, input, r);\n397\t\n398\t    return CHECK_KERNEL();\n399\t}\n400\t\n401\t} // namespace plain_sumcheck\n402\t"}]},"parent_tool_use_id":"toolu_01Ms7oxXZjHmbUorCdjoQ5hr","session_id":"3eab5b9b-40e0-4e43-bd71-fd448feabe6e","uuid":"449eaf92-1e70-4fdb-ab5e-aa3bdbfeb8f5","timestamp":"2026-04-13T13:12:27.197Z"}
