if small_trace_idxs.is_empty() {\n        return Ok(());\n    }\n\n    let mut d_main_parts_keepalive = Vec::new();\n    let mut descs: Vec<BatchedR0AirDesc> = Vec::new();\n\n    for &trace_idx in &small_trace_idxs {\n        let (air_idx, air_ctx) = &per_trace[trace_idx];\n        let n = n_per_trace[trace_idx];\n        let sel = &selectors_base[trace_idx];\n        let pv = &public_values_per_trace[trace_idx];\n        let eq3b = &eq_3b_per_trace[trace_idx];\n        let single_pk = &pk.per_air[*air_idx];\n        let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n        let height = air_ctx.common_main.height();\n        let n_lift = n.max(0) as usize;\n        let num_x = 1u32 << n_lift;\n\n        let mut main_parts = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n        for committed in &air_ctx.cached_mains {\n            main_parts.push(committed.trace.buffer().as_ptr());\n        }\n        main_parts.push(air_ctx.common_main.buffer().as_ptr());\n        let d_main_parts = main_parts.to_device()?;\n\n        let log_large_domain = log2_ceil_usize(local_constraint_deg << l_skip);\n        let omega_root = F::two_adic_generator(log_large_domain);\n        let eq_xi_tree = &eq_xis[&n_lift];\n\n        let num_cosets_zc = local_constraint_deg.saturating_sub(1) as u32;\n        let num_cosets_logup = local_constraint_deg as u32;\n\n        let preprocessed_ptr = single_pk\n            .preprocessed_data\n            .as_ref()\n            .map(|cd| cd.trace.buffer().as_ptr())\n            .unwrap_or(std::ptr::null());\n\n        let zc_rules = &single_pk.other_data.zerocheck_round0;\n        let constraints_dag = &single_pk.vk.symbolic_constraints;\n        let has_constraints =\n            !constraints_dag.constraints.constraint_idx.is_empty() && num_cosets_zc > 0;\n\n        let single_air_constraints =\n            SymbolicConstraintsT::from(&single_pk.vk.symbolic_constraints);\n        let logup_rules = build_logup_rules_for_air(single_pk, &single_air_constraints, beta_pows, eq3b)?;\n\n        descs.push(BatchedR0AirDesc {\n            trace_idx, num_x, height: height as u32, g_shift: omega_root,\n            buffer_size_zc: if has_constraints { zc_rules.inner.buffer_size } else { 0 },\n            buffer_size_logup: logup_rules.as_ref().map(|r| r.buffer_size).unwrap_or(0),\n            num_cosets_zc, num_cosets_logup,\n            selectors_cube: sel.buffer().as_ptr(), preprocessed: preprocessed_ptr,\n            d_main_parts: d_main_parts.as_ptr(), eq_cube: eq_xi_tree.get_ptr(n_lift),\n            lambda_pows: d_lambda_pows.as_ptr(), public_values: pv.as_ptr(),\n            d_zc_rules: if has_constraints { zc_rules.inner.d_rules.as_raw_ptr() as *const _ } else { std::ptr::null() },\n            d_zc_used_nodes: if has_constraints { zc_rules.inner.d_used_nodes.as_ptr() } else { std::ptr::null() },\n            zc_rules_len: if has_constraints { zc_rules.inner.d_rules.len() } else { 0 },\n            zc_used_nodes_len: if has_constraints { zc_rules.inner.d_used_nodes.len() } else { 0 },\n            lambda_len: d_lambda_pows.len(), logup_rules,\n        });\n        d_main_parts_keepalive.push(d_main_parts);\n    }\n\n    info!(\"Round0 Phase4: {} small AIRs processed via batched kernels\", descs.len());\n\n    // Batched zerocheck\n    let mut zc_groups: std::collections::BTreeMap<u32, Vec<usize>> = std::collections::BTreeMap::new();\n    for (i, d) in descs.iter().enumerate() {\n        if d.zc_rules_len > 0 && d.num_cosets_zc > 0 { zc_groups.entry(d.num_cosets_zc).or_default().push(i); }\n    }\n    for (num_cosets, indices) in &zc_groups {\n        let group_descs: Vec<&BatchedR0AirDesc> = indices.iter().map(|&i| &descs[i]).collect();\n        let output = evaluate_batched_zerocheck_group(&group_descs, *num_cosets, skip_domain)?;\n        if output.is_empty() { continue; }\n        let output_h = output.to_host_on_current_stream()?;\n        let d = *num_cosets as usize * skip_domain as usize;\n        for (group_idx, &desc_idx) in indices.iter().enumerate() {\n            let desc = &descs[desc_idx];\n            let local_constraint_deg = desc.num_cosets_zc as usize + 1;\n            let nc = desc.num_cosets_zc as usize;\n            let q_evals = &output_h[group_idx * d..(group_idx + 1) * d];\n            let mut values = EF::zero_vec(nc << l_skip);\n            for c in 0..nc { for i in 0..1 << l_skip { values[i * nc + c] = q_evals[(c << l_skip) + i]; } }\n            let log_ld = log2_ceil_usize(local_constraint_deg << l_skip);\n            let or = F::two_adic_generator(log_ld);\n            let q = UnivariatePoly::from_geometric_cosets_evals_idft(RowMajorMatrix::new(values, nc), or, or);\n            let sp_0_deg = sumcheck_round0_deg(l_skip, local_constraint_deg);\n            let coeffs: Vec<_> = (0..=sp_0_deg).map(|i| {\n                let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n                if i >= 1 << l_skip { c += q.coeffs()[i - (1 << l_skip)]; }\n                c\n            }).collect();\n            batch_sp_poly[2 * num_present_airs + desc.trace_idx] = UnivariatePoly::new(coeffs);\n        }\n    }\n\n    // Batched logup\n    let mut logup_groups: std::collections::BTreeMap<u32, Vec<usize>> = std::collections::BTreeMap::new();\n    for (i, d) in descs.iter().enumerate() {\n        if d.logup_rules.is_some() && d.num_cosets_logup > 0 { logup_groups.entry(d.num_cosets_logup).or_default().push(i); }\n    }\n    for (num_cosets, indices) in &logup_groups {\n        let group_descs: Vec<&BatchedR0AirDesc> = indices.iter().map(|&i| &descs[i]).collect();\n        let output = evaluate_batched_logup_group(&group_descs, *num_cosets, skip_domain)?;\n        if output.is_empty() { continue; }\n        let output_h = output.to_host_on_current_stream()?;\n        let d = *num_cosets as usize * skip_domain as usize;\n        for (group_idx, &desc_idx) in indices.iter().enumerate() {\n            let desc = &descs[desc_idx];\n            let n = n_per_trace[desc.trace_idx];\n            let nc = desc.num_cosets_logup as usize;\n            let evals = &output_h[group_idx * d..(group_idx + 1) * d];\n            let (mut numer, denom): (Vec<EF>, Vec<EF>) = evals.iter().map(|f| (f.p, f.q)).unzip();\n            if n.is_negative() { let nf = F::from_u32(1 << n.unsigned_abs()).inverse(); for s in &mut numer { *s *= nf; } }\n            let mut nv = EF::zero_vec(nc << l_skip);\n            let mut dv = EF::zero_vec(nc << l_skip);\n            for c in 0..nc { for i in 0..1 << l_skip { nv[i * nc + c] = numer[(c << l_skip) + i]; dv[i * nc + c] = denom[(c << l_skip) + i]; } }\n            let log_ld = log2_ceil_usize(nc << l_skip);\n            let or = F::two_adic_generator(log_ld);\n            batch_sp_poly[2 * desc.trace_idx] = UnivariatePoly::from_geometric_cosets_evals_idft(RowMajorMatrix::new(nv, nc), or, F::ONE);\n            batch_sp_poly[2 * desc.trace_idx + 1] = UnivariatePoly::from_geometric_cosets_evals_idft(RowMajorMatrix::new(dv, nc), or, F::ONE);\n        }\n    }\n\n    Ok(())\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":246,"cache_read_input_tokens":242921,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":246},"output_tokens":72,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"3eab5b9b-40e0-4e43-bd71-fd448feabe6e","uuid":"0d60695d-8f9b-4875-86a2-731e29a490de"}
