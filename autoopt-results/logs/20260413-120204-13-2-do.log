intermediates spill.\n165\tnamespace align_x_round0_config {\n166\t\n167\t// Returns {zs_per_grid, zs_per_block}\n168\t// NOTE: it is best for avoiding warp divergence that `large_domain` is a multiple of `WARP_SIZE` (32).\n169\tinline std::pair<uint32_t, uint32_t> get_z_dim(uint32_t large_domain) {\n170\t    // Since we are currently not using any shared memory in relation to the `z_int` variable, the only\n171\t    // important factor is that every thread in a warp shares the same `x_int`.\n172\t    // NOTE: when `large_domain < WARP_SIZE`, there is unavoidable warp divergence, so we just optimize\n173\t    // for packing as much into the block as possible.\n174\t    uint32_t zs_per_block = std::min(large_domain, static_cast<uint32_t>(WARP_SIZE));\n175\t    uint32_t zs_per_grid = div_ceil(large_domain, zs_per_block);\n176\t    return {zs_per_grid, zs_per_block};\n177\t}\n178\t\n179\tinline std::pair<dim3, dim3> eval_constraints_launch_params(\n180\t    uint32_t buffer_size,\n181\t    uint32_t large_domain, // range of z_int\n182\t    uint32_t num_x,        // range of x_int\n183\t    size_t max_temp_bytes,\n184\t    uint32_t buffer_threshold, // threshold for switching intermediate buffer to global memory\n185\t    uint32_t threads_per_block\n186\t) {\n187\t    auto [zs_per_grid, zs_per_block] = get_z_dim(large_domain);\n188\t    auto xs_per_block =\n189\t        std::min(static_cast<size_t>(num_x), div_ceil(threads_per_block, zs_per_block));\n190\t    dim3 block(xs_per_block * zs_per_block);\n191\t    // We will define grid = xs_per_grid * zs_per_grid, where varying xs_per_grid affects the global\n192\t    // memory usage.\n193\t    // `temp_sums_buffer_size` is `xs_per_grid * large_domain`\n194\t    size_t scale_factor = large_domain;\n195\t    if (buffer_size > buffer_threshold) {\n196\t        // This mean global memory is used.\n197\t        // `intermediates_buffer_size` is `xs_per_grid * xs_per_block * large_domain * buffer_size`\n198\t        scale_factor 