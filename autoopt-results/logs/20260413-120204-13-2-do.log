{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019wY3PJ9UVgAPu6nuZA5Ved","type":"tool_result","content":"1\tuse super::*;\n2\tuse crate::{\n3\t    monomial::{InteractionMonomialTerm, LambdaTerm, MonomialHeader, PackedVar},\n4\t    poly::SqrtEqLayers,\n5\t};\n6\t\n7\t#[repr(C)]\n8\t#[derive(Clone, Copy, Debug)]\n9\tpub struct MainMatrixPtrs<T> {\n10\t    pub data: *const T,\n11\t    pub air_width: u32,\n12\t}\n13\t\n14\t// Types for batch MLE:\n15\t#[repr(C)]\n16\t#[derive(Clone, Copy, Debug)]\n17\tpub struct BlockCtx {\n18\t    pub local_block_idx_x: u32,\n19\t    /// Caution: this refers to the index within buffer of `ZerocheckCtx` or `LogupCtx`. It is\n20\t    /// hence a \"local\" AIR index and not the global AIR index within the proving key.\n21\t    pub air_idx: u32,\n22\t}\n23\t\n24\t/// Per-AIR context for batched monomial evaluation.\n25\t#[repr(C)]\n26\t#[derive(Clone, Copy, Debug)]\n27\tpub struct MonomialAirCtx {\n28\t    pub d_headers: *const MonomialHeader,\n29\t    pub d_variables: *const PackedVar,\n30\t    pub d_lambda_combinations: *const EF, // Precomputed per-monomial\n31\t    pub num_monomials: u32,\n32\t    pub eval_ctx: EvalCoreCtx,\n33\t    pub d_eq_xi: *const EF,\n34\t    pub num_y: u32,\n35\t}\n36\t\n37\t#[repr(C)]\n38\t#[derive(Clone, Copy, Debug)]\n39\tpub struct EvalCoreCtx {\n40\t    pub d_selectors: *const EF,\n41\t    pub d_preprocessed: MainMatrixPtrs<EF>,\n42\t    pub d_main: *const MainMatrixPtrs<EF>,\n43\t    pub d_public: *const F,\n44\t}\n45\t\n46\t#[repr(C)]\n47\t#[derive(Clone, Copy, Debug)]\n48\tpub struct ZerocheckCtx {\n49\t    pub eval_ctx: EvalCoreCtx,\n50\t    pub d_intermediates: *mut EF,\n51\t    pub num_y: u32,\n52\t    pub d_eq_xi: *const EF,\n53\t    pub d_rules: *const std::ffi::c_void,\n54\t    pub rules_len: usize,\n55\t    pub d_used_nodes: *const usize,\n56\t    pub used_nodes_len: usize,\n57\t    pub buffer_size: u32,\n58\t}\n59\t\n60\t#[repr(C)]\n61\t#[derive(Clone, Copy, Debug)]\n62\tpub struct LogupCtx {\n63\t    pub eval_ctx: EvalCoreCtx,\n64\t    pub d_intermediates: *mut EF,\n65\t    pub num_y: u32,\n66\t    pub d_eq_xi: *const EF,\n67\t    pub d_challenges: *const EF,\n68\t    pub d_eq_3bs: *const EF,\n69\t    pub d_rules: *const std::ffi::c_void,\n70\t    pub rules_len: usize,\n71\t    pub d_used_nodes: *const usize,\n72\t    pub d_pair_idxs: *const u32,\n73\t    pub used_nodes_len: usize,\n74\t    pub buffer_size: u32,\n75\t}\n76\t\n77\t/// Common per-AIR context for batched logup monomial evaluation.\n78\t#[repr(C)]\n79\t#[derive(Clone, Copy, Debug)]\n80\tpub struct LogupMonomialCommonCtx {\n81\t    pub eval_ctx: EvalCoreCtx,\n82\t    pub d_eq_xi: *const EF,\n83\t    pub bus_term_sum: EF, // Precomputed sum_i(beta[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n84\t    pub num_y: u32,\n85\t    pub mono_blocks: u32,\n86\t}\n87\t\n88\t/// Per-AIR context for batched logup monomial evaluation (numerator or denominator).\n89\t#[repr(C)]\n90\t#[derive(Clone, Copy, Debug)]\n91\tpub struct LogupMonomialCtx {\n92\t    pub d_headers: *const MonomialHeader,\n93\t    pub d_variables: *const PackedVar,\n94\t    pub d_combinations: *const EF,\n95\t    pub num_monomials: u32,\n96\t}\n97\t/// Descriptor for batched interpolation of columns across multiple traces.\n98\t#[repr(C)]\n99\t#[derive(Clone, Copy, Debug)]\n100\tpub struct InterpColDesc {\n101\t    pub output: *mut EF,\n102\t    pub columns_offset: u32,\n103\t    pub num_y: u32,\n104\t    pub num_columns: u32,\n105\t    pub total_threads: u32,\n106\t    pub block_start: u32,\n107\t}\n108\t\n109\tunsafe impl Send for InterpColDesc {}\n110\tunsafe impl Sync for InterpColDesc {}\n111\t\n112\t// end of types for batch MLE\n113\t\n114\textern \"C\" {\n115\t    // gkr.cu\n116\t    fn _frac_build_tree_layer(\n117\t        layer: *mut Frac<EF>,\n118\t        layer_size: usize,\n119\t        revert: bool,\n120\t        alpha: EF,\n121\t        apply_alpha: bool,\n122\t    ) -> i32;\n123\t\n124\t    /// Fused two-layer tree build. Applies layers i and i+1 in one kernel pass,\n125\t    /// keeping intermediate right-half nodes for revert operations.\n126\t    /// `half_i1` = N >> (i+2), where i is the first of the two layers.\n127\t    fn _frac_build_tree_two_layers(layer: *mut Frac<EF>, half_i1: usize) -> i32;\n128\t\n129\t    pub fn _frac_compute_round_temp_buffer_size(stride: u32) -> u32;\n130\t\n131\t    fn _frac_compute_round(\n132\t        eq_xi_low: *const EF,\n133\t        eq_xi_high: *const EF,\n134\t        pq_buffer: *const Frac<EF>,\n135\t        num_x: usize,\n136\t        eq_low_cap: usize,\n137\t        lambda: EF,\n138\t        out_device: *mut EF,\n139\t        tmp_block_sums: *mut EF,\n140\t    ) -> i32;\n141\t\n142\t    /// Fused compute round + tree layer revert. Combines frac_build_tree_layer(revert=true)\n143\t    /// with compute_round for the first inner round. Modifies layer in-place for revert.\n144\t    fn _frac_compute_round_and_revert(\n145\t        eq_xi_low: *const EF,\n146\t        eq_xi_high: *const EF,\n147\t        layer: *mut Frac<EF>,\n148\t        num_x: usize,\n149\t        eq_low_cap: usize,\n150\t        lambda: EF,\n151\t        out_device: *mut EF,\n152\t        tmp_block_sums: *mut EF,\n153\t    ) -> i32;\n154\t\n155\t    fn _frac_fold_fpext_columns(\n156\t        src: *const Frac<EF>,\n157\t        dst: *mut Frac<EF>,\n158\t        size: usize,\n159\t        r: EF,\n160\t    ) -> i32;\n161\t\n162\t    /// Fused compute round + fold (out-of-place). Reads from pre-fold src_pq_buffer (size\n163\t    /// src_pq_size), computes sumcheck sums, and writes folded output to dst_pq_buffer (size\n164\t    /// src_pq_size/2). IMPORTANT: src_pq_buffer and dst_pq_buffer must NOT alias.\n165\t    fn _frac_compute_round_and_fold(\n166\t        eq_xi_low: *const EF,\n167\t        eq_xi_high: *const EF,\n168\t        src_pq_buffer: *const Frac<EF>,\n169\t        dst_pq_buffer: *mut Frac<EF>,\n170\t        src_pq_size: usize,\n171\t        eq