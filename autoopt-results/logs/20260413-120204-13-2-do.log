+ x_int_in_block;","+","+    // Precompute values for this single coset","+    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);","+","+    uint32_t const log_height_total = __ffs(ctx.height) - 1;","+    uint32_t const log_segment = min(l_skip, log_height_total);","+    uint32_t const segment_size = 1u << log_segment;","+    uint32_t const log_stride = l_skip - log_segment;","+","+    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];","+    Fp const omega_skip_ntt =","+        (l_skip == 0) ? Fp::one() : device_ntt::get_twiddle(l_skip, ntt_idx);","+","+    // Compute for single coset: g^(coset_idx + 1)","+    Fp const g_coset = pow(ctx.g_shift, coset_idx + 1);","+    Fp const eval_point = g_coset * omega_skip_ntt;","+    Fp const omega = exp_power_of_2(eval_point, log_stride);","+    Fp const is_first_mult = avg_gp(omega, segment_size);","+    Fp const is_last_mult = avg_gp(omega * eta, segment_size);","+    Fp const omega_shift = pow(g_coset, ntt_idx_rev);","+","+    // Intermediate buffer setup (single coset, global only for batched)","+    Fp *inter_buffer;","+    uint32_t buffer_stride;","+    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD];","+    if constexpr (GLOBAL) {","+        // Thread index within this AIR: coset_idx * (num_x_blocks * block_x) + x_block_idx * block_x + threadIdx.x","+        uint32_t air_tidx = coset_idx * num_x_blocks * blockDim.x + x_block_idx * blockDim.x + threadIdx.x;","+        inter_buffer = ctx.d_intermediates + air_tidx;","+        buffer_stride = ctx.buffer_stride;","+    } else {","+        inter_buffer = local_buffer;","+        buffer_stride = 1;","+    }","+","+    FpExt sum = FpExt(Fp::zero());","+","+    NttEvalContext<1> eval_ctx{","+        ctx.preprocessed,","+        ctx.main_parts,","+        ctx.public_values,","+        inter_buffer,","+        ntt_buffer,","+        {omega_shift},","+        skip_domain,","+        ctx.height,","+        buffer_stride,","+        ctx.buffer_size,","+        ntt_idx,","+    };","+","+    // Single pass over x_int (no tiling needed — each block handles one x_block)","+    uint32_t x_int = x_int_base;","+    if (x_int < ctx.num_x) {","+        Fp is_first = is_first_mult * ctx.selectors_cube[x_int];","+        Fp is_last = is_last_mult * ctx.selectors_cube[2 * ctx.num_x + x_int];","+","+        FpExt constraint_sums[1];","+        acc_constraints<1, NEEDS_SHMEM>(","+            constraint_sums,","+            eval_ctx,","+            &is_first,","+            &is_last,","+            x_int,","+            ctx.lambda_pows,","+            ctx.d_rules,","+            ctx.rules_len,","+            ctx.d_used_nodes,","+            ctx.used_nodes_len,","+            ctx.lambda_len","+        );","+","+        sum = constraint_sums[0] * ctx.eq_cube[x_int];","+    }","+","+    // Single-coset reduction","+    Fp zerofier = exp_power_of_2(eval_point, l_skip) - Fp::one();","+    shared_sum[threadIdx.x] = sum * inv(zerofier);","+    __syncthreads();","+","+    if (threadIdx.x < skip_domain) {","+        FpExt tile_sum = shared_sum[threadIdx.x];","+        for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {","+            tile_sum += shared_sum[(lane << l_skip) + threadIdx.x];","+        }","+        // Output layout: [total_blocks][num_cosets * skip_domain]","+        tmp_sums_buffer[blockIdx.x * num_cosets * skip_domain + coset_idx * skip_domain + ntt_idx] =","+            tile_sum;","+    }","+}","+","+template <bool GLOBAL, bool NEEDS_SHMEM>","+int launch_batched_zerocheck_r0(","+    FpExt *tmp_sums_buffer,","+    FpExt *output,","+    const Round0BlockCtx *d_block_ctxs,","+    const Round0ZcCtx *d_zc_ctxs,","+    const uint32_t *d_air_offsets,","+    uint32_t total_blocks,","+    uint32_t num_airs,","+    uint32_t num_cosets,","+    uint32_t skip_domain,","+    uint32_t block_x","+) {","+    if (total_blocks == 0) return 0;","+","+    dim3 grid(total_blocks);","+    dim3 block(block_x);","+","+    size_t shared_sum_size = sizeo