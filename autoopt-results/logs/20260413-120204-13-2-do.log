{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LBkiBatjsNc99Wnovik2eC","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    sync::Arc,\n15\t};\n16\t\n17\tuse itertools::{izip, Itertools};\n18\tuse openvm_cuda_common::{\n19\t    copy::{MemCopyD2H, MemCopyD2HStreamSync, MemCopyH2D},\n20\t    d_buffer::DeviceBuffer,\n21\t    error::MemCopyError,\n22\t    memory_manager::MemTracker,\n23\t    stream::current_stream_sync,\n24\t};\n25\tuse openvm_stark_backend::{\n26\t    air_builders::symbolic::SymbolicConstraints,\n27\t    calculate_n_logup,\n28\t    dft::Radix2BowersSerial,\n29\t    p3_matrix::dense::RowMajorMatrix,\n30\t    poly_common::{\n31\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n32\t        UnivariatePoly,\n33\t    },\n34\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n35\t    prover::{\n36\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n37\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n38\t        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n39\t    },\n40\t};\n41\tuse p3_dft::TwoAdicSubgroupDft;\n42\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n43\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n44\tuse rustc_hash::FxHashMap;\n45\tuse tracing::{debug, info, info_span, instrument};\n46\t\n47\tuse crate::{\n48\t    base::DeviceMatrix,\n49\t    cuda::{\n50\t        logup_zerocheck::{\n51\t            batched_interpolate_columns_gpu, fold_selectors_round0, InterpColDesc, MainMatrixPtrs,\n52\t        },\n53\t        sumcheck::batch_fold_mle,\n54\t    },\n55\t    data_transporter::transport_matrix_d2h_col_major,\n56\t    error::LogupZerocheckError,\n57\t    gpu_backend::GenericGpuBackend,\n58\t    hash_scheme::GpuHashScheme,\n59\t    logup_zerocheck::{\n60\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n61\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n62\t    },\n63\t    poly::EqEvalLayers,\n64\t    prelude::{EF, F},\n65\t    sponge::GpuFiatShamirTranscript,\n66\t    utils::compute_barycentric_inv_lagrange_denoms,\n67\t};\n68\t\n69\tpub(crate) mod batch_mle;\n70\tpub(crate) mod batch_mle_monomial;\n71\tmod errors;\n72\tpub(crate) mod fold_ple;\n73\t/// Fraction sumcheck via GKR\n74\tmod fractional;\n75\t/// Logup interaction evaluations for GKR input\n76\tmod gkr_input;\n77\tmod mle_round;\n78\tmod round0;\n79\tpub(crate) mod rules;\n80\t\n81\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n82\tuse batch_mle_monomial::{\n83\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n84\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n85\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n86\t};\n87\tpub use errors::*;\n88\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n89\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n90\tuse round0::evaluate_round0_constraints_gpu;\n91\t\n92\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n93\t/// More threads = more concurrent kernels but more peak GPU memory and more\n94\t/// MemoryManager mutex contention. 8 provides good SM utilization on the RTX 4090.\n95\tconst NUM_ROUND0_STREAMS: usize = 8;\n96\t\n97\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n98\t/// instead of the monomial kernel for high num_y traces.\n99\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n100\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n101\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n102\t\n103\t#[inline]\n104\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n105\t    if need_rot {\n106\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n107\t        (mat_width / 2) as u32\n108\t    } else {\n109\t        mat_width as u32\n110\t    }\n111\t}\n112\t\n113\t/// Result of processing one AIR in Round 0.\n114\tstruct Round0AirResult {\n115\t    trace_idx: usize,\n116\t    zerocheck_poly: Option<UnivariatePoly<EF>>,\n117\t    logup_numer_poly: Option<UnivariatePoly<EF>>,\n118\t    logup_denom_poly: Option<UnivariatePoly<EF>>,\n119\t}\n120\t"}]},"parent_tool_use_id":"toolu_01FMWmxH7Y9afcepS6uJgEHz","session_id":"3eab5b9b-40e0-4e43-bd71-fd448feabe6e","uuid":"a35688f9-adf8-4f07-9802-2c25515e9c9d","timestamp":"2026-04-13T13:12:26.461Z"}
