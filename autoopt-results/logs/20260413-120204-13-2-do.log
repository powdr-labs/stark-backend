small (batched path).\n        let per_thread_temp_bytes = self.memory_limit_bytes / NUM_ROUND0_STREAMS.max(1);\n        let skip_domain = 1u32 << l_skip;\n        let coset_parallel_threshold: u32 = 32768;\n\n        let mut large_work_items: Vec<Round0AirWorkItem<HS>> = Vec::new();\n        let mut small_trace_idxs: Vec<usize> = Vec::new();\n        for (trace_idx, ((air_idx, air_ctx), &n, sel, pv, eq3b)) in izip!(\n            &ctx.per_trace,\n            &self.n_per_trace,\n            &selectors_base,\n            &self.public_values_per_trace,\n            &self.eq_3b_per_trace,\n        )\n        .enumerate()\n        {\n            let n_lift = n.max(0) as usize;\n            let num_x = 1u32 << n_lift;\n            if num_x * skip_domain >= coset_parallel_threshold {\n                large_work_items.push(Round0AirWorkItem {\n                    trace_idx,\n                    single_pk: &self.pk.per_air[*air_idx],\n                    n,\n                    selectors_cube: sel,\n                    public_values: pv,\n                    eq_3bs: eq3b,\n                    cached_mains: &air_ctx.cached_mains,\n                    common_main: &air_ctx.common_main,\n                    eq_xis: &self.eq_xis,\n                    d_lambda_pows,\n                    beta_pows: &self.beta_pows,\n                    l_skip,\n                    constraint_degree: self.constraint_degree,\n                    xi: &self.xi,\n                    max_temp_bytes: per_thread_temp_bytes,\n                });\n            } else {\n                small_trace_idxs.push(trace_idx);\n            }\n        }\n\n        // Sort large AIRs by descending height for load balance.\n        large_work_items.sort_by(|a, b| b.common_main.height().cmp(&a.common_main.height()));\n\n        // Barrier: ensure all prior GPU work is visible to worker thread streams.\n        current_stream_sync().map_err(MemCopyError::from)?;\n\n        // Phase 2a: Process large AIRs via existing multi-threaded per-AIR path.\n        let num_threads = if large_work_items.len() >= 100 {\n            NUM_ROUND0_STREAMS.min(large_work_items.len())\n        } else {\n            1\n        };\n        let results: Vec<Round0AirResult> = if num_threads <= 1 {\n            large_work_items\n                .iter()\n                .map(|w| process_air_round0(w))\n                .collect::<Result<Vec<_>, _>>()?\n        } else {\n            let chunk_size = large_work_items.len().div_ceil(num_threads);\n            std::thread::scope(|s| {\n                let handles: Vec<_> = large_work_items\n                    .chunks(chunk_size)\n                    .map(|chunk| {\n                        s.spawn(move || -> Result<Vec<Round0AirResult>, LogupZerocheckError> {\n                            chunk.iter().map(|w| process_air_round0(w)).collect()\n                        })\n                    })\n                    .collect();\n                let mut all_results = Vec::with_capacity(large_work_items.len());\n                for handle in handles {\n                    all_results.extend(handle.join().unwrap()?);\n                }\n                Ok::<_, LogupZerocheckError>(all_results)\n            })?\n        };\n        for result in results {\n            if let Some(poly) = result.zerocheck_poly {\n                batch_sp_poly[2 * num_present_airs + result.trace_idx] = poly;\n            }\n            if let Some(poly) = result.logup_numer_poly {\n                batch_sp_poly[2 * result.trace_idx] = poly;\n            }\n            if let Some(poly) = result.logup_denom_poly {\n                batch_sp_poly[2 * result.trace_idx + 1] = poly;\n            }\n        }\n\n        // Phase 2b: Process small AIRs via batched kernels.\n        // This path processes small AIRs that use coset-parallel mode.\n        if !small_trace_idxs.is_empty() {\n            use crate::logup_zerocheck::round0::{\n                build_logup_rules_for_air, evaluate_batched_logup_group,\n                evaluate_batched_zerocheck_group, BatchedR0AirDesc,\n            };\n\n            let mut d_main_parts_keepalive = Vec::new();\n            let mut descs: Vec<BatchedR0AirDesc> = Vec::new();\n\n            let per_trace_vec: Vec<_> = ctx.per_trace.iter().collect();\n            for &trace_idx in &small_trace_idxs {\n                let (air_idx, air_ctx) = &per_trace_vec[trace_idx];\n                let n = self.n_per_trace[trace_idx];\n                let sel = &selectors_base[trace_idx];\n                let pv = &self.public_values_per_trace[trace_idx];\n                let eq3b = &self.eq_3b_per_trace[trace_idx];\n                let single_pk = &self.pk.per_air[*air_idx];\n                let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n                let height = air_ctx.common_main.height();\n                let n_lift = n.max(0) as usize;\n                let num_x = 1u32 << n_lift;\n\n                let mut main_parts = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n                for committed in &air_ctx.cached_mains {\n                    main_parts.push(committed.trace.buffer().as_ptr());\n                }\n                main_parts.push(air_ctx.common_main.buffer().as_ptr());\n                let d_main_parts = main_parts.to_device()?;\n\n                let log_large_domain = log2_ceil_usize(local_constraint_deg << l_skip);\n                let omega_root = F::two_adic_generator(log_large_domain);\n                let eq_xi_tree = &self.eq_xis[&n_lift];\n\n                let num_cosets_zc = local_constraint_deg.saturating_sub(1) as u32;\n                let num_cosets_logup = local_constraint_deg as u32;\n\n                let preprocessed_ptr = single_pk\n                    .preprocessed_data\n                    .as_ref()\n                    .map(|cd| cd.trace.buffer().as_ptr())\n                    .unwrap_or(std::ptr::null());\n\n                let zc_rules = &single_pk.other_data.zerocheck_round0;\n                let constraints_dag = &single_pk.vk.symbolic_constraints;\n                let has_constraints = !constraints_dag.constraints.constraint_idx.is_empty()\n                    && num_cosets_zc > 0;\n\n                let single_air_constraints =\n                    SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n                let logup_rules = build_logup_rules_for_air(\n                    single_pk,\n                    &single_air_constraints,\n                    &self.beta_pows,\n                    eq3b,\n                )?;\n\n                descs.push(BatchedR0AirDesc {\n                    trace_idx,\n                    num_x,\n                    height: height as u32,\n                    g_shift: omega_root,\n                    buffer_size_zc: if has_constraints {\n                        zc_rules.inner.buffer_size\n                    } else {\n                        0\n                    },\n                    buffer_size_logup: logup_rules\n                        .as_ref()\n                        .map(|r| r.buffer_size)\n                        .unwrap_or(0),\n                    num_cosets_zc,\n                    num_cosets_logup,\n                    selectors_cube: sel.buffer().as_ptr(),\n                    preprocessed: preprocessed_ptr,\n                    d_main_parts: d_main_parts.as_ptr(),\n                    eq_cube: eq_xi_tree.get_ptr(n_lift),\n                    lambda_pows: d_lambda_pows.as_ptr(),\n                    public_values: pv.as_ptr(),\n                    d_zc_rules: if has_constraints {\n                        zc_rules.inner.d_rules.as_raw_ptr() as *const std::ffi::c_void\n                    } else {\n                        std::ptr::null()\n                    },\n                    d_zc_used_nodes: if has_constraints {\n                        zc_rules.inner.d_used_nodes.as_ptr()\n                    } else {\n                        std::ptr::null()\n                    },\n                    zc_rules_len: if has_constraints {\n                        zc_rules.inner.d_rules.len()\n                    } else {\n                        0\n                    },\n                    zc_used_nodes_len: if has_constraints {\n                        zc_rules.inner.d_used_nodes.len()\n                    } else {\n                        0\n                    },\n                    lambda_len: d_lambda_pows.len(),\n                    logup_rules,\n                });\n                d_main_parts_keepalive.push(d_main_parts);\n            }\n\n            info!(\n                \"Round0: {} large AIRs (per-AIR), {} small AIRs (batched)\",\n                large_work_items.len(),\n                descs.len()\n            );\n\n            // Batched zerocheck groups\n            {\n                let mut zc_groups: std::collections::BTreeMap<u32, Vec<usize>> =\n                    std::collections::BTreeMap::new();\n                for (i, d) in descs.iter().enumerate() {\n                    if d.zc_rules_len > 0 && d.num_cosets_zc > 0 {\n                        zc_groups.entry(d.num_cosets_zc).or_default().push(i);\n                    }\n                }\n                for (num_cosets, indices) in &zc_groups {\n                    let group_descs: Vec<&BatchedR0AirDesc> =\n                        indices.iter().map(|&i| &descs[i]).collect();\n                    let output =\n                        evaluate_batched_zerocheck_group(&group_descs, *num_cosets, skip_domain)?;\n                    if output.is_empty() {\n                        continue;\n                    }\n                    let output_h = output.to_host_on_current_stream()?;\n                    let d = *num_cosets as usize * skip_domain as usize;\n                    for (group_idx, &desc_idx) in indices.iter().enumerate() {\n                        let desc = &descs[desc_idx];\n                        let local_constraint_deg = desc.num_cosets_zc as usize + 1;\n                        let num_cosets_zc = desc.num_cosets_zc as usize;\n                        let q_evals = &output_h[group_idx * d..(group_idx + 1) * d];\n                        let mut values = EF::zero_vec(num_cosets_zc << l_skip);\n                        for coset_idx in 0..num_cosets_zc {\n                            for i in 0..1 << l_skip {\n                                values[i * num_cosets_zc + coset_idx] =\n                                    q_evals[(coset_idx << l_skip) + i];\n                            }\n                        }\n                        let log_ld = log2_ceil_usize(local_constraint_deg << l_skip);\n                        let omega_root = F::two_adic_generator(log_ld);\n                        let q = UnivariatePoly::from_geometric_cosets_evals_idft(\n                            RowMajorMatrix::new(values, num_cosets_zc),\n                            omega_root,\n                            omega_root,\n                        );\n                        let sp_0_deg = sumcheck_round0_deg(l_skip, local_constraint_deg);\n                        let coeffs = (0..=sp_0_deg)\n                            .map(|i| {\n                                let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n                                if i >= 1 << l_skip {\n                                    c += q.coeffs()[i - (1 << l_skip)];\n                                }\n                                c\n                            })\n                            .collect_vec();\n                        batch_sp_poly[2 * num_present_airs + desc.trace_idx] =\n                            UnivariatePoly::new(coeffs);\n                    }\n                }\n            }\n\n            // Batched logup groups\n            {\n                let mut logup_groups: std::collections::BTreeMap<u32, Vec<usize>> =\n                    std::collections::BTreeMap::new();\n                for (i, d) in descs.iter().enumerate() {\n                    if d.logup_rules.is_some() && d.num_cosets_logup > 0 {\n                        logup_groups\n                            .entry(d.num_cosets_logup)\n                            .or_default()\n                            .push(i);\n                    }\n                }\n                for (num_cosets, indices) in &logup_groups {\n                    let group_descs: Vec<&BatchedR0AirDesc> =\n                        indices.iter().map(|&i| &descs[i]).collect();\n                    let output =\n                        evaluate_batched_logup_group(&group_descs, *num_cosets, skip_domain)?;\n                    if output.is_empty() {\n                        continue;\n                    }\n                    let output_h = output.to_host_on_current_stream()?;\n                    let d = *num_cosets as usize * skip_domain as usize;\n                    for (group_idx, &desc_idx) in indices.iter().enumerate() {\n                        let desc = &descs[desc_idx];\n                        let n = self.n_per_trace[desc.trace_idx];\n                        let num_cosets_logup = desc.num_cosets_logup as usize;\n                        let evals = &output_h[group_idx * d..(group_idx + 1) * d];\n                        let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n                            evals.iter().map(|frac| (frac.p, frac.q)).unzip();\n                        if n.is_negative() {\n                            let norm_factor = F::from_u32(1 << n.unsigned_abs()).inverse();\n                            for s in &mut numer {\n                                *s *= norm_factor;\n                            }\n                        }\n                        let mut numer_values = EF::zero_vec(num_cosets_logup << l_skip);\n                        let mut denom_values = EF::zero_vec(num_cosets_logup << l_skip);\n                        for coset_idx in 0..num_cosets_logup {\n                            for i in 0..1 << l_skip {\n                                let src = (coset_idx << l_skip) + i;\n                                let dst = i * num_cosets_logup + coset_idx;\n                                numer_values[dst] = numer[src];\n                                denom_values[dst] = denom[src];\n                            }\n                        }\n                        let log_ld = log2_ceil_usize(num_cosets_logup << l_skip);\n                        let omega_root = F::two_adic_generator(log_ld);\n                        let numer_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n                            RowMajorMatrix::new(numer_values, num_cosets_logup),\n                            omega_root,\n                            F::ONE,\n                        );\n                        let denom_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n                            RowMajorMatrix::new(denom_values, num_cosets_logup),\n                            omega_root,\n                            F::ONE,\n                        );\n                        batch_sp_poly[2 * desc.trace_idx] = numer_poly;\n                        batch_sp_poly[2 * desc.trace_idx + 1] = denom_poly;\n                    }\n                }\n            }\n            // Drop keepalive buffers\n            drop(d_main_parts_keepalive);\n            drop(descs);\n        }"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1801,"cache_read_input_tokens":200011,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1801},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"3eab5b9b-40e0-4e43-bd71-fd448feabe6e","uuid":"c6ddbeb0-7f34-4043-8d1e-bc9d0091e8fe"}
