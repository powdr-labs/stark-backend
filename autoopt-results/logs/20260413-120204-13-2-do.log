{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017zP8oYzBerkiUx8MXJER3B","type":"tool_result","content":"1\t#include \"codec.cuh\"\n2\t#include \"dag_entry.cuh\"\n3\t#include \"eval_config.cuh\"\n4\t#include \"fp.h\"\n5\t#include \"fpext.h\"\n6\t#include \"frac_ext.cuh\"\n7\t#include \"launcher.cuh\"\n8\t#include \"sumcheck.cuh\"\n9\t#include \"utils.cuh\"\n10\t#include <algorithm>\n11\t#include <cmath>\n12\t#include <cstddef>\n13\t#include <cstdint>\n14\t#include <utility>\n15\t#include <vector_types.h>\n16\t\n17\tusing namespace symbolic_dag;\n18\t\n19\tnamespace logup_round0 {\n20\t\n21\t// NOTE[jpw]: keeping separate from zerocheck so it can be tuned separately\n22\tconstexpr uint32_t BUFFER_THRESHOLD = 16;\n23\t// Threshold for switching between coset-parallel and lockstep modes.\n24\t// When num_x * skip_domain < threshold, use coset-parallel (grid.y = num_cosets) for better GPU utilization.\n25\t// When >= threshold, use lockstep (single thread handles all cosets) to avoid redundant iNTT.\n26\tconstexpr uint32_t COSET_PARALLEL_THRESHOLD = 32768; // 2^15\n27\t\n28\t// Device function to evaluate interactions for all cosets in lockstep with DAG traversal.\n29\t// Computes numerator and denominator sums for each coset.\n30\t// NOTE: Using __inline__ instead of __forceinline__ to let compiler decide based on register pressure.\n31\t//\n32\t// Template params:\n33\t// - FIRST_COSET_IS_IDENTITY: compile-time flag for lockstep kernel when coset 0 has shift=1\n34\t// Runtime params:\n35\t// - skip_ntt: runtime flag for coset-parallel kernel when processing identity coset\n36\ttemplate <uint32_t NUM_COSETS, bool NEEDS_SHMEM, bool FIRST_COSET_IS_IDENTITY = false>\n37\t__device__ __inline__ void acc_interactions(\n38\t    const NttEvalContext<NUM_COSETS> &eval_ctx,\n39\t    const Fp *is_first, // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n40\t    const Fp *is_last,  // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n41\t    uint32_t x_int,\n42\t    const FpExt *__restrict__ numer_weights,\n43\t    const FpExt *__restrict__ denom_weights,\n44\t    const Rule *__restrict__ d_rules,\n45\t    size_t rules_len,\n46\t    FpExt *__restrict__ numer_sums, // output [NUM_COSETS]\n47\t    FpExt *__restrict__ denom_sums, // output [NUM_COSETS]\n48\t    bool skip_ntt = false           // Runtime flag for identity coset\n49\t) {\n50\t    // Initialize sums to zero\n51\t#pragma unroll\n52\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n53\t        numer_sums[c] = FpExt(Fp::zero());\n54\t        denom_sums[c] = FpExt(Fp::zero());\n55\t    }\n56\t\n57\t    for (size_t node = 0; node < rules_len; ++node) {\n58\t        Rule rule = d_rules[node];\n59\t        // Lazy decoding: only decode header (op, flags, x) upfront\n60\t        RuleHeader header = decode_rule_header(rule);\n61\t\n62\t        // Evaluate x operand for all cosets\n63\t        Fp x_vals[NUM_COSETS];\n64\t        ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n65\t            x_vals, header.x, eval_ctx, is_first, is_last, x_int, skip_ntt\n66\t        );\n67\t\n68\t        Fp results[NUM_COSETS];\n69\t\n70\t        switch (header.op) {\n71\t        case OP_ADD: {\n72\t            // Decode y only for binary ops\n73\t            SourceInfo y_src = decode_y(rule);\n74\t            Fp y_vals[NUM_COSETS];\n75\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n76\t                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n77\t            );\n78\t#pragma unroll\n79\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n80\t                results[c] = x_vals[c] + y_vals[c];\n81\t            }\n82\t            break;\n83\t        }\n84\t        case OP_SUB: {\n85\t            SourceInfo y_src = decode_y(rule);\n86\t            Fp y_vals[NUM_COSETS];\n87\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n88\t                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n89\t            );\n90\t#pragma unroll\n91\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n92\t                results[c] = x_vals[c] - y_vals[c];\n93\t            }\n94\t            break;\n95\t        }\n96\t        case OP_MUL: {\n97\t            SourceInfo y_src = decode_y(rule);\n98\t            Fp y_vals[NUM_COSETS];\n99\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n100\t                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n101\t            );\n102\t#pragma unroll\n103\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n104\t                results[c] = x_vals[c] * y_vals[c];\n105\t            }\n106\t            break;\n107\t        }\n108\t        case OP_NEG:\n109\t#pragma unroll\n110\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n111\t                results[c] = -x_vals[c];\n112\t            }\n113\t            break;\n114\t        case OP_VAR:\n115\t#pragma unroll\n116\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n117\t                results[c] = x_vals[c];\n118\t            }\n119\t            break;\n120\t        case OP_INV:\n121\t#pragma unroll\n122\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n123\t                results[c] = inv(x_vals[c]);\n124\t            }\n125\t            break;\n126\t        }\n127\t\n128\t        // Store intermediate results for all cosets\n129\t        // Decode z_index only when buffering\n130\t        if (header.buffer_result && eval_ctx.buffer_size > 0) {\n131\t            uint32_t z_index = decode_z_index(rule);\n132\t#ifdef CUDA_DEBUG\n133\t            assert(z_index < eval_ctx.buffer_size);\n134\t#endif\n135\t            // Intermediate buffer layout: [buffer_size][NUM_COSETS] per thread\n136\t#pragma unroll\n137\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n138\t                eval_ctx.inter_buffer[z_index * eval_ctx.buffer_stride + c] = results[c];\n139\t            }\n140\t        }\n141\t\n142\t        // Accumulate interaction sums\n143\t        if (header.is_constraint) {\n144\t            FpExt numer_w = numer_weights[node];\n145\t            FpExt denom_w = denom_weights[node];\n146\t#pragma unroll\n147\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n148\t                numer_sums[c] += numer_w * results[c];\n149\t                denom_sums[c] += denom_w * results[c];\n150\t            }\n151\t        }\n152\t    }\n153\t}\n154\t\n155\t// ============================================================================\n156\t// KERNELS\n157\t// ============================================================================\n158\t\n159\t// Round0 phase interactions kernel - each thread handles ALL cosets in lockstep\n160\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n161\t__global__ void logup_r0_ntt_eval_interactions_kernel(\n162\t    FracExt *__restrict__ tmp_sums_buffer, // [NUM_COSETS][gridDim.x][skip_domain]\n163\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n164\t    const Fp *__restrict__ preprocessed,\n165\t    const Fp *const *__restrict__ main_parts,\n166\t    const FpExt *__restrict__ eq_cube, // [num_x]\n167\t    const Fp *__restrict__ public_values,\n168\t    const FpExt *__restrict__ numer_weights,\n169\t    const FpExt *__restrict__ denom_weights,\n170\t    FpExt denom_sum_init,\n171\t    const Rule *__restrict__ d_rules,\n172\t    size_t rules_len,\n173\t    uint32_t buffer_size,\n174\t    Fp *__restrict__ d_intermediates,\n175\t    uint32_t skip_domain,\n176\t    uint32_t num_x,\n177\t    uint32_t height,\n178\t    Fp g_shift\n179\t) {\n180\t    extern __shared__ char smem[];\n181\t    // Shared memory layout:\n182\t    // - FracExt[blockDim.x]: shared_sum for reduction (reused per coset)\n183\t    // - Fp[blockDim.x]: ntt_buffers (one skip_domain-sized buffer per x_int group, only when NEEDS_SHMEM)\n184\t    FracExt *shared_sum = reinterpret_cast<FracExt *>(smem);\n185\t    Fp *ntt_buffers_base =\n186\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FracExt)) : nullptr;\n187\t\n188\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n189\t\n190\t    // Each x_int group within the block gets its own ntt_buffer slice\n191\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n192\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n193\t\n194\t    // Thread layout: ntt_idx varies fastest, then x_int\n195\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n196\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n197\t    uint32_t const x_int_base = tidx >> l_skip;\n198\t\n199\t    // Precompute values needed for all cosets\n200\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n201\t    Fp const omega_skip = TWO_ADIC_GENERATORS[l_skip];\n202\t\n203\t    // Compute is_first_mult, is_last_mult for all cosets\n204\t    uint32_t const log_height_total = __ffs(height) - 1;\n205\t    uint32_t const log_segment = min(l_skip, log_height_total);\n206\t    uint32_t const segment_size = 1u << log_segment;\n207\t    uint32_t const log_stride = l_skip - log_segment;\n208\t\n209\t    Fp is_first_mult[NUM_COSETS];\n210\t    Fp is_last_mult[NUM_COSETS];\n211\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n212\t    Fp const omega_skip_ntt = pow(omega_skip, ntt_idx);\n213\t\n214\t    // Cosets c=0..NUM_COSETS-1 with shifts 1,g^1, g^2, ...\n215\t    Fp g_coset = Fp::one();\n216\t#pragma unroll\n217\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n218\t        Fp eval_point = g_coset * omega_skip_ntt;\n219\t        Fp omega = exp_power_of_2(eval_point, log_stride);\n220\t        is_first_mult[c] = avg_gp(omega, segment_size);\n221\t        is_last_mult[c] = avg_gp(omega * eta, segment_size);\n222\t        g_coset *= g_shift; // g^(c+1) for next iteration\n223\t    }\n224\t\n225\t    // Intermediate buffer setup\n226\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD * NUM_COSETS];\n227\t    Fp *inter_buffer;\n228\t    uint32_t buffer_stride;\n229\t    if constexpr (GLOBAL) {\n230\t        // Layout: [buffer_size][num_threads][NUM_COSETS]\n231\t        inter_buffer = d_intermediates + tidx * NUM_COSETS;\n232\t        buffer_stride = gridDim.x * blockDim.x * NUM_COSETS;\n233\t    } else {\n234\t        inter_buffer = local_buffer;\n235\t        buffer_stride = NUM_COSETS;\n236\t    }\n237\t\n238\t    // Accumulate sums for all cosets\n239\t    FracExt sums[NUM_COSETS];\n240\t#pragma unroll\n241\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n242\t        sums[c] = {FpExt(Fp::zero()), FpExt(Fp::zero())};\n243\t    }\n244\t\n245\t    // blockDim.x is guaranteed to be a multiple of 2^l_skip\n246\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n247\t\n248\t    // Initialize eval_ctx once with loop-invariant fields\n249\t    NttEvalContext<NUM_COSETS> eval_ctx{\n250\t        preprocessed,\n251\t        main_parts,\n252\t        public_values,\n253\t        inter_buffer,\n254\t        ntt_buffer,\n255\t        {}, // omega_shifts - set once below\n256\t        skip_domain,\n257\t        height,\n258\t        buffer_stride,\n259\t        buffer_size,\n260\t        ntt_idx,\n261\t    };\n262\t    // Compute omega_shifts: coset 0 has identity shift, rest use g^c\n263\t    eval_ctx.omega_shifts[0] = Fp::one(); // Identity coset\n264\t    g_coset = g_shift;                    // g^1\n265\t#pragma unroll\n266\t    for (uint32_t c = 1; c < NUM_COSETS; c++) {\n267\t        eval_ctx.omega_shifts[c] = pow(g_coset, ntt_idx_rev);\n268\t        g_coset *= g_shift;\n269\t    }\n270\t\n271\t    // Tile across x_int\n272\t    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n273\t        // Compute per-iteration selectors as fresh local values\n274\t        Fp is_first[NUM_COSETS];\n275\t        Fp is_last[NUM_COSETS];\n276\t#pragma unroll\n277\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n278\t            is_first[c] = is_first_mult[c] * selectors_cube[x_int];\n279\t            is_last[c] = is_last_mult[c] * selectors_cube[2 * num_x + x_int];\n280\t        }\n281\t\n282\t        FpExt numer_results[NUM_COSETS];\n283\t        FpExt denom_results[NUM_COSETS];\n284\t        acc_interactions<NUM_COSETS, NEEDS_SHMEM, /*FIRST_COSET_IS_IDENTITY=*/true>(\n285\t            eval_ctx, is_first, is_last, x_int,\n286\t            numer_weights, denom_weights, d_rules, rules_len, numer_results, denom_results\n287\t        );\n288\t\n289\t        FpExt eq = eq_cube[x_int];\n290\t#pragma unroll\n291\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n292\t            sums[c].p += eq * numer_results[c];\n293\t            sums[c].q += eq * (denom_results[c] + denom_sum_init);\n294\t        }\n295\t    }\n296\t\n297\t    // Reduction: one coset at a time to minimize shared memory\n298\t#pragma unroll\n299\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n300\t        shared_sum[threadIdx.x] = sums[c];\n301\t        __syncthreads();\n302\t\n303\t        if (threadIdx.x < skip_domain) {\n304\t            FracExt tile_sum = shared_sum[threadIdx.x];\n305\t            for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n306\t                auto lane_offset = (lane << l_skip) + threadIdx.x;\n307\t                tile_sum.p += shared_sum[lane_offset].p;\n308\t                tile_sum.q += shared_sum[lane_offset].q;\n309\t            }\n310\t            // Output layout: [num_blocks][NUM_COSETS * skip_domain]\n311\t            // This matches final_reduce_block_sums expected [num_blocks][d] layout\n312\t            tmp_sums_buffer[blockIdx.x * NUM_COSETS * skip_domain + c * skip_domain + ntt_idx] =\n313\t                tile_sum;\n314\t        }\n315\t        __syncthreads();\n316\t    }\n317\t}\n318\t\n319\t// Coset-parallel kernel: grid.y = num_cosets, each block handles ONE coset.\n320\t// Uses acc_interactions<1, NEEDS_SHMEM> with explicit parameter passing.\n321\t// Use when num_x * skip_domain is small for better GPU utilization.\n322\ttemplate <bool GLOBAL, bool NEEDS_SHMEM>\n323\t__global__ void logup_r0_ntt_eval_interactions_coset_parallel_kernel(\n324\t    FracExt *__restrict__ tmp_sums_buffer, // [num_blocks][num_cosets * skip_domain]\n325\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n326\t    const Fp *__restrict__ preprocessed,\n327\t    const Fp *const *__restrict__ main_parts,\n328\t    const FpExt *__restrict__ eq_cube, // [num_x]\n329\t    const Fp *__restrict__ public_values,\n330\t    const FpExt *__restrict__ numer_weights,\n331\t    const FpExt *__restrict__ denom_weights,\n332\t    FpExt denom_sum_init,\n333\t    const Rule *__restrict__ d_rules,\n334\t    size_t rules_len,\n335\t    uint32_t buffer_size,\n336\t    Fp *__restrict__ d_intermediates,\n337\t    uint32_t skip_domain,\n338\t    uint32_t num_x,\n339\t    uint32_t height,\n340\t    Fp g_shift\n341\t) {\n342\t    extern __shared__ char smem[];\n343\t    FracExt *shared_sum = reinterpret_cast<FracExt *>(smem);\n344\t    Fp *ntt_buffers_base =\n345\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FracExt)) : nullptr;\n346\t\n347\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n348\t    uint32_t const num_cosets = gridDim.y;\n349\t\n350\t    // Each x_int group within the block gets its own ntt_buffer slice\n351\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n352\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n353\t\n354\t    // Thread layout: ntt_idx varies fastest, then x_int\n355\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n356\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n357\t    uint32_t const x_int_base = tidx >> l_skip;\n358\t\n359\t    // KEY DIFFERENCE: coset_idx from blockIdx.y\n360\t    uint32_t const coset_idx = blockIdx.y;\n361\t    bool const is_identity_coset = (coset_idx == 0);\n362\t\n363\t    // Precompute values for this single coset\n364\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n365\t    Fp const omega_skip = TWO_ADIC_GENERATORS[l_skip];\n366\t\n367\t    uint32_t const log_height_total = __ffs(height) - 1;\n368\t    uint32_t const log_segment = min(l_skip, log_height_total);\n369\t    uint32_t const segment_size = 1u << log_segment;\n370\t    uint32_t const log_stride = l_skip - log_segment;\n371\t\n372\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n373\t    Fp const omega_skip_ntt = pow(omega_skip, ntt_idx);\n374\t\n375\t    // Compute for single coset: coset 0 has shift=1, rest have shift=g^coset_idx\n376\t    Fp const g_coset = is_identity_coset ? Fp::one() : pow(g_shift, coset_idx);\n377\t    Fp const eval_point = is_identity_coset ? omega_skip_ntt : (g_coset * omega_skip_ntt);\n378\t    Fp const omega = exp_power_of_2(eval_point, log_stride);\n379\t    Fp const is_first_mult = avg_gp(omega, segment_size);\n380\t    Fp const is_last_mult = avg_gp(omega * eta, segment_size);\n381\t    Fp const omega_shift = is_identity_coset ? Fp::one() : pow(g_coset, ntt_idx_rev);\n382\t\n383\t    // Intermediate buffer setup (single coset, no NUM_COSETS multiplier)\n384\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD];\n385\t    Fp *inter_buffer;\n386\t    uint32_t buffer_stride;\n387\t    if constexpr (GLOBAL) {\n388\t        // Layout: [buffer_size][num_cosets * num_threads_per_coset]\n389\t        uint32_t global_tidx = coset_idx * gridDim.x * blockDim.x + tidx;\n390\t        inter_buffer = d_intermediates + global_tidx;\n391\t        buffer_stride = gridDim.x * gridDim.y * blockDim.x;\n392\t    } else {\n393\t        inter_buffer = local_buffer;\n394\t        buffer_stride = 1;\n395\t    }\n396\t\n397\t    FracExt sum = {FpExt(Fp::zero()), FpExt(Fp::zero())};\n398\t\n399\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n400\t\n401\t    // Single-coset context (NUM_COSETS=1), loop-invariant fields only\n402\t    NttEvalContext<1> eval_ctx{\n403\t        preprocessed,\n404\t        main_parts,\n405\t        public_values,\n406\t        inter_buffer,\n407\t        ntt_buffer,\n408\t        {omega_shift}, // omega_shifts[1]\n409\t        skip_domain,\n410\t        height,\n411\t        buffer_stride,\n412\t        buffer_size,\n413\t        ntt_idx,\n414\t    };\n415\t\n416\t    // Main loop - reuses acc_interactions<1, NEEDS_SHMEM>\n417\t    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n418\t        Fp is_first = is_first_mult * selectors_cube[x_int];\n419\t        Fp is_last = is_last_mult * selectors_cube[2 * num_x + x_int];\n420\t\n421\t        FpExt numer_results[1];\n422\t        FpExt denom_results[1];\n423\t        // We use this device function to handle a single coset so NUM_COSETS = 1 and FIRST_COSET_IS_IDENTITY = false.\n424\t        // The actual `coset_idx = 0` skip is handled by the `is_identity_coset` flag.\n425\t        acc_interactions</*NUM_COSETS=*/1, NEEDS_SHMEM, /*FIRST_COSET_IS_IDENTITY=*/false>(\n426\t            eval_ctx,\n427\t            &is_first,\n428\t            &is_last,\n429\t            x_int,\n430\t            numer_weights,\n431\t            denom_weights,\n432\t            d_rules,\n433\t            rules_len,\n434\t            numer_results,\n435\t            denom_results,\n436\t            is_identity_coset // skip_ntt flag for identity coset\n437\t        );\n438\t\n439\t        FpExt eq = eq_cube[x_int];\n440\t        sum.p += eq * numer_results[0];\n441\t        sum.q += eq * (denom_results[0] + denom_sum_init);\n442\t    }\n443\t\n444\t    // Single-coset reduction (no loop over cosets)\n445\t    shared_sum[threadIdx.x] = sum;\n446\t    __syncthreads();\n447\t\n448\t    if (threadIdx.x < skip_domain) {\n449\t        FracExt tile_sum = shared_sum[threadIdx.x];\n450\t        for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n451\t            auto lane_offset = (lane << l_skip) + threadIdx.x;\n452\t            tile_sum.p += shared_sum[lane_offset].p;\n453\t            tile_sum.q += shared_sum[lane_offset].q;\n454\t        }\n455\t        // Output layout: [num_x_blocks][num_cosets * skip_domain]\n456\t        // Same as lockstep to ensure final_reduce_block_sums works unchanged\n457\t        tmp_sums_buffer[blockIdx.x * num_cosets * skip_domain + coset_idx * skip_domain + ntt_idx] =\n458\t            tile_sum;\n459\t    }\n460\t}\n461\t\n462\t// ============================================================================\n463\t// LAUNCHERS\n464\t// ============================================================================\n465\t\n466\tconstexpr uint32_t MAX_THREADS = 128;\n467\t\n468\t// Helper to determine which mode to use based on threshold\n469\tinline bool use_coset_parallel_mode(uint32_t num_x, uint32_t skip_domain) {\n470\t    return (num_x * skip_domain) < COSET_PARALLEL_THRESHOLD;\n471\t}\n472\t\n473\t// (Not a launcher) Utility function to calculate required size of temp sum buffer.\n474\t// Required length of *temp_sum_buffer in FracExt elements\n475\textern \"C\" size_t _logup_r0_temp_sums_buffer_size(\n476\t    uint32_t buffer_size,\n477\t    uint32_t skip_domain,\n478\t    uint32_t num_x,\n479\t    uint32_t num_cosets,\n480\t    size_t max_temp_bytes\n481\t) {\n482\t    // Both modes use the same buffer size formula\n483\t    return DISPATCH_BOOL(\n484\t        round0_config_impl::temp_sums_buffer_size,\n485\t        use_coset_parallel_mode(num_x, skip_domain),\n486\t        buffer_size,\n487\t        skip_domain,\n488\t        num_x,\n489\t        num_cosets,\n490\t        max_temp_bytes,\n491\t        BUFFER_THRESHOLD,\n492\t        MAX_THREADS\n493\t    );\n494\t}\n495\t\n496\textern \"C\" size_t _logup_r0_intermediates_buffer_size(\n497\t    uint32_t buffer_size,\n498\t    uint32_t skip_domain,\n499\t    uint32_t num_x,\n500\t    uint32_t num_cosets,\n501\t    size_t max_temp_bytes\n502\t) {\n503\t    // Both modes use the same buffer size formula\n504\t    return DISPATCH_BOOL(\n505\t        round0_config_impl::intermediates_buffer_size,\n506\t        use_coset_parallel_mode(num_x, skip_domain),\n507\t        buffer_size,\n508\t        skip_domain,\n509\t        num_x,\n510\t        num_cosets,\n511\t        max_temp_bytes,\n512\t        BUFFER_THRESHOLD,\n513\t        MAX_THREADS\n514\t    );\n515\t}\n516\t\n517\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n518\tint launch_logup_ntt_eval_interactions(\n519\t    FracExt *tmp_sums_buffer,\n520\t    FracExt *output,\n521\t    const Fp *selectors_cube,\n522\t    const Fp *preprocessed,\n523\t    const Fp *const *main_parts,\n524\t    const FpExt *eq_cube,\n525\t    const Fp *public_values,\n526\t    const FpExt *numer_weights,\n527\t    const FpExt *denom_weights,\n528\t    FpExt denom_sum_init,\n529\t    const Rule *d_rules,\n530\t    size_t rules_len,\n531\t    uint32_t buffer_size,\n532\t    Fp *d_intermediates,\n533\t    uint32_t skip_domain,\n534\t    uint32_t num_x,\n535\t    uint32_t height,\n536\t    Fp g_shift,\n537\t    size_t max_temp_bytes\n538\t) {\n539\t    auto [grid, block] = coset_round0_config::eval_constraints_launch_params(\n540\t        buffer_size, skip_domain, num_x, NUM_COSETS, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n541\t    );\n542\t\n543\t    size_t shared_sum_size = sizeof(FracExt) * block.x;\n544\t    // NTT buffers: one skip_domain-sized buffer per x_int group in the block\n545\t    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n546\t    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n547\t\n548\t    logup_r0_ntt_eval_interactions_kernel<NUM_COSETS, GLOBAL, NEEDS_SHMEM>\n549\t        <<<grid, block, shmem_bytes>>>(\n550\t            tmp_sums_buffer,\n551\t            selectors_cube,\n552\t            preprocessed,\n553\t            main_parts,\n554\t            eq_cube,\n555\t            public_values,\n556\t            numer_weights,\n557\t            denom_weights,\n558\t            denom_sum_init,\n559\t            d_rules,\n560\t            rules_len,\n561\t            buffer_size,\n562\t            d_intermediates,\n563\t            skip_domain,\n564\t            num_x,\n565\t            height,\n566\t            g_shift\n567\t        );\n568\t\n569\t    int err = CHECK_KERNEL();\n570\t    if (err != 0) {\n571\t        return err;\n572\t    }\n573\t\n574\t    auto num_blocks = grid.x;\n575\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n576\t    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n577\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n578\t    auto large_domain = NUM_COSETS * skip_domain;\n579\t    sumcheck::final_reduce_block_sums<<<2 * large_domain, reduce_block, reduce_shmem>>>(\n580\t        reinterpret_cast<FpExt *>(tmp_sums_buffer), reinterpret_cast<FpExt *>(output), num_blocks\n581\t    );\n582\t    return CHECK_KERNEL();\n583\t}\n584\t\n585\t// Generate dispatcher for num_cosets (1-4) x is_global x needs_shmem\n586\tDEFINE_DISPATCH_N_B1_B2(dispatch_logup, launch_logup_ntt_eval_interactions, 4)\n587\t\n588\t// Coset-parallel launcher: uses grid.y = num_cosets, each block handles one coset\n589\ttemplate <bool GLOBAL, bool NEEDS_SHMEM>\n590\tint launch_logup_coset_parallel(\n591\t    FracExt *tmp_sums_buffer,\n592\t    FracExt *output,\n593\t    const Fp *selectors_cube,\n594\t    const Fp *preprocessed,\n595\t    const Fp *const *main_parts,\n596\t    const FpExt *eq_cube,\n597\t    const Fp *public_values,\n598\t    const FpExt *numer_weights,\n599\t    const FpExt *denom_weights,\n600\t    FpExt denom_sum_init,\n601\t    const Rule *d_rules,\n602\t    size_t rules_len,\n603\t    uint32_t buffer_size,\n604\t    Fp *d_intermediates,\n605\t    uint32_t skip_domain,\n606\t    uint32_t num_x,\n607\t    uint32_t height,\n608\t    uint32_t num_cosets,\n609\t    Fp g_shift,\n610\t    size_t max_temp_bytes\n611\t) {\n612\t    auto [grid, block] = coset_parallel_round0_config::eval_constraints_launch_params(\n613\t        buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n614\t    );\n615\t\n616\t    size_t shared_sum_size = sizeof(FracExt) * block.x;\n617\t    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n618\t    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n619\t\n620\t    logup_r0_ntt_eval_interactions_coset_parallel_kernel<GLOBAL, NEEDS_SHMEM>\n621\t        <<<grid, block, shmem_bytes>>>(\n622\t            tmp_sums_buffer,\n623\t            selectors_cube,\n624\t            preprocessed,\n625\t            main_parts,\n626\t            eq_cube,\n627\t            public_values,\n628\t            numer_weights,\n629\t            denom_weights,\n630\t            denom_sum_init,\n631\t            d_rules,\n632\t            rules_len,\n633\t            buffer_size,\n634\t            d_intermediates,\n635\t            skip_domain,\n636\t            num_x,\n637\t            height,\n638\t            g_shift\n639\t        );\n640\t    int err = CHECK_KERNEL();\n641\t    if (err != 0) {\n642\t        return err;\n643\t    }\n644\t\n645\t    // Final reduction: same as lockstep\n646\t    auto num_blocks = grid.x;\n647\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n648\t    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n649\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n650\t    auto large_domain = num_cosets * skip_domain;\n651\t    sumcheck::final_reduce_block_sums<<<2 * large_domain, reduce_block, reduce_shmem>>>(\n652\t        reinterpret_cast<FpExt *>(tmp_sums_buffer), reinterpret_cast<FpExt *>(output), num_blocks\n653\t    );\n654\t\n655\t    return CHECK_KERNEL();\n656\t}\n657\t\n658\textern \"C\" int _logup_bary_eval_interactions_round0(\n659\t    FracExt *tmp_sums_buffer, // [num_blocks][num_cosets * skip_domain]\n660\t    FracExt *output,          // [num_cosets * skip_domain]\n661\t    const Fp *selectors_cube, // [3][num_x]\n662\t    const Fp *preprocessed,\n663\t    const Fp *const *main_parts,\n664\t    const FpExt *eq_cube, // [num_x]\n665\t    const Fp *public_values,\n666\t    const FpExt *numer_weights,\n667\t    const FpExt *denom_weights,\n668\t    FpExt denom_sum_init,\n669\t    const Rule *d_rules,\n670\t    size_t rules_len,\n671\t    uint32_t buffer_size,\n672\t    Fp *d_intermediates,\n673\t    uint32_t skip_domain,\n674\t    uint32_t num_x,\n675\t    uint32_t height,\n676\t    uint32_t num_cosets,\n677\t    Fp g_shift,\n678\t    size_t max_temp_bytes\n679\t) {\n680\t    bool is_global = buffer_size > BUFFER_THRESHOLD;\n681\t    bool needs_shmem = skip_domain > WARP_SIZE;\n682\t\n683\t    // Threshold-based dispatch: use coset-parallel for small workloads\n684\t    if (use_coset_parallel_mode(num_x, skip_domain)) {\n685\t        // Coset-parallel mode: grid.y = num_cosets, each block handles one coset\n686\t        if (is_global) {\n687\t            if (needs_shmem) {\n688\t                return launch_logup_coset_parallel<true, true>(\n689\t                    tmp_sums_buffer,\n690\t                    output,\n691\t                    selectors_cube,\n692\t                    preprocessed,\n693\t                    main_parts,\n694\t                    eq_cube,\n695\t                    public_values,\n696\t                    numer_weights,\n697\t                    denom_weights,\n698\t                    denom_sum_init,\n699\t                    d_rules,\n700\t                    rules_len,\n701\t                    buffer_size,\n702\t                    d_intermediates,\n703\t                    skip_domain,\n704\t                    num_x,\n705\t                    height,\n706\t                    num_cosets,\n707\t                    g_shift,\n708\t                    max_temp_bytes\n709\t                );\n710\t            } else {\n711\t                return launch_logup_coset_parallel<true, false>(\n712\t                    tmp_sums_buffer,\n713\t                    output,\n714\t                    selectors_cube,\n715\t                    preprocessed,\n716\t                    main_parts,\n717\t                    eq_cube,\n718\t                    public_values,\n719\t                    numer_weights,\n720\t                    denom_weights,\n721\t                    denom_sum_init,\n722\t                    d_rules,\n723\t                    rules_len,\n724\t                    buffer_size,\n725\t                    d_intermediates,\n726\t                    skip_domain,\n727\t                    num_x,\n728\t                    height,\n729\t                    num_cosets,\n730\t                    g_shift,\n731\t                    max_temp_bytes\n732\t                );\n733\t            }\n734\t        } else {\n735\t            if (needs_shmem) {\n736\t                return launch_logup_coset_parallel<false, true>(\n737\t                    tmp_sums_buffer,\n738\t                    output,\n739\t                    selectors_cube,\n740\t                    preprocessed,\n741\t                    main_parts,\n742\t                    eq_cube,\n743\t                    public_values,\n744\t                    numer_weights,\n745\t                    denom_weights,\n746\t                    denom_sum_init,\n747\t                    d_rules,\n748\t                    rules_len,\n749\t                    buffer_size,\n750\t                    d_intermediates,\n751\t                    skip_domain,\n752\t                    num_x,\n753\t                    height,\n754\t                    num_cosets,\n755\t                    g_shift,\n756\t                    max_temp_bytes\n757\t                );\n758\t            } else {\n759\t                return launch_logup_coset_parallel<false, false>(\n760\t                    tmp_sums_buffer,\n761\t                    output,\n762\t                    selectors_cube,\n763\t                    preprocessed,\n764\t                    main_parts,\n765\t                    eq_cube,\n766\t                    public_values,\n767\t                    numer_weights,\n768\t                    denom_weights,\n769\t                    denom_sum_init,\n770\t                    d_rules,\n771\t                    rules_len,\n772\t                    buffer_size,\n773\t                    d_intermediates,\n774\t                    skip_domain,\n775\t                    num_x,\n776\t                    height,\n777\t                    num_cosets,\n778\t                    g_shift,\n779\t                    max_temp_bytes\n780\t                );\n781\t            }\n782\t        }\n783\t    } else {\n784\t        // Lockstep mode: single thread handles all cosets\n785\t        return dispatch_logup(\n786\t            num_cosets,\n787\t            is_global,\n788\t            needs_shmem,\n789\t            tmp_sums_buffer,\n790\t            output,\n791\t            selectors_cube,\n792\t            preprocessed,\n793\t            main_parts,\n794\t            eq_cube,\n795\t            public_values,\n796\t            numer_weights,\n797\t            denom_weights,\n798\t            denom_sum_init,\n799\t            d_rules,\n800\t            rules_len,\n801\t            buffer_size,\n802\t            d_intermediates,\n803\t            skip_domain,\n804\t            num_x,\n805\t            height,\n806\t            g_shift,\n807\t            max_temp_bytes\n808\t        );\n809\t    }\n810\t}\n811\t\n812\t} // namespace logup_round0\n813\t"}]},"parent_tool_use_id":null,"session_id":"3eab5b9b-40e0-4e43-bd71-fd448feabe6e","uuid":"352dd81b-5d40-40fc-b9a9-9f0ba2fa2828","timestamp":"2026-04-13T13:14:11.792Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/cuda/src/logup_zerocheck/logup_round0.cu","content":"#include \"codec.cuh\"\n#include \"dag_entry.cuh\"\n#include \"eval_config.cuh\"\n#include \"fp.h\"\n#include \"fpext.h\"\n#include \"frac_ext.cuh\"\n#include \"launcher.cuh\"\n#include \"sumcheck.cuh\"\n#include \"utils.cuh\"\n#include <algorithm>\n#include <cmath>\n#include <cstddef>\n#include <cstdint>\n#include <utility>\n#include <vector_types.h>\n\nusing namespace symbolic_dag;\n\nnamespace logup_round0 {\n\n// NOTE[jpw]: keeping separate from zerocheck so it can be tuned separately\nconstexpr uint32_t BUFFER_THRESHOLD = 16;\n// Threshold for switching between coset-parallel and lockstep modes.\n// When num_x * skip_domain < threshold, use coset-parallel (grid.y = num_cosets) for better GPU utilization.\n// When >= threshold, use lockstep (single thread handles all cosets) to avoid redundant iNTT.\nconstexpr uint32_t COSET_PARALLEL_THRESHOLD = 32768; // 2^15\n\n// Device function to evaluate interactions for all cosets in lockstep with DAG traversal.\n// Computes numerator and denominator sums for each coset.\n// NOTE: Using __inline__ instead of __forceinline__ to let compiler decide based on register pressure.\n//\n// Template params:\n// - FIRST_COSET_IS_IDENTITY: compile-time flag for lockstep kernel when coset 0 has shift=1\n// Runtime params:\n// - skip_ntt: runtime flag for coset-parallel kernel when processing identity coset\ntemplate <uint32_t NUM_COSETS, bool NEEDS_SHMEM, bool FIRST_COSET_IS_IDENTITY = false>\n__device__ __inline__ void acc_interactions(\n    const NttEvalContext<NUM_COSETS> &eval_ctx,\n    const Fp *is_first, // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n    const Fp *is_last,  // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n    uint32_t x_int,\n    const FpExt *__restrict__ numer_weights,\n    const FpExt *__restrict__ denom_weights,\n    const Rule *__restrict__ d_rules,\n    size_t rules_len,\n    FpExt *__restrict__ numer_sums, // output [NUM_COSETS]\n    FpExt *__restrict__ denom_sums, // output [NUM_COSETS]\n    bool skip_ntt = false           // Runtime flag for identity coset\n) {\n    // Initialize sums to zero\n#pragma unroll\n    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n        numer_sums[c] = FpExt(Fp::zero());\n        denom_sums[c] = FpExt(Fp::zero());\n    }\n\n    for (size_t node = 0; node < rules_len; ++node) {\n        Rule rule = d_rules[node];\n        // Lazy decoding: only decode header (op, flags, x) upfront\n        RuleHeader header = decode_rule_header(rule);\n\n        // Evaluate x operand for all cosets\n        Fp x_vals[NUM_COSETS];\n        ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n            x_vals, header.x, eval_ctx, is_first, is_last, x_int, skip_ntt\n        );\n\n        Fp results[NUM_COSETS];\n\n        switch (header.op) {\n        case OP_ADD: {\n            // Decode y only for binary ops\n            SourceInfo y_src = decode_y(rule);\n            Fp y_vals[NUM_COSETS];\n            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n            );\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                results[c] = x_vals[c] + y_vals[c];\n            }\n            break;\n        }\n        case OP_SUB: {\n            SourceInfo y_src = decode_y(rule);\n            Fp y_vals[NUM_COSETS];\n            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n            );\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                results[c] = x_vals[c] - y_vals[c];\n            }\n            break;\n        }\n        case OP_MUL: {\n            SourceInfo y_src = decode_y(rule);\n            Fp y_vals[NUM_COSETS];\n            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n            );\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                results[c] = x_vals[c] * y_vals[c];\n            }\n            break;\n        }\n        case OP_NEG:\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                results[c] = -x_vals[c];\n            }\n            break;\n        case OP_VAR:\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                results[c] = x_vals[c];\n            }\n            break;\n        case OP_INV:\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                results[c] = inv(x_vals[c]);\n            }\n            break;\n        }\n\n        // Store intermediate results for all cosets\n        // Decode z_index only when buffering\n        if (header.buffer_result && eval_ctx.buffer_size > 0) {\n            uint32_t z_index = decode_z_index(rule);\n#ifdef CUDA_DEBUG\n            assert(z_index < eval_ctx.buffer_size);\n#endif\n            // Intermediate buffer layout: [buffer_size][NUM_COSETS] per thread\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                eval_ctx.inter_buffer[z_index * eval_ctx.buffer_stride + c] = results[c];\n            }\n        }\n\n        // Accumulate interaction sums\n        if (header.is_constraint) {\n            FpExt numer_w = numer_weights[node];\n            FpExt denom_w = denom_weights[node];\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                numer_sums[c] += numer_w * results[c];\n                denom_sums[c] += denom_w * results[c];\n            }\n        }\n    }\n}\n\n// ============================================================================\n// KERNELS\n// ============================================================================\n\n// Round0 phase interactions kernel - each thread handles ALL cosets in lockstep\ntemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n__global__ void logup_r0_ntt_eval_interactions_kernel(\n    FracExt *__restrict__ tmp_sums_buffer, // [NUM_COSETS][gridDim.x][skip_domain]\n    const Fp *__restrict__ selectors_cube, // [3][num_x]\n    const Fp *__restrict__ preprocessed,\n    const Fp *const *__restrict__ main_parts,\n    const FpExt *__restrict__ eq_cube, // [num_x]\n    const Fp *__restrict__ public_values,\n    const FpExt *__restrict__ numer_weights,\n    const FpExt *__restrict__ denom_weights,\n    FpExt denom_sum_init,\n    const Rule *__restrict__ d_rules,\n    size_t rules_len,\n    uint32_t buffer_size,\n    Fp *__restrict__ d_intermediates,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t height,\n    Fp g_shift\n) {\n    extern __shared__ char smem[];\n    // Shared memory layout:\n    // - FracExt[blockDim.x]: shared_sum for reduction (reused per coset)\n    // - Fp[blockDim.x]: ntt_buffers (one skip_domain-sized buffer per x_int group, only when NEEDS_SHMEM)\n    FracExt *shared_sum = reinterpret_cast<FracExt *>(smem);\n    Fp *ntt_buffers_base =\n        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FracExt)) : nullptr;\n\n    uint32_t const l_skip = __ffs(skip_domain) - 1;\n\n    // Each x_int group within the block gets its own ntt_buffer slice\n    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n\n    // Thread layout: ntt_idx varies fastest, then x_int\n    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n    uint32_t const x_int_base = tidx >> l_skip;\n\n    // Precompute values needed for all cosets\n    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n    Fp const omega_skip = TWO_ADIC_GENERATORS[l_skip];\n\n    // Compute is_first_mult, is_last_mult for all cosets\n    uint32_t const log_height_total = __ffs(height) - 1;\n    uint32_t const log_segment = min(l_skip, log_height_total);\n    uint32_t const segment_size = 1u << log_segment;\n    uint32_t const log_stride = l_skip - log_segment;\n\n    Fp is_first_mult[NUM_COSETS];\n    Fp is_last_mult[NUM_COSETS];\n    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n    Fp const omega_skip_ntt = pow(omega_skip, ntt_idx);\n\n    // Cosets c=0..NUM_COSETS-1 with shifts 1,g^1, g^2, ...\n    Fp g_coset = Fp::one();\n#pragma unroll\n    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n        Fp eval_point = g_coset * omega_skip_ntt;\n        Fp omega = exp_power_of_2(eval_point, log_stride);\n        is_first_mult[c] = avg_gp(omega, segment_size);\n        is_last_mult[c] = avg_gp(omega * eta, segment_size);\n        g_coset *= g_shift; // g^(c+1) for next iteration\n    }\n\n    // Intermediate buffer setup\n    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD * NUM_COSETS];\n    Fp *inter_buffer;\n    uint32_t buffer_stride;\n    if constexpr (GLOBAL) {\n        // Layout: [buffer_size][num_threads][NUM_COSETS]\n        inter_buffer = d_intermediates + tidx * NUM_COSETS;\n        buffer_stride = gridDim.x * blockDim.x * NUM_COSETS;\n    } else {\n        inter_buffer = local_buffer;\n        buffer_stride = NUM_COSETS;\n    }\n\n    // Accumulate sums for all cosets\n    FracExt sums[NUM_COSETS];\n#pragma unroll\n    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n        sums[c] = {FpExt(Fp::zero()), FpExt(Fp::zero())};\n    }\n\n    // blockDim.x is guaranteed to be a multiple of 2^l_skip\n    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n\n    // Initialize eval_ctx once with loop-invariant fields\n    NttEvalContext<NUM_COSETS> eval_ctx{\n        preprocessed,\n        main_parts,\n        public_values,\n        inter_buffer,\n        ntt_buffer,\n        {}, // omega_shifts - set once below\n        skip_domain,\n        height,\n        buffer_stride,\n        buffer_size,\n        ntt_idx,\n    };\n    // Compute omega_shifts: coset 0 has identity shift, rest use g^c\n    eval_ctx.omega_shifts[0] = Fp::one(); // Identity coset\n    g_coset = g_shift;                    // g^1\n#pragma unroll\n    for (uint32_t c = 1; c < NUM_COSETS; c++) {\n        eval_ctx.omega_shifts[c] = pow(g_coset, ntt_idx_rev);\n        g_coset *= g_shift;\n    }\n\n    // Tile across x_int\n    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n        // Compute per-iteration selectors as fresh local values\n        Fp is_first[NUM_COSETS];\n        Fp is_last[NUM_COSETS];\n#pragma unroll\n        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n            is_first[c] = is_first_mult[c] * selectors_cube[x_int];\n            is_last[c] = is_last_mult[c] * selectors_cube[2 * num_x + x_int];\n        }\n\n        FpExt numer_results[NUM_COSETS];\n        FpExt denom_results[NUM_COSETS];\n        acc_interactions<NUM_COSETS, NEEDS_SHMEM, /*FIRST_COSET_IS_IDENTITY=*/true>(\n            eval_ctx, is_first, is_last, x_int,\n            numer_weights, denom_weights, d_rules, rules_len, numer_results, denom_results\n        );\n\n        FpExt eq = eq_cube[x_int];\n#pragma unroll\n        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n            sums[c].p += eq * numer_results[c];\n            sums[c].q += eq * (denom_results[c] + denom_sum_init);\n        }\n    }\n\n    // Reduction: one coset at a time to minimize shared memory\n#pragma unroll\n    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n        shared_sum[threadIdx.x] = sums[c];\n        __syncthreads();\n\n        if (threadIdx.x < skip_domain) {\n            FracExt tile_sum = shared_sum[threadIdx.x];\n            for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n                auto lane_offset = (lane << l_skip) + threadIdx.x;\n                tile_sum.p += shared_sum[lane_offset].p;\n                tile_sum.q += shared_sum[lane_offset].q;\n            }\n            // Output layout: [num_blocks][NUM_COSETS * skip_domain]\n            // This matches final_reduce_block_sums expected [num_blocks][d] layout\n            tmp_sums_buffer[blockIdx.x * NUM_COSETS * skip_domain + c * skip_domain + ntt_idx] =\n                tile_sum;\n        }\n        __syncthreads();\n    }\n}\n\n// Coset-parallel kernel: grid.y = num_cosets, each block handles ONE coset.\n// Uses acc_interactions<1, NEEDS_SHMEM> with explicit parameter passing.\n// Use when num_x * skip_domain is small for better GPU utilization.\ntemplate <bool GLOBAL, bool NEEDS_SHMEM>\n__global__ void logup_r0_ntt_eval_interactions_coset_parallel_kernel(\n    FracExt *__restrict__ tmp_sums_buffer, // [num_blocks][num_cosets * skip_domain]\n    const Fp *__restrict__ selectors_cube, // [3][num_x]\n    const Fp *__restrict__ preprocessed,\n    const Fp *const *__restrict__ main_parts,\n    const FpExt *__restrict__ eq_cube, // [num_x]\n    const Fp *__restrict__ public_values,\n    const FpExt *__restrict__ numer_weights,\n    const FpExt *__restrict__ denom_weights,\n    FpExt denom_sum_init,\n    const Rule *__restrict__ d_rules,\n    size_t rules_len,\n    uint32_t buffer_size,\n    Fp *__restrict__ d_intermediates,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t height,\n    Fp g_shift\n) {\n    extern __shared__ char smem[];\n    FracExt *shared_sum = reinterpret_cast<FracExt *>(smem);\n    Fp *ntt_buffers_base =\n        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FracExt)) : nullptr;\n\n    uint32_t const l_skip = __ffs(skip_domain) - 1;\n    uint32_t const num_cosets = gridDim.y;\n\n    // Each x_int group within the block gets its own ntt_buffer slice\n    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n\n    // Thread layout: ntt_idx varies fastest, then x_int\n    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n    uint32_t const x_int_base = tidx >> l_skip;\n\n    // KEY DIFFERENCE: coset_idx from blockIdx.y\n    uint32_t const coset_idx = blockIdx.y;\n    bool const is_identity_coset = (coset_idx == 0);\n\n    // Precompute values for this single coset\n    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n    Fp const omega_skip = TWO_ADIC_GENERATORS[l_skip];\n\n    uint32_t const log_height_total = __ffs(height) - 1;\n    uint32_t const log_segment = min(l_skip, log_height_total);\n    uint32_t const segment_size = 1u << log_segment;\n    uint32_t const log_stride = l_skip - log_segment;\n\n    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n    Fp const omega_skip_ntt = pow(omega_skip, ntt_idx);\n\n    // Compute for single coset: coset 0 has shift=1, rest have shift=g^coset_idx\n    Fp const g_coset = is_identity_coset ? Fp::one() : pow(g_shift, coset_idx);\n    Fp const eval_point = is_identity_coset ? omega_skip_ntt : (g_coset * omega_skip_ntt);\n    Fp const omega = exp_power_of_2(eval_point, log_stride);\n    Fp const is_first_mult = avg_gp(omega, segment_size);\n    Fp const is_last_mult = avg_gp(omega * eta, segment_size);\n    Fp const omega_shift = is_identity_coset ? Fp::one() : pow(g_coset, ntt_idx_rev);\n\n    // Intermediate buffer setup (single coset, no NUM_COSETS multiplier)\n    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD];\n    Fp *inter_buffer;\n    uint32_t buffer_stride;\n    if constexpr (GLOBAL) {\n        // Layout: [buffer_size][num_cosets * num_threads_per_coset]\n        uint32_t global_tidx = coset_idx * gridDim.x * blockDim.x + tidx;\n        inter_buffer = d_intermediates + global_tidx;\n        buffer_stride = gridDim.x * gridDim.y * blockDim.x;\n    } else {\n        inter_buffer = local_buffer;\n        buffer_stride = 1;\n    }\n\n    FracExt sum = {FpExt(Fp::zero()), FpExt(Fp::zero())};\n\n    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n\n    // Single-coset context (NUM_COSETS=1), loop-invariant fields only\n    NttEvalContext<1> eval_ctx{\n        preprocessed,\n        main_parts,\n        public_values,\n        inter_buffer,\n        ntt_buffer,\n        {omega_shift}, // omega_shifts[1]\n        skip_domain,\n        height,\n        buffer_stride,\n        buffer_size,\n        ntt_idx,\n    };\n\n    // Main loop - reuses acc_interactions<1, NEEDS_SHMEM>\n    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n        Fp is_first = is_first_mult * selectors_cube[x_int];\n        Fp is_last = is_last_mult * selectors_cube[2 * num_x + x_int];\n\n        FpExt numer_results[1];\n        FpExt denom_results[1];\n        // We use this device function to handle a single coset so NUM_COSETS = 1 and FIRST_COSET_IS_IDENTITY = false.\n        // The actual `coset_idx = 0` skip is handled by the `is_identity_coset` flag.\n        acc_interactions</*NUM_COSETS=*/1, NEEDS_SHMEM, /*FIRST_COSET_IS_IDENTITY=*/false>(\n            eval_ctx,\n            &is_first,\n            &is_last,\n            x_int,\n            numer_weights,\n            denom_weights,\n            d_rules,\n            rules_len,\n            numer_results,\n            denom_results,\n            is_identity_coset // skip_ntt flag for identity coset\n        );\n\n        FpExt eq = eq_cube[x_int];\n        sum.p += eq * numer_results[0];\n        sum.q += eq * (denom_results[0] + denom_sum_init);\n    }\n\n    // Single-coset reduction (no loop over cosets)\n    shared_sum[threadIdx.x] = sum;\n    __syncthreads();\n\n    if (threadIdx.x < skip_domain) {\n        FracExt tile_sum = shared_sum[threadIdx.x];\n        for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n            auto lane_offset = (lane << l_skip) + threadIdx.x;\n            tile_sum.p += shared_sum[lane_offset].p;\n            tile_sum.q += shared_sum[lane_offset].q;\n        }\n        // Output layout: [num_x_blocks][num_cosets * skip_domain]\n        // Same as lockstep to ensure final_reduce_block_sums works unchanged\n        tmp_sums_buffer[blockIdx.x * num_cosets * skip_domain + coset_idx * skip_domain + ntt_idx] =\n            tile_sum;\n    }\n}\n\n// ============================================================================\n// LAUNCHERS\n// ============================================================================\n\nconstexpr uint32_t MAX_THREADS = 128;\n\n// Helper to determine which mode to use based on threshold\ninline bool use_coset_parallel_mode(uint32_t num_x, uint32_t skip_domain) {\n    return (num_x * skip_domain) < COSET_PARALLEL_THRESHOLD;\n}\n\n// (Not a launcher) Utility function to calculate required size of temp sum buffer.\n// Required length of *temp_sum_buffer in FracExt elements\nextern \"C\" size_t _logup_r0_temp_sums_buffer_size(\n    uint32_t buffer_size,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t num_cosets,\n    size_t max_temp_bytes\n) {\n    // Both modes use the same buffer size formula\n    return DISPATCH_BOOL(\n        round0_config_impl::temp_sums_buffer_size,\n        use_coset_parallel_mode(num_x, skip_domain),\n        buffer_size,\n        skip_domain,\n        num_x,\n        num_cosets,\n        max_temp_bytes,\n        BUFFER_THRESHOLD,\n        MAX_THREADS\n    );\n}\n\nextern \"C\" size_t _logup_r0_intermediates_buffer_size(\n    uint32_t buffer_size,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t num_cosets,\n    size_t max_temp_bytes\n) {\n    // Both modes use the same buffer size formula\n    return DISPATCH_BOOL(\n        round0_config_impl::intermediates_buffer_size,\n        use_coset_parallel_mode(num_x, skip_domain),\n        buffer_size,\n        skip_domain,\n        num_x,\n        num_cosets,\n        max_temp_bytes,\n        BUFFER_THRESHOLD,\n        MAX_THREADS\n    );\n}\n\ntemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\nint launch_logup_ntt_eval_interactions(\n    FracExt *tmp_sums_buffer,\n    FracExt *output,\n    const Fp *selectors_cube,\n    const Fp *preprocessed,\n    const Fp *const *main_parts,\n    const FpExt *eq_cube,\n    const Fp *public_values,\n    const FpExt *numer_weights,\n    const FpExt *denom_weights,\n    FpExt denom_sum_init,\n    const Rule *d_rules,\n    size_t rules_len,\n    uint32_t buffer_size,\n    Fp *d_intermediates,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t height,\n    Fp g_shift,\n    size_t max_temp_bytes\n) {\n    auto [grid, block] = coset_round0_config::eval_constraints_launch_params(\n        buffer_size, skip_domain, num_x, NUM_COSETS, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n    );\n\n    size_t shared_sum_size = sizeof(FracExt) * block.x;\n    // NTT buffers: one skip_domain-sized buffer per x_int group in the block\n    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n\n    logup_r0_ntt_eval_interactions_kernel<NUM_COSETS, GLOBAL, NEEDS_SHMEM>\n        <<<grid, block, shmem_bytes>>>(\n            tmp_sums_buffer,\n            selectors_cube,\n            preprocessed,\n            main_parts,\n            eq_cube,\n            public_values,\n            numer_weights,\n            denom_weights,\n            denom_sum_init,\n            d_rules,\n            rules_len,\n            buffer_size,\n            d_intermediates,\n            skip_domain,\n            num_x,\n            height,\n            g_shift\n        );\n\n    int err = CHECK_KERNEL();\n    if (err != 0) {\n        return err;\n    }\n\n    auto num_blocks = grid.x;\n    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n    auto large_domain = NUM_COSETS * skip_domain;\n    sumcheck::final_reduce_block_sums<<<2 * large_domain, reduce_block, reduce_shmem>>>(\n        reinterpret_cast<FpExt *>(tmp_sums_buffer), reinterpret_cast<FpExt *>(output), num_blocks\n    );\n    return CHECK_KERNEL();\n}\n\n// Generate dispatcher for num_cosets (1-4) x is_global x needs_shmem\nDEFINE_DISPATCH_N_B1_B2(dispatch_logup, launch_logup_ntt_eval_interactions, 4)\n\n// Coset-parallel launcher: uses grid.y = num_cosets, each block handles one coset\ntemplate <bool GLOBAL, bool NEEDS_SHMEM>\nint launch_logup_coset_parallel(\n    FracExt *tmp_sums_buffer,\n    FracExt *output,\n    const Fp *selectors_cube,\n    const Fp *preprocessed,\n    const Fp *const *main_parts,\n    const FpExt *eq_cube,\n    const Fp *public_values,\n    const FpExt *numer_weights,\n    const FpExt *denom_weights,\n    FpExt denom_sum_init,\n    const Rule *d_rules,\n    size_t rules_len,\n    uint32_t buffer_size,\n    Fp *d_intermediates,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t height,\n    uint32_t num_cosets,\n    Fp g_shift,\n    size_t max_temp_bytes\n) {\n    auto [grid, block] = coset_parallel_round0_config::eval_constraints_launch_params(\n        buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n    );\n\n    size_t shared_sum_size = sizeof(FracExt) * block.x;\n    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n\n    logup_r0_ntt_eval_interactions_coset_parallel_kernel<GLOBAL, NEEDS_SHMEM>\n        <<<grid, block, shmem_bytes>>>(\n            tmp_sums_buffer,\n            selectors_cube,\n            preprocessed,\n            main_parts,\n            eq_cube,\n            public_values,\n            numer_weights,\n            denom_weights,\n            denom_sum_init,\n            d_rules,\n            rules_len,\n            buffer_size,\n            d_intermediates,\n            skip_domain,\n            num_x,\n            height,\n            g_shift\n        );\n    int err = CHECK_KERNEL();\n    if (err != 0) {\n        return err;\n    }\n\n    // Final reduction: same as lockstep\n    auto num_blocks = grid.x;\n    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n    auto large_domain = num_cosets * skip_domain;\n    sumcheck::final_reduce_block_sums<<<2 * large_domain, reduce_block, reduce_shmem>>>(\n        reinterpret_cast<FpExt *>(tmp_sums_buffer), reinterpret_cast<FpExt *>(output), num_blocks\n    );\n\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _logup_bary_eval_interactions_round0(\n    FracExt *tmp_sums_buffer, // [num_blocks][num_cosets * skip_domain]\n    FracExt *output,          // [num_cosets * skip_domain]\n    const Fp *selectors_cube, // [3][num_x]\n    const Fp *preprocessed,\n    const Fp *const *main_parts,\n    const FpExt *eq_cube, // [num_x]\n    const Fp *public_values,\n    const FpExt *numer_weights,\n    const FpExt *denom_weights,\n    FpExt denom_sum_init,\n    const Rule *d_rules,\n    size_t rules_len,\n    uint32_t buffer_size,\n    Fp *d_intermediates,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t height,\n    uint32_t num_cosets,\n    Fp g_shift,\n    size_t max_temp_bytes\n) {\n    bool is_global = buffer_size > BUFFER_THRESHOLD;\n    bool needs_shmem = skip_domain > WARP_SIZE;\n\n    // Threshold-based dispatch: use coset-parallel for small workloads\n    if (use_coset_parallel_mode(num_x, skip_domain)) {\n        // Coset-parallel mode: grid.y = num_cosets, each block handles one coset\n        if (is_global) {\n            if (needs_shmem) {\n                return launch_logup_coset_parallel<true, true>(\n                    tmp_sums_buffer,\n                    output,\n                    selectors_cube,\n                    preprocessed,\n                    main_parts,\n                    eq_cube,\n                    public_values,\n                    numer_weights,\n                    denom_weights,\n                    denom_sum_init,\n                    d_rules,\n                    rules_len,\n                    buffer_size,\n                    d_intermediates,\n                    skip_domain,\n                    num_x,\n                    height,\n                    num_cosets,\n                    g_shift,\n                    max_temp_bytes\n                );\n            } else {\n                return launch_logup_coset_parallel<true, false>(\n                    tmp_sums_buffer,\n                    output,\n                    selectors_cube,\n                    preprocessed,\n                    main_parts,\n                    eq_cube,\n                    public_values,\n                    numer_weights,\n                    denom_weights,\n                    denom_sum_init,\n                    d_rules,\n                    rules_len,\n                    buffer_size,\n                    d_intermediates,\n                    skip_domain,\n                    num_x,\n                    height,\n                    num_cosets,\n                    g_shift,\n                    max_temp_bytes\n                );\n            }\n        } else {\n            if (needs_shmem) {\n                return launch_logup_coset_parallel<false, true>(\n                    tmp_sums_buffer,\n                    output,\n                    selectors_cube,\n                    preprocessed,\n                    main_parts,\n                    eq_cube,\n                    public_values,\n                    numer_weights,\n                    denom_weights,\n                    denom_sum_init,\n                    d_rules,\n                    rules_len,\n                    buffer_size,\n                    d_intermediates,\n                    skip_domain,\n                    num_x,\n                    height,\n                    num_cosets,\n                    g_shift,\n                    max_temp_bytes\n                );\n            } else {\n                return launch_logup_coset_parallel<false, false>(\n                    tmp_sums_buffer,\n                    output,\n                    selectors_cube,\n                    preprocessed,\n                    main_parts,\n                    eq_cube,\n                    public_values,\n                    numer_weights,\n                    denom_weights,\n                    denom_sum_init,\n                    d_rules,\n                    rules_len,\n                    buffer_size,\n                    d_intermediates,\n                    skip_domain,\n                    num_x,\n                    height,\n                    num_cosets,\n                    g_shift,\n                    max_temp_bytes\n                );\n            }\n        }\n    } else {\n        // Lockstep mode: single thread handles all cosets\n        return dispatch_logup(\n            num_cosets,\n            is_global,\n            needs_shmem,\n            tmp_sums_buffer,\n            output,\n            selectors_cube,\n            preprocessed,\n            main_parts,\n            eq_cube,\n            public_values,\n            numer_weights,\n            denom_weights,\n            denom_sum_init,\n            d_rules,\n            rules_len,\n            buffer_size,\n            d_intermediates,\n            skip_domain,\n            num_x,\n            height,\n            g_shift,\n            max_temp_bytes\n        );\n    }\n}\n\n} // namespace logup_round0\n","numLines":813,"startLine":1,"totalLines":813}}}
