\t            eq_xis: &self.eq_xis,\n919\t            d_lambda_pows,\n920\t            beta_pows: &self.beta_pows,\n921\t            l_skip,\n922\t            constraint_degree: self.constraint_degree,\n923\t            xi: &self.xi,\n924\t            max_temp_bytes: per_thread_temp_bytes,\n925\t        })\n926\t        .collect();\n927\t\n928\t        // Sort by descending height for better load balance across thread chunks.\n929\t        work_items.sort_by(|a, b| b.common_main.height().cmp(&a.common_main.height()));\n930\t\n931\t        // Barrier: ensure all prior GPU work (trace uploads, pk data, selectors)\n932\t        // is visible to worker thread streams.\n933\t        current_stream_sync().map_err(MemCopyError::from)?;\n934\t\n935\t        // Phase 2: Process AIRs in parallel across N OS threads.\n936\t        // Only use multi-threading when there are enough AIRs to benefit from concurrent\n937\t        // kernel execution. With few large AIRs (e.g., APC 0 has ~20 per segment), each\n938\t        // kernel already saturates the GPU and multi-threading adds memory pool overhead.\n939\t        let num_threads = if work_items.len() >= 100 {\n940\t            NUM_ROUND0_STREAMS.min(work_items.len())\n941\t        } else {\n942\t            1\n943\t        };\n944\t        let results: Vec<Round0AirResult> = if num_threads <= 1 {\n945\t            work_items\n946\t                .iter()\n947\t                .map(|w| process_air_round0(w))\n948\t                .collect::<Result<Vec<_>, _>>()?\n949\t        } else {\n950\t            let chunk_size = work_items.len().div_ceil(num_threads);\n951\t            std::thread::scope(|s| {\n952\t                let handles: Vec<_> = work_items\n953\t                    .chunks(chunk_size)\n954\t                    .map(|chunk| {\n955\t                        s.spawn(move || -> Result<Vec<Round0AirResult>, LogupZerocheckError> {\n956\t                            chunk.iter().map(|w| process_air_round0(w)).collect()\n9