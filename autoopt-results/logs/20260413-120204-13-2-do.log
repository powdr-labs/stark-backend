{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xzu1FtDQ8ut2DTP9jUMC43","type":"tool_result","content":"1\t#pragma once\n2\t\n3\t#include \"fp.h\"\n4\t#include \"fpext.h\"\n5\t#include \"launcher.cuh\"\n6\t#include <algorithm>\n7\t#include <cassert>\n8\t#include <cstddef>\n9\t#include <cstdint>\n10\t#include <utility>\n11\t#include <vector_types.h>\n12\t\n13\t// Shared implementation for coset-based round0 launch configs.\n14\t// Template parameter COSET_PARALLEL controls grid organization:\n15\t// - false (lockstep): grid.y = 1, each thread handles all cosets via NUM_COSETS template\n16\t// - true (coset-parallel): grid.y = num_cosets, each block handles one coset\n17\tnamespace round0_config_impl {\n18\t\n19\ttemplate <bool COSET_PARALLEL>\n20\tinline std::pair<dim3, dim3> eval_constraints_launch_params(\n21\t    uint32_t buffer_size,\n22\t    uint32_t skip_domain,\n23\t    uint32_t num_x,\n24\t    uint32_t num_cosets,\n25\t    size_t max_temp_bytes,\n26\t    uint32_t buffer_threshold,\n27\t    uint32_t max_threads_per_block\n28\t) {\n29\t    // ASSERTION: full skip domain must fit in one block\n30\t    assert(skip_domain <= 1024 && \"skip_domain exceeds CUDA max threads per block (1024)\");\n31\t    auto max_threads = std::max(skip_domain, max_threads_per_block);\n32\t    auto [grid, block] = kernel_launch_params(skip_domain * num_x, max_threads);\n33\t\n34\t    if constexpr (COSET_PARALLEL) {\n35\t        grid.y = num_cosets; // 2D grid for coset-parallel mode\n36\t    }\n37\t    // grid.y = 1 implicitly for lockstep mode\n38\t\n39\t    // Both modes have the same total buffer size:\n40\t    // - Lockstep: grid.x * block.x * num_cosets * buffer_size\n41\t    // - Coset-parallel: grid.x * grid.y * block.x * buffer_size (where grid.y = num_cosets)\n42\t    size_t desired_intermed_capacity_bytes =\n43\t        buffer_size <= buffer_threshold\n44\t            ? 0\n45\t            : (size_t)grid.x * block.x * num_cosets * buffer_size * sizeof(Fp);\n46\t\n47\t    uint32_t num_x_per_thread = std::max(\n48\t        div_ceil(desired_intermed_capacity_bytes, std::max(max_temp_bytes, (size_t)1)), (size_t)1\n49\t    );\n50\t    if (num_x_per_thread <= grid.x) {\n51\t        grid.x = grid.x / num_x_per_thread;\n52\t    } else {\n53\t        grid.x = 1;\n54\t        block.x = std::max(num_x / num_x_per_thread, 1u) * skip_domain;\n55\t    }\n56\t\n57\t    return {grid, block};\n58\t}\n59\t\n60\ttemplate <bool COSET_PARALLEL>\n61\tinline uint32_t temp_sums_buffer_size(\n62\t    uint32_t buffer_size,\n63\t    uint32_t skip_domain,\n64\t    uint32_t num_x,\n65\t    uint32_t num_cosets,\n66\t    size_t max_temp_bytes,\n67\t    uint32_t buffer_threshold,\n68\t    uint32_t threads_per_block\n69\t) {\n70\t    auto [grid, _] = eval_constraints_launch_params<COSET_PARALLEL>(\n71\t        buffer_size,\n72\t        skip_domain,\n73\t        num_x,\n74\t        num_cosets,\n75\t        max_temp_bytes,\n76\t        buffer_threshold,\n77\t        threads_per_block\n78\t    );\n79\t    // Output layout: [num_blocks][num_cosets * skip_domain]\n80\t    return grid.x * num_cosets * skip_domain;\n81\t}\n82\t\n83\ttemplate <bool COSET_PARALLEL>\n84\tinline uint32_t intermediates_buffer_size(\n85\t    uint32_t buffer_size,\n86\t    uint32_t skip_domain,\n87\t    uint32_t num_x,\n88\t    uint32_t num_cosets,\n89\t    size_t max_temp_bytes,\n90\t    uint32_t buffer_threshold,\n91\t    uint32_t threads_per_block\n92\t) {\n93\t    if (buffer_size <= buffer_threshold) {\n94\t        return 0;\n95\t    }\n96\t    auto [grid, block] = eval_constraints_launch_params<COSET_PARALLEL>(\n97\t        buffer_size,\n98\t        skip_domain,\n99\t        num_x,\n100\t        num_cosets,\n101\t        max_temp_bytes,\n102\t        buffer_threshold,\n103\t        threads_per_block\n104\t    );\n105\t    // Layout: [buffer_size][num_threads][num_cosets]\n106\t    return grid.x * block.x * buffer_size * num_cosets;\n107\t}\n108\t\n109\t} // namespace 