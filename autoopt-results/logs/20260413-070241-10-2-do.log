    MAX_THREADS\n520\t    );\n521\t}\n522\t\n523\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n524\tint launch_zerocheck_ntt_evaluate_constraints(\n525\t    FpExt *tmp_sums_buffer,\n526\t    FpExt *output,\n527\t    const Fp *selectors_cube, // [3][num_x]\n528\t    const Fp *preprocessed,\n529\t    const Fp *const *main_parts,\n530\t    const FpExt *eq_cube, // [num_x]\n531\t    const FpExt *d_lambda_pows,\n532\t    const Fp *public_values,\n533\t    const Rule *d_rules,\n534\t    size_t rules_len,\n535\t    const size_t *d_used_nodes,\n536\t    size_t used_nodes_len,\n537\t    size_t lambda_len,\n538\t    uint32_t buffer_size,\n539\t    Fp *d_intermediates,\n540\t    uint32_t skip_domain,\n541\t    uint32_t num_x,\n542\t    uint32_t height,\n543\t    Fp g_shift,\n544\t    size_t max_temp_bytes\n545\t) {\n546\t    auto [grid, block] = coset_round0_config::eval_constraints_launch_params(\n547\t        buffer_size, skip_domain, num_x, NUM_COSETS, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n548\t    );\n549\t\n550\t    size_t shared_sum_size = sizeof(FpExt) * block.x;\n551\t    // NTT buffers: one skip_domain-sized buffer per x_int group in the block\n552\t    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n553\t    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n554\t\n555\t    zerocheck_ntt_evaluate_constraints_kernel<NUM_COSETS, GLOBAL, NEEDS_SHMEM>\n556\t        <<<grid, block, shmem_bytes>>>(\n557\t            tmp_sums_buffer,\n558\t            selectors_cube,\n559\t            preprocessed,\n560\t            main_parts,\n561\t            eq_cube,\n562\t            d_lambda_pows,\n563\t            public_values,\n564\t            d_rules,\n565\t            rules_len,\n566\t            d_used_nodes,\n567\t            used_nodes_len,\n568\t            lambda_len,\n569\t            buffer_size,\n570\t            d_intermediates,\n571\t            skip_domain,\n572\t            num_x,\n573\t            height,\n574\t  