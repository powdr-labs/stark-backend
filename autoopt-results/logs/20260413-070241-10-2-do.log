        1 << n_lift,\n175\t        height as u32,\n176\t        num_cosets_zc as u32,\n177\t        omega_root,\n178\t        w.max_temp_bytes,\n179\t    )?;\n180\t\n181\t    let zerocheck_poly = if !sum_buffer.is_empty() {\n182\t        let q_evals = sum_buffer.to_host_on_current_stream()?;\n183\t        let q = {\n184\t            let mut values = EF::zero_vec(num_cosets_zc << w.l_skip);\n185\t            for coset_idx in 0..num_cosets_zc {\n186\t                for i in 0..1 << w.l_skip {\n187\t                    values[i * num_cosets_zc + coset_idx] = q_evals[(coset_idx << w.l_skip) + i];\n188\t                }\n189\t            }\n190\t            UnivariatePoly::from_geometric_cosets_evals_idft(\n191\t                RowMajorMatrix::new(values, num_cosets_zc),\n192\t                omega_root,\n193\t                omega_root,\n194\t            )\n195\t        };\n196\t        let sp_0_deg = sumcheck_round0_deg(w.l_skip, local_constraint_deg);\n197\t        let coeffs = (0..=sp_0_deg)\n198\t            .map(|i| {\n199\t                let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n200\t                if i >= 1 << w.l_skip {\n201\t                    c += q.coeffs()[i - (1 << w.l_skip)];\n202\t                }\n203\t                c\n204\t            })\n205\t            .collect_vec();\n206\t        Some(UnivariatePoly::new(coeffs))\n207\t    } else {\n208\t        None\n209\t    };\n210\t\n211\t    let num_cosets_logup = local_constraint_deg;\n212\t    let sum = evaluate_round0_interactions_gpu(\n213\t        single_pk,\n214\t        &single_air_constraints,\n215\t        w.selectors_cube.buffer(),\n216\t        &d_main_parts,\n217\t        w.public_values,\n218\t        eq_xi_tree.get_ptr(n_lift),\n219\t        w.beta_pows,\n220\t        w.eq_3bs,\n221\t        1 << w.l_skip,\n222\t        1 << n_lift,\n223\t        height as u32,\n224\t        num_cosets_logup as u32,\n225\t        omega_root,\n226\t        w.max_temp_bytes,\n227\t    )?;\n228\