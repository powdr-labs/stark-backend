{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014sKh5jxZGu98Ecw41eoGXL","type":"tool_result","content":"1\t#pragma once\n2\t\n3\t#include \"fp.h\"\n4\t#include <cstdint>\n5\t\n6\tconstexpr uint32_t LOG_WARP_SIZE = 5;\n7\t\n8\t/// Compute x^{2^power_log} by repeated squaring.\n9\t__device__ __forceinline__ Fp exp_power_of_2(Fp x, uint32_t power_log) {\n10\t    Fp res = x;\n11\t    while (power_log--) {\n12\t        res.sqr();\n13\t    }\n14\t    return res;\n15\t}\n16\t\n17\t// Given x and 2^n, computes 1/2^n * (1 + x + ... + x^{2^n - 1}).\n18\t__device__ __forceinline__ Fp avg_gp(Fp x, uint32_t n) {\n19\t#ifdef CUDA_DEBUG\n20\t    assert(n && !(n & (n - 1)));\n21\t#endif\n22\t    Fp res = Fp::one();\n23\t    for (uint32_t i = 1; i < n; i <<= 1) {\n24\t        res *= Fp::one() + x;\n25\t        res = res.halve();\n26\t        x *= x;\n27\t    }\n28\t    return res;\n29\t}\n30\t\n31\t/// Assuming `x` is a `len`-bit number, reverses its `len` bits.\n32\t__device__ __forceinline__ uint32_t rev_len(uint32_t x, uint32_t len) {\n33\t    return __brev(x) >> (32 - len);\n34\t}\n35\t\n36\t__device__ __forceinline__ uint32_t with_rev_bits(uint32_t x, uint32_t buf_size) { return x; }\n37\t\n38\t/// Given an index and the buffer size (must be a power of two), turns on some last bits as provided.\n39\t/// Example: with_rev_bits(0b110, 32, 1, 0) == 0b10110.\n40\ttemplate <typename... Bool>\n41\t__device__ __forceinline__ uint32_t\n42\twith_rev_bits(uint32_t x, uint32_t buf_size, bool first, Bool &&...others) {\n43\t    buf_size >>= 1;\n44\t    return with_rev_bits(x | (first * buf_size), buf_size, others...);\n45\t}\n46\t\n47\t#define DISPATCH_BOOL(func, b1, ...) ((b1) ? func<true>(__VA_ARGS__) : func<false>(__VA_ARGS__))\n48\t\n49\t// Dispatch helper for two bool template parameters\n50\t#define DISPATCH_BOOL_PAIR(func, b1, b2, ...)                                                      \\\n51\t    ((b1) ? ((b2) ? func<true, true>(__VA_ARGS__) : func<true, false>(__VA_ARGS__))                \\\n52\t          : ((b2) ? func<false, true>(__VA_ARGS__) : func<false, false>(__VA_ARGS__)))\n53\t\n54\t// Generic dispatcher for <uint32_t N, bool B1, bool B2> template functions.\n55\t// Generates recursive template to dispatch runtime n (1..MAX_N) to compile-time N.\n56\t// Usage: DEFINE_DISPATCH_N_B1_B2(dispatcher_name, target_func, MAX_N)\n57\t// Then call: dispatcher_name(n, b1, b2, args...)\n58\t#define DEFINE_DISPATCH_N_B1_B2(name, func, max_n)                                                 \\\n59\t    template <uint32_t N, typename... Args>                                                        \\\n60\t    inline int name##_impl(uint32_t n, bool b1, bool b2, Args &&...args) {                         \\\n61\t        if (n == N) {                                                                              \\\n62\t            if (b1) {                                                                              \\\n63\t                return b2 ? func<N, true, true>(std::forward<Args>(args)...)                       \\\n64\t                          : func<N, true, false>(std::forward<Args>(args)...);                     \\\n65\t            } else {                                                                               \\\n66\t                return b2 ? func<N, false, true>(std::forward<Args>(args)...)                      \\\n67\t                          : func<N, false, false>(std::forward<Args>(args)...);                    \\\n68\t            }                                                                                      \\\n69\t        } else if constexpr (N == 1) {                                                             \\\n70\t            return -1;                                                                             \\\n71\t        } else {                                                                                   \\\n72\t            return name##_impl<N - 1>(n, b1, b2, std::fo