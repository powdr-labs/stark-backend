n48\t    InPlaceWork,\n49\t}\n50\t\n51\t/// Encapsulates ping-pong buffer scheduling state for GKR inner rounds.\n52\t///\n53\t/// This struct manages the decision of whether to use in-place or out-of-place\n54\t/// (ping-pong) kernel variants based on buffer capacities and current data location.\n55\tstruct BufferScheduler {\n56\t    /// True if data currently resides in work_buffer, false if in layer.\n57\t    data_in_work_buffer: bool,\n58\t    /// Maximum capacity of work_buffer in elements.\n59\t    work_buffer_cap: usize,\n60\t}\n61\t\n62\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n63\tenum GkrRoundStrategy {\n64\t    FoldEval,\n65\t    PrecomputeM,\n66\t}\n67\t\n68\tconst PRECOMPUTE_M_TAIL_TILE: usize = 4096;\n69\tconst PRECOMPUTE_M_MIN_TAIL_TILE: usize = 256;\n70\tconst PRECOMPUTE_M_DEFAULT_MIN_BLOCKS: usize = 64;\n71\tconst PRECOMPUTE_M_DEFAULT_TARGET_BLOCKS: usize = 1024;\n72\t\n73\timpl BufferScheduler {\n74\t    /// Creates a new scheduler with data initially in layer buffer.\n75\t    fn new(work_buffer_cap: usize) -> Self {\n76\t        Self {\n77\t            data_in_work_buffer: false,\n78\t            work_buffer_cap,\n79\t        }\n80\t    }\n81\t\n82\t    /// Returns true if we can use ping-pong (out-of-place) for the given post-fold size.\n83\t    fn can_pingpong(&self, post_fold_size: usize) -> bool {\n84\t        post_fold_size <= self.work_buffer_cap\n85\t    }\n86\t\n87\t    /// Determines the next buffer target for a fused compute+fold operation.\n88\t    ///\n89\t    /// For last outer round: uses ping-pong when possible for __restrict__ optimization.\n90\t    /// For non-last outer rounds: preserves layer for tree revert operations.\n91\t    fn next_target(&mut self, post_fold_size: usize, last_outer_round: bool) -> BufferTarget {\n92\t        let can_pingpong = self.can_pingpong(post_fold_size);\n93\t\n94\t        if last_outer_round {\n95\t            if can_pingpong {\n96\t                // Ping-pong to other buffer\n97\t                if self.data_in_work_buffer {\n98\t                    self.data_in_work_buffer = false;\n99\t                    BufferTarget::WorkToLayer\n100\t                } else {"}]},"parent_tool_use_id":"toolu_014r6CDpsraiWwtTVcuGYQQZ","session_id":"6086bd80-4e0d-45db-9a25-2370973b0822","uuid":"5ae4cd54-6599-481f-8313-e3f9d1bbb673","timestamp":"2026-04-14T18:10:41.471Z"}
