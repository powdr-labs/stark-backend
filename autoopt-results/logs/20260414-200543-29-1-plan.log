lts/2026-04-14-0830-batch-scatter-gkr-input-eval/report.md","autoopt-results/2026-04-14-1200-bulk-alloc-mle-fold-buffers/report.md","autoopt-results/2026-04-14-1430-warp-tiled-gkr-intermediates/report.md","autoopt-results/2026-04-14-1630-pingpong-mle-fold-buffers/report.md","autoopt-results/2026-04-14-1800-gpu-gkr-transcript-processing/report.md","autoopt-results/2026-04-14-2000-matrix-base-ptr-interpolation/report.md"],"durationMs":15,"numFiles":28,"truncated":false}}
