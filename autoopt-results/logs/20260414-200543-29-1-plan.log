][1] = host[i].q;\n1865\t            }\n1866\t        }\n1867\t        let late_mono_traces: Vec<_> = late_eval\n1868\t            .iter()\n1869\t            .filter(|t| trace_has_monomials(t, self.pk))\n1870\t            .collect();\n1871\t        if !late_mono_traces.is_empty() {\n1872\t            let lambda_combs: Vec<_> = late_mono_traces\n1873\t                .iter()\n1874\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1875\t                .collect();\n1876\t            let batch = ZerocheckMonomialBatch::new(late_mono_traces, self.pk, &lambda_combs)?;\n1877\t            let out = batch\n1878\t                .evaluate(1)\n1879\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1880\t            let host = out.to_host()?;\n1881\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1882\t                self.zerocheck_tilde_evals[trace_idx] = host[i];\n1883\t                // zc_out not set for num_x=1, handled from tilde_eval in compute_batch_s\n1884\t            }\n1885\t        }\n1886\t\n1887\t        // Logup for early traces: partition by num_y threshold\n1888\t        if !early_eval.is_empty() {\n1889\t            evaluate_logup_batched(\n1890\t                &early_eval,\n1891\t                self.pk,\n1892\t                d_challenges_ptr,\n1893\t                sp_deg as u32,\n1894\t                self.monomial_num_y_threshold,\n1895\t                &self.logup_combinations,\n1896\t                &mut logup_out,\n1897\t                &mut self.logup_tilde_evals,\n1898\t                self.memory_limit_bytes,\n1899\t            )\n1900\t            .map_err(LogupZerocheckError::MleInteractionEval)?;\n1901\t        }\n1902\t\n1903\t        // Early traces (num_y>1): partition by threshold for zerocheck path\n1904\t        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n1905\t            .iter()\n1906\t            .filter(|t| t.has_constraints)\n1907\t            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n1908\t\n1909\t        // Partition high num_y traces by monomial-to-rules ratio\n1910\t        // (traces without monomials are skipped - they contribute zero)\n1911\t        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n1912\t            high_early.iter().partition(|t| {\n1913\t                let num_monomials = get_num_monomials(t, self.pk);\n1914\t                let rules_len = get_zerocheck_rules_len(t, self.pk);\n1915\t                // Use DAG when monomial expansion significantly increased the term count\n1916\t                num_monomials as usize >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len\n1917\t            });\n1918\t\n1919\t        // DAG evaluation for high num_y traces with high monomial-to-rules ratio\n1920\t        if !high_dag_traces.is_empty() {\n1921\t            let lambda_pows = self.lambda_pows.as_ref().unwrap();\n1922\t            evaluate_zerocheck_batched(\n1923\t                high_dag_traces,\n1924\t                self.pk,\n1925\t                lambda_pows,\n1926\t                sp_deg as u32,\n1927\t                &mut zc_out,\n1928\t                self.memory_limit_bytes,\n1929\t            )\n1930\t            .map_err(LogupZerocheckError::MleConstraintEval)?;\n1931\t        }\n1932\t\n1933\t        // Par-Y monomial kernel for high num_y traces\n1934\t        if !high_mono_traces.is_empty() {\n1935\t            let lambda_combs: Vec<_> = high_mono_traces\n1936\t                .iter()\n1937\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1938\t                .collect();\n1939\t            let batch = ZerocheckMonomialParYBatch::new(\n1940\t                high_mono_traces,\n1941\t                self.pk,\n1942\t                &lambda_combs,\n1943\t                self.sm_count,\n1944\t                sp_deg as u32,\n1945\t                None,\n1946\t            )?;\n1947\t            