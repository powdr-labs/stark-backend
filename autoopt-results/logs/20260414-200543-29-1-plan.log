{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VfWv12ekf2KL361BTFhGwQ","type":"tool_result","content":"419\t    zc_out: &mut [Vec<EF>],\n420\t    memory_limit_bytes: usize,\n421\t) -> Result<(), KernelError> {\n422\t    // Collect traces with constraints and their buffer sizes\n423\t    let mut zc_traces_with_size: Vec<(&TraceCtx, usize)> = traces\n424\t        .into_iter()\n425\t        .filter(|t| t.has_constraints)\n426\t        .map(|t| {\n427\t            let buffer_size = pk.per_air[t.air_idx]\n428\t                .other_data\n429\t                .zerocheck_mle\n430\t                .inner\n431\t                .buffer_size;\n432\t            let mem = zerocheck_batch_mle_intermediates_buffer_bytes(buffer_size, num_x, t.num_y);\n433\t            (t, mem)\n434\t        })\n435\t        .collect();\n436\t    if zc_traces_with_size.is_empty() {\n437\t        return Ok(());\n438\t    }\n439\t\n440\t    // Sort by buffer size descending for better bin packing (First Fit Decreasing)\n441\t    zc_traces_with_size.sort_by(|a, b| b.1.cmp(&a.1));\n442\t\n443\t    let num_x_usize = num_x as usize;\n444\t    let mut batch_start = 0;\n445\t\n446\t    while batch_start < zc_traces_with_size.len() {\n447\t        let (batch_count, batch_memory) = find_batch_end(\n448\t            &zc_traces_with_size[batch_start..],\n449\t            |(_, mem)| *mem,\n450\t            memory_limit_bytes,\n451\t        );\n452\t        let batch: Vec<&TraceCtx> = zc_traces_with_size[batch_start..batch_start + batch_count]\n453\t            .iter()\n454\t            .map(|(t, _)| *t)\n455\t            .collect();\n456\t\n457\t        if batch.len() == 1 {\n458\t            // Single trace: use non-batch kernel\n459\t            let t = batch[0];\n460\t            if batch_memory > memory_limit_bytes {\n461\t                tracing::warn!(\n462\t                    air_idx = t.air_idx,\n463\t                    intermediate_buffer_bytes = batch_memory,\n464\t                    memory_limit_bytes,\n465\t                    \"zerocheck: trace exceeds memory limit, using non-batch kernel\"\n466\t                );\n467\t            }\n468\t            let rules = &pk.per_air[t.air_idx].other_data.zerocheck_mle;\n469\t            let out = evaluate_mle_constraints_gpu(\n470\t                t.eq_xi_ptr,\n471\t                t.sels_ptr,\n472\t                t.prep_ptr,\n473\t                &t.main_ptrs_dev,\n474\t                t.public_ptr,\n475\t                lambda_pows,\n476\t                rules,\n477\t                t.num_y,\n478\t                num_x,\n479\t            )?;\n480\t            let out_host = out.to_host()?;\n481\t            zc_out[t.trace_idx].copy_from_slice(&out_host);\n482\t        } else {\n483\t            // Normal batch using ZerocheckMleBatchBuilder\n484\t            tracing::debug!(\n485\t                batch_size = batch.len(),\n486\t                batch_memory,\n487\t                memory_limit_bytes,\n488\t                \"zerocheck: batching traces\"\n489\t            );\n490\t            let builder = ZerocheckMleBatchBuilder::new(batch.iter().copied(), pk, num_x)?;\n491\t            let out = builder.evaluate(lambda_pows, num_x)?;\n492\t            let host = out.to_host()?;\n493\t\n494\t            for (i, trace_idx) in builder.trace_indices().enumerate() {\n495\t                let evals = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n496\t                zc_out[trace_idx].copy_from_slice(evals);\n497\t            }\n498\t        }\n499\t        batch_start += batch_count;\n500\t    }\n501\t    Ok(())\n502\t}\n503\t\n504\t#[allow(clippy::too_many_arguments)]\n505\tpub(crate) fn evaluate_logup_batched<HS: GpuHashScheme>(\n506\t    traces: &[TraceCtx],\n507\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n508\t    d_challenges_ptr: *const EF,\n509\t    num_x: u32,\n510\t    monomial_num_y_threshold: u32,\n511\t    logup_combinations: &[Option<LogupCombinations>],\n512\t    logup_out: &mut [[Vec<EF>; 2]],\n513\t    logup_tilde_evals: &mut [[EF; 2]],\n514\t    memory_limit_bytes: usize,\n515\t) -> Result<(), KernelError> {\n516\t    let (low_traces, high_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) = traces\n517\t        .iter()\n518\t        .filter(|t| t.has_interactions)\n519\t        .partition(|t| t.num_y <= monomial_num_y_threshold);\n520\t\n521\t    if !low_traces.is_empty() {\n522\t        let logup_combs: Vec<_> = low_traces\n523\t            .iter()\n524\t            .map(|t| logup_combinations[t.trace_idx].as_ref().unwrap())\n525\t            .collect();\n526\t        let batch = LogupMonomialBatch::new(low_traces.iter().copied(), pk, &logup_combs)?;\n527\t        let out = batch.evaluate(num_x)?;\n528\t        let host = out.to_host()?;\n529\t        let num_x_usize = num_x as usize;\n530\t        for (i, trace_idx) in batch.trace_indices().enumerate() {\n531\t            let fracs = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n532\t            let norm = low_traces[i].norm_factor;\n533\t            if num_x == 1 {\n534\t                logup_tilde_evals[trace_idx][0] = fracs[0].p * norm;\n535\t                logup_tilde_evals[trace_idx][1] = fracs[0].q;\n536\t            } else {\n537\t                for (j, frac) in fracs.iter().enumerate() {\n538\t                    logup_out[trace_idx][0][j] = frac.p * norm;\n539\t                    logup_out[trace_idx][1][j] = frac.q;\n540\t                }\n541\t            }\n542\t        }\n543\t    }\n544\t\n545\t    if high_traces.is_empty() {\n546\t        return Ok(());\n547\t    }\n548\t\n549\t    // Collect high traces with interactions and their buffer sizes\n550\t    let mut logup_traces_with_size: Vec<(&TraceCtx, usize)> = high_traces\n551\t        .iter()\n552\t        .copied()\n553\t        .map(|t| {\n554\t            let buffer_size = pk.per_air[t.air_idx]\n555\t                .other_data\n556\t                .interaction_rules\n557\t                .inner\n558\t                .buffer_size;\n559\t            let mem = logup_batch_mle_intermediates_buffer_bytes(buffer_size, num_x, t.num_y);\n560\t            (t, mem)\n561\t        })\n562\t        .collect();\n563\t\n564\t    // Sort by buffer size descending for better bin packing (First Fit Decreasing)\n565\t    logup_traces_with_size.sort_by(|a, b| b.1.cmp(&a.1));\n566\t\n567\t    let num_x_usize = num_x as usize;\n568\t    let mut batch_start = 0;\n569\t\n570\t    while batch_start < logup_traces_with_size.len() {\n571\t        let (batch_count, batch_memory) = find_batch_end(\n572\t            &logup_traces_with_size[batch_start..],\n573\t            |(_, mem)| *mem,\n574\t            memory_limit_bytes,\n575\t        );\n576\t        let batch: Vec<&TraceCtx> = logup_traces_with_size[batch_start..batch_start + batch_count]\n577\t            .iter()\n578\t            .map(|(t, _)| *t)\n579\t            .collect();\n580\t\n581\t        if batch.len() == 1 && batch_memory > memory_limit_bytes {\n582\t            // Single oversized trace: use non-batch kernel\n583\t            let t = batch[0];\n584\t            tracing::warn!(\n585\t                air_idx = t.air_idx,\n586\t                intermediate_buffer_bytes = batch_memory,\n587\t                memory_limit_bytes,\n588\t                \"logup: trace exceeds memory limit, using non-batch kernel\"\n589\t            );\n590\t            evaluate_single_logup(\n591\t                t,\n592\t                pk,\n593\t                d_challenges_ptr,\n594\t                num_x,\n595\t                &mut logup_out[t.trace_idx],\n596\t                &mut logup_tilde_evals[t.trace_idx],\n597\t            )?;\n598\t        } else {\n599\t            // Normal batch using LogupMleBatchBuilder\n600\t            tracing::debug!(\n601\t                batch_size = batch.len(),\n602\t                batch_memory,\n603\t                memory_limit_bytes,\n604\t                \"logup: batching traces\"\n605\t            );\n606\t            let builder =\n607\t                LogupMleBatchBuilder::new(batch.iter().copied(), pk, d_challenges_ptr, num_x)?;\n608\t            let out = builder.evaluate(num_x)?;\n609\t            let host = out.to_host()?;\n610\t\n611\t            for (i, (trace_idx, norm_factor)) in builder.trace_info().enumerate() {\n612\t                let fracs = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n613\t                if num_x == 1 {\n614\t                    logup_tilde_evals[trace_idx][0] = fracs[0].p * norm_factor;\n615\t                    logup_tilde_evals[trace_idx][1] = fracs[0].q;\n616\t                } else {\n617\t                    let numer: Vec<EF> = fracs.iter().map(|f| f.p * norm_factor).collect();\n618\t                    let denom: Vec<EF> = fracs.iter().map(|f| f.q).collect();\n619\t                    logup_out[trace_idx] = [numer, denom];\n620\t                }\n621\t            }\n622\t        }\n623\t        batch_start += batch_count;\n624\t    }\n625\t    Ok(())\n626\t}\n627\t\n628\t/// Evaluate logup for a single trace using non-batch kernel.\n629\tfn evaluate_single_logup<HS: GpuHashScheme>(\n630\t    t: &TraceCtx,\n631\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n632\t    d_challenges_ptr: *const EF,\n633\t    num_x: u32,\n634\t    logup_out: &mut [Vec<EF>; 2],\n635\t    logup_tilde_eval: &mut [EF; 2],\n636\t) -> Result<(), KernelError> {\n637\t    let air_pk = &pk.per_air[t.air_idx];\n638\t    let out = evaluate_mle_interactions_gpu(\n639\t        t.eq_xi_ptr,\n640\t        t.sels_ptr,\n641\t        t.prep_ptr,\n642\t        &t.main_ptrs_dev,\n643\t        t.public_ptr,\n644\t        d_challenges_ptr,\n645\t        t.eq_3bs_ptr,\n646\t        &air_pk.other_data.interaction_rules,\n647\t        t.num_y,\n648\t        num_x,\n649\t    )?;\n650\t    let fracs = out.to_host()?;\n651\t\n652\t    if num_x == 1 {\n653\t        logup_tilde_eval[0] = fracs[0].p * t.norm_factor;\n654\t        logup_tilde_eval[1] = fracs[0].q;\n655\t        // logup_out not set, will be handled directly from tilde eval in compute_batch_s\n656\t    } else {\n657\t        let numer: Vec<EF> = fracs.iter().map(|f| f.p * t.norm_factor).collect();\n658\t        let denom: Vec<EF> = fracs.iter().map(|f| f.q).collect();\n659\t        *logup_out = [numer, denom];\n660\t    }\n661\t    Ok(())\n662\t}\n663\t\n664\t// ============================================================================\n665\t// FFI wrappers\n666\t// ============================================================================\n667\t\n668\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n669\tfn evaluate_mle_constraints_gpu_batch(\n670\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n671\t    zc_ctxs: &DeviceBuffer<ZerocheckCtx>,\n672\t    air_block_offsets: &DeviceBuffer<u32>,\n673\t    lambda_pows: &DeviceBuffer<EF>,\n674\t    lambda_len: usize,\n675\t    num_x: u32,\n676\t    threads_per_block: u32,\n677\t) -> Result<DeviceBuffer<EF>, KernelError> {\n678\t    let num_blocks = block_ctxs.len();\n679\t    let num_airs = zc_ctxs.len();\n680\t    tracing::debug!(\n681\t        %num_blocks,\n682\t        %num_x,\n683\t        %threads_per_block,\n684\t        %num_airs,\n685\t        \"zerocheck_batch_eval_mle\"\n686\t    );\n687\t    // Need one buffer slot per block\n688\t    let mut tmp_sums_buffer = DeviceBuffer::<EF>::with_capacity(num_blocks * num_x as usize);\n689\t    let mut output = DeviceBuffer::<EF>::with_capacity(num_airs * num_x as usize);\n690\t    unsafe {\n691\t        zerocheck_batch_eval_mle(\n692\t            &mut tmp_sums_buffer,\n693\t            &mut output,\n694\t            block_ctxs,\n695\t            zc_ctxs,\n696\t            air_block_offsets,\n697\t            lambda_pows,\n698\t            lambda_len,\n699\t            num_blocks as u32,\n700\t            num_x,\n701\t            num_airs as u32,\n702\t            threads_per_block,\n703\t        )?;\n704\t    }\n705\t    Ok(output)\n706\t}\n707\t\n708\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n709\tfn evaluate_mle_interactions_gpu_batch(\n710\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n711\t    logup_ctxs: &DeviceBuffer<LogupCtx>,\n712\t    air_block_offsets: &DeviceBuffer<u32>,\n713\t    num_x: u32,\n714\t    threads_per_block: u32,\n715\t) -> Result<DeviceBuffer<Frac<EF>>, KernelError> {\n716\t    let num_blocks = block_ctxs.len();\n717\t    let num_airs = logup_ctxs.len();\n718\t    // Need one buffer slot per block\n719\t    let mut tmp_sums_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(num_blocks * num_x as usize);\n720\t    let mut output = DeviceBuffer::<Frac<EF>>::with_capacity(num_airs * num_x as usize);\n721\t    unsafe {\n722\t        logup_batch_eval_mle(\n723\t            &mut tmp_sums_buffer,\n724\t            &mut output,\n725\t            block_ctxs,\n726\t            logup_ctxs,\n727\t            air_block_offsets,\n728\t            num_blocks as u32,\n729\t            num_x,\n730\t            num_airs as u32,\n731\t            threads_per_block,\n732\t        )?;\n733\t    }\n734\t    Ok(output)\n735\t}\n736\t"}]},"parent_tool_use_id":null,"session_id":"6086bd80-4e0d-45db-9a25-2370973b0822","uuid":"62723b92-0fc7-49f9-8e58-48c16bfd59ea","timestamp":"2026-04-14T21:02:32.639Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/batch_mle.rs","content":"    zc_out: &mut [Vec<EF>],\n    memory_limit_bytes: usize,\n) -> Result<(), KernelError> {\n    // Collect traces with constraints and their buffer sizes\n    let mut zc_traces_with_size: Vec<(&TraceCtx, usize)> = traces\n        .into_iter()\n        .filter(|t| t.has_constraints)\n        .map(|t| {\n            let buffer_size = pk.per_air[t.air_idx]\n                .other_data\n                .zerocheck_mle\n                .inner\n                .buffer_size;\n            let mem = zerocheck_batch_mle_intermediates_buffer_bytes(buffer_size, num_x, t.num_y);\n            (t, mem)\n        })\n        .collect();\n    if zc_traces_with_size.is_empty() {\n        return Ok(());\n    }\n\n    // Sort by buffer size descending for better bin packing (First Fit Decreasing)\n    zc_traces_with_size.sort_by(|a, b| b.1.cmp(&a.1));\n\n    let num_x_usize = num_x as usize;\n    let mut batch_start = 0;\n\n    while batch_start < zc_traces_with_size.len() {\n        let (batch_count, batch_memory) = find_batch_end(\n            &zc_traces_with_size[batch_start..],\n            |(_, mem)| *mem,\n            memory_limit_bytes,\n        );\n        let batch: Vec<&TraceCtx> = zc_traces_with_size[batch_start..batch_start + batch_count]\n            .iter()\n            .map(|(t, _)| *t)\n            .collect();\n\n        if batch.len() == 1 {\n            // Single trace: use non-batch kernel\n            let t = batch[0];\n            if batch_memory > memory_limit_bytes {\n                tracing::warn!(\n                    air_idx = t.air_idx,\n                    intermediate_buffer_bytes = batch_memory,\n                    memory_limit_bytes,\n                    \"zerocheck: trace exceeds memory limit, using non-batch kernel\"\n                );\n            }\n            let rules = &pk.per_air[t.air_idx].other_data.zerocheck_mle;\n            let out = evaluate_mle_constraints_gpu(\n                t.eq_xi_ptr,\n                t.sels_ptr,\n                t.prep_ptr,\n                &t.main_ptrs_dev,\n                t.public_ptr,\n                lambda_pows,\n                rules,\n                t.num_y,\n                num_x,\n            )?;\n            let out_host = out.to_host()?;\n            zc_out[t.trace_idx].copy_from_slice(&out_host);\n        } else {\n            // Normal batch using ZerocheckMleBatchBuilder\n            tracing::debug!(\n                batch_size = batch.len(),\n                batch_memory,\n                memory_limit_bytes,\n                \"zerocheck: batching traces\"\n            );\n            let builder = ZerocheckMleBatchBuilder::new(batch.iter().copied(), pk, num_x)?;\n            let out = builder.evaluate(lambda_pows, num_x)?;\n            let host = out.to_host()?;\n\n            for (i, trace_idx) in builder.trace_indices().enumerate() {\n                let evals = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n                zc_out[trace_idx].copy_from_slice(evals);\n            }\n        }\n        batch_start += batch_count;\n    }\n    Ok(())\n}\n\n#[allow(clippy::too_many_arguments)]\npub(crate) fn evaluate_logup_batched<HS: GpuHashScheme>(\n    traces: &[TraceCtx],\n    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n    d_challenges_ptr: *const EF,\n    num_x: u32,\n    monomial_num_y_threshold: u32,\n    logup_combinations: &[Option<LogupCombinations>],\n    logup_out: &mut [[Vec<EF>; 2]],\n    logup_tilde_evals: &mut [[EF; 2]],\n    memory_limit_bytes: usize,\n) -> Result<(), KernelError> {\n    let (low_traces, high_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) = traces\n        .iter()\n        .filter(|t| t.has_interactions)\n        .partition(|t| t.num_y <= monomial_num_y_threshold);\n\n    if !low_traces.is_empty() {\n        let logup_combs: Vec<_> = low_traces\n            .iter()\n            .map(|t| logup_combinations[t.trace_idx].as_ref().unwrap())\n            .collect();\n        let batch = LogupMonomialBatch::new(low_traces.iter().copied(), pk, &logup_combs)?;\n        let out = batch.evaluate(num_x)?;\n        let host = out.to_host()?;\n        let num_x_usize = num_x as usize;\n        for (i, trace_idx) in batch.trace_indices().enumerate() {\n            let fracs = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n            let norm = low_traces[i].norm_factor;\n            if num_x == 1 {\n                logup_tilde_evals[trace_idx][0] = fracs[0].p * norm;\n                logup_tilde_evals[trace_idx][1] = fracs[0].q;\n            } else {\n                for (j, frac) in fracs.iter().enumerate() {\n                    logup_out[trace_idx][0][j] = frac.p * norm;\n                    logup_out[trace_idx][1][j] = frac.q;\n                }\n            }\n        }\n    }\n\n    if high_traces.is_empty() {\n        return Ok(());\n    }\n\n    // Collect high traces with interactions and their buffer sizes\n    let mut logup_traces_with_size: Vec<(&TraceCtx, usize)> = high_traces\n        .iter()\n        .copied()\n        .map(|t| {\n            let buffer_size = pk.per_air[t.air_idx]\n                .other_data\n                .interaction_rules\n                .inner\n                .buffer_size;\n            let mem = logup_batch_mle_intermediates_buffer_bytes(buffer_size, num_x, t.num_y);\n            (t, mem)\n        })\n        .collect();\n\n    // Sort by buffer size descending for better bin packing (First Fit Decreasing)\n    logup_traces_with_size.sort_by(|a, b| b.1.cmp(&a.1));\n\n    let num_x_usize = num_x as usize;\n    let mut batch_start = 0;\n\n    while batch_start < logup_traces_with_size.len() {\n        let (batch_count, batch_memory) = find_batch_end(\n            &logup_traces_with_size[batch_start..],\n            |(_, mem)| *mem,\n            memory_limit_bytes,\n        );\n        let batch: Vec<&TraceCtx> = logup_traces_with_size[batch_start..batch_start + batch_count]\n            .iter()\n            .map(|(t, _)| *t)\n            .collect();\n\n        if batch.len() == 1 && batch_memory > memory_limit_bytes {\n            // Single oversized trace: use non-batch kernel\n            let t = batch[0];\n            tracing::warn!(\n                air_idx = t.air_idx,\n                intermediate_buffer_bytes = batch_memory,\n                memory_limit_bytes,\n                \"logup: trace exceeds memory limit, using non-batch kernel\"\n            );\n            evaluate_single_logup(\n                t,\n                pk,\n                d_challenges_ptr,\n                num_x,\n                &mut logup_out[t.trace_idx],\n                &mut logup_tilde_evals[t.trace_idx],\n            )?;\n        } else {\n            // Normal batch using LogupMleBatchBuilder\n            tracing::debug!(\n                batch_size = batch.len(),\n                batch_memory,\n                memory_limit_bytes,\n                \"logup: batching traces\"\n            );\n            let builder =\n                LogupMleBatchBuilder::new(batch.iter().copied(), pk, d_challenges_ptr, num_x)?;\n            let out = builder.evaluate(num_x)?;\n            let host = out.to_host()?;\n\n            for (i, (trace_idx, norm_factor)) in builder.trace_info().enumerate() {\n                let fracs = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n                if num_x == 1 {\n                    logup_tilde_evals[trace_idx][0] = fracs[0].p * norm_factor;\n                    logup_tilde_evals[trace_idx][1] = fracs[0].q;\n                } else {\n                    let numer: Vec<EF> = fracs.iter().map(|f| f.p * norm_factor).collect();\n                    let denom: Vec<EF> = fracs.iter().map(|f| f.q).collect();\n                    logup_out[trace_idx] = [numer, denom];\n                }\n            }\n        }\n        batch_start += batch_count;\n    }\n    Ok(())\n}\n\n/// Evaluate logup for a single trace using non-batch kernel.\nfn evaluate_single_logup<HS: GpuHashScheme>(\n    t: &TraceCtx,\n    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n    d_challenges_ptr: *const EF,\n    num_x: u32,\n    logup_out: &mut [Vec<EF>; 2],\n    logup_tilde_eval: &mut [EF; 2],\n) -> Result<(), KernelError> {\n    let air_pk = &pk.per_air[t.air_idx];\n    let out = evaluate_mle_interactions_gpu(\n        t.eq_xi_ptr,\n        t.sels_ptr,\n        t.prep_ptr,\n        &t.main_ptrs_dev,\n        t.public_ptr,\n        d_challenges_ptr,\n        t.eq_3bs_ptr,\n        &air_pk.other_data.interaction_rules,\n        t.num_y,\n        num_x,\n    )?;\n    let fracs = out.to_host()?;\n\n    if num_x == 1 {\n        logup_tilde_eval[0] = fracs[0].p * t.norm_factor;\n        logup_tilde_eval[1] = fracs[0].q;\n        // logup_out not set, will be handled directly from tilde eval in compute_batch_s\n    } else {\n        let numer: Vec<EF> = fracs.iter().map(|f| f.p * t.norm_factor).collect();\n        let denom: Vec<EF> = fracs.iter().map(|f| f.q).collect();\n        *logup_out = [numer, denom];\n    }\n    Ok(())\n}\n\n// ============================================================================\n// FFI wrappers\n// ============================================================================\n\n/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\nfn evaluate_mle_constraints_gpu_batch(\n    block_ctxs: &DeviceBuffer<BlockCtx>,\n    zc_ctxs: &DeviceBuffer<ZerocheckCtx>,\n    air_block_offsets: &DeviceBuffer<u32>,\n    lambda_pows: &DeviceBuffer<EF>,\n    lambda_len: usize,\n    num_x: u32,\n    threads_per_block: u32,\n) -> Result<DeviceBuffer<EF>, KernelError> {\n    let num_blocks = block_ctxs.len();\n    let num_airs = zc_ctxs.len();\n    tracing::debug!(\n        %num_blocks,\n        %num_x,\n        %threads_per_block,\n        %num_airs,\n        \"zerocheck_batch_eval_mle\"\n    );\n    // Need one buffer slot per block\n    let mut tmp_sums_buffer = DeviceBuffer::<EF>::with_capacity(num_blocks * num_x as usize);\n    let mut output = DeviceBuffer::<EF>::with_capacity(num_airs * num_x as usize);\n    unsafe {\n        zerocheck_batch_eval_mle(\n            &mut tmp_sums_buffer,\n            &mut output,\n            block_ctxs,\n            zc_ctxs,\n            air_block_offsets,\n            lambda_pows,\n            lambda_len,\n            num_blocks as u32,\n            num_x,\n            num_airs as u32,\n            threads_per_block,\n        )?;\n    }\n    Ok(output)\n}\n\n/// See [`crate::logup