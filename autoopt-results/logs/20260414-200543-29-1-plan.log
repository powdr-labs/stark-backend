{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013xtexyWNsFcmPdq6VPr2TC","type":"tool_result","content":"1\tuse std::sync::Arc;\n2\t\n3\tuse getset::Getters;\n4\tuse itertools::Itertools;\n5\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer, memory_manager::MemTracker};\n6\tuse openvm_stark_backend::{\n7\t    p3_util::log2_strict_usize,\n8\t    prover::{stacked_pcs::StackedLayout, MatrixDimensions},\n9\t};\n10\tuse tracing::instrument;\n11\t\n12\tuse crate::{\n13\t    base::{DeviceMatrix, DeviceMatrixView},\n14\t    cuda::{\n15\t        batch_ntt_small::batch_ntt_small,\n16\t        matrix::{batch_expand_pad, stack_columns, StackColDesc},\n17\t        ntt::bit_rev,\n18\t    },\n19\t    hash_scheme::GpuMerkleHash,\n20\t    merkle_tree::{MerkleTreeConstructor, MerkleTreeGpu},\n21\t    ntt::batch_ntt,\n22\t    poly::{mle_interpolate_stages, PleMatrix},\n23\t    prelude::F,\n24\t    GpuProverConfig, ProverError, RsCodeMatrixError, StackTracesError,\n25\t};\n26\t\n27\t#[derive(Getters)]\n28\tpub struct StackedPcsDataGpu<F, Digest> {\n29\t    /// Layout of the unstacked collection of matrices within the stacked matrix.\n30\t    #[getset(get = \"pub\")]\n31\t    pub(crate) layout: StackedLayout,\n32\t    /// The stacked matrix with height `2^{l_skip + n_stack}`.\n33\t    /// This is optionally cached depending on the prover configuration:\n34\t    /// - Caching increases the peak GPU memory but avoids a recomputation during stacked\n35\t    ///   reduction.\n36\t    /// - Not caching means the stacked matrix computation is recomputed during stacked reduction,\n37\t    ///   but lowers the peak GPU memory.\n38\t    #[getset(get = \"pub\")]\n39\t    pub(crate) matrix: Option<PleMatrix<F>>,\n40\t    /// Merkle tree of the Reed-Solomon codewords of the stacked matrix.\n41\t    /// Depends on `k_whir` parameter.\n42\t    #[getset(get = \"pub\")]\n43\t    pub(crate) tree: MerkleTreeGpu<F, Digest>,\n44\t}\n45\t\n46\t#[allow(clippy::type_complexity)]\n47\t#[instrument(level = \"info\", skip_all)]\n48\tpub fn stacked_commit<MH: GpuMerkleHash + MerkleTreeConstructor>(\n49\t    l_skip: usize,\n50\t    n_stack: usize,\n51\t    log_blowup: usize,\n52\t    k_whir: usize,\n53\t    traces: &[&DeviceMatrix<F>],\n54\t    prover_config: GpuProverConfig,\n55\t) -> Result<(MH::Digest, StackedPcsDataGpu<F, MH::Digest>), ProverError> {\n56\t    let mut mem = MemTracker::start(\"prover.stacked_commit\");\n57\t    mem.tracing_info(\"before stacked_commit\");\n58\t    mem.reset_peak();\n59\t    let layout = get_stacked_layout(l_skip, n_stack, traces);\n60\t    tracing::info!(\n61\t        height = layout.height(),\n62\t        width = layout.width(),\n63\t        \"stacked_matrix_dimensions\"\n64\t    );\n65\t    let opt_stacked_matrix = if prover_config.cache_stacked_matrix {\n66\t        Some(stack_traces(&layout, traces)?)\n67\t    } else {\n68\t        None\n69\t    };\n70\t    let rs_matrix = rs_code_matrix(log_blowup, &layout, traces, &opt_stacked_matrix)?;\n71\t    let tree = MerkleTreeGpu::<F, MH::Digest>::new_with_hash::<MH>(\n72\t        rs_matrix,\n73\t        1 << k_whir,\n74\t        prover_config.cache_rs_code_matrix,\n75\t    )?;\n76\t    let root = tree.root();\n77\t    let data = StackedPcsDataGpu {\n78\t        layout,\n79\t        matrix: opt_stacked_matrix,\n80\t        tree,\n81\t    };\n82\t    mem.emit_metrics();\n83\t    Ok((root, data))\n84\t}\n85\t\n86\t/// The `traces` **must** already be in height-sorted order.\n87\t///\n88\t/// This function is generic in `F` and only relies on CUDA memory operations.\n89\t#[instrument(skip_all)]\n90\tpub fn stacked_matrix(\n91\t    l_skip: usize,\n92\t    n_stack: usize,\n93\t    traces: &[&DeviceMatrix<F>],\n94\t) -> Result<(PleMatrix<F>, StackedLayout), ProverError> {\n95\t    let layout = get_stacked_layout(l_skip, n_stack, traces);\n96\t    let matrix = stack_traces(&layout, traces)?;\n97\t    Ok((matrix, layout))\n98\t}\n99\t\n100\tpub(crate) fn get_stacked_layout(\n101\t    l_skip: usize,\n102\t    n_stack: usize,\n103\t    traces: &[&DeviceMatrix<F>],\n104\t) -> StackedLayout {\n105\t    let sorted_meta = traces\n106\t        .iter()\n107\t        .map(|trace| {\n108\t            // height cannot be zero:\n109\t            let log_height = log2_strict_usize(trace.height());\n110\t            (trace.width(), log_height)\n111\t        })\n112\t        .collect_vec();\n113\t    debug_assert!(sorted_meta.is_sorted_by(|a, b| a.1 >= b.1));\n114\t    StackedLayout::new(l_skip, l_skip + n_stack, sorted_meta).unwrap()\n115\t}\n116\t\n117\tpub(crate) fn stack_traces(\n118\t    layout: &StackedLayout,\n119\t    traces: &[&DeviceMatrix<F>],\n120\t) -> Result<PleMatrix<F>, StackTracesError> {\n121\t    let mem = MemTracker::start(\"prover.stack_traces\");\n122\t    let l_skip = layout.l_skip();\n123\t    let height = layout.height();\n124\t    let width = layout.width();\n125\t    let mut q_evals = DeviceBuffer::<F>::with_capacity(width.checked_mul(height).unwrap());\n126\t    stack_traces_into_expanded(layout, traces, &mut q_evals, height)?;\n127\t    mem.emit_metrics();\n128\t    Ok(PleMatrix::from_evals(l_skip, q_evals, height, width))\n129\t}\n130\t\n131\t/// `buffer` should be the buffer to write the stacked traces into.\n132\t/// `buffer` should be a matrix with dimensions `padded_height x width` where `width` is the stacked\n133\t/// width and `padded_height` must be a multiple of the stacked height.\n134\tpub(crate) fn stack_traces_into_expanded(\n135\t    layout: &StackedLayout,\n136\t    traces: &[&DeviceMatrix<F>],\n137\t    buffer: &mut DeviceBuffer<F>,\n138\t    padded_height: usize,\n139\t) -> Result<(), StackTracesError> {\n140\t    let l_skip = layout.l_skip();\n141\t    debug_assert_eq!(padded_height % layout.height(), 0);\n142\t    debug_assert_eq!(buffer.len() % padded_height, 0);\n143\t    debug_assert_eq!(buffer.len() / padded_height, layout.width());\n144\t    buffer.fill_zero().map_err(StackTracesError::FillZero)?;\n145\t\n146\t    // Phase 1: Build descriptor array on host (CPU-only, no CUDA API calls)\n147\t    let mut descs: Vec<StackColDesc> = Vec::with_capacity(layout.sorted_cols.len());\n148\t    for (mat_idx, j, s) in &layout.sorted_cols {\n149\t        let start = s.col_idx * padded_height + s.row_idx;\n150\t        let trace = traces[*mat_idx];"}]},"parent_tool_use_id":"toolu_01FhNMas4p66wEih29SzSeAa","session_id":"6086bd80-4e0d-45db-9a25-2370973b0822","uuid":"79715e23-4160-482d-be40-4499acef26ec","timestamp":"2026-04-14T18:10:39.357Z"}
