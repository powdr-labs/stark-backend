{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012AUY2DYkPa2PJwrFnPxjJm","type":"tool_result","content":"90\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n91\t/// More threads = more concurrent kernels but more peak GPU memory and more\n92\t/// MemoryManager mutex contention. 4 is a good balance for the RTX 4090.\n93\tconst NUM_ROUND0_STREAMS: usize = 4;\n94\t\n95\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n96\t/// instead of the monomial kernel for high num_y traces.\n97\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n98\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n99\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n100\t\n101\t#[inline]\n102\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n103\t    if need_rot {\n104\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n105\t        (mat_width / 2) as u32\n106\t    } else {\n107\t        mat_width as u32\n108\t    }\n109\t}\n110\t\n111\t/// Result of processing one AIR in Round 0.\n112\tstruct Round0AirResult {\n113\t    trace_idx: usize,\n114\t    zerocheck_poly: Option<UnivariatePoly<EF>>,\n115\t    logup_numer_poly: Option<UnivariatePoly<EF>>,\n116\t    logup_denom_poly: Option<UnivariatePoly<EF>>,\n117\t}\n118\t\n119\t/// All read-only references needed to process one AIR in Round 0.\n120\tstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n121\t    trace_idx: usize,\n122\t    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n123\t    n: isize,\n124\t    selectors_cube: &'a DeviceMatrix<F>,\n125\t    public_values: &'a DeviceBuffer<F>,\n126\t    eq_3bs: &'a [EF],\n127\t    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n128\t    common_main: &'a DeviceMatrix<F>,\n129\t    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n130\t    d_lambda_pows: &'a DeviceBuffer<EF>,\n131\t    beta_pows: &'a [EF],\n132\t    l_skip: usize,\n133\t    constraint_degree: usize,\n134\t    xi: &'a [EF],\n135\t    max_temp_bytes: usize,\n136\t}\n137\t\n138\tfn process_air_round0<HS: GpuHashScheme>(\n139\t    w: &Round0AirWorkItem<HS>,\n140\t) -> Result<Round0AirResult, LogupZerocheckError> {\n141\t    let single_pk = w.single_pk;\n142\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n143\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n144\t    assert!(\n145\t        local_constraint_deg <= w.constraint_degree,\n146\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n147\t        w.constraint_degree\n148\t    );\n149\t\n150\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n151\t    let omega_root = F::two_adic_generator(log_large_domain);\n152\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n153\t\n154\t    let height = w.common_main.height();\n155\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n156\t    for committed in w.cached_mains {\n157\t        main_parts.push(committed.trace.buffer().as_ptr());\n158\t    }\n159\t    main_parts.push(w.common_main.buffer().as_ptr());\n160\t    let d_main_parts = main_parts.to_device()?;\n161\t\n162\t    let n_lift = w.n.max(0) as usize;\n163\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n164\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n165\t\n166\t    let sum_buffer = evaluate_round0_constraints_gpu(\n167\t        single_pk,\n168\t        w.selectors_cube.buffer(),\n169\t        &d_main_parts,\n170\t        w.public_values,\n171\t        eq_xi_tree.get_ptr(n_lift),\n172\t        w.d_lambda_pows,\n173\t        1 << w.l_skip,\n174\t        1 << n_lift,\n175\t        height as u32,\n176\t        num_cosets_zc as u32,\n177\t        omega_root,\n178\t        w.max_temp_bytes,\n179\t    )?;\n180\t\n181\t    let zerocheck_poly = if !sum_buffer.is_empty() {\n182\t        let q_evals = sum_buffer.to_host_on_current_stream()?;\n183\t        let q = {\n184\t            let mut values = EF::zero_vec(num_cosets_zc << w.l_skip);\n185\t            for coset_idx in 0..num_cosets_zc {\n186\t                for i in 0..1 << w.l_skip {\n187\t                    values[i * num_cosets_zc + coset_idx] = q_evals[(coset_idx << w.l_skip) + i];\n188\t                }\n189\t            }"}]},"parent_tool_use_id":null,"session_id":"93785c5e-49ce-4ca5-bdce-28569746575a","uuid":"73550c89-1b6d-41e2-ac2c-bc73988b97c1","timestamp":"2026-04-12T23:12:11.928Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/mod.rs","content":"/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n/// More threads = more concurrent kernels but more peak GPU memory and more\n/// MemoryManager mutex contention. 4 is a good balance for the RTX 4090.\nconst NUM_ROUND0_STREAMS: usize = 4;\n\n/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n/// instead of the monomial kernel for high num_y traces.\n/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\nconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n\n#[inline]\npub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n    if need_rot {\n        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n        (mat_width / 2) as u32\n    } else {\n        mat_width as u32\n    }\n}\n\n/// Result of processing one AIR in Round 0.\nstruct Round0AirResult {\n    trace_idx: usize,\n    zerocheck_poly: Option<UnivariatePoly<EF>>,\n    logup_numer_poly: Option<UnivariatePoly<EF>>,\n    logup_denom_poly: Option<UnivariatePoly<EF>>,\n}\n\n/// All read-only references needed to process one AIR in Round 0.\nstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n    trace_idx: usize,\n    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n    n: isize,\n    selectors_cube: &'a DeviceMatrix<F>,\n    public_values: &'a DeviceBuffer<F>,\n    eq_3bs: &'a [EF],\n    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n    common_main: &'a DeviceMatrix<F>,\n    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n    d_lambda_pows: &'a DeviceBuffer<EF>,\n    beta_pows: &'a [EF],\n    l_skip: usize,\n    constraint_degree: usize,\n    xi: &'a [EF],\n    max_temp_bytes: usize,\n}\n\nfn process_air_round0<HS: GpuHashScheme>(\n    w: &Round0AirWorkItem<HS>,\n) -> Result<Round0AirResult, LogupZerocheckError> {\n    let single_pk = w.single_pk;\n    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n    assert!(\n        local_constraint_deg <= w.constraint_degree,\n        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n        w.constraint_degree\n    );\n\n    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n    let omega_root = F::two_adic_generator(log_large_domain);\n    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n\n    let height = w.common_main.height();\n    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n    for committed in w.cached_mains {\n        main_parts.push(committed.trace.buffer().as_ptr());\n    }\n    main_parts.push(w.common_main.buffer().as_ptr());\n    let d_main_parts = main_parts.to_device()?;\n\n    let n_lift = w.n.max(0) as usize;\n    let eq_xi_tree = &w.eq_xis[&n_lift];\n    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n\n    let sum_buffer = evaluate_round0_constraints_gpu(\n        single_pk,\n        w.selectors_cube.buffer(),\n        &d_main_parts,\n        w.public_values,\n        eq_xi_tree.get_ptr(n_lift),\n        w.d_lambda_pows,\n        1 << w.l_skip,\n        1 << n_lift,\n        height as u32,\n        num_cosets_zc as u32,\n        omega_root,\n        w.max_temp_bytes,\n    )?;\n\n    let zerocheck_poly = if !sum_buffer.is_empty() {\n        let q_evals = sum_buffer.to_host_on_current_stream()?;\n        let q = {\n            let mut values = EF::zero_vec(num_cosets_zc << w.l_skip);\n            for coset_idx in 0..num_cosets_zc {\n                for i in 0..1 << w.l_skip {\n                    values[i * num_cosets_zc + coset_idx] = q_evals[(coset_idx << w.l_skip) + i];\n                }\n            }","numLines":100,"startLine":90,"totalLines":1702}}}
