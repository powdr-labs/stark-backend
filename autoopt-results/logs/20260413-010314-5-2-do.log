 else {\n155\t        DeviceBuffer::<EF>::with_capacity(1)\n156\t    };\n157\t\n158\t    let num_rows_per_tile = height.div_ceil(TASK_SIZE as usize).max(1);\n159\t\n160\t    let leaves_ptr = w.leaves_ptr.0;\n161\t    let l_skip = w.l_skip;\n162\t    let lifted_height = max(height, 1 << l_skip);\n163\t\n164\t    let trace_output = if height != lifted_height {\n165\t        let required = height * num_interactions;\n166\t        if required > tmp.len() {\n167\t            *tmp = DeviceBuffer::with_capacity(required);\n168\t        }\n169\t        tmp.as_mut_ptr()\n170\t    } else {\n171\t        leaves_ptr\n172\t    };\n173\t    unsafe {\n174\t        logup_gkr_input_eval(\n175\t            is_global,\n176\t            trace_output,\n177\t            d_preprocessed,\n178\t            d_partition_ptrs,\n179\t            &d_public_values,\n180\t            w.d_challenges,\n181\t            &intermediates,\n182\t            &rules.inner.d_rules,\n183\t            &rules.inner.d_used_nodes,\n184\t            &rules.d_pair_idxs,\n185\t            height as u32,\n186\t            num_rows_per_tile as u32,\n187\t        )?;\n188\t    }\n189\t    if height != lifted_height {\n190\t        debug_assert_eq!(lifted_height % height, 0);\n191\t        debug_assert!(!tmp.is_empty());\n192\t        let norm_factor_denom = lifted_height / height;\n193\t        let norm_factor = F::from_usize(norm_factor_denom).inverse();\n194\t        unsafe {\n195\t            frac_vector_scalar_multiply_ext_fp(\n196\t                tmp.as_mut_ptr(),\n197\t                norm_factor,\n198\t                tmp.len() as u32,\n199\t            )?;\n200\t            frac_matrix_vertically_repeat(\n201\t                leaves_ptr,\n202\t                tmp.as_ptr(),\n203\t                num_interactions as u32,\n204\t                lifted_height as u32,\n205\t                height as u32,\n206\t            )?;\n207\t        }\n208\t    }\n209\t    Ok(())\n210\t}\n211\t\n212\t/// Evaluate interactions from trace evaluation matrices to get (p, q) fractional sumcheck input.\n213\t/// Returns leaves buffer (WITHOUT alpha applied) and alpha value to be applied in first tree layer.\n214\t#[instrument(name = \"prover.rap_constraints.logup_gkr.input_evals\", skip_all)]\n215\tpub fn log_gkr_input_evals<HS: GpuHashScheme>(\n216\t    trace_interactions: &[Option<TraceInteractionMeta>],\n217\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n218\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n219\t    l_skip: usize,\n220\t    alpha_logup: EF,\n221\t    d_challenges: &DeviceBuffer<EF>,\n222\t    total_leaves: usize,\n223\t) -> Result<(DeviceBuffer<Frac<EF>>, EF), InteractionGpuError> {\n224\t    if trace_interactions.iter().all(|meta| meta.is_none()) {\n225\t        return Ok((DeviceBuffer::new(), alpha_logup));\n226\t    }\n227\t\n228\t    let leaves = DeviceBuffer::<Frac<EF>>::with_capacity(total_leaves);\n229\t    leaves.fill_zero()?;\n230\t\n231\t    // Phase 1: Build work items and sort by descending height for load balance.\n232\t    let mut work_items: Vec<GkrInputWorkItem<HS>> = trace_interactions\n233\t        .iter()\n234\t        .flatten()\n235\t        .map(|meta| {\n236\t            let air_ctx = &ctx.per_trace[meta.trace_idx].1;\n237\t            let pk_air = &pk.per_air[meta.air_idx];\n238\t            let slice = meta.layout_slices.first().unwrap();\n239\t            assert_eq!(slice.col_idx, 0);\n240\t            let dst_offset = slice.row_idx;\n241\t            let leaves_ptr = unsafe { leaves.as_mut_ptr().add(dst_offset) };\n242\t            GkrInputWorkItem {\n243\t                air_ctx,\n244\t                pk_air,\n245\t                l_skip,\n246\t                d_challenges,\n247\t                leaves_ptr: SendPtr(leaves_ptr),\n248\t            }\n249\t        })\n250\t        .collect();\n251\t\n252\t    work_items.sort_by(|a, b| b.air_ctx.height().cmp(&a.air_ctx.height()));\n253\t\n254\t    // Barrier: ensure fill_zero() and all prior GPU work is visible to worker thread streams.\n255\t    current_stream_sync().map_err(InteractionGpuError::from)?;\n256\t\n257\t    // Phase 2: Process AIRs in parallel across N OS threads.\n258\t    let num_threads = if work_items.len() >= 100 {\n259\t        NUM_GKR_INPUT_STREAMS.min(work_items.len())\n260\t    } else {\n261\t        1\n262\t    };\n263\t\n264\t    if num_threads <= 1 {\n265\t        let mut d_partition_ptrs = DeviceBuffer::<u64>::new();\n266\t        let mut tmp = DeviceBuffer::<Frac<EF>>::new();\n267\t        for w in &work_items {\n268\t            process_gkr_input_air(w, &mut d_partition_ptrs, &mut tmp)?;\n269\t        }\n270\t    } else {\n271\t        let chunk_size = work_items.len().div_ceil(num_threads);\n272\t        std::thread::scope(|s| {\n273\t            let handles: Vec<_> = work_items\n274\t                .chunks(chunk_size)\n275\t                .map(|chunk| {\n276\t                    s.spawn(move || -> Result<(), InteractionGpuError> {\n277\t                        let mut d_partition_ptrs = DeviceBuffer::<u64>::new();\n278\t                        let mut tmp = DeviceBuffer::<Frac<EF>>::new();\n279\t                        for w in chunk {\n280\t                            process_gkr_input_air(w, &mut d_partition_ptrs, &mut tmp)?;\n281\t                        }\n282\t                        current_stream_sync().map_err(InteractionGpuError::from)?;\n283\t                        Ok(())\n284\t                    })\n285\t                })\n286\t                .collect();\n287\t            for handle in handles {\n288\t                handle.join().unwrap()?;\n289\t            }\n290\t            Ok::<_, InteractionGpuError>(())\n291\t        })?;\n292\t    }\n293\t\n294\t    // NOTE: alpha is NO LONGER applied here - it will be fused into the first tree layer\n295\t    // in fractional_sumcheck_gpu for better performance (eliminates one memory pass)\n296\t    Ok((leaves, alpha_logup))\n297\t}\n298\t"}]},"parent_tool_use_id":null,"session_id":"3001e34b-f3ed-4dd1-9440-8c7993724ff2","uuid":"f32e4326-dae5-43a0-b73b-07b333865d71","timestamp":"2026-04-12T23:28:53.982Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/gkr_input.rs","content":"use std::cmp::max;\n\nuse itertools::Itertools;\nuse openvm_cuda_common::{\n    copy::MemCopyH2D,\n    d_buffer::DeviceBuffer,\n    stream::current_stream_sync,\n};\nuse openvm_stark_backend::prover::{\n    fractional_sumcheck_gkr::Frac,\n    stacked_pcs::{StackedLayout, StackedSlice},\n    DeviceMultiStarkProvingKey, MatrixDimensions, ProvingContext,\n};\nuse p3_field::{Field, PrimeCharacteristicRing};\nuse tracing::instrument;\n\nuse super::errors::InteractionGpuError;\nuse crate::{\n    cuda::logup_zerocheck::{\n        frac_matrix_vertically_repeat, frac_vector_scalar_multiply_ext_fp, logup_gkr_input_eval,\n    },\n    gpu_backend::GenericGpuBackend,\n    hash_scheme::GpuHashScheme,\n    prelude::{EF, F},\n};\n\nconst TASK_SIZE: u32 = 65536;\n\n/// Number of OS threads (and thus CUDA streams) for parallel GKR input evaluation.\nconst NUM_GKR_INPUT_STREAMS: usize = 4;\n\nstruct SendPtr<T>(*mut T);\nunsafe impl<T> Send for SendPtr<T> {}\nunsafe impl<T> Sync for SendPtr<T> {}\n\nstruct GkrInputWorkItem<'a, HS: GpuHashScheme> {\n    air_ctx: &'a openvm_stark_backend::prover::AirProvingContext<GenericGpuBackend<HS>>,\n    pk_air: &'a openvm_stark_backend::prover::DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n    l_skip: usize,\n    d_challenges: &'a DeviceBuffer<EF>,\n    leaves_ptr: SendPtr<Frac<EF>>,\n}\n\n#[allow(dead_code)]\n#[derive(Clone)]\npub struct TraceInteractionMeta {\n    pub trace_idx: usize,\n    pub air_idx: usize,\n    pub layout_slices: Vec<StackedSlice>,\n}\n\n// TODO[jpw]: revisit if this function is needed\npub fn collect_trace_interactions<HS: GpuHashScheme>(\n    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n    layout: &StackedLayout,\n) -> Vec<Option<TraceInteractionMeta>> {\n    // Pre-group layout slices by trace to avoid repeated scans later.\n    let mut slices_by_trace: Vec<Vec<(usize, StackedSlice)>> =\n        vec![Vec::new(); ctx.per_trace.len()];\n    for &(trace_idx, interaction_idx, ref slice) in &layout.sorted_cols {\n        if let Some(entries) = slices_by_trace.get_mut(trace_idx) {\n            entries.push((interaction_idx, *slice));\n        }\n    }\n\n    ctx.per_trace\n        .iter()\n        .enumerate()\n        .map(|(trace_idx, (air_idx, _))| {\n            let vk = &pk.per_air[*air_idx].vk;\n            if !vk.has_interaction() {\n                return None;\n            }\n\n            let mut layout_entries = vec![None; vk.num_interactions()];\n            for (interaction_idx, slice) in &slices_by_trace[trace_idx] {\n                if let Some(slot) = layout_entries.get_mut(*interaction_idx) {\n                    *slot = Some(*slice);\n                }\n            }\n\n            let layout_slices = layout_entries\n                .into_iter()\n                .enumerate()\n                .map(|(idx, maybe_slice)| {\n                    maybe_slice.unwrap_or_else(|| {\n                        panic!(\n                            \"missing stacked slice for interaction {} of trace {}\",\n                            idx, trace_idx\n                        )\n                    })\n                })\n                .collect_vec();\n\n            Some(TraceInteractionMeta {\n                trace_idx,\n                air_idx: *air_idx,\n                layout_slices,\n            })\n        })\n        .collect()\n}\n\nfn process_gkr_input_air<HS: GpuHashScheme>(\n    w: &GkrInputWorkItem<HS>,\n    d_partition_ptrs: &mut DeviceBuffer<u64>,\n    tmp: &mut DeviceBuffer<Frac<EF>>,\n) -> Result<(), InteractionGpuError> {\n    let null_preprocessed = DeviceBuffer::<F>::new();\n    let air_ctx = w.air_ctx;\n    let pk_air = w.pk_air;\n\n    let preprocessed_matrix = pk_air\n        .preprocessed_data\n        .as_ref()\n        .map(|committed| &committed.trace);\n\n    let mut partitioned_main = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n    for committed in &air_ctx.cached_mains {\n        partitioned_main.push(&committed.trace);\n    }\n    partitioned_main.push(&air_ctx.common_main);\n\n    let rules = &pk_air.other_data.interaction_rules;\n    let num_interactions = pk_air.vk.symbolic_constraints.interactions.len();\n\n    let d_preprocessed = preprocessed_matrix\n        .as_ref()\n        .map(|m| m.buffer())\n        .unwrap_or(&null_preprocessed);\n    let d_public_values = if air_ctx.public_values.is_empty() {\n        DeviceBuffer::<F>::new()\n    } else {\n        air_ctx.public_values.to_device()?\n    };\n\n    let height = air_ctx.height();\n    debug_assert_eq!(height, partitioned_main[0].height());\n    let partition_ptrs = partitioned_main\n        .iter()\n        .map(|m| m.buffer().as_ptr() as u64)\n        .collect_vec();\n    if partition_ptrs.len() > d_partition_ptrs.len() {\n        *d_partition_ptrs = DeviceBuffer::with_capacity(partition_ptrs.len());\n    }\n    partition_ptrs.copy_to(d_partition_ptrs)?;\n\n    let buffer_size = rules.inner.buffer_size;\n    // TODO[jpw]: remove magic 10\n    let is_global = buffer_size > 10;\n    let intermediates = if is_global {\n        DeviceBuffer::<EF>::with_capacity((TASK_SIZE as usize) * buffer_size as usize)\n    } else {\n        DeviceBuffer::<EF>::with_capacity(1)\n    };\n\n    let num_rows_per_tile = height.div_ceil(TASK_SIZE as usize).max(1);\n\n    let leaves_ptr = w.leaves_ptr.0;\n    let l_skip = w.l_skip;\n    let lifted_height = max(height, 1 << l_skip);\n\n    let trace_output = if height != lifted_height {\n        let required = height * num_interactions;\n        if required > tmp.len() {\n            *tmp = DeviceBuffer::with_capacity(required);\n        }\n        tmp.as_mut_ptr()\n    } else {\n        leaves_ptr\n    };\n    unsafe {\n        logup_gkr_input_eval(\n            is_global,\n            trace_output,\n            d_preprocessed,\n            d_partition_ptrs,\n            &d_public_values,\n            w.d_challenges,\n            &intermediates,\n            &rules.inner.d_rules,\n            &rules.inner.d_used_nodes,\n            &rules.d_pair_idxs,\n            height as u32,\n            num_rows_per_tile as u32,\n        )?;\n    }\n    if height != lifted_height {\n        debug_assert_eq!(lifted_height % height, 0);\n        debug_assert!(!tmp.is_empty());\n        let norm_factor_denom = lifted_height / height;\n        let norm_factor = F::from_usize(norm_factor_denom).inverse();\n        unsafe {\n            frac_vector_scalar_multiply_ext_fp(\n                tmp.as_mut_ptr(),\n                norm_factor,\n                tmp.len() as u32,\n            )?;\n            frac_matrix_vertically_repeat(\n                leaves_ptr,\n                tmp.as_ptr(),\n                num_interactions as u32,\n                lifted_height as u32,\n                height as u32,\n            )?;\n        }\n    }\n    Ok(())\n}\n\n/// Evaluate interactions from trace evaluation matrices to get (p, q) fractional sumcheck input.\n/// Returns leaves buffer (WITHOUT alpha applied) and alpha value to be applied in first tree layer.\n#[instrument(name = \"prover.rap_constraints.logup_gkr.input_evals\", skip_all)]\npub fn log_gkr_input_evals<HS: GpuHashScheme>(\n    trace_interactions: &[Option<TraceInteractionMeta>],\n    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n    l_skip: usize,\n    alpha_logup: EF,\n    d_challenges: &DeviceBuffer<EF>,\n    total_leaves: usize,\n) -> Result<(DeviceBuffer<Frac<EF>>, EF), InteractionGpuError> {\n    if trace_interactions.iter().all(|meta| meta.is_none()) {\n        return Ok((DeviceBuffer::new(), alpha_logup));\n    }\n\n    let leaves = DeviceBuffer::<Frac<EF>>::with_capacity(total_leaves);\n    leaves.fill_zero()?;\n\n    // Phase 1: Build work items and sort by descending height for load balance.\n    let mut work_items: Vec<GkrInputWorkItem<HS>> = trace_interactions\n        .iter()\n        .flatten()\n        .map(|meta| {\n            let air_ctx = &ctx.per_trace[meta.trace_idx].1;\n            let pk_air = &pk.per_air[meta.air_idx];\n            let slice = meta.layout_slices.first().unwrap();\n            assert_eq!(slice.col_idx, 0);\n            let dst_offset = slice.row_idx;\n            let leaves_ptr = unsafe { leaves.as_mut_ptr().add(dst_offset) };\n            GkrInputWorkItem {\n                air_ctx,\n                pk_air,\n                l_skip,\n                d_challenges,\n                leaves_ptr: SendPtr(leaves_ptr),\n            }\n        })\n        .collect();\n\n    work_items.sort_by(|a, b| b.air_ctx.height().cmp(&a.air_ctx.height()));\n\n    // Barrier: ensure fill_zero() and all prior GPU work is visible to worker thread streams.\n    current_stream_sync().map_err(InteractionGpuError::from)?;\n\n    // Phase 2: Process AIRs in parallel across N OS threads.\n    let num_threads = if work_items.len() >= 100 {\n        NUM_GKR_INPUT_STREAMS.min(work_items.len())\n    } else {\n        1\n    };\n\n    if num_threads <= 1 {\n        let mut d_partition_ptrs = DeviceBuffer::<u64>::new();\n        let mut tmp = DeviceBuffer::<Frac<EF>>::new();\n        for w in &work_items {\n            process_gkr_input_air(w, &mut d_partition_ptrs, &mut tmp)?;\n        }\n    } else {\n        let chunk_size = work_items.len().div_ceil(num_threads);\n        std::thread::scope(|s| {\n            let handles: Vec<_> = work_items\n                .chunks(chunk_size)\n                .map(|chunk| {\n                    s.spawn(move || -> Result<(), InteractionGpuError> {\n                        let mut d_partition_ptrs = DeviceBuffer::<u64>::new();\n                        let mut tmp = DeviceBuffer::<Frac<EF>>::new();\n                        for w in chunk {\n                            process_gkr_input_air(w, &mut d_partition_ptrs, &mut tmp)?;\n                        }\n                        current_stream_sync().map_err(InteractionGpuError::from)?;\n                        Ok(())\n                    })\n                })\n                .collect();\n            for handle in handles {\n                handle.join().unwrap()?;\n            }\n            Ok::<_, InteractionGpuError>(())\n        })?;\n    }\n\n    // NOTE: alpha is NO LONGER applied here - it will be fused into the first tree layer\n    // in fractional_sumcheck_gpu for better performance (eliminates one memory pass)\n    Ok((leaves, alpha_logup))\n}\n","numLines":298,"startLine":1,"totalLines":298}}}
