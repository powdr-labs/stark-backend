\n52\t            let vk = &pk.per_air[*air_idx].vk;\n53\t            if !vk.has_interaction() {\n54\t                return None;\n55\t            }\n56\t\n57\t            let mut layout_entries = vec![None; vk.num_interactions()];\n58\t            for (interaction_idx, slice) in &slices_by_trace[trace_idx] {\n59\t                if let Some(slot) = layout_entries.get_mut(*interaction_idx) {\n60\t                    *slot = Some(*slice);\n61\t                }\n62\t            }\n63\t\n64\t            let layout_slices = layout_entries\n65\t                .into_iter()\n66\t                .enumerate()\n67\t                .map(|(idx, maybe_slice)| {\n68\t                    maybe_slice.unwrap_or_else(|| {\n69\t                        panic!(\n70\t                            \"missing stacked slice for interaction {} of trace {}\",\n71\t                            idx, trace_idx\n72\t                        )\n73\t                    })\n74\t                })\n75\t                .collect_vec();\n76\t\n77\t            Some(TraceInteractionMeta {\n78\t                trace_idx,\n79\t                air_idx: *air_idx,\n80\t                layout_slices,\n81\t            })\n82\t        })\n83\t        .collect()\n84\t}\n85\t\n86\t/// Evaluate interactions from trace evaluation matrices to get (p, q) fractional sumcheck input.\n87\t/// Returns leaves buffer (WITHOUT alpha applied) and alpha value to be applied in first tree layer.\n88\t#[instrument(name = \"prover.rap_constraints.logup_gkr.input_evals\", skip_all)]\n89\tpub fn log_gkr_input_evals<HS: GpuHashScheme>(\n90\t    trace_interactions: &[Option<TraceInteractionMeta>],\n91\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n92\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n93\t    l_skip: usize,\n94\t    alpha_logup: EF,\n95\t    d_challenges: &DeviceBuffer<EF>,\n96\t    total_leaves: usize,\n97\t) -> Result<(DeviceBuffer<Frac<EF>>, EF), InteractionGpuError> {\n98\t    if trace_interactions.iter().all(|meta| meta.is_none()) {\n99\t        return Ok((DeviceBuffer::new(), alpha_logup));\n100\t    }\n101\t\n102\t    let leaves = DeviceBuffer::<Frac<EF>>::with_capacity(total_leaves);\n103\t    leaves.fill_zero()?;\n104\t    let null_preprocessed = DeviceBuffer::<F>::new();\n105\t\n106\t    let mut d_partition_ptrs = DeviceBuffer::<u64>::new();\n107\t    let mut tmp = DeviceBuffer::<Frac<EF>>::new();\n108\t    for meta in trace_interactions.iter().flatten() {\n109\t        let air_ctx = &ctx.per_trace[meta.trace_idx].1;\n110\t        let pk_air = &pk.per_air[meta.air_idx];\n111\t\n112\t        let preprocessed_matrix = pk_air\n113\t            .preprocessed_data\n114\t            .as_ref()\n115\t            .map(|committed| &committed.trace);\n116\t\n117\t        let mut partitioned_main = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n118\t        for committed in &air_ctx.cached_mains {\n119\t            partitioned_main.push(&committed.trace);\n120\t        }\n121\t        partitioned_main.push(&air_ctx.common_main);\n122\t\n123\t        let rules = &pk_air.other_data.interaction_rules;\n124\t        let num_interactions = pk_air.vk.symbolic_constraints.interactions.len();\n125\t\n126\t        let d_preprocessed = preprocessed_matrix\n127\t            .as_ref()\n128\t            .map(|m| m.buffer())\n129\t            .unwrap_or(&null_preprocessed);\n130\t        let d_public_values = if air_ctx.public_values.is_empty() {\n131\t            DeviceBuffer::<F>::new()\n132\t        } else {\n133\t            air_ctx.public_values.to_device()?\n134\t        };\n135\t\n136\t        let height = air_ctx.height();\n137\t        debug_assert_eq!(height, partitioned_main[0].height());\n138\t        let partition_ptrs = partitioned_main\n139\t            .iter()\n140\t            .map(|m| m.buffer().as_ptr() as u64)\n141\t            .collect_vec();\n142\t        if partition_ptrs.len() > d_partition_ptrs.len() {\n143\t            d_partition_ptrs = DeviceBuffer::with_capacity(partition_ptrs.len());\n144\t        }\n145\t        partition_ptrs.copy_to(&mut d_partition_ptrs)?;\n146\t\n147\t        let buffer_size = rules.inner.buffer_size;\n148\t        // TODO[jpw]: remove magic 10\n149\t        let is_global = buffer_size > 10;\n150\t        let intermediates = if is_global {\n151\t            DeviceBuffer::<EF>::with_capacity((TASK_SIZE as usize) * buffer_size as usize)\n152\t        } else {\n153\t            DeviceBuffer::<EF>::with_capacity(1)\n154\t        };\n155\t\n156\t        let num_rows_per_tile = height.div_ceil(TASK_SIZE as usize).max(1);\n157\t\n158\t        let slice = meta.layout_slices.first().unwrap();\n159\t        if slice.col_idx != 0 {\n160\t            return Err(InteractionGpuError::Layout);\n161\t        }\n162\t        let dst_offset = slice.row_idx;\n163\t        let lifted_height = max(height, 1 << l_skip);\n164\t        debug_assert_eq!(slice.len(l_skip), lifted_height);\n165\t        // SAFETY: by definition of interactions stacked layout, `leaves` has enough capacity\n166\t        let leaves_ptr = unsafe { leaves.as_mut_ptr().add(dst_offset) };\n167\t\n168\t        let trace_output = if height != lifted_height {\n169\t            let required = height * num_interactions;\n170\t            if required > tmp.len() {\n171\t                tmp = DeviceBuffer::with_capacity(required);\n172\t            }\n173\t            tmp.as_mut_ptr()\n174\t        } else {\n175\t            leaves_ptr\n176\t        };\n177\t        unsafe {\n178\t            logup_gkr_input_eval(\n179\t                is_global,\n180\t                trace_output,\n181\t                d_preprocessed,\n182\t                &d_partition_ptrs,\n183\t                &d_public_values,\n184\t                d_challenges,\n185\t                &intermediates,\n186\t                &rules.inner.d_rules,\n187\t                &rules.inner.d_used_nodes,\n188\t                &rules.d_pair_idxs,\n189\t                height as u32,\n190\t                num_rows_per_tile as u32,\n191\t            )?;\n192\t        }\n193\t        if height != lifted_height {\n194\t            debug_assert_eq!(lifted_height % height, 0);\n195\t            debug_assert!(!tmp.is_empty());\n196\t            let norm_factor_denom = lifted_height / height;\n197\t            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n198\t            unsafe {\n199\t                // SAFETY: scaling within buffer length\n200\t                frac_vector_scalar_multiply_ext_fp(\n201\t                    tmp.as_mut_ptr(),\n202\t                    norm_factor,\n203\t                    tmp.len() as u32,\n204\t                )?;\n205\t                // SAFETY: stacked interaction layout is defined with respect to lifted height so\n206\t                // lifting (i.e., vertically repeating) stays within bounds\n207\t                frac_matrix_vertically_repeat(\n208\t                    leaves_ptr,\n209\t                    tmp.as_ptr(),\n210\t                    num_interactions as u32,\n211\t                    lifted_height as u32,\n212\t                    height as u32,\n213\t                )?;\n214\t            }\n215\t        }\n216\t    }\n217\t\n218\t    // NOTE: alpha is NO LONGER applied here - it will be fused into the first tree layer\n219\t    // in fractional_sumcheck_gpu for better performance (eliminates one memory pass)\n220\t    Ok((leaves, alpha_logup))\n221\t}\n222\t"}]},"parent_tool_use_id":null,"session_id":"3001e34b-f3ed-4dd1-9440-8c7993724ff2","uuid":"6c1c28f7-9d81-412e-8d8b-3c3a2f36eee0","timestamp":"2026-04-12T23:22:47.943Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/gkr_input.rs","content":"use std::cmp::max;\n\nuse itertools::Itertools;\nuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer};\nuse openvm_stark_backend::prover::{\n    fractional_sumcheck_gkr::Frac,\n    stacked_pcs::{StackedLayout, StackedSlice},\n    DeviceMultiStarkProvingKey, MatrixDimensions, ProvingContext,\n};\nuse p3_field::{Field, PrimeCharacteristicRing};\nuse tracing::instrument;\n\nuse super::errors::InteractionGpuError;\nuse crate::{\n    cuda::logup_zerocheck::{\n        frac_matrix_vertically_repeat, frac_vector_scalar_multiply_ext_fp, logup_gkr_input_eval,\n    },\n    gpu_backend::GenericGpuBackend,\n    hash_scheme::GpuHashScheme,\n    prelude::{EF, F},\n};\n\nconst TASK_SIZE: u32 = 65536;\n\n#[allow(dead_code)]\n#[derive(Clone)]\npub struct TraceInteractionMeta {\n    pub trace_idx: usize,\n    pub air_idx: usize,\n    pub layout_slices: Vec<StackedSlice>,\n}\n\n// TODO[jpw]: revisit if this function is needed\npub fn collect_trace_interactions<HS: GpuHashScheme>(\n    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n    layout: &StackedLayout,\n) -> Vec<Option<TraceInteractionMeta>> {\n    // Pre-group layout slices by trace to avoid repeated scans later.\n    let mut slices_by_trace: Vec<Vec<(usize, StackedSlice)>> =\n        vec![Vec::new(); ctx.per_trace.len()];\n    for &(trace_idx, interaction_idx, ref slice) in &layout.sorted_cols {\n        if let Some(entries) = slices_by_trace.get_mut(trace_idx) {\n            entries.push((interaction_idx, *slice));\n        }\n    }\n\n    ctx.per_trace\n        .iter()\n        .enumerate()\n        .map(|(trace_idx, (air_idx, _))| {\n            let vk = &pk.per_air[*air_idx].vk;\n            if !vk.has_interaction() {\n                return None;\n            }\n\n            let mut layout_entries = vec![None; vk.num_interactions()];\n            for (interaction_idx, slice) in &slices_by_trace[trace_idx] {\n                if let Some(slot) = layout_entries.get_mut(*interaction_idx) {\n                    *slot = Some(*slice);\n                }\n            }\n\n            let layout_slices = layout_entries\n                .into_iter()\n                .enumerate()\n                .map(|(idx, maybe_slice)| {\n                    maybe_slice.unwrap_or_else(|| {\n                        panic!(\n                            \"missing stacked slice for interaction {} of trace {}\",\n                            idx, trace_idx\n                        )\n                    })\n                })\n                .collect_vec();\n\n            Some(TraceInteractionMeta {\n                trace_idx,\n                air_idx: *air_idx,\n                layout_slices,\n            })\n        })\n        .collect()\n}\n\n/// Evaluate interactions from trace evaluation matrices to get (p, q) fractional sumcheck input.\n/// Returns leaves buffer (WITHOUT alpha applied) and alpha value to be applied in first tree layer.\n#[instrument(name = \"prover.rap_constraints.logup_gkr.input_evals\", skip_all)]\npub fn log_gkr_input_evals<HS: GpuHashScheme>(\n    trace_interactions: &[Option<TraceInteractionMeta>],\n    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n    l_skip: usize,\n    alpha_logup: EF,\n    d_challenges: &DeviceBuffer<EF>,\n    total_leaves: usize,\n) -> Result<(DeviceBuffer<Frac<EF>>, EF), InteractionGpuError> {\n    if trace_interactions.iter().all(|meta| meta.is_none()) {\n        return Ok((DeviceBuffer::new(), alpha_logup));\n    }\n\n    let leaves = DeviceBuffer::<Frac<EF>>::with_capacity(total_leaves);\n    leaves.fill_zero()?;\n    let null_preprocessed = DeviceBuffer::<F>::new();\n\n    let mut d_partition_ptrs = DeviceBuffer::<u64>::new();\n    let mut tmp = DeviceBuffer::<Frac<EF>>::new();\n    for meta in trace_interactions.iter().flatten() {\n        let air_ctx = &ctx.per_trace[meta.trace_idx].1;\n        let pk_air = &pk.per_air[meta.air_idx];\n\n        let preprocessed_matrix = pk_air\n            .preprocessed_data\n            .as_ref()\n            .map(|committed| &committed.trace);\n\n        let mut partitioned_main = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n        for committed in &air_ctx.cached_mains {\n            partitioned_main.push(&committed.trace);\n        }\n        partitioned_main.push(&air_ctx.common_main);\n\n        let rules = &pk_air.other_data.interaction_rules;\n        let num_interactions = pk_air.vk.symbolic_constraints.interactions.len();\n\n        let d_preprocessed = preprocessed_matrix\n            .as_ref()\n            .map(|m| m.buffer())\n            .unwrap_or(&null_preprocessed);\n        let d_public_values = if air_ctx.public_values.is_empty() {\n            DeviceBuffer::<F>::new()\n        } else {\n            air_ctx.public_values.to_device()?\n        };\n\n        let height = air_ctx.height();\n        debug_assert_eq!(height, partitioned_main[0].height());\n        let partition_ptrs = partitioned_main\n            .iter()\n            .map(|m| m.buffer().as_ptr() as u64)\n            .collect_vec();\n        if partition_ptrs.len() > d_partition_ptrs.len() {\n            d_partition_ptrs = DeviceBuffer::with_capacity(partition_ptrs.len());\n        }\n        partition_ptrs.copy_to(&mut d_partition_ptrs)?;\n\n        let buffer_size = rules.inner.buffer_size;\n        // TODO[jpw]: remove magic 10\n        let is_global = buffer_size > 10;\n        let intermediates = if is_global {\n            DeviceBuffer::<EF>::with_capacity((TASK_SIZE as usize) * buffer_size as usize)\n        } else {\n            DeviceBuffer::<EF>::with_capacity(1)\n        };\n\n        let num_rows_per_tile = height.div_ceil(TASK_SIZE as usize).max(1);\n\n        let slice = meta.layout_slices.first().unwrap();\n        if slice.col_idx != 0 {\n            return Err(InteractionGpuError::Layout);\n        }\n        let dst_offset = slice.row_idx;\n        let lifted_height = max(height, 1 << l_skip);\n        debug_assert_eq!(slice.len(l_skip), lifted_height);\n        // SAFETY: by definition of interactions stacked layout, `leaves` has enough capacity\n        let leaves_ptr = unsafe { leaves.as_mut_ptr().add(dst_offset) };\n\n        let trace_output = if height != lifted_height {\n            let required = height * num_interactions;\n            if required > tmp.len() {\n                tmp = DeviceBuffer::with_capacity(required);\n            }\n            tmp.as_mut_ptr()\n        } else {\n            leaves_ptr\n        };\n        unsafe {\n            logup_gkr_input_eval(\n                is_global,\n                trace_output,\n                d_preprocessed,\n                &d_partition_ptrs,\n                &d_public_values,\n                d_challenges,\n                &intermediates,\n                &rules.inner.d_rules,\n                &rules.inner.d_used_nodes,\n                &rules.d_pair_idxs,\n                height as u32,\n                num_rows_per_tile as u32,\n            )?;\n        }\n        if height != lifted_height {\n            debug_assert_eq!(lifted_height % height, 0);\n            debug_assert!(!tmp.is_empty());\n            let norm_factor_denom = lifted_height / height;\n            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n            unsafe {\n                // SAFETY: scaling within buffer length\n                frac_vector_scalar_multiply_ext_fp(\n                    tmp.as_mut_ptr(),\n                    norm_factor,\n                    tmp.len() as u32,\n                )?;\n                // SAFETY: stacked interaction layout is defined with respect to lifted height so\n                // lifting (i.e., vertically repeating) stays within bounds\n                frac_matrix_vertically_repeat(\n                    leaves_ptr,\n                    tmp.as_ptr(),\n                    num_interactions as u32,\n                    lifted_height as u32,\n                    height as u32,\n                )?;\n            }\n        }\n    }\n\n    // NOTE: alpha is NO LONGER applied here - it will be fused into the first tree layer\n    // in fractional_sumcheck_gpu for better performance (eliminates one memory pass)\n    Ok((leaves, alpha_logup))\n}\n","numLines":222,"startLine":1,"totalLines":222}}}
