{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XUUjA6L5Gq4LZz1gQQRg13","type":"tool_result","content":"1\t/// BN254 field arithmetic and Poseidon2 permutation helpers for CUDA.\n2\t///\n3\t/// This header provides:\n4\t///   - Bn254Fr type (4 × u64 Montgomery form, little-endian limbs)\n5\t///   - CIOS Montgomery multiplication matching p3-bn254::helpers::monty_mul\n6\t///   - Field add / sub / neg / double / x^5 S-box\n7\t///   - MDS layers for WIDTH = 3 (external and internal)\n8\t///   - bn254_from_canonical / bn254_to_canonical conversions\n9\t///   - reduce_32 (pack BabyBear → Bn254Fr) for both num_f_elms=8 (Merkle) and num_f_elms=3 (challenger)\n10\t///   - split_32 (unpack Bn254Fr → BabyBear canonical u32) for num_f_elms=3 (challenger)\n11\t///\n12\t/// All functions are pure computation (no globals). The Poseidon2 permutation\n13\t/// function is declared here but defined in bn254_poseidon2.cu (where the\n14\t/// round-constant globals live).\n15\t#pragma once\n16\t#include <cstdint>\n17\t\n18\t// ---------------------------------------------------------------------------\n19\t// BN254 scalar field type\n20\t// ---------------------------------------------------------------------------\n21\t\n22\t/// A BN254 scalar field element stored in Montgomery form.\n23\t/// `limbs[i]` are little-endian 64-bit words: limbs[0] = bits 0-63, etc.\n24\tstruct Bn254Fr {\n25\t    uint64_t limbs[4];\n26\t};\n27\t\n28\t// ---------------------------------------------------------------------------\n29\t// Field constants (all in Montgomery form)\n30\t// ---------------------------------------------------------------------------\n31\t\n32\t// P = BN254 prime (canonical representation)\n33\t__device__ __constant__ static const uint64_t BN254_P[4] = {\n34\t    0x43e1f593f0000001ULL,\n35\t    0x2833e84879b97091ULL,\n36\t    0xb85045b68181585dULL,\n37\t    0x30644e72e131a029ULL,\n38\t};\n39\t\n40\t// MU = P^{-1} mod 2^64  (used in Montgomery reduction)\n41\tstatic const uint64_t BN254_MU = 0x3d1e0a6c10000001ULL;\n42\t\n43\t// R^2 mod P  (converts canonical → Montgomery: mont(x) = monty_mul(R2, x))\n44\t__device__ __constant__ static const uint64_t BN254_R2[4] = {\n45\t    0x1bb8e645ae216da7ULL,\n46\t    0x53fe3ab1e35c59e3ULL,\n47\t    0x8c49833d53bb8085ULL,\n48\t    0x0216d0b17f4e44a5ULL,\n49\t};\n50\t\n51\t// 1 in Montgomery form = R mod P = 2^256 mod P\n52\t__device__ __constant__ static const uint64_t BN254_R_ONE[4] = {\n53\t    0xac96341c4ffffffbULL,\n54\t    0x36fc76959f60cd29ULL,\n55\t    0x666ea36f7879462eULL,\n56\t    0x0e0a77c19a07df2fULL,\n57\t};\n58\t\n59\t// 2 in Montgomery form\n60\t__device__ __constant__ static const uint64_t BN254_R_TWO[4] = {\n61\t    0x592c68389ffffff6ULL,\n62\t    0x6df8ed2b3ec19a53ULL,\n63\t    0xccdd46def0f28c5cULL,\n64\t    0x1c14ef83340fbe5eULL,\n65\t};\n66\t\n67\t// BabyBear prime\n68\tstatic const uint64_t BABYBEAR_PRIME = 0x78000001ULL;\n69\t\n70\t// ---------------------------------------------------------------------------\n71\t// 256-bit helpers: wrapping add/sub with carry/borrow\n72\t// ---------------------------------------------------------------------------\n73\t\n74\tstatic __device__ __forceinline__\n75\tuint64_t add256_ret(uint64_t r[4], const uint64_t a[4], const uint64_t b[4]) {\n76\t    uint64_t carry = 0;\n77\t    for (int i = 0; i < 4; i++) {\n78\t        __uint128_t t = (__uint128_t)a[i] + b[i] + carry;\n79\t        r[i] = (uint64_t)t;\n80\t        carry = (uint64_t)(t >> 64);\n81\t    }\n82\t    return carry;\n83\t}\n84\t\n85\t// returns 1 if borrow (a < b), else 0\n86\tstatic __device__ __forceinline__\n87\tuint64_t sub256_ret(uint64_t r[4], const uint64_t a[4], const uint64_t b[4]) {\n88\t    uint64_t borrow = 0;\n89\t    for (int i = 0; i < 4; i++) {\n90\t        __uint128_t t = (__uint128_t)a[i] - b[i] - borrow;\n91\t        r[i] = (uint64_t)t;\n92\t        // If a[i] < b[i]+borrow, we borrowed\n93\t        borrow = (t >> 127) ? 1 : 0;\n94\t    }\n95\