CK_KERNEL();\n651\t    if (err != 0) {\n652\t        return err;\n653\t    }\n654\t\n655\t    // Final reduction: same as lockstep - sum across all x_int blocks for each (coset, ntt_idx)\n656\t    auto num_blocks = grid.x;\n657\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n658\t    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n659\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n660\t    sumcheck::final_reduce_block_sums<<<num_cosets * skip_domain, reduce_block, reduce_shmem>>>(\n661\t        tmp_sums_buffer, output, num_blocks\n662\t    );\n663\t\n664\t    return CHECK_KERNEL();\n665\t}\n666\t\n667\textern \"C\" int _zerocheck_ntt_eval_constraints("}]},"parent_tool_use_id":"toolu_01Y9s2bXVuuXs5inbGD7w6Xp","session_id":"8c7f624f-3476-4fc9-b97f-853499dc45e9","uuid":"153f7335-9328-463e-922c-34e8cd535b36","timestamp":"2026-04-10T18:40:57.645Z"}
