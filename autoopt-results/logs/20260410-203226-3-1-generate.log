++lane) {\n451\t            auto lane_offset = (lane << l_skip) + threadIdx.x;\n452\t            tile_sum.p += shared_sum[lane_offset].p;\n453\t            tile_sum.q += shared_sum[lane_offset].q;\n454\t        }\n455\t        // Output layout: [num_x_blocks][num_cosets * skip_domain]\n456\t        // Same as lockstep to ensure final_reduce_block_sums works unchanged\n457\t        tmp_sums_buffer[blockIdx.x * num_cosets * skip_domain + coset_idx * skip_domain + ntt_idx] =\n458\t            tile_sum;\n459\t    }\n460\t}\n461\t\n462\t// ============================================================================\n463\t// LAUNCHERS\n464\t// ============================================================================\n465\t\n466\tconstexpr uint32_t MAX_THREADS = 128;\n467\t\n468\t// Helper to determine which mode to use based on threshold\n469\tinline bool use_coset_parallel_mode(uint32_t num_x, uint32_t skip_domain) {\n470\t    return (num_x * skip_domain) < COSET_PARALLEL_THRESHOLD;\n471\t}\n472\t\n473\t// (Not a launcher) Utility function to calculate required size of temp sum buffer.\n474\t// Required length of *temp_sum_buffer in FracExt elements\n475\textern \"C\" size_t _logup_r0_temp_sums_buffer_size(\n476\t    uint32_t buffer_size,\n477\t    uint32_t skip_domain,\n478\t    uint32_t num_x,\n479\t    uint32_t num_cosets,\n480\t    size_t max_temp_bytes\n481\t) {\n482\t    // Both modes use the same buffer size formula\n483\t    return DISPATCH_BOOL(\n484\t        round0_config_impl::temp_sums_buffer_size,\n485\t        use_coset_parallel_mode(num_x, skip_domain),\n486\t        buffer_size,\n487\t        skip_domain,\n488\t        num_x,\n489\t        num_cosets,\n490\t        max_temp_bytes,\n491\t        BUFFER_THRESHOLD,\n492\t        MAX_THREADS\n493\t    );\n494\t}\n495\t\n496\textern \"C\" size_t _logup_r0_intermediates_buffer_size(\n497\t    uint32_t buffer_size,\n498\t    uint32_t skip_domain,\n499\t    uint32_t num_x,\n500\t    uint32_t num_cosets,\n501\t