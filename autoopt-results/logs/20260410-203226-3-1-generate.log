{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LokhwreVZHWeLmDyuPnwCr","type":"tool_result","content":"667\textern \"C\" int _zerocheck_ntt_eval_constraints(\n668\t    FpExt *tmp_sums_buffer,   // [num_blocks][num_cosets * skip_domain]\n669\t    FpExt *output,            // [num_cosets * skip_domain]\n670\t    const Fp *selectors_cube, // [3][num_x]\n671\t    const Fp *preprocessed,\n672\t    const Fp *const *main_parts,\n673\t    const FpExt *eq_cube, // [num_x]\n674\t    const FpExt *d_lambda_pows,\n675\t    const Fp *public_values,\n676\t    const Rule *d_rules,\n677\t    size_t rules_len,\n678\t    const size_t *d_used_nodes,\n679\t    size_t used_nodes_len,\n680\t    size_t lambda_len,\n681\t    uint32_t buffer_size,\n682\t    Fp *d_intermediates,\n683\t    uint32_t skip_domain,\n684\t    uint32_t num_x,\n685\t    uint32_t height,\n686\t    uint32_t num_cosets,\n687\t    Fp g_shift,\n688\t    size_t max_temp_bytes\n689\t) {\n690\t    bool is_global = buffer_size > BUFFER_THRESHOLD;\n691\t    bool needs_shmem = skip_domain > WARP_SIZE;\n692\t\n693\t#define KERNEL_ARGS                                                                                \\\n694\t    tmp_sums_buffer, output, selectors_cube, preprocessed, main_parts, eq_cube, d_lambda_pows,     \\\n695\t        public_values, d_rules, rules_len, d_used_nodes, used_nodes_len, lambda_len, buffer_size,  \\\n696\t        d_intermediates, skip_domain, num_x, height\n697\t\n698\t    // Threshold-based dispatch: use coset-parallel for small workloads\n699\t    if (use_coset_parallel_mode(num_x, skip_domain)) {\n700\t        // Coset-parallel mode: grid.y = num_cosets, each block handles one coset\n701\t        return DISPATCH_BOOL_PAIR(\n702\t            launch_zerocheck_coset_parallel,\n703\t            is_global,\n704\t            needs_shmem,\n705\t            KERNEL_ARGS,\n706\t            num_cosets,\n707\t            g_shift,\n708\t            max_temp_bytes\n709\t        );\n71