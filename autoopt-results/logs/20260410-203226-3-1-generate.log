n1043\t        }\n1044\t\n1045\t        self.mem\n1046\t            .emit_metrics_with_label(\"prover.batch_constraints.fold_ple_evals\");\n1047\t        Ok(())\n1048\t    }\n1049\t\n1050\t    #[instrument(\n1051\t        name = \"LogupZerocheck::sumcheck_polys_batch_eval\",\n1052\t        level = \"info\",\n1053\t        skip_all,\n1054\t        fields(round = round)\n1055\t    )]\n1056\t    fn sumcheck_polys_batch_eval(\n1057\t        &mut self,\n1058\t        round: usize,\n1059\t        r_prev: EF,\n1060\t    ) -> Result<Vec<Vec<EF>>, LogupZerocheckError> {\n1061\t        let sp_deg = self.constraint_degree;\n1062\t\n1063\t        // Per-trace outputs (filled as we go)\n1064\t        let mut zc_out: Vec<Vec<EF>> = vec![vec![EF::ZERO; sp_deg]; self.n_per_trace.len()];\n1065\t        let mut logup_out: Vec<[Vec<EF>; 2]> =\n1066\t            vec![[vec![EF::ZERO; sp_deg], vec![EF::ZERO; sp_deg]]; self.n_per_trace.len()];\n1067\t\n1068\t        // Keep early interpolations alive for duration of kernels\n1069\t        let mut _keepalive_interpolated: Vec<DeviceMatrix<EF>> = Vec::new();\n1070\t\n1071\t        let mut late_eval: Vec<TraceCtx> = Vec::new(); // round == n_lift + 1\n1072\t        let mut early_eval: Vec<TraceCtx> = Vec::new(); // round <= n_lift\n1073\t\n1074\t        // First, handle traces in original order and split into cases\n1075\t        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n1076\t            self.n_per_trace.iter(),\n1077\t            self.mat_evals_per_trace.iter(),\n1078\t            self.sels_per_trace.iter(),\n1079\t            self.d_eq_3b_per_trace.iter(),\n1080\t            self.public_values_per_trace.iter(),\n1081\t            self.air_indices_per_trace.iter()\n1082\t        )\n1083\t        .enumerate()\n1084\t        {\n1085\t            let pk = &self.pk.per_air[air_idx];\n1086\t            let dag = &pk.vk.symbolic_constraints;\n1087\t            let has_constraints = dag.constraints.num_constraint