treams.\n931\t        current_stream_sync().map_err(MemCopyError::from)?;\n932\t\n933\t        // Phase 2: Process AIRs in parallel across N OS threads.\n934\t        // Only use multi-threading when there are enough AIRs to benefit from concurrent\n935\t        // kernel execution. With few large AIRs (e.g., APC 0 has ~20 per segment), each\n936\t        // kernel already saturates the GPU and multi-threading adds memory pool overhead.\n937\t        let num_threads = if work_items.len() >= 100 {\n938\t            NUM_ROUND0_STREAMS.min(work_items.len())\n939\t        } else {\n940\t            1\n941\t        };\n942\t        let results: Vec<Round0AirResult> = if num_threads <= 1 {\n943\t            work_items\n944\t                .iter()\n945\t                .map(|w| process_air_round0(w))\n946\t                .collect::<Result<Vec<_>, _>>()?\n947\t        } else {\n948\t            let chunk_size = work_items.len().div_ceil(num_threads);\n949\t            std::thread::scope(|s| {\n950\t                let handles: Vec<_> = work_items\n951\t                    .chunks(chunk_size)\n952\t                    .map(|chunk| {\n953\t                        s.spawn(move || -> Result<Vec<Round0AirResult>, LogupZerocheckError> {\n954\t                            chunk.iter().map(|w| process_air_round0(w)).collect()\n955\t                        })\n956\t                    })\n957\t                    .collect();\n958\t                let mut all_results = Vec::with_capacity(work_items.len());\n959\t                for handle in handles {\n960\t                    all_results.extend(handle.join().unwrap()?);\n961\t                }\n962\t                Ok::<_, LogupZerocheckError>(all_results)\n963\t            })?\n964\t        };\n965\t\n966\t        // Phase 3: Scatter results into batch_sp_poly (main thread, pure CPU)\n967\t        for result in results {\n968\t            if let Some(poly) = result.zerocheck_poly {\n969\t                batch_sp_poly[2 * num_present_airs + result.trace_idx] = poly;"}]},"parent_tool_use_id":"toolu_01Uussd4qWbdV3ByH7qycYd7","session_id":"e6440d5e-5fb7-4583-a464-0e3f9791a04a","uuid":"a8a3f747-836b-40de-bdf9-bac67a6747d4","timestamp":"2026-04-13T03:22:29.030Z"}
