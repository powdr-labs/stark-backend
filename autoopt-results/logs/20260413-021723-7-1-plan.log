{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LjtjbuPxvfcW1m9bMohQgU","type":"tool_result","content":"85\tpub use errors::*;\n86\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n87\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n88\tuse round0::evaluate_round0_constraints_gpu;\n89\t\n90\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n91\t/// More threads = more concurrent kernels but more peak GPU memory and more\n92\t/// MemoryManager mutex contention. 4 is a good balance for the RTX 4090.\n93\tconst NUM_ROUND0_STREAMS: usize = 4;\n94\t\n95\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n96\t/// instead of the monomial kernel for high num_y traces.\n97\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n98\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n99\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;"}]},"parent_tool_use_id":"toolu_01A6ojr9DPp1tgy7dbuQbzdu","session_id":"e6440d5e-5fb7-4583-a464-0e3f9791a04a","uuid":"f758f610-1365-4b58-897a-145ca2fd985b","timestamp":"2026-04-13T03:18:12.147Z"}
