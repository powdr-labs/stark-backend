{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ctf2hyepCqXikFghLwdMck","type":"tool_result","content":"1\tuse super::*;\n2\tuse crate::{\n3\t    monomial::{InteractionMonomialTerm, LambdaTerm, MonomialHeader, PackedVar},\n4\t    poly::SqrtEqLayers,\n5\t};\n6\t\n7\t#[repr(C)]\n8\t#[derive(Clone, Copy, Debug)]\n9\tpub struct MainMatrixPtrs<T> {\n10\t    pub data: *const T,\n11\t    pub air_width: u32,\n12\t}\n13\t\n14\t// Types for batch MLE:\n15\t#[repr(C)]\n16\t#[derive(Clone, Copy, Debug)]\n17\tpub struct BlockCtx {\n18\t    pub local_block_idx_x: u32,\n19\t    /// Caution: this refers to the index within buffer of `ZerocheckCtx` or `LogupCtx`. It is\n20\t    /// hence a \"local\" AIR index and not the global AIR index within the proving key.\n21\t    pub air_idx: u32,\n22\t}\n23\t\n24\t/// Per-AIR context for batched monomial evaluation.\n25\t#[repr(C)]\n26\t#[derive(Clone, Copy, Debug)]\n27\tpub struct MonomialAirCtx {\n28\t    pub d_headers: *const MonomialHeader,\n29\t    pub d_variables: *const PackedVar,\n30\t    pub d_lambda_combinations: *const EF, // Precomputed per-monomial\n31\t    pub num_monomials: u32,\n32\t    pub eval_ctx: EvalCoreCtx,\n33\t    pub d_eq_xi: *const EF,\n34\t    pub num_y: u32,\n35\t}\n36\t\n37\t#[repr(C)]\n38\t#[derive(Clone, Copy, Debug)]\n39\tpub struct EvalCoreCtx {\n40\t    pub d_selectors: *const EF,\n41\t    pub d_preprocessed: MainMatrixPtrs<EF>,\n42\t    pub d_main: *const MainMatrixPtrs<EF>,\n43\t    pub d_public: *const F,\n44\t}\n45\t\n46\t#[repr(C)]\n47\t#[derive(Clone, Copy, Debug)]\n48\tpub struct ZerocheckCtx {\n49\t    pub eval_ctx: EvalCoreCtx,\n50\t    pub d_intermediates: *mut EF,\n51\t    pub num_y: u32,\n52\t    pub d_eq_xi: *const EF,\n53\t    pub d_rules: *const std::ffi::c_void,\n54\t    pub rules_len: usize,\n55\t    pub d_used_nodes: *const usize,\n56\t    pub used_nodes_len: usize,\n57\t    pub buffer_size: u32,\n58\t}\n59\t\n60\t#[repr(C)]\n61\t#[derive(Clone, Copy, Debug)]\n62\tpub struct LogupCtx {\n63\t    pub eval_ctx: EvalCoreCtx,\n64\t    pub d_intermediates: *mut EF,\n65\t    pub num_y: u32,\n66\t    pub d_eq_xi: *const EF,\n67\t    pub d_challenges: *const EF,\n68\t    pub d_eq_3bs: *const EF,\n69\t    pub d_rules: *const std::ffi::c_void,\n70\t    pub rules_len: usize,\n71\t    pub d_used_nodes: *const usize,\n72\t    pub d_pair_idxs: *const u32,\n73\t    pub used_nodes_len: usize,\n74\t    pub buffer_size: u32,\n75\t}\n76\t\n77\t/// Common per-AIR context for batched logup monomial evaluation.\n78\t#[repr(C)]\n79\t#[derive(Clone, Copy, Debug)]\n80\tpub struct LogupMonomialCommonCtx {\n81\t    pub eval_ctx: EvalCoreCtx,\n82\t    pub d_eq_xi: *const EF,\n83\t    pub bus_term_sum: EF, // Precomputed sum_i(beta[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n84\t    pub num_y: u32,\n85\t    pub mono_blocks: u32,\n86\t}\n87\t\n88\t/// Per-AIR context for batched logup monomial evaluation (numerator or denominator).\n89\t#[repr(C)]\n90\t#[derive(Clone, Copy, Debug)]\n91\tpub struct LogupMonomialCtx {\n92\t    pub d_headers: *const MonomialHeader,\n93\t    pub d_variables: *const PackedVar,\n94\t    pub d_combinations: *const EF,\n95\t    pub num_monomials: u32,\n96\t}\n97\t// end of types for batch MLE\n98\t\n99\textern \"C\" {\n100\t    // gkr.cu\n101\t    fn _frac_build_tree_layer(\n102\t        layer: *mut Frac<EF>,\n103\t        layer_size: usize,\n104\t        revert: bool,\n105\t        alpha: EF,\n106\t        apply_alpha: bool,\n107\t    ) -> i32;\n108\t\n109\t    /// Fused two-layer tree build. Applies layers i and i+1 in one kernel pass,\n110\t    /// keeping intermediate right-half nodes for revert operations.\n111\t    /// `half_i1` = N >> (i+2), where i is the first of the two layers.\n112\t    fn _frac_build_tree_two_layers(layer: *mut Frac<EF>, half_i1: usize) -> i32;\n113\t\n114\t    pub fn _frac_compute_round_temp_buffer_size(stride: u32) -> u32;\n115\t\n116\t    fn _frac_compute_round(\n117\t        eq_xi_low: *const EF,\n118\t        eq_xi_high: *const EF,\n119\t        pq_buffer: *const Frac<EF>,\n120\t        num_x: usize,\n121\t        eq_low_cap: usize,\n122\t        lambda: EF,\n123\t        out_device: *mut EF,\n124\t        tmp_block_sums: *mut EF,\n125\t    ) -> i32;\n126\t\n127\t    /// Fused compute round + tree layer revert. Combines frac_build_tree_layer(revert=true)\n128\t    /// with compute_round for the first inner round. Modifies layer in-place for revert.\n129\t    fn _frac_compute_round_and_revert(\n130\t        eq_xi_low: *const EF,\n131\t        eq_xi_high: *const EF,\n132\t        layer: *mut Frac<EF>,\n133\t        num_x: usize,\n134\t        eq_low_cap: usize,\n135\t        lambda: EF,\n136\t        out_device: *mut EF,\n137\t        tmp_block_sums: *mut EF,\n138\t    ) -> i32;\n139\t\n140\t    fn _frac_fold_fpext_columns(\n141\t        src: *const Frac<EF>,\n142\t        dst: *mut Frac<EF>,\n143\t        size: usize,\n144\t        r: EF,\n145\t    ) -> i32;\n146\t\n147\t    /// Fused compute round + fold (out-of-place). Reads from pre-fold src_pq_buffer (size\n148\t    /// src_pq_size), computes sumcheck sums, and writes folded output to dst_pq_buffer (size\n149\t    /// src_pq_size/2). IMPORTANT: src_pq_buffer and dst_pq_buffer must NOT alias.\n150\t    fn _frac_compute_round_and_fold(\n151\t        eq_xi_low: *const EF,\n152\t        eq_xi_high: *const EF,\n153\t        src_pq_buffer: *const Frac<EF>,\n154\t        dst_pq_buffer: *mut Frac<EF>,\n155\t        src_pq_size: usize,\n156\t        eq_low_cap: usize,\n157\t        lambda: EF,\n158\t        r_prev: EF,\n159\t        out_device: *mut EF,\n160\t        tmp_block_sums: *mut EF,\n161\t    ) -> i32;\n162\t\n163\t    /// Fused compute round + fold (in-place). Reads from pre-fold pq_buffer (size src_pq_size),\n164\t    /// computes sumcheck sums, and writes folded output to the same buffer (first src_pq_size/2\n165\t    /// elements).\n166\t    fn _frac_compute_round_and_fold_inplace(\n167\t        eq_xi_low: *const EF,\n168\t        eq_xi_high: *const EF,\n169\t        pq_buffer: *mut Frac<EF>,\n170\t        src_pq_size: usize,\n171\t        eq_low_cap: usize,\n172\t        lambda: EF,\n173\t        r_prev: EF,\n174\t        out_device: *mut EF,\n175\t        tmp_block_sums: *mut EF,\n176\t    ) -> i32;\n177\t\n178\t    fn _frac_precompute_m_build(\n179\t        pq: *const Frac<EF>,\n180\t        rem_n: usize,\n181\t        w: usize,\n182\t        lambda: EF,\n183\t        r_prev: EF,\n184\t        inline_fold: bool,\n185\t        eq_tail_low: *const EF,\n186\t        eq_tail_high: *const EF,\n187\t        eq_tail_low_cap: usize,\n188\t        tail_tile: usize,\n189\t        partial_out: *mut EF,\n190\t        partial_len: usize,\n191\t        m_total: *mut EF,\n192\t    ) -> i32;\n193\t\n194\t    fn _frac_precompute_m_eval_round(\n195\t        m_total: *const EF,\n196\t        w: usize,\n197\t        t: usize,\n198\t        eq_r_prefix: *const EF,\n199\t        eq_suffix: *const EF,\n200\t        out: *mut EF,\n201\t    ) -> i32;\n202\t\n203\t    fn _frac_multifold(\n204\t        src: *const Frac<EF>,\n205\t        dst: *mut Frac<EF>,\n206\t        rem_n: usize,\n207\t        w: usize,\n208\t        eq_r_window: *const EF,\n209\t    ) -> i32;\n210\t\n211\t    fn _frac_add_alpha(data: *mut std::ffi::c_void, len: usize, alpha: EF) -> i32;\n212\t\n213\t    fn _frac_vector_scalar_multiply_ext_fp(frac_vec: *mut Frac<EF>, scalar: F, length: u32) -> i32;\n214\t\n215\t    // utils.cu\n216\t    fn _fold_ple_from_evals(\n217\t        input_matrix: *const F,\n218\t        output_matrix: *mut EF,\n219\t        omega_skip_pows: *const F,\n220\t        inv_lagrange_denoms: *const EF,\n221\t        height: u32,\n222\t        width: u32,\n223\t        l_skip: u32,\n224\t        new_height: u32,\n225\t        rotate: bool,\n226\t    ) -> i32;\n227\t\n228\t    fn _interpolate_columns(\n229\t        interpolated: *mut EF,\n230\t        columns: *const *const EF,\n231\t        s_deg: usize,\n232\t        num_y: usize,\n233\t        num_columns: usize,\n234\t    ) -> i32;\n235\t\n236\t    fn _frac_matrix_vertically_repeat(\n237\t        out: *mut Frac<EF>,\n238\t        input: *const Frac<EF>,\n239\t        width: u32,\n240\t        lifted_height: u32,\n241\t        height: u32,\n242\t    ) -> i32;\n243\t\n244\t    fn _frac_matrix_vertically_repeat_ext(\n245\t        out_numerators: *mut EF,\n246\t        out_denominators: *mut EF,\n247\t        in_numerators: *const EF,\n248\t        in_denominators: *const EF,\n249\t        width: u32,\n250\t        lifted_height: u32,"}]},"parent_tool_use_id":"toolu_01LbhgoZtXURug6u5zGrHw7E","session_id":"e6440d5e-5fb7-4583-a464-0e3f9791a04a","uuid":"352b69a8-2f26-4f7a-98d5-aa835111c68c","timestamp":"2026-04-13T00:19:06.366Z"}
