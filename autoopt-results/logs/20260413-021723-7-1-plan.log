{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QEvkGxU6ZSFLx1gCS4UkfE","type":"tool_result","content":"1\tuse std::{array::from_fn, cmp::max, ffi::c_void, iter::zip, mem, sync::Arc};\n2\t\n3\tuse itertools::{zip_eq, Itertools};\n4\tuse openvm_cuda_common::{\n5\t    copy::{cuda_memcpy, MemCopyD2H, MemCopyH2D},\n6\t    d_buffer::DeviceBuffer,\n7\t    memory_manager::MemTracker,\n8\t};\n9\tuse openvm_stark_backend::{\n10\t    dft::Radix2BowersSerial,\n11\t    p3_matrix::dense::RowMajorMatrix,\n12\t    poly_common::{\n13\t        eq_uni_poly, eval_eq_mle, eval_eq_uni, eval_eq_uni_at_one, eval_in_uni, Squarable,\n14\t        UnivariatePoly,\n15\t    },\n16\t    proof::StackingProof,\n17\t    prover::{\n18\t        stacked_pcs::StackedLayout, sumcheck::sumcheck_round0_deg, DeviceMultiStarkProvingKey,\n19\t        MatrixDimensions, ProvingContext,\n20\t    },\n21\t};\n22\tuse p3_dft::TwoAdicSubgroupDft;\n23\tuse p3_field::{PrimeCharacteristicRing, TwoAdicField};\n24\tuse tracing::{debug, info_span, instrument};\n25\t\n26\tuse crate::{\n27\t    base::DeviceMatrix,\n28\t    cuda::{\n29\t        batch_ntt_small::ensure_device_ntt_twiddles_initialized,\n30\t        poly::vector_scalar_multiply_ext,\n31\t        stacked_reduction::{\n32\t            _stacked_reduction_r0_required_temp_buffer_size, initialize_k_rot_from_eq_segments,\n33\t            stacked_reduction_fold_ple, stacked_reduction_sumcheck_mle_round,\n34\t            stacked_reduction_sumcheck_mle_round_degenerate, stacked_reduction_sumcheck_round0,\n35\t            NUM_G,\n36\t        },\n37\t        sumcheck::{fold_mle, triangular_fold_mle},\n38\t    },\n39\t    gpu_backend::GenericGpuBackend,\n40\t    hash_scheme::GpuHashScheme,\n41\t    poly::EqEvalSegments,\n42\t    prelude::{Digest, D_EF, EF, F},\n43\t    sponge::GpuFiatShamirTranscript,\n44\t    stacked_pcs::StackedPcsDataGpu,\n45\t    utils::{compute_barycentric_inv_lagrange_denoms, reduce_raw_u64_to_ef},\n46\t    GpuDevice, StackedReductionError,\n47\t};\n48\t\n49\t/// Degree of the sumcheck polynomial for stacked reduction.\n50\tpub const STACKED_REDUCTION_S_DEG: usize = 2;\n51\t\n52\tpub struct StackedReductionGpu<D = Digest> {\n53\t    sm_count: u32,\n54\t\n55\t    l_skip: usize,\n56\t    n_stack: usize,\n57\t\n58\t    omega_skip: F,\n59\t    omega_skip_pows: Vec<F>,\n60\t    d_omega_skip_pows: DeviceBuffer<F>,\n61\t\n62\t    r_0: EF,\n63\t    d_lambda_pows: DeviceBuffer<EF>,\n64\t    eq_const: EF,\n65\t\n66\t    pub(crate) stacked_per_commit: Vec<StackedPcsData2<D>>,\n67\t    d_q_widths: DeviceBuffer<u32>,\n68\t    q_width_max: u32,\n69\t    d_q_eval_ptrs: DeviceBuffer<*const EF>,\n70\t\n71\t    trace_ptrs: Vec<(\n72\t        *const F, /* trace_ptr */\n73\t        usize,    /* height */\n74\t        usize,    /* width */\n75\t    )>,\n76\t    unstacked_cols: Vec<UnstackedSlice>,\n77\t    d_unstacked_cols: DeviceBuffer<UnstackedSlice>,\n78\t    // boundary indices where heights change. all columns between two boundaries must have the same\n79\t    // height. We can have multiple chunks of the same height if that is needed to reduce peak GPU\n80\t    // memory.\n81\t    ht_diff_idxs: Vec<usize>,\n82\t    n_max: usize,\n83\t\n84\t    // Initially holds eq(r[1..=n], H_n) for n=0..=n_max but gets updated after each sumcheck round\n85\t    // by some custom folding\n86\t    eq_r_ns: EqEvalSegments<EF>,\n87\t\n88\t    // == After round 0 ==\n89\t    q_evals: Vec<DeviceBuffer<EF>>, // get width from stacked_per_commit\n90\t    // Stores folded eq values that won't change anymore (no more folding)\n91\t    // Corresponds to log_height in 0..l_skip+round-1 _before_ round `round`. Gets updated with one\n92\t    // new element after each round.\n93\t    eq_stable: Vec<EF>,\n94\t    k_rot_stable: Vec<EF>,\n95\t\n96\t    /// Stores the folded k_rot evaluations for `\\kappa_\\rot(x, r) = eq_n(rot^{-1}(x), r)` for each\n97\t    /// `n` after each round. We use the [EqEvalSegments] type to guard the segment-based\n98\t    /// memory layout.\n99\t    k_rot_ns: EqEvalSegments<EF>,\n100\t    /// Stores eq(u[1+n_T..round-1], b_{T,j}[..round-n_T-1])\n101\t    eq_ub_per_trace: Vec<EF>,\n102\t    d_eq_ub_all: DeviceBuffer<EF>,\n103\t\n104\t    d_block_sums: DeviceBuffer<EF>,\n105\t    d_accum: DeviceBuffer<u64>,\n106\t    d_input_ptrs: DeviceBuffer<*const EF>,\n107\t    d_output_ptrs: DeviceBuffer<*mut EF>,\n108\t\n109\t    mem: MemTracker,\n110\t}\n111\t\n112\t/// A struct for holding stacked pcs data. We only need the `MerkleTreeGpu` from `StackedPcsDataGpu`\n113\t/// but we wrap the latter in an `Arc` to provide uniformity in dealing with common main and\n114\t/// preprocessed/cached traces. This struct stores the unstacked `traces`, in prismalinear\n115\t/// evaluation form, corresponding to the stacked pcs data.\n116\t///\n117\t/// Generic over the Merkle digest type `D`.  The default `D = Digest` preserves the existing\n118\t/// BabyBear-Poseidon2 behaviour.\n119\tpub struct StackedPcsData2<D = Digest> {\n120\t    pub(crate) inner: Arc<StackedPcsDataGpu<F, D>>,\n121\t    /// The unstacked traces corresponding to `inner`'s commitment.\n122\t    pub(crate) traces: Vec<DeviceMatrix<F>>,\n123\t}\n124\t\n125\timpl<D> StackedPcsData2<D> {\n126\t    /// # Safety\n127\t    /// `traces` must be the traces that were committed to in `pcs_data`.\n128\t    pub unsafe fn from_raw(\n129\t        pcs_data: Arc<StackedPcsDataGpu<F, D>>,\n130\t        traces: Vec<DeviceMatrix<F>>,\n131\t    ) -> Self {\n132\t        Self {\n133\t            inner: pcs_data,\n134\t            traces,\n135\t        }\n136\t    }\n137\t\n138\t    pub fn layout(&self) -> &StackedLayout {\n139\t        &self.inner.layout\n140\t    }\n141\t}\n142\t\n143\t/// Pointer with length to location in a big device buffer. The device buffer is identified by\n144\t/// `commit_idx`. Due to pecuarlities with `l_skip`, the length of the slice is defined as\n145\t/// `max(2^log_height, 2^l_skip)`. In other words, this is a pointer to the slice\n146\t/// `q[commit_idx].column(stacked_col_idx)[stacked_row_idx..stacked_row_idx + len]`.\n147\t///\n148\t/// # Safety\n149\t/// - this type is `repr(C)` as it will cross FFI boundaries for CUDA usage.\n150\t#[repr(C)]\n151\t#[derive(Clone, Copy, Debug)]\n152\tpub(crate) struct UnstackedSlice {\n153\t    commit_idx: u32,\n154\t    log_height: u32,\n155\t    stacked_row_idx: u32,\n156\t    stacked_col_idx: u32,\n157\t}\n158\t\n159\timpl<D> StackedReductionGpu<D> {\n160\t    fn log_stacked_height(&self, round: usize) -> usize {\n161\t        self.n_stack - (round - 1)\n162\t    }\n163\t\n164\t    fn stacked_height(&self, round: usize) -> usize {\n165\t        1 << self.log_stacked_height(round)\n166\t    }\n167\t\n168\t    /// Current maximum `n` supported by eq_r_ns\n169\t    fn cur_max_n(&self, round: usize) -> usize {\n170\t        self.n_max - (round - 1)\n171\t    }\n172\t}\n173\t\n174\t/// Batch sumcheck to reduce trace openings, including rotations, to stacked matrix opening.\n175\t///\n176\t/// The `stacked_matrix, stacked_layout` should be the result of stacking the `traces` with\n177\t/// parameters `l_skip` and `n_stack`.\n178\t#[allow(clippy::type_complexity)]\n179\t#[instrument(\n180\t    name = \"prover.openings.stacked_reduction\",\n181\t    level = \"info\",\n182\t    skip_all,\n183\t    fields(phase = \"prover\")\n184\t)]\n185\tpub fn prove_stacked_opening_reduction_gpu<HS, TS>(\n186\t    device: &GpuDevice,\n187\t    transcript: &mut TS,\n188\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n189\t    ctx: ProvingContext<GenericGpuBackend<HS>>,\n190\t    common_main_pcs_data: StackedPcsDataGpu<F, HS::Digest>,\n191\t    r: &[EF],\n192\t) -> Result<\n193\t    (\n194\t        StackingProof<HS::SC>,\n195\t        Vec<EF>,\n196\t        Vec<StackedPcsData2<HS::Digest>>,\n197\t    ),\n198\t    StackedReductionError,\n199\t>\n200\twhere"}]},"parent_tool_use_id":"toolu_01ULWh2wUUUwmVnHavGcTaoJ","session_id":"e6440d5e-5f