EF>, Round0EvalError> {\n45\t    let constraints_dag = &pk.vk.symbolic_constraints;\n46\t    if constraints_dag.constraints.constraint_idx.is_empty() || num_cosets == 0 {\n47\t        // No plain AIR constraints, return empty buffer\n48\t        return Ok(DeviceBuffer::new());\n49\t    }\n50\t\n51\t    let rules = &pk.other_data.zerocheck_round0;\n52\t\n53\t    let buffer_size: u32 = rules.inner.buffer_size;\n54\t    let intermed_capacity = unsafe {\n55\t        _zerocheck_r0_intermediates_buffer_size(\n56\t            buffer_size,\n57\t            skip_domain,\n58\t            num_x,\n59\t            num_cosets,\n60\t            max_temp_bytes,\n61\t        )\n62\t    };\n63\t    let mut intermediates = if intermed_capacity > 0 {\n64\t        debug!(\"zerocheck:intermediates_capacity={intermed_capacity}\");\n65\t        DeviceBuffer::<F>::with_capacity(intermed_capacity)\n66\t    } else {\n67\t        DeviceBuffer::<F>::new()\n68\t    };\n69\t\n70\t    let temp_sums_buffer_capacity = unsafe {\n71\t        _zerocheck_r0_temp_sums_buffer_size(\n72\t            buffer_size,\n73\t            skip_domain,\n74\t            num_x,\n75\t            num_cosets,\n76\t            max_temp_bytes,\n77\t        )\n78\t    };\n79\t    debug!(\"zerocheck:temp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n80\t    let mut temp_sums_buffer = DeviceBuffer::<EF>::with_capacity(temp_sums_buffer_capacity);\n81\t    let used_temp_bytes =\n82\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<EF>();\n83\t    if used_temp_bytes > max_temp_bytes {\n84\t        // We do not error if the required bytes is greater than the requested max, but this may\n85\t        // lead to unexpected peak memory usage.\n86\t        warn!(\"zerocheck used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\");\n87\t    }\n88\t\n89\t    let preprocessed_ptr = pk\n90\t        .preprocessed_data\n91\t        .as_ref()\n92\t        .map(|cd| cd.trace.buffer().as_ptr())\n93\t        .unwrap_or(std::ptr::null());\n94\t\n95\t    let mut sp_evals =\n96\t        DeviceBuffer::<EF>::with_capacity(num_cosets as usize * skip_domain as usize);\n97\t    // SAFETY:\n98\t    // - No bounds checks are done in this kernel. It fully assumes that the Rules are trusted and\n99\t    //   all nodes are valid.\n100\t    unsafe {\n101\t        zerocheck_ntt_eval_constraints(\n102\t            &mut temp_sums_buffer,\n103\t            &mut sp_evals,\n104\t            selectors_cube,\n105\t            preprocessed_ptr,\n106\t            main_parts,\n107\t            eq_cube,\n108\t            lambda_pows,\n109\t            public_values,\n110\t            &rules.inner.d_rules,\n111\t            &rules.inner.d_used_nodes,\n112\t            buffer_size,\n113\t            &mut intermediates,\n114\t            skip_domain,\n115\t            num_x,\n116\t            height,\n117\t            num_cosets,\n118\t            g_shift,\n119\t            max_temp_bytes,\n120\t        )?;\n121\t    }\n122\t\n123\t    Ok(sp_evals)\n124\t}\n125\t\n126\t/// Evaluate interaction constraints (excluding plain AIR constraints) for a single AIR, given\n127\t/// prepared trace input.\n128\t///\n129\t/// `constraints` includes interaction expressions for the AIR.\n130\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n131\t#[allow(clippy::too_many_arguments)]\n132\tpub fn evaluate_round0_interactions_gpu<HS: GpuHashScheme>(\n133\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n134\t    symbolic: &SymbolicConstraints<F>,\n135\t    selectors_cube: &DeviceBuffer<F>,\n136\t    main_parts: &DeviceBuffer<*const F>,\n137\t    public_values: &DeviceBuffer<F>,\n138\t    eq_cube: *const EF,\n139\t    beta_pows: &[EF],\n140\t    eq_3bs: &[EF],\n141\t    skip_domain: u32,\n142\t    num_x: u32,\n143\t    height: u32,\n144\t    num_cosets: u32,\n145\t    g_shift: F,\n146\t    max_temp_bytes: usize,\n147\t) -> Result<DeviceBuffer<Frac<EF>>, Round0EvalError> {\n148\t    // Check if this trace has interactions\n149\t    if eq_3bs.is_empty() {\n150\t        return Ok(DeviceBuffer::new());\n151\t    }\n152\t    let large_domain = num_cosets * skip_domain;\n153\t\n154\t    // We create a new \"interactions DAG\" where the new .constraints are the interaction [count,\n155\t    // message_0, message_1, ..] expressions themselves, while the .interactions are empty\n156\t    // We track the indices with InteractionNode\n157\t\n158\t    // Copied from build_symbolic_constraints_dag to handle sorting of constraints\n159\t    // NOTE: For logup round0, the kernel uses weights indexed by rule_idx, not constraint_idx.\n160\t    // So we deduplicate constraint_idx and use dag_idx_to_rule_idx for weight mapping.\n161\t    let (rules, d_numer_weights, d_denom_weights, denom_sum_init) = {\n162\t        let mut dag_builder = SymbolicDagBuilder::new();\n163\t        let mut sorted_used_dag_idxs = Vec::new();\n164\t        for interaction in &symbolic.interactions {\n165\t            let count = dag_builder.add_expr(&interaction.count);\n166\t            sorted_used_dag_idxs.push(count);\n167\t            sorted_used_dag_idxs.extend(\n168\t                interaction\n169\t                    .message\n170\t                    .iter()\n171\t                    .map(|field_expr| dag_builder.add_expr(field_expr)),\n172\t            );\n173\t        }\n174\t        sorted_used_dag_idxs.sort();\n175\t        // Deduplicate for the dag since logup round0 kernel doesn't use used_nodes\n176\t        sorted_used_dag_idxs.dedup();\n177\t        let dag = SymbolicExpressionDag {\n178\t            nodes: dag_builder.nodes,\n179\t            constraint_idx: sorted_used_dag_idxs,\n180\t        };\n181\t        let rules = SymbolicRulesGpu::new(&dag, true);\n182\t        let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n183\t        let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n184\t        let mut denom_sum_init = EF::ZERO;\n185\t        for (interaction_idx, interaction) in symbolic.interactions.iter().enumerate() {\n186\t            // CAUTION: an expression node could be used in multiple interactions, and might even be\n187\t            // used as `count` in one, but message field in another. We only care about their\n188\t            // weighted sum with eq_3b, so we compute the weights ahead of time.\n189\t            let count_dag_idx =\n190\t                dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];\n191\t            let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n192\t            numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n193\t            denom_sum_init += eq_3bs[interaction_idx]\n194\t                * beta_pows[interaction.message.len()]\n195\t                * F::from_u32(interaction.bus_index as u32 + 1);\n196\t\n197\t            for (message_idx, message) in interaction.message.iter().enumerate() {\n198\t                let message_dag_idx =\n199\t                    dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n200\t                let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n201\t                denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];\n202\t            }\n203\t        }\n204\t        let d_numer_weights = numer_weights.to_device()?;\n205\t        let d_denom_weights = denom_weights.to_device()?;\n206\t        (rules, d_numer_weights, d_denom_weights, denom_sum_init)\n207\t    };\n208\t\n209\t    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n210\t    let d_rules = encoded_rules.to_device()?;\n211\t\n212\t    let buffer_size: u32 = rules.buffer_size.try_into().unwrap();\n213\t    let intermed_capacity = unsafe {\n214\t        _logup_r0_intermediates_buffer_size(\n215\t            buffer_size,\n216\t            skip_domain,\n217\t            num_x,\n218\t            num_cosets,\n219\t            max_temp_bytes,\n220\t        )\n221\t    };\n222\t    let mut intermediates = if intermed_capacity > 0 {\n223\t        debug!(\"logup_r0:intermediates_capacity={intermed_capacity}\");\n224\t        DeviceBuffer::<F>::with_capacity(intermed_capacity)\n225\t    } else {\n226\t        DeviceBuffer::<F>::new()\n227\t    };\n228\t\n229\t    let temp_sums_buffer_capacity = unsafe {\n230\t        _logup_r0_temp_sums_buffer_size(buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes)\n231\t    };\n232\t    debug!(\"logup_r0:tmp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n233\t    let mut temp_sums_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(temp_sums_buffer_capacity);\n234\t    let used_temp_bytes =\n235\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<Frac<EF>>();\n236\t    if used_temp_bytes > max_temp_bytes {\n237\t        warn!(\n238\t            \"logup_round0 used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\"\n239\t        );\n240\t    }\n241\t\n242\t    let preprocessed_ptr = pk\n243\t        .preprocessed_data\n244\t        .as_ref()\n245\t        .map(|cd| cd.trace.buffer().as_ptr())\n246\t        .unwrap_or(std::ptr::null());\n247\t\n248\t    let mut s_evals = DeviceBuffer::<Frac<EF>>::with_capacity(large_domain as usize);\n249\t\n250\t    unsafe {\n251\t        logup_bary_eval_interactions_round0(\n252\t            &mut temp_sums_buffer,\n253\t            &mut s_evals,\n254\t            selectors_cube,\n255\t            preprocessed_ptr,\n256\t            main_parts,\n257\t            eq_cube,\n258\t            public_values,\n259\t            &d_numer_weights,\n260\t            &d_denom_weights,\n261\t            denom_sum_init,\n262\t            &d_rules,\n263\t            buffer_size,\n264\t            &mut intermediates,\n265\t            skip_domain,\n266\t            num_x,\n267\t            height,\n268\t            num_cosets,\n269\t            g_shift,\n270\t            max_temp_bytes,\n271\t        )?;\n272\t    }\n273\t\n274\t    Ok(s_evals)\n275\t}\n276\t"}]},"parent_tool_use_id":"toolu_01LbhgoZtXURug6u5zGrHw7E","session_id":"e6440d5e-5fb7-4583-a464-0e3f9791a04a","uuid":"da17a516-7134-4c16-9fc7-c091a85b0972","timestamp":"2026-04-13T00:18:46.432Z"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01TRczRD37UeFNtSsfWvVdxJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018thayFzv45CZX4KtRHeeYr","name":"Read","input":{"file_path":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/mod.rs","offset":1,"limit":400},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":6,"cache_creation_input_tokens":6174,"cache_read_input_tokens":13403,"cache_creation":{"ephemeral_5m_input_tokens":6174,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":"toolu_01LbhgoZtXURug6u5zGrHw7E","session_id":"e6440d5e-5fb7-4583-a464-0e3f9791a04a","uuid":"c59c9e55-93b6-4131-88ed-75cff715494e"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018thayFzv45CZX4KtRHeeYr","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    sync::Arc,\n15\t};\n16\t\n17\tuse itertools::{izip, Itertools};\n18\tuse openvm_cuda_common::{\n19\t    copy::{MemCopyD2H, MemCopyD2HStreamSync, MemCopyH2D},\n20\t    d_buffer::DeviceBuffer,\n21\t    error::MemCopyError,\n22\t    memory_manager::MemTracker,\n23\t    stream::current_stream_sync,\n24\t};\n25\tuse openvm_stark_backend::{\n26\t    air_builders::symbolic::SymbolicConstraints,\n27\t    calculate_n_logup,\n28\t    dft::Radix2BowersSerial,\n29\t    p3_matrix::dense::RowMajorMatrix,\n30\t    poly_common::{\n31\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n32\t        UnivariatePoly,\n33\t    },\n34\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n35\t    prover::{\n36\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n37\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n38\t        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n39\t    },\n40\t};\n41\tuse p3_dft::TwoAdicSubgroupDft;\n42\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n43\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n44\tuse rustc_hash::FxHashMap;\n45\tuse tracing::{debug, info, info_span, instrument};\n46\t\n47\tuse crate::{\n48\t    base::DeviceMatrix,\n49\t    cuda::{\n50\t        logup_zerocheck::{fold_selectors_round0, interpolate_columns_gpu, MainMatrixPtrs},\n51\t        sumcheck::batch_fold_mle,\n52\t    },\n53\t    data_transporter::transport_matrix_d2h_col_major,\n54\t    error::LogupZerocheckError,\n55\t    gpu_backend::GenericGpuBackend,\n56\t    hash_scheme::GpuHashScheme,\n57\t    logup_zerocheck::{\n58\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n59\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n60\t    },\n61\t    poly::EqEvalLayers,\n62\t    prelude::{EF, F},\n63\t    sponge::GpuFiatShamirTranscript,\n64\t    utils::compute_barycentric_inv_lagrange_denoms,\n65\t};\n66\t\n67\tpub(crate) mod batch_mle;\n68\tpub(crate) mod batch_mle_monomial;\n69\tmod errors;\n70\tpub(crate) mod fold_ple;\n71\t/// Fraction sumcheck via GKR\n72\tmod fractional;\n73\t/// Logup interaction evaluations for GKR input\n74\tmod gkr_input;\n75\tmod mle_round;\n76\tmod round0;\n77\tpub(crate) mod rules;\n78\t\n79\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n80\tuse batch_mle_monomial::{\n81\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n82\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n83\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n84\t};\n85\tpub use errors::*;\n86\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n87\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n88\tuse round0::evaluate_round0_constraints_gpu;\n89\t\n90\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n91\t/// More threads = more concurrent kernels but more peak GPU memory and more\n92\t/// MemoryManager mutex contention. 4 is a good balance for the RTX 4090.\n93\tconst NUM_ROUND0_STREAMS: usize = 4;\n94\t\n95\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n96\t/// instead of the monomial kernel for high num_y traces.\n97\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n98\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n99\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n100\t\n101\t#[inline]\n102\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n103\t    if need_rot {\n104\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n105\t        (mat_width / 2) as u32\n106\t    } else {\n107\t        mat_width as u32\n108\t    }\n109\t}\n110\t\n111\t/// Result of processing one AIR in Round 0.\n112\tstruct Round0AirResult {\n113\t    trace_idx: usize,\n114\t    zerocheck_poly: Option<UnivariatePoly<EF>>,\n115\t    logup_numer_poly: Option<UnivariatePoly<EF>>,\n116\t    logup_denom_poly: Option<UnivariatePoly<EF>>,\n117\t}\n118\t\n119\t/// All read-only references needed to process one AIR in Round 0.\n120\tstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n121\t    trace_idx: usize,\n122\t    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n123\t    n: isize,\n124\t    selectors_cube: &'a DeviceMatrix<F>,\n125\t    public_values: &'a DeviceBuffer<F>,\n126\t    eq_3bs: &'a [EF],\n127\t    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n128\t    common_main: &'a DeviceMatrix<F>,\n129\t    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n130\t    d_lambda_pows: &'a DeviceBuffer<EF>,\n131\t    beta_pows: &'a [EF],\n132\t    l_skip: usize,\n133\t    constraint_degree: usize,\n134\t    xi: &'a [EF],\n135\t    max_temp_bytes: usize,\n136\t}\n137\t\n138\tfn process_air_round0<HS: GpuHashScheme>(\n139\t    w: &Round0AirWorkItem<HS>,\n140\t) -> Result<Round0AirResult, LogupZerocheckError> {\n141\t    let single_pk = w.single_pk;\n142\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n143\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n144\t    assert!(\n145\t        local_constraint_deg <= w.constraint_degree,\n146\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n147\t        w.constraint_degree\n148\t    );\n149\t\n150\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n151\t    let omega_root = F::two_adic_generator(log_large_domain);\n152\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n153\t\n154\t    let height = w.common_main.height();\n155\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n156\t    for committed in w.cached_mains {\n157\t        main_parts.push(committed.trace.buffer().as_ptr());\n158\t    }\n159\t    main_parts.push(w.common_main.buffer().as_ptr());\n160\t    let d_main_parts = main_parts.to_device()?;\n161\t\n162\t    let n_lift = w.n.max(0) as usize;\n163\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n164\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n165\t\n166\t    let sum_buffer = evaluate_round0_constraints_gpu(\n167\t        single_pk,\n168\t        w.selectors_cube.buffer(),\n169\t        &d_main_parts,\n170\t        w.public_values,\n171\t        eq_xi_tree.get_ptr(n_lift),\n172\t        w.d_lambda_pows,\n173\t        1 << w.l_skip,\n174\t        1 << n_lift,\n175\t        height as u32,\n176\t        num_cosets_zc as u32,\n177\t        omega_root,\n178\t        w.max_temp_bytes,\n179\t    )?;\n180\t\n181\t    let zerocheck_poly = if !sum_buffer.is_empty() {\n182\t        let q_evals = sum_buffer.to_host_on_current_stream()?;\n183\t        let q = {\n184\t            let mut values = EF::zero_vec(num_cosets_zc << w.l_skip);\n185\t            for coset_idx in 0..num_cosets_zc {\n186\t                for i in 0..1 << w.l_skip {\n187\t                    values[i * num_cosets_zc + coset_idx] = q_evals[(coset_idx << w.l_skip) + i];\n188\t                }\n189\t            }\n190\t            UnivariatePoly::from_geometric_cosets_evals_idft(\n191\t                RowMajorMatrix::new(values, num_cosets_zc),\n192\t                omega_root,\n193\t                omega_root,\n194\t            )\n195\t        };\n196\t        let sp_0_deg = sumcheck_round0_deg(w.l_skip, local_constraint_deg);\n197\t        let coeffs = (0..=sp_0_deg)\n198\t            .map(|i| {\n199\t                let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n200\t                if i >= 1 << w.l_skip {\n201\t                    c += q.coeffs()[i - (1 << w.l_skip)];\n202\t                }\n203\t                c\n204\t            })\n205\t            .collect_vec();\n206\t        Some(UnivariatePoly::new(coeffs))\n207\t    } else {\n208\t        None\n209\t    };\n210\t\n211\t    let num_cosets_logup = local_constraint_deg;\n212\t    let sum = evaluate_round0_interactions_gpu(\n213\t        single_pk,\n214\t        &single_air_constraints,\n215\t        w.selectors_cube.buffer(),\n216\t        &d_main_parts,\n217\t        w.public_values,\n218\t        eq_xi_tree.get_ptr(n_lift),\n219\t        w.beta_pows,\n220\t        w.eq_3bs,\n221\t        1 << w.l_skip,\n222\t        1 << n_lift,\n223\t        height as u32,\n224\t        num_cosets_logup as u32,\n225\t        omega_root,\n226\t        w.max_temp_bytes,\n227\t    )?;\n228\t\n229\t    let (logup_numer_poly, logup_denom_poly) = if !sum.is_empty() {\n230\t        let evals = sum.to_host_on_current_stream()?;\n231\t        let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n232\t            evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n233\t        if w.n.is_negative() {\n234\t            let norm_factor = F::from_u32(1 << w.n.unsigned_abs()).inverse();\n235\t            for s in &mut numer {\n236\t                *s *= norm_factor;\n237\t            }\n238\t        }\n239\t        let mut numer_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n240\t        let mut denom_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n241\t        for coset_idx in 0..num_cosets_logup {\n242\t            for i in 0..1 << w.l_skip {\n243\t                let src = (coset_idx << w.l_skip) + i;\n244\t                let dst = i * num_cosets_logup + coset_idx;\n245\t                numer_values[dst] = numer[src];\n246\t                denom_values[dst] = denom[src];\n247\t            }\n248\t        }\n249\t        let numer_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n250\t            RowMajorMatrix::new(numer_values, num_cosets_logup),\n251\t            omega_root,\n252\t            F::ONE,\n253\t        );\n254\t        let denom_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n255\t            RowMajorMatrix::new(denom_values, num_cosets_logup),\n256\t            omega_root,\n257\t            F::ONE,\n258\t        );\n259\t        (Some(numer_poly), Some(denom_poly))\n260\t    } else {\n261\t        (None, None)\n262\t    };\n263\t\n264\t    Ok(Round0AirResult {\n265\t        trace_idx: w.trace_idx,\n266\t        zerocheck_poly,\n267\t        logup_numer_poly,\n268\t        logup_denom_poly,\n269\t    })\n270\t}\n271\t\n272\t#[allow(clippy::type_complexity)]\n273\t#[instrument(level = \"info\", skip_all)]\n274\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n275\t    transcript: &mut TS,\n276\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n277\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n278\t    save_memory: bool,\n279\t    monomial_num_y_threshold: u32,\n280\t    sm_count: u32,\n281\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n282\twhere\n283\t    HS: GpuHashScheme,\n284\t    TS: GpuFiatShamirTranscript<HS::SC>,\n285\t{\n286\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n287\t    let l_skip = mpk.params.l_skip;\n288\t    let constraint_degree = mpk.max_constraint_degree;\n289\t    let num_traces = ctx.per_trace.len();\n290\t\n291\t    // Traces are sorted\n292\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n293\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n294\t    // heights\n295\t    let mut total_interactions = 0u64;\n296\t    let interactions_meta: Vec<_> = ctx\n297\t        .per_trace\n298\t        .iter()\n299\t        .map(|(air_idx, air_ctx)| {\n300\t            let pk = &mpk.per_air[*air_idx];\n301\t\n302\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n303\t            let height = air_ctx.common_main.height();\n304\t            let log_height = log2_strict_usize(height);\n305\t            let log_lifted_height = log_height.max(l_skip);\n306\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n307\t            (num_interactions, log_lifted_height)\n308\t        })\n309\t        .collect();\n310\t    // Implicitly, the width of this stacking should be 1\n311\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n312\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n313\t    // GKR\n314\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n315\t\n316\t    // Grind to increase soundness of random sampling for LogUp\n317\t    let logup_pow_witness = transcript\n318\t        .grind_gpu(mpk.params.logup.pow_bits)\n319\t        .map_err(LogupZerocheckError::Grind)?;\n320\t    let alpha_logup = transcript.sample_ext();\n321\t    let beta_logup = transcript.sample_ext();\n322\t    debug!(%alpha_logup, %beta_logup);\n323\t\n324\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n325\t    let mut prover = LogupZerocheckGpu::new(\n326\t        mpk,\n327\t        ctx,\n328\t        n_logup,\n329\t        interactions_layout,\n330\t        alpha_logup,\n331\t        beta_logup,\n332\t        save_memory,\n333\t        monomial_num_y_threshold,\n334\t        sm_count,\n335\t    )?;\n336\t    let n_global = prover.n_global;\n337\t\n338\t    let total_leaves = 1 << (l_skip + n_logup);\n339\t    prover\n340\t        .mem\n341\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n342\t    prover.mem.reset_peak();\n343\t    let (inputs, alpha) = if has_interactions {\n344\t        log_gkr_input_evals(\n345\t            &prover.trace_interactions,\n346\t            mpk,\n347\t            ctx,\n348\t            l_skip,\n349\t            alpha_logup,\n350\t            &prover.d_challenges,\n351\t            total_leaves,\n352\t        )?\n353\t    } else {\n354\t        (DeviceBuffer::new(), EF::ZERO)\n355\t    };\n356\t    // Set memory limit for batch MLE based on inputs buffer size\n357\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n358\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n359\t    if !prover.save_memory {\n360\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n361\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n362\t            tracing::warn!(\n363\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n364\t                prover.memory_limit_bytes\n365\t            );\n366\t        }\n367\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n368\t    }\n369\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n370\t\n371\t    let (frac_sum_proof, mut xi) =\n372\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n373\t    while xi.len() != l_skip + n_global {\n374\t        xi.push(transcript.sample_ext());\n375\t    }\n376\t    debug!(?xi);\n377\t    prover.xi = xi;\n378\t\n379\t    logup_