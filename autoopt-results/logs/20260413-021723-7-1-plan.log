nel time is 95.6ms against a 143.8ms wall span, leaving 48.2ms in overhead—nearly double what segment 1 had. I need to figure out why the overhead jumped so significantly.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1825,"cache_read_input_tokens":123966,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1825},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e6440d5e-5fb7-4583-a464-0e3f9791a04a","uuid":"2afc7f12-9b67-4d12-9e25-56beeeefd445"}
