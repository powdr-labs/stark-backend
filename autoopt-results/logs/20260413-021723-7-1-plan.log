ze = rules.inner.buffer_size;\n150\t    // TODO[jpw]: remove magic 10\n151\t    let is_global = buffer_size > 10;\n152\t    let intermediates = if is_global {\n153\t        DeviceBuffer::<EF>::with_capacity((TASK_SIZE as usize) * buffer_size as usize)\n154\t    } else {\n155\t        DeviceBuffer::<EF>::with_capacity(1)\n156\t    };\n157\t\n158\t    let num_rows_per_tile = height.div_ceil(TASK_SIZE as usize).max(1);\n159\t\n160\t    let leaves_ptr = w.leaves_ptr.0;\n161\t    let l_skip = w.l_skip;\n162\t    let lifted_height = max(height, 1 << l_skip);\n163\t\n164\t    let trace_output = if height != lifted_height {\n165\t        let required = height * num_interactions;\n166\t        if required > tmp.len() {\n167\t            *tmp = DeviceBuffer::with_capacity(required);\n168\t        }\n169\t        tmp.as_mut_ptr()\n170\t    } else {\n171\t        leaves_ptr\n172\t    };\n173\t    unsafe {\n174\t        logup_gkr_input_eval(\n175\t            is_global,\n176\t            trace_output,\n177\t            d_preprocessed,\n178\t            d_partition_ptrs,\n179\t            &d_public_values,\n180\t            w.d_challenges,\n181\t            &intermediates,\n182\t            &rules.inner.d_rules,\n183\t            &rules.inner.d_used_nodes,\n184\t            &rules.d_pair_idxs,\n185\t            height as u32,\n186\t            num_rows_per_tile as u32,\n187\t        )?;\n188\t    }\n189\t    if height != lifted_height {\n190\t        debug_assert_eq!(lifted_height % height, 0);\n191\t        debug_assert!(!tmp.is_empty());\n192\t        let norm_factor_denom = lifted_height / height;\n193\t        let norm_factor = F::from_usize(norm_factor_denom).inverse();\n194\t        unsafe {\n195\t            frac_vector_scalar_multiply_ext_fp(\n196\t                tmp.as_mut_ptr(),\n197\t                norm_factor,\n198\t                tmp.len() as u32,\n199\t            )?;\n200\t            frac_matrix_vertically_repeat(\n201\t                leaves_ptr,\n202\t                tmp.as_ptr(),\n203\t                num_interactions as u32,\n204\t                lifted_height as u32,\n205\t                height as u32,\n206\t            )?;\n207\t        }\n208\t    }\n209\t    Ok(())\n210\t}\n211\t\n212\t/// Evaluate interactions from trace evaluation matrices to get (p, q) fractional sumcheck input.\n213\t/// Returns leaves buffer (WITHOUT alpha applied) and alpha value to be applied in first tree layer.\n214\t#[instrument(name = \"prover.rap_constraints.logup_gkr.input_evals\", skip_all)]\n215\tpub fn log_gkr_input_evals<HS: GpuHashScheme>(\n216\t    trace_interactions: &[Option<TraceInteractionMeta>],\n217\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n218\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n219\t    l_skip: usize,"}]},"parent_tool_use_id":"toolu_01A6ojr9DPp1tgy7dbuQbzdu","session_id":"e6440d5e-5fb7-4583-a464-0e3f9791a04a","uuid":"3f5e683b-fc7a-40bd-830d-f4af3ba139e2","timestamp":"2026-04-13T03:18:20.292Z"}
