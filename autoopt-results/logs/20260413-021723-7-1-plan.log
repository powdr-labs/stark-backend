{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XmFbGgQ6G3Sb6CD9VEGHcn","type":"tool_result","content":"533\tpub unsafe fn frac_build_tree_layer(\n534\t    layer: &mut DeviceBuffer<Frac<EF>>,\n535\t    layer_size: usize,\n536\t    revert: bool,\n537\t    alpha: EF,\n538\t    apply_alpha: bool,\n539\t) -> Result<(), CudaError> {\n540\t    debug_assert!(layer.len() >= layer_size);\n541\t    CudaError::from_result(_frac_build_tree_layer(\n542\t        layer.as_mut_ptr(),\n543\t        layer_size,\n544\t        revert,\n545\t        alpha,\n546\t        apply_alpha,\n547\t    ))\n548\t}\n549\t\n550\t/// Fused two-layer tree build kernel.\n551\t/// `half_i1` = N >> (i+2), where i is the first of the two layers being fused.\n552\tpub unsafe fn frac_build_tree_two_layers(\n553\t    layer: &mut DeviceBuffer<Frac<EF>>,\n554\t    half_i1: usize,\n555\t) -> Result<(), CudaError> {\n556\t    CudaError::from_result(_frac_build_tree_two_layers(layer.as_mut_ptr(), half_i1))\n557\t}\n558\t\n559\t// `eq_xi` will not store evaluations for the first hypercube coordinate because the prover factors\n560\t// out the first eq term.\n561\t#[allow(clippy::too_many_arguments)]\n562\tpub unsafe fn frac_compute_round(\n563\t    eq_xi: &SqrtEqLayers,\n564\t    pq_buffer: &DeviceBuffer<Frac<EF>>,\n565\t    num_x: usize,\n566\t    lambda: EF,\n567\t    out_device: &mut DeviceBuffer<EF>,\n568\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n569\t) -> Result<(), CudaError> {\n570\t    let low_n = eq_xi.low_n();\n571\t    let high_n = eq_xi.high_n();\n572\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n573\t    debug_assert!(pq_buffer.len() >= 2 * num_x);\n574\t    #[cfg(debug_assertions)]\n575\t    {\n576\t        let len = tmp_block_sums.len();\n577\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n578\t        assert!(\n579\t            len >= required as usize,\n580\t            \"tmp_block_sums len={len} < required={required}\"\n581\t        );\n582\t    }\n583\t    CudaError::from_result(_frac_compute_round(\n584\t        eq_xi.low.get_ptr(low_n),\n585\t        eq_xi.high.get_ptr(high_n),\n586\t        pq_buffer.as_ptr(),\n587\t        num_x,\n588\t        1 << low_n,\n589\t        lambda,\n590\t        out_device.as_mut_ptr(),\n591\t        tmp_block_sums.as_mut_ptr(),\n592\t    ))\n593\t}\n594\t\n595\t/// Fused compute round + tree layer revert kernel.\n596\t///\n597\t/// Combines `frac_build_tree_layer(revert=true)` with `compute_round` for the first inner round.\n598\t/// The revert operation modifies `layer` in-place: `layer[i] = layer[i] - layer[i + half]` for `i <\n599\t/// half`.\n600\t///\n601\t/// This eliminates one kernel launch per outer round.\n602\t#[allow(clippy::too_many_arguments)]\n603\tpub unsafe fn frac_compute_round_and_revert(\n604\t    eq_xi: &SqrtEqLayers,\n605\t    layer: &mut DeviceBuffer<Frac<EF>>,\n606\t    num_x: usize,\n607\t    lambda: EF,\n608\t    out_device: &mut DeviceBuffer<EF>,\n609\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n610\t) -> Result<(), CudaError> {\n611\t    let low_n = eq_xi.low_n();\n612\t    let high_n = eq_xi.high_n();\n613\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n614\t    #[cfg(debug_assertions)]\n615\t    {\n616\t        let len = tmp_block_sums.len();\n617\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n618\t        assert!(\n619\t            len >= required as usize,\n620\t            \"tmp_block_sums len={len} < required={required}\"\n621\t        );\n622\t        assert!(layer.len() >= 2 * num_x, \"layer too small for pq_size\");\n623\t    }\n624\t    CudaError::from_result(_frac_compute_round_and_revert(\n625\t        eq_xi.low.get_ptr(low_n),\n626\t        eq_xi.high.get_ptr(high_n),\n627\t        layer.as_mut_ptr(),\n628\t        num_x,\n629\t        1 << low_n,\n630\t        lambda,\n631\t        out_device.as_mut_ptr(),\n632\t        tmp_block_sums.as_mut_ptr(),\n633\t    ))\n634\t}\n635\t\n636\t/// Folds `Frac<EF>` buffer. Pairs (idx, idx+quarter) and (idx+half, idx+3*quarter),\n637\t/// writes results to dst[idx] and dst[idx+quarter]. Output size is `size / 2`.\n638\t/// Safe for src == dst (in-place) because each thread handles disjoint indices.\n639\tpub unsafe fn fold_ef_frac_columns(\n640\t    src: &DeviceBuffer<Frac<EF>>,\n641\t    dst: &mut DeviceBuffer<Frac<EF>>,\n642\t    size: usize,\n643\t    r: EF,\n644\t) -> Result<(), CudaError> {\n645\t    debug_assert!(src.len() >= size);\n646\t    debug_assert!(dst.len() >= size / 2);\n647\t    CudaError::from_result(_frac_fold_fpext_columns(\n648\t        src.as_ptr(),\n649\t        dst.as_mut_ptr(),\n650\t        size,\n651\t        r,\n652\t    ))\n653\t}\n654\t\n655\t/// In-place fold. See [`fold_ef_frac_columns`] for details.\n656\tpub unsafe fn fold_ef_frac_columns_inplace(\n657\t    buffer: &mut DeviceBuffer<Frac<EF>>,\n658\t    size: usize,\n659\t    r: EF,\n660\t) -> Result<(), CudaError> {\n661\t    debug_assert!(buffer.len() >= size);\n662\t    let ptr = buffer.as_mut_ptr();\n663\t    CudaError::from_result(_frac_fold_fpext_columns(ptr, ptr, size, r))\n664\t}\n665\t\n666\t/// Fused compute round + fold kernel.\n667\t///\n668\t/// Reads from pre-fold `src_pq_buffer` (size `src_pq_size`), performs fold-on-the-fly using\n669\t/// `r_prev`, computes s' polynomial evaluations (degree 2), and writes folded output to\n670\t/// `dst_pq_buffer` (size `src_pq_size/2`).\n671\t///\n672\t/// This fuses the fold operation into the next round's compute, eliminating one kernel launch per\n673\t/// inner round and reducing memory traffic.\n674\t///\n675\t/// The eq_xi layers should have max_n = log2(src_pq_size / 4) = log2(post-fold num_x).\n676\t#[allow(clippy::too_many_arguments)]\n677\tpub unsafe fn frac_compute_round_and_fold(\n678\t    eq_xi: &SqrtEqLayers,\n679\t    src_pq_buffer: &DeviceBuffer<Frac<EF>>,\n680\t    dst_pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n681\t    src_pq_size: usize,\n682\t    lambda: EF,\n683\t    r_prev: EF,\n684\t    out_device: &mut DeviceBuffer<EF>,\n685\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n686\t) -> Result<(), CudaError> {\n687\t    let low_n = eq_xi.low_n();\n688\t    let high_n = eq_xi.high_n();\n689\t    // Post-fold: num_x = src_pq_size / 4\n690\t    let num_x = src_pq_size >> 2;\n691\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n692\t    #[cfg(debug_assertions)]\n693\t    {\n694\t        assert!(src_pq_size > 2, \"src_pq_size must be > 2\");\n695\t        let pq_size = src_pq_size >> 1;\n696\t        assert!(num_x > 0, \"num_x must be > 0\");\n697\t        assert!(\n698\t            src_pq_buffer.len() >= src_pq_size,\n699\t            \"src_pq_buffer too small: {} < {}\",\n700\t            src_pq_buffer.len(),\n701\t            src_pq_size\n702\t        );\n703\t        assert!(\n704\t            dst_pq_buffer.len() >= pq_size,\n705\t            \"dst_pq_buffer too small: {} < {}\",\n706\t            dst_pq_buffer.len(),\n707\t            pq_size\n708\t        );\n709\t        let len = tmp_block_sums.len();\n710\t        let required = _frac_compute_round_temp_buffer_size(num_x as u32);\n711\t        assert!(\n712\t            len >= required as usize,\n713\t            \"tmp_block_sums len={len} < required={required}\"\n714\t        );\n715\t    }\n716\t    CudaError::from_result(_frac_compute_round_and_fold(\n717\t        eq_xi.low.get_ptr(low_n),\n718\t        eq_xi.high.get_ptr(high_n),\n719\t        src_pq_buffer.as_ptr(),\n720\t        dst_pq_buffer.as_mut_ptr(),\n721\t        src_pq_size,\n722\t        1 << low_n,\n723\t        lambda,\n724\t        r_prev,\n725\t        out_device.as_mut_ptr(),\n726\t        tmp_block_sums.as_mut_ptr(),\n727\t    ))\n728\t}\n729\t\n730\t/// In-place fused compute round + fold kernel. See [`frac_compute_round_and_fold`] for details.\n731\t///\n732\t/// Uses a dedicated in-place kernel that doesn't have `__restrict__` on the pq pointer,"}]},"parent_to