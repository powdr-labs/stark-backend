evals,\n1488\t        );\n1489\t        // eq(xi, X) = (2 * xi - 1) * X + (1 - xi)\n1490\t        // Compute s(X) = eq(xi, X) * s'_head(X) + s'_tail * X (s'_head now contains eq(..,r))\n1491\t        // s(X) has degree s_deg\n1492\t        let mut coeffs = sp_head.into_coeffs();\n1493\t        coeffs.push(EF::ZERO);\n1494\t        let b = EF::ONE - xi_cur;\n1495\t        let a = xi_cur - b;\n1496\t        for i in (0..s_deg).rev() {\n1497\t            coeffs[i + 1] = a * coeffs[i] + b * coeffs[i + 1];\n1498\t        }\n1499\t        coeffs[0] *= b;\n1500\t        coeffs[1] += sp_tail;\n1501\t        UnivariatePoly::new(coeffs)\n1502\t    }\n1503\t\n1504\t    #[instrument(name = \"LogupZerocheck::fold_mle_evals\", level = \"debug\", skip_all, fields(round = round))]\n1505\t    fn fold_mle_evals(&mut self, round: usize, r_round: EF) -> Result<(), LogupZerocheckError> {\n1506\t        // Assumes that input_mats are sorted by height\n1507\t        let batch_fold = |input_mats: Vec<DeviceMatrix<EF>>| -> Result<Vec<DeviceMatrix<EF>>, LogupZerocheckError> {\n1508\t            let num_matrices = input_mats.partition_point(|mat| mat.height() > 1);\n1509\t            let mut max_output_cells = 0;\n1510\t            let (log_output_heights, widths, mut output_mats): (Vec<_>, Vec<_>, Vec<_>) =\n1511\t                input_mats\n1512\t                    .iter()\n1513\t                    .take(num_matrices)\n1514\t                    .map(|mat| {\n1515\t                        let height = mat.height();\n1516\t                        let width = mat.width();\n1517\t                        let output_height = height >> 1;\n1518\t                        max_output_cells = max(max_output_cells, output_height * width);\n1519\t                        let output_mat = DeviceMatrix::<EF>::with_capacity(output_height, width);\n1520\t                        (output_height.ilog2() as u8, width as u32, output_mat)\n1521\t                    })\n1522\t                    .multiunzip();\n1523\t\n1524\t            let input_ptrs = input_mats\n1525\t                .iter()\n1526\t                .take(num_matrices)\n1527\t                .map(|mat| mat.buffer().as_ptr())\n1528\t                .collect_vec();\n1529\t            let output_ptrs = output_mats\n1530\t                .iter()\n1531\t                .map(|mat| mat.buffer().as_mut_ptr())\n1532\t                .collect_vec();\n1533\t\n1534\t            let d_input_ptrs = input_ptrs.to_device()?;\n1535\t            let d_output_ptrs = output_ptrs.to_device()?;\n1536\t            let d_log_output_heights = log_output_heights.to_device()?;\n1537\t            let d_widths = widths.to_device()?;\n1538\t\n1539\t            unsafe {\n1540\t                batch_fold_mle(\n1541\t                    &d_input_ptrs,\n1542\t                    &d_output_ptrs,\n1543\t                    &d_widths,\n1544\t                    num_matrices.try_into().unwrap(),\n1545\t                    &d_log_output_heights,\n1546\t                    max_output_cells.try_into().unwrap(),\n1547\t                    r_round,\n1548\t                )\n1549\t                .map_err(LogupZerocheckError::BatchFoldMle)?;\n1550\t            }\n1551\t            output_mats.extend_from_slice(&input_mats[num_matrices..]);\n1552\t            Ok(output_mats)\n1553\t        };\n1554\t\n1555\t        // Fold mat_evals_per_trace: Vec<Vec<DeviceMatrix<EF>>>\n1556\t        self.mat_evals_per_trace = {\n1557\t            let lengths = self\n1558\t                .mat_evals_per_trace\n1559\t                .iter()\n1560\t                .map(|v| v.len())\n1561\t                .collect_vec();\n1562\t            let input_mats = std::mem::take(&mut self.mat_evals_per_trace)\n1563\t                .into_iter()\n1564\t                .flatten()\n1565\t                .collect_vec();\n1566\t            let mut output_mats = batch_fold(input_mats)?.into_iter();\n1567\t            lengths\n1568\t                .into_iter()\n1569\t                .map(|len| output_mats.by_ref().take(len).collect())\n1570\t                .collect()\n1571\t        };\n1572\t        if self.save_memory {\n1573\t            self.memory_limit_bytes = self.gkr_mem_contribution.saturating_sub(\n1574\t                self.mat_evals_per_trace\n1575\t                    .iter()\n1576\t                    .flatten()\n1577\t                    .map(|m| m.buffer().len() * size_of::<EF>())\n1578\t                    .sum(),\n1579\t            );\n1580\t        }\n1581\t\n1582\t        // Fold sels_per_trace: Vec<DeviceMatrix<EF>>\n1583\t        self.sels_per_trace = batch_fold(std::mem::take(&mut self.sels_per_trace))?;\n1584\t\n1585\t        for tree in self.eq_xis.values_mut() {\n1586\t            // trim the back (which corresponds to r_{j-1}) because we don't need it anymore\n1587\t            if tree.layers.len() > 1 {\n1588\t                tree.layers.pop();\n1589\t            }\n1590\t        }\n1591\t        let xi = self.xi[self.l_skip + round - 1];\n1592\t        let eq_r = eval_eq_mle(&[xi], &[r_round]);\n1593\t        self.eq_ns.push(self.eq_ns[round - 1] * eq_r);\n1594\t        self.eq_sharp_ns.push(self.eq_sharp_ns[round - 1] * eq_r);\n1595\t        Ok(())\n1596\t    }\n1597\t\n1598\t    #[instrument(\n1599\t        name = \"LogupZerocheck::into_column_openings\",\n1600\t        level = \"debug\",\n1601\t        skip_all\n1602\t    )]\n1603\t    fn into_column_openings(mut self) -> Result<Vec<Vec<Vec<EF>>>, LogupZerocheckError> {\n1604\t        let num_airs_present = self.mat_evals_per_trace.len();\n1605\t        let mut column_openings = Vec::with_capacity(num_airs_present);\n1606\t\n1607\t        // At the end, we've folded all MLEs so they only have one row equal to evaluation at `\\vec\n1608\t        // r`.\n1609\t        for (&need_rot, mat_evals) in self\n1610\t            .needs_next_per_trace\n1611\t            .iter()\n1612\t            .zip(std::mem::take(&mut self.mat_evals_per_trace))\n1613\t        {\n1614\t            // GPU matrices are doubled-width (original + rotated), so we need to split them\n1615\t            // First, copy all matrices to host and split them\n1616\t            let mut split_mats: Vec<Option<ColMajorMatrix<EF>>> = mat_evals\n1617\t                .into_iter()\n1618\t                .map(|mat| {\n1619\t                    let mat_host = transport_matrix_d2h_col_major(&mat)?;\n1620\t                    let width = mat_host.width();\n1621\t                    let height = mat_host.height();\n1622\t                    debug_assert_eq!(height, 1, \"Matrices should have height=1 after folding\");\n1623\t                    let air_width = if need_rot {\n1624\t                        debug_assert_eq!(\n1625\t                            width % 2,\n1626\t                            0,\n1627\t                            \"GPU matrices should have doubled width (original + rotated)\"\n1628\t                        );\n1629\t                        width / 2\n1630\t                    } else {\n1631\t                        width\n1632\t                    };\n1633\t\n1634\t                    // Split doubled-width matrix into original and rotated parts\n1635\t                    let values = &mat_host.values;\n1636\t                    let orig: Vec<EF> = (0..air_width)\n1637\t                        .map(|col| values[col * height]) // height=1, so values[col]\n1638\t                        .collect();\n1639\t                    let rot: Option<Vec<EF>> = if need_rot {\n1640\t                        Some(\n1641\t                            (air_width..width)\n1642\t                                .map(|col| values[col * height]) // height=1, so values[col]\n1643\t                                .collect(),\n1644\t                        )\n1645\t                    } else {\n1646\t                        None\n1647\t                    };\n1648\t\n1649\t                    Ok(vec![\n1650\t                        Some(ColMajorMatrix::new(orig, air_width)),\n1651\t                        rot.map(|mat| ColMajorMatrix::new(mat, air_width)),\n1652\t                    ])\n1653\t                })\n1654\t                .collect::<Result<Vec<_>, MemCopyError>>()?\n1655\t                .into_iter()\n1656\t                .flatten()\n1657\t                .collect();\n1658\t\n1659\t            // Order of mats after splitting is:\n1660\t            // - preprocessed (if has_preprocessed),\n1661\t            // - preprocessed_rot (if has_preprocessed),\n1662\t            // - cached(0), cached(0)_rot, ...\n1663\t            // - common_main\n1664\t            // - common_main_rot\n1665\t            // For column openings, we pop common_main, common_main_rot and put it at the front\n1666\t            assert_eq!(\n1667\t                split_mats.len() % 2,\n1668\t                0,\n1669\t                \"Should have even number of matrices after splitting\"\n1670\t            );\n1671\t            let common_main_rot = split_mats.pop().unwrap();\n1672\t            let common_main = split_mats.pop().unwrap();\n1673\t\n1674\t            let openings_of_air = iter::once(&[common_main, common_main_rot] as &[_])\n1675\t                .chain(split_mats.chunks_exact(2))\n1676\t                .map(|pair| {\n1677\t                    let plains = pair[0].as_ref().unwrap();\n1678\t                    if let Some(rots) = pair[1].as_ref() {\n1679\t                        std::iter::zip(plains.columns(), rots.columns())\n1680\t                            .flat_map(|(claim, claim_rot)| {\n1681\t                                assert_eq!(claim.len(), 1);\n1682\t                                assert_eq!(claim_rot.len(), 1);\n1683\t                                [claim[0], claim_rot[0]]\n1684\t                            })\n1685\t                            .collect_vec()\n1686\t                    } else {\n1687\t                        plains\n1688\t                            .columns()\n1689\t                            .map(|claim| {\n1690\t                                assert_eq!(claim.len(), 1);\n1691\t                                claim[0]\n1692\t                            })\n1693\t                            .collect_vec()\n1694\t                    }\n1695\t                })\n1696\t                .collect_vec();\n1697\t            column_openings.push(openings_of_air);\n1698\t        }\n1699\t        Ok(column_openings)\n1700\t    }\n1701\t}\n1702\t"}]},"parent_tool_use_id":"toolu_01LbhgoZtXURug6u5zGrHw7E","session_id":"e6440d5e-5fb7-4583-a464-0e3f9791a04a","uuid":"f6cbafc6-f686-41e1-9647-6953e8bdc1ec","timestamp":"2026-04-13T00:18:59.662Z"}
