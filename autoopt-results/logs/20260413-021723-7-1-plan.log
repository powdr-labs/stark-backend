{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DX6AAwR4MXaMAgpAcVmDaN","type":"tool_result","content":"490\t#[instrument(skip_all)]\n491\tpub fn fractional_sumcheck_gpu<SC, TS>(\n492\t    transcript: &mut TS,\n493\t    leaves: DeviceBuffer<Frac<EF>>,\n494\t    alpha: EF,\n495\t    assert_zero: bool,\n496\t    mem: &mut MemTracker,\n497\t) -> Result<(FracSumcheckProof<SC>, Vec<EF>), FractionalSumcheckError>\n498\twhere\n499\t    SC: StarkProtocolConfig<EF = EF>,\n500\t    TS: FiatShamirTranscript<SC>,\n501\t{\n502\t    let mut layer = leaves;\n503\t    if layer.is_empty() {\n504\t        return Ok((\n505\t            FracSumcheckProof {\n506\t                fractional_sum: (EF::ZERO, EF::ONE),\n507\t                claims_per_layer: vec![],\n508\t                sumcheck_polys: vec![],\n509\t            },\n510\t            vec![],\n511\t        ));\n512\t    };\n513\t    let total_leaves = layer.len();\n514\t    // total_rounds = l_skip + n_logup\n515\t    let total_rounds = log2_strict_usize(total_leaves);\n516\t    assert!(total_rounds > 0, \"n_logup > 0 when there are interactions\");\n517\t    // Build segment tree.\n518\t    // - We only maintain the current layer\n519\t    // - Input layer uses separate F and EF buffers to save memory\n520\t    // - First tree layer converts (F, EF) to FracExt (EF, EF)\n521\t\n522\t    // We store it in bit-reversal order for coalesced memory accesses.\n523\t    // For large N (> 1024), fuse bitrev + tree layers 0 and 1 into a single kernel pass,\n524\t    // eliminating ~1.5N global memory reads. For small N, fall back to separate operations.\n525\t    let start_layer_i = if total_leaves > 1024 {\n526\t        unsafe {\n527\t            // SAFETY: Frac<EF> has exact same memory layout and alignment as (EF, EF).\n528\t            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n529\t            bit_rev_frac_ext_build_k2(buf, total_rounds as u32, alpha)\n530\t                .map_err(FractionalSumcheckError::BitReversal)?;\n531\t        }\n532\t        2 // layers 0+1 already done\n533\t    } else {\n534\t        // Fallback: separate bitrev + layer 0.\n535\t        unsafe {\n536\t            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n537\t            bit_rev_frac_ext(\n538\t                buf,\n539\t                buf,\n540\t                total_rounds as u32,\n541\t                total_leaves.try_into().unwrap(),\n542\t                1,\n543\t            )\n544\t            .map_err(FractionalSumcheckError::BitReversal)?;\n545\t            frac_build_tree_layer(&mut layer, total_leaves, false, alpha, true)\n546\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n547\t            use crate::cuda::logup_zerocheck::frac_add_alpha;\n548\t            let half = total_leaves / 2;\n549\t            let second_half_ptr = layer.as_mut_raw_ptr() as *mut Frac<EF>;\n550\t            let second_half_buf =\n551\t                DeviceBuffer::<Frac<EF>>::from_raw_parts(second_half_ptr.add(half), half);\n552\t            frac_add_alpha(&second_half_buf, alpha)\n553\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n554\t            std::mem::forget(second_half_buf);\n555\t        }\n556\t        1 // layer 0 done; continue from layer 1\n557\t    };\n558\t\n559\t    // Remaining layers: fuse consecutive pairs via two-layer kernel (~33% traffic savings).\n560\t    let mut i = start_layer_i;\n561\t    while i + 1 < total_rounds {\n562\t        let half_i1 = total_leaves >> (i + 2);\n563\t        unsafe {\n564\t            frac_build_tree_two_layers(&mut layer, half_i1)\n565\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n566\t        }\n567\t        i += 2;\n568\t    }\n569\t    // Remaining single layer (if odd number of layers left).\n570\t    if i < total_rounds {\n571\t        unsafe {\n572\t            frac_build_tree_layer(&mut layer, total_leaves >> i, false, EF::ZERO, false)\n573\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n574\t        }\n575\t    }\n576\t    mem.emit_metrics_with_label(\"frac_sumcheck.segment_tree\");\n577\t    mem.tracing_info(\"fractional_sumcheck_gkr: after building segment tree\");\n578\t    let mut copy_scratch = DeviceBuffer::<Frac<EF>>::with_capacity(1);\n579\t    let root = copy_from_device(&layer, 0, &mut copy_scratch)?;\n580\t    unsafe {\n581\t        frac_build_tree_layer(&mut layer, 2, true, EF::ZERO, false)\n582\t            .map_err(FractionalSumcheckError::SegmentTree)?;\n583\t    }\n584\t    if assert_zero {\n585\t        if root.p != EF::ZERO {\n586\t            return Err(FractionalSumcheckError::NonzeroRootSum {\n587\t                p: root.p,\n588\t                q: root.q,\n589\t            });"}]},"parent_tool_use_id":null,"session_id":"e6440d5e-5fb7-4583-a464-0e3f9791a04a","uuid":"c4ddb961-65f3-4d28-b91b-7314b8a9db60","timestamp":"2026-04-13T03:01:14.366Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/fractional.rs","content":"#[instrument(skip_all)]\npub fn fractional_sumcheck_gpu<SC, TS>(\n    transcript: &mut TS,\n    leaves: DeviceBuffer<Frac<EF>>,\n    alpha: EF,\n    assert_zero: bool,\n    mem: &mut MemTracker,\n) -> Result<(FracSumcheckProof<SC>, Vec<EF>), FractionalSumcheckError>\nwhere\n    SC: StarkProtocolConfig<EF = EF>,\n    TS: FiatShamirTranscript<SC>,\n{\n    let mut layer = leaves;\n    if layer.is_empty() {\n        return Ok((\n            FracSumcheckProof {\n                fractional_sum: (EF::ZERO, EF::ONE),\n                claims_per_layer: vec![],\n                sumcheck_polys: vec![],\n            },\n            vec![],\n        ));\n    };\n    let total_leaves = layer.len();\n    // total_rounds = l_skip + n_logup\n    let total_rounds = log2_strict_usize(total_leaves);\n    assert!(total_rounds > 0, \"n_logup > 0 when there are interactions\");\n    // Build segment tree.\n    // - We only maintain the current layer\n    // - Input layer uses separate F and EF buffers to save memory\n    // - First tree layer converts (F, EF) to FracExt (EF, EF)\n\n    // We store it in bit-reversal order for coalesced memory accesses.\n    // For large N (> 1024), fuse bitrev + tree layers 0 and 1 into a single kernel pass,\n    // eliminating ~1.5N global memory reads. For small N, fall back to separate operations.\n    let start_layer_i = if total_leaves > 1024 {\n        unsafe {\n            // SAFETY: Frac<EF> has exact same memory layout and alignment as (EF, EF).\n            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n            bit_rev_frac_ext_build_k2(buf, total_rounds as u32, alpha)\n                .map_err(FractionalSumcheckError::BitReversal)?;\n        }\n        2 // layers 0+1 already done\n    } else {\n        // Fallback: separate bitrev + layer 0.\n        unsafe {\n            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n            bit_rev_frac_ext(\n                buf,\n                buf,\n                total_rounds as u32,\n                total_leaves.try_into().unwrap(),\n                1,\n            )\n            .map_err(FractionalSumcheckError::BitReversal)?;\n            frac_build_tree_layer(&mut layer, total_leaves, false, alpha, true)\n                .map_err(FractionalSumcheckError::SegmentTree)?;\n            use crate::cuda::logup_zerocheck::frac_add_alpha;\n            let half = total_leaves / 2;\n            let second_half_ptr = layer.as_mut_raw_ptr() as *mut Frac<EF>;\n            let second_half_buf =\n                DeviceBuffer::<Frac<EF>>::from_raw_parts(second_half_ptr.add(half), half);\n            frac_add_alpha(&second_half_buf, alpha)\n                .map_err(FractionalSumcheckError::SegmentTree)?;\n            std::mem::forget(second_half_buf);\n        }\n        1 // layer 0 done; continue from layer 1\n    };\n\n    // Remaining layers: fuse consecutive pairs via two-layer kernel (~33% traffic savings).\n    let mut i = start_layer_i;\n    while i + 1 < total_rounds {\n        let half_i1 = total_leaves >> (i + 2);\n        unsafe {\n            frac_build_tree_two_layers(&mut layer, half_i1)\n                .map_err(FractionalSumcheckError::SegmentTree)?;\n        }\n        i += 2;\n    }\n    // Remaining single layer (if odd number of layers left).\n    if i < total_rounds {\n        unsafe {\n            frac_build_tree_layer(&mut layer, total_leaves >> i, false, EF::ZERO, false)\n                .map_err(FractionalSumcheckError::SegmentTree)?;\n        }\n    }\n    mem.emit_metrics_with_label(\"frac_sumcheck.segment_tree\");\n    mem.tracing_info(\"fractional_sumcheck_gkr: after building segment tree\");\n    let mut copy_scratch = DeviceBuffer::<Frac<EF>>::with_capacity(1);\n    let root = copy_from_device(&layer, 0, &mut copy_scratch)?;\n    unsafe {\n        frac_build_tree_layer(&mut layer, 2, true, EF::ZERO, false)\n            .map_err(FractionalSumcheckError::SegmentTree)?;\n    }\n    if assert_zero {\n        if root.p != EF::ZERO {\n            return Err(FractionalSumcheckError::NonzeroRootSum {\n                p: root.p,\n                q: root.q,\n            });","numLines":100,"startLine":490,"totalLines":1271}}}
