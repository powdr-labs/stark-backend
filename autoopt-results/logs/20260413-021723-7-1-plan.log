   )\n241\t    .entered();\n242\t    #[allow(clippy::needless_range_loop)]\n243\t    for round in 1..=n_stack {\n244\t        let batch_s_evals = prover.batch_sumcheck_poly_eval(round, u_vec[round - 1])?;\n245\t\n246\t        for &eval in &batch_s_evals {\n247\t            transcript.observe_ext(eval);\n248\t        }\n249\t        sumcheck_round_polys.push(batch_s_evals);\n250\t\n251\t        let u_round = transcript.sample_ext();\n252\t        u_vec.push(u_round);\n253\t        debug!(%round, %u_round);\n254\t\n255\t        prover.fold_mle_evals(round, u_round)?;\n256\t    }\n257\t    let stacking_openings = prover.get_stacked_openings()?;\n258\t    for claims_for_com in &stacking_openings {\n259\t        for &claim in claims_for_com {\n260\t            transcript.observe_ext(claim);\n261\t        }\n262\t    }\n263\t    drop(_mle_rounds_span);\n264\t    let proof = StackingProof {\n265\t        univariate_round_coeffs: s_0.into_coeffs(),\n266\t        sumcheck_round_polys,\n267\t        stacking_openings,\n268\t    };\n269\t    Ok((proof, u_vec, prover.stacked_per_commit))\n270\t}\n271\t\n272\timpl<D: Copy + Clone + Send + Sync + 'static> StackedReductionGpu<D> {\n273\t    #[instrument(\"stacked_reduction_new\", level = \"debug\", skip_all)]\n274\t    fn new<HS: GpuHashScheme<Digest = D>>(\n275\t        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n276\t        ctx: ProvingContext<GenericGpuBackend<HS>>,\n277\t        common_main_pcs_data: StackedPcsDataGpu<F, D>,\n278\t        r: &[EF],\n279\t        lambda: EF,\n280\t        sm_count: u32,\n281\t    ) -> Result<Self, StackedReductionError> {\n282\t        ensure_device_ntt_twiddles_initialized();\n283\t        let mem = MemTracker::start(\"prover.stacked_reduction_new\");\n284\t        let l_skip = mpk.params.l_skip;\n285\t        let n_stack = mpk.params.n_stack;\n286\t\n287\t        let omega_skip = F::two_adic_generator(l_skip);\n288\t        let omega_skip_pows = omega_skip.powers().take(1 << l_skip).collect_vec();\n289\t        let d_omega_skip_pows = omega_skip_pows.to_device()?;\n290\t\n291\t        // NOTE: DeviceMatrix contains an Arc, so clone is lightweight [for now].\n292\t        // PERF[jpw]: stack the traces all at once. To save memory, we could either stack and drop\n293\t        // traces as we go or even at commit time only store the stacked matrix and drop the traces\n294\t        // much earlier.\n295\t        let common_main_traces = ctx\n296\t            .per_trace\n297\t            .iter()\n298\t            .map(|(_, air_ctx)| air_ctx.common_main.clone())\n299\t            .collect_vec();\n300\t        // SAFETY: common_main_traces commits to common_main_pcs_data\n301\t        let common_main_stacked = unsafe {\n302\t            StackedPcsData2::from_raw(Arc::new(common_main_pcs_data), common_main_traces)\n303\t        };\n304\t        let mut stacked_per_commit = vec![common_main_stacked];\n305\t        for (air_idx, air_ctx) in ctx.per_trace.iter() {\n306\t            for committed in mpk.per_air[*air_idx]\n307\t                .preprocessed_data\n308\t                .iter()\n309\t                .chain(air_ctx.cached_mains.iter())\n310\t            {\n311\t                // SAFETY: committed.trace commits to committed.data\n312\t                let stacked = unsafe {\n313\t                    StackedPcsData2::from_raw(committed.data.clone(), vec![committed.trace.clone()])\n314\t                };\n315\t                stacked_per_commit.push(stacked);\n316\t            }\n317\t        }\n318\t\n319\t        debug_assert!(stacked_per_commit\n320\t            .iter()\n321\t            .all(|d| d.layout().height() == 1 << (l_skip + n_stack)));\n322\t\n323\t        let need_rot_per_trace = ctx\n324\t            .per_trace\n325\t            .iter()\n326\t            .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n327\t            .collect_vec();\n328\t        let mut need_rot_per_commit = vec![need_rot_per_trace];\n329\t  