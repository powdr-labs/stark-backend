s) = layout.sorted_cols[idx + j];\n366\t                    debug_assert_eq!(_j, j);\n367\t                    debug_assert_eq!(1 << s.log_height(), trace.height());\n368\t                    unstacked_cols.push(UnstackedSlice {\n369\t                        commit_idx: commit_idx as u32,\n370\t                        log_height: s.log_height() as u32,\n371\t                        stacked_row_idx: s.row_idx as u32,\n372\t                        stacked_col_idx: s.col_idx as u32,\n373\t                    });\n374\t                    need_rot_per_col.push(need_rot);\n375\t                }\n376\t            }\n377\t        }\n378\t        debug_assert_eq!(unstacked_cols.len(), total_num_cols);\n379\t        ht_diff_idxs.push(unstacked_cols.len());\n380\t\n381\t        let lambda_pows_used = lambda.powers().take(total_num_cols * 2).collect_vec();\n382\t        let mut lambda_pows = vec![EF::ZERO; total_num_cols * 2];\n383\t        for (col_idx, need_rot) in need_rot_per_col.into_iter().enumerate() {\n384\t            let lambda_eq_idx = 2 * col_idx;\n385\t            let lambda_rot_idx = 2 * col_idx + 1;\n386\t            lambda_pows[lambda_eq_idx] = lambda_pows_used[lambda_eq_idx];\n387\t            if need_rot {\n388\t                lambda_pows[lambda_rot_idx] = lambda_pows_used[lambda_rot_idx];\n389\t            }\n390\t        }\n391\t        let d_lambda_pows = lambda_pows.to_device()?;\n392\t\n393\t        let d_unstacked_cols = unstacked_cols.to_device()?;\n394\t\n395\t        // layout per commit is sorted, first height is largest\n396\t        let n_max = r.len() - 1;\n397\t        debug_assert_eq!(\n398\t            n_max,\n399\t            stacked_per_commit\n400\t                .iter()\n401\t                .map(|d| d.layout().sorted_cols[0].2.log_height())\n402\t                .max()\n403\t                .unwrap_or(0)\n404\t                .saturating_sub(l_skip)\n405\t        );\n406\t        let eq_r_ns =\n407\t            EqEvalSegments::new(&r[1