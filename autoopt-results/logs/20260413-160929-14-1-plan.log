::<EF>::with_capacity(temp_sums_buffer_capacity);\n81\t    let used_temp_bytes =\n82\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<EF>();\n83\t    if used_temp_bytes > max_temp_bytes {\n84\t        // We do not error if the required bytes is greater than the requested max, but this may\n85\t        // lead to unexpected peak memory usage.\n86\t        warn!(\"zerocheck used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\");\n87\t    }\n88\t\n89\t    let preprocessed_ptr = pk\n90\t        .preprocessed_data\n91\t        .as_ref()\n92\t        .map(|cd| cd.trace.buffer().as_ptr())\n93\t        .unwrap_or(std::ptr::null());\n94\t\n95\t    let mut sp_evals =\n96\t        DeviceBuffer::<EF>::with_capacity(num_cosets as usize * skip_domain as usize);\n97\t    // SAFETY:\n98\t    // - No bounds checks are done in this kernel. It fully assumes that the Rules are trusted and\n99\t    //   all nodes are valid.\n100\t    unsafe {\n101\t        zerocheck_ntt_eval_constraints(\n102\t            &mut temp_sums_buffer,\n103\t            &mut sp_evals,\n104\t            selectors_cube,\n105\t            preprocessed_ptr,\n106\t            main_parts,\n107\t            eq_cube,\n108\t            lambda_pows,\n109\t            public_values,\n110\t            &rules.inner.d_rules,\n111\t            &rules.inner.d_used_nodes,\n112\t            buffer_size,\n113\t            &mut intermediates,\n114\t            skip_domain,\n115\t            num_x,\n116\t            height,\n117\t            num_cosets,\n118\t            g_shift,\n119\t            max_temp_bytes,\n120\t        )?;\n121\t    }\n122\t\n123\t    Ok(sp_evals)\n124\t}\n125\t\n126\t/// Evaluate interaction constraints (excluding plain AIR constraints) for a single AIR, given\n127\t/// prepared trace input.\n128\t///\n129\t/// `constraints` includes interaction expressions for the AIR.\n130\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory beh