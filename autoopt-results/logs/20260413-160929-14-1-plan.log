{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BT47QhUaLdbk8MrhwFoNuB","type":"tool_result","content":"400\t    src_pq_buffer: &DeviceBuffer<Frac<EF>>,\n401\t    dst_pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n402\t    src_pq_size: usize,\n403\t    lambda: EF,\n404\t    r_prev: EF,\n405\t    transcript: &mut TS,\n406\t    d_sum_evals: &mut DeviceBuffer<EF>,\n407\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n408\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n409\t    r_vec: &mut Vec<EF>,\n410\t    prev_s_eval: &mut EF,\n411\t    xi_j: EF,\n412\t    eq_r_acc: &mut EF,\n413\t) -> Result<EF, FractionalSumcheckError>\n414\twhere\n415\t    SC: StarkProtocolConfig<EF = EF>,\n416\t    TS: FiatShamirTranscript<SC>,\n417\t{\n418\t    unsafe {\n419\t        frac_compute_round_and_fold(\n420\t            eq_buffer,\n421\t            src_pq_buffer,\n422\t            dst_pq_buffer,\n423\t            src_pq_size,\n424\t            lambda,\n425\t            r_prev,\n426\t            d_sum_evals,\n427\t            tmp_block_sums,\n428\t        )\n429\t        .map_err(FractionalSumcheckError::ComputeRound)?;\n430\t    }\n431\t    eq_buffer.drop_layer();\n432\t    observe_and_update(\n433\t        d_sum_evals,\n434\t        transcript,\n435\t        round_polys_eval,\n436\t        r_vec,\n437\t        prev_s_eval,\n438\t        xi_j,\n439\t        eq_r_acc,\n440\t    )\n441\t}\n442\t\n443\t/// In-place variant of [`do_fused_sumcheck_round`]. Reads and writes to the same buffer.\n444\t#[allow(clippy::too_many_arguments)]\n445\tfn do_fused_sumcheck_round_inplace<SC, TS>(\n446\t    eq_buffer: &mut SqrtEqLayers,\n447\t    pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n448\t    src_pq_size: usize,\n449\t    lambda: EF,\n450\t    r_prev: EF,\n451\t    transcript: &mut TS,\n452\t    d_sum_evals: &mut DeviceBuffer<EF>,\n453\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n454\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n455\t    r_vec: &mut Vec<EF>,\n456\t    prev_s_eval: &mut EF,\n457\t    xi_j: EF,\n458\t    eq_r_acc: &mut EF,\n459\t) -> Result<EF, FractionalSumcheckError>\n460\twhere\n461\t    SC: StarkProtocolConfig<EF = EF>,\n462\t    TS: FiatShamirTranscript<SC>,\n463\t{\n464\t    unsafe {\n465\t        frac_compute_round_and_fold_inplace(\n466\t            eq_buffer,\n467\t            pq_buffer,\n468\t            src_pq_size,\n469\t            lambda,\n470\t            r_prev,\n471\t            d_sum_evals,\n472\t            tmp_block_sums,\n473\t        )\n474\t        .map_err(FractionalSumcheckError::ComputeRound)?;\n475\t    }\n476\t    eq_buffer.drop_layer();\n477\t    observe_and_update(\n478\t        d_sum_evals,\n479\t        transcript,\n480\t        round_polys_eval,\n481\t        r_vec,\n482\t        prev_s_eval,\n483\t        xi_j,\n484\t        eq_r_acc,\n485\t    )\n486\t}\n487\t\n488\t/// GKR fractional sumcheck prover. See `docs/cuda-backend/gkr-prover.md` (repo root) for the\n489\t/// protocol and implementation details.\n490\t#[instrument(skip_all)]\n491\tpub fn fractional_sumcheck_gpu<SC, TS>(\n492\t    transcript: &mut TS,\n493\t    leaves: DeviceBuffer<Frac<EF>>,\n494\t    alpha: EF,\n495\t    assert_zero: bool,\n496\t    mem: &mut MemTracker,\n497\t) -> Result<(FracSumcheckProof<SC>, Vec<EF>), FractionalSumcheckError>\n498\twhere\n499\t    SC: StarkProtocolConfig<EF = EF>,\n500\t    TS: FiatShamirTranscript<SC>,\n501\t{\n502\t    let mut layer = leaves;\n503\t    if layer.is_empty() {\n504\t        return Ok((\n505\t            FracSumcheckProof {\n506\t                fractional_sum: (EF::ZERO, EF::ONE),\n507\t                claims_per_layer: vec![],\n508\t                sumcheck_polys: vec![],\n509\t            },\n510\t            vec![],\n511\t        ));\n512\t    };\n513\t    let total_leaves = layer.len();\n514\t    // total_rounds = l_skip + n_logup\n515\t    let total_rounds = log2_strict_usize(total_leaves);\n516\t    assert!(total_rounds > 0, \"n_logup > 0 when there are interactions\");\n517\t    // Build segment tree.\n518\t    // - We only maintain the current layer\n519\t    // - Input layer uses separate F and EF buffers to save memory\n520\t    // - First tree layer converts (F, EF) to FracExt (EF, EF)\n521\t\n522\t    // We store it in bit-reversal order for coalesced memory accesses.\n523\t    // For large N (> 1024), fuse bitrev + tree layers 0 and 1 into a single kernel pass,\n524\t    // eliminating ~1.5N global memory reads. For small N, fall back to separate operations.\n525\t    let start_layer_i = if total_leaves > 1024 {\n526\t        unsafe {\n527\t            // SAFETY: Frac<EF> has exact same memory layout and alignment as (EF, EF).\n528\t            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n529\t            bit_rev_frac_ext_build_k2(buf, total_rounds as u32, alpha)\n530\t                .map_err(FractionalSumcheckError::BitReversal)?;\n531\t        }\n532\t        2 // layers 0+1 already done\n533\t    } else {\n534\t        // Fallback: separate bitrev + layer 0.\n535\t        unsafe {\n536\t            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n537\t            bit_rev_frac_ext(\n538\t                buf,\n539\t                buf,\n540\t                total_rounds as u32,\n541\t                total_leaves.try_into().unwrap(),\n542\t                1,\n543\t            )\n544\t            .map_err(FractionalSumcheckError::BitReversal)?;\n545\t            frac_build_tree_layer(&mut layer, total_leaves, false, alpha, true)\n546\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n547\t            use crate::cuda::logup_zerocheck::frac_add_alpha;\n548\t            let half = total_leaves / 2;\n549\t            let second_half_ptr = layer.as_mut_raw_ptr() as *mut Frac<EF>;\n550\t            let second_half_buf =\n551\t                DeviceBuffer::<Frac<EF>>::from_raw_parts(second_half_ptr.add(half), half);\n552\t            frac_add_alpha(&second_half_buf, alpha)\n553\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n554\t            std::mem::forget(second_half_buf);\n555\t        }\n556\t        1 // layer 0 done; continue from layer 1\n557\t    };\n558\t\n559\t    // Remaining layers: fuse consecutive pairs via two-layer kernel (~33% traffic savings).\n560\t    let mut i = start_layer_i;\n561\t    while i + 1 < total_rounds {\n562\t        let half_i1 = total_leaves >> (i + 2);\n563\t        unsafe {\n564\t            frac_build_tree_two_layers(&mut layer, half_i1)\n565\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n566\t        }\n567\t        i += 2;\n568\t    }\n569\t    // Remaining single layer (if odd number of layers left).\n570\t    if i < total_rounds {\n571\t        unsafe {\n572\t            frac_build_tree_layer(&mut layer, total_leaves >> i, false, EF::ZERO, false)\n573\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n574\t        }\n575\t    }\n576\t    mem.emit_metrics_with_label(\"frac_sumcheck.segment_tree\");\n577\t    mem.tracing_info(\"fractional_sumcheck_gkr: after building segment tree\");\n578\t    let mut copy_scratch = DeviceBuffer::<Frac<EF>>::with_capacity(1);\n579\t    let root = copy_from_device(&layer, 0, &mut copy_scratch)?;\n580\t    unsafe {\n581\t        frac_build_tree_layer(&mut layer, 2, true, EF::ZERO, false)\n582\t            .map_err(FractionalSumcheckError::SegmentTree)?;\n583\t    }\n584\t    if assert_zero {\n585\t        if root.p != EF::ZERO {\n586\t            return Err(FractionalSumcheckError::NonzeroRootSum {\n587\t                p: root.p,\n588\t                q: root.q,\n589\t            });\n590\t        }\n591\t    } else {\n592\t        transcript.observe_ext(root.p);\n593\t    }\n594\t    transcript.observe_ext(root.q);\n595\t\n596\t    let mut claims_per_layer = Vec::with_capacity(total_rounds);\n597\t    let mut sumcheck_polys = Vec::with_capacity(total_rounds);\n598\t\n599\t    let first_left = copy_from_device(&layer, 0, &mut copy_scratch)?;\n600\t    let first_right = copy_from_device(&layer, 1, &mut copy_scratch)?;\n601\t    claims_per_layer.push(GkrLayerClaims {\n602\t        p_xi_0: first_left.p,\n603\t        q_xi_0: first_left.q,\n604\t        p_xi_1: first_right.p,\n605\t        q_xi_1: first_right.q,\n606\t    });\n607\t    for value in [\n608\t        claims_per_layer[0].p_xi_0,\n609\t        claims_per_layer[0].q_xi_0,\n610\t        claims_per_layer[0].p_xi_1,\n611\t        claims_per_layer[0].q_xi_1,\n612\t    ] {\n613\t        transcript.observe_ext(value);\n614\t    }\n615\t    let mu_1 = transcript.sample_ext();\n616\t    let mut xi_prev = vec![mu_1];\n617\t    let mut d_sum_evals = DeviceBuffer::<EF>::with_capacity(2);\n618\t\n619\t    let precompute_m_env = precompute_m_enabled();\n620\t\n621\t    // Work buffer to avoid revert operations on layer. Only needed for non-last rounds.\n622\t    // For the last round (round == total_rounds - 1), we fold in-place on layer.\n623\t    // When precompute-M is active, the first multifold folds w+1 variables at once\n624\t    // (pending r_prev + w window challenges), so the output is total_leaves >> (2 + w).\n625\t    // Fold-eval fallback rounds (rem_n < min_n) need at most 2^min_n elements.\n626\t    let max_work_size = if total_rounds > 2 {\n627\t        if precompute_m_env {\n628\t            (total_leaves >> (2 + GKR_WINDOW_SIZE)).max(1 << GKR_WINDOW_DEFAULT_MIN_N)\n629\t        } else {\n630\t            total_leaves >> 2\n631\t        }\n632\t    } else {\n633\t        0\n634\t    };\n635\t    let mut work_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(max_work_size);\n636\t    let max_tmp_buffer_capacity = if total_rounds > 1 {\n637\t        (unsafe { _frac_compute_round_temp_buffer_size((1 << (total_rounds - 1)) as u32) }) as usize\n638\t    } else {\n639\t        0\n640\t    };\n641\t    let mut tmp_block_sums = if max_tmp_buffer_capacity > 0 {\n642\t        DeviceBuffer::<EF>::with_capacity(max_tmp_buffer_capacity)\n643\t    } else {\n644\t        DeviceBuffer::new()\n645\t    };\n646\t    let precompute_m_min_blocks_threshold = precompute_m_min_blocks_threshold();\n647\t    let precompute_m_target_blocks = precompute_m_target_blocks();\n648\t    let precompute_m_tail_tile_override = precompute_m_tail_tile_override();\n649\t    let precompute_m_min_n = precompute_m_min_n();"}]},"parent_tool_use_id":"toolu_01TKSERYzbpr2YE1SjSGbB7V","session_id":"d386d521-3ea3-445a-958b-d64302191775","uuid":"ae92b39a-a87e-473f-9261-1abcd403ccae","timestamp":"2026-04-13T14:18:11.622Z"}
