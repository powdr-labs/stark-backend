                 // Previous round's challenge for folding\n243\t    FpExt *__restrict__ block_sums,      // Output: [gridDim.x * 2]\n244\t    FracExt *__restrict__ dst_pq         // Post-fold buffer (pq_size FracExt)\n245\t) {\n246\t    extern __shared__ FpExt shared[];\n247\t    const uint32_t pq_size = 2 * num_x;\n248\t\n249\t    // Index offsets for fold pattern (see detailed comments in inplace kernel)\n250\t    const uint32_t half = pq_size;              // src_pq_size / 2\n251\t    const uint32_t quarter = pq_size >> 1;      // pq_size / 2\n252\t    const uint32_t eighth = pq_size >> 2;       // pq_size / 4\n253\t    const uint32_t three_eighths = eighth * 3;  // 3 * pq_size / 4\n254\t\n255\t    // Use scalar accumulators instead of array to help register allocation\n256\t    const FpExt zero(Fp::zero());\n257\t    FpExt local0 = zero, local1 = zero;\n258\t    uint32_t idx_base = threadIdx.x + blockIdx.x * blockDim.x;\n259\t\n260\t    // Map phase: compute local sum by striding over grid\n261\t    for (uint32_t idx = idx_base; idx < num_x / 2; idx += blockDim.x * gridDim.x) {\n262\t        // Scalars for folded values used in compute\n263\t        FpExt p0_even, q0_even, p1_even, q1_even;\n264\t        FpExt p0_odd, q0_odd, p1_odd, q1_odd;\n265\t\n266\t        // Load pairs in tight scopes, fold, write immediately to reduce register pressure\n267\t        // f00 at post-fold idx\n268\t        {\n269\t            FracExt a = src_pq[idx];\n270\t            FracExt b = src_pq[idx + quarter];\n271\t            p0_even = a.p + r_prev * (b.p - a.p);\n272\t            q0_even = a.q + r_prev * (b.q - a.q);\n273\t            dst_pq[idx] = {p0_even, q0_even};\n274\t        }\n275\t        // f10 at post-fold idx + quarter\n276\t        {\n277\t            FracExt a = src_pq[idx + half];\n278\t            FracExt b = src_pq[idx + half + quarter];\n279\t            p1_even = a.p + r_prev * (b.p - a.p);\n280\t            q1_even = a.q + r_prev * (b.q - a.q);\n281\t            dst_pq[idx + quarter] = {p1_even, q1_even};\n282\t        }\n283\t        // f01 at post-fold idx + eighth\n284\t        {\n285\t            FracExt a = src_pq[idx + eighth];\n286\t            FracExt b = src_pq[idx + three_eighths];\n287\t            p0_odd = a.p + r_prev * (b.p - a.p);\n288\t            q0_odd = a.q + r_prev * (b.q - a.q);\n289\t            dst_pq[idx + eighth] = {p0_odd, q0_odd};\n290\t        }\n291\t        // f11 at post-fold idx + three_eighths\n292\t        {\n293\t            FracExt a = src_pq[idx + half + eighth];\n294\t            FracExt b = src_pq[idx + half + three_eighths];\n295\t            p1_odd = a.p + r_prev * (b.p - a.p);\n296\t            q1_odd = a.q + r_prev * (b.q - a.q);\n297\t            dst_pq[idx + three_eighths] = {p1_odd, q1_odd};\n298\t        }\n299\t\n300\t        accumulate_compute_contributions("}]},"parent_tool_use_id":"toolu_01TKSERYzbpr2YE1SjSGbB7V","session_id":"d386d521-3ea3-445a-958b-d64302191775","uuid":"fc1d2af6-edb5-45ca-b13c-593b1b060a41","timestamp":"2026-04-13T14:18:17.074Z"}
