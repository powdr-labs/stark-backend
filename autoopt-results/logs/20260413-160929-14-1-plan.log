{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011yHvkhrcRV1hZGg5KGDakn","type":"tool_result","content":"1\t//! Rust bindings for BN254 Poseidon2 Merkle-tree CUDA kernels and RC initialization.\n2\t\n3\tuse std::sync::OnceLock;\n4\t\n5\tuse openvm_cuda_common::{d_buffer::DeviceBuffer, error::CudaError};\n6\tuse zkhash::{\n7\t    ark_ff::PrimeField as _, fields::bn256::FpBN256 as ArkFpBN256,\n8\t    poseidon2::poseidon2_instance_bn256::RC3,\n9\t};\n10\t\n11\tuse crate::{\n12\t    bn254_sponge::DeviceBn254SpongeState,\n13\t    prelude::{EF, F},\n14\t};\n15\t\n16\t// ---------------------------------------------------------------------------\n17\t// BN254 Digest type (single Bn254Scalar = [u64; 4] in Montgomery form)\n18\t// ---------------------------------------------------------------------------\n19\t\n20\t/// One BN254 scalar element — the digest type for BN254 Poseidon2 Merkle trees.\n21\t/// Layout matches `bn254_digest_t` in the CUDA kernel (32 bytes, align 8).\n22\tpub type Bn254Digest = [openvm_stark_sdk::config::baby_bear_bn254_poseidon2::Bn254Scalar; 1];\n23\t\n24\t// Compile-time FFI safety assertions.\n25\t// `Bn254Digest` is passed to CUDA as `Bn254Fr*` (32 bytes, 8-aligned).\n26\tconst _: () = assert!(\n27\t    std::mem::size_of::<Bn254Digest>() == 32,\n28\t    \"Bn254Digest must be 32 bytes to match CUDA bn254_digest_t\"\n29\t);\n30\tconst _: () = assert!(\n31\t    std::mem::align_of::<Bn254Digest>() == 8,\n32\t    \"Bn254Digest must be 8-byte aligned to match CUDA Bn254Fr\"\n33\t);\n34\t// `F` (BabyBear) is cast to `*const u32` at the FFI boundary.\n35\tconst _: () = assert!(\n36\t    std::mem::size_of::<F>() == std::mem::size_of::<u32>(),\n37\t    \"F must be 4 bytes to match CUDA uint32_t\"\n38\t);\n39\t// `EF` (BinomialExtensionField<BabyBear, 4>) is cast to `*const u32` (stride of 4 u32s).\n40\tconst _: () = assert!(\n41\t    std::mem::size_of::<EF>() == 4 * std::mem::size_of::<u32>(),\n42\t    \"EF must be 16 bytes (4 x uint32_t) for CUDA\"\n43\t);\n44\t\n45\t// ---------------------------------------------------------------------------\n46\t// FFI-safe type alias: 32 bytes = 4 × u64, matching CUDA `Bn254Fr`.\n47\t// We use this in extern declarations instead of `Bn254Digest` to avoid\n48\t// passing non-repr(C) types across the FFI boundary.\n49\t// ---------------------------------------------------------------------------\n50\ttype Bn254FrRaw = [u64; 4];\n51\t\n52\t// ---------------------------------------------------------------------------\n53\t// FFI declarations\n54\t// ---------------------------------------------------------------------------\n55\t\n56\textern \"C\" {\n57\t    fn _init_bn254_poseidon2_rc(\n58\t        initial_rc: *const u64,  // [4*3*4] = 48 u64s\n59\t        partial_rc: *const u64,  // [56*4]  = 224 u64s\n60\t        terminal_rc: *const u64, // [4*3*4] = 48 u64s\n61\t    ) -> i32;\n62\t\n63\t    fn _bn254_poseidon2_compressing_row_hashes(\n64\t        out: *mut Bn254FrRaw,\n65\t        matrix: *const u32, // F = BabyBear, repr(transparent) over u32\n66\t        width: usize,\n67\t        query_stride: usize,\n68\t        log_rows_per_query: usize,\n69\t    ) -> i32;\n70\t\n71\t    fn _bn254_poseidon2_compressing_row_hashes_ext(\n72\t        out: *mut Bn254FrRaw,\n73\t        matrix: *const u32, // EF = [BabyBear; 4], each BabyBear is repr(transparent) over u32\n74\t        width: usize,\n75\t        query_stride: usize,\n76\t        log_rows_per_query: usize,\n77\t    ) -> i32;\n78\t\n79\t    fn _bn254_poseidon2_adjacent_compress_layer(\n80\t        output: *mut Bn254FrRaw,\n81\t        prev_layer: *const Bn254FrRaw,\n82\t        output_size: usize,\n83\t    ) -> i32;\n84\t\n85\t    fn _bn254_sponge_grind(\n86\t        init_state: *const DeviceBn254SpongeState,\n87\t        bits: u32,\n88\t        min_witness: u32,\n89\t        max_witness: u32,\n90\t        result: *mut u32,\n91\t    ) -> i32;\n92\t}\n93\t\n94\t// ---------------------------------------------------------------------------\n95\t// Montgomery multiplication helper (mirrors CUDA imr / bn254_monty_mul)\n96\t// ---------------------------------------------------------------------------\n97\t\n98\tconst BN254_PRIME: [u64; 4] = [\n99\t    0x43e1f593f0000001,\n100\t    0x2833e84879b97091,\n101\t    0xb85045b68181585d,\n102\t    0x30644e72e131a029,\n103\t];\n104\tconst BN254_MU: u64 = 0x3d1e0a6c10000001;\n105\tconst BN254_R_SQ: [u64; 4] = [\n106\t    0x1bb8e645ae216da7,\n107\t    0x53fe3ab1e35c59e3,\n108\t    0x8c49833d53bb8085,\n109\t    0x0216d0b17f4e44a5,\n110\t];\n111\t\n112\tfn mul_small(lhs: [u64; 4], rhs: u64) -> (u64, [u64; 4]) {\n113\t    let mut acc = (lhs[0] as u128) * (rhs as u128);\n114\t    let low = acc as u64;\n115\t    acc >>= 64;\n116\t    let mut high = [0u64; 4];\n117\t    for i in 1..4 {\n118\t        acc += (lhs[i] as u128) * (rhs as u128);\n119\t        high[i - 1] = acc as u64;\n120\t        acc >>= 64;\n121\t    }\n122\t    high[3] = acc as u64;\n123\t    (low, high)\n124\t}\n125\t\n126\tfn mul_small_and_acc(lhs: [u64; 4], rhs: u64, add: [u64; 4]) -> (u64, [u64; 4]) {\n127\t    let mut acc = (lhs[0] as u128) * (rhs as u128) + (add[0] as u128);\n128\t    let low = acc as u64;\n129\t    acc >>= 64;\n130\t    let mut high = [0u64; 4];\n131\t    for i in 1..4 {\n132\t        acc += (lhs[i] as u128) * (rhs as u128) + (add[i] as u128);\n133\t        high[i - 1] = acc as u64;\n134\t        acc >>= 64;\n135\t    }\n136\t    high[3] = acc as u64;\n137\t    (low, high)\n138\t}\n139\t\n140\tfn imr(acc0: u64, acc: [u64; 4]) -> [u64; 4] {\n141\t    let t = acc0.wrapping_mul(BN254_MU);\n142\t    let (_, u) = mul_small(BN254_PRIME, t);\n143\t    let mut sub = [0u64; 4];\n144\t    let mut borrow: u64 = 0;\n145\t    for i in 0..4 {\n146\t        let (d, b1) = acc[i].overflowing_sub(u[i]);\n147\t        let (d2, b2) = d.overflowing_sub(borrow);\n148\t        sub[i] = d2;\n149\t        borrow = (b1 as u64) + (b2 as u64);\n150\t    }\n151\t    if borrow != 0 {\n152\t        let mut carry: u64 = 0;\n153\t        let mut result = [0u64; 4];\n154\t        for i in 0..4 {\n155\t            let t = (sub[i] as u128) + (BN254_PRIME[i] as u128) + (carry as u128);\n156\t            result[i] = t as u64;\n157\t            carry = (t >> 64) as u64;\n158\t        }\n159\t        result\n160\t    } else {\n161\t        sub\n162\t    }\n163\t}\n164\t\n165\t/// Montgomery multiplication: `lhs * rhs * R^{-1} mod P`.\n166\tpub fn monty_mul_bn254(lhs: [u64; 4], rhs: [u64; 4]) -> [u64; 4] {\n167\t    let (acc0, acc) = mul_small(lhs, rhs[0]);\n168\t    let res0 = imr(acc0, acc);\n169\t\n170\t    let (acc0, acc) = mul_small_and_acc(lhs, rhs[1], res0);\n171\t    let res1 = imr(acc0, acc);\n172\t\n173\t    let (acc0, acc) = mul_small_and_acc(lhs, rhs[2], res1);\n174\t    let res2 = imr(acc0, acc);\n175\t\n176\t    let (acc0, acc) = mul_small_and_acc(lhs, rhs[3], res2);\n177\t    imr(acc0, acc)\n178\t}\n179\t\n180\t/// Convert a canonical [u64; 4] BN254 value into Montgomery form.\n181\tpub fn canonical_to_monty_bn254(canonical: [u64; 4]) -> [u64; 4] {\n182\t    monty_mul_bn254(BN254_R_SQ, canonical)\n183\t}\n184\t\n185\t// ---------------------------------------------------------------------------\n186\t// Round-constant initialization\n187\t// ---------------------------------------------------------------------------\n188\t\n189\t/// Compute BN254 Poseidon2 round constants from zkhash's RC3.\n190\t/// Returns (initial_flat, partial_flat, terminal_flat) as flat u64 vectors.\n191\tfn compute_bn254_rc_constants() -> (Vec<u64>, Vec<u64>, Vec<u64>) {\n192\t    // RC3: 64 rows × 3 elements each (ark_FpBN256 in canonical form)\n193\t    // Layout:\n194\t    //   rows  0.. 4 → initial external rounds (3 elements each)\n195\t    //   rows  4..60 → internal/partial rounds (3 elements, only [0] used)\n196\t    //   rows 60..64 → terminal external rounds (3 elements each)\n197\t    let to_monty = |elem: &ArkFpBN256| -> [u64; 4] {\n198\t        let canonical: [u64; 4] = elem.into_bigint().0;\n199\t        canonical_to_monty_bn254(canonical)\n200\t    };\n201\t\n202\t    let all_rows: Vec<[[u64; 4]; 3]> = RC3\n203\t        .iter()\n204\t        .map(|row| [to_monty(&row[0]), to_monty(&row[1]), to_monty(&row[2])])\n205\t        .collect();\n206\t\n207\t    let flatten_rows = |rows: &[[[u64; 4]; 3]]| -> Vec<u64> {\n208\t        rows.iter()\n209\t            .flat_map(|r| r.iter())\n210\t            .flat_map(|limbs| limbs.iter().copied())\n211\t            .collect()\n212\t    };\n213\t\n214\t    let initial_flat = flatten_rows(&all_rows[0..4]);\n215\t    let partial_flat: Vec<u64> = all_rows[4..60]\n216\t        .iter()\n217\t        .flat_map(|r| r[0].iter().copied())\n218\t        .collect();\n219\t    let terminal_flat = flatten_rows(&all_rows[60..64]);\n220\t\n221\t    (initial_flat, partial_flat, terminal_flat)\n222\t}\n223\t\n224\t/// Initialize BN254 Poseidon2 round constants on the GPU (called once at startup).\n225\tpub fn init_bn254_poseidon2_rc() -> Result<(), CudaError> {\n226\t    static INIT: OnceLock<i32> = OnceLock::new();\n227\t\n228\t    let code = *INIT.get_or_init(|| {\n229\t        let (initial, partial, terminal) = compute_bn254_rc_constants();\n230\t        unsafe { _init_bn254_poseidon2_rc(initial.as_ptr(), partial.as_ptr(), terminal.as_ptr()) }\n231\t    });\n232\t\n233\t    CudaError::from_result(code)\n234\t}\n235\t\n236\t// ---------------------------------------------------------------------------\n237\t// Public safe wrappers\n238\t// ---------------------------------------------------------------------------\n239\t\n240\t/// Computes BN254 Poseidon2 row hashes for a BabyBear matrix.\n241\t///\n242\t/// # Safety\n243\t/// - `out` must have length `>= query_stride`.\n244\t/// - `matrix` must have length `>= width * (query_stride << log_rows_per_query)`.\n245\tpub unsafe fn bn254_poseidon2_compressing_row_hashes(\n246\t    out: &mut DeviceBuffer<Bn254Digest>,\n247\t    matrix: &DeviceBuffer<F>,\n248\t    width: usize,\n249\t    query_stride: usize,\n250\t    log_rows_per_query: usize,\n251\t) -> Result<(), CudaError> {\n252\t    init_bn254_poseidon2_rc()?;\n253\t    CudaError::from_result(_bn254_poseidon2_compressing_row_hashes(\n254\t        out.as_mut_ptr().cast::<Bn254FrRaw>(),\n255\t        matrix.as_ptr().cast::<u32>(),\n256\t        width,\n257\t        query_stride,\n258\t        log_rows_per_query,\n259\t    ))\n260\t}\n261\t\n262\t/// Computes BN254 Poseidon2 row hashes for an extension-field matrix.\n263\t///\n264\t/// # Safety\n265\t/// - `out` must have length `>= query_stride`.\n266\t/// - `matrix` must have length `>= width * (query_stride << log_rows_per_query)`.\n267\tpub unsafe fn bn254_poseidon2_compressing_row_hashes_ext(\n268\t    out: &mut DeviceBuffer<Bn254Digest>,\n269\t    matrix: &DeviceBuffer<EF>,\n270\t    width: usize,\n271\t    query_stride: usize,\n272\t    log_rows_per_query: usize,\n273\t) -> Result<(), CudaError> {\n274\t    init_bn254_poseidon2_rc()?;\n275\t    CudaError::from_result(_bn254_poseidon2_compressing_row_hashes_ext(\n276\t        out.as_mut_ptr().cast::<Bn254FrRaw>(),\n277\t        matrix.as_ptr().cast::<u32>(),\n278\t        width,\n279\t        query_stride,\n280\t        log_rows_per_query,\n281\t    ))\n282\t}\n283\t\n284\t/// Compresses adjacent pairs of BN254 digests to produce the next Merkle layer.\n285\t///\n286\t/// # Safety\n287\t/// - `output` must have length `>= output_size`.\n288\t/// - `prev_layer` must have length `>= output_size * 2`.\n289\tpub unsafe fn bn254_poseidon2_adjacent_compress_layer(\n290\t    output: &mut DeviceBuffer<Bn254Digest>,\n291\t    prev_layer: &DeviceBuffer<Bn254Digest>,\n292\t    output_size: usize,\n293\t) -> Result<(), CudaError> {\n294\t    init_bn254_poseidon2_rc()?;\n295\t    CudaError::from_result(_bn254_poseidon2_adjacent_compress_layer(\n296\t        output.as_mut_ptr().cast::<Bn254FrRaw>(),\n297\t        prev_layer.as_ptr().cast::<Bn254FrRaw>(),\n298\t        output_size,\n299\t    ))\n300\t}\n301\t\n302\t/// Launch the BN254 sponge grinding kernel.\n303\t///\n304\t/// # Safety\n305\t/// - `init_state` must point to valid device memory.\n306\tpub unsafe fn bn254_sponge_grind(\n307\t    init_state: *const DeviceBn254SpongeState,\n308\t    bits: u32,\n309\t    max_witness: u32,\n310\t) -> Result<u32, crate::sponge::GrindError> {\n311\t    use openvm_cuda_common::copy::{MemCopyD2H, MemCopyH2D};\n312\t\n313\t    init_bn254_poseidon2_rc()?;\n314\t    let mut d_result: DeviceBuffer<u32> = DeviceBuffer::with_capacity(1);\n315\t    [u32::MAX].copy_to(&mut d_result)?;\n316\t\n317\t    for start in (0..=max_witness).step_by(1 << bits) {\n318\t        CudaError::from_result(_bn254_sponge_grind(\n319\t            init_state,\n320\t            bits,\n321\t            start,\n322\t            max_witness,\n323\t            d_result.as_mut_ptr(),\n324\t        ))?;\n325\t\n326\t        let result = d_result.to_host()?[0];\n327\t        if result < u32::MAX {\n328\t            return Ok(result);\n329\t        }\n330\t    }\n331\t    Err(crate::sponge::GrindError::WitnessNotFound)\n332\t}\n333\t"}]},"parent_tool_use_id":"toolu_01NLP2QCuMPDLWtQcAq3QvH5","session_id":"d386d521-3ea3-445a-958b-d64302191775","uuid":"6e6e4351-809c-4641-8f05-c6e6ee3fe2a9","timestamp":"2026-04-13T14:18:05.332Z"}
