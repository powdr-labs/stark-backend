= t01 + t23;\n102\t    Fp t01123 = t0123 + x[1];\n103\t    Fp t01233 = t0123 + x[3];\n104\t\n105\t    x[3] = t01233 + x[0].doubled();\n106\t    x[1] = t01123 + x[2].doubled();\n107\t    x[0] = t01123 + t01;\n108\t    x[2] = t01233 + t23;\n109\t}\n110\t\n111\tstatic __device__ void multiply_by_m_ext(Fp *old_cells) {\n112\t    // Optimized method for multiplication by M_EXT.\n113\t    // See appendix B of Poseidon2 paper for additional details.\n114\t    Fp tmp_sums[4];\n115\t    for (uint i = 0; i < 4; i++) {\n116\t        tmp_sums[i] = 0;\n117\t    }\n118\t    for (uint i = 0; i < CELLS / 4; i++) {\n119\t        multiply_by_4x4_circulant(old_cells + i * 4);\n120\t        for (uint j = 0; j < 4; j++) {\n121\t            tmp_sums[j] += old_cells[i * 4 + j];\n122\t        }\n123\t    }\n124\t    for (uint i = 0; i < CELLS; i++) {\n125\t        old_cells[i] += tmp_sums[i % 4];\n126\t    }\n127\t}\n128\t\n129\tstatic __device__ void add_round_constants_full(\n130\t    const Fp *ROUND_CONSTANTS_PLONKY3,\n131\t    Fp *cells,\n132\t    uint round\n133\t) {\n134\t    for (uint i = 0; i < CELLS; i++) {\n135\t        cells[i] += ROUND_CONSTANTS_PLONKY3[round * CELLS + i];\n136\t    }\n137\t}\n138\t\n139\tstatic __device__ void add_round_constants_partial(\n140\t    const Fp *PARTIAL_ROUND_CONSTANTS_PLONKY3,\n141\t    Fp *cells,\n142\t    uint round\n143\t) {\n144\t    cells[0] += PARTIAL_ROUND_CONSTANTS_PLONKY3[round];\n145\t}\n146\t\n147\tstatic __device__ __forceinline__ void internal_layer_mat_mul(Fp *cells) {\n148\t    Fp part_sum = cells[1];\n149\t    for (uint i = 2; i < CELLS; i++) {\n150\t        part_sum += cells[i];\n151\t    }\n152\t    // https://github.com/Plonky3/Plonky3/blob/ecc66909d17f37a4d626d4601dc1420742571630/baby-bear/src/poseidon2.rs#L219\n153\t    Fp sum = part_sum + cells[0];\n154\t    cells[0] = part_sum - cells[0];                    // -2\n155\t    cells[1] += sum;                                   // 1\n156\t    cells[2] = sum + cells[2].doubled();               // 2\n157\t    cells[3] = sum + cells[3].halve();                 // 1/2\n158\t    cells[4] = sum + cells[4].doubled() + cells[4];    // 3\n159\t    cells[5] = sum + cells[5].doubled().doubled();     // 4\n160\t    cells[6] = sum - cells[6].halve();                 // -1/2\n161\t    cells[7] = sum - (cells[7].doubled() + cells[7]);  // -3\n162\t    cells[8] = sum - cells[8].doubled().doubled();     // -4\n163\t    cells[9] = sum + cells[9] * internal_diag16[9];    // 1/2^8\n164\t    cells[10] = sum + cells[10].halve().halve();       // 1/4\n165\t    cells[11] = sum + cells[11] * internal_diag16[11]; // 1/8\n166\t    cells[12] = sum + cells[12] * internal_diag16[12]; // 1/2^27\n167\t    cells[13] = sum + cells[13] * internal_diag16[13]; // -1/2^8\n168\t    cells[14] = sum + cells[14] * internal_diag16[14]; // -1/16\n169\t    cells[15] = sum + cells[15] * internal_diag16[15]; // -1/2^27\n170\t}\n171\t\n172\tstatic __device__ void full_round_half(const Fp *ROUND_CONSTANTS, Fp *cells, uint round) {\n173\t    add_round_constants_full(ROUND_CONSTANTS, cells, round);\n174\t    do_full_sboxes(cells);\n175\t    multiply_by_m_ext(cells);\n176\t}\n177\t\n178\tstatic __device__ void partial_round(const Fp *PARTIAL_ROUND_CONSTANTS, Fp *cells, uint round) {\n179\t    add_round_constants_partial(PARTIAL_ROUND_CONSTANTS, cells, round);\n180\t    do_partial_sboxes(cells);\n181\t    internal_layer_mat_mul(cells);\n182\t}\n183\t\n184\tstatic __device__ void poseidon2_mix(Fp *cells) {\n185\t    // First linear layer.\n186\t    multiply_by_m_ext(cells);\n187\t\n188\t    // perform initial full rounds (external)\n189\t    for (uint i = 0; i < ROUNDS_HALF_FULL; i++) {\n190\t        full_round_half(INITIAL_ROUND_CONSTANTS, cells, i);\n191\t    }\n192\t\n193\t    // perform partial rounds (internal)\n194\t    for (uint i = 0; i < ROUNDS_PARTIAL; i++) {\n195\t        partial_round(INTERNAL_ROUND_CONSTANTS, cells, i);\n196\t    }\n197\t\n198\t    // perform terminal full rounds