{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UMbWts7WvNQv6vs7V1zdGV","type":"tool_result","content":"600\t            sh_right1[sh_idx] = q1;\n601\t        }\n602\t        __syncthreads();\n603\t\n604\t        // Phase 3: Accumulate with 2 muls per iteration (weight already folded in).\n605\t        for (uint32_t bi = 0; bi < batch; ++bi) {\n606\t            uint32_t row = bi * sh_stride;\n607\t            acc += sh_left0[row + u] * sh_right1[row + v]\n608\t                 + sh_left1[row + u] * sh_right0[row + v];\n609\t        }\n610\t\n611\t        __syncthreads();\n612\t    }\n613\t\n614\t    partial_out[blockIdx.x * (m * m) + u * m + v] = acc;\n615\t}\n616\t\n617\ttemplate <bool inline_fold, uint32_t W>\n618\tinline void launch_precompute_m_build_partial_kernel(\n619\t    dim3 grid,\n620\t    const FracExt *pq,\n621\t    uint32_t rem_n,\n622\t    FpExt lambda,\n623\t    FpExt r_prev,\n624\t    const FpExt *eq_tail_low,\n625\t    const FpExt *eq_tail_high,\n626\t    uint32_t log_eq_tail_low_cap,\n627\t    uint32_t tail_tile,\n628\t    FpExt *partial_out\n629\t) {\n630\t    constexpr uint32_t m = 1u << W;\n631\t    dim3 block(m, m);\n632\t    constexpr uint32_t sh_stride = m + 1;  // +1 padding to match kernel\n633\t    size_t shmem_bytes =\n634\t        (4 * sh_stride * PRECOMPUTE_M_TAIL_BATCH + PRECOMPUTE_M_TAIL_BATCH) * sizeof(FpExt);\n635\t    precompute_m_build_partial_kernel<inline_fold, W><<<grid, block, shmem_bytes>>>(\n636\t        pq,\n637\t        rem_n,\n638\t        lambda,\n639\t        r_prev,\n640\t        eq_tail_low,\n641\t        eq_tail_high,\n642\t        log_eq_tail_low_cap,\n643\t        tail_tile,\n644\t        partial_out\n645\t    );\n646\t}\n647\t\n648\ttemplate <bool inline_fold>\n649\tinline int launch_precompute_m_build_partial_dispatch(\n650\t    uint32_t w,\n651\t    dim3 grid,\n652\t    const FracExt *pq,\n653\t    uint32_t rem_n,\n654\t    FpExt lambda,\n655\t    FpExt r_prev,\n656\t    const FpExt *eq_tail_low,\n657\t    const FpExt *eq_tail_high,\n658\t    uint32_t log_eq_tail_low_cap,\n659\t    uint32_t tail_tile,\n660\t    FpExt *partial_out\n661\t) {\n662\t    using LauncherFn = void (*)(\n663\t        dim3, const FracExt *, uint32_t, FpExt, FpExt, const FpExt *, const FpExt *, uint32_t,\n664\t        uint32_t, FpExt *\n665\t    );\n666\t    static constexpr LauncherFn launchers[] = {\n667\t        &launch_precompute_m_build_partial_kernel<inline_fold, 1>,\n668\t        &launch_precompute_m_build_partial_kernel<inline_fold, 2>,\n669\t        &launch_precompute_m_build_partial_kernel<inline_fold, 3>,\n670\t        &launch_precompute_m_build_partial_kernel<inline_fold, 4>,\n671\t        &launch_precompute_m_build_partial_kernel<inline_fold, 5>,\n672\t    };\n673\t\n674\t    constexpr uint32_t min_w = 1;\n675\t    constexpr uint32_t max_w = static_cast<uint32_t>(sizeof(launchers) / sizeof(launchers[0]));\n676\t    if (w < min_w || w > max_w) {\n677\t        // 2D launch uses (2^w, 2^w) threads, so w > 5 exceeds 1024 threads per block.\n678\t        return cudaErrorInvalidValue;\n679\t    }\n680\t\n681\t    launchers[w - min_w](\n682\t        grid,\n683\t        pq,\n684\t        rem_n,\n685\t        lambda,\n686\t        r_prev,\n687\t        eq_tail_low,\n688\t        eq_tail_high,\n689\t        log_eq_tail_low_cap,\n690\t        tail_tile,\n691\t        partial_out\n692\t    );\n693\t    return 0;\n694\t}\n695\t\n696\t// Reduce partial M blocks into a final M matrix.\n697\t__global__ void precompute_m_reduce_partials_kernel(\n698\t    const FpExt *__restrict__ partial,\n699\t    uint32_t num_blocks,\n700\t    uint32_t total_entries,\n701\t    FpExt *__restrict__ m_total\n702\t) {\n703\t    uint32_t entry = blockIdx.x * blockDim.x + threadIdx.x;\n704\t    if (entry >= total_entries) {\n705\t        return;\n706\t    }\n707\t\n708\t    FpExt zero(Fp::zero());\n709\t    FpExt acc = zero;\n710\t    // Iterate over partial blocks with coalesced loads:\n711\t    // for fixed b, neighboring threads read neighboring entries.\n712\t    for (uint32_t b = 0; b < num_blocks; ++b) {\n713\t        acc += partial[(size_t)b * total_entries + entry];\n714\t    }\n715\t    m_total[entry] = acc;\n716\t}\n717\t\n718\t// Evaluate one round polynomial inside a precompute-M window from precomputed M.\n719\t// See docs/cuda-backend/gkr-prover.md § \"Precompute M strategy\".\n720\t// Output: out[0] = s'(1), out[1] = s'(2).\n721\t__global__ void precompute_m_eval_round_kernel(\n722\t    const FpExt *__restrict__ m_total,\n723\t    uint32_t w,\n724\t    uint32_t t,\n725\t    const FpExt *__restrict__ eq_r_prefix,\n726\t    const FpExt *__restrict__ eq_suffix,\n727\t    FpExt *__restrict__ out\n728\t) {\n729\t    extern __shared__ FpExt shared[];\n730\t\n731\t    uint32_t m = 1u << w;\n732\t    uint32_t prefix_bits = t;\n733\t    uint32_t suffix_bits = w - t - 1;\n734\t    uint32_t prefix_size = 1u << prefix_bits;\n735\t    uint32_t suffix_size = 1u << suffix_bits;\n736\t\n737\t    uint64_t total = (uint64_t)prefix_size * prefix_size * suffix_size;\n738\t    uint32_t cur_bit = 1u << suffix_bits;\n739\t    FpExt zero(Fp::zero());\n740\t    FpExt one(Fp::one());\n741\t    FpExt two = one + one;\n742\t\n743\t    FpExt local_s1 = zero;\n744\t    FpExt local_s2 = zero;\n745\t\n746\t    for (uint64_t idx = threadIdx.x; idx < total; idx += blockDim.x) {\n747\t        uint32_t suffix = (uint32_t)(idx % suffix_size);\n748\t        uint64_t tmp = idx / suffix_size;\n749\t        uint32_t b2 = (uint32_t)(tmp % prefix_size);\n750\t        uint32_t b1 = (uint32_t)(tmp / prefix_size);\n751\t\n752\t        FpExt weight = eq_r_prefix[b1] * eq_r_prefix[b2] * eq_suffix[suffix];\n753\t\n754\t        uint32_t prefix_shift = suffix_bits + 1;\n755\t        uint32_t beta1_0 = (b1 << prefix_shift) | suffix;\n756\t        uint32_t beta1_1 = beta1_0 | cur_bit;\n757\t        uint32_t beta2_0 = (b2 << prefix_shift) | suffix;\n758\t        uint32_t beta2_1 = beta2_0 | cur_bit;\n759\t\n760\t        FpExt m00 = m_total[beta1_0 * m + beta2_0];\n761\t        FpExt m01 = m_total[beta1_0 * m + beta2_1];\n762\t        FpExt m10 = m_total[beta1_1 * m + beta2_0];\n763\t        FpExt m11 = m_total[beta1_1 * m + beta2_1];\n764\t\n765\t        local_s1 += weight * m11;\n766\t        local_s2 += weight * (m00 - two * (m01 + m10 - m11 - m11));\n767\t    }\n768\t\n769\t    {\n770\t        FpExt reduced = sumcheck::block_reduce_sum(local_s1, shared);\n771\t        if (threadIdx.x == 0) out[0] = reduced;\n772\t    }\n773\t    __syncthreads();\n774\t    {\n775\t        FpExt reduced = sumcheck::block_reduce_sum(local_s2, shared);\n776\t        if (threadIdx.x == 0) out[1] = reduced;\n777\t    }\n778\t}\n779\t\n780\t// Fold w rounds at once using precomputed eq_r_window.\n781\t// One thread computes both poly outputs for a single tail index.\n782\ttemplate <uint32_t W>\n783\t__global__ void multifold_kernel(\n784\t    const FracExt *src,\n785\t    FracExt *dst,\n786\t    uint32_t tail_size,\n787\t    const FpExt *__restrict__ eq_r_window\n788\t) {\n789\t    constexpr uint32_t beta_size = 1u << W;\n790\t    uint32_t out_idx = blockIdx.x * blockDim.x + threadIdx.x;\n791\t    if (out_idx >= tail_size) {\n792\t        return;\n793\t    }\n794\t\n795\t    FpExt zero(Fp::zero());\n796\t    FpExt acc0_p = zero;\n797\t    FpExt acc0_q = zero;\n798\t    FpExt acc1_p = zero;\n799\t    FpExt acc1_q = zero;\n800\t    const FracExt *src_1 = src + ((size_t)tail_size << W);\n801\t    for (uint32_t beta = 0; beta < beta_size; ++beta) {\n802\t        uint32_t idx = beta * tail_size + out_idx;\n803\t        FracExt v0 = src[idx];\n804\t        FracExt v1 = src_1[idx];\n805\t        FpExt eq_r = eq_r_window[beta];\n806\t        acc0_p += eq_r * v0.p;\n807\t        acc0_q += eq_r * v0.q;\n808\t        acc1_p += eq_r * v1.p;\n809\t        acc1_q += eq_r * v1.q;\n810\t    }\n811\t    dst[out_idx] = {acc0_p, acc0_q};\n812\t    dst[tail_size + out_idx] = {acc1_p, acc1_q};\n813\t}\n814\t\n815\t__global__ void add_alpha_kernel(FracExt *data, size_t len, FpExt alpha) {\n816\t    size_t idx = blockIdx.x * blockDim.x + threadIdx.x;\n817\t    if (idx < len) {\n818\t        data[idx].q = data[idx].q + alpha;\n819\t    }\n820\t}\n821\t\n822\ttemplate <typename F, typename EF>\n823\t__global__ void frac_vector_scalar_multiply_kernel(\n824\t    std::pair<EF, EF> *frac_vec,\n825\t    F scalar,\n826\t    uint32_t length\n827\t) {\n828\t    size_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n829\t    if (tidx >= length)\n830\t        return;\n831\t\n832\t    frac_vec[tidx].first *= scalar;\n833\t}\n834\t\n835\t// Fused two-layer tree build kernel.\n836\t// Applies two consecutive frac_add tree layers in one pass, keeping intermediate\n837\t// right-half nodes for later revert operations.\n838\t//\n839\t// For fused layers i and i+1 with half_i = N >> (i+1) and half_i1 = N >> (i+2):\n840\t//   Thread j in [0, half_i1) reads:\n841\t//     A = layer[j],                  B = layer[j + half_i1],\n842\t//     C = layer[j + half_i],         D = layer[j + half_i + half_i1]\n843\t//   Computes:\n844\t//     lhs = frac_add(A, C)            (layer i result at j, kept in register)\n845\t//     rhs = frac_add(B, D)            (layer i result at j + half_i1)\n846\t//     result = frac_add(lhs, rhs)     (layer i+1 result at j)\n847\t//   Writes:\n848\t//     layer[j]         = result        (layer i+1 output)\n849\t//     layer[j+half_i1] = rhs           (layer i intermediate, needed for revert of layer i+1)\n850\t//   C and D remain untouched (already in correct place for revert of layer i).\n851\t//\n852\t// Memory traffic vs two separate frac_build_tree_layer calls:\n853\t//   Non-fused: 4 reads + 2 writes (layer i) + 2 reads + 1 write (layer i+1) = 6R+3W per group\n854\t//   Fused:     4 reads + 2 writes per group\n855\t//   Savings:   2 reads + 1 write = ~33% reduction in global memory traffic.\n856\t__global__ void frac_build_tree_two_layers_kernel(\n857\t    FracExt *__restrict__ layer,\n858\t    uint32_t half_i1   // = N >> (i+2), where i is the first of the two layers\n859\t) {\n860\t    uint32_t j = blockIdx.x * blockDim.x + threadIdx.x;\n861\t    if (j >= half_i1) return;\n862\t\n863\t    uint32_t half_i = half_i1 << 1;   // = N >> (i+1)\n864\t\n865\t    FracExt A = layer[j];\n866\t    FracExt B = layer[j + half_i1];\n867\t    FracExt C = layer[j + half_i];\n868\t    FracExt D = layer[j + half_i + half_i1];\n869\t\n870\t    // Layer i: combine A with C and B with D (kept in registers)\n871\t    FracExt lhs = frac_add(A, C);\n872\t    FracExt rhs = frac_add(B, D);\n873\t    // Layer i+1: combine the two layer-i results\n874\t    FracExt result = frac_add(lhs, rhs);\n875\t\n876\t    layer[j]         = result;\n877\t    layer[j + half_i1] = rhs;   // Needed for revert of layer i+1\n878\t    // layer[j + half_i] = C  (unchanged, needed for revert of layer i)\n879\t    // layer[j + half_i + half_i1] = D  (unchanged, needed for revert of layer i)\n880\t}\n881\t\n882\t// ============================================================================\n883\t// LAUNCHERS\n884\t// ============================================================================\n885\ttemplate <bool revert, bool apply_alpha>\n886\tint launch_frac_build_tree_layer(FracExt *layer, size_t layer_size, FpExt alpha) {\n887\t    auto [grid, block] = kernel_launch_params(layer_size);\n888\t    frac_build_tree_layer_kernel<revert, apply_alpha><<<grid, block>>>(layer, layer_size, alpha);\n889\t    return CHECK_KERNEL();\n890\t}\n891\t\n892\textern \"C\" int _frac_build_tree_layer(\n893\t    FracExt *layer,\n894\t    size_t layer_size,\n895\t    bool revert,\n896\t    FpExt alpha,\n897\t    bool apply_alpha\n898\t) {\n899\t    if (layer_size == 0) {"}]},"parent_tool_use_id":"toolu_01TKSERYzbpr2YE1SjSGbB7V","session_id":"d386d521-3ea3-445a-958b-d64302191775","uuid":"709fc36f-f077-4085-ad1a-2a833a26c650","timestamp":"2026-04-13T14:18:35.047Z"}
