{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0139hEDxDAq6Q4dXeZXdQbXp","type":"tool_result","content":"1\t#include <algorithm>\n2\t#include <cassert>\n3\t#include <cmath>\n4\t#include <cstdint>\n5\t#include <cstdio>\n6\t#include <cstdlib>\n7\t#include <utility>\n8\t#include <vector_types.h>\n9\t\n10\t#include \"codec.cuh\"\n11\t#include \"dag_entry.cuh\"\n12\t#include \"eval_config.cuh\"\n13\t#include \"fp.h\"\n14\t#include \"fpext.h\"\n15\t#include \"launcher.cuh\"\n16\t#include \"sumcheck.cuh\"\n17\t#include \"utils.cuh\"\n18\t\n19\tusing namespace symbolic_dag;\n20\t\n21\tnamespace zerocheck_round0 {\n22\t\n23\tconstexpr uint32_t BUFFER_THRESHOLD = 16;\n24\t// Threshold for switching between coset-parallel and lockstep modes.\n25\t// When num_x * skip_domain < threshold, use coset-parallel (grid.y = num_cosets) for better GPU utilization.\n26\t// When >= threshold, use lockstep (single thread handles all cosets) to avoid redundant iNTT.\n27\tconstexpr uint32_t COSET_PARALLEL_THRESHOLD = 32768; // 2^15\n28\t\n29\t// Device function to compute constraint sums for all cosets in lockstep with DAG traversal.\n30\t// This computes: sum(lambda_i * constraint_i) for all constraints, for each coset.\n31\t// NOTE: Using __inline__ instead of __forceinline__ to let compiler decide based on register pressure.\n32\ttemplate <uint32_t NUM_COSETS, bool NEEDS_SHMEM>\n33\t__device__ __inline__ void acc_constraints(\n34\t    FpExt *__restrict__ constraint_sums, // output [NUM_COSETS]\n35\t    const NttEvalContext<NUM_COSETS> &eval_ctx,\n36\t    const Fp *is_first, // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n37\t    const Fp *is_last,  // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n38\t    uint32_t x_int,\n39\t    const FpExt *__restrict__ d_lambda_pows,\n40\t    const Rule *__restrict__ d_rules,\n41\t    size_t rules_len,\n42\t    const size_t *__restrict__ d_used_nodes,\n43\t    size_t used_nodes_len,\n44\t    size_t lambda_len\n45\t) {\n46\t    size_t lambda_idx = 0;\n47\t\n48\t    // Initialize constraint sums to zero\n49\t#pragma unroll\n50\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n51\t        constraint_sums[c] = FpExt(Fp::zero());\n52\t    }\n53\t\n54\t    for (size_t node = 0; node < rules_len; ++node) {\n55\t        Rule rule = d_rules[node];\n56\t        // Lazy decoding: only decode header (op, flags, x) upfront\n57\t        RuleHeader header = decode_rule_header(rule);\n58\t\n59\t        // Evaluate x operand for all cosets\n60\t        Fp x_vals[NUM_COSETS];\n61\t        ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(x_vals, header.x, eval_ctx, is_first, is_last, x_int);\n62\t\n63\t        switch (header.op) {\n64\t        case OP_ADD: {\n65\t            // Decode y only for binary ops\n66\t            SourceInfo y_src = decode_y(rule);\n67\t            Fp y_vals[NUM_COSETS];\n68\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n69\t#pragma unroll\n70\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n71\t                x_vals[c] += y_vals[c];\n72\t            }\n73\t            break;\n74\t        }\n75\t        case OP_SUB: {\n76\t            SourceInfo y_src = decode_y(rule);\n77\t            Fp y_vals[NUM_COSETS];\n78\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n79\t#pragma unroll\n80\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n81\t                x_vals[c] -= y_vals[c];\n82\t            }\n83\t            break;\n84\t        }\n85\t        case OP_MUL: {\n86\t            SourceInfo y_src = decode_y(rule);\n87\t            Fp y_vals[NUM_COSETS];\n88\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n89\t#pragma unroll\n90\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n91\t                x_vals[c] *= y_vals[c];\n92\t            }\n93\t            break;\n94\t        }\n95\t        case OP_NEG:\n96\t#pragma unroll\n97\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n98\t                x_vals[c] = -x_vals[c];\n99\t            }\n100\t            break;\n101\t        case OP_VAR:\n102\t            break;\n103\t        case OP_INV:\n104\t#pragma unroll\n105\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n106\t                x_vals[c] = inv(x_vals[c]);\n107\t            }\n108\t            break;\n109\t        }\n110\t\n111\t        // Store intermediate results for all cosets\n112\t        // Decode z_index only when buffering\n113\t        if (header.buffer_result && eval_ctx.buffer_size > 0) {\n114\t            uint32_t z_index = decode_z_index(rule);\n115\t#ifdef CUDA_DEBUG\n116\t            assert(z_index < eval_ctx.buffer_size);\n117\t#endif\n118\t            // Intermediate buffer layout: [buffer_size][NUM_COSETS] per thread\n119\t#pragma unroll\n120\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n121\t                eval_ctx.inter_buffer[z_index * eval_ctx.buffer_stride + c] = x_vals[c];\n122\t            }\n123\t        }\n124\t\n125\t        // Accumulate constraint sums\n126\t        if (header.is_constraint) {\n127\t            while (lambda_idx < lambda_len && lambda_idx < used_nodes_len &&\n128\t                   d_used_nodes[lambda_idx] == node) {\n129\t                FpExt lambda = d_lambda_pows[lambda_idx];\n130\t                lambda_idx++;\n131\t#pragma unroll\n132\t                for (uint32_t c = 0; c < NUM_COSETS; c++) {\n133\t                    constraint_sums[c] += lambda * x_vals[c];\n134\t                }\n135\t            }\n136\t        }\n137\t    }\n138\t}\n139\t\n140\t// NTT-based kernel: Each thread handles ALL cosets in lockstep.\n141\t// Grid: (num_x_blocks, 1) - no coset dimension\n142\t// Block: (skip_domain * x_per_block)\n143\t// Thread layout: ntt_idx = threadIdx.x % skip_domain, varies fastest\n144\t//\n145\t// Key optimization: iNTT is done ONCE per trace access, then coefficient is\n146\t// used for all coset shifts + forward NTTs.\n147\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n148\t__global__ void zerocheck_ntt_evaluate_constraints_kernel(\n149\t    FpExt *__restrict__ tmp_sums_buffer,   // [num_blocks][NUM_COSETS][skip_domain]\n150\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n151\t    const Fp *__restrict__ preprocessed,\n152\t    const Fp *const *__restrict__ main_parts,\n153\t    const FpExt *__restrict__ eq_cube, // [num_x]\n154\t    const FpExt *__restrict__ d_lambda_pows,\n155\t    const Fp *__restrict__ public_values,\n156\t    const Rule *__restrict__ d_rules,\n157\t    size_t rules_len,\n158\t    const size_t *__restrict__ d_used_nodes,\n159\t    size_t used_nodes_len,\n160\t    size_t lambda_len,\n161\t    uint32_t buffer_size,\n162\t    Fp *__restrict__ d_intermediates,\n163\t    uint32_t skip_domain,\n164\t    uint32_t num_x,\n165\t    uint32_t height,\n166\t    Fp g_shift\n167\t) {\n168\t    extern __shared__ char smem[];\n169\t    // Shared memory layout:\n170\t    // - FpExt[blockDim.x]: shared_sum for reduction (reused per coset)\n171\t    // - Fp[blockDim.x]: ntt_buffers (one skip_domain-sized buffer per x_int group, only when NEEDS_SHMEM)\n172\t    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem);\n173\t    Fp *ntt_buffers_base =\n174\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FpExt)) : nullptr;\n175\t\n176\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n177\t\n178\t    // Each x_int group within the block gets its own ntt_buffer slice\n179\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n180\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n181\t\n182\t    // Thread layout: ntt_idx varies fastest, then x_int\n183\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n184\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n185\t    uint32_t const x_int_base = tidx >> l_skip;\n186\t\n187\t    // Precompute values needed for all cosets\n188\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n189\t\n190\t    // Compute is_first_mult, is_last_mult for all cosets\n191\t    uint32_t const log_height_total = __ffs(height) - 1;\n192\t    uint32_t const log_segment = min(l_skip, log_height_total);\n193\t    uint32_t const segment_size = 1u << log_segment;\n194\t    uint32_t const log_stride = l_skip - log_segment;\n195\t\n196\t    Fp is_first_mult[NUM_COSETS];\n197\t    Fp is_last_mult[NUM_COSETS];\n198\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n199\t    Fp const omega_skip_ntt =\n200\t        (l_skip == 0) ? Fp::one() : device_ntt::get_twiddle(l_skip, ntt_idx);"}]},"parent_tool_use_id":"toolu_018WjuBWPJKzAavaxdWFDM29","session_id":"d386d521-3ea3-445a-958b-d64302191775","uuid":"4b5753be-89ba-44ab-912d-20da7f795dd8","timestamp":"2026-04-13T14:18:09.673Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G5GszKyAk7kuJTQeAvkjeT","type":"tool_result","content":"150\t\n151\tfn precompute_m_min_blocks_threshold() -> usize {\n152\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_BLOCKS\")\n153\t        .ok()\n154\t        .and_then(|val| val.parse::<usize>().ok())\n155\t        .unwrap_or(PRECOMPUTE_M_DEFAULT_MIN_BLOCKS)\n156\t        .max(1)\n157\t}\n158\t\n159\tfn precompute_m_num_tail_blocks(rem_n: usize, w: usize, tail_tile: usize) -> usize {\n160\t    let tail_n = rem_n - w;\n161\t    (1usize << tail_n).div_ceil(tail_tile)\n162\t}\n163\t\n164\tfn precompute_m_target_blocks() -> usize {\n165\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_TARGET_BLOCKS\")\n166\t        .ok()\n167\t        .and_then(|val| val.parse::<usize>().ok())\n168\t        .unwrap_or(PRECOMPUTE_M_DEFAULT_TARGET_BLOCKS)\n169\t        .max(1)\n170\t}\n171\t\n172\tfn precompute_m_tail_tile_override() -> Option<usize> {\n173\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_TAIL_TILE\")\n174\t        .ok()\n175\t        .and_then(|val| val.parse::<usize>().ok())\n176\t        .map(|v| v.clamp(PRECOMPUTE_M_MIN_TAIL_TILE, PRECOMPUTE_M_TAIL_TILE))\n177\t}\n178\t\n179\tfn precompute_m_min_n() -> usize {\n180\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_N\")\n181\t        .ok()\n182\t        .and_then(|val| val.parse::<usize>().ok())\n183\t        .unwrap_or(GKR_WINDOW_DEFAULT_MIN_N)\n184\t}\n185\t\n186\tfn precompute_m_build_tail_tile(\n187\t    rem_n: usize,\n188\t    w: usize,\n189\t    min_blocks_threshold: usize,\n190\t    target_blocks: usize,\n191\t    tail_tile_override: Option<usize>,\n192\t) -> usize {\n193\t    if let Some(tile) = tail_tile_override {\n194\t        return tile;\n195\t    }\n196\t    let tail_n = rem_n - w;\n197\t    let k = 1usize << tail_n;\n198\t    let target_blocks = target_blocks.max(min_blocks_threshold).max(1);\n199\t    let desired_tile = k.div_ceil(target_blocks).max(1);\n200\t    desired_tile.clamp(PRECOMPUTE_M_MIN_TAIL_TILE, PRECOMPUTE_M_TAIL_TILE)\n201\t}\n202\t\n203\tfn choose_precompute_m_window_w(\n204\t    rem_n: usize,\n205\t    rounds_left: usize,\n206\t    min_blocks_threshold: usize,\n207\t    target_blocks: usize,\n208\t    tail_tile_override: Option<usize>,\n209\t    min_n: usize,\n210\t) -> Option<usize> {\n211\t    if rem_n < min_n || rounds_left < GKR_WINDOW_SIZE {\n212\t        return None;\n213\t    }\n214\t    let w = GKR_WINDOW_SIZE;\n215\t    let tail_tile = precompute_m_build_tail_tile(\n216\t        rem_n,\n217\t        w,\n218\t        min_blocks_threshold,\n219\t        target_blocks,\n220\t        tail_tile_override,\n221\t    );\n222\t    (precompute_m_num_tail_blocks(rem_n, w, tail_tile) >= min_blocks_threshold).then_some(w)\n223\t}\n224\t\n225\tfn choose_round_strategy(\n226\t    round: usize,\n227\t    precompute_m_env: bool,\n228\t    precompute_m_min_blocks_threshold: usize,\n229\t    precompute_m_target_blocks: usize,\n230\t    precompute_m_tail_tile_override: Option<usize>,\n231\t    precompute_m_min_n: usize,\n232\t) -> GkrRoundStrategy {\n233\t    if !precompute_m_env {\n234\t        return GkrRoundStrategy::FoldEval;\n235\t    }\n236\t    let start_base = 1usize;\n237\t    let stop = round.div_ceil(2);\n238\t    let rem_n = round - start_base;\n239\t    let rounds_left = stop - start_base;\n240\t    if choose_precompute_m_window_w(\n241\t        rem_n,\n242\t        rounds_left,\n243\t        precompute_m_min_blocks_threshold,\n244\t        precompute_m_target_blocks,\n245\t        precompute_m_tail_tile_override,\n246\t        precompute_m_min_n,\n247\t    )\n248\t    .is_none()\n249\t    {\n250\t        return GkrRoundStrategy::FoldEval;\n251\t    }\n252\t\n253\t    GkrRoundStrategy::PrecomputeM\n254\t}\n255\t\n256\tfn eval_mle_table(points: &[EF], out: &mut [EF]) {\n257\t    // w <= 5 so CPU builds are trivial; avoid GPU kernel/alloc overhead for tiny tables.\n258\t    let n = points.len();\n259\t    let size = 1usize << n;\n260\t    debug_assert!(out.len() >= size);\n261\t    for (bits, dst) in out.iter_mut().enumerate().take(size) {\n262\t        let mut acc = EF::ONE;\n263\t        for (i, &x) in points.iter().enumerate() {\n264\t            let bit = ((bits >> (n - 1 - i)) & 1) == 1;\n265\t            acc *= if bit { x } else { EF::ONE - x };\n266\t        }\n267\t        *dst = acc;\n268\t    }\n269\t}\n270\t\n271\t/// Get low/high eq pointers for the tail portion of the eq buffer, skipping `drop_count` layers.\n272\t/// See `docs/cuda-backend/gkr-prover.md` § \"Eq buffer sqrt decomposition\".\n273\tfn eq_tail_ptrs(\n274\t    eq_buffer: &SqrtEqLayers,\n275\t    drop_count: usize,\n276\t) -> (*const EF, *const EF, usize, usize) {\n277\t    let mut high_n = eq_buffer.high_n();\n278\t    let mut low_n = eq_buffer.low_n();\n279\t    let total_n = high_n + low_n;\n280\t    if drop_count >= total_n {\n281\t        return (std::ptr::null(), std::ptr::null(), 1, 0);\n282\t    }\n283\t    if drop_count <= high_n {\n284\t        high_n -= drop_count;\n285\t    } else {\n286\t        low_n -= drop_count - high_n;\n287\t        high_n = 0;\n288\t    }\n289\t    let tail_n = low_n + high_n;\n290\t    if tail_n == 0 {\n291\t        (std::ptr::null(), std::ptr::null(), 1, 0)\n292\t    } else {\n293\t        (\n294\t            eq_buffer.low.get_ptr(low_n),\n295\t            eq_buffer.high.get_ptr(high_n),\n296\t            1 << low_n,\n297\t            tail_n,\n298\t        )\n299\t    }\n300\t}\n301\t\n302\tfn copy_to_device_ptr<T: Copy>(dst: *mut T, src: &[T]) -> Result<(), FractionalSumcheckError> {\n303\t    if src.is_empty() {\n304\t        return Ok(());\n305\t    }\n306\t    unsafe {\n307\t        cuda_memcpy::<false, true>(\n308\t            dst as *mut c_void,\n309\t            src.as_ptr() as *const c_void,\n310\t            std::mem::size_of_val(src),\n311\t        )?;\n312\t    }\n313\t    Ok(())\n314\t}\n315\t\n316\t/// Observes s_evals in transcript, updates accumulators, and returns the sampled challenge.\n317\t#[allow(clippy::too_many_arguments)]\n318\tfn observe_and_update<SC, TS>(\n319\t    d_sum_evals: &DeviceBuffer<EF>,\n320\t    transcript: &mut TS,\n321\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n322\t    r_vec: &mut Vec<EF>,\n323\t    prev_s_eval: &mut EF,\n324\t    xi_j: EF,\n325\t    eq_r_acc: &mut EF,\n326\t) -> Result<EF, FractionalSumcheckError>\n327\twhere\n328\t    SC: StarkProtocolConfig<EF = EF>,\n329\t    TS: FiatShamirTranscript<SC>,\n330\t{\n331\t    let (s_evals, sp_evals) = reconstruct_s_evals(d_sum_evals, *prev_s_eval, xi_j, *eq_r_acc)?;\n332\t\n333\t    for &eval in &s_evals {\n334\t        transcript.observe_ext(eval);\n335\t    }\n336\t    round_polys_eval.push(s_evals);\n337\t\n338\t    let r = transcript.sample_ext();\n339\t    r_vec.push(r);\n340\t\n341\t    let eq_r = eval_eq_mle(&[xi_j], &[r]);\n342\t    *eq_r_acc *= eq_r;\n343\t    *prev_s_eval = eq_r * interpolate_quadratic_at_012(&sp_evals, r);\n344\t\n345\t    Ok(r)\n346\t}\n347\t\n348\t/// Fused revert + compute round: reverts the tree layer and computes s'_0(1) and s'_0(2).\n349\t///\n350\t/// See `docs/cuda-backend/gkr-prover.md` § \"Sumcheck round strategies\" for context.\n351\t#[allow(clippy::too_many_arguments)]\n352\tfn do_sumcheck_round_and_revert<SC, TS>(\n353\t    eq_buffer: &mut SqrtEqLayers,\n354\t    layer: &mut DeviceBuffer<Frac<EF>>,\n355\t    pq_size: usize,\n356\t    lambda: EF,\n357\t    transcript: &mut TS,\n358\t    d_sum_evals: &mut DeviceBuffer<EF>,\n359\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n360\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n361\t    r_vec: &mut Vec<EF>,\n362\t    prev_s_eval: &mut EF,\n363\t    xi_j: EF,\n364\t    eq_r_acc: &mut EF,\n365\t) -> Result<EF, FractionalSumcheckError>\n366\twhere\n367\t    SC: StarkProtocolConfig<EF = EF>,\n368\t    TS: FiatShamirTranscript<SC>,\n369\t{\n370\t    unsafe {\n371\t        frac_compute_round_and_revert(\n372\t            eq_buffer,\n373\t            layer,\n374\t            pq_size / 2,\n375\t            lambda,\n376\t            d_sum_evals,\n377\t            tmp_block_sums,\n378\t        )\n379\t        .map_err(FractionalSumcheckError::ComputeRound)?;\n380\t    }\n381\t    eq_buffer.drop_layer();\n382\t    observe_and_update(\n383\t        d_sum_evals,\n384\t        transcript,\n385\t        round_polys_eval,\n386\t        r_vec,\n387\t        prev_s_eval,\n388\t        xi_j,\n389\t        eq_r_acc,\n390\t    )\n391\t}\n392\t\n393\t/// Fused compute round: computes s' polynomial AND folds the pq_buffer for next round.\n394\t///\n395\t/// This kernel fuses the fold operation (using `r_prev` from the previous round) into the current\n396\t/// round's compute, eliminating one kernel launch and reducing memory traffic.\n397\t#[allow(clippy::too_many_arguments)]\n398\tfn do_fused_sumcheck_round<SC, TS>(\n399\t    eq_buffer: &mut SqrtEqLayers,"}]},"parent_tool_use_id":"toolu_01TKSERYzbpr2YE1SjSGbB7V","session_id":"d386d521-3ea3-445a-958b-d64302191775","uuid":"d7408d32-75ae-4bf8-bf20-3da6d37de89b","timestamp":"2026-04-13T14:18:09.689Z"}
