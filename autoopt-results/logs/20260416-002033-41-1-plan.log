{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018eX4Ln7Ha3g8knNvtGZcpJ","type":"tool_result","content":"1\tuse std::{array::from_fn, cmp::max, ffi::c_void, iter::zip, mem, sync::Arc};\n2\t\n3\tuse itertools::{zip_eq, Itertools};\n4\tuse openvm_cuda_common::{\n5\t    copy::{cuda_memcpy, MemCopyD2H, MemCopyH2D},\n6\t    d_buffer::DeviceBuffer,\n7\t    memory_manager::MemTracker,\n8\t};\n9\tuse openvm_stark_backend::{\n10\t    dft::Radix2BowersSerial,\n11\t    p3_matrix::dense::RowMajorMatrix,\n12\t    poly_common::{\n13\t        eq_uni_poly, eval_eq_mle, eval_eq_uni, eval_eq_uni_at_one, eval_in_uni, Squarable,\n14\t        UnivariatePoly,\n15\t    },\n16\t    proof::StackingProof,\n17\t    prover::{\n18\t        stacked_pcs::StackedLayout, sumcheck::sumcheck_round0_deg, DeviceMultiStarkProvingKey,\n19\t        MatrixDimensions, ProvingContext,\n20\t    },\n21\t};\n22\tuse p3_dft::TwoAdicSubgroupDft;\n23\tuse p3_field::{PrimeCharacteristicRing, TwoAdicField};\n24\tuse tracing::{debug, info_span, instrument};\n25\t\n26\tuse crate::{\n27\t    base::DeviceMatrix,\n28\t    cuda::{\n29\t        batch_ntt_small::ensure_device_ntt_twiddles_initialized,\n30\t        poly::vector_scalar_multiply_ext,\n31\t        stacked_reduction::{\n32\t            _stacked_reduction_r0_required_temp_buffer_size,\n33\t            batched_stacked_reduction_sumcheck_mle_round,\n34\t            batched_stacked_reduction_sumcheck_mle_round_degenerate,\n35\t            compute_mle_launch_params, initialize_k_rot_from_eq_segments,\n36\t            stacked_reduction_fold_ple, stacked_reduction_sumcheck_round0, DegenMleDesc,\n37\t            NonDegenMleDesc, NUM_G,\n38\t        },\n39\t        sumcheck::{fold_mle, triangular_fold_mle},\n40\t    },\n41\t    gpu_backend::GenericGpuBackend,\n42\t    hash_scheme::GpuHashScheme,\n43\t    poly::EqEvalSegments,\n44\t    prelude::{Digest, D_EF, EF, F},\n45\t    sponge::GpuFiatShamirTranscript,\n46\t    stacked_pcs::StackedPcsDataGpu,\n47\t    utils::{compute_barycentric_inv_lagrange_denoms, reduce_raw_u64_to_ef},\n48\t    GpuDevice, StackedReductionError,\n49\t};\n50\t\n51\t/// Degree of the sumcheck polynomial for stacked reduction.\n52\tpub const STACKED_REDUCTION_S_DEG: usize = 2;\n53\t\n54\tpub struct StackedReductionGpu<D = Digest> {\n55\t    sm_count: u32,\n56\t\n57\t    l_skip: usize,\n58\t    n_stack: usize,\n59\t\n60\t    omega_skip: F,\n61\t    omega_skip_pows: Vec<F>,\n62\t    d_omega_skip_pows: DeviceBuffer<F>,\n63\t\n64\t    r_0: EF,\n65\t    d_lambda_pows: DeviceBuffer<EF>,\n66\t    eq_const: EF,\n67\t\n68\t    pub(crate) stacked_per_commit: Vec<StackedPcsData2<D>>,\n69\t    d_q_widths: DeviceBuffer<u32>,\n70\t    q_width_max: u32,\n71\t    d_q_eval_ptrs: DeviceBuffer<*const EF>,\n72\t\n73\t    trace_ptrs: Vec<(\n74\t        *const F, /* trace_ptr */\n75\t        usize,    /* height */\n76\t        usize,    /* width */\n77\t    )>,\n78\t    unstacked_cols: Vec<UnstackedSlice>,\n79\t    d_unstacked_cols: DeviceBuffer<UnstackedSlice>,\n80\t    // boundary indices where heights change. all columns between two boundaries must have the same\n81\t    // height. We can have multiple chunks of the same height if that is needed to reduce peak GPU\n82\t    // memory.\n83\t    ht_diff_idxs: Vec<usize>,\n84\t    n_max: usize,\n85\t\n86\t    // Initially holds eq(r[1..=n], H_n) for n=0..=n_max but gets updated after each sumcheck round\n87\t    // by some custom folding\n88\t    eq_r_ns: EqEvalSegments<EF>,\n89\t\n90\t    // == After round 0 ==\n91\t    q_evals: Vec<DeviceBuffer<EF>>, // get width from stacked_per_commit\n92\t    // Stores folded eq values that won't change anymore (no more folding)\n93\t    // Corresponds to log_height in 0..l_skip+round-1 _before_ round `round`. Gets updated with one\n94\t    // new element after each round.\n95\t    eq_stable: Vec<EF>,\n96\t    k_rot_stable: Vec<EF>,\n97\t\n98\t    /// Stores the folded k_rot evaluations for `\\kappa_\\rot(x, r) = eq_n(rot^{-1}(x), r)` for each\n99\t    /// `n` after each round. We use the [EqEvalSegments] type to guard the segment-based\n100\t    /// memory layout.\n101\t    k_rot_ns: EqEvalSegments<EF>,\n102\t    /// Stores eq(u[1+n_T..round-1], b_{T,j}[..round-n_T-1])\n103\t    eq_ub_per_trace: Vec<EF>,\n104\t    d_eq_ub_all: DeviceBuffer<EF>,\n105\t\n106\t    d_block_sums: DeviceBuffer<EF>,\n107\t    d_accum: DeviceBuffer<u64>,\n108\t    d_input_ptrs: DeviceBuffer<*const EF>,\n109\t    d_output_ptrs: DeviceBuffer<*mut EF>,\n110\t\n111\t    mem: MemTracker,\n112\t}\n113\t\n114\t/// A struct for holding stacked pcs data. We only need the `MerkleTreeGpu` from `StackedPcsDataGpu`\n115\t/// but we wrap the latter in an `Arc` to provide uniformity in dealing with common main and\n116\t/// preprocessed/cached traces. This struct stores the unstacked `traces`, in prismalinear\n117\t/// evaluation form, corresponding to the stacked pcs data.\n118\t///\n119\t/// Generic over the Merkle digest type `D`.  The default `D = Digest` preserves the existing\n120\t/// BabyBear-Poseidon2 behaviour.\n121\tpub struct StackedPcsData2<D = Digest> {\n122\t    pub(crate) inner: Arc<StackedPcsDataGpu<F, D>>,\n123\t    /// The unstacked traces corresponding to `inner`'s commitment.\n124\t    pub(crate) traces: Vec<DeviceMatrix<F>>,\n125\t}\n126\t\n127\timpl<D> StackedPcsData2<D> {\n128\t    /// # Safety\n129\t    /// `traces` must be the traces that were committed to in `pcs_data`.\n130\t    pub unsafe fn from_raw(\n131\t        pcs_data: Arc<StackedPcsDataGpu<F, D>>,\n132\t        traces: Vec<DeviceMatrix<F>>,\n133\t    ) -> Self {\n134\t        Self {\n135\t            inner: pcs_data,\n136\t            traces,\n137\t        }\n138\t    }\n139\t\n140\t    pub fn layout(&self) -> &StackedLayout {\n141\t        &self.inner.layout\n142\t    }\n143\t}\n144\t\n145\t/// Pointer with length to location in a big device buffer. The device buffer is identified by\n146\t/// `commit_idx`. Due to pecuarlities with `l_skip`, the length of the slice is defined as\n147\t/// `max(2^log_height, 2^l_skip)`. In other words, this is a pointer to the slice\n148\t/// `q[commit_idx].column(stacked_col_idx)[stacked_row_idx..stacked_row_idx + len]`.\n149\t///\n150\t/// # Safety"}]},"parent_tool_use_id":"toolu_01Q3N3Uijebzf1H5jhsp2AEY","session_id":"8773bab9-c899-4b31-8324-e4269b1a66cf","uuid":"015c8751-ed21-48f9-999c-ecb3582f3eb2","timestamp":"2026-04-15T22:28:24.129Z"}
