{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K5EPe2NYHrZFsxMmKW4zEZ","type":"tool_result","content":"400\t\n401\t// ---------------------------------------------------------------------------\n402\t// Extern \"C\" launchers\n403\t// ---------------------------------------------------------------------------\n404\t\n405\t/// Upload BN254 Poseidon2 round constants (in Montgomery form) to device constant memory.\n406\t///\n407\t/// @param initial_rc   Flat array of 4*3*4 = 48 uint64s  (initial external rounds)\n408\t/// @param partial_rc   Flat array of 56*4 = 224 uint64s  (internal/partial rounds)\n409\t/// @param terminal_rc  Flat array of 4*3*4 = 48 uint64s  (terminal external rounds)\n410\textern \"C\" int _init_bn254_poseidon2_rc(\n411\t    const uint64_t* initial_rc,\n412\t    const uint64_t* partial_rc,\n413\t    const uint64_t* terminal_rc\n414\t) {\n415\t    cudaError_t err;\n416\t    err = cudaMemcpyToSymbol(g_initial_rc,  initial_rc,  4 * 3 * 4 * sizeof(uint64_t));\n417\t    if (err != cudaSuccess) return (int)err;\n418\t    err = cudaMemcpyToSymbol(g_partial_rc,  partial_rc,  56  * 4 * sizeof(uint64_t));\n419\t    if (err != cudaSuccess) return (int)err;\n420\t    err = cudaMemcpyToSymbol(g_terminal_rc, terminal_rc, 4 * 3 * 4 * sizeof(uint64_t));\n421\t    if (err != cudaSuccess) return (int)err;\n422\t    return (int)cudaSuccess;\n423\t}\n424\t\n425\textern \"C\" int _bn254_poseidon2_compressing_row_hashes(\n426\t    bn254_digest_t* out,\n427\t    const Fp*       matrix,\n428\t    size_t          width,\n429\t    size_t          query_stride,\n430\t    size_t          log_rows_per_query\n431\t) {\n432\t    auto [grid, block] = kernel_launch_params(query_stride, 512 >> log_rows_per_query);\n433\t    block.y = 1 << log_rows_per_query;\n434\t    size_t shared_stride = block.x * div_ceil(block.y, 2);\n435\t    size_t shmem_bytes   = shared_stride * sizeof(Bn254Fr);\n436\t    auto   height        = query_stride << log_rows_per_query;\n437\t\n438\t    bn254_compressing_row_hashes_kernel<<<grid, block, shmem_bytes>>>(\n439\t        out, matrix, width, height, query_stride, log_rows_per_query\n440\t    );\n441\t    return CHECK_KERNEL();\n442\t}\n443\t\n444\textern \"C\" int _bn254_poseidon2_compressing_row_hashes_ext(\n445\t    bn254_digest_t* out,\n446\t    const FpExt*    matrix,\n447\t    size_t          width,\n448\t    size_t          query_stride,\n449\t    size_t          log_rows_per_query\n450\t) {\n451\t    auto [grid, block] = kernel_launch_params(query_stride, 512 >> log_rows_per_query);\n452\t    block.y = 1 << log_rows_per_query;\n453\t    size_t shared_stride = block.x * div_ceil(block.y, 2);\n454\t    size_t shmem_bytes   = shared_stride * sizeof(Bn254Fr);\n455\t    auto   height        = query_stride << log_rows_per_query;\n456\t\n457\t    bn254_compressing_row_hashes_ext_kernel<<<grid, block, shmem_bytes>>>(\n458\t        out, matrix, width, height, query_stride, log_rows_per_query\n459\t    );\n460\t    return CHECK_KERNEL();\n461\t}\n462\t\n463\textern \"C\" int _bn254_poseidon2_adjacent_compress_layer(\n464\t    bn254_digest_t*       output,\n465\t    const bn254_digest_t* prev_layer,\n466\t    size_t                output_size\n467\t) {\n468\t    auto [grid, block] = kernel_launch_params(output_size);\n469\t    bn254_adjacent_compress_layer_kernel<<<grid, block>>>(output, prev_layer, output_size);\n470\t    return CHECK_KERNEL();\n471\t}\n472\t\n473\textern \"C\" int _bn254_sponge_grind(\n474\t    const DeviceBn254SpongeState* init_state,\n475\t    uint32_t bits,\n476\t    uint32_t min_witness,\n477\t    uint32_t max_witness,\n478\t    uint32_t* result\n479\t) {\n480\t    const size_t block_size = BN254_GRIND_BLOCK_SIZE;\n481\t    size_t total_threads = size_t{1} << bits;\n482\t    size_t grid_size = div_ceil(total_threads, block_size);\n483\t\n484\t    bn254_grind_kernel<<<grid_size, block_size>>>(init_state, bits, min_witness, max_witness, result);\n485\t\n486\t    cudaE