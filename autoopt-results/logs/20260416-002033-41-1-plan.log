   })\n229\t            .collect::<Result<Vec<_>, MerkleTreeError>>()\n230\t    }\n231\t}\n232\t\n233\timpl MerkleTreeConstructor for Poseidon2MerkleHash {\n234\t    fn new_merkle_tree(\n235\t        matrix: DeviceMatrix<F>,\n236\t        rows_per_query: usize,\n237\t        cache_backing_matrix: bool,\n238\t    ) -> Result<MerkleTreeGpu<F, Self::Digest>, MerkleTreeError> {\n239\t        MerkleTreeGpu::<F, Self::Digest>::new_generic_with_hash::<Self>(\n240\t            matrix,\n241\t            rows_per_query,\n242\t            cache_backing_matrix,\n243\t        )\n244\t    }\n245\t}\n246\t\n247\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n248\timpl MerkleTreeConstructor for crate::hash_scheme::Bn254Poseidon2MerkleHash {\n249\t    fn new_merkle_tree(\n250\t        matrix: DeviceMatrix<F>,\n251\t        rows_per_query: usize,\n252\t        cache_backing_matrix: bool,\n253\t    ) -> Result<MerkleTreeGpu<F, Self::Digest>, MerkleTreeError> {\n254\t        MerkleTreeGpu::<F, Self::Digest>::new_generic_with_hash::<Self>(\n255\t            matrix,\n256\t            rows_per_query,\n257\t            cache_backing_matrix,\n258\t        )\n259\t    }\n260\t}\n261\t\n262\t// Base field merkle tree — Poseidon2 default constructor\n263\timpl MerkleTreeGpu<F, Digest> {\n264\t    /// Build a Merkle tree using the default Poseidon2 hash.\n265\t    ///\n266\t    /// Equivalent to `new_with_hash::<Poseidon2MerkleHash>(...)`.\n267\t    pub fn new(\n268\t        matrix: DeviceMatrix<F>,\n269\t        rows_per_query: usize,\n270\t        cache_backing_matrix: bool,\n271\t    ) -> Result<Self, MerkleTreeError> {\n272\t        Self::new_with_hash::<Poseidon2MerkleHash>(matrix, rows_per_query, cache_backing_matrix)\n273\t    }\n274\t}\n275\t\n276\t// Base field merkle tree — generic batch query (works for any BatchQueryMerkle digest)\n277\timpl<D: BatchQueryMerkle + Send + Sync + 'static> MerkleTreeGpu<F, D> {\n278\t    fn batch_query_proofs(\n279\t        trees: &[&Self],\n280\t    