68\t        d_g_pos: DeviceBuffer<EF>,\n569\t        d_g_neg: Vec<DeviceBuffer<EF>>,\n570\t        s_0_deg: usize,\n571\t    ) -> Result<UnivariatePoly<EF>, StackedReductionError> {\n572\t        let l_skip = self.l_skip;\n573\t        let skip_domain = 1 << l_skip;\n574\t        let large_uni_domain = (s_0_deg + 1).next_power_of_two(); // 2 * skip_domain\n575\t        let dft = Radix2BowersSerial;\n576\t\n577\t        // Accumulate s_0 coefficients across all buckets\n578\t        let mut s_0_coeffs = vec![EF::ZERO; large_uni_domain];\n579\t\n580\t        // --- Process n >= 0 bucket ---\n581\t        let g_pos = d_g_pos.to_host()?;\n582\t        if !g_pos.iter().all(|&x| x == EF::ZERO) {\n583\t            // Build E polynomials for n >= 0\n584\t            let e0 = eq_uni_poly::<F, EF>(l_skip, self.r_0);\n585\t            let e1 = eq_uni_poly::<F, EF>(l_skip, self.r_0 * self.omega_skip);\n586\t            let e2 = eq_uni_at_one_poly(l_skip, self.eq_const);\n587\t\n588\t            // NTT-based multiplication: s_0 += E0*G0 + E1*G1 + E2*G2\n589\t            Self::ntt_multiply_and_add(\n590\t                &dft,\n591\t                large_uni_domain,\n592\t                [e0.coeffs(), e1.coeffs(), e2.coeffs()],\n593\t                [\n594\t                    &g_pos[0..skip_domain],\n595\t                    &g_pos[skip_domain..2 * skip_domain],\n596\t                    &g_pos[2 * skip_domain..3 * skip_domain],\n597\t                ],\n598\t                &mut s_0_coeffs,\n599\t            );\n600\t        }\n601\t\n602\t        // --- Process n < 0 buckets ---\n603\t        for (bucket_idx, d_g_neg_bucket) in d_g_neg.into_iter().enumerate() {\n604\t            let n_abs = bucket_idx + 1;\n605\t            let g_neg = d_g_neg_bucket.to_host()?;\n606\t            if g_neg.iter().all(|&x| x == EF::ZERO) {\n607\t                continue;\n608\t            }\n609\t\n610\t            // Adjusted parameters for n < 0\n611\t            let l = l_skip - n_abs;\n612\t            let omega_l = self.omega_skip.exp_power_of_2(n_abs);\n613\t            let r_uni = self.r_0.exp_power_of_2(n_abs);\n614\t\n615\t            // Build E polynomials with indicator factor\n616\t            let ind = build_indicator_poly(l_skip, -(n_abs as isize));\n617\t            let e0_base = eq_uni_poly::<F, EF>(l, r_uni);\n618\t            let e1_base = eq_uni_poly::<F, EF>(l, r_uni * omega_l);\n619\t            let e2_base = eq_uni_at_one_poly(l, self.eq_const);\n620\t\n621\t            // E_neg = E_base * ind (polynomial multiplication)\n622\t            let e0_neg = poly_multiply_ntt(&dft, e0_base.coeffs(), ind.coeffs(), skip_domain);\n623\t            let e1_neg = poly_multiply_ntt(&dft, e1_base.coeffs(), ind.coeffs(), skip_domain);\n624\t            let e2_neg = poly_multiply_ntt(&dft, e2_base.coeffs(), ind.coeffs(), skip_domain);\n625\t\n626\t            Self::ntt_multiply_and_add(\n627\t                &dft,\n628\t                large_uni_domain,\n629\t                [&e0_neg, &e1_neg, &e2_neg],\n630\t                [\n631\t                    &g_neg[0..skip_domain],\n632\t                    &g_neg[skip_domain..2 * skip_domain],\n633\t                    &g_neg[2 * skip_domain..3 * skip_domain],\n634\t                ],\n635\t                &mut s_0_coeffs,\n636\t            );\n637\t        }\n638\t\n639\t        s_0_coeffs.truncate(s_0_deg + 1);\n640\t        Ok(UnivariatePoly::new(s_0_coeffs))\n641\t    }\n642\t\n643\t    /// NTT-based polynomial multiplication following logup pattern.\n644\t    /// Computes: out += sum_i E[i] * G[i]\n645\t    fn ntt_multiply_and_add(\n646\t        dft: &Radix2BowersSerial,\n647\t        domain_size: usize,\n648\t        e_coeffs: [&[EF]; 3],\n649\t        g_evals: [&[EF]; 3], // G evaluations on identity coset\n650\t        out: &mut [EF],\n651\t    ) {\n652\t        // 1. iDFT G evaluations to get G coefficients\n653\t        let g_coeffs: [Vec<EF>; 3] = std::array::from_fn(|i| dft.idft(g_evals[i].to_ve