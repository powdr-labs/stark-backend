{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GdajbKtYbvTNZ9m34ZzKxB","type":"tool_result","content":"1\t/// BN254 Poseidon2 CUDA kernels.\n2\t///\n3\t/// All BN254 code lives in this single translation unit to avoid device-side\n4\t/// linkage issues with `static __device__` variables.\n5\t///\n6\t/// Entry points (called from Rust via FFI):\n7\t///   _init_bn254_poseidon2_rc         - Upload round constants from Rust\n8\t///   _bn254_poseidon2_compressing_row_hashes     - Merkle leaf hashes (F matrix)\n9\t///   _bn254_poseidon2_compressing_row_hashes_ext - Merkle leaf hashes (EF matrix)\n10\t///   _bn254_poseidon2_adjacent_compress_layer    - Merkle internal compress\n11\t///   _bn254_sponge_grind              - PoW grinding for BN254 transcript\n12\t\n13\t#include \"poseidon2_bn254.cuh\"\n14\t#include \"fp.h\"\n15\t#include \"fpext.h\"\n16\t#include \"launcher.cuh\"\n17\t#include <cstdint>\n18\t\n19\t// ---------------------------------------------------------------------------\n20\t// Round constant device memory (filled by _init_bn254_poseidon2_rc)\n21\t// ---------------------------------------------------------------------------\n22\t\n23\t/// External initial round constants: 4 rounds × 3 elements\n24\t__device__ __constant__ Bn254Fr g_initial_rc[4][3];\n25\t\n26\t/// Internal (partial) round constants: 56 rounds × 1 element (for state[0] only)\n27\t__device__ __constant__ Bn254Fr g_partial_rc[56];\n28\t\n29\t/// External terminal round constants: 4 rounds × 3 elements\n30\t__device__ __constant__ Bn254Fr g_terminal_rc[4][3];\n31\t\n32\t// ---------------------------------------------------------------------------\n33\t// BN254 Poseidon2 permutation (WIDTH=3, 4 + 56 + 4 rounds)\n34\t//\n35\t// Matches p3-bn254's Poseidon2Bn254<3> permutation exactly:\n36\t//   external_initial_permute_state:  MDS first, then 4×(add_RC + sbox_all + MDS)\n37\t//   internal_permute_state:          56×(add_RC[0] + sbox[0] + matmul_internal)\n38\t//   external_terminal_permute_state: 4×(add_RC + sbox_all + MDS)\n39\t// ---------------------------------------------------------------------------\n40\t\n41\tstatic __device__ __forceinline__\n42\tvoid bn254_poseidon2_permute(Bn254Fr state[3]) {\n43\t    // --- Initial external layer ---\n44\t    bn254_mds_external(state); // MDS without round constants\n45\t    for (int r = 0; r < 4; r++) {\n46\t        for (int i = 0; i < 3; i++) {\n47\t            state[i] = bn254_add(state[i], g_initial_rc[r][i]);\n48\t            state[i] = bn254_sbox(state[i]);\n49\t        }\n50\t        bn254_mds_external(state);\n51\t    }\n52\t\n53\t    // --- Internal (partial) layer ---\n54\t    for (int r = 0; r < 56; r++) {\n55\t        state[0] = bn254_add(state[0], g_partial_rc[r]);\n56\t        state[0] = bn254_sbox(state[0]);\n57\t        bn254_mds_internal(state);\n58\t    }\n59\t\n60\t    // --- Terminal external layer ---\n61\t    for (int r = 0; r < 4; r++) {\n62\t        for (int i = 0; i < 3; i++) {\n63\t            state[i] = bn254_add(state[i], g_terminal_rc[r][i]);\n64\t            state[i] = bn254_sbox(state[i]);\n65\t        }\n66\t        bn254_mds_external(state);\n67\t    }\n68\t}\n69\t\n70\t// ---------------------------------------------------------------------------\n71\t// BN254 Merkle digest: a single Bn254Fr element (32 bytes)\n72\t// Matches Digest = [Bn254Scalar; 1] on the Rust side.\n73\t// ---------------------------------------------------------------------------\n74\t\n75\tstruct bn254_digest_t {\n76\t    Bn254Fr elem;\n77\t};\n78\t\n79\t// ---------------------------------------------------------------------------\n80\t// Helper: zero-initialize a Bn254Fr\n81\t// ---------------------------------------------------------------------------\n82\t\n83\tstatic __device__ __forceinline__\n84\tBn254Fr bn254_zero_init() {\n85\t    Bn254Fr z;\n86\t    for (int i = 0; i < 4; i++) z.limbs[i] = 0;\n87\t    return z;\n88\t}\n89\t\n90\t// ---------------------------------------------------------------------------\n91\t// Sponge constants for Merkle hashing\n92\t//\n93\t// Matches MultiField32PaddingFreeSponge<BabyBear, Bn254Scalar, Perm, 3, 16, 1>:\n94\t//   BABY_BEAR_RATE = 16  BabyBear values absorbed per permutation\n95\t//   NUM_F_ELMS = 8       BabyBear values packed per Bn254Fr (floor(254/31) = 8)\n96\t// ---------------------------------------------------------------------------\n97\t\n98\tstatic const int BN254_BABY_BEAR_RATE = 16;\n99\tstatic const int BN254_NUM_F_ELMS    = 8;\n100\t"}]},"parent_tool_use_id":"toolu_01LzC35AorKhPdNH2XgR9uBr","session_id":"8773bab9-c899-4b31-8324-e4269b1a66cf","uuid":"6d87a6b8-8eb9-4b27-b304-c49067274b97","timestamp":"2026-04-15T22:36:28.585Z"}
