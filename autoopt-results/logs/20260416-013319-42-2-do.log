              true,\n50\t            )?;\n51\t        }\n52\t    }\n53\t    let folded = DeviceMatrix::new(Arc::new(folded_buf), num_x, out_width);\n54\t    Ok(folded)\n55\t}\n56\t\n57\t/// Folds PLE evaluations by interpolating univariate polynomials on coset D and evaluating at r_0.\n58\t/// Returns a single matrix of width `width`.\n59\t///\n60\t/// When `rotate` is true, returns the folding of the lift of the rotated matrix.\n61\t/// When `rotate` is false, returns the folding of the lift of the original matrix.\n62\t///\n63\t/// # Assumptions\n64\t/// - `mat` should be the unlifted original matrix of trace evaluations.\n65\t/// - `output` should be a valid pointer to a buffer of size at least `num_x * width` where `num_x =\n66\t///   max(height / 2^l_skip, 1)`.\n67\tpub unsafe fn fold_ple_evals_gpu(\n68\t    l_skip: usize,\n69\t    d_omega_skip_pows: &DeviceBuffer<F>,\n70\t    mat: &DeviceMatrix<F>,\n71\t    output: *mut EF,\n72\t    d_inv_lagrange_denoms_r0: &DeviceBuffer<EF>,\n73\t    rotate: bool,\n74\t) -> Result<(), FoldPleError> {\n75\t    let height = mat.height();\n76\t    let width = mat.width();\n77\t\n78\t    if height == 0 || width == 0 {\n79\t        return Ok(());\n80\t    }\n81\t\n82\t    let skip_domain = d_omega_skip_pows.len();\n83\t    debug_assert_eq!(skip_domain, 1 << l_skip);\n84\t    let lifted_height = max(skip_domain, height);\n85\t    let num_x = lifted_height / skip_domain;\n86\t\n87\t    // Launch kernel\n88\t    unsafe {\n89\t        fold_ple_from_evals(\n90\t            mat.buffer(),\n91\t            output,\n92\t            d_omega_skip_pows,\n93\t            d_inv_lagrange_denoms_r0,\n94\t            height as u32,\n95\t            width as u32,\n96\t            l_skip as u32,\n97\t            num_x as u32,\n98\t            rotate,\n99\t        )?;\n100\t    }\n101\t    Ok(())\n102\t}\n103\t"}]},"parent_tool_use_id":null,"session_id":"ad7abbbb-1391-43dc-94f8-6f027601bba7","uuid":"9036285b-3190-4a8c-8627-d87f57e674c9","timestamp":