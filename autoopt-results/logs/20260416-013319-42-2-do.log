{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015Zy6MgYcYxtBjWxtvGfCD6","type":"tool_result","content":"1\t#include \"fp.h\"\n2\t#include \"fpext.h\"\n3\t#include \"launcher.cuh\"\n4\t#include \"sumcheck.cuh\"\n5\t#include <algorithm>\n6\t#include <cassert>\n7\t#include <cstddef>\n8\t#include <cstdint>\n9\t#include <utility>\n10\t\n11\tnamespace {\n12\t\n13\t// ============================================================================\n14\t// KERNELS\n15\t// ============================================================================\n16\t\n17\t// Folds PLE evaluations by interpolating univariate polynomials on coset D and evaluating at r_0\n18\t// Input: column-major matrix [height * width] of evaluations\n19\t// Output: column-major matrix [new_height * width] of folded evaluations (original OR rotated)\n20\t// For each (x, col), collects 2^l_skip evaluations on coset D and interpolates\n21\t// Parallelizes barycentric interpolation: each chunk of skip_domain threads handles one output cell\n22\t// Grid: (num_row_blocks, width) where blockIdx.y selects the column\n23\ttemplate <bool ROTATE>\n24\t__global__ void fold_ple_from_evals_kernel(\n25\t    const Fp *__restrict__ input_matrix, // [height * width] column-major\n26\t    FpExt *__restrict__ output_matrix,   // [new_height * width] column-major\n27\t    const Fp *__restrict__ omega_skip_pows, // [skip_domain]\n28\t    const FpExt *inv_lagrange_denoms,       // [skip_domain]\n29\t    uint32_t height,\n30\t    uint32_t skip_domain, // 2^l_skip\n31\t    uint32_t l_skip,      // log2(domain_size)\n32\t    uint32_t new_height   // lifted_height >> l_skip\n33\t) {\n34\t    extern __shared__ char smem_raw[];\n35\t    FpExt *smem = reinterpret_cast<FpExt *>(smem_raw);\n36\t\n37\t    uint32_t col = blockIdx.y;\n38\t    uint32_t chunks_per_block = blockDim.x / skip_domain;\n39\t    uint32_t chunk_in_block = threadIdx.x / skip_domain;\n40\t    uint32_t tid_in_chunk = threadIdx.x % skip_domain;\n41\t    uint32_t x = blockIdx.x * chunks_per_block + chunk_in_block; // row index in output\n42\t\n43\t    // Cannot early-return: all threads must participate in chunk_reduce_sum (uses __syncthreads)\n44\t    bool const active_chunk = (x < new_height);\n45\t\n46\t    // Each thread handles exactly ONE term of the barycentric interpolation\n47\t    FpExt local_val(Fp::zero());\n48\t    if (active_chunk) {\n49\t        uint32_t z = tid_in_chunk;\n50\t        uint32_t offset = ROTATE ? 1 : 0;\n51\t        uint32_t row_idx = ((x << l_skip) + z + offset) % height;\n52\t        uint32_t input_idx = col * height + row_idx;\n53\t        Fp eval = input_matrix[input_idx];\n54\t\n55\t        // Lagrange interpolation: eval * omega_skip_pows[z] * inv_lagrange_denoms[z]\n56\t        local_val = inv_lagrange_denoms[z] * omega_skip_pows[z] * eval;\n57\t    }\n58\t\n59\t    // Reduce within chunk\n60\t    // All threads must participate; inactive chunks contribute zero\n61\t    FpExt result =\n62\t        sumcheck::chunk_reduce_sum(local_val, smem, tid_in_chunk, skip_domain, chunk_in_block);\n63\t\n64\t    // No __syncthreads() needed: each chunk writes to a distinct output location\n65\t    // and kernel exits immediately after this write\n66\t    if (active_chunk && tid_in_chunk == 0) {\n67\t        output_matrix[col * new_height + x] = result;\n68\t    }\n69\t}\n70\t\n71\tstruct InterpColDesc {\n72\t    FpExt* output;              // Base pointer for this trace's interpolated output\n73\t    uint32_t columns_offset;    // Offset into the flattened columns array\n74\t    uint32_t num_y;             // Number of y-values for this trace\n75\t    uint32_t num_columns;       // Number of columns for this trace\n76\t    uint32_t total_threads;     // = num_y * num_columns (precomputed for efficiency)\n77\t    uint32_t block_start;       // First block index assigned to this descriptor\n78\t};\n79\t\n80\tstruct InterpMatrixInfo {\n81\t    const FpExt* base;   // Matrix base pointer (column-major data)\n82\t    uint32_t width;      // Number of columns in this matrix\n83\t};\n84\t\n85\tstruct InterpTraceDescM {\n86\t    FpExt* output;              // Base pointer for this trace's interpolated output\n87\t    uint32_t matrix_offset;     // Index into the d_matrices array\n88\t    uint32_t num_matrices;      // Number of matrices for this trace (typically 2-5)\n89\t    uint32_t num_y;             // Number of y-values (height / 2)\n90\t    uint32_t num_columns;       // Total columns across all matrices\n91\t    uint32_t total_threads;     // = num_y * num_columns\n92\t    uint32_t block_start;       // First block index assigned to this descriptor\n93\t};\n94\t\n95\t__global__ void interpolate_columns_kernel(\n96\t    FpExt *__restrict__ interpolated,\n97\t    const FpExt *__restrict__ const *__restrict__ columns,\n98\t    uint32_t s_deg,\n99\t    uint32_t num_y,\n100\t    uint32_t num_columns\n101\t) {\n102\t    uint32_t tidx = threadIdx.x + blockIdx.x * blockDim.x;\n103\t    uint32_t y = tidx % num_y;\n104\t    uint32_t col_idx = tidx / num_y;\n105\t    if (col_idx >= num_columns)\n106\t        return;\n107\t\n108\t    const FpExt *__restrict__ column = columns[col_idx];\n109\t    auto t0 = column[y << 1];\n110\t    auto t1 = column[(y << 1) | 1];\n111\t    FpExt *__restrict__ this_interpolated = interpolated + col_idx * s_deg * num_y;\n112\t\n113\t    for (int x = 0; x < s_deg; x++) {\n114\t        this_interpolated[x * num_y + y] = t0 + (t1 - t0) * Fp(x + 1u);\n115\t    }\n116\t}\n117\t\n118\t__global__ void batched_interpolate_columns_kernel(\n119\t    const InterpColDesc* descs,\n120\t    const FpExt *const * all_columns,\n121\t    uint32_t s_deg,\n122\t    uint32_t num_descs\n123\t) {\n124\t    // Binary search: find the descriptor that owns this block\n125\t    uint32_t block_idx = blockIdx.x;\n126\t    uint32_t lo = 0, hi = num_descs;\n127\t    while (lo + 1 < hi) {\n128\t        uint32_t mid = (lo + hi) / 2;\n129\t        if (descs[mid].block_start <= block_idx) lo = mid;\n130\t        else hi = mid;\n131\t    }\n132\t\n133\t    const InterpColDesc& d = descs[lo];\n134\t    uint32_t local_block = block_idx - d.block_start;\n135\t    uint32_t tidx = local_block * blockDim.x + threadIdx.x;\n136\t    if (tidx >= d.total_threads) return;\n137\t\n138\t    uint32_t y = tidx % d.num_y;\n139\t    uint32_t col_local = tidx / d.num_y;\n140\t\n141\t    const FpExt *column = all_columns[d.columns_offset + col_local];\n142\t    auto t0 = column[y << 1];\n143\t    auto t1 = column[(y << 1) | 1];\n144\t    FpExt *this_out = d.output + col_local * s_deg * d.num_y;\n145\t\n146\t    for (int x = 0; x < s_deg; x++) {\n147\t        this_out[x * d.num_y + y] = t0 + (t1 - t0) * Fp(x + 1u);\n148\t    }\n149\t}\n150\t\n151\t__global__ void batched_interpolate_columns_matrix_kernel(\n152\t    const InterpTraceDescM* descs,\n153\t    const InterpMatrixInfo* matrices,\n154\t    uint32_t s_deg,\n155\t    uint32_t num_descs\n156\t) {\n157\t    // Binary search: find descriptor owning this block (same as existing kernel)\n158\t    uint32_t block_idx = blockIdx.x;\n159\t    uint32_t lo = 0, hi = num_descs;\n160\t    while (lo + 1 < hi) {\n161\t        uint32_t mid = (lo + hi) / 2;\n162\t        if (descs[mid].block_start <= block_idx) lo = mid;\n163\t        else hi = mid;\n164\t    }\n165\t\n166\t    const InterpTraceDescM& d = descs[lo];\n167\t    uint32_t local_block = block_idx - d.block_start;\n168\t    uint32_t tidx = local_block * blockDim.x + threadIdx.x;\n169\t    if (tidx >= d.total_threads) return;\n170\t\n171\t    uint32_t y = tidx % d.num_y;\n172\t    uint32_t col_local = tidx / d.num_y;\n173\t\n174\t    // Compute column pointer from matrix base + offset\n175\t    // Linear scan over matrices (typically 2-5 per trace)\n176\t    const FpExt *column = nullptr;\n177\t    uint32_t rem = col_local;\n178\t    for (uint32_t i = 0; i < d.num_matrices; i++) {\n179\t        const InterpMatrixInfo& m = matrices[d.matrix_offset + i];\n180\t        if (rem < m.width) {\n181\t            column = m.base + rem * (2u * d.num_y);\n182\t            break;\n183\t        }\n184\t        rem -= m.width;\n185\t    }\n186\t\n187\t    auto t0 = column[y << 1];\n188\t    auto t1 = column[(y << 1) | 1];\n189\t    FpExt *this_out = d.output + col_local * s_deg * d.num_y;\n190\t\n191\t    for (int x = 0; x < s_deg; x++) {\n192\t        this_out[x * d.num_y + y] = t0 + (t1 - t0) * Fp(x + 1u);\n193\t    }\n194\t}\n195\t\n196\t__global__ void frac_matrix_vertically_repeat_kernel(\n197\t    std::pair<FpExt, FpExt> *__restrict__ out,\n198\t    const std::pair<FpExt, FpExt> *__restrict__ in,\n199\t    const uint32_t width,\n200\t    const uint32_t lifted_height,\n201\t    const uint32_t height\n202\t) {\n203\t    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;\n204\t    uint32_t col = blockIdx.y + blockIdx.z * gridDim.y;\n205\t    if (col >= width) {\n206\t        return;\n207\t    }\n208\t    out[col * lifted_height + row].first = in[col * height + (row % height)].first;\n209\t    out[col * lifted_height + row].second = in[col * height + (row % height)].second;\n210\t}\n211\t\n212\t// Vertically repeat separate (F, EF) buffers (for GKR input optimization)\n213\t__global__ void frac_matrix_vertically_repeat_mixed_kernel(\n214\t    FpExt *__restrict__ out_numerators,\n215\t    FpExt *__restrict__ out_denominators,\n216\t    const FpExt *__restrict__ in_numerators,\n217\t    const FpExt *__restrict__ in_denominators,\n218\t    const uint32_t width,\n219\t    const uint32_t lifted_height,\n220\t    const uint32_t height\n221\t) {\n222\t    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;\n223\t    uint32_t col = blockIdx.y + blockIdx.z * gridDim.y;\n224\t    if (col >= width) {\n225\t        return;\n226\t    }\n227\t    uint32_t src_row = row % height;\n228\t    size_t src_idx = col * height + src_row;\n229\t    size_t dst_idx = col * lifted_height + row;\n230\t    out_numerators[dst_idx] = in_numerators[src_idx];\n231\t    out_denominators[dst_idx] = in_denominators[src_idx];\n232\t}\n233\t\n234\t// ============================================================================\n235\t// LAUNCHERS\n236\t// ============================================================================\n237\t\n238\tconstexpr uint32_t MAX_GRID_DIM = 65535u;\n239\t\n240\textern \"C\" int _fold_ple_from_evals(\n241\t    const Fp *input_matrix,\n242\t    FpExt *output_matrix,\n243\t    const Fp *omega_skip_pows,\n244\t    const FpExt *inv_lagrange_denoms,\n245\t    uint32_t height,\n246\t    uint32_t width,\n247\t    uint32_t l_skip,\n248\t    uint32_t new_height,\n249\t    bool rotate\n250\t) {\n251\t    uint32_t skip_domain = 1u << l_skip;\n252\t\n253\t    // Block size: at least skip_domain, prefer 256 for occupancy\n254\t    uint32_t block_size = std::max(256u, skip_domain);\n255\t    uint32_t chunks_per_block = block_size / skip_domain;\n256\t\n257\t    // 2D grid: x-dim for rows, y-dim for columns\n258\t    dim3 grid(div_ceil(new_height, chunks_per_block), width);\n259\t    dim3 block(block_size);\n260\t\n261\t    // Shared memory for cross-warp reduction (needed when skip_domain > 32)\n262\t    // Each warp in the block needs one FpExt slot for cross-warp reduction\n263\t    uint32_t total_warps_in_block = block_size / WARP_SIZE;\n264\t    size_t smem_bytes = (skip_domain > WARP_SIZE) ? total_warps_in_block * sizeof(FpExt) : 0;\n265\t\n266\t    if (rotate) {\n267\t        fold_ple_from_evals_kernel<true><<<grid, block, smem_bytes>>>(\n268\t            input_matrix,\n269\t            output_matrix,\n270\t            omega_skip_pows,\n271\t            inv_lagrange_denoms,\n272\t            height,\n273\t            skip_domain,\n274\t            l_skip,\n275\t            new_height\n276\t        );\n277\t    } else {\n278\t        fold_ple_from_evals_kernel<false><<<grid, block, smem_bytes>>>(\n279\t            input_matrix,\n280\t            output_matrix,\n281\t            omega_skip_pows,\n282\t            inv_lagrange_denoms,\n283\t            height,\n284\t            skip_domain,\n285\t            l_skip,\n286\t            new_height\n287\t        );\n288\t    }\n289\t    return CHECK_KERNEL();\n290\t}\n291\t\n292\textern \"C\" int _interpolate_columns(\n293\t    FpExt *interpolated,\n294\t    const FpExt *const *columns,\n295\t    size_t s_deg,\n296\t    size_t num_y,\n297\t    size_t num_columns\n298\t) {\n299\t    auto [grid, block] = kernel_launch_params(num_y * num_columns, 512);\n300\t\n301\t    interpolate_columns_kernel<<<grid, block>>>(interpolated, columns, s_deg, num_y, num_columns);\n302\t    return CHECK_KERNEL();\n303\t}\n304\t\n305\textern \"C\" int _batched_interpolate_columns(\n306\t    const InterpColDesc* descs,\n307\t    const FpExt *const * all_columns,\n308\t    size_t s_deg,\n309\t    size_t num_descs,\n310\t    size_t total_blocks\n311\t) {\n312\t    if (num_descs == 0) return 0;\n313\t    dim3 grid(total_blocks);\n314\t    dim3 block(512);\n315\t    batched_interpolate_columns_kernel<<<grid, block>>>(\n316\t        descs, all_columns, s_deg, num_descs\n317\t    );\n318\t    return CHECK_KERNEL();\n319\t}\n320\t\n321\textern \"C\" int _batched_interpolate_columns_matrix(\n322\t    const InterpTraceDescM* descs,\n323\t    const InterpMatrixInfo* matrices,\n324\t    size_t s_deg,\n325\t    size_t num_descs,\n326\t    size_t total_blocks\n327\t) {\n328\t    if (num_descs == 0) return 0;\n329\t    dim3 grid(total_blocks);\n330\t    dim3 block(512);\n331\t    batched_interpolate_columns_matrix_kernel<<<grid, block>>>(\n332\t        descs, matrices, s_deg, num_descs\n333\t    );\n334\t    return CHECK_KERNEL();\n335\t}\n336\t\n337\textern \"C\" int _frac_matrix_vertically_repeat(\n338\t    std::pair<FpExt, FpExt> *out,\n339\t    const std::pair<FpExt, FpExt> *in,\n340\t    const uint32_t width,\n341\t    const uint32_t lifted_height,\n342\t    const uint32_t height\n343\t) {\n344\t    auto [grid, block] = kernel_launch_params(lifted_height);\n345\t    grid.y = std::min(width, MAX_GRID_DIM);\n346\t    grid.z = (width + grid.y - 1) / grid.y;\n347\t    assert(grid.z <= MAX_GRID_DIM);\n348\t    frac_matrix_vertically_repeat_kernel<<<grid, block>>>(out, in, width, lifted_height, height);\n349\t    return CHECK_KERNEL();\n350\t}\n351\t\n352\textern \"C\" int _frac_matrix_vertically_repeat_ext(\n353\t    FpExt *out_numerators,\n354\t    FpExt *out_denominators,\n355\t    const FpExt *in_numerators,\n356\t    const FpExt *in_denominators,\n357\t    const uint32_t width,\n358\t    const uint32_t lifted_height,\n359\t    const uint32_t height\n360\t) {\n361\t    auto [grid, block] = kernel_launch_params(lifted_height);\n362\t    grid.y = std::min(width, MAX_GRID_DIM);\n363\t    grid.z = (width + grid.y - 1) / grid.y;\n364\t    assert(grid.z <= MAX_GRID_DIM);\n365\t    frac_matrix_vertically_repeat_mixed_kernel<<<grid, block>>>(\n366\t        out_numerators,\n367\t        out_denominators,\n368\t        in_numerators,\n369\t        in_denominators,\n370\t        width,\n371\t        lifted_height,\n372\t        height\n373\t    );\n374\t    return CHECK_KERNEL();\n375\t}\n376\t\n377\t} // namespace\n378\t"}]},"parent_tool_use_id":null,"session_id":"ad7abbbb-1391-43dc-94f8-6f027601bba7","uuid":"2ff0118a-9b9a-498f-b5f6-2b6f304fca53","timestamp":"2026-04-16T00:25:43.073Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/cuda/src/logup_zerocheck/utils.cu","content":"#include \"fp.h\"\n#include \"fpext.h\"\n#include \"launcher.cuh\"\n#include \"sumcheck.cuh\"\n#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <utility>\n\nnamespace {\n\n// ============================================================================\n// KERNELS\n// ============================================================================\n\n// Folds PLE evaluations by interpolating univariate polynomials on coset D and evaluating at r_0\n// Input: column-major matrix [height * width] of evaluations\n// Output: column-major matrix [new_height * width] of folded evaluations (original OR rotated)\n// For each (x, col), collects 2^l_skip evaluations on coset D and interpolates\n// Parallelizes barycentric interpolation: each chunk of skip_domain threads handles one output cell\n// Grid: (num_row_blocks, width) where blockIdx.y selects the column\ntemplate <bool ROTATE>\n__global__ void fold_ple_from_evals_kernel(\n    const Fp *__restrict__ input_matrix, // [height * width] column-major\n    FpExt *__restrict__ output_matrix,   // [new_height * width] column-major\n    const Fp *__restrict__ omega_skip_pows, // [skip_domain]\n    const FpExt *inv_lagrange_denoms,       // [skip_domain]\n    uint32_t height,\n    uint32_t skip_domain, // 2^l_skip\n    uint32_t l_skip,      // log2(domain_size)\n    uint32_t new_height   // lifted_height >> l_skip\n) {\n    extern __shared__ char smem_raw[];\n    FpExt *smem = reinterpret_cast<FpExt *>(smem_raw);\n\n    uint32_t col = blockIdx.y;\n    uint32_t chunks_per_block = blockDim.x / skip_domain;\n    uint32_t chunk_in_block = threadIdx.x / skip_domain;\n    uint32_t tid_in_chunk = threadIdx.x % skip_domain;\n    uint32_t x = blockIdx.x * chunks_per_block + chunk_in_block; // row index in output\n\n    // Cannot early-return: all threads must participate in chunk_reduce_sum (uses __syncthreads)\n    bool const active_chunk = (x < new_height);\n\n    // Each thread handles exactly ONE term of the barycentric interpolation\n    FpExt local_val(Fp::zero());\n    if (active_chunk) {\n        uint32_t z = tid_in_chunk;\n        uint32_t offset = ROTATE ? 1 : 0;\n        uint32_t row_idx = ((x << l_skip) + z + offset) % height;\n        uint32_t input_idx = col * height + row_idx;\n        Fp eval = input_matrix[input_idx];\n\n        // Lagrange interpolation: eval * omega_skip_pows[z] * inv_lagrange_denoms[z]\n        local_val = inv_lagrange_denoms[z] * omega_skip_pows[z] * eval;\n    }\n\n    // Reduce within chunk\n    // All threads must participate; inactive chunks contribute zero\n    FpExt result =\n        sumcheck::chunk_reduce_sum(local_val, smem, tid_in_chunk, skip_domain, chunk_in_block);\n\n    // No __syncthreads() needed: each chunk writes to a distinct output location\n    // and kernel exits immediately after this write\n    if (active_chunk && tid_in_chunk == 0) {\n        output_matrix[col * new_height + x] = result;\n    }\n}\n\nstruct InterpColDesc {\n    FpExt* output;              // Base pointer for this trace's interpolated output\n    uint32_t columns_offset;    // Offset into the flattened columns array\n    uint32_t num_y;             // Number of y-values for this trace\n    uint32_t num_columns;       // Number of columns for this trace\n    uint32_t total_threads;     // = num_y * num_columns (precomputed for efficiency)\n    uint32_t block_start;       // First block index assigned to this descriptor\n};\n\nstruct InterpMatrixInfo {\n    const FpExt* base;   // Matrix base pointer (column-major data)\n    uint32_t width;      // Number of columns in this matrix\n};\n\nstruct InterpTraceDescM {\n    FpExt* output;              // Base pointer for this trace's interpolated output\n    uint32_t matrix_offset;     // Index into the d_matrices array\n    uint32_t num_matrices;      // Number of matrices for this trace (typically 2-5)\n    uint32_t num_y;             // Number of y-values (height / 2)\n    uint32_t num_columns;       // Total columns across all matrices\n    uint32_t total_threads;     // = num_y * num_columns\n    uint32_t block_start;       // First block index assigned to this descriptor\n};\n\n__global__ void interpolate_columns_kernel(\n    FpExt *__restrict__ interpolated,\n    const FpExt *__restrict__ const *__restrict__ columns,\n    uint32_t s_deg,\n    uint32_t num_y,\n    uint32_t num_columns\n) {\n    uint32_t tidx = threadIdx.x + blockIdx.x * blockDim.x;\n    uint32_t y = tidx % num_y;\n    uint32_t col_idx = tidx / num_y;\n    if (col_idx >= num_columns)\n        return;\n\n    const FpExt *__restrict__ column = columns[col_idx];\n    auto t0 = column[y << 1];\n    auto t1 = column[(y << 1) | 1];\n    FpExt *__restrict__ this_interpolated = interpolated + col_idx * s_deg * num_y;\n\n    for (int x = 0; x < s_deg; x++) {\n        this_interpolated[x * num_y + y] = t0 + (t1 - t0) * Fp(x + 1u);\n    }\n}\n\n__global__ void batched_interpolate_columns_kernel(\n    const InterpColDesc* descs,\n    const FpExt *const * all_columns,\n    uint32_t s_deg,\n    uint32_t num_descs\n) {\n    // Binary search: find the descriptor that owns this block\n    uint32_t block_idx = blockIdx.x;\n    uint32_t lo = 0, hi = num_descs;\n    while (lo + 1 < hi) {\n        uint32_t mid = (lo + hi) / 2;\n        if (descs[mid].block_start <= block_idx) lo = mid;\n        else hi = mid;\n    }\n\n    const InterpColDesc& d = descs[lo];\n    uint32_t local_block = block_idx - d.block_start;\n    uint32_t tidx = local_block * blockDim.x + threadIdx.x;\n    if (tidx >= d.total_threads) return;\n\n    uint32_t y = tidx % d.num_y;\n    uint32_t col_local = tidx / d.num_y;\n\n    const FpExt *column = all_columns[d.columns_offset + col_local];\n    auto t0 = column[y << 1];\n    auto t1 = column[(y << 1) | 1];\n    FpExt *this_out = d.output + col_local * s_deg * d.num_y;\n\n    for (int x = 0; x < s_deg; x++) {\n        this_out[x * d.num_y + y] = t0 + (t1 - t0) * Fp(x + 1u);\n    }\n}\n\n__global__ void batched_interpolate_columns_matrix_kernel(\n    const InterpTraceDescM* descs,\n    const InterpMatrixInfo* matrices,\n    uint32_t s_deg,\n    uint32_t num_descs\n) {\n    // Binary search: find descriptor owning this block (same as existing kernel)\n    uint32_t block_idx = blockIdx.x;\n    uint32_t lo = 0, hi = num_descs;\n    while (lo + 1 < hi) {\n        uint32_t mid = (lo + hi) / 2;\n        if (descs[mid].block_start <= block_idx) lo = mid;\n        else hi = mid;\n    }\n\n    const InterpTraceDescM& d = descs[lo];\n    uint32_t local_block = block_idx - d.block_start;\n    uint32_t tidx = local_block * blockDim.x + threadIdx.x;\n    if (tidx >= d.total_threads) return;\n\n    uint32_t y = tidx % d.num_y;\n    uint32_t col_local = tidx / d.num_y;\n\n    // Compute column pointer from matrix base + offset\n    // Linear scan over matrices (typically 2-5 per trace)\n    const FpExt *column = nullptr;\n    uint32_t rem = col_local;\n    for (uint32_t i = 0; i < d.num_matrices; i++) {\n        const InterpMatrixInfo& m = matrices[d.matrix_offset + i];\n        if (rem < m.width) {\n            column = m.base + rem * (2u * d.num_y);\n            break;\n        }\n        rem -= m.width;\n    }\n\n    auto t0 = column[y << 1];\n    auto t1 = column[(y << 1) | 1];\n    FpExt *this_out = d.output + col_local * s_deg * d.num_y;\n\n    for (int x = 0; x < s_deg; x++) {\n        this_out[x * d.num_y + y] = t0 + (t1 - t0) * Fp(x + 1u);\n    }\n}\n\n__global__ void frac_matrix_vertically_repeat_kernel(\n    std::pair<FpExt, FpExt> *__restrict__ out,\n    const std::pair<FpExt, FpExt> *__restrict__ in,\n    const uint32_t width,\n    const uint32_t lifted_height,\n    const uint32_t height\n) {\n    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;\n    uint32_t col = blockIdx.y + blockIdx.z * gridDim.y;\n    if (col >= width) {\n        return;\n    }\n    out[col * lifted_height + row].first = in[col * height + (row % height)].first;\n    out[col * lifted_height + row].second = in[col * height + (row % height)].second;\n}\n\n// Vertically repeat separate (F, EF) buffers (for GKR input optimization)\n__global__ void frac_matrix_vertically_repeat_mixed_kernel(\n    FpExt *__restrict__ out_numerators,\n    FpExt *__restrict__ out_denominators,\n    const FpExt *__restrict__ in_numerators,\n    const FpExt *__restrict__ in_denominators,\n    const uint32_t width,\n    const uint32_t lifted_height,\n    const uint32_t height\n) {\n    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;\n    uint32_t col = blockIdx.y + blockIdx.z * gridDim.y;\n    if (col >= width) {\n        return;\n    }\n    uint32_t src_row = row % height;\n    size_t src_idx = col * height + src_row;\n    size_t dst_idx = col * lifted_height + row;\n    out_numerators[dst_idx] = in_numerators[src_idx];\n    out_denominators[dst_idx] = in_denominators[src_idx];\n}\n\n// ============================================================================\n// LAUNCHERS\n// ============================================================================\n\nconstexpr uint32_t MAX_GRID_DIM = 65535u;\n\nextern \"C\" int _fold_ple_from_evals(\n    const Fp *input_matrix,\n    FpExt *output_matrix,\n    const Fp *omega_skip_pows,\n    const FpExt *inv_lagrange_denoms,\n    uint32_t height,\n    uint32_t width,\n    uint32_t l_skip,\n    uint32_t new_height,\n    bool rotate\n) {\n    uint32_t skip_domain = 1u << l_skip;\n\n    // Block size: at least skip_domain, prefer 256 for occupancy\n    uint32_t block_size = std::max(256u, skip_domain);\n    uint32_t chunks_per_block = block_size / skip_domain;\n\n    // 2D grid: x-dim for rows, y-dim for columns\n    dim3 grid(div_ceil(new_height, chunks_per_block), width);\n    dim3 block(block_size);\n\n    // Shared memory for cross-warp reduction (needed when skip_domain > 32)\n    // Each warp in the block needs one FpExt slot for cross-warp reduction\n    uint32_t total_warps_in_block = block_size / WARP_SIZE;\n    size_t smem_bytes = (skip_domain > WARP_SIZE) ? total_warps_in_block * sizeof(FpExt) : 0;\n\n    if (rotate) {\n        fold_ple_from_evals_kernel<true><<<grid, block, smem_bytes>>>(\n            input_matrix,\n            output_matrix,\n            omega_skip_pows,\n            inv_lagrange_denoms,\n            height,\n            skip_domain,\n            l_skip,\n            new_height\n        );\n    } else {\n        fold_ple_from_evals_kernel<false><<<grid, block, smem_bytes>>>(\n            input_matrix,\n            output_matrix,\n            omega_skip_pows,\n            inv_lagrange_denoms,\n            height,\n            skip_domain,\n            l_skip,\n            new_height\n        );\n    }\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _interpolate_columns(\n    FpExt *interpolated,\n    const FpExt *const *columns,\n    size_t s_deg,\n    size_t num_y,\n    size_t num_columns\n) {\n    auto [grid, block] = kernel_launch_params(num_y * num_columns, 512);\n\n    interpolate_columns_kernel<<<grid, block>>>(interpolated, columns, s_deg, num_y, num_columns);\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _batched_interpolate_columns(\n    const InterpColDesc* descs,\n    const FpExt *const * all_columns,\n    size_t s_deg,\n    size_t num_descs,\n    size_t total_blocks\n) {\n    if (num_descs == 0) return 0;\n    dim3 grid(total_blocks);\n    dim3 block(512);\n    batched_interpolate_columns_kernel<<<grid, block>>>(\n        descs, all_columns, s_deg, num_descs\n    );\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _batched_interpolate_columns_matrix(\n    const InterpTraceDescM* descs,\n    const InterpMatrixInfo* matrices,\n    size_t s_deg,\n    size_t num_descs,\n    size_t total_blocks\n) {\n    if (num_descs == 0) return 0;\n    dim3 grid(total_blocks);\n    dim3 block(512);\n    batched_interpolate_columns_matrix_kernel<<<grid, block>>>(\n        descs, matrices, s_deg, num_descs\n    );\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _frac_matrix_vertically_repeat(\n    std::pair<FpExt, FpExt> *out,\n    const std::pair<FpExt, FpExt> *in,\n    const uint32_t width,\n    const uint32_t lifted_height,\n    const uint32_t height\n) {\n    auto [grid, block] = kernel_launch_params(lifted_height);\n    grid.y = std::min(width, MAX_GRID_DIM);\n    grid.z = (width + grid.y - 1) / grid.y;\n    assert(grid.z <= MAX_GRID_DIM);\n    frac_matrix_vertically_repeat_kernel<<<grid, block>>>(out, in, width, lifted_height, height);\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _frac_matrix_vertically_repeat_ext(\n    FpExt *out_numerators,\n    FpExt *out_denominators,\n    const FpExt *in_numerators,\n    const FpExt *in_denominators,\n    const uint32_t width,\n    const uint32_t lifted_height,\n    const uint32_t height\n) {\n    auto [grid, block] = kernel_launch_params(lifted_height);\n    grid.y = std::min(width, MAX_GRID_DIM);\n    grid.z = (width + grid.y - 1) / grid.y;\n    assert(grid.z <= MAX_GRID_DIM);\n    frac_matrix_vertically_repeat_mixed_kernel<<<grid, block>>>(\n        out_numerators,\n        out_denominators,\n        in_numerators,\n        in_denominators,\n        width,\n        lifted_height,\n        height\n    );\n    return CHECK_KERNEL();\n}\n\n} // namespace\n","numLines":378,"startLine":1,"totalLines":378}}}
