{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01USyZk5CuAszkSeDmeoomZ8","type":"tool_result","content":"1\tuse itertools::Itertools;\n2\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer};\n3\tuse openvm_stark_backend::{\n4\t    air_builders::symbolic::{\n5\t        symbolic_expression::SymbolicExpression, SymbolicConstraints, SymbolicDagBuilder,\n6\t        SymbolicExpressionDag,\n7\t    },\n8\t    prover::{fractional_sumcheck_gkr::Frac, DeviceStarkProvingKey},\n9\t};\n10\tuse p3_field::PrimeCharacteristicRing;\n11\tuse tracing::{debug, warn};\n12\t\n13\tuse super::errors::Round0EvalError;\n14\tuse crate::{\n15\t    cuda::logup_zerocheck::{\n16\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n17\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n18\t        logup_bary_eval_interactions_round0, zerocheck_ntt_eval_constraints,\n19\t    },\n20\t    gpu_backend::GenericGpuBackend,\n21\t    hash_scheme::GpuHashScheme,\n22\t    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n23\t    prelude::{EF, F},\n24\t};\n25\t\n26\t/// BUFFER_THRESHOLD matching the CUDA-side constant.\n27\tpub(crate) const BUFFER_THRESHOLD: u32 = 16;\n28\t/// COSET_PARALLEL_THRESHOLD matching the CUDA-side constant.\n29\tpub(crate) const COSET_PARALLEL_THRESHOLD: u32 = 32768;\n30\t/// MAX_THREADS matching the CUDA-side constant for coset-parallel kernels.\n31\tpub(crate) const MAX_THREADS_ROUND0: u32 = 128;\n32\t\n33\t/// Per-AIR metadata for batched zerocheck coset-parallel evaluation.\n34\t/// Must match the C struct `ZerocheckBatchMeta` in zerocheck_round0.cu exactly.\n35\t#[repr(C)]\n36\t#[derive(Clone, Copy)]\n37\tpub(crate) struct ZerocheckBatchMeta {\n38\t    pub selectors_cube: *const F,\n39\t    pub preprocessed: *const F,\n40\t    pub main_parts: *const *const F,\n41\t    pub eq_cube: *const EF,\n42\t    pub public_values: *const F,\n43\t    pub d_rules: *const std::ffi::c_void,\n44\t    pub d_used_nodes: *const usize,\n45\t    pub rules_len: usize,\n46\t    pub used_nodes_len: usize,\n47\t    pub buffer_size: u32,\n48\t    pub num_x: u32,\n49\t    pub height: u32,\n50\t    pub num_cosets: u32,\n51\t    pub g_shift: F,\n52\t}\n53\t\n54\t// SAFETY: All pointers refer to device memory managed by DeviceBuffer kept alive\n55\t// until stream sync.\n56\tunsafe impl Send for ZerocheckBatchMeta {}\n57\t\n58\t/// Per-AIR metadata for batched logup coset-parallel evaluation.\n59\t/// Must match the C struct `LogupBatchMeta` in logup_round0.cu exactly.\n60\t#[repr(C)]\n61\t#[derive(Clone, Copy)]\n62\tpub(crate) struct LogupBatchMeta {\n63\t    pub selectors_cube: *const F,\n64\t    pub preprocessed: *const F,\n65\t    pub main_parts: *const *const F,\n66\t    pub eq_cube: *const EF,\n67\t    pub public_values: *const F,\n68\t    pub numer_weights: *const EF,\n69\t    pub denom_weights: *const EF,\n70\t    pub d_rules: *const std::ffi::c_void,\n71\t    pub rules_len: usize,\n72\t    pub denom_sum_init: EF,\n73\t    pub buffer_size: u32,\n74\t    pub num_x: u32,\n75\t    pub height: u32,\n76\t    pub num_cosets: u32,\n77\t    pub g_shift: F,\n78\t}\n79\t\n80\t// SAFETY: All pointers refer to device memory managed by DeviceBuffer kept alive\n81\t// until stream sync.\n82\tunsafe impl Send for LogupBatchMeta {}\n83\t\n84\t/// Evaluate plain AIR constraints (not interactions) for a single AIR, given prepared trace input.\n85\t///\n86\t/// `num_cosets` should equal `constraint_degree - 1` because we evaluate the quotient polynomial.\n87\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n88\t#[allow(clippy::too_many_arguments)]\n89\tpub fn evaluate_round0_constraints_gpu<HS: GpuHashScheme>(\n90\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n91\t    selectors_cube: &DeviceBuffer<F>,\n92\t    main_parts: &DeviceBuffer<*const F>,\n93\t    public_values: &DeviceBuffer<F>,\n94\t    eq_cube: *const EF,\n95\t    lambda_pows: &DeviceBuffer<EF>,\n96\t    skip_domain: u32,\n97\t    num_x: u32,\n98\t    height: u32,\n99\t    num_cosets: u32,\n100\t    g_shift: F,"}]},"parent_tool_use_id":"toolu_019xaxjb5CY3UXKd4xKtnvE4","session_id":"d346b169-4c5b-4579-98c0-3e4f65b0717e","uuid":"ff63150a-7913-4567-ae12-8717f8fb096a","timestamp":"2026-04-11T07:19:09.035Z"}
