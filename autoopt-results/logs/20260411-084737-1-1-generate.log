{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QSgertacrNiFS9EcWS9Cuu","type":"tool_result","content":"602\t    fn sumcheck_uni_round0_polys(\n603\t        &mut self,\n604\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n605\t        lambda: EF,\n606\t    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n607\t        self.mem\n608\t            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n609\t        self.mem.reset_peak();\n610\t        let n_logup = self.n_logup;\n611\t        let l_skip = self.l_skip;\n612\t        let xi = &self.xi;\n613\t        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n614\t        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n615\t            h_lambda_pows.to_device()?\n616\t        } else {\n617\t            DeviceBuffer::new()\n618\t        });\n619\t        // Precompute lambda combinations for all AIRs with monomials\n620\t        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n621\t        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n622\t            if air_pk.other_data.zerocheck_monomials.is_some() {\n623\t                self.lambda_combinations[air_idx] = Some(\n624\t                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n625\t                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n626\t                );\n627\t            }\n628\t        }\n629\t        let num_present_airs = ctx.per_trace.len();\n630\t        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n631\t\n632\t        self.eq_3b_per_trace = ctx\n633\t            .per_trace\n634\t            .iter()\n635\t            .enumerate()\n636\t            .map(|(trace_idx, (air_idx, _))| {\n637\t                let vk = &self.pk.per_air[*air_idx].vk;\n638\t                let num_interactions = vk.num_interactions();\n639\t                if num_interactions > 0 {\n640\t                    let n = self.n_per_trace[trace_idx];\n641\t                    let n_lift = n.max(0) as usize;\n642\t                    let mut b_vec = vec![F::ZERO; n_logup - n_lift];\n643\t                    let mut weights = Vec::with_capacity(num_interactions);\n644\t                    for interaction_idx in 0..num_interactions {\n645\t                        let stacked_idx = self\n646\t                            .interactions_layout\n647\t                            .get(trace_idx, interaction_idx)\n648\t                            .unwrap()\n649\t                            .row_idx;\n650\t                        let mut b_int = stacked_idx >> (l_skip + n_lift);\n651\t                        for bit in &mut b_vec {\n652\t                            *bit = F::from_bool(b_int & 1 == 1);\n653\t                            b_int >>= 1;\n654\t                        }\n655\t                        let weight =\n656\t                            eval_eq_mle(&self.xi[l_skip + n_lift..l_skip + n_logup], &b_vec);\n657\t                        weights.push(weight);\n658\t                    }\n659\t                    weights\n660\t                } else {\n661\t                    vec![]\n662\t                }\n663\t            })\n664\t            .collect_vec();\n665\t        self.d_eq_3b_per_trace = self\n666\t            .eq_3b_per_trace\n667\t            .iter()\n668\t            .map(|eq_3bs| {\n669\t                if eq_3bs.is_empty() {\n670\t                    Ok(DeviceBuffer::new())\n671\t                } else {\n672\t                    eq_3bs.to_device()\n673\t                }\n674\t            })\n675\t            .collect::<Result<Vec<_>, _>>()?;\n676\t\n677\t        // Precompute logup combinations for all traces with interaction monomials\n678\t        for (trace_idx, (air_idx, _)) in ctx.per_trace.iter().enumerate() {\n679\t            let air_pk = &self.pk.per_air[*air_idx];\n680\t            if air_pk.other_data.interaction_monomials.is_some()\n681\t                && !self.eq_3b_per_trace[trace_idx].is_empty()\n682\t            {\n683\t                self.logup_combinations[trace_idx] = Some(\n684\t                    compute_logup_combinations(\n685\t                        self.pk,\n686\t                        *air_idx,\n687\t                        &self.d_beta_pows,\n688\t                        &self.d_eq_3b_per_trace[trace_idx],\n689\t                        &self.eq_3b_per_trace[trace_idx],\n690\t                        &self.beta_pows,\n691\t                    )\n692\t                    .map_err(LogupZerocheckError::LogupCombinations)?,\n693\t                );\n694\t            }\n695\t        }\n696\t\n697\t        // PERF[jpw]: we could also build the layers for different n in a transposed way using\n698\t        // eq_nonoverlapping_stage_ext, which is more memory efficient\n699\t        for &n in &self.n_per_trace {\n700\t            let n_lift = n.max(0) as usize;\n701\t            if let Entry::Vacant(entry) = self.eq_xis.entry(n_lift) {\n702\t                let layers =\n703\t                    EqEvalLayers::new_rev(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n704\t                        .map_err(LogupZerocheckError::EqEvalLayers)?;\n705\t                entry.insert(layers);\n706\t            }\n707\t        }\n708\t\n709\t        self.sels_per_trace_base = self\n710\t            .n_per_trace\n711\t            .iter()\n712\t            .map(|&n| {\n713\t                let n_lift = n.max(0) as usize;\n714\t                let height = 1 << n_lift;\n715\t                let mut cols = F::zero_vec(3 * height);\n716\t                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n717\t                cols[0] = F::ONE; // is_first\n718\t                cols[2 * height + height - 1] = F::ONE; // is_last\n719\t                let d_cols = cols.to_device()?;\n720\t                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n721\t            })\n722\t            .collect::<Result<Vec<_>, MemCopyError>>()?;\n723\t\n724\t        let selectors_base = self.sels_per_trace_base.clone();\n725\t\n726\t        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n727\t        // present AIR\n728\t        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n729\t        let d_lambda_pows = self\n730\t            .lambda_pows\n731\t            .as_ref()\n732\t            .expect(\"lambda powers must be set before round-0 evaluation\");\n733\t\n734\t        // Metadata stored per AIR during Phase 1, consumed in Phase 2\n735\t        struct Round0Pending<F, EF> {\n736\t            trace_idx: usize,\n737\t            air_idx: usize,\n738\t            num_cosets_zc: usize,\n739\t            num_cosets_logup: usize,\n740\t            local_constraint_deg: usize,\n741\t            omega_root: F,\n742\t            n: isize,\n743\t            // For individual (non-batched) launches:\n744\t            zc_result: DeviceBuffer<EF>,\n745\t            logup_result: DeviceBuffer<Frac<EF>>,\n746\t            // For batched launches (index within the batch, None if individual):\n747\t            zc_batch_idx: Option<usize>,\n748\t            logup_batch_idx: Option<usize>,\n749\t        }\n750\t\n751\t        let skip_domain: u32 = 1 << l_skip;\n752\t        let block_x = skip_domain.max(MAX_THREADS_ROUND0);\n753\t\n754\t        // Pre-check: disable batching if skip_domain is large enough that batch\n755\t        // temp buffers would exceed the memory budget. Each batched block contributes\n756\t        // max_num_cosets * skip_domain * sizeof(T) to the temp buffer. With ~600\n757\t        // AIRs and ~8 blocks each, the total can reach hundreds of MB.\n758\t        // Conservative estimate: if d * num_airs * max_blocks_per_air * sizeof(Frac<EF>) > 128 MB,\n759\t        // skip batching. This typically triggers for skip_domain >= 256.\n760\t        const BATCH_TMP_BUDGET: usize = 128 * 1024 * 1024;\n761\t        let max_cosets_estimate = self.constraint_degree; // upper bound\n762\t        let d_estimate = max_cosets_estimate * skip_domain as usize;\n763\t        let blocks_per_air_estimate = skip_domain.div_ceil(block_x) as usize;\n764\t        let estimated_batch_tmp = num_present_airs\n765\t            * blocks_per_air_estimate\n766\t            * d_estimate\n767\t            * std::mem::size_of::<Frac<EF>>();\n768\t        let batching_enabled = estimated_batch_tmp <= BATCH_TMP_BUDGET;\n769\t        debug!(\n770\t            \"Round 0: l_skip={l_skip}, skip_domain={skip_domain}, batching_enabled={batching_enabled}, estimated_tmp={estimated_batch_tmp}\"\n771\t        );\n772\t\n773\t        // Phase 1: Classify AIRs, collect metadata for batching, launch kernels.\n774\t        let mut pending: Vec<Round0Pending<F, EF>> = Vec::with_capacity(num_present_airs);\n775\t        let mut d_main_parts_vec: Vec<DeviceBuffer<*const F>> =\n776\t            Vec::with_capacity(num_present_airs);\n777\t\n778\t        // Batched zerocheck metadata\n779\t        let mut zc_batch_metas: Vec<ZerocheckBatchMeta> = Vec::new();\n780\t        let mut zc_batch_x_blocks: Vec<u32> = Vec::new();\n781\t\n782\t        // Batched logup metadata + keep-alive buffers for per-AIR device data\n783\t        let mut logup_batch_metas: Vec<LogupBatchMeta> = Vec::new();\n784\t        let mut logup_batch_x_blocks: Vec<u32> = Vec::new();\n785\t        // Keep per-AIR logup device buffers alive until stream sync\n786\t        let mut logup_keepalive_rules: Vec<DeviceBuffer<u128>> = Vec::new();\n787\t        let mut logup_keepalive_numer_w: Vec<DeviceBuffer<EF>> = Vec::new();\n788\t        let mut logup_keepalive_denom_w: Vec<DeviceBuffer<EF>> = Vec::new();\n789\t\n790\t        // Sub-phase A: Classify AIRs and collect metadata\n791\t        for (trace_idx, ((air_idx, air_ctx), &n, selectors_cube, public_values, eq_3bs)) in izip!(\n792\t            &ctx.per_trace,\n793\t            