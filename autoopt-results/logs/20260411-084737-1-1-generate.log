{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0119R4vKvE6X3YGdUgWaKF4e","type":"tool_result","content":"440\t            }\n441\t            return Ok(addr);\n442\t        }\n443\t\n444\t        let addr = unsafe {\n445\t            vpmm_reserve(self.va_size, self.page_size).map_err(|_| MemoryError::ReserveFailed {\n446\t                size: self.va_size,\n447\t                page_size: self.page_size,\n448\t            })?\n449\t        };\n450\t        self.roots.push(addr);\n451\t        self.insert_unmapped_region(addr + requested as u64, self.va_size - requested);\n452\t        Ok(addr)\n453\t    }\n454\t\n455\t    /// Insert a hole back into the unmapped set, coalescing with neighbors.\n456\t    fn insert_unmapped_region(&mut self, mut addr: CUdeviceptr, mut size: usize) {\n457\t        if size == 0 {\n458\t            return;\n459\t        }\n460\t\n461\t        if let Some((&prev_addr, &prev_size)) = self.unmapped_regions.range(..addr).next_back() {\n462\t            if prev_addr + prev_size as u64 == addr {\n463\t                self.unmapped_regions.remove(&prev_addr);\n464\t                addr = prev_addr;\n465\t                size += prev_size;\n466\t            }\n467\t        }\n468\t\n469\t        if let Some((&next_addr, &next_size)) = self.unmapped_regions.range(addr + 1..).next() {\n470\t            if addr + size as u64 == next_addr {\n471\t                self.unmapped_regions.remove(&next_addr);\n472\t                size += next_size;\n473\t            }\n474\t        }\n475\t\n476\t        self.unmapped_regions.insert(addr, size);\n477\t    }\n478\t\n479\t    /// Roll back partially allocated pages when allocation fails.\n480\t    /// Unmaps and releases any mapped pages and restores the reserved VA span.\n481\t    fn rollback_new_pages(\n482\t        &mut self,\n483\t        reserved_ptr: CUdeviceptr,\n484\t        reserved_size: usize,\n485\t        allocated_pages: &[(CUdeviceptr, CUmemGenericAllocationHandle)],\n486\t    ) {\n487\t        for (addr, handle) in allocated_pages {\n488\t            if let Err(e) = unsafe { vpmm_unmap(*addr, self.page_size) } {\n489\t                tracing::error!(\n490\t                    \"rollback: vpmm_unmap failed: addr={:#x}, size={}: {:?}\",\n491\t                    addr,\n492\t                    self.page_size,\n493\t                    e\n494\t                );\n495\t            }\n496\t            self.active_pages.remove(addr);\n497\t            if let Err(e) = unsafe { vpmm_release(*handle) } {\n498\t                tracing::error!(\"rollback: vpmm_release failed: handle={}: {:?}\", handle, e);\n499\t            }"}]},"parent_tool_use_id":"toolu_01CxAp3cyzXvfpYeFo9ZYegw","session_id":"d346b169-4c5b-4579-98c0-3e4f65b0717e","uuid":"75a38c8c-d331-460b-a6ad-48d5af6bf86c","timestamp":"2026-04-11T07:03:49.178Z"}
