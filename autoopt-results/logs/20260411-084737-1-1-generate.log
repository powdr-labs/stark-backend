{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X2bTXAGwAh5FFtJ3CJZdoj","type":"tool_result","content":"1\t#include <cuda.h>\n2\t#include <cuda_runtime_api.h>\n3\t#include <stdint.h>\n4\t\n5\textern \"C\" {\n6\t\n7\t// Return 0 on success, else CUresult / cudaError_t code\n8\t\n9\tint _vpmm_check_support(int device_ordinal) {\n10\t    CUdevice dev;\n11\t    CUresult r = cuDeviceGet(&dev, device_ordinal);\n12\t    if (r != CUDA_SUCCESS) return (int)r;\n13\t    int vpmm = 0;\n14\t    r = cuDeviceGetAttribute(&vpmm, CU_DEVICE_ATTRIBUTE_VIRTUAL_MEMORY_MANAGEMENT_SUPPORTED, dev);\n15\t    if (r != CUDA_SUCCESS) return (int)r;\n16\t    return vpmm ? 0 : (int)CUDA_ERROR_NOT_SUPPORTED;\n17\t}\n18\t\n19\tint _vpmm_min_granularity(int device_ordinal, size_t* out) {\n20\t    if (!out) return (int)CUDA_ERROR_INVALID_VALUE;\n21\t    CUdevice dev;\n22\t    CUresult r = cuDeviceGet(&dev, device_ordinal);\n23\t    if (r != CUDA_SUCCESS) return (int)r;\n24\t\n25\t    CUmemAllocationProp prop{};\n26\t    prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;\n27\t    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;\n28\t    prop.location.id = device_ordinal;\n29\t    prop.requestedHandleTypes = CU_MEM_HANDLE_TYPE_NONE;\n30\t\n31\t    return (int)cuMemGetAllocationGranularity(out, &prop, CU_MEM_ALLOC_GRANULARITY_MINIMUM);\n32\t}\n33\t\n34\tint _vpmm_reserve(size_t size, size_t align, CUdeviceptr* out_va) {\n35\t    if (!out_va) return (int)CUDA_ERROR_INVALID_VALUE;\n36\t    return (int)cuMemAddressReserve(out_va, size, align, 0, 0);\n37\t}\n38\t\n39\tint _vpmm_release_va(CUdeviceptr base, size_t size) {\n40\t    return (int)cuMemAddressFree(base, size);\n41\t}\n42\t\n43\tint _vpmm_create_physical(int device_ordinal, size_t bytes, CUmemGenericAllocationHandle* out_h) {\n44\t    if (!out_h) return (int)CUDA_ERROR_INVALID_VALUE;\n45\t    CUmemAllocationProp prop{};\n46\t    prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;\n47\t    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;\n48\t    prop.location.id = device_ordinal;\n49\t    prop.requestedHandleTypes = CU_MEM_HANDLE_TYPE_NONE;\n50\t    return (int)cuMemCreate(out_h, bytes, &prop, 0);\n51\t}\n52\t\n53\tint _vpmm_map(CUdeviceptr va, size_t bytes, CUmemGenericAllocationHandle h) {\n54\t    return (int)cuMemMap(va, bytes, 0, h, 0);\n55\t}\n56\t\n57\tint _vpmm_set_access(CUdeviceptr va, size_t bytes, const int device_ordinal) {\n58\t    const CUmemAccessDesc acc = {\n59\t        .location = {\n60\t            .type = CU_MEM_LOCATION_TYPE_DEVICE,\n61\t            .id = device_ordinal\n62\t        },\n63\t        .flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE\n64\t    };\n65\t    return (int)cuMemSetAccess(va, bytes, &acc, 1);\n66\t}\n67\t\n68\tint _vpmm_unmap(CUdeviceptr va, size_t bytes) {\n69\t    return (int)cuMemUnmap(va, bytes);\n70\t}\n71\t\n72\tint _vpmm_release(CUmemGenericAllocationHandle h) {\n73\t    return (int)cuMemRelease(h);\n74\t}\n75\t\n76\t} // extern \"C\"\n77\t"}]},"parent_tool_use_id":"toolu_01CxAp3cyzXvfpYeFo9ZYegw","session_id":"d346b169-4c5b-4579-98c0-3e4f65b0717e","uuid":"aa72cf1f-5512-4703-9f2a-b5791f7c8eea","timestamp":"2026-04-11T07:03:00.295Z"}
