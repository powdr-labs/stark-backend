{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FeEaUFRL73TtPuqcE4v9ji","type":"tool_result","content":"1\tuse std::{env, process};\n2\t\n3\tuse openvm_cuda_backend::{\n4\t    logup_zerocheck::{fractional_sumcheck_gpu, make_synthetic_leaves},\n5\t    prelude::EF,\n6\t    sponge::DuplexSpongeGpu,\n7\t};\n8\tuse openvm_cuda_common::copy::MemCopyD2D;\n9\tuse p3_field::PrimeCharacteristicRing;\n10\t\n11\tfn parse_usize(var: &str, default: usize) -> usize {\n12\t    env::var(var)\n13\t        .ok()\n14\t        .and_then(|x| x.parse::<usize>().ok())\n15\t        .unwrap_or(default)\n16\t}\n17\t\n18\t/// All benchmarks output the same CSV format: `n,run_idx,is_warmup,elapsed_ms`\n19\tfn bench_fractional_sumcheck() -> Result<(), Box<dyn std::error::Error>> {\n20\t    let n = parse_usize(\"SWIRL_BENCH_N\", 24);\n21\t    let repeats = parse_usize(\"SWIRL_BENCH_REPEATS\", 3);\n22\t    let warmups = parse_usize(\"SWIRL_BENCH_WARMUPS\", 1);\n23\t\n24\t    let template = make_synthetic_leaves(n)?;\n25\t\n26\t    println!(\"run_idx,is_warmup,elapsed_ms\");\n27\t\n28\t    for run_idx in 0..(warmups + repeats) {\n29\t        let is_warmup = run_idx < warmups;\n30\t        let leaves = template.device_copy().expect(\"device copy leaves\");\n31\t\n32\t        let mut transcript = DuplexSpongeGpu::default();\n33\t        let mut mem = openvm_cuda_common::memory_manager::MemTracker::start(\"bench.fractional\");\n34\t\n35\t        openvm_cuda_common::stream::current_stream_sync().expect(\"sync before timing\");\n36\t        let t0 = std::time::Instant::now();\n37\t        let _ = fractional_sumcheck_gpu(&mut transcript, leaves, EF::ZERO, false, &mut mem)?;\n38\t        openvm_cuda_common::stream::current_stream_sync().expect(\"sync after timing\");\n39\t        let ms = t0.elapsed().as_secs_f64() * 1000.0;\n40\t\n41\t        println!(\"{run_idx},{},{:.4}\", is_warmup as u8, ms);\n42\t    }\n43\t\n44\t    Ok(())\n45\t}\n46\t\n47\t#[allow(clippy::type_complexity)]\n48\tconst BENCHMARKS: &[(&str, fn() -> Result<(), Box<dyn std::error::Error>>)] =\n49\t    &[(\"fractional-sumcheck\", bench_fractional_sumcheck)];\n50\t\n51\tfn main() {\n52\t    let args: Vec<String> = env::args().collect();\n53\t    if args.len() < 2 {\n54\t        eprintln!(\"Usage: bench <benchmark>\");\n55\t        eprintln!();\n56\t        eprintln!(\"Available benchmarks:\");\n57\t        for (name, _) in BENCHMARKS {\n58\t            eprintln!(\"  {name}\");\n59\t        }\n60\t        process::exit(1);\n61\t    }\n62\t\n63\t    let name = &args[1];\n64\t    for (bench_name, bench_fn) in BENCHMARKS {\n65\t        if name == bench_name {\n66\t            if let Err(e) = bench_fn() {\n67\t                eprintln!(\"Error: {e}\");\n68\t                process::exit(1);\n69\t            }\n70\t            return;\n71\t        }\n72\t    }\n73\t\n74\t    eprintln!(\"Unknown benchmark: {name}\");\n75\t    eprintln!();\n76\t    eprintln!(\"Available benchmarks:\");\n77\t    for (name, _) in BENCHMARKS {\n78\t        eprintln!(\"  {name}\");\n79\t    }\n80\t    process::exit(1);\n81\t}\n82\t"}]},"parent_tool_use_id":"toolu_01CxAp3cyzXvfpYeFo9ZYegw","session_id":"d346b169-4c5b-4579-98c0-3e4f65b0717e","uuid":"279e475f-f469-445e-bfab-4b34db07e67e","timestamp":"2026-04-11T07:03:12.023Z"}
