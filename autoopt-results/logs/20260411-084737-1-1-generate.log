 to device buffer with at least `num_x` elements representing\n949\t///   evaluations on hypercube.\n950\t#[allow(clippy::too_many_arguments)]\n951\tpub unsafe fn zerocheck_ntt_eval_constraints(\n952\t    tmp_sums_buffer: &mut DeviceBuffer<EF>,\n953\t    output: &mut DeviceBuffer<EF>,\n954\t    selectors_cube: &DeviceBuffer<F>,\n955\t    preprocessed: *const F,\n956\t    main_ptrs: &DeviceBuffer<*const F>,\n957\t    eq_cube: *const EF,\n958\t    lambda_pows: &DeviceBuffer<EF>,\n959\t    public_values: &DeviceBuffer<F>,\n960\t    rules: &DeviceBuffer<u128>,\n961\t    used_nodes: &DeviceBuffer<usize>,\n962\t    buffer_size: u32,\n963\t    intermediates: &mut DeviceBuffer<F>,\n964\t    skip_domain: u32,\n965\t    num_x: u32,\n966\t    height: u32,\n967\t    num_cosets: u32,\n968\t    g_shift: F,\n969\t    max_temp_bytes: usize,\n970\t) -> Result<(), CudaError> {\n971\t    CudaError::from_result(_zerocheck_ntt_eval_constraints(\n972\t        tmp_sums_buffer.as_mut_ptr(),\n973\t        output.as_mut_ptr(),\n974\t        selectors_cube.as_ptr(),\n975\t        preprocessed,\n976\t        main_ptrs.as_ptr(),\n977\t        eq_cube,\n978\t        lambda_pows.as_ptr(),\n979\t        public_values.as_ptr(),\n980\t        rules.as_raw_ptr(),\n981\t        rules.len(),\n982\t        used_nodes.as_ptr(),\n983\t        used_nodes.len(),\n984\t        lambda_pows.len(),\n985\t        buffer_size,\n986\t        intermediates.as_mut_ptr(),\n987\t        skip_domain,\n988\t        num_x,\n989\t        height,\n990\t        num_cosets,\n991\t        g_shift,\n992\t        max_temp_bytes,\n993\t    ))\n994\t}\n995\t\n996\t/// # Safety\n997\t/// - `buffer_size` does not refer to the capacity of `intermediates`. It refers to \"how many DAG\n998\t///   nodes per row need to be buffered\". The capacity is a multiple of `buffer_size` which is\n999\t///   runtime calculated based on `buffer_size`.\n1000\t/// - `eq_cube` must be a pointer to device buffer with at least `num_x` elements representing\n1001\t///   evaluations on hypercube.\n1002\t/// - `output` will not be written to by this function. Only `tmp_sums_buffer` is written.\n1003\t#[allow(clippy::too_many_arguments)]\n1004\tpub unsafe fn logup_bary_eval_interactions_round0(\n1005\t    tmp_sums_buffer: &mut DeviceBuffer<Frac<EF>>,\n1006\t    output: &mut DeviceBuffer<Frac<EF>>,\n1007\t    selectors_cube: &DeviceBuffer<F>,\n1008\t    preprocessed: *const F,\n1009\t    main_ptrs: &DeviceBuffer<*const F>,\n1010\t    eq_cube: *const EF,\n1011\t    public_values: &DeviceBuffer<F>,\n1012\t    numer_weights: &DeviceBuffer<EF>,\n1013\t    denom_weights: &DeviceBuffer<EF>,\n1014\t    denom_sum_init: EF,\n1015\t    rules: &DeviceBuffer<u128>,\n1016\t    buffer_size: u32,\n1017\t    intermediates: &mut DeviceBuffer<F>,\n1018\t    skip_domain: u32,\n1019\t    num_x: u32,\n1020\t    height: u32,\n1021\t    num_cosets: u32,\n1022\t    g_shift: F,\n1023\t    max_temp_bytes: usize,\n1024\t) -> Result<(), CudaError> {\n1025\t    CudaError::from_result(_logup_bary_eval_interactions_round0(\n1026\t        tmp_sums_buffer.as_mut_ptr(),\n1027\t        output.as_mut_ptr(),\n1028\t        selectors_cube.as_ptr(),\n1029\t        preprocessed,\n1030\t        main_ptrs.as_ptr(),\n1031\t        eq_cube,\n1032\t        public_values.as_ptr(),\n1033\t        numer_weights.as_ptr(),\n1034\t        denom_weights.as_ptr(),\n1035\t        denom_sum_init,\n1036\t        rules.as_raw_ptr(),\n1037\t        rules.len(),\n1038\t        buffer_size,\n1039\t        intermediates.as_mut_ptr(),\n1040\t        skip_domain,\n1041\t        num_x,\n1042\t        height,\n1043\t        num_cosets,\n1044\t        g_shift,\n1045\t        max_temp_bytes,\n1046\t    ))\n1047\t}\n1048\t\n1049\t/// Batched coset-parallel zerocheck evaluation for multiple small AIRs.\n1050\t#[allow(clippy::too_many_arguments)]\n1051\tpub unsafe fn zerocheck_ntt_eval_constraints_batched(\n1052\t    tmp_sums_buffer: &mut DeviceBuffer<EF>,\n1053\t    output: &mut Device