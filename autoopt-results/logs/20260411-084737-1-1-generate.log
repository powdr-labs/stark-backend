{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HqMApiKrU1qo33XzA64DKE","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    sync::Arc,\n15\t};\n16\t\n17\tuse itertools::{izip, Itertools};\n18\tuse openvm_cuda_common::{\n19\t    copy::{MemCopyD2H, MemCopyH2D},\n20\t    d_buffer::DeviceBuffer,\n21\t    error::MemCopyError,\n22\t    memory_manager::MemTracker,\n23\t    stream::current_stream_sync,\n24\t};\n25\tuse openvm_stark_backend::{\n26\t    air_builders::symbolic::SymbolicConstraints,\n27\t    calculate_n_logup,\n28\t    dft::Radix2BowersSerial,\n29\t    p3_matrix::dense::RowMajorMatrix,\n30\t    poly_common::{\n31\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n32\t        UnivariatePoly,\n33\t    },\n34\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n35\t    prover::{\n36\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n37\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, DeviceMultiStarkProvingKey,\n38\t        MatrixDimensions, ProvingContext,\n39\t    },\n40\t};\n41\tuse p3_dft::TwoAdicSubgroupDft;\n42\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n43\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n44\tuse rustc_hash::FxHashMap;\n45\tuse tracing::{debug, info, info_span, instrument};\n46\t\n47\tuse crate::{\n48\t    base::DeviceMatrix,\n49\t    cuda::{\n50\t        logup_zerocheck::{fold_selectors_round0, interpolate_columns_gpu, MainMatrixPtrs},\n51\t        sumcheck::batch_fold_mle,\n52\t    },\n53\t    data_transporter::transport_matrix_d2h_col_major,\n54\t    error::LogupZerocheckError,\n55\t    gpu_backend::GenericGpuBackend,\n56\t    hash_scheme::GpuHashScheme,\n57\t    logup_zerocheck::{\n58\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n59\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n60\t    },\n61\t    poly::EqEvalLayers,\n62\t    prelude::{EF, F},\n63\t    sponge::GpuFiatShamirTranscript,\n64\t    utils::compute_barycentric_inv_lagrange_denoms,\n65\t};\n66\t\n67\tpub(crate) mod batch_mle;\n68\tpub(crate) mod batch_mle_monomial;\n69\tmod errors;\n70\tpub(crate) mod fold_ple;\n71\t/// Fraction sumcheck via GKR\n72\tmod fractional;\n73\t/// Logup interaction evaluations for GKR input\n74\tmod gkr_input;\n75\tmod mle_round;\n76\tmod round0;\n77\tpub(crate) mod rules;\n78\t\n79\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n80\tuse batch_mle_monomial::{\n81\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n82\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n83\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n84\t};\n85\tpub use errors::*;\n86\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n87\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n88\tuse round0::{\n89\t    evaluate_round0_constraints_gpu, LogupBatchMeta, ZerocheckBatchMeta, BUFFER_THRESHOLD,\n90\t    COSET_PARALLEL_THRESHOLD, MAX_THREADS_ROUND0,\n91\t};\n92\t\n93\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n94\t/// instead of the monomial kernel for high num_y traces.\n95\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n96\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n97\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n98\t\n99\t#[inline]\n100\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n101\t    if need_rot {\n102\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n103\t        (mat_width / 2) as u32\n104\t    } else {\n105\t        mat_width as u32\n106\t    }\n107\t}\n108\t\n109\t#[allow(clippy::type_complexity)]\n110\t#[instrument(level = \"info\", skip_all)]\n111\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n112\t    transcript: &mut TS,\n113\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n114\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n115\t    save_memory: bool,\n116\t    monomial_num_y_threshold: u32,\n117\t    sm_count: u32,\n118\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n119\twhere\n120\t    HS: GpuHashScheme,\n121\t    TS: GpuFiatShamirTranscript<HS::SC>,\n122\t{\n123\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n124\t    let l_skip = mpk.params.l_skip;\n125\t    let constraint_degree = mpk.max_constraint_degree;\n126\t    let num_traces = ctx.per_trace.len();\n127\t\n128\t    // Traces are sorted\n129\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n130\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n131\t    // heights\n132\t    let mut total_interactions = 0u64;\n133\t    let interactions_meta: Vec<_> = ctx\n134\t        .per_trace\n135\t        .iter()\n136\t        .map(|(air_idx, air_ctx)| {\n137\t            let pk = &mpk.per_air[*air_idx];\n138\t\n139\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n140\t            let height = air_ctx.common_main.height();\n141\t            let log_height = log2_strict_usize(height);\n142\t            let log_lifted_height = log_height.max(l_skip);\n143\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n144\t            (num_interactions, log_lifted_height)\n145\t        })\n146\t        .collect();\n147\t    // Implicitly, the width of this stacking should be 1\n148\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n149\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n150\t    // GKR\n151\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n152\t\n153\t    // Grind to increase soundness of random sampling for LogUp\n154\t    let logup_pow_witness = transcript\n155\t        .grind_gpu(mpk.params.logup.pow_bits)\n156\t        .map_err(LogupZerocheckError::Grind)?;\n157\t    let alpha_logup = transcript.sample_ext();\n158\t    let beta_logup = transcript.sample_ext();\n159\t    debug!(%alpha_logup, %beta_logup);\n160\t\n161\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n162\t    let mut prover = LogupZerocheckGpu::new(\n163\t        mpk,\n164\t        ctx,\n165\t        n_logup,\n166\t        interactions_layout,\n167\t        alpha_logup,\n168\t        beta_logup,\n169\t        save_memory,\n170\t        monomial_num_y_threshold,\n171\t        sm_count,\n172\t    )?;\n173\t    let n_global = prover.n_global;\n174\t\n175\t    let total_leaves = 1 << (l_skip + n_logup);\n176\t    prover\n177\t        .mem\n178\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n179\t    prover.mem.reset_peak();\n180\t    let (inputs, alpha) = if has_interactions {\n181\t        log_gkr_input_evals(\n182\t            &prover.trace_interactions,\n183\t            mpk,\n184\t            ctx,\n185\t            l_skip,\n186\t            alpha_logup,\n187\t            &prover.d_challenges,\n188\t            total_leaves,\n189\t        )?\n190\t    } else {\n191\t        (DeviceBuffer::new(), EF::ZERO)\n192\t    };\n193\t    // Set memory limit for batch MLE based on inputs buffer size\n194\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n195\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n196\t    if !prover.save_memory {\n197\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n198\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n199\t            tracing::warn!(\n200\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n201\t                prover.memory_limit_bytes\n202\t            );\n203\t        }\n204\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n205\t    }\n206\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n207\t\n208\t    let (frac_sum_proof, mut xi) =\n209\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n210\t    while xi.len() != l_skip + n_global {\n211\t        xi.push(transcript.sample_ext());\n212\t    }\n213\t    debug!(?xi);\n214\t    prover.xi = xi;\n215\t\n216\t    logup_gkr_span.exit();\n217\t\n218\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does\n219\t    // not include the kernel times for the actual folding\n220\t    let round0_span = info_span!(\"prover.rap_constraints.round0\", phase = \"prover\").entered();\n221\t    // begin batch sumcheck\n222\t    let mut sumcheck_round_polys = Vec::with_capacity(n_max);\n223\t    let mut r = Vec::with_capacity(n_max + 1);\n224\t    // batching randomness\n225\t    let lambda = transcript.sample_ext();\n226\t    debug!(%lambda);\n227\t\n228\t    let sp_0_polys = prover.sumcheck_uni_round0_polys(ctx, lambda)?;\n229\t    let s_0_cpu_span = info_span!(\"s'_0 -> s_0 cpu interpolations\").entered();\n230\t    let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_degree);\n231\t    let s_deg = constraint_degree + 1;\n232\t    let s_0_deg = sumcheck_round0_deg(l_skip, s_deg);\n233\t    let large_uni_domain = (s_0_deg + 1).next_power_of_two();\n234\t    let dft = Radix2BowersSerial;\n235\t    let s_0_logup_polys = {\n236\t        let eq_sharp_uni = eq_sharp_uni_poly(&prover.xi[..l_skip]);\n237\t        let mut eq_coeffs = eq_sharp_uni.into_coeffs();\n238\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n239\t        let eq_evals = dft.dft(eq_coeffs);\n240\t\n241\t        let width = 2 * num_traces;\n242\t        let mut sp_coeffs_mat = EF::zero_vec(width * large_uni_domain);\n243\t        for (i, coeffs) in sp_0_polys[..2 * num_traces].iter().enumerate() {\n244\t            for (j, &c_j) in coeffs.coeffs().iter().enumerate().take(sp_0_deg + 1) {\n245\t                // SAFETY:\n246\t                // - coeffs length is <= sp_0_deg + 1 <= s_0_deg < large_uni_domain\n247\t                // - sp_coeffs_mat allocated for width\n248\t                unsafe {\n249\t                    *sp_coeffs_mat.get_unchecked_mut(j * width + i) = c_j;\n250\t                }\n251\t            }\n252\t        }\n253\t        let mut s_evals = dft.dft_batch(RowMajorMatrix::new(sp_coeffs_mat, width));\n254\t        for (eq, row) in zip(eq_evals, s_evals.values.chunks_mut(width)) {\n255\t            for x in row {\n256\t                *x *= eq;\n257\t            }\n258\t        }\n259\t        dft.idft_batch(s_evals)\n260\t    };\n261\t    let skip_domain_size = F::from_usize(1 << l_skip);\n262\t    // logup sum claims (sum_{\\hat p}, sum_{\\hat q}) per present AIR\n263\t    let (numerator_term_per_air, denominator_term_per_air): (Vec<_>, Vec<_>) = (0..num_traces)\n264\t        .map(|trace_idx| {\n265\t            let [sum_claim_p, sum_claim_q] = [0, 1].map(|is_denom| {\n266\t                // Compute sum over D of s_0(Z) to get the sum claim\n267\t                (0..=s_0_deg)\n268\t                    .step_by(1 << l_skip)\n269\t                    .map(|j| unsafe {\n270\t                        // SAFETY: matrix is 2 * num_trace x large_uni_domain, s_0_deg <\n271\t                        // large_uni_domain\n272\t                        *s_0_logup_polys\n273\t                            .values\n274\t                            .get_unchecked(j * 2 * num_traces + 2 * trace_idx + is_denom)\n275\t                    })\n276\t                    .sum::<EF>()\n277\t                    * skip_domain_size\n278\t            });\n279\t            transcript.observe_ext(sum_claim_p);\n280\t            transcript.observe_ext(sum_claim_q);\n281\t\n282\t            (sum_claim_p, sum_claim_q)\n283\t        })\n284\t        .unzip();\n285\t\n286\t    let mu = transcript.sample_ext();\n287\t    debug!(%mu);\n288\t    let mu_pows = mu.powers().take(3 * num_traces).collect_vec();\n289\t\n290\t    let s_0_zc_poly = {\n291\t        let eq_uni = eq_uni_poly::<F, _>(l_skip, prover.xi[0]);\n292\t        let mut eq_coeffs = eq_uni.into_coeffs();\n293\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n294\t        let eq_evals = dft.dft(eq_coeffs);\n295\t\n296\t        // Algebraically batch\n297\t        let mut sp_coeffs = EF::zero_vec(large_uni_domain);\n298\t        let mus = &mu_pows[2 * num_traces..];\n299\t        let polys = &sp_0_polys[2 * num_traces..];\n300\t        for (j, batch_coeff) in sp_coeffs.iter_mut().enumerate().take(sp_0_deg + 1) {"}]},"parent_tool_use_id":"toolu_01H5RjoMez6G6m2AVL4Mbk17","session_id":"d346b169-4c5b-4579-98c0-3e4f65b0717e","uuid":"803fafa7-aea8-45f4-a119-245571c34aaa","timestamp":"2026-04-11T07:19:12.496Z"}
