{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SHBuXCXjmSEM47YYBXGfpT","type":"tool_result","content":"250\t        return GkrRoundStrategy::FoldEval;\n251\t    }\n252\t\n253\t    GkrRoundStrategy::PrecomputeM\n254\t}\n255\t\n256\tfn eval_mle_table(points: &[EF], out: &mut [EF]) {\n257\t    // w <= 5 so CPU builds are trivial; avoid GPU kernel/alloc overhead for tiny tables.\n258\t    let n = points.len();\n259\t    let size = 1usize << n;\n260\t    debug_assert!(out.len() >= size);\n261\t    for (bits, dst) in out.iter_mut().enumerate().take(size) {\n262\t        let mut acc = EF::ONE;\n263\t        for (i, &x) in points.iter().enumerate() {\n264\t            let bit = ((bits >> (n - 1 - i)) & 1) == 1;\n265\t            acc *= if bit { x } else { EF::ONE - x };\n266\t        }\n267\t        *dst = acc;\n268\t    }\n269\t}\n270\t\n271\t/// Get low/high eq pointers for the tail portion of the eq buffer, skipping `drop_count` layers.\n272\t/// See `docs/cuda-backend/gkr-prover.md` § \"Eq buffer sqrt decomposition\".\n273\tfn eq_tail_ptrs(\n274\t    eq_buffer: &SqrtEqLayers,\n275\t    drop_count: usize,\n276\t) -> (*const EF, *const EF, usize, usize) {\n277\t    let mut high_n = eq_buffer.high_n();\n278\t    let mut low_n = eq_buffer.low_n();\n279\t    let total_n = high_n + low_n;\n280\t    if drop_count >= total_n {\n281\t        return (std::ptr::null(), std::ptr::null(), 1, 0);\n282\t    }\n283\t    if drop_count <= high_n {\n284\t        high_n -= drop_count;\n285\t    } else {\n286\t        low_n -= drop_count - high_n;\n287\t        high_n = 0;\n288\t    }\n289\t    let tail_n = low_n + high_n;\n290\t    if tail_n == 0 {\n291\t        (std::ptr::null(), std::ptr::null(), 1, 0)\n292\t    } else {\n293\t        (\n294\t            eq_buffer.low.get_ptr(low_n),\n295\t            eq_buffer.high.get_ptr(high_n),\n296\t            1 << low_n,\n297\t            tail_n,\n298\t        )\n299\t    }\n300\t}\n301\t\n302\tfn copy_to_device_ptr<T: Copy>(dst: *mut T, src: &[T]) -> Result<(), FractionalSumcheckError> {\n303\t    if src.is_empty() {\n304\t        return Ok(());\n305\t    }\n306\t    unsafe {\n307\t        cuda_memcpy::<false, true>(\n308\t            dst as *mut c_void,\n309\t            src.as_ptr() as *const c_void,\n310\t            std::mem::size_of_val(src),\n311\t        )?;\n312\t    }\n313\t    Ok(())\n314\t}\n315\t\n316\t/// Observes s_evals in transcript, updates accumulators, and returns the sampled challenge.\n317\t#[allow(clippy::too_many_arguments)]\n318\tfn observe_and_update<SC, TS>(\n319\t    d_sum_evals: &DeviceBuffer<EF>,\n320\t    transcript: &mut TS,\n321\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n322\t    r_vec: &mut Vec<EF>,\n323\t    prev_s_eval: &mut EF,\n324\t    xi_j: EF,\n325\t    eq_r_acc: &mut EF,\n326\t) -> Result<EF, FractionalSumcheckError>\n327\twhere\n328\t    SC: StarkProtocolConfig<EF = EF>,\n329\t    TS: FiatShamirTranscript<SC>,\n330\t{\n331\t    let (s_evals, sp_evals) = reconstruct_s_evals(d_sum_evals, *prev_s_eval, xi_j, *eq_r_acc)?;\n332\t\n333\t    for &eval in &s_evals {\n334\t        transcript.observe_ext(eval);\n335\t    }\n336\t    round_polys_eval.push(s_evals);\n337\t\n338\t    let r = transcript.sample_ext();\n339\t    r_vec.push(r);\n340\t\n341\t    let eq_r = eval_eq_mle(&[xi_j], &[r]);\n342\t    *eq_r_acc *= eq_r;\n343\t    *prev_s_eval = eq_r * interpolate_quadratic_at_012(&sp_evals, r);\n344\t\n345\t    Ok(r)\n346\t}\n347\t\n348\t/// Fused revert + compute round: reverts the tree layer and computes s'_0(1) and s'_0(2).\n349\t///\n350\t/// See `docs/cuda-backend/gkr-prover.md` § \"Sumcheck round strategies\" for context.\n351\t#[allow(clippy::too_many_arguments)]\n352\tfn do_sumcheck_round_and_revert<SC, TS>(\n353\t    eq_buffer: &mut SqrtEqLayers,\n354\t    layer: &mut DeviceBuffer<Frac<EF>>,\n355\t    pq_size: usize,\n356\t    lambda: EF,\n357\t    transcript: &mut TS,\n358\t    d_sum_evals: &mut DeviceBuffer<EF>,\n359\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n360\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n361\t    r_vec: &mut Vec<EF>,\n362\t    prev_s_eval: &mut EF,\n363\t    xi_j: EF,\n364\t    eq_r_acc: &mut EF,\n365\t) -> Result<EF, FractionalSumcheckError>\n366\twhere\n367\t    SC: StarkProtocolConfig<EF = EF>,\n368\t    TS: FiatShamirTranscript<SC>,\n369\t{\n370\t    unsafe {\n371\t        frac_compute_round_and_revert(\n372\t            eq_buffer,\n373\t            layer,\n374\t            pq_size / 2,\n375\t            lambda,\n376\t            d_sum_evals,\n377\t            tmp_block_sums,\n378\t        )\n379\t        .map_err(FractionalSumcheckError::ComputeRound)?;\n380\t    }\n381\t    eq_buffer.drop_layer();\n382\t    observe_and_update(\n383\t        d_sum_evals,\n384\t        transcript,\n385\t        round_polys_eval,\n386\t        r_vec,\n387\t        prev_s_eval,\n388\t        xi_j,\n389\t        eq_r_acc,\n390\t    )\n391\t}\n392\t\n393\t/// Fused compute round: computes s' polynomial AND folds the pq_buffer for next round.\n394\t///\n395\t/// This kernel fuses the fold operation (using `r_prev` from the previous round) into the current\n396\t/// round's compute, eliminating one kernel launch and reducing memory traffic.\n397\t#[allow(clippy::too_many_arguments)]\n398\tfn do_fused_sumcheck_round<SC, TS>(\n399\t    eq_buffer: &mut SqrtEqLayers,\n400\t    src_pq_buffer: &DeviceBuffer<Frac<EF>>,\n401\t    dst_pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n402\t    src_pq_size: usize,\n403\t    lambda: EF,\n404\t    r_prev: EF,\n405\t    transcript: &mut TS,\n406\t    d_sum_evals: &mut DeviceBuffer<EF>,\n407\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n408\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n409\t    r_vec: &mut Vec<EF>,\n410\t    prev_s_eval: &mut EF,\n411\t    xi_j: EF,\n412\t    eq_r_acc: &mut EF,\n413\t) -> Result<EF, FractionalSumcheckError>\n414\twhere\n415\t    SC: StarkProtocolConfig<EF = EF>,\n416\t    TS: FiatShamirTranscript<SC>,\n417\t{\n418\t    unsafe {\n419\t        frac_compute_round_and_fold(\n420\t            eq_buffer,\n421\t            src_pq_buffer,\n422\t            dst_pq_buffer,\n423\t            src_pq_size,\n424\t            lambda,\n425\t            r_prev,\n426\t            d_sum_evals,\n427\t            tmp_block_sums,\n428\t        )\n429\t        .map_err(FractionalSumcheckError::ComputeRound)?;\n430\t    }\n431\t    eq_buffer.drop_layer();\n432\t    observe_and_update(\n433\t        d_sum_evals,\n434\t        transcript,\n435\t        round_polys_eval,\n436\t        r_vec,\n437\t        prev_s_eval,\n438\t        xi_j,\n439\t        eq_r_acc,\n440\t    )\n441\t}\n442\t\n443\t/// In-place variant of [`do_fused_sumcheck_round`]. Reads and writes to the same buffer.\n444\t#[allow(clippy::too_many_arguments)]\n445\tfn do_fused_sumcheck_round_inplace<SC, TS>(\n446\t    eq_buffer: &mut SqrtEqLayers,\n447\t    pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n448\t    src_pq_size: usize,\n449\t    lambda: EF,\n450\t    r_prev: EF,\n451\t    transcript: &mut TS,\n452\t    d_sum_evals: &mut DeviceBuffer<EF>,\n453\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n454\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n455\t    r_vec: &mut Vec<EF>,\n456\t    prev_s_eval: &mut EF,\n457\t    xi_j: EF,\n458\t    eq_r_acc: &mut EF,\n459\t) -> Result<EF, FractionalSumcheckError>\n460\twhere\n461\t    SC: StarkProtocolConfig<EF = EF>,\n462\t    TS: FiatShamirTranscript<SC>,\n463\t{\n464\t    unsafe {\n465\t        frac_compute_round_and_fold_inplace(\n466\t            eq_buffer,\n467\t            pq_buffer,\n468\t            src_pq_size,\n469\t            lambda,\n470\t            r_prev,\n471\t            d_sum_evals,\n472\t            tmp_block_sums,\n473\t        )\n474\t        .map_err(FractionalSumcheckError::ComputeRound)?;\n475\t    }\n476\t    eq_buffer.drop_layer();\n477\t    observe_and_update(\n478\t        d_sum_evals,\n479\t        transcript,\n480\t        round_polys_eval,\n481\t        r_vec,\n482\t        prev_s_eval,\n483\t        xi_j,\n484\t        eq_r_acc,\n485\t    )\n486\t}\n487\t\n488\t/// GKR fractional sumcheck prover. See `docs/cuda-backend/gkr-prover.md` (repo root) for the\n489\t/// protocol and implementation details.\n490\t#[instrument(skip_all)]\n491\tpub fn fractional_sumcheck_gpu<SC, TS>(\n492\t    transcript: &mut TS,\n493\t    leaves: DeviceBuffer<Frac<EF>>,\n494\t    alpha: EF,\n495\t    assert_zero: bool,\n496\t    mem: &mut MemTracker,\n497\t) -> Result<(FracSumcheckProof<SC>, Vec<EF>), FractionalSumcheckError>\n498\twhere\n499\t    SC: StarkProtocolConfig<EF = EF>,\n500\t    TS: FiatShamirTranscript<SC>,\n501\t{\n502\t    let mut layer = leaves;\n503\t    if layer.is_empty() {\n504\t        return Ok((\n505\t            FracSumcheckProof {\n506\t                fractional_sum: (EF::ZERO, EF::ONE),\n507\t                claims_per_layer: vec![],\n508\t                sumcheck_polys: vec![],\n509\t            },\n510\t            vec![],\n511\t        ));\n512\t    };\n513\t    let total_leaves = layer.len();\n514\t    // total_rounds = l_skip + n_logup\n515\t    let total_rounds = log2_strict_usize(total_leaves);\n516\t    assert!(total_rounds > 0, \"n_logup > 0 when there are interactions\");\n517\t    // Build segment tree.\n518\t    // - We only maintain the current layer\n519\t    // - Input layer uses separate F and EF buffers to save memory\n520\t    // - First tree layer converts (F, EF) to FracExt (EF, EF)\n521\t\n522\t    // We store it in bit-reversal order for coalesced memory accesses.\n523\t    // For large N (> 1024), fuse bitrev + tree layers 0 and 1 into a single kernel pass,\n524\t    // eliminating ~1.5N global memory reads. For small N, fall back to separate operations.\n525\t    let start_layer_i = if total_leaves > 1024 {\n526\t        unsafe {\n527\t            // SAFETY: Frac<EF> has exact same memory layout and alignment as (EF, EF).\n528\t            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n529\t            bit_rev_frac_ext_build_k2(buf, total_rounds as u32, alpha)\n530\t                .map_err(FractionalSumcheckError::BitReversal)?;\n531\t        }\n532\t        2 // layers 0+1 already done\n533\t    } else {\n534\t        // Fallback: separate bitrev + layer 0.\n535\t        unsafe {\n536\t            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n537\t            bit_rev_frac_ext(\n538\t                buf,\n539\t                buf,\n540\t                total_rounds as u32,\n541\t                total_leaves.try_into().unwrap(),\n542\t                1,\n543\t            )\n544\t            .map_err(FractionalSumcheckError::BitReversal)?;\n545\t            frac_build_tree_layer(&mut layer, total_leaves, false, alpha, true)\n546\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n547\t            use crate::cuda::logup_zerocheck::frac_add_alpha;\n548\t            let half = total_leaves / 2;\n549\t            let second_half_ptr = layer.as_mut_raw_ptr() as *mut Frac<EF>;"}]},"parent_tool_use_id":"toolu_01H5RjoMez6G6m2AVL4Mbk17","session_id":"d346b169-4c5b-4579-98c0-3e4f65b0717e","uuid":"54eb361b-5241-49c2-8144-04663b479ab1","timestamp":"2026-04-11T07:19:38.609Z"}
