{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BNMZsomGhaEzzoeHDGUhQa","type":"tool_result","content":"1\t//! Batch MLE evaluation for zerocheck and logup.\n2\t//!\n3\t//! This module provides builders for batching MLE evaluations across multiple AIRs,\n4\t//! enabling efficient GPU kernel launches that process multiple traces in parallel.\n5\t\n6\tuse openvm_cuda_common::{\n7\t    copy::{MemCopyD2H, MemCopyH2D},\n8\t    d_buffer::DeviceBuffer,\n9\t    error::MemCopyError,\n10\t};\n11\tuse openvm_stark_backend::prover::{fractional_sumcheck_gkr::Frac, DeviceMultiStarkProvingKey};\n12\t\n13\tuse crate::{\n14\t    cuda::logup_zerocheck::{\n15\t        _logup_batch_mle_intermediates_buffer_size, _zerocheck_batch_mle_intermediates_buffer_size,\n16\t        logup_batch_eval_mle, zerocheck_batch_eval_mle, BlockCtx, EvalCoreCtx, LogupCtx,\n17\t        MainMatrixPtrs, ZerocheckCtx,\n18\t    },\n19\t    error::KernelError,\n20\t    gpu_backend::GenericGpuBackend,\n21\t    hash_scheme::GpuHashScheme,\n22\t    logup_zerocheck::{\n23\t        batch_mle_monomial::{LogupCombinations, LogupMonomialBatch},\n24\t        mle_round::{evaluate_mle_constraints_gpu, evaluate_mle_interactions_gpu},\n25\t    },\n26\t    prelude::{EF, F},\n27\t};\n28\t\n29\tconst MAX_THREADS_PER_BLOCK: u32 = 128;\n30\t\n31\t// ============================================================================\n32\t// Memory calculation helpers\n33\t// ============================================================================\n34\t\n35\t/// Computes zerocheck intermediate buffer memory in bytes for a trace.\n36\tfn zerocheck_batch_mle_intermediates_buffer_bytes(\n37\t    buffer_size: u32,\n38\t    num_x: u32,\n39\t    num_y: u32,\n40\t) -> usize {\n41\t    unsafe {\n42\t        _zerocheck_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n43\t            * std::mem::size_of::<EF>()\n44\t    }\n45\t}\n46\t\n47\t/// Computes logup intermediate buffer memory in bytes for a trace.\n48\tfn logup_batch_mle_intermediates_buffer_bytes(buffer_size: u32, num_x: u32, num_y: u32) -> usize {\n49\t    unsafe {\n50\t        _logup_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n51\t            * std::mem::size_of::<EF>()\n52\t    }\n53\t}\n54\t\n55\t// ============================================================================\n56\t// Batching helpers\n57\t// ============================================================================\n58\t\n59\t/// Find how many traces fit in the memory budget.\n60\t/// Returns (count, total_memory_of_batch).\n61\tfn find_batch_end<T, M>(traces: &[T], memory_fn: M, memory_limit_bytes: usize) -> (usize, usize)\n62\twhere\n63\t    M: Fn(&T) -> usize,\n64\t{\n65\t    let mut batch_end = 0;\n66\t    let mut batch_memory = 0usize;\n67\t\n68\t    while batch_end < traces.len() {\n69\t        let trace_memory = memory_fn(&traces[batch_end]);\n70\t\n71\t        if batch_end == 0 {\n72\t            // First trace always included (even if oversized)\n73\t            batch_memory = trace_memory;\n74\t            batch_end = 1;\n75\t            if trace_memory > memory_limit_bytes {\n76\t                break; // Single oversized trace\n77\t            }\n78\t        } else if batch_memory + trace_memory <= memory_limit_bytes {\n79\t            batch_memory += trace_memory;\n80\t            batch_end += 1;\n81\t        } else {\n82\t            break; // Would exceed limit\n83\t        }\n84\t    }\n85\t    (batch_end, batch_memory)\n86\t}\n87\t\n88\t/// Context for a single trace used in batch MLE evaluation.\n89\tpub(crate) struct TraceCtx {\n90\t    pub trace_idx: usize,\n91\t    pub air_idx: usize,\n92\t    #[allow(dead_code)]\n93\t    pub n_lift: usize,\n94\t    pub num_y: u32,\n95\t    pub has_constraints: bool,\n96\t    pub has_interactions: bool,\n97\t    pub norm_factor: F,\n98\t    // shared eval pointers (same for zerocheck + logup)\n99\t    pub eq_xi_ptr: *const EF,\n100\t    pub sels_ptr: *const EF,\n101\t    pub prep_ptr: MainMatrixPtrs<EF>,\n102\t    pub main_ptrs_dev: DeviceBuffer<MainMatrixPtrs<EF>>,\n103\t    pub public_ptr: *const F,\n104\t    pub eq_3bs_ptr: *const EF,\n105\t}\n106\t\n107\t// NOTE[jpw]: we do not expect to use this since most of the time zerocheck will use monomial_par_y.\n108\t// We use DAG evaluation primarily for Poseidon2Air. Consider deleting either the non-batch or batch\n109\t// dag version to reduce code duplication.\n110\t/// Builder for batched zerocheck MLE evaluation.\n111\t///\n112\t/// Collects traces and pre-builds all GPU contexts, then evaluates in a single kernel launch.\n113\tpub(crate) struct ZerocheckMleBatchBuilder<'a> {\n114\t    traces: Vec<&'a TraceCtx>,\n115\t    d_block_ctxs: DeviceBuffer<BlockCtx>,\n116\t    d_zc_ctxs: DeviceBuffer<ZerocheckCtx>,\n117\t    air_offsets: DeviceBuffer<u32>,\n118\t    threads_per_block: u32,\n119\t    _intermediates_keepalive: Vec<DeviceBuffer<EF>>,\n120\t}\n121\t\n122\timpl<'a> ZerocheckMleBatchBuilder<'a> {\n123\t    /// Creates a new builder from an iterator of traces.\n124\t    ///\n125\t    /// This constructor filters traces with constraints, computes thread configuration,\n126\t    /// builds all block and zerocheck contexts, and uploads them to the device.\n127\t    pub fn new<HS: GpuHashScheme>(\n128\t        traces: impl Iterator<Item = &'a TraceCtx>,\n129\t        pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n130\t        num_x: u32,\n131\t    ) -> Result<Self, MemCopyError> {\n132\t        let traces: Vec<&TraceCtx> = traces.filter(|t| t.has_constraints).collect();\n133\t\n134\t        if traces.is_empty() {\n135\t            return Ok(Self {\n136\t                traces: vec![],\n137\t                d_block_ctxs: DeviceBuffer::new(),\n138\t                d_zc_ctxs: DeviceBuffer::new(),\n139\t                air_offsets: DeviceBuffer::new(),\n140\t                threads_per_block: 0,\n141\t                _intermediates_keepalive: vec![],\n142\t            });\n143\t        }\n144\t\n145\t        // Compute threads_per_block from max_num_y\n146\t        let max_num_y = traces.iter().map(|t| t.num_y).max().unwrap_or(0);\n147\t        let threads_per_block = max_num_y.min(MAX_THREADS_PER_BLOCK);\n148\t\n149\t        // Build block_ctxs and air_offsets\n150\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();"}]},"parent_tool_use_id":"toolu_01H5RjoMez6G6m2AVL4Mbk17","session_id":"d346b169-4c5b-4579-98c0-3e4f65b0717e","uuid":"be142a28-88ed-4438-87fb-c83a24ffe872","timestamp":"2026-04-11T07:19:34.777Z"}
