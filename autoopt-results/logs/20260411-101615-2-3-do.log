?;","+                d_tmp","+                    .fill_zero()","+                    .map_err(|e| LogupZerocheckError::from(MemCopyError::from(e)))?;"," ","-            let mut d_tmp = DeviceBuffer::<Frac<EF>>::with_capacity(","-                total_x_blocks as usize * logup_global_d,","-            );","-            d_tmp","-                .fill_zero()","-                .map_err(|e| LogupZerocheckError::from(MemCopyError::from(e)))?;","-            d_logup_global_output = DeviceBuffer::<Frac<EF>>::with_capacity(","-                logup_global_metas.len() * logup_global_d,","-            );","+                let mut d_sb_output = DeviceBuffer::<Frac<EF>>::with_capacity(","+                    sb_metas.len() * logup_global_d,","+                );"," ","-            unsafe {","-                crate::cuda::logup_zerocheck::logup_bary_eval_interactions_round0_batched_global(","-                    &mut d_tmp,","-                    &mut d_logup_global_output,","-                    &d_metas_bytes,","-                    &d_air_for_block,","-                    &d_seg_offsets,","-                    logup_global_metas.len() as u32,","-                    total_x_blocks,","-                    logup_global_max_cosets,","-                    skip_domain,","-                )","-                .map_err(|e| LogupZerocheckError::from(MemCopyError::from(e)))?;","+                unsafe {","+                    crate::cuda::logup_zerocheck::logup_bary_eval_interactions_round0_batched_global(","+                        &mut d_tmp,","+                        &mut d_sb_output,","+                        &d_metas_bytes,","+                        &d_air_for_block,","+                        &d_seg_offsets,","+                        sb_metas.len() as u32,","+                        sb_total_x,","+                        logup_global_max_cosets,","+                        skip_domain,","+                    )","+                    .map_err(|e| LogupZerocheckError::from(MemCopyError::from(e)))?;","+                }","+                drop(d_tmp);","+                intermed_keepalive.push(d_intermediates);","+                d_logup_global_sb_outputs.push(d_sb_output);","+                logup_global_sb_d.push(logup_global_d);","             }","-            drop(d_tmp);","-            intermed_keepalive.push(d_intermediates);","         }"," ","         // Phase 2: Explicit stream sync, then D2H transfers + CPU polynomial construction."]}],"userModified":false,"replaceAll":false}}
