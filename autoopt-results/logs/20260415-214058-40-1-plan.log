   )\n243\t    .entered();\n244\t    #[allow(clippy::needless_range_loop)]\n245\t    for round in 1..=n_stack {\n246\t        let batch_s_evals = prover.batch_sumcheck_poly_eval(round, u_vec[round - 1])?;\n247\t\n248\t        for &eval in &batch_s_evals {\n249\t            transcript.observe_ext(eval);\n250\t        }\n251\t        sumcheck_round_polys.push(batch_s_evals);\n252\t\n253\t        let u_round = transcript.sample_ext();\n254\t        u_vec.push(u_round);\n255\t        debug!(%round, %u_round);\n256\t\n257\t        prover.fold_mle_evals(round, u_round)?;\n258\t    }\n259\t    let stacking_openings = prover.get_stacked_openings()?;\n260\t    for claims_for_com in &stacking_openings {\n261\t        for &claim in claims_for_com {\n262\t            transcript.observe_ext(claim);\n263\t        }\n264\t    }\n265\t    drop(_mle_rounds_span);\n266\t    let proof = StackingProof {\n267\t        univariate_round_coeffs: s_0.into_coeffs(),\n268\t        sumcheck_round_polys,\n269\t        stacking_openings,\n270\t    };\n271\t    Ok((proof, u_vec, prover.stacked_per_commit))\n272\t}\n273\t\n274\timpl<D: Copy + Clone + Send + Sync + 'static> StackedReductionGpu<D> {\n275\t    #[instrument(\"stacked_reduction_new\", level = \"debug\", skip_all)]\n276\t    fn new<HS: GpuHashScheme<Digest = D>>(\n277\t        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n278\t        ctx: ProvingContext<GenericGpuBackend<HS>>,\n279\t        common_main_pcs_data: StackedPcsDataGpu<F, D>,\n280\t        r: &[EF],\n281\t        lambda: EF,\n282\t        sm_count: u32,\n283\t    ) -> Result<Self, StackedReductionError> {\n284\t        ensure_device_ntt_twiddles_initialized();\n285\t        let mem = MemTracker::start(\"prover.stacked_reduction_new\");\n286\t        let l_skip = mpk.params.l_skip;\n287\t        let n_stack = mpk.params.n_stack;\n288\t\n289\t        let omega_skip = F::two_adic_generator(l_skip);\n290\t        let omega_skip_pows = omega_skip.powers().take(1 << l_