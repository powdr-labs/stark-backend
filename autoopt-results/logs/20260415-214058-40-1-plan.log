{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SjGxqeJ5JdSKkHPs8h6smV","type":"tool_result","content":"1\t#include \"device_ntt.cuh\"\n2\t#include \"fp.h\"\n3\t#include \"launcher.cuh\"\n4\t#include \"utils.cuh\"\n5\t#include <cassert>\n6\t#include <cstddef>\n7\t#include <cstdint>\n8\t#include <cuda_runtime.h>\n9\t#include <vector_types.h>\n10\t\n11\tusing namespace device_ntt;\n12\t\n13\t// ============================================================================\n14\t// Constant Memory Definition and Initialization\n15\t// ============================================================================\n16\t\n17\tnamespace device_ntt {\n18\t\n19\t// Define the constant memory (declared extern in device_ntt.cuh)\n20\t__constant__ Fp DEVICE_NTT_TWIDDLES[DEVICE_NTT_TWIDDLES_SIZE];\n21\t\n22\t} // namespace device_ntt\n23\t\n24\t// Kernel to generate twiddles for all levels 1..MAX_NTT_LEVEL\n25\t// Each thread handles one twiddle: omega_level^index\n26\t__global__ void generate_device_ntt_twiddles_kernel(Fp *d_twiddles) {\n27\t    uint32_t tid = blockIdx.x * blockDim.x + threadIdx.x;\n28\t    if (tid >= DEVICE_NTT_TWIDDLES_SIZE)\n29\t        return;\n30\t\n31\t    // Find which level this tid belongs to\n32\t    // Level L starts at offset 2^L - 2 and has 2^L elements\n33\t    // tid in [2^L - 2, 2^(L+1) - 2) => level L\n34\t    uint32_t level = 1;\n35\t    uint32_t offset = 0;\n36\t    while (level <= MAX_NTT_LEVEL) {\n37\t        uint32_t level_size = 1u << level;\n38\t        if (tid < offset + level_size) {\n39\t            break;\n40\t        }\n41\t        offset += level_size;\n42\t        level++;\n43\t    }\n44\t\n45\t    uint32_t index = tid - offset;\n46\t    // Compute omega_level^index where omega_level = TWO_ADIC_GENERATORS[level]\n47\t    d_twiddles[tid] = pow(TWO_ADIC_GENERATORS[level], index);\n48\t}\n49\t\n50\t// Generate twiddles into the provided device buffer and copy to constant memory.\n51\t// `d_twiddles` must have capacity for DEVICE_NTT_TWIDDLES_SIZE elements.\n52\t// Returns 0 on success, non-zero on error.\n53\textern \"C\" int _generate_device_ntt_twiddles(Fp *d_twiddles) {\n54\t    // Generate twiddles on GPU\n55\t    constexpr uint32_t BLOCK_SIZE = 256;\n56\t    uint32_t num_blocks = div_ceil(DEVICE_NTT_TWIDDLES_SIZE, BLOCK_SIZE);\n57\t    generate_device_ntt_twiddles_kernel<<<num_blocks, BLOCK_SIZE>>>(d_twiddles);\n58\t\n59\t    // Copy to constant memory using per-thread stream\n60\t    cudaMemcpyToSymbolAsync(\n61\t        DEVICE_NTT_TWIDDLES,\n62\t        d_twiddles,\n63\t        DEVICE_NTT_TWIDDLES_SIZE * sizeof(Fp),\n64\t        0,\n65\t        cudaMemcpyDeviceToDevice,\n66\t        cudaStreamPerThread\n67\t    );\n68\t    cudaStreamSynchronize(cudaStreamPerThread);\n69\t\n70\t    return CHECK_KERNEL();\n71\t}\n72\t\n73\t// ============================================================================\n74\t// Batch NTT Kernels\n75\t// ============================================================================\n76\t\n77\ttemplate <bool intt, bool needs_shmem>\n78\t__global__ void batch_ntt_kernel(\n79\t    Fp *__restrict__ buffer,\n80\t    uint32_t const l_skip,\n81\t    uint32_t const cnt_blocks\n82\t) {\n83\t    uint32_t const block_idx = blockIdx.x * blockDim.y + threadIdx.y;\n84\t    bool const active_thread = (block_idx < cnt_blocks);\n85\t    buffer += block_idx << l_skip;\n86\t\n87\t#ifdef CUDA_DEBUG\n88\t    assert(blockDim.x <= (1 << l_skip));\n89\t#endif\n90\t    uint32_t const i = threadIdx.x;\n91\t\n92\t    Fp this_thread_value;\n93\t    if constexpr (needs_shmem) {\n94\t        extern __shared__ Fp smem[];\n95\t        auto sbuf = smem + (threadIdx.y << l_skip);\n96\t        if (active_thread) {\n97\t            sbuf[i] = buffer[i];\n98\t        }\n99\t        __syncthreads();\n100\t\n101\t        ntt_natural_to_bitrev<intt, true>(this_thread_value, sbuf, i, l_skip, active_thread);\n102\t    } else if (active_thread) {\n103\t        this_thread_value = buffer[i];\n104\t        ntt_natural_to_bitrev<intt, false>(this_thread_value, nullptr, i, l_skip, true);\n105\t    }\n106\t\n107\t    if (active_thread) {\n108\t        auto const j = rev_len(i, l_skip);\n109\t        buffer[j] = this_thread_value;\n110\t    }\n111\t}\n112\t\n113\ttemplate <bool intt, bool needs_shmem>\n114\tint launch_batch_ntt_small(Fp *buffer, size_t const l_skip, size_t const cnt_blocks) {\n115\t    uint32_t const threads_per_block = 1024;\n116\t    uint32_t const threads_x = 1 << l_skip;\n117\t    assert(threads_per_block >> l_skip);\n118\t    uint32_t const threads_y = threads_per_block / threads_x;\n119\t    size_t const smem_size = needs_shmem ? (sizeof(Fp) * threads_per_block) : 0;\n120\t\n121\t    batch_ntt_kernel<intt, needs_shmem>\n122\t        <<<div_ceil(cnt_blocks, threads_y), dim3{threads_x, threads_y, 1}, smem_size>>>(\n123\t            buffer, l_skip, cnt_blocks\n124\t        );\n125\t\n126\t    return CHECK_KERNEL();\n127\t}\n128\t\n129\textern \"C\" int _batch_ntt_small(\n130\t    Fp *buffer,\n131\t    size_t const l_skip,\n132\t    size_t const cnt_blocks,\n133\t    bool const is_intt\n134\t) {\n135\t    bool const needs_shmem = l_skip > LOG_WARP_SIZE;\n136\t    assert((1 << l_skip) <= 1024);\n137\t    return DISPATCH_BOOL_PAIR(\n138\t        launch_batch_ntt_small, is_intt, needs_shmem, buffer, l_skip, cnt_blocks\n139\t    );\n140\t}\n141\t"}]},"parent_tool_use_id":"toolu_01Dkua5M8DfdsWc3jWXXd5Zp","session_id":"719c141a-1a84-4f89-a64a-f54435a4c1b4","uuid":"4f2002d3-9978-4141-86cb-7f20a40113a5","timestamp":"2026-04-15T19:47:53.217Z"}
