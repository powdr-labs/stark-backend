{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0136Jg64CVGC4Lkude3ewJ8A","type":"tool_result","content":"1\tuse openvm_stark_backend::{SystemParams, WhirProximityStrategy};\n2\t\n3\tuse crate::config::log_up_params::log_up_security_params_baby_bear_100_bits;\n4\t\n5\t/// STARK config where the base field is BabyBear, extension field is BabyBear^4, and the hasher is\n6\t/// `Poseidon2<Bn254>`.\n7\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n8\tpub mod baby_bear_bn254_poseidon2;\n9\t/// STARK config where the base field is BabyBear, extension field is BabyBear^4, and the hasher is\n10\t/// `Poseidon2<BabyBear>`.\n11\tpub mod baby_bear_poseidon2;\n12\tpub mod log_up_params;\n13\t\n14\t// ==========================================================================\n15\t// Production configurations\n16\t// ==========================================================================\n17\t// These configurations target 100-bits of proven round-by-round (RBR) security with BabyBear as the\n18\t// base field and BabyBear^4 as the extension field.\n19\t\n20\tconst WHIR_MAX_LOG_FINAL_POLY_LEN: usize = 10;\n21\tconst SECURITY_BITS_TARGET: usize = 100;\n22\t\n23\tpub const DEFAULT_APP_L_SKIP: usize = 4;\n24\tpub const DEFAULT_APP_LOG_BLOWUP: usize = 1;\n25\tpub const DEFAULT_LEAF_LOG_BLOWUP: usize = 2;\n26\tpub const DEFAULT_INTERNAL_LOG_BLOWUP: usize = 3;\n27\tpub const DEFAULT_ROOT_LOG_BLOWUP: usize = 4;\n28\t\n29\tpub const MAX_APP_LOG_STACKED_HEIGHT: usize = 24;\n30\t\n31\t/// Returns `SystemParams` targeting 100 bits of proven RBR security for App VM circuits.\n32\t///\n33\t/// # Assumptions for 100-bit security\n34\t/// - **Max trace height**: `log_stacked_height` ≤ [`MAX_APP_LOG_STACKED_HEIGHT`] (24)\n35\t/// - **Max constraints per AIR**: ≤ 5,000\n36\t/// - **Num AIRs**: ≤ 100\n37\t/// - **Max interactions per AIR**: ≤ 1,000\n38\t/// - **Num trace columns** (unstacked, total across all AIRs): ≤ 30,000\n39\t/// - **`w_stack`** = 2,048, bounding total stacked cells to `w_stack × 2^(n_stack + l_skip)`\n40\t//\n41\t// See `test_all_production_configs` in `crates/stark-backend/tests/soundness.rs` for the\n42\t// full soundness analysis.\n43\tpub fn app_params_with_100_bits_security(log_stacked_height: usize) -> SystemParams {\n44\t    assert!(\n45\t        log_stacked_height <= MAX_APP_LOG_STACKED_HEIGHT,\n46\t        \"log_stacked_height must be <= {MAX_APP_LOG_STACKED_HEIGHT}\",\n47\t    );\n48\t    SystemParams::new(\n49\t        DEFAULT_APP_LOG_BLOWUP,\n50\t        DEFAULT_APP_L_SKIP,\n51\t        log_stacked_height.saturating_sub(DEFAULT_APP_L_SKIP), // n_stack\n52\t        2048,                                                  // w_stack\n53\t        WHIR_MAX_LOG_FINAL_POLY_LEN,\n54\t        5,  // folding pow\n55\t        15, // mu pow\n56\t        WhirProximityStrategy::UniqueDecoding,\n57\t        SECURITY_BITS_TARGET,\n58\t        log_up_security_params_baby_bear_100_bits(),\n59\t    )\n60\t}\n61\t\n62\t/// Returns `SystemParams` targeting 100 bits of proven RBR security for leaf aggregation circuits.\n63\t///\n64\t/// # Assumptions for 100-bit security\n65\t/// - **Max trace height**: ≤ 2^21\n66\t/// - **Max constraints per AIR**: ≤ 1,000\n67\t/// - **Num AIRs**: ≤ 50\n68\t/// - **Max interactions per AIR**: ≤ 100 (maximum number of interactions in a single AIR for a\n69\t///   single row)\n70\t/// - **Num trace columns** (unstacked, total across all AIRs): ≤ 2,000\n71\t/// - **`w_stack`** = 2,048, bounding total stacked cells to `w_stack × 2^(n_stack + l_skip)`\n72\t///\n73\t/// Config: `l_skip=4, n_stack=17, log_blowup=2`.\n74\t//\n75\t// See `test_all_production_configs` in `crates/stark-backend/tests/soundness.rs` for the\n76\t// full soundness analysis.\n77\tpub fn leaf_params_with_100_bits_security() -> SystemParams {\n78\t    SystemParams::new(\n79\t        DEFAULT_LEAF_LOG_BLOWUP,\n80\t        4,    // l_skip\n81\t        17,   // n_stack\n82\t        2048, // w_stack\n83\t        WHIR_MAX_LOG_FINAL_POLY_LEN,\n84\t        4,  // folding pow\n85\t        13, // mu pow\n86\t        WhirProximityStrategy::UniqueDecoding,\n87\t        SECURITY_BITS_TARGET,\n88\t        log_up_security_params_baby_bear_100_bits(),\n89\t    )\n90\t}\n91\t\n92\t/// Returns `SystemParams` targeting 100 bits of proven RBR security for internal aggregation\n93\t/// circuits.\n94\t///\n95\t/// # Assumptions for 100-bit security\n96\t/// - **Max trace height**: ≤ 2^19\n97\t/// - **Max constraints per AIR**: ≤ 1,000\n98\t/// - **Num AIRs**: ≤ 50\n99\t/// - **Max interactions per AIR**: ≤ 100\n100\t/// - **Num trace columns** (unstacked, total across all AIRs): ≤ 2,000\n101\t/// - **`w_stack`** = 512, bounding total stacked cells to `w_stack × 2^(n_stack + l_skip)`\n102\t///\n103\t/// Config: `l_skip=2, n_stack=17, log_blowup=3`.\n104\t//\n105\t// See `test_all_production_configs` in `crates/stark-backend/tests/soundness.rs` for the\n106\t// full soundness analysis.\n107\tpub fn internal_params_with_100_bits_security() -> SystemParams {\n108\t    SystemParams::new(\n109\t        DEFAULT_INTERNAL_LOG_BLOWUP,\n110\t        2,   // l_skip\n111\t        17,  // n_stack\n112\t        512, // w_stack\n113\t        WHIR_MAX_LOG_FINAL_POLY_LEN,\n114\t        18, // folding pow\n115\t        20, // mu pow\n116\t        WhirProximityStrategy::ListDecoding { m: 2 },\n117\t        SECURITY_BITS_TARGET,\n118\t        log_up_security_params_baby_bear_100_bits(),\n119\t    )\n120\t}\n121\t\n122\t/// Returns `SystemParams` targeting 100 bits of proven RBR security for root circuits.\n123\t///\n124\t/// # Assumptions for 100-bit security\n125\t/// - **Max trace height**: ≤ 2^21\n126\t/// - **Max constraints per AIR**: ≤ 1,000\n127\t/// - **Num AIRs**: ≤ 50\n128\t/// - **Max interactions per AIR**: ≤ 100\n129\t/// - **Num trace columns** (unstacked, total across all AIRs): ≤ 2,000\n130\t/// - **`w_stack`** = 9, bounding total stacked cells to `w_stack × 2^(n_stack + l_skip)`\n131\t///\n132\t/// Config: `l_skip=2, n_stack=19, log_blowup=4`.\n133\t//\n134\t// See `test_all_production_configs` in `crates/stark-backend/tests/soundness.rs` for the\n135\t// full soundness analysis.\n136\tpub fn root_params_with_100_bits_security() -> SystemParams {\n137\t    SystemParams::new(\n138\t        DEFAULT_ROOT_LOG_BLOWUP,\n139\t        2,  // l_skip\n140\t        19, // n_stack\n141\t        9,  // w_stack\n142\t        WHIR_MAX_LOG_FINAL_POLY_LEN,\n143\t        20, // folding pow\n144\t        20, // mu pow\n145\t        WhirProximityStrategy::ListDecoding { m: 2 },\n146\t        SECURITY_BITS_TARGET,\n147\t        log_up_security_params_baby_bear_100_bits(),\n148\t    )\n149\t}\n150\t"}]},"parent_tool_use_id":"toolu_01B2aXHfTFY1CYrURnDvPBve","session_id":"719c141a-1a84-4f89-a64a-f54435a4c1b4","uuid":"4eb9f916-47cc-4f1a-b7a0-0489ef48e617","timestamp":"2026-04-15T20:13:31.958Z"}
