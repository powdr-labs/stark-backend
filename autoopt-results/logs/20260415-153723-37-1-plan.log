           prev_r,\n                            transcript,\n                            &mut d_sum_evals,\n                            &mut tmp_block_sums,\n                            &mut round_polys_eval,\n                            &mut r_vec,\n                            &mut prev_s_eval,\n                            xi_j,\n                            &mut eq_r_acc,\n                        )?,\n                        BufferTarget::InPlaceLayer => do_fused_sumcheck_round_inplace(\n                            &mut eq_buffer,\n                            &mut layer,\n                            src_pq_size,\n                            lambda,\n                            prev_r,\n                            transcript,\n                            &mut d_sum_evals,\n                            &mut tmp_block_sums,\n                            &mut round_polys_eval,\n                            &mut r_vec,\n                            &mut prev_s_eval,\n                            xi_j,\n                            &mut eq_r_acc,\n                        )?,\n                        BufferTarget::InPlaceWork => do_fused_sumcheck_round_inplace(\n                            &mut eq_buffer,\n                            &mut work_buffer,\n                            src_pq_size,\n                            lambda,\n                            prev_r,\n                            transcript,\n                            &mut d_sum_evals,\n                            &mut tmp_block_sums,\n                            &mut round_polys_eval,\n                            &mut r_vec,\n                            &mut prev_s_eval,\n                            xi_j,\n                            &mut eq_r_acc,\n                        )?,\n                    };\n\n                    pq_size >>= 1;\n                    prev_r = r;\n                }\n\n                // Final fold after last r (no next compute to fuse with).\n                active = match scheduler.fina