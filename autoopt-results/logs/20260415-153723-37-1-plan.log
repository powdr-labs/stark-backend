{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JytLuyfkKZD5HSYHavrHX6","type":"tool_result","content":"1\tuse openvm_cuda_common::{\n2\t    d_buffer::DeviceBuffer,\n3\t    error::{check, CudaError},\n4\t};\n5\t\n6\tuse crate::{\n7\t    prelude::{D_EF, EF, F},\n8\t    whir::BatchingTracePacket,\n9\t};\n10\t\n11\textern \"C\" {\n12\t    fn _whir_algebraic_batch_traces(\n13\t        output: *mut F,\n14\t        packets: *const BatchingTracePacket,\n15\t        mu_powers: *const EF,\n16\t        stacked_height: usize,\n17\t        num_packets: usize,\n18\t        skip_domain: u32,\n19\t    ) -> i32;\n20\t\n21\t    pub fn _whir_sumcheck_coeff_moments_required_temp_buffer_size(height: u32) -> u32;\n22\t\n23\t    fn _whir_sumcheck_coeff_moments_round(\n24\t        f_coeffs: *const EF,\n25\t        w_moments: *const EF,\n26\t        output: *mut EF,\n27\t        tmp_block_sums: *mut EF,\n28\t        height: u32,\n29\t    ) -> i32;\n30\t\n31\t    fn _whir_fold_coeffs_and_moments(\n32\t        f_coeffs: *const EF,\n33\t        w_moments: *const EF,\n34\t        f_folded_coeffs: *mut EF,\n35\t        w_folded_moments: *mut EF,\n36\t        alpha: EF,\n37\t        height: u32,\n38\t    ) -> i32;\n39\t\n40\t    fn _w_moments_accumulate(\n41\t        w_moments: *const EF,\n42\t        z0_pows2: *const EF,\n43\t        z_pows2: *const F,\n44\t        gamma: EF,\n45\t        num_queries: u32,\n46\t        log_height: u32,\n47\t        height: u32,\n48\t    ) -> i32;\n49\t}\n50\t\n51\t/// # Safety\n52\t/// - `packets` must contain pointers `ptr` to device buffers valid for `height x width` elements.\n53\t///   The `stacked_row_start` must be the correct starting row index for the trace within the\n54\t///   stacked matrix.\n55\t/// - `mu_powers` must be defined for at least the sum of the stacked widths.\n56\tpub unsafe fn whir_algebraic_batch_traces(\n57\t    output: &mut DeviceBuffer<F>,\n58\t    packets: &DeviceBuffer<BatchingTracePacket>,\n59\t    mu_powers: &DeviceBuffer<EF>,\n60\t    skip_domain: u32,\n61\t) -> Result<(), CudaError> {\n62\t    debug_assert_eq!(output.len() % D_EF, 0);\n63\t    check(_whir_algebraic_batch_traces(\n64\t        output.as_mut_ptr(),\n65\t        packets.as_ptr(),\n66\t        mu_powers.as_ptr(),\n67\t        output.len() / D_EF,\n68\t        packets.len(),\n69\t        skip_domain,\n70\t    ))\n71\t}\n72\t\n73\t/// Performs a WHIR sumcheck round with `f` in coefficient form and `w` in moment form.\n74\t///\n75\t/// # Safety\n76\t/// - `f_coeffs` and `w_moments` are the same length, which is a power of two.\n77\t/// - `output` has length at least 2.\n78\t/// - `tmp_block_sums` has length at least\n79\t///   `_whir_sumcheck_coeff_moments_required_temp_buffer_size(height)`.\n80\tpub unsafe fn whir_sumcheck_coeff_moments_round(\n81\t    f_coeffs: &DeviceBuffer<EF>,\n82\t    w_moments: &DeviceBuffer<EF>,\n83\t    output: &mut DeviceBuffer<EF>,\n84\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n85\t    height: u32,\n86\t) -> Result<(), CudaError> {\n87\t    debug_assert!(f_coeffs.len() >= height as usize);\n88\t    debug_assert!(w_moments.len() >= height as usize);\n89\t    #[cfg(debug_assertions)]\n90\t    {\n91\t        let len = tmp_block_sums.len();\n92\t        let required = _whir_sumcheck_coeff_moments_required_temp_buffer_size(height);\n93\t        assert!(\n94\t            len >= required as usize,\n95\t            \"tmp_block_sums len={len} < required={required}\"\n96\t        );\n97\t    }\n98\t    check(_whir_sumcheck_coeff_moments_round(\n99\t        f_coeffs.as_ptr(),\n100\t        w_moments.as_ptr(),\n101\t        output.as_mut_ptr(),\n102\t        tmp_block_sums.as_mut_ptr(),\n103\t        height,\n104\t    ))\n105\t}\n106\t\n107\t/// Folds `f` (coefficient form) and `w` (moment form) for one WHIR round.\n108\t///\n109\t/// # Safety\n110\t/// - `f_coeffs` and `w_moments` have length `height`, which is a power of two.\n111\t/// - `f_folded_coeffs` and `w_folded_moments` have length `height / 2`.\n112\tpub unsafe fn whir_fold_coeffs_and_moments(\n113\t    f_coeffs: &DeviceBuffer<EF>,\n114\t    w_moments: &DeviceBuffer<EF>,\n115\t    f_folded_coeffs: &mut DeviceBuffer<EF>,\n116\t    w_folded_moments: &mut DeviceBuffer<EF>,\n117\t    alpha: EF,\n118\t    height: u32,\n119\t) -> Result<(), CudaError> {\n120\t    debug_assert!(f_coeffs.len() >= height as usize);\n121\t    debug_assert!(w_moments.len() >= height as usize);\n122\t    debug_assert!(f_folded_coeffs.len() >= (height as usize / 2));\n123\t    debug_assert!(w_folded_moments.len() >= (height as usize / 2));\n124\t    check(_whir_fold_coeffs_and_moments(\n125\t        f_coeffs.as_ptr(),\n126\t        w_moments.as_ptr(),\n127\t        f_folded_coeffs.as_mut_ptr(),\n128\t        w_folded_moments.as_mut_ptr(),\n129\t        alpha,\n130\t        height,\n131\t    ))\n132\t}\n133\t\n134\t/// Updates WHIR moment vector in place by adding gamma-weighted query terms.\n135\t///\n136\t/// # Safety\n137\t/// - `w_moments` has length `height = 2^log_height`.\n138\t/// - `z0_pows2` has length `log_height`.\n139\t/// - `z_pows2` has length `num_queries * log_height`.\n140\tpub unsafe fn w_moments_accumulate(\n141\t    w_moments: &mut DeviceBuffer<EF>,\n142\t    z0_pows2: &DeviceBuffer<EF>,\n143\t    z_pows2: &DeviceBuffer<F>,\n144\t    gamma: EF,\n145\t    num_queries: u32,\n146\t    log_height: u32,\n147\t) -> Result<(), CudaError> {\n148\t    let height = w_moments.len();\n149\t    debug_assert_eq!(z0_pows2.len(), log_height as usize);\n150\t    debug_assert_eq!(z_pows2.len(), num_queries as usize * log_height as usize);\n151\t    check(_w_moments_accumulate(\n152\t        w_moments.as_mut_ptr(),\n153\t        z0_pows2.as_ptr(),\n154\t        z_pows2.as_ptr(),\n155\t        gamma,\n156\t        num_queries,\n157\t        log_height,\n158\t        height as u32,\n159\t    ))\n160\t}\n161\t"}]},"parent_tool_use_id":"toolu_01Pd4JUY8b1Jx5eQTdsAE8zE","session_id":"694fb196-69bb-4e1f-a777-5a160503c446","uuid":"7132cce4-e90b-43f8-9674-d750cc799246","timestamp":"2026-04-15T13:46:33.197Z"}
