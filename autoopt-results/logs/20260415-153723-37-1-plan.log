             constraint_degree: self.constraint_degree,\n1088\t                xi: &self.xi,\n1089\t                max_temp_bytes: per_thread_temp_bytes,\n1090\t                zc_intermed_cap,\n1091\t                zc_temp_sums_cap,\n1092\t                logup_intermed_cap,\n1093\t                logup_temp_sums_cap,\n1094\t                zc_batch_offset: 0,    // set after max_poly_len is computed\n1095\t                numer_batch_offset: 0,\n1096\t                denom_batch_offset: 0,\n1097\t            }\n1098\t        })\n1099\t        .collect();\n1100\t\n1101\t        // Sort by descending height for better load balance across thread chunks.\n1102\t        work_items.sort_by(|a, b| b.common_main.height().cmp(&a.common_main.height()));\n1103\t\n1104\t        // Pre-compute polynomial extraction transform matrices per unique constraint degree.\n1105\t        let skip_domain = 1usize << l_skip;\n1106\t        let mut extract_tables: FxHashMap<usize, Round0ExtractTables> = FxHashMap::default();\n1107\t        for w in &work_items {\n1108\t            let d = w.single_pk.vk.max_constraint_degree as usize;\n1109\t            if !extract_tables.contains_key(&d) {\n1110\t                extract_tables.insert(d, compute_round0_extract_tables(d, l_skip)?);\n1111\t            }\n1112\t        }\n1113\t\n1114\t        // Pre-allocate device batch polynomial array.\n1115\t        // All polynomial coefficients are written here by GPU extraction kernels,\n1116\t        // then copied to host in a single D2H transfer.\n1117\t        let max_poly_len = work_items\n1118\t            .iter()\n1119\t            .map(|w| {\n1120\t                let d = w.single_pk.vk.max_constraint_degree as usize;\n1121\t                let zc_len = sumcheck_round0_deg(l_skip, d) + 1;\n1122\t                let logup_len = d * skip_domain;\n1123\t                zc_len.max(logup_len)\n1124\t            })\n1125\t            .max()\n1126\t            .unwrap_or(0);\n1127\t\n1128\t        let batch_total = 3 * num_present_airs * max_poly_len;\n1129\t        let d_batch_array = if batch_total > 0 {\n1130\t            let buf = DeviceBuffer::<EF>::with_capacity(batch_total);\n1131\t            buf.fill_zero().map_err(MemCopyError::from)?;\n1132\t            buf\n1133\t        } else {\n1134\t            DeviceBuffer::new()\n1135\t        };\n1136\t\n1137\t        // Set per-AIR batch offsets.\n1138\t        for w in &mut work_items {\n1139\t            w.zc_batch_offset = (2 * num_present_airs + w.trace_idx) * max_poly_len;\n1140\t            w.numer_batch_offset = (2 * w.trace_idx) * max_poly_len;\n1141\t            w.denom_batch_offset = (2 * w.trace_idx + 1) * max_poly_len;\n1142\t        }\n1143\t\n1144\t        // Track per-AIR polynomial lengths for host-side reconstruction.\n1145\t        let poly_lens: Vec<(usize, usize, usize)> = {\n1146\t            // Build a map from trace_idx to (zc_len, logup_len)\n1147\t            let mut lens = vec![(0usize, 0usize, 0usize); num_present_airs];\n1148\t            for w in &work_items {\n1149\t                let d = w.single_pk.vk.max_constraint_degree as usize;\n1150\t                let has_constraints = d > 1\n1151\t                    && !w\n1152\t                        .single_pk\n1153\t                        .vk\n1154\t                        .symbolic_constraints\n1155\t                        .constraints\n1156\t                        .constraint_idx\n1157\t                        .is_empty();\n1158\t                let has_interactions = !w.eq_3bs.is_empty();\n1159\t                let zc_len = if has_constraints {\n1160\t                    sumcheck_round0_deg(l_skip, d) + 1\n1161\t                } else {\n1162\t                    0\n1163\t                };\n1164\t                let logup_len = if has_interactions { d * skip_domain } else { 0 };\n1165\t                lens[w.trace_idx] = (zc_len, logup_len, logup_len);\n1166\t            }\n1167\t            lens\n1168\t        };\n1169\t\n1170\t        // Pre-compute buffer sizes for pre-allocation using a percentile threshold.\n1171\t        // Using the max would require enormous buffers (driven by a few large AIRs),\n1172\t        // causing GPU memory pressure that degrades all phases. The 95th percentile\n1173\t        // covers 95%+ of AIRs while keeping total allocation manageable. The few\n1174\t        // large AIRs above the threshold fall back to dynamic allocation.\n1175\t        let percentile_idx = |n: usize| -> usize { (n * 95 / 100).min(n.saturating_sub(1)) };\n1176\t        let (max_zc_intermed, max_zc_temp_sums, max_logup_intermed, max_logup_temp_sums) = {\n1177\t            let n = work_items.len();\n1178\t            let mut zc_i: Vec<usize> = work_items.iter().map(|w| w.zc_intermed_cap).collect();\n1179\t            let mut zc_t: Vec<usize> = work_items.iter().map(|w| w.zc_temp_sums_cap).collect();\n1180\t            let mut li: Vec<usize> = work_items.iter().map(|w| w.logup_intermed_cap).collect();\n1181\t            let mut lt: Vec<usize> = work_items.iter().map(|w| w.logup_temp_sums_cap).collect();\n1182\t            zc_i.sort_unstable();\n1183\t            zc_t.sort_unstable();\n1184\t            li.sort_unstable();\n1185\t            lt.sort_unstable();\n1186\t            let idx = percentile_idx(n);\n1187\t            (zc_i[idx], zc_t[idx], li[idx], lt[idx])\n1188\t        };\n1189\t\n1190\t        // Barrier: ensure all prior GPU work (trace uploads, pk data, selectors)\n1191\t        // is visible to worker thread streams.\n1192\t        current_stream_sync().map_err(MemCopyError::from)?;\n1193\t\n1194\t        // Phase 1b: Batched path for small AIRs.\n1195\t        // Identify batchable AIRs and process them with descriptor-array kernels.\n1196\t        // This eliminates per-AIR kernel launch overhead for the majority of AIRs.\n1197\t        let batchable = round0_batched::identify_batchable_airs(&work_items, l_skip);\n1198\t        let batched_count = batchable.it