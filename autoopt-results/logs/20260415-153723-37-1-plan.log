{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DpPcqTQAQnaBrzTiKmctMU","type":"tool_result","content":"1\tuse super::*;\n2\tuse crate::{\n3\t    monomial::{InteractionMonomialTerm, LambdaTerm, MonomialHeader, PackedVar},\n4\t    poly::SqrtEqLayers,\n5\t};\n6\t\n7\t#[repr(C)]\n8\t#[derive(Clone, Copy, Debug)]\n9\tpub struct MainMatrixPtrs<T> {\n10\t    pub data: *const T,\n11\t    pub air_width: u32,\n12\t}\n13\t\n14\t// Types for batch MLE:\n15\t#[repr(C)]\n16\t#[derive(Clone, Copy, Debug)]\n17\tpub struct BlockCtx {\n18\t    pub local_block_idx_x: u32,\n19\t    /// Caution: this refers to the index within buffer of `ZerocheckCtx` or `LogupCtx`. It is\n20\t    /// hence a \"local\" AIR index and not the global AIR index within the proving key.\n21\t    pub air_idx: u32,\n22\t}\n23\t\n24\t// Types for batched Round 0:\n25\t#[repr(C)]\n26\t#[derive(Clone, Copy, Debug)]\n27\tpub struct Round0BlockCtx {\n28\t    pub local_block_idx: u32,\n29\t    pub air_idx: u32,\n30\t}\n31\t\n32\t#[repr(C)]\n33\t#[derive(Clone, Copy, Debug)]\n34\tpub struct Round0ZcCtx {\n35\t    pub selectors_cube: *const F,\n36\t    pub preprocessed: *const F,\n37\t    pub main_parts: *const *const F,\n38\t    pub eq_cube: *const EF,\n39\t    pub lambda_pows: *const EF,\n40\t    pub public_values: *const F,\n41\t    pub d_rules: *const std::ffi::c_void,\n42\t    pub d_used_nodes: *const usize,\n43\t    pub rules_len: usize,\n44\t    pub used_nodes_len: usize,\n45\t    pub lambda_len: usize,\n46\t    pub buffer_size: u32,\n47\t    pub d_intermediates: *mut F,\n48\t    pub buffer_stride: u32,\n49\t    pub num_x: u32,\n50\t    pub height: u32,\n51\t    pub g_shift: F,\n52\t}\n53\t\n54\tunsafe impl Send for Round0ZcCtx {}\n55\tunsafe impl Sync for Round0ZcCtx {}\n56\t\n57\t#[repr(C)]\n58\t#[derive(Clone, Copy, Debug)]\n59\tpub struct Round0LogupCtx {\n60\t    pub selectors_cube: *const F,\n61\t    pub preprocessed: *const F,\n62\t    pub main_parts: *const *const F,\n63\t    pub eq_cube: *const EF,\n64\t    pub public_values: *const F,\n65\t    pub d_rules: *const std::ffi::c_void,\n66\t    pub rules_len: usize,\n67\t    pub buffer_size: u32,\n68\t    pub d_intermediates: *mut F,\n69\t    pub buffer_stride: u32,\n70\t    pub numer_weights: *const EF,\n71\t    pub denom_weights: *const EF,\n72\t    pub denom_sum_init: EF,\n73\t    pub num_x: u32,\n74\t    pub height: u32,\n75\t    pub g_shift: F,\n76\t}\n77\t\n78\tunsafe impl Send for Round0LogupCtx {}\n79\tunsafe impl Sync for Round0LogupCtx {}\n80\t\n81\t/// Per-AIR context for batched monomial evaluation.\n82\t#[repr(C)]\n83\t#[derive(Clone, Copy, Debug)]\n84\tpub struct MonomialAirCtx {\n85\t    pub d_headers: *const MonomialHeader,\n86\t    pub d_variables: *const PackedVar,\n87\t    pub d_lambda_combinations: *const EF, // Precomputed per-monomial\n88\t    pub num_monomials: u32,\n89\t    pub eval_ctx: EvalCoreCtx,\n90\t    pub d_eq_xi: *const EF,\n91\t    pub num_y: u32,\n92\t}\n93\t\n94\t#[repr(C)]\n95\t#[derive(Clone, Copy, Debug)]\n96\tpub struct EvalCoreCtx {\n97\t    pub d_selectors: *const EF,\n98\t    pub d_preprocessed: MainMatrixPtrs<EF>,\n99\t    pub d_main: *const MainMatrixPtrs<EF>,\n100\t    pub d_public: *const F,"}]},"parent_tool_use_id":"toolu_01Pd4JUY8b1Jx5eQTdsAE8zE","session_id":"694fb196-69bb-4e1f-a777-5a160503c446","uuid":"7a210591-26d2-4df9-8cc8-9a3b1a1c6c87","timestamp":"2026-04-15T13:46:37.257Z"}
