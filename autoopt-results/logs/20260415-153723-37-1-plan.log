{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jgx6UPRpth3c6yR7f9R96S","type":"tool_result","content":"1\tuse std::collections::BTreeMap;\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer};\n5\tuse openvm_stark_backend::{\n6\t    air_builders::symbolic::{\n7\t        symbolic_expression::SymbolicExpression, SymbolicConstraints, SymbolicDagBuilder,\n8\t        SymbolicExpressionDag,\n9\t    },\n10\t    prover::{fractional_sumcheck_gkr::Frac, MatrixDimensions},\n11\t};\n12\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n13\t\n14\tuse openvm_cuda_common::error::CudaError;\n15\t\n16\tuse super::{errors::Round0EvalError, LogupZerocheckError, Round0AirWorkItem, Round0ExtractTables};\n17\tuse crate::{\n18\t    cuda::logup_zerocheck::{\n19\t        _round0_extract_logup_polys, _round0_extract_zerocheck_poly,\n20\t        batched_logup_r0_eval_interactions, batched_zerocheck_r0_eval_constraints,\n21\t        Round0BlockCtx, Round0LogupCtx, Round0ZcCtx,\n22\t    },\n23\t    hash_scheme::GpuHashScheme,\n24\t    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n25\t    prelude::{EF, F},\n26\t};\n27\t\n28\tconst COSET_PARALLEL_THRESHOLD: u32 = 32768;\n29\tconst MAX_THREADS_R0: u32 = 128;\n30\tconst MIN_BATCHABLE_AIRS: usize = 50;\n31\t/// Max intermediates per AIR (Fp elements). Keeps aggregate arena small enough\n32\t/// that L2-cache reuse across wave fronts remains effective.\n33\tconst MAX_INTERMEDIATES_PER_AIR: usize = 16 * 1024 * 1024;\n34\t\n35\t/// Identify which work items are eligible for the batched Round 0 path.\n36\t///\n37\t/// A work item is batchable if it uses the coset-parallel kernel variant\n38\t/// (num_x * skip_domain < COSET_PARALLEL_THRESHOLD) and its intermediates\n39\t/// fit in the per-AIR memory budget. Returns an all-false vec if fewer than\n40\t/// MIN_BATCHABLE_AIRS qualify.\n41\t#[inline(never)]\n42\tpub fn identify_batchable_airs<HS: GpuHashScheme>(\n43\t    work_items: &[Round0AirWorkItem<HS>],\n44\t    l_skip: usize,\n45\t) -> Vec<bool> {\n46\t    let skip_domain = 1u32 << l_skip;\n47\t    let mut mask = vec![false; work_items.len()];\n48\t    let mut count = 0usize;\n49\t\n50\t    for (idx, w) in work_items.iter().enumerate() {\n51\t        let n_lift = w.n.max(0) as usize;\n52\t        let num_x = 1u32 << n_lift;\n53\t        if num_x * skip_domain >= COSET_PARALLEL_THRESHOLD {\n54\t            continue;\n55\t        }\n56\t        // Check intermediates budget\n57\t        let local_constraint_deg = w.single_pk.vk.max_constraint_degree as u32;\n58\t        let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n59\t        let block_x = std::cmp::min(MAX_THREADS_R0, skip_domain * num_x);\n60\t        let block_x = (block_x / skip_domain) * skip_domain;\n61\t        let x_per_block = block_x / skip_domain;\n62\t        let num_x_blocks = num_x.div_ceil(x_per_block);\n63\t        let buffer_stride = num_cosets_zc * num_x_blocks * block_x;\n64\t        let buffer_size = w.single_pk.other_data.zerocheck_round0.inner.buffer_size;\n65\t        let intermediates = buffer_stride as usize * std::cmp::max(buffer_size as usize, 1);\n66\t        if intermediates > MAX_INTERMEDIATES_PER_AIR {\n67\t            continue;\n68\t        }\n69\t        // Skip AIRs without zerocheck constraints\n70\t        if w.zc_intermed_cap == 0\n71\t            && w.eq_3bs.is_empty()\n72\t        {\n73\t            continue;\n74\t        }\n75\t        mask[idx] = true;\n76\t        count += 1;\n77\t    }\n78\t    if count < MIN_BATCHABLE_AIRS {\n79\t        mask.fill(false);\n80\t    }\n81\t    mask\n82\t}\n83\t\n84\t/// Pre-built logup DAG rules for one AIR, ready for the batched kernel.\n85\tstruct LogupRulesForAir {\n86\t    d_rules: DeviceBuffer<u128>,\n87\t    rules_len: usize,\n88\t    buffer_size: u32,\n89\t    d_numer_weights: DeviceBuffer<EF>,\n90\t    d_denom_weights: DeviceBuffer<EF>,\n91\t    denom_sum_init: EF,\n92\t}\n93\t\n94\t/// Build logup interaction DAG rules for a single AIR.\n95\t#[inline(never)]\n96\tfn build_logup_rules_for_air(\n97\t    symbolic: &SymbolicConstraints<F>,\n98\t    beta_pows: &[EF],\n99\t    eq_3bs: &[EF],\n100\t) -> Result<Option<LogupRulesForAir>, LogupZerocheckError> {\n101\t    if eq_3bs.is_empty() || symbolic.interactions.is_empty() {\n102\t        return Ok(None);\n103\t    }\n104\t    let mut dag_builder = SymbolicDagBuilder::new();\n105\t    let mut sorted_used_dag_idxs = Vec::new();\n106\t    for interaction in &symbolic.interactions {\n107\t        let count = dag_builder.add_expr(&interaction.count);\n108\t        sorted_used_dag_idxs.push(count);\n109\t        sorted_used_dag_idxs\n110\t            .extend(interaction.message.iter().map(|f| dag_builder.add_expr(f)));\n111\t    }\n112\t    sorted_used_dag_idxs.sort();\n113\t    sorted_used_dag_idxs.dedup();\n114\t    let dag = SymbolicExpressionDag {\n115\t        nodes: dag_builder.nodes,\n116\t        constraint_idx: sorted_used_dag_idxs,\n117\t    };\n118\t    let rules = SymbolicRulesGpu::new(&dag, true);\n119\t    let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n120\t    let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n121\t    let mut denom_sum_init = EF::ZERO;\n122\t    for (interaction_idx, interaction) in symbolic.interactions.iter().enumerate() {\n123\t        let count_dag_idx =\n124\t            dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];\n125\t        let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n126\t        numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n127\t        denom_sum_init += eq_3bs[interaction_idx]\n128\t            * beta_pows[interaction.message.len()]\n129\t            * F::from_u32(interaction.bus_index as u32 + 1);\n130\t        for (message_idx, message) in interaction.message.iter().enumerate() {\n131\t            let message_dag_idx =\n132\t                dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n133\t            let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n134\t            denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];\n135\t        }\n136\t    }\n137\t    let d_numer_weights = numer_weights.to_device()?;\n138\t    let d_denom_weights = denom_weights.to_device()?;\n139\t    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n140\t    let d_rules = encoded_rules.to_device()?;\n141\t    Ok(Some(LogupRulesForAir {\n142\t        d_rules,\n143\t        rules_len: rules.rules.len(),\n144\t        buffer_size: rules.buffer_size.try_into().unwrap(),\n145\t        d_numer_weights,\n146\t        d_denom_weights,\n147\t        denom_sum_init,\n148\t    }))\n149\t}\n150\t\n151\t/// Per-AIR descriptor used internally by the batch orchestration.\n152\tstruct BatchAirDesc {\n153\t    work_item_idx: usize,\n154\t    num_x: u32,\n155\t    height: u32,\n156\t    n: isize,\n157\t    g_shift: F,\n158\t    has_zc_constraints: bool,\n159\t    num_cosets_zc: u32,\n160\t    num_cosets_logup: u32,\n161\t    buffer_size_zc: u32,\n162\t    // Device pointers\n163\t    selectors_cube: *const F,\n164\t    preprocessed: *const F,\n165\t    d_main_parts: *const *const F,\n166\t    eq_cube: *const EF,\n167\t    lambda_pows: *const EF,\n168\t    public_values: *const F,\n169\t    d_zc_rules: *const std::ffi::c_void,\n170\t    d_zc_used_nodes: *const usize,\n171\t    zc_rules_len: usize,\n172\t    zc_used_nodes_len: usize,\n173\t    lambda_len: usize,\n174\t    logup_rules: Option<LogupRulesForAir>,\n175\t    // Batch offsets into d_batch_array\n176\t    zc_batch_offset: usize,\n177\t    numer_batch_offset: usize,\n178\t    denom_batch_offset: usize,\n179\t}\n180\t\n181\tunsafe impl Send for BatchAirDesc {}\n182\tunsafe impl Sync for BatchAirDesc {}\n183\t\n184\t/// Execute batched Round 0 for all batchable AIRs.\n185\t///\n186\t/// Runs batched eval+reduce kernels for groups of small AIRs, then calls\n187\t/// per-AIR GPU extraction kernels to write polynomial coefficients directly\n188\t/// into d_batch_array. Called from within `sumcheck_uni_round0_polys` after\n189\t/// Phase 1 but before Phase 2.\n190\t#[inline(never)]\n191\t#[allow(clippy::too_many_arguments)]\n192\tpub fn batch_round0_small_airs<HS: GpuHashScheme>(\n193\t    work_items: &[Round0AirWorkItem<HS>],\n194\t    batchable: &[bool],\n195\t    l_skip: usize,\n196\t    d_batch_ptr: *mut EF,\n197\t    extract_tables: &rustc_hash::FxHashMap<usize, Round0ExtractTables>,\n198\t    eq_xis: &rustc_hash::FxHashMap<usize, super::EqEvalLayers<EF>>,\n199\t    eq_3b_per_trace: &[Vec<EF>],\n200\t    beta_pows: &[EF],\n201\t) -> Result<(), LogupZerocheckError> {\n202\t    let skip_domain = 1u32 << l_skip;\n203\t    let batchable_count = batchable.iter().filter(|&&b| b).count();\n204\t    if batchable_count == 0 {\n205\t        return Ok(());\n206\t    }\n207\t    tracing::info!(\"batch_round0: processing {batchable_count} small AIRs via batched kernels\");\n208\t\n209\t    // Build main_parts device pointers in a single batched upload.\n210\t    let mut all_main_ptrs: Vec<*const F> = Vec::new();\n211\t    let mut main_ptrs_offsets: Vec<usize> = Vec::with_capacity(work_items.len());\n212\t    for (idx, w) in work_items.iter().enumerate() {\n213\t        if !batchable[idx] {\n214\t            main_ptrs_offsets.push(0);\n215\t            continue;\n216\t        }\n217\t        let offset = all_main_ptrs.len();\n218\t        main_ptrs_offsets.push(offset);\n219\t        for committed in w.cached_mains {\n220\t            all_main_ptrs.push(committed.trace.buffer().as_ptr());\n221\t        }\n222\t        all_main_ptrs.push(w.common_main.buffer().as_ptr());\n223\t    }\n224\t    let d_all_main_ptrs = if all_main_ptrs.is_empty() {\n225\t        DeviceBuffer::new()\n226\t    } else {\n227\t        all_main_ptrs.to_device()?\n228\t    };\n229\t\n230\t    // Build per-AIR descriptors.\n231\t    let mut descs: Vec<BatchAirDesc> = Vec::with_capacity(batchable_count);\n232\t    for (idx, w) in work_items.iter().enumerate() {\n233\t        if !batchable[idx] {\n234\t            continue;\n235\t        }\n236\t        let single_pk = w.single_pk;\n237\t        let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n238\t        let n_lift = w.n.max(0) as usize;\n239\t        let num_x = 1u32 << n_lift;\n240\t        let height = w.common_main.height() as u32;\n241\t        let log_large_domain = p3_util::log2_ceil_usize(local_constraint_deg << l_skip);\n242\t        let g_shift = F::two_adic_generator(log_large_domain);\n243\t        let num_cosets_zc = local_constraint_deg.saturating_sub(1) as u32;\n244\t        let num_cosets_logup = local_constraint_deg as u32;\n245\t\n246\t        let zc_rules = &single_pk.other_data.zerocheck_round0;\n247\t        let buffer_size_zc = zc_rules.inner.buffer_size;\n248\t\n249\t        let preprocessed = single_pk\n250\t            .preprocessed_data\n251\t            .as_ref()\n252\t            .map(|cd| cd.trace.buffer().as_ptr())\n253\t            .unwrap_or(std::ptr::null());\n254\t\n255\t        let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n256\t        let logup_rules = build_logup_rules_for_air(\n257\t            &single_air_constraints,\n258\t            beta_pows,\n259\t            &eq_3b_per_trace[w.trace_idx],\n260\t        )?;\n261\t\n262\t        let d_main_parts = if d_all_main_ptrs.is_empty() {\n263\t            std::ptr::null()\n264\t        } else {\n265\t            unsafe { d_all_main_ptrs.as_ptr().add(main_ptrs_offsets[idx]) }\n266\t        };\n267\t\n268\t        let has_zc_constraints = !single_pk\n269\t            .vk\n270\t            .symbolic_constraints\n271\t            .constraints\n272\t            .constraint_idx\n273\t            .is_empty();\n274\t\n275\t        let d_lambda_pows = w.d_lambda_pows;\n276\t\n277\t        descs.push(BatchAirDesc {\n278\t            work_item_idx: idx,\n279\t            num_x,\n280\t            height,\n281\t            n: w.n,\n282\t            g_shift,\n283\t            has_zc_constraints,\n284\t            num_cosets_zc,\n285\t            num_cosets_logup,\n286\t            buffer_size_zc,\n287\t            selectors_cube: w.selectors_cube.buffer().as_ptr(),\n288\t            preprocessed,\n289\t            d_main_parts,\n290\t            eq_cube: eq_xis[&n_lift].get_ptr(n_lift),\n291\t            lambda_pows: d_lambda_pows.as_ptr(),\n292\t            public_values: w.public_values.as_ptr(),\n293\t            d_zc_rules: zc_rules.inner.d_rules.as_raw_ptr(),\n294\t            d_zc_used_nodes: zc_rules.inner.d_used_nodes.as_ptr(),\n295\t            zc_rules_len: zc_rules.inner.d_rules.len(),\n296\t            zc_used_nodes_len: zc_rules.inner.d_used_nodes.len(),\n297\t            lambda_len: d_lambda_pows.len(),\n298\t            logup_rules,\n299\t            zc_batch_offset: w.zc_batch_offset,\n300\t            numer_batch_offset: w.numer_batch_offset,\n301\t            denom_batch_offset: w.denom_batch_offset,\n302\t        });\n303\t    }\n304\t\n305\t    // Group by num_cosets_zc, launch batched zerocheck.\n306\t    let mut zc_groups: BTreeMap<u32, Vec<usize>> = BTreeMap::new();\n307\t    for (i, d) in descs.iter().enumerate() {\n308\t        if d.has_zc_constraints && d.num_cosets_zc > 0 {\n309\t            zc_groups.entry(d.num_cosets_zc).or_default().push(i);\n310\t        }\n311\t    }\n312\t\n313\t    for (&num_cosets, air_indices) in &zc_groups {\n314\t        let group_descs: Vec<&BatchAirDesc> = air_indices.iter().map(|&i| &descs[i]).collect();\n315\t        tracing::debug!(\n316\t            \"batch_round0: zc group num_cosets={num_cosets} airs={}\",\n317\t            group_descs.len()\n318\t        );\n319\t        let output =\n320\t            evaluate_batched_zerocheck_group(&group_descs, num_cosets, skip_domain)?;\n321\t        if !output.is_empty() {\n322\t            // Run per-AIR extraction: write from batched output to d_batch_array.\n323\t            let stride = num_cosets as usize * skip_domain as usize;\n324\t            for (local_idx, &desc_idx) in air_indices.iter().enumerate() {\n325\t                let d = &descs[desc_idx];\n326\t                let w = &work_items[d.work_item_idx];\n327\t                let local_constraint_deg = w.single_pk.vk.max_constraint_degree as usize;\n328\t                let tables = &extract_tables[&local_constraint_deg];\n329\t                let err = unsafe {\n330\t                    _round0_extract_zerocheck_poly(\n331\t                        d_batch_ptr.add(d.zc_batch_offset),\n332\t                        output.as_ptr().add(local_idx * stride),\n333\t                        tables.zc_transform.as_ptr(),\n334\t                        tables.zc_input_size,\n335\t                        tables.zc_output_size,\n336\t                    )\n337\t                };\n338\t                if err != 0 {\n339\t                    return Err(Round0EvalError::Cuda(CudaError::new(err)).into());\n340\t                }\n341\t            }\n342\t        }\n343\t    }\n344\t\n345\t    // Group by num_cosets_logup, launch batched logup.\n346\t    let mut logup_groups: BTreeMap<u32, Vec<usize>> = BTreeMap::new();\n347\t    for (i, d) in descs.iter().enumerate() {\n348\t        if d.logup_rules.is_some() && d.num_cosets_logup > 0 {\n349\t            logup_groups.entry(d.num_cosets_logup).or_default().push(i);\n350\t        }\n351\t    }\n352\t\n353\t    for (&num_cosets, air_indices) in &logup_groups {\n354\t        let group_descs: Vec<&BatchAirDesc> = air_indices.iter().map(|&i| &descs[i]).collect();\n355\t        tracing::debug!(\n356\t            \"batch_round0: logup group num_cosets={num_cosets} airs={}\",\n357\t            group_descs.len()\n358\t        );\n359\t        let output =\n360\t            evaluate_batched_logup_group(&