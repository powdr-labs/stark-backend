9\t                tables.zc_output_size,\n310\t            )\n311\t        };\n312\t        if err != 0 {\n313\t            return Err(Round0EvalError::Cuda(CudaError::new(err)).into());\n314\t        }\n315\t    }\n316\t    // sum_buffer dropped here; cudaFreeAsync is ordered after the kernel on the same stream\n317\t\n318\t    let num_cosets_logup = local_constraint_deg;\n319\t\n320\t    // Check if pre-allocated logup buffers are large enough for this AIR\n321\t    let logup_prealloc_inter = if w.logup_intermed_cap > 0\n322\t        && bufs.logup_intermediates.len() >= w.logup_intermed_cap\n323\t    {\n324\t        Some(&mut bufs.logup_intermediates)\n325\t    } else {\n326\t        None\n327\t    };\n328\t    let logup_prealloc_temp = if w.logup_temp_sums_cap > 0\n329\t        && bufs.logup_temp_sums.len() >= w.logup_temp_sums_cap\n330\t    {\n331\t        Some(&mut bufs.logup_temp_sums)\n332\t    } else {\n333\t        None\n334\t    };\n335\t\n336\t    let sum = evaluate_round0_interactions_gpu(\n337\t        single_pk,\n338\t        &single_air_constraints,\n339\t        w.selectors_cube.buffer(),\n340\t        &d_main_parts,\n341\t        w.public_values,\n342\t        eq_xi_tree.get_ptr(n_lift),\n343\t        w.beta_pows,\n344\t        w.eq_3bs,\n345\t        1 << w.l_skip,\n346\t        1 << n_lift,\n347\t        height as u32,\n348\t        num_cosets_logup as u32,\n349\t        omega_root,\n350\t        w.max_temp_bytes,\n351\t        logup_prealloc_inter,\n352\t        logup_prealloc_temp,\n353\t    )?;\n354\t\n355\t    if !sum.is_empty() {\n356\t        let tables = &extract_tables[&local_constraint_deg];\n357\t        let norm_factor: EF = if w.n.is_negative() {\n358\t            EF::from(F::from_u32(1 << w.n.unsigned_abs()).inverse())\n359\t        } else {"}]},"parent_tool_use_id":"toolu_018XNYrch4i7K7fQWykXd8Lb","session_id":"694fb196-69bb-4e1f-a777-5a160503c446","uuid":"bb5fdf97-a4c8-42b1-bdd3-478d1bf70251","timestamp":"2026-04-15T14:23:32.232Z"}
