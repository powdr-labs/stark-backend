     let mut pq_size = 2 << round;\n669\t\n670\t        let lambda = transcript.sample_ext();\n671\t\n672\t        let tmp_buffer_capacity =\n673\t            unsafe { _frac_compute_round_temp_buffer_size((1 << round) as u32) } as usize;\n674\t        if tmp_buffer_capacity > tmp_block_sums.len() {\n675\t            tmp_block_sums = DeviceBuffer::<EF>::with_capacity(tmp_buffer_capacity);\n676\t        }\n677\t\n678\t        let last_outer_round = round == total_rounds - 1;\n679\t        debug_assert!(round > 0);\n680\t        let backend = choose_round_strategy(\n681\t            round,\n682\t            precompute_m_env,\n683\t            precompute_m_min_blocks_threshold,\n684\t            precompute_m_target_blocks,\n685\t            precompute_m_tail_tile_override,\n686\t            precompute_m_min_n,\n687\t        );\n688\t\n689\t        // In round `j`, contains `s_{j-1}(r_{j-1})`. Starts with the sumcheck's sum claim.\n690\t        let (numer_claim, denom_claim) =\n691\t            reduce_to_single_evaluation(claims_per_layer.last().unwrap(), /* mu */ xi_prev[0]);\n692\t        let mut prev_s_eval = numer_claim + lambda * denom_claim;\n693\t        let mut eq_r_acc = EF::ONE;\n694\t\n695\t        // Round 0: compute + revert fused. The pq_buffer fold will be fused into next round's\n696\t        // compute. This fuses frac_build_tree_layer(revert=true) with the first inner round\n697\t        // compute.\n698\t        let r0 = do_sumcheck_round_and_revert(\n699\t            &mut eq_buffer,\n700\t            &mut layer,\n701\t            pq_size,\n702\t            lambda,\n703\t            transcript,\n704\t            &mut d_sum_evals,\n705\t            &mut tmp_block_sums,\n706\t            &mut round_polys_eval,\n707\t            &mut r_vec,\n708\t            &mut prev_s_eval,\n709\t            xi_prev[0],\n710\t            &mut eq_r_acc,\n711\t        )?;\n712\t\n713\t        // Fused rounds 1..(round-1): compute + fold using prev_r.\n714\t        let mut