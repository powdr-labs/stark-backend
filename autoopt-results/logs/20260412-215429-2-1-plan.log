{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HD59pxdR2vBYiqdVMcScCX","type":"tool_result","content":"54\tpub struct SystemParams {\n55\t    pub l_skip: usize,\n56\t    pub n_stack: usize,\n57\t    /// Maximum number of stacked polynomials (i.e. stacked matrix width). This implies a max\n58\t    /// stacked cell count of `w_stack * 2^(n_stack + l_skip)`.\n59\t    pub w_stack: usize,\n60\t    /// `-log_2` of the rate for the initial Reed-Solomon code.\n61\t    pub log_blowup: usize,\n62\t    #[getset(get = \"pub\")]\n63\t    pub whir: WhirConfig,\n64\t    pub logup: LogUpSecurityParameters,\n65\t    /// Global max constraint degree enforced across all AIR and Interaction constraints\n66\t    pub max_constraint_degree: usize,\n67\t}\n68\t\n69\timpl SystemParams {\n70\t    pub fn logup_pow_bits(&self) -> usize {\n71\t        self.logup.pow_bits\n72\t    }\n73\t\n74\t    pub fn k_whir(&self) -> usize {\n75\t        self.whir.k\n76\t    }\n77\t\n78\t    #[inline]\n79\t    pub fn log_stacked_height(&self) -> usize {\n80\t        self.l_skip + self.n_stack\n81\t    }\n82\t\n83\t    #[inline]\n84\t    pub fn log_final_poly_len(&self) -> usize {\n85\t        self.whir.log_final_poly_len(self.log_stacked_height())\n86\t    }\n87\t\n88\t    #[inline]\n89\t    pub fn num_whir_rounds(&self) -> usize {\n90\t        self.whir.num_whir_rounds()\n91\t    }\n92\t\n93\t    #[inline]\n94\t    pub fn num_whir_sumcheck_rounds(&self) -> usize {\n95\t        self.whir.num_sumcheck_rounds()\n96\t    }\n97\t\n98\t    /// Constructor with many configuration options. Only `k_whir`, `max_constraint_degree`,\n99\t    /// `query_phase_pow_bits` are preset with constants.\n100\t    ///\n101\t    /// The `security_bits` is the target bits of security. It is used to select the number of WHIR\n102\t    /// queries, but does **not** guarantee the target security level is achieved by the overall\n103\t    /// protocol using these parameters. Use the soundness calculator to ensure the target security\n104\t    /// level is met.\n105\t    ///\n106\t    /// This function should only be used for internal cryptography libraries. Most users should\n107\t    /// instead use preset parameters provided in SDKs.\n108\t    #[allow(clippy::too_many_arguments)]\n109\t    pub fn new(\n110\t        log_blowup: usize,\n111\t        l_skip: usize,\n112\t        n_stack: usize,\n113\t        w_stack: usize,\n114\t        log_final_poly_len: usize,\n115\t        folding_pow_bits: usize,\n116\t        mu_pow_bits: usize,\n117\t        proximity: WhirProximityStrategy,\n118\t        security_bits: usize,\n119\t        logup: LogUpSecurityParameters,\n120\t    ) -> SystemParams {\n121\t        const WHIR_QUERY_PHASE_POW_BITS: usize = 20;\n122\t\n123\t        let k_whir = DEFAULT_K_WHIR;\n124\t        let max_constraint_degree = 4;\n125\t        let log_stacked_height = l_skip + n_stack;\n126\t\n127\t        SystemParams {\n128\t            l_skip,\n129\t            n_stack,\n130\t            w_stack,\n131\t            log_blowup,\n132\t            whir: WhirConfig::new(\n133\t                log_blowup,\n134\t                log_stacked_height,\n135\t                WhirParams {\n136\t                    k: k_whir,\n137\t                    log_final_poly_len,\n138\t                    query_phase_pow_bits: WHIR_QUERY_PHASE_POW_BITS,\n139\t                    proximity,\n140\t                    folding_pow_bits,\n141\t                    mu_pow_bits,\n142\t                },\n143\t                security_bits,\n144\t            ),\n145\t            logup,\n146\t            max_constraint_degree,\n147\t        }\n148\t    }\n149\t}\n150\t\n151\t/// Configurable parameters that are used to determine the [WhirConfig] for a target security level.\n152\t#[derive(Clone, Copy, Debug, Serialize, Deserialize, PartialEq, Eq)]\n153\tpub struct WhirParams {"}]},"parent_tool_use_id":"toolu_01Wizx9eNexzGPa86sob5mCL","session_id":"f1ad9314-c536-427a-92c1-585cbcf5d248",