         self.zerocheck_tilde_evals[trace_idx] = host[i];\n1239\t                // zc_out not set for num_x=1, handled from tilde_eval in compute_batch_s\n1240\t            }\n1241\t        }\n1242\t\n1243\t        // Logup for early traces: partition by num_y threshold\n1244\t        if !early_eval.is_empty() {\n1245\t            evaluate_logup_batched(\n1246\t                &early_eval,\n1247\t                self.pk,\n1248\t                d_challenges_ptr,\n1249\t                sp_deg as u32,\n1250\t                self.monomial_num_y_threshold,\n1251\t                &self.logup_combinations,\n1252\t                &mut logup_out,\n1253\t                &mut self.logup_tilde_evals,\n1254\t                self.memory_limit_bytes,\n1255\t            )\n1256\t            .map_err(LogupZerocheckError::MleInteractionEval)?;\n1257\t        }\n1258\t\n1259\t        // Early traces (num_y>1): partition by threshold for zerocheck path\n1260\t        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n1261\t            .iter()\n1262\t            .filter(|t| t.has_constraints)\n1263\t            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n1264\t\n1265\t        // Partition high num_y traces by monomial-to-rules ratio\n1266\t        // (traces without monomials are skipped - they contribute zero)\n1267\t        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n1268\t            high_early.iter().partition(|t| {\n1269\t                let num_monomials = get_num_monomials(t, self.pk);\n1270\t                let rules_len = get_zerocheck_rules_len(t, self.pk);\n1271\t                // Use DAG when monomial expansion significantly increased the term count\n1272\t                num_monomials as usize >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len\n1273\t            });\n1274\t\n1275\t        // DAG evaluation for high num_y traces with high monomial-to-rules ratio\n1276\t        if !high_dag_traces.is_empty() {\n1277\t            let lambda_pows = self.lambda_pows.as_ref().unwrap();\n1278\t            evaluate_zerocheck_batched(\n1279\t                high_dag_traces,\n1280\t                self.pk,\n1281\t                lambda_pows,\n1282\t                sp_deg as u32,\n1283\t                &mut zc_out,\n1284\t                self.memory_limit_bytes,\n1285\t            )\n1286\t            .map_err(LogupZerocheckError::MleConstraintEval)?;\n1287\t        }\n1288\t\n1289\t        // Par-Y monomial kernel for high num_y traces\n1290\t        if !high_mono_traces.is_empty() {\n1291\t            let lambda_combs: Vec<_> = high_mono_traces\n1292\t                .iter()\n1293\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1294\t                .collect();\n1295\t            let batch = ZerocheckMonomialParYBatch::new(\n1296\t                high_mono_traces,\n1297\t                self.pk,\n1298\t                &lambda_combs,\n1299\t                self.sm_count,\n1300\t                sp_deg as u32,\n1301\t                None,\n1302\t            )?;\n1303\t            let out = batch\n1304\t                .evaluate(sp_deg as u32)\n1305\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1306\t            let host = out.to_host()?;\n1307\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1308\t                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n1309\t            }\n1310\t        }\n1311\t\n1312\t        // Monomial zerocheck for low num_y traces\n1313\t        let low_mono_traces = low_early;\n1314\t        if !low_mono_traces.is_empty() {\n1315\t            let lambda_combs: Vec<_> = low_mono_traces\n1316\t                .iter()\n1317\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1318\t                .collect();\n1319\t            let batch = ZerocheckMonomialBatch::new(low_mono_traces, self.pk, &lambda_combs)?;\n1320\t            let out = batch\n1321\t                .evaluate(sp_deg as u32)\n1322\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1323\t            let host = out.to_host()?;\n1324\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1325\t                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n1326\t            }\n1327\t        }\n1328\t\n1329\t        Ok(logup_out.into_iter().flatten().chain(zc_out).collect())\n1330\t    }\n1331\t\n1332\t    #[instrument(level = \"debug\", skip_all, fields(round = round))]\n1333\t    fn compute_batch_s_poly(\n1334\t        &mut self,\n1335\t        sp_round_evals: Vec<Vec<EF>>,\n1336\t        num_traces: usize,\n1337\t        round: usize,\n1338\t        mu_pows: &[EF],\n1339\t    ) -> UnivariatePoly<EF> {\n1340\t        debug_assert_eq!(sp_round_evals.len(), 3 * num_traces);\n1341\t        debug_assert_eq!(sp_round_evals.len(), mu_pows.len());\n1342\t        let constraint_degree = self.constraint_degree;\n1343\t        let mut sp_head_zc = vec![EF::ZERO; constraint_degree];\n1344\t        let mut sp_head_logup = vec![EF::ZERO; constraint_degree];\n1345\t        let mut sp_tail = EF::ZERO;\n1346\t        for (trace_idx, &n) in self.n_per_trace.iter().enumerate() {\n1347\t            let n_lift = n.max(0) as usize;\n1348\t            let zc_idx = 2 * num_traces + trace_idx;\n1349\t            let numer_idx = 2 * trace_idx;\n1350\t            let denom_idx = numer_idx + 1;\n1351\t            if round == n_lift + 1 {\n1352\t                let eq_r_acc = *self.eq_ns.last().unwrap();\n1353\t                let eq_sharp_r_acc = *self.eq_sharp_ns.last().unwrap();\n1354\t                self.zerocheck_tilde_evals[trace_idx] *= eq_r_acc;\n1355\t                self.logup_tilde_evals[trace_idx][0] *= eq_sharp_r_acc;\n1356\t                self.logup_tilde_evals[trace_idx][1] *= eq_sharp_r_acc;\n1357\t            }\n1358\t            if round <= n_lift {\n1359\t  