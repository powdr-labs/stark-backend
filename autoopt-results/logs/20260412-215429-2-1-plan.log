{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FVMbwNTrysXf2g1YKaEHdB","type":"tool_result","content":"1\t//! Backend for proving and verifying mixed-matrix STARKs.\n2\t//! The backend is designed to be modular and compatible with different hardware implementations.\n3\t//! The backend provides prover and verifier implementations of the SWIRL proof system.\n4\t//!\n5\t//! The aim is to support different circuit representations and permutation/lookup arguments.\n6\t\n7\t// Re-export all Plonky3 crates\n8\tpub use p3_air;\n9\tpub use p3_challenger;\n10\tpub use p3_field;\n11\tpub use p3_matrix;\n12\tpub use p3_maybe_rayon;\n13\tpub use p3_symmetric;\n14\tpub use p3_util;\n15\tuse p3_util::log2_ceil_u64;\n16\t\n17\t/// AIR builders for prover and verifier, including support for cross-matrix permutation arguments.\n18\tpub mod air_builders;\n19\tpub mod codec;\n20\t/// Copy of Plonky3's DFT module without parallelism (Rayon) for faster single-threaded execution.\n21\t/// Used by the prover **only**.\n22\tpub mod dft;\n23\tpub mod duplex_sponge;\n24\t/// Protocol hasher trait definition.\n25\tpub mod hasher;\n26\t/// Log-up permutation argument implementation as RAP.\n27\tpub mod interaction;\n28\t/// Proving and verifying key generation\n29\tpub mod keygen;\n30\t/// Common polynomial utilities shared by prover and verifier\n31\tpub mod poly_common;\n32\t/// Definition of the STARK proof struct.\n33\tpub mod proof;\n34\tpub mod prover;\n35\tpub mod soundness;\n36\tpub mod utils;\n37\tpub mod verifier;\n38\t\n39\t#[cfg(any(test, feature = \"test-utils\"))]\n40\tpub mod test_utils;\n41\t// #[cfg(test)]\n42\t// pub mod tests;\n43\t\n44\tmod any_air;\n45\t/// STARK Protocol configuration trait\n46\tmod config;\n47\t/// Trait for STARK backend engine proving keygen, proviing, verifying API functions.\n48\tmod engine;\n49\t/// Fiat-Shamir transcript trait definition.\n50\tmod transcript;\n51\tpub use any_air::*;\n52\tpub use config::*;\n53\tpub use engine::*;\n54\tpub use transcript::*;\n55\t\n56\t// Use jemalloc as global allocator for performance\n57\t#[cfg(all(feature = \"jemalloc\", unix, not(test)))]\n58\t#[global_allocator]\n59\tstatic GLOBAL: tikv_jemallocator::Jemalloc = tikv_jemallocator::Jemalloc;\n60\t\n61\t// Use mimalloc as global allocator\n62\t#[cfg(all(feature = \"mimalloc\", not(test)))]\n63\t#[global_allocator]\n64\tstatic GLOBAL: mimalloc::MiMalloc = mimalloc::MiMalloc;\n65\t\n66\t/// Common utility function for computing `n_logup` parameter in terms of `total_interactions`,\n67\t/// which is the sum of interaction message counts across all traces, using the lifted trace\n68\t/// heights.\n69\t///\n70\t/// This calculation must be consistent between the prover and verifier and is enforced by\n71\t/// the verifier.\n72\t// NOTE: we could use a more strict calculation of `n_logup = log2_ceil(total_interactions >>\n73\t// l_skip)` but the `leading_zeros` calculation below is easier to check in the recursion\n74\t// circuit. The formula below is equivalent to `log2_ceil(total_interactions + 1) - l_skip`.\n75\tpub fn calculate_n_logup(l_skip: usize, total_interactions: u64) -> usize {\n76\t    if total_interactions != 0 {\n77\t        let n_logup = (u64::BITS - total_interactions.leading_zeros()) as usize - l_skip;\n78\t        debug_assert_eq!(\n79\t            n_logup + l_skip,\n80\t            log2_ceil_u64(total_interactions + 1) as usize\n81\t        );\n82\t        n_logup\n83\t    } else {\n84\t        0\n85\t    }\n86\t}\n87\t"}]},"parent_tool_use_id":"toolu_01WjQzKcf5YBN8o2NmC1Vhua","session_id":"f1ad9314-c536-427a-92c1-585cbcf5d248","uuid":"70b4fe0e-fac5-4900-95b0-be1c57f900ee","timestamp":"2026-04-12T20:11:10.456Z"}
