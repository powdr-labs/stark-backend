{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015NCrUNVXpmVhBP2MxEzm8C","type":"tool_result","content":"150\t    }\n151\t}\n152\t\n153\textern \"C\" int _zerocheck_monomial_batched(\n154\t    FpExt *tmp_sums,\n155\t    FpExt *output,\n156\t    const BlockCtx *block_ctxs,\n157\t    const MonomialAirCtx *air_ctxs,\n158\t    const uint32_t *air_block_offsets,\n159\t    uint32_t num_blocks,\n160\t    uint32_t num_x,\n161\t    uint32_t num_airs,\n162\t    uint32_t threads_per_block\n163\t) {\n164\t    if (num_blocks == 0) {\n165\t        return 0;\n166\t    }\n167\t\n168\t    dim3 grid(num_blocks, num_x);\n169\t    dim3 block(threads_per_block);\n170\t    size_t shmem = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n171\t\n172\t    // Phase 1: Main monomial evaluation kernel\n173\t    zerocheck_monomial_kernel<<<grid, block, shmem>>>(\n174\t        tmp_sums, block_ctxs, air_ctxs, threads_per_block\n175\t    );\n176\t    int err = CHECK_KERNEL();\n177\t    if (err != 0)\n178\t        return err;\n179\t\n180\t    // Phase 2: Batched reduction for all AIRs in single launch\n181\t    // Grid: (num_airs, num_x) - each block handles one (air, x) pair\n182\t    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n183\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n184\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n185\t\n186\t    dim3 reduce_grid(num_airs, num_x);\n187\t    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n188\t        tmp_sums, output, air_block_offsets, num_x\n189\t    );\n190\t\n191\t    return CHECK_KERNEL();\n192\t}\n193\t\n194\t// ============================================================================\n195\t// PAR-Y KERNEL (parallelizes over y_int, tiles monomials)\n196\t// ============================================================================\n197\t\n198\t__global__ void zerocheck_monomial_par_y_kernel(\n199\t    FpExt *__restrict__ tmp_sums,\n200\t    const BlockCtx *__restrict__ block_ctxs,\n201\t    const MonomialAirCtx *__restrict__ air_ctxs,\n202\t    uint32_t threads_per_block,\n203\t    uint32_t chunk_size // monomials per mono_chunk\n204\t) {\n205\t    extern __shared__ char smem[];\n206\t    FpExt *shared = (FpExt *)smem;\n207\t\n208\t    BlockCtx bctx = block_ctxs[blockIdx.x];\n209\t    MonomialAirCtx actx = air_ctxs[bctx.air_idx];\n210\t\n211\t    uint32_t num_x = gridDim.y;\n212\t    uint32_t x_int = blockIdx.y;\n213\t\n214\t    // Decode y_block and mono_chunk from local_block_idx_x\n215\t    // Encoding: local_block_idx_x = y_block * air_mono_chunks + mono_chunk\n216\t    uint32_t air_mono_chunks = (actx.num_monomials + chunk_size - 1) / chunk_size;\n217\t    uint32_t y_block = bctx.local_block_idx_x / air_mono_chunks;\n218\t    uint32_t mono_chunk = bctx.local_block_idx_x % air_mono_chunks;\n219\t\n220\t    // Decode y_int from thread position within y_block\n221\t    uint32_t y_int = threadIdx.x + y_block * threads_per_block;\n222\t    bool active = (y_int < actx.num_y);\n223\t\n224\t    uint32_t height = num_x * actx.num_y;\n225\t    uint32_t row = x_int * actx.num_y + y_int;\n226\t\n227\t    // Contiguous chunk of monomials for this mono_chunk\n228\t    uint32_t mono_start = mono_chunk * chunk_size;\n229\t    uint32_t mono_end = min(mono_start + chunk_size, actx.num_monomials);"}]},"parent_tool_use_id":"toolu_01KqFCVJDc9WJFhZ42umbk3D","session_id":"f1ad9314-c536-427a-92c1-585cbcf5d248","uuid":"177486b5-85b4-4f8b-84cc-48adcfe557ba","timestamp":"2026-04-12T19:59:21.392Z"}
