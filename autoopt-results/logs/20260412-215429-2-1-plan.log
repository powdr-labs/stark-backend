   )\n241\t    .entered();\n242\t    #[allow(clippy::needless_range_loop)]\n243\t    for round in 1..=n_stack {\n244\t        let batch_s_evals = prover.batch_sumcheck_poly_eval(round, u_vec[round - 1])?;\n245\t\n246\t        for &eval in &batch_s_evals {\n247\t            transcript.observe_ext(eval);\n248\t        }\n249\t        sumcheck_round_polys.push(batch_s_evals);\n250\t\n251\t        let u_round = transcript.sample_ext();\n252\t        u_vec.push(u_round);\n253\t        debug!(%round, %u_round);\n254\t\n255\t        prover.fold_mle_evals(round, u_round)?;\n256\t    }\n257\t    let stacking_openings = prover.get_stacked_openings()?;\n258\t    for claims_for_com in &stacking_openings {\n259\t        for &claim in claims_for_com {\n260\t            transcript.observe_ext(claim);\n261\t        }\n262\t    }\n263\t    drop(_mle_rounds_span);\n264\t    let proof = StackingProof {\n265\t        univariate_round_coeffs: s_0.into_coeffs(),\n266\t        sumcheck_round_polys,\n267\t        stacking_openings,\n268\t    };\n269\t    Ok((proof, u_vec, prover.stacked_per_commit))\n270\t}\n271\t\n272\timpl<D: Copy + Clone + Send + Sync + 'static> StackedReductionGpu<D> {\n273\t    #[instrument(\"stacked_reduction_new\", level = \"debug\", skip_all)]\n274\t    fn new<HS: GpuHashScheme<Digest = D>>(\n275\t        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n276\t        ctx: ProvingContext<GenericGpuBackend<HS>>,\n277\t        common_main_pcs_data: StackedPcsDataGpu<F, D>,\n278\t        r: &[EF],\n279\t        lambda: EF,\n280\t        sm_count: u32,\n281\t    ) -> Result<Self, StackedReductionError> {\n282\t        ensure_device_ntt_twiddles_initialized();\n283\t        let mem = MemTracker::start(\"prover.stacked_reduction_new\");\n284\t        let l_skip = mpk.params.l_skip;\n285\t        let n_stack = mpk.params.n_stack;\n286\t\n287\t        let omega_skip = F::two_adic_generator(l_skip);\n288\t        let omega_skip_pows = omega_skip.powers().take(1 << l_