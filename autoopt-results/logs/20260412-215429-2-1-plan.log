{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M1G6K8bw8QHqTgdDhrpiLq","type":"tool_result","content":"1\t#include \"eval_ctx.cuh\"\n2\t#include \"frac_ext.cuh\"\n3\t#include \"launcher.cuh\"\n4\t#include \"monomial.cuh\"\n5\t#include \"sumcheck.cuh\"\n6\t\n7\t#include <cassert>\n8\t#include <cstdint>\n9\t\n10\tnamespace logup_zerocheck_mle {\n11\t\n12\t__device__ __forceinline__ FpExt\n13\teval_variable(PackedVar var, uint32_t row, const EvalCoreCtx &ctx, uint32_t height) {\n14\t    uint8_t entry_type = var.entry_type();\n15\t    uint8_t offset = var.offset();\n16\t\n17\t    switch (entry_type) {\n18\t    case 1: { // MAIN\n19\t        auto main_ptr = ctx.d_main[var.part_index()];\n20\t        const auto stride = height * main_ptr.air_width;\n21\t        const FpExt *__restrict__ matrix = main_ptr.data + stride * offset;\n22\t        const FpExt *__restrict__ column = matrix + height * var.col_index();\n23\t        return column[row];\n24\t    }\n25\t    case 0: { // PREPROCESSED\n26\t        const auto stride = height * ctx.d_preprocessed.air_width;\n27\t        const FpExt *__restrict__ matrix = ctx.d_preprocessed.data + stride * offset;\n28\t        const FpExt *__restrict__ column = matrix + height * var.col_index();\n29\t        return column[row];\n30\t    }\n31\t    case 3: // PUBLIC\n32\t        return FpExt(ctx.d_public[var.col_index()]);\n33\t    case 8: // IS_FIRST\n34\t        return ctx.d_selectors[row];\n35\t    case 9: // IS_LAST\n36\t        return ctx.d_selectors[2 * height + row];\n37\t    case 10: // IS_TRANSITION\n38\t        return ctx.d_selectors[height + row];\n39\t    default:\n40\t        assert(false);\n41\t    }\n42\t    return FpExt(Fp::zero());\n43\t}\n44\t\n45\t// For batched monomial evaluation across multiple AIRs\n46\tstruct MonomialAirCtx {\n47\t    const MonomialHeader *__restrict__ d_headers;\n48\t    const PackedVar *__restrict__ d_variables;\n49\t    const FpExt *__restrict__ d_lambda_combinations; // Precomputed per-monomial\n50\t    uint32_t num_monomials;\n51\t    EvalCoreCtx eval_ctx;\n52\t    const FpExt *__restrict__ d_eq_xi;\n53\t    uint32_t num_y;\n54\t};\n55\t\n56\t// ============================================================================\n57\t// PRECOMPUTE LAMBDA COMBINATIONS (once per AIR after lambda is sampled)\n58\t// ============================================================================\n59\t\n60\t__global__ void precompute_lambda_combinations_kernel(\n61\t    FpExt *__restrict__ out,\n62\t    const MonomialHeader *__restrict__ headers,\n63\t    const LambdaTerm *__restrict__ lambda_terms,\n64\t    const FpExt *__restrict__ lambda_pows,\n65\t    uint32_t num_monomials\n66\t) {\n67\t    uint32_t m = blockIdx.x * blockDim.x + threadIdx.x;\n68\t    if (m >= num_monomials)\n69\t        return;\n70\t\n71\t    MonomialHeader hdr = headers[m];\n72\t    FpExt sum(Fp::zero());\n73\t    for (uint16_t l = 0; l < hdr.num_terms; ++l) {\n74\t        LambdaTerm term = lambda_terms[hdr.term_offset + l];\n75\t        sum += lambda_pows[term.constraint_idx] * term.coefficient;\n76\t    }\n77\t    out[m] = sum;\n78\t}\n79\t\n80\textern \"C\" int _precompute_lambda_combinations(\n81\t    FpExt *out,\n82\t    const MonomialHeader *headers,\n83\t    const LambdaTerm *lambda_terms,\n84\t    const FpExt *lambda_pows,\n85\t    uint32_t num_monomials\n86\t) {\n87\t    if (num_monomials == 0)\n88\t        return 0;\n89\t\n90\t    constexpr uint32_t threads = 256;\n91\t    uint32_t blocks = div_ceil(num_monomials, threads);\n92\t    precompute_lambda_combinations_kernel<<<blocks, threads>>>(\n93\t        out, headers, lambda_terms, lambda_pows, num_monomials\n94\t    );\n95\t    return CHECK_KERNEL();\n96\t}\n97\t\n98\t// ============================================================================\n99\t// BATCHED KERNEL (multiple AIRs in single launch)\n100\t// ============================================================================\n101\t\n102\t__global__ void zerocheck_monomial_kernel(\n103\t    FpExt *__restrict__ tmp_sums,\n104\t    const BlockCtx *__restrict__ block_ctxs,\n105\t    const MonomialAirCtx *__restrict__ air_ctxs,\n106\t    uint32_t threads_per_block\n107\t) {\n108\t    extern __shared__ char smem[];\n109\t    FpExt *shared = (FpExt *)smem;\n110\t\n111\t    BlockCtx bctx = block_ctxs[blockIdx.x];\n112\t    MonomialAirCtx actx = air_ctxs[bctx.air_idx];\n113\t\n114\t    uint32_t num_x = gridDim.y;\n115\t    uint32_t x_int = blockIdx.y;\n116\t\n117\t    // Decode y_int and mono_block from local_block_idx_x\n118\t    uint32_t mono_blocks = (actx.num_monomials + threads_per_block - 1) / threads_per_block;\n119\t    uint32_t y_int = bctx.local_block_idx_x / mono_blocks;\n120\t    uint32_t mono_block = bctx.local_block_idx_x % mono_blocks;\n121\t\n122\t    uint32_t height = num_x * actx.num_y;\n123\t    uint32_t row = x_int * actx.num_y + y_int;\n124\t\n125\t    FpExt sum(Fp::zero());\n126\t\n127\t    // Each thread evaluates one monomial\n128\t    uint32_t m = mono_block * threads_per_block + threadIdx.x;\n129\t    if (m < actx.num_monomials) {\n130\t        MonomialHeader hdr = actx.d_headers[m];\n131\t\n132\t        // Evaluate product of variables\n133\t        FpExt product(Fp::one());\n134\t        for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n135\t            PackedVar var = actx.d_variables[hdr.var_offset + v];\n136\t            product *= eval_variable(var, row, actx.eval_ctx, height);\n137\t        }\n138\t\n139\t        sum = product * actx.d_lambda_combinations[m];\n140\t    }\n141\t\n142\t    // Block reduction\n143\t    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n144\t\n145\t    if (threadIdx.x == 0) {\n146\t        // Apply eq_xi here (eliminates separate phase 2)\n147\t        // eq_xi is eq(xi, y) which only depends on y, not x\n148\t        reduced *= actx.d_eq_xi[y_int];\n149\t        tmp_sums[blockIdx.x * num_x + x_int] = reduced;\n150\t    }"}]},"parent_tool_use_id":"toolu_