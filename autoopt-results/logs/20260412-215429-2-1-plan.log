{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K2bNmBTpibytmvfqWzyWP8","type":"tool_result","content":"290\timpl<'a> ZerocheckMonomialParYBatch<'a> {\n291\t    /// Creates a new batch from an iterator of traces.\n292\t    ///\n293\t    /// `lambda_combinations` must contain one buffer per trace (in iteration order),\n294\t    /// each precomputed via [`compute_lambda_combinations`].\n295\t    ///\n296\t    /// The `sm_count` and `num_x` parameters are used to auto-tune the chunk size\n297\t    /// for optimal SM utilization.\n298\t    ///\n299\t    /// # Panics\n300\t    ///\n301\t    /// Panics if `traces` is empty or if `lambda_combinations` length doesn't match.\n302\t    #[allow(clippy::too_many_arguments)]\n303\t    pub fn new<HS: GpuHashScheme>(\n304\t        traces: impl IntoIterator<Item = &'a TraceCtx>,\n305\t        pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n306\t        lambda_combinations: &[&DeviceBuffer<EF>],\n307\t        sm_count: u32,\n308\t        num_x: u32,\n309\t        max_monomials_per_thread: Option<u32>,\n310\t    ) -> Result<Self, MemCopyError> {\n311\t        let traces: Vec<_> = traces.into_iter().collect();\n312\t        assert!(\n313\t            !traces.is_empty(),\n314\t            \"ZerocheckMonomialParYBatch requires at least one trace\"\n315\t        );\n316\t        assert_eq!(\n317\t            traces.len(),\n318\t            lambda_combinations.len(),\n319\t            \"lambda_combinations must have one buffer per trace\"\n320\t        );\n321\t\n322\t        let threads_per_block = THREADS_PER_BLOCK_PAR_Y;\n323\t        let max_mono_per_thread =\n324\t            max_monomials_per_thread.unwrap_or(DEFAULT_MAX_MONOMIALS_PER_THREAD);\n325\t\n326\t        // First pass: collect per-AIR info\n327\t        let mut per_air_info: Vec<(u32, u32)> = Vec::new(); // (y_blocks, num_monomials)\n328\t        let mut max_monomials = 0u32;\n329\t\n330\t        for t in traces.iter() {\n331\t            let monomials = pk.per_air[t.air_idx]\n332\t                .other_data\n333\t                .zerocheck_monomials\n334\t                .as_ref()\n335\t                .expect(\"AIR with constraints must have monomials\");\n336\t\n337\t            let y_blocks = t.num_y.div_ceil(threads_per_block);\n338\t            max_monomials = max_monomials.max(monomials.num_monomials);\n339\t            per_air_info.push((y_blocks, monomials.num_monomials));\n340\t        }\n341\t\n342\t        // Determine chunk_size based on SM utilization and cap\n343\t        // We want: total_blocks * num_x >= sm_count * WAVES_TARGET\n344\t        // total_blocks = sum of (y_blocks * air_mono_chunks) per AIR\n345\t        // where air_mono_chunks = ceil(num_monomials / chunk_size)\n346\t        //\n347\t        // Also: chunk_size <= max_mono_per_thread\n348\t        //\n349\t        // Start with chunk_size = max_mono_per_thread and adjust if needed\n350\t        let target_blocks = sm_count * WAVES_TARGET;\n351\t\n352\t        // Initial estimate: use max_mono_per_thread as chunk_size\n353\t        let mut chunk_size = max_mono_per_thread;\n354\t        loop {\n355\t            let total_blocks: u32 = per_air_info\n356\t                .iter()\n357\t                .map(|(y_blocks, num_mono)| {\n358\t                    let air_mono_chunks = num_mono.div_ceil(chunk_size);\n359\t                    y_blocks * air_mono_chunks\n360\t                })\n361\t                .sum();\n362\t\n363\t            if total_blocks * num_x >= target_blocks || chunk_size <= 1 {\n364\t                break;\n365\t            }\n366\t            // Need more blocks: reduce chunk_size\n367\t            chunk_size = (chunk_size / 2).max(1);\n368\t        }\n369\t\n370\t        // Build block_ctxs with per-AIR encoding\n371\t        // Encoding: local_block_idx_x = y_block * air_mono_chunks + mono_chunk\n372\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();\n373\t        let mut air_offsets: Vec<u32> = Vec::with_capacity(traces.len() + 1);\n374\t        air_offsets.push(0);\n375\t\n376\t        for (local_air, (y_blocks, num_mono)) in per_air_info.iter().enumerate() {\n377\t            let air_mono_chunks = num_mono.div_ceil(chunk_size);\n378\t\n379\t            for y_block in 0..*y_blocks {\n380\t                for mono_chunk in 0..air_mono_chunks {\n381\t                    let local_idx = y_block * air_mono_chunks + mono_chunk;\n382\t                    block_ctxs_h.push(BlockCtx {\n383\t                        local_block_idx_x: local_idx,\n384\t                        air_idx: local_air as u32,\n385\t                    });\n386\t                }\n387\t            }\n388\t            air_offsets.push(block_ctxs_h.len() as u32);\n389\t        }\n390\t\n391\t        let num_blocks = block_ctxs_h.len() as u32;\n392\t\n393\t        // Build MonomialAirCtx for each trace\n394\t        let air_ctxs_h: Vec<MonomialAirCtx> = traces\n395\t            .iter()\n396\t            .zip(lambda_combinations)\n397\t            .map(|(t, lc)| {\n398\t                let monomials = pk.per_air[t.air_idx]\n399\t                    .other_data\n400\t                    .zerocheck_monomials\n401\t                    .as_ref()\n402\t                    .unwrap();\n403\t\n404\t                let eval_ctx = EvalCoreCtx {\n405\t                    d_selectors: t.sels_ptr,\n406\t                    d_preprocessed: t.prep_ptr,\n407\t                    d_main: t.main_ptrs_dev.as_ptr(),\n408\t                    d_public: t.public_ptr,\n409\t                };\n410\t\n411\t                MonomialAirCtx {\n412\t                    d_headers: monomials.d_headers.as_ptr(),\n413\t                    d_variables: monomials.d_variables.as_ptr(),\n414\t                    d_lambda_combinations: lc.as_ptr(),\n415\t                    num_monomials: monomials.num_monomials,\n416\t                    eval_ctx,\n417\t                    d_eq_xi: t.eq_xi_ptr,\n418\t                    num_y: t.num_y,\n419\t                }\n420\t            })\n421\t            .collect();\n422\t\n423\t        // Upload to device\n424\t        let block_ctxs = block_ctxs_h.to_device()?;\n425\t        let air_ctxs = air_ctxs_h.to_device()?;\n426\t        let air_offsets = air_offsets.to_device()?;\n427\t\n428\t        debug!(\n429\t            num_airs = traces.len(),\n430\t            num_blocks, chunk_size, max_monomials, \"ZerocheckMonomialParYBatch created\"\n431\t        );\n432\t\n433\t        Ok(Self {\n434\t            traces,\n435\t            block_ctxs,\n436\t            air_ctxs,\n437\t            air_offsets,\n438\t            num_blocks,\n439\t            chunk_size,"}]},"parent_tool_use_id":"toolu_01KqFCVJDc9WJFhZ42umbk3D","session_id":"f1ad9314-c536-427a-92c1-585cbcf5d248","uuid":"bccb1b49-fecc-437d-9431-65ed6b5b85c2","timestamp":"2026-04-12T19:59:25.058Z"}
