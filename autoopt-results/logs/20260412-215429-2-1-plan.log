hs = widths.to_device()?;\n1441\t\n1442\t            unsafe {\n1443\t                batch_fold_mle(\n1444\t                    &d_input_ptrs,\n1445\t                    &d_output_ptrs,\n1446\t                    &d_widths,\n1447\t                    num_matrices.try_into().unwrap(),\n1448\t                    &d_log_output_heights,\n1449\t                    max_output_cells.try_into().unwrap(),\n1450\t                    r_round,\n1451\t                )\n1452\t                .map_err(LogupZerocheckError::BatchFoldMle)?;\n1453\t            }\n1454\t            output_mats.extend_from_slice(&input_mats[num_matrices..]);\n1455\t            Ok(output_mats)\n1456\t        };\n1457\t\n1458\t        // Fold mat_evals_per_trace: Vec<Vec<DeviceMatrix<EF>>>\n1459\t        self.mat_evals_per_trace = {\n1460\t            let lengths = self\n1461\t                .mat_evals_per_trace\n1462\t                .iter()\n1463\t                .map(|v| v.len())\n1464\t                .collect_vec();\n1465\t            let input_mats = std::mem::take(&mut self.mat_evals_per_trace)\n1466\t                .into_iter()\n1467\t                .flatten()\n1468\t                .collect_vec();\n1469\t            let mut output_mats = batch_fold(input_mats)?.into_iter();\n1470\t            lengths\n1471\t                .into_iter()\n1472\t                .map(|len| output_mats.by_ref().take(len).collect())\n1473\t                .collect()\n1474\t        };\n1475\t        if self.save_memory {\n1476\t            self.memory_limit_bytes = self.gkr_mem_contribution.saturating_sub(\n1477\t                self.mat_evals_per_trace\n1478\t                    .iter()\n1479\t                    .flatten()\n1480\t                    .map(|m| m.buffer().len() * size_of::<EF>())\n1481\t                    .sum(),\n1482\t            );\n1483\t        }\n1484\t\n1485\t        // Fold sels_per_trace: Vec<DeviceMatrix<EF>>\n1486\t        self.sels_per_trace = batch_fold(std::mem::take(&mut self.sels_per