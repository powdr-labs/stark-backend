{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rj6sfXNquenTjdYTBSMprT","type":"tool_result","content":"145\t        // Build block_ctxs and air_offsets\n146\t        // For each AIR: total_blocks = ceil(num_monomials / tpb) * num_y\n147\t        // local_block_idx_x encodes (y_int * mono_blocks + mono_block_idx)\n148\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();\n149\t        let mut air_offsets: Vec<u32> = Vec::with_capacity(traces.len() + 1);\n150\t        air_offsets.push(0);\n151\t\n152\t        for (local_air, t) in traces.iter().enumerate() {\n153\t            let monomials = pk.per_air[t.air_idx]\n154\t                .other_data\n155\t                .zerocheck_monomials\n156\t                .as_ref()\n157\t                .unwrap();\n158\t            let mono_blocks = monomials.num_monomials.div_ceil(threads_per_block);\n159\t            let total_blocks = mono_blocks * t.num_y;\n160\t\n161\t            for local_idx in 0..total_blocks {\n162\t                block_ctxs_h.push(BlockCtx {\n163\t                    local_block_idx_x: local_idx,\n164\t                    air_idx: local_air as u32,\n165\t                });\n166\t            }\n167\t            air_offsets.push(block_ctxs_h.len() as u32);\n168\t        }\n169\t\n170\t        // Build MonomialAirCtx for each trace\n171\t        let air_ctxs_h: Vec<MonomialAirCtx> = traces\n172\t            .iter()\n173\t            .zip(lambda_combinations)\n174\t            .map(|(t, lc)| {\n175\t                let monomials = pk.per_air[t.air_idx]\n176\t                    .other_data\n177\t                    .zerocheck_monomials\n178\t                    .as_ref()\n179\t                    .unwrap();\n180\t\n181\t                let eval_ctx = EvalCoreCtx {\n182\t                    d_selectors: t.sels_ptr,\n183\t                    d_preprocessed: t.prep_ptr,\n184\t                    d_main: t.main_ptrs_dev.as_ptr(),\n185\t                    d_public: t.public_ptr,\n186\t                };\n187\t\n188\t                MonomialAirCtx {\n189\t                    d_headers: monomials.d_headers.as_ptr(),\n190\t                    d_variables: monomials.d_variables.as_ptr(),\n191\t                    d_lambda_combinations: lc.as_ptr(),\n192\t                    num_monomials: monomials.num_monomials,\n193\t                    eval_ctx,\n194\t                    d_eq_xi: t.eq_xi_ptr,\n195\t                    num_y: t.num_y,\n196\t                }\n197\t            })\n198\t            .collect();\n199\t\n200\t        // Upload to device\n201\t        let block_ctxs = block_ctxs_h.to_device()?;\n202\t        let air_ctxs = air_ctxs_h.to_device()?;\n203\t        let air_offsets = air_offsets.to_device()?;\n204\t\n205\t        debug!(\n206\t            num_airs = traces.len(),\n207\t            num_blocks = block_ctxs.len(),\n208\t            \"ZerocheckMonomialBatch created\"\n209\t        );\n210\t\n211\t        Ok(Self {\n212\t            traces,\n213\t            block_ctxs,\n214\t            air_ctxs,\n215\t            air_offsets,\n216\t        })\n217\t    }\n218\t\n219\t    /// Returns the trace indices in order.\n220\t    pub fn trace_indices(&self) -> impl Iterator<Item = usize> + '_ {\n221\t        self.traces.iter().map(|t| t.trace_idx)\n222\t    }\n223\t\n224\t    /// Evaluates the batch and returns the output device buffer.\n225\t    ///\n226\t    /// The buffer contains `num_airs * num_x` elements, laid out as\n227\t    /// `[air0_x0, air0_x1, ..., air1_x0, air1_x1, ...]`.\n228\t    /// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n229\t    pub fn evaluate(&self, num_x: u32) -> Result<DeviceBuffer<EF>, KernelError> {\n230\t        let num_blocks = self.block_ctxs.len();\n231\t        let num_airs = self.air_ctxs.len();\n232\t\n233\t        debug!(\n234\t            %num_blocks,\n235\t            %num_x,\n236\t            %num_airs,\n237\t            \"zerocheck_monomial_batched\"\n238\t        );\n239\t\n240\t        let mut tmp_sums = DeviceBuffer::<EF>::with_capacity(num_blocks * num_x as usize);\n241\t        let mut output = DeviceBuffer::<EF>::with_capacity(num_airs * num_x as usize);\n242\t\n243\t        debug_assert_eq!(\n244\t            self.air_offsets.len(),\n245\t            num_airs + 1,\n246\t            \"air_offsets must have num_airs + 1 elements\"\n247\t        );\n248\t        // SAFETY: All device pointers in block_ctxs and air_ctxs were constructed from\n249\t        // valid DeviceBuffers that outlive this call (TraceCtx references, pk monomial data,\n250\t        // lambda_combinations). The air_offsets buffer has length num_airs + 1 as required.\n251\t        unsafe {\n252\t            zerocheck_monomial_batched(\n253\t                &mut tmp_sums,\n254\t                &mut output,\n255\t                &self.block_ctxs,\n256\t                &self.air_ctxs,\n257\t                &self.air_offsets,\n258\t                num_blocks as u32,\n259\t                num_x,\n260\t                num_airs as u32,\n261\t                THREADS_PER_BLOCK,\n262\t            )?;\n263\t        }\n264\t\n265\t        Ok(output)\n266\t    }\n267\t}\n268\t\n269\t// Constants for par-y kernel\n270\tconst THREADS_PER_BLOCK_PAR_Y: u32 = 128;\n271\tconst DEFAULT_MAX_MONOMIALS_PER_THREAD: u32 = 64;\n272\tconst WAVES_TARGET: u32 = 4;\n273\t\n274\t/// Batch evaluator for monomial-based zerocheck MLE evaluation, parallelizing over y_int.\n275\t///\n276\t/// This variant is optimized for traces with high `num_y`: each thread handles one y_int\n277\t/// and loops over a chunk of monomials. The chunk size is auto-tuned based on SM count.\n278\t///\n279\t/// The caller must filter traces using [`trace_has_monomials`] before constructing.\n280\t/// The batch must contain at least one trace.\n281\tpub(crate) struct ZerocheckMonomialParYBatch<'a> {\n282\t    traces: Vec<&'a TraceCtx>,\n283\t    block_ctxs: DeviceBuffer<BlockCtx>,\n284\t    air_ctxs: DeviceBuffer<MonomialAirCtx>,\n285\t    air_offsets: DeviceBuffer<u32>,\n286\t    num_blocks: u32,\n287\t    chunk_size: u32,\n288\t}\n289\t\n290\timpl<'a> ZerocheckMonomialParYBatch<'a> {\n291\t    /// Creates a new batch from an iterator of traces.\n292\t    ///\n293\t    /// `lambda_combinations` must contain one buffer per trace (in iteration order),\n294\t    /// each precomputed via [`compute_lambda_combinations`]."}]},"parent_tool_use_id":"toolu_016SBVHkQkrDLgfDXTKW2X5T","session_id":"f93534bb-5de3-4083-9e85-ad533ac466ab","uuid":"c94992fc-63fb-4f76-9d91-1829216c31a8","timestamp":"2026-04-14T04:04:37.808Z"}
