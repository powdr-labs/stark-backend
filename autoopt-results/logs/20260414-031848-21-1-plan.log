hs = widths.to_device()?;\n1819\t\n1820\t            unsafe {\n1821\t                batch_fold_mle(\n1822\t                    &d_input_ptrs,\n1823\t                    &d_output_ptrs,\n1824\t                    &d_widths,\n1825\t                    num_matrices.try_into().unwrap(),\n1826\t                    &d_log_output_heights,\n1827\t                    max_output_cells.try_into().unwrap(),\n1828\t                    r_round,\n1829\t                )\n1830\t                .map_err(LogupZerocheckError::BatchFoldMle)?;\n1831\t            }\n1832\t            output_mats.extend_from_slice(&input_mats[num_matrices..]);\n1833\t            Ok(output_mats)\n1834\t        };\n1835\t\n1836\t        // Fold mat_evals_per_trace: Vec<Vec<DeviceMatrix<EF>>>\n1837\t        self.mat_evals_per_trace = {\n1838\t            let lengths = self\n1839\t                .mat_evals_per_trace\n1840\t                .iter()\n1841\t                .map(|v| v.len())\n1842\t                .collect_vec();\n1843\t            let input_mats = std::mem::take(&mut self.mat_evals_per_trace)\n1844\t                .into_iter()\n1845\t                .flatten()\n1846\t                .collect_vec();\n1847\t            let mut output_mats = batch_fold(input_mats)?.into_iter();\n1848\t            lengths\n1849\t                .into_iter()\n1850\t                .map(|len| output_mats.by_ref().take(len).collect())\n1851\t                .collect()\n1852\t        };\n1853\t        if self.save_memory {\n1854\t            self.memory_limit_bytes = self.gkr_mem_contribution.saturating_sub(\n1855\t                self.mat_evals_per_trace\n1856\t                    .iter()\n1857\t                    .flatten()\n1858\t                    .map(|m| m.buffer().len() * size_of::<EF>())\n1859\t                    .sum(),\n1860\t            );\n1861\t        }\n1862\t\n1863\t        // Fold sels_per_trace: Vec<DeviceMatrix<EF>>\n1864\t        self.sels_per_trace = batch_fold(std::mem::take(&mut self.sels_per