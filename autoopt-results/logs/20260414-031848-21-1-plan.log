n1687\t            }\n1688\t        }\n1689\t\n1690\t        // Monomial zerocheck for low num_y traces\n1691\t        let low_mono_traces = low_early;\n1692\t        if !low_mono_traces.is_empty() {\n1693\t            let lambda_combs: Vec<_> = low_mono_traces\n1694\t                .iter()\n1695\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1696\t                .collect();\n1697\t            let batch = ZerocheckMonomialBatch::new(low_mono_traces, self.pk, &lambda_combs)?;\n1698\t            let out = batch\n1699\t                .evaluate(sp_deg as u32)\n1700\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1701\t            let host = out.to_host()?;\n1702\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1703\t                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n1704\t            }\n1705\t        }\n1706\t\n1707\t        Ok(logup_out.into_iter().flatten().chain(zc_out).collect())\n1708\t    }\n1709\t\n1710\t    #[instrument(level = \"debug\", skip_all, fields(round = round))]\n1711\t    fn compute_batch_s_poly(\n1712\t        &mut self,\n1713\t        sp_round_evals: Vec<Vec<EF>>,\n1714\t        num_traces: usize,\n1715\t        round: usize,\n1716\t        mu_pows: &[EF],\n1717\t    ) -> UnivariatePoly<EF> {\n1718\t        debug_assert_eq!(sp_round_evals.len(), 3 * num_traces);\n1719\t        debug_assert_eq!(sp_round_evals.len(), mu_pows.len());\n1720\t        let constraint_degree = self.constraint_degree;\n1721\t        let mut sp_head_zc = vec![EF::ZERO; constraint_degree];\n1722\t        let mut sp_head_logup = vec![EF::ZERO; constraint_degree];\n1723\t        let mut sp_tail = EF::ZERO;\n1724\t        for (trace_idx, &n) in self.n_per_trace.iter().enumerate() {\n1725\t            let n_lift = n.max(0) as usize;\n1726\t            let zc_idx = 2 * num_traces + trace_idx;\n1727\t            let numer_idx = 2 * trace_idx;\n1728\t            let denom_idx = numer_idx + 1;\n1729\t            if round == n_lift + 1 {\n1730\t                let eq_r_acc = *self.eq_ns.last().unwrap();\n1731\t                let eq_sharp_r_acc = *self.eq_sharp_ns.last().unwrap();\n1732\t                self.zerocheck_tilde_evals[trace_idx] *= eq_r_acc;\n1733\t                self.logup_tilde_evals[trace_idx][0] *= eq_sharp_r_acc;\n1734\t                self.logup_tilde_evals[trace_idx][1] *= eq_sharp_r_acc;\n1735\t            }\n1736\t            if round <= n_lift {\n1737\t                for i in 0..constraint_degree {\n1738\t                    sp_head_zc[i] += mu_pows[zc_idx] * sp_round_evals[zc_idx][i];\n1739\t                    sp_head_logup[i] += mu_pows[numer_idx] * sp_round_evals[numer_idx][i]\n1740\t                        + mu_pows[denom_idx] * sp_round_evals[denom_idx][i];\n1741\t                }\n1742\t            } else {\n1743\t                sp_tail += mu_pows[zc_idx] * self.zerocheck_tilde_evals[trace_idx]\n1744\t                    + mu_pows[numer_idx] * self.logup_tilde_evals[trace_idx][0]\n1745\t                    + mu_pows[denom_idx] * self.logup_tilde_evals[trace_idx][1];\n1746\t            }\n1747\t        }\n1748\t        let s_deg = constraint_degree + 1;\n1749\t        let l_skip = self.l_skip;\n1750\t        // With eq(xi,r) contributions\n1751\t        let mut sp_head_evals = vec![EF::ZERO; s_deg];\n1752\t        for i in 0..constraint_degree {\n1753\t            sp_head_evals[i + 1] = self.eq_ns[round - 1] * sp_head_zc[i]\n1754\t                + self.eq_sharp_ns[round - 1] * sp_head_logup[i];\n1755\t        }\n1756\t        // We need to derive s'(0).\n1757\t        // We use that s_j(0) + s_j(1) = s_{j-1}(r_{j-1})\n1758\t        let xi_cur = self.xi[l_skip + round - 1];\n1759\t        {\n1760\t            let eq_xi_0 = EF::ONE - xi_cur;\n1761\t            let eq_xi_1 = xi_cur;\n1762\t            sp_head_evals[0] =\n1763\t                (self.prev_s_eval - eq_xi_1 * sp_head_evals[1] - sp_tail) * eq_xi_0.inverse();\n1764\t        }\n1765\t        // s' has degree s_deg - 1\n1766\t        let sp_head = UnivariatePoly::lagrange_interpolate(\n1767\t            &(0..s_deg).map(F::from_usize).collect_vec(),\n1768\t            &sp_head_evals,\n1769\t        );\n1770\t        // eq(xi, X) = (2 * xi - 1) * X + (1 - xi)"}]},"parent_tool_use_id":"toolu_016SBVHkQkrDLgfDXTKW2X5T","session_id":"f93534bb-5de3-4083-9e85-ad533ac466ab","uuid":"d36c1c17-3b98-4dc2-b774-a7a2276c58ba","timestamp":"2026-04-14T04:04:14.171Z"}
