{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SVAz4cTbPzW14puBMkicXV","type":"tool_result","content":"1\tuse std::sync::Arc;\n2\t\n3\tuse getset::Getters;\n4\tuse itertools::Itertools;\n5\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer, memory_manager::MemTracker};\n6\tuse openvm_stark_backend::{\n7\t    p3_util::log2_strict_usize,\n8\t    prover::{stacked_pcs::StackedLayout, MatrixDimensions},\n9\t};\n10\tuse tracing::instrument;\n11\t\n12\tuse crate::{\n13\t    base::{DeviceMatrix, DeviceMatrixView},\n14\t    cuda::{\n15\t        batch_ntt_small::batch_ntt_small,\n16\t        matrix::{batch_expand_pad, stack_columns, StackColDesc},\n17\t        ntt::bit_rev,\n18\t    },\n19\t    hash_scheme::GpuMerkleHash,\n20\t    merkle_tree::{MerkleTreeConstructor, MerkleTreeGpu},\n21\t    ntt::batch_ntt,\n22\t    poly::{mle_interpolate_stages, PleMatrix},\n23\t    prelude::F,\n24\t    GpuProverConfig, ProverError, RsCodeMatrixError, StackTracesError,\n25\t};\n26\t\n27\t#[derive(Getters)]\n28\tpub struct StackedPcsDataGpu<F, Digest> {\n29\t    /// Layout of the unstacked collection of matrices within the stacked matrix.\n30\t    #[getset(get = \"pub\")]\n31\t    pub(crate) layout: StackedLayout,\n32\t    /// The stacked matrix with height `2^{l_skip + n_stack}`.\n33\t    /// This is optionally cached depending on the prover configuration:\n34\t    /// - Caching increases the peak GPU memory but avoids a recomputation during stacked\n35\t    ///   reduction.\n36\t    /// - Not caching means the stacked matrix computation is recomputed during stacked reduction,\n37\t    ///   but lowers the peak GPU memory.\n38\t    #[getset(get = \"pub\")]\n39\t    pub(crate) matrix: Option<PleMatrix<F>>,\n40\t    /// Merkle tree of the Reed-Solomon codewords of the stacked matrix.\n41\t    /// Depends on `k_whir` parameter.\n42\t    #[getset(get = \"pub\")]\n43\t    pub(crate) tree: MerkleTreeGpu<F, Digest>,\n44\t}\n45\t\n46\t#[allow(clippy::type_complexity)]\n47\t#[instrument(level = \"info\", skip_all)]\n48\tpub fn stacked_commit<MH: GpuMerkleHash + MerkleTreeConstructor>(\n49\t    l_skip: usize,\n50\t    n_stack: usize,\n51\t    log_blowup: usize,\n52\t    k_whir: usize,\n53\t    traces: &[&DeviceMatrix<F>],\n54\t    prover_config: GpuProverConfig,\n55\t) -> Result<(MH::Digest, StackedPcsDataGpu<F, MH::Digest>), ProverError> {\n56\t    let mut mem = MemTracker::start(\"prover.stacked_commit\");\n57\t    mem.tracing_info(\"before stacked_commit\");\n58\t    mem.reset_peak();\n59\t    let layout = get_stacked_layout(l_skip, n_stack, traces);\n60\t    tracing::info!(\n61\t        height = layout.height(),\n62\t        width = layout.width(),\n63\t        \"stacked_matrix_dimensions\"\n64\t    );\n65\t    let opt_stacked_matrix = if prover_config.cache_stacked_matrix {\n66\t        Some(stack_traces(&layout, traces)?)\n67\t    } else {\n68\t        None\n69\t    };\n70\t    let rs_matrix = rs_code_matrix(log_blowup, &layout, traces, &opt_stacked_matrix)?;\n71\t    let tree = MerkleTreeGpu::<F, MH::Digest>::new_with_hash::<MH>(\n72\t        rs_matrix,\n73\t        1 << k_whir,\n74\t        prover_config.cache_rs_code_matrix,\n75\t    )?;\n76\t    let root = tree.root();\n77\t    let data = StackedPcsDataGpu {\n78\t        layout,\n79\t        matrix: opt_stacked_matrix,\n80\t        tree,\n81\t    };\n82\t    mem.emit_metrics();\n83\t    Ok((root, data))\n84\t}\n85\t\n86\t/// The `traces` **must** already be in height-sorted order.\n87\t///\n88\t/// This function is generic in `F` and only relies on CUDA memory operations.\n89\t#[instrument(skip_all)]\n90\tpub fn stacked_matrix(\n91\t    l_skip: usize,\n92\t    n_stack: usize,\n93\t    traces: &[&DeviceMatrix<F>],\n94\t) -> Result<(PleMatrix<F>, StackedLayout), ProverError> {\n95\t    let layout = get_stacked_layout(l_skip, n_stack, traces);\n96\t    let matrix = stack_traces(&layout, traces)?;\n97\t    Ok((matrix, layout))\n98\t}\n99\t\n100\tpub(crate) fn get_stacked_layout(\n101\t    l_skip: usize,\n102\t    n_stack: usize,\n103\t    traces: &[&DeviceMatrix<F>],\n104\t) -> StackedLayout {\n105\t    let sorted_meta = traces\n106\t        .iter()\n107\t        .map(|trace| {\n108\t            // height cannot be zero:\n109\t            let log_height = log2_strict_usize(trace.height());\n110\t            (trace.width(), log_height)\n111\t        })\n112\t        .collect_vec();\n113\t    debug_assert!(sorted_meta.is_sorted_by(|a, b| a.1 >= b.1));\n114\t    StackedLayout::new(l_skip, l_skip + n_stack, sorted_meta).unwrap()\n115\t}\n116\t\n117\tpub(crate) fn stack_traces(\n118\t    layout: &StackedLayout,\n119\t    traces: &[&DeviceMatrix<F>],\n120\t) -> Result<PleMatrix<F>, StackTracesError> {\n121\t    let mem = MemTracker::start(\"prover.stack_traces\");\n122\t    let l_skip = layout.l_skip();\n123\t    let height = layout.height();\n124\t    let width = layout.width();\n125\t    let mut q_evals = DeviceBuffer::<F>::with_capacity(width.checked_mul(height).unwrap());\n126\t    stack_traces_into_expanded(layout, traces, &mut q_evals, height)?;\n127\t    mem.emit_metrics();\n128\t    Ok(PleMatrix::from_evals(l_skip, q_evals, height, width))\n129\t}\n130\t\n131\t/// `buffer` should be the buffer to write the stacked traces into.\n132\t/// `buffer` should be a matrix with dimensions `padded_height x width` where `width` is the stacked\n133\t/// width and `padded_height` must be a multiple of the stacked height.\n134\tpub(crate) fn stack_traces_into_expanded(\n135\t    layout: &StackedLayout,\n136\t    traces: &[&DeviceMatrix<F>],\n137\t    buffer: &mut DeviceBuffer<F>,\n138\t    padded_height: usize,\n139\t) -> Result<(), StackTracesError> {\n140\t    let l_skip = layout.l_skip();\n141\t    debug_assert_eq!(padded_height % layout.height(), 0);\n142\t    debug_assert_eq!(buffer.len() % padded_height, 0);\n143\t    debug_assert_eq!(buffer.len() / padded_height, layout.width());\n144\t    buffer.fill_zero().map_err(StackTracesError::FillZero)?;\n145\t\n146\t    // Phase 1: Build descriptor array on host (CPU-only, no CUDA API calls)\n147\t    let mut descs: Vec<StackColDesc> = Vec::with_capacity(layout.sorted_cols.len());\n148\t    for (mat_idx, j, s) in &layout.sorted_cols {\n149\t        let start = s.col_idx * padded_height + s.row_idx;\n150\t        let trace = traces[*mat_idx];"}]},"parent_tool_use_id":"toolu_01K7Tk9XpPYZcSLTKVR6cWaX","session_id":"f93534bb-5de3-4083-9e85-ad533ac466ab","uuid":"c9eebca5-7538-4e17-b121-b3cb51eecfc6","timestamp":"2026-04-14T04:04:10.329Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KA1RCbkvf8EuvEBYzUwuyt","type":"tool_result","content":"475\t    };\n476\t    let skip_domain_size = F::from_usize(1 << l_skip);\n477\t    // logup sum claims (sum_{\\hat p}, sum_{\\hat q}) per present AIR\n478\t    let (numerator_term_per_air, denominator_term_per_air): (Vec<_>, Vec<_>) = (0..num_traces)\n479\t        .map(|trace_idx| {\n480\t            let [sum_claim_p, sum_claim_q] = [0, 1].map(|is_denom| {\n481\t                // Compute sum over D of s_0(Z) to get the sum claim\n482\t                (0..=s_0_deg)\n483\t                    .step_by(1 << l_skip)\n484\t                    .map(|j| unsafe {\n485\t                        // SAFETY: matrix is 2 * num_trace x large_uni_domain, s_0_deg <\n486\t                        // large_uni_domain\n487\t                        *s_0_logup_polys\n488\t                            .values\n489\t                            .get_unchecked(j * 2 * num_traces + 2 * trace_idx + is_denom)\n490\t                    })\n491\t                    .sum::<EF>()\n492\t                    * skip_domain_size\n493\t            });\n494\t            transcript.observe_ext(sum_claim_p);\n495\t            transcript.observe_ext(sum_claim_q);\n496\t\n497\t            (sum_claim_p, sum_claim_q)\n498\t        })\n499\t        .unzip();\n500\t\n501\t    let mu = transcript.sample_ext();\n502\t    debug!(%mu);\n503\t    let mu_pows = mu.powers().take(3 * num_traces).collect_vec();\n504\t\n505\t    let s_0_zc_poly = {\n506\t        let eq_uni = eq_uni_poly::<F, _>(l_skip, prover.xi[0]);\n507\t        let mut eq_coeffs = eq_uni.into_coeffs();\n508\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n509\t        let eq_evals = dft.dft(eq_coeffs);\n510\t\n511\t        // Algebraically batch\n512\t        let mut sp_coeffs = EF::zero_vec(large_uni_domain);\n513\t        let mus = &mu_pows[2 * num_traces..];\n514\t        let polys = &sp_0_polys[2 * num_traces..];\n515\t        for (j, batch_coeff) in sp_coeffs.iter_mut().enumerate().take(sp_0_deg + 1) {\n516\t            for (&mu, poly) in zip(mus, polys) {\n517\t                *batch_coeff += mu * *poly.coeffs().get(j).unwrap_or(&EF::ZERO);\n518\t            }\n519\t        }\n520\t        let mut s_evals = dft.dft(sp_coeffs);\n521\t        for (eq, x) in zip(eq_evals, &mut s_evals) {\n522\t            *x *= eq;\n523\t        }\n524\t        dft.idft(s_evals)\n525\t    };\n526\t\n527\t    // Algebraically batch\n528\t    let s_0_poly = UnivariatePoly::new(\n529\t        zip(\n530\t            s_0_logup_polys.values.chunks_exact(2 * num_traces),\n531\t            s_0_zc_poly,\n532\t        )\n533\t        .take(s_0_deg + 1)\n534\t        .map(|(logup_row, batched_zc)| {\n535\t            let coeff = batched_zc\n536\t                + zip(&mu_pows, logup_row)\n537\t                    .map(|(&mu_j, &x)| mu_j * x)\n538\t                    .sum::<EF>();\n539\t            transcript.observe_ext(coeff);\n540\t            coeff\n541\t        })\n542\t        .collect(),\n543\t    );\n544\t    drop(s_0_cpu_span);\n545\t\n546\t    let r_0 = transcript.sample_ext();\n547\t    r.push(r_0);\n548\t    debug!(round = 0, r_round = %r_0);\n549\t    prover.prev_s_eval = s_0_poly.eval_at_point(r_0);\n550\t    debug!(\"s_0(r_0) = {}\", prover.prev_s_eval);\n551\t\n552\t    prover.fold_ple_evals(ctx, r_0)?;\n553\t    drop(round0_span);\n554\t\n555\t    // Sumcheck rounds:\n556\t    // - each round the prover needs to compute univariate polynomial `s_round`. This poly is linear\n557\t    //   since we are taking MLE of `evals`.\n558\t    // - at end of each round, sample random `r_round` in `EF`\n559\t    //\n560\t    // `s_round` is degree `s_deg` so we evaluate it at `0, ..., =s_deg`. The prover skips\n561\t    // evaluation at `0` because the verifier can infer it from the previous round's\n562\t    // `s_{round-1}(r)` claim. The degree is constraint_degree + 1, where + 1 is from eq term\n563\t    let mle_rounds_span =\n564\t        info_span!(\"prover.rap_constraints.mle_rounds\", phase = \"prover\").entered();\n565\t    debug!(%s_deg);\n566\t    for round in 1..=n_max {\n567\t        let sp_round_evals = prover.sumcheck_polys_batch_eval(round, r[round - 1])?;\n568\t        let batch_s = prover.compute_batch_s_poly(sp_round_evals, num_traces, round, &mu_pows);\n569\t        let batch_s_evals = (1..=s_deg)\n570\t            .map(|i| batch_s.eval_at_point(EF::from_usize(i)))\n571\t            .collect_vec();\n572\t        for &eval in &batch_s_evals {\n573\t            transcript.observe_ext(eval);\n574\t        }\n575\t        sumcheck_round_polys.push(batch_s_evals);\n576\t\n577\t        let r_round = transcript.sample_ext();\n578\t        debug!(%round, %r_round);\n579\t        r.push(r_round);\n580\t        prover.prev_s_eval = batch_s.eval_at_point(r_round);\n581\t\n582\t        prover.fold_mle_evals(round, r_round)?;\n583\t    }\n584\t    assert_eq!(r.len(), n_max + 1);\n585\t\n586\t    let column_openings = prover.into_column_openings()?;\n587\t\n588\t    let need_rot_per_trace = ctx\n589\t        .per_trace\n590\t        .iter()\n591\t        .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n592\t        .collect::<Vec<_>>();\n593\t    // Observe common main openings first, and then preprocessed/cached\n594\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n595\t        for (claim, claim_rot) in column_openings_by_rot(&openings[0], *need_rot) {\n596\t            transcript.observe_ext(claim);\n597\t            transcript.observe_ext(claim_rot);\n598\t        }\n599\t    }\n600\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n601\t        for part in openings.iter().skip(1) {\n602\t            for (claim, claim_rot) in column_openings_by_rot(part, *need_rot) {\n603\t                transcript.observe_ext(claim);\n604\t                transcript.observe_ext(claim_rot);\n605\t            }\n606\t        }\n607\t    }\n608\t    drop(mle_rounds_span);\n609\t\n610\t    let batch_constraint_proof = BatchConstraintProof {\n611\t        numerator_term_per_air,\n612\t        denominator_term_per_air,\n613\t        univariate_round_coeffs: s_0_poly.into_coeffs(),\n614\t        sumcheck_round_polys,\n615\t        column_openings,\n616\t    };\n617\t    let gkr_proof = GkrProof {\n618\t        logup_pow_witness,\n619\t        q0_claim: frac_sum_proof.fractional_sum.1,\n620\t        claims_per_layer: frac_sum_proof.claims_per_layer,\n621\t        sumcheck_polys: frac_sum_proof.sumcheck_polys,\n622\t    };\n623\t    Ok((gkr_proof, batch_constraint_proof, r))\n624\t}\n625\t\n626\tpub struct LogupZerocheckGpu<'a, HS: GpuHashScheme> {\n627\t    pub alpha_logup: EF,\n628\t    pub beta_pows: Vec<EF>,\n629\t    // [alpha, beta^0, beta^1, .., beta^max_interaction_len]\n630\t    pub d_challenges: DeviceBuffer<EF>,\n631\t\n632\t    pub l_skip: usize,\n633\t    n_logup: usize,\n634\t    n_global: usize,\n635\t\n636\t    pub omega_skip: F,\n637\t    pub omega_skip_pows: Vec<F>,\n638\t    d_omega_skip_pows: DeviceBuffer<F>,\n639\t\n640\t    pub interactions_layout: StackedLayout,\n641\t    pub constraint_degree: usize,\n642\t    n_per_trace: Vec<isize>,\n643\t    max_num_constraints: usize,\n644\t    pub monomial_num_y_threshold: u32,\n645\t    sm_count: u32,\n646\t    // Available after GKR:\n647\t    pub xi: Vec<EF>,\n648\t    pub lambda_pows: Option<DeviceBuffer<EF>>,\n649\t    /// Precomputed lambda combinations per AIR (indexed by air_idx). Set when lambda is sampled.\n650\t    lambda_combinations: Vec<Option<DeviceBuffer<EF>>>,\n651\t    /// Beta powers on device for logup MLE rounds.\n652\t    d_beta_pows: DeviceBuffer<EF>,\n653\t    /// Precomputed logup combinations per trace (indexed by trace_idx). Set when xi is sampled.\n654\t    logup_combinations: Vec<Option<LogupCombinations>>,\n655\t\n656\t    // n_T => segment tree of eq(xi[j..1+n_T]) for j=1..={n_T-round+1} in _reverse_ layout\n657\t    eq_xis: FxHashMap<usize, EqEvalLayers<EF>>,\n658\t    eq_3b_per_trace: Vec<Vec<EF>>,\n659\t    d_eq_3b_per_trace: Vec<DeviceBuffer<EF>>,\n660\t    // Evaluations on hypercube only, for round 0\n661\t    sels_per_trace_base: Vec<DeviceMatrix<F>>,\n662\t    // After univariate round 0:\n663\t    mat_evals_per_trace: Vec<Vec<DeviceMatrix<EF>>>,\n664\t    sels_per_trace: Vec<DeviceMatrix<EF>>,\n665\t    // Store public_values per trace (similar to CPU's EvalHelper)\n666\t    public_values_per_trace: Vec<DeviceBuffer<F>>,\n667\t    air_indices_per_trace: Vec<usize>,\n668\t    zerocheck_tilde_evals: Vec<EF>,\n669\t    logup_tilde_evals: Vec<[EF; 2]>,\n670\t    needs_next_per_trace: Vec<bool>,\n671\t\n672\t    trace_interactions: Vec<Option<TraceInteractionMeta>>,\n673\t    // round0: Round0Buffers,\n674\t    pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,"}]},"parent_tool_use_id":"toolu_016SBVHkQkrDLgfDXTKW2X5T","session_id":"f93534bb-5de3-4083-9e85-ad533ac466ab","uuid":"2548d063-6866-4f95-986b-4386d47a18c8","timestamp":"2026-04-14T04:04:10.350Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017XuC3Zz8FP1m3rNyufM5Uy","type":"tool_result","content":"1\tuse std::array::from_fn;\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::{\n5\t    copy::{MemCopyD2H, MemCopyH2D},\n6\t    d_buffer::DeviceBuffer,\n7\t    memory_manager::MemTracker,\n8\t};\n9\tuse openvm_stark_backend::prover::MatrixDimensions;\n10\tuse p3_util::log2_strict_usize;\n11\tuse tracing::{info_span, instrument};\n12\t\n13\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n14\tuse crate::cuda::bn254_merkle_tree::Bn254Digest;\n15\tuse crate::{\n16\t    base::DeviceMatrix,\n17\t    cuda::{matrix::matrix_get_rows_fp_kernel, merkle_tree::query_digest_layers},\n18\t    hash_scheme::{GpuMerkleHash, Poseidon2MerkleHash},\n19\t    prelude::{Digest, DIGEST_SIZE, EF, F},\n20\t    MerkleTreeError,\n21\t};\n22\t\n23\t/// Trait for reconstructing a digest from a flat slice of F elements as\n24\t/// produced by the `query_digest_layers` CUDA kernel.\n25\t///\n26\t/// Both `Digest = [F; 8]` (BabyBear Poseidon2) and `Bn254Digest = [Bn254Scalar; 1]`\n27\t/// occupy exactly `DIGEST_SIZE * size_of::<F>()` = 32 bytes, so the same kernel\n28\t/// can be reused for both.\n29\tpub trait BatchQueryMerkle: Copy + Sized + 'static {\n30\t    /// Reconstruct one digest from `DIGEST_SIZE` consecutive F-valued words in `out`\n31\t    /// starting at index `base`.\n32\t    fn reconstruct_from_f(out: &[F], base: usize) -> Self;\n33\t}\n34\t\n35\timpl BatchQueryMerkle for Digest {\n36\t    fn reconstruct_from_f(out: &[F], base: usize) -> Self {\n37\t        from_fn(|i| out[base + i])\n38\t    }\n39\t}\n40\t\n41\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n42\timpl BatchQueryMerkle for Bn254Digest {\n43\t    fn reconstruct_from_f(out: &[F], base: usize) -> Self {\n44\t        // Safety: [F; DIGEST_SIZE] and Bn254Digest have the same size (32 bytes).\n45\t        const _: () =\n46\t            assert!(std::mem::size_of::<Bn254Digest>() == DIGEST_SIZE * std::mem::size_of::<F>());\n47\t        let f_arr: [F; DIGEST_SIZE] = from_fn(|i| out[base + i]);\n48\t        unsafe { std::ptr::read_unaligned(f_arr.as_ptr() as *const Bn254Digest) }\n49\t    }\n50\t}\n51\t\n52\tpub struct MerkleTreeGpu<F, Digest> {\n53\t    /// The matrix that is used to form the leaves of the Merkle tree, which are\n54\t    /// in turn hashed into the bottom digest layer.\n55\t    ///\n56\t    /// This matrix is optionally cached depending on the prover configuration:\n57\t    /// - Caching increases the peak GPU memory but avoids a recomputation of MLE eval-to-coeffs,\n58\t    ///   batch_expand, and forward NTT.\n59\t    /// - Not caching pays a performance penalty due to the above recomputation.\n60\t    pub(crate) backing_matrix: Option<DeviceMatrix<F>>,\n61\t    pub(crate) digest_layers: Vec<DeviceBuffer<Digest>>,\n62\t    pub(crate) rows_per_query: usize,\n63\t    pub(crate) root: Digest,\n64\t}\n65\t\n66\tpub trait MerkleTreeConstructor: GpuMerkleHash {\n67\t    fn new_merkle_tree(\n68\t        matrix: DeviceMatrix<F>,\n69\t        rows_per_query: usize,\n70\t        cache_backing_matrix: bool,\n71\t    ) -> Result<MerkleTreeGpu<F, Self::Digest>, MerkleTreeError>;\n72\t}\n73\t\n74\tpub trait MerkleProofQueryDigest: BatchQueryMerkle + Copy + Send + Sync + 'static {\n75\t    fn batch_query_merkle_proofs(\n76\t        trees: &[&MerkleTreeGpu<F, Self>],\n77\t        query_indices: &[usize],\n78\t    ) -> Result<Vec<Vec<Vec<Self>>>, MerkleTreeError>;\n79\t}\n80\t\n81\timpl<F, Digest> MerkleTreeGpu<F, Digest> {\n82\t    pub fn root(&self) -> Digest\n83\t    where\n84\t        Digest: Clone,\n85\t    {\n86\t        self.root.clone()\n87\t    }\n88\t\n89\t    pub fn query_stride(&self) -> usize {\n90\t        self.digest_layers[0].len()\n91\t    }\n92\t\n93\t    pub fn proof_depth(&self) -> usize {\n94\t        self.digest_layers.len() - 1\n95\t    }\n96\t}\n97\t\n98\t// Base field merkle tree — generic constructor\n99\timpl<D: Copy + Send + Sync + 'static> MerkleTreeGpu<F, D> {\n100\t    /// Build a Merkle tree using the given hash scheme `MH`.\n101\t    ///\n102\t    /// This is the primary constructor; `new()` is a convenience wrapper that\n103\t    /// fixes `MH = Poseidon2MerkleHash`.\n104\t    #[instrument(name = \"merkle_tree\", skip_all)]\n105\t    pub fn new_with_hash<MH: MerkleTreeConstructor<Digest = D>>(\n106\t        matrix: DeviceMatrix<F>,\n107\t        rows_per_query: usize,\n108\t        cache_backing_matrix: bool,\n109\t    ) -> Result<Self, MerkleTreeError> {\n110\t        MH::new_merkle_tree(matrix, rows_per_query, cache_backing_matrix)\n111\t    }\n112\t\n113\t    fn new_generic_with_hash<MH: GpuMerkleHash<Digest = D>>(\n114\t        matrix: DeviceMatrix<F>,\n115\t        rows_per_query: usize,\n116\t        cache_backing_matrix: bool,\n117\t    ) -> Result<Self, MerkleTreeError> {\n118\t        let mem = MemTracker::start(\"prover.merkle_tree\");\n119\t        let height = matrix.height();\n120\t        assert!(height.is_power_of_two());\n121\t        let k = log2_strict_usize(rows_per_query);\n122\t        assert!(\n123\t            rows_per_query <= height,\n124\t            \"rows_per_query ({rows_per_query}) must not exceed height ({height})\"\n125\t        );\n126\t        let query_stride = height / rows_per_query;\n127\t        let mut query_digest_layer = DeviceBuffer::<D>::with_capacity(query_stride);\n128\t        // SAFETY: query_digest_layer properly allocated\n129\t        unsafe {\n130\t            MH::compress_rows(\n131\t                &mut query_digest_layer,\n132\t                matrix.buffer(),\n133\t                matrix.width(),\n134\t                query_stride,\n135\t                k,\n136\t            )\n137\t            .map_err(MerkleTreeError::CompressingRowHashes)?;\n138\t        }\n139\t        // If not caching, drop the backing matrix at this point to save memory.\n140\t        let backing_matrix = cache_backing_matrix.then_some(matrix);\n141\t\n142\t        let mut digest_layers = vec![query_digest_layer];\n143\t        while digest_layers.last().unwrap().len() > 1 {\n144\t            let prev_layer = digest_layers.last().unwrap();\n145\t            let mut layer = DeviceBuffer::<D>::with_capacity(prev_layer.len() / 2);\n146\t            let layer_len = layer.len();\n147\t            let layer_idx = digest_layers.len();\n148\t            // SAFETY:\n149\t            // - `layer` is properly allocated with half the size of `prev_layer` and does not\n150\t            //   overlap with it.\n151\t            unsafe {\n152\t                MH::compress_layer(&mut layer, prev_layer, layer_len).map_err(|error| {\n153\t                    MerkleTreeError::AdjacentCompressLayer {\n154\t                        error,\n155\t                        layer: layer_idx,\n156\t                    }\n157\t                })?;\n158\t            }\n159\t            digest_layers.push(layer);\n160\t        }\n161\t        let d_root = digest_layers.last().unwrap();\n162\t        assert_eq!(d_root.len(), 1, \"Only one root is supported\");\n163\t        let root = d_root.to_host()?.pop().unwrap();\n164\t\n165\t        mem.emit_metrics();\n166\t        Ok(Self {\n167\t            backing_matrix,\n168\t            digest_layers,\n169\t            rows_per_query,\n170\t            root,\n171\t        })\n172\t    }\n173\t\n174\t    #[instrument(name = \"batch_open_rows\", skip_all)]\n175\t    pub fn batch_open_rows(\n176\t        backing_matrices: &[&DeviceMatrix<F>],\n177\t        query_indices: &[usize],\n178\t        query_stride: usize,\n179\t        rows_per_query: usize,\n180\t    ) -> Result<\n181\t        Vec<\n182\t            // per tree\n183\t            Vec<\n184\t                // per query index\n185\t                Vec<F>, // opened rows, concatenated for rows_per_query strided rows\n186\t            >,\n187\t        >,\n188\t        MerkleTreeError,\n189\t    > {\n190\t        let row_idxs = query_indices\n191\t            .iter()\n192\t            .flat_map(|&query_idx| {\n193\t                debug_assert!(query_idx < query_stride);\n194\t                (0..rows_per_query)\n195\t                    .map(move |row_offset| (row_offset * query_stride + query_idx) as u32)\n196\t            })\n197\t            .collect_vec();\n198\t        let d_row_idxs = row_idxs.to_device()?;\n199\t        // PERF[jpw]: I did not batch across trees into a single kernel call because widths are\n200\t        // different so it was inconvenient. Make a new kernel if slow.\n201\t        // NOTE: par_iter requires cross-stream waits, not worth the effort\n202\t        backing_matrices\n203\t            .iter()\n204\t            .enumerate()\n205\t            .map(|(matrix_idx, matrix)| {\n206\t                let d_out = DeviceBuffer::<F>::with_capacity(row_idxs.len() * matrix.width());\n207\t                // SAFETY:\n208\t                // - `output_rows` is allocated with row_idxs.len() * width\n209\t                // - row indices are within bounds\n210\t                unsafe {\n211\t                    matrix_get_rows_fp_kernel(\n212\t                        &d_out,\n213\t                        matrix.buffer(),\n214\t                        &d_row_idxs,\n215\t                        matrix.width() as u64,\n216\t                        matrix.height() as u64,\n217\t                        d_row_idxs.len() as u32,\n218\t                    )\n219\t                    .map_err(|error| MerkleTreeError::MatrixGetRows { error, matrix_idx })?;\n220\t                }\n221\t                let width = matrix.width();\n222\t                let out = info_span!(\"opened_rows_d2h\").in_scope(|| d_out.to_host())?;\n223\t                let opened_rows_per_query = out\n224\t                    .chunks_exact(rows_per_query * width)\n225\t                    .map(|rows| rows.to_vec())\n226\t                    .collect_vec();\n227\t                Ok(opened_rows_per_query)\n228\t            })\n229\t            .collect::<Result<Vec<_>, MerkleTreeError>>()\n230\t    }\n231\t}\n232\t\n233\timpl MerkleTreeConstructor for Poseidon2MerkleHash {\n234\t    fn new_merkle_tree(\n235\t        matrix: DeviceMatrix<F>,\n236\t        rows_per_query: usize,\n237\t        cache_backing_matrix: bool,\n238\t    ) -> Result<MerkleTreeGpu<F, Self::Digest>, MerkleTreeError> {\n239\t        MerkleTreeGpu::<F, Self::Digest>::new_generic_with_hash::<Self>(\n240\t            matrix,\n241\t            rows_per_query,\n242\t            cache_backing_matrix,\n243\t        )\n244\t    }\n245\t}\n246\t\n247\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n248\timpl MerkleTreeConstructor for crate::hash_scheme::Bn254Poseidon2MerkleHash {\n249\t    fn new_merkle_tree(\n250\t        matrix: DeviceMatrix<F>,\n251\t        rows_per_query: usize,\n252\t        cache_backing_matrix: bool,\n253\t    ) -> Result<MerkleTreeGpu<F, Self::Digest>, MerkleTreeError> {\n254\t        MerkleTreeGpu::<F, Self::Digest>::new_generic_with_hash::<Self>(\n255\t            matrix,\n256\t            rows_per_query,\n257\t            cache_backing_matrix,\n258\t        )\n259\t    }\n260\t}\n261\t\n262\t// Base field merkle tree — Poseidon2 default constructor\n263\timpl MerkleTreeGpu<F, Digest> {\n264\t    /// Build a Merkle tree using the default Poseidon2 hash.\n265\t    ///\n266\t    /// Equivalent to `new_with_hash::<Poseidon2MerkleHash>(...)`.\n267\t    pub fn new(\n268\t        matrix: DeviceMatrix<F>,\n269\t        rows_per_query: usize,\n270\t        cache_backing_matrix: bool,\n271\t    ) -> Result<Self, MerkleTreeError> {\n272\t        Self::new_with_hash::<Poseidon2MerkleHash>(matrix, rows_per_query, cache_backing_matrix)\n273\t    }\n274\t}\n275\t\n276\t// Base field merkle tree — generic batch query (works for any BatchQueryMerkle digest)\n277\timpl<D: BatchQueryMerkle + Send + Sync + 'static> MerkleTreeGpu<F, D> {\n278\t    fn batch_query_proofs(\n279\t        trees: &[&Self],\n280\t        query_indices: &[usize],\n281\t    ) -> Result<Vec<Vec<Vec<D>>>, MerkleTreeError> {\n282\t        // The kernel treats each layer as a separate array and does parallel accesses;\n283\t        // we lay out all the layer pointers flattened into a vec.\n284\t        let num_trees = trees.len();\n285\t        let num_queries = query_indices.len();\n286\t        let depth = trees[0].proof_depth();\n287\t        debug_assert!(\n288\t            trees.iter().all(|tree| tree.proof_depth() == depth),\n289\t            \"Merkle trees don't have same depth\"\n290\t        );\n291\t        let layers_ptr = trees\n292\t            .iter()\n293\t            .flat_map(|tree| {\n294\t                // skip root layer [depth]\n295\t                tree.digest_layers\n296\t                    .iter()\n297\t                    .take(depth)\n298\t                    .map(|layer| layer.as_ptr() as u64)\n299\t            })\n300\t            .collect_vec();\n301\t        let d_layers_ptr = layers_ptr.to_device()?;\n302\t        debug_assert_eq!(d_layers_ptr.len(), num_trees * depth);\n303\t\n304\t        // [query_idx] is the top level grouping\n305\t        let indices = query_indices\n306\t            .iter()\n307\t            .flat_map(|&index| {\n308\t                (0..num_trees).flat_map(move |tree_idx| {\n309\t                    (0..depth).map(move |layer_idx| {\n310\t                        debug_assert!(index < trees[tree_idx].query_stride());\n311\t                        ((index >> layer_idx) ^ 1) as u64\n312\t                    })\n313\t                })\n314\t            })\n315\t            .collect_vec();\n316\t        let d_indices = indices.to_device()?;\n317\t        debug_assert_eq!(d_indices.len(), d_layers_ptr.len() * num_queries);\n318\t\n319\t        let mut d_out =\n320\t            DeviceBuffer::<F>::with_capacity(d_layers_ptr.len() * num_queries * DIGEST_SIZE);\n321\t        // SAFETY:\n322\t        // - d_out has size num_trees * depth * num_queries * DIGEST_SIZE in `F` elements\n323\t        // - d_layers_ptr is size `num_trees * depth` device pointers\n324\t        // - d_indices is size `num_trees * depth * num_queries` indices for merkle proof sibling\n325\t        //   indices\n326\t        // - Both Digest=[F;8] and Bn254Digest=[Bn254Scalar;1] are 32 bytes == DIGEST_SIZE * 4, so\n327\t        //   the same kernel correctly copies the raw bytes for either digest type.\n328\t        unsafe {\n329\t            query_digest_layers(\n330\t                &mut d_out,\n331\t                &d_layers_ptr,\n332\t                &d_indices,\n333\t                num_queries as u64,\n334\t                d_layers_ptr.len() as u64,\n335\t            )\n336\t            .map_err(MerkleTreeError::QueryDigestLayers)?;\n337\t        }\n338\t        let out = d_out.to_host()?;\n339\t        // Chunk up the array using D::reconstruct_from_f\n340\t        let res = (0..num_trees)\n341\t            .map(|tree_idx| {\n342\t                (0..num_queries)\n343\t                    .map(|query_idx| {\n344\t                        (0..depth)\n345\t                            .map(|layer_idx| {\n346\t                                let base =\n347\t                                    (query_idx * num_trees * depth + tree_idx * depth + layer_idx)\n348\t                                        * DIGEST_SIZE;\n349\t                                D::reconstruct_from_f(&out, base)\n350\t                            })\n351\t                            .collect_vec()\n352\t                    })\n353\t                    .collect_vec()\n354\t            })\n355\t            .collect_vec();\n356\t        Ok(res)\n357\t    }\n358\t\n359\t    /// Batch queries multiple `trees` at _the same_ `query_indices` for merkle proofs.\n360\t    ///\n361\t    /// # Assumptions\n362\t    /// - All `trees` have the same depth.\n363\t    pub fn batch_query_merkle_proofs(\n364\t        trees: &[&Self],\n365\t        query_indices: &[usize],\n366\t    ) -> Result<\n367\t        Vec<\n368\t            // per tree\n369\t            Vec<\n370\t                // per query index\n371\t                Vec<D>, // merkle proof\n372\t            >,\n373\t        >,\n374\t        MerkleTreeError,\n375\t    >\n376\t    where\n377\t        D: MerkleProofQueryDigest,\n378\t    {\n379\t        D::batch_query_merkle_proofs(trees, query_indices)\n380\t    }\n381\t}\n382\t\n383\timpl MerkleProofQueryDigest for Digest {\n384\t    fn batch_query_merkle_proofs(\n385\t        trees: &[&MerkleTreeGpu<F, Self>],\n386\t        query_indices: &[usize],\n387\t    ) -> Result<Vec<Vec<Vec<Self>>>, MerkleTreeError> {\n388\t        MerkleTreeGpu::<F, Self>::batch_query_proofs(trees, query_indices)\n389\t    }\n390\t}\n391\t\n392\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n393\timpl MerkleProofQueryDigest for Bn254Digest {\n394\t    fn batch_query_merkle_proofs(\n395\t        trees: &[&MerkleTreeGpu<F, Self>],\n396\t        query_indices: &[usize],\n397\t    ) -> Result<Vec<Vec<Vec<Self>>>, MerkleTreeError> {\n398\t        MerkleTreeGpu::<F, Self>::batch_query_proofs(trees, query_indices)\n399\t    }\n400\t}\n401\t\n402\t// Extension field merkle tree — generic constructor\n403\timpl<D: Copy + Send + Sync + 'static> MerkleTreeGpu<EF, D> {\n404\t    /// Build a Merkle tree from an extension-field matrix using hash scheme `MH`.\n405\t    #[instrument(name = \"merkle_tree_ext\", skip_all)]\n406\t    pub fn new_with_hash<MH: GpuMerkleHash<Digest = D>>(\n407\t        matrix: DeviceMatrix<EF>,\n408\t        rows_per_query: usize,\n409\t        cache_backing_matrix: bool,\n410\t    ) -> Result<Self, MerkleTreeError> {\n411\t        let height = matrix.height();\n412\t        assert!(height.is_power_of_two());\n413\t        let k = log2_strict_usize(rows_per_query);\n414\t        assert!(\n415\t            rows_per_query <= height,\n416\t            \"rows_per_query ({rows_per_query}) must not exceed height ({height})\"\n417\t        );\n418\t        let query_stride = height / rows_per_query;\n419\t        let mut query_digest_layer = DeviceBuffer::<D>::with_capacity(query_stride);\n420\t        // SAFETY: query_digest_layer properly allocated\n421\t        unsafe {\n422\t            MH::compress_rows_ext(\n423\t                &mut query_digest_layer,\n424\t                matrix.buffer(),\n425\t                matrix.width(),\n426\t                query_stride,\n427\t                k,\n428\t            )\n429\t            .map_err(MerkleTreeError::CompressingRowHashesExt)?;\n430\t        }\n431\t        // If not caching, drop the backing matrix at this point to save memory.\n432\t        let backing_matrix = cache_backing_matrix.then_some(matrix);\n433\t\n434\t        let mut digest_layers = vec![query_digest_layer];\n435\t        while digest_layers.last().unwrap().len() > 1 {\n436\t            let prev_layer = digest_layers.last().unwrap();\n437\t            let mut layer = DeviceBuffer::<D>::with_capacity(prev_layer.len() / 2);\n438\t            let layer_len = layer.len();\n439\t            let layer_idx = digest_layers.len();\n440\t            // SAFETY:\n441\t            // - `layer` is properly allocated with half the size of `prev_layer` and does not\n442\t            //   overlap with it.\n443\t            unsafe {\n444\t                MH::compress_layer(&mut layer, prev_layer, layer_len).map_err(|error| {\n445\t                    MerkleTreeError::AdjacentCompressLayer {\n446\t                        error,\n447\t                        layer: layer_idx,\n448\t                    }\n449\t                })?;\n450\t            }\n451\t            digest_layers.push(layer);\n452\t        }\n453\t        let d_root = digest_layers.last().unwrap();\n454\t        assert_eq!(d_root.len(), 1, \"Only one root is supported\");\n455\t        let root = d_root.to_host()?.pop().unwrap();\n456\t\n457\t        Ok(Self {\n458\t            backing_matrix,\n459\t            digest_layers,\n460\t            rows_per_query,\n461\t            root,\n462\t        })\n463\t    }\n464\t}\n465\t\n466\t// Extension field merkle tree — Poseidon2 default constructor\n467\timpl MerkleTreeGpu<EF, Digest> {\n468\t    /// Build a Merkle tree from an extension-field matrix using Poseidon2.\n469\t    ///\n470\t    /// NOTE: currently unused because we transpose `DeviceMatrix<EF>` to\n471\t    /// `DeviceMatrix<F>` beforehand in our use cases.\n472\t    pub fn new(\n473\t        matrix: DeviceMatrix<EF>,\n474\t        rows_per_query: usize,\n475\t        cache_backing_matrix: bool,\n476\t    ) -> Result<Self, MerkleTreeError> {\n477\t        Self::new_with_hash::<Poseidon2MerkleHash>(matrix, rows_per_query, cache_backing_matrix)\n478\t    }\n479\t}\n480\t"}]},"parent_tool_use_id":"toolu_01K7Tk9XpPYZcSLTKVR6cWaX","session_id":"f93534bb-5de3-4083-9e85-ad533ac466ab","uuid":"e23d44df-b859-417b-8fe1-748a752542c8","timestamp":"2026-04-14T04:04:10.403Z"}
