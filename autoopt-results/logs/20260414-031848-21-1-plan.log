air_idx,\n1411\t                        n_lift,\n1412\t                        num_y: 1,\n1413\t                        has_constraints,\n1414\t                        has_interactions,\n1415\t                        norm_factor,\n1416\t                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n1417\t                        sels_ptr: sels.buffer().as_ptr(),\n1418\t                        prep_ptr,\n1419\t                        main_ptrs_dev,\n1420\t                        public_ptr: public_vals.as_ptr(),\n1421\t                        eq_3bs_ptr: eq_3bs.as_ptr(),\n1422\t                    });\n1423\t                } else {\n1424\t                    // A.2: scale tilde evals only\n1425\t                    if has_constraints {\n1426\t                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n1427\t                        *tilde_eval *= r_prev;\n1428\t                    }\n1429\t                    if has_interactions {\n1430\t                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n1431\t                            *x *= r_prev;\n1432\t                        }\n1433\t                    }\n1434\t                }\n1435\t            } else {\n1436\t                // Case B: collect metadata for batched interpolation\n1437\t                let log_num_y = n_lift - round;\n1438\t                let num_y = 1 << log_num_y;\n1439\t                let height = 2 * num_y;\n1440\t                debug_assert_eq!(height, mats[0].height());\n1441\t\n1442\t                let col_start = all_columns.len();\n1443\t                // Collect all column pointers: selectors + all matrices (preprocessed + mains)\n1444\t                all_columns.extend(\n1445\t                    iter::once(sels)\n1446\t                        .chain(mats.iter())\n1447\t                        .flat_map(|m| {\n1448\t                            assert_eq!(m.height(), height);\n1449\t                            (0..m.width())\n1450\t         