mut_ptr();\n1479\t\n1480\t            // Build descriptors with multi-block-per-trace assignment\n1481\t            const THREADS_PER_BLOCK: u32 = 512;\n1482\t            let mut block_offset: u32 = 0;\n1483\t            let descs: Vec<InterpColDesc> = case_b_traces\n1484\t                .iter()\n1485\t                .map(|meta| {\n1486\t                    let total_threads = (meta.num_y * meta.num_columns) as u32;\n1487\t                    let blocks = total_threads.div_ceil(THREADS_PER_BLOCK);\n1488\t                    let desc = InterpColDesc {\n1489\t                        output: unsafe { big_ptr.add(meta.interp_offset) },\n1490\t                        columns_offset: meta.col_start as u32,\n1491\t                        num_y: meta.num_y as u32,\n1492\t                        num_columns: meta.num_columns as u32,\n1493\t                        total_threads,\n1494\t                        block_start: block_offset,\n1495\t                    };\n1496\t                    block_offset += blocks;\n1497\t                    desc\n1498\t                })\n1499\t                .collect();\n1500\t            let total_blocks = block_offset as usize;\n1501\t\n1502\t            let d_descs = descs.to_device()?;\n1503\t            let d_all_columns = all_columns.to_device()?;\n1504\t            unsafe {\n1505\t                batched_interpolate_columns_gpu(&d_descs, &d_all_columns, sp_deg, total_blocks)\n1506\t                    .map_err(|e| LogupZerocheckError::InterpolateColumns(e.into()))?;\n1507\t            }\n1508\t\n1509\t            Some(big_buf)\n1510\t        } else {\n1511\t            None\n1512\t        };\n1513\t\n1514\t        // ── Phase 3: Build TraceCtx for each Case B trace ──\n1515\t        for meta in &case_b_traces {\n1516\t            let mats = &self.mat_evals_per_trace[meta.trace_idx];\n1517\t            let first_main_idx = usize::from(meta.has_preprocessed);\n1518\t            let eq_xi_tree = &self.eq_xis[&meta.n_lift];\n1519\t            let log_num_y = meta.n_lift - round;\n1520\t            let interpolated_height = sp_deg * meta.num_y;\n1521\t\n1522\t            let base_ptr = _keepalive_interpolated\n1523\t                .as_ref()\n1524\t                .unwrap()\n1525\t                .as_ptr()\n1526\t                .wrapping_add(meta.interp_offset);\n1527\t\n1528\t            let mut widths_so_far = 0usize;\n1529\t            let sels_ptr = base_ptr.wrapping_add(widths_so_far * interpolated_height);\n1530\t            widths_so_far += 3; // selector width is always 3\n1531\t\n1532\t            let prep_ptr = if meta.has_preprocessed {\n1533\t                MainMatrixPtrs {\n1534\t                    data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1535\t                    air_width: air_width_for_mat(meta.need_rot, mats[0].width()),\n1536\t                }\n1537\t            } else {\n1538\t                MainMatrixPtrs {\n1539\t                    data: std::ptr::null(),\n1540\t                    air_width: 0,\n1541\t                }\n1542\t            };\n1543\t            if meta.has_preprocessed {\n1544\t                widths_so_far += mats[0].width();\n1545\t            }\n1546\t            let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1547\t                .iter()\n1548\t                .map(|m| {\n1549\t                    let main_ptr = MainMatrixPtrs {\n1550\t                        data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1551\t                        air_width: air_width_for_mat(meta.need_rot, m.width()),\n1552\t                    };\n1553\t                    widths_so_far += m.width();\n1554\t                    main_ptr\n1555\t                })\n1556\t                .collect_vec();\n1557\t            debug_assert_eq!(widths_so_far, meta.num_columns);\n1558\t            let main_ptrs_dev = main_ptrs.to_device()?;\n1559\t\n1560\t            early_eval.push(TraceCtx {\n1561\t                trace_idx