{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V2SVZZqhS2GR4HWkeUp6ci","type":"tool_result","content":"152\tfn process_air_round0<HS: GpuHashScheme>(\n153\t    w: &Round0AirWorkItem<HS>,\n154\t    bufs: &mut round0::Round0ThreadBuffers,\n155\t) -> Result<Round0AirResult, LogupZerocheckError> {\n156\t    let single_pk = w.single_pk;\n157\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n158\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n159\t    assert!(\n160\t        local_constraint_deg <= w.constraint_degree,\n161\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n162\t        w.constraint_degree\n163\t    );\n164\t\n165\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n166\t    let omega_root = F::two_adic_generator(log_large_domain);\n167\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n168\t\n169\t    let height = w.common_main.height();\n170\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n171\t    for committed in w.cached_mains {\n172\t        main_parts.push(committed.trace.buffer().as_ptr());\n173\t    }\n174\t    main_parts.push(w.common_main.buffer().as_ptr());\n175\t    let d_main_parts = main_parts.to_device()?;\n176\t\n177\t    let n_lift = w.n.max(0) as usize;\n178\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n179\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n180\t\n181\t    // Check if pre-allocated zerocheck buffers are large enough for this AIR\n182\t    let zc_prealloc_inter = if w.zc_intermed_cap > 0\n183\t        && bufs.zc_intermediates.len() >= w.zc_intermed_cap\n184\t    {\n185\t        Some(&mut bufs.zc_intermediates)\n186\t    } else {\n187\t        None\n188\t    };\n189\t    let zc_prealloc_temp = if w.zc_temp_sums_cap > 0\n190\t        && bufs.zc_temp_sums.len() >= w.zc_temp_sums_cap\n191\t    {\n192\t        Some(&mut bufs.zc_temp_sums)\n193\t    } else {\n194\t        None\n195\t    };\n196\t\n197\t    let sum_buffer = evaluate_round0_constraints_gpu(\n198\t        single_pk,\n199\t        w.selectors_cube.buffer(),\n200\t        &d_main_parts,\n201\t        w.public_values,\n202\t        eq_xi_tree.get_ptr(n_lift),\n203\t        w.d_lambda_pows,\n204\t        1 << w.l_skip,\n205\t        1 << n_lift,\n206\t        height as u32,\n207\t        num_cosets_zc as u32,\n208\t        omega_root,\n209\t        w.max_temp_bytes,\n210\t        zc_prealloc_inter,\n211\t        zc_prealloc_temp,\n212\t    )?;\n213\t\n214\t    let zerocheck_poly = if !sum_buffer.is_empty() {\n215\t        let q_evals = sum_buffer.to_host_on_current_stream()?;\n216\t        let q = {\n217\t            let mut values = EF::zero_vec(num_cosets_zc << w.l_skip);\n218\t            for coset_idx in 0..num_cosets_zc {\n219\t                for i in 0..1 << w.l_skip {\n220\t                    values[i * num_cosets_zc + coset_idx] = q_evals[(coset_idx << w.l_skip) + i];\n221\t                }\n222\t            }\n223\t            UnivariatePoly::from_geometric_cosets_evals_idft(\n224\t                RowMajorMatrix::new(values, num_cosets_zc),\n225\t                omega_root,\n226\t                omega_root,\n227\t            )\n228\t        };\n229\t        let sp_0_deg = sumcheck_round0_deg(w.l_skip, local_constraint_deg);\n230\t        let coeffs = (0..=sp_0_deg)\n231\t            .map(|i| {\n232\t                let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n233\t                if i >= 1 << w.l_skip {\n234\t                    c += q.coeffs()[i - (1 << w.l_skip)];\n235\t                }\n236\t                c\n237\t            })\n238\t            .collect_vec();\n239\t        Some(UnivariatePoly::new(coeffs))\n240\t    } else {\n241\t        None\n242\t    };\n243\t\n244\t    let num_cosets_logup = local_constraint_deg;\n245\t\n246\t    // Check if pre-allocated logup buffers are large enough for this AIR\n247\t    let logup_prealloc_inter = if w.logup_intermed_cap > 0\n248\t        && bufs.logup_intermediates.len() >= w.logup_intermed_cap\n249\t    {\n250\t        Some(&mut bufs.logup_intermediates)\n251\t    } else {\n252\t        None\n253\t    };\n254\t    let logup_prealloc_temp = if w.logup_temp_sums_cap > 0\n255\t        && bufs.logup_temp_sums.len() >= w.logup_temp_sums_cap\n256\t    {\n257\t        Some(&mut bufs.logup_temp_sums)\n258\t    } else {\n259\t        None\n260\t    };\n261\t\n262\t    let sum = evaluate_round0_interactions_gpu(\n263\t        single_pk,\n264\t        &single_air_constraints,\n265\t        w.selectors_cube.buffer(),\n266\t        &d_main_parts,\n267\t        w.public_values,\n268\t        eq_xi_tree.get_ptr(n_lift),\n269\t        w.beta_pows,\n270\t        w.eq_3bs,\n271\t        1 << w.l_skip,\n272\t        1 << n_lift,\n273\t        height as u32,\n274\t        num_cosets_logup as u32,\n275\t        omega_root,\n276\t        w.max_temp_bytes,\n277\t        logup_prealloc_inter,\n278\t        logup_prealloc_temp,\n279\t    )?;\n280\t\n281\t    let (logup_numer_poly, logup_denom_poly) = if !sum.is_empty() {\n282\t        let evals = sum.to_host_on_current_stream()?;\n283\t        let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n284\t            evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n285\t        if w.n.is_negative() {\n286\t            let norm_factor = F::from_u32(1 << w.n.unsigned_abs()).inverse();\n287\t            for s in &mut numer {\n288\t                *s *= norm_factor;\n289\t            }\n290\t        }\n291\t        let mut numer_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n292\t        let mut denom_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n293\t        for coset_idx in 0..num_cosets_logup {\n294\t            for i in 0..1 << w.l_skip {\n295\t                let src = (coset_idx << w.l_skip) + i;\n296\t                let dst = i * num_cosets_logup + coset_idx;\n297\t                numer_values[dst] = numer[src];\n298\t                denom_values[dst] = denom[src];\n299\t            }\n300\t        }\n301\t        let numer_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n302\t            RowMajorMatrix::new(numer_values, num_cosets_logup),\n303\t            omega_root,\n304\t            F::ONE,\n305\t        );\n306\t        let denom_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n307\t            RowMajorMatrix::new(denom_values, num_cosets_logup),\n308\t            omega_root,\n309\t            F::ONE,\n310\t        );\n311\t        (Some(numer_poly), Some(denom_poly))\n312\t    } else {\n313\t        (None, None)\n314\t    };\n315\t\n316\t    Ok(Round0AirResult {\n317\t        trace_idx: w.trace_idx,\n318\t        zerocheck_poly,\n319\t        logup_numer_poly,\n320\t        logup_denom_poly,\n321\t    })\n322\t}\n323\t\n324\t#[allow(clippy::type_complexity)]\n325\t#[instrument(level = \"info\", skip_all)]\n326\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n327\t    transcript: &mut TS,\n328\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n329\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n330\t    save_memory: bool,\n331\t    monomial_num_y_threshold: u32,\n332\t    sm_count: u32,\n333\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n334\twhere\n335\t    HS: GpuHashScheme,\n336\t    TS: GpuFiatShamirTranscript<HS::SC>,\n337\t{\n338\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n339\t    let l_skip = mpk.params.l_skip;\n340\t    let constraint_degree = mpk.max_constraint_degree;\n341\t    let num_traces = ctx.per_trace.len();\n342\t\n343\t    // Traces are sorted\n344\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n345\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n346\t    // heights\n347\t    let mut total_interactions = 0u64;\n348\t    let interactions_meta: Vec<_> = ctx\n349\t        .per_trace\n350\t        .iter()\n351\t        .map(|(air_idx, air_ctx)| {\n352\t            let pk = &mpk.per_air[*air_idx];\n353\t\n354\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n355\t            let height = air_ctx.common_main.height();\n356\t            let log_height = log2_strict_usize(height);\n357\t            let log_lifted_height = log_height.max(l_skip);\n358\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n359\t            (num_interactions, log_lifted_height)\n360\t        })\n361\t        .collect();\n362\t    // Implicitly, the width of this stacking should be 1\n363\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n364\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n365\t    // GKR\n366\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n367\t\n368\t    // Grind to increase soundness of random sampling for LogUp\n369\t    let logup_pow_witness = transcript\n370\t        .grind_gpu(mpk.params.logup.pow_bits)\n371\t        .map_err(LogupZerocheckError::Grind)?;\n372\t    let alpha_logup = transcript.sample_ext();\n373\t    let beta_logup = transcript.sample_ext();\n374\t    debug!(%alpha_logup, %beta_logup);\n375\t\n376\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n377\t    let mut prover = LogupZerocheckGpu::new(\n378\t        mpk,\n379\t        ctx,\n380\t        n_logup,\n381\t        interactions_layout,\n382\t        alpha_logup,\n383\t        beta_logup,\n384\t        save_memory,\n385\t        monomial_num_y_threshold,\n386\t        sm_count,\n387\t    )?;\n388\t    let n_global = prover.n_global;\n389\t\n390\t    let total_leaves = 1 << (l_skip + n_logup);\n391\t    prover\n392\t        .mem\n393\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n394\t    prover.mem.reset_peak();\n395\t    let (inputs, alpha) = if has_interactions {\n396\t        log_gkr_input_evals(\n397\t            &prover.trace_interactions,\n398\t            mpk,\n399\t            ctx,\n400\t            l_skip,\n401\t            alpha_logup,\n402\t            &prover.d_challenges,\n403\t            total_leaves,\n404\t        )?\n405\t    } else {\n406\t        (DeviceBuffer::new(), EF::ZERO)\n407\t    };\n408\t    // Set memory limit for batch MLE based on inputs buffer size\n409\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n410\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n411\t    if !prover.save_memory {\n412\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n413\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n414\t            tracing::warn!(\n415\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n416\t                prover.memory_limit_bytes\n417\t            );\n418\t        }\n419\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n420\t    }\n421\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n422\t\n423\t    let (frac_sum_proof, mut xi) =\n424\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n425\t    while xi.len() != l_skip + n_global {\n426\t        xi.push(transcript.sample_ext());\n427\t    }\n428\t    debug!(?xi);\n429\t    prover.xi = xi;\n430\t\n431\t    logup_gkr_span.exit();\n432\t\n433\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does\n434\t    // not include the kernel times for the actual folding\n435\t    let round0_span = info_span!(\"prover.rap_constraints.round0\", phase = \"prover\").entered();\n436\t    // begin batch sumcheck\n437\t    let mut sumcheck_round_polys = Vec::with_capacity(n_max);\n438\t    let mut r = Vec::with_capacity(n_max + 1);\n439\t    // batching randomness\n440\t    let lambda = transcript.sample_ext();\n441\t    debug!(%lambda);\n442\t\n443\t    let sp_0_polys = prover.sumcheck_uni_round0_polys(ctx, lambda)?;\n444\t    let s_0_cpu_span = info_span!(\"s'_0 -> s_0 cpu interpolations\").entered();\n445\t    let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_degree);\n446\t    let s_deg = constraint_degree + 1;\n447\t    let s_0_deg = sumcheck_round0_deg(l_skip, s_deg);\n448\t    let large_uni_domain = (s_0_deg + 1).next_power_of_two();\n449\t    let dft = Radix2BowersSerial;\n450\t    let s_0_logup_polys = {\n451\t        let eq_sharp_uni = eq_sharp_uni_poly(&prover.xi[..l_skip]);\n452\t        let mut eq_coeffs = eq_sharp_uni.into_coeffs();\n453\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n454\t        let eq_evals = dft.dft(eq_coeffs);\n455\t\n456\t        let width = 2 * num_traces;\n457\t        let mut sp_coeffs_mat = EF::zero_vec(width * large_uni_domain);\n458\t        for (i, coeffs) in sp_0_polys[..2 * num_traces].iter().enumerate() {\n459\t            for (j, &c_j) in coeffs.coeffs().iter().enumerate().take(sp_0_deg + 1) {\n460\t                // SAFETY:\n461\t                // - coeffs length is <= sp_0_deg + 1 <= s_0_deg < large_uni_domain\n462\t                // - sp_coeffs_mat allocated for width\n463\t                unsafe {\n464\t                    *sp_coeffs_mat.get_unchecked_mut(j * width + i) = c_j;\n465\t                }\n466\t            }\n467\t        }\n468\t        let mut s_evals = dft.dft_batch(RowMajorMatrix::new(sp_coeffs_mat, width));\n469\t        for (eq, row) in zip(eq_evals, s_evals.values.chunks_mut(width)) {\n470\t            for x in row {\n471\t                *x *= eq;\n472\t            }\n473\t        }\n474\t        dft.idft_batch(s_evals)\n475\t    };\n476\t    let skip_domain_size = F::from_usize(1 << l_skip);\n477\t    // logup sum claims (sum_{\\hat p}, sum_{\\hat q}) per present AIR\n478\t    let (numerator_term_per_air, denominator_term_per_air): (Vec<_>, Vec<_>) = (0..num_traces)\n479\t        .map(|trace_idx| {\n480\t            let [sum_claim_p, sum_claim_q] = [0, 1].map(|is_denom| {\n481\t                // Compute sum over D of s_0(Z) to get the sum claim\n482\t                (0..=s_0_deg)\n483\t                    .step_by(1 << l_skip)\n484\t                    .map(|j| unsafe {\n485\t                        // SAFETY: matrix is 2 * num_trace x large_uni_domain, s_0_deg <\n486\t                        // large_uni_domain\n487\t                        *s_0_logup_polys\n488\t                            .values\n489\t                            .get_unchecked(j * 2 * num_traces + 2 * trace_idx + is_denom)\n490\t                    })\n491\t                    .sum::<EF>()\n492\t                    * skip_domain_size\n493\t            });\n494\t            transcript.observe_ext(sum_claim_p);\n495\t            transcript.observe_ext(sum_claim_q);\n496\t\n497\t            (sum_claim_p, sum_claim_q)\n498\t        })\n499\t        .unzip();\n500\t\n501\t    let mu = transcript.sample_ext();"}]},"parent_tool_use_id":"toolu_0176knSXpLjVFPnwrNKNfpcR","session_id":"f93534bb-5de3-4083-9e85-ad533ac466ab","uuid":"678aeea6-5a12-4990-b4cc-25f3f7d555af","timestamp":"2026-04-14T04:04:13.296Z"}
