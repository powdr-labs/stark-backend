; sp_deg]]; self.n_per_trace.len()];\n1333\t\n1334\t        let mut late_eval: Vec<TraceCtx> = Vec::new(); // round == n_lift + 1\n1335\t        let mut early_eval: Vec<TraceCtx> = Vec::new(); // round <= n_lift\n1336\t\n1337\t        // ── Phase 1: Collect metadata, split into Case A / Case B (no CUDA calls) ──\n1338\t        // For Case B traces, we collect column pointers and sizing info to batch the\n1339\t        // interpolation into a single kernel launch.\n1340\t        struct CaseBMeta {\n1341\t            trace_idx: usize,\n1342\t            air_idx: usize,\n1343\t            n_lift: usize,\n1344\t            num_y: usize,\n1345\t            num_columns: usize, // total columns (selectors + preprocessed + mains)\n1346\t            interp_offset: usize, // element offset within the big interpolated buffer\n1347\t            col_start: usize,   // start index in the flat all_columns array\n1348\t            has_preprocessed: bool,\n1349\t            need_rot: bool,\n1350\t            has_constraints: bool,\n1351\t            has_interactions: bool,\n1352\t            norm_factor: F,\n1353\t        }\n1354\t        let mut case_b_traces: Vec<CaseBMeta> = Vec::new();\n1355\t        let mut all_columns: Vec<*const EF> = Vec::new();\n1356\t        let mut total_interp_elems: usize = 0;\n1357\t\n1358\t        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n1359\t            self.n_per_trace.iter(),\n1360\t            self.mat_evals_per_trace.iter(),\n1361\t            self.sels_per_trace.iter(),\n1362\t            self.d_eq_3b_per_trace.iter(),\n1363\t            self.public_values_per_trace.iter(),\n1364\t            self.air_indices_per_trace.iter()\n1365\t        )\n1366\t        .enumerate()\n1367\t        {\n1368\t            let pk = &self.pk.per_air[air_idx];\n1369\t            let dag = &pk.vk.symbolic_constraints;\n1370\t            let has_constraints = dag.constraints.num_constraints() > 0;\n1371\t            let has_interac