{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016i9eBkaekABjendvzoSYmH","type":"tool_result","content":"1\tuse itertools::Itertools;\n2\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer};\n3\tuse openvm_stark_backend::{\n4\t    air_builders::symbolic::{\n5\t        symbolic_expression::SymbolicExpression, SymbolicConstraints, SymbolicDagBuilder,\n6\t        SymbolicExpressionDag,\n7\t    },\n8\t    prover::{fractional_sumcheck_gkr::Frac, DeviceStarkProvingKey},\n9\t};\n10\tuse p3_field::PrimeCharacteristicRing;\n11\tuse tracing::{debug, warn};\n12\t\n13\tuse super::errors::Round0EvalError;\n14\tuse crate::{\n15\t    cuda::logup_zerocheck::{\n16\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n17\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n18\t        logup_bary_eval_interactions_round0, zerocheck_ntt_eval_constraints,\n19\t    },\n20\t    gpu_backend::GenericGpuBackend,\n21\t    hash_scheme::GpuHashScheme,\n22\t    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n23\t    prelude::{EF, F},\n24\t};\n25\t\n26\t/// Pre-allocated per-thread GPU buffers for Round 0 evaluation.\n27\t/// Reused across AIRs to eliminate per-AIR mutex contention on the global memory manager.\n28\tpub(crate) struct Round0ThreadBuffers {\n29\t    pub zc_intermediates: DeviceBuffer<F>,\n30\t    pub zc_temp_sums: DeviceBuffer<EF>,\n31\t    pub logup_intermediates: DeviceBuffer<F>,\n32\t    pub logup_temp_sums: DeviceBuffer<Frac<EF>>,\n33\t}\n34\t\n35\t/// Evaluate plain AIR constraints (not interactions) for a single AIR, given prepared trace input.\n36\t///\n37\t/// `num_cosets` should equal `constraint_degree - 1` because we evaluate the quotient polynomial.\n38\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n39\t#[allow(clippy::too_many_arguments)]\n40\tpub fn evaluate_round0_constraints_gpu<HS: GpuHashScheme>(\n41\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n42\t    selectors_cube: &DeviceBuffer<F>,\n43\t    main_parts: &DeviceBuffer<*const F>,\n44\t    public_values: &DeviceBuffer<F>,\n45\t    eq_cube: *const EF,\n46\t    lambda_pows: &DeviceBuffer<EF>,\n47\t    skip_domain: u32,\n48\t    num_x: u32,\n49\t    height: u32,\n50\t    num_cosets: u32,\n51\t    g_shift: F,\n52\t    max_temp_bytes: usize,\n53\t    prealloc_intermediates: Option<&mut DeviceBuffer<F>>,\n54\t    prealloc_temp_sums: Option<&mut DeviceBuffer<EF>>,\n55\t) -> Result<DeviceBuffer<EF>, Round0EvalError> {\n56\t    let constraints_dag = &pk.vk.symbolic_constraints;\n57\t    if constraints_dag.constraints.constraint_idx.is_empty() || num_cosets == 0 {\n58\t        // No plain AIR constraints, return empty buffer\n59\t        return Ok(DeviceBuffer::new());\n60\t    }\n61\t\n62\t    let rules = &pk.other_data.zerocheck_round0;\n63\t\n64\t    let buffer_size: u32 = rules.inner.buffer_size;\n65\t    let intermed_capacity = unsafe {\n66\t        _zerocheck_r0_intermediates_buffer_size(\n67\t            buffer_size,\n68\t            skip_domain,\n69\t            num_x,\n70\t            num_cosets,\n71\t            max_temp_bytes,\n72\t        )\n73\t    };\n74\t\n75\t    let use_prealloc_inter = prealloc_intermediates\n76\t        .as_ref()\n77\t        .map_or(false, |p| intermed_capacity > 0 && p.len() >= intermed_capacity);\n78\t    let mut fallback_intermediates;\n79\t    let intermediates = if use_prealloc_inter {\n80\t        prealloc_intermediates.unwrap()\n81\t    } else {\n82\t        fallback_intermediates = if intermed_capacity > 0 {\n83\t            debug!(\"zerocheck:intermediates_capacity={intermed_capacity}\");\n84\t            DeviceBuffer::<F>::with_capacity(intermed_capacity)\n85\t        } else {\n86\t            DeviceBuffer::<F>::new()\n87\t        };\n88\t        &mut fallback_intermediates\n89\t    };\n90\t\n91\t    let temp_sums_buffer_capacity = unsafe {\n92\t        _zerocheck_r0_temp_sums_buffer_size(\n93\t            buffer_size,\n94\t            skip_domain,\n95\t            num_x,\n96\t            num_cosets,\n97\t            max_temp_bytes,\n98\t        )\n99\t    };\n100\t\n101\t    let use_prealloc_temp = prealloc_temp_sums\n102\t        .as_ref()\n103\t        .map_or(false, |p| p.len() >= temp_sums_buffer_capacity);\n104\t    let mut fallback_temp_sums;\n105\t    let temp_sums_buffer = if use_prealloc_temp {\n106\t        prealloc_temp_sums.unwrap()\n107\t    } else {\n108\t        debug!(\"zerocheck:temp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n109\t        fallback_temp_sums = DeviceBuffer::<EF>::with_capacity(temp_sums_buffer_capacity);\n110\t        &mut fallback_temp_sums\n111\t    };\n112\t\n113\t    let used_temp_bytes =\n114\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<EF>();\n115\t    if used_temp_bytes > max_temp_bytes {\n116\t        warn!(\"zerocheck used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\");\n117\t    }\n118\t\n119\t    let preprocessed_ptr = pk\n120\t        .preprocessed_data\n121\t        .as_ref()\n122\t        .map(|cd| cd.trace.buffer().as_ptr())\n123\t        .unwrap_or(std::ptr::null());\n124\t\n125\t    let mut sp_evals =\n126\t        DeviceBuffer::<EF>::with_capacity(num_cosets as usize * skip_domain as usize);\n127\t    // SAFETY:\n128\t    // - No bounds checks are done in this kernel. It fully assumes that the Rules are trusted and\n129\t    //   all nodes are valid.\n130\t    unsafe {\n131\t        zerocheck_ntt_eval_constraints(\n132\t            temp_sums_buffer,\n133\t            &mut sp_evals,\n134\t            selectors_cube,\n135\t            preprocessed_ptr,\n136\t            main_parts,\n137\t            eq_cube,\n138\t            lambda_pows,\n139\t            public_values,\n140\t            &rules.inner.d_rules,\n141\t            &rules.inner.d_used_nodes,\n142\t            buffer_size,\n143\t            intermediates,\n144\t            skip_domain,\n145\t            num_x,\n146\t            height,\n147\t            num_cosets,\n148\t            g_shift,\n149\t            max_temp_bytes,\n150\t        )?;\n151\t    }\n152\t\n153\t    Ok(sp_evals)\n154\t}\n155\t\n156\t/// Evaluate interaction constraints (excluding plain AIR constraints) for a single AIR, given\n157\t/// prepared trace input.\n158\t///\n159\t/// `constraints` includes interaction expressions for the AIR.\n160\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n161\t#[allow(clippy::too_many_arguments)]\n162\tpub fn evaluate_round0_interactions_gpu<HS: GpuHashScheme>(\n163\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n164\t    symbolic: &SymbolicConstraints<F>,\n165\t    selectors_cube: &DeviceBuffer<F>,\n166\t    main_parts: &DeviceBuffer<*const F>,\n167\t    public_values: &DeviceBuffer<F>,\n168\t    eq_cube: *const EF,\n169\t    beta_pows: &[EF],\n170\t    eq_3bs: &[EF],\n171\t    skip_domain: u32,\n172\t    num_x: u32,\n173\t    height: u32,\n174\t    num_cosets: u32,\n175\t    g_shift: F,\n176\t    max_temp_bytes: usize,\n177\t    prealloc_intermediates: Option<&mut DeviceBuffer<F>>,\n178\t    prealloc_temp_sums: Option<&mut DeviceBuffer<Frac<EF>>>,\n179\t) -> Result<DeviceBuffer<Frac<EF>>, Round0EvalError> {\n180\t    // Check if this trace has interactions\n181\t    if eq_3bs.is_empty() {\n182\t        return Ok(DeviceBuffer::new());\n183\t    }\n184\t    let large_domain = num_cosets * skip_domain;\n185\t\n186\t    // We create a new \"interactions DAG\" where the new .constraints are the interaction [count,\n187\t    // message_0, message_1, ..] expressions themselves, while the .interactions are empty\n188\t    // We track the indices with InteractionNode\n189\t\n190\t    // Copied from build_symbolic_constraints_dag to handle sorting of constraints\n191\t    // NOTE: For logup round0, the kernel uses weights indexed by rule_idx, not constraint_idx.\n192\t    //