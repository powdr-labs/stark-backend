         .iter()\n1608\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1609\t                .collect();\n1610\t            let batch = ZerocheckMonomialBatch::new(late_mono_traces, self.pk, &lambda_combs)?;\n1611\t            let out = batch\n1612\t                .evaluate(1)\n1613\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1614\t            let host = out.to_host()?;\n1615\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1616\t                self.zerocheck_tilde_evals[trace_idx] = host[i];\n1617\t                // zc_out not set for num_x=1, handled from tilde_eval in compute_batch_s\n1618\t            }\n1619\t        }\n1620\t\n1621\t        // Logup for early traces: partition by num_y threshold\n1622\t        if !early_eval.is_empty() {\n1623\t            evaluate_logup_batched(\n1624\t                &early_eval,\n1625\t                self.pk,\n1626\t                d_challenges_ptr,\n1627\t                sp_deg as u32,\n1628\t                self.monomial_num_y_threshold,\n1629\t                &self.logup_combinations,\n1630\t                &mut logup_out,\n1631\t                &mut self.logup_tilde_evals,\n1632\t                self.memory_limit_bytes,\n1633\t            )\n1634\t            .map_err(LogupZerocheckError::MleInteractionEval)?;\n1635\t        }\n1636\t\n1637\t        // Early traces (num_y>1): partition by threshold for zerocheck path\n1638\t        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n1639\t            .iter()\n1640\t            .filter(|t| t.has_constraints)\n1641\t            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n1642\t\n1643\t        // Partition high num_y traces by monomial-to-rules ratio\n1644\t        // (traces without monomials are skipped - they contribute zero)\n1645\t        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n1646\t            high_early.it