{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BVucMZ8dmF1aS3UK4EZVUW","type":"tool_result","content":"930\t                let mut cols = F::zero_vec(3 * height);\n931\t                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n932\t                cols[0] = F::ONE; // is_first\n933\t                cols[2 * height + height - 1] = F::ONE; // is_last\n934\t                let d_cols = cols.to_device()?;\n935\t                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n936\t            })\n937\t            .collect::<Result<Vec<_>, MemCopyError>>()?;\n938\t\n939\t        let selectors_base = self.sels_per_trace_base.clone();\n940\t\n941\t        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n942\t        // present AIR\n943\t        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n944\t        let d_lambda_pows = self\n945\t            .lambda_pows\n946\t            .as_ref()\n947\t            .expect(\"lambda powers must be set before round-0 evaluation\");\n948\t\n949\t        // Phase 1: Build work items with pre-computed buffer sizes (main thread, pure CPU)\n950\t        let per_thread_temp_bytes = self.memory_limit_bytes / NUM_ROUND0_STREAMS.max(1);\n951\t        let mut work_items: Vec<Round0AirWorkItem<HS>> = izip!(\n952\t            &ctx.per_trace,\n953\t            &self.n_per_trace,\n954\t            &selectors_base,\n955\t            &self.public_values_per_trace,\n956\t            &self.eq_3b_per_trace,\n957\t        )\n958\t        .enumerate()\n959\t        .map(|(trace_idx, ((air_idx, air_ctx), &n, sel, pv, eq3b))| {\n960\t            let single_pk = &self.pk.per_air[*air_idx];\n961\t            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n962\t            let n_lift = n.max(0) as usize;\n963\t            let skip_domain = 1u32 << l_skip;\n964\t            let num_x = 1u32 << n_lift;\n965\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1) as u32;\n966\t            let num_cosets_logup = local_constraint_deg as u32;\n967\t\n968\t            // Pre-compute zerocheck buffer sizes\n969\t            let zc_buffer_size = single_pk.other_data.zerocheck_round0.inner.buffer_size;\n970\t            let zc_intermed_cap = if num_cosets_zc > 0 && !single_pk.vk.symbolic_constraints.constraints.constraint_idx.is_empty() {\n971\t                unsafe {\n972\t                    _zerocheck_r0_intermediates_buffer_size(\n973\t                        zc_buffer_size, skip_domain, num_x, num_cosets_zc, per_thread_temp_bytes,\n974\t                    )\n975\t                }\n976\t            } else {\n977\t                0\n978\t            };\n979\t            let zc_temp_sums_cap = if num_cosets_zc > 0 && !single_pk.vk.symbolic_constraints.constraints.constraint_idx.is_empty() {\n980\t                unsafe {\n981\t                    _zerocheck_r0_temp_sums_buffer_size(\n982\t                        zc_buffer_size, skip_domain, num_x, num_cosets_zc, per_thread_temp_bytes,\n983\t                    )\n984\t                }\n985\t            } else {\n986\t                0\n987\t            };\n988\t\n989\t            // Pre-compute logup buffer sizes (using logup_round0_buffer_size from Step 1)\n990\t            let logup_buffer_size = single_pk.other_data.logup_round0_buffer_size;\n991\t            let has_interactions = !eq3b.is_empty();\n992\t            let logup_intermed_cap = if has_interactions && logup_buffer_size > 0 {\n993\t                unsafe {\n994\t                    _logup_r0_intermediates_buffer_size(\n995\t                        logup_buffer_size, skip_domain, num_x, num_cosets_logup, per_thread_temp_bytes,\n996\t                    )\n997\t                }\n998\t            } else {\n999\t                0\n1000\t            };\n1001\t            let logup_temp_sums_cap = if has_interactions && logup_buffer_size > 0 {\n1002\t                unsafe {\n1003\t                    _logup_r0_temp_sums_buffer_size(\n1004\t                        logup_buffer_size, skip_domain, num_x, num_cosets_logup, per_thread_temp_bytes,\n1005\t                    )\n1006\t                }\n1007\t            } else {\n1008\t                0\n1009\t            };\n1010\t\n1011\t            Round0AirWorkItem {\n1012\t                trace_idx,\n1013\t                single_pk,\n1014\t                n,\n1015\t                selectors_cube: sel,\n1016\t                public_values: pv,\n1017\t                eq_3bs: eq3b,\n1018\t                cached_mains: &air_ctx.cached_mains,\n1019\t                common_main: &air_ctx.common_main,\n1020\t                eq_xis: &self.eq_xis,\n1021\t                d_lambda_pows,\n1022\t                beta_pows: &self.beta_pows,\n1023\t                l_skip,\n1024\t                constraint_degree: self.constraint_degree,\n1025\t                xi: &self.xi,\n1026\t                max_temp_bytes: per_thread_temp_bytes,\n1027\t                zc_intermed_cap,\n1028\t                zc_temp_sums_cap,\n1029\t                logup_intermed_cap,\n1030\t                logup_temp_sums_cap,\n1031\t            }\n1032\t        })\n1033\t        .collect();\n1034\t\n1035\t        // Sort by descending height for better load balance across thread chunks.\n1036\t        work_items.sort_by(|a, b| b.common_main.height().cmp(&a.common_main.height()));\n1037\t\n1038\t        // Pre-compute buffer sizes for pre-allocation using a percentile threshold.\n1039\t        // Using the max would require enormous buffers (driven by a few large AIRs),\n1040\t        // causing GPU memory pressure that degrades all phases. The 95th percentile\n1041\t        // covers 95%+ of AIRs while keeping total allocation manageable. The few\n1042\t        // large AIRs above the threshold fall back to dynamic allocation.\n1043\t        let percentile_idx = |n: usize| -> usize { (n * 95 / 100).min(n.saturating_sub(1)) };\n1044\t        let (max_zc_intermed, max_zc_temp_sums, max_logup_intermed, max_logup_temp_sums) = {\n1045\t            let n = work_items.len();\n1046\t            let mut zc_i: Vec<usize> = work_items.iter().map(|w| w.zc_intermed_cap).collect();\n1047\t            let mut zc_t: Vec<usize> = work_items.iter().map(|w| w.zc_temp_sums_cap).collect();\n1048\t            let mut li: Vec<usize> = work_items.iter().map(|w| w.logup_intermed_cap).collect();\n1049\t            let mut lt: Vec<usize> = work_items.iter().map(|w| w.logup_temp_sums_cap).collect();\n1050\t            zc_i.sort_unstable();\n1051\t            zc_t.sort_unstable();\n1052\t            li.sort_unstable();\n1053\t            lt.sort_unstable();\n1054\t            let idx = percentile_idx(n);\n1055\t            (zc_i[idx], zc_t[idx], li[idx], lt[idx])\n1056\t        };\n1057\t\n1058\t        // Barrier: ensure all prior GPU work (trace uploads, pk data, selectors)\n1059\t        // is visible to worker thread streams.\n1060\t        current_stream_sync().map_err(MemCopyError::from)?;\n1061\t\n1062\t        // Phase 2: Process AIRs in parallel across N OS threads.\n1063\t        // Only use multi-threading when there are enough AIRs to benefit from concurrent\n1064\t        // kernel execution. With few large AIRs (e.g., APC 0 has ~20 per segment), each\n1065\t        // kernel already saturates the GPU and multi-threading adds memory pool overhead.\n1066\t        let mut num_threads = if work_items.len() >= 100 {\n1067\t            NUM_ROUND0_STREAMS.min(work_items.len())\n1068\t        } else {\n1069\t            1\n1070\t        };\n1071\t\n1072\t        // Memory budget check: reduce num_threads if pre-allocation would exceed budget.\n1073\t        let per_thread_bytes = max_zc_intermed * size_of::<F>()\n1074\t            + max_zc_temp_sums * size_of::<EF>()\n1075\t            + max_logup_intermed * size_of::<F>()\n1076\t            + max_logup_temp_sums * size_of::<Frac<EF>>();\n1077\t        while num_threads > 1 && num_threads * per_thread_bytes > 2_000_000_000 {\n1078\t            num_threads /= 2;\n1079\t            tracing::warn!(\n1080\t                \"Reducing Round 0 thread count to {} due to memory budget ({}MB per thread)\",\n1081\t                num_threads,\n1082\t                per_thread_bytes / (1024 * 1024),\n1083\t            );\n1084\t        }\n1085\t\n1086\t        // Pre-allocate per-thread buffer pools to avoid per-AIR mutex contention.\n1087\t        let skip_prealloc = num_threads == 1 && per_thread_bytes > 2_000_000_000;\n1088\t        let thread_buffers: Vec<round0::Round0ThreadBuffers> = if skip_prealloc {\n1089\t            tracing::warn!(\n1090\t                \"Skipping Round 0 pre-allocation: {}MB exceeds 2GB budget\",\n1091\t                per_thread_bytes / (1024 * 1024),\n1092\t            );\n1093\t            (0..num_threads)\n1094\t                .map(|_| round0::Round0ThreadBuffers {\n1095\t                    zc_intermediates: DeviceBuffer::new(),\n1096\t                    zc_temp_sums: DeviceBuffer::new(),\n1097\t                    logup_intermediates: DeviceBuffer::new(),\n1098\t                    logup_temp_sums: DeviceBuffer::new(),\n1099\t                })\n1100\t                .collect()\n1101\t        } else {\n1102\t            tracing::debug!(\n1103\t                \"Pre-allocating Round 0 buffers: {}MB per thread × {} threads\",\n1104\t                per_thread_bytes / (1024 * 1024),\n1105\t                num_threads,\n1106\t            );\n1107\t            (0..num_threads)\n1108\t                .map(|_| round0::Round0ThreadBuffers {\n1109\t                    zc_intermediates: if max_zc_intermed > 0 {\n1110\t                        DeviceBuffer::with_capacity(max_zc_intermed)\n1111\t                    } else {\n1112\t                        DeviceBuffer::new()\n1113\t                    },\n1114\t                    zc_temp_sums: if max_zc_temp_sums > 0 {\n1115\t                        DeviceBuffer::with_capacity(max_zc_temp_sums)\n1116\t                    } else {\n1117\t                        DeviceBuffer::new()\n1118\t                    },\n1119\t                    logup_intermediates: if max_logup_intermed > 0 {\n1120\t                        DeviceBuffer::with_capacity(max_logup_intermed)\n1121\t                    } else {\n1122\t                        DeviceBuffer::new()\n1123\t                    },\n1124\t                    logup_temp_sums: if max_logup_temp_sums > 0 {\n1125\t                        DeviceBuffer::with_capacity(max_logup_temp_sums)\n1126\t                    } else {\n1127\t                        DeviceBuffer::new()\n1128\t                    },\n1129\t                })\n1130\t                .collect()\n1131\t        };\n1132\t\n1133\t        let results: Vec<Round0AirResult> = if num_threads <= 1 {\n1134\t            let mut bufs = thread_buffers.into_iter().next().unwrap();\n1135\t            work_items\n1136\t                .iter()\n1137\t                .map(|w| process_air_round0(w, &mut bufs))\n1138\t                .collect::<Result<Vec<_>, _>>()?\n1139\t        } else {\n1140\t            // Interleaved (round-robin) assignment on the height-sorted list.\n1141\t            // Work items are already sorted by descending height. Round-robin\n1142\t            // distributes them so each thread gets a balanced mix of large and\n1143\t            // small AIRs (thread 0 gets items 0, N, 2N, ...; thread 1 gets\n1144\t            // items 1, N+1, 2N+1, ...). This balances both per-AIR fixed\n1145\t            // overhead (kernel launches, D2H copies) and height-proportional\n1146\t            // GPU kernel time without needing a calibrated cost model.\n1147\t            let mut thread_items: Vec<Vec<usize>> =\n1148\t                (0..num_threads).map(|_| Vec::new()).collect();\n1149\t            for (item_idx, _) in work_items.iter().enumerate() {\n1150\t                thread_items[item_idx % num_threads].push(item_idx);\n1151\t            }\n1152\t\n1153\t            std::thread::scope(|s| {\n1154\t                let handles: Vec<_> = thread_buffers\n1155\t                    .into_iter()\n1156\t                    .zip(thread_items.into_iter())\n1157\t                    .enumerate()\n1158\t                    .map(|(thread_id, (mut bufs, indices))| {\n1159\t                        let items = &work_items;\n1160\t                        s.spawn(move || -> Result<Vec<Round0AirResult>, LogupZerocheckError> {\n1161\t                            let t0 = std::time::Instant::now();\n1162\t                            let results: Vec<_> = indices\n1163\t                                .iter()\n1164\t                                .map(|&idx| process_air_round0(&items[idx], &mut bufs))\n1165\t                                .collect::<Result<_, _>>()?;\n1166\t                            tracing::debug!(thread_id, elapsed_ms = t0.elapsed().as_millis(), num_airs = indices.len(), \"round0 thread done\");\n1167\t                            Ok(results)\n1168\t                        })\n1169\t                    })\n1170\t                    .collect();\n1171\t                let mut all_results = Vec::with_capacity(work_items.len());\n1172\t                for handle in handles {\n1173\t                    all_results.extend(handle.join().unwrap()?);\n1174\t                }\n1175\t                Ok::<_, LogupZerocheckError>(all_results)\n1176\t            })?\n1177\t        };\n1178\t\n1179\t        // Phase 3: Scatter results into batch_sp_poly (main thread, pure CPU)\n1180\t        for result in results {\n1181\t            if let Some(poly) = result.zerocheck_poly {\n1182\t                batch_sp_poly[2 * num_present_airs + result.trace_idx] = poly;\n1183\t            }\n1184\t            if let Some(poly) = result.logup_numer_poly {\n1185\t                batch_sp_poly[2 * result.trace_idx] = poly;\n1186\t            }\n1187\t            if let Some(poly) = result.logup_denom_poly {\n1188\t                batch_sp_poly[2 * result.trace_idx + 1] = poly;\n1189\t            }\n1190\t        }\n1191\t        self.mem\n1192\t            .emit_metrics_with_label(\"prover.batch_constraints.round0\");\n1193\t        Ok(batch_sp_poly)\n1194\t    }"}]},"parent_tool_use_id":"toolu_01GNRJrb1ZmSyjfXvXwDQXiJ","session_id":"f93534bb-5de3-4083-9e85-ad533ac466ab","uuid":"3815a1c9-c1fe-4995-8468-74a246f26882","timestamp":"2026-04-14T04:24:35.812Z"}
