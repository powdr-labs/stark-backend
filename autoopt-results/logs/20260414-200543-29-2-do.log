lHeader hdr = actx.d_headers[m];\n            FpExt product(Fp::one());\n            for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n                PackedVar var = actx.d_variables[hdr.var_offset + v];\n                product *= eval_variable(var, row, actx.eval_ctx, height);\n            }\n            sum += product * actx.d_lambda_combinations[m];\n        }\n        sum *= actx.d_eq_xi[y_int];\n    }\n\n    sum = sumcheck::warp_reduce_sum(sum);\n\n    if (lane == 0) {\n        output[output_offsets[warp_global] * num_x + x_int] = sum;\n    }\n}\n\n// 4 warps per block = 128 threads\nconstexpr uint32_t WARP_KERNEL_WARPS_PER_BLOCK = 4;\nconstexpr uint32_t WARP_KERNEL_BLOCK_SIZE = WARP_KERNEL_WARPS_PER_BLOCK * WARP_SIZE;\n\nextern \"C\" int _warp_zerocheck_monomial_batched(\n    FpExt *output,\n    const MonomialAirCtx *air_ctxs,\n    const uint32_t *trace_ids,\n    const uint32_t *output_offsets,\n    uint32_t num_traces,\n    uint32_t num_x\n) {\n    if (num_traces == 0) return 0;\n\n    uint32_t num_blocks = div_ceil(num_traces, WARP_KERNEL_WARPS_PER_BLOCK);\n    dim3 grid(num_blocks, num_x);\n    dim3 block(WARP_KERNEL_BLOCK_SIZE);\n\n    warp_zerocheck_monomial_kernel<<<grid, block>>>(\n        output, air_ctxs, trace_ids, output_offsets, num_traces\n    );\n    return CHECK_KERNEL();\n}\n\n// Warp-per-trace logup monomial evaluation.\n// Each warp evaluates both numerator and denominator monomials for one trace.\n__global__ void warp_logup_monomial_kernel(\n    FracExt *__restrict__ output,\n    const LogupMonomialCommonCtx *__restrict__ common_ctxs,\n    const LogupMonomialCtx *__restrict__ numer_ctxs,\n    const LogupMonomialCtx *__restrict__ denom_ctxs,\n    const uint32_t *__restrict__ trace_ids,\n    const uint32_t *__restrict__ output_offsets,\n    uint32_t num_traces\n) {\n    constexpr uint32_t WARP = 32;\n    uint32_t warp_global = (blockIdx.x * blockDim.x + threadIdx.x) / WARP;\n    uint32_t lane = threadIdx.x % WARP;\n    uint32_t num_x = gridDim.y;\n    uint32_t x_int = blockIdx.y;\n\n    if (warp_global >= num_traces) return;\n\n    uint32_t trace_id = trace_ids[warp_global];\n    LogupMonomialCommonCtx common = common_ctxs[trace_id];\n    LogupMonomialCtx numer = numer_ctxs[trace_id];\n    LogupMonomialCtx denom = denom_ctxs[trace_id];\n\n    FpExt numer_sum(Fp::zero());\n    FpExt denom_sum(Fp::zero());\n\n    if (lane < common.num_y) {\n        uint32_t y_int = lane;\n        uint32_t height = num_x * common.num_y;\n        uint32_t row = x_int * common.num_y + y_int;\n\n        // Numerator monomials\n        for (uint32_t m = 0; m < numer.num_monomials; ++m) {\n            MonomialHeader hdr = numer.d_headers[m];\n            FpExt monomial = numer.d_combinations[m];\n            for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n                PackedVar var = numer.d_variables[hdr.var_offset + v];\n                monomial *= eval_variable(var, row, common.eval_ctx, height);\n            }\n            numer_sum += monomial;\n        }\n        numer_sum *= common.d_eq_xi[y_int];\n\n        // Denominator monomials\n        for (uint32_t m = 0; m < denom.num_monomials; ++m) {\n            MonomialHeader hdr = denom.d_headers[m];\n            FpExt monomial = denom.d_combinations[m];\n            for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n                PackedVar var = denom.d_variables[hdr.var_offset + v];\n                monomial *= eval_variable(var, row, common.eval_ctx, height);\n            }\n            denom_sum += monomial;\n        }\n        // Add bus_term contribution (once per y_int)\n        denom_sum += common.bus_term_sum;\n        denom_sum *= common.d_eq_xi[y_int];\n    }\n\n    numer_sum = sumcheck::warp_reduce_sum(numer_sum);\n    denom_sum = sumcheck::warp_reduce_sum(denom_sum);\n\n    if (lane == 0) {\n        uint32_t out_pos = output_offsets[warp_global];\n        output[out_pos * num_x + x_int].p = numer_sum;\n        output[out_pos * num_x + x_int].q = denom_sum;\n    }\n}\n\nextern \"C\" int _warp_logup_monomial_batched(\n    FracExt *output,\n    const LogupMonomialCommonCtx *common_ctxs,\n    const LogupMonomialCtx *numer_ctxs,\n    const LogupMonomialCtx *denom_ctxs,\n    const uint32_t *trace_ids,\n    const uint32_t *output_offsets,\n    uint32_t num_traces,\n    uint32_t num_x\n) {\n    if (num_traces == 0) return 0;\n\n    uint32_t num_blocks = div_ceil(num_traces, WARP_KERNEL_WARPS_PER_BLOCK);\n    dim3 grid(num_blocks, num_x);\n    dim3 block(WARP_KERNEL_BLOCK_SIZE);\n\n    warp_logup_monomial_kernel<<<grid, block>>>(\n        output, common_ctxs, numer_ctxs, denom_ctxs,\n        trace_ids, output_offsets, num_traces\n    );\n    return CHECK_KERNEL();\n}\n\n// Scatter-copy: copies blocks of `block_size` FpExt elements from contiguous src\n// to scattered positions in dst. Used to merge block-path output into the shared\n// output buffer.\n__global__ void scatter_fpext_blocks_kernel(\n    FpExt *__restrict__ dst,\n    const FpExt *__restrict__ src,\n    const uint32_t *__restrict__ dst_offsets,\n    uint32_t num_items,\n    uint32_t block_size\n) {\n    uint32_t item = blockIdx.x;\n    uint32_t elem = blockIdx.y * blockDim.x + threadIdx.x;\n    if (item >= num_items || elem >= block_size) return;\n    dst[dst_offsets[item] * block_size + elem] = src[item * block_size + elem];\n}\n\nextern \"C\" int _scatter_fpext_blocks(\n    FpExt *dst,\n    const FpExt *src,\n    const uint32_t *dst_offsets,\n    uint32_t num_items,\n    uint32_t block_size\n) {\n    if (num_items == 0 || block_size == 0) return 0;\n\n    // Each block handles one item's worth of elements\n    uint32_t threads = min(block_size, 256u);\n    uint32_t y_blocks = div_ceil(block_size, threads);\n    dim3 grid(num_items, y_blocks);\n    dim3 blk(threads);\n\n    scatter_fpext_blocks_kernel<<<grid, blk>>>(\n        dst, src, dst_offsets, num_items, block_size\n    );\n    return CHECK_KERNEL();\n}\n\n} // namespace logup_zerocheck_mle","originalFile":"#include \"eval_ctx.cuh\"\n#include \"frac_ext.cuh\"\n#include \"launcher.cuh\"\n#include \"monomial.cuh\"\n#include \"sumcheck.cuh\"\n\n#include <cassert>\n#include <cstdint>\n\nnamespace logup_zerocheck_mle {\n\n__device__ __forceinline__ FpExt\neval_variable(PackedVar var, uint32_t row, const EvalCoreCtx &ctx, uint32_t height) {\n    uint8_t entry_type = var.entry_type();\n    uint8_t offset = var.offset();\n\n    switch (entry_type) {\n    case 1: { // MAIN\n        auto main_ptr = ctx.d_main[var.part_index()];\n        const auto stride = height * main_ptr.air_width;\n        const FpExt *__restrict__ matrix = main_ptr.data + stride * offset;\n        const FpExt *__restrict__ column = matrix + height * var.col_index();\n        return column[row];\n    }\n    case 0: { // PREPROCESSED\n        const auto stride = height * ctx.d_preprocessed.air_width;\n        const FpExt *__restrict__ matrix = ctx.d_preprocessed.data + stride * offset;\n        const FpExt *__restrict__ column = matrix + height * var.col_index();\n        return column[row];\n    }\n    case 3: // PUBLIC\n        return FpExt(ctx.d_public[var.col_index()]);\n    case 8: // IS_FIRST\n        return ctx.d_selectors[row];\n    case 9: // IS_LAST\n        return ctx.d_selectors[2 * height + row];\n    case 10: // IS_TRANSITION\n        return ctx.d_selectors[height + row];\n    default:\n        assert(false);\n    }\n    return FpExt(Fp::zero());\n}\n\n// For batched monomial evaluation across multiple AIRs\nstruct MonomialAirCtx {\n    const MonomialHeader *__restrict__ d_headers;\n    const PackedVar *__restrict__ d_variables;\n    const FpExt *__restrict__ d_lambda_combinations; // Precomputed per-monomial\n    uint32_t num_monomials;\n    EvalCoreCtx eval_ctx;\n    const FpExt *__restrict__ d_eq_xi;\n    uint32_t num_y;\n};\n\n// ============================================================================\n// PRECOMPUTE LAMBDA COMBINATIONS (once per AIR after lambda is sampled)\n// ============================================================================\n\n__global__ void precompute_lambda_combinations_kernel(\n    FpExt *__restrict__ out,\n    const MonomialHeader *__restrict__ headers,\n    const LambdaTerm *__restrict__ lambda_terms,\n    const FpExt *__restrict__ lambda_pows,\n    uint32_t num_monomials\n) {\n    uint32_t m = blockIdx.x * blockDim.x + threadIdx.x;\n    if (m >= num_monomials)\n        return;\n\n    MonomialHeader hdr = headers[m];\n    FpExt sum(Fp::zero());\n    for (uint16_t l = 0; l < hdr.num_terms; ++l) {\n        LambdaTerm term = lambda_terms[hdr.term_offset + l];\n        sum += lambda_pows[term.constraint_idx] * term.coefficient;\n    }\n    out[m] = sum;\n}\n\nextern \"C\" int _precompute_lambda_combinations(\n    FpExt *out,\n    const MonomialHeader *headers,\n    const LambdaTerm *lambda_terms,\n    const FpExt *lambda_pows,\n    uint32_t num_monomials\n) {\n    if (num_monomials == 0)\n        return 0;\n\n    constexpr uint32_t threads = 256;\n    uint32_t blocks = div_ceil(num_monomials, threads);\n    precompute_lambda_combinations_kernel<<<blocks, threads>>>(\n        out, headers, lambda_terms, lambda_pows, num_monomials\n    );\n    return CHECK_KERNEL();\n}\n\n// ============================================================================\n// BATCHED KERNEL (multiple AIRs in single launch)\n// ============================================================================\n\n__global__ void zerocheck_monomial_kernel(\n    FpExt *__restrict__ tmp_sums,\n    const BlockCtx *__restrict__ block_ctxs,\n    const MonomialAirCtx *__restrict__ air_ctxs,\n    uint32_t threads_per_block\n) {\n    extern __shared__ char smem[];\n    FpExt *shared = (FpExt *)smem;\n\n    BlockCtx bctx = block_ctxs[blockIdx.x];\n    MonomialAirCtx actx = air_ctxs[bctx.air_idx];\n\n    uint32_t num_x = gridDim.y;\n    uint32_t x_int = blockIdx.y;\n\n    // Decode y_int and mono_block from local_block_idx_x\n    uint32_t mono_blocks = (actx.num_monomials + threads_per_block - 1) / threads_per_block;\n    uint32_t y_int = bctx.local_block_idx_x / mono_blocks;\n    uint32_t mono_block = bctx.local_block_idx_x % mono_blocks;\n\n    uint32_t height = num_x * actx.num_y;\n    uint32_t row = x_int * actx.num_y + y_int;\n\n    FpExt sum(Fp::zero());\n\n    // Each thread evaluates one monomial\n    uint32_t m = mono_block * threads_per_block + threadIdx.x;\n    if (m < actx.num_monomials) {\n        MonomialHeader hdr = actx.d_headers[m];\n\n        // Evaluate product of variables\n        FpExt product(Fp::one());\n        for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n            PackedVar var = actx.d_variables[hdr.var_offset + v];\n            product *= eval_variable(var, row, actx.eval_ctx, height);\n        }\n\n        sum = product * actx.d_lambda_combinations[m];\n    }\n\n    // Block reduction\n    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n\n    if (threadIdx.x == 0) {\n        // Apply eq_xi here (eliminates separate phase 2)\n        // eq_xi is eq(xi, y) which only depends on y, not x\n        reduced *= actx.d_eq_xi[y_int];\n        tmp_sums[blockIdx.x * num_x + x_int] = reduced;\n    }\n}\n\nextern \"C\" int _zerocheck_monomial_batched(\n    FpExt *tmp_sums,\n    FpExt *output,\n    const BlockCtx *block_ctxs,\n    const MonomialAirCtx *air_ctxs,\n    const uint32_t *air_block_offsets,\n    uint32_t num_blocks,\n    uint32_t num_x,\n    uint32_t num_airs,\n    uint32_t threads_per_block\n) {\n    if (num_blocks == 0) {\n        return 0;\n    }\n\n    dim3 grid(num_blocks, num_x);\n    dim3 block(threads_per_block);\n    size_t shmem = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n\n    // Phase 1: Main monomial evaluation kernel\n    zerocheck_monomial_kernel<<<grid, block, shmem>>>(\n        tmp_sums, block_ctxs, air_ctxs, threads_per_block\n    );\n    int err = CHECK_KERNEL();\n    if (err != 0)\n        return err;\n\n    // Phase 2: Batched reduction for all AIRs in single launch\n    // Grid: (num_airs, num_x) - each block handles one (air, x) pair\n    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n\n    dim3 reduce_grid(num_airs, num_x);\n    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n        tmp_sums, output, air_block_offsets, num_x\n    );\n\n    return CHECK_KERNEL();\n}\n\n// ============================================================================\n// PAR-Y KERNEL (parallelizes over y_int, tiles monomials)\n// ============================================================================\n\n__global__ void zerocheck_monomial_par_y_kernel(\n    FpExt *__restrict__ tmp_sums,\n    const BlockCtx *__restrict__ block_ctxs,\n    const MonomialAirCtx *__restrict__ air_ctxs,\n    uint32_t threads_per_block,\n    uint32_t chunk_size // monomials per mono_chunk\n) {\n    extern __shared__ char smem[];\n    FpExt *shared = (FpExt *)smem;\n\n    BlockCtx bctx = block_ctxs[blockIdx.x];\n    MonomialAirCtx actx = air_ctxs[bctx.air_idx];\n\n    uint32_t num_x = gridDim.y;\n    uint32_t x_int = blockIdx.y;\n\n    // Decode y_block and mono_chunk from local_block_idx_x\n    // Encoding: local_block_idx_x = y_block * air_mono_chunks + mono_chunk\n    uint32_t air_mono_chunks = (actx.num_monomials + chunk_size - 1) / chunk_size;\n    uint32_t y_block = bctx.local_block_idx_x / air_mono_chunks;\n    uint32_t mono_chunk = bctx.local_block_idx_x % air_mono_chunks;\n\n    // Decode y_int from thread position within y_block\n    uint32_t y_int = threadIdx.x + y_block * threads_per_block;\n    bool active = (y_int < actx.num_y);\n\n    uint32_t height = num_x * actx.num_y;\n    uint32_t row = x_int * actx.num_y + y_int;\n\n    // Contiguous chunk of monomials for this mono_chunk\n    uint32_t mono_start = mono_chunk * chunk_size;\n    uint32_t mono_end = min(mono_start + chunk_size, actx.num_monomials);\n\n    FpExt sum(Fp::zero());\n    if (active) {\n        // Each thread loops over its chunk of monomials\n        for (uint32_t m = mono_start; m < mono_end; ++m) {\n            MonomialHeader hdr = actx.d_headers[m];\n\n            FpExt product(Fp::one());\n            for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n                PackedVar var = actx.d_variables[hdr.var_offset + v];\n                product *= eval_variable(var, row, actx.eval_ctx, height);\n            }\n\n            sum += product * actx.d_lambda_combinations[m];\n        }\n\n        // Apply eq_xi\n        sum *= actx.d_eq_xi[y_int];\n    }\n\n    // Block reduction sums across y_int values in this block\n    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n\n    if (threadIdx.x == 0) {\n        tmp_sums[blockIdx.x * num_x + x_int] = reduced;\n    }\n}\n\nextern \"C\" int _zerocheck_monomial_par_y_batched(\n    FpExt *tmp_sums,\n    FpExt *output,\n    const BlockCtx *block_ctxs,\n    const MonomialAirCtx *air_ctxs,\n    const uint32_t *air_block_offsets,\n    uint32_t num_blocks,\n    uint32_t num_x,\n    uint32_t num_airs,\n    uint32_t chunk_size,\n    uint32_t threads_per_block\n) {\n    if (num_blocks == 0) {\n        return 0;\n    }\n\n    dim3 grid(num_blocks, num_x);\n    dim3 block(threads_per_block);\n    size_t shmem = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n\n    // Phase 1: Main par-y kernel\n    zerocheck_monomial_par_y_kernel<<<grid, block, shmem>>>(\n        tmp_sums, block_ctxs, air_ctxs, threads_per_block, chunk_size\n    );\n    int err = CHECK_KERNEL();\n    if (err != 0)\n        return err;\n\n    // Phase 2: Batched reduction for all AIRs in single launch\n    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n\n    dim3 reduce_grid(num_airs, num_x);\n    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n        tmp_sums, output, air_block_offsets, num_x\n    );\n\n    return CHECK_KERNEL();\n}\n\n// ============================================================================\n// LOGUP MONOMIAL KERNELS\n// ============================================================================\n\ntemplate <bool IS_DENOM>\n__global__ void precompute_logup_combinations_kernel(\n    FpExt *__restrict__ out,\n    const MonomialHeader *__restrict__ headers,\n    const InteractionMonomialTerm *__restrict__ terms,\n    const FpExt *__restrict__ beta_pows,\n    const FpExt *__restrict__ eq_3bs,\n    uint32_t num_monomials\n) {\n    uint32_t m = blockIdx.x * blockDim.x + threadIdx.x;\n    if (m >= num_monomials)\n        return;\n\n    MonomialHeader hdr = headers[m];\n    FpExt sum(Fp::zero());\n    for (uint16_t t = 0; t < hdr.num_terms; ++t) {\n        InteractionMonomialTerm term = terms[hdr.term_offset + t];\n        FpExt value = eq_3bs[term.interaction_idx] * term.coefficient;\n        if constexpr (IS_DENOM) {\n            value *= beta_pows[term.field_idx];\n        }\n        sum += value;\n    }\n    out[m] = sum;\n}\n\nextern \"C\" int _precompute_logup_numer_combinations(\n    FpExt *out,\n    const MonomialHeader *headers,\n    const InteractionMonomialTerm *terms,\n    const FpExt *eq_3bs,\n    uint32_t num_monomials\n) {\n    if (num_monomials == 0)\n        return 0;\n\n    constexpr uint32_t threads = 256;\n    uint32_t blocks = div_ceil(num_monomials, threads);\n    precompute_logup_combinations_kernel<false><<<blocks, threads>>>(\n        out, headers, terms, nullptr, eq_3bs, num_monomials\n    );\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _precompute_logup_denom_combinations(\n    FpExt *out,\n    const MonomialHeader *headers,\n    const InteractionMonomialTerm *terms,\n    const FpExt *beta_pows,\n    const FpExt *eq_3bs,\n    uint32_t num_monomials\n) {\n    if (num_monomials == 0)\n        return 0;\n\n    constexpr uint32_t threads = 256;\n    uint32_t blocks = div_ceil(num_monomials, threads);\n    precompute_logup_combinations_kernel<true><<<blocks, threads>>>(\n        out, headers, terms, beta_pows, eq_3bs, num_monomials\n    );\n    return CHECK_KERNEL();\n}\n\n// AIR context for logup monomial MLE evaluation\n// Note: These structures match the Rust LogupMonomial*Ctx types\nstruct LogupMonomialCommonCtx {\n    EvalCoreCtx eval_ctx;\n    const FpExt *__restrict__ d_eq_xi;\n    FpExt bus_term_sum; // Precomputed sum_i(beta[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n    uint32_t num_y;\n    uint32_t mono_blocks;\n};\n\nstruct LogupMonomialCtx {\n    const MonomialHeader *__restrict__ d_headers;\n    const PackedVar *__restrict__ d_variables;\n    const FpExt *__restrict__ d_combinations;\n    uint32_t num_monomials;\n};\n\n// Logup monomial MLE kernel - evaluates numerator or denominator monomials per block.\n// This produces FracExt output compatible with the standard reduction pattern.\n//\n// Block assignment: one block per (y_int, mono_block).\n// Each block evaluates a chunk of monomials across threads.\n//\n// Template parameter IS_DENOM:\n//   - false: numerator kernel, writes to tmp_sums[...].p\n//   - true: denominator kernel, writes to tmp_sums[...].q and adds bus_term_sum when mono_block == 0\ntemplate <bool IS_DENOM>\n__global__ void logup_monomial_kernel(\n    FracExt *__restrict__ tmp_sums,\n    const BlockCtx *__restrict__ block_ctxs,\n    const LogupMonomialCommonCtx *__restrict__ common_ctxs,\n    const LogupMonomialCtx *__restrict__ ctxs\n) {\n    extern __shared__ char smem[];\n    FpExt *shared = (FpExt *)smem;\n\n    BlockCtx bctx = block_ctxs[blockIdx.x];\n    LogupMonomialCommonCtx common_ctx = common_ctxs[bctx.air_idx];\n    LogupMonomialCtx ctx = ctxs[bctx.air_idx];\n\n    uint32_t num_x = gridDim.y;\n    uint32_t x_int = blockIdx.y;\n    uint32_t height = num_x * common_ctx.num_y;\n\n    uint32_t mono_blocks = common_ctx.mono_blocks;\n#ifdef CUDA_DEBUG\n    assert(mono_blocks > 0);\n#endif\n    uint32_t y_int = bctx.local_block_idx_x / mono_blocks;\n    uint32_t mono_block = bctx.local_block_idx_x % mono_blocks;\n    uint32_t row = x_int * common_ctx.num_y + y_int;\n    uint32_t m = mono_block * blockDim.x + threadIdx.x;\n\n    FpExt sum(Fp::zero());\n    if (y_int < common_ctx.num_y && m < ctx.num_monomials) {\n        MonomialHeader hdr = ctx.d_headers[m];\n        FpExt monomial = ctx.d_combinations[m];\n        for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n            PackedVar var = ctx.d_variables[hdr.var_offset + v];\n            monomial *= eval_variable(var, row, common_ctx.eval_ctx, height);\n        }\n        sum = monomial * common_ctx.d_eq_xi[y_int];\n    }\n\n    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n\n    if (threadIdx.x == 0) {\n        if constexpr (IS_DENOM) {\n            if (mono_block == 0 && y_int < common_ctx.num_y) {\n                reduced += common_ctx.bus_term_sum * common_ctx.d_eq_xi[y_int];\n            }\n            tmp_sums[blockIdx.x * num_x + x_int].q = reduced;\n        } else {\n            tmp_sums[blockIdx.x * num_x + x_int].p = reduced;\n        }\n    }\n}\n\nextern \"C\" int _logup_monomial_batched(\n    FracExt *tmp_sums,\n    FracExt *output,\n    const BlockCtx *block_ctxs,\n    const LogupMonomialCommonCtx *common_ctxs,\n    const LogupMonomialCtx *numer_ctxs,\n    const LogupMonomialCtx *denom_ctxs,\n    const uint32_t *air_block_offsets,\n    uint32_t num_blocks,\n    uint32_t num_x,\n    uint32_t num_airs,\n    uint32_t threads_per_block\n) {\n    if (num_blocks == 0)\n        return 0;\n\n    dim3 grid(num_blocks, num_x);\n    dim3 block(threads_per_block);\n    size_t shmem = div_ceil(threads_per_block, WARP_SIZE) * sizeof(FpExt);\n\n    // Phase 1: Evaluate numerator monomials\n    logup_monomial_kernel<false><<<grid, block, shmem>>>(\n        tmp_sums, block_ctxs, common_ctxs, numer_ctxs\n    );\n    int err = CHECK_KERNEL();\n    if (err != 0)\n        return err;\n\n    // Phase 1b: Evaluate denominator monomials\n    logup_monomial_kernel<true><<<grid, block, shmem>>>(\n        tmp_sums, block_ctxs, common_ctxs, denom_ctxs\n    );\n    err = CHECK_KERNEL();\n    if (err != 0)\n        return err;\n\n    // Phase 2: Batched reduction\n    // FracExt = (FpExt, FpExt) so treat as 2 * num_x elements per AIR\n    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n\n    dim3 reduce_grid(num_airs, 2 * num_x);\n    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n        reinterpret_cast<FpExt *>(tmp_sums),\n        reinterpret_cast<FpExt *>(output),\n        air_block_offsets,\n        2 * num_x\n    );\n\n    return CHECK_KERNEL();\n}\n\n} // namespace logup_zerocheck_mle\n","structuredPatch":[{"oldStart":494,"oldLines":4,"newStart":494,"newLines":206,"lines":["     return CHECK_KERNEL();"," }"," ","+// ============================================================================","+// WARP-PER-TRACE KERNELS (for small traces: num_y <= 32, num_monomials <= 32)","+// ============================================================================","+","+// Each warp handles one trace. Thread lane = y_int.","+// Each thread loops over ALL monomials for its y-value, producing a per-trace sum","+// via warp reduction. Output is scattered to output_offsets[warp_global].","+__global__ void warp_zerocheck_monomial_kernel(","+    FpExt *__restrict__ output,","+    const MonomialAirCtx *__restrict__ air_ctxs,","+    const uint32_t *__restrict__ trace_ids,","+    const uint32_t *__restrict__ output_offsets,","+    uint32_t num_traces","+) {","+    constexpr uint32_t WARP = 32;","+    uint32_t warp_global = (blockIdx.x * blockDim.x + threadIdx.x) / WARP;","+    uint32_t lane = threadIdx.x % WARP;","+    uint32_t num_x = gridDim.y;","+    uint32_t x_int = blockIdx.y;","+","+    if (warp_global >= num_traces) return;","+","+    MonomialAirCtx actx = air_ctxs[trace_ids[warp_global]];","+","+    FpExt sum(Fp::zero());","+    if (lane < actx.num_y) {","+        uint32_t y_int = lane;","+        uint32_t height = num_x * actx.num_y;","+        uint32_t row = x_int * actx.num_y + y_int;","+","+        for (uint32_t m = 0; m < actx.num_monomials; ++m) {","+            MonomialHeader hdr = actx.d_headers[m];","+            FpExt product(Fp::one());","+            for (uint16_t v = 0; v < hdr.num_vars; ++v) {","+                PackedVar var = actx.d_variables[hdr.var_offset + v];","+                product *= eval_variable(var, row, actx.eval_ctx, height);","+            }","+            sum += product * actx.d_lambda_combinations[m];","+        }","+        sum *= actx.d_eq_xi[y_int];","+    }","+","+    sum = sumcheck::warp_reduce_sum(sum);","+","+    if (lane == 0) {","+        output[output_offsets[warp_global] * num_x + x_int] = sum;","+    }","+}","+","+// 4 warps per block = 128 threads","+constexpr uint32_t WARP_KERNEL_WARPS_PER_BLOCK = 4;","+constexpr uint32_t WARP_KERNEL_BLOCK_SIZE = WARP_KERNEL_WARPS_PER_BLOCK * WARP_SIZE;","+","+extern \"C\" int _warp_zerocheck_monomial_batched(","+    FpExt *output,","+    const MonomialAirCtx *air_ctxs,","+    const uint32_t *trace_ids,","+    const uint32_t *output_offsets,","+    uint32_t num_traces,","+    uint32_t num_x","+) {","+    if (num_traces == 0) return 0;","+","+    uint32_t num_blocks = div_ceil(num_traces, WARP_KERNEL_WARPS_PER_BLOCK);","+    dim3 grid(num_blocks, num_x);","+    dim3 block(WARP_KERNEL_BLOCK_SIZE);","+","+    warp_zerocheck_monomial_kernel<<<grid, block>>>(","+        output, air_ctxs, trace_ids, output_offsets, num_traces","+    );","+    return CHECK_KERNEL();","+}","+","+// Warp-per-trace logup monomial evaluation.","+// Each warp evaluates both numerator and denominator monomials for one trace.","+__global__ void warp_logup_monomial_kernel(","+    FracExt *__restrict__ output,","+    const LogupMonomialCommonCtx *__restrict__ common_ctxs,","+    const LogupMonomialCtx *__restrict__ numer_ctxs,","+    const LogupMonomialCtx *__restrict__ denom_ctxs,","+    const uint32_t *__restrict__ trace_ids,","+    const uint32_t *__restrict__ output_offsets,","+    uint32_t num_traces","+) {","+    constexpr uint32_t WARP = 32;","+    uint32_t warp_global = (blockIdx.x * blockDim.x + threadIdx.x) / WARP;","+    uint32_t lane = threadIdx.x % WARP;","+    uint32_t num_x = gridDim.y;","+    uint32_t x_int = blockIdx.y;","+","+    if (warp_global >= num_traces) return;","+","+    uint32_t trace_id = trace_ids[warp_global];","+    LogupMonomialCommonCtx common = common_ctxs[trace_id];","+    LogupMonomialCtx numer = numer_ctxs[trace_id];","+    LogupMonomialCtx denom = denom_ctxs[trace_id];","+","+    FpExt numer_sum(Fp::zero());","+    FpExt denom_sum(Fp::zero());","+","+    if (lane < common.num_y) {","+        uint32_t y_int = lane;","+        uint32_t height = num_x * common.num_y;","+        uint32_t row = x_int * common.num_y + y_int;","+","+        // Numerator monomials","+        for (uint32_t m = 0; m < numer.num_monomials; ++m) {","+            MonomialHeader hdr = numer.d_headers[m];","+            FpExt monomial = numer.d_combinations[m];","+            for (uint16_t v = 0; v < hdr.num_vars; ++v) {","+                PackedVar var = numer.d_variables[hdr.var_offset + v];","+                monomial *= eval_variable(var, row, common.eval_ctx, height);","+            }","+            numer_sum += monomial;","+        }","+        numer_sum *= common.d_eq_xi[y_int];","+","+        // Denominator monomials","+        for (uint32_t m = 0; m < denom.num_monomials; ++m) {","+            MonomialHeader hdr = denom.d_headers[m];","+            FpExt monomial = denom.d_combinations[m];","+            for (uint16_t v = 0; v < hdr.num_vars; ++v) {","+                PackedVar var = denom.d_variables[hdr.var_offset + v];","+                monomial *= eval_variable(var, row, common.eval_ctx, height);","+            }","+            denom_sum += monomial;","+        }","+        // Add bus_term contribution (once per y_int)","+        denom_sum += common.bus_term_sum;","+        denom_sum *= common.d_eq_xi[y_int];","+    }","+","+    numer_sum = sumcheck::warp_reduce_sum(numer_sum);","+    denom_sum = sumcheck::warp_reduce_sum(denom_sum);","+","+    if (lane == 0) {","+        uint32_t out_pos = output_offsets[warp_global];","+        output[out_pos * num_x + x_int].p = numer_sum;","+        output[out_pos * num_x + x_int].q = denom_sum;","+    }","+}","+","+extern \"C\" int _warp_logup_monomial_batched(","+    FracExt *output,","+    const LogupMonomialCommonCtx *common_ctxs,","+    const LogupMonomialCtx *numer_ctxs,","+    const LogupMonomialCtx *denom_ctxs,","+    const uint32_t *trace_ids,","+    const uint32_t *output_offsets,","+    uint32_t num_traces,","+    uint32_t num_x","+) {","+    if (num_traces == 0) return 0;","+","+    uint32_t num_blocks = div_ceil(num_traces, WARP_KERNEL_WARPS_PER_BLOCK);","+    dim3 grid(num_blocks, num_x);","+    dim3 block(WARP_KERNEL_BLOCK_SIZE);","+","+    warp_logup_monomial_kernel<<<grid, block>>>(","+        output, common_ctxs, numer_ctxs, denom_ctxs,","+        trace_ids, output_offsets, num_traces","+    );","+    return CHECK_KERNEL();","+}","+","+// Scatter-copy: copies blocks of `block_size` FpExt elements from contiguous src","+// to scattered positions in dst. Used to merge block-path output into the shared","+// output buffer.","+__global__ void scatter_fpext_blocks_kernel(","+    FpExt *__restrict__ dst,","+    const FpExt *__restrict__ src,","+    const uint32_t *__restrict__ dst_offsets,","+    uint32_t num_items,","+    uint32_t block_size","+) {","+    uint32_t item = blockIdx.x;","+    uint32_t elem = blockIdx.y * blockDim.x + threadIdx.x;","+    if (item >= num_items || elem >= block_size) return;","+    dst[dst_offsets[item] * block_size + elem] = src[item * block_size + elem];","+}","+","+extern \"C\" int _scatter_fpext_blocks(","+    FpExt *dst,","+    const FpExt *src,","+    const uint32_t *dst_offsets,","+    uint32_t num_items,","+    uint32_t block_size","+) {","+    if (num_items == 0 || block_size == 0) return 0;","+","+    // Each block handles one item's worth of elements","+    uint32_t threads = min(block_size, 256u);","+    uint32_t y_blocks = div_ceil(block_size, threads);","+    dim3 grid(num_items, y_blocks);","+    dim3 blk(threads);","+","+    scatter_fpext_blocks_kernel<<<grid, blk>>>(","+        dst, src, dst_offsets, num_items, block_size","+    );","+    return CHECK_KERNEL();","+}","+"," } // namespace logup_zerocheck_mle"]}],"userModified":false,"replaceAll":false}}
