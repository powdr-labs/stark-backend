\n709\t    eq_xi: &SqrtEqLayers,\n710\t    layer: &mut DeviceBuffer<Frac<EF>>,\n711\t    num_x: usize,\n712\t    lambda: EF,\n713\t    out_device: &mut DeviceBuffer<EF>,\n714\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n715\t) -> Result<(), CudaError> {\n716\t    let low_n = eq_xi.low_n();\n717\t    let high_n = eq_xi.high_n();\n718\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n719\t    #[cfg(debug_assertions)]\n720\t    {\n721\t        let len = tmp_block_sums.len();\n722\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n723\t        assert!(\n724\t            len >= required as usize,\n725\t            \"tmp_block_sums len={len} < required={required}\"\n726\t        );\n727\t        assert!(layer.len() >= 2 * num_x, \"layer too small for pq_size\");\n728\t    }\n729\t    CudaError::from_result(_frac_compute_round_and_revert(\n730\t        eq_xi.low.get_ptr(low_n),\n731\t        eq_xi.high.get_ptr(high_n),\n732\t        layer.as_mut_ptr(),\n733\t        num_x,\n734\t        1 << low_n,\n735\t        lambda,\n736\t        out_device.as_mut_ptr(),\n737\t        tmp_block_sums.as_mut_ptr(),\n738\t    ))\n739\t}\n740\t\n741\t/// Folds `Frac<EF>` buffer. Pairs (idx, idx+quarter) and (idx+half, idx+3*quarter),\n742\t/// writes results to dst[idx] and dst[idx+quarter]. Output size is `size / 2`.\n743\t/// Safe for src == dst (in-place) because each thread handles disjoint indices.\n744\tpub unsafe fn fold_ef_frac_columns(\n745\t    src: &DeviceBuffer<Frac<EF>>,\n746\t    dst: &mut DeviceBuffer<Frac<EF>>,\n747\t    size: usize,\n748\t    r: EF,\n749\t) -> Result<(), CudaError> {\n750\t    debug_assert!(src.len() >= size);\n751\t    debug_assert!(dst.len() >= size / 2);\n752\t    CudaError::from_result(_frac_fold_fpext_columns(\n753\t        src.as_ptr(),\n754\t        dst.as_mut_ptr(),\n755\t        size,\n756\t        r,\n757\t    ))\n758\t}\n759\t\n760\t/// In-place fold. See [`fold_ef_frac_columns`] for details.\n761\tpub unsafe fn fold_ef_frac_columns_inplace(\n762\t    buffer: &mut DeviceBuffer<Frac<EF>>,\n763\t    size: usize,\n764\t    r: EF,\n765\t) -> Result<(), CudaError> {\n766\t    debug_assert!(buffer.len() >= size);\n767\t    let ptr = buffer.as_mut_ptr();\n768\t    CudaError::from_result(_frac_fold_fpext_columns(ptr, ptr, size, r))\n769\t}\n770\t\n771\t/// Fused compute round + fold kernel.\n772\t///\n773\t/// Reads from pre-fold `src_pq_buffer` (size `src_pq_size`), performs fold-on-the-fly using\n774\t/// `r_prev`, computes s' polynomial evaluations (degree 2), and writes folded output to\n775\t/// `dst_pq_buffer` (size `src_pq_size/2`).\n776\t///\n777\t/// This fuses the fold operation into the next round's compute, eliminating one kernel launch per\n778\t/// inner round and reducing memory traffic.\n779\t///\n780\t/// The eq_xi layers should have max_n = log2(src_pq_size / 4) = log2(post-fold num_x).\n781\t#[allow(clippy::too_many_arguments)]\n782\tpub unsafe fn frac_compute_round_and_fold(\n783\t    eq_xi: &SqrtEqLayers,\n784\t    src_pq_buffer: &DeviceBuffer<Frac<EF>>,\n785\t    dst_pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n786\t    src_pq_size: usize,\n787\t    lambda: EF,\n788\t    r_prev: EF,\n789\t    out_device: &mut DeviceBuffer<EF>,\n790\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n791\t) -> Result<(), CudaError> {\n792\t    let low_n = eq_xi.low_n();\n793\t    let high_n = eq_xi.high_n();\n794\t    // Post-fold: num_x = src_pq_size / 4\n795\t    let num_x = src_pq_size >> 2;\n796\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n797\t    #[cfg(debug_assertions)]\n798\t    {\n799\t        assert!(src_pq_size > 2, \"src_pq_size must be > 2\");"}]},"parent_tool_use_id":"toolu_01FvhCB93jqt4LU48te2ZGuN","session_id":"997f7e33-9a1a-40a3-8498-75cdc1cf5ede","uuid":"8280af0e-af9e-42e5-b689-1ffe0b9ac52d","timestamp":"2026-04-14T21:24:08.542Z"}
