{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pmqa9GW4sthYCbSdVyTkfw","type":"tool_result","content":"1\t//! Batched monomial-based MLE evaluation for zerocheck and logup.\n2\t//!\n3\t//! This module provides batch evaluators for monomial evaluations across multiple AIRs,\n4\t//! enabling efficient GPU kernel launches that process multiple traces in a single launch.\n5\t\n6\tuse openvm_cuda_common::{\n7\t    copy::MemCopyH2D,\n8\t    d_buffer::DeviceBuffer,\n9\t    error::{CudaError, MemCopyError},\n10\t};\n11\tuse openvm_stark_backend::prover::{fractional_sumcheck_gkr::Frac, DeviceMultiStarkProvingKey};\n12\tuse p3_field::PrimeCharacteristicRing;\n13\tuse tracing::debug;\n14\t\n15\tuse crate::{\n16\t    cuda::logup_zerocheck::{\n17\t        logup_monomial_batched, precompute_lambda_combinations,\n18\t        precompute_logup_denom_combinations, precompute_logup_numer_combinations,\n19\t        zerocheck_monomial_batched, zerocheck_monomial_par_y_batched, BlockCtx, EvalCoreCtx,\n20\t        LogupMonomialCommonCtx, LogupMonomialCtx, MonomialAirCtx,\n21\t    },\n22\t    error::KernelError,\n23\t    gpu_backend::GenericGpuBackend,\n24\t    hash_scheme::GpuHashScheme,\n25\t    logup_zerocheck::batch_mle::TraceCtx,\n26\t    prelude::EF,\n27\t};\n28\t\n29\tconst THREADS_PER_BLOCK: u32 = 256;\n30\t\n31\t/// Returns true if the trace can use the monomial evaluation path.\n32\t///\n33\t/// A trace is eligible if it has constraints and the AIR has expanded monomials.\n34\tpub(crate) fn trace_has_monomials<HS: GpuHashScheme>(\n35\t    trace: &TraceCtx,\n36\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n37\t) -> bool {\n38\t    trace.has_constraints\n39\t        && pk.per_air[trace.air_idx]\n40\t            .other_data\n41\t            .zerocheck_monomials\n42\t            .as_ref()\n43\t            .map(|m| m.num_monomials > 0)\n44\t            .unwrap_or(false)\n45\t}\n46\t\n47\t/// Get the number of monomials for a trace. Returns 0 if the trace has no monomials.\n48\tpub(crate) fn get_num_monomials<HS: GpuHashScheme>(\n49\t    trace: &TraceCtx,\n50\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n51\t) -> u32 {\n52\t    pk.per_air[trace.air_idx]\n53\t        .other_data\n54\t        .zerocheck_monomials\n55\t        .as_ref()\n56\t        .map(|m| m.num_monomials)\n57\t        .unwrap_or(0)\n58\t}\n59\t\n60\t/// Get the rules_len for a trace's zerocheck DAG.\n61\tpub(crate) fn get_zerocheck_rules_len<HS: GpuHashScheme>(\n62\t    trace: &TraceCtx,\n63\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n64\t) -> usize {\n65\t    pk.per_air[trace.air_idx]\n66\t        .other_data\n67\t        .zerocheck_mle\n68\t        .inner\n69\t        .d_rules\n70\t        .len()\n71\t}\n72\t\n73\t/// Precompute lambda combinations for a single AIR's monomials.\n74\t///\n75\t/// Returns a buffer of length `num_monomials` where each element is\n76\t/// `sum_l(coefficient_l * lambda_pows[constraint_idx_l])` for that monomial.\n77\t///\n78\t/// The AIR must have nonempty monomials.\n79\tpub(crate) fn compute_lambda_combinations<HS: GpuHashScheme>(\n80\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n81\t    air_idx: usize,\n82\t    lambda_pows: &DeviceBuffer<EF>,\n83\t) -> Result<DeviceBuffer<EF>, CudaError> {\n84\t    let monomials = pk.per_air[air_idx]\n85\t        .other_data\n86\t        .zerocheck_monomials\n87\t        .as_ref()\n88\t        .expect(\"AIR must have monomials\");\n89\t    let mut buf = DeviceBuffer::<EF>::with_capacity(monomials.num_monomials as usize);\n90\t    unsafe {\n91\t        precompute_lambda_combinations(\n92\t            &mut buf,\n93\t            monomials.d_headers.as_ptr(),\n94\t            monomials.d_lambda_terms.as_ptr(),\n95\t            lambda_pows,\n96\t            monomials.num_monomials,\n97\t        )?;\n98\t    }\n99\t    Ok(buf)\n100\t}\n101\t\n102\t/// Batch evaluator for monomial-based zerocheck MLE evaluation.\n103\t///\n104\t/// Pre-builds GPU contexts for all traces, then evaluates in a single kernel launch.\n105\t///\n106\t/// The caller must filter traces using [`trace_has_monomials`] before constructing.\n107\t/// The batch must contain at least one trace.\n108\t///\n109\t/// The struct holds references to `TraceCtx` which guarantees the underlying\n110\t/// device buffers (including `main_ptrs_dev`) remain valid for the struct's lifetime.\n111\tpub(crate) struct ZerocheckMonomialBatch<'a> {\n112\t    traces: Vec<&'a TraceCtx>,\n113\t    block_ctxs: DeviceBuffer<BlockCtx>,\n114\t    air_ctxs: DeviceBuffer<MonomialAirCtx>,\n115\t    air_offsets: DeviceBuffer<u32>,\n116\t}\n117\t\n118\timpl<'a> ZerocheckMonomialBatch<'a> {\n119\t    /// Creates a new batch from an iterator of traces.\n120\t    ///\n121\t    /// `lambda_combinations` must contain one buffer per trace (in iteration order),\n122\t    /// each precomputed via [`compute_lambda_combinations`].\n123\t    ///\n124\t    /// # Panics\n125\t    ///\n126\t    /// Panics if `traces` is empty or if `lambda_combinations` length doesn't match.\n127\t    pub fn new<HS: GpuHashScheme>(\n128\t        traces: impl IntoIterator<Item = &'a TraceCtx>,\n129\t        pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n130\t        lambda_combinations: &[&DeviceBuffer<EF>],\n131\t    ) -> Result<Self, MemCopyError> {\n132\t        let traces: Vec<_> = traces.into_iter().collect();\n133\t        assert!(\n134\t            !traces.is_empty(),\n135\t            \"ZerocheckMonomialBatch requires at least one trace\"\n136\t        );\n137\t        assert_eq!(\n138\t            traces.len(),\n139\t            lambda_combinations.len(),\n140\t            \"lambda_combinations must have one buffer per trace\"\n141\t        );\n142\t\n143\t        let threads_per_block = THREADS_PER_BLOCK;\n144\t\n145\t        // Build block_ctxs and air_offsets\n146\t        // For each AIR: total_blocks = ceil(num_monomials / tpb) * num_y\n147\t        // local_block_idx_x encodes (y_int * mono_blocks + mono_block_idx)\n148\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();\n149\t        let mut air_offsets: Vec<u32> = Vec::with_capacity(traces.len() + 1);\n150\t        air_offsets.push(0);\n151\t\n152\t        for (local_air, t) in traces.iter().enumerate() {\n153\t            let monomials = pk.per_air[t.air_idx]\n154\t                .other_data\n155\t                .zerocheck_monomials\n156\t                .as_ref()\n157\t                .unwrap();\n158\t            let mono_blocks = monomials.num_monomials.div_ceil(threads_per_block);\n159\t            let total_blocks = mono_blocks * t.num_y;\n160\t\n161\t            for local_idx in 0..total_blocks {\n162\t                block_ctxs_h.push(BlockCtx {\n163\t                    local_block_idx_x: local_idx,\n164\t                    air_idx: local_air as u32,\n165\t                });\n166\t            }\n167\t            air_offsets.push(block_ctxs_h.len() as u32);\n168\t        }\n169\t\n170\t        // Build MonomialAirCtx for each trace\n171\t        let air_ctxs_h: Vec<MonomialAirCtx> = traces\n172\t            .iter()\n173\t            .zip(lambda_combinations)\n174\t            .map(|(t, lc)| {\n175\t                let monomials = pk.per_air[t.air_idx]\n176\t                    .other_data\n177\t                    .zerocheck_monomials\n178\t                    .as_ref()\n179\t                    .unwrap();\n180\t\n181\t                let eval_ctx = EvalCoreCtx {\n182\t                    d_selectors: t.sels_ptr,\n183\t                    d_preprocessed: t.prep_ptr,\n184\t                    d_main: t.main_ptrs_dev.as_ptr(),\n185\t                    d_public: t.public_ptr,\n186\t                };\n187\t\n188\t                MonomialAirCtx {\n189\t                    d_headers: monomials.d_headers.as_ptr(),\n190\t                    d_variables: monomials.d_variables.as_ptr(),\n191\t                    d_lambda_combinations: lc.as_ptr(),\n192\t                    num_monomials: monomials.num_monomials,\n193\t                    eval_ctx,\n194\t                    d_eq_xi: t.eq_xi_ptr,\n195\t                    num_y: t.num_y,\n196\t                }\n197\t            })\n198\t            .collect();\n199\t\n200\t        // Upload to device\n201\t        let block_ctxs = block_ctxs_h.to_device()?;\n202\t        let air_ctxs = air_ctxs_h.to_device()?;\n203\t        let air_offsets = air_offsets.to_device()?;\n204\t\n205\t        debug!(\n206\t            num_airs = traces.len(),\n207\t            num_blocks = block_ctxs.len(),\n208\t            \"ZerocheckMonomialBatch created\"\n209\t        );\n210\t\n211\t        Ok(Self {\n212\t            traces,\n213\t            block_ctxs,\n214\t            air_ctxs,\n215\t            air_offsets,\n216\t        })\n217\t    }\n218\t\n219\t    /// Returns the trace indices in order.\n220\t    pub fn trace_indices(&self) -> impl Iterator<Item = usize> + '_ {\n221\t        self.traces.iter().map(|t| t.trace_idx)\n222\t    }\n223\t\n224\t    /// Evaluates the batch and returns the output device buffer.\n225\t    ///\n226\t    /// The buffer contains `num_airs * num_x` elements, laid out as\n227\t    /// `[air0_x0, air0_x1, ..., air1_x0, air1_x1, ...]`.\n228\t    /// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n229\t    pub fn evaluate(&self, num_x: u32) -> Result<DeviceBuffer<EF>, KernelError> {\n230\t        let num_blocks = self.block_ctxs.len();\n231\t        let num_airs = self.air_ctxs.len();\n232\t\n233\t        debug!(\n234\t            %num_blocks,\n235\t            %num_x,\n236\t            %num_airs,\n237\t            \"zerocheck_monomial_batched\"\n238\t        );\n239\t\n240\t        let mut tmp_sums = DeviceBuffer::<EF>::with_capacity(num_blocks * num_x as usize);\n241\t        let mut output = DeviceBuffer::<EF>::with_capacity(num_airs * num_x as usize);\n242\t\n243\t        debug_assert_eq!(\n244\t            self.air_offsets.len(),\n245\t            num_airs + 1,\n246\t            \"air_offsets must have num_airs + 1 elements\"\n247\t        );\n248\t        // SAFETY: All device pointers in block_ctxs and air_ctxs were constructed from\n249\t        // valid DeviceBuffers that outlive this call (TraceCtx references, pk monomial data,\n250\t        // lambda_combinations). The air_offsets buffer has length num_airs + 1 as required.\n251\t        unsafe {\n252\t            zerocheck_monomial_batched(\n253\t                &mut tmp_sums,\n254\t                &mut output,\n255\t                &self.block_ctxs,\n256\t                &self.air_ctxs,\n257\t                &self.air_offsets,\n258\t                num_blocks as u32,\n259\t                num_x,\n260\t                num_airs as u32,\n261\t                THREADS_PER_BLOCK,\n262\t            )?;\n263\t        }\n264\t\n265\t        Ok(output)\n266\t    }\n267\t}\n268\t\n269\t// Constants for par-y kernel\n270\tconst THREADS_PER_BLOCK_PAR_Y: u32 = 128;\n271\tconst DEFAULT_MAX_MONOMIALS_PER_THREAD: u32 = 64;\n272\tconst WAVES_TARGET: u32 = 4;\n273\t\n274\t/// Batch evaluator for monomial-based zerocheck MLE evaluation, parallelizing over y_int.\n275\t///\n276\t/// This variant is optimized for traces with high `num_y`: each thread handles one y_int\n277\t/// and loops over a chunk of monomials. The chunk size is auto-tuned based on SM count.\n278\t///\n279\t/// The caller must filter traces using [`trace_has_monomials`] before constructing.\n280\t/// The batch must contain at least one trace.\n281\tpub(crate) struct ZerocheckMonomialParYBatch<'a> {\n282\t    traces: Vec<&'a TraceCtx>,\n283\t    block_ctxs: DeviceBuffer<BlockCtx>,\n284\t    air_ctxs: DeviceBuffer<MonomialAirCtx>,\n285\t    air_offsets: DeviceBuffer<u32>,\n286\t    num_blocks: u32,\n287\t    chunk_size: u32,\n288\t}\n289\t\n290\timpl<'a> ZerocheckMonomialParYBatch<'a> {\n291\t    /// Creates a new batch from an iterator of traces.\n292\t    ///\n293\t    /// `lambda_combinations` must contain one buffer per trace (in iteration order),\n294\t    /// each precomputed via [`compute_lambda_combinations`].\n295\t    ///\n296\t    /// The `sm_count` and `num_x` parameters are used to auto-tune the chunk size\n297\t    /// for optimal SM utilization.\n298\t    ///\n299\t    /// # Panics\n300\t    ///\n301\t    /// Panics if `traces` is empty or if `lambda_combinations` length doesn't match.\n302\t    #[allow(clippy::too_many_arguments)]\n303\t    pub fn new<HS: GpuHashScheme>(\n304\t        traces: impl IntoIterator<Item = &'a TraceCtx>,\n305\t        pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n306\t        lambda_combinations: &[&DeviceBuffer<EF>],\n307\t        sm_count: u32,\n308\t        num_x: u32,\n309\t        max_monomials_per_thread: Option<u32>,\n310\t    ) -> Result<Self, MemCopyError> {\n311\t        let traces: Vec<_> = traces.into_iter().collect();\n312\t        assert!(\n313\t            !traces.is_empty(),\n314\t            \"ZerocheckMonomialParYBatch requires at least one trace\"\n315\t        );\n316\t        assert_eq!(\n317\t            traces.len(),\n318\t            lambda_combinations.len(),\n319\t            \"lambda_combinations must have one buffer per trace\"\n320\t        );\n321\t\n322\t        let threads_per_block = THREADS_PER_BLOCK_PAR_Y;\n323\t        let max_mono_per_thread =\n324\t            max_monomials_per_thread.unwrap_or(DEFAULT_MAX_MONOMIALS_PER_THREAD);\n325\t\n326\t        // First pass: collect per-AIR info\n327\t        let mut per_air_info: Vec<(u32, u32)> = Vec::new(); // (y_blocks, num_monomials)\n328\t        let mut max_monomials = 0u32;\n329\t\n330\t        for t in traces.iter() {\n331\t            let monomials = pk.per_air[t.air_idx]\n332\t                .other_data\n333\t                .zerocheck_monomials\n334\t                .as_ref()\n335\t                .expect(\"AIR with constraints must have monomials\");\n336\t\n337\t            let y_blocks = t.num_y.div_ceil(threads_per_block);\n338\t            max_monomials = max_monomials.max(monomials.num_monomials);\n339\t            per_air_info.push((y_blocks, monomials.num_monomials));\n340\t        }\n341\t\n342\t        // Determine chunk_size based on SM utilization and cap\n343\t        // We want: total_blocks * num_x >= sm_count * WAVES_TARGET\n344\t        // total_blocks = sum of (y_blocks * air_mono_chunks) per AIR\n345\t        // where air_mono_chunks = ceil(num_monomials / chunk_size)\n346\t        //\n347\t        // Also: chunk_size <= max_mono_per_thread\n348\t        //\n349\t        // Start with chunk_size = max_mono_per_thread and adjust if needed\n350\t        let target_blocks = sm_count * WAVES_TARGET;\n351\t\n352\t        // Initial estimate: use max_mono_per_thread as chunk_size\n353\t        let mut chunk_size = max_mono_per_thread;\n354\t        loop {\n355\t            let total_blocks: u32 = per_air_info\n356\t                .iter()\n357\t                .map(|(y_blocks, num_mono)| {\n358\t                    let air_mono_chunks = num_mono.div_ceil(chunk_size);\n359\t                    y_blocks * air_mono_chunks\n360\t                })\n361\t                .sum();\n362\t\n363\t            if total_blocks * num_x >= target_blocks || chunk_size <= 1 {\n364\t                break;\n365\t            }\n366\t            // Need more blocks: reduce chunk_size\n367\t            chunk_size = (chunk_size / 2).max(1);\n368\t        }\n369\t\n370\t        // Build block_ctxs with per-AIR encoding\n371\t        // Encoding: local_block_idx_x = y_block * air_mono_chunks + mono_chunk\n372\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();\n373\t        let mut air_offsets: Vec<u32> = Vec::with_capacity(traces.len() + 1);\n374\t        air_offsets.push(0);\n375\t\n376\t        for (local_air, (y_blocks, num_mono)) in per_air_info.iter().enumerate() {\n377\t            let air_mono_chunks = num_mono.div_ceil(chunk_size);\n378\t\n379\t            for y_block in 0..*y_blocks {\n380\t                for mono_chunk in 0..air_mono_chunks {\n381\t                    let local_idx = y_block * air_mono_chunks + mono_chunk;\n382\t                    block_ctxs_h.push(BlockCtx {\n383\t                        local_block_idx_x: local_idx,\n384\t                        air_idx: local_air as u32,\n385\t                    });\n386\t                }\n387\t            }\n388\t            air_offsets.push(block_ctxs_h.len() as u32);\n389\t        }\n390\t\n391\t        let num_blocks = block_ctxs_h.len() as u32;\n392\t\n393\t        // Build MonomialAirCtx for each trace\n394\t        let air_ctxs_h: Vec<MonomialAirCtx> = traces\n395\t            .iter()\n396\t            .zip(lambda_combinations)\n397\t            .map(|(t, lc)| {\n398\t                let monomials = pk.per_air[t.air_idx]\n399\t                    .other_data\n400\t                    .zerocheck_monomials\n401\t                    .as_ref()\n402\t                    .unwrap();\n403\t\n404\t                let eval_ctx = EvalCoreCtx {\n405\t                    d_selectors: t.sels_ptr,\n406\t                    d_preprocessed: t.prep_ptr,\n407\t                    d_main: t.main_ptrs_dev.as_ptr(),\n408\t                    d_public: t.public_ptr,\n409\t                };\n410\t\n411\t                MonomialAirCtx {\n412\t                    d_headers: monomials.d_headers.as_ptr(),\n413\t                    d_variables: monomials.d_variables.as_ptr(),\n414\t                    d_lambda_combinations: lc.as_ptr(),\n415\t                    num_monomials: monomials.num_monomials,\n416\t                    eval_ctx,\n417\t                    d_eq_xi: t.eq_xi_ptr,\n418\t                    num_y: t.num_y,\n419\t                }\n420\t            })\n421\t            .collect();\n422\t\n423\t        // Upload to device\n424\t        let block_ctxs = block_ctxs_h.to_device()?;\n425\t        let air_ctxs = air_ctxs_h.to_device()?;\n426\t        let air_offsets = air_offsets.to_device()?;\n427\t\n428\t        debug!(\n429\t            num_airs = traces.len(),\n430\t            num_blocks, chunk_size, max_monomials, \"ZerocheckMonomialParYBatch created\"\n431\t        );\n432\t\n433\t        Ok(Self {\n434\t            traces,\n435\t            block_ctxs,\n436\t            air_ctxs,\n437\t            air_offsets,\n438\t            num_blocks,\n439\t            chunk_size,\n440\t        })\n441\t    }\n442\t\n443\t    /// Returns the trace indices in order.\n444\t    pub fn trace_indices(&self) -> impl Iterator<Item = usize> + '_ {\n445\t        self.traces.iter().map(|t| t.trace_idx)\n446\t    }\n447\t\n448\t    /// Evaluates the batch and returns the output device buffer.\n449\t    ///\n450\t    /// The buffer contains `num_airs * num_x` elements, laid out as\n451\t    /// `[air0_x0, air0_x1, ..., air1_x0, air1_x1, ...]`.\n452\t    /// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n453\t    pub fn evaluate(&self, num_x: u32) -> Result<DeviceBuffer<EF>, KernelError> {\n454\t        let num_airs = self.air_ctxs.len();\n455\t\n456\t        debug!(\n457\t            num_blocks = %self.num_blocks,\n458\t            %num_x,\n459\t            %num_airs,\n460\t            chunk_size = %self.chunk_size,\n461\t            \"zerocheck_monomial_par_y_batched\"\n462\t        );\n463\t\n464\t        let mut tmp_sums =\n465\t            DeviceBuffer::<EF>::with_capacity(self.num_blocks as usize * num_x as usize);\n466\t        let mut output = DeviceBuffer::<EF>::with_capacity(num_airs * num_x as usize);\n467\t\n468\t        debug_assert_eq!(\n469\t            self.air_offsets.len(),\n470\t            num_airs + 1,\n471\t            \"air_offsets must have num_airs + 1 elements\"\n472\t        );\n473\t        // SAFETY: All device pointers in block_ctxs and air_ctxs were constructed from\n474\t        // valid DeviceBuffers that outlive this call (TraceCtx references, pk monomial data,\n475\t        // lambda_combinations). The air_offsets buffer has length num_airs + 1 as required.\n476\t        unsafe {\n477\t            zerocheck_monomial_par_y_batched(\n478\t                &mut tmp_sums,\n479\t                &mut output,\n480\t                &self.block_ctxs,\n481\t                &self.air_ctxs,\n482\t                &self.air_offsets,\n483\t                self.num_blocks,\n484\t                num_x,\n485\t                num_airs as u32,\n486\t                self.chunk_size,\n487\t                THREADS_PER_BLOCK_PAR_Y,\n488\t            )?;\n489\t        }\n490\t\n491\t        Ok(output)\n492\t    }\n493\t}\n494\t\n495\t// ============================================================================\n496\t// LOGUP MONOMIAL EVALUATION\n497\t// ============================================================================\n498\t\n499\t/// Precomputed logup combinations for a single AIR.\n500\tpub struct LogupCombinations {\n501\t    pub d_numer_combinations: DeviceBuffer<EF>,\n502\t    pub d_denom_combinations: DeviceBuffer<EF>,\n503\t    pub bus_term_sum: EF,\n504\t}\n505\t\n506\t/// Precompute logup combinations for a single AIR's interaction monomials.\n507\t///\n508\t/// The AIR must have nonempty interaction monomials.\n509\tpub(crate) fn compute_logup_combinations<HS: GpuHashScheme>(\n510\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n511\t    air_idx: usize,\n512\t    d_beta_pows: &DeviceBuffer<EF>,\n513\t    d_eq_3bs: &DeviceBuffer<EF>,\n514\t    eq_3bs_host: &[EF],\n515\t    beta_pows_host: &[EF],\n516\t) -> Result<LogupCombinations, CudaError> {\n517\t    let monomials = pk.per_air[air_idx]\n518\t        .other_data\n519\t        .interaction_monomials\n520\t        .as_ref()\n521\t        .expect(\"AIR must have interaction monomials\");\n522\t\n523\t    // Precompute numerator combinations: sum_i(coeff_i * eq_3bs[interaction_idx_i])\n524\t    let mut d_numer_combinations = if monomials.num_numer_monomials > 0 {\n525\t        DeviceBuffer::<EF>::with_capacity(monomials.num_numer_monomials as usize)\n526\t    } else {\n527\t        DeviceBuffer::new()\n528\t    };\n529\t    if monomials.num_numer_monomials > 0 {\n530\t        unsafe {\n531\t            precompute_logup_numer_combinations(\n532\t                &mut d_numer_combinations,\n533\t                monomials.d_numer_headers.as_ptr(),\n534\t                monomials.d_numer_terms.as_ptr(),\n535\t                d_eq_3bs,\n536\t                monomials.num_numer_monomials,\n537\t            )?;\n538\t        }\n539\t    }\n540\t\n541\t    // Precompute denominator combinations: sum_i(coeff_i * beta_pows[field_idx_i] *\n542\t    // eq_3bs[interaction_idx_i])\n543\t    let mut d_denom_combinations = if monomials.num_denom_monomials > 0 {\n544\t        DeviceBuffer::<EF>::with_capacity(monomials.num_denom_monomials as usize)\n545\t    } else {\n546\t        DeviceBuffer::new()\n547\t    };\n548\t    if monomials.num_denom_monomials > 0 {\n549\t        unsafe {\n550\t            precompute_logup_denom_combinations(\n551\t                &mut d_denom_combinations,\n552\t                monomials.d_denom_headers.as_ptr(),\n553\t                monomials.d_denom_terms.as_ptr(),\n554\t                d_beta_pows,\n555\t                d_eq_3bs,\n556\t                monomials.num_denom_monomials,\n557\t            )?;\n558\t        }\n559\t    }\n560\t\n561\t    // Compute bus_term_sum on CPU: sum_i(beta_pows[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n562\t    let interactions = &pk.per_air[air_idx].vk.symbolic_constraints.interactions;\n563\t    debug_assert_eq!(\n564\t        interactions.len(),\n565\t        eq_3bs_host.len(),\n566\t        \"interaction count must match eq_3bs\"\n567\t    );\n568\t    let mut bus_term_sum = EF::ZERO;\n569\t    for (i, interaction) in interactions.iter().enumerate() {\n570\t        let beta_len = beta_pows_host[interaction.message.len()];\n571\t        let bus_idx = interaction.bus_index as u32;\n572\t        bus_term_sum += beta_len * EF::from_u32(bus_idx + 1) * eq_3bs_host[i];\n573\t    }\n574\t\n575\t    Ok(LogupCombinations {\n576\t        d_numer_combinations,\n577\t        d_denom_combinations,\n578\t        bus_term_sum,\n579\t    })\n580\t}\n581\t\n582\tconst THREADS_PER_BLOCK_LOGUP: u32 = 128;\n583\t\n584\t/// Batch evaluator for logup monomial MLE evaluation.\n585\t///\n586\t/// Each block evaluates a monomial chunk for a y_int, producing a FracExt output\n587\t/// compatible with standard reduction.\n588\tpub(crate) struct LogupMonomialBatch<'a> {\n589\t    traces: Vec<&'a TraceCtx>,\n590\t    block_ctxs: DeviceBuffer<BlockCtx>,\n591\t    common_ctxs: DeviceBuffer<LogupMonomialCommonCtx>,\n592\t    numer_ctxs: DeviceBuffer<LogupMonomialCtx>,\n593\t    denom_ctxs: DeviceBuffer<LogupMonomialCtx>,\n594\t    air_offsets: DeviceBuffer<u32>,\n595\t    num_blocks: u32,\n596\t}\n597\t\n598\timpl<'a> LogupMonomialBatch<'a> {\n599\t    /// Creates a new batch from an iterator of traces.\n600\t    ///\n601\t    /// `logup_combinations` must contain one `LogupCombinations` per trace (in iteration order),\n602\t    /// each precomputed via [`compute_logup_combinations`].\n603\t    ///\n604\t    /// # Panics\n605\t    ///\n606\t    /// Panics if `traces` is empty or if `logup_combinations` length doesn't match.\n607\t    pub fn new<HS: GpuHashScheme>(\n608\t        traces: impl IntoIterator<Item = &'a TraceCtx>,\n609\t        pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n610\t        logup_combinations: &[&LogupCombinations],\n611\t    ) -> Result<Self, MemCopyError> {\n612\t        let traces: Vec<_> = traces.into_iter().collect();\n613\t        assert!(\n614\t            !traces.is_empty(),\n615\t            \"LogupMonomialBatch requires at least one trace\"\n616\t        );\n617\t        assert_eq!(\n618\t            traces.len(),\n619\t            logup_combinations.len(),\n620\t            \"logup_combinations must have one entry per trace\"\n621\t        );\n622\t\n623\t        let threads_per_block = THREADS_PER_BLOCK_LOGUP;\n624\t\n625\t        // Build block_ctxs: one block per (y_int, mono_block) per trace\n626\t        // local_block_idx_x = y_int * mono_blocks + mono_block\n627\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();\n628\t        let mut air_offsets: Vec<u32> = Vec::with_capacity(traces.len() + 1);\n629\t        air_offsets.push(0);\n630\t\n631\t        for (local_air, t) in traces.iter().enumerate() {\n632\t            let monomials = pk.per_air[t.air_idx]\n633\t                .other_data\n634\t                .interaction_monomials\n635\t                .as_ref()\n636\t                .unwrap();\n637\t            let max_monomials = monomials\n638\t                .num_numer_monomials\n639\t                .max(monomials.num_denom_monomials);\n640\t            let mono_blocks = max_monomials.div_ceil(threads_per_block).max(1);\n641\t            for y_int in 0..t.num_y {\n642\t                for mono_block in 0..mono_blocks {\n643\t                    block_ctxs_h.push(BlockCtx {\n644\t                        local_block_idx_x: y_int * mono_blocks + mono_block,\n645\t                        air_idx: local_air as u32,\n646\t                    });\n647\t                }\n648\t            }\n649\t            air_offsets.push(block_ctxs_h.len() as u32);\n650\t        }\n651\t\n652\t        let num_blocks = block_ctxs_h.len() as u32;\n653\t\n654\t        // Build logup monomial ctxs for each trace\n655\t        let common_ctxs_h: Vec<LogupMonomialCommonCtx> = traces\n656\t            .iter()\n657\t            .zip(logup_combinations)\n658\t            .map(|(t, lc)| {\n659\t                let monomials = pk.per_air[t.air_idx]\n660\t                    .other_data\n661\t                    .interaction_monomials\n662\t                    .as_ref()\n663\t                    .unwrap();\n664\t                let max_monomials = monomials\n665\t                    .num_numer_monomials\n666\t                    .max(monomials.num_denom_monomials);\n667\t                let mono_blocks = max_monomials.div_ceil(threads_per_block).max(1);\n668\t\n669\t                let eval_ctx = EvalCoreCtx {\n670\t                    d_selectors: t.sels_ptr,\n671\t                    d_preprocessed: t.prep_ptr,\n672\t                    d_main: t.main_ptrs_dev.as_ptr(),\n673\t                    d_public: t.public_ptr,\n674\t                };\n675\t\n676\t                LogupMonomialCommonCtx {\n677\t                    eval_ctx,\n678\t                    d_eq_xi: t.eq_xi_ptr,\n679\t                    bus_term_sum: lc.bus_term_sum,\n680\t                    num_y: t.num_y,\n681\t                    mono_blocks,\n682\t                }\n683\t            })\n684\t            .collect();\n685\t        let numer_ctxs_h: Vec<LogupMonomialCtx> = traces\n686\t            .iter()\n687\t            .zip(logup_combinations)\n688\t            .map(|(t, lc)| {\n689\t                let monomials = pk.per_air[t.air_idx]\n690\t                    .other_data\n691\t                    .interaction_monomials\n692\t                    .as_ref()\n693\t                    .unwrap();\n694\t                LogupMonomialCtx {\n695\t                    d_headers: monomials.d_numer_headers.as_ptr(),\n696\t                    d_variables: monomials.d_numer_variables.as_ptr(),\n697\t                    d_combinations: lc.d_numer_combinations.as_ptr(),\n698\t                    num_monomials: monomials.num_numer_monomials,\n699\t                }\n700\t            })\n701\t            .collect();\n702\t        let denom_ctxs_h: Vec<LogupMonomialCtx> = traces\n703\t            .iter()\n704\t            .zip(logup_combinations)\n705\t            .map(|(t, lc)| {\n706\t                let monomials = pk.per_air[t.air_idx]\n707\t                    .other_data\n708\t                    .interaction_monomials\n709\t                    .as_ref()\n710\t                    .unwrap();\n711\t                LogupMonomialCtx {\n712\t                    d_headers: monomials.d_denom_headers.as_ptr(),\n713\t                    d_variables: monomials.d_denom_variables.as_ptr(),\n714\t                    d_combinations: lc.d_denom_combinations.as_ptr(),\n715\t                    num_monomials: monomials.num_denom_monomials,\n716\t                }\n717\t            })\n718\t            .collect();\n719\t\n720\t        // Upload to device\n721\t        let block_ctxs = block_ctxs_h.to_device()?;\n722\t        let common_ctxs = common_ctxs_h.to_device()?;\n723\t        let numer_ctxs = numer_ctxs_h.to_device()?;\n724\t        let denom_ctxs = denom_ctxs_h.to_device()?;\n725\t        let air_offsets = air_offsets.to_device()?;\n726\t\n727\t        debug!(\n728\t            num_airs = traces.len(),\n729\t            num_blocks, \"LogupMonomialBatch created\"\n730\t        );\n731\t\n732\t        Ok(Self {\n733\t            traces,\n734\t            block_ctxs,\n735\t            common_ctxs,\n736\t            numer_ctxs,\n737\t            denom_ctxs,\n738\t            air_offsets,\n739\t            num_blocks,\n740\t        })\n741\t    }\n742\t\n743\t    /// Returns the trace indices in order.\n744\t    pub fn trace_indices(&self) -> impl Iterator<Item = usize> + '_ {\n745\t        self.traces.iter().map(|t| t.trace_idx)\n746\t    }\n747\t\n748\t    /// Evaluates the batch and returns the output device buffer.\n749\t    ///\n750\t    /// The buffer contains `num_airs * num_x` FracExt elements, laid out as\n751\t    /// `[air0_x0, air0_x1, ..., air1_x0, air1_x1, ...]`.\n752\t    /// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n753\t    pub fn evaluate(&self, num_x: u32) -> Result<DeviceBuffer<Frac<EF>>, KernelError> {\n754\t        let num_airs = self.common_ctxs.len();\n755\t\n756\t        debug!(\n757\t            num_blocks = %self.num_blocks,\n758\t            %num_x,\n759\t            %num_airs,\n760\t            \"logup_monomial_batched\"\n761\t        );\n762\t\n763\t        let mut tmp_sums =\n764\t            DeviceBuffer::<Frac<EF>>::with_capacity(self.num_blocks as usize * num_x as usize);\n765\t        let mut output = DeviceBuffer::<Frac<EF>>::with_capacity(num_airs * num_x as usize);\n766\t\n767\t        debug_assert_eq!(\n768\t            self.air_offsets.len(),\n769\t            num_airs + 1,\n770\t            \"air_offsets must have num_airs + 1 elements\"\n771\t        );\n772\t\n773\t        // SAFETY: All device pointers were constructed from valid DeviceBuffers that outlive this\n774\t        // call.\n775\t        unsafe {\n776\t            logup_monomial_batched(\n777\t                &mut tmp_sums,\n778\t                &mut output,\n779\t                &self.block_ctxs,\n780\t                &self.common_ctxs,\n781\t                &self.numer_ctxs,\n782\t                &self.denom_ctxs,\n783\t                &self.air_offsets,\n784\t                self.num_blocks,\n785\t                num_x,\n786\t                num_airs as u32,\n787\t                THREADS_PER_BLOCK_LOGUP,\n788\t            )?;\n789\t        }\n790\t\n791\t        Ok(output)\n792\t    }\n793\t}\n794\t"}]},"parent_tool_use_id":"toolu_01FvhCB93jqt4LU48te2ZGuN","session_id":"997f7e33-9a1a-40a3-8498-75cdc1cf5ede","uuid":"476d0942-f0d6-4aac-9ac5-7a1e5194eae9","timestamp":"2026-04-14T21:24:03.903Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KVcshNCL16GK1LiuaxBW59","type":"tool_result","content":"1\t#include \"eval_ctx.cuh\"\n2\t#include \"frac_ext.cuh\"\n3\t#include \"launcher.cuh\"\n4\t#include \"monomial.cuh\"\n5\t#include \"sumcheck.cuh\"\n6\t\n7\t#include <cassert>\n8\t#include <cstdint>\n9\t\n10\tnamespace logup_zerocheck_mle {\n11\t\n12\t__device__ __forceinline__ FpExt\n13\teval_variable(PackedVar var, uint32_t row, const EvalCoreCtx &ctx, uint32_t height) {\n14\t    uint8_t entry_type = var.entry_type();\n15\t    uint8_t offset = var.offset();\n16\t\n17\t    switch (entry_type) {\n18\t    case 1: { // MAIN\n19\t        auto main_ptr = ctx.d_main[var.part_index()];\n20\t        const auto stride = height * main_ptr.air_width;\n21\t        const FpExt *__restrict__ matrix = main_ptr.data + stride * offset;\n22\t        const FpExt *__restrict__ column = matrix + height * var.col_index();\n23\t        return column[row];\n24\t    }\n25\t    case 0: { // PREPROCESSED\n26\t        const auto stride = height * ctx.d_preprocessed.air_width;\n27\t        const FpExt *__restrict__ matrix = ctx.d_preprocessed.data + stride * offset;\n28\t        const FpExt *__restrict__ column = matrix + height * var.col_index();\n29\t        return column[row];\n30\t    }\n31\t    case 3: // PUBLIC\n32\t        return FpExt(ctx.d_public[var.col_index()]);\n33\t    case 8: // IS_FIRST\n34\t        return ctx.d_selectors[row];\n35\t    case 9: // IS_LAST\n36\t        return ctx.d_selectors[2 * height + row];\n37\t    case 10: // IS_TRANSITION\n38\t        return ctx.d_selectors[height + row];\n39\t    default:\n40\t        assert(false);\n41\t    }\n42\t    return FpExt(Fp::zero());\n43\t}\n44\t\n45\t// For batched monomial evaluation across multiple AIRs\n46\tstruct MonomialAirCtx {\n47\t    const MonomialHeader *__restrict__ d_headers;\n48\t    const PackedVar *__restrict__ d_variables;\n49\t    const FpExt *__restrict__ d_lambda_combinations; // Precomputed per-monomial\n50\t    uint32_t num_monomials;\n51\t    EvalCoreCtx eval_ctx;\n52\t    const FpExt *__restrict__ d_eq_xi;\n53\t    uint32_t num_y;\n54\t};\n55\t\n56\t// ============================================================================\n57\t// PRECOMPUTE LAMBDA COMBINATIONS (once per AIR after lambda is sampled)\n58\t// ============================================================================\n59\t\n60\t__global__ void precompute_lambda_combinations_kernel(\n61\t    FpExt *__restrict__ out,\n62\t    const MonomialHeader *__restrict__ headers,\n63\t    const LambdaTerm *__restrict__ lambda_terms,\n64\t    const FpExt *__restrict__ lambda_pows,\n65\t    uint32_t num_monomials\n66\t) {\n67\t    uint32_t m = blockIdx.x * blockDim.x + threadIdx.x;\n68\t    if (m >= num_monomials)\n69\t        return;\n70\t\n71\t    MonomialHeader hdr = headers[m];\n72\t    FpExt sum(Fp::zero());\n73\t    for (uint16_t l = 0; l < hdr.num_terms; ++l) {\n74\t        LambdaTerm term = lambda_terms[hdr.term_offset + l];\n75\t        sum += lambda_pows[term.constraint_idx] * term.coefficient;\n76\t    }\n77\t    out[m] = sum;\n78\t}\n79\t\n80\textern \"C\" int _precompute_lambda_combinations(\n81\t    FpExt *out,\n82\t    const MonomialHeader *headers,\n83\t    const LambdaTerm *lambda_terms,\n84\t    const FpExt *lambda_pows,\n85\t    uint32_t num_monomials\n86\t) {\n87\t    if (num_monomials == 0)\n88\t        return 0;\n89\t\n90\t    constexpr uint32_t threads = 256;\n91\t    uint32_t blocks = div_ceil(num_monomials, threads);\n92\t    precompute_lambda_combinations_kernel<<<blocks, threads>>>(\n93\t        out, headers, lambda_terms, lambda_pows, num_monomials\n94\t    );\n95\t    return CHECK_KERNEL();\n96\t}\n97\t\n98\t// ============================================================================\n99\t// BATCHED KERNEL (multiple AIRs in single launch)\n100\t// ============================================================================\n101\t\n102\t__global__ void zerocheck_monomial_kernel(\n103\t    FpExt *__restrict__ tmp_sums,\n104\t    const BlockCtx *__restrict__ block_ctxs,\n105\t    const MonomialAirCtx *__restrict__ air_ctxs,\n106\t    uint32_t threads_per_block\n107\t) {\n108\t    extern __shared__ char smem[];\n109\t    FpExt *shared = (FpExt *)smem;\n110\t\n111\t    BlockCtx bctx = block_ctxs[blockIdx.x];\n112\t    MonomialAirCtx actx = air_ctxs[bctx.air_idx];\n113\t\n114\t    uint32_t num_x = gridDim.y;\n115\t    uint32_t x_int = blockIdx.y;\n116\t\n117\t    // Decode y_int and mono_block from local_block_idx_x\n118\t    uint32_t mono_blocks = (actx.num_monomials + threads_per_block - 1) / threads_per_block;\n119\t    uint32_t y_int = bctx.local_block_idx_x / mono_blocks;\n120\t    uint32_t mono_block = bctx.local_block_idx_x % mono_blocks;\n121\t\n122\t    uint32_t height = num_x * actx.num_y;\n123\t    uint32_t row = x_int * actx.num_y + y_int;\n124\t\n125\t    FpExt sum(Fp::zero());\n126\t\n127\t    // Each thread evaluates one monomial\n128\t    uint32_t m = mono_block * threads_per_block + threadIdx.x;\n129\t    if (m < actx.num_monomials) {\n130\t        MonomialHeader hdr = actx.d_headers[m];\n131\t\n132\t        // Evaluate product of variables\n133\t        FpExt product(Fp::one());\n134\t        for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n135\t            PackedVar var = actx.d_variables[hdr.var_offset + v];\n136\t            product *= eval_variable(var, row, actx.eval_ctx, height);\n137\t        }\n138\t\n139\t        sum = product * actx.d_lambda_combinations[m];\n140\t    }\n141\t\n142\t    // Block reduction\n143\t    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n144\t\n145\t    if (threadIdx.x == 0) {\n146\t        // Apply eq_xi here (eliminates separate phase 2)\n147\t        // eq_xi is eq(xi, y) which only depends on y, not x\n148\t        reduced *= actx.d_eq_xi[y_int];\n149\t        tmp_sums[blockIdx.x * num_x + x_int] = reduced;\n150\t    }\n151\t}\n152\t\n153\textern \"C\" int _zerocheck_monomial_batched(\n154\t    FpExt *tmp_sums,\n155\t    FpExt *output,\n156\t    const BlockCtx *block_ctxs,\n157\t    const MonomialAirCtx *air_ctxs,\n158\t    const uint32_t *air_block_offsets,\n159\t    uint32_t num_blocks,\n160\t    uint32_t num_x,\n161\t    uint32_t num_airs,\n162\t    uint32_t threads_per_block\n163\t) {\n164\t    if (num_blocks == 0) {\n165\t        return 0;\n166\t    }\n167\t\n168\t    dim3 grid(num_blocks, num_x);\n169\t    dim3 block(threads_per_block);\n170\t    size_t shmem = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n171\t\n172\t    // Phase 1: Main monomial evaluation kernel\n173\t    zerocheck_monomial_kernel<<<grid, block, shmem>>>(\n174\t        tmp_sums, block_ctxs, air_ctxs, threads_per_block\n175\t    );\n176\t    int err = CHECK_KERNEL();\n177\t    if (err != 0)\n178\t        return err;\n179\t\n180\t    // Phase 2: Batched reduction for all AIRs in single launch\n181\t    // Grid: (num_airs, num_x) - each block handles one (air, x) pair\n182\t    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n183\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n184\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n185\t\n186\t    dim3 reduce_grid(num_airs, num_x);\n187\t    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n188\t        tmp_sums, output, air_block_offsets, num_x\n189\t    );\n190\t\n191\t    return CHECK_KERNEL();\n192\t}\n193\t\n194\t// ============================================================================\n195\t// PAR-Y KERNEL (parallelizes over y_int, tiles monomials)\n196\t// ============================================================================\n197\t\n198\t__global__ void zerocheck_monomial_par_y_kernel(\n199\t    FpExt *__restrict__ tmp_sums,\n200\t    const BlockCtx *__restrict__ block_ctxs,\n201\t    const MonomialAirCtx *__restrict__ air_ctxs,\n202\t    uint32_t threads_per_block,\n203\t    uint32_t chunk_size // monomials per mono_chunk\n204\t) {\n205\t    extern __shared__ char smem[];\n206\t    FpExt *shared = (FpExt *)smem;\n207\t\n208\t    BlockCtx bctx = block_ctxs[blockIdx.x];\n209\t    MonomialAirCtx actx = air_ctxs[bctx.air_idx];\n210\t\n211\t    uint32_t num_x = gridDim.y;\n212\t    uint32_t x_int = blockIdx.y;\n213\t\n214\t    // Decode y_block and mono_chunk from local_block_idx_x\n215\t    // Encoding: local_block_idx_x = y_block * air_mono_chunks + mono_chunk\n216\t    uint32_t air_mono_chunks = (actx.num_monomials + chunk_size - 1) / chunk_size;\n217\t    uint32_t y_block = bctx.local_block_idx_x / air_mono_chunks;\n218\t    uint32_t mono_chunk = bctx.local_block_idx_x % air_mono_chunks;\n219\t\n220\t    // Decode y_int from thread position within y_block\n221\t    uint32_t y_int = threadIdx.x + y_block * threads_per_block;\n222\t    bool active = (y_int < actx.num_y);\n223\t\n224\t    uint32_t height = num_x * actx.num_y;\n225\t    uint32_t row = x_int * actx.num_y + y_int;\n226\t\n227\t    // Contiguous chunk of monomials for this mono_chunk\n228\t    uint32_t mono_start = mono_chunk * chunk_size;\n229\t    uint32_t mono_end = min(mono_start + chunk_size, actx.num_monomials);\n230\t\n231\t    FpExt sum(Fp::zero());\n232\t    if (active) {\n233\t        // Each thread loops over its chunk of monomials\n234\t        for (uint32_t m = mono_start; m < mono_end; ++m) {\n235\t            MonomialHeader hdr = actx.d_headers[m];\n236\t\n237\t            FpExt product(Fp::one());\n238\t            for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n239\t                PackedVar var = actx.d_variables[hdr.var_offset + v];\n240\t                product *= eval_variable(var, row, actx.eval_ctx, height);\n241\t            }\n242\t\n243\t            sum += product * actx.d_lambda_combinations[m];\n244\t        }\n245\t\n246\t        // Apply eq_xi\n247\t        sum *= actx.d_eq_xi[y_int];\n248\t    }\n249\t\n250\t    // Block reduction sums across y_int values in this block\n251\t    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n252\t\n253\t    if (threadIdx.x == 0) {\n254\t        tmp_sums[blockIdx.x * num_x + x_int] = reduced;\n255\t    }\n256\t}\n257\t\n258\textern \"C\" int _zerocheck_monomial_par_y_batched(\n259\t    FpExt *tmp_sums,\n260\t    FpExt *output,\n261\t    const BlockCtx *block_ctxs,\n262\t    const MonomialAirCtx *air_ctxs,\n263\t    const uint32_t *air_block_offsets,\n264\t    uint32_t num_blocks,\n265\t    uint32_t num_x,\n266\t    uint32_t num_airs,\n267\t    uint32_t chunk_size,\n268\t    uint32_t threads_per_block\n269\t) {\n270\t    if (num_blocks == 0) {\n271\t        return 0;\n272\t    }\n273\t\n274\t    dim3 grid(num_blocks, num_x);\n275\t    dim3 block(threads_per_block);\n276\t    size_t shmem = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n277\t\n278\t    // Phase 1: Main par-y kernel\n279\t    zerocheck_monomial_par_y_kernel<<<grid, block, shmem>>>(\n280\t        tmp_sums, block_ctxs, air_ctxs, threads_per_block, chunk_size\n281\t    );\n282\t    int err = CHECK_KERNEL();\n283\t    if (err != 0)\n284\t        return err;\n285\t\n286\t    // Phase 2: Batched reduction for all AIRs in single launch\n287\t    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n288\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n289\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n290\t\n291\t    dim3 reduce_grid(num_airs, num_x);\n292\t    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n293\t        tmp_sums, output, air_block_offsets, num_x\n294\t    );\n295\t\n296\t    return CHECK_KERNEL();\n297\t}\n298\t\n299\t// ============================================================================\n300\t// LOGUP MONOMIAL KERNELS\n301\t// ============================================================================\n302\t\n303\ttemplate <bool IS_DENOM>\n304\t__global__ void precompute_logup_combinations_kernel(\n305\t    FpExt *__restrict__ out,\n306\t    const MonomialHeader *__restrict__ headers,\n307\t    const InteractionMonomialTerm *__restrict__ terms,\n308\t    const FpExt *__restrict__ beta_pows,\n309\t    const FpExt *__restrict__ eq_3bs,\n310\t    uint32_t num_monomials\n311\t) {\n312\t    uint32_t m = blockIdx.x * blockDim.x + threadIdx.x;\n313\t    if (m >= num_monomials)\n314\t        return;\n315\t\n316\t    MonomialHeader hdr = headers[m];\n317\t    FpExt sum(Fp::zero());\n318\t    for (uint16_t t = 0; t < hdr.num_terms; ++t) {\n319\t        InteractionMonomialTerm term = terms[hdr.term_offset + t];\n320\t        FpExt value = eq_3bs[term.interaction_idx] * term.coefficient;\n321\t        if constexpr (IS_DENOM) {\n322\t            value *= beta_pows[term.field_idx];\n323\t        }\n324\t        sum += value;\n325\t    }\n326\t    out[m] = sum;\n327\t}\n328\t\n329\textern \"C\" int _precompute_logup_numer_combinations(\n330\t    FpExt *out,\n331\t    const MonomialHeader *headers,\n332\t    const InteractionMonomialTerm *terms,\n333\t    const FpExt *eq_3bs,\n334\t    uint32_t num_monomials\n335\t) {\n336\t    if (num_monomials == 0)\n337\t        return 0;\n338\t\n339\t    constexpr uint32_t threads = 256;\n340\t    uint32_t blocks = div_ceil(num_monomials, threads);\n341\t    precompute_logup_combinations_kernel<false><<<blocks, threads>>>(\n342\t        out, headers, terms, nullptr, eq_3bs, num_monomials\n343\t    );\n344\t    return CHECK_KERNEL();\n345\t}\n346\t\n347\textern \"C\" int _precompute_logup_denom_combinations(\n348\t    FpExt *out,\n349\t    const MonomialHeader *headers,\n350\t    const InteractionMonomialTerm *terms,\n351\t    const FpExt *beta_pows,\n352\t    const FpExt *eq_3bs,\n353\t    uint32_t num_monomials\n354\t) {\n355\t    if (num_monomials == 0)\n356\t        return 0;\n357\t\n358\t    constexpr uint32_t threads = 256;\n359\t    uint32_t blocks = div_ceil(num_monomials, threads);\n360\t    precompute_logup_combinations_kernel<true><<<blocks, threads>>>(\n361\t        out, headers, terms, beta_pows, eq_3bs, num_monomials\n362\t    );\n363\t    return CHECK_KERNEL();\n364\t}\n365\t\n366\t// AIR context for logup monomial MLE evaluation\n367\t// Note: These structures match the Rust LogupMonomial*Ctx types\n368\tstruct LogupMonomialCommonCtx {\n369\t    EvalCoreCtx eval_ctx;\n370\t    const FpExt *__restrict__ d_eq_xi;\n371\t    FpExt bus_term_sum; // Precomputed sum_i(beta[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n372\t    uint32_t num_y;\n373\t    uint32_t mono_blocks;\n374\t};\n375\t\n376\tstruct LogupMonomialCtx {\n377\t    const MonomialHeader *__restrict__ d_headers;\n378\t    const PackedVar *__restrict__ d_variables;\n379\t    const FpExt *__restrict__ d_combinations;\n380\t    uint32_t num_monomials;\n381\t};\n382\t\n383\t// Logup monomial MLE kernel - evaluates numerator or denominator monomials per block.\n384\t// This produces FracExt output compatible with the standard reduction pattern.\n385\t//\n386\t// Block assignment: one block per (y_int, mono_block).\n387\t// Each block evaluates a chunk of monomials across threads.\n388\t//\n389\t// Template parameter IS_DENOM:\n390\t//   - false: numerator kernel, writes to tmp_sums[...].p\n391\t//   - true: denominator kernel, writes to tmp_sums[...].q and adds bus_term_sum when mono_block == 0\n392\ttemplate <bool IS_DENOM>\n393\t__global__ void logup_monomial_kernel(\n394\t    FracExt *__restrict__ tmp_sums,\n395\t    const BlockCtx *__restrict__ block_ctxs,\n396\t    const LogupMonomialCommonCtx *__restrict__ common_ctxs,\n397\t    const LogupMonomialCtx *__restrict__ ctxs\n398\t) {\n399\t    extern __shared__ char smem[];\n400\t    FpExt *shared = (FpExt *)smem;\n401\t\n402\t    BlockCtx bctx = block_ctxs[blockIdx.x];\n403\t    LogupMonomialCommonCtx common_ctx = common_ctxs[bctx.air_idx];\n404\t    LogupMonomialCtx ctx = ctxs[bctx.air_idx];\n405\t\n406\t    uint32_t num_x = gridDim.y;\n407\t    uint32_t x_int = blockIdx.y;\n408\t    uint32_t height = num_x * common_ctx.num_y;\n409\t\n410\t    uint32_t mono_blocks = common_ctx.mono_blocks;\n411\t#ifdef CUDA_DEBUG\n412\t    assert(mono_blocks > 0);\n413\t#endif\n414\t    uint32_t y_int = bctx.local_block_idx_x / mono_blocks;\n415\t    uint32_t mono_block = bctx.local_block_idx_x % mono_blocks;\n416\t    uint32_t row = x_int * common_ctx.num_y + y_int;\n417\t    uint32_t m = mono_block * blockDim.x + threadIdx.x;\n418\t\n419\t    FpExt sum(Fp::zero());\n420\t    if (y_int < common_ctx.num_y && m < ctx.num_monomials) {\n421\t        MonomialHeader hdr = ctx.d_headers[m];\n422\t        FpExt monomial = ctx.d_combinations[m];\n423\t        for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n424\t            PackedVar var = ctx.d_variables[hdr.var_offset + v];\n425\t            monomial *= eval_variable(var, row, common_ctx.eval_ctx, height);\n426\t        }\n427\t        sum = monomial * common_ctx.d_eq_xi[y_int];\n428\t    }\n429\t\n430\t    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n431\t\n432\t    if (threadIdx.x == 0) {\n433\t        if constexpr (IS_DENOM) {\n434\t            if (mono_block == 0 && y_int < common_ctx.num_y) {\n435\t                reduced += common_ctx.bus_term_sum * common_ctx.d_eq_xi[y_int];\n436\t            }\n437\t            tmp_sums[blockIdx.x * num_x + x_int].q = reduced;\n438\t        } else {\n439\t            tmp_sums[blockIdx.x * num_x + x_int].p = reduced;\n440\t        }\n441\t    }\n442\t}\n443\t\n444\textern \"C\" int _logup_monomial_batched(\n445\t    FracExt *tmp_sums,\n446\t    FracExt *output,\n447\t    const BlockCtx *block_ctxs,\n448\t    const LogupMonomialCommonCtx *common_ctxs,\n449\t    const LogupMonomialCtx *numer_ctxs,\n450\t    const LogupMonomialCtx *denom_ctxs,\n451\t    const uint32_t *air_block_offsets,\n452\t    uint32_t num_blocks,\n453\t    uint32_t num_x,\n454\t    uint32_t num_airs,\n455\t    uint32_t threads_per_block\n456\t) {\n457\t    if (num_blocks == 0)\n458\t        return 0;\n459\t\n460\t    dim3 grid(num_blocks, num_x);\n461\t    dim3 block(threads_per_block);\n462\t    size_t shmem = div_ceil(threads_per_block, WARP_SIZE) * sizeof(FpExt);\n463\t\n464\t    // Phase 1: Evaluate numerator monomials\n465\t    logup_monomial_kernel<false><<<grid, block, shmem>>>(\n466\t        tmp_sums, block_ctxs, common_ctxs, numer_ctxs\n467\t    );\n468\t    int err = CHECK_KERNEL();\n469\t    if (err != 0)\n470\t        return err;\n471\t\n472\t    // Phase 1b: Evaluate denominator monomials\n473\t    logup_monomial_kernel<true><<<grid, block, shmem>>>(\n474\t        tmp_sums, block_ctxs, common_ctxs, denom_ctxs\n475\t    );\n476\t    err = CHECK_KERNEL();\n477\t    if (err != 0)\n478\t        return err;\n479\t\n480\t    // Phase 2: Batched reduction\n481\t    // FracExt = (FpExt, FpExt) so treat as 2 * num_x elements per AIR\n482\t    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n483\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n484\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n485\t\n486\t    dim3 reduce_grid(num_airs, 2 * num_x);\n487\t    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n488\t        reinterpret_cast<FpExt *>(tmp_sums),\n489\t        reinterpret_cast<FpExt *>(output),\n490\t        air_block_offsets,\n491\t        2 * num_x\n492\t    );\n493\t\n494\t    return CHECK_KERNEL();\n495\t}\n496\t\n497\t} // namespace logup_zerocheck_mle\n498\t"}]},"parent_tool_use_id":"toolu_01FvhCB93jqt4LU48te2ZGuN","session_id":"997f7e33-9a1a-40a3-8498-75cdc1cf5ede","uuid":"e6c3e53c-b1e5-4e2d-96ad-94b91f03c99a","timestamp":"2026-04-14T21:24:04.005Z"}
