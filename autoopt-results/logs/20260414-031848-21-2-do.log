{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MWPmc6qs2aRjEbcjkqPJXq","type":"tool_result","content":"1\tuse std::{ffi::c_void, fmt::Debug, ptr};\n2\t\n3\tuse crate::{\n4\t    copy::MemCopyD2H,\n5\t    error::{check, CudaError},\n6\t    memory_manager::{d_free, d_malloc},\n7\t    stream::{cudaStreamPerThread, cudaStream_t},\n8\t};\n9\t\n10\t#[link(name = \"cudart\")]\n11\textern \"C\" {\n12\t    pub fn cudaMemsetAsync(dst: *mut c_void, value: i32, count: usize, stream: cudaStream_t)\n13\t        -> i32;\n14\t}\n15\t\n16\t/// Struct that owns a buffer allocated on GPU device. The struct only holds the raw pointer and\n17\t/// length, but this struct has a `Drop` implementation which frees the associated device memory.\n18\t#[repr(C)]\n19\tpub struct DeviceBuffer<T> {\n20\t    ptr: *mut T,\n21\t    len: usize,\n22\t}\n23\t\n24\t/// A struct that packs a pointer with a size in bytes to pass on CUDA.\n25\t/// It holds `*const c_void` for being a universal simple type that can be read by CUDA.\n26\t/// Since it is hard to enforce immutability preservation, it just holds `*const`,\n27\t/// but has two separate constructors for more robustness from the usage perspective.\n28\t/// This is essentially a [DeviceBuffer] but without owning the data.\n29\t#[repr(C)]\n30\t#[derive(Debug, Copy, Clone)]\n31\tpub struct DeviceBufferView {\n32\t    pub ptr: *const c_void,\n33\t    pub size: usize,\n34\t}\n35\t\n36\tunsafe impl<T> Send for DeviceBuffer<T> {}\n37\tunsafe impl<T> Sync for DeviceBuffer<T> {}\n38\t\n39\timpl<T> DeviceBuffer<T> {\n40\t    /// Creates an \"empty\" DeviceBuffer with a null pointer and zero length.\n41\t    #[allow(clippy::new_without_default)]\n42\t    pub fn new() -> Self {\n43\t        DeviceBuffer {\n44\t            ptr: ptr::null_mut(),\n45\t            len: 0,\n46\t        }\n47\t    }\n48\t\n49\t    /// # Safety\n50\t    /// - The caller must ensure that the pointer `ptr` is valid for `len` elements of type `T` in\n51\t    ///   device memory.\n52\t    /// - Dropping the constructed buffer will attempt to free the memory. As such, `ptr` must\n53\t    ///   either have been allocated by the internal memory manager (VPMM) or the caller must use\n54\t    ///   `ManuallyDrop` to prevent double-free.\n55\t    pub unsafe fn from_raw_parts(ptr: *mut T, len: usize) -> Self {\n56\t        DeviceBuffer { ptr, len }\n57\t    }\n58\t\n59\t    /// Allocate device memory for `len` elements of type `T`.\n60\t    pub fn with_capacity(len: usize) -> Self {\n61\t        tracing::debug!(\n62\t            \"Creating device buffer of size {} (sizeof type = {})\",\n63\t            len,\n64\t            size_of::<T>()\n65\t        );\n66\t        assert_ne!(len, 0, \"Zero capacity request is wrong\");\n67\t        let size_bytes = std::mem::size_of::<T>() * len;\n68\t        let raw_ptr = d_malloc(size_bytes).expect(\"GPU allocation failed\");\n69\t        #[cfg(feature = \"touchemall\")]\n70\t        {\n71\t            // 0xffffffff is `Fp::invalid()` and shouldn't occur in a trace\n72\t            unsafe {\n73\t                cudaMemsetAsync(raw_ptr, 0xff, size_bytes, cudaStreamPerThread);\n74\t            }\n75\t        }\n76\t        let typed_ptr = raw_ptr as *mut T;\n77\t\n78\t        DeviceBuffer {\n79\t            ptr: typed_ptr,\n80\t            len,\n81\t        }\n82\t    }\n83\t\n84\t    /// Fills the buffer with zeros.\n85\t    pub fn fill_zero(&self) -> Result<(), CudaError> {\n86\t        assert_ne!(self.len, 0, \"Empty buffer\");\n87\t        let size_bytes = std::mem::size_of::<T>() * self.len;\n88\t        check(unsafe { cudaMemsetAsync(self.as_mut_raw_ptr(), 0, size_bytes, cudaStreamPerThread) })\n89\t    }\n90\t\n91\t    /// Fills a suffix of the buffer with zeros.\n92\t    /// The `start_idx` is the index in the buffer, in `T` elements.\n93\t    pub fn fill_zero_suffix(&self, start_idx: usize) -> Result<(), CudaError> {\n94\t        assert!(\n95\t            start_idx < self.len,\n96\t            \"start index has to be smaller than length\"\n97\t        );\n98\t        let size_bytes = std::mem::size_of::<T>() * (self.len - start_idx);\n99\t        check(unsafe {\n100\t            cudaMemsetAsync(\n101\t                self.as_mut_ptr().add(start_idx) as *mut c_void,\n102\t                0,\n103\t                size_bytes,\n104\t                cudaStreamPerThread,\n105\t            )\n106\t        })\n107\t    }\n108\t\n109\t    /// Returns the number of elements in this buffer.\n110\t    pub fn len(&self) -> usize {\n111\t        self.len\n112\t    }\n113\t\n114\t    /// Returns whether the buffer is empty (null pointer or zero length).\n115\t    pub fn is_empty(&self) -> bool {\n116\t        self.len == 0 || self.ptr.is_null()\n117\t    }\n118\t\n119\t    /// Returns a raw mutable pointer to the device data (typed).\n120\t    pub fn as_mut_ptr(&self) -> *mut T {\n121\t        self.ptr\n122\t    }\n123\t\n124\t    /// Returns a raw const pointer to the device data (typed).\n125\t    pub fn as_ptr(&self) -> *const T {\n126\t        self.ptr as *const T\n127\t    }\n128\t\n129\t    /// Returns a `*mut c_void` (untyped) pointer.\n130\t    pub fn as_mut_raw_ptr(&self) -> *mut c_void {\n131\t        self.ptr as *mut c_void\n132\t    }\n133\t\n134\t    /// Returns a `*const c_void` (untyped) pointer.\n135\t    pub fn as_raw_ptr(&self) -> *const c_void {\n136\t        self.ptr as *const c_void\n137\t    }\n138\t\n139\t    /// Converts the buffer to a buffer of different type.\n140\t    /// `T` must be composable of `U`s.\n141\t    pub fn as_buffer<U>(mut self) -> DeviceBuffer<U> {\n142\t        assert_eq!(\n143\t            size_of::<T>() % size_of::<U>(),\n144\t            0,\n145\t            \"the underlying type size must divide the former one\"\n146\t        );\n147\t        assert_eq!(\n148\t            align_of::<T>() % align_of::<U>(),\n149\t            0,\n150\t            \"the underlying type alignment must divide the former one\""}]},"p