{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0121jXNnBHLZHi6VvpF7fi4C","type":"tool_result","content":"1\t#pragma once\n2\t\n3\t#include \"fp.h\"\n4\t#include \"fpext.h\"\n5\t#include \"launcher.cuh\"\n6\t#include <algorithm>\n7\t#include <cassert>\n8\t#include <cstddef>\n9\t#include <cstdint>\n10\t#include <utility>\n11\t#include <vector_types.h>\n12\t\n13\t// Shared implementation for coset-based round0 launch configs.\n14\t// Template parameter COSET_PARALLEL controls grid organization:\n15\t// - false (lockstep): grid.y = 1, each thread handles all cosets via NUM_COSETS template\n16\t// - true (coset-parallel): grid.y = num_cosets, each block handles one coset\n17\tnamespace round0_config_impl {\n18\t\n19\ttemplate <bool COSET_PARALLEL>\n20\tinline std::pair<dim3, dim3> eval_constraints_launch_params(\n21\t    uint32_t buffer_size,\n22\t    uint32_t skip_domain,\n23\t    uint32_t num_x,\n24\t    uint32_t num_cosets,\n25\t    size_t max_temp_bytes,\n26\t    uint32_t buffer_threshold,\n27\t    uint32_t max_threads_per_block\n28\t) {\n29\t    // ASSERTION: full skip domain must fit in one block\n30\t    assert(skip_domain <= 1024 && \"skip_domain exceeds CUDA max threads per block (1024)\");\n31\t    auto max_threads = std::max(skip_domain, max_threads_per_block);\n32\t    auto [grid, block] = kernel_launch_params(skip_domain * num_x, max_threads);\n33\t\n34\t    if constexpr (COSET_PARALLEL) {\n35\t        grid.y = num_cosets; // 2D grid for coset-parallel mode\n36\t    }\n37\t    // grid.y = 1 implicitly for lockstep mode\n38\t\n39\t    // Both modes have the same total buffer size:\n40\t    // - Lockstep: grid.x * block.x * num_cosets * buffer_size\n41\t    // - Coset-parallel: grid.x * grid.y * block.x * buffer_size (where grid.y = num_cosets)\n42\t    size_t desired_intermed_capacity_bytes =\n43\t        buffer_size <= buffer_threshold\n44\t            ? 0\n45\t            : (size_t)grid.x * block.x * num_cosets * buffer_size * sizeof(Fp);\n46\t\n47\t    uint32_t num_x_per_thread = std::max(\n48\t        div_ceil(desired_intermed_capacity_bytes, std::max(max_temp_bytes, (size_t)1)), (size_t)1\n49\t    );\n50\t    if (num_x_per_thread <= grid.x) {\n51\t        grid.x = grid.x / num_x_per_thread;\n52\t    } else {\n53\t        grid.x = 1;\n54\t        block.x = std::max(num_x / num_x_per_thread, 1u) * skip_domain;\n55\t    }\n56\t\n57\t    return {grid, block};\n58\t}\n59\t\n60\ttemplate <bool COSET_PARALLEL>\n61\tinline uint32_t temp_sums_buffer_size(\n62\t    uint32_t buffer_size,\n63\t    uint32_t skip_domain,\n64\t    uint32_t num_x,\n65\t    uint32_t num_cosets,\n66\t    size_t max_temp_bytes,\n67\t    uint32_t buffer_threshold,\n68\t    uint32_t threads_per_block\n69\t) {\n70\t    auto [grid, _] = eval_constraints_launch_params<COSET_PARALLEL>(\n71\t        buffer_size,\n72\t        skip_domain,\n73\t        num_x,\n74\t        num_cosets,\n75\t        max_temp_bytes,\n76\t        buffer_threshold,\n77\t        threads_per_block\n78\t    );\n79\t    // Output layout: [num_blocks][num_cosets * skip_domain]\n80\t    return grid.x * num_cosets * skip_domain;\n81\t}\n82\t\n83\ttemplate <bool COSET_PARALLEL>\n84\tinline uint32_t intermediates_buffer_size(\n85\t    uint32_t buffer_size,\n86\t    uint32_t skip_domain,\n87\t    uint32_t num_x,\n88\t    uint32_t num_cosets,\n89\t    size_t max_temp_bytes,\n90\t    uint32_t buffer_threshold,\n91\t    uint32_t threads_per_block\n92\t) {\n93\t    if (buffer_size <= buffer_threshold) {\n94\t        return 0;\n95\t    }\n96\t    auto [grid, block] = eval_constraints_launch_params<COSET_PARALLEL>(\n97\t        buffer_size,\n98\t        skip_domain,\n99\t        num_x,\n100\t        num_cosets,\n101\t        max_temp_bytes,\n102\t        buffer_threshold,\n103\t        threads_per_block\n104\t    );\n105\t    // Layout: [buffer_size][num_threads][num_cosets]\n106\t    return grid.x * block.x * buffer_size * num_cosets;\n107\t}\n108\t\n109\t} // namespace round0_config_impl\n110\t\n111\t// Lockstep mode: 1D grid (grid.x blocks), each thread handles ALL cosets via NUM_COSETS template.\n112\tnamespace coset_round0_config {\n113\t\n114\tinline std::pair<dim3, dim3> eval_constraints_launch_params(\n115\t    uint32_t buffer_size,\n116\t    uint32_t skip_domain,\n117\t    uint32_t num_x,\n118\t    uint32_t num_cosets,\n119\t    size_t max_temp_bytes,\n120\t    uint32_t buffer_threshold,\n121\t    uint32_t max_threads_per_block\n122\t) {\n123\t    return round0_config_impl::eval_constraints_launch_params<false>(\n124\t        buffer_size,\n125\t        skip_domain,\n126\t        num_x,\n127\t        num_cosets,\n128\t        max_temp_bytes,\n129\t        buffer_threshold,\n130\t        max_threads_per_block\n131\t    );\n132\t}\n133\t\n134\t} // namespace coset_round0_config\n135\t\n136\t// Coset-parallel mode: 2D grid (grid.x * grid.y where grid.y = num_cosets),\n137\t// each block handles ONE coset identified by blockIdx.y.\n138\tnamespace coset_parallel_round0_config {\n139\t\n140\tinline std::pair<dim3, dim3> eval_constraints_launch_params(\n141\t    uint32_t buffer_size,\n142\t    uint32_t skip_domain,\n143\t    uint32_t num_x,\n144\t    uint32_t num_cosets,\n145\t    size_t max_temp_bytes,\n146\t    uint32_t buffer_threshold,\n147\t    uint32_t max_threads_per_block\n148\t) {\n149\t    return round0_config_impl::eval_constraints_launch_params<true>(\n150\t        buffer_size,\n151\t        skip_domain,\n152\t        num_x,\n153\t        num_cosets,\n154\t        max_temp_bytes,\n155\t        buffer_threshold,\n156\t        max_threads_per_block\n157\t    );\n158\t}\n159\t\n160\t} // namespace coset_parallel_round0_config\n161\t\n162\t// Launch strategy: linearize (x_int, z_int) into a 1D threadIdx.x to keep warps aligned on x_int.\n163\t// We tile z within a block (up to WARP_SIZE) and use the remaining threads for x; grid.x scales x\n164\t// based on max_temp_bytes, accounting for both temp sum buffer and (optional) intermediates spill.\n165\tnamespace align_x_round0_config {\n166\t\n167\t// Returns {zs_per_grid, zs_per_block}\n168\t// NOTE: it is best for avoiding warp divergence that `large_domain` is a multiple of `WARP_SIZE` (32).\n169\tinline std::pair<uint32_t, uint32_t> get_z_dim(uint32_t large_domain) {\n170\t    // Since we are currently not using any shared memory in relation to the `z_int` variable, the only\n171\t    // important factor is that every thread in a warp shares the same `x_int`.\n172\t    // NOTE: when `large_domain < WARP_SIZE`, there is unavoidable warp divergence, so we just optimize\n173\t    // for packing as much into the block as possible.\n174\t    uint32_t zs_per_block = std::min(large_domain, static_cast<uint32_t>(WARP_SIZE));\n175\t    uint32_t zs_per_grid = div_ceil(large_domain, zs_per_block);\n176\t    return {zs_per_grid, zs_per_block};\n177\t}\n178\t\n179\tinline std::pair<dim3, dim3> eval_constraints_launch_params(\n180\t    uint32_t buffer_size,\n181\t    uint32_t large_domain, // range of z_int\n182\t    uint32_t num_x,        // range of x_int\n183\t    size_t max_temp_bytes,\n184\t    uint32_t buffer_threshold, // threshold for switching intermediate buffer to global memory\n185\t    uint32_t threads_per_block\n186\t) {\n187\t    auto [zs_per_grid, zs_per_block] = get_z_dim(large_domain);\n188\t    auto xs_per_block =\n189\t        std::min(static_cast<size_t>(num_x), div_ceil(threads_per_block, zs_per_block));\n190\t    dim3 block(xs_per_block * zs_per_block);\n191\t    // We will define grid = xs_per_grid * zs_per_grid, where varying xs_per_grid affects the global\n192\t    // memory usage.\n193\t    // `temp_sums_buffer_size` is `xs_per_grid * large_domain`\n194\t    size_t scale_factor = large_domain;\n195\t    if (buffer_size > buffer_threshold) {\n196\t        // This mean global memory is used.\n197\t        // `intermediates_buffer_size` is `xs_per_grid * xs_per_block * large_domain * buffer_size`\n198\t        scale_factor += static_cast<size_t>(xs_per_block) * large_domain * buffer_size;\n199\t    }\n200\t    size_t xs_per_grid = max_temp_bytes / (scale_factor * sizeof(FpExt));\n201\t    // Failsafe to ensure kernel doesn't fail:\n202\t    xs_per_grid = std::max(xs_per_grid, static_cast<size_t>(1));\n203\t    xs_per_grid = std::min(xs_per_grid, div_ceil(num_x, xs_per_block));\n204\t    dim3 grid(xs_per_grid * zs_per_grid);\n205\t\n206\t    return {grid, block};\n207\t}\n208\t\n209\tinline size_t temp_sums_buffer_size(\n210\t    uint32_t buffer_size,\n211\t    uint32_t large_domain,\n212\t    uint32_t num_x,\n213\t    size_t max_temp_bytes,\n214\t    uint32_t buffer_threshold,\n215\t    uint32_t threads_per_block\n216\t) {\n217\t    auto [grid, block] = eval_constraints_launch_params(\n218\t        buffer_size, large_domain, num_x, max_temp_bytes, buffer_threshold, threads_per_block\n219\t    );\n220\t    (void)block;\n221\t    auto [zs_per_grid, zs_per_block] = get_z_dim(large_domain);\n222\t    (void)zs_per_block;\n223\t    auto xs_per_grid = grid.x / zs_per_grid;\n224\t    return static_cast<size_t>(large_domain) * xs_per_grid;\n225\t}\n226\t\n227\tinline size_t intermediates_buffer_size(\n228\t    uint32_t buffer_size,\n229\t    uint32_t large_domain,\n230\t    uint32_t num_x,\n231\t    size_t max_temp_bytes,\n232\t    uint32_t buffer_threshold,\n233\t    uint32_t threads_per_block\n234\t) {\n235\t    if (buffer_size <= buffer_threshold) {\n236\t        return 0;\n237\t    }\n238\t    auto [grid, block] = eval_constraints_launch_params(\n239\t        buffer_size, large_domain, num_x, max_temp_bytes, buffer_threshold, threads_per_block\n240\t    );\n241\t    auto [zs_per_grid, zs_per_block] = get_z_dim(large_domain);\n242\t    auto xs_per_block = block.x / zs_per_block;\n243\t    auto xs_per_grid = grid.x / zs_per_grid;\n244\t    size_t task_stride = static_cast<size_t>(xs_per_grid) * xs_per_block * large_domain;\n245\t    return task_stride * buffer_size;\n246\t}\n247\t\n248\t} // namespace align_x_round0_config\n249\t\n250\tnamespace mle_rounds_config {\n251\tinline std::pair<dim3, dim3> eval_constraints_launch_params(\n252\t    uint32_t num_x,\n253\t    uint32_t num_y,\n254\t    size_t max_threads_per_block\n255\t) {\n256\t    auto threads_per_block = std::min(std::max(WARP_SIZE, (size_t)num_y), max_threads_per_block);\n257\t    auto num_blocks_for_y = div_ceil(num_y, threads_per_block);\n258\t    dim3 grid = dim3(num_blocks_for_y, num_x);\n259\t    dim3 block = dim3(threads_per_block);\n260\t    return {grid, block};\n261\t}\n262\t\n263\tinline size_t temp_sums_buffer_size(uint32_t num_x, uint32_t num_y, uint32_t threads_per_block) {\n264\t    auto [grid, block] = eval_constraints_launch_params(num_x, num_y, threads_per_block);\n265\t    (void)block;\n266\t    return static_cast<size_t>(grid.x) * grid.y;\n267\t}\n268\t\n269\tinline size_t intermediates_buffer_size(\n270\t    uint32_t buffer_size,\n271\t    uint32_t num_x,\n272\t    uint32_t num_y,\n273\t    uint32_t buffer_threshold,\n274\t    uint32_t threads_per_block\n275\t) {\n276\t    if (buffer_size <= buffer_threshold) {\n277\t        return 0;\n278\t    }\n279\t    auto [grid, block] = eval_constraints_launch_params(num_x, num_y, threads_per_block);\n280\t    return static_cast<size_t>(block.x) * grid.x * grid.y * buffer_size;\n281\t}\n282\t} // namespace mle_rounds_config\n283\t"}]},"parent_tool_use_id":"toolu_016M7eRkYKqcYkCBrzjWVo7j","session_id":"48b5d5bc-06ba-4812-85f4-27a650fcd6d2","uuid":"04cf5275-b270-4b58-82a4-f0b8491564a5","timestamp":"2026-04-14T04:39:50.158Z"}
