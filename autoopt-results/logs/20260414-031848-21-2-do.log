{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016nLYS8gXutLQU6yi1MXfzW","type":"tool_result","content":"1\t/*\n2\t * Source: https://github.com/risc0/risc0 (ref=b9bfc8ad3547d76e9304b630f2a935bbab01aa9d)\n3\t * Status: MODIFIED from risc0/sys/kernels/zkp/cuda/fp.h\n4\t * Imported: 2025-01-25 by @gaxiom\n5\t * \n6\t * LOCAL CHANGES (high level):\n7\t * - 2025-03-25: add TWO_ADIC_GENERATORS\n8\t * - 2025-06-02: add neg_one()\n9\t * - 2025-08-09: gcd inversion optimization\n10\t * - 2025-09-14: use sppark's bb31_t impl for core arithmetic operations\n11\t */\n12\t\n13\t// Copyright 2024 RISC Zero, Inc.\n14\t//\n15\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n16\t// you may not use this file except in compliance with the License.\n17\t// You may obtain a copy of the License at\n18\t//\n19\t//     http://www.apache.org/licenses/LICENSE-2.0\n20\t//\n21\t// Unless required by applicable law or agreed to in writing, software\n22\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n23\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n24\t// See the License for the specific language governing permissions and\n25\t// limitations under the License.\n26\t\n27\t#pragma once\n28\t\n29\t/// \\file\n30\t/// Defines the core finite field data type, Fp, and some free functions on the type.\n31\t\n32\t#include <cassert>\n33\t#include <cstdint>\n34\t#include \"ff/baby_bear.hpp\"\n35\t\n36\t/// The Fp class is an element of the finite field F_p, where P is the prime number 15*2^27 + 1.\n37\t/// Put another way, Fp is basically integer arithmetic modulo P.\n38\t///\n39\t/// The 'Fp' datatype is the core type of all of the operations done within the zero knowledge\n40\t/// proofs, and is smallest 'addressable' datatype, and the base type of which all composite types\n41\t/// are built.  In many ways, one can imagine it as the word size of a very strange architecture.\n42\t///\n43\t/// This specific prime P was chosen to:\n44\t/// - Be less than 2^31 so that it fits within a 32 bit word and doesn't overflow on addition.\n45\t/// - Otherwise have as large a power of 2 in the factors of P-1 as possible.\n46\t///\n47\t/// This last property is useful for number theoretical transforms (the fast fourier transform\n48\t/// equivalent on finite fields).  See NTT.h for details.\n49\t///\n50\t/// The Fp class wraps all the standard arithmetic operations to make the finite field elements look\n51\t/// basically like ordinary numbers (which they mostly are).\n52\tclass Fp : public bb31_t {\n53\t  public:\n54\t    /// The value of P, the modulus of Fp.\n55\t    static constexpr uint32_t P = 15 * (uint32_t(1) << 27) + 1; // bb31_t::MOD\n56\t    static constexpr uint32_t M = 0x88000001; // -bb31_t::M0\n57\t    static constexpr uint32_t R2 = 1172168163; // bb31_t::RR\n58\t    static constexpr uint32_t MONTY_BITS = 32;\n59\t    static constexpr uint32_t MONTY_MASK = 0xffffffff; // uint32_t((uint64_t(1) << MONTY_BITS) - 1);\n60\t    static constexpr uint32_t HALF_P_PLUS_1 = (P + 1) >> 1;\n61\t    static constexpr uint32_t TWO_ADICITY = 27;\n62\t    // Precomputed inverse of 2^(2*FIELD_BITS - 2) mod P for FIELD_BITS = 31\n63\t    // FIELD_BITS = 31, so k = 2*FIELD_BITS - 2 = 60\n64\t    // INV_2EXP_K = (2^k)^(-1) mod P\n65\t    static constexpr uint32_t INV_2EXP_K = 975175684u;\n66\t\n67\tprivate:\n68\t    __device__ uint32_t val() const {\n69\t        return static_cast<uint32_t>(*this);\n70\t    }\n71\t\n72\tpublic:\n73\t    /// Add default constructor explicitly\n74\t    __device__ constexpr Fp() : bb31_t(0) {}\n75\t    \n76\t    /// Constructor from bb31_t for explicit conversion\n77\t    __device__ explicit constexpr Fp(const bb31_t& b) : bb31_t(b) {}\n78\t\n79\t    /// Constructor from bb31_base for implicit conversion\n80\t    __device__ Fp(const bb31_base& b) : bb31_t(b) {}\n81\t\n82\t    /// Constructor from uint32_t that forces encoding\n83\t    __host__ __device__ constexpr Fp(uint32_t v) : bb31_t(static_cast<int>(v)) {}\n84\t\n85\t    /// Constructor from any numerical type that forces encoding\n86\t    template <class I, std::enable_if_t<std::is_integral_v<I>, int> = 0>\n87\t    __host__ __device__ constexpr Fp(I v) : bb31_t(static_cast<int>(v)) {}\n88\t\n89\t    /// Construct an Fp from an already-encoded raw value\n90\t    __device__ static constexpr Fp fromRaw(uint32_t val) { \n91\t        return Fp(bb31_t(val));\n92\t    }\n93\t\n94\t    /// Fp with zero value\n95\t    __device__ static constexpr Fp zero() { return Fp(0); }\n96\t\n97\t    /// Fp with one value\n98\t    __device__ static constexpr Fp one() { return Fp(1); }\n99\t\n100\t    /// Fp with negative one value\n101\t    __device__ static constexpr Fp neg_one() { return maxVal(); }\n102\t\n103\t    /// Convert to a uint32_t\n104\t    __device__ uint32_t asUInt32() const { return val(); }\n105\t\n106\t    /// Return the raw underlying word\n107\t    __device__ uint32_t asRaw() const { return bb31_t::operator*(); }\n108\t\n109\t    /// Get the largest value, basically P - 1.\n110\t    __device__ static constexpr Fp maxVal() { return P - 1; }\n111\t\n112\t    /// Get an 'invalid' Fp value\n113\t    __device__ static constexpr Fp invalid() { return Fp::fromRaw(0xfffffffful); }\n114\t\n115\t    /// get value\n116\t    __device__ uint32_t get() const { return asRaw(); }\n117\t\n118\t    /// force set the value\n119\t    __device__ void set(uint32_t input) { bb31_t::operator=(input); }\n120\t\n121\t    /// Equality operators\n122\t    friend __device__ inline bool operator==(const Fp& a, const Fp& b) {\n123\t        return a.asRaw() == b.asRaw();\n124\t    }\n125\t    friend __device__ inline bool operator!=(const Fp& a, const Fp& b) {\n126\t        return a.asRaw() != b.asRaw();\n127\t    }\n128\t    friend __device__ inline bool operator==(const Fp& a, int b) {\n129\t        return a.asRaw() == Fp(b).asRaw();\n130\t    }\n131\t    friend __device__ inline bool operator==(int a, const Fp& b) {\n132\t        return Fp(a).asRaw() == b.asRaw();\n133\t    }\n134\t\n135\t    /// Comparison operators\n136\t    __device__ bool operator<(Fp rhs) const { return val() < rhs.val(); }\n137\t\n138\t    __device__ bool operator<=(Fp rhs) const { return val() <= rhs.val(); }\n139\t\n140\t    __device__ bool operator>(Fp rhs) const { return val() > rhs.val(); }\n141\t\n142\t    __device__ bool operator>=(Fp rhs) const { return val() >= rhs.val(); }\n143\t\n144\t    // Post-inc/dec\n145\t    __device__ Fp operator++(int) {\n146\t        Fp r = *this;\n147\t        *this += Fp::one();\n148\t        return r;\n149\t    }\n150\t\n151\t    __device__ Fp operator--(int) {\n152\t        Fp r = *this;\n153\t        *this -= Fp::one();\n154\t        return r;\n155\t    }\n156\t\n157\t    // Pre-inc/dec\n158\t    __device__ Fp operator++() {\n159\t        *this += Fp::one();\n160\t        return *this;\n161\t    }\n162\t\n163\t    __device__ Fp operator--() {\n164\t        *this -= Fp::one();\n165\t        return *this;\n166\t    }\n167\t\n168\t    /// Given an element x from a 31 bit field F_P compute x/2.\n169\t    /// The input must be in [0, P).\n170\t    /// The output will also be in [0, P).\n171\t    static __device__ inline uint32_t halve_u32(uint32_t input) {\n172\t        uint32_t shr = input >> 1;\n173\t        uint32_t lo_bit = input & 1;\n174\t        return shr + (lo_bit * HALF_P_PLUS_1); // optimized for cuda\n175\t                                               // uint32_t shr_corr = shr + HALF_P_PLUS_1;\n176\t                                               // if (lo_bit == 0) {\n177\t                                               //   return shr;\n178\t                                               // } else {\n179\t                                               //   return shr_corr;\n180\t                                               // }\n181\t    }\n182\t\n183\t    /// monty_reduce from Plonky3: monty-31/src/utils.rs\n184\t    static __device__ uint32_t monty_reduce(uint64_t x) {\n185\t        uint64_t t = (x * uint64_t(Fp::M)) & uint64_t(Fp::MONTY_MASK);\n186\t        uint64_t u = t * uint64_t(Fp::P);\n187\t\n188\t        uint64_t x_sub_u = x - u;\n189\t        bool overflow = x < u; // overflowing_sub\n190\t\n191\t        uint32_t x_sub_u_hi = uint32_t(x_sub_u >> Fp::MONTY_BITS);\n192\t        uint32_t corr = overflow ? (Fp::P) : 0;\n193\t        return x_sub_u_hi + corr;\n194\t    }\n195\t\n196\t  public:\n197\t    /// Return a new Fp that is double of this value\n198\t    /// We use `doubled` here since 'double' is a C++ reserved keyword\n199\t    __device__ Fp doubled() const { return *this + *this; }\n200\t\n201\t    /// Return a new Fp that is half of this value\n202\t    __device__ Fp halve() const { return Fp::fromRaw(halve_u32(asRaw())); }\n203\t\n204\t    /// Multiply the given MontyField31 element by `2^{-n}`.\n205\t    ///\n206\t    /// This makes use of the fact that, as the monty constant is `2^32`,\n207\t    /// the monty form of `2^{-n}` is `2^{32 - n}`. Monty reduction works\n208\t    /// provided the input is `< 2^32P` so this works for `0 <= n <= 32`.\n209\t    __device__ Fp mul_2exp_neg_n(uint32_t n) const {\n210\t        assert(n < 33 && \"n must be less than 33\");\n211\t        uint64_t value_mul_2exp_neg_n = static_cast<uint64_t>(asRaw()) << (32 - n);\n212\t        return Fp::fromRaw(monty_reduce(value_mul_2exp_neg_n));\n213\t    }\n214\t};\n215\t\n216\t/// Raise an value to a power\n217\t__device__ inline Fp pow(Fp x, uint32_t n) {\n218\t    return Fp(static_cast<bb31_t>(x) ^ n);\n219\t}\n220\t\n221\ttemplate <class I, std::enable_if_t<std::is_integral_v<I>, int> = 0>\n222\t__device__ inline Fp pow(Fp x, I n) {\n223\t    return pow(x, static_cast<uint32_t>(n));\n224\t}\n225\t\n226\t/// Helper: gcd-based inversion for 32-bit prime fields with FIELD_BITS <= 32.\n227\t/// Returns v = 2^{2*FIELD_BITS - 2} * a^{-1} mod P where FIELD_BITS = 31 and P is odd prime.\n228\t/// Copied from Plonky3: https://github.com/Plonky3/Plonky3/pull/921\n229\tstatic __device__ inline int64_t gcd_inversion_prime_field_32(uint32_t a, uint32_t b) {\n230\t    int64_t u = 1;\n231\t    int64_t v = 0;\n232\t    // FIELD_BITS = 31 => iterate 2*FIELD_BITS - 2 = 60 times\n233\t    for (uint32_t i = 0; i < 60; i++) {\n234\t        if ((a & 1u) != 0u) {\n235\t            if (a < b) {\n236\t                // temp variable swap for a, b and u, v\n237\t                uint32_t tmp_ab = a;\n238\t                a = b;\n239\t                b = tmp_ab;\n240\t                int64_t tmp_uv = u;\n241\t                u = v;\n242\t                v = tmp_uv;\n243\t            }\n244\t            a -= b;\n245\t            u -= v;\n246\t        }\n247\t        a >>= 1;\n248\t        v <<= 1;\n249\t    }\n250\t    return v;\n251\t}\n252\t\n253\t/// Compute the multiplicative inverse of x, or `1/x` in finite field terms, using a fast\n254\t/// gcd-based algorithm specialized for 31-bit prime P.\n255\t/// For x = 0, returns 0.\n256\t/// WARNING: GCD algorithm has warp divergence on GPU - prefer inv_fermat() for better performance.\n257\t__device__ inline Fp inv_gcd(Fp x) {\n258\t    if (x.asRaw() == 0u) {\n259\t        return Fp::zero();\n260\t    }\n261\t\n262\t    uint32_t a = x.asUInt32();\n263\t    int64_t v = gcd_inversion_prime_field_32(a, Fp::P);\n264\t    // Bring v into [0, P)\n265\t    int64_t v_mod = v % static_cast<int64_t>(Fp::P);\n266\t    if (v_mod < 0) {\n267\t        v_mod += static_cast<int64_t>(Fp::P);\n268\t    }\n269\t\n270\t    return Fp(static_cast<uint32_t>(v_mod)) * Fp(Fp::INV_2EXP_K);\n271\t}\n272\t\n273\t/// Compute the multiplicative inverse of x using Fermat's little theorem: x^(-1) = x^(P-2) mod P.\n274\t/// Uses optimized addition chain from bb31_t::reciprocal().\n275\t/// For x = 0, returns 0.\n276\t/// This is GPU-friendly: no branches, uniform control flow across warps.\n277\t__device__ inline Fp inv_fermat(Fp x) {\n278\t    if (x.asRaw() == 0u) {\n279\t        return Fp::zero();\n280\t    }\n281\t    // bb31_t::reciprocal() computes x^(P-2) using optimized addition chain:\n282\t    // ~31 squarings + 7 multiplications, no branches\n283\t    return Fp(static_cast<bb31_t>(x).reciprocal());\n284\t}\n285\t\n286\t/// Default inv() - uses Fermat's method for GPU-friendly performance\n287\t__device__ inline Fp inv(Fp x) {\n288\t    return inv_fermat(x);\n289\t}\n290\t\n291\tconstexpr __device__ Fp TWO_ADIC_GENERATORS[Fp::TWO_ADICITY + 1] = {\n292\t    Fp(0x1),        // Fp(0x0ffffffeu),\n293\t    Fp(0x78000000), // Fp(0x68000003u),\n294\t    Fp(0x67055c21), // Fp(0x1c38d511u),\n295\t    Fp(0x5ee99486), // Fp(0x3d85298fu),\n296\t    Fp(0xbb4c4e4),  // Fp(0x5f06e481u),\n297\t    Fp(0x2d4cc4da), // Fp(0x3f5c39ecu),\n298\t    Fp(0x669d6090), // Fp(0x5516a97au),\n299\t    Fp(0x17b56c64), // Fp(0x3d6be592u),\n300\t    Fp(0x67456167), // Fp(0x5bb04149u),\n301\t    Fp(0x688442f9), // Fp(0x4907f9abu),\n302\t    Fp(0x145e952d), // Fp(0x548b8e90u),\n303\t    Fp(0x4fe61226), // Fp(0x1d8ca617u),\n304\t    Fp(0x4c734715), // Fp(0x2ce7f0e6u),\n305\t    Fp(0x11c33e2a), // Fp(0x621b371fu),\n306\t    Fp(0x62c3d2b1), // Fp(0x6d4d2d78u),\n307\t    Fp(0x77cad399), // Fp(0x18716fcdu),\n308\t    Fp(0x54c131f4), // Fp(0x3b30a682u),\n309\t    Fp(0x4cabd6a6), // Fp(0x1c6f4728u),\n310\t    Fp(0x5cf5713f), // Fp(0x59b01f7cu),\n311\t    Fp(0x3e9430e8), // Fp(0x1a7f97acu),\n312\t    Fp(0xba067a3),  // Fp(0x0732561cu),\n313\t    Fp(0x18adc27d), // Fp(0x2b5a1cd4u),\n314\t    Fp(0x21fd55bc), // Fp(0x6f7d26f9u),\n315\t    Fp(0x4b859b3d), // Fp(0x16e2f919u),\n316\t    Fp(0x3bd57996), // Fp(0x285ab85bu),\n317\t    Fp(0x4483d85a), // Fp(0x0dd5a9ecu),\n318\t    Fp(0x3a26eef8), // Fp(0x43f13568u),\n319\t    Fp(0x1a427a41)  // Fp(0x57fab6eeu)\n320\t};\n321\t\n322\tstatic_assert(std::is_trivially_copyable<Fp>::value, \"Fp must be POD-ish\");\n323\tstatic_assert(sizeof(Fp) == 4, \"Fp must be 4 bytes\");\n324\tstatic_assert(alignof(Fp) == 4, \"Fp must be 4-byte aligned\");\n325\tstatic_assert(sizeof(Fp) == sizeof(bb31_t), \"Fp and bb31_t sizes must match\");\n326\tstatic_assert(alignof(Fp) == alignof(bb31_t), \"Fp and bb31_t align must match\");"}]},"parent_tool_use_id":"toolu_016M7eRkYKqcYkCBrzjWVo7j","session_id":"48b5d5bc-06ba-4812-85f4-27a650fcd6d2","uuid":"cb733d25-a575-4259-9301-ed2039e34d73","timestamp":"2026-04-14T04:39:32.836Z"}
