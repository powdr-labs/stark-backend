{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P4cfCpUdTNCEhdZUdLJegb","type":"tool_result","content":"1\t#include <algorithm>\n2\t#include <cassert>\n3\t#include <cmath>\n4\t#include <cstdint>\n5\t#include <cstdio>\n6\t#include <cstdlib>\n7\t#include <utility>\n8\t#include <vector_types.h>\n9\t\n10\t#include \"codec.cuh\"\n11\t#include \"dag_entry.cuh\"\n12\t#include \"eval_config.cuh\"\n13\t#include \"fp.h\"\n14\t#include \"fpext.h\"\n15\t#include \"launcher.cuh\"\n16\t#include \"sumcheck.cuh\"\n17\t#include \"utils.cuh\"\n18\t\n19\tusing namespace symbolic_dag;\n20\t\n21\tnamespace zerocheck_round0 {\n22\t\n23\tconstexpr uint32_t BUFFER_THRESHOLD = 16;\n24\t// Threshold for switching between coset-parallel and lockstep modes.\n25\t// When num_x * skip_domain < threshold, use coset-parallel (grid.y = num_cosets) for better GPU utilization.\n26\t// When >= threshold, use lockstep (single thread handles all cosets) to avoid redundant iNTT.\n27\tconstexpr uint32_t COSET_PARALLEL_THRESHOLD = 32768; // 2^15\n28\t\n29\t// Device function to compute constraint sums for all cosets in lockstep with DAG traversal.\n30\t// This computes: sum(lambda_i * constraint_i) for all constraints, for each coset.\n31\t// NOTE: Using __inline__ instead of __forceinline__ to let compiler decide based on register pressure.\n32\ttemplate <uint32_t NUM_COSETS, bool NEEDS_SHMEM>\n33\t__device__ __inline__ void acc_constraints(\n34\t    FpExt *__restrict__ constraint_sums, // output [NUM_COSETS]\n35\t    const NttEvalContext<NUM_COSETS> &eval_ctx,\n36\t    const Fp *is_first, // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n37\t    const Fp *is_last,  // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n38\t    uint32_t x_int,\n39\t    const FpExt *__restrict__ d_lambda_pows,\n40\t    const Rule *__restrict__ d_rules,\n41\t    size_t rules_len,\n42\t    const size_t *__restrict__ d_used_nodes,\n43\t    size_t used_nodes_len,\n44\t    size_t lambda_len\n45\t) {\n46\t    size_t lambda_idx = 0;\n47\t\n48\t    // Initialize constraint sums to zero\n49\t#pragma unroll\n50\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n51\t        constraint_sums[c] = FpExt(Fp::zero());\n52\t    }\n53\t\n54\t    for (size_t node = 0; node < rules_len; ++node) {\n55\t        Rule rule = d_rules[node];\n56\t        // Lazy decoding: only decode header (op, flags, x) upfront\n57\t        RuleHeader header = decode_rule_header(rule);\n58\t\n59\t        // Evaluate x operand for all cosets\n60\t        Fp x_vals[NUM_COSETS];\n61\t        ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(x_vals, header.x, eval_ctx, is_first, is_last, x_int);\n62\t\n63\t        switch (header.op) {\n64\t        case OP_ADD: {\n65\t            // Decode y only for binary ops\n66\t            SourceInfo y_src = decode_y(rule);\n67\t            Fp y_vals[NUM_COSETS];\n68\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n69\t#pragma unroll\n70\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n71\t                x_vals[c] += y_vals[c];\n72\t            }\n73\t            break;\n74\t        }\n75\t        case OP_SUB: {\n76\t            SourceInfo y_src = decode_y(rule);\n77\t            Fp y_vals[NUM_COSETS];\n78\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n79\t#pragma unroll\n80\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n81\t                x_vals[c] -= y_vals[c];\n82\t            }\n83\t            break;\n84\t        }\n85\t        case OP_MUL: {\n86\t            SourceInfo y_src = decode_y(rule);\n87\t            Fp y_vals[NUM_COSETS];\n88\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n89\t#pragma unroll\n90\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n91\t                x_vals[c] *= y_vals[c];\n92\t            }\n93\t            break;\n94\t        }\n95\t        case OP_NEG:\n96\t#pragma unroll\n97\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n98\t                x_vals[c] = -x_vals[c];\n99\t            }\n100\t            break;\n101\t        case OP_VAR:\n102\t            break;\n103\t        case OP_INV:\n104\t#pragma unroll\n105\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n106\t                x_vals[c] = inv(x_vals[c]);\n107\t            }\n108\t            break;\n109\t        }\n110\t\n111\t        // Store intermediate results for all cosets\n112\t        // Decode z_index only when buffering\n113\t        if (header.buffer_result && eval_ctx.buffer_size > 0) {\n114\t            uint32_t z_index = decode_z_index(rule);\n115\t#ifdef CUDA_DEBUG\n116\t            assert(z_index < eval_ctx.buffer_size);\n117\t#endif\n118\t            // Intermediate buffer layout: [buffer_size][NUM_COSETS] per thread\n119\t#pragma unroll\n120\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n121\t                eval_ctx.inter_buffer[z_index * eval_ctx.buffer_stride + c] = x_vals[c];\n122\t            }\n123\t        }\n124\t\n125\t        // Accumulate constraint sums\n126\t        if (header.is_constraint) {\n127\t            while (lambda_idx < lambda_len && lambda_idx < used_nodes_len &&\n128\t                   d_used_nodes[lambda_idx] == node) {\n129\t                FpExt lambda = d_lambda_pows[lambda_idx];\n130\t                lambda_idx++;\n131\t#pragma unroll\n132\t                for (uint32_t c = 0; c < NUM_COSETS; c++) {\n133\t                    constraint_sums[c] += lambda * x_vals[c];\n134\t                }\n135\t            }\n136\t        }\n137\t    }\n138\t}\n139\t\n140\t// NTT-based kernel: Each thread handles ALL cosets in lockstep.\n141\t// Grid: (num_x_blocks, 1) - no coset dimension\n142\t// Block: (skip_domain * x_per_block)\n143\t// Thread layout: ntt_idx = threadIdx.x % skip_domain, varies fastest\n144\t//\n145\t// Key optimization: iNTT is done ONCE per trace access, then coefficient is\n146\t// used for all coset shifts + forward NTTs.\n147\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n148\t__global__ void zerocheck_ntt_evaluate_constraints_kernel(\n149\t    FpExt *__restrict__ tmp_sums_buffer,   // [num_blocks][NUM_COSETS][skip_domain]\n150\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n151\t    const Fp *__restrict__ preprocessed,\n152\t    const Fp *const *__restrict__ main_parts,\n153\t    const FpExt *__restrict__ eq_cube, // [num_x]\n154\t    const FpExt *__restrict__ d_lambda_pows,\n155\t    const Fp *__restrict__ public_values,\n156\t    const Rule *__restrict__ d_rules,\n157\t    size_t rules_len,\n158\t    const size_t *__restrict__ d_used_nodes,\n159\t    size_t used_nodes_len,\n160\t    size_t lambda_len,\n161\t    uint32_t buffer_size,\n162\t    Fp *__restrict__ d_intermediates,\n163\t    uint32_t skip_domain,\n164\t    uint32_t num_x,\n165\t    uint32_t height,\n166\t    Fp g_shift\n167\t) {\n168\t    extern __shared__ char smem[];\n169\t    // Shared memory layout:\n170\t    // - FpExt[blockDim.x]: shared_sum for reduction (reused per coset)\n171\t    // - Fp[blockDim.x]: ntt_buffers (one skip_domain-sized buffer per x_int group, only when NEEDS_SHMEM)\n172\t    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem);\n173\t    Fp *ntt_buffers_base =\n174\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FpExt)) : nullptr;\n175\t\n176\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n177\t\n178\t    // Each x_int group within the block gets its own ntt_buffer slice\n179\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n180\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n181\t\n182\t    // Thread layout: ntt_idx varies fastest, then x_int\n183\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n184\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n185\t    uint32_t const x_int_base = tidx >> l_skip;\n186\t\n187\t    // Precompute values needed for all cosets\n188\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n189\t\n190\t    // Compute is_first_mult, is_last_mult for all cosets\n191\t    uint32_t const log_height_total = __ffs(height) - 1;\n192\t    uint32_t const log_segment = min(l_skip, log_height_total);\n193\t    uint32_t const segment_size = 1u << log_segment;\n194\t    uint32_t const log_stride = l_skip - log_segment;\n195\t\n196\t    Fp is_first_mult[NUM_COSETS];\n197\t    Fp is_last_mult[NUM_COSETS];\n198\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n199\t    Fp const omega_skip_ntt =\n200\t        (l_skip == 0) ? Fp::one() : device_ntt::get_twiddle(l_skip, ntt_idx);\n201\t\n202\t    Fp g_coset = g_shift; // g^1, will iterate g^2, g^3, ...\n203\t#pragma unroll\n204\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n205\t        Fp eval_point = g_coset * omega_skip_ntt;\n206\t        Fp omega = exp_power_of_2(eval_point, log_stride);\n207\t        is_first_mult[c] = avg_gp(omega, segment_size);\n208\t        is_last_mult[c] = avg_gp(omega * eta, segment_size);\n209\t        g_coset *= g_shift; // g^(c+2) for next iteration\n210\t    }\n211\t\n212\t    // Intermediate buffer setup\n213\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD * NUM_COSETS];\n214\t    Fp *inter_buffer;\n215\t    uint32_t buffer_stride;\n216\t    if constexpr (GLOBAL) {\n217\t        // Layout: [buffer_size][num_threads][NUM_COSETS]\n218\t        inter_buffer = d_intermediates + tidx * NUM_COSETS;\n219\t        buffer_stride = gridDim.x * blockDim.x * NUM_COSETS;\n220\t    } else {\n221\t        inter_buffer = local_buffer;\n222\t        buffer_stride = NUM_COSETS;\n223\t    }\n224\t\n225\t    // Accumulate sums for all cosets\n226\t    FpExt sums[NUM_COSETS] = {};\n227\t\n228\t    // blockDim.x is guaranteed to be a multiple of 2^l_skip\n229\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n230\t\n231\t    // Initialize eval_ctx once with loop-invariant fields\n232\t    NttEvalContext<NUM_COSETS> eval_ctx{\n233\t        preprocessed,\n234\t        main_parts,\n235\t        public_values,\n236\t        inter_buffer,\n237\t        ntt_buffer,\n238\t        {}, // omega_shifts - set once below\n239\t        skip_domain,\n240\t        height,\n241\t        buffer_stride,\n242\t        buffer_size,\n243\t        ntt_idx,\n244\t    };\n245\t    // Compute omega_shifts directly into context using iterative multiplication\n246\t    Fp const omega_shift_base = pow(g_shift, ntt_idx_rev);\n247\t    Fp omega_shift = omega_shift_base;\n248\t#pragma unroll\n249\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n250\t        eval_ctx.omega_shifts[c] = omega_shift;\n251\t        omega_shift *= omega_shift_base;\n252\t    }\n253\t\n254\t    // Tile across x_int to save intermediate buffer size\n255\t    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n256\t        // Compute per-iteration selectors as fresh local values\n257\t        Fp is_first[NUM_COSETS];\n258\t        Fp is_last[NUM_COSETS];\n259\t#pragma unroll\n260\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n261\t            is_first[c] = is_first_mult[c] * selectors_cube[x_int];\n262\t            is_last[c] = is_last_mult[c] * selectors_cube[2 * num_x + x_int];\n263\t        }\n264\t\n265\t        FpExt constraint_sums[NUM_COSETS];\n266\t        acc_constraints<NUM_COSETS, NEEDS_SHMEM>(\n267\t            constraint_sums,\n268\t            eval_ctx,\n269\t            is_first,\n270\t            is_last,\n271\t            x_int,\n272\t            d_lambda_pows,\n273\t            d_rules,\n274\t            rules_len,\n275\t            d_used_nodes,\n276\t            used_nodes_len,\n277\t            lambda_len\n278\t        );\n279\t\n280\t        FpExt eq = eq_cube[x_int];\n281\t#pragma unroll\n282\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n283\t            sums[c] += constraint_sums[c] * eq;\n284\t        }\n285\t    }\n286\t\n287\t    // Reduction: one coset at a time to minimize shared memory\n288\t    // Recompute eval_point and zerofier on demand (saves registers during main loop)\n289\t    g_coset = g_shift; // reset to g^1\n290\t#pragma unroll\n291\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n292\t        Fp eval_point = g_coset * omega_skip_ntt;\n293\t        Fp zerofier = exp_power_of_2(eval_point, l_skip) - Fp::one();\n294\t\n295\t        // We assume g_shift is not in skip domain and since we use (c+1) power,\n296\t        // eval_point is never in skip domain. Hence zerofier is never zero.\n297\t        shared_sum[threadIdx.x] = sums[c] * inv(zerofier);\n298\t        __syncthreads();\n299\t\n300\t        if (threadIdx.x < skip_domain) {\n301\t            FpExt tile_sum = shared_sum[threadIdx.x];\n302\t            for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n303\t                tile_sum += shared_sum[(lane << l_skip) + threadIdx.x];\n304\t            }\n305\t            // Output layout: [num_blocks][NUM_COSETS * skip_domain]\n306\t            // This matches final_reduce_block_sums expected layout [num_blocks][d]\n307\t            tmp_sums_buffer[blockIdx.x * NUM_COSETS * skip_domain + c * skip_domain + ntt_idx] =\n308\t                tile_sum;\n309\t        }\n310\t        __syncthreads();\n311\t        g_coset *= g_shift;\n312\t    }\n313\t}\n314\t\n315\t__global__ void fold_selectors_round0_kernel(\n316\t    FpExt *out,\n317\t    const Fp *in,\n318\t    FpExt is_first,\n319\t    FpExt is_last,\n320\t    uint32_t num_x\n321\t) {\n322\t    size_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n323\t    if (tidx >= num_x)\n324\t        return;\n325\t\n326\t    out[tidx] = is_first * in[tidx];                              // is_first\n327\t    out[2 * num_x + tidx] = is_last * in[2 * num_x + tidx];       // is_last\n328\t    out[num_x + tidx] = FpExt(Fp::one()) - out[2 * num_x + tidx]; // is_transition\n329\t}\n330\t\n331\t// Coset-parallel kernel: grid.y = num_cosets, each block handles ONE coset.\n332\t// Uses acc_constraints<1, NEEDS_SHMEM> with explicit parameter passing.\n333\t// Use when num_x * skip_domain is small for better GPU utilization.\n334\ttemplate <bool GLOBAL, bool NEEDS_SHMEM>\n335\t__global__ void zerocheck_ntt_evaluate_constraints_coset_parallel_kernel(\n336\t    FpExt *__restrict__ tmp_sums_buffer,   // [num_blocks][num_cosets * skip_domain]\n337\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n338\t    const Fp *__restrict__ preprocessed,\n339\t    const Fp *const *__restrict__ main_parts,\n340\t    const FpExt *__restrict__ eq_cube, // [num_x]\n341\t    const FpExt *__restrict__ d_lambda_pows,\n342\t    const Fp *__restrict__ public_values,\n343\t    const Rule *__restrict__ d_rules,\n344\t    size_t rules_len,\n345\t    const size_t *__restrict__ d_used_nodes,\n346\t    size_t used_nodes_len,\n347\t    size_t lambda_len,\n348\t    uint32_t buffer_size,\n349\t    Fp *__restrict__ d_intermediates,\n350\t    uint32_t skip_domain,\n351\t    uint32_t num_x,\n352\t    uint32_t height,\n353\t    Fp g_shift\n354\t) {\n355\t    extern __shared__ char smem[];\n356\t    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem);\n357\t    Fp *ntt_buffers_base =\n358\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FpExt)) : nullptr;\n359\t\n360\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n361\t    uint32_t const num_cosets = gridDim.y;\n362\t\n363\t    // Each x_int group within the block gets its own ntt_buffer slice\n364\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n365\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n366\t\n367\t    // Thread layout: ntt_idx varies fastest, then x_int\n368\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n369\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n370\t    uint32_t const x_int_base = tidx >> l_skip;\n371\t\n372\t    // KEY DIFFERENCE: coset_idx from blockIdx.y\n373\t    uint32_t const coset_idx = blockIdx.y;\n374\t\n375\t    // Precompute values for this single coset\n376\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n377\t\n378\t    uint32_t const log_height_total = __ffs(height) - 1;\n379\t    uint32_t const log_segment = min(l_skip, log_height_total);\n380\t    uint32_t const segment_size = 1u << log_segment;\n381\t    uint32_t const log_stride = l_skip - log_segment;\n382\t\n383\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n384\t    Fp const omega_skip_ntt =\n385\t        (l_skip == 0) ? Fp::one() : device_ntt::get_twiddle(l_skip, ntt_idx);\n386\t\n387\t    // Compute for single coset: g^(coset_idx + 1)\n388\t    Fp const g_coset = pow(g_shift, coset_idx + 1);\n389\t    Fp const eval_point = g_coset * omega_skip_ntt;\n390\t    Fp const omega = exp_power_of_2(eval_point, log_stride);\n391\t    Fp const is_first_mult = avg_gp(omega, segment_size);\n392\t    Fp const is_last_mult = avg_gp(omega * eta, segment_size);\n393\t    Fp const omega_shift = pow(g_coset, ntt_idx_rev);\n394\t\n395\t    // Intermediate buffer setup (single coset, no NUM_COSETS multiplier)\n396\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD];\n397\t    Fp *inter_buffer;\n398\t    uint32_t buffer_stride;\n399\t    if constexpr (GLOBAL) {\n400\t        // Layout: [buffer_size][num_cosets * num_threads_per_coset]\n401\t        uint32_t global_tidx = coset_idx * gridDim.x * blockDim.x + tidx;\n402\t        inter_buffer = d_intermediates + global_tidx;\n403\t        buffer_stride = gridDim.x * gridDim.y * blockDim.x;\n404\t    } else {\n405\t        inter_buffer = local_buffer;\n406\t        buffer_stride = 1;\n407\t    }\n408\t\n409\t    FpExt sum = FpExt(Fp::zero());\n410\t\n411\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n412\t\n413\t    // Single-coset context (NUM_COSETS=1), loop-invariant fields only\n414\t    NttEvalContext<1> eval_ctx{\n415\t        preprocessed,\n416\t        main_parts,\n417\t        public_values,\n418\t        inter_buffer,\n419\t        ntt_buffer,\n420\t        {omega_shift}, // omega_shifts[1]\n421\t        skip_domain,\n422\t        height,\n423\t        buffer_stride,\n424\t        buffer_size,\n425\t        ntt_idx,\n426\t    };\n427\t\n428\t    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n429\t        Fp is_first = is_first_mult * selectors_cube[x_int];\n430\t        Fp is_last = is_last_mult * selectors_cube[2 * num_x + x_int];\n431\t\n432\t        FpExt constraint_sums[1];\n433\t        acc_constraints<1, NEEDS_SHMEM>(\n434\t            constraint_sums,\n435\t            eval_ctx,\n436\t            &is_first,\n437\t            &is_last,\n438\t            x_int,\n439\t            d_lambda_pows,\n440\t            d_rules,\n441\t            rules_len,\n442\t            d_used_nodes,\n443\t            used_nodes_len,\n444\t            lambda_len\n445\t        );\n446\t\n447\t        sum += constraint_sums[0] * eq_cube[x_int];\n448\t    }\n449\t\n450\t    // Single-coset reduction (no loop over cosets)\n451\t    Fp zerofier = exp_power_of_2(eval_point, l_skip) - Fp::one();\n452\t    // We assume g_shift is not in skip domain and since we use (c+1) power,\n453\t    // eval_point is never in skip domain. Hence zerofier is never zero.\n454\t    shared_sum[threadIdx.x] = sum * inv(zerofier);\n455\t    __syncthreads();\n456\t\n457\t    if (threadIdx.x < skip_domain) {\n458\t        FpExt tile_sum = shared_sum[threadIdx.x];\n459\t        for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n460\t            tile_sum += shared_sum[(lane << l_skip) + threadIdx.x];\n461\t        }\n462\t        // Output layout: [num_x_blocks][num_cosets * skip_domain]\n463\t        // Same as lockstep to ensure final_reduce_block_sums works unchanged\n464\t        tmp_sums_buffer[blockIdx.x * num_cosets * skip_domain + coset_idx * skip_domain + ntt_idx] =\n465\t            tile_sum;\n466\t    }\n467\t}\n468\t\n469\t// ============================================================================\n470\t// LAUNCHERS\n471\t// ============================================================================\n472\tconstexpr uint32_t MAX_THREADS = 128;\n473\t\n474\t// Helper to determine which mode to use based on threshold\n475\tinline bool use_coset_parallel_mode(uint32_t num_x, uint32_t skip_domain) {\n476\t    return (num_x * skip_domain) < COSET_PARALLEL_THRESHOLD;\n477\t}\n478\t\n479\t// (Not a launcher) Utility function to calculate required size of temp sum buffer.\n480\t// Required length of *temp_sum_buffer in FpExt elements\n481\textern \"C\" size_t _zerocheck_r0_temp_sums_buffer_size(\n482\t    uint32_t buffer_size,\n483\t    uint32_t skip_domain,\n484\t    uint32_t num_x,\n485\t    uint32_t num_cosets,\n486\t    size_t max_temp_bytes\n487\t) {\n488\t    // Both modes use the same buffer size formula\n489\t    return DISPATCH_BOOL(\n490\t        round0_config_impl::temp_sums_buffer_size,\n491\t        use_coset_parallel_mode(num_x, skip_domain),\n492\t        buffer_size,\n493\t        skip_domain,\n494\t        num_x,\n495\t        num_cosets,\n496\t        max_temp_bytes,\n497\t        BUFFER_THRESHOLD,\n498\t        MAX_THREADS\n499\t    );\n500\t}\n501\t\n502\textern \"C\" size_t _zerocheck_r0_intermediates_buffer_size(\n503\t    uint32_t buffer_size,\n504\t    uint32_t skip_domain,\n505\t    uint32_t num_x,\n506\t    uint32_t num_cosets,\n507\t    size_t max_temp_bytes\n508\t) {\n509\t    // Both modes use the same buffer size formula\n510\t    return DISPATCH_BOOL(\n511\t        round0_config_impl::intermediates_buffer_size,\n512\t        use_coset_parallel_mode(num_x, skip_domain),\n513\t        buffer_size,\n514\t        skip_domain,\n515\t        num_x,\n516\t        num_cosets,\n517\t        max_temp_bytes,\n518\t        BUFFER_THRESHOLD,\n519\t        MAX_THREADS\n520\t    );\n521\t}\n522\t\n523\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n524\tint launch_zerocheck_ntt_evaluate_constraints(\n525\t    FpExt *tmp_sums_buffer,\n526\t    FpExt *output,\n527\t    const Fp *selectors_cube, // [3][num_x]\n528\t    const Fp *preprocessed,\n529\t    const Fp *const *main_parts,\n530\t    const FpExt *eq_cube, // [num_x]\n531\t    const FpExt *d_lambda_pows,\n532\t    const Fp *public_values,\n533\t    const Rule *d_rules,\n534\t    size_t rules_len,\n535\t    const size_t *d_used_nodes,\n536\t    size_t used_nodes_len,\n537\t    size_t lambda_len,\n538\t    uint32_t buffer_size,\n539\t    Fp *d_intermediates,\n540\t    uint32_t skip_domain,\n541\t    uint32_t num_x,\n542\t    uint32_t height,\n543\t    Fp g_shift,\n544\t    size_t max_temp_bytes\n545\t) {\n546\t    auto [grid, block] = coset_round0_config::eval_constraints_launch_params(\n547\t        buffer_size, skip_domain, num_x, NUM_COSETS, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n548\t    );\n549\t\n550\t    size_t shared_sum_size = sizeof(FpExt) * block.x;\n551\t    // NTT buffers: one skip_domain-sized buffer per x_int group in the block\n552\t    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n553\t    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n554\t\n555\t    zerocheck_ntt_evaluate_constraints_kernel<NUM_COSETS, GLOBAL, NEEDS_SHMEM>\n556\t        <<<grid, block, shmem_bytes>>>(\n557\t            tmp_sums_buffer,\n558\t            selectors_cube,\n559\t            preprocessed,\n560\t            main_parts,\n561\t            eq_cube,\n562\t            d_lambda_pows,\n563\t            public_values,\n564\t            d_rules,\n565\t            rules_len,\n566\t            d_used_nodes,\n567\t            used_nodes_len,\n568\t            lambda_len,\n569\t            buffer_size,\n570\t            d_intermediates,\n571\t            skip_domain,\n572\t            num_x,\n573\t            height,\n574\t            g_shift\n575\t        );\n576\t    int err = CHECK_KERNEL();\n577\t    if (err != 0) {\n578\t        return err;\n579\t    }\n580\t\n581\t    // Final reduction: sum across all x_int blocks for each (coset, ntt_idx)\n582\t    auto num_blocks = grid.x;\n583\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n584\t    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n585\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n586\t    sumcheck::final_reduce_block_sums<<<NUM_COSETS * skip_domain, reduce_block, reduce_shmem>>>(\n587\t        tmp_sums_buffer, output, num_blocks\n588\t    );\n589\t\n590\t    return CHECK_KERNEL();\n591\t}\n592\t\n593\t// Generate dispatcher for num_cosets (1-4) x is_global x needs_shmem\n594\tDEFINE_DISPATCH_N_B1_B2(dispatch_zerocheck, launch_zerocheck_ntt_evaluate_constraints, 4)\n595\t\n596\t// Coset-parallel launcher: uses grid.y = num_cosets, each block handles one coset\n597\ttemplate <bool GLOBAL, bool NEEDS_SHMEM>\n598\tint launch_zerocheck_coset_parallel(\n599\t    FpExt *tmp_sums_buffer,\n600\t    FpExt *output,\n601\t    const Fp *selectors_cube,\n602\t    const Fp *preprocessed,\n603\t    const Fp *const *main_parts,\n604\t    const FpExt *eq_cube,\n605\t    const FpExt *d_lambda_pows,\n606\t    const Fp *public_values,\n607\t    const Rule *d_rules,\n608\t    size_t rules_len,\n609\t    const size_t *d_used_nodes,\n610\t    size_t used_nodes_len,\n611\t    size_t lambda_len,\n612\t    uint32_t buffer_size,\n613\t    Fp *d_intermediates,\n614\t    uint32_t skip_domain,\n615\t    uint32_t num_x,\n616\t    uint32_t height,\n617\t    uint32_t num_cosets,\n618\t    Fp g_shift,\n619\t    size_t max_temp_bytes\n620\t) {\n621\t    auto [grid, block] = coset_parallel_round0_config::eval_constraints_launch_params(\n622\t        buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n623\t    );\n624\t\n625\t    size_t shared_sum_size = sizeof(FpExt) * block.x;\n626\t    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n627\t    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n628\t\n629\t    zerocheck_ntt_evaluate_constraints_coset_parallel_kernel<GLOBAL, NEEDS_SHMEM>\n630\t        <<<grid, block, shmem_bytes>>>(\n631\t            tmp_sums_buffer,\n632\t            selectors_cube,\n633\t            preprocessed,\n634\t            main_parts,\n635\t            eq_cube,\n636\t            d_lambda_pows,\n637\t            public_values,\n638\t            d_rules,\n639\t            rules_len,\n640\t            d_used_nodes,\n641\t            used_nodes_len,\n642\t            lambda_len,\n643\t            buffer_size,\n644\t            d_intermediates,\n645\t            skip_domain,\n646\t            num_x,\n647\t            height,\n648\t            g_shift\n649\t        );\n650\t    int err = CHECK_KERNEL();\n651\t    if (err != 0) {\n652\t        return err;\n653\t    }\n654\t\n655\t    // Final reduction: same as lockstep - sum across all x_int blocks for each (coset, ntt_idx)\n656\t    auto num_blocks = grid.x;\n657\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n658\t    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n659\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n660\t    sumcheck::final_reduce_block_sums<<<num_cosets * skip_domain, reduce_block, reduce_shmem>>>(\n661\t        tmp_sums_buffer, output, num_blocks\n662\t    );\n663\t\n664\t    return CHECK_KERNEL();\n665\t}\n666\t\n667\textern \"C\" int _zerocheck_ntt_eval_constraints(\n668\t    FpExt *tmp_sums_buffer,   // [num_blocks][num_cosets * skip_domain]\n669\t    FpExt *output,            // [num_cosets * skip_domain]\n670\t    const Fp *selectors_cube, // [3][num_x]\n671\t    const Fp *preprocessed,\n672\t    const Fp *const *main_parts,\n673\t    const FpExt *eq_cube, // [num_x]\n674\t    const FpExt *d_lambda_pows,\n675\t    const Fp *public_values,\n676\t    const Rule *d_rules,\n677\t    size_t rules_len,\n678\t    const size_t *d_used_nodes,\n679\t    size_t used_nodes_len,\n680\t    size_t lambda_len,\n681\t    uint32_t buffer_size,\n682\t    Fp *d_intermediates,\n683\t    uint32_t skip_domain,\n684\t    uint32_t num_x,\n685\t    uint32_t height,\n686\t    uint32_t num_cosets,\n687\t    Fp g_shift,\n688\t    size_t max_temp_bytes\n689\t) {\n690\t    bool is_global = buffer_size > BUFFER_THRESHOLD;\n691\t    bool needs_shmem = skip_domain > WARP_SIZE;\n692\t\n693\t#define KERNEL_ARGS                                                                                \\\n694\t    tmp_sums_buffer, output, selectors_cube, preprocessed, main_parts, eq_cube, d_lambda_pows,     \\\n695\t        public_values, d_rules, rules_len, d_used_nodes, used_nodes_len, lambda_len, buffer_size,  \\\n696\t        d_intermediates, skip_domain, num_x, height\n697\t\n698\t    // Threshold-based dispatch: use coset-parallel for small workloads\n699\t    if (use_coset_parallel_mode(num_x, skip_domain)) {\n700\t        // Coset-parallel mode: grid.y = num_cosets, each block handles one coset\n701\t        return DISPATCH_BOOL_PAIR(\n702\t            launch_zerocheck_coset_parallel,\n703\t            is_global,\n704\t            needs_shmem,\n705\t            KERNEL_ARGS,\n706\t            num_cosets,\n707\t            g_shift,\n708\t            max_temp_bytes\n709\t        );\n710\t    } else {\n711\t        // Lockstep mode: single thread handles all cosets\n712\t        return dispatch_zerocheck(\n713\t            num_cosets, is_global, needs_shmem, KERNEL_ARGS, g_shift, max_temp_bytes\n714\t        );\n715\t    }\n716\t#undef KERNEL_ARGS\n717\t}\n718\t\n719\textern \"C\" int _fold_selectors_round0(\n720\t    FpExt *out,\n721\t    const Fp *in,\n722\t    FpExt is_first,\n723\t    FpExt is_last,\n724\t    uint32_t num_x\n725\t) {\n726\t    auto [grid, block] = kernel_launch_params(num_x);\n727\t    fold_selectors_round0_kernel<<<grid, block>>>(out, in, is_first, is_last, num_x);\n728\t    return CHECK_KERNEL();\n729\t}\n730\t\n731\t} // namespace zerocheck_round0\n732\t"}]},"parent_tool_use_id":"toolu_016M7eRkYKqcYkCBrzjWVo7j","session_id":"48b5d5bc-06ba-4812-85f4-27a650fcd6d2","uuid":"b1463fe3-df7c-499e-b3ab-6bb312466505","timestamp":"2026-04-14T04:39:30.441Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014MwguQ4SgXSg5xBeTXoN1n","type":"tool_result","content":"1\t#include \"codec.cuh\"\n2\t#include \"dag_entry.cuh\"\n3\t#include \"eval_config.cuh\"\n4\t#include \"fp.h\"\n5\t#include \"fpext.h\"\n6\t#include \"frac_ext.cuh\"\n7\t#include \"launcher.cuh\"\n8\t#include \"sumcheck.cuh\"\n9\t#include \"utils.cuh\"\n10\t#include <algorithm>\n11\t#include <cmath>\n12\t#include <cstddef>\n13\t#include <cstdint>\n14\t#include <utility>\n15\t#include <vector_types.h>\n16\t\n17\tusing namespace symbolic_dag;\n18\t\n19\tnamespace logup_round0 {\n20\t\n21\t// NOTE[jpw]: keeping separate from zerocheck so it can be tuned separately\n22\tconstexpr uint32_t BUFFER_THRESHOLD = 16;\n23\t// Threshold for switching between coset-parallel and lockstep modes.\n24\t// When num_x * skip_domain < threshold, use coset-parallel (grid.y = num_cosets) for better GPU utilization.\n25\t// When >= threshold, use lockstep (single thread handles all cosets) to avoid redundant iNTT.\n26\tconstexpr uint32_t COSET_PARALLEL_THRESHOLD = 32768; // 2^15\n27\t\n28\t// Device function to evaluate interactions for all cosets in lockstep with DAG traversal.\n29\t// Computes numerator and denominator sums for each coset.\n30\t// NOTE: Using __inline__ instead of __forceinline__ to let compiler decide based on register pressure.\n31\t//\n32\t// Template params:\n33\t// - FIRST_COSET_IS_IDENTITY: compile-time flag for lockstep kernel when coset 0 has shift=1\n34\t// Runtime params:\n35\t// - skip_ntt: runtime flag for coset-parallel kernel when processing identity coset\n36\ttemplate <uint32_t NUM_COSETS, bool NEEDS_SHMEM, bool FIRST_COSET_IS_IDENTITY = false>\n37\t__device__ __inline__ void acc_interactions(\n38\t    const NttEvalContext<NUM_COSETS> &eval_ctx,\n39\t    const Fp *is_first, // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n40\t    const Fp *is_last,  // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n41\t    uint32_t x_int,\n42\t    const FpExt *__restrict__ numer_weights,\n43\t    const FpExt *__restrict__ denom_weights,\n44\t    const Rule *__restrict__ d_rules,\n45\t    size_t rules_len,\n46\t    FpExt *__restrict__ numer_sums, // output [NUM_COSETS]\n47\t    FpExt *__restrict__ denom_sums, // output [NUM_COSETS]\n48\t    bool skip_ntt = false           // Runtime flag for identity coset\n49\t) {\n50\t    // Initialize sums to zero\n51\t#pragma unroll\n52\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n53\t        numer_sums[c] = FpExt(Fp::zero());\n54\t        denom_sums[c] = FpExt(Fp::zero());\n55\t    }\n56\t\n57\t    for (size_t node = 0; node < rules_len; ++node) {\n58\t        Rule rule = d_rules[node];\n59\t        // Lazy decoding: only decode header (op, flags, x) upfront\n60\t        RuleHeader header = decode_rule_header(rule);\n61\t\n62\t        // Evaluate x operand for all cosets\n63\t        Fp x_vals[NUM_COSETS];\n64\t        ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n65\t            x_vals, header.x, eval_ctx, is_first, is_last, x_int, skip_ntt\n66\t        );\n67\t\n68\t        Fp results[NUM_COSETS];\n69\t\n70\t        switch (header.op) {\n71\t        case OP_ADD: {\n72\t            // Decode y only for binary ops\n73\t            SourceInfo y_src = decode_y(rule);\n74\t            Fp y_vals[NUM_COSETS];\n75\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n76\t                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n77\t            );\n78\t#pragma unroll\n79\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n80\t                results[c] = x_vals[c] + y_vals[c];\n81\t            }\n82\t            break;\n83\t        }\n84\t        case OP_SUB: {\n85\t            SourceInfo y_src = decode_y(rule);\n86\t            Fp y_vals[NUM_COSETS];\n87\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n88\t                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n89\t            );\n90\t#pragma unroll\n91\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n92\t                results[c] = x_vals[c] - y_vals[c];\n93\t            }\n94\t            break;\n95\t        }\n96\t        case OP_MUL: {\n97\t            SourceInfo y_src = decode_y(rule);\n98\t            Fp y_vals[NUM_COSETS];\n99\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n100\t                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n101\t            );\n102\t#pragma unroll\n103\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n104\t                results[c] = x_vals[c] * y_vals[c];\n105\t            }\n106\t            break;\n107\t        }\n108\t        case OP_NEG:\n109\t#pragma unroll\n110\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n111\t                results[c] = -x_vals[c];\n112\t            }\n113\t            break;\n114\t        case OP_VAR:\n115\t#pragma unroll\n116\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n117\t                results[c] = x_vals[c];\n118\t            }\n119\t            break;\n120\t        case OP_INV:\n121\t#pragma unroll\n122\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n123\t                results[c] = inv(x_vals[c]);\n124\t            }\n125\t            break;\n126\t        }\n127\t\n128\t        // Store intermediate results for all cosets\n129\t        // Decode z_index only when buffering\n130\t        if (header.buffer_result && eval_ctx.buffer_size > 0) {\n131\t            uint32_t z_index = decode_z_index(rule);\n132\t#ifdef CUDA_DEBUG\n133\t            assert(z_index < eval_ctx.buffer_size);\n134\t#endif\n135\t            // Intermediate buffer layout: [buffer_size][NUM_COSETS] per thread\n136\t#pragma unroll\n137\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n138\t                eval_ctx.inter_buffer[z_index * eval_ctx.buffer_stride + c] = results[c];\n139\t            }\n140\t        }\n141\t\n142\t        // Accumulate interaction sums\n143\t        if (header.is_constraint) {\n144\t            FpExt numer_w = numer_weights[node];\n145\t            FpExt denom_w = denom_weights[node];\n146\t#pragma unroll\n147\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n148\t                numer_sums[c] += numer_w * results[c];\n149\t                denom_sums[c] += denom_w * results[c];\n150\t            }\n151\t        }\n152\t    }\n153\t}\n154\t\n155\t// ============================================================================\n156\t// KERNELS\n157\t// ============================================================================\n158\t\n159\t// Round0 phase interactions kernel - each thread handles ALL cosets in lockstep\n160\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n161\t__global__ void logup_r0_ntt_eval_interactions_kernel(\n162\t    FracExt *__restrict__ tmp_sums_buffer, // [NUM_COSETS][gridDim.x][skip_domain]\n163\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n164\t    const Fp *__restrict__ preprocessed,\n165\t    const Fp *const *__restrict__ main_parts,\n166\t    const FpExt *__restrict__ eq_cube, // [num_x]\n167\t    const Fp *__restrict__ public_values,\n168\t    const FpExt *__restrict__ numer_weights,\n169\t    const FpExt *__restrict__ denom_weights,\n170\t    FpExt denom_sum_init,\n171\t    const Rule *__restrict__ d_rules,\n172\t    size_t rules_len,\n173\t    uint32_t buffer_size,\n174\t    Fp *__restrict__ d_intermediates,\n175\t    uint32_t skip_domain,\n176\t    uint32_t num_x,\n177\t    uint32_t height,\n178\t    Fp g_shift\n179\t) {\n180\t    extern __shared__ char smem[];\n181\t    // Shared memory layout:\n182\t    // - FracExt[blockDim.x]: shared_sum for reduction (reused per coset)\n183\t    // - Fp[blockDim.x]: ntt_buffers (one skip_domain-sized buffer per x_int group, only when NEEDS_SHMEM)\n184\t    FracExt *shared_sum = reinterpret_cast<FracExt *>(smem);\n185\t    Fp *ntt_buffers_base =\n186\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FracExt)) : nullptr;\n187\t\n188\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n189\t\n190\t    // Each x_int group within the block gets its own ntt_buffer slice\n191\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n192\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n193\t\n194\t    // Thread layout: ntt_idx varies fastest, then x_int\n195\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n196\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n197\t    uint32_t const x_int_base = tidx >> l_skip;\n198\t\n199\t    // Precompute values needed for all cosets\n200\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n201\t    Fp const omega_skip = TWO_ADIC_GENERATORS[l_skip];\n202\t\n203\t    // Compute is_first_mult, is_last_mult for all cosets\n204\t    uint32_t const log_height_total = __ffs(height) - 1;\n205\t    uint32_t const log_segment = min(l_skip, log_height_total);\n206\t    uint32_t const segment_size = 1u << log_segment;\n207\t    uint32_t const log_stride = l_skip - log_segment;\n208\t\n209\t    Fp is_first_mult[NUM_COSETS];\n210\t    Fp is_last_mult[NUM_COSETS];\n211\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n212\t    Fp const omega_skip_ntt = pow(omega_skip, ntt_idx);\n213\t\n214\t    // Cosets c=0..NUM_COSETS-1 with shifts 1,g^1, g^2, ...\n215\t    Fp g_coset = Fp::one();\n216\t#pragma unroll\n217\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n218\t        Fp eval_point = g_coset * omega_skip_ntt;\n219\t        Fp omega = exp_power_of_2(eval_point, log_stride);\n220\t        is_first_mult[c] = avg_gp(omega, segment_size);\n221\t        is_last_mult[c] = avg_gp(omega * eta, segment_size);\n222\t        g_coset *= g_shift; // g^(c+1) for next iteration\n223\t    }\n224\t\n225\t    // Intermediate buffer setup\n226\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD * NUM_COSETS];\n227\t    Fp *inter_buffer;\n228\t    uint32_t buffer_stride;\n229\t    if constexpr (GLOBAL) {\n230\t        // Layout: [buffer_size][num_threads][NUM_COSETS]\n231\t        inter_buffer = d_intermediates + tidx * NUM_COSETS;\n232\t        buffer_stride = gridDim.x * blockDim.x * NUM_COSETS;\n233\t    } else {\n234\t        inter_buffer = local_buffer;\n235\t        buffer_stride = NUM_COSETS;\n236\t    }\n237\t\n238\t    // Accumulate sums for all cosets\n239\t    FracExt sums[NUM_COSETS];\n240\t#pragma unroll\n241\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n242\t        sums[c] = {FpExt(Fp::zero()), FpExt(Fp::zero())};\n243\t    }\n244\t\n245\t    // blockDim.x is guaranteed to be a multiple of 2^l_skip\n246\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n247\t\n248\t    // Initialize eval_ctx once with loop-invariant fields\n249\t    NttEvalContext<NUM_COSETS> eval_ctx{\n250\t        preprocessed,\n251\t        main_parts,\n252\t        public_values,\n253\t        inter_buffer,\n254\t        ntt_buffer,\n255\t        {}, // omega_shifts - set once below\n256\t        skip_domain,\n257\t        height,\n258\t        buffer_stride,\n259\t        buffer_size,\n260\t        ntt_idx,\n261\t    };\n262\t    // Compute omega_shifts: coset 0 has identity shift, rest use g^c\n263\t    eval_ctx.omega_shifts[0] = Fp::one(); // Identity coset\n264\t    g_coset = g_shift;                    // g^1\n265\t#pragma unroll\n266\t    for (uint32_t c = 1; c < NUM_COSETS; c++) {\n267\t        eval_ctx.omega_shifts[c] = pow(g_coset, ntt_idx_rev);\n268\t        g_coset *= g_shift;\n269\t    }\n270\t\n271\t    // Tile across x_int\n272\t    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n273\t        // Compute per-iteration selectors as fresh local values\n274\t        Fp is_first[NUM_COSETS];\n275\t        Fp is_last[NUM_COSETS];\n276\t#pragma unroll\n277\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n278\t            is_first[c] = is_first_mult[c] * selectors_cube[x_int];\n279\t            is_last[c] = is_last_mult[c] * selectors_cube[2 * num_x + x_int];\n280\t        }\n281\t\n282\t        FpExt numer_results[NUM_COSETS];\n283\t        FpExt denom_results[NUM_COSETS];\n284\t        acc_interactions<NUM_COSETS, NEEDS_SHMEM, /*FIRST_COSET_IS_IDENTITY=*/true>(\n285\t            eval_ctx, is_first, is_last, x_int,\n286\t            numer_weights, denom_weights, d_rules, rules_len, numer_results, denom_results\n287\t        );\n288\t\n289\t        FpExt eq = eq_cube[x_int];\n290\t#pragma unroll\n291\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n292\t            sums[c].p += eq * numer_results[c];\n293\t            sums[c].q += eq * (denom_results[c] + denom_sum_init);\n294\t        }\n295\t    }\n296\t\n297\t    // Reduction: one coset at a time to minimize shared memory\n298\t#pragma unroll\n299\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n300\t        shared_sum[threadIdx.x] = sums[c];\n301\t        __syncthreads();\n302\t\n303\t        if (threadIdx.x < skip_domain) {\n304\t            FracExt tile_sum = shared_sum[threadIdx.x];\n305\t            for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n306\t                auto lane_offset = (lane << l_skip) + threadIdx.x;\n307\t                tile_sum.p += shared_sum[lane_offset].p;\n308\t                tile_sum.q += shared_sum[lane_offset].q;\n309\t            }\n310\t            // Output layout: [num_blocks][NUM_COSETS * skip_domain]\n311\t            // This matches final_reduce_block_sums expected [num_blocks][d] layout\n312\t            tmp_sums_buffer[blockIdx.x * NUM_COSETS * skip_domain + c * skip_domain + ntt_idx] =\n313\t                tile_sum;\n314\t        }\n315\t        __syncthreads();\n316\t    }\n317\t}\n318\t\n319\t// Coset-parallel kernel: grid.y = num_cosets, each block handles ONE coset.\n320\t// Uses acc_interactions<1, NEEDS_SHMEM> with explicit parameter passing.\n321\t// Use when num_x * skip_domain is small for better GPU utilization.\n322\ttemplate <bool GLOBAL, bool NEEDS_SHMEM>\n323\t__global__ void logup_r0_ntt_eval_interactions_coset_parallel_kernel(\n324\t    FracExt *__restrict__ tmp_sums_buffer, // [num_blocks][num_cosets * skip_domain]\n325\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n326\t    const Fp *__restrict__ preprocessed,\n327\t    const Fp *const *__restrict__ main_parts,\n328\t    const FpExt *__restrict__ eq_cube, // [num_x]\n329\t    const Fp *__restrict__ public_values,\n330\t    const FpExt *__restrict__ numer_weights,\n331\t    const FpExt *__restrict__ denom_weights,\n332\t    FpExt denom_sum_init,\n333\t    const Rule *__restrict__ d_rules,\n334\t    size_t rules_len,\n335\t    uint32_t buffer_size,\n336\t    Fp *__restrict__ d_intermediates,\n337\t    uint32_t skip_domain,\n338\t    uint32_t num_x,\n339\t    uint32_t height,\n340\t    Fp g_shift\n341\t) {\n342\t    extern __shared__ char smem[];\n343\t    FracExt *shared_sum = reinterpret_cast<FracExt *>(smem);\n344\t    Fp *ntt_buffers_base =\n345\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FracExt)) : nullptr;\n346\t\n347\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n348\t    uint32_t const num_cosets = gridDim.y;\n349\t\n350\t    // Each x_int group within the block gets its own ntt_buffer slice\n351\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n352\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n353\t\n354\t    // Thread layout: ntt_idx varies fastest, then x_int\n355\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n356\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n357\t    uint32_t const x_int_base = tidx >> l_skip;\n358\t\n359\t    // KEY DIFFERENCE: coset_idx from blockIdx.y\n360\t    uint32_t const coset_idx = blockIdx.y;\n361\t    bool const is_identity_coset = (coset_idx == 0);\n362\t\n363\t    // Precompute values for this single coset\n364\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n365\t    Fp const omega_skip = TWO_ADIC_GENERATORS[l_skip];\n366\t\n367\t    uint32_t const log_height_total = __ffs(height) - 1;\n368\t    uint32_t const log_segment = min(l_skip, log_height_total);\n369\t    uint32_t const segment_size = 1u << log_segment;\n370\t    uint32_t const log_stride = l_skip - log_segment;\n371\t\n372\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n373\t    Fp const omega_skip_ntt = pow(omega_skip, ntt_idx);\n374\t\n375\t    // Compute for single coset: coset 0 has shift=1, rest have shift=g^coset_idx\n376\t    Fp const g_coset = is_identity_coset ? Fp::one() : pow(g_shift, coset_idx);\n377\t    Fp const eval_point = is_identity_coset ? omega_skip_ntt : (g_coset * omega_skip_ntt);\n378\t    Fp const omega = exp_power_of_2(eval_point, log_stride);\n379\t    Fp const is_first_mult = avg_gp(omega, segment_size);\n380\t    Fp const is_last_mult = avg_gp(omega * eta, segment_size);\n381\t    Fp const omega_shift = is_identity_coset ? Fp::one() : pow(g_coset, ntt_idx_rev);\n382\t\n383\t    // Intermediate buffer setup (single coset, no NUM_COSETS multiplier)\n384\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD];\n385\t    Fp *inter_buffer;\n386\t    uint32_t buffer_stride;\n387\t    if constexpr (GLOBAL) {\n388\t        // Layout: [buffer_size][num_cosets * num_threads_per_coset]\n389\t        uint32_t global_tidx = coset_idx * gridDim.x * blockDim.x + tidx;\n390\t        inter_buffer = d_intermediates + global_tidx;\n391\t        buffer_stride = gridDim.x * gridDim.y * blockDim.x;\n392\t    } else {\n393\t        inter_buffer = local_buffer;\n394\t        buffer_stride = 1;\n395\t    }\n396\t\n397\t    FracExt sum = {FpExt(Fp::zero()), FpExt(Fp::zero())};\n398\t\n399\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n400\t\n401\t    // Single-coset context (NUM_COSETS=1), loop-invariant fields only\n402\t    NttEvalContext<1> eval_ctx{\n403\t        preprocessed,\n404\t        main_parts,\n405\t        public_values,\n406\t        inter_buffer,\n407\t        ntt_buffer,\n408\t        {omega_shift}, // omega_shifts[1]\n409\t        skip_domain,\n410\t        height,\n411\t        buffer_stride,\n412\t        buffer_size,\n413\t        ntt_idx,\n414\t    };\n415\t\n416\t    // Main loop - reuses acc_interactions<1, NEEDS_SHMEM>\n417\t    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n418\t        Fp is_first = is_first_mult * selectors_cube[x_int];\n419\t        Fp is_last = is_last_mult * selectors_cube[2 * num_x + x_int];\n420\t\n421\t        FpExt numer_results[1];\n422\t        FpExt denom_results[1];\n423\t        // We use this device function to handle a single coset so NUM_COSETS = 1 and FIRST_COSET_IS_IDENTITY = false.\n424\t        // The actual `coset_idx = 0` skip is handled by the `is_identity_coset` flag.\n425\t        acc_interactions</*NUM_COSETS=*/1, NEEDS_SHMEM, /*FIRST_COSET_IS_IDENTITY=*/false>(\n426\t            eval_ctx,\n427\t            &is_first,\n428\t            &is_last,\n429\t            x_int,\n430\t            numer_weights,\n431\t            denom_weights,\n432\t            d_rules,\n433\t            rules_len,\n434\t            numer_results,\n435\t            denom_results,\n436\t            is_identity_coset // skip_ntt flag for identity coset\n437\t        );\n438\t\n439\t        FpExt eq = eq_cube[x_int];\n440\t        sum.p += eq * numer_results[0];\n441\t        sum.q += eq * (denom_results[0] + denom_sum_init);\n442\t    }\n443\t\n444\t    // Single-coset reduction (no loop over cosets)\n445\t    shared_sum[threadIdx.x] = sum;\n446\t    __syncthreads();\n447\t\n448\t    if (threadIdx.x < skip_domain) {\n449\t        FracExt tile_sum = shared_sum[threadIdx.x];\n450\t        for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n451\t            auto lane_offset = (lane << l_skip) + threadIdx.x;\n452\t            tile_sum.p += shared_sum[lane_offset].p;\n453\t            tile_sum.q += shared_sum[lane_offset].q;\n454\t        }\n455\t        // Output layout: [num_x_blocks][num_cosets * skip_domain]\n456\t        // Same as lockstep to ensure final_reduce_block_sums works unchanged\n457\t        tmp_sums_buffer[blockIdx.x * num_cosets * skip_domain + coset_idx * skip_domain + ntt_idx] =\n458\t            tile_sum;\n459\t    }\n460\t}\n461\t\n462\t// ============================================================================\n463\t// LAUNCHERS\n464\t// ============================================================================\n465\t\n466\tconstexpr uint32_t MAX_THREADS = 128;\n467\t\n468\t// Helper to determine which mode to use based on threshold\n469\tinline bool use_coset_parallel_mode(uint32_t num_x, uint32_t skip_domain) {\n470\t    return (num_x * skip_domain) < COSET_PARALLEL_THRESHOLD;\n471\t}\n472\t\n473\t// (Not a launcher) Utility function to calculate required size of temp sum buffer.\n474\t// Required length of *temp_sum_buffer in FracExt elements\n475\textern \"C\" size_t _logup_r0_temp_sums_buffer_size(\n476\t    uint32_t buffer_size,\n477\t    uint32_t skip_domain,\n478\t    uint32_t num_x,\n479\t    uint32_t num_cosets,\n480\t    size_t max_temp_bytes\n481\t) {\n482\t    // Both modes use the same buffer size formula\n483\t    return DISPATCH_BOOL(\n484\t        round0_config_impl::temp_sums_buffer_size,\n485\t        use_coset_parallel_mode(num_x, skip_domain),\n486\t        buffer_size,\n487\t        skip_domain,\n488\t        num_x,\n489\t        num_cosets,\n490\t        max_temp_bytes,\n491\t        BUFFER_THRESHOLD,\n492\t        MAX_THREADS\n493\t    );\n494\t}\n495\t\n496\textern \"C\" size_t _logup_r0_intermediates_buffer_size(\n497\t    uint32_t buffer_size,\n498\t    uint32_t skip_domain,\n499\t    uint32_t num_x,\n500\t    uint32_t num_cosets,\n501\t    size_t max_temp_bytes\n502\t) {\n503\t    // Both modes use the same buffer size formula\n504\t    return DISPATCH_BOOL(\n505\t        round0_config_impl::intermediates_buffer_size,\n506\t        use_coset_parallel_mode(num_x, skip_domain),\n507\t        buffer_size,\n508\t        skip_domain,\n509\t        num_x,\n510\t        num_cosets,\n511\t        max_temp_bytes,\n512\t        BUFFER_THRESHOLD,\n513\t        MAX_THREADS\n514\t    );\n515\t}\n516\t\n517\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n518\tint launch_logup_ntt_eval_interactions(\n519\t    FracExt *tmp_sums_buffer,\n520\t    FracExt *output,\n521\t    const Fp *selectors_cube,\n522\t    const Fp *preprocessed,\n523\t    const Fp *const *main_parts,\n524\t    const FpExt *eq_cube,\n525\t    const Fp *public_values,\n526\t    const FpExt *numer_weights,\n527\t    const FpExt *denom_weights,\n528\t    FpExt denom_sum_init,\n529\t    const Rule *d_rules,\n530\t    size_t rules_len,\n531\t    uint32_t buffer_size,\n532\t    Fp *d_intermediates,\n533\t    uint32_t skip_domain,\n534\t    uint32_t num_x,\n535\t    uint32_t height,\n536\t    Fp g_shift,\n537\t    size_t max_temp_bytes\n538\t) {\n539\t    auto [grid, block] = coset_round0_config::eval_constraints_launch_params(\n540\t        buffer_size, skip_domain, num_x, NUM_COSETS, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n541\t    );\n542\t\n543\t    size_t shared_sum_size = sizeof(FracExt) * block.x;\n544\t    // NTT buffers: one skip_domain-sized buffer per x_int group in the block\n545\t    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n546\t    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n547\t\n548\t    logup_r0_ntt_eval_interactions_kernel<NUM_COSETS, GLOBAL, NEEDS_SHMEM>\n549\t        <<<grid, block, shmem_bytes>>>(\n550\t            tmp_sums_buffer,\n551\t            selectors_cube,\n552\t            preprocessed,\n553\t            main_parts,\n554\t            eq_cube,\n555\t            public_values,\n556\t            numer_weights,\n557\t            denom_weights,\n558\t            denom_sum_init,\n559\t            d_rules,\n560\t            rules_len,\n561\t            buffer_size,\n562\t            d_intermediates,\n563\t            skip_domain,\n564\t            num_x,\n565\t            height,\n566\t            g_shift\n567\t        );\n568\t\n569\t    int err = CHECK_KERNEL();\n570\t    if (err != 0) {\n571\t        return err;\n572\t    }\n573\t\n574\t    auto num_blocks = grid.x;\n575\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n576\t    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n577\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n578\t    auto large_domain = NUM_COSETS * skip_domain;\n579\t    sumcheck::final_reduce_block_sums<<<2 * large_domain, reduce_block, reduce_shmem>>>(\n580\t        reinterpret_cast<FpExt *>(tmp_sums_buffer), reinterpret_cast<FpExt *>(output), num_blocks\n581\t    );\n582\t    return CHECK_KERNEL();\n583\t}\n584\t\n585\t// Generate dispatcher for num_cosets (1-4) x is_global x needs_shmem\n586\tDEFINE_DISPATCH_N_B1_B2(dispatch_logup, launch_logup_ntt_eval_interactions, 4)\n587\t\n588\t// Coset-parallel launcher: uses grid.y = num_cosets, each block handles one coset\n589\ttemplate <bool GLOBAL, bool NEEDS_SHMEM>\n590\tint launch_logup_coset_parallel(\n591\t    FracExt *tmp_sums_buffer,\n592\t    FracExt *output,\n593\t    const Fp *selectors_cube,\n594\t    const Fp *preprocessed,\n595\t    const Fp *const *main_parts,\n596\t    const FpExt *eq_cube,\n597\t    const Fp *public_values,\n598\t    const FpExt *numer_weights,\n599\t    const FpExt *denom_weights,\n600\t    FpExt denom_sum_init,\n601\t    const Rule *d_rules,\n602\t    size_t rules_len,\n603\t    uint32_t buffer_size,\n604\t    Fp *d_intermediates,\n605\t    uint32_t skip_domain,\n606\t    uint32_t num_x,\n607\t    uint32_t height,\n608\t    uint32_t num_cosets,\n609\t    Fp g_shift,\n610\t    size_t max_temp_bytes\n611\t) {\n612\t    auto [grid, block] = coset_parallel_round0_config::eval_constraints_launch_params(\n613\t        buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n614\t    );\n615\t\n616\t    size_t shared_sum_size = sizeof(FracExt) * block.x;\n617\t    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n618\t    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n619\t\n620\t    logup_r0_ntt_eval_interactions_coset_parallel_kernel<GLOBAL, NEEDS_SHMEM>\n621\t        <<<grid, block, shmem_bytes>>>(\n622\t            tmp_sums_buffer,\n623\t            selectors_cube,\n624\t            preprocessed,\n625\t            main_parts,\n626\t            eq_cube,\n627\t            public_values,\n628\t            numer_weights,\n629\t            denom_weights,\n630\t            denom_sum_init,\n631\t            d_rules,\n632\t            rules_len,\n633\t            buffer_size,\n634\t            d_intermediates,\n635\t            skip_domain,\n636\t            num_x,\n637\t            height,\n638\t            g_shift\n639\t        );\n640\t    int err = CHECK_KERNEL();\n641\t    if (err != 0) {\n642\t        return err;\n643\t    }\n644\t\n645\t    // Final reduction: same as lockstep\n646\t    auto num_blocks = grid.x;\n647\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n648\t    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n649\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n650\t    auto large_domain = num_cosets * skip_domain;\n651\t    sumcheck::final_reduce_block_sums<<<2 * large_domain, reduce_block, reduce_shmem>>>(\n652\t        reinterpret_cast<FpExt *>(tmp_sums_buffer), reinterpret_cast<FpExt *>(output), num_blocks\n653\t    );\n654\t\n655\t    return CHECK_KERNEL();\n656\t}\n657\t\n658\textern \"C\" int _logup_bary_eval_interactions_round0(\n659\t    FracExt *tmp_sums_buffer, // [num_blocks][num_cosets * skip_domain]\n660\t    FracExt *output,          // [num_cosets * skip_domain]\n661\t    const Fp *selectors_cube, // [3][num_x]\n662\t    const Fp *preprocessed,\n663\t    const Fp *const *main_parts,\n664\t    const FpExt *eq_cube, // [num_x]\n665\t    const Fp *public_values,\n666\t    const FpExt *numer_weights,\n667\t    const FpExt *denom_weights,\n668\t    FpExt denom_sum_init,\n669\t    const Rule *d_rules,\n670\t    size_t rules_len,\n671\t    uint32_t buffer_size,\n672\t    Fp *d_intermediates,\n673\t    uint32_t skip_domain,\n674\t    uint32_t num_x,\n675\t    uint32_t height,\n676\t    uint32_t num_cosets,\n677\t    Fp g_shift,\n678\t    size_t max_temp_bytes\n679\t) {\n680\t    bool is_global = buffer_size > BUFFER_THRESHOLD;\n681\t    bool needs_shmem = skip_domain > WARP_SIZE;\n682\t\n683\t    // Threshold-based dispatch: use coset-parallel for small workloads\n684\t    if (use_coset_parallel_mode(num_x, skip_domain)) {\n685\t        // Coset-parallel mode: grid.y = num_cosets, each block handles one coset\n686\t        if (is_global) {\n687\t            if (needs_shmem) {\n688\t                return launch_logup_coset_parallel<true, true>(\n689\t                    tmp_sums_buffer,\n690\t                    output,\n691\t                    selectors_cube,\n692\t                    preprocessed,\n693\t                    main_parts,\n694\t                    eq_cube,\n695\t                    public_values,\n696\t                    numer_weights,\n697\t                    denom_weights,\n698\t                    denom_sum_init,\n699\t                    d_rules,\n700\t                    rules_len,\n701\t                    buffer_size,\n702\t                    d_intermediates,\n703\t                    skip_domain,\n704\t                    num_x,\n705\t                    height,\n706\t                    num_cosets,\n707\t                    g_shift,\n708\t                    max_temp_bytes\n709\t                );\n710\t            } else {\n711\t                return launch_logup_coset_parallel<true, false>(\n712\t                    tmp_sums_buffer,\n713\t                    output,\n714\t                    selectors_cube,\n715\t                    preprocessed,\n716\t                    main_parts,\n717\t                    eq_cube,\n718\t                    public_values,\n719\t                    numer_weights,\n720\t                    denom_weights,\n721\t                    denom_sum_init,\n722\t                    d_rules,\n723\t                    rules_len,\n724\t                    buffer_size,\n725\t                    d_intermediates,\n726\t                    skip_domain,\n727\t                    num_x,\n728\t                    height,\n729\t                    num_cosets,\n730\t                    g_shift,\n731\t                    max_temp_bytes\n732\t                );\n733\t            }\n734\t        } else {\n735\t            if (needs_shmem) {\n736\t                return launch_logup_coset_parallel<false, true>(\n737\t                    tmp_sums_buffer,\n738\t                    output,\n739\t                    selectors_cube,\n740\t                    preprocessed,\n741\t                    main_parts,\n742\t                    eq_cube,\n743\t                    public_values,\n744\t                    numer_weights,\n745\t                    denom_weights,\n746\t                    denom_sum_init,\n747\t                    d_rules,\n748\t                    rules_len,\n749\t                    buffer_size,\n750\t                    d_intermediates,\n751\t                    skip_domain,\n752\t                    num_x,\n753\t                    height,\n754\t                    num_cosets,\n755\t                    g_shift,\n756\t                    max_temp_bytes\n757\t                );\n758\t            } else {\n759\t                return launch_logup_coset_parallel<false, false>(\n760\t                    tmp_sums_buffer,\n761\t                    output,\n762\t                    selectors_cube,\n763\t                    preprocessed,\n764\t                    main_parts,\n765\t                    eq_cube,\n766\t                    public_values,\n767\t                    numer_weights,\n768\t                    denom_weights,\n769\t                    denom_sum_init,\n770\t                    d_rules,\n771\t                    rules_len,\n772\t                    buffer_size,\n773\t                    d_intermediates,\n774\t                    skip_domain,\n775\t                    num_x,\n776\t                    height,\n777\t                    num_cosets,\n778\t                    g_shift,\n779\t                    max_temp_bytes\n780\t                );\n781\t            }\n782\t        }\n783\t    } else {\n784\t        // Lockstep mode: single thread handles all cosets\n785\t        return dispatch_logup(\n786\t            num_cosets,\n787\t            is_global,\n788\t            needs_shmem,\n789\t            tmp_sums_buffer,\n790\t            output,\n791\t            selectors_cube,\n792\t            preprocessed,\n793\t            main_parts,\n794\t            eq_cube,\n795\t            public_values,\n796\t            numer_weights,\n797\t            denom_weights,\n798\t            denom_sum_init,\n799\t            d_rules,\n800\t            rules_len,\n801\t            buffer_size,\n802\t            d_intermediates,\n803\t            skip_domain,\n804\t            num_x,\n805\t            height,\n806\t            g_shift,\n807\t            max_temp_bytes\n808\t        );\n809\t    }\n810\t}\n811\t\n812\t} // namespace logup_round0\n813\t"}]},"parent_tool_use_id":"toolu_016M7eRkYKqcYkCBrzjWVo7j","session_id":"48b5d5bc-06ba-4812-85f4-27a650fcd6d2","uuid":"32cdce34-1d39-461e-931b-33c319501256","timestamp":"2026-04-14T04:39:30.602Z"}
