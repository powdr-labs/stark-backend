{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NnSe2enwxgrqHvVGX7peFm","type":"tool_result","content":"1\tuse std::process::exit;\n2\t\n3\tuse openvm_cuda_builder::{cuda_available, CudaBuilder};\n4\t\n5\tfn main() {\n6\t    if !cuda_available() {\n7\t        eprintln!(\"cargo:warning=CUDA is not available\");\n8\t        exit(1);\n9\t    }\n10\t\n11\t    println!(\"cargo:rerun-if-env-changed=CARGO_FEATURE_BABY_BEAR_BN254_POSEIDON2\");\n12\t\n13\t    let common = CudaBuilder::new()\n14\t        .include_from_dep(\"DEP_CUDA_COMMON_INCLUDE\")\n15\t        .include(\"cuda/include\");\n16\t\n17\t    common.emit_link_directives();\n18\t\n19\t    let mut builder = common\n20\t        .clone()\n21\t        .library_name(\"cuda-backend\")\n22\t        .watch(\"cuda\")\n23\t        .include(\"cuda/include\");\n24\t\n25\t    // Collect .cu files, excluding bn254_poseidon2.cu unless the feature is enabled.\n26\t    let bn254_enabled = std::env::var(\"CARGO_FEATURE_BABY_BEAR_BN254_POSEIDON2\").is_ok();\n27\t    for entry in glob::glob(\"cuda/src/**/*.cu\").expect(\"failed to glob cuda/src/**/*.cu\") {\n28\t        let path = entry.expect(\"glob error\");\n29\t        if !bn254_enabled && path.file_name().is_some_and(|f| f == \"bn254_poseidon2.cu\") {\n30\t            continue;\n31\t        }\n32\t        builder = builder.file(path);\n33\t    }\n34\t\n35\t    builder.build();\n36\t\n37\t    common\n38\t        .clone()\n39\t        .library_name(\"supra_ntt\")\n40\t        .include(\"cuda/supra/include\")\n41\t        .files_from_glob(\"cuda/supra/*.cu\")\n42\t        .build();\n43\t}\n44\t"}]},"parent_tool_use_id":"toolu_01FZzK86KrwWGG3hq5jAC3MR","session_id":"48b5d5bc-06ba-4812-85f4-27a650fcd6d2","uuid":"2cea4d78-73a1-4755-828d-18f507d6cd20","timestamp":"2026-04-14T04:37:35.749Z"}
