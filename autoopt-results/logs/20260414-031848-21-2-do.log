egree as usize;\n159\t    assert!(\n160\t        local_constraint_deg <= w.constraint_degree,\n161\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n162\t        w.constraint_degree\n163\t    );\n164\t\n165\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n166\t    let omega_root = F::two_adic_generator(log_large_domain);\n167\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n168\t\n169\t    let height = w.common_main.height();\n170\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n171\t    for committed in w.cached_mains {\n172\t        main_parts.push(committed.trace.buffer().as_ptr());\n173\t    }\n174\t    main_parts.push(w.common_main.buffer().as_ptr());\n175\t    let d_main_parts = main_parts.to_device()?;\n176\t\n177\t    let n_lift = w.n.max(0) as usize;\n178\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n179\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n180\t\n181\t    // Check if pre-allocated zerocheck buffers are large enough for this AIR\n182\t    let zc_prealloc_inter = if w.zc_intermed_cap > 0\n183\t        && bufs.zc_intermediates.len() >= w.zc_intermed_cap\n184\t    {\n185\t        Some(&mut bufs.zc_intermediates)\n186\t    } else {\n187\t        None\n188\t    };\n189\t    let zc_prealloc_temp = if w.zc_temp_sums_cap > 0\n190\t        && bufs.zc_temp_sums.len() >= w.zc_temp_sums_cap\n191\t    {\n192\t        Some(&mut bufs.zc_temp_sums)\n193\t    } else {\n194\t        None\n195\t    };\n196\t\n197\t    let sum_buffer = evaluate_round0_constraints_gpu(\n198\t        single_pk,\n199\t        w.selectors_cube.buffer(),\n200\t        &d_main_parts,\n201\t        w.public_values,\n202\t        eq_xi_tree.get_ptr(n_lift),\n203\t        w.d_lambda_pows,\n204\t        1 << w.l_skip,\n205\t        1 << n_lift,\n206\t        height as u32,\n207\t        num_cosets_zc as u32,\n208\t        omega_root,\n209\t        w.max_temp_