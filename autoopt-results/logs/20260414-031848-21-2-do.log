{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BaKeBk326KuuTqQmmdcopG","type":"tool_result","content":"100\t\n101\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n102\t/// instead of the monomial kernel for high num_y traces.\n103\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n104\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n105\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n106\t\n107\t#[inline]\n108\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n109\t    if need_rot {\n110\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n111\t        (mat_width / 2) as u32\n112\t    } else {\n113\t        mat_width as u32\n114\t    }\n115\t}\n116\t\n117\t/// Result of processing one AIR in Round 0.\n118\tstruct Round0AirResult {\n119\t    trace_idx: usize,\n120\t    zerocheck_poly: Option<UnivariatePoly<EF>>,\n121\t    logup_numer_poly: Option<UnivariatePoly<EF>>,\n122\t    logup_denom_poly: Option<UnivariatePoly<EF>>,\n123\t}\n124\t\n125\t/// All read-only references needed to process one AIR in Round 0.\n126\tstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n127\t    trace_idx: usize,\n128\t    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n129\t    n: isize,\n130\t    selectors_cube: &'a DeviceMatrix<F>,\n131\t    public_values: &'a DeviceBuffer<F>,\n132\t    eq_3bs: &'a [EF],\n133\t    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n134\t    common_main: &'a DeviceMatrix<F>,\n135\t    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n136\t    d_lambda_pows: &'a DeviceBuffer<EF>,\n137\t    beta_pows: &'a [EF],\n138\t    l_skip: usize,\n139\t    constraint_degree: usize,\n140\t    xi: &'a [EF],\n141\t    max_temp_bytes: usize,\n142\t    /// Pre-computed zerocheck intermediates buffer capacity needed\n143\t    zc_intermed_