  block_start: block_offset,\n                    };\n                    block_offset += blocks;\n                    desc\n                })\n                .collect();\n            let total_blocks = block_offset as usize;\n\n            let d_descs = descs.to_device()?;\n            let d_all_columns = all_columns.to_device()?;\n            unsafe {\n                batched_interpolate_columns_gpu(&d_descs, &d_all_columns, sp_deg, total_blocks)\n                    .map_err(|e| LogupZerocheckError::InterpolateColumns(e.into()))?;\n            }"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":436,"cache_read_input_tokens":86813,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":436},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"b2c5b2fa-d637-4943-9fa1-342b2397e169","uuid":"0329a918-6084-427c-99dc-91e44708ede1"}
