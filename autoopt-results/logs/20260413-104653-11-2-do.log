{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FN1MZriQm4MAEryf1oRHbT","type":"tool_result","content":"1\t#include \"fp.h\"\n2\t#include \"fpext.h\"\n3\t#include \"launcher.cuh\"\n4\t#include \"sumcheck.cuh\"\n5\t#include <algorithm>\n6\t#include <cassert>\n7\t#include <cstddef>\n8\t#include <cstdint>\n9\t#include <utility>\n10\t\n11\tnamespace {\n12\t\n13\t// ============================================================================\n14\t// KERNELS\n15\t// ============================================================================\n16\t\n17\t// Folds PLE evaluations by interpolating univariate polynomials on coset D and evaluating at r_0\n18\t// Input: column-major matrix [height * width] of evaluations\n19\t// Output: column-major matrix [new_height * width] of folded evaluations (original OR rotated)\n20\t// For each (x, col), collects 2^l_skip evaluations on coset D and interpolates\n21\t// Parallelizes barycentric interpolation: each chunk of skip_domain threads handles one output cell\n22\t// Grid: (num_row_blocks, width) where blockIdx.y selects the column\n23\ttemplate <bool ROTATE>\n24\t__global__ void fold_ple_from_evals_kernel(\n25\t    const Fp *__restrict__ input_matrix, // [height * width] column-major\n26\t    FpExt *__restrict__ output_matrix,   // [new_height * width] column-major\n27\t    const Fp *__restrict__ omega_skip_pows, // [skip_domain]\n28\t    const FpExt *inv_lagrange_denoms,       // [skip_domain]\n29\t    uint32_t height,\n30\t    uint32_t skip_domain, // 2^l_skip\n31\t    uint32_t l_skip,      // log2(domain_size)\n32\t    uint32_t new_height   // lifted_height >> l_skip\n33\t) {\n34\t    extern __shared__ char smem_raw[];\n35\t    FpExt *smem = reinterpret_cast<FpExt *>(smem_raw);\n36\t\n37\t    uint32_t col = blockIdx.y;\n38\t    uint32_t chunks_per_block = blockDim.x / skip_domain;\n39\t    uint32_t chunk_in_block = threadIdx.x / skip_domain;\n40\t    uint32_t tid_in_chunk = threadIdx.x % skip_domain;\n41\t    uint32_t x = blockIdx.x * chunks_per_block + chunk_in_block; // row index in output\n42\t\n43\t    // Cannot early-return: all threads must participate in chunk_reduce_sum (uses __syncthreads)\n44\t    bool const active_chunk = (x < new_height);\n45\t\n46\t    // Each thread handles exactly ONE term of the barycentric interpolation\n47\t    FpExt local_val(Fp::zero());\n48\t    if (active_chunk) {\n49\t        uint32_t z = tid_in_chunk;\n50\t        uint32_t offset = ROTATE ? 1 : 0;\n51\t        uint32_t row_idx = ((x << l_skip) + z + offset) % height;\n52\t        uint32_t input_idx = col * height + row_idx;\n53\t        Fp eval = input_matrix[input_idx];\n54\t\n55\t        // Lagrange interpolation: eval * omega_skip_pows[z] * inv_lagrange_denoms[z]\n56\t        local_val = inv_lagrange_denoms[z] * omega_skip_pows[z] * eval;\n57\t    }\n58\t\n59\t    // Reduce within chunk\n60\t    // All threads must participate; inactive chunks contribute zero\n61\t    FpExt result =\n62\t        sumcheck::chunk_reduce_sum(local_val, smem, tid_in_chunk, skip_domain, chunk_in_block);\n63\t\n64\t    // No __syncthreads() needed: each chunk writes to a distinct output location\n65\t    // and kernel exits immediately after this write\n66\t    if (active_chunk && tid_in_chunk == 0) {\n67\t        output_matrix[col * new_height + x] = result;\n68\t    }\n69\t}\n70\t\n71\t__global__ void interpolate_columns_kernel(\n72\t    FpExt *__restrict__ interpolated,\n73\t    const FpExt *__restrict__ const *__restrict__ columns,\n74\t    uint32_t s_deg,\n75\t    uint32_t num_y,\n76\t    uint32_t num_columns\n77\t) {\n78\t    uint32_t tidx = threadIdx.x + blockIdx.x * blockDim.x;\n79\t    uint32_t y = tidx % num_y;\n80\t    uint32_t col_idx = tidx / num_y;\n81\t    if (col_idx >= num_columns)\n82\t        return;\n83\t\n84\t    const FpExt *__restrict__ column = columns[col_idx];\n85\t    auto t0 = column[y << 1];\n86\t    auto t1 = column[(y << 1) | 1];\n87\t    FpExt *__restrict__ this_interpolated = interpolated + col_idx * s_deg * num_y;\n88\t\n89\t    for (int x = 0; x < s_deg; x++) {\n90\t        this_interpolated[x * num_y + y] = t0 + (t1 - t0) * Fp(x + 1u);\n91\t    }\n92\t}\n93\t\n94\t__global__ void frac_matrix_vertically_repeat_kernel(\n95\t    std::pair<FpExt, FpExt> *__restrict__ out,\n96\t    const std::pair<FpExt, FpExt> *__restrict__ in,\n97\t    const uint32_t width,\n98\t    const uint32_t lifted_height,\n99\t    const uint32_t height\n100\t) {\n101\t    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;\n102\t    uint32_t col = blockIdx.y + blockIdx.z * gridDim.y;\n103\t    if (col >= width) {\n104\t        return;\n105\t    }\n106\t    out[col * lifted_height + row].first = in[col * height + (row % height)].first;\n107\t    out[col * lifted_height + row].second = in[col * height + (row % height)].second;\n108\t}\n109\t\n110\t// Vertically repeat separate (F, EF) buffers (for GKR input optimization)\n111\t__global__ void frac_matrix_vertically_repeat_mixed_kernel(\n112\t    FpExt *__restrict__ out_numerators,\n113\t    FpExt *__restrict__ out_denominators,\n114\t    const FpExt *__restrict__ in_numerators,\n115\t    const FpExt *__restrict__ in_denominators,\n116\t    const uint32_t width,\n117\t    const uint32_t lifted_height,\n118\t    const uint32_t height\n119\t) {\n120\t    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;\n121\t    uint32_t col = blockIdx.y + blockIdx.z * gridDim.y;\n122\t    if (col >= width) {\n123\t        return;\n124\t    }\n125\t    uint32_t src_row = row % height;\n126\t    size_t src_idx = col * height + src_row;\n127\t    size_t dst_idx = col * lifted_height + row;\n128\t    out_numerators[dst_idx] = in_numerators[src_idx];\n129\t    out_denominators[dst_idx] = in_denominators[src_idx];\n130\t}\n131\t\n132\t// ============================================================================\n133\t// LAUNCHERS\n134\t// ===========================================================================