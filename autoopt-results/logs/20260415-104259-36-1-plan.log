{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DrMDjGEJ92dzVzcnir3CdB","type":"tool_result","content":"470\t// LAUNCHERS\n471\t// ============================================================================\n472\tconstexpr uint32_t MAX_THREADS = 128;\n473\t\n474\t// Helper to determine which mode to use based on threshold\n475\tinline bool use_coset_parallel_mode(uint32_t num_x, uint32_t skip_domain) {\n476\t    return (num_x * skip_domain) < COSET_PARALLEL_THRESHOLD;\n477\t}\n478\t\n479\t// (Not a launcher) Utility function to calculate required size of temp sum buffer.\n480\t// Required length of *temp_sum_buffer in FpExt elements\n481\textern \"C\" size_t _zerocheck_r0_temp_sums_buffer_size(\n482\t    uint32_t buffer_size,\n483\t    uint32_t skip_domain,\n484\t    uint32_t num_x,\n485\t    uint32_t num_cosets,\n486\t    size_t max_temp_bytes\n487\t) {\n488\t    // Both modes use the same buffer size formula\n489\t    return DISPATCH_BOOL(\n490\t        round0_config_impl::temp_sums_buffer_size,\n491\t        use_coset_parallel_mode(num_x, skip_domain),\n492\t        buffer_size,\n493\t        skip_domain,\n494\t        num_x,\n495\t        num_cosets,\n496\t        max_temp_bytes,\n497\t        BUFFER_THRESHOLD,\n498\t        MAX_THREADS\n499\t    );\n500\t}\n501\t\n502\textern \"C\" size_t _zerocheck_r0_intermediates_buffer_size(\n503\t    uint32_t buffer_size,\n504\t    uint32_t skip_domain,\n505\t    uint32_t num_x,\n506\t    uint32_t num_cosets,\n507\t    size_t max_temp_bytes\n508\t) {\n509\t    // Both modes use the same buffer size formula\n510\t    return DISPATCH_BOOL(\n511\t        round0_config_impl::intermediates_buffer_size,\n512\t        use_coset_parallel_mode(num_x, skip_domain),\n513\t        buffer_size,\n514\t        skip_domain,\n515\t        num_x,\n516\t        num_cosets,\n517\t        max_temp_bytes,\n518\t        BUFFER_THRESHOLD,\n519\t        MAX_THREADS\n520\t    );\n521\t}\n522\t\n523\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n524\tint launch_zerocheck_ntt_evaluate_constraints(\n525\t    FpExt *tmp_sums_buffer,\n526\t    FpExt *output,\n527\t    const Fp *selectors_cube, // [3][num_x]\n528\t    const Fp *preprocessed,\n529\t    const Fp *const *main_parts,\n530\t    const FpExt *eq_cube, // [num_x]\n531\t    const FpExt *d_lambda_pows,\n532\t    const Fp *public_values,\n533\t    const Rule *d_rules,\n534\t    size_t rules_len,\n535\t    const size_t *d_used_nodes,\n536\t    size_t used_nodes_len,\n537\t    size_t lambda_len,\n538\t    uint32_t buffer_size,\n539\t    Fp *d_intermediates,\n540\t    uint32_t skip_domain,\n541\t    uint32_t num_x,\n542\t    uint32_t height,\n543\t    Fp g_shift,\n544\t    size_t max_temp_bytes\n545\t) {\n546\t    auto [grid, block] = coset_round0_config::eval_constraints_launch_params(\n547\t        buffer_size, skip_domain, num_x, NUM_COSETS, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n548\t    );\n549\t\n550\t    size_t shared_sum_size = sizeof(FpExt) * block.x;\n551\t    // NTT buffers: one skip_domain-sized buffer per x_int group in the block\n552\t    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n553\t    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n554\t\n555\t    zerocheck_ntt_evaluate_constraints_kernel<NUM_COSETS, GLOBAL, NEEDS_SHMEM>\n556\t        <<<grid, block, shmem_bytes>>>(\n557\t            tmp_sums_buffer,\n558\t            selectors_cube,\n559\t            preprocessed,\n560\t            main_parts,\n561\t            eq_cube,\n562\t            d_lambda_pows,\n563\t            public_values,\n564\t            d_rules,\n565\t            rules_len,\n566\t            d_used_nodes,\n567\t            used_nodes_len,\n568\t            lambda_len,\n569\t            buffer_size,"}]},"parent_tool_use_id":"toolu_01BpDXMwv3zxyLVTE5Be6t3Z","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"33920f4e-aec6-4602-a096-ba8cd843314b","timestamp":"2026-04-15T09:11:52.499Z"}
