{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AGgRe8HFpeCdEnKpxFahFy","type":"tool_result","content":"1\tuse std::sync::Arc;\n2\t\n3\tuse serde::{de::DeserializeOwned, Serialize};\n4\t\n5\tuse crate::{\n6\t    keygen::types::MultiStarkProvingKey,\n7\t    prover::{\n8\t        stacked_pcs::StackedPcsData, AirProvingContext, ColMajorMatrix, CommittedTraceData,\n9\t        CpuColMajorBackend, DeviceMultiStarkProvingKey, ProvingContext,\n10\t    },\n11\t    StarkProtocolConfig,\n12\t};\n13\t\n14\tpub trait MatrixDimensions {\n15\t    fn height(&self) -> usize;\n16\t    fn width(&self) -> usize;\n17\t}\n18\t\n19\t/// Associated types needed by the prover, in the form of buffers and views,\n20\t/// specific to a specific hardware backend.\n21\t///\n22\t/// Memory allocation and copying is not handled by this trait.\n23\tpub trait ProverBackend {\n24\t    /// Extension field degree for the challenge field `Self::Challenge` over base field\n25\t    /// `Self::Val`.\n26\t    const CHALLENGE_EXT_DEGREE: u8;\n27\t    // ==== Host Types ====\n28\t    /// Base field type, on host.\n29\t    type Val: Copy + Send + Sync + Serialize + DeserializeOwned;\n30\t    /// Challenge field (extension field of base field), on host.\n31\t    type Challenge: Copy + Send + Sync + Serialize + DeserializeOwned;\n32\t    /// Single commitment on host.\n33\t    // Commitments are small in size and need to be transferred back to host to be included in\n34\t    // proof.\n35\t    type Commitment: Clone + Send + Sync + Serialize + DeserializeOwned;\n36\t\n37\t    // ==== Device Types ====\n38\t    /// Single matrix buffer on device together with dimension metadata. Owning this means nothing\n39\t    /// else has a shared reference to the buffer.\n40\t    type Matrix: MatrixDimensions + Send + Sync;\n41\t    /// Backend specific type for any pre-computed data associated with a single AIR. For example,\n42\t    /// it may contain prover-specific precomputations based on the AIR constraints (but\n43\t    /// independent from any trace data).\n44\t    type OtherAirData: Send + Sync;\n45\t    /// Owned buffer for the preimage of a PCS commitment on device, together with any metadata\n46\t    /// necessary for computing opening proofs.\n47\t    ///\n48\t    /// For example, multiple buffers for LDE matrices, their trace domain sizes, and pointer to\n49\t    /// mixed merkle tree.\n50\t    type PcsData: Send + Sync;\n51\t}\n52\t\n53\tpub trait ProverDevice<PB: ProverBackend, TS>:\n54\t    TraceCommitter<PB> + MultiRapProver<PB, TS> + OpeningProver<PB, TS>\n55\t{\n56\t    type Error: 'static\n57\t        + std::error::Error\n58\t        + Send\n59\t        + Sync\n60\t        + From<<Self as TraceCommitter<PB>>::Error>\n61\t        + From<<Self as MultiRapProver<PB, TS>>::Error>\n62\t        + From<<Self as OpeningProver<PB, TS>>::Error>;\n63\t}\n64\t\n65\t/// Provides functionality for committing to a batch of trace matrices, possibly of different\n66\t/// heights.\n67\tpub trait TraceCommitter<PB: ProverBackend> {\n68\t    type Error: std::fmt::Debug;\n69\t    fn commit(&self, traces: &[&PB::Matrix]) -> Result<(PB::Commitment, PB::PcsData), Self::Error>;\n70\t}\n71\t\n72\t/// This trait is responsible for all proving steps to prove a collection of trace matrices\n73\t/// satisfies all constraints of a Randomized AIR with Preprocessing. Such constraints include AIR\n74\t/// constraints as well as bus balancing constraints for interactions between AIRs. These\n75\t/// constraints may be grouped into challenge phases, where new randomness is sampled between phases\n76\t/// via Fiat-Shamir (which would involve committing to more data).\n77\t///\n78\t/// This trait is _not_ responsible for committing to the trace matrices or for proving polynomial\n79\t/// openings with respect to the committed trace matrices.\n80\tpub trait MultiRapProver<PB: ProverBackend, TS> {\n81\t    /// The partial proof is the proof that the trace matrices satisfy all constraints assuming that\n82\t    /// certain polynomial opening claims are validated. In other words, it is a proof that reduces\n83\t    /// the constraint satisfaction claim to certain polynomial opening claims.\n84\t    type PartialProof: Clone + Send + Sync + Serialize + DeserializeOwned;\n85\t    /// Other artifacts of the proof (e.g., sampled randomness) that may be passed to later stages\n86\t    /// of the protocol.\n87\t    type Artifacts;\n88\t\n89\t    type Error: std::fmt::Debug;\n90\t\n91\t    fn prove_rap_constraints(\n92\t        &self,\n93\t        transcript: &mut TS,\n94\t        mpk: &DeviceMultiStarkProvingKey<PB>,\n95\t        ctx: &ProvingContext<PB>,\n96\t        common_main_pcs_data: &PB::PcsData,\n97\t    ) -> Result<(Self::PartialProof, Self::Artifacts), Self::Error>;\n98\t}\n99\t\n100\t/// This trait is responsible for proving the evaluation claims of a collection of polynomials at a"}]},"parent_tool_use_id":"toolu_01MWF8uxhoPgEUCEtBhyfUw3","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"140fc5a5-6cfe-4613-9cc5-9d982b623e53","timestamp":"2026-04-15T08:50:35.845Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019mZ4NbtDuM1N22nYk7Nta2","type":"tool_result","content":"1\t#![allow(dead_code)]\n2\tuse openvm_cuda_common::{\n3\t    copy::{MemCopyD2H, MemCopyH2D},\n4\t    d_buffer::DeviceBuffer,\n5\t};\n6\tuse openvm_stark_backend::{\n7\t    p3_util::log2_strict_usize,\n8\t    poly_common::UnivariatePoly,\n9\t    prover::sumcheck::{SumcheckCubeProof, SumcheckPrismProof},\n10\t    FiatShamirTranscript,\n11\t};\n12\tuse p3_field::{ExtensionField, Field};\n13\tuse tracing::{debug, info_span, instrument};\n14\t\n15\tuse crate::{\n16\t    cuda::{\n17\t        batch_ntt_small::batch_ntt_small,\n18\t        matrix::batch_expand_pad_wide,\n19\t        sumcheck::{fold_mle, fold_ple_from_coeffs, reduce_over_x_and_cols, sumcheck_mle_round},\n20\t    },\n21\t    error::SumcheckError,\n22\t    prelude::*,\n23\t    sponge::DuplexSpongeGpu,\n24\t};\n25\t\n26\t/// GPU implementation of multilinear sumcheck\n27\t///\n28\t/// Memory strategy: Ping-pong buffers (buffer_a ↔ buffer_b) alternate each round\n29\t/// - Round 0 (even): reads buffer_a, writes buffer_b\n30\t/// - Round 1 (odd):  reads buffer_b, writes buffer_a\n31\t/// - Final result in buffer determined by parity of n\n32\t/// - Memory footprint: ~1.5 * evals.len() * sizeof(EF)\n33\t#[allow(dead_code)]\n34\t#[instrument(name = \"sumcheck_multilinear_gpu\", level = \"info\", skip_all)]\n35\tpub fn sumcheck_multilinear_gpu<F: Field>(\n36\t    transcript: &mut DuplexSpongeGpu,\n37\t    evals: &[F],\n38\t) -> Result<(SumcheckCubeProof<EF>, Vec<EF>), SumcheckError>\n39\twhere\n40\t    EF: ExtensionField<F>,\n41\t{\n42\t    let n = log2_strict_usize(evals.len());\n43\t    let mut round_polys_eval = Vec::with_capacity(n);\n44\t    let mut r = Vec::with_capacity(n);\n45\t\n46\t    // Compute sum claim\n47\t    let sum_claim: EF = evals.iter().copied().sum::<F>().into();\n48\t    transcript.observe_ext(sum_claim);\n49\t\n50\t    // Convert to extension field\n51\t    let evals_ext: Vec<EF> = evals.iter().map(|&x| EF::from(x)).collect();\n52\t\n53\t    // Setup\n54\t    let mut current_height = 1 << n;\n55\t    let width = 1;\n56\t    let num_matrices = 1;\n57\t    let d = 1; // Degree for MLE\n58\t    const WD: usize = 1; // Number of output polynomials\n59\t\n60\t    // Allocate ping-pong buffers\n61\t    let total_size = width * current_height;\n62\t    let mut d_buffer_a = evals_ext.to_device()?;\n63\t    let mut d_buffer_b = DeviceBuffer::<EF>::with_capacity(total_size / 2);\n64\t\n65\t    // Set up pointer arrays on device\n66\t    let mut d_input_ptrs = DeviceBuffer::<*const EF>::with_capacity(num_matrices);\n67\t    let mut d_output_ptrs = DeviceBuffer::<*mut EF>::with_capacity(num_matrices);\n68\t    let d_widths = [width as u32].to_device()?;\n69\t\n70\t    // Buffer for round output [d * WD]\n71\t    let d_round_output = DeviceBuffer::<EF>::with_capacity(d * WD);\n72\t\n73\t    // Sumcheck rounds\n74\t    for round in 0..n {\n75\t        // Ping-pong buffers\n76\t        let (input_buf, output_buf) = if round % 2 == 0 {\n77\t            (&d_buffer_a, &mut d_buffer_b)\n78\t        } else {\n79\t            (&d_buffer_b, &mut d_buffer_a)\n80\t        };\n81\t\n82\t        // Update pointer arrays\n83\t        let input_ptr = input_buf.as_ptr();\n84\t        let output_ptr = output_buf.as_mut_ptr();\n85\t\n86\t        [input_ptr].copy_to(&mut d_input_ptrs)?;\n87\t        [output_ptr].copy_to(&mut d_output_ptrs)?;\n88\t\n89\t        // Call sumcheck_mle_round kernel (uses output_buf as tmp)\n90\t        unsafe {\n91\t            sumcheck_mle_round(\n92\t                &d_input_ptrs,\n93\t                &d_round_output,\n94\t                output_buf, // Reuse output buffer as tmp!\n95\t                &d_widths,\n96\t                num_matrices as u32,\n97\t                current_height as u32,\n98\t                d as u32,\n99\t            )\n100\t            .map_err(|e| SumcheckError::SumcheckMleRound(e.into()))?;\n101\t        }\n102\t\n103\t        // Copy result back to host\n104\t        let h_round_output = d_round_output.to_host()?;\n105\t\n106\t        // Observe in transcript\n107\t        let s = h_round_output[0..d].to_vec();\n108\t\n109\t        assert_eq!(s.len(), d);\n110\t        transcript.observe_ext(s[0]);\n111\t        round_polys_eval.push(s);\n112\t\n113\t        // Sample challenge from transcript\n114\t        let r_round = transcript.sample_ext();\n115\t        debug!(%round, %r_round);\n116\t        r.push(r_round);\n117\t\n118\t        // Fold using the challenge\n119\t        let output_height = (current_height >> 1) as u32;\n120\t        unsafe {\n121\t            fold_mle(\n122\t                &d_input_ptrs,\n123\t                &d_output_ptrs,\n124\t                &d_widths,\n125\t                num_matrices.try_into().unwrap(),\n126\t                output_height,\n127\t                width as u32 * output_height,\n128\t                r_round,\n129\t            )\n130\t            .map_err(|e| SumcheckError::FoldMle(e.into()))?;\n131\t        }\n132\t\n133\t        current_height >>= 1;\n134\t    }\n135\t\n136\t    // After all rounds, get final evaluation claim\n137\t    let final_buf = if n % 2 == 1 { &d_buffer_b } else { &d_buffer_a };\n138\t    let eval_claim_vec = final_buf.to_host()?;\n139\t    let eval_claim = eval_claim_vec[0];\n140\t\n141\t    transcript.observe_ext(eval_claim);\n142\t\n143\t    Ok((\n144\t        SumcheckCubeProof {\n145\t            sum_claim,\n146\t            round_polys_eval,\n147\t            eval_claim,\n148\t        },\n149\t        r,\n150\t    ))\n151\t}\n152\t\n153\t/// GPU implementation of prismalinear sumcheck with univariate skip\n154\t///\n155\t/// Memory strategy:\n156\t/// - Round 0: Uses DFT/iDFT pipeline, reuses buffers between steps\n157\t/// - Rounds 1..n: Standard MLE rounds with ping-pong buffers\n158\t/// - d_evals gets modified by iDFT in round 0, then reused for fold_ple\n159\t/// - Memory footprint: if evals.len() = 2^(l_skip +n), then 2 * evals.len() * sizeof(F) + 1.5 * 2^n\n160\t///   * sizeof(EF)\n161\t///\n162\t/// NOTE: batch_ntt expects a concrete type BabyBear, so I removed generic type parameters for now\n163\t#[allow(dead_code)]\n164\t#[instrument(name = \"sumcheck_prismalinear_gpu\", level = \"info\", skip_all)]\n165\tpub fn sumcheck_prismalinear_gpu(\n166\t    transcript: &mut DuplexSpongeGpu,\n167\t    l_skip: usize,\n168\t    evals: &[F],\n169\t) -> Result<(SumcheckPrismProof<EF>, Vec<EF>), SumcheckError> {\n170\t    let prism_dim = p3_util::log2_strict_usize(evals.len());\n171\t    assert!(prism_dim >= l_skip);\n172\t    let n = prism_dim - l_skip;\n173\t\n174\t    let mut round_polys_eval = Vec::with_capacity(n);\n175\t    let mut r = Vec::with_capacity(n + 1);\n176\t\n177\t    // Compute sum claim\n178\t    let sum_claim: EF = evals.iter().copied().sum::<F>().into();\n179\t    transcript.observe_ext(sum_claim);\n180\t\n181\t    // Setup\n182\t    let domain_size = 1 << l_skip;\n183\t    let num_x = 1 << n;\n184\t    let width = 1;\n185\t    let d = 1; // Degree for simple case\n186\t    let s_deg = d * (domain_size - 1); // d * (2^l_skip - 1)\n187\t    let log_large_domain = p3_util::log2_ceil_usize(s_deg + 1);\n188\t    let large_domain_size = 1 << log_large_domain;\n189\t\n190\t    // ========== Round 0: Special PLE round ==========\n191\t    let _round0_span = info_span!(\"sumcheck_prismalinear.round0\").entered();\n192\t\n193\t    let mut d_coeffs = evals.to_device()?;\n194\t    let mut d_s0_coeffs = DeviceBuffer::<F>::with_capacity(large_domain_size);\n195\t\n196\t    // Step 1: iDFT on skip domain (reinterpreting dimensions)\n197\t    // Input: [height=2^(l_skip+n), width=1]\n198\t    // Treat as: [height=2^l_skip, width=2^n]\n199\t    unsafe {\n200\t        batch_ntt_small(&mut d_coeffs, l_skip, num_x * width, true)\n201\t            .map_err(|e| SumcheckError::BatchNttSmall(e.into()))?;\n202\t    }\n203\t\n204\t    if domain_size == large_domain_size {\n205\t        unsafe {\n206\t            // Step 2-5: Sum over all x and columns\n207\t            reduce_over_x_and_cols(\n208\t                &d_coeffs,\n209\t                &d_s0_coeffs,\n210\t                num_x as u32,\n211\t                width as u32,\n212\t                large_domain_size as u32,\n213\t            )\n214\t            .map_err(|e| SumcheckError::ReduceOverXAndCols(e.into()))?;\n215\t        }\n216\t    } else {\n217\t        let mut d_coeffs_large =\n218\t            DeviceBuffer::<F>::with_capacity(num_x * width * large_domain_size);\n219\t\n220\t        // Step 2: Copy and pad each column to large domain size\n221\t        unsafe {\n222\t            batch_expand_pad_wide(\n223\t                d_coeffs_large.as_mut_ptr(),\n224\t                d_coeffs.as_ptr(),\n225\t                (num_x * width) as u32,\n226\t                large_domain_size as u32,\n227\t                domain_size as u32,\n228\t            )\n229\t            .map_err(|e| SumcheckError::BatchExpandPadWide(e.into()))?;\n230\t        }\n231\t\n232\t        // Step 3: DFT on large domain\n233\t        unsafe {\n234\t            batch_ntt_small(&mut d_coeffs_large, log_large_domain, num_x * width, false)\n235\t                .map_err(|e| SumcheckError::BatchNttSmall(e.into()))?;\n236\t        }\n237\t\n238\t        // Step 4: Sum over all x and columns\n239\t        unsafe {\n240\t            reduce_over_x_and_cols(\n241\t                &d_coeffs_large,\n242\t                &d_s0_coeffs,\n243\t                num_x as u32,\n244\t                width as u32,\n245\t                large_domain_size as u32,\n246\t            )\n247\t            .map_err(|e| SumcheckError::ReduceOverXAndCols(e.into()))?;\n248\t        }\n249\t        drop(d_coeffs_large);\n250\t\n251\t        // Step 5: iDFT to get coefficients\n252\t        unsafe {\n253\t            batch_ntt_small(&mut d_s0_coeffs, log_large_domain, 1, true)\n254\t                .map_err(|e| SumcheckError::BatchNttSmall(e.into()))?;\n255\t        }\n256\t    }\n257\t    // Step 6: Copy to host and convert to extension field\n258\t    let s0_coeffs_host: Vec<F> = d_s0_coeffs.to_host()?;\n259\t    drop(d_s0_coeffs);\n260\t    let s0_coeffs_ext: Vec<EF> = s0_coeffs_host[0..=s_deg]\n261\t        .iter()\n262\t        .map(|&x| EF::from(x))\n263\t        .collect();\n264\t\n265\t    // Step 7: Create polynomial and observe in transcript\n266\t    let s_0 = UnivariatePoly::new(s0_coeffs_ext.clone());\n267\t    for &coeff in &s0_coeffs_ext {\n268\t        transcript.observe_ext(coeff);\n269\t    }\n270\t\n271\t    // Step 8: Sample challenge r_0\n272\t    let r_0 = transcript.sample_ext();\n273\t    debug!(round = 0, r_round = %r_0);\n274\t    r.push(r_0);\n275\t\n276\t    // ========== Fold PLE: Evaluate at r_0 ==========\n277\t\n278\t    let d_folded = DeviceBuffer::<EF>::with_capacity(num_x);\n279\t    unsafe {\n280\t        fold_ple_from_coeffs(\n281\t            d_coeffs.as_ptr(),     // Original input (base field, but modified by iDFT)\n282\t            d_folded.as_mut_ptr(), // Output in extension field\n283\t            num_x as u32,\n284\t            width as u32,\n285\t            domain_size as u32,\n286\t            r_0,\n287\t        )\n288\t        .map_err(|e| SumcheckError::FoldPleFromCoeffs(e.into()))?;\n289\t    }\n290\t    drop(d_coeffs);\n291\t    drop(_round0_span);\n292\t\n293\t    // ========== Rounds 1..n: Regular MLE rounds ==========\n294\t    let _mle_rounds_span = info_span!(\"sumcheck_prismalinear.mle_rounds\").entered();\n295\t\n296\t    let mut current_height = num_x; // After fold_ple, height is 2^n\n297\t    let num_matrices = 1;\n298\t\n299\t    // Allocate ping-pong buffers for MLE rounds\n300\t    let mut d_buffer_a = d_folded; // Reuse folded result\n301\t    let mut d_buffer_b = DeviceBuffer::<EF>::with_capacity(current_height / 2);\n302\t\n303\t    let mut d_input_ptrs = DeviceBuffer::<*const EF>::with_capacity(num_matrices);\n304\t    let mut d_output_ptrs = DeviceBuffer::<*mut EF>::with_capacity(num_matrices);\n305\t    let d_widths = [width as u32].to_device()?;\n306\t    let d_round_output = DeviceBuffer::<EF>::with_capacity(d);\n307\t\n308\t    for round in 1..=n {\n309\t        let (input_buf, output_buf) = if round % 2 == 1 {\n310\t            (&d_buffer_a, &mut d_buffer_b)\n311\t        } else {\n312\t            (&d_buffer_b, &mut d_buffer_a)\n313\t        };\n314\t\n315\t        let input_ptr = input_buf.as_ptr();\n316\t        let output_ptr = output_buf.as_mut_ptr();\n317\t\n318\t        [input_ptr].copy_to(&mut d_input_ptrs)?;\n319\t        [output_ptr].copy_to(&mut d_output_ptrs)?;\n320\t\n321\t        // Sumcheck MLE round\n322\t        unsafe {\n323\t            sumcheck_mle_round(\n324\t                &d_input_ptrs,\n325\t                &d_round_output,\n326\t                output_buf,\n327\t                &d_widths,\n328\t                num_matrices as u32,\n329\t                current_height as u32,\n330\t                d as u32,\n331\t            )\n332\t            .map_err(|e| SumcheckError::SumcheckMleRound(e.into()))?;\n333\t        }\n334\t\n335\t        let h_round_output = d_round_output.to_host()?;\n336\t        let s = h_round_output[0..d].to_vec();\n337\t        assert_eq!(s.len(), d);\n338\t        transcript.observe_ext(s[0]);\n339\t        round_polys_eval.push(s);\n340\t\n341\t        let r_round = transcript.sample_ext();\n342\t        debug!(%round, %r_round);\n343\t        r.push(r_round);\n344\t\n345\t        // Fold MLE\n346\t        let output_height = (current_height >> 1) as u32;\n347\t        unsafe {\n348\t            fold_mle(\n349\t                &d_input_ptrs,\n350\t                &d_output_ptrs,\n351\t                &d_widths,\n352\t                num_matrices.try_into().unwrap(),\n353\t                output_height,\n354\t                width as u32 * output_height,\n355\t                r_round,\n356\t            )\n357\t            .map_err(|e| SumcheckError::FoldMle(e.into()))?;\n358\t        }\n359\t\n360\t        current_height >>= 1;\n361\t    }\n362\t    drop(_mle_rounds_span);\n363\t\n364\t    // Get final evaluation claim\n365\t    let final_buf = if n % 2 == 1 { &d_buffer_b } else { &d_buffer_a };\n366\t    let eval_claim_vec = final_buf.to_host()?;\n367\t    let eval_claim = eval_claim_vec[0];\n368\t\n369\t    transcript.observe_ext(eval_claim);\n370\t\n371\t    Ok((\n372\t        SumcheckPrismProof {\n373\t            sum_claim,\n374\t            s_0,\n375\t            round_polys_eval,\n376\t            eval_claim,\n377\t        },\n378\t        r,\n379\t    ))\n380\t}\n381\t"}]},"parent_tool_use_id":"toolu_01KrJkGSXQSuRiHanrn4W4wH","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"51287f3c-695e-4a3a-97ee-32c8ca30ae0f","timestamp":"2026-04-15T08:50:36.007Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KXMLjZMUjAUx8HvjtgEFoV","type":"tool_result","content":"1\tuse itertools::Itertools;\n2\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer};\n3\tuse openvm_stark_backend::{\n4\t    air_builders::symbolic::{\n5\t        symbolic_expression::SymbolicExpression, SymbolicConstraints, SymbolicDagBuilder,\n6\t        SymbolicExpressionDag,\n7\t    },\n8\t    prover::{fractional_sumcheck_gkr::Frac, DeviceStarkProvingKey},\n9\t};\n10\tuse p3_field::PrimeCharacteristicRing;\n11\tuse tracing::{debug, warn};\n12\t\n13\tuse super::errors::Round0EvalError;\n14\tuse crate::{\n15\t    cuda::logup_zerocheck::{\n16\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n17\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n18\t        logup_bary_eval_interactions_round0, zerocheck_ntt_eval_constraints,\n19\t    },\n20\t    gpu_backend::GenericGpuBackend,\n21\t    hash_scheme::GpuHashScheme,\n22\t    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n23\t    prelude::{EF, F},\n24\t};\n25\t\n26\t/// Pre-allocated per-thread GPU buffers for Round 0 evaluation.\n27\t/// Reused across AIRs to eliminate per-AIR mutex contention on the global memory manager.\n28\tpub(crate) struct Round0ThreadBuffers {\n29\t    pub zc_intermediates: DeviceBuffer<F>,\n30\t    pub zc_temp_sums: DeviceBuffer<EF>,\n31\t    pub logup_intermediates: DeviceBuffer<F>,\n32\t    pub logup_temp_sums: DeviceBuffer<Frac<EF>>,\n33\t}\n34\t\n35\t/// Evaluate plain AIR constraints (not interactions) for a single AIR, given prepared trace input.\n36\t///\n37\t/// `num_cosets` should equal `constraint_degree - 1` because we evaluate the quotient polynomial.\n38\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n39\t#[allow(clippy::too_many_arguments)]\n40\tpub fn evaluate_round0_constraints_gpu<HS: GpuHashScheme>(\n41\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n42\t    selectors_cube: &DeviceBuffer<F>,\n43\t    main_parts: &DeviceBuffer<*const F>,\n44\t    public_values: &DeviceBuffer<F>,\n45\t    eq_cube: *const EF,\n46\t    lambda_pows: &DeviceBuffer<EF>,\n47\t    skip_domain: u32,\n48\t    num_x: u32,\n49\t    height: u32,\n50\t    num_cosets: u32,\n51\t    g_shift: F,\n52\t    max_temp_bytes: usize,\n53\t    prealloc_intermediates: Option<&mut DeviceBuffer<F>>,\n54\t    prealloc_temp_sums: Option<&mut DeviceBuffer<EF>>,\n55\t) -> Result<DeviceBuffer<EF>, Round0EvalError> {\n56\t    let constraints_dag = &pk.vk.symbolic_constraints;\n57\t    if constraints_dag.constraints.constraint_idx.is_empty() || num_cosets == 0 {\n58\t        // No plain AIR constraints, return empty buffer\n59\t        return Ok(DeviceBuffer::new());\n60\t    }\n61\t\n62\t    let rules = &pk.other_data.zerocheck_round0;\n63\t\n64\t    let buffer_size: u32 = rules.inner.buffer_size;\n65\t    let intermed_capacity = unsafe {\n66\t        _zerocheck_r0_intermediates_buffer_size(\n67\t            buffer_size,\n68\t            skip_domain,\n69\t            num_x,\n70\t            num_cosets,\n71\t            max_temp_bytes,\n72\t        )\n73\t    };\n74\t\n75\t    let use_prealloc_inter = prealloc_intermediates\n76\t        .as_ref()\n77\t        .map_or(false, |p| intermed_capacity > 0 && p.len() >= intermed_capacity);\n78\t    let mut fallback_intermediates;\n79\t    let intermediates = if use_prealloc_inter {\n80\t        prealloc_intermediates.unwrap()\n81\t    } else {\n82\t        fallback_intermediates = if intermed_capacity > 0 {\n83\t            debug!(\"zerocheck:intermediates_capacity={intermed_capacity}\");\n84\t            DeviceBuffer::<F>::with_capacity(intermed_capacity)\n85\t        } else {\n86\t            DeviceBuffer::<F>::new()\n87\t        };\n88\t        &mut fallback_intermediates\n89\t    };\n90\t\n91\t    let temp_sums_buffer_capacity = unsafe {\n92\t        _zerocheck_r0_temp_sums_buffer_size(\n93\t            buffer_size,\n94\t            skip_domain,\n95\t            num_x,\n96\t            num_cosets,\n97\t            max_temp_bytes,\n98\t        )\n99\t    };\n100\t\n101\t    let use_prealloc_temp = prealloc_temp_sums\n102\t        .as_ref()\n103\t        .map_or(false, |p| p.len() >= temp_sums_buffer_capacity);\n104\t    let mut fallback_temp_sums;\n105\t    let temp_sums_buffer = if use_prealloc_temp {\n106\t        prealloc_temp_sums.unwrap()\n107\t    } else {\n108\t        debug!(\"zerocheck:temp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n109\t        fallback_temp_sums = DeviceBuffer::<EF>::with_capacity(temp_sums_buffer_capacity);\n110\t        &mut fallback_temp_sums\n111\t    };\n112\t\n113\t    let used_temp_bytes =\n114\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<EF>();\n115\t    if used_temp_bytes > max_temp_bytes {\n116\t        warn!(\"zerocheck used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\");\n117\t    }\n118\t\n119\t    let preprocessed_ptr = pk\n120\t        .preprocessed_data\n121\t        .as_ref()\n122\t        .map(|cd| cd.trace.buffer().as_ptr())\n123\t        .unwrap_or(std::ptr::null());\n124\t\n125\t    let mut sp_evals =\n126\t        DeviceBuffer::<EF>::with_capacity(num_cosets as usize * skip_domain as usize);\n127\t    // SAFETY:\n128\t    // - No bounds checks are done in this kernel. It fully assumes that the Rules are trusted and\n129\t    //   all nodes are valid.\n130\t    unsafe {\n131\t        zerocheck_ntt_eval_constraints(\n132\t            temp_sums_buffer,\n133\t            &mut sp_evals,\n134\t            selectors_cube,\n135\t            preprocessed_ptr,\n136\t            main_parts,\n137\t            eq_cube,\n138\t            lambda_pows,\n139\t            public_values,\n140\t            &rules.inner.d_rules,\n141\t            &rules.inner.d_used_nodes,\n142\t            buffer_size,\n143\t            intermediates,\n144\t            skip_domain,\n145\t            num_x,\n146\t            height,\n147\t            num_cosets,\n148\t            g_shift,\n149\t            max_temp_bytes,\n150\t        )?;\n151\t    }\n152\t\n153\t    Ok(sp_evals)\n154\t}\n155\t\n156\t/// Evaluate interaction constraints (excluding plain AIR constraints) for a single AIR, given\n157\t/// prepared trace input.\n158\t///\n159\t/// `constraints` includes interaction expressions for the AIR.\n160\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n161\t#[allow(clippy::too_many_arguments)]\n162\tpub fn evaluate_round0_interactions_gpu<HS: GpuHashScheme>(\n163\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n164\t    symbolic: &SymbolicConstraints<F>,\n165\t    selectors_cube: &DeviceBuffer<F>,\n166\t    main_parts: &DeviceBuffer<*const F>,\n167\t    public_values: &DeviceBuffer<F>,\n168\t    eq_cube: *const EF,\n169\t    beta_pows: &[EF],\n170\t    eq_3bs: &[EF],\n171\t    skip_domain: u32,\n172\t    num_x: u32,\n173\t    height: u32,\n174\t    num_cosets: u32,\n175\t    g_shift: F,\n176\t    max_temp_bytes: usize,\n177\t    prealloc_intermediates: Option<&mut DeviceBuffer<F>>,\n178\t    prealloc_temp_sums: Option<&mut DeviceBuffer<Frac<EF>>>,\n179\t) -> Result<DeviceBuffer<Frac<EF>>, Round0EvalError> {\n180\t    // Check if this trace has interactions\n181\t    if eq_3bs.is_empty() {\n182\t        return Ok(DeviceBuffer::new());\n183\t    }\n184\t    let large_domain = num_cosets * skip_domain;\n185\t\n186\t    // We create a new \"interactions DAG\" where the new .constraints are the interaction [count,\n187\t    // message_0, message_1, ..] expressions themselves, while the .interactions are empty\n188\t    // We track the indices with InteractionNode\n189\t\n190\t    // Copied from build_symbolic_constraints_dag to handle sorting of constraints\n191\t    // NOTE: For logup round0, the kernel uses weights indexed by rule_idx, not constraint_idx.\n192\t    // So we deduplicate constraint_idx and use dag_idx_to_rule_idx for weight mapping.\n193\t    let (rules, d_numer_weights, d_denom_weights, denom_sum_init) = {\n194\t        let mut dag_builder = SymbolicDagBuilder::new();\n195\t        let mut sorted_used_dag_idxs = Vec::new();\n196\t        for interaction in &symbolic.interactions {\n197\t            let count = dag_builder.add_expr(&interaction.count);\n198\t            sorted_used_dag_idxs.push(count);\n199\t            sorted_used_dag_idxs.extend(\n200\t                interaction\n201\t                    .message\n202\t                    .iter()\n203\t                    .map(|field_expr| dag_builder.add_expr(field_expr)),\n204\t            );\n205\t        }\n206\t        sorted_used_dag_idxs.sort();\n207\t        // Deduplicate for the dag since logup round0 kernel doesn't use used_nodes\n208\t        sorted_used_dag_idxs.dedup();\n209\t        let dag = SymbolicExpressionDag {\n210\t            nodes: dag_builder.nodes,\n211\t            constraint_idx: sorted_used_dag_idxs,\n212\t        };\n213\t        let rules = SymbolicRulesGpu::new(&dag, true);\n214\t        let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n215\t        let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n216\t        let mut denom_sum_init = EF::ZERO;\n217\t        for (interaction_idx, interaction) in symbolic.interactions.iter().enumerate() {\n218\t            // CAUTION: an expression node could be used in multiple interactions, and might even be\n219\t            // used as `count` in one, but message field in another. We only care about their\n220\t            // weighted sum with eq_3b, so we compute the weights ahead of time.\n221\t            let count_dag_idx =\n222\t                dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];\n223\t            let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n224\t            numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n225\t            denom_sum_init += eq_3bs[interaction_idx]\n226\t                * beta_pows[interaction.message.len()]\n227\t                * F::from_u32(interaction.bus_index as u32 + 1);\n228\t\n229\t            for (message_idx, message) in interaction.message.iter().enumerate() {\n230\t                let message_dag_idx =\n231\t                    dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n232\t                let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n233\t                denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];\n234\t            }\n235\t        }\n236\t        let d_numer_weights = numer_weights.to_device()?;\n237\t        let d_denom_weights = denom_weights.to_device()?;\n238\t        (rules, d_numer_weights, d_denom_weights, denom_sum_init)\n239\t    };\n240\t\n241\t    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n242\t    let d_rules = encoded_rules.to_device()?;\n243\t\n244\t    let buffer_size: u32 = rules.buffer_size.try_into().unwrap();\n245\t    let intermed_capacity = unsafe {\n246\t        _logup_r0_intermediates_buffer_size(\n247\t            buffer_size,\n248\t            skip_domain,\n249\t            num_x,\n250\t            num_cosets,\n251\t            max_temp_bytes,\n252\t        )\n253\t    };\n254\t\n255\t    let use_prealloc_inter = prealloc_intermediates\n256\t        .as_ref()\n257\t        .map_or(false, |p| intermed_capacity > 0 && p.len() >= intermed_capacity);\n258\t    let mut fallback_intermediates;\n259\t    let intermediates = if use_prealloc_inter {\n260\t        prealloc_intermediates.unwrap()\n261\t    } else {\n262\t        fallback_intermediates = if intermed_capacity > 0 {\n263\t            debug!(\"logup_r0:intermediates_capacity={intermed_capacity}\");\n264\t            DeviceBuffer::<F>::with_capacity(intermed_capacity)\n265\t        } else {\n266\t            DeviceBuffer::<F>::new()\n267\t        };\n268\t        &mut fallback_intermediates\n269\t    };\n270\t\n271\t    let temp_sums_buffer_capacity = unsafe {\n272\t        _logup_r0_temp_sums_buffer_size(buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes)\n273\t    };\n274\t\n275\t    let use_prealloc_temp = prealloc_temp_sums\n276\t        .as_ref()\n277\t        .map_or(false, |p| p.len() >= temp_sums_buffer_capacity);\n278\t    let mut fallback_temp_sums;\n279\t    let temp_sums_buffer = if use_prealloc_temp {\n280\t        prealloc_temp_sums.unwrap()\n281\t    } else {\n282\t        debug!(\"logup_r0:tmp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n283\t        fallback_temp_sums = DeviceBuffer::<Frac<EF>>::with_capacity(temp_sums_buffer_capacity);\n284\t        &mut fallback_temp_sums\n285\t    };\n286\t\n287\t    let used_temp_bytes =\n288\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<Frac<EF>>();\n289\t    if used_temp_bytes > max_temp_bytes {\n290\t        warn!(\n291\t            \"logup_round0 used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\"\n292\t        );\n293\t    }\n294\t\n295\t    let preprocessed_ptr = pk\n296\t        .preprocessed_data\n297\t        .as_ref()\n298\t        .map(|cd| cd.trace.buffer().as_ptr())\n299\t        .unwrap_or(std::ptr::null());\n300\t\n301\t    let mut s_evals = DeviceBuffer::<Frac<EF>>::with_capacity(large_domain as usize);\n302\t\n303\t    unsafe {\n304\t        logup_bary_eval_interactions_round0(\n305\t            temp_sums_buffer,\n306\t            &mut s_evals,\n307\t            selectors_cube,\n308\t            preprocessed_ptr,\n309\t            main_parts,\n310\t            eq_cube,\n311\t            public_values,\n312\t            &d_numer_weights,\n313\t            &d_denom_weights,\n314\t            denom_sum_init,\n315\t            &d_rules,\n316\t            buffer_size,\n317\t            intermediates,\n318\t            skip_domain,\n319\t            num_x,\n320\t            height,\n321\t            num_cosets,\n322\t            g_shift,\n323\t            max_temp_bytes,\n324\t        )?;\n325\t    }\n326\t\n327\t    Ok(s_evals)\n328\t}\n329\t"}]},"parent_tool_use_id":"toolu_01KrJkGSXQSuRiHanrn4W4wH","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"e221ffb7-53ca-4bad-a96f-261820d96e19","timestamp":"2026-04-15T08:50:36.284Z"}
