tpub struct LogupCtx {\n63\t    pub eval_ctx: EvalCoreCtx,\n64\t    pub d_intermediates: *mut EF,\n65\t    pub num_y: u32,\n66\t    pub d_eq_xi: *const EF,\n67\t    pub d_challenges: *const EF,\n68\t    pub d_eq_3bs: *const EF,\n69\t    pub d_rules: *const std::ffi::c_void,\n70\t    pub rules_len: usize,\n71\t    pub d_used_nodes: *const usize,\n72\t    pub d_pair_idxs: *const u32,\n73\t    pub used_nodes_len: usize,\n74\t    pub buffer_size: u32,\n75\t}\n76\t\n77\t/// Common per-AIR context for batched logup monomial evaluation.\n78\t#[repr(C)]\n79\t#[derive(Clone, Copy, Debug)]\n80\tpub struct LogupMonomialCommonCtx {\n81\t    pub eval_ctx: EvalCoreCtx,\n82\t    pub d_eq_xi: *const EF,\n83\t    pub bus_term_sum: EF, // Precomputed sum_i(beta[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n84\t    pub num_y: u32,\n85\t    pub mono_blocks: u32,\n86\t}\n87\t\n88\t/// Per-AIR context for batched logup monomial evaluation (numerator or denominator).\n89\t#[repr(C)]\n90\t#[derive(Clone, Copy, Debug)]\n91\tpub struct LogupMonomialCtx {\n92\t    pub d_headers: *const MonomialHeader,\n93\t    pub d_variables: *const PackedVar,\n94\t    pub d_combinations: *const EF,\n95\t    pub num_monomials: u32,\n96\t}\n97\t/// Descriptor for batched interpolation of columns across multiple traces.\n98\t#[repr(C)]\n99\t#[derive(Clone, Copy, Debug)]\n100\tpub struct InterpColDesc {"}]},"parent_tool_use_id":"toolu_01BpDXMwv3zxyLVTE5Be6t3Z","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"11b23fc9-889d-4aee-980d-8a503814c766","timestamp":"2026-04-15T09:12:33.438Z"}
