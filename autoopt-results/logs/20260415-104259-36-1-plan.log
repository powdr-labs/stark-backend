{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015JvCBvmdAnAfVKvSZvuR3r","type":"tool_result","content":"1\tuse core::fmt::Debug;\n2\t\n3\tuse getset::Getters;\n4\tuse p3_field::{BasedVectorSpace, ExtensionField, PrimeField64, TwoAdicField};\n5\tuse serde::{Deserialize, Serialize};\n6\t\n7\tuse crate::{hasher::MerkleHasher, interaction::LogUpSecurityParameters};\n8\t\n9\tpub const DEFAULT_K_WHIR: usize = 4;\n10\t\n11\t/// Trait that holds the associated types for the SWIRL protocol. These are the types needed by the\n12\t/// verifier and must be independent of the prover backend.\n13\t///\n14\t/// This trait only holds the associated types and the struct implementing the trait does not hold\n15\t/// the system parameters. System parameters are specified and stored separated in [SystemParams].\n16\t///\n17\t/// The trait has an **implicit** associated Fiat-Shamir transcript type, including the hash used.\n18\t/// There is no explicit associated type because the concrete implementation of the transcript may\n19\t/// differ between prover and verifier and the verifier may further employ different implementations\n20\t/// for logging or debugging purposes. The trait controlling concrete implementations of the\n21\t/// transcript is specified by [`FiatShamirTranscript`](crate::FiatShamirTranscript).\n22\tpub trait StarkProtocolConfig: 'static + Clone + Send + Sync {\n23\t    /// The prime base field.\n24\t    type F: TwoAdicField + PrimeField64;\n25\t    /// The extension field, used for random challenges.\n26\t    type EF: TwoAdicField + ExtensionField<Self::F>;\n27\t    /// The digest type used for commitments.\n28\t    type Digest: Copy\n29\t        + Send\n30\t        + Sync\n31\t        + Debug\n32\t        + Default\n33\t        + PartialEq\n34\t        + Eq\n35\t        + Serialize\n36\t        + for<'de> Deserialize<'de>;\n37\t    /// The merkle tree hasher used by the polynomial commitment scheme.\n38\t    type Hasher: MerkleHasher<F = Self::F, Digest = Self::Digest>;\n39\t\n40\t    /// Degree of the extension field.\n41\t    const D_EF: usize = <Self::EF as BasedVectorSpace<Self::F>>::DIMENSION;\n42\t\n43\t    fn params(&self) -> &SystemParams;\n44\t\n45\t    fn hasher(&self) -> &Self::Hasher;\n46\t}\n47\t\n48\t/// Type alias for backwards compatibility. New implementations should use `SC::F`.\n49\tpub type Val<SC> = <SC as StarkProtocolConfig>::F;\n50\t/// Type alias for backwards compatibility. New implementations should use `SC::Digest`.\n51\tpub type Com<SC> = <SC as StarkProtocolConfig>::Digest;\n52\t\n53\t#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq, Getters)]\n54\tpub struct SystemParams {\n55\t    pub l_skip: usize,\n56\t    pub n_stack: usize,\n57\t    /// Maximum number of stacked polynomials (i.e. stacked matrix width). This implies a max\n58\t    /// stacked cell count of `w_stack * 2^(n_stack + l_skip)`.\n59\t    pub w_stack: usize,\n60\t    /// `-log_2` of the rate for the initial Reed-Solomon code.\n61\t    pub log_blowup: usize,\n62\t    #[getset(get = \"pub\")]\n63\t    pub whir: WhirConfig,\n64\t    pub logup: LogUpSecurityParameters,\n65\t    /// Global max constraint degree enforced across all AIR and Interaction constraints\n66\t    pub max_constraint_degree: usize,\n67\t}\n68\t\n69\timpl SystemParams {\n70\t    pub fn logup_pow_bits(&self) -> usize {\n71\t        self.logup.pow_bits\n72\t    }\n73\t\n74\t    pub fn k_whir(&self) -> usize {\n75\t        self.whir.k\n76\t    }\n77\t\n78\t    #[inline]\n79\t    pub fn log_stacked_height(&self) -> usize {\n80\t        self.l_skip + self.n_stack\n81\t    }\n82\t\n83\t    #[inline]\n84\t    pub fn log_final_poly_len(&self) -> usize {\n85\t        self.whir.log_final_poly_len(self.log_stacked_height())\n86\t    }\n87\t\n88\t    #[inline]\n89\t    pub fn num_whir_rounds(&self) -> usize {\n90\t        self.whir.num_whir_rounds()\n91\t    }\n92\t\n93\t    #[inline]\n94\t    pub fn num_whir_sumcheck_rounds(&self) -> usize {\n95\t        self.whir.num_sumcheck_rounds()\n96\t    }\n97\t\n98\t    /// Constructor with many configuration options. Only `k_whir`, `max_constraint_degree`,\n99\t    /// `query_phase_pow_bits` are preset with constants.\n100\t    ///\n101\t    /// The `security_bits` is the target bits of security. It is used to select the number of WHIR\n102\t    /// queries, but does **not** guarantee the target security level is achieved by the overall\n103\t    /// protocol using these parameters. Use the soundness calculator to ensure the target security\n104\t    /// level is met.\n105\t    ///\n106\t    /// This function should only be used for internal cryptography libraries. Most users should\n107\t    /// instead use preset parameters provided in SDKs.\n108\t    #[allow(clippy::too_many_arguments)]\n109\t    pub fn new(\n110\t        log_blowup: usize,\n111\t        l_skip: usize,\n112\t        n_stack: usize,\n113\t        w_stack: usize,\n114\t        log_final_poly_len: usize,\n115\t        folding_pow_bits: usize,\n116\t        mu_pow_bits: usize,\n117\t        proximity: WhirProximityStrategy,\n118\t        security_bits: usize,\n119\t        logup: LogUpSecurityParameters,\n120\t    ) -> SystemParams {\n121\t        const WHIR_QUERY_PHASE_POW_BITS: usize = 20;\n122\t\n123\t        let k_whir = DEFAULT_K_WHIR;\n124\t        let max_constraint_degree = 4;\n125\t        let log_stacked_height = l_skip + n_stack;\n126\t\n127\t        SystemParams {\n128\t            l_skip,\n129\t            n_stack,\n130\t            w_stack,\n131\t            log_blowup,\n132\t            whir: WhirConfig::new(\n133\t                log_blowup,\n134\t                log_stacked_height,\n135\t                WhirParams {\n136\t                    k: k_whir,\n137\t                    log_final_poly_len,\n138\t                    query_phase_pow_bits: WHIR_QUERY_PHASE_POW_BITS,\n139\t                    proximity,\n140\t                    folding_pow_bits,\n141\t                    mu_pow_bits,\n142\t                },\n143\t                security_bits,\n144\t            ),\n145\t            logup,\n146\t            max_constraint_degree,\n147\t        }\n148\t    }\n149\t}\n150\t\n151\t/// Configurable parameters that are used to determine the [WhirConfig] for a target security level.\n152\t#[derive(Clone, Copy, Debug, Serialize, Deserialize, PartialEq, Eq)]\n153\tpub struct WhirParams {\n154\t    pub k: usize,\n155\t    /// WHIR rounds will stop as soon as `log2` of the final polynomial length is `<=\n156\t    /// log_final_poly_len`.\n157\t    pub log_final_poly_len: usize,\n158\t    pub query_phase_pow_bits: usize,\n159\t    /// Proximity regime to use within each WHIR round. This is used to determine the number of\n160\t    /// queries in each round for a target security level.\n161\t    pub proximity: WhirProximityStrategy,\n162\t    /// Number of bits of grinding to increase security of each folding step.\n163\t    pub folding_pow_bits: usize,\n164\t    /// Number of bits of grinding before sampling the μ batching challenge.\n165\t    pub mu_pow_bits: usize,\n166\t}\n167\t\n168\t#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n169\tpub struct WhirConfig {\n170\t    /// Constant folding factor. This means that `2^k` terms are folded per round.\n171\t    pub k: usize,\n172\t    pub rounds: Vec<WhirRoundConfig>,\n173\t    /// Number of bits of grinding before sampling the μ batching challenge.\n174\t    pub mu_pow_bits: usize,\n175\t    /// Number of bits of grinding for the query phase of each WHIR round.\n176\t    /// The PoW bits can vary per round, but for simplicity we use the same number for all rounds.\n177\t    pub query_phase_pow_bits: usize,\n178\t    /// Number of bits of grinding before sampling folding randomness in each WHIR round.\n179\t    /// The folding PoW bits can vary per round, but for simplicity (and efficiency of the\n180\t    /// recursion circuit) we use the same number for all rounds.\n181\t    pub folding_pow_bits: usize,\n182\t    /// Proximity regimes for WHIR rounds. We use only proven error bounds.\n183\t    ///\n184\t    /// Note: this field is not needed by the verifier as it is only used to determine the number\n185\t    /// of queries in the `rounds` field. However we store it in `WhirConfig` for security analysis\n186\t    /// purposes.\n187\t    pub proximity: WhirProximityStrategy,\n188\t}\n189\t\n190\t#[derive(Clone, Copy, Debug, Serialize, Deserialize, PartialEq, Eq)]\n191\tpub struct WhirRoundConfig {\n192\t    /// Number of in-domain queries sampled in this WHIR round.\n193\t    pub num_queries: usize,\n194\t}\n195\t\n196\t#[derive(Clone, Copy, Debug, Serialize, Deserialize, PartialEq, Eq)]\n197\tpub enum WhirProximityStrategy {\n198\t    /// Unique decoding regime in every WHIR round.\n199\t    UniqueDecoding,\n200\t    /// Unique decoding regime in the initial `list_start_round` WHIR rounds. Then list decoding\n201\t    /// regime with the same proximity radius derived from `m` (see `ListDecoding`) for all\n202\t    /// subsequent WHIR rounds (0-indices `>= list_start_round`). Note that a WHIR round\n203\t    /// consists of codewords of different degrees with the same rate. The WHIR round changes\n204\t    /// when the rate changes.\n205\t    SplitUniqueList { m: usize, list_start_round: usize },\n206\t    /// List decoding regime in every WHIR round, with the same proximity radius derived from `m`,\n207\t    /// where `m = ceil(sqrt(\\rho) / 2 \\eta), \\eta = 1 - sqrt(\\rho) - \\delta, where \\delta is the\n208\t    /// proximity radius.\n209\t    ListDecoding { m: usize },\n210\t}\n211\t\n212\timpl WhirProximityStrategy {\n213\t    pub fn initial_round(&self) -> ProximityRegime {\n214\t        self.in_round(0)\n215\t    }\n216\t\n217\t    pub fn in_round(&self, whir_round: usize) -> ProximityRegime {\n218\t        match *self {\n219\t            Self::UniqueDecoding => ProximityRegime::UniqueDecoding,\n220\t            Self::SplitUniqueList {\n221\t                m,\n222\t                list_start_round,\n223\t            } => {\n224\t                if whir_round < list_start_round {\n225\t                    ProximityRegime::UniqueDecoding\n226\t                } else {\n227\t                    ProximityRegime::ListDecoding { m }\n228\t                }\n229\t            }\n230\t            Self::ListDecoding { m } => ProximityRegime::ListDecoding { m },\n231\t        }\n232\t    }\n233\t}\n234\t\n235\t/// Defines the proximity regime for the proof system.\n236\t#[derive(Clone, Copy, Debug, Serialize, Deserialize, PartialEq, Eq)]\n237\tpub enum ProximityRegime {\n238\t    /// Unique decoding guarantees a single valid witness.\n239\t    UniqueDecoding,\n240\t    /// List decoding bounded by multiplicity `m`.\n241\t    ListDecoding { m: usize },\n242\t}\n243\t\n244\timpl ProximityRegime {\n245\t    /// Returns total security bits for `num_queries` WHIR queries.\n246\t    ///\n247\t    /// This treats the per-query error as an upper bound on the maximum agreement.\n248\t    ///\n249\t    /// - `UniqueDecoding`: max agreement is `(1 + ρ) / 2`.\n250\t    /// - `ListDecoding { m }`: finite-multiplicity Guruswami-Sudan threshold, `sqrt(ρ(1 + 1/m)) +\n251\t    ///   ε` for a tiny `ε`, to keep the proximity threshold strict.\n252\t    pub fn whir_query_security_bits(&self, num_queries: usize, log_inv_rate: usize) -> f64 {\n253\t        let rho = 2.0_f64.powf(-(log_inv_rate as f64));\n254\t        let max_agreement = match *self {\n255\t            ProximityRegime::UniqueDecoding => (1.0 + rho) / 2.0,\n256\t            ProximityRegime::ListDecoding { m } => {\n257\t                let m = m.max(1) as f64;\n258\t                // Johnson bound with a tiny epsilon to ensure strict proximity.\n259\t                (rho * (1.0 + 1.0 / m)).sqrt() + 1e-6\n260\t            }\n261\t        };\n262\t\n263\t        // Keep the `log2` well-defined.\n264\t        let max_agreement = max_agreement.clamp(f64::MIN_POSITIVE, 1.0);\n265\t        -(num_queries as f64) * max_agreement.log2()\n266\t    }\n267\t\n268\t    /// Returns the per-query security bits for WHIR query sampling.\n269\t    pub fn whir_per_query_security_bits(&self, log_inv_rate: usize) -> f64 {\n270\t        self.whir_query_security_bits(1, log_inv_rate)\n271\t    }\n272\t}\n273\t\n274\timpl WhirConfig {\n275\t    /// Sets parameters targeting `security_bits` of provable security (including grinding), using\n276\t    /// the given proximity regime.\n277\t    pub fn new(\n278\t        log_blowup: usize,\n279\t        log_stacked_height: usize,\n280\t        whir_params: WhirParams,\n281\t        security_bits: usize,\n282\t    ) -> Self {\n283\t        let query_phase_pow_bits = whir_params.query_phase_pow_bits;\n284\t        let protocol_security_level = security_bits.saturating_sub(query_phase_pow_bits);\n285\t        let k_whir = whir_params.k;\n286\t        let num_rounds = log_stacked_height\n287\t            .saturating_sub(whir_params.log_final_poly_len)\n288\t            .div_ceil(k_whir);\n289\t        let mut log_inv_rate = log_blowup;\n290\t        let proximity = whir_params.proximity;\n291\t\n292\t        let mut round_parameters = Vec::with_capacity(num_rounds);\n293\t        for round in 0..num_rounds {\n294\t            // Queries are set w.r.t. to old rate, while the rest to the new rate\n295\t            let next_rate = log_inv_rate + (k_whir - 1);\n296\t\n297\t            let num_queries = Self::queries(\n298\t                proximity.in_round(round),\n299\t                protocol_security_level,\n300\t                log_inv_rate,"}]},"parent_tool_use_id":"toolu_015Z1cN3tKpZN3PXeGDyNzJ5","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"742944a1-cd88-4126-99e6-ebe290b2b3a3","timestamp":"2026-04-15T08:50:53.068Z"}
