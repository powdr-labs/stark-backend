{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AH96Ciz8XbdSVrTTimRiUg","type":"tool_result","content":"1\tuse itertools::Itertools;\n2\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer};\n3\tuse openvm_stark_backend::{\n4\t    air_builders::symbolic::{\n5\t        symbolic_expression::SymbolicExpression, SymbolicConstraints, SymbolicDagBuilder,\n6\t        SymbolicExpressionDag,\n7\t    },\n8\t    prover::{fractional_sumcheck_gkr::Frac, DeviceStarkProvingKey},\n9\t};\n10\tuse p3_field::PrimeCharacteristicRing;\n11\tuse tracing::{debug, warn};\n12\t\n13\tuse super::errors::Round0EvalError;\n14\tuse crate::{\n15\t    cuda::logup_zerocheck::{\n16\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n17\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n18\t        logup_bary_eval_interactions_round0, zerocheck_ntt_eval_constraints,\n19\t    },\n20\t    gpu_backend::GenericGpuBackend,\n21\t    hash_scheme::GpuHashScheme,\n22\t    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n23\t    prelude::{EF, F},\n24\t};\n25\t\n26\t/// Pre-allocated per-thread GPU buffers for Round 0 evaluation.\n27\t/// Reused across AIRs to eliminate per-AIR mutex contention on the global memory manager.\n28\tpub(crate) struct Round0ThreadBuffers {\n29\t    pub zc_intermediates: DeviceBuffer<F>,\n30\t    pub zc_temp_sums: DeviceBuffer<EF>,\n31\t    pub logup_intermediates: DeviceBuffer<F>,\n32\t    pub logup_temp_sums: DeviceBuffer<Frac<EF>>,\n33\t}\n34\t\n35\t/// Evaluate plain AIR constraints (not interactions) for a single AIR, given prepared trace input.\n36\t///\n37\t/// `num_cosets` should equal `constraint_degree - 1` because we evaluate the quotient polynomial.\n38\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n39\t#[allow(clippy::too_many_arguments)]\n40\tpub fn evaluate_round0_constraints_gpu<HS: GpuHashScheme>(\n41\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n42\t    selectors_cube: &DeviceBuffer<F>,\n43\t    main_parts: &DeviceBuffer<*const F>,\n44\t    public_values: &DeviceBuffer<F>,\n45\t    eq_cube: *const EF,\n46\t    lambda_pows: &DeviceBuffer<EF>,\n47\t    skip_domain: u32,\n48\t    num_x: u32,\n49\t    height: u32,\n50\t    num_cosets: u32,\n51\t    g_shift: F,\n52\t    max_temp_bytes: usize,\n53\t    prealloc_intermediates: Option<&mut DeviceBuffer<F>>,\n54\t    prealloc_temp_sums: Option<&mut DeviceBuffer<EF>>,\n55\t) -> Result<DeviceBuffer<EF>, Round0EvalError> {\n56\t    let constraints_dag = &pk.vk.symbolic_constraints;\n57\t    if constraints_dag.constraints.constraint_idx.is_empty() || num_cosets == 0 {\n58\t        // No plain AIR constraints, return empty buffer\n59\t        return Ok(DeviceBuffer::new());\n60\t    }\n61\t\n62\t    let rules = &pk.other_data.zerocheck_round0;\n63\t\n64\t    let buffer_size: u32 = rules.inner.buffer_size;\n65\t    let intermed_capacity = unsafe {\n66\t        _zerocheck_r0_intermediates_buffer_size(\n67\t            buffer_size,\n68\t            skip_domain,\n69\t            num_x,\n70\t            num_cosets,\n71\t            max_temp_bytes,\n72\t        )\n73\t    };\n74\t\n75\t    let use_prealloc_inter = prealloc_intermediates\n76\t        .as_ref()\n77\t        .map_or(false, |p| intermed_capacity > 0 && p.len() >= intermed_capacity);\n78\t    let mut fallback_intermediates;\n79\t    let intermediates = if use_prealloc_inter {\n80\t        prealloc_intermediates.unwrap()\n81\t    } else {\n82\t        fallback_intermediates = if intermed_capacity > 0 {\n83\t            debug!(\"zerocheck:intermediates_capacity={intermed_capacity}\");\n84\t            DeviceBuffer::<F>::with_capacity(intermed_capacity)\n85\t        } else {\n86\t            DeviceBuffer::<F>::new()\n87\t        };\n88\t        &mut fallback_intermediates\n89\t    };\n90\t\n91\t    let temp_sums_buffer_capacity = unsafe {\n92\t        _zerocheck_r0_temp_sums_buffer_size(\n93\t            buffer_size,\n94\t            skip_domain,\n95\t            num_x,\n96\t            num_cosets,\n97\t            max_temp_bytes,\n98\t        )\n99\t    };\n100\t\n101\t    let use_prealloc_temp = prealloc_temp_sums\n102\t        .as_ref()\n103\t        .map_or(false, |p| p.len() >= temp_sums_buffer_capacity);\n104\t    let mut fallback_temp_sums;\n105\t    let temp_sums_buffer = if use_prealloc_temp {\n106\t        prealloc_temp_sums.unwrap()\n107\t    } else {\n108\t        debug!(\"zerocheck:temp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n109\t        fallback_temp_sums = DeviceBuffer::<EF>::with_capacity(temp_sums_buffer_capacity);\n110\t        &mut fallback_temp_sums\n111\t    };\n112\t\n113\t    let used_temp_bytes =\n114\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<EF>();\n115\t    if used_temp_bytes > max_temp_bytes {\n116\t        warn!(\"zerocheck used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\");\n117\t    }\n118\t\n119\t    let preprocessed_ptr = pk\n120\t        .preprocessed_data\n121\t        .as_ref()\n122\t        .map(|cd| cd.trace.buffer().as_ptr())\n123\t        .unwrap_or(std::ptr::null());\n124\t\n125\t    let mut sp_evals =\n126\t        DeviceBuffer::<EF>::with_capacity(num_cosets as usize * skip_domain as usize);\n127\t    // SAFETY:\n128\t    // - No bounds checks are done in this kernel. It fully assumes that the Rules are trusted and\n129\t    //   all nodes are valid.\n130\t    unsafe {\n131\t        zerocheck_ntt_eval_constraints(\n132\t            temp_sums_buffer,\n133\t            &mut sp_evals,\n134\t            selectors_cube,\n135\t            preprocessed_ptr,\n136\t            main_parts,\n137\t            eq_cube,\n138\t            lambda_pows,\n139\t            public_values,\n140\t            &rules.inner.d_rules,\n141\t            &rules.inner.d_used_nodes,\n142\t            buffer_size,\n143\t            intermediates,\n144\t            skip_domain,\n145\t            num_x,\n146\t            height,\n147\t            num_cosets,\n148\t            g_shift,\n149\t            max_temp_bytes,\n150\t        )?;\n151\t    }\n152\t\n153\t    Ok(sp_evals)\n154\t}\n155\t\n156\t/// Evaluate interaction constraints (excluding plain AIR constraints) for a single AIR, given\n157\t/// prepared trace input.\n158\t///\n159\t/// `constraints` includes interaction expressions for the AIR.\n160\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n161\t#[allow(clippy::too_many_arguments)]\n162\tpub fn evaluate_round0_interactions_gpu<HS: GpuHashScheme>(\n163\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n164\t    symbolic: &SymbolicConstraints<F>,\n165\t    selectors_cube: &DeviceBuffer<F>,\n166\t    main_parts: &DeviceBuffer<*const F>,\n167\t    public_values: &DeviceBuffer<F>,\n168\t    eq_cube: *const EF,\n169\t    beta_pows: &[EF],\n170\t    eq_3bs: &[EF],\n171\t    skip_domain: u32,\n172\t    num_x: u32,\n173\t    height: u32,\n174\t    num_cosets: u32,\n175\t    g_shift: F,\n176\t    max_temp_bytes: usize,\n177\t    prealloc_intermediates: Option<&mut DeviceBuffer<F>>,\n178\t    prealloc_temp_sums: Option<&mut DeviceBuffer<Frac<EF>>>,\n179\t) -> Result<DeviceBuffer<Frac<EF>>, Round0EvalError> {\n180\t    // Check if this trace has interactions\n181\t    if eq_3bs.is_empty() {\n182\t        return Ok(DeviceBuffer::new());\n183\t    }\n184\t    let large_domain = num_cosets * skip_domain;\n185\t\n186\t    // We create a new \"interactions DAG\" where the new .constraints are the interaction [count,\n187\t    // message_0, message_1, ..] expressions themselves, while the .interactions are empty\n188\t    // We track the indices with InteractionNode\n189\t\n190\t    // Copied from build_symbolic_constraints_dag to handle sorting of constraints\n191\t    // NOTE: For logup round0, the kernel uses weights indexed by rule_idx, not constraint_idx.\n192\t    // So we deduplicate constraint_idx and use dag_idx_to_rule_idx for weight mapping.\n193\t    let (rules, d_numer_weights, d_denom_weights, denom_sum_init) = {\n194\t        let mut dag_builder = SymbolicDagBuilder::new();\n195\t        let mut sorted_used_dag_idxs = Vec::new();\n196\t        for interaction in &symbolic.interactions {\n197\t            let count = dag_builder.add_expr(&interaction.count);\n198\t            sorted_used_dag_idxs.push(count);\n199\t            sorted_used_dag_idxs.extend(\n200\t                interaction\n201\t                    .message\n202\t                    .iter()\n203\t                    .map(|field_expr| dag_builder.add_expr(field_expr)),\n204\t            );\n205\t        }\n206\t        sorted_used_dag_idxs.sort();\n207\t        // Deduplicate for the dag since logup round0 kernel doesn't use used_nodes\n208\t        sorted_used_dag_idxs.dedup();\n209\t        let dag = SymbolicExpressionDag {\n210\t            nodes: dag_builder.nodes,\n211\t            constraint_idx: sorted_used_dag_idxs,\n212\t        };\n213\t        let rules = SymbolicRulesGpu::new(&dag, true);\n214\t        let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n215\t        let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n216\t        let mut denom_sum_init = EF::ZERO;\n217\t        for (interaction_idx, interaction) in symbolic.interactions.iter().enumerate() {\n218\t            // CAUTION: an expression node could be used in multiple interactions, and might even be\n219\t            // used as `count` in one, but message field in another. We only care about their\n220\t            // weighted sum with eq_3b, so we compute the weights ahead of time.\n221\t            let count_dag_idx =\n222\t                dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];\n223\t            let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n224\t            numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n225\t            denom_sum_init += eq_3bs[interaction_idx]\n226\t                * beta_pows[interaction.message.len()]\n227\t                * F::from_u32(interaction.bus_index as u32 + 1);\n228\t\n229\t            for (message_idx, message) in interaction.message.iter().enumerate() {\n230\t                let message_dag_idx =\n231\t                    dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n232\t                let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n233\t                denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];\n234\t            }\n235\t        }\n236\t        let d_numer_weights = numer_weights.to_device()?;\n237\t        let d_denom_weights = denom_weights.to_device()?;\n238\t        (rules, d_numer_weights, d_denom_weights, denom_sum_init)\n239\t    };\n240\t\n241\t    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n242\t    let d_rules = encoded_rules.to_device()?;\n243\t\n244\t    let buffer_size: u32 = rules.buffer_size.try_into().unwrap();\n245\t    let intermed_capacity = unsafe {\n246\t        _logup_r0_intermediates_buffer_size(\n247\t            buffer_size,\n248\t            skip_domain,\n249\t            num_x,\n250\t            num_cosets,\n251\t            max_temp_bytes,\n252\t        )\n253\t    };\n254\t\n255\t    let use_prealloc_inter = prealloc_intermediates\n256\t        .as_ref()\n257\t        .map_or(false, |p| intermed_capacity > 0 && p.len() >= intermed_capacity);\n258\t    let mut fallback_intermediates;\n259\t    let intermediates = if use_prealloc_inter {\n260\t        prealloc_intermediates.unwrap()\n261\t    } else {\n262\t        fallback_intermediates = if intermed_capacity > 0 {\n263\t            debug!(\"logup_r0:intermediates_capacity={intermed_capacity}\");\n264\t            DeviceBuffer::<F>::with_capacity(intermed_capacity)\n265\t        } else {\n266\t            DeviceBuffer::<F>::new()\n267\t        };\n268\t        &mut fallback_intermediates\n269\t    };\n270\t\n271\t    let temp_sums_buffer_capacity = unsafe {\n272\t        _logup_r0_temp_sums_buffer_size(buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes)\n273\t    };\n274\t\n275\t    let use_prealloc_temp = prealloc_temp_sums\n276\t        .as_ref()\n277\t        .map_or(false, |p| p.len() >= temp_sums_buffer_capacity);\n278\t    let mut fallback_temp_sums;\n279\t    let temp_sums_buffer = if use_prealloc_temp {\n280\t        prealloc_temp_sums.unwrap()\n281\t    } else {\n282\t        debug!(\"logup_r0:tmp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n283\t        fallback_temp_sums = DeviceBuffer::<Frac<EF>>::with_capacity(temp_sums_buffer_capacity);\n284\t        &mut fallback_temp_sums\n285\t    };\n286\t\n287\t    let used_temp_bytes =\n288\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<Frac<EF>>();\n289\t    if used_temp_bytes > max_temp_bytes {\n290\t        warn!(\n291\t            \"logup_round0 used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\"\n292\t        );\n293\t    }\n294\t\n295\t    let preprocessed_ptr = pk\n296\t        .preprocessed_data\n297\t        .as_ref()\n298\t        .map(|cd| cd.trace.buffer().as_ptr())\n299\t        .unwrap_or(std::ptr::null());\n300\t\n301\t    let mut s_evals = DeviceBuffer::<Frac<EF>>::with_capacity(large_domain as usize);\n302\t\n303\t    unsafe {\n304\t        logup_bary_eval_interactions_round0(\n305\t            temp_sums_buffer,\n306\t            &mut s_evals,\n307\t            selectors_cube,\n308\t            preprocessed_ptr,\n309\t            main_parts,\n310\t            eq_cube,\n311\t            public_values,\n312\t            &d_numer_weights,\n313\t            &d_denom_weights,\n314\t            denom_sum_init,\n315\t            &d_rules,\n316\t            buffer_size,\n317\t            intermediates,\n318\t            skip_domain,\n319\t            num_x,\n320\t            height,\n321\t            num_cosets,\n322\t            g_shift,\n323\t            max_temp_bytes,\n324\t        )?;\n325\t    }\n326\t\n327\t    Ok(s_evals)\n328\t}\n329\t"}]},"parent_tool_use_id":"toolu_01BpDXMwv3zxyLVTE5Be6t3Z","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"2fccd39a-5d4d-47d6-8904-c1d0a5edf212","timestamp":"2026-04-15T09:11:37.191Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G1gn4dKHHCVga3QBGgTFG2","type":"tool_result","content":"244\tfn process_air_round0<HS: GpuHashScheme>(\n245\t    w: &Round0AirWorkItem<HS>,\n246\t    bufs: &mut round0::Round0ThreadBuffers,\n247\t    d_batch_ptr: *mut EF,\n248\t    extract_tables: &FxHashMap<usize, Round0ExtractTables>,\n249\t) -> Result<(), LogupZerocheckError> {\n250\t    let single_pk = w.single_pk;\n251\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n252\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n253\t    assert!(\n254\t        local_constraint_deg <= w.constraint_degree,\n255\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n256\t        w.constraint_degree\n257\t    );\n258\t\n259\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n260\t    let omega_root = F::two_adic_generator(log_large_domain);\n261\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n262\t\n263\t    let height = w.common_main.height();\n264\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n265\t    for committed in w.cached_mains {\n266\t        main_parts.push(committed.trace.buffer().as_ptr());\n267\t    }\n268\t    main_parts.push(w.common_main.buffer().as_ptr());\n269\t    let d_main_parts = main_parts.to_device()?;\n270\t\n271\t    let n_lift = w.n.max(0) as usize;\n272\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n273\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n274\t\n275\t    // Check if pre-allocated zerocheck buffers are large enough for this AIR\n276\t    let zc_prealloc_inter = if w.zc_intermed_cap > 0\n277\t        && bufs.zc_intermediates.len() >= w.zc_intermed_cap\n278\t    {\n279\t        Some(&mut bufs.zc_intermediates)\n280\t    } else {\n281\t        None\n282\t    };\n283\t    let zc_prealloc_temp = if w.zc_temp_sums_cap > 0\n284\t        && bufs.zc_temp_sums.len() >= w.zc_temp_sums_cap\n285\t    {\n286\t        Some(&mut bufs.zc_temp_sums)\n287\t    } else {\n288\t        None\n289\t    };\n290\t\n291\t    let sum_buffer = evaluate_round0_constraints_gpu(\n292\t        single_pk,\n293\t        w.selectors_cube.buffer(),\n294\t        &d_main_parts,\n295\t        w.public_values,\n296\t        eq_xi_tree.get_ptr(n_lift),\n297\t        w.d_lambda_pows,\n298\t        1 << w.l_skip,\n299\t        1 << n_lift,\n300\t        height as u32,\n301\t        num_cosets_zc as u32,\n302\t        omega_root,\n303\t        w.max_temp_bytes,\n304\t        zc_prealloc_inter,\n305\t        zc_prealloc_temp,\n306\t    )?;\n307\t\n308\t    // GPU-side polynomial extraction: launch a small kernel to compute\n309\t    // iDFT + Lagrange interpolation + coefficient adjustment on-device,\n310\t    // writing directly into the batch array. No D2H sync needed.\n311\t    if !sum_buffer.is_empty() {\n312\t        let tables = &extract_tables[&local_constraint_deg];\n313\t        let err = unsafe {\n314\t            _round0_extract_zerocheck_poly(\n315\t                d_batch_ptr.add(w.zc_batch_offset),\n316\t                sum_buffer.as_ptr(),\n317\t                tables.zc_transform.as_ptr(),\n318\t                tables.zc_input_size,\n319\t                tables.zc_output_size,\n320\t            )\n321\t        };\n322\t        if err != 0 {\n323\t            return Err(Round0EvalError::Cuda(CudaError::new(err)).into());\n324\t        }\n325\t    }\n326\t    // sum_buffer dropped here; cudaFreeAsync is ordered after the kernel on the same stream\n327\t\n328\t    let num_cosets_logup = local_constraint_deg;\n329\t\n330\t    // Check if pre-allocated logup buffers are large enough for this AIR\n331\t    let logup_prealloc_inter = if w.logup_intermed_cap > 0\n332\t        && bufs.logup_intermediates.len() >= w.logup_intermed_cap\n333\t    {\n334\t        Some(&mut bufs.logup_intermediates)\n335\t    } else {\n336\t        None\n337\t    };\n338\t    let logup_prealloc_temp = if w.logup_temp_sums_cap > 0\n339\t        && bufs.logup_temp_sums.len() >= w.logup_temp_sums_cap\n340\t    {\n341\t        Some(&mut bufs.logup_temp_sums)\n342\t    } else {\n343\t        None\n344\t    };\n345\t\n346\t    let sum = evaluate_round0_interactions_gpu(\n347\t        single_pk,\n348\t        &single_air_constraints,\n349\t        w.selectors_cube.buffer(),\n350\t        &d_main_parts,\n351\t        w.public_values,\n352\t        eq_xi_tree.get_ptr(n_lift),\n353\t        w.beta_pows,\n354\t        w.eq_3bs,\n355\t        1 << w.l_skip,\n356\t        1 << n_lift,\n357\t        height as u32,\n358\t        num_cosets_logup as u32,\n359\t        omega_root,\n360\t        w.max_temp_bytes,\n361\t        logup_prealloc_inter,\n362\t        logup_prealloc_temp,\n363\t    )?;\n364\t\n365\t    if !sum.is_empty() {\n366\t        let tables = &extract_tables[&local_constraint_deg];\n367\t        let norm_factor: EF = if w.n.is_negative() {\n368\t            EF::from(F::from_u32(1 << w.n.unsigned_abs()).inverse())\n369\t        } else {\n370\t            EF::ONE\n371\t        };\n372\t        let err = unsafe {\n373\t            _round0_extract_logup_polys(\n374\t                d_batch_ptr.add(w.numer_batch_offset),\n375\t                d_batch_ptr.add(w.denom_batch_offset),\n376\t                sum.as_ptr(),\n377\t                tables.logup_transform.as_ptr(),\n378\t                tables.logup_size,\n379\t                tables.logup_size,\n380\t                norm_factor,\n381\t            )\n382\t        };\n383\t        if err != 0 {\n384\t            return Err(Round0EvalError::Cuda(CudaError::new(err)).into());\n385\t        }\n386\t    }\n387\t\n388\t    Ok(())\n389\t}\n390\t\n391\t#[allow(clippy::type_complexity)]\n392\t#[instrument(level = \"info\", skip_all)]\n393\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n394\t    transcript: &mut TS,\n395\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n396\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n397\t    save_memory: bool,\n398\t    monomial_num_y_threshold: u32,\n399\t    sm_count: u32,\n400\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n401\twhere\n402\t    HS: GpuHashScheme,\n403\t    TS: GpuFiatShamirTranscript<HS::SC>,\n404\t{\n405\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n406\t    let l_skip = mpk.params.l_skip;\n407\t    let constraint_degree = mpk.max_constraint_degree;\n408\t    let num_traces = ctx.per_trace.len();\n409\t\n410\t    // Traces are sorted\n411\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n412\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n413\t    // heights\n414\t    let mut total_interactions = 0u64;\n415\t    let interactions_meta: Vec<_> = ctx\n416\t        .per_trace\n417\t        .iter()\n418\t        .map(|(air_idx, air_ctx)| {\n419\t            let pk = &mpk.per_air[*air_idx];\n420\t\n421\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n422\t            let height = air_ctx.common_main.height();\n423\t            let log_height = log2_strict_usize(height);\n424\t            let log_lifted_height = log_height.max(l_skip);\n425\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n426\t            (num_interactions, log_lifted_height)\n427\t        })\n428\t        .collect();\n429\t    // Implicitly, the width of this stacking should be 1\n430\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n431\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n432\t    // GKR\n433\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n434\t\n435\t    // Grind to increase soundness of random sampling for LogUp\n436\t    let logup_pow_witness = transcript\n437\t        .grind_gpu(mpk.params.logup.pow_bits)\n438\t        .map_err(LogupZerocheckError::Grind)?;\n439\t    let alpha_logup = transcript.sample_ext();\n440\t    let beta_logup = transcript.sample_ext();\n441\t    debug!(%alpha_logup, %beta_logup);\n442\t\n443\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n444\t    let mut prover = LogupZerocheckGpu::new(\n445\t        mpk,\n446\t        ctx,\n447\t        n_logup,\n448\t        interactions_layout,\n449\t        alpha_logup,\n450\t        beta_logup,\n451\t        save_memory,\n452\t        monomial_num_y_threshold,\n453\t        sm_count,\n454\t    )?;\n455\t    let n_global = prover.n_global;\n456\t\n457\t    let total_leaves = 1 << (l_skip + n_logup);\n458\t    prover\n459\t        .mem\n460\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n461\t    prover.mem.reset_peak();\n462\t    let (inputs, alpha) = if has_interactions {\n463\t        log_gkr_input_evals(\n464\t            &prover.trace_interactions,\n465\t            mpk,\n466\t            ctx,\n467\t            l_skip,\n468\t            alpha_logup,\n469\t            &prover.d_challenges,\n470\t            total_leaves,\n471\t        )?\n472\t    } else {\n473\t        (DeviceBuffer::new(), EF::ZERO)\n474\t    };\n475\t    // Set memory limit for batch MLE based on inputs buffer size\n476\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n477\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n478\t    if !prover.save_memory {\n479\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n480\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n481\t            tracing::warn!(\n482\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n483\t                prover.memory_limit_bytes\n484\t            );\n485\t        }\n486\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n487\t    }\n488\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n489\t\n490\t    let (frac_sum_proof, mut xi) =\n491\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n492\t    while xi.len() != l_skip + n_global {\n493\t        xi.push(transcript.sample_ext());\n494\t    }\n495\t    debug!(?xi);\n496\t    prover.xi = xi;\n497\t\n498\t    logup_gkr_span.exit();\n499\t\n500\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does\n501\t    // not include the kernel times for the actual folding\n502\t    let round0_span = info_span!(\"prover.rap_constraints.round0\", phase = \"prover\").entered();\n503\t    // begin batch sumcheck\n504\t    let mut sumcheck_round_polys = Vec::with_capacity(n_max);\n505\t    let mut r = Vec::with_capacity(n_max + 1);\n506\t    // batching randomness\n507\t    let lambda = transcript.sample_ext();\n508\t    debug!(%lambda);\n509\t\n510\t    let sp_0_polys = prover.sumcheck_uni_round0_polys(ctx, lambda)?;\n511\t    let s_0_cpu_span = info_span!(\"s'_0 -> s_0 cpu interpolations\").entered();\n512\t    let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_degree);\n513\t    let s_deg = constraint_degree + 1;\n514\t    let s_0_deg = sumcheck_round0_deg(l_skip, s_deg);\n515\t    let large_uni_domain = (s_0_deg + 1).next_power_of_two();\n516\t    let dft = Radix2BowersSerial;\n517\t    let s_0_logup_polys = {\n518\t        let eq_sharp_uni = eq_sharp_uni_poly(&prover.xi[..l_skip]);\n519\t        let mut eq_coeffs = eq_sharp_uni.into_coeffs();\n520\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n521\t        let eq_evals = dft.dft(eq_coeffs);\n522\t\n523\t        let width = 2 * num_traces;\n524\t        let mut sp_coeffs_mat = EF::zero_vec(width * large_uni_domain);\n525\t        for (i, coeffs) in sp_0_polys[..2 * num_traces].iter().enumerate() {\n526\t            for (j, &c_j) in coeffs.coeffs().iter().enumerate().take(sp_0_deg + 1) {\n527\t                // SAFETY:\n528\t                // - coeffs length is <= sp_0_deg + 1 <= s_0_deg < large_uni_domain\n529\t                // - sp_coeffs_mat allocated for width\n530\t                unsafe {\n531\t                    *sp_coeffs_mat.get_unchecked_mut(j * width + i) = c_j;\n532\t                }\n533\t            }\n534\t        }\n535\t        let mut s_evals = dft.dft_batch(RowMajorMatrix::new(sp_coeffs_mat, width));\n536\t        for (eq, row) in zip(eq_evals, s_evals.values.chunks_mut(width)) {\n537\t            for x in row {\n538\t                *x *= eq;\n539\t            }\n540\t        }\n541\t        dft.idft_batch(s_evals)\n542\t    };\n543\t    let skip_domain_size = F::from_usize(1 << l_skip);"}]},"parent_tool_use_id":"toolu_01BpDXMwv3zxyLVTE5Be6t3Z","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"6d526b55-05b9-478f-96d8-44deea8557d1","timestamp":"2026-04-15T09:11:37.414Z"}
