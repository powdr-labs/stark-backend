{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AymRpM6Jr8PPjfq5NEQa7y","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    mem::size_of,\n15\t    sync::Arc,\n16\t};\n17\t\n18\tuse itertools::{izip, Itertools};\n19\tuse openvm_cuda_common::{\n20\t    copy::{MemCopyD2H, MemCopyH2D},\n21\t    d_buffer::DeviceBuffer,\n22\t    error::{CudaError, MemCopyError},\n23\t    memory_manager::MemTracker,\n24\t    stream::current_stream_sync,\n25\t};\n26\tuse openvm_stark_backend::{\n27\t    air_builders::symbolic::SymbolicConstraints,\n28\t    calculate_n_logup,\n29\t    dft::Radix2BowersSerial,\n30\t    p3_matrix::dense::RowMajorMatrix,\n31\t    poly_common::{\n32\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n33\t        UnivariatePoly,\n34\t    },\n35\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n36\t    prover::{\n37\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n38\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n39\t        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n40\t    },\n41\t};\n42\tuse p3_dft::TwoAdicSubgroupDft;\n43\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n44\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n45\tuse rustc_hash::FxHashMap;\n46\tuse tracing::{debug, info, info_span, instrument};\n47\t\n48\tuse crate::{\n49\t    base::DeviceMatrix,\n50\t    cuda::{\n51\t        logup_zerocheck::{\n52\t            batched_interpolate_columns_matrix_gpu, fold_selectors_round0, InterpMatrixInfo,\n53\t            InterpTraceDescM, MainMatrixPtrs,\n54\t        },\n55\t        sumcheck::batch_fold_mle,\n56\t    },\n57\t    data_transporter::transport_matrix_d2h_col_major,\n58\t    error::LogupZerocheckError,\n59\t    gpu_backend::GenericGpuBackend,\n60\t    hash_scheme::GpuHashScheme,\n61\t    cuda::logup_zerocheck::{\n62\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n63\t        _round0_extract_logup_polys, _round0_extract_zerocheck_poly,\n64\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n65\t    },\n66\t    logup_zerocheck::{\n67\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n68\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n69\t    },\n70\t    poly::EqEvalLayers,\n71\t    prelude::{EF, F},\n72\t    sponge::GpuFiatShamirTranscript,\n73\t    utils::compute_barycentric_inv_lagrange_denoms,\n74\t};\n75\t\n76\tpub(crate) mod batch_mle;\n77\tpub(crate) mod batch_mle_monomial;\n78\tmod errors;\n79\tpub(crate) mod fold_ple;\n80\t/// Fraction sumcheck via GKR\n81\tmod fractional;\n82\t/// Logup interaction evaluations for GKR input\n83\tmod gkr_input;\n84\tmod mle_round;\n85\tmod round0;\n86\tpub(crate) mod rules;\n87\t\n88\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n89\tuse batch_mle_monomial::{\n90\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n91\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n92\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n93\t};\n94\tpub use errors::*;\n95\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n96\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n97\tuse round0::evaluate_round0_constraints_gpu;\n98\t\n99\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n100\t/// More threads = more concurrent kernels but more peak GPU memory and more\n101\t/// MemoryManager mutex contention. 8 provides good SM utilization on the RTX 4090.\n102\tconst NUM_ROUND0_STREAMS: usize = 8;\n103\t\n104\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n105\t/// instead of the monomial kernel for high num_y traces.\n106\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n107\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n108\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n109\t\n110\t#[inline]\n111\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n112\t    if need_rot {\n113\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n114\t        (mat_width / 2) as u32\n115\t    } else {\n116\t        mat_width as u32\n117\t    }\n118\t}\n119\t\n120\t/// Pre-computed transformation matrices for GPU-side polynomial extraction in Round 0.\n121\t/// Captures the entire pipeline: transpose + iDFT + unshift + Lagrange interpolation\n122\t/// + coefficient adjustment (for zerocheck only).\n123\tstruct Round0ExtractTables {\n124\t    /// Zerocheck: maps eval values to final poly coefficients (with adjustment).\n125\t    /// Row-major [output_size × input_size].\n126\t    zc_transform: DeviceBuffer<EF>,\n127\t    zc_input_size: u32,\n128\t    zc_output_size: u32,\n129\t    /// Logup: maps eval values to poly coefficients (no adjustment).\n130\t    /// Row-major [size × size].\n131\t    logup_transform: DeviceBuffer<EF>,\n132\t    logup_size: u32,\n133\t}\n134\t\n135\t/// Compute transform matrices for a given constraint degree `d` and `l_skip`.\n136\t/// These are pre-computed on the CPU by running the polynomial extraction pipeline\n137\t/// on unit vectors, then uploaded to the GPU.\n138\tfn compute_round0_extract_tables(d: usize, l_skip: usize) -> Result<Round0ExtractTables, MemCopyError> {\n139\t    let skip_domain = 1usize << l_skip;\n140\t    let omega_root = F::two_adic_generator(log2_ceil_usize(d << l_skip));\n141\t\n142\t    // Zerocheck transform: input is (d-1)*skip_domain evals, output is sp_0_deg+1 coefficients\n143\t    let (zc_host, zc_in, zc_out) = {\n144\t        let w = d.saturating_sub(1); // num_cosets_zc\n145\t        if w == 0 {\n146\t            (vec![], 0u32, 0u32)\n147\t        } else {\n148\t            let input_size = w * skip_domain;\n149\t            let output_size = sumcheck_round0_deg(l_skip, d) + 1;\n150\t            let mut transform = vec![EF::ZERO; output_size * input_size];\n151\t            for j in 0..input_size {\n152\t                let src_c = j / skip_domain;\n153\t                let src_i = j % skip_domain;\n154\t                let mut values = EF::zero_vec(input_size);\n155\t                values[src_i * w + src_c] = EF::ONE; // transpose baked in\n156\t                let q = UnivariatePoly::<EF>::from_geometric_cosets_evals_idft(\n157\t                    RowMajorMatrix::new(values, w),\n158\t                    omega_root,\n159\t                    omega_root,\n160\t                );\n161\t                for i in 0..output_size {\n162\t                    let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n163\t                    if i >= skip_domain {\n164\t                        c += q.coeffs()[i - skip_domain];\n165\t                    }\n166\t                    transform[i * input_size + j] = c;\n167\t                }\n168\t            }\n169\t            (transform, input_size as u32, output_size as u32)\n170\t        }\n171\t    };\n172\t\n173\t    // Logup transform: input and output are both d*skip_domain\n174\t    let (logup_host, logup_sz) = {\n175\t        let w = d; // num_cosets_logup\n176\t        let size = w * skip_domain;\n177\t        let mut transform = vec![EF::ZERO; size * size];\n178\t        for j in 0..size {\n179\t            let src_c = j / skip_domain;\n180\t            let src_i = j % skip_domain;\n181\t            let mut values = EF::zero_vec(size);\n182\t            values[src_i * w + src_c] = EF::ONE;\n183\t            let poly = UnivariatePoly::<EF>::from_geometric_cosets_evals_idft(\n184\t                RowMajorMatrix::new(values, w),\n185\t                omega_root,\n186\t                F::ONE,\n187\t            );\n188\t            for i in 0..size {\n189\t                transform[i * size + j] = *poly.coeffs().get(i).unwrap_or(&EF::ZERO);\n190\t            }\n191\t        }\n192\t        (transform, size as u32)\n193\t    };\n194\t\n195\t    let d_zc = if zc_host.is_empty() {\n196\t        DeviceBuffer::new()\n197\t    } else {\n198\t        zc_host.to_device()?\n199\t    };\n200\t    let d_logup = logup_host.to_device()?;\n201\t\n202\t    Ok(Round0ExtractTables {\n203\t        zc_transform: d_zc,\n204\t        zc_input_size: zc_in,\n205\t        zc_output_size: zc_out,\n206\t        logup_transform: d_logup,\n207\t        logup_size: logup_sz,\n208\t    })\n209\t}\n210\t\n211\t/// All read-only references needed to process one AIR in Round 0.\n212\tstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n213\t    trace_idx: usize,\n214\t    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n215\t    n: isize,\n216\t    selectors_cube: &'a DeviceMatrix<F>,\n217\t    public_values: &'a DeviceBuffer<F>,\n218\t    eq_3bs: &'a [EF],\n219\t    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n220\t    common_main: &'a DeviceMatrix<F>,\n221\t    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n222\t    d_lambda_pows: &'a DeviceBuffer<EF>,\n223\t    beta_pows: &'a [EF],\n224\t    l_skip: usize,\n225\t    constraint_degree: usize,\n226\t    xi: &'a [EF],\n227\t    max_temp_bytes: usize,\n228\t    /// Pre-computed zerocheck intermediates buffer capacity needed\n229\t    zc_intermed_cap: usize,\n230\t    /// Pre-computed zerocheck temp sums buffer capacity needed\n231\t    zc_temp_sums_cap: usize,\n232\t    /// Pre-computed logup intermediates buffer capacity needed\n233\t    logup_intermed_cap: usize,\n234\t    /// Pre-computed logup temp sums buffer capacity needed\n235\t    logup_temp_sums_cap: usize,\n236\t    /// Offset into the device batch array for this AIR's zerocheck poly\n237\t    zc_batch_offset: usize,\n238\t    /// Offset for logup numerator poly\n239\t    numer_batch_offset: usize,\n240\t    /// Offset for logup denominator poly\n241\t    denom_batch_offset: usize,\n242\t}\n243\t\n244\tfn process_air_round0<HS: GpuHashScheme>(\n245\t    w: &Round0AirWorkItem<HS>,\n246\t    bufs: &mut round0::Round0ThreadBuffers,\n247\t    d_batch_ptr: *mut EF,\n248\t    extract_tables: &FxHashMap<usize, Round0ExtractTables>,\n249\t) -> Result<(), LogupZerocheckError> {\n250\t    let single_pk = w.single_pk;\n251\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n252\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n253\t    assert!(\n254\t        local_constraint_deg <= w.constraint_degree,\n255\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n256\t        w.constraint_degree\n257\t    );\n258\t\n259\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n260\t    let omega_root = F::two_adic_generator(log_large_domain);\n261\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n262\t\n263\t    let height = w.common_main.height();\n264\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n265\t    for committed in w.cached_mains {\n266\t        main_parts.push(committed.trace.buffer().as_ptr());\n267\t    }\n268\t    main_parts.push(w.common_main.buffer().as_ptr());\n269\t    let d_main_parts = main_parts.to_device()?;\n270\t\n271\t    let n_lift = w.n.max(0) as usize;\n272\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n273\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n274\t\n275\t    // Check if pre-allocated zerocheck buffers are large enough for this AIR\n276\t    let zc_prealloc_inter = if w.zc_intermed_cap > 0\n277\t        && bufs.zc_intermediates.len() >= w.zc_intermed_cap\n278\t    {\n279\t        Some(&mut bufs.zc_intermediates)\n280\t    } else {\n281\t        None\n282\t    };\n283\t    let zc_prealloc_temp = if w.zc_temp_sums_cap > 0\n284\t        && bufs.zc_temp_sums.len() >= w.zc_temp_sums_cap\n285\t    {\n286\t        Some(&mut bufs.zc_temp_sums)\n287\t    } else {\n288\t        None\n289\t    };\n290\t\n291\t    let sum_buffer = evaluate_round0_constraints_gpu(\n292\t        single_pk,\n293\t        w.selectors_cube.buffer(),\n294\t        &d_main_parts,\n295\t        w.public_values,\n296\t        eq_xi_tree.get_ptr(n_lift),\n297\t        w.d_lambda_pows,\n298\t        1 << w.l_skip,\n299\t        1 << n_lift,\n300\t        height as u32,"}]},"parent_tool_use_id":"toolu_01KrJkGSXQSuRiHanrn4W4wH","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"d559dabd-d3e9-4e8d-a8e0-f8fe109049e1","timestamp":"2026-04-15T08:50:41.920Z"}
