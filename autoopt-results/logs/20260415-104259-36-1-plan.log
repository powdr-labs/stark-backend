{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JNWNs4NAm5zX2EfoNwJWcy","type":"tool_result","content":"1\tuse std::{iter::once, sync::Arc};\n2\t\n3\tuse itertools::Itertools;\n4\tuse p3_dft::{Radix2DitParallel, TwoAdicSubgroupDft};\n5\tuse p3_field::{ExtensionField, Field, PrimeCharacteristicRing, TwoAdicField};\n6\tuse p3_maybe_rayon::prelude::*;\n7\tuse p3_util::log2_strict_usize;\n8\tuse tracing::instrument;\n9\t\n10\tuse crate::{\n11\t    poly_common::Squarable,\n12\t    proof::{MerkleProof, WhirProof},\n13\t    prover::{\n14\t        error::WhirProverError,\n15\t        poly::{eval_to_coeff_rs_message, evals_eq_hypercube, evals_mobius_eq_hypercube, Mle},\n16\t        stacked_pcs::{MerkleTree, StackedPcsData},\n17\t        ColMajorMatrix, CpuColMajorBackend, MatrixDimensions, ProverBackend, ReferenceDevice,\n18\t    },\n19\t    FiatShamirTranscript, StarkProtocolConfig, WhirConfig,\n20\t};\n21\t\n22\tpub trait WhirProver<SC: StarkProtocolConfig, PB: ProverBackend, PD, TS> {\n23\t    type Error;\n24\t\n25\t    /// Prove the WHIR protocol for a collection of MLE polynomials \\hat{q}_j, each in n variables,\n26\t    /// at a single vector `u \\in \\Fext^n`.\n27\t    ///\n28\t    /// This means applying WHIR with weight polynomial\n29\t    /// `\\hat{w}(Z, \\vec X) = Z * mobius_eq_poly(u)(\\vec X)`, where `mobius_eq_poly(u)` is the\n30\t    /// Möbius-adjusted equality polynomial for eval-to-coeff RS encoding.\n31\t    ///\n32\t    /// The matrices in `common_main_pcs_data` and `pre_cached_pcs_data_per_commit` must all have\n33\t    /// the same height.\n34\t    fn prove_whir(\n35\t        &self,\n36\t        transcript: &mut TS,\n37\t        common_main_pcs_data: PB::PcsData,\n38\t        pre_cached_pcs_data_per_commit: Vec<Arc<PB::PcsData>>,\n39\t        u_cube: &[PB::Challenge],\n40\t    ) -> Result<WhirProof<SC>, Self::Error>;\n41\t}\n42\t\n43\timpl<SC, TS> WhirProver<SC, CpuColMajorBackend<SC>, ReferenceDevice<SC>, TS> for ReferenceDevice<SC>\n44\twhere\n45\t    SC: StarkProtocolConfig,\n46\t    SC::F: TwoAdicField + Ord,\n47\t    SC::EF: TwoAdicField + ExtensionField<SC::F> + Ord,\n48\t    TS: FiatShamirTranscript<SC>,\n49\t{\n50\t    type Error = WhirProverError;\n51\t\n52\t    #[instrument(level = \"info\", skip_all)]\n53\t    fn prove_whir(\n54\t        &self,\n55\t        transcript: &mut TS,\n56\t        common_main_pcs_data: StackedPcsData<SC::F, SC::Digest>,\n57\t        pre_cached_pcs_data_per_commit: Vec<Arc<StackedPcsData<SC::F, SC::Digest>>>,\n58\t        u_cube: &[SC::EF],\n59\t    ) -> Result<WhirProof<SC>, WhirProverError> {\n60\t        let params = self.params();\n61\t        let committed_mats = once(&common_main_pcs_data)\n62\t            .chain(pre_cached_pcs_data_per_commit.iter().map(|d| d.as_ref()))\n63\t            .map(|d| (&d.matrix, &d.tree))\n64\t            .collect_vec();\n65\t        prove_whir_opening::<SC, _>(\n66\t            transcript,\n67\t            self.config().hasher(),\n68\t            params.l_skip,\n69\t            params.log_blowup,\n70\t            &params.whir,\n71\t            &committed_mats,\n72\t            u_cube,\n73\t        )\n74\t    }\n75\t}\n76\t\n77\t#[allow(clippy::too_many_arguments, clippy::type_complexity)]\n78\tpub fn prove_whir_opening<SC, TS>(\n79\t    transcript: &mut TS,\n80\t    hasher: &SC::Hasher,\n81\t    l_skip: usize,\n82\t    log_blowup: usize,\n83\t    whir_params: &WhirConfig,\n84\t    committed_mats: &[(&ColMajorMatrix<SC::F>, &MerkleTree<SC::F, SC::Digest>)],\n85\t    u: &[SC::EF],\n86\t) -> Result<WhirProof<SC>, WhirProverError>\n87\twhere\n88\t    SC: StarkProtocolConfig,\n89\t    SC::F: TwoAdicField + Ord,\n90\t    SC::EF: TwoAdicField + ExtensionField<SC::F> + Ord,\n91\t    TS: FiatShamirTranscript<SC>,\n92\t{\n93\t    // Proof-of-work grinding before μ batching challenge.\n94\t    // This amplifies soundness of the initial batching step.\n95\t    let mu_pow_witness = transcript.grind(whir_params.mu_pow_bits);\n96\t\n97\t    // Sample randomness for algebraic batching.\n98\t    // We batch the codewords for \\hat{q}_j together _before_ applying WHIR.\n99\t    let mu = transcript.sample_ext();\n100\t    let total_width = committed_mats.iter().map(|(mat, _)| mat.width()).sum();\n101\t    let mu_powers = mu.powers().take(total_width).collect_vec();\n102\t\n103\t    let height = committed_mats[0].0.height();\n104\t    debug_assert!(committed_mats.iter().all(|(mat, _)| mat.height() == height));\n105\t    let mut m = log2_strict_usize(height);\n106\t\n107\t    let k_whir = whir_params.k;\n108\t    let num_whir_rounds = whir_params.num_whir_rounds();\n109\t    let num_sumcheck_rounds = whir_params.num_sumcheck_rounds();\n110\t\n111\t    let mles: Vec<Vec<SC::F>> = committed_mats\n112\t        .par_iter()\n113\t        .flat_map(|(mat, _)| {\n114\t            mat.par_columns().map(|col| {\n115\t                // Convert column evaluations directly into eval-to-coeff RS coefficients, then\n116\t                // interpret them as MLE coefficients of HatF and compute HatF hypercube evals.\n117\t                let mut x = eval_to_coeff_rs_message(l_skip, col);\n118\t                Mle::coeffs_to_evals_inplace(&mut x);\n119\t                x\n120\t            })\n121\t        })\n122\t        .collect();\n123\t\n124\t    // The evaluations of `\\hat{f}` in the current WHIR round on the hypercube `H_m`.\n125\t    let mut f_evals: Vec<_> = (0..1 << m)\n126\t        .into_par_iter()\n127\t        .map(|i| {\n128\t            mles.iter()\n129\t                .zip(mu_powers.iter())\n130\t                .fold(SC::EF::ZERO, |acc, (mle_j, mu_j)| acc + *mu_j * mle_j[i])\n131\t        })\n132\t        .collect();\n133\t\n134\t    // We assume `\\hat{w}` in a WHIR round is always multilinear and maintain its\n135\t    // evaluations on `H_m`.\n136\t    let mut w_evals = evals_mobius_eq_hypercube(u);\n137\t\n138\t    let mut whir_sumcheck_polys: Vec<[SC::EF; 2]> = Vec::with_capacity(num_sumcheck_rounds);\n139\t    let mut codeword_commits = vec![];\n140\t    let mut ood_values = vec![];\n141\t    // per commitment, per whir query, per column\n142\t    let mut initial_round_opened_rows: Vec<Vec<Vec<Vec<SC::F>>>> =\n143\t        vec![vec![]; committed_mats.len()];\n144\t    let mut initial_round_merkle_proofs: Vec<Vec<MerkleProof<SC::Digest>>> =\n145\t        vec![vec![]; committed_mats.len()];\n146\t    let mut codeword_opened_values: Vec<Vec<Vec<SC::EF>>> = Vec::with_capacity(num_whir_rounds - 1);\n147\t    let mut codeword_merkle_proofs: Vec<Vec<MerkleProof<SC::Digest>>> =\n148\t        Vec::with_capacity(num_whir_rounds - 1);\n149\t    let mut folding_pow_witnesses = Vec::with_capacity(num_sumcheck_rounds);\n150\t    let mut query_phase_pow_witnesses = Vec::with_capacity(num_whir_rounds);\n151\t    let mut rs_tree = None;\n152\t    let mut log_rs_domain_size = m + log_blowup;\n153\t    let mut final_poly = None;\n154\t    for (whir_round, round_params) in whir_params.rounds.iter().enumerate() {\n155\t        let is_last_round = whir_round == num_whir_rounds - 1;\n156\t        // Run k_whir rounds of sumcheck on `sum_{x in H_m} \\hat{w}(\\hat{f}(x), x)`\n157\t        for round in 0..k_whir {\n158\t            debug_assert_eq!(f_evals.len(), 1 << (m - round));\n159\t\n160\t            // \\hat{f} * eq has degree 2\n161\t            let s_deg = 2;\n162\t            let s_evals = (1..=s_deg)\n163\t                .map(|x| {\n164\t                    let x = SC::F::from_usize(x);\n165\t                    let hypercube_dim = m - round - 1;\n166\t                    (0..(1usize << hypercube_dim))\n167\t                        .map(|y| {\n168\t                            let f_0 = f_evals[y << 1];\n169\t                            let f_1 = f_evals[(y << 1) + 1];\n170\t                            let f_x = f_0 + (f_1 - f_0) * x;\n171\t                            let w_0 = w_evals[y << 1];\n172\t                            let w_1 = w_evals[(y << 1) + 1];\n173\t                            let w_x = w_0 + (w_1 - w_0) * x;\n174\t                            f_x * w_x\n175\t                        })\n176\t                        .fold(SC::EF::ZERO, |acc, x| acc + x)\n177\t                })\n178\t                .collect_vec();\n179\t\n180\t            for &eval in &s_evals {\n181\t                transcript.observe_ext(eval);\n182\t            }\n183\t            whir_sumcheck_polys.push(\n184\t                s_evals\n185\t                    .try_into()\n186\t                    .map_err(|_| WhirProverError::TryIntoFailed)?,\n187\t            );\n188\t\n189\t            folding_pow_witnesses.push(transcript.grind(whir_params.folding_pow_bits));\n190\t            // Folding randomness\n191\t            let alpha = transcript.sample_ext();\n192\t\n193\t            // Fold the evaluations\n194\t            let half = f_evals.len() / 2;\n195\t            for y in 0..half {\n196\t                let eval_0 = f_evals[y << 1];\n197\t                let eval_1 = f_evals[(y << 1) + 1];\n198\t                // Linear interpolation at r_round\n199\t                f_evals[y] = eval_0 + alpha * (eval_1 - eval_0);\n200\t\n201\t                let eval_0 = w_evals[y << 1];\n202\t                let eval_1 = w_evals[(y << 1) + 1];\n203\t                w_evals[y] = eval_0 + alpha * (eval_1 - eval_0);\n204\t            }\n205\t            f_evals.truncate(half);\n206\t            w_evals.truncate(half);\n207\t        }\n208\t        // Define g^ = f^(alpha, \\cdot) and send matrix commit of RS(g^)\n209\t        // f_evals is the evaluations of f^(alpha, \\cdot) on hypercube\n210\t        let g_mle = Mle::from_evaluations(&f_evals);\n211\t        let (g_tree, z_0) = if !is_last_round {\n212\t            let dft = Radix2DitParallel::default();\n213\t            let mut g_coeffs = g_mle.coeffs().to_vec();\n214\t            debug_assert_eq!(g_coeffs.len(), 1 << (m - k_whir));\n215\t            g_coeffs.resize(1 << (log_rs_domain_size - 1), SC::EF::ZERO);\n216\t            // `g: \\mathcal{L}^{(2)} \\to \\mathbb F`\n217\t            let g_rs = dft.dft(g_coeffs);\n218\t            let g_tree = MerkleTree::new(hasher, ColMajorMatrix::new(g_rs, 1), 1 << k_whir)?;\n219\t            let g_commit = g_tree.root()?;\n220\t            transcript.observe_commit(g_commit);\n221\t            codeword_commits.push(g_commit);\n222\t\n223\t            let z_0 = transcript.sample_ext();\n224\t            let z_0_vec = z_0.exp_powers_of_2().take(m - k_whir).collect_vec();\n225\t            let g_opened_value = g_mle.eval_at_point(&z_0_vec);\n226\t            transcript.observe_ext(g_opened_value);\n227\t            ood_values.push(g_opened_value);\n228\t\n229\t            (Some(g_tree), Some(z_0))\n230\t        } else {\n231\t            let coeffs = g_mle.into_coeffs();\n232\t            for coeff in &coeffs {\n233\t                transcript.observe_ext(*coeff);\n234\t            }\n235\t            final_poly = Some(coeffs);\n236\t            (None, None)\n237\t        };\n238\t\n239\t        // omega is generator of RS domain `\\mathcal{L}^{(2^k)}`\n240\t        let omega = SC::F::two_adic_generator(log_rs_domain_size - k_whir);\n241\t        let num_queries = round_params.num_queries;\n242\t        let mut query_indices = Vec::with_capacity(num_queries);\n243\t        query_phase_pow_witnesses.push(transcript.grind(whir_params.query_phase_pow_bits));\n244\t        // Sample query indices first\n245\t        for _ in 0..num_queries {\n246\t            // This is the index of the leaf in the Merkle tree\n247\t            let index = transcript.sample_bits(log_rs_domain_size - k_whir);\n248\t            query_indices.push(index as usize);\n249\t        }\n250\t        let mut zs = Vec::with_capacity(num_queries);\n251\t        if !is_last_round {\n252\t            codeword_opened_values.push(vec![]);\n253\t            codeword_merkle_proofs.push(vec![]);\n254\t        }\n255\t        for (query_idx, index) in query_indices.into_iter().enumerate() {\n256\t            let z_i = omega.exp_u64(index as u64);\n257\t            // Get merkle proofs for in-domain samples necessary to evaluate Fold(f, \\vec\n258\t            // \\alpha)(z_i)\n259\t            zs.push(z_i);\n260\t\n261\t            let depth = log_rs_domain_size.saturating_sub(k_whir);\n262\t            // Row openings are different between first WHIR round (width > 1) and other rounds\n263\t            // (width = 1):\n264\t            // NOTE: merkle proof is deterministic from the index and merkle root, so the opened_row\n265\t            // and merkle proof are both hinted and not observed by the transcript.\n266\t            if whir_round == 0 {\n267\t                #[allow(clippy::needless_range_loop)]\n268\t                for com_idx in 0..committed_mats.len() {\n269\t                    debug_assert_eq!(initial_round_merkle_proofs[com_idx].len(), query_idx);\n270\t                    let tree = &committed_mats[com_idx].1;\n271\t                    let tree_height = tree.backing_matrix.height();\n272\t                    let expected = 1 << log_rs_domain_size;\n273\t                    if tree_height != expected {\n274\t                        return Err(WhirProverError::TreeHeightMismatch {\n275\t                            tree_height,\n276\t                            expected,\n277\t                        });\n278\t                    }\n279\t                    let opened_rows = tree.get_opened_rows(index)?;\n280\t                    initial_round_opened_rows[com_idx].push(opened_rows);\n281\t                    debug_assert_eq!(tree.proof_depth(), depth);\n282\t                    let proof = tree.query_merkle_proof(index)?;\n283\t                    debug_assert_eq!(proof.len(), depth);\n284\t                    initial_round_merkle_proofs[com_idx].push(proof);\n285\t                }\n286\t            } else {\n287\t                let tree: &MerkleTree<SC::EF, SC::Digest> =\n288\t                    rs_tree.as_ref().ok_or(WhirProverError::RsTreeNone)?;\n289\t                let width = tree.backing_matrix.width();\n290\t                if width != 1 {\n291\t                    return Err(WhirProverError::TreeWidthNotOne { width });\n292\t                }\n293\t                let opened_rows = tree\n294\t                    .get_opened_rows(index)?\n295\t                    .into_iter()\n296\t                    .flatten()\n297\t                    .collect_vec();\n298\t                codeword_opened_values[whir_round - 1].push(opened_rows);\n299\t                debug_assert_eq!(tree.proof_depth(), depth);\n300\t                let proof = tree.query_merkle_proof(index)?;\n301\t                debug_assert_eq!(proof.len(), depth);\n302\t                codeword_merkle_proofs[whir_round - 1].push(proof);\n303\t            }\n304\t        }\n305\t        rs_tree = g_tree;\n306\t\n307\t        // We still sample on the last round to match the verifier, who uses a\n308\t        // final gamma to unify some logic. But we do not need to update\n309\t        // `w_evals`.\n310\t        let gamma = transcript.sample_ext();\n311\t\n312\t        if !is_last_round {\n313\t            // Update \\hat{w}\n314\t            w_evals_accumulate::<SC::EF, SC::EF>(\n315\t                &mut w_evals,\n316\t                z_0.ok_or(WhirProverError::Z0None)?,\n317\t                gamma,\n318\t            );\n319\t            for (z_i, gamma_pow) in zs.into_iter().zip(gamma.powers().skip(2)) {\n320\t                w_evals_accumulate::<SC::F, SC::EF>(&mut w_evals, z_i, gamma_pow);\n321\t            }\n322\t        }\n323\t\n324\t        m -= k_whir;\n325\t        log_rs_domain_size -= 1;\n326\t    }\n327\t\n328\t    Ok(WhirProof::<SC> {\n329\t        mu_pow_witness,\n330\t        whir_sumcheck_polys,\n331\t        codeword_commits,\n332\t        ood_values,\n333\t        folding_pow_witnesses,\n334\t        query_phase_pow_witnesses,\n335\t        initial_round_opened_rows,\n336\t        initial_round_merkle_proofs,\n337\t        codeword_opened_values,\n338\t        codeword_merkle_proofs,\n339\t        final_poly: final_poly.ok_or(WhirProverError::FinalPolyNone)?,\n340\t    })\n341\t}\n342\t\n343\t/// Given hypercube evaluations `w_evals` of `\\hat{w}` on `H_t`, this updates the evaluations\n344\t/// in place to be the evaluations of `\\hat{w}'(x) = \\hat{w}(x) + γ * eq(x, pow(z))`.\n345\tfn w_evals_accumulate<F: Field, EF: ExtensionField<F>>(w_evals: &mut [EF], z: F, gamma: EF) {\n346\t    let dim = log2_strict_usize(w_evals.len());\n347\t    let z_pows = z.exp_powers_of_2().take(dim).collect_vec();\n348\t    let evals = evals_eq_hypercube(&z_pows);\n349\t    for (w, x) in w_evals.iter_mut().zip(evals.into_iter()) {\n350\t        *w += gamma * x;\n351\t    }\n352\t}\n353\t"}]},"parent_tool_use_id":"toolu_015Z1cN3tKpZN3PXeGDyNzJ5","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"cca8162c-82de-4d4b-a877-872156ab4cfc","timestamp":"2026-04-15T08:50:43.959Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VUofZ9Di6WZ6BvqpzwgUZc","type":"tool_result","content":"244\tfn process_air_round0<HS: GpuHashScheme>(\n245\t    w: &Round0AirWorkItem<HS>,\n246\t    bufs: &mut round0::Round0ThreadBuffers,\n247\t    d_batch_ptr: *mut EF,\n248\t    extract_tables: &FxHashMap<usize, Round0ExtractTables>,\n249\t) -> Result<(), LogupZerocheckError> {\n250\t    let single_pk = w.single_pk;\n251\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n252\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n253\t    assert!(\n254\t        local_constraint_deg <= w.constraint_degree,\n255\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n256\t        w.constraint_degree\n257\t    );\n258\t\n259\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n260\t    let omega_root = F::two_adic_generator(log_large_domain);\n261\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n262\t\n263\t    let height = w.common_main.height();\n264\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n265\t    for committed in w.cached_mains {\n266\t        main_parts.push(committed.trace.buffer().as_ptr());\n267\t    }\n268\t    main_parts.push(w.common_main.buffer().as_ptr());\n269\t    let d_main_parts = main_parts.to_device()?;\n270\t\n271\t    let n_lift = w.n.max(0) as usize;\n272\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n273\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n274\t\n275\t    // Check if pre-allocated zerocheck buffers are large enough for this AIR\n276\t    let zc_prealloc_inter = if w.zc_intermed_cap > 0\n277\t        && bufs.zc_intermediates.len() >= w.zc_intermed_cap\n278\t    {\n279\t        Some(&mut bufs.zc_intermediates)\n280\t    } else {\n281\t        None\n282\t    };\n283\t    let zc_prealloc_temp = if w.zc_temp_sums_cap > 0\n284\t        && bufs.zc_temp_sums.len() >= w.zc_temp_sums_cap\n285\t    {\n286\t        Some(&mut bufs.zc_temp_sums)\n287\t    } else {\n288\t        None\n289\t    };\n290\t\n291\t    let sum_buffer = evaluate_round0_constraints_gpu(\n292\t        single_pk,\n293\t        w.selectors_cube.buffer(),\n294\t        &d_main_parts,\n295\t        w.public_values,\n296\t        eq_xi_tree.get_ptr(n_lift),\n297\t        w.d_lambda_pows,\n298\t        1 << w.l_skip,\n299\t        1 << n_lift,\n300\t        height as u32,\n301\t        num_cosets_zc as u32,\n302\t        omega_root,\n303\t        w.max_temp_bytes,\n304\t        zc_prealloc_inter,\n305\t        zc_prealloc_temp,\n306\t    )?;\n307\t\n308\t    // GPU-side polynomial extraction: launch a small kernel to compute\n309\t    // iDFT + Lagrange interpolation + coefficient adjustment on-device,\n310\t    // writing directly into the batch array. No D2H sync needed.\n311\t    if !sum_buffer.is_empty() {\n312\t        let tables = &extract_tables[&local_constraint_deg];\n313\t        let err = unsafe {\n314\t            _round0_extract_zerocheck_poly(\n315\t                d_batch_ptr.add(w.zc_batch_offset),\n316\t                sum_buffer.as_ptr(),\n317\t                tables.zc_transform.as_ptr(),\n318\t                tables.zc_input_size,\n319\t                tables.zc_output_size,\n320\t            )\n321\t        };\n322\t        if err != 0 {\n323\t            return Err(Round0EvalError::Cuda(CudaError::new(err)).into());\n324\t        }\n325\t    }\n326\t    // sum_buffer dropped here; cudaFreeAsync is ordered after the kernel on the same stream\n327\t\n328\t    let num_cosets_logup = local_constraint_deg;\n329\t\n330\t    // Check if pre-allocated logup buffers are large enough for this AIR\n331\t    let logup_prealloc_inter = if w.logup_intermed_cap > 0\n332\t        && bufs.logup_intermediates.len() >= w.logup_intermed_cap\n333\t    {\n334\t        Some(&mut bufs.logup_intermediates)\n335\t    } else {\n336\t        None\n337\t    };\n338\t    let logup_prealloc_temp = if w.logup_temp_sums_cap > 0\n339\t        && bufs.logup_temp_sums.len() >= w.logup_temp_sums_cap\n340\t    {\n341\t        Some(&mut bufs.logup_temp_sums)\n342\t    } else {\n343\t        None\n344\t    };\n345\t\n346\t    let sum = evaluate_round0_interactions_gpu(\n347\t        single_pk,\n348\t        &single_air_constraints,\n349\t        w.selectors_cube.buffer(),\n350\t        &d_main_parts,\n351\t        w.public_values,\n352\t        eq_xi_tree.get_ptr(n_lift),\n353\t        w.beta_pows,\n354\t        w.eq_3bs,\n355\t        1 << w.l_skip,\n356\t        1 << n_lift,\n357\t        height as u32,\n358\t        num_cosets_logup as u32,\n359\t        omega_root,\n360\t        w.max_temp_bytes,\n361\t        logup_prealloc_inter,\n362\t        logup_prealloc_temp,\n363\t    )?;\n364\t\n365\t    if !sum.is_empty() {\n366\t        let tables = &extract_tables[&local_constraint_deg];\n367\t        let norm_factor: EF = if w.n.is_negative() {\n368\t            EF::from(F::from_u32(1 << w.n.unsigned_abs()).inverse())\n369\t        } else {\n370\t            EF::ONE\n371\t        };\n372\t        let err = unsafe {\n373\t            _round0_extract_logup_polys(\n374\t                d_batch_ptr.add(w.numer_batch_offset),\n375\t                d_batch_ptr.add(w.denom_batch_offset),\n376\t                sum.as_ptr(),\n377\t                tables.logup_transform.as_ptr(),\n378\t                tables.logup_size,\n379\t                tables.logup_size,\n380\t                norm_factor,\n381\t            )\n382\t        };\n383\t        if err != 0 {\n384\t            return Err(Round0EvalError::Cuda(CudaError::new(err)).into());\n385\t        }\n386\t    }\n387\t\n388\t    Ok(())\n389\t}\n390\t\n391\t#[allow(clippy::type_complexity)]\n392\t#[instrument(level = \"info\", skip_all)]\n393\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n394\t    transcript: &mut TS,\n395\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n396\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n397\t    save_memory: bool,\n398\t    monomial_num_y_threshold: u32,\n399\t    sm_count: u32,\n400\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n401\twhere\n402\t    HS: GpuHashScheme,\n403\t    TS: GpuFiatShamirTranscript<HS::SC>,\n404\t{\n405\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n406\t    let l_skip = mpk.params.l_skip;\n407\t    let constraint_degree = mpk.max_constraint_degree;\n408\t    let num_traces = ctx.per_trace.len();\n409\t\n410\t    // Traces are sorted\n411\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n412\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n413\t    // heights\n414\t    let mut total_interactions = 0u64;\n415\t    let interactions_meta: Vec<_> = ctx\n416\t        .per_trace\n417\t        .iter()\n418\t        .map(|(air_idx, air_ctx)| {\n419\t            let pk = &mpk.per_air[*air_idx];\n420\t\n421\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n422\t            let height = air_ctx.common_main.height();\n423\t            let log_height = log2_strict_usize(height);\n424\t            let log_lifted_height = log_height.max(l_skip);\n425\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n426\t            (num_interactions, log_lifted_height)\n427\t        })\n428\t        .collect();\n429\t    // Implicitly, the width of this stacking should be 1\n430\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n431\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n432\t    // GKR\n433\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n434\t\n435\t    // Grind to increase soundness of random sampling for LogUp\n436\t    let logup_pow_witness = transcript\n437\t        .grind_gpu(mpk.params.logup.pow_bits)\n438\t        .map_err(LogupZerocheckError::Grind)?;\n439\t    let alpha_logup = transcript.sample_ext();\n440\t    let beta_logup = transcript.sample_ext();\n441\t    debug!(%alpha_logup, %beta_logup);\n442\t\n443\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n444\t    let mut prover = LogupZerocheckGpu::new(\n445\t        mpk,\n446\t        ctx,\n447\t        n_logup,\n448\t        interactions_layout,\n449\t        alpha_logup,\n450\t        beta_logup,\n451\t        save_memory,\n452\t        monomial_num_y_threshold,\n453\t        sm_count,\n454\t    )?;\n455\t    let n_global = prover.n_global;\n456\t\n457\t    let total_leaves = 1 << (l_skip + n_logup);\n458\t    prover\n459\t        .mem\n460\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n461\t    prover.mem.reset_peak();\n462\t    let (inputs, alpha) = if has_interactions {\n463\t        log_gkr_input_evals(\n464\t            &prover.trace_interactions,\n465\t            mpk,\n466\t            ctx,\n467\t            l_skip,\n468\t            alpha_logup,\n469\t            &prover.d_challenges,\n470\t            total_leaves,\n471\t        )?\n472\t    } else {\n473\t        (DeviceBuffer::new(), EF::ZERO)\n474\t    };\n475\t    // Set memory limit for batch MLE based on inputs buffer size\n476\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n477\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n478\t    if !prover.save_memory {\n479\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n480\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n481\t            tracing::warn!(\n482\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n483\t                prover.memory_limit_bytes\n484\t            );\n485\t        }\n486\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n487\t    }\n488\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n489\t\n490\t    let (frac_sum_proof, mut xi) =\n491\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n492\t    while xi.len() != l_skip + n_global {\n493\t        xi.push(transcript.sample_ext());\n494\t    }\n495\t    debug!(?xi);\n496\t    prover.xi = xi;\n497\t\n498\t    logup_gkr_span.exit();\n499\t\n500\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does\n501\t    // not include the kernel times for the actual folding\n502\t    let round0_span = info_span!(\"prover.rap_constraints.round0\", phase = \"prover\").entered();\n503\t    // begin batch sumcheck\n504\t    let mut sumcheck_round_polys = Vec::with_capacity(n_max);\n505\t    let mut r = Vec::with_capacity(n_max + 1);\n506\t    // batching randomness\n507\t    let lambda = transcript.sample_ext();\n508\t    debug!(%lambda);\n509\t\n510\t    let sp_0_polys = prover.sumcheck_uni_round0_polys(ctx, lambda)?;\n511\t    let s_0_cpu_span = info_span!(\"s'_0 -> s_0 cpu interpolations\").entered();\n512\t    let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_degree);\n513\t    let s_deg = constraint_degree + 1;\n514\t    let s_0_deg = sumcheck_round0_deg(l_skip, s_deg);\n515\t    let large_uni_domain = (s_0_deg + 1).next_power_of_two();\n516\t    let dft = Radix2BowersSerial;\n517\t    let s_0_logup_polys = {\n518\t        let eq_sharp_uni = eq_sharp_uni_poly(&prover.xi[..l_skip]);\n519\t        let mut eq_coeffs = eq_sharp_uni.into_coeffs();\n520\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n521\t        let eq_evals = dft.dft(eq_coeffs);\n522\t\n523\t        let width = 2 * num_traces;\n524\t        let mut sp_coeffs_mat = EF::zero_vec(width * large_uni_domain);\n525\t        for (i, coeffs) in sp_0_polys[..2 * num_traces].iter().enumerate() {\n526\t            for (j, &c_j) in coeffs.coeffs().iter().enumerate().take(sp_0_deg + 1) {\n527\t                // SAFETY:\n528\t                // - coeffs length is <= sp_0_deg + 1 <= s_0_deg < large_uni_domain\n529\t                // - sp_coeffs_mat allocated for width\n530\t                unsafe {\n531\t                    *sp_coeffs_mat.get_unchecked_mut(j * width + i) = c_j;\n532\t                }\n533\t            }\n534\t        }\n535\t        let mut s_evals = dft.dft_batch(RowMajorMatrix::new(sp_coeffs_mat, width));\n536\t        for (eq, row) in zip(eq_evals, s_evals.values.chunks_mut(width)) {\n537\t            for x in row {\n538\t                *x *= eq;\n539\t            }\n540\t        }\n541\t        dft.idft_batch(s_evals)\n542\t    };\n543\t    let skip_domain_size = F::from_usize(1 << l_skip);\n544\t    // logup sum claims (sum_{\\hat p}, sum_{\\hat q}) per present AIR\n545\t    let (numerator_term_per_air, denominator_term_per_air): (Vec<_>, Vec<_>) = (0..num_traces)\n546\t        .map(|trace_idx| {\n547\t            let [sum_claim_p, sum_claim_q] = [0, 1].map(|is_denom| {\n548\t                // Compute sum over D of s_0(Z) to get the sum claim\n549\t                (0..=s_0_deg)\n550\t                    .step_by(1 << l_skip)\n551\t                    .map(|j| unsafe {\n552\t                        // SAFETY: matrix is 2 * num_trace x large_uni_domain, s_0_deg <\n553\t                        // large_uni_domain\n554\t                        *s_0_logup_polys\n555\t                            .values\n556\t                            .get_unchecked(j * 2 * num_traces + 2 * trace_idx + is_denom)\n557\t                    })\n558\t                    .sum::<EF>()\n559\t                    * skip_domain_size\n560\t            });\n561\t            transcript.observe_ext(sum_claim_p);\n562\t            transcript.observe_ext(sum_claim_q);\n563\t\n564\t            (sum_claim_p, sum_claim_q)\n565\t        })\n566\t        .unzip();\n567\t\n568\t    let mu = transcript.sample_ext();\n569\t    debug!(%mu);\n570\t    let mu_pows = mu.powers().take(3 * num_traces).collect_vec();\n571\t\n572\t    let s_0_zc_poly = {\n573\t        let eq_uni = eq_uni_poly::<F, _>(l_skip, prover.xi[0]);\n574\t        let mut eq_coeffs = eq_uni.into_coeffs();\n575\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n576\t        let eq_evals = dft.dft(eq_coeffs);\n577\t\n578\t        // Algebraically batch\n579\t        let mut sp_coeffs = EF::zero_vec(large_uni_domain);\n580\t        let mus = &mu_pows[2 * num_traces..];\n581\t        let polys = &sp_0_polys[2 * num_traces..];\n582\t        for (j, batch_coeff) in sp_coeffs.iter_mut().enumerate().take(sp_0_deg + 1) {\n583\t            for (&mu, poly) in zip(mus, polys) {\n584\t                *batch_coeff += mu * *poly.coeffs().get(j).unwrap_or(&EF::ZERO);\n585\t            }\n586\t        }\n587\t        let mut s_evals = dft.dft(sp_coeffs);\n588\t        for (eq, x) in zip(eq_evals, &mut s_evals) {\n589\t            *x *= eq;\n590\t        }\n591\t        dft.idft(s_evals)\n592\t    };\n593\t\n594\t    // Algebraically batch\n595\t    let s_0_poly = UnivariatePoly::new(\n596\t        zip(\n597\t            s_0_logup_polys.values.chunks_exact(2 * num_traces),\n598\t            s_0_zc_poly,\n599\t        )\n600\t        .take(s_0_deg + 1)\n601\t        .map(|(logup_row, batched_zc)| {\n602\t            let coeff = batched_zc\n603\t                + zip(&mu_pows, logup_row)\n604\t                    .map(|(&mu_j, &x)| mu_j * x)\n605\t                    .sum::<EF>();\n606\t            transcript.observe_ext(coeff);\n607\t            coeff\n608\t        })\n609\t        .collect(),\n610\t    );\n611\t    drop(s_0_cpu_span);\n612\t\n613\t    let r_0 = transcript.sample_ext();\n614\t    r.push(r_0);\n615\t    debug!(round = 0, r_round = %r_0);\n616\t    prover.prev_s_eval = s_0_poly.eval_at_point(r_0);\n617\t    debug!(\"s_0(r_0) = {}\", prover.prev_s_eval);\n618\t\n619\t    prover.fold_ple_evals(ctx, r_0)?;\n620\t    drop(round0_span);\n621\t\n622\t    // Allocate ping-pong buffers for MLE fold. These eliminate per-round per-matrix\n623\t    // cudaMallocAsync/cudaFreeAsync in fold_mle_evals. The first fold round reads from\n624\t    // original DeviceMatrix objects (no initial D2D pack needed); subsequent rounds read\n625\t    // from the ping-pong buffers.\n626\t    {\n627\t        let mat_total_cells: usize = prover\n628\t            .mat_evals_per_trace\n629\t            .iter()\n630\t            .flatten()\n631\t            .map(|m| m.height() * m.width())\n632\t            .sum();\n633\t        if mat_total_cells > 0 {\n634\t            prover.fold_mat_buf_a = Some(DeviceBuffer::<EF>::with_capacity(mat_total_cells));\n635\t            prover.fold_mat_buf_b = Some(DeviceBuffer::<EF>::with_capacity(mat_total_cells));\n636\t        }\n637\t\n638\t        let sel_total_cells: usize = prover\n639\t            .sels_per_trace\n640\t            .iter()\n641\t            .map(|m| m.height() * m.width())\n642\t            .sum();\n643\t        if sel_total_cells > 0 {\n644\t            prover.fold_sel_buf_a = Some(DeviceBuffer::<EF>::with_capacity(sel_total_cells));\n645\t            prover.fold_sel_buf_b = Some(DeviceBuffer::<EF>::with_capacity(sel_total_cells));\n646\t        }\n647\t    }\n648\t\n649\t    // Sumcheck rounds:\n650\t    // - each round the prover needs to compute univariate polynomial `s_round`. This poly is linear\n651\t    //   since we are taking MLE of `evals`.\n652\t    // - at end of each round, sample random `r_round` in `EF`\n653\t    //\n654\t    // `s_round` is degree `s_deg` so we evaluate it at `0, ..., =s_deg`. The prover skips\n655\t    // evaluation at `0` because the verifier can infer it from the previous round's\n656\t    // `s_{round-1}(r)` claim. The degree is constraint_degree + 1, where + 1 is from eq term\n657\t    let mle_rounds_span =\n658\t        info_span!(\"prover.rap_constraints.mle_rounds\", phase = \"prover\").entered();\n659\t    debug!(%s_deg);\n660\t    for round in 1..=n_max {\n661\t        let sp_round_evals = prover.sumcheck_polys_batch_eval(round, r[round - 1])?;\n662\t        let batch_s = prover.compute_batch_s_poly(sp_round_evals, num_traces, round, &mu_pows);\n663\t        let batch_s_evals = (1..=s_deg)\n664\t            .map(|i| batch_s.eval_at_point(EF::from_usize(i)))\n665\t            .collect_vec();\n666\t        for &eval in &batch_s_evals {\n667\t            transcript.observe_ext(eval);\n668\t        }\n669\t        sumcheck_round_polys.push(batch_s_evals);\n670\t\n671\t        let r_round = transcript.sample_ext();\n672\t        debug!(%round, %r_round);\n673\t        r.push(r_round);\n674\t        prover.prev_s_eval = batch_s.eval_at_point(r_round);\n675\t\n676\t        prover.fold_mle_evals(round, r_round)?;\n677\t    }\n678\t    assert_eq!(r.len(), n_max + 1);\n679\t\n680\t    let column_openings = prover.into_column_openings()?;\n681\t\n682\t    let need_rot_per_trace = ctx\n683\t        .per_trace\n684\t        .iter()\n685\t        .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n686\t        .collect::<Vec<_>>();\n687\t    // Observe common main openings first, and then preprocessed/cached\n688\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n689\t        for (claim, claim_rot) in column_openings_by_rot(&openings[0], *need_rot) {\n690\t            transcript.observe_ext(claim);\n691\t            transcript.observe_ext(claim_rot);\n692\t        }\n693\t    }\n694\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n695\t        for part in openings.iter().skip(1) {\n696\t            for (claim, claim_rot) in column_openings_by_rot(part, *need_rot) {\n697\t                transcript.observe_ext(claim);\n698\t                transcript.observe_ext(claim_rot);\n699\t            }\n700\t        }\n701\t    }\n702\t    drop(mle_rounds_span);\n703\t\n704\t    let batch_constraint_proof = BatchConstraintProof {\n705\t        numerator_term_per_air,\n706\t        denominator_term_per_air,\n707\t        univariate_round_coeffs: s_0_poly.into_coeffs(),\n708\t        sumcheck_round_polys,\n709\t        column_openings,\n710\t    };\n711\t    let gkr_proof = GkrProof {\n712\t        logup_pow_witness,\n713\t        q0_claim: frac_sum_proof.fractional_sum.1,\n714\t        claims_per_layer: frac_sum_proof.claims_per_layer,\n715\t        sumcheck_polys: frac_sum_proof.sumcheck_polys,\n716\t    };\n717\t    Ok((gkr_proof, batch_constraint_proof, r))\n718\t}\n719\t\n720\tpub struct LogupZerocheckGpu<'a, HS: GpuHashScheme> {\n721\t    pub alpha_logup: EF,\n722\t    pub beta_pows: Vec<EF>,\n723\t    // [alpha, beta^0, beta^1, .., beta^max_interaction_len]\n724\t    pub d_challenges: DeviceBuffer<EF>,\n725\t\n726\t    pub l_skip: usize,\n727\t    n_logup: usize,\n728\t    n_global: usize,\n729\t\n730\t    pub omega_skip: F,\n731\t    pub omega_skip_pows: Vec<F>,\n732\t    d_omega_skip_pows: DeviceBuffer<F>,\n733\t\n734\t    pub interactions_layout: StackedLayout,\n735\t    pub constraint_degree: usize,\n736\t    n_per_trace: Vec<isize>,\n737\t    max_num_constraints: usize,\n738\t    pub monomial_num_y_threshold: u32,\n739\t    sm_count: u32,\n740\t    // Available after GKR:\n741\t    pub xi: Vec<EF>,\n742\t    pub lambda_pows: Option<DeviceBuffer<EF>>,\n743\t    /// Precomputed lambda combinations per AIR (indexed by air_idx). Set when lambda is sampled."}]},"parent_tool_use_id":"toolu_01KrJkGSXQSuRiHanrn4W4wH","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"5e0fba9f-f0e0-41aa-b27f-402bf363895e","timestamp":"2026-04-15T08:50:44.249Z"}
