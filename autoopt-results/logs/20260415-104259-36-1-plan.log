{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DqorF4zYWztu6hU1igjZVF","type":"tool_result","content":"50\t#define DISPATCH_BOOL_PAIR(func, b1, b2, ...)                                                      \\\n51\t    ((b1) ? ((b2) ? func<true, true>(__VA_ARGS__) : func<true, false>(__VA_ARGS__))                \\\n52\t          : ((b2) ? func<false, true>(__VA_ARGS__) : func<false, false>(__VA_ARGS__)))\n53\t\n54\t// Generic dispatcher for <uint32_t N, bool B1, bool B2> template functions.\n55\t// Generates recursive template to dispatch runtime n (1..MAX_N) to compile-time N.\n56\t// Usage: DEFINE_DISPATCH_N_B1_B2(dispatcher_name, target_func, MAX_N)\n57\t// Then call: dispatcher_name(n, b1, b2, args...)\n58\t#define DEFINE_DISPATCH_N_B1_B2(name, func, max_n)                                                 \\\n59\t    template <uint32_t N, typename... Args>                                                        \\\n60\t    inline int name##_impl(uint32_t n, bool b1, bool b2, Args &&...args) {                         \\\n61\t        if (n == N) {                                                                              \\\n62\t            if (b1) {                                                                              \\\n63\t                return b2 ? func<N, true, true>(std::forward<Args>(args)...)                       \\\n64\t                          : func<N, true, false>(std::forward<Args>(args)...);                     \\\n65\t            } else {                                                                               \\\n66\t                return b2 ? func<N, false, true>(std::forward<Args>(args)...)                      \\\n67\t                          : func<N, false, false>(std::forward<Args>(args)...);                    \\\n68\t            }                                                                                      \\\n69\t        } else if constexpr (N == 1) {                                                             \\\n70\t            return -1;                                                                             \\\n71\t        } else {                                                                                   \\\n72\t            return name##_impl<N - 1>(n, b1, b2, std::forward<Args>(args)...);                     \\\n73\t        }                                                                                          \\\n74\t    }                                                                                              \\\n75\t    template <typename... Args> inline int name(uint32_t n, bool b1, bool b2, Args &&...args) {    \\\n76\t        return name##_impl<max_n>(n, b1, b2, std::forward<Args>(args)...);                         \\\n77\t    }\n78\t"}]},"parent_tool_use_id":"toolu_01WqBVpv4iTXwmt11WWUnn54","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"11a4b6ff-02f7-4522-8b15-5053024604ae","timestamp":"2026-04-15T09:22:17.028Z"}
