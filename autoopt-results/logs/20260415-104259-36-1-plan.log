{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0174iFJvixBymKmFemYmMbSM","type":"tool_result","content":"1\t//! Prove keccakf-air over BabyBear using poseidon2 for FRI hash.\n2\t//! Multi-threaded: runs multiple proofs across OS threads / CUDA streams.\n3\t\n4\tuse std::sync::Arc;\n5\t\n6\tuse openvm_cuda_backend::{prelude::SC, BabyBearPoseidon2GpuEngine, GpuBackend};\n7\tuse openvm_cuda_common::stream::current_stream_id;\n8\tuse openvm_stark_backend::{\n9\t    p3_air::{Air, AirBuilder, BaseAir},\n10\t    p3_field::Field,\n11\t    prover::{AirProvingContext, ColMajorMatrix, DeviceDataTransporter, ProvingContext},\n12\t    BaseAirWithPublicValues, ColumnsAir, PartitionedBaseAir, StarkEngine, SystemParams,\n13\t};\n14\tuse openvm_stark_sdk::{\n15\t    config::{\n16\t        app_params_with_100_bits_security,\n17\t        baby_bear_poseidon2::{BabyBearPoseidon2RefEngine, DuplexSponge},\n18\t    },\n19\t    utils::setup_tracing,\n20\t};\n21\tuse p3_baby_bear::BabyBear;\n22\tuse p3_keccak_air::KeccakAir;\n23\tuse rand::{rngs::StdRng, Rng, SeedableRng};\n24\tuse tracing::info_span;\n25\t\n26\tconst NUM_PERMUTATIONS: usize = 1 << 10;\n27\t\n28\t// Newtype to implement extended traits\n29\tstruct TestAir(KeccakAir);\n30\t\n31\timpl<F> BaseAir<F> for TestAir {\n32\t    fn width(&self) -> usize {\n33\t        BaseAir::<F>::width(&self.0)\n34\t    }\n35\t}\n36\timpl<F: Field> BaseAirWithPublicValues<F> for TestAir {}\n37\timpl<F: Field> ColumnsAir<F> for TestAir {}\n38\timpl<F: Field> PartitionedBaseAir<F> for TestAir {}\n39\t\n40\timpl<AB: AirBuilder> Air<AB> for TestAir {\n41\t    fn eval(&self, builder: &mut AB) {\n42\t        self.0.eval(builder);\n43\t    }\n44\t}\n45\t\n46\tfn make_params() -> SystemParams {\n47\t    app_params_with_100_bits_security(21)\n48\t}\n49\t\n50\tfn main() {\n51\t    setup_tracing();\n52\t    std::panic::set_hook(Box::new(|info| {\n53\t        eprintln!(\"Thread panicked: {}\", info);\n54\t        std::process::abort();\n55\t    }));\n56\t\n57\t    // NUM_THREADS: number of OS threads = CUDA streams to use\n58\t    let num_threads: usize = std::env::var(\"NUM_THREADS\")\n59\t        .ok()\n60\t        .and_then(|s| s.parse().ok())\n61\t        .unwrap_or(2);\n62\t\n63\t    // NUM_TASKS: number of proofs to run\n64\t    let num_tasks: usize = std::env::var(\"NUM_TASKS\")\n65\t        .ok()\n66\t        .and_then(|s| s.parse().ok())\n67\t        .unwrap_or(num_threads * 4);\n68\t\n69\t    // ----- CPU keygen once, shared by all threads -----\n70\t    let air = TestAir(KeccakAir {});\n71\t    let engine = BabyBearPoseidon2RefEngine::<DuplexSponge>::new(make_params());\n72\t    let (pk, vk) = engine.keygen(&[Arc::new(air)]);\n73\t    let pk = Arc::new(pk);\n74\t    let vk = Arc::new(vk);\n75\t    let air_idx = 0;\n76\t\n77\t    // Base seed to derive per-task RNGs deterministically but independently.\n78\t    let mut master_rng = StdRng::seed_from_u64(42);\n79\t    let base_seed: u64 = master_rng.random();\n80\t\n81\t    let tasks_per_thread = num_tasks.div_ceil(num_threads);\n82\t    let mut handles = Vec::new();\n83\t\n84\t    for worker_idx in 0..num_threads {\n85\t        let pk = pk.clone();\n86\t        let vk = vk.clone();\n87\t        let start_task = worker_idx * tasks_per_thread;\n88\t        let end_task = std::cmp::min(start_task + tasks_per_thread, num_tasks);\n89\t\n90\t        handles.push(std::thread::spawn(move || {\n91\t            for t in start_task..end_task {\n92\t                let task_seed = base_seed ^ ((t as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15));\n93\t                let mut rng = StdRng::seed_from_u64(task_seed);\n94\t\n95\t                let inputs = (0..NUM_PERMUTATIONS)\n96\t                    .map(|_| rng.random())\n97\t                    .collect::<Vec<_>>();\n98\t                let trace = info_span!(\"generate_trace\", task=%t)\n99\t                    .in_scope(|| p3_keccak_air::generate_trace_rows::<BabyBear>(inputs, 0));\n100\t"}]},"parent_tool_use_id":"toolu_01MWF8uxhoPgEUCEtBhyfUw3","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"a86d29d6-236d-4254-8f4a-d7cdce8ba7b0","timestamp":"2026-04-15T08:51:41.718Z"}
