{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VpztLTitvmJFVz8MSZRhh3","type":"tool_result","content":"1\tuse std::{cmp::max, fmt::Debug, sync::Arc};\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::{\n5\t    copy::{cuda_memcpy, MemCopyD2H, MemCopyH2D},\n6\t    d_buffer::DeviceBuffer,\n7\t    error::MemCopyError,\n8\t    stream::current_stream_sync,\n9\t};\n10\tuse openvm_stark_backend::{\n11\t    keygen::types::MultiStarkProvingKey,\n12\t    p3_matrix::{dense::RowMajorMatrix, Matrix},\n13\t    prover::{\n14\t        stacked_pcs::{MerkleTree, StackedPcsData},\n15\t        AirProvingContext, ColMajorMatrix, CommittedTraceData, CpuColMajorBackend,\n16\t        DeviceDataTransporter, DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions,\n17\t        MatrixView, ProvingContext,\n18\t    },\n19\t};\n20\tuse tracing::{debug, info_span};\n21\t\n22\tuse crate::{\n23\t    base::DeviceMatrix,\n24\t    cuda::matrix::{collapse_strided_matrix, matrix_transpose_fp},\n25\t    gpu_backend::GenericGpuBackend,\n26\t    hash_scheme::GpuHashScheme,\n27\t    merkle_tree::MerkleTreeGpu,\n28\t    poly::PleMatrix,\n29\t    prelude::{Digest, F, SC},\n30\t    stacked_pcs::StackedPcsDataGpu,\n31\t    AirDataGpu, GpuBackend, GpuDevice, GpuProverConfig, ProverError,\n32\t};\n33\t\n34\timpl<HS: GpuHashScheme> DeviceDataTransporter<HS::SC, GenericGpuBackend<HS>> for GpuDevice {\n35\t    fn transport_pk_to_device(\n36\t        &self,\n37\t        mpk: &MultiStarkProvingKey<HS::SC>,\n38\t    ) -> DeviceMultiStarkProvingKey<GenericGpuBackend<HS>> {\n39\t        let _span = info_span!(\"transport_pk_to_device\").entered();\n40\t        let per_air = mpk\n41\t            .per_air\n42\t            .iter()\n43\t            .map(|pk| {\n44\t                let preprocessed_data = pk.preprocessed_data.as_ref().map(|d| {\n45\t                    transport_and_unstack_single_data_h2d::<HS>(d.as_ref(), &self.prover_config)\n46\t                        .unwrap()\n47\t                });\n48\t                let other_data = AirDataGpu::new(pk).unwrap();\n49\t                let num_monomials = other_data\n50\t                    .zerocheck_monomials\n51\t                    .as_ref()\n52\t                    .map(|m| m.num_monomials)\n53\t                    .unwrap_or(0);\n54\t                debug!(air = %pk.air_name, num_monomials, \"monomial expansion\");\n55\t\n56\t                DeviceStarkProvingKey {\n57\t                    air_name: pk.air_name.clone(),\n58\t                    vk: pk.vk.clone(),\n59\t                    preprocessed_data,\n60\t                    other_data,\n61\t                }\n62\t            })\n63\t            .collect();\n64\t        // Synchronize in case the proving key is shared between threads/streams\n65\t        current_stream_sync().unwrap();\n66\t\n67\t        DeviceMultiStarkProvingKey::new(\n68\t            per_air,\n69\t            mpk.trace_height_constraints.clone(),\n70\t            mpk.max_constraint_degree,\n71\t            mpk.params.clone(),\n72\t            mpk.vk_pre_hash,\n73\t        )\n74\t    }\n75\t\n76\t    fn transport_matrix_to_device(&self, matrix: &ColMajorMatrix<F>) -> DeviceMatrix<F> {\n77\t        transport_matrix_h2d_col_major(matrix).unwrap()\n78\t    }\n79\t\n80\t    fn transport_pcs_data_to_device(\n81\t        &self,\n82\t        pcs_data: &StackedPcsData<F, HS::Digest>,\n83\t    ) -> StackedPcsDataGpu<F, HS::Digest> {\n84\t        transport_pcs_data_h2d::<HS::Digest>(pcs_data, &self.prover_config).unwrap()\n85\t    }\n86\t\n87\t    fn transport_matrix_from_device_to_host(&self, matrix: &DeviceMatrix<F>) -> ColMajorMatrix<F> {\n88\t        transport_matrix_d2h_col_major(matrix).unwrap()\n89\t    }\n90\t}\n91\t\n92\tpub fn transport_matrix_h2d_col_major<T>(\n93\t    matrix: &ColMajorMatrix<T>,\n94\t) -> Result<DeviceMatrix<T>, MemCopyError> {\n95\t    // matrix is already col-major, so this is just H2D buffer transfer\n96\t    let buffer = matrix.values.to_device()?;\n97\t    Ok(DeviceMatrix::new(\n98\t        Arc::new(buffer),\n99\t        matrix.height(),\n100\t        matrix.width(),\n101\t    ))\n102\t}\n103\t\n104\tpub fn transport_matrix_h2d_row(\n105\t    matrix: &RowMajorMatrix<F>,\n106\t) -> Result<DeviceMatrix<F>, MemCopyError> {\n107\t    let data = matrix.values.as_slice();\n108\t    let input_buffer = data.to_device().unwrap();\n109\t    let output = DeviceMatrix::<F>::with_capacity(Matrix::height(matrix), Matrix::width(matrix));\n110\t    unsafe {\n111\t        matrix_transpose_fp(\n112\t            output.buffer(),\n113\t            &input_buffer,\n114\t            Matrix::width(matrix),\n115\t            Matrix::height(matrix),\n116\t        )?;\n117\t    }\n118\t    assert_eq!(output.strong_count(), 1);\n119\t    Ok(output)\n120\t}\n121\t\n122\t/// `d` must be the stacked pcs data of a single trace matrix.\n123\t/// This function will transport `d` to device and then unstack it (allocating device memory) to\n124\t/// return `CommittedTraceData<F, Digest>`.\n125\tpub fn transport_and_unstack_single_data_h2d<HS: GpuHashScheme>(\n126\t    d: &StackedPcsData<F, HS::Digest>,\n127\t    prover_config: &GpuProverConfig,\n128\t) -> Result<CommittedTraceData<GenericGpuBackend<HS>>, ProverError> {\n129\t    let _span = info_span!(\"transport_unstack_h2d\").entered();\n130\t    debug_assert!(d\n131\t        .layout\n132\t        .sorted_cols\n133\t        .iter()\n134\t        .all(|(mat_idx, _, _)| *mat_idx == 0));\n135\t    let l_skip = d.layout.l_skip();\n136\t    let trace_view = d.mat_view(0);\n137\t    let height = trace_view.height();\n138\t    let width = trace_view.width();\n139\t    let stride = trace_view.stride();\n140\t    let lifted_height = height * stride;\n141\t    debug_assert_eq!(lifted_height, max(height, 1 << l_skip));\n142\t    debug_assert_eq!(lifted_height * width, trace_view.values().len());\n143\t    debug_assert!(d.matrix.values.len() >= lifted_height * width);\n144\t    let stacked_width = d.matrix.width();\n145\t    let stacked_height = d.matrix.height();\n146\t    let d_matrix_evals = d.matrix.values.to_device()?;\n147\t    let strided_trace = DeviceBuffer::<F>::with_capacity(lifted_height * width);\n148\t    // SAFETY: D2D copy\n149\t    // - `d_matrix_evals` is the stacked matrix, guaranteed to have length `>= lifted_height *\n150\t    //   width` by definition of stacking"}]},"parent_tool_use_id":"toolu_01KrJkGSXQSuRiHanrn4W4wH","session_id":"cd67acf5-7001-4f85-a6f5-23b121ad763a","uuid":"756127ce-344e-46ee-a7f9-e0e4a495d4b1","timestamp":"2026-04-15T08:51:07.387Z"}
