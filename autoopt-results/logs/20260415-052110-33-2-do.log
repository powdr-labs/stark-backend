{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HdifSq1Jr87wp7kcJ29KFa","type":"tool_result","content":"1\tuse std::{\n2\t    collections::HashMap,\n3\t    ffi::c_void,\n4\t    ptr::NonNull,\n5\t    sync::{Mutex, OnceLock},\n6\t    time::{SystemTime, UNIX_EPOCH},\n7\t};\n8\t\n9\tuse bytesize::ByteSize;\n10\t\n11\tuse crate::{\n12\t    error::{check, MemoryError},\n13\t    stream::{cudaStreamPerThread, cudaStream_t, current_stream_id, device_synchronize},\n14\t};\n15\t\n16\tmod cuda;\n17\tmod vm_pool;\n18\tuse vm_pool::VirtualMemoryPool;\n19\t\n20\t#[cfg(test)]\n21\tmod tests;\n22\t\n23\t#[link(name = \"cudart\")]\n24\textern \"C\" {\n25\t    fn cudaMallocAsync(dev_ptr: *mut *mut c_void, size: usize, stream: cudaStream_t) -> i32;\n26\t    fn cudaFreeAsync(dev_ptr: *mut c_void, stream: cudaStream_t) -> i32;\n27\t    fn cudaMemGetInfo(free: *mut usize, total: *mut usize) -> i32;\n28\t}\n29\t\n30\tstatic MEMORY_MANAGER: OnceLock<Mutex<MemoryManager>> = OnceLock::new();\n31\t\n32\tpub fn device_memory_used() -> usize {\n33\t    let mut free = 0usize;\n34\t    let mut total = 0usize;\n35\t    unsafe { cudaMemGetInfo(&mut free, &mut total) };\n36\t    total - free\n37\t}\n38\t\n39\t#[ctor::ctor]\n40\tfn init() {\n41\t    let _ = MEMORY_MANAGER.set(Mutex::new(MemoryManager::new()));\n42\t    tracing::info!(\"Memory manager initialized at program start\");\n43\t}\n44\t\n45\tpub struct MemoryManager {\n46\t    pool: VirtualMemoryPool,\n47\t    allocated_ptrs: HashMap<NonNull<c_void>, usize>,\n48\t    current_size: usize,\n49\t    max_used_size: usize,\n50\t}\n51\t\n52\t/// # Safety\n53\t/// `MemoryManager` is not internally synchronized. These impls are safe because\n54\t/// the singleton instance is wrapped in `Mutex` via `MEMORY_MANAGER`.\n55\tunsafe impl Send for MemoryManager {}\n56\tunsafe impl Sync for MemoryManager {}\n57\t\n58\timpl MemoryManager {\n59\t    pub fn new() -> Self {\n60\t        // Create virtual memory pool\n61\t        let pool = VirtualMemoryPool::default();\n62\t\n63\t        Self {\n64\t            pool,\n65\t            allocated_ptrs: HashMap::new(),\n66\t            current_size: 0,\n67\t            max_used_size: 0,\n68\t        }\n69\t    }\n70\t\n71\t    fn d_malloc(&mut self, size: usize) -> Result<*mut c_void, MemoryError> {\n72\t        assert!(size != 0, \"Requested size must be non-zero\");\n73\t\n74\t        let mut tracked_size = size;\n75\t        let ptr = if size < self.pool.page_size {\n76\t            let mut ptr: *mut c_void = std::ptr::null_mut();\n77\t            check(unsafe { cudaMallocAsync(&mut ptr, size, cudaStreamPerThread) }).map_err(\n78\t                |e| {\n79\t                    tracing::error!(\"cudaMallocAsync failed: size={}: {:?}\", size, e);\n80\t                    MemoryError::from(e)\n81\t                },\n82\t            )?;\n83\t            self.allocated_ptrs.insert(\n84\t                NonNull::new(ptr).expect(\"BUG: cudaMallocAsync returned null\"),\n85\t                size,\n86\t            );\n87\t            ptr\n88\t        } else {\n89\t            tracked_size = size.next_multiple_of(self.pool.page_size);\n90\t            let stream_id = current_stream_id()?;\n91\t            self.pool.malloc_internal(tracked_size, stream_id)?\n92\t        };\n93\t\n94\t        self.current_size += tracked_size;\n95\t        if self.current_size > self.max_used_size {\n96\t            self.max_used_size = self.current_size;\n97\t        }\n98\t        Ok(ptr)\n99\t    }\n100\t\n101\t    /// # Safety\n102\t    /// The pointer `ptr` must be a valid, previously allocated device pointer.\n103\t    /// The caller must ensure that `ptr` is not used after this function is called.\n104\t    unsafe fn d_free(&mut self, ptr: *mut c_void) -> Result<(), MemoryError> {\n105\t        let nn = NonNull::new(ptr).ok_or(MemoryError::NullPointer)?;\n106\t\n107\t        if let Some(size) = self.allocated_ptrs.remove(&nn) {\n108\t            self.current_size -= s