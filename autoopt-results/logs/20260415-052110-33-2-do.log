start(label: &'static str) -> Self {\n164\t        let current = MEMORY_MANAGER\n165\t            .get()\n166\t            .and_then(|m| m.lock().ok())\n167\t            .map(|m| m.current_size)\n168\t            .unwrap_or_default();\n169\t\n170\t        Self { current, label }\n171\t    }\n172\t\n173\t    pub fn start_and_reset_peak(label: &'static str) -> Self {\n174\t        let mut mem = Self::start(label);\n175\t        mem.reset_peak();\n176\t        mem\n177\t    }\n178\t\n179\t    pub fn emit_metrics(&self) {\n180\t        self.emit_metrics_with_label(self.label);\n181\t    }\n182\t\n183\t    pub fn emit_metrics_with_label(&self, label: &'static str) {\n184\t        let Some(manager) = MEMORY_MANAGER.get().and_then(|m| m.lock().ok()) else {\n185\t            return;\n186\t        };\n187\t\n188\t        let ts = SystemTime::now()\n189\t            .duration_since(UNIX_EPOCH)\n190\t            .unwrap()\n191\t            .as_secs_f64()\n192\t            * 1000.0;\n193\t        let current = manager.current_size;\n194\t        // local_peak is local maximum memory size, as observed by the manager, since the last\n195\t        // reset_peak call\n196\t        let local_peak = manager.max_used_size;\n197\t        let reserved = manager.pool.memory_usage();\n198\t        metrics::gauge!(\"gpu_mem.timestamp_ms\", \"module\" => label).set(ts);\n199\t        metrics::gauge!(\"gpu_mem.current_bytes\", \"module\" => label).set(current as f64);\n200\t        metrics::gauge!(\"gpu_mem.local_peak_bytes\", \"module\" => label).set(local_peak as f64);\n201\t        metrics::gauge!(\"gpu_mem.reserved_bytes\", \"module\" => label).set(reserved as f64);\n202\t    }\n203\t\n204\t    #[inline]\n205\t    pub fn tracing_info(&self, msg: impl Into<Option<&'static str>>) {\n206\t        let Some(manager) = MEMORY_MANAGER.get().and_then(|m| m.lock().ok()) else {\n207\t            tracing::error!(\"Memory manager not available\");\n208\t            return;\n209\t        };\n210\t   