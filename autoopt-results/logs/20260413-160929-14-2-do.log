ctxs = logup_ctxs_h.to_device()?;\n    let d_air_offsets = air_offsets_h.to_device()?;\n\n    let output_size = descs.len() * num_cosets as usize * skip_domain as usize;\n    let tmp_sums_size = total_blocks as usize * num_cosets as usize * skip_domain as usize;\n    let mut tmp_sums_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(tmp_sums_size);\n    let mut output = DeviceBuffer::<Frac<EF>>::with_capacity(output_size);\n\n    unsafe {\n        batched_logup_r0_eval_interactions(\n            &mut tmp_sums_buffer,\n            &mut output,\n            &d_block_ctxs,\n            &d_logup_ctxs,\n            &d_air_offsets,\n            total_blocks,\n            descs.len() as u32,\n            num_cosets,\n            skip_domain,\n            block_x,\n        )?;\n    }\n    Ok(output)\n}\n","structuredPatch":[{"oldStart":10,"oldLines":7,"newStart":10,"newLines":7,"lines":["     p3_matrix::dense::RowMajorMatrix,","     poly_common::UnivariatePoly,","     prover::{","-        fractional_sumcheck_gkr::Frac, sumcheck::sumcheck_round0_deg, DeviceStarkProvingKey,","+        fractional_sumcheck_gkr::Frac, sumcheck::sumcheck_round0_deg, MatrixDimensions,","         ProvingContext,","     },"," };"]}],"userModified":false,"replaceAll":false}}
