{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KrosDrFziGq393d5SYszFX","type":"tool_result","content":"760\t            monomial_num_y_threshold,\n761\t        })\n762\t    }\n763\t\n764\t    // PERF[jpw]: we could return evals and batch zerocheck poly by degree before interpolating.\n765\t    // Cannot do it for logup because we need to calculate the sum claims.\n766\t    #[instrument(name = \"prover.rap_constraints.ple_round0\", level = \"info\", skip_all)]\n767\t    fn sumcheck_uni_round0_polys(\n768\t        &mut self,\n769\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n770\t        lambda: EF,\n771\t    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n772\t        self.mem\n773\t            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n774\t        self.mem.reset_peak();\n775\t        let n_logup = self.n_logup;\n776\t        let l_skip = self.l_skip;\n777\t        let xi = &self.xi;\n778\t        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n779\t        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n780\t            h_lambda_pows.to_device()?\n781\t        } else {\n782\t            DeviceBuffer::new()\n783\t        });\n784\t        // Precompute lambda combinations for all AIRs with monomials\n785\t        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n786\t        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n787\t            if air_pk.other_data.zerocheck_monomials.is_some() {\n788\t                self.lambda_combinations[air_idx] = Some(\n789\t                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n790\t                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n791\t                );\n792\t            }\n793\t        }\n794\t        let num_present_airs = ctx.per_trace.len();\n795\t        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n796\t\n797\t        self.eq_3b_per_trace = ctx\n798\t            .per_trace\n799\t            .iter()\n800\t            .enumerate()\n801\t            .map(|(trace_idx, (air_idx, _))| {\n802\t                let vk = &self.pk.per_air[*air_idx].vk;\n803\t                let num_interactions = vk.num_interactions();\n804\t                if num_interactions > 0 {\n805\t                    let n = self.n_per_trace[trace_idx];\n806\t                    let n_lift = n.max(0) as usize;\n807\t                    let mut b_vec = vec![F::ZERO; n_logup - n_lift];\n808\t                    let mut weights = Vec::with_capacity(num_interactions);\n809\t                    for interaction_idx in 0..num_interactions {\n810\t                        let stacked_idx = self\n811\t                            .interactions_layout\n812\t                            .get(trace_idx, interaction_idx)\n813\t                            .unwrap()\n814\t                            .row_idx;\n815\t                        let mut b_int = stacked_idx >> (l_skip + n_lift);\n816\t                        for bit in &mut b_vec {\n817\t                            *bit = F::from_bool(b_int & 1 == 1);\n818\t                            b_int >>= 1;\n819\t                        }\n820\t                        let weight =\n821\t                            eval_eq_mle(&self.xi[l_skip + n_lift..l_skip + n_logup], &b_vec);\n822\t                        weights.push(weight);\n823\t                    }\n824\t                    weights\n825\t                } else {\n826\t                    vec![]\n827\t                }\n828\t            })\n829\t            .collect_vec();\n830\t        self.d_eq_3b_per_trace = self\n831\t            .eq_3b_per_trace\n832\t            .iter()\n833\t            .map(|eq_3bs| {\n834\t                if eq_3bs.is_empty() {\n835\t                    Ok(DeviceBuffer::new())\n836\t                } else {\n837\t                    eq_3bs.to_device()\n838\t                }\n839\t            })\n840\t            .collect::<Result<Vec<_>, _>>()?;\n841\t\n842\t        // Precompute logup combinations for all traces with interaction monomials\n843\t        for (trace_idx, (air_idx, _)) in ctx.per_trace.iter().enumerate() {\n844\t            let air_pk = &self.pk.per_air[*air_idx];\n845\t            if air_pk.other_data.interaction_monomials.is_some()\n846\t                && !self.eq_3b_per_trace[trace_idx].is_empty()\n847\t            {\n848\t                self.logup_combinations[trace_idx] = Some(\n849\t                    compute_logup_combinations(\n850\t                        self.pk,\n851\t                        *air_idx,\n852\t                        &self.d_beta_pows,\n853\t                        &self.d_eq_3b_per_trace[trace_idx],\n854\t                        &self.eq_3b_per_trace[trace_idx],\n855\t                        &self.beta_pows,\n856\t                    )\n857\t                    .map_err(LogupZerocheckError::LogupCombinations)?,\n858\t                );\n859\t            }\n860\t        }\n861\t\n862\t        // PERF[jpw]: we could also build the layers for different n in a transposed way using\n863\t        // eq_nonoverlapping_stage_ext, which is more memory efficient\n864\t        for &n in &self.n_per_trace {\n865\t            let n_lift = n.max(0) as usize;\n866\t            if let Entry::Vacant(entry) = self.eq_xis.entry(n_lift) {\n867\t                let layers =\n868\t                    EqEvalLayers::new_rev(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n869\t                        .map_err(LogupZerocheckError::EqEvalLayers)?;\n870\t                entry.insert(layers);\n871\t            }\n872\t        }\n873\t\n874\t        self.sels_per_trace_base = self\n875\t            .n_per_trace\n876\t            .iter()\n877\t            .map(|&n| {\n878\t                let n_lift = n.max(0) as usize;\n879\t                let height = 1 << n_lift;\n880\t                let mut cols = F::zero_vec(3 * height);\n881\t                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n882\t                cols[0] = F::ONE; // is_first\n883\t                cols[2 * height + height - 1] = F::ONE; // is_last\n884\t                let d_cols = cols.to_device()?;\n885\t                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n886\t            })\n887\t            .collect::<Result<Vec<_>, MemCopyError>>()?;\n888\t\n889\t        let selectors_base = self.sels_per_trace_base.clone();\n890\t\n891\t        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n892\t        // present AIR\n893\t        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n894\t        let d_lambda_pows = self\n895\t            .lambda_pows\n896\t            .as_ref()\n897\t            .expect(\"lambda powers must be set before round-0 evaluation\");\n898\t\n899\t        // Phase 1: Build work items (main thread, pure CPU)\n900\t        let per_thread_temp_bytes = self.memory_limit_bytes / NUM_ROUND0_STREAMS.max(1);\n901\t        let mut work_items: Vec<Round0AirWorkItem<HS>> = izip!(\n902\t            &ctx.per_trace,\n903\t            &self.n_per_trace,\n904\t            &selectors_base,\n905\t            &self.public_values_per_trace,\n906\t            &self.eq_3b_per_trace,\n907\t        )\n908\t        .enumerate()\n909\t        .map(|(trace_idx, ((air_idx, air_ctx), &n, sel, pv, eq3b))| Round0AirWorkItem {\n910\t            trace_idx,\n911\t            single_pk: &self.pk.per_air[*air_idx],\n912\t            n,\n913\t            selectors_cube: sel,\n914\t            public_values: pv,\n915\t            eq_3bs: eq3b,\n916\t            cached_mains: &air_ctx.cached_mains,\n917\t            common_main: &air_ctx.common_main,\n918\t            eq_xis: &self.eq_xis,\n919\t            d_lambda_pows,\n920\t            beta_pows: &self.beta_pows,\n921\t            l_skip,\n922\t            constraint_degree: self.constraint_degree,\n923\t            xi: &self.xi,\n924\t            max_temp_bytes: per_thread_temp_bytes,\n925\t        })\n926\t        .collect();\n927\t\n928\t        // Sort by descending height for better load balance across thread chunks.\n929\t        work_items.sort_by(|a, b| b.common_main.height().cmp(&a.common_main.height()));\n930\t\n931\t        // Barrier: ensure all prior GPU work (trace uploads, pk data, selectors)\n932\t        // is visible to worker thread streams.\n933\t        current_stream_sync().map_err(MemCopyError::from)?;\n934\t\n935\t        // Phase 2: Process AIRs in parallel across N OS threads.\n936\t        // Only use multi-threading when there are enough AIRs to benefit from concurrent\n937\t        // kernel execution. With few large AIRs (e.g., APC 0 has ~20 per segment), each\n938\t        // kernel already saturates the GPU and multi-threading adds memory pool overhead.\n939\t        let num_threads = if work_items.len() >= 100 {\n940\t            NUM_ROUND0_STREAMS.min(work_items.len())\n941\t        } else {\n942\t            1\n943\t        };\n944\t        let results: Vec<Round0AirResult> = if num_threads <= 1 {\n945\t            work_items\n946\t                .iter()\n947\t                .map(|w| process_air_round0(w))\n948\t                .collect::<Result<Vec<_>, _>>()?\n949\t        } else {\n950\t            let chunk_size = work_items.len().div_ceil(num_threads);\n951\t            std::thread::scope(|s| {\n952\t                let handles: Vec<_> = work_items\n953\t                    .chunks(chunk_size)\n954\t                    .map(|chunk| {\n955\t                        s.spawn(move || -> Result<Vec<Round0AirResult>, LogupZerocheckError> {\n956\t                            chunk.iter().map(|w| process_air_round0(w)).collect()\n957\t                        })\n958\t                    })\n959\t                    .collect();\n960\t                let mut all_results = Vec::with_capacity(work_items.len());\n961\t                for handle in handles {\n962\t                    all_results.extend(handle.join().unwrap()?);\n963\t                }\n964\t                Ok::<_, LogupZerocheckError>(all_results)\n965\t            })?\n966\t        };\n967\t\n968\t        // Phase 3: Scatter results into batch_sp_poly (main thread, pure CPU)\n969\t        for result in results {\n970\t            if let Some(poly) = result.zerocheck_poly {\n971\t                batch_sp_poly[2 * num_present_airs + result.trace_idx] = poly;\n972\t            }\n973\t            if let Some(poly) = result.logup_numer_poly {\n974\t                batch_sp_poly[2 * result.trace_idx] = poly;\n975\t            }\n976\t            if let Some(poly) = result.logup_denom_poly {\n977\t                batch_sp_poly[2 * result.trace_idx + 1] = poly;\n978\t            }\n979\t        }\n980\t        self.mem\n981\t            .emit_metrics_with_label(\"prover.batch_constraints.round0\");\n982\t        Ok(batch_sp_poly)\n983\t    }\n984\t\n985\t    // Note: there are no gpu sync points in this function, so span does not indicate kernel times\n986\t    #[instrument(name = \"LogupZerocheck::fold_ple_evals\", level = \"debug\", skip_all)]\n987\t    fn fold_ple_evals(\n988\t        &mut self,\n989\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,"}]},"parent_tool_use_id":"toolu_01BayDRC2BDdWWkYAw8YGfj8","session_id":"9e3c2c89-9ba9-4e03-a0d9-bb2105990b3b","uuid":"b474143d-f513-497f-87a3-f6b1d9776d61","timestamp":"2026-04-13T14:38:57.553Z"}
