{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SMtKHyrmzaoZZUDcbTmoQy","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"\n3\tAudit script for OpenVM metrics viewer.\n4\t\n5\tRecomputes the experiment details table from a metrics JSON file,\n6\tprinting all computed values so they can be verified against the web UI.\n7\t\n8\tUsage:\n9\t    python3 audit_metrics.py <metrics_file_or_url> [experiment_name]\n10\t\n11\tThe source can be a local file path or an HTTP(S) URL.\n12\tGitHub blob URLs are auto-converted to raw URLs.\n13\t\n14\tIf the input is a combined metrics file and no experiment is given,\n15\tlists available experiments.\n16\t\"\"\"\n17\t\n18\tfrom __future__ import annotations\n19\t\n20\timport json\n21\timport re\n22\timport sys\n23\timport urllib.request\n24\tfrom typing import Any, Callable, Literal\n25\t\n26\t# A single flattened metric entry: {\"group\": ..., \"air_name\": ..., \"air_id\": ..., \"metric\": ..., \"value\": ..., ...}\n27\tEntry = dict[str, str]\n28\t# Raw metrics JSON with \"counter\" and \"gauge\" arrays\n29\tMetricsJson = dict[str, Any]\n30\t# Computed metrics dict returned by extract_metrics\n31\tMetrics = dict[str, Any]\n32\t\n33\t\n34\t# ============================================================\n35\t# Computation — this is the code that needs to be audited.\n36\t# It must match the JS in index.html exactly.\n37\t# ============================================================\n38\t\n39\tdef load_metrics_dataframes(\n40\t    metrics_json: MetricsJson,\n41\t) -> tuple[list[Entry], list[Entry], list[Entry], list[Entry], list[Entry]]:\n42\t    \"\"\"Port of loadMetricsDataframes: flatten entries, split by group prefix.\"\"\"\n43\t    entries: list[Entry] = []\n44\t    for c in metrics_json[\"counter\"] + metrics_json[\"gauge\"]:\n45\t        obj = dict(c[\"labels\"])\n46\t        obj[\"metric\"] = c[\"metric\"]\n47\t        obj[\"value\"] = c[\"value\"]\n48\t        entries.append(obj)\n49\t\n50\t    app = [e for e in entries if e.get(\"group\", \"\").startswith(\"app_proof\")]\n51\t    if not app:\n52\t        app = [e for e in entries if e.get(\"group\", \"\").startswith(\"reth\")]\n53\t    leaf = [e for e in entries if e.get(\"group\", \"\").startswith(\"leaf\")]\n54\t    internal = [e for e in entries if e.get(\"group\", \"\").startswith(\"internal\")]\n55\t    compression = [e for e in entries if e.get(\"group\", \"\") == \"compression\"]\n56\t\n57\t    return entries, app, leaf, internal, compression\n58\t\n59\t\n60\tdef is_normal_instruction_air(name: str) -> bool:\n61\t    \"\"\"Port of isNormalInstructionAir.\"\"\"\n62\t    m = re.match(r\"^VmAirWrapper<[^,]+,\\s*([^>]+?)(?:<(\\d+)(?:,\\s*\\d+)*>)?\\s*>$\", name or \"\")\n63\t    if not m:\n64\t        return False\n65\t    if m.group(1) == \"FieldExpressionCoreAir\":\n66\t        return False\n67\t    if m.group(2) and int(m.group(2)) != 4:\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef sum_metric(entries: list[Entry], metric_name: str) -> float:\n73\t    \"\"\"Sum values for entries matching metric_name.\"\"\"\n74\t    return sum(float(e[\"value\"]) for e in entries if e[\"metric\"] == metric_name)\n75\t\n76\t\n77\tdef unique_metric(entries: list[Entry], metric_name: str) -> float:\n78\t    \"\"\"Get the value of a metric that must appear exactly once.\"\"\"\n79\t    matches = [e for e in entries if e[\"metric\"] == metric_name]\n80\t    assert len(matches) == 1, f\"Expected exactly 1 entry for '{metric_name}', found {len(matches)}\"\n81\t    return float(matches[0][\"value\"])\n82\t\n83\t\n84\tdef detect_version(metrics_json: MetricsJson) -> Literal[1, 2]:\n85\t    \"\"\"Returns 2 if any metric name contains 'logup_gkr' (V2-only), else 1.\"\"\"\n86\t    names = {e[\"metric\"] for e in metrics_json[\"counter\"] + metrics_json[\"gauge\"]}\n87\t    return 2 if any(\"logup_gkr\" in n for n in names) else 1\n88\t\n89\t\n90\tdef extract_metrics(run_name: str, metrics_json: MetricsJson) -> Metrics:\n91\t    \"\"\"Port of extractMetrics from index.html. Returns dict of all computed values.\"\"\"\n92\t    all_entries, app, leaf, internal, compression = load_metrics_dataframes(metrics_json)\n93\t    m: Metrics = {}\n94\t    m[\"name\"] = run_name\n95\t\n96\t    # --- Classify app AIRs ---\n97\t    powdr_air = [e for e in app if (e.get(\"air_name\") or \"\").startswith(\"PowdrAir\")]\n98\t    non_powdr = [e for e in app if not (e.get(\"air_name\") or \"\").startswith(\"PowdrAir\")]\n99\t    normal_air = [e for e in non_powdr if is_normal_instruction_air(e.get(\"air_name\", \"\"))]\n100\t    precompile_air = [e for e in non_powdr if not is_normal_instruction_air(e.get(\"air_name\", \"\"))]\n101\t\n102\t    # --- Basic stats ---\n103\t    m[\"app_proof_cols\"] = sum_metric(app, \"main_cols\") + sum_metric(app, \"prep_cols\") + sum_metric(app, \"perm_cols\")\n104\t    segments = [int(e[\"segment\"]) for e in app if \"segment\" in e]\n105\t    m[\"num_segments\"] = max(segments, default=-1) + 1\n106\t    m[\"num_air_instances\"] = len([e for e in app if e[\"metric\"] == \"rows\"])\n107\t    m[\"app_proof_cells\"] = sum_metric(app, \"total_cells\")\n108\t    m[\"app_proof_cells_used\"] = sum_metric(app, \"total_cells_used\")  # V1 only\n109\t\n110\t    # --- Constraints & bus interactions ---\n111\t    has_constraints = any(e[\"metric\"] == \"constraints\" for e in all_entries)\n112\t    has_interactions = any(e[\"metric\"] == \"interactions\" for e in all_entries)\n113\t\n114\t    # Rows & segments by AIR, summed over all segments.\n115\t    # We key by (air_id, air_name) because air_id alone is only unique within a proving\n116\t    # phase — different phases (app, leaf, compression) reuse the same air_id for\n117\t    # unrelated AIRs. Keying by the pair is a pragmatic fix: it would break if the same\n118\t    # (air_id, air_name) tuple appeared in two different phases, but that is unlikely\n119\t    # since each phase uses a distinct AIR set.\n120\t    segments_by_app_air: dict[str, float] = {}\n121\t    rows_by_app_air: dict[str, float] = {}\n122\t    for e in app:\n123\t        # Rows are indicated per segment and AIR\n124\t        if e[\"metric\"] == \"rows\":\n125\t            key = f\"{e['air_id']}:{e.get('air_name', '')}\"\n126\t            segments_by_app_air[key] = segments_by_app_air.get(key, 0) + 1\n127\t            rows_by_app_air[key] = rows_by_app_air.get(key, 0) + float(e[\"value\"])\n128\t\n129\t    # Constraints and interactions are listed per AIR.\n130\t    # For the number of constraints and interactions, we weight by the number of segments for that AIR;\n131\t    # for the number of instances and messages, we weight by the number of rows (across all segments).\n132\t    def weighted_sum(metric_name: str, weights: dict[str, float]) -> float:\n133\t        return sum(\n134\t            float(e[\"value\"]) * weights.get(f\"{e['air_id']}:{e.get('air_name', '')}\", 0)\n135\t            for e in all_entries if e[\"metric\"] == metric_name\n136\t        )\n137\t\n138\t    m[\"constraints\"] = weighted_sum(\"constraints\", segments_by_app_air) if has_constraints else None\n139\t    m[\"bus_interactions\"] = weighted_sum(\"interactions\", segments_by_app_air) if has_interactions else None\n140\t    m[\"constraint_instances\"] = weighted_sum(\"constraints\", rows_by_app_air) if has_constraints else None\n141\t    m[\"bus_interaction_messages\"] = weighted_sum(\"interactions\", rows_by_app_air) if has_interactions else None\n142\t\n143\t    # --- Proof times by phase ---\n144\t    # execute_metered runs *before* segment proving and is outside per-segment\n145\t    # total_proof_time_ms. We report it as a separate top-level phase.\n146\t    m[\"execute_metered_time_ms\"] = sum_metric(app, \"execute_metered_time_ms\")\n147\t    m[\"app_proof_time_ms\"] = sum_metric(app, \"total_proof_time_ms\")\n148\t    m[\"leaf_proof_time_ms\"] = sum_metric(leaf, \"total_proof_time_ms\")\n149\t    m[\"inner_recursion_proof_time_ms\"] = sum_metric(internal, \"total_proof_time_ms\")\n150\t    m[\"compression_proof_time_ms\"] = sum_metric(compression, \"total_proof_time_ms\")\n151\t    m[\"total_proof_time_ms\"] = (m[\"execute_metered_time_ms\"] + m[\"app_proof_time_ms\"]\n152\t        + m[\"leaf_proof_time_ms\"] + m[\"inner_recursion_proof_time_ms\"]\n153\t        + m[\"compression_proof_time_ms\"])\n154\t\n155\t    # --- STARK time excluding trace ---\n156\t    m[\"app_proof_time_excluding_trace_ms\"] = sum_metric(app, \"stark_prove_excluding_trace_time_ms\")\n157\t\n158\t    # --- App time sub-components ---\n159\t    m[\"app_execute_preflight_time_ms\"] = sum_metric(app, \"execute_preflight_time_ms\")\n160\t    m[\"app_trace_gen_time_ms\"] = sum_metric(app, \"trace_gen_time_ms\")\n161\t    m[\"app_set_initial_memory_time_ms\"] = sum_metric(app, \"set_initial_memory_time_ms\")  # V2 only\n162\t\n163\t    # --- V2: STARK sub-components (prover.*) ---\n164\t    m[\"app_trace_commit_time_ms\"] = sum_metric(app, \"prover.main_trace_commit_time_ms\")\n165\t    m[\"app_rap_constraints_time_ms\"] = sum_metric(app, \"prover.rap_constraints_time_ms\")\n166\t    m[\"app_openings_time_ms\"] = sum_metric(app, \"prover.openings_time_ms\")\n167\t    m[\"app_stark_other_ms\"] = (m[\"app_proof_time_excluding_trace_ms\"]\n168\t        - m[\"app_trace_commit_time_ms\"] - m[\"app_rap_constraints_time_ms\"] - m[\"app_openings_time_ms\"])\n169\t\n170\t    # --- V2: rap_constraints sub-components ---\n171\t    m[\"app_rap_logup_gkr_time_ms\"] = sum_metric(app, \"prover.rap_constraints.logup_gkr_time_ms\")\n172\t    m[\"app_rap_round0_time_ms\"] = sum_metric(app, \"prover.rap_constraints.round0_time_ms\")\n173\t    m[\"app_rap_mle_rounds_time_ms\"] = sum_metric(app, \"prover.rap_constraints.mle_rounds_time_ms\")\n174\t    m[\"app_rap_other_ms\"] = (m[\"app_rap_constraints_time_ms\"]\n175\t        - m[\"app_rap_logup_gkr_time_ms\"] - m[\"app_rap_round0_time_ms\"] - m[\"app_rap_mle_rounds_time_ms\"])\n176\t\n177\t    # --- V2: openings sub-components ---\n178\t    m[\"app_openings_whir_time_ms\"] = sum_metric(app, \"prover.openings.whir_time_ms\")\n179\t    m[\"app_openings_stacked_reduction_time_ms\"] = sum_metric(app, \"prover.openings.stacked_reduction_time_ms\")\n180\t    m[\"app_openings_other_ms\"] = (m[\"app_openings_time_ms\"]\n181\t        - m[\"app_openings_whir_time_ms\"] - m[\"app_openings_stacked_reduction_time_ms\"])\n182\t\n183\t    # --- App other (residual) ---\n184\t    # execute_metered is a separate top-level phase, not inside app_proof_time_ms.\n185\t    m[\"app_other_ms\"] = (m[\"app_proof_time_ms\"]\n186\t        - m[\"app_proof_time_excluding_trace_ms\"]\n187\t        - m[\"app_execute_preflight_time_ms\"]\n188\t        - m[\"app_trace_gen_time_ms\"] - m[\"app_set_initial_memory_time_ms\"])\n189\t\n190\t    # --- Cell ratios ---\n191\t    total = m[\"app_proof_cells\"]\n192\t    m[\"powdr_ratio\"] = sum_metric(powdr_air, \"cells\") / total if total > 0 else 0\n193\t    m[\"normal_instruction_ratio\"] = sum_metric(normal_air, \"cells\") / total if total > 0 else 0\n194\t    m[\"openvm_precompile_ratio\"] = sum_metric(precompile_air, \"cells\") / total if total > 0 else 0\n195\t\n196\t    return m\n197\t\n198\t\n199\t# ============================================================\n200\t# Presentation — formatting and printing (not part of audit)\n201\t# ============================================================\n202\t\n203\tFormatter = Callable[[float], str]\n204\t\n205\t# Basic stats row: (key, label, formatter)\n206\tBasicRow = tuple[str, str, Formatter]\n207\t# Proof time row: (key, label, indent, flags)  — flags: b=bold, r=residual\n208\tProofRow = tuple[str, str, int, str]\n209\t# Union of row types used by print_section\n210\tRow = BasicRow | ProofRow\n211\t\n212\t\n213\tdef fmt_ms(ms: float) -> str:\n214\t    return f\"{ms / 1000:.2f}s ({ms:.0f} ms)\"\n215\t\n216\tdef fmt_cells(v: float) -> str:\n217\t    for threshold, suffix in [(1e9, \"B\"), (1e6, \"M\"), (1e3, \"K\")]:\n218\t        if v >= threshold:\n219\t            return f\"{v / threshold:.2f}{suffix} ({v:,.0f})\"\n220\t    return f\"{v:,.0f}\"\n221\t\n222\tdef fmt_int(v: float) -> str:\n223\t    return f\"{v:,.0f}\"\n224\t\n225\tdef fmt_pct(v: float) -> str:\n226\t    return f\"{v * 100:.1f}%\"\n227\t\n228\t\n229\tBASIC_STATS_V1: list[BasicRow] = [\n230\t    (\"num_segments\",            \"Segments\",                     lambda v: str(int(v))),\n231\t    (\"num_air_instances\",       \"AIR Instances\",                fmt_int),\n232\t    (\"app_proof_cols\",          \"Columns\",                  fmt_int),\n233\t    (\"app_proof_cells\",         \"Cells\",                    fmt_cells),\n234\t    (\"app_proof_cells_used\",    \"Cells (without padding)\",  fmt_cells),\n235\t    (\"constraints\",             \"Constraints\",                  fmt_int),\n236\t    (\"constraint_instances\",    \"Constraint Instances\",         fmt_cells),\n237\t    (\"bus_interactions\",        \"Bus Interactions\",              fmt_int),\n238\t    (\"bus_interaction_messages\", \"Bus Interaction Messages\",     fmt_cells),\n239\t]\n240\t\n241\tBASIC_STATS_V2: list[BasicRow] = [r for r in BASIC_STATS_V1 if r[0] != \"app_proof_cells_used\"]\n242\t\n243\tPROOF_TIME_V1: list[ProofRow] = [\n244\t    (\"execute_metered_time_ms\",          \"Metered Execution\",     0, \"\"),\n245\t    (\"app_proof_time_ms\",                \"App Proof Time\",        0, \"\"),\n246\t    (\"app_proof_time_excluding_trace_ms\",\"  STARK (excl. trace)\", 1, \"\"),\n247\t    (\"app_execute_preflight_time_ms\",    \"  Preflight Execution\", 1, \"\"),\n248\t    (\"app_trace_gen_time_ms\",            \"  Trace Gen\",           1, \"\"),\n249\t    (\"app_other_ms\",                     \"  Other / Overlap\",     1, \"r\"),\n250\t    (\"leaf_proof_time_ms\",               \"Leaf Recursion\",        0, \"\"),\n251\t    (\"inner_recursion_proof_time_ms\",    \"Inner Recursion\",       0, \"\"),\n252\t    (\"total_proof_time_ms\",              \"Total\",                 0, \"\"),\n253\t]\n254\t\n255\tPROOF_TIME_V2: list[ProofRow] = [\n256\t    (\"execute_metered_time_ms\",              \"Metered Execution\",     0, \"\"),\n257\t    (\"app_proof_time_ms\",                    \"App Proof Time\",        0, \"\"),\n258\t    (\"app_proof_time_excluding_trace_ms\",    \"  STARK (excl. trace)\", 1, \"\"),\n259\t    (\"app_rap_constraints_time_ms\",          \"    Constraints\",       2, \"\"),\n260\t    (\"app_rap_logup_gkr_time_ms\",           \"      LogUp GKR\",       3, \"\"),\n261\t    (\"app_rap_round0_time_ms\",              \"      Round 0\",         3, \"\"),\n262\t    (\"app_rap_mle_rounds_time_ms\",          \"      MLE Rounds\",      3, \"\"),\n263\t    (\"app_rap_other_ms\",                    \"      Other\",           3, \"r\"),\n264\t    (\"app_openings_time_ms\",                \"    Openings\",          2, \"\"),\n265\t    (\"app_openings_whir_time_ms\",           \"      WHIR\",            3, \"\"),\n266\t    (\"app_openings_stacked_reduction_time_ms\",\"      Stacked Reduction\", 3, \"\"),\n267\t    (\"app_openings_other_ms\",               \"      Other\",           3, \"r\"),\n268\t    (\"app_trace_commit_time_ms\",            \"    Trace Commit\",      2, \"\"),\n269\t    (\"app_stark_other_ms\",                  \"    Other\",             2, \"r\"),\n270\t    (\"app_execute_preflight_time_ms\",       \"  Preflight Execution\", 1, \"\"),\n271\t    (\"app_set_initial_memory_time_ms\",      \"  Set Initial Memory\",  1, \"\"),\n272\t    (\"app_trace_gen_time_ms\",               \"  Trace Gen\",           1, \"\"),\n273\t    (\"app_other_ms\",                        \"  Other\",               1, \"r\"),\n274\t    (\"leaf_proof_time_ms\",                  \"Leaf Recursion\",        0, \"\"),\n275\t    (\"inner_recursion_proof_time_ms\",       \"Inner Recursion\",       0, \"\"),\n276\t    (\"compression_proof_time_ms\",           \"Compression\",           0, \"\"),\n277\t    (\"total_proof_time_ms\",                 \"Total\",                 0, \"\"),\n278\t]\n279\t\n280\tCELL_DISTRIBUTION: list[BasicRow] = [\n281\t    (\"powdr_ratio\",               \"Powdr\",              fmt_pct),\n282\t    (\"normal_instruction_ratio\",  \"Normal Instructions\", fmt_pct),\n283\t    (\"openvm_precompile_ratio\",   \"OpenVM Precompiles\",  fmt_pct),\n284\t]\n285\t\n286\t\n287\tdef print_section(\n288\t    title: str, rows: list[Row], m: Metrics, *, pct_of_key: str | None = None\n289\t) -> None:\n290\t    print(f\"\\n  {title}\")\n291\t    print(f\"  {'─' * 58}\")\n292\t    width = max(len(r[1]) for r in rows)\n293\t    total = m.get(pct_of_key, 0) if pct_of_key else 0\n294\t\n295\t    for row in rows:\n296\t        key, label = row[0], row[1]\n297\t        val: float | None = m.get(key)\n298\t\n299\t        if key == \"total_proof_time_ms\":\n300\t            print(f\"  {'─' * 58}\")\n301\t\n302\t        if val is None:\n303\t            print(f\"  {label:<{width}}  N/A\")\n304\t            continue\n305\t\n306\t        # Determine formatter and flags\n307\t        if len(row) == 3:\n308\t            fmt: Formatter = row[2]  # type: ignore[assignment]\n309\t            flags = \"\"\n310\t        else:\n311\t            fmt = fmt_ms\n312\t            flags: str = row[3]  # type: ignore[no-redef]\n313\t\n314\t        suffix = \" (residual)\" if \"r\" in flags else \"\"\n315\t\n316\t        pct = f\"  ({val / total * 100:5.1f}%)\" if total > 0 else \"\"\n317\t        print(f\"  {label:<{width}}  {fmt(val)}{pct}{suffix}\")\n318\t\n319\t\n320\t# ============================================================\n321\t# Data loading (IO)\n322\t# ============================================================\n323\t\n324\tdef load_data(source: str) -> tuple[dict[str, Any], str]:\n325\t    \"\"\"Load JSON from a file path or URL. Returns (data, source_label).\"\"\"\n326\t    if source.startswith(\"http://\") or source.startswith(\"https://\"):\n327\t        url = re.sub(r\"github\\.com/(.+)/blob/\", r\"raw.githubusercontent.com/\\1/\", source)\n328\t        with urllib.request.urlopen(url) as resp:\n329\t            return json.loads(resp.read()), url.split(\"/\")[-1]\n330\t    else:\n331\t        with open(source) as f:\n332\t            return json.load(f), source.split(\"/\")[-1]\n333\t\n334\t\n335\tdef resolve_experiments(\n336\t    data: dict[str, Any], source_label: str, experiment: str | None\n337\t) -> dict[str, MetricsJson]:\n338\t    \"\"\"Normalize raw/combined input and select experiment(s). Returns dict of {name: json}.\"\"\"\n339\t    if \"counter\" in data and \"gauge\" in data:\n340\t        name = experiment or source_label.replace(\".json\", \"\")\n341\t        return {name: data}\n342\t\n343\t    if experiment:\n344\t        if experiment not in data:\n345\t            sys.exit(f\"Error: '{experiment}' not found. Available: {', '.join(sorted(data))}\")\n346\t        return {experiment: data[experiment]}\n347\t\n348\t    if len(data) == 1:\n349\t        return data\n350\t\n351\t    print(f\"Combined file with {len(data)} experiments:\")\n352\t    for name in sorted(data):\n353\t        print(f\"  - {name}\")\n354\t    print(f\"\\nUsage: {sys.argv[0]} {sys.argv[1]} <experiment_name>\")\n355\t    sys.exit(0)\n356\t\n357\t\n358\t# ============================================================\n359\t# Main\n360\t# ============================================================\n361\t\n362\tdef main() -> None:\n363\t    if len(sys.argv) < 2:\n364\t        print(__doc__.strip())\n365\t        sys.exit(1)\n366\t\n367\t    data, source_label = load_data(sys.argv[1])\n368\t    experiment = sys.argv[2] if len(sys.argv) > 2 else None\n369\t    runs = resolve_experiments(data, source_label, experiment)\n370\t\n371\t    for run_name, metrics_json in runs.items():\n372\t        version = detect_version(metrics_json)\n373\t        m = extract_metrics(run_name, metrics_json)\n374\t\n375\t        print(f\"\\nExperiment: {run_name}  (OpenVM {version})\")\n376\t\n377\t        basic = BASIC_STATS_V2 if version == 2 else BASIC_STATS_V1\n378\t        proof = PROOF_TIME_V2 if version == 2 else PROOF_TIME_V1\n379\t\n380\t        print_section(\"App Proof Basic Stats\", basic, m)\n381\t        print_section(\"Proof Time\", proof, m, pct_of_key=\"total_proof_time_ms\")\n382\t        print_section(\"Trace Cell Distribution\", CELL_DISTRIBUTION, m)\n383\t\n384\t\n385\tif __name__ == \"__main__\":\n386\t    main()\n387\t"}]},"parent_tool_use_id":null,"session_id":"9fb0c9c1-c32f-45e4-afe7-f108d55d0327","uuid":"4c619366-fda2-42d9-9cc0-fff3139bf05e","timestamp":"2026-04-12T19:18:34.951Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/spec.py","content":"#!/usr/bin/env python3\n\"\"\"\nAudit script for OpenVM metrics viewer.\n\nRecomputes the experiment details table from a metrics JSON file,\nprinting all computed values so they can be verified against the web UI.\n\nUsage:\n    python3 audit_metrics.py <metrics_file_or_url> [experiment_name]\n\nThe source can be a local file path or an HTTP(S) URL.\nGitHub blob URLs are auto-converted to raw URLs.\n\nIf the input is a combined metrics file and no experiment is given,\nlists available experiments.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport re\nimport sys\nimport urllib.request\nfrom typing import Any, Callable, Literal\n\n# A single flattened metric entry: {\"group\": ..., \"air_name\": ..., \"air_id\": ..., \"metric\": ..., \"value\": ..., ...}\nEntry = dict[str, str]\n# Raw metrics JSON with \"counter\" and \"gauge\" arrays\nMetricsJson = dict[str, Any]\n# Computed metrics dict returned by extract_metrics\nMetrics = dict[str, Any]\n\n\n# ============================================================\n# Computation — this is the code that needs to be audited.\n# It must match the JS in index.html exactly.\n# ============================================================\n\ndef load_metrics_dataframes(\n    metrics_json: MetricsJson,\n) -> tuple[list[Entry], list[Entry], list[Entry], list[Entry], list[Entry]]:\n    \"\"\"Port of loadMetricsDataframes: flatten entries, split by group prefix.\"\"\"\n    entries: list[Entry] = []\n    for c in metrics_json[\"counter\"] + metrics_json[\"gauge\"]:\n        obj = dict(c[\"labels\"])\n        obj[\"metric\"] = c[\"metric\"]\n        obj[\"value\"] = c[\"value\"]\n        entries.append(obj)\n\n    app = [e for e in entries if e.get(\"group\", \"\").startswith(\"app_proof\")]\n    if not app:\n        app = [e for e in entries if e.get(\"group\", \"\").startswith(\"reth\")]\n    leaf = [e for e in entries if e.get(\"group\", \"\").startswith(\"leaf\")]\n    internal = [e for e in entries if e.get(\"group\", \"\").startswith(\"internal\")]\n    compression = [e for e in entries if e.get(\"group\", \"\") == \"compression\"]\n\n    return entries, app, leaf, internal, compression\n\n\ndef is_normal_instruction_air(name: str) -> bool:\n    \"\"\"Port of isNormalInstructionAir.\"\"\"\n    m = re.match(r\"^VmAirWrapper<[^,]+,\\s*([^>]+?)(?:<(\\d+)(?:,\\s*\\d+)*>)?\\s*>$\", name or \"\")\n    if not m:\n        return False\n    if m.group(1) == \"FieldExpressionCoreAir\":\n        return False\n    if m.group(2) and int(m.group(2)) != 4:\n        return False\n    return True\n\n\ndef sum_metric(entries: list[Entry], metric_name: str) -> float:\n    \"\"\"Sum values for entries matching metric_name.\"\"\"\n    return sum(float(e[\"value\"]) for e in entries if e[\"metric\"] == metric_name)\n\n\ndef unique_metric(entries: list[Entry], metric_name: str) -> float:\n    \"\"\"Get the value of a metric that must appear exactly once.\"\"\"\n    matches = [e for e in entries if e[\"metric\"] == metric_name]\n    assert len(matches) == 1, f\"Expected exactly 1 entry for '{metric_name}', found {len(matches)}\"\n    return float(matches[0][\"value\"])\n\n\ndef detect_version(metrics_json: MetricsJson) -> Literal[1, 2]:\n    \"\"\"Returns 2 if any metric name contains 'logup_gkr' (V2-only), else 1.\"\"\"\n    names = {e[\"metric\"] for e in metrics_json[\"counter\"] + metrics_json[\"gauge\"]}\n    return 2 if any(\"logup_gkr\" in n for n in names) else 1\n\n\ndef extract_metrics(run_name: str, metrics_json: MetricsJson) -> Metrics:\n    \"\"\"Port of extractMetrics from index.html. Returns dict of all computed values.\"\"\"\n    all_entries, app, leaf, internal, compression = load_metrics_dataframes(metrics_json)\n    m: Metrics = {}\n    m[\"name\"] = run_name\n\n    # --- Classify app AIRs ---\n    powdr_air = [e for e in app if (e.get(\"air_name\") or \"\").startswith(\"PowdrAir\")]\n    non_powdr = [e for e in app if not (e.get(\"air_name\") or \"\").startswith(\"PowdrAir\")]\n    normal_air = [e for e in non_powdr if is_normal_instruction_air(e.get(\"air_name\", \"\"))]\n    precompile_air = [e for e in non_powdr if not is_normal_instruction_air(e.get(\"air_name\", \"\"))]\n\n    # --- Basic stats ---\n    m[\"app_proof_cols\"] = sum_metric(app, \"main_cols\") + sum_metric(app, \"prep_cols\") + sum_metric(app, \"perm_cols\")\n    segments = [int(e[\"segment\"]) for e in app if \"segment\" in e]\n    m[\"num_segments\"] = max(segments, default=-1) + 1\n    m[\"num_air_instances\"] = len([e for e in app if e[\"metric\"] == \"rows\"])\n    m[\"app_proof_cells\"] = sum_metric(app, \"total_cells\")\n    m[\"app_proof_cells_used\"] = sum_metric(app, \"total_cells_used\")  # V1 only\n\n    # --- Constraints & bus interactions ---\n    has_constraints = any(e[\"metric\"] == \"constraints\" for e in all_entries)\n    has_interactions = any(e[\"metric\"] == \"interactions\" for e in all_entries)\n\n    # Rows & segments by AIR, summed over all segments.\n    # We key by (air_id, air_name) because air_id alone is only unique within a proving\n    # phase — different phases (app, leaf, compression) reuse the same air_id for\n    # unrelated AIRs. Keying by the pair is a pragmatic fix: it would break if the same\n    # (air_id, air_name) tuple appeared in two different phases, but that is unlikely\n    # since each phase uses a distinct AIR set.\n    segments_by_app_air: dict[str, float] = {}\n    rows_by_app_air: dict[str, float] = {}\n    for e in app:\n        # Rows are indicated per segment and AIR\n        if e[\"metric\"] == \"rows\":\n            key = f\"{e['air_id']}:{e.get('air_name', '')}\"\n            segments_by_app_air[key] = segments_by_app_air.get(key, 0) + 1\n            rows_by_app_air[key] = rows_by_app_air.get(key, 0) + float(e[\"value\"])\n\n    # Constraints and interactions are listed per AIR.\n    # For the number of constraints and interactions, we weight by the number of segments for that AIR;\n    # for the number of instances and messages, we weight by the number of rows (across all segments).\n    def weighted_sum(metric_name: str, weights: dict[str, float]) -> float:\n        return sum(\n            float(e[\"value\"]) * weights.get(f\"{e['air_id']}:{e.get('air_name', '')}\", 0)\n            for e in all_entries if e[\"metric\"] == metric_name\n        )\n\n    m[\"constraints\"] = weighted_sum(\"constraints\", segments_by_app_air) if has_constraints else None\n    m[\"bus_interactions\"] = weighted_sum(\"interactions\", segments_by_app_air) if has_interactions else None\n    m[\"constraint_instances\"] = weighted_sum(\"constraints\", rows_by_app_air) if has_constraints else None\n    m[\"bus_interaction_messages\"] = weighted_sum(\"interactions\", rows_by_app_air) if has_interactions else None\n\n    # --- Proof times by phase ---\n    # execute_metered runs *before* segment proving and is outside per-segment\n    # total_proof_time_ms. We report it as a separate top-level phase.\n    m[\"execute_metered_time_ms\"] = sum_metric(app, \"execute_metered_time_ms\")\n    m[\"app_proof_time_ms\"] = sum_metric(app, \"total_proof_time_ms\")\n    m[\"leaf_proof_time_ms\"] = sum_metric(leaf, \"total_proof_time_ms\")\n    m[\"inner_recursion_proof_time_ms\"] = sum_metric(internal, \"total_proof_time_ms\")\n    m[\"compression_proof_time_ms\"] = sum_metric(compression, \"total_proof_time_ms\")\n    m[\"total_proof_time_ms\"] = (m[\"execute_metered_time_ms\"] + m[\"app_proof_time_ms\"]\n        + m[\"leaf_proof_time_ms\"] + m[\"inner_recursion_proof_time_ms\"]\n        + m[\"compression_proof_time_ms\"])\n\n    # --- STARK time excluding trace ---\n    m[\"app_proof_time_excluding_trace_ms\"] = sum_metric(app, \"stark_prove_excluding_trace_time_ms\")\n\n    # --- App time sub-components ---\n    m[\"app_execute_preflight_time_ms\"] = sum_metric(app, \"execute_preflight_time_ms\")\n    m[\"app_trace_gen_time_ms\"] = sum_metric(app, \"trace_gen_time_ms\")\n    m[\"app_set_initial_memory_time_ms\"] = sum_metric(app, \"set_initial_memory_time_ms\")  # V2 only\n\n    # --- V2: STARK sub-components (prover.*) ---\n    m[\"app_trace_commit_time_ms\"] = sum_metric(app, \"prover.main_trace_commit_time_ms\")\n    m[\"app_rap_constraints_time_ms\"] = sum_metric(app, \"prover.rap_constraints_time_ms\")\n    m[\"app_openings_time_ms\"] = sum_metric(app, \"prover.openings_time_ms\")\n    m[\"app_stark_other_ms\"] = (m[\"app_proof_time_excluding_trace_ms\"]\n        - m[\"app_trace_commit_time_ms\"] - m[\"app_rap_constraints_time_ms\"] - m[\"app_openings_time_ms\"])\n\n    # --- V2: rap_constraints sub-components ---\n    m[\"app_rap_logup_gkr_time_ms\"] = sum_metric(app, \"prover.rap_constraints.logup_gkr_time_ms\")\n    m[\"app_rap_round0_time_ms\"] = sum_metric(app, \"prover.rap_constraints.round0_time_ms\")\n    m[\"app_rap_mle_rounds_time_ms\"] = sum_metric(app, \"prover.rap_constraints.mle_rounds_time_ms\")\n    m[\"app_rap_other_ms\"] = (m[\"app_rap_constraints_time_ms\"]\n        - m[\"app_rap_logup_gkr_time_ms\"] - m[\"app_rap_round0_time_ms\"] - m[\"app_rap_mle_rounds_time_ms\"])\n\n    # --- V2: openings sub-components ---\n    m[\"app_openings_whir_time_ms\"] = sum_metric(app, \"prover.openings.whir_time_ms\")\n    m[\"app_openings_stacked_reduction_time_ms\"] = sum_metric(app, \"prover.openings.stacked_reduction_time_ms\")\n    m[\"app_openings_other_ms\"] = (m[\"app_openings_time_ms\"]\n        - m[\"app_openings_whir_time_ms\"] - m[\"app_openings_stacked_reduction_time_ms\"])\n\n    # --- App other (residual) ---\n    # execute_metered is a separate top-level phase, not inside app_proof_time_ms.\n    m[\"app_other_ms\"] = (m[\"app_proof_time_ms\"]\n        - m[\"app_proof_time_excluding_trace_ms\"]\n        - m[\"app_execute_preflight_time_ms\"]\n        - m[\"app_trace_gen_time_ms\"] - m[\"app_set_initial_memory_time_ms\"])\n\n    # --- Cell ratios ---\n    total = m[\"app_proof_cells\"]\n    m[\"powdr_ratio\"] = sum_metric(powdr_air, \"cells\") / total if total > 0 else 0\n    m[\"normal_instruction_ratio\"] = sum_metric(normal_air, \"cells\") / total if total > 0 else 0\n    m[\"openvm_precompile_ratio\"] = sum_metric(precompile_air, \"cells\") / total if total > 0 else 0\n\n    return m\n\n\n# ============================================================\n# Presentation — formatting and printing (not part of audit)\n# ============================================================\n\nFormatter = Callable[[float], str]\n\n# Basic stats row: (key, label, formatter)\nBasicRow = tuple[str, str, Formatter]\n# Proof time row: (key, label, indent, flags)  — flags: b=bold, r=residual\nProofRow = tuple[str, str, int, str]\n# Union of row types used by print_section\nRow = BasicRow | ProofRow\n\n\ndef fmt_ms(ms: float) -> str:\n    return f\"{ms / 1000:.2f}s ({ms:.0f} ms)\"\n\ndef fmt_cells(v: float) -> str:\n    for threshold, suffix in [(1e9, \"B\"), (1e6, \"M\"), (1e3, \"K\")]:\n        if v >= threshold:\n            return f\"{v / threshold:.2f}{suffix} ({v:,.0f})\"\n    return f\"{v:,.0f}\"\n\ndef fmt_int(v: float) -> str:\n    return f\"{v:,.0f}\"\n\ndef fmt_pct(v: float) -> str:\n    return f\"{v * 100:.1f}%\"\n\n\nBASIC_STATS_V1: list[BasicRow] = [\n    (\"num_segments\",            \"Segments\",                     lambda v: str(int(v))),\n    (\"num_air_instances\",       \"AIR Instances\",                fmt_int),\n    (\"app_proof_cols\",          \"Columns\",                  fmt_int),\n    (\"app_proof_cells\",         \"Cells\",                    fmt_cells),\n    (\"app_proof_cells_used\",    \"Cells (without padding)\",  fmt_cells),\n    (\"constraints\",             \"Constraints\",                  fmt_int),\n    (\"constraint_instances\",    \"Constraint Instances\",         fmt_cells),\n    (\"bus_interactions\",        \"Bus Interactions\",              fmt_int),\n    (\"bus_interaction_messages\", \"Bus Interaction Messages\",     fmt_cells),\n]\n\nBASIC_STATS_V2: list[BasicRow] = [r for r in BASIC_STATS_V1 if r[0] != \"app_proof_cells_used\"]\n\nPROOF_TIME_V1: list[ProofRow] = [\n    (\"execute_metered_time_ms\",          \"Metered Execution\",     0, \"\"),\n    (\"app_proof_time_ms\",                \"App Proof Time\",        0, \"\"),\n    (\"app_proof_time_excluding_trace_ms\",\"  STARK (excl. trace)\", 1, \"\"),\n    (\"app_execute_preflight_time_ms\",    \"  Preflight Execution\", 1, \"\"),\n    (\"app_trace_gen_time_ms\",            \"  Trace Gen\",           1, \"\"),\n    (\"app_other_ms\",                     \"  Other / Overlap\",     1, \"r\"),\n    (\"leaf_proof_time_ms\",               \"Leaf Recursion\",        0, \"\"),\n    (\"inner_recursion_proof_time_ms\",    \"Inner Recursion\",       0, \"\"),\n    (\"total_proof_time_ms\",              \"Total\",                 0, \"\"),\n]\n\nPROOF_TIME_V2: list[ProofRow] = [\n    (\"execute_metered_time_ms\",              \"Metered Execution\",     0, \"\"),\n    (\"app_proof_time_ms\",                    \"App Proof Time\",        0, \"\"),\n    (\"app_proof_time_excluding_trace_ms\",    \"  STARK (excl. trace)\", 1, \"\"),\n    (\"app_rap_constraints_time_ms\",          \"    Constraints\",       2, \"\"),\n    (\"app_rap_logup_gkr_time_ms\",           \"      LogUp GKR\",       3, \"\"),\n    (\"app_rap_round0_time_ms\",              \"      Round 0\",         3, \"\"),\n    (\"app_rap_mle_rounds_time_ms\",          \"      MLE Rounds\",      3, \"\"),\n    (\"app_rap_other_ms\",                    \"      Other\",           3, \"r\"),\n    (\"app_openings_time_ms\",                \"    Openings\",          2, \"\"),\n    (\"app_openings_whir_time_ms\",           \"      WHIR\",            3, \"\"),\n    (\"app_openings_stacked_reduction_time_ms\",\"      Stacked Reduction\", 3, \"\"),\n    (\"app_openings_other_ms\",               \"      Other\",           3, \"r\"),\n    (\"app_trace_commit_time_ms\",            \"    Trace Commit\",      2, \"\"),\n    (\"app_stark_other_ms\",                  \"    Other\",             2, \"r\"),\n    (\"app_execute_preflight_time_ms\",       \"  Preflight Execution\", 1, \"\"),\n    (\"app_set_initial_memory_time_ms\",      \"  Set Initial Memory\",  1, \"\"),\n    (\"app_trace_gen_time_ms\",               \"  Trace Gen\",           1, \"\"),\n    (\"app_other_ms\",                        \"  Other\",               1, \"r\"),\n    (\"leaf_proof_time_ms\",                  \"Leaf Recursion\",        0, \"\"),\n    (\"inner_recursion_proof_time_ms\",       \"Inner Recursion\",       0, \"\"),\n    (\"compression_proof_time_ms\",           \"Compression\",           0, \"\"),\n    (\"total_proof_time_ms\",                 \"Total\",                 0, \"\"),\n]\n\nCELL_DISTRIBUTION: list[BasicRow] = [\n    (\"powdr_ratio\",               \"Powdr\",              fmt_pct),\n    (\"normal_instruction_ratio\",  \"Normal Instructions\", fmt_pct),\n    (\"openvm_precompile_ratio\",   \"OpenVM Precompiles\",  fmt_pct),\n]\n\n\ndef print_section(\n    title: str, rows: list[Row], m: Metrics, *, pct_of_key: str | None = None\n) -> None:\n    print(f\"\\n  {title}\")\n    print(f\"  {'─' * 58}\")\n    width = max(len(r[1]) for r in rows)\n    total = m.get(pct_of_key, 0) if pct_of_key else 0\n\n    for row in rows:\n        key, label = row[0], row[1]\n        val: float | None = m.get(key)\n\n        if key == \"total_proof_time_ms\":\n            print(f\"  {'─' * 58}\")\n\n        if val is None:\n            print(f\"  {label:<{width}}  N/A\")\n            continue\n\n        # Determine formatter and flags\n        if len(row) == 3:\n            fmt: Formatter = row[2]  # type: ignore[assignment]\n            flags = \"\"\n        else:\n            fmt = fmt_ms\n            flags: str = row[3]  # type: ignore[no-redef]\n\n        suffix = \" (residual)\" if \"r\" in flags else \"\"\n\n        pct = f\"  ({val / total * 100:5.1f}%)\" if total > 0 else \"\"\n        print(f\"  {label:<{width}}  {fmt(val)}{pct}{suffix}\")\n\n\n# ============================================================\n# Data loading (IO)\n# ============================================================\n\ndef load_data(source: str) -> tuple[dict[str, Any], str]:\n    \"\"\"Load JSON from a file path or URL. Returns (data, source_label).\"\"\"\n    if source.startswith(\"http://\") or source.startswith(\"https://\"):\n        url = re.sub(r\"github\\.com/(.+)/blob/\", r\"raw.githubusercontent.com/\\1/\", source)\n        with urllib.request.urlopen(url) as resp:\n            return json.loads(resp.read()), url.split(\"/\")[-1]\n    else:\n        with open(source) as f:\n            return json.load(f), source.split(\"/\")[-1]\n\n\ndef resolve_experiments(\n    data: dict[str, Any], source_label: str, experiment: str | None\n) -> dict[str, MetricsJson]:\n    \"\"\"Normalize raw/combined input and select experiment(s). Returns dict of {name: json}.\"\"\"\n    if \"counter\" in data and \"gauge\" in data:\n        name = experiment or source_label.replace(\".json\", \"\")\n        return {name: data}\n\n    if experiment:\n        if experiment not in data:\n            sys.exit(f\"Error: '{experiment}' not found. Available: {', '.join(sorted(data))}\")\n        return {experiment: data[experiment]}\n\n    if len(data) == 1:\n        return data\n\n    print(f\"Combined file with {len(data)} experiments:\")\n    for name in sorted(data):\n        print(f\"  - {name}\")\n    print(f\"\\nUsage: {sys.argv[0]} {sys.argv[1]} <experiment_name>\")\n    sys.exit(0)\n\n\n# ============================================================\n# Main\n# ============================================================\n\ndef main() -> None:\n    if len(sys.argv) < 2:\n        print(__doc__.strip())\n        sys.exit(1)\n\n    data, source_label = load_data(sys.argv[1])\n    experiment = sys.argv[2] if len(sys.argv) > 2 else None\n    runs = resolve_experiments(data, source_label, experiment)\n\n    for run_name, metrics_json in runs.items():\n        version = detect_version(metrics_json)\n        m = extract_metrics(run_name, metrics_json)\n\n        print(f\"\\nExperiment: {run_name}  (OpenVM {version})\")\n\n        basic = BASIC_STATS_V2 if version == 2 else BASIC_STATS_V1\n        proof = PROOF_TIME_V2 if version == 2 else PROOF_TIME_V1\n\n        print_section(\"App Proof Basic Stats\", basic, m)\n        print_section(\"Proof Time\", proof, m, pct_of_key=\"total_proof_time_ms\")\n        print_section(\"Trace Cell Distribution\", CELL_DISTRIBUTION, m)\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":387,"startLine":1,"totalLines":387}}}
