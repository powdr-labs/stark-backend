{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018qjF6SryQ5GDAoNf4PTKdn","type":"tool_result","content":"0\tuse std::{array::from_fn, cmp::max, ffi::c_void, iter::zip, mem, sync::Arc};\n1\t\n2\tuse itertools::{zip_eq, Itertools};\n3\tuse openvm_cuda_common::{\n4\t    copy::{cuda_memcpy, MemCopyD2H, MemCopyH2D},\n5\t    d_buffer::DeviceBuffer,\n6\t    memory_manager::MemTracker,\n7\t};\n8\tuse openvm_stark_backend::{\n9\t    dft::Radix2BowersSerial,\n10\t    p3_matrix::dense::RowMajorMatrix,\n11\t    poly_common::{\n12\t        eq_uni_poly, eval_eq_mle, eval_eq_uni, eval_eq_uni_at_one, eval_in_uni, Squarable,\n13\t        UnivariatePoly,\n14\t    },\n15\t    proof::StackingProof,\n16\t    prover::{\n17\t        stacked_pcs::StackedLayout, sumcheck::sumcheck_round0_deg, DeviceMultiStarkProvingKey,\n18\t        MatrixDimensions, ProvingContext,\n19\t    },\n20\t};\n21\tuse p3_dft::TwoAdicSubgroupDft;\n22\tuse p3_field::{PrimeCharacteristicRing, TwoAdicField};\n23\tuse tracing::{debug, info_span, instrument};\n24\t\n25\tuse crate::{\n26\t    base::DeviceMatrix,\n27\t    cuda::{\n28\t        batch_ntt_small::ensure_device_ntt_twiddles_initialized,\n29\t        poly::vector_scalar_multiply_ext,\n30\t        stacked_reduction::{\n31\t            _stacked_reduction_r0_required_temp_buffer_size, initialize_k_rot_from_eq_segments,\n32\t            stacked_reduction_fold_ple, stacked_reduction_sumcheck_mle_round,\n33\t            stacked_reduction_sumcheck_mle_round_degenerate, stacked_reduction_sumcheck_round0,\n34\t            NUM_G,\n35\t        },\n36\t        sumcheck::{fold_mle, triangular_fold_mle},\n37\t    },\n38\t    gpu_backend::GenericGpuBackend,\n39\t    hash_scheme::GpuHashScheme,\n40\t    poly::EqEvalSegments,\n41\t    prelude::{Digest, D_EF, EF, F},\n42\t    sponge::GpuFiatShamirTranscript,\n43\t    stacked_pcs::StackedPcsDataGpu,\n44\t    utils::{compute_barycentric_inv_lagrange_denoms, reduce_raw_u64_to_ef},\n45\t    GpuDevice, StackedReductionError,\n46\t};\n47\t\n48\t/// Degree of the sumcheck polynomial for stacked reduction.\n49\tpub const STACKED_REDUCTION_S_DEG: usize = 2;\n50\t\n51\tpub struct StackedReductionGpu<D = Digest> {\n52\t    sm_count: u32,\n53\t\n54\t    l_skip: usize,\n55\t    n_stack: usize,\n56\t\n57\t    omega_skip: F,\n58\t    omega_skip_pows: Vec<F>,\n59\t    d_omega_skip_pows: DeviceBuffer<F>,\n60\t\n61\t    r_0: EF,\n62\t    d_lambda_pows: DeviceBuffer<EF>,\n63\t    eq_const: EF,\n64\t\n65\t    pub(crate) stacked_per_commit: Vec<StackedPcsData2<D>>,\n66\t    d_q_widths: DeviceBuffer<u32>,\n67\t    q_width_max: u32,\n68\t    d_q_eval_ptrs: DeviceBuffer<*const EF>,\n69\t\n70\t    trace_ptrs: Vec<(\n71\t        *const F, /* trace_ptr */\n72\t        usize,    /* height */\n73\t        usize,    /* width */\n74\t    )>,\n75\t    unstacked_cols: Vec<UnstackedSlice>,\n76\t    d_unstacked_cols: DeviceBuffer<UnstackedSlice>,\n77\t    // boundary indices where heights change. all columns between two boundaries must have the same\n78\t    // height. We can have multiple chunks of the same height if that is needed to reduce peak GPU\n79\t    // memory.\n80\t    ht_diff_idxs: Vec<usize>,\n81\t    n_max: usize,\n82\t\n83\t    // Initially holds eq(r[1..=n], H_n) for n=0..=n_max but gets updated after each sumcheck round\n84\t    // by some custom folding\n85\t    eq_r_ns: EqEvalSegments<EF>,\n86\t\n87\t    // == After round 0 ==\n88\t    q_evals: Vec<DeviceBuffer<EF>>, // get width from stacked_per_commit\n89\t    // Stores folded eq values that won't change anymore (no more folding)\n90\t    // Corresponds to log_height in 0..l_skip+round-1 _before_ round `round`. Gets updated with one\n91\t    // new element after each round.\n92\t    eq_stable: Vec<EF>,\n93\t    k_rot_stable: Vec<EF>,\n94\t\n95\t    /// Stores the folded k_rot evaluations for `\\kappa_\\rot(x, r) = eq_n(rot^{-1}(x), r)` for each\n96\t    /// `n` after each round. We use the [EqEvalSegments] type to guard the segment-based\n97\t    /// memory layout.\n98\t    k_rot_ns: EqEvalSegments<EF>,\n99\t    /// Stores eq(u[1+n_T..round-1], b_{T,j}[..round-n_T-1])\n100\t    eq_ub_per_trace: Vec<EF>,\n101\t    d_eq_ub: DeviceBuffer<EF>,\n102\t\n103\t    d_block_sums: DeviceBuffer<EF>,\n104\t    d_accum: DeviceBuffer<u64>,\n105\t    d_input_ptrs: DeviceBuffer<*const EF>,\n106\t    d_output_ptrs: DeviceBuffer<*mut EF>,\n107\t\n108\t    mem: MemTracker,\n109\t}\n110\t\n111\t/// A struct for holding stacked pcs data. We only need the `MerkleTreeGpu` from `StackedPcsDataGpu`\n112\t/// but we wrap the latter in an `Arc` to provide uniformity in dealing with common main and\n113\t/// preprocessed/cached traces. This struct stores the unstacked `traces`, in prismalinear\n114\t/// evaluation form, corresponding to the stacked pcs data.\n115\t///\n116\t/// Generic over the Merkle digest type `D`.  The default `D = Digest` preserves the existing\n117\t/// BabyBear-Poseidon2 behaviour.\n118\tpub struct StackedPcsData2<D = Digest> {\n119\t    pub(crate) inner: Arc<StackedPcsDataGpu<F, D>>,\n120\t    /// The unstacked traces corresponding to `inner`'s commitment.\n121\t    pub(crate) traces: Vec<DeviceMatrix<F>>,\n122\t}\n123\t\n124\timpl<D> StackedPcsData2<D> {\n125\t    /// # Safety\n126\t    /// `traces` must be the traces that were committed to in `pcs_data`.\n127\t    pub unsafe fn from_raw(\n128\t        pcs_data: Arc<StackedPcsDataGpu<F, D>>,\n129\t        traces: Vec<DeviceMatrix<F>>,\n130\t    ) -> Self {\n131\t        Self {\n132\t            inner: pcs_data,\n133\t            traces,\n134\t        }\n135\t    }\n136\t\n137\t    pub fn layout(&self) -> &StackedLayout {\n138\t        &self.inner.layout\n139\t    }\n140\t}\n141\t\n142\t/// Pointer with length to location in a big device buffer. The device buffer is identified by\n143\t/// `commit_idx`. Due to pecuarlities with `l_skip`, the length of the slice is defined as\n144\t/// `max(2^log_height, 2^l_skip)`. In other words, this is a pointer to the slice\n145\t/// `q[commit_idx].column(stacked_col_idx)[stacked_row_idx..stacked_row_idx + len]`.\n146\t///\n147\t/// # Safety\n148\t/// - this type is `repr(C)` as it will cross FFI boundaries for CUDA usage.\n149\t#[repr(C)]\n150\t#[derive(Clone, Copy, Debug)]\n151\tpub(crate) struct UnstackedSlice {\n152\t    commit_idx: u32,\n153\t    log_height: u32,\n154\t    stacked_row_idx: u32,\n155\t    stacked_col_idx: u32,\n156\t}\n157\t\n158\timpl<D> StackedReductionGpu<D> {\n159\t    fn log_stacked_height(&self, round: usize) -> usize {\n160\t        self.n_stack - (round - 1)\n161\t    }\n162\t\n163\t    fn stacked_height(&self, round: usize) -> usize {\n164\t        1 << self.log_stacked_height(round)\n165\t    }\n166\t\n167\t    /// Current maximum `n` supported by eq_r_ns\n168\t    fn cur_max_n(&self, round: usize) -> usize {\n169\t        self.n_max - (round - 1)\n170\t    }\n171\t}\n172\t\n173\t/// Batch sumcheck to reduce trace openings, including rotations, to stacked matrix opening.\n174\t///\n175\t/// The `stacked_matrix, stacked_layout` should be the result of stacking the `traces` with\n176\t/// parameters `l_skip` and `n_stack`.\n177\t#[allow(clippy::type_complexity)]\n178\t#[instrument(\n179\t    name = \"prover.openings.stacked_reduction\",\n180\t    level = \"info\",\n181\t    skip_all,\n182\t    fields(phase = \"prover\")\n183\t)]\n184\tpub fn prove_stacked_opening_reduction_gpu<HS, TS>(\n185\t    device: &GpuDevice,\n186\t    transcript: &mut TS,\n187\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n188\t    ctx: ProvingContext<GenericGpuBackend<HS>>,\n189\t    common_main_pcs_data: StackedPcsDataGpu<F, HS::Digest>,\n190\t    r: &[EF],\n191\t) -> Result<\n192\t    (\n193\t        StackingProof<HS::SC>,\n194\t        Vec<EF>,\n195\t        Vec<StackedPcsData2<HS::Digest>>,\n196\t    ),\n197\t    StackedReductionError,\n198\t>\n199\twhere\n200\t    HS: GpuHashScheme,\n201\t    TS: GpuFiatShamirTranscript<HS::SC>,\n202\t{\n203\t    let n_stack = device.config.n_stack;\n204\t    // Batching randomness\n205\t    let lambda = transcript.sample_ext();\n206\t\n207\t    let _round0_span =\n208\t        info_span!(\"prover.openings.stacked_reduction.round0\", phase = \"prover\").entered();\n209\t    let mut prover = StackedReductionGpu::new::<HS>(\n210\t        mpk,\n211\t        ctx,\n212\t        common_main_pcs_data,\n213\t        r,\n214\t        lambda,\n215\t        device.sm_count(),\n216\t    )?;\n217\t\n218\t    // Round 0: univariate sumcheck\n219\t    let s_0 = prover.batch_sumcheck_uni_round0_poly()?;\n220\t    for &coeff in s_0.coeffs() {\n221\t        transcript.observe_ext(coeff);\n222\t    }\n223\t\n224\t    let mut u_vec = Vec::with_capacity(n_stack + 1);\n225\t    let u_0 = transcript.sample_ext();\n226\t    u_vec.push(u_0);\n227\t    debug!(round = 0, u_round = %u_0);\n228\t\n229\t    prover.fold_ple_evals(u_0)?;\n230\t    drop(_round0_span);\n231\t    // end round 0\n232\t\n233\t    let mut sumcheck_round_polys = Vec::with_capacity(n_stack);\n234\t\n235\t    // Rounds 1..=n_stack: MLE sumcheck\n236\t    let _mle_rounds_span = info_span!(\n237\t        \"prover.openings.stacked_reduction.mle_rounds\",\n238\t        phase = \"prover\"\n239\t    )\n240\t    .entered();\n241\t    #[allow(clippy::needless_range_loop)]\n242\t    for round in 1..=n_stack {\n243\t        let batch_s_evals = prover.batch_sumcheck_poly_eval(round, u_vec[round - 1])?;\n244\t\n245\t        for &eval in &batch_s_evals {\n246\t            transcript.observe_ext(eval);\n247\t        }\n248\t        sumcheck_round_polys.push(batch_s_evals);\n249\t\n250\t        let u_round = transcript.sample_ext();\n251\t        u_vec.push(u_round);\n252\t        debug!(%round, %u_round);\n253\t\n254\t        prover.fold_mle_evals(round, u_round)?;\n255\t    }\n256\t    let stacking_openings = prover.get_stacked_openings()?;\n257\t    for claims_for_com in &stacking_openings {\n258\t        for &claim in claims_for_com {\n259\t            transcript.observe_ext(claim);\n260\t        }\n261\t    }\n262\t    drop(_mle_rounds_span);\n263\t    let proof = StackingProof {\n264\t        univariate_round_coeffs: s_0.into_coeffs(),\n265\t        sumcheck_round_polys,\n266\t        stacking_openings,\n267\t    };\n268\t    Ok((proof, u_vec, prover.stacked_per_commit))\n269\t}\n270\t\n271\timpl<D: Copy + Clone + Send + Sync + 'static> StackedReductionGpu<D> {\n272\t    #[instrument(\"stacked_reduction_new\", level = \"debug\", skip_all)]\n273\t    fn new<HS: GpuHashScheme<Digest = D>>(\n274\t        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n275\t        ctx: ProvingContext<GenericGpuBackend<HS>>,\n276\t        common_main_pcs_data: StackedPcsDataGpu<F, D>,\n277\t        r: &[EF],\n278\t        lambda: EF,\n279\t        sm_count: u32,\n280\t    ) -> Result<Self, StackedReductionError> {\n281\t        ensure_device_ntt_twiddles_initialized();\n282\t        let mem = MemTracker::start(\"prover.stacked_reduction_new\");\n283\t        let l_skip = mpk.params.l_skip;\n284\t        let n_stack = mpk.params.n_stack;\n285\t\n286\t        let omega_skip = F::two_adic_generator(l_skip);\n287\t        let omega_skip_pows = omega_skip.powers().take(1 << l_skip).collect_vec();\n288\t        let d_omega_skip_pows = omega_skip_pows.to_device()?;\n289\t\n290\t        // NOTE: DeviceMatrix contains an Arc, so clone is lightweight [for now].\n291\t        // PERF[jpw]: stack the traces all at once. To save memory, we could either stack and drop\n292\t        // traces as we go or even at commit time only store the stacked matrix and drop the traces\n293\t        // much earlier.\n294\t        let common_main_traces = ctx\n295\t            .per_trace\n296\t            .iter()\n297\t            .map(|(_, air_ctx)| air_ctx.common_main.clone())\n298\t            .collect_vec();\n299\t        // SAFETY: common_main_traces commits to common_main_pcs_data"}]},"parent_tool_use_id":"toolu_014eFaCET9Z7mMapZ