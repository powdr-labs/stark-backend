{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017xBTxjMg27xkmw16rn6Fq4","type":"tool_result","content":"1\t#include \"codec.cuh\"\n2\t#include \"dag_entry.cuh\"\n3\t#include \"eval_config.cuh\"\n4\t#include \"fp.h\"\n5\t#include \"fpext.h\"\n6\t#include \"frac_ext.cuh\"\n7\t#include \"launcher.cuh\"\n8\t#include \"sumcheck.cuh\"\n9\t#include \"utils.cuh\"\n10\t#include <algorithm>\n11\t#include <cmath>\n12\t#include <cstddef>\n13\t#include <cstdint>\n14\t#include <utility>\n15\t#include <vector_types.h>\n16\t\n17\tusing namespace symbolic_dag;\n18\t\n19\tnamespace logup_round0 {\n20\t\n21\t// NOTE[jpw]: keeping separate from zerocheck so it can be tuned separately\n22\tconstexpr uint32_t BUFFER_THRESHOLD = 16;\n23\t// Threshold for switching between coset-parallel and lockstep modes.\n24\t// When num_x * skip_domain < threshold, use coset-parallel (grid.y = num_cosets) for better GPU utilization.\n25\t// When >= threshold, use lockstep (single thread handles all cosets) to avoid redundant iNTT.\n26\tconstexpr uint32_t COSET_PARALLEL_THRESHOLD = 32768; // 2^15\n27\t\n28\t// Device function to evaluate interactions for all cosets in lockstep with DAG traversal.\n29\t// Computes numerator and denominator sums for each coset.\n30\t// NOTE: Using __inline__ instead of __forceinline__ to let compiler decide based on register pressure.\n31\t//\n32\t// Template params:\n33\t// - FIRST_COSET_IS_IDENTITY: compile-time flag for lockstep kernel when coset 0 has shift=1\n34\t// Runtime params:\n35\t// - skip_ntt: runtime flag for coset-parallel kernel when processing identity coset\n36\ttemplate <uint32_t NUM_COSETS, bool NEEDS_SHMEM, bool FIRST_COSET_IS_IDENTITY = false>\n37\t__device__ __inline__ void acc_interactions(\n38\t    const NttEvalContext<NUM_COSETS> &eval_ctx,\n39\t    const Fp *is_first, // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n40\t    const Fp *is_last,  // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n41\t    uint32_t x_int,\n42\t    const FpExt *__restrict__ numer_weights,\n43\t    const FpExt *__restrict__ denom_weights,\n44\t    const Rule *__restrict__ d_rules,\n45\t    size_t rules_len,\n46\t    FpExt *__restrict__ numer_sums, // output [NUM_COSETS]\n47\t    FpExt *__restrict__ denom_sums, // output [NUM_COSETS]\n48\t    bool skip_ntt = false           // Runtime flag for identity coset\n49\t) {\n50\t    // Initialize sums to zero\n51\t#pragma unroll\n52\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n53\t        numer_sums[c] = FpExt(Fp::zero());\n54\t        denom_sums[c] = FpExt(Fp::zero());\n55\t    }\n56\t\n57\t    for (size_t node = 0; node < rules_len; ++node) {\n58\t        Rule rule = d_rules[node];\n59\t        // Lazy decoding: only decode header (op, flags, x) upfront\n60\t        RuleHeader header = decode_rule_header(rule);\n61\t\n62\t        // Evaluate x operand for all cosets\n63\t        Fp x_vals[NUM_COSETS];\n64\t        ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n65\t            x_vals, header.x, eval_ctx, is_first, is_last, x_int, skip_ntt\n66\t        );\n67\t\n68\t        Fp results[NUM_COSETS];\n69\t\n70\t        switch (header.op) {\n71\t        case OP_ADD: {\n72\t            // Decode y only for binary ops\n73\t            SourceInfo y_src = decode_y(rule);\n74\t            Fp y_vals[NUM_COSETS];\n75\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n76\t                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n77\t            );\n78\t#pragma unroll\n79\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n80\t                results[c] = x_vals[c] + y_vals[c];\n81\t            }\n82\t            break;\n83\t        }\n84\t        case OP_SUB: {\n85\t            SourceInfo y_src = decode_y(rule);\n86\t            Fp y_vals[NUM_COSETS];\n87\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n88\t                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n89\t            );\n90\t#pragma unroll\n91\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n92\t                results[c] = x_vals[c] - y_vals[c];\n93\t            }\n94\t            break;\n95\t        }\n96\t        case OP_MUL: {\n97\t            SourceInfo y_src = decode_y(rule);\n98\t            Fp y_vals[NUM_COSETS];\n99\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n100\t                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n101\t            );\n102\t#pragma unroll\n103\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n104\t                results[c] = x_vals[c] * y_vals[c];\n105\t            }\n106\t            break;\n107\t        }\n108\t        case OP_NEG:\n109\t#pragma unroll\n110\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n111\t                results[c] = -x_vals[c];\n112\t            }\n113\t            break;\n114\t        case OP_VAR:\n115\t#pragma unroll\n116\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n117\t                results[c] = x_vals[c];\n118\t            }\n119\t            break;\n120\t        case OP_INV:\n121\t#pragma unroll\n122\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n123\t                results[c] = inv(x_vals[c]);\n124\t            }\n125\t            break;\n126\t        }\n127\t\n128\t        // Store intermediate results for all cosets\n129\t        // Decode z_index only when buffering\n130\t        if (header.buffer_result && eval_ctx.buffer_size > 0) {\n131\t            uint32_t z_index = decode_z_index(rule);\n132\t#ifdef CUDA_DEBUG\n133\t            assert(z_index < eval_ctx.buffer_size);\n134\t#endif\n135\t            // Intermediate buffer layout: [buffer_size][NUM_COSETS] per thread\n136\t#pragma unroll\n137\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n138\t                eval_ctx.inter_buffer[z_index * eval_ctx.buffer_stride + c] = results[c];\n139\t            }\n140\t        }\n141\t\n142\t        // Accumulate interaction sums\n143\t        if (header.is_constraint) {\n144\t            FpExt numer_w = numer_weights[node];\n145\t            FpExt denom_w = denom_weights[node];\n146\t#pragma unroll\n147\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n148\t                numer_sums[c] += numer_w * results[c];\n149\t                denom_sums[c] += denom_w * results[c];\n150\t            }\n151\t        }\n152\t    }\n153\t}\n154\t\n155\t// ============================================================================\n156\t// KERNELS\n157\t// ============================================================================\n158\t\n159\t// Round0 phase interactions kernel - each thread handles ALL cosets in lockstep\n160\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n161\t__global__ void logup_r0_ntt_eval_interactions_kernel(\n162\t    FracExt *__restrict__ tmp_sums_buffer, // [NUM_COSETS][gridDim.x][skip_domain]\n163\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n164\t    const Fp *__restrict__ preprocessed,\n165\t    const Fp *const *__restrict__ main_parts,\n166\t    const FpExt *__restrict__ eq_cube, // [num_x]\n167\t    const Fp *__restrict__ public_values,\n168\t    const FpExt *__restrict__ numer_weights,\n169\t    const FpExt *__restrict__ denom_weights,\n170\t    FpExt denom_sum_init,\n171\t    const Rule *__restrict__ d_rules,\n172\t    size_t rules_len,\n173\t    uint32_t buffer_size,\n174\t    Fp *__restrict__ d_intermediates,\n175\t    uint32_t skip_domain,\n176\t    uint32_t num_x,\n177\t    uint32_t height,\n178\t    Fp g_shift\n179\t) {\n180\t    extern __shared__ char smem[];\n181\t    // Shared memory layout:\n182\t    // - FracExt[blockDim.x]: shared_sum for reduction (reused per coset)\n183\t    // - Fp[blockDim.x]: ntt_buffers (one skip_domain-sized buffer per x_int group, only when NEEDS_SHMEM)\n184\t    FracExt *shared_sum = reinterpret_cast<FracExt *>(smem);\n185\t    Fp *ntt_buffers_base =\n186\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FracExt)) : nullptr;\n187\t\n188\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n189\t\n190\t    // Each x_int group within the block gets its own ntt_buffer slice\n191\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n192\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n193\t\n194\t    // Thread layout: ntt_idx varies fastest, then x_int\n195\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n196\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n197\t    uint32_t const x_int_base = tidx >> l_skip;\n198\t\n199\t    // Precompute values needed for all cosets\n200\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n201\t    Fp const omega_skip = TWO_ADIC_GENERATORS[l_skip];\n202\t\n203\t    // Compute is_first_mult, is_last_mult for all cosets\n204\t    uint32_t const log_height_total = __ffs(height) - 1;\n205\t    uint32_t const log_segment = min(l_skip, log_height_total);\n206\t    uint32_t const segment_size = 1u << log_segment;\n207\t    uint32_t const log_stride = l_skip - log_segment;\n208\t\n209\t    Fp is_first_mult[NUM_COSETS];\n210\t    Fp is_last_mult[NUM_COSETS];\n211\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n212\t    Fp const omega_skip_ntt = pow(omega_skip, ntt_idx);\n213\t\n214\t    // Cosets c=0..NUM_COSETS-1 with shifts 1,g^1, g^2, ...\n215\t    Fp g_coset = Fp::one();\n216\t#pragma unroll\n217\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n218\t        Fp eval_point = g_coset * omega_skip_ntt;\n219\t        Fp omega = exp_power_of_2(eval_point, log_stride);\n220\t        is_first_mult[c] = avg_gp(omega, segment_size);\n221\t        is_last_mult[c] = avg_gp(omega * eta, segment_size);\n222\t        g_coset *= g_shift; // g^(c+1) for next iteration\n223\t    }\n224\t\n225\t    // Intermediate buffer setup\n226\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD * NUM_COSETS];\n227\t    Fp *inter_buffer;\n228\t    uint32_t buffer_stride;\n229\t    if constexpr (GLOBAL) {\n230\t        // Layout: [buffer_size][num_threads][NUM_COSETS]\n231\t        inter_buffer = d_intermediates + tidx * NUM_COSETS;\n232\t        buffer_stride = gridDim.x * blockDim.x * NUM_COSETS;\n233\t    } else {\n234\t        inter_buffer = local_buffer;\n235\t        buffer_stride = NUM_COSETS;\n236\t    }\n237\t\n238\t    // Accumulate sums for all cosets\n239\t    FracExt sums[NUM_COSETS];\n240\t#pragma unroll\n241\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n242\t        sums[c] = {FpExt(Fp::zero()), FpExt(Fp::zero())};\n243\t    }\n244\t\n245\t    // blockDim.x is guaranteed to be a multiple of 2^l_skip\n246\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n247\t\n248\t    // Initialize eval_ctx once with loop-invariant fields\n249\t    NttEvalContext<NUM_COSETS> eval_ctx{\n250\t        preprocessed,\n251\t        main_parts,\n252\t        public_values,\n253\t        inter_buffer,\n254\t        ntt_buffer,\n255\t        {}, // omega_shifts - set once below\n256\t        skip_domain,\n257\t        height,\n258\t        buffer_stride,\n259\t        buffer_size,\n260\t        ntt_idx,\n261\t    };\n262\t    // Compute omega_shifts: coset 0 has identity shift, rest use g^c\n263\t    eval_ctx.omega_shifts[0] = Fp::one(); // Identity coset\n264\t    g_coset = g_shift;                    // g^1\n265\t#pragma unroll\n266\t    for (uint32_t c = 1; c < NUM_COSETS; c++) {\n267\t        eval_ctx.omega_shifts[c] = pow(g_coset, ntt_idx_rev);\n268\t        g_coset *= g_shift;\n269\t    }\n270\t\n271\t    // Tile across x_int\n272\t    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n273\t        // Compute per-iteration selectors as fresh local values\n274\t        Fp is_first[NUM_COSETS];\n275\t        Fp is_last[NUM_COSETS];\n276\t#pragma unroll\n277\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n278\t            is_first[c] = is_first_mult[c] * selectors_cube[x_int];\n279\t            is_last[c] = is_last_mult[c] * selectors_cube[2 * num_x + x_int];\n280\t        }\n281\t\n282\t        FpExt numer_results[NUM_COSETS];\n283\t        FpExt denom_results[NUM_COSETS];\n284\t        acc_interactions<NUM_COSETS, NEEDS_SHMEM, /*FIRST_COSET_IS_IDENTITY=*/true>(\n285\t            eval_ctx, is_first, is_last, x_int,\n286\t            numer_weights, denom_weights, d_rules, rules_len, numer_results, denom_results\n287\t        );\n288\t\n289\t        FpExt eq = eq_cube[x_int];\n290\t#pragma unroll\n291\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n292\t            sums[c].p += eq * numer_results[c];\n293\t            sums[c].q += eq * (denom_results[c] + denom_sum_init);\n294\t        }\n295\t    }\n296\t\n297\t    // Reduction: one coset at a time to minimize shared memory\n298\t#pragma unroll\n299\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n300\t        shared_sum[threadIdx.x] = sums[c];\n301\t        __syncthreads();\n302\t\n303\t        if (threadIdx.x < skip_domain) {\n304\t            FracExt tile_sum = shared_sum[threadIdx.x];\n305\t            for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n306\t                auto lane_offset = (lane << l_skip) + threadIdx.x;\n307\t                tile_sum.p += shared_sum[lane_offset].p;\n308\t                tile_sum.q += shared_sum[lane_offset].q;\n309\t            }\n310\t            // Output layout: [num_blocks][NUM_COSETS * skip_domain]\n311\t            // This matches final_reduce_block_sums expected [num_blocks][d] layout\n312\t            tmp_sums_buffer[blockIdx.x * NUM_COSETS * skip_domain + c * skip_domain + ntt_idx] =\n313\t                tile_sum;\n314\t        }\n315\t        __syncthreads();\n316\t    }\n317\t}\n318\t\n319\t// Coset-parallel kernel: grid.y = num_cosets, each block handles ONE coset.\n320\t// Uses acc_interactions<1, NEEDS_SHMEM> with explicit parameter passing.\n321\t// Use when num_x * skip_domain is small for better GPU utilization.\n322\ttemplate <bool GLOBAL, bool NEEDS_SHMEM>\n323\t__global__ void logup_r0_ntt_eval_interactions_coset_parallel_kernel(\n324\t    FracExt *__restrict__ tmp_sums_buffer, // [num_blocks][num_cosets * skip_domain]\n325\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n326\t    const Fp *__restrict__ preprocessed,\n327\t    const Fp *const *__restrict__ main_parts,\n328\t    const FpExt *__restrict__ eq_cube, // [num_x]\n329\t    const Fp *__restrict__ public_values,\n330\t    const FpExt *__restrict__ numer_weights,\n331\t    const FpExt *__restrict__ denom_weights,\n332\t    FpExt denom_sum_init,\n333\t    const Rule *__restrict__ d_rules,\n334\t    size_t rules_len,\n335\t    uint32_t buffer_size,\n336\t    Fp *__restrict__ d_intermediates,\n337\t    uint32_t skip_domain,\n338\t    uint32_t num_x,\n339\t    uint32_t height,\n340\t    Fp g_shift\n341\t) {\n342\t    extern __shared__ char smem[];\n343\t    FracExt *shared_sum = reinterpret_cast<FracExt *>(smem);\n344\t    Fp *ntt_buffers_base =\n345\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FracExt)) : nullptr;\n346\t\n347\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n348\t    uint32_t const num_cosets = gridDim.y;\n349\t\n350\t    // Each x_int group within the block gets its own ntt_buffer slice\n351\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n352\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n353\t\n354\t    // Thread layout: ntt_idx varies fastest, then x_int\n355\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n356\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n357\t    uint32_t const x_int_base = tidx >> l_skip;\n358\t\n359\t    // KEY DIFFERENCE: coset_idx from blockIdx.y\n360\t    uint32_t const coset_idx = blockIdx.y;\n361\t    bool const is_identity_coset = (coset_idx == 0);\n362\t\n363\t    // Precompute values for this single coset\n364\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n365\t    Fp const omega_skip = TWO_ADIC_GENERATORS[l_skip];\n366\t\n367\t    uint32_t const log_height_total = __ffs(height) - 1;\n368\t    uint32_t const log_segment = min(l_skip, log_height_total);\n369\t    uint32_t const segment_size = 1u << log_segment;\n370\t    uint32_t const log_stride = l_skip - log_segment;\n371\t\n372\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n373\t    Fp const omega_skip_ntt = pow(omega_skip, ntt_idx);\n374\t\n375\t    // Compute for single coset: coset 0 has shift=1, rest have shift=g^coset_idx\n376\t    Fp const g_coset = is_identity_coset ? Fp::one() : pow(g_shift, coset_idx);\n377\t    Fp const eval_point = is_identity_coset ? omega_skip_ntt : (g_coset * omega_skip_ntt);\n378\t    Fp const omega = exp_power_of_2(eval_point, log_stride);\n379\t    Fp const is_first_mult = avg_gp(omega, segment_size);\n380\t    Fp const is_last_mult = avg_gp(omega * eta, segment_size);\n381\t    Fp const omega_shift = is_identity_coset ? Fp::one() : pow(g_coset, ntt_idx_rev);\n382\t\n383\t    // Intermediate buffer setup (single coset, no NUM_COSETS multiplier)\n384\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD];\n385\t    Fp *inter_buffer;\n386\t    uint32_t buffer_stride;\n387\t    if constexpr (GLOBAL) {\n388\t        // Layout: [buffer_size][num_cosets * num_threads_per_coset]\n389\t        uint32_t global_tidx = coset_idx * gridDim.x * blockDim.x + tidx;\n390\t        inter_buffer = d_intermediates + global_tidx;\n391\t        buffer_stride = gridDim.x * gridDim.y * blockDim.x;\n392\t    } else {\n393\t        inter_buffer = local_buffer;\n394\t        buffer_stride = 1;\n395\t    }\n396\t\n397\t    FracExt sum = {FpExt(Fp::zero()), FpExt(Fp::zero())};\n398\t\n399\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n400\t\n401\t  