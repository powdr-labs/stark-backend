{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HbyL5Tcd3XiVyykriTvGZS","type":"tool_result","content":"306\t__global__ void stacked_reduction_sumcheck_mle_round_degenerate_kernel(\n307\t    const FpExt *__restrict__ const\n308\t        *__restrict__ q_evals, // pointers to matrices of same height, one per [commit_idx]\n309\t    const FpExt *__restrict__ eq_ub_ptr, // pointer to `eq_ub_per_trace` at window start\n310\t    FpExt eq_r,                          // pointer to EqEvalSegments\n311\t    FpExt k_rot_r,                       // pointer to `k_rot` segments\n312\t    const UnstackedSlice *__restrict__ unstacked_cols, // pointer to unstacked_cols at window start\n313\t    const FpExt *__restrict__ lambda_pows,             // pointer to lambda_pows at window start\n314\t    uint64_t *__restrict__ output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n315\t    uint32_t q_height,             // height of each matrix in q_evals\n316\t    uint32_t window_len,\n317\t    uint32_t shift_factor // = l_skip + round\n318\t) {\n319\t    extern __shared__ char smem[];\n320\t    FpExt *shared = (FpExt *)smem;\n321\t\n322\t    FpExt local_sums[S_DEG];\n323\t#pragma unroll\n324\t    for (int i = 0; i < S_DEG; i++) {\n325\t        local_sums[i] = FpExt(0);\n326\t    }\n327\t\n328\t    for (uint32_t window_idx = threadIdx.x; window_idx < window_len; window_idx += blockDim.x) {\n329\t        UnstackedSlice s = unstacked_cols[window_idx];\n330\t        const FpExt *__restrict__ q = q_evals[s.commit_idx];\n331\t\n332\t        auto col_idx = s.stacked_col_idx;\n333\t        auto row_idx = s.stacked_row_idx;\n334\t        auto row_start = (row_idx >> shift_factor) << 1;\n335\t        auto q_offset = col_idx * q_height + row_start;\n336\t\n337\t        auto q_0 = q[q_offset];\n338\t        auto q_1 = q[q_offset + 1];\n339\t        auto q_c1 = q_1 - q_0;\n340\t\n341\t        uint32_t b_bool = (row_idx >> (shift_factor - 1)) & 1;\n342\t        Fp b = Fp(b_bool);\n343\t\n344\t        auto eq_ub = eq_ub_ptr[window_idx];\n345\t\n346\t#pragma unroll\n347\t        for (int x_int = 1; x_int <= S_DEG; ++x_int) {\n348\t            Fp x = Fp(x_int);\n349\t            auto eq_ub_x = eq_ub * eq1(x, b);\n350\t            auto eq = eq_r * eq_ub_x;\n351\t            auto k_rot = k_rot_r * eq_ub_x;\n352\t\n353\t            auto q_x = q_0 + q_c1 * x;\n354\t\n355\t            local_sums[x_int - 1] +=\n356\t                (lambda_pows[2 * window_idx] * eq + lambda_pows[2 * window_idx + 1] * k_rot) * q_x;\n357\t        }\n358\t    }\n359\t\n360\t#pragma unroll\n361\t    for (int idx = 0; idx < S_DEG; idx++) {\n362\t        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n363\t        if (threadIdx.x == 0) {\n364\t            sumcheck::atomic_add_fpext_to_u64(output + idx * 4, reduced);\n365\t        }\n366\t        __syncthreads();\n367\t    }\n368\t}\n369\t\n370\t// ============================================================================\n371\t// LAUNCHERS\n372\t// ============================================================================\n373\t\n374\tinline std::pair<dim3, dim3> stacked_reduction_round0_launch_params(\n375\t    uint32_t trace_height,\n376\t    uint32_t trace_width,\n377\t    uint32_t l_skip\n378\t) {\n379\t    uint32_t skip_domain = 1u << l_skip;\n380\t    auto lifted_height = std::max(trace_height, skip_domain);\n381\t    // Entire skip domain must fit within a block\n382\t    auto max_threads = std::max(skip_domain, 256u);\n383\t    auto [grid, block] = kernel_launch_params(lifted_height, max_threads);\n384\t    // NOTE: lifted_height = skip_domain * num_x will always be divisible by block.x since num_x is a power of 2. Therefore all threads in a block will be active.\n385\t    grid.y = trace_width;\n386\t    return {grid, block};\n387\t}\n388\t\n389\t// (Not a launcher) Utility function to calculate required size of temp buffer.\n390\t// Required length of *block_sums in FpExt elements\n391\t// SP_DEG=1: outputs NUM_G=3 values per z (G0, G1, G2)\n392\textern \"C\" uint32_t _stacked_reduction_r0_required_temp_buffer_size(\n393\t    uint32_t trace_height,\n394\t    uint32_t trace_width,\n395\t    uint32_t l_skip\n396\t) {\n397\t    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n398\t    return ((grid.x * grid.y) << l_skip) * NUM_G;\n399\t}\n400\t\n401\t// SP_DEG=1: No z_packets needed, outputs G0, G1, G2 on identity coset only.\n402\t// Uses ADD_TO_OUTPUT=true to accumulate into output buffer (for bucket-based accumulation).\n403\textern \"C\" int _stacked_reduction_sumcheck_round0(\n404\t    const FpExt *eq_r_ns,\n405\t    const Fp *trace_ptr,\n406\t    const FpExt *lambda_pows,\n407\t    FpExt *block_sums,\n408\t    FpExt *output, // length should be NUM_G * skip_domain, ADD to existing values\n409\t    uint32_t trace_height,\n410\t    uint32_t trace_width,\n411\t    uint32_t l_skip,\n412\t    uint32_t num_x\n413\t) {\n414\t    uint32_t skip_domain = 1u << l_skip;\n415\t    uint32_t stride = std::max(skip_domain / trace_height, 1u);\n416\t    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n417\t\n418\t    // Use block.x + 1 stride for shared_sum to avoid bank conflicts\n419\t    // NUM_G=3 outputs per z (G0, G1, G2)\n420\t    size_t shmem_sum_size = sizeof(FpExt) * (block.x + 1) * NUM_G;\n421\t\n422\t    stacked_reduction_round0_block_sum_kernel<<<grid, block, shmem_sum_size>>>(\n423\t        eq_r_ns, trace_ptr, lambda_pows, block_sums,\n424\t        trace_height, trace_width, l_skip,\n425\t        skip_domain - 1, num_x, 31 - __builtin_clz(stride)"}]},"parent_tool_use_id":"toolu_014eFaCET9Z7mMapZg9wTXPh","session_id":"9fb0c9c1-c32f-45e4-afe7-f108d55d0327","uuid":"99ea3f4e-0626-4315-82fb-030db38c3de3","timestamp":"2026-04-12T19:21:54.250Z"}
