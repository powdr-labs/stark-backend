{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0186pdSztrEM5MLhUuAayZ88","type":"tool_result","content":"0\t#include \"device_ntt.cuh\"\n1\t#include \"fp.h\"\n2\t#include \"fpext.h\"\n3\t#include \"frac_ext.cuh\"\n4\t#include \"launcher.cuh\"\n5\t#include \"sumcheck.cuh\"\n6\t#include \"utils.cuh\"\n7\t#include <algorithm>\n8\t#include <cassert>\n9\t#include <cmath>\n10\t#include <cstddef>\n11\t#include <cstdint>\n12\t#include <cuda_runtime.h>\n13\t#include <utility>\n14\t#include <vector_types.h>\n15\t\n16\tusing namespace device_ntt;\n17\t\n18\tnamespace {\n19\t\n20\tconstexpr uint32_t MAX_GRID_DIM = 65535u;\n21\t// S_DEG=2 for MLE sumcheck rounds (kept for backward compatibility)\n22\tconstexpr int S_DEG = 2;\n23\t// Number of G outputs per z in round 0 (SP_DEG=1): G0, G1, G2\n24\tconstexpr int NUM_G = 3;\n25\t\n26\t} // namespace\n27\t\n28\tstruct UnstackedSlice {\n29\t    uint32_t commit_idx;\n30\t    uint32_t log_height;\n31\t    uint32_t stacked_row_idx;\n32\t    uint32_t stacked_col_idx;\n33\t};\n34\t\n35\tstruct UnstackedPleFoldPacket {\n36\t    const Fp *__restrict__ src;\n37\t    FpExt *__restrict__ dst;\n38\t    uint32_t height;\n39\t    uint32_t width;\n40\t};\n41\t\n42\t__device__ __forceinline__ FpExt get_eq_cube(const FpExt *eq_r_ns, uint32_t cube_size, uint32_t x) {\n43\t    return eq_r_ns[cube_size + x];\n44\t}\n45\t\n46\t__device__ __forceinline__ uint32_t rot_prev(uint32_t x_int, uint32_t cube_size) {\n47\t    return x_int == 0 ? cube_size - 1 : x_int - 1;\n48\t}\n49\t\n50\t__device__ __forceinline__ Fp eq1(Fp x, Fp y) { return Fp::one() - x - y + Fp(2) * x * y; }\n51\t\n52\t__device__ __forceinline__ Fp barycentric_interpolate_strided(\n53\t    const Fp *evals,\n54\t    uint32_t evals_len,\n55\t    uint32_t z,\n56\t    uint32_t expansion_factor,     // large_domain / skip_domain\n57\t    const Fp *inv_lagrange_denoms, // denoms specifically for z\n58\t    const Fp *omega_skip_pows,\n59\t    uint32_t skip_domain\n60\t) {\n61\t    Fp q = Fp::zero();\n62\t    uint32_t stride = evals_len >= skip_domain ? 1 : skip_domain / evals_len;\n63\t    if (z % expansion_factor == 0) {\n64\t        auto i = z / expansion_factor;\n65\t        if (i % stride == 0)\n66\t            q = evals[i / stride];\n67\t    } else {\n68\t        for (int idx = 0; idx < (skip_domain / stride); idx++) {\n69\t            q += evals[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n70\t        }\n71\t    }\n72\t    return q;\n73\t}\n74\t\n75\t// SP_DEG=1 kernel: compute 3 partial sums G0, G1, G2 on identity coset only.\n76\t// No iNTT/NTT operations - reconstruction happens on CPU via NTT-based polynomial multiplication.\n77\t//\n78\t// Each block covers a tile of z-values (threadIdx.x) and collaborates across threads\n79\t// to sum over x for a single column. Blocks stride over columns via gridDim.y.\n80\t//\n81\t// G0(Z) = Σ_{col,x} coeff_eq[col] * eq_cube(x) * q_{col,x}(Z)\n82\t// G1(Z) = Σ_{col,x} coeff_rot[col] * eq_cube(x) * q_{col,x}(Z)\n83\t// G2(Z) = Σ_{col,x} coeff_rot[col] * (eq_cube(rot_prev(x)) - eq_cube(x)) * q_{col,x}(Z)\n84\t//\n85\t// where coeff_eq[col] = lambda_pows[2*col], coeff_rot[col] = lambda_pows[2*col+1]\n86\t__global__ void stacked_reduction_round0_block_sum_kernel(\n87\t    const FpExt *__restrict__ eq_r_ns, // pointer to EqEvalSegments\n88\t    const Fp *__restrict__ trace_ptr,\n89\t    const FpExt *__restrict__ lambda_pows, // pointer to lambda_pows at window start\n90\t    FpExt *__restrict__ block_sums, // [gridDim.x * gridDim.y][NUM_G * skip_domain]\n91\t    uint32_t height,                // trace height\n92\t    uint32_t width,                 // trace width\n93\t    uint32_t l_skip,\n94\t    uint32_t skip_mask, // 2^l_skip - 1\n95\t    uint32_t num_x,     // 1 << n_lift\n96\t    uint32_t log_stride\n97\t) {\n98\t    extern __shared__ char smem[];\n99\t    // Use blockDim.x + 1 stride to avoid shared memory bank conflicts\n100\t    const uint32_t PADDED_X = blockDim.x + 1;\n101\t    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem); // FpExt[NUM_G][PADDED_X]\n102\t\n103\t    uint32_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n104\t    uint32_t z_idx = tidx & skip_mask;\n105\t    uint32_t x_int = tidx >> l_skip;\n106\t    uint32_t col_idx = blockIdx.y;\n107\t\n108\t    // Compute G weights (no z-dependent packets needed)\n109\t    FpExt eq_cube = get_eq_cube(eq_r_ns, num_x, x_int);\n110\t    FpExt eq_cube_rot_prev = get_eq_cube(eq_r_ns, num_x, rot_prev(x_int, num_x));\n111\t    FpExt k_rot_diff = eq_cube_rot_prev - eq_cube;\n112\t\n113\t    FpExt coeff_eq = lambda_pows[2 * col_idx];      // for G0\n114\t    FpExt coeff_rot = lambda_pows[2 * col_idx + 1]; // for G1, G2\n115\t\n116\t    FpExt w0 = coeff_eq * eq_cube;      // weight for G0\n117\t    FpExt w1 = coeff_rot * eq_cube;     // weight for G1\n118\t    FpExt w2 = coeff_rot * k_rot_diff;  // weight for G2\n119\t\n120\t    // Load trace value (identity coset only, no NTT needed)\n121\t    auto evals = trace_ptr + col_idx * height + (x_int << (l_skip - log_stride));\n122\t    auto stride_mask = (1u << log_stride) - 1;\n123\t    Fp q = (z_idx & stride_mask) == 0 ? evals[z_idx >> log_stride] : Fp::zero();\n124\t\n125\t    // Store 3 partial sums to shared memory\n126\t    shared_sum[0 * PADDED_X + threadIdx.x] = w0 * q;\n127\t    shared_sum[1 * PADDED_X + threadIdx.x] = w1 * q;\n128\t    shared_sum[2 * PADDED_X + threadIdx.x] = w2 * q;\n129\t\n130\t    __syncthreads();\n131\t\n132\t    // Reduction: only threads in first x-slice participate\n133\t    if ((threadIdx.x >> l_skip) == 0) {\n134\t        FpExt g0 = shared_sum[0 * PADDED_X + z_idx];\n135\t        FpExt g1 = shared_sum[1 * PADDED_X + z_idx];\n136\t        FpExt g2 = shared_sum[2 * PADDED_X + z_idx];\n137\t\n138\t        for (int lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n139\t            g0 += shared_sum[0 * PADDED_X + (lane << l_skip) + z_idx];\n140\t            g1 += shared_sum[1 * PADDED_X + (lane << l_skip) + z_idx];\n141\t            g2 += shared_sum[2 * PADDED_X + (lane << l_skip) + z_idx];\n142\t        }\n143\t\n144\t        // Output: 3 values per z_idx, stored contiguously\n145\t        uint32_t skip_domain = 1u << l_skip;\n146\t        FpExt *out_ptr =\n147\t            block_sums + (col_idx * gridDim.x + blockIdx.x) * (NUM_G * skip_domain);\n148\t        out_ptr[0 * skip_domain + z_idx] = g0;\n149\t        out_ptr[1 * skip_domain + z_idx] = g1;\n150\t        out_ptr[2 * skip_domain + z_idx] = g2;\n151\t    }\n152\t}\n153\t\n154\t// Single-trace kernel: each chunk of skip_domain threads handles one output cell\n155\t// Parallelizes barycentric interpolation across threads for better performance\n156\t// Grid: (num_row_blocks, trace_width) where blockIdx.y selects the column\n157\t__global__ void stacked_reduction_fold_ple_kernel(\n158\t    const Fp *__restrict__ src,\n159\t    FpExt *__restrict__ dst,\n160\t    const Fp *__restrict__ omega_skip_pows,\n161\t    const FpExt *__restrict__ inv_lagrange_denoms,\n162\t    uint32_t trace_height,\n163\t    uint32_t new_height,\n164\t    uint32_t skip_domain\n165\t) {\n166\t    extern __shared__ char smem_raw[];\n167\t    FpExt *smem = reinterpret_cast<FpExt *>(smem_raw);\n168\t\n169\t    uint32_t col_idx = blockIdx.y;\n170\t    uint32_t chunks_per_block = blockDim.x / skip_domain;\n171\t    uint32_t chunk_in_block = threadIdx.x / skip_domain;\n172\t    uint32_t tid_in_chunk = threadIdx.x % skip_domain;\n173\t    uint32_t row_idx = blockIdx.x * chunks_per_block + chunk_in_block;\n174\t\n175\t    // Cannot early-return: all threads must participate in chunk_reduce_sum (uses __syncthreads)\n176\t    bool const active_chunk = (row_idx < new_height);\n177\t\n178\t    // Barycentric interpolation: each thread handles exactly ONE term\n179\t    // (since src_len <= skip_domain, each thread contributes at most one term)\n180\t    FpExt local_val(Fp::zero());\n181\t    if (active_chunk) {\n182\t        uint32_t src_len = std::min(trace_height, skip_domain);\n183\t        uint32_t stride = skip_domain / src_len;\n184\t        const Fp *cell_src = src + col_idx * trace_height + row_idx * src_len;\n185\t\n186\t        if (tid_in_chunk < src_len) {\n187\t            uint32_t idx = tid_in_chunk;\n188\t            local_val =\n189\t                cell_src[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n190\t        }\n191\t    }\n192\t\n193\t    // Reduce within chunk using the helper from sumcheck.cuh\n194\t    // All threads must participate; inactive chunks contribute zero\n195\t    FpExt result =\n196\t        sumcheck::chunk_reduce_sum(local_val, smem, tid_in_chunk, skip_domain, chunk_in_block);\n197\t\n198\t    // No __syncthreads() needed: each chunk writes to a distinct dst location\n199\t    // and kernel exits immediately after this write"}]},"parent_tool_use_id":"toolu_014eFaCET9Z7mMapZg9wTXPh","session_id":"9fb0c9c1-c32f-45e4-afe7-f108d55d0327","uuid":"572bb94b-5b46-40b0-84b4-ff77bcaf106f","timestamp":"2026-04-12T19:21:51.014Z"}
