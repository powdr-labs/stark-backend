{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Syc54azr7z4kcqAJKkUScb","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    sync::Arc,\n15\t};\n16\t\n17\tuse itertools::{izip, Itertools};\n18\tuse openvm_cuda_common::{\n19\t    copy::{MemCopyD2H, MemCopyH2D},\n20\t    d_buffer::DeviceBuffer,\n21\t    error::MemCopyError,\n22\t    memory_manager::MemTracker,\n23\t};\n24\tuse openvm_stark_backend::{\n25\t    air_builders::symbolic::SymbolicConstraints,\n26\t    calculate_n_logup,\n27\t    dft::Radix2BowersSerial,\n28\t    p3_matrix::dense::RowMajorMatrix,\n29\t    poly_common::{\n30\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n31\t        UnivariatePoly,\n32\t    },\n33\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n34\t    prover::{\n35\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n36\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, DeviceMultiStarkProvingKey,\n37\t        MatrixDimensions, ProvingContext,\n38\t    },\n39\t};\n40\tuse p3_dft::TwoAdicSubgroupDft;\n41\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n42\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n43\tuse rustc_hash::FxHashMap;\n44\tuse tracing::{debug, info, info_span, instrument};\n45\t\n46\tuse crate::{\n47\t    base::DeviceMatrix,\n48\t    cuda::{\n49\t        logup_zerocheck::{fold_selectors_round0, interpolate_columns_gpu, MainMatrixPtrs},\n50\t        sumcheck::batch_fold_mle,\n51\t    },\n52\t    data_transporter::transport_matrix_d2h_col_major,\n53\t    error::LogupZerocheckError,\n54\t    gpu_backend::GenericGpuBackend,\n55\t    hash_scheme::GpuHashScheme,\n56\t    logup_zerocheck::{\n57\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n58\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n59\t    },\n60\t    poly::EqEvalLayers,\n61\t    prelude::{EF, F},\n62\t    sponge::GpuFiatShamirTranscript,\n63\t    utils::compute_barycentric_inv_lagrange_denoms,\n64\t};\n65\t\n66\tpub(crate) mod batch_mle;\n67\tpub(crate) mod batch_mle_monomial;\n68\tmod errors;\n69\tpub(crate) mod fold_ple;\n70\t/// Fraction sumcheck via GKR\n71\tmod fractional;\n72\t/// Logup interaction evaluations for GKR input\n73\tmod gkr_input;\n74\tmod mle_round;\n75\tmod round0;\n76\tpub(crate) mod rules;\n77\t\n78\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n79\tuse batch_mle_monomial::{\n80\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n81\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n82\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n83\t};\n84\tpub use errors::*;\n85\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n86\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n87\tuse round0::evaluate_round0_constraints_gpu;\n88\t\n89\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n90\t/// instead of the monomial kernel for high num_y traces.\n91\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n92\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n93\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n94\t\n95\t#[inline]\n96\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n97\t    if need_rot {\n98\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n99\t        (mat_width / 2) as u32\n100\t    } else {"}]},"parent_tool_use_id":"toolu_01BbLT2g17Xes2xU56PCCbAm","session_id":"9fb0c9c1-c32f-45e4-afe7-f108d55d0327","uuid":"eb37a753-163e-40af-a048-d1b26a8ab67c","timestamp":"2026-04-12T19:21:50.808Z"}
