pub struct LogupCtx {\n62\t    pub eval_ctx: EvalCoreCtx,\n63\t    pub d_intermediates: *mut EF,\n64\t    pub num_y: u32,\n65\t    pub d_eq_xi: *const EF,\n66\t    pub d_challenges: *const EF,\n67\t    pub d_eq_3bs: *const EF,\n68\t    pub d_rules: *const std::ffi::c_void,\n69\t    pub rules_len: usize,\n70\t    pub d_used_nodes: *const usize,\n71\t    pub d_pair_idxs: *const u32,\n72\t    pub used_nodes_len: usize,\n73\t    pub buffer_size: u32,\n74\t}\n75\t\n76\t/// Common per-AIR context for batched logup monomial evaluation.\n77\t#[repr(C)]\n78\t#[derive(Clone, Copy, Debug)]\n79\tpub struct LogupMonomialCommonCtx {\n80\t    pub eval_ctx: EvalCoreCtx,\n81\t    pub d_eq_xi: *const EF,\n82\t    pub bus_term_sum: EF, // Precomputed sum_i(beta[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n83\t    pub num_y: u32,\n84\t    pub mono_blocks: u32,\n85\t}\n86\t\n87\t/// Per-AIR context for batched logup monomial evaluation (numerator or denominator).\n88\t#[repr(C)]\n89\t#[derive(Clone, Copy, Debug)]\n90\tpub struct LogupMonomialCtx {\n91\t    pub d_headers: *const MonomialHeader,\n92\t    pub d_variables: *const PackedVar,\n93\t    pub d_combinations: *const EF,\n94\t    pub num_monomials: u32,\n95\t}\n96\t// end of types for batch MLE\n97\t\n98\textern \"C\" {\n99\t    // gkr.cu"}]},"parent_tool_use_id":"toolu_01HxSPkmcEs1rXrFnoZbrzGV","session_id":"9fb0c9c1-c32f-45e4-afe7-f108d55d0327","uuid":"9619a558-f3b0-49e1-8527-046dfd937767","timestamp":"2026-04-12T19:31:45.627Z"}
