{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bw8fRbJB3LyMz7dEcVDc2h","type":"tool_result","content":"0\tuse std::{ffi::c_void, fmt::Debug, ptr};\n1\t\n2\tuse crate::{\n3\t    copy::MemCopyD2H,\n4\t    error::{check, CudaError},\n5\t    memory_manager::{d_free, d_malloc},\n6\t    stream::{cudaStreamPerThread, cudaStream_t},\n7\t};\n8\t\n9\t#[link(name = \"cudart\")]\n10\textern \"C\" {\n11\t    pub fn cudaMemsetAsync(dst: *mut c_void, value: i32, count: usize, stream: cudaStream_t)\n12\t        -> i32;\n13\t}\n14\t\n15\t/// Struct that owns a buffer allocated on GPU device. The struct only holds the raw pointer and\n16\t/// length, but this struct has a `Drop` implementation which frees the associated device memory.\n17\t#[repr(C)]\n18\tpub struct DeviceBuffer<T> {\n19\t    ptr: *mut T,\n20\t    len: usize,\n21\t}\n22\t\n23\t/// A struct that packs a pointer with a size in bytes to pass on CUDA.\n24\t/// It holds `*const c_void` for being a universal simple type that can be read by CUDA.\n25\t/// Since it is hard to enforce immutability preservation, it just holds `*const`,\n26\t/// but has two separate constructors for more robustness from the usage perspective.\n27\t/// This is essentially a [DeviceBuffer] but without owning the data.\n28\t#[repr(C)]\n29\t#[derive(Debug, Copy, Clone)]\n30\tpub struct DeviceBufferView {\n31\t    pub ptr: *const c_void,\n32\t    pub size: usize,\n33\t}\n34\t\n35\tunsafe impl<T> Send for DeviceBuffer<T> {}\n36\tunsafe impl<T> Sync for DeviceBuffer<T> {}\n37\t\n38\timpl<T> DeviceBuffer<T> {\n39\t    /// Creates an \"empty\" DeviceBuffer with a null pointer and zero length.\n40\t    #[allow(clippy::new_without_default)]\n41\t    pub fn new() -> Self {\n42\t        DeviceBuffer {\n43\t            ptr: ptr::null_mut(),\n44\t            len: 0,\n45\t        }\n46\t    }\n47\t\n48\t    /// # Safety\n49\t    /// - The caller must ensure that the pointer `ptr` is valid for `len` elements of type `T` in\n50\t    ///   device memory.\n51\t    /// - Dropping the constructed buffer will attempt to free the memory. As such, `ptr` must\n52\t    ///   either have been allocated by the internal memory manager (VPMM) or the caller must use\n53\t    ///   `ManuallyDrop` to prevent double-free.\n54\t    pub unsafe fn from_raw_parts(ptr: *mut T, len: usize) -> Self {\n55\t        DeviceBuffer { ptr, len }\n56\t    }\n57\t\n58\t    /// Allocate device memory for `len` elements of type `T`.\n59\t    pub fn with_capacity(len: usize) -> Self {"}]},"parent_tool_use_id":"toolu_01HxSPkmcEs1rXrFnoZbrzGV","session_id":"9fb0c9c1-c32f-45e4-afe7-f108d55d0327","uuid":"cc603a1a-4e5f-4a6e-a328-627cf312694f","timestamp":"2026-04-12T19:31:46.406Z"}
