{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q1L6tLrTUxjKoqKjnFJ1hv","type":"tool_result","content":"1\t//! Defines the symbolic rule data to precompute and store in the GPU proving key\n2\tuse itertools::Itertools;\n3\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer, error::MemCopyError};\n4\tuse openvm_stark_backend::{\n5\t    air_builders::symbolic::{\n6\t        symbolic_expression::SymbolicExpression,\n7\t        symbolic_variable::{Entry, SymbolicVariable},\n8\t        SymbolicConstraints, SymbolicDagBuilder, SymbolicExpressionDag,\n9\t    },\n10\t    keygen::types::StarkProvingKey,\n11\t    StarkProtocolConfig,\n12\t};\n13\tuse p3_field::PrimeCharacteristicRing;\n14\t\n15\tuse crate::{\n16\t    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n17\t    monomial::{\n18\t        ExpandedInteractionMonomials, ExpandedMonomials, InteractionMonomialTerm, LambdaTerm,\n19\t        MonomialHeader, PackedVar,\n20\t    },\n21\t    prelude::F,\n22\t};\n23\t\n24\tpub struct AirDataGpu {\n25\t    pub interaction_rules: InteractionEvalRules,\n26\t    /// Whether to buffer vars depends on the performance and memory access patterns of the kernel.\n27\t    /// This may be tuned.\n28\t    pub zerocheck_round0: ConstraintOnlyRules<true>,\n29\t    pub zerocheck_mle: ConstraintOnlyRules<false>,\n30\t    pub zerocheck_monomials: Option<ZerocheckMonomials>,\n31\t    pub interaction_monomials: Option<InteractionMonomials>,\n32\t}\n33\t\n34\t/// Used for GKR input evaluation and logup MLE sumcheck rounds.\n35\tpub struct InteractionEvalRules {\n36\t    pub(crate) inner: EvalRules,\n37\t    /// Constraints consist of all `(numer, denom)` pairs **topologically sorted**. We map the\n38\t    /// constraint idx back to unsorted order. ```text\n39\t    /// constraint_idx => 2 * interaction_idx + is_denom\n40\t    /// ```\n41\t    pub(crate) d_pair_idxs: DeviceBuffer<u32>,\n42\t    pub(crate) max_fields_len: usize,\n43\t}\n44\t\n45\t/// Constraints only, no interactions\n46\tpub struct ConstraintOnlyRules<const BUFFER_VARS: bool> {\n47\t    pub(crate) inner: EvalRules,\n48\t}\n49\t\n50\tpub struct EvalRules {\n51\t    /// Encoded rules\n52\t    pub d_rules: DeviceBuffer<u128>,\n53\t    pub d_used_nodes: DeviceBuffer<usize>,\n54\t    pub buffer_size: u32,\n55\t}\n56\t\n57\tpub struct ZerocheckMonomials {\n58\t    pub d_headers: DeviceBuffer<MonomialHeader>,\n59\t    pub d_variables: DeviceBuffer<PackedVar>,\n60\t    pub d_lambda_terms: DeviceBuffer<LambdaTerm<F>>,\n61\t    pub num_monomials: u32,\n62\t}\n63\t\n64\tpub struct InteractionMonomials {\n65\t    pub d_numer_headers: DeviceBuffer<MonomialHeader>,\n66\t    pub d_numer_variables: DeviceBuffer<PackedVar>,\n67\t    pub d_numer_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n68\t    pub num_numer_monomials: u32,\n69\t    pub d_denom_headers: DeviceBuffer<MonomialHeader>,\n70\t    pub d_denom_variables: DeviceBuffer<PackedVar>,\n71\t    pub d_denom_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n72\t    pub num_denom_monomials: u32,\n73\t    pub max_fields_len: usize,\n74\t    pub num_interactions: u32,\n75\t}\n76\t\n77\tfn to_device_or_empty<T>(data: &[T]) -> Result<DeviceBuffer<T>, MemCopyError> {\n78\t    if data.is_empty() {\n79\t        Ok(DeviceBuffer::new())\n80\t    } else {\n81\t        data.to_device()\n82\t    }\n83\t}\n84\t\n85\timpl AirDataGpu {\n86\t    pub fn new<S: StarkProtocolConfig<F = F>>(\n87\t        pk: &StarkProvingKey<S>,\n88\t    ) -> Result<Self, MemCopyError> {\n89\t        let dag = &pk.vk.symbolic_constraints;\n90\t        let symbolic_constraints = SymbolicConstraints::from(dag);\n91\t        let interaction_rules = InteractionEvalRules::new(&symbolic_constraints)?;\n92\t        let zerocheck_round0 = ConstraintOnlyRules::<true>::new(&dag.constraints)?;\n93\t        let zerocheck_mle = ConstraintOnlyRules::<false>::new(&dag.constraints)?;\n94\t\n95\t        let zerocheck_monomials = if dag.constraints.num_constraints() > 0 {\n96\t            let expanded = ExpandedMonomials::from_dag(&dag.constraints);\n97\t            Some(ZerocheckMonomials::from_expanded(&expanded)?)\n98\t        } else {\n99\t            None\n100\t        };\n101\t        let interaction_monomials = if !symbolic_constraints.interactions.is_empty() {\n102\t            let expanded =\n103\t                ExpandedInteractionMonomials::from_symbolic_constraints(&symbolic_constraints);\n104\t            Some(InteractionMonomials::from_expanded(&expanded)?)\n105\t        } else {\n106\t            None\n107\t        };\n108\t        Ok(Self {\n109\t            interaction_rules,\n110\t            zerocheck_round0,\n111\t            zerocheck_mle,\n112\t            zerocheck_monomials,\n113\t            interaction_monomials,\n114\t        })\n115\t    }\n116\t}\n117\t\n118\timpl ZerocheckMonomials {\n119\t    pub fn from_expanded(expanded: &ExpandedMonomials<F>) -> Result<Self, MemCopyError> {\n120\t        // Validate bounds for all monomial headers to prevent out-of-bounds access in CUDA kernel\n121\t        let num_variables = expanded.variables.len();\n122\t        let num_lambda_terms = expanded.lambda_terms.len();\n123\t        for (i, hdr) in expanded.headers.iter().enumerate() {\n124\t            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n125\t            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n126\t            assert!(\n127\t                var_end <= num_variables,\n128\t                \"Monomial {i}: var_offset ({}) + num_vars ({}) = {var_end} exceeds variables.len() ({num_variables})\",\n129\t                hdr.var_offset,\n130\t                hdr.num_vars\n131\t            );\n132\t            assert!(\n133\t                term_end <= num_lambda_terms,\n134\t                \"Monomial {i}: term_offset ({}) + num_terms ({}) = {term_end} exceeds lambda_terms.len() ({num_lambda_terms})\",\n135\t                hdr.term_offset,\n136\t                hdr.num_terms\n137\t            );\n138\t        }\n139\t\n140\t        Ok(Self {\n141\t            d_headers: expanded.headers.to_device()?,\n142\t            d_variables: expanded.variables.to_device()?,\n143\t            d_lambda_terms: expanded.lambda_terms.to_device()?,\n144\t            num_monomials: expanded.headers.len() as u32,\n145\t        })\n146\t    }\n147\t}\n148\t\n149\timpl InteractionMonomials {\n150\t    pub fn from_expanded(expanded: &ExpandedInteractionMonomials<F>) -> Result<Self, MemCopyError> {\n151\t        // Validate numerator monomial headers\n152\t        let num_numer_vars = expanded.numer_variables.len();\n153\t        let num_numer_terms = expanded.numer_terms.len();\n154\t        for (i, hdr) in expanded.numer_headers.iter().enumerate() {\n155\t            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n156\t            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n157\t            assert!(\n158\t                var_end <= num_numer_vars,\n159\t                \"Numer monomial {i}: var_offset + num_vars exceeds bounds\"\n160\t            );\n161\t            assert!(\n162\t                term_end <= num_numer_terms,\n163\t                \"Numer monomial {i}: term_offset + num_terms exceeds bounds\"\n164\t            );\n165\t        }\n166\t\n167\t        // Validate denominator monomial headers\n168\t        let num_denom_vars = expanded.denom_variables.len();\n169\t        let num_denom_terms = expanded.denom_terms.len();\n170\t        for (i, hdr) in expanded.denom_headers.iter().enumerate() {\n171\t            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n172\t            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n173\t            assert!(\n174\t                var_end <= num_denom_vars,\n175\t                \"Denom monomial {i}: var_offset + num_vars exceeds bounds\"\n176\t            );\n177\t            assert!(\n178\t                term_end <= num_denom_terms,\n179\t                \"Denom monomial {i}: term_offset + num_terms exceeds bounds\"\n180\t            );\n181\t        }\n182\t\n183\t        Ok(Self {\n184\t            d_numer_headers: to_device_or_empty(&expanded.numer_headers)?,\n185\t            d_numer_variables: to_device_or_empty(&expanded.numer_variables)?,\n186\t            d_numer_terms: to_device_or_empty(&expanded.numer_terms)?,\n187\t            num_numer_monomials: expanded.numer_headers.len() as u32,\n188\t            d_denom_headers: to_device_or_empty(&expanded.denom_headers)?,\n189\t            d_denom_variables: to_device_or_empty(&expanded.denom_variables)?,\n190\t            d_denom_terms: to_device_or_empty(&expanded.denom_terms)?,\n191\t            num_denom_monomials: expanded.denom_headers.len() as u32,\n192\t            max_fields_len: expanded.max_fields_len,\n193\t            num_interactions: expanded.num_interactions,\n194\t        })\n195\t    }\n196\t}\n197\t\n198\timpl InteractionEvalRules {\n199\t    pub fn new(symbolic_constraints: &SymbolicConstraints<F>) -> Result<Self, MemCopyError> {\n200\t        let interactions = &symbolic_constraints.interactions;\n201\t        let num_interactions = interactions.len();\n202\t        if num_interactions == 0 {\n203\t            return Ok(Self {\n204\t                inner: EvalRules::dummy(),\n205\t\n206\t                max_fields_len: 0,\n207\t                d_pair_idxs: DeviceBuffer::new(),\n208\t            });\n209\t        }\n210\t        let max_fields_len = interactions\n211\t            .iter()\n212\t            .map(|interaction| interaction.message.len())\n213\t            .max()\n214\t            .unwrap_or(0);\n215\t        // [alpha, beta^0, ..., beta^max_fields_len]\n216\t        let symbolic_challenges: Vec<SymbolicExpression<F>> = (0..max_fields_len + 2)\n217\t            .map(|index| SymbolicVariable::<F>::new(Entry::Challenge, index).into())\n218\t            .collect();\n219\t\n220\t        let mut frac_pairs = Vec::with_capacity(num_interactions * 2);\n221\t        for interaction in interactions.iter() {\n222\t            let numer = interaction.count.clone();\n223\t            let b = SymbolicExpression::from_u32(interaction.bus_index as u32 + 1);\n224\t            let betas = symbolic_challenges[1..].to_vec();\n225\t            let mut denom = SymbolicExpression::from_u32(0);\n226\t            for (j, expr) in interaction.message.iter().enumerate() {\n227\t                denom += betas[j].clone() * expr.clone();\n228\t            }\n229\t            denom += betas[interaction.message.len()].clone() * b;\n230\t            frac_pairs.push(numer);\n231\t            frac_pairs.push(denom);\n232\t        }\n233\t        // build DAG without sorting constraint idxs:\n234\t        let (dag, pair_idxs) = {\n235\t            let mut dag_builder = SymbolicDagBuilder::new();\n236\t            let mut dag_pair_idxs: Vec<(usize, u32)> = frac_pairs\n237\t                .iter()\n238\t                .enumerate()\n239\t                .map(|(pair_idx, expr)| {\n240\t                    let dag_idx = dag_builder.add_expr(expr);\n241\t                    (dag_idx, pair_idx.try_into().unwrap())\n242\t                })\n243\t                .collect_vec();\n244\t            dag_pair_idxs.sort();\n245\t            let (constraint_idx, pair_idxs): (Vec<_>, Vec<_>) = dag_pair_idxs.into_iter().unzip();\n246\t            // NOTE: do not sort pair_idxs since we need to keep them in pairs\n247\t            let dag = SymbolicExpressionDag {\n248\t                nodes: dag_builder.nodes,\n249\t                constraint_idx,\n250\t            };\n251\t            (dag, pair_idxs)\n252\t        };\n253\t        let rules = SymbolicRulesGpu::new(&dag, false);\n254\t        // Build used_nodes with duplicates, preserving order from constraint_idx\n255\t        let used_nodes = dag\n256\t            .constraint_idx\n257\t            .iter()\n258\t            .map(|&dag_idx| rules.dag_idx_to_rule_idx[&dag_idx])\n259\t            .collect_vec();\n260\t        let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n261\t        let d_rules = encoded_rules.to_device()?;\n262\t        let d_used_nodes = used_nodes.to_device()?;\n263\t        let d_pair_idxs = pair_idxs.to_device()?;\n264\t        assert_eq!(\n265\t            used_nodes.len(),\n266\t            2 * num_interactions,\n267\t            \"Rules come in (numer, denom) pairs\"\n268\t        );\n269\t\n270\t        let inner = EvalRules {\n271\t            d_rules,\n272\t            d_used_nodes,\n273\t            buffer_size: rules\n274\t                .buffer_size\n275\t                .try_into()\n276\t                .expect(\"buffer_size exceeds u32\"),\n277\t        };\n278\t\n279\t        Ok(Self {\n280\t            inner,\n281\t            d_pair_idxs,\n282\t            max_fields_len,\n283\t        })\n284\t    }\n285\t}\n286\t\n287\timpl<const BUFFER_VARS: bool> ConstraintOnlyRules<BUFFER_VARS> {\n288\t    pub fn new(dag: &SymbolicExpressionDag<F>) -> Result<Self, MemCopyError> {\n289\t        if dag.num_constraints() == 0 {\n290\t            return Ok(Self {\n291\t                inner: EvalRules::dummy(),\n292\t            });\n293\t        }\n294\t\n295\t        let rules = SymbolicRulesGpu::new(dag, BUFFER_VARS);\n296\t        // Build used_nodes with duplicates, preserving order from constraint_idx\n297\t        let used_nodes = dag\n298\t            .constraint_idx\n299\t            .iter()\n300\t            .map(|&dag_idx| rules.dag_idx_to_rule_idx[&dag_idx])\n301\t            .collect_vec();\n302\t\n303\t        let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n304\t        let d_rules = encoded_rules.to_device()?;\n305\t        let d_used_nodes = used_nodes.to_device()?;\n306\t\n307\t        let inner = EvalRules {\n308\t            d_rules,\n309\t            d_used_nodes,\n310\t            buffer_size: rules\n311\t                .buffer_size\n312\t                .try_into()\n313\t                .expect(\"buffer_size exceeds u32\"),\n314\t        };\n315\t        Ok(Self { inner })\n316\t    }\n317\t}\n318\t\n319\timpl EvalRules {\n320\t    pub fn dummy() -> Self {\n321\t        Self {\n322\t            d_rules: DeviceBuffer::new(),\n323\t            d_used_nodes: DeviceBuffer::new(),\n324\t            buffer_size: 0,\n325\t        }\n326\t    }\n327\t}\n328\t"}]},"parent_tool_use_id":null,"session_id":"6dad4735-cfc3-4e75-88af-7885288c829c","uuid":"ba63b506-2672-41cd-8bf4-d8a48d3e2a37","timestamp":"2026-04-11T08:04:36.195Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/pkey.rs","content":"//! Defines the symbolic rule data to precompute and store in the GPU proving key\nuse itertools::Itertools;\nuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer, error::MemCopyError};\nuse openvm_stark_backend::{\n    air_builders::symbolic::{\n        symbolic_expression::SymbolicExpression,\n        symbolic_variable::{Entry, SymbolicVariable},\n        SymbolicConstraints, SymbolicDagBuilder, SymbolicExpressionDag,\n    },\n    keygen::types::StarkProvingKey,\n    StarkProtocolConfig,\n};\nuse p3_field::PrimeCharacteristicRing;\n\nuse crate::{\n    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n    monomial::{\n        ExpandedInteractionMonomials, ExpandedMonomials, InteractionMonomialTerm, LambdaTerm,\n        MonomialHeader, PackedVar,\n    },\n    prelude::F,\n};\n\npub struct AirDataGpu {\n    pub interaction_rules: InteractionEvalRules,\n    /// Whether to buffer vars depends on the performance and memory access patterns of the kernel.\n    /// This may be tuned.\n    pub zerocheck_round0: ConstraintOnlyRules<true>,\n    pub zerocheck_mle: ConstraintOnlyRules<false>,\n    pub zerocheck_monomials: Option<ZerocheckMonomials>,\n    pub interaction_monomials: Option<InteractionMonomials>,\n}\n\n/// Used for GKR input evaluation and logup MLE sumcheck rounds.\npub struct InteractionEvalRules {\n    pub(crate) inner: EvalRules,\n    /// Constraints consist of all `(numer, denom)` pairs **topologically sorted**. We map the\n    /// constraint idx back to unsorted order. ```text\n    /// constraint_idx => 2 * interaction_idx + is_denom\n    /// ```\n    pub(crate) d_pair_idxs: DeviceBuffer<u32>,\n    pub(crate) max_fields_len: usize,\n}\n\n/// Constraints only, no interactions\npub struct ConstraintOnlyRules<const BUFFER_VARS: bool> {\n    pub(crate) inner: EvalRules,\n}\n\npub struct EvalRules {\n    /// Encoded rules\n    pub d_rules: DeviceBuffer<u128>,\n    pub d_used_nodes: DeviceBuffer<usize>,\n    pub buffer_size: u32,\n}\n\npub struct ZerocheckMonomials {\n    pub d_headers: DeviceBuffer<MonomialHeader>,\n    pub d_variables: DeviceBuffer<PackedVar>,\n    pub d_lambda_terms: DeviceBuffer<LambdaTerm<F>>,\n    pub num_monomials: u32,\n}\n\npub struct InteractionMonomials {\n    pub d_numer_headers: DeviceBuffer<MonomialHeader>,\n    pub d_numer_variables: DeviceBuffer<PackedVar>,\n    pub d_numer_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n    pub num_numer_monomials: u32,\n    pub d_denom_headers: DeviceBuffer<MonomialHeader>,\n    pub d_denom_variables: DeviceBuffer<PackedVar>,\n    pub d_denom_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n    pub num_denom_monomials: u32,\n    pub max_fields_len: usize,\n    pub num_interactions: u32,\n}\n\nfn to_device_or_empty<T>(data: &[T]) -> Result<DeviceBuffer<T>, MemCopyError> {\n    if data.is_empty() {\n        Ok(DeviceBuffer::new())\n    } else {\n        data.to_device()\n    }\n}\n\nimpl AirDataGpu {\n    pub fn new<S: StarkProtocolConfig<F = F>>(\n        pk: &StarkProvingKey<S>,\n    ) -> Result<Self, MemCopyError> {\n        let dag = &pk.vk.symbolic_constraints;\n        let symbolic_constraints = SymbolicConstraints::from(dag);\n        let interaction_rules = InteractionEvalRules::new(&symbolic_constraints)?;\n        let zerocheck_round0 = ConstraintOnlyRules::<true>::new(&dag.constraints)?;\n        let zerocheck_mle = ConstraintOnlyRules::<false>::new(&dag.constraints)?;\n\n        let zerocheck_monomials = if dag.constraints.num_constraints() > 0 {\n            let expanded = ExpandedMonomials::from_dag(&dag.constraints);\n            Some(ZerocheckMonomials::from_expanded(&expanded)?)\n        } else {\n            None\n        };\n        let interaction_monomials = if !symbolic_constraints.interactions.is_empty() {\n            let expanded =\n                ExpandedInteractionMonomials::from_symbolic_constraints(&symbolic_constraints);\n            Some(InteractionMonomials::from_expanded(&expanded)?)\n        } else {\n            None\n        };\n        Ok(Self {\n            interaction_rules,\n            zerocheck_round0,\n            zerocheck_mle,\n            zerocheck_monomials,\n            interaction_monomials,\n        })\n    }\n}\n\nimpl ZerocheckMonomials {\n    pub fn from_expanded(expanded: &ExpandedMonomials<F>) -> Result<Self, MemCopyError> {\n        // Validate bounds for all monomial headers to prevent out-of-bounds access in CUDA kernel\n        let num_variables = expanded.variables.len();\n        let num_lambda_terms = expanded.lambda_terms.len();\n        for (i, hdr) in expanded.headers.iter().enumerate() {\n            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n            assert!(\n                var_end <= num_variables,\n                \"Monomial {i}: var_offset ({}) + num_vars ({}) = {var_end} exceeds variables.len() ({num_variables})\",\n                hdr.var_offset,\n                hdr.num_vars\n            );\n            assert!(\n                term_end <= num_lambda_terms,\n                \"Monomial {i}: term_offset ({}) + num_terms ({}) = {term_end} exceeds lambda_terms.len() ({num_lambda_terms})\",\n                hdr.term_offset,\n                hdr.num_terms\n            );\n        }\n\n        Ok(Self {\n            d_headers: expanded.headers.to_device()?,\n            d_variables: expanded.variables.to_device()?,\n            d_lambda_terms: expanded.lambda_terms.to_device()?,\n            num_monomials: expanded.headers.len() as u32,\n        })\n    }\n}\n\nimpl InteractionMonomials {\n    pub fn from_expanded(expanded: &ExpandedInteractionMonomials<F>) -> Result<Self, MemCopyError> {\n        // Validate numerator monomial headers\n        let num_numer_vars = expanded.numer_variables.len();\n        let num_numer_terms = expanded.numer_terms.len();\n        for (i, hdr) in expanded.numer_headers.iter().enumerate() {\n            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n            assert!(\n                var_end <= num_numer_vars,\n                \"Numer monomial {i}: var_offset + num_vars exceeds bounds\"\n            );\n            assert!(\n                term_end <= num_numer_terms,\n                \"Numer monomial {i}: term_offset + num_terms exceeds bounds\"\n            );\n        }\n\n        // Validate denominator monomial headers\n        let num_denom_vars = expanded.denom_variables.len();\n        let num_denom_terms = expanded.denom_terms.len();\n        for (i, hdr) in expanded.denom_headers.iter().enumerate() {\n            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n            assert!(\n                var_end <= num_denom_vars,\n                \"Denom monomial {i}: var_offset + num_vars exceeds bounds\"\n            );\n            assert!(\n                term_end <= num_denom_terms,\n                \"Denom monomial {i}: term_offset + num_terms exceeds bounds\"\n            );\n        }\n\n        Ok(Self {\n            d_numer_headers: to_device_or_empty(&expanded.numer_headers)?,\n            d_numer_variables: to_device_or_empty(&expanded.numer_variables)?,\n            d_numer_terms: to_device_or_empty(&expanded.numer_terms)?,\n            num_numer_monomials: expanded.numer_headers.len() as u32,\n            d_denom_headers: to_device_or_empty(&expanded.denom_headers)?,\n            d_denom_variables: to_device_or_empty(&expanded.denom_variables)?,\n            d_denom_terms: to_device_or_empty(&expanded.denom_terms)?,\n            num_denom_monomials: expanded.denom_headers.len() as u32,\n            max_fields_len: expanded.max_fields_len,\n            num_interactions: expanded.num_interactions,\n        })\n    }\n}\n\nimpl InteractionEvalRules {\n    pub fn new(symbolic_constraints: &SymbolicConstraints<F>) -> Result<Self, MemCopyError> {\n        let interactions = &symbolic_constraints.interactions;\n        let num_interactions = interactions.len();\n        if num_interactions == 0 {\n            return Ok(Self {\n                inner: EvalRules::dummy(),\n\n                max_fields_len: 0,\n                d_pair_idxs: DeviceBuffer::new(),\n            });\n        }\n        let max_fields_len = interactions\n            .iter()\n            .map(|interaction| interaction.message.len())\n            .max()\n            .unwrap_or(0);\n        // [alpha, beta^0, ..., beta^max_fields_len]\n        let symbolic_challenges: Vec<SymbolicExpression<F>> = (0..max_fields_len + 2)\n            .map(|index| SymbolicVariable::<F>::new(Entry::Challenge, index).into())\n            .collect();\n\n        let mut frac_pairs = Vec::with_capacity(num_interactions * 2);\n        for interaction in interactions.iter() {\n            let numer = interaction.count.clone();\n            let b = SymbolicExpression::from_u32(interaction.bus_index as u32 + 1);\n            let betas = symbolic_challenges[1..].to_vec();\n            let mut denom = SymbolicExpression::from_u32(0);\n            for (j, expr) in interaction.message.iter().enumerate() {\n                denom += betas[j].clone() * expr.clone();\n            }\n            denom += betas[interaction.message.len()].clone() * b;\n            frac_pairs.push(numer);\n            frac_pairs.push(denom);\n        }\n        // build DAG without sorting constraint idxs:\n        let (dag, pair_idxs) = {\n            let mut dag_builder = SymbolicDagBuilder::new();\n            let mut dag_pair_idxs: Vec<(usize, u32)> = frac_pairs\n                .iter()\n                .enumerate()\n                .map(|(pair_idx, expr)| {\n                    let dag_idx = dag_builder.add_expr(expr);\n                    (dag_idx, pair_idx.try_into().unwrap())\n                })\n                .collect_vec();\n            dag_pair_idxs.sort();\n            let (constraint_idx, pair_idxs): (Vec<_>, Vec<_>) = dag_pair_idxs.into_iter().unzip();\n            // NOTE: do not sort pair_idxs since we need to keep them in pairs\n            let dag = SymbolicExpressionDag {\n                nodes: dag_builder.nodes,\n                constraint_idx,\n            };\n            (dag, pair_idxs)\n        };\n        let rules = SymbolicRulesGpu::new(&dag, false);\n        // Build used_nodes with duplicates, preserving order from constraint_idx\n        let used_nodes = dag\n            .constraint_idx\n            .iter()\n            .map(|&dag_idx| rules.dag_idx_to_rule_idx[&dag_idx])\n            .collect_vec();\n        let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n        let d_rules = encoded_rules.to_device()?;\n        let d_used_nodes = used_nodes.to_device()?;\n        let d_pair_idxs = pair_idxs.to_device()?;\n        assert_eq!(\n            used_nodes.len(),\n            2 * num_interactions,\n            \"Rules come in (numer, denom) pairs\"\n        );\n\n        let inner = EvalRules {\n            d_rules,\n            d_used_nodes,\n            buffer_size: rules\n                .buffer_size\n                .try_into()\n                .expect(\"buffer_size exceeds u32\"),\n        };\n\n        Ok(Self {\n            inner,\n            d_pair_idxs,\n            max_fields_len,\n        })\n    }\n}\n\nimpl<const BUFFER_VARS: bool> ConstraintOnlyRules<BUFFER_VARS> {\n    pub fn new(dag: &SymbolicExpressionDag<F>) -> Result<Self, MemCopyError> {\n        if dag.num_constraints() == 0 {\n            return Ok(Self {\n                inner: EvalRules::dummy(),\n            });\n        }\n\n        let rules = SymbolicRulesGpu::new(dag, BUFFER_VARS);\n        // Build used_nodes with duplicates, preserving order from constraint_idx\n        let used_nodes = dag\n            .constraint_idx\n            .iter()\n            .map(|&dag_idx| rules.dag_idx_to_rule_idx[&dag_idx])\n            .collect_vec();\n\n        let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n        let d_rules = encoded_rules.to_device()?;\n        let d_used_nodes = used_nodes.to_device()?;\n\n        let inner = EvalRules {\n            d_rules,\n            d_used_nodes,\n            buffer_size: rules\n                .buffer_size\n                .try_into()\n                .expect(\"buffer_size exceeds u32\"),\n        };\n        Ok(Self { inner })\n    }\n}\n\nimpl EvalRules {\n    pub fn dummy() -> Self {\n        Self {\n            d_rules: DeviceBuffer::new(),\n            d_used_nodes: DeviceBuffer::new(),\n            buffer_size: 0,\n        }\n    }\n}\n","numLines":328,"startLine":1,"totalLines":328}}}
