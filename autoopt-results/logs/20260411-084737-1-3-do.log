rator(log_large_domain);\n777\t\n778\t            assert!(!xi.is_empty(), \"xi vector must not be empty\");\n779\t\n780\t            let height = air_ctx.common_main.height();\n781\t            let mut main_parts = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n782\t            for committed in &air_ctx.cached_mains {\n783\t                main_parts.push(committed.trace.buffer().as_ptr());\n784\t            }\n785\t            main_parts.push(air_ctx.common_main.buffer().as_ptr());\n786\t            let d_main_parts = main_parts.to_device()?;\n787\t\n788\t            let n_lift = n.max(0) as usize;\n789\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n790\t            let max_temp_bytes = self.memory_limit_bytes;\n791\t            // local_constraint_deg = 0 means no constraints. The only way that linear constraints\n792\t            // on trace polynomials could vanish on 2^l_skip points is if the constraint polynomial\n793\t            // is identically zero. Thus for local_constraint_deg = 0 or 1, we must have `s'_0 = 0`.\n794\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n795\t            let zc_result = evaluate_round0_constraints_gpu(\n796\t                single_pk,\n797\t                selectors_cube.buffer(),\n798\t                &d_main_parts,\n799\t                public_values,\n800\t                eq_xi_tree.get_ptr(n_lift),\n801\t                d_lambda_pows,\n802\t                1 << l_skip,\n803\t                1 << n_lift,\n804\t                height as u32,\n805\t                num_cosets_zc as u32,\n806\t                omega_root,\n807\t                max_temp_bytes,\n808\t            )?;\n809\t\n810\t            // PERF: we could use an interaction-specific constraint degree here\n811\t            let num_cosets_logup = local_constraint_deg;\n812\t            let logup_result = evaluate_round0_interactions_gpu(\n813\t                single_pk,\n814\t                &single_air_constraints,\n815\t  