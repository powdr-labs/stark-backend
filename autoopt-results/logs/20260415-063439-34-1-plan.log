==============================================\n667\t\n668\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n669\tfn evaluate_mle_constraints_gpu_batch(\n670\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n671\t    zc_ctxs: &DeviceBuffer<ZerocheckCtx>,\n672\t    air_block_offsets: &DeviceBuffer<u32>,\n673\t    lambda_pows: &DeviceBuffer<EF>,\n674\t    lambda_len: usize,\n675\t    num_x: u32,\n676\t    threads_per_block: u32,\n677\t) -> Result<DeviceBuffer<EF>, KernelError> {\n678\t    let num_blocks = block_ctxs.len();\n679\t    let num_airs = zc_ctxs.len();\n680\t    tracing::debug!(\n681\t        %num_blocks,\n682\t        %num_x,\n683\t        %threads_per_block,\n684\t        %num_airs,\n685\t        \"zerocheck_batch_eval_mle\"\n686\t    );\n687\t    // Need one buffer slot per block\n688\t    let mut tmp_sums_buffer = DeviceBuffer::<EF>::with_capacity(num_blocks * num_x as usize);\n689\t    let mut output = DeviceBuffer::<EF>::with_capacity(num_airs * num_x as usize);\n690\t    unsafe {\n691\t        zerocheck_batch_eval_mle(\n692\t            &mut tmp_sums_buffer,\n693\t            &mut output,\n694\t            block_ctxs,\n695\t            zc_ctxs,\n696\t            air_block_offsets,\n697\t            lambda_pows,\n698\t            lambda_len,\n699\t            num_blocks as u32,\n700\t            num_x,\n701\t            num_airs as u32,\n702\t            threads_per_block,\n703\t        )?;\n704\t    }\n705\t    Ok(output)\n706\t}\n707\t\n708\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n709\tfn evaluate_mle_interactions_gpu_batch(\n710\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n711\t    logup_ctxs: &DeviceBuffer<LogupCtx>,\n712\t    air_block_offsets: &DeviceBuffer<u32>,\n713\t    num_x: u32,\n714\t    threads_per_block: u32,\n715\t) -> Result<DeviceBuffer<Frac<EF>>, KernelError> {\n716\t    let num_blocks = block_ctxs.len();\n717\t    let num_airs = logup_ctxs.len();\n718\t    // Ne