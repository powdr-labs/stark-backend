{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TqdKvXXYU9pysu1eycAVAP","type":"tool_result","content":"599\t    fn sumcheck_uni_round0_polys(\n600\t        &mut self,\n601\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n602\t        lambda: EF,\n603\t    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n604\t        self.mem\n605\t            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n606\t        self.mem.reset_peak();\n607\t        let n_logup = self.n_logup;\n608\t        let l_skip = self.l_skip;\n609\t        let xi = &self.xi;\n610\t        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n611\t        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n612\t            h_lambda_pows.to_device()?\n613\t        } else {\n614\t            DeviceBuffer::new()\n615\t        });\n616\t        // Precompute lambda combinations for all AIRs with monomials\n617\t        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n618\t        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n619\t            if air_pk.other_data.zerocheck_monomials.is_some() {\n620\t                self.lambda_combinations[air_idx] = Some(\n621\t                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n622\t                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n623\t                );\n624\t            }\n625\t        }\n626\t        let num_present_airs = ctx.per_trace.len();\n627\t        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n628\t\n629\t        self.eq_3b_per_trace = ctx\n630\t            .per_trace\n631\t            .iter()\n632\t            .enumerate()\n633\t            .map(|(trace_idx, (air_idx, _))| {\n634\t                let vk = &self.pk.per_air[*air_idx].vk;\n635\t                let num_interactions = vk.num_interactions();\n636\t                if num_interactions > 0 {\n637\t                    let n = self.n_per_trace[trace_idx];\n638\t                    let n_lift = n.max(0) as usize;\n639\t                    let mut b_vec = vec![F::ZERO; n_logup - n_lift];\n640\t                    let mut weights = Vec::with_capacity(num_interactions);\n641\t                    for interaction_idx in 0..num_interactions {\n642\t                        let stacked_idx = self\n643\t                            .interactions_layout\n644\t                            .get(trace_idx, interaction_idx)\n645\t                            .unwrap()\n646\t                            .row_idx;\n647\t                        let mut b_int = stacked_idx >> (l_skip + n_lift);\n648\t                        for bit in &mut b_vec {\n649\t                            *bit = F::from_bool(b_int & 1 == 1);\n650\t                            b_int >>= 1;\n651\t                        }\n652\t                        let weight =\n653\t                            eval_eq_mle(&self.xi[l_skip + n_lift..l_skip + n_logup], &b_vec);\n654\t                        weights.push(weight);\n655\t                    }\n656\t                    weights\n657\t                } else {\n658\t                    vec![]\n659\t                }\n660\t            })\n661\t            .collect_vec();\n662\t        self.d_eq_3b_per_trace = self\n663\t            .eq_3b_per_trace\n664\t            .iter()\n665\t            .map(|eq_3bs| {\n666\t                if eq_3bs.is_empty() {\n667\t                    Ok(DeviceBuffer::new())\n668\t                } else {\n669\t                    eq_3bs.to_device()\n670\t                }\n671\t            })\n672\t            .collect::<Result<Vec<_>, _>>()?;\n673\t\n674\t        // Precompute logup combinations for all traces with interaction monomials\n675\t        for (trace_idx, (air_idx, _)) in ctx.per_trace.iter().enumerate() {\n676\t            let air_pk = &self.pk.per_air[*air_idx];\n677\t            if air_pk.other_data.interaction_monomials.is_some()\n678\t                && !self.eq_3b_per_trace[trace_idx].is_empty()\n679\t            {\n680\t                self.logup_combinations[trace_idx] = Some(\n681\t                    compute_logup_combinations(\n682\t                        self.pk,\n683\t                        *air_idx,\n684\t                        &self.d_beta_pows,\n685\t                        &self.d_eq_3b_per_trace[trace_idx],\n686\t                        &self.eq_3b_per_trace[trace_idx],\n687\t                        &self.beta_pows,\n688\t                    )\n689\t                    .map_err(LogupZerocheckError::LogupCombinations)?,\n690\t                );\n691\t            }\n692\t        }\n693\t\n694\t        // PERF[jpw]: we could also build the layers for different n in a transposed way using\n695\t        // eq_nonoverlapping_stage_ext, which is more memory efficient\n696\t        for &n in &self.n_per_trace {\n697\t            let n_lift = n.max(0) as usize;\n698\t            if let Entry::Vacant(entry) = self.eq_xis.entry(n_lift) {\n699\t                let layers =\n700\t                    EqEvalLayers::new_rev(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n701\t                        .map_err(LogupZerocheckError::EqEvalLayers)?;\n702\t                entry.insert(layers);\n703\t            }\n704\t        }\n705\t\n706\t        self.sels_per_trace_base = self\n707\t            .n_per_trace\n708\t            .iter()\n709\t            .map(|&n| {\n710\t                let n_lift = n.max(0) as usize;\n711\t                let height = 1 << n_lift;\n712\t                let mut cols = F::zero_vec(3 * height);\n713\t                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n714\t                cols[0] = F::ONE; // is_first\n715\t                cols[2 * height + height - 1] = F::ONE; // is_last\n716\t                let d_cols = cols.to_device()?;\n717\t                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n718\t            })\n719\t            .collect::<Result<Vec<_>, MemCopyError>>()?;\n720\t\n721\t        let selectors_base = self.sels_per_trace_base.clone();\n722\t\n723\t        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n724\t        // present AIR\n725\t        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n726\t        let d_lambda_pows = self\n727\t            .lambda_pows\n728\t            .as_ref()\n729\t            .expect(\"lambda powers must be set before round-0 evaluation\");\n730\t\n731\t        // Metadata stored per AIR during Phase 1, consumed in Phase 2\n732\t        struct Round0Pending<F, EF> {\n733\t            trace_idx: usize,\n734\t            air_idx: usize,\n735\t            num_cosets_zc: usize,\n736\t            num_cosets_logup: usize,\n737\t            local_constraint_deg: usize,\n738\t            omega_root: F,\n739\t            n: isize,\n740\t            zc_result: DeviceBuffer<EF>,\n741\t            logup_result: DeviceBuffer<Frac<EF>>,\n742\t        }\n743\t\n744\t        // Phase 1: Launch all GPU kernels without blocking D2H transfers.\n745\t        // Collect result buffers and metadata for Phase 2 processing.\n746\t        let mut pending: Vec<Round0Pending<F, EF>> = Vec::with_capacity(num_present_airs);\n747\t        // Collect d_main_parts to keep them alive until all kernels complete.\n748\t        let mut d_main_parts_vec: Vec<DeviceBuffer<*const F>> = Vec::with_capacity(num_present_airs);\n749\t\n750\t        for (trace_idx, ((air_idx, air_ctx), &n, selectors_cube, public_values, eq_3bs)) in izip!(\n751\t            &ctx.per_trace,\n752\t            &self.n_per_trace,\n753\t            &selectors_base,\n754\t            &self.public_values_per_trace,\n755\t            &self.eq_3b_per_trace,\n756\t        )\n757\t        .enumerate()\n758\t        {\n759\t            debug!(\"starting batch constraints for air_idx={air_idx} (trace_idx={trace_idx})\");\n760\t            let single_pk = &self.pk.per_air[*air_idx];\n761\t            // Includes both plain AIR constraints and symbolic interactions\n762\t            let single_air_constraints =\n763\t                SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n764\t            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n765\t            debug_assert_eq!(\n766\t                single_air_constraints.max_constraint_degree(),\n767\t                local_constraint_deg\n768\t            );\n769\t            assert!(\n770\t                local_constraint_deg <= self.constraint_degree,\n771\t                \"Max constraint degree ({local_constraint_deg}) of AIR {air_idx} exceeds the global maximum {}\",\n772\t                self.constraint_degree\n773\t            );\n774\t\n775\t            let log_large_domain = log2_ceil_usize(local_constraint_deg << l_skip);\n776\t            let omega_root = F::two_adic_generator(log_large_domain);\n777\t\n778\t            assert!(!xi.is_empty(), \"xi vector must not be empty\");\n779\t\n780\t            let height = air_ctx.common_main.height();\n781\t            let mut main_parts = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n782\t            for committed in &air_ctx.cached_mains {\n783\t                main_parts.push(committed.trace.buffer().as_ptr());\n784\t            }\n785\t            main_parts.push(air_ctx.common_main.buffer().as_ptr());\n786\t            let d_main_parts = main_parts.to_device()?;\n787\t\n788\t            let n_lift = n.max(0) as usize;\n789\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n790\t            let max_temp_bytes = self.memory_limit_bytes;\n791\t            // local_constraint_deg = 0 means no constraints. The only way that linear constraints\n792\t            // on trace polynomials could vanish on 2^l_skip points is if the constraint polynomial\n793\t            // is identically zero. Thus for local_constraint_deg = 0 or 1, we must have `s'_0 = 0`.\n794\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n795\t            let zc_result = evaluate_round0_constraints_gpu(\n796\t                single_pk,\n797\t                selectors_cube.buffer(),\n798\t                &d_main_parts,\n799\t                public_values,\n800\t                eq_xi_tree.get_ptr(n_lift),\n801\t                d_lambda_pows,\n802\t                1 << l_skip,\n803\t                1 << n_lift,\n804\t                height as u32,\n805\t                num_cosets_zc as u32,\n806\t                omega_root,\n807\t                max_temp_bytes,\n808\t            )?;\n809\t\n810\t            // PERF: we could use an interaction-specific constraint degree here\n811\t            let num_cosets_logup = local_constraint_deg;\n812\t            let logup_result = evaluate_round0_interactions_gpu(\n813\t                single_pk,\n814\t                &single_air_constraints,\n815\t                selectors_cube.buffer(),\n816\t                &d_main_parts,\n817\t                public_values,\n818\t                eq_xi_tree.get_ptr(n_lift),\n819\t                &self.beta_pows,\n820\t                eq_3bs,\n821\t                1 << l_skip,\n822\t                1 << n_lift,\n823\t                height as u32,\n824\t                num_cosets_logup as u32,\n825\t                omega_root,\n826\t                max_temp_bytes,\n827\t            )?;\n828\t\n829\t            d_main_parts_vec.push(d_main_parts);\n830\t            pending.push(Round0Pending {\n831\t                trace_idx,\n832\t                air_idx: *air_idx,\n833\t                num_cosets_zc,\n834\t                num_cosets_logup,\n835\t                local_constraint_deg,\n836\t                omega_root,\n837\t                n,\n838\t                zc_result,\n839\t                logup_result,\n840\t            });\n841\t        }\n842\t\n843\t        // Phase 2: Explicit stream sync, then D2H transfers + CPU polynomial construction.\n844\t        current_stream_sync().map_err(|e| LogupZerocheckError::from(MemCopyError::from(e)))?;\n845\t\n846\t        // Release d_main_parts now that all kernels have completed\n847\t        drop(d_main_parts_vec);\n848\t\n849\t        for entry in pending {\n850\t            if !entry.zc_result.is_empty() {\n851\t                let q_evals = entry.zc_result.to_host()?;\n852\t                let q = {\n853\t                    // Make q_evals row-major, with columns <> cosets\n854\t                    let mut values = EF::zero_vec(entry.num_cosets_zc << l_skip);\n855\t                    for coset_idx in 0..entry.num_cosets_zc {\n856\t                        for i in 0..1 << l_skip {\n857\t                            values[i * entry.num_cosets_zc + coset_idx] =\n858\t                                q_evals[(coset_idx << l_skip) + i];\n859\t                        }\n860\t                    }\n861\t                    UnivariatePoly::from_geometric_cosets_evals_idft(\n862\t                        RowMajorMatrix::new(values, entry.num_cosets_zc),\n863\t                        entry.omega_root,\n864\t                        entry.omega_root,\n865\t                    )\n866\t                };\n867\t                // sp_0 = (Z^{2^l_skip} - 1) * q\n868\t                let sp_0_deg = sumcheck_round0_deg(l_skip, entry.local_constraint_deg);\n869\t                let coeffs = (0..=sp_0_deg)\n870\t                    .map(|i| {\n871\t                        let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n872\t                        if i >= 1 << l_skip {\n873\t                            c += q.coeffs()[i - (1 << l_skip)];\n874\t                        }\n875\t                        c\n876\t                    })\n877\t                    .collect_vec();\n878\t                debug_assert_eq!(\n879\t                    coeffs.iter().step_by(1 << l_skip).copied().sum::<EF>(),\n880\t                    EF::ZERO,\n881\t                    \"Zerocheck sum is not zer