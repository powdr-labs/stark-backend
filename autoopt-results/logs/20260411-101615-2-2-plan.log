{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PXZ58TNnuZWk5LH5ZjDxZm","type":"tool_result","content":"924\tpub unsafe fn zerocheck_ntt_eval_constraints(\n925\t    tmp_sums_buffer: &mut DeviceBuffer<EF>,\n926\t    output: &mut DeviceBuffer<EF>,\n927\t    selectors_cube: &DeviceBuffer<F>,\n928\t    preprocessed: *const F,\n929\t    main_ptrs: &DeviceBuffer<*const F>,\n930\t    eq_cube: *const EF,\n931\t    lambda_pows: &DeviceBuffer<EF>,\n932\t    public_values: &DeviceBuffer<F>,\n933\t    rules: &DeviceBuffer<u128>,\n934\t    used_nodes: &DeviceBuffer<usize>,\n935\t    buffer_size: u32,\n936\t    intermediates: &mut DeviceBuffer<F>,\n937\t    skip_domain: u32,\n938\t    num_x: u32,\n939\t    height: u32,\n940\t    num_cosets: u32,\n941\t    g_shift: F,\n942\t    max_temp_bytes: usize,\n943\t) -> Result<(), CudaError> {\n944\t    CudaError::from_result(_zerocheck_ntt_eval_constraints(\n945\t        tmp_sums_buffer.as_mut_ptr(),\n946\t        output.as_mut_ptr(),\n947\t        selectors_cube.as_ptr(),\n948\t        preprocessed,\n949\t        main_ptrs.as_ptr(),\n950\t        eq_cube,\n951\t        lambda_pows.as_ptr(),\n952\t        public_values.as_ptr(),\n953\t        rules.as_raw_ptr(),\n954\t        rules.len(),\n955\t        used_nodes.as_ptr(),\n956\t        used_nodes.len(),\n957\t        lambda_pows.len(),\n958\t        buffer_size,\n959\t        intermediates.as_mut_ptr(),\n960\t        skip_domain,\n961\t        num_x,\n962\t        height,\n963\t        num_cosets,\n964\t        g_shift,\n965\t        max_temp_bytes,\n966\t    ))\n967\t}\n968\t\n969\t/// # Safety\n970\t/// - `buffer_size` does not refer to the capacity of `intermediates`. It refers to \"how many DAG\n971\t///   nodes per row need to be buffered\". The capacity is a multiple of `buffer_size` which is\n972\t///   runtime calculated based on `buffer_size`.\n973\t/// - `eq_cube` must be a pointer to device buffer with at least `num_x` elements representing\n974\t///   evaluations on hypercube.\n975\t/// - `output` will not be written to by this function. Only `tmp_sums_buffer` is written.\n976\t#[allow(clippy::too_many_arguments)]\n977\tpub unsafe fn logup_bary_eval_interactions_round0(\n978\t    tmp_sums_buffer: &mut DeviceBuffer<Frac<EF>>,\n979\t    output: &mut DeviceBuffer<Frac<EF>>,\n980\t    selectors_cube: &DeviceBuffer<F>,\n981\t    preprocessed: *const F,\n982\t    main_ptrs: &DeviceBuffer<*const F>,\n983\t    eq_cube: *const EF,\n984\t    public_values: &DeviceBuffer<F>,\n985\t    numer_weights: &DeviceBuffer<EF>,\n986\t    denom_weights: &DeviceBuffer<EF>,\n987\t    denom_sum_init: EF,\n988\t    rules: &DeviceBuffer<u128>,\n989\t    buffer_size: u32,\n990\t    intermediates: &mut DeviceBuffer<F>,\n991\t    skip_domain: u32,\n992\t    num_x: u32,\n993\t    height: u32,\n994\t    num_cosets: u32,\n995\t    g_shift: F,\n996\t    max_temp_bytes: usize,\n997\t) -> Result<(), CudaError> {\n998\t    CudaError::from_result(_logup_bary_eval_interactions_round0(\n999\t        tmp_sums_buffer.as_mut_ptr(),\n1000\t        output.as_mut_ptr(),\n1001\t        selectors_cube.as_ptr(),\n1002\t        preprocessed,\n1003\t        main_ptrs.as_ptr(),\n1004\t        eq_cube,\n1005\t        public_values.as_ptr(),\n1006\t        numer_weights.as_ptr(),\n1007\t        denom_weights.as_ptr(),\n1008\t        denom_sum_init,\n1009\t        rules.as_raw_ptr(),\n1010\t        rules.len(),\n1011\t        buffer_size,\n1012\t        intermediates.as_mut_ptr(),\n1013\t        skip_domain,\n1014\t        num_x,\n1015\t        height,\n1016\t        num_cosets,\n1017\t        g_shift,\n1018\t        max_temp_bytes,\n1019\t    ))\n1020\t}\n1021\t\n1022\t/// Evaluate zerocheck MLE constraints on GPU with raw device pointers.\n1023\t#[allow(clippy::too_many_arguments)]\n1024\tpub unsafe fn zerocheck_eval_mle(\n1025\t    tmp_sums_buffer: &mut DeviceBuffer<EF>,\n1026\t    output: &mut DeviceBuffer<EF>,\n1027\t    eq_xi: *const EF,\n1028\t    selectors: *const EF,\n1029\t    preprocessed: MainMatrixPtrs<EF>,\n1030\t    main_ptrs: *const MainMatrixPtrs<EF>,\n1031\t    lambda_pows: *const EF,\n1032\t    lambda_len: usize,\n1033\t    public_values: *const F,\n1034\t    rules: *const std::ffi::c_void,\n1035\t    rules_len: usize,\n1036\t    used_nodes: *const usize,\n1037\t    used_nodes_len: usize,\n1038\t    buffer_size: u32,\n1039\t    intermediates: &mut DeviceBuffer<EF>,\n1040\t    num_y: u32,\n1041\t    num_x: u32,\n1042\t) -> Result<(), CudaError> {\n1043\t    CudaError::from_result(_zerocheck_eval_mle(\n1044\t        tmp_sums_buffer.as_mut_ptr(),\n1045\t        output.as_mut_ptr(),\n1046\t        eq_xi,\n1047\t        selectors,\n1048\t        preprocessed,\n1049\t        main_ptrs,\n1050\t        lambda_pows,\n1051\t        public_values,\n1052\t        rules,\n1053\t        rules_len,\n1054\t        used_nodes,\n1055\t        used_nodes_len,\n1056\t        lambda_len,\n1057\t        buffer_size,\n1058\t        intermediates.as_mut_ptr(),\n1059\t        num_y,\n1060\t        num_x,\n1061\t    ))\n1062\t}\n1063\t\n1064\t#[allow(clippy::too_many_arguments)]\n1065\tpub unsafe fn zerocheck_batch_eval_mle(\n1066\t    tmp_sums_buffer: &mut DeviceBuffer<EF>,\n1067\t    output: &mut DeviceBuffer<EF>,\n1068\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n1069\t    zc_ctxs: &DeviceBuffer<ZerocheckCtx>,\n1070\t    air_block_offsets: &DeviceBuffer<u32>,\n1071\t    lambda_pows: &DeviceBuffer<EF>,\n1072\t    lambda_len: usize,\n1073\t    num_blocks: u32,"}]},"parent_tool_use_id":"toolu_014XtXXF1SQVXnzmnT8hNbkR","session_id":"eca100d0-d51d-440d-9172-4b67f2ccfe84","uuid":"9e2004eb-c084-46cc-bf40-9949bcef55a7","timestamp":"2026-04-11T08:32:47.804Z"}
