{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015VCKaoSsSxCsT8QQvXUsSW","type":"tool_result","content":"1\t#include <algorithm>\n2\t#include <cassert>\n3\t#include <cmath>\n4\t#include <cstdint>\n5\t#include <cstdio>\n6\t#include <cstdlib>\n7\t#include <utility>\n8\t#include <vector_types.h>\n9\t\n10\t#include \"codec.cuh\"\n11\t#include \"dag_entry.cuh\"\n12\t#include \"eval_config.cuh\"\n13\t#include \"fp.h\"\n14\t#include \"fpext.h\"\n15\t#include \"launcher.cuh\"\n16\t#include \"sumcheck.cuh\"\n17\t#include \"utils.cuh\"\n18\t\n19\tusing namespace symbolic_dag;\n20\t\n21\tnamespace zerocheck_round0 {\n22\t\n23\tconstexpr uint32_t BUFFER_THRESHOLD = 16;\n24\t// Threshold for switching between coset-parallel and lockstep modes.\n25\t// When num_x * skip_domain < threshold, use coset-parallel (grid.y = num_cosets) for better GPU utilization.\n26\t// When >= threshold, use lockstep (single thread handles all cosets) to avoid redundant iNTT.\n27\tconstexpr uint32_t COSET_PARALLEL_THRESHOLD = 32768; // 2^15\n28\t\n29\t// Device function to compute constraint sums for all cosets in lockstep with DAG traversal.\n30\t// This computes: sum(lambda_i * constraint_i) for all constraints, for each coset.\n31\t// NOTE: Using __inline__ instead of __forceinline__ to let compiler decide based on register pressure.\n32\ttemplate <uint32_t NUM_COSETS, bool NEEDS_SHMEM>\n33\t__device__ __inline__ void acc_constraints(\n34\t    FpExt *__restrict__ constraint_sums, // output [NUM_COSETS]\n35\t    const NttEvalContext<NUM_COSETS> &eval_ctx,\n36\t    const Fp *is_first, // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n37\t    const Fp *is_last,  // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n38\t    uint32_t x_int,\n39\t    const FpExt *__restrict__ d_lambda_pows,\n40\t    const Rule *__restrict__ d_rules,\n41\t    size_t rules_len,\n42\t    const size_t *__restrict__ d_used_nodes,\n43\t    size_t used_nodes_len,\n44\t    size_t lambda_len\n45\t) {\n46\t    size_t lambda_idx = 0;\n47\t\n48\t    // Initialize constraint sums to zero\n49\t#pragma unroll\n50\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n51\t        constraint_sums[c] = FpExt(Fp::zero());\n52\t    }\n53\t\n54\t    for (size_t node = 0; node < rules_len; ++node) {\n55\t        Rule rule = d_rules[node];\n56\t        // Lazy decoding: only decode header (op, flags, x) upfront\n57\t        RuleHeader header = decode_rule_header(rule);\n58\t\n59\t        // Evaluate x operand for all cosets\n60\t        Fp x_vals[NUM_COSETS];\n61\t        ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(x_vals, header.x, eval_ctx, is_first, is_last, x_int);\n62\t\n63\t        switch (header.op) {\n64\t        case OP_ADD: {\n65\t            // Decode y only for binary ops\n66\t            SourceInfo y_src = decode_y(rule);\n67\t            Fp y_vals[NUM_COSETS];\n68\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n69\t#pragma unroll\n70\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n71\t                x_vals[c] += y_vals[c];\n72\t            }\n73\t            break;\n74\t        }\n75\t        case OP_SUB: {\n76\t            SourceInfo y_src = decode_y(rule);\n77\t            Fp y_vals[NUM_COSETS];\n78\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n79\t#pragma unroll\n80\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n81\t                x_vals[c] -= y_vals[c];\n82\t            }\n83\t            break;\n84\t        }\n85\t        case OP_MUL: {\n86\t            SourceInfo y_src = decode_y(rule);\n87\t            Fp y_vals[NUM_COSETS];\n88\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n89\t#pragma unroll\n90\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n91\t                x_vals[c] *= y_vals[c];\n92\t            }\n93\t            break;\n94\t        }\n95\t        case OP_NEG:\n96\t#pragma unroll\n97\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n98\t                x_vals[c] = -x_vals[c];\n99\t            }\n100\t            break;\n101\t        case OP_VAR:\n102\t            break;\n103\t        case OP_INV:\n104\t#pragma unroll\n105\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n106\t                x_vals[c] = inv(x_vals[c]);\n107\t            }\n108\t            break;\n109\t        }\n110\t\n111\t        // Store intermediate results for all cosets\n112\t        // Decode z_index only when buffering\n113\t        if (header.buffer_result && eval_ctx.buffer_size > 0) {\n114\t            uint32_t z_index = decode_z_index(rule);\n115\t#ifdef CUDA_DEBUG\n116\t            assert(z_index < eval_ctx.buffer_size);\n117\t#endif\n118\t            // Intermediate buffer layout: [buffer_size][NUM_COSETS] per thread\n119\t#pragma unroll\n120\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n121\t                eval_ctx.inter_buffer[z_index * eval_ctx.buffer_stride + c] = x_vals[c];\n122\t            }\n123\t        }\n124\t\n125\t        // Accumulate constraint sums\n126\t        if (header.is_constraint) {\n127\t            while (lambda_idx < lambda_len && lambda_idx < used_nodes_len &&\n128\t                   d_used_nodes[lambda_idx] == node) {\n129\t                FpExt lambda = d_lambda_pows[lambda_idx];\n130\t                lambda_idx++;\n131\t#pragma unroll\n132\t                for (uint32_t c = 0; c < NUM_COSETS; c++) {\n133\t                    constraint_sums[c] += lambda * x_vals[c];\n134\t                }\n135\t            }\n136\t        }\n137\t    }\n138\t}\n139\t\n140\t// NTT-based kernel: Each thread handles ALL cosets in lockstep.\n141\t// Grid: (num_x_blocks, 1) - no coset dimension\n142\t// Block: (skip_domain * x_per_block)\n143\t// Thread layout: ntt_idx = threadIdx.x % skip_domain, varies fastest\n144\t//\n145\t// Key optimization: iNTT is done ONCE per trace access, then coefficient is\n146\t// used for all coset shifts + forward NTTs.\n147\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n148\t__global__ void zerocheck_ntt_evaluate_constraints_kernel(\n149\t    FpExt *__restrict__ tmp_sums_buffer,   // [num_blocks][NUM_COSETS][skip_domain]\n150\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n151\t    const Fp *__restrict__ preprocessed,\n152\t    const Fp *const *__restrict__ main_parts,\n153\t    const FpExt *__restrict__ eq_cube, // [num_x]\n154\t    const FpExt *__restrict__ d_lambda_pows,\n155\t    const Fp *__restrict__ public_values,\n156\t    const Rule *__restrict__ d_rules,\n157\t    size_t rules_len,\n158\t    const size_t *__restrict__ d_used_nodes,\n159\t    size_t used_nodes_len,\n160\t    size_t lambda_len,\n161\t    uint32_t buffer_size,\n162\t    Fp *__restrict__ d_intermediates,\n163\t    uint32_t skip_domain,\n164\t    uint32_t num_x,\n165\t    uint32_t height,\n166\t    Fp g_shift\n167\t) {\n168\t    extern __shared__ char smem[];\n169\t    // Shared memory layout:\n170\t    // - FpExt[blockDim.x]: shared_sum for reduction (reused per coset)\n171\t    // - Fp[blockDim.x]: ntt_buffers (one skip_domain-sized buffer per x_int group, only when NEEDS_SHMEM)\n172\t    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem);\n173\t    Fp *ntt_buffers_base =\n174\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FpExt)) : nullptr;\n175\t\n176\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n177\t\n178\t    // Each x_int group within the block gets its own ntt_buffer slice\n179\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n180\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n181\t\n182\t    // Thread layout: ntt_idx varies fastest, then x_int\n183\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n184\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n185\t    uint32_t const x_int_base = tidx >> l_skip;\n186\t\n187\t    // Precompute values needed for all cosets\n188\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n189\t\n190\t    // Compute is_first_mult, is_last_mult for all cosets\n191\t    uint32_t const log_height_total = __ffs(height) - 1;\n192\t    uint32_t const log_segment = min(l_skip, log_height_total);\n193\t    uint32_t const segment_size = 1u << log_segment;\n194\t    uint32_t const log_stride = l_skip - log_segment;\n195\t\n196\t    Fp is_first_mult[NUM_COSETS];\n197\t    Fp is_last_mult[NUM_COSETS];\n198\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n199\t    Fp const omega_skip_ntt =\n200\t        (l_skip == 0) ? Fp::one() : device_ntt::get_twiddle(l_skip, ntt_idx);\n201\t\n202\t    Fp g_coset = g_shift; // g^1, will iterate g^2, g^3, ...\n203\t#pragma unroll\n204\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n205\t        Fp eval_point = g_coset * omega_skip_ntt;\n206\t        Fp omega = exp_power_of_2(eval_point, log_stride);\n207\t        is_first_mult[c] = avg_gp(omega, segment_size);\n208\t        is_last_mult[c] = avg_gp(omega * eta, segment_size);\n209\t        g_coset *= g_shift; // g^(c+2) for next iteration\n210\t    }\n211\t\n212\t    // Intermediate buffer setup\n213\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD * NUM_COSETS];\n214\t    Fp *inter_buffer;\n215\t    uint32_t buffer_stride;\n216\t    if constexpr (GLOBAL) {\n217\t        // Layout: [buffer_size][num_threads][NUM_COSETS]\n218\t        inter_buffer = d_intermediates + tidx * NUM_COSETS;\n219\t        buffer_stride = gridDim.x * blockDim.x * NUM_COSETS;\n220\t    } else {\n221\t        inter_buffer = local_buffer;\n222\t        buffer_stride = NUM_COSETS;\n223\t    }\n224\t\n225\t    // Accumulate sums for all cosets\n226\t    FpExt sums[NUM_COSETS] = {};\n227\t\n228\t    // blockDim.x is guaranteed to be a multiple of 2^l_skip\n229\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n230\t\n231\t    // Initialize eval_ctx once with loop-invariant fields\n232\t    NttEvalContext<NUM_COSETS> eval_ctx{\n233\t        preprocessed,\n234\t        main_parts,\n235\t        public_values,\n236\t        inter_buffer,\n237\t        ntt_buffer,\n238\t        {}, // omega_shifts - set once below\n239\t        skip_domain,\n240\t        height,\n241\t        buffer_stride,\n242\t        buffer_size,\n243\t        ntt_idx,\n244\t    };\n245\t    // Compute omega_shifts directly into context using iterative multiplication\n246\t    Fp const omega_shift_base = pow(g_shift, ntt_idx_rev);\n247\t    Fp omega_shift = omega_shift_base;\n248\t#pragma unroll\n249\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n250\t        eval_ctx.omega_shifts[c] = omega_shift;\n251\t        omega_shift *= omega_shift_base;\n252\t    }\n253\t\n254\t    // Tile across x_int to save intermediate buffer size\n255\t    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n256\t        // Compute per-iteration selectors as fresh local values\n257\t        Fp is_first[NUM_COSETS];\n258\t        Fp is_last[NUM_COSETS];\n259\t#pragma unroll\n260\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n261\t            is_first[c] = is_first_mult[c] * selectors_cube[x_int];\n262\t            is_last[c] = is_last_mult[c] * selectors_cube[2 * num_x + x_int];\n263\t        }\n264\t\n265\t        FpExt constraint_sums[NUM_COSETS];\n266\t        acc_constraints<NUM_COSETS, NEEDS_SHMEM>(\n267\t            constraint_sums,\n268\t            eval_ctx,\n269\t            is_first,\n270\t            is_last,\n271\t            x_int,\n272\t            d_lambda_pows,\n273\t            d_rules,\n274\t            rules_len,\n275\t            d_used_nodes,\n276\t            used_nodes_len,\n277\t            lambda_len\n278\t        );\n279\t\n280\t        FpExt eq = eq_cube[x_int];\n281\t#pragma unroll\n282\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n283\t            sums[c] += constraint_sums[c] * eq;\n284\t        }\n285\t    }\n286\t\n287\t    // Reduction: one coset at a time to minimize shared memory\n288\t    // Recompute eval_point and zerofier on demand (saves registers during main loop)\n289\t    g_coset = g_shift; // reset to g^1\n290\t#pragma unroll\n291\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n292\t        Fp eval_point = g_coset * omega_skip_ntt;\n293\t        Fp zerofier = exp_power_of_2(eval_point, l_skip) - Fp::one();\n294\t\n295\t        // We assume g_shift is not in skip domain and since we use (c+1) power,\n296\t        // eval_point is never in skip domain. Hence zerofier is never zero.\n297\t        shared_sum[threadIdx.x] = sums[c] * inv(zerofier);\n298\t        __syncthreads();\n299\t\n300\t        if (threadIdx.x < skip_domain) {"}]},"parent_tool_use_id":"toolu_014XtXXF1SQVXnzmnT8hNbkR","session_id":"eca100d0-d51d-440d-9172-4b67f2ccfe84","uuid":"533c186e-bc5c-4607-9c9e-ccb38e868e83","timestamp":"2026-04-11T08:32:35.947Z"}
