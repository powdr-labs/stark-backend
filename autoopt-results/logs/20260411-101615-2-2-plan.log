{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01475QTkHpEk6ycBhdEhuqrn","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    sync::Arc,\n15\t};\n16\t\n17\tuse itertools::{izip, Itertools};\n18\tuse openvm_cuda_common::{\n19\t    copy::{MemCopyD2H, MemCopyH2D},\n20\t    d_buffer::DeviceBuffer,\n21\t    error::MemCopyError,\n22\t    memory_manager::MemTracker,\n23\t    stream::current_stream_sync,\n24\t};\n25\tuse openvm_stark_backend::{\n26\t    air_builders::symbolic::SymbolicConstraints,\n27\t    calculate_n_logup,\n28\t    dft::Radix2BowersSerial,\n29\t    p3_matrix::dense::RowMajorMatrix,\n30\t    poly_common::{\n31\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n32\t        UnivariatePoly,\n33\t    },\n34\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n35\t    prover::{\n36\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n37\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, DeviceMultiStarkProvingKey,\n38\t        MatrixDimensions, ProvingContext,\n39\t    },\n40\t};\n41\tuse p3_dft::TwoAdicSubgroupDft;\n42\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n43\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n44\tuse rustc_hash::FxHashMap;\n45\tuse tracing::{debug, info, info_span, instrument};\n46\t\n47\tuse crate::{\n48\t    base::DeviceMatrix,\n49\t    cuda::{\n50\t        logup_zerocheck::{fold_selectors_round0, interpolate_columns_gpu, MainMatrixPtrs},\n51\t        sumcheck::batch_fold_mle,\n52\t    },\n53\t    data_transporter::transport_matrix_d2h_col_major,\n54\t    error::LogupZerocheckError,\n55\t    gpu_backend::GenericGpuBackend,\n56\t    hash_scheme::GpuHashScheme,\n57\t    logup_zerocheck::{\n58\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n59\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n60\t    },\n61\t    poly::EqEvalLayers,\n62\t    prelude::{EF, F},\n63\t    sponge::GpuFiatShamirTranscript,\n64\t    utils::compute_barycentric_inv_lagrange_denoms,\n65\t};\n66\t\n67\tpub(crate) mod batch_mle;\n68\tpub(crate) mod batch_mle_monomial;\n69\tmod errors;\n70\tpub(crate) mod fold_ple;\n71\t/// Fraction sumcheck via GKR\n72\tmod fractional;\n73\t/// Logup interaction evaluations for GKR input\n74\tmod gkr_input;\n75\tmod mle_round;\n76\tmod round0;\n77\tpub(crate) mod rules;\n78\t\n79\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n80\tuse batch_mle_monomial::{\n81\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n82\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n83\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n84\t};\n85\tpub use errors::*;\n86\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n87\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n88\tuse round0::evaluate_round0_constraints_gpu;\n89\t\n90\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n91\t/// instead of the monomial kernel for high num_y traces.\n92\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n93\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n94\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n95\t\n96\t#[inline]\n97\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n98\t    if need_rot {\n99\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n100\t        (mat_width / 2) as u32\n101\t    } else {\n102\t        mat_width as u32\n103\t    }\n104\t}\n105\t\n106\t#[allow(clippy::type_complexity)]\n107\t#[instrument(level = \"info\", skip_all)]\n108\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n109\t    transcript: &mut TS,\n110\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n111\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n112\t    save_memory: bool,\n113\t    monomial_num_y_threshold: u32,\n114\t    sm_count: u32,\n115\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n116\twhere\n117\t    HS: GpuHashScheme,\n118\t    TS: GpuFiatShamirTranscript<HS::SC>,\n119\t{\n120\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n121\t    let l_skip = mpk.params.l_skip;\n122\t    let constraint_degree = mpk.max_constraint_degree;\n123\t    let num_traces = ctx.per_trace.len();\n124\t\n125\t    // Traces are sorted\n126\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n127\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n128\t    // heights\n129\t    let mut total_interactions = 0u64;\n130\t    let interactions_meta: Vec<_> = ctx\n131\t        .per_trace\n132\t        .iter()\n133\t        .map(|(air_idx, air_ctx)| {\n134\t            let pk = &mpk.per_air[*air_idx];\n135\t\n136\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n137\t            let height = air_ctx.common_main.height();\n138\t            let log_height = log2_strict_usize(height);\n139\t            let log_lifted_height = log_height.max(l_skip);\n140\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n141\t            (num_interactions, log_lifted_height)\n142\t        })\n143\t        .collect();\n144\t    // Implicitly, the width of this stacking should be 1\n145\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n146\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n147\t    // GKR\n148\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n149\t\n150\t    // Grind to increase soundness of random sampling for LogUp\n151\t    let logup_pow_witness = transcript\n152\t        .grind_gpu(mpk.params.logup.pow_bits)\n153\t        .map_err(LogupZerocheckError::Grind)?;\n154\t    let alpha_logup = transcript.sample_ext();\n155\t    let beta_logup = transcript.sample_ext();\n156\t    debug!(%alpha_logup, %beta_logup);\n157\t\n158\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n159\t    let mut prover = LogupZerocheckGpu::new(\n160\t        mpk,\n161\t        ctx,\n162\t        n_logup,\n163\t        interactions_layout,\n164\t        alpha_logup,\n165\t        beta_logup,\n166\t        save_memory,\n167\t        monomial_num_y_threshold,\n168\t        sm_count,\n169\t    )?;\n170\t    let n_global = prover.n_global;\n171\t\n172\t    let total_leaves = 1 << (l_skip + n_logup);\n173\t    prover\n174\t        .mem\n175\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n176\t    prover.mem.reset_peak();\n177\t    let (inputs, alpha) = if has_interactions {\n178\t        log_gkr_input_evals(\n179\t            &prover.trace_interactions,\n180\t            mpk,\n181\t            ctx,\n182\t            l_skip,\n183\t            alpha_logup,\n184\t            &prover.d_challenges,\n185\t            total_leaves,\n186\t        )?\n187\t    } else {\n188\t        (DeviceBuffer::new(), EF::ZERO)\n189\t    };\n190\t    // Set memory limit for batch MLE based on inputs buffer size\n191\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n192\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n193\t    if !prover.save_memory {\n194\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n195\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n196\t            tracing::warn!(\n197\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n198\t                prover.memory_limit_bytes\n199\t            );\n200\t        }"}]},"parent_tool_use_id":"toolu_014XtXXF1SQVXnzmnT8hNbkR","session_id":"eca100d0-d51d-440d-9172-4b67f2ccfe84","uuid":"ffcbe06c-22a2-4b39-9040-e93dde274bd9","timestamp":"2026-04-11T08:32:30.585Z"}
