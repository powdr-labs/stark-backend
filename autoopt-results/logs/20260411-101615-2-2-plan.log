n654\t\n655\t    // Final reduction: same as lockstep - sum across all x_int blocks for each (coset, ntt_idx)\n656\t    auto num_blocks = grid.x;\n657\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n658\t    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n659\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n660\t    sumcheck::final_reduce_block_sums<<<num_cosets * skip_domain, reduce_block, reduce_shmem>>>(\n661\t        tmp_sums_buffer, output, num_blocks\n662\t    );\n663\t\n664\t    return CHECK_KERNEL();\n665\t}\n666\t\n667\textern \"C\" int _zerocheck_ntt_eval_constraints(\n668\t    FpExt *tmp_sums_buffer,   // [num_blocks][num_cosets * skip_domain]\n669\t    FpExt *output,            // [num_cosets * skip_domain]"}]},"parent_tool_use_id":"toolu_01PYiTqpPJ12eM4UVA1LT5mv","session_id":"eca100d0-d51d-440d-9172-4b67f2ccfe84","uuid":"cc74c914-9c20-4a61-812f-e945ec1a53b2","timestamp":"2026-04-11T08:51:17.317Z"}
