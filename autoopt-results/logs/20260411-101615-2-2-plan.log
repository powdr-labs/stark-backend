pExt constraint_sums[1];\n433\t        acc_constraints<1, NEEDS_SHMEM>(\n434\t            constraint_sums,\n435\t            eval_ctx,\n436\t            &is_first,\n437\t            &is_last,\n438\t            x_int,\n439\t            d_lambda_pows,\n440\t            d_rules,\n441\t            rules_len,\n442\t            d_used_nodes,\n443\t            used_nodes_len,\n444\t            lambda_len\n445\t        );\n446\t\n447\t        sum += constraint_sums[0] * eq_cube[x_int];\n448\t    }\n449\t\n450\t    // Single-coset reduction (no loop over cosets)\n451\t    Fp zerofier = exp_power_of_2(eval_point, l_skip) - Fp::one();\n452\t    // We assume g_shift is not in skip domain and since we use (c+1) power,\n453\t    // eval_point is never in skip domain. Hence zerofier is never zero.\n454\t    shared_sum[threadIdx.x] = sum * inv(zerofier);\n455\t    __syncthreads();\n456\t\n457\t    if (threadIdx.x < skip_domain) {\n458\t        FpExt tile_sum = shared_sum[threadIdx.x];\n459\t        for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n460\t            tile_sum += shared_sum[(lane << l_skip) + threadIdx.x];\n461\t        }\n462\t        // Output layout: [num_x_blocks][num_cosets * skip_domain]\n463\t        // Same as lockstep to ensure final_reduce_block_sums works unchanged\n464\t        tmp_sums_buffer[blockIdx.x * num_cosets * skip_domain + coset_idx * skip_domain + ntt_idx] =\n465\t            tile_sum;\n466\t    }\n467\t}\n468\t\n469\t// ============================================================================\n470\t// LAUNCHERS\n471\t// ============================================================================\n472\tconstexpr uint32_t MAX_THREADS = 128;\n473\t\n474\t// Helper to determine which mode to use based on threshold\n475\tinline bool use_coset_parallel_mode(uint32_t num_x, uint32_t skip_domain) {\n476\t    return (num_x * skip_domain) < COSET_PARALLEL_THRESHOLD;\n477\t}\n478\t\n479\t// (Not a launcher) Utility function to calculate required size of temp sum buffer.\n480\t// Required length of *temp_sum_buffer in FpExt elements\n481\textern \"C\" size_t _zerocheck_r0_temp_sums_buffer_size(\n482\t    uint32_t buffer_size,\n483\t    uint32_t skip_domain,\n484\t    uint32_t num_x,\n485\t    uint32_t num_cosets,\n486\t    size_t max_temp_bytes\n487\t) {\n488\t    // Both modes use the same buffer size formula\n489\t    return DISPATCH_BOOL(\n490\t        round0_config_impl::temp_sums_buffer_size,\n491\t        use_coset_parallel_mode(num_x, skip_domain),\n492\t        buffer_size,\n493\t        skip_domain,\n494\t        num_x,\n495\t        num_cosets,\n496\t        max_temp_bytes,\n497\t        BUFFER_THRESHOLD,\n498\t        MAX_THREADS\n499\t    );\n500\t}\n501\t\n502\textern \"C\" size_t _zerocheck_r0_intermediates_buffer_size(\n503\t    uint32_t buffer_size,\n504\t    uint32_t skip_domain,\n505\t    uint32_t num_x,\n506\t    uint32_t num_cosets,\n507\t    size_t max_temp_bytes\n508\t) {\n509\t    // Both modes use the same buffer size formula\n510\t    return DISPATCH_BOOL(\n511\t        round0_config_impl::intermediates_buffer_size,\n512\t        use_coset_parallel_mode(num_x, skip_domain),\n513\t        buffer_size,\n514\t        skip_domain,\n515\t        num_x,\n516\t        num_cosets,\n517\t        max_temp_bytes,\n518\t        BUFFER_THRESHOLD,\n519\t        MAX_THREADS\n520\t    );\n521\t}\n522\t\n523\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n524\tint launch_zerocheck_ntt_evaluate_constraints(\n525\t    FpExt *tmp_sums_buffer,\n526\t    FpExt *output,\n527\t    const Fp *selectors_cube, // [3][num_x]\n528\t    const Fp *preprocessed,\n529\t    const Fp *const *main_parts,\n530\t    const FpExt *eq_cube, // [num_x]\n531\t    const FpExt *d_lambda_pows,\n532\t    const Fp *public_values,\n533\t    const Rule *d_rules,\n534\t    size_t rules_len,\n535\t    const size_t *d_used_nodes,\n536\t    size_t used_nodes_len,\n537\t    size_t lambda_len,\n538\t    uint32_t bu