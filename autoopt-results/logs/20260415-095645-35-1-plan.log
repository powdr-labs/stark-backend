ector\n102\t    {\n103\t        let mut packets = Vec::new();\n104\t        let mut total_stacked_width = 0u32;\n105\t        for stacked in &stacked_per_commit {\n106\t            let layout = stacked.layout();\n107\t            for (trace, &idx) in zip(&stacked.traces, &layout.mat_starts) {\n108\t                let (_, _, s) = layout.sorted_cols[idx];\n109\t                let packet = BatchingTracePacket {\n110\t                    ptr: trace.buffer().as_ptr(),\n111\t                    height: trace.height() as u32,\n112\t                    width: trace.width() as u32,\n113\t                    stacked_row_start: s.row_idx as u32,\n114\t                    mu_idx: total_stacked_width + s.col_idx as u32,\n115\t                };\n116\t                packets.push(packet);\n117\t            }\n118\t            total_stacked_width += layout.width() as u32;\n119\t        }\n120\t        let mu_powers = mu.powers().take(total_stacked_width as usize).collect_vec();\n121\t        let d_mu_powers = mu_powers.to_device()?;\n122\t        let d_packets = packets.to_device()?;\n123\t        // SAFETY:\n124\t        // - `mu_powers` has length `total_width`.\n125\t        // - `f_ple_evals` has capacity `height * D_EF` (stacked height in base coordinates).\n126\t        // - `d_packets` contain valid pointers and stacked row indices by construction.\n127\t        unsafe {\n128\t            whir_algebraic_batch_traces(&mut f_ple_evals, &d_packets, &d_mu_powers, 1 << l_skip)\n129\t                .map_err(WhirProverError::AlgebraicBatch)?;\n130\t        }\n131\t        for stacked in &mut stacked_per_commit {\n132\t            // drop traces to free device memory if RS codewords matrix exists\n133\t            if stacked.inner.tree.backing_matrix.is_some() {\n134\t                stacked.traces.clear();\n135\t            }\n136\t        }\n137\t    } // common_main_pcs_data.matrix has now been freed\n138\t\n139\t    // Compute \\hat{f} coefficients:\n140\t    //\n141\t    //