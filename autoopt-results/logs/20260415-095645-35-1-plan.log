{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XawP1Pxn2NDwXKP7fyN4Cc","type":"tool_result","content":"1\tuse std::{iter::once, sync::Arc};\n2\t\n3\tuse itertools::Itertools;\n4\tuse p3_dft::{Radix2DitParallel, TwoAdicSubgroupDft};\n5\tuse p3_field::{ExtensionField, Field, PrimeCharacteristicRing, TwoAdicField};\n6\tuse p3_maybe_rayon::prelude::*;\n7\tuse p3_util::log2_strict_usize;\n8\tuse tracing::instrument;\n9\t\n10\tuse crate::{\n11\t    poly_common::Squarable,\n12\t    proof::{MerkleProof, WhirProof},\n13\t    prover::{\n14\t        error::WhirProverError,\n15\t        poly::{eval_to_coeff_rs_message, evals_eq_hypercube, evals_mobius_eq_hypercube, Mle},\n16\t        stacked_pcs::{MerkleTree, StackedPcsData},\n17\t        ColMajorMatrix, CpuColMajorBackend, MatrixDimensions, ProverBackend, ReferenceDevice,\n18\t    },\n19\t    FiatShamirTranscript, StarkProtocolConfig, WhirConfig,\n20\t};\n21\t\n22\tpub trait WhirProver<SC: StarkProtocolConfig, PB: ProverBackend, PD, TS> {\n23\t    type Error;\n24\t\n25\t    /// Prove the WHIR protocol for a collection of MLE polynomials \\hat{q}_j, each in n variables,\n26\t    /// at a single vector `u \\in \\Fext^n`.\n27\t    ///\n28\t    /// This means applying WHIR with weight polynomial\n29\t    /// `\\hat{w}(Z, \\vec X) = Z * mobius_eq_poly(u)(\\vec X)`, where `mobius_eq_poly(u)` is the\n30\t    /// Möbius-adjusted equality polynomial for eval-to-coeff RS encoding.\n31\t    ///\n32\t    /// The matrices in `common_main_pcs_data` and `pre_cached_pcs_data_per_commit` must all have\n33\t    /// the same height.\n34\t    fn prove_whir(\n35\t        &self,\n36\t        transcript: &mut TS,\n37\t        common_main_pcs_data: PB::PcsData,\n38\t        pre_cached_pcs_data_per_commit: Vec<Arc<PB::PcsData>>,\n39\t        u_cube: &[PB::Challenge],\n40\t    ) -> Result<WhirProof<SC>, Self::Error>;\n41\t}\n42\t\n43\timpl<SC, TS> WhirProver<SC, CpuColMajorBackend<SC>, ReferenceDevice<SC>, TS> for ReferenceDevice<SC>\n44\twhere\n45\t    SC: StarkProtocolConfig,\n46\t    SC::F: TwoAdicField + Ord,\n47\t    SC::EF: TwoAdicField + ExtensionField<SC::F> + Ord,\n48\t    TS: FiatShamirTranscript<SC>,\n49\t{\n50\t    type Error = WhirProverError;\n51\t\n52\t    #[instrument(level = \"info\", skip_all)]\n53\t    fn prove_whir(\n54\t        &self,\n55\t        transcript: &mut TS,\n56\t        common_main_pcs_data: StackedPcsData<SC::F, SC::Digest>,\n57\t        pre_cached_pcs_data_per_commit: Vec<Arc<StackedPcsData<SC::F, SC::Digest>>>,\n58\t        u_cube: &[SC::EF],\n59\t    ) -> Result<WhirProof<SC>, WhirProverError> {\n60\t        let params = self.params();\n61\t        let committed_mats = once(&common_main_pcs_data)\n62\t            .chain(pre_cached_pcs_data_per_commit.iter().map(|d| d.as_ref()))\n63\t            .map(|d| (&d.matrix, &d.tree))\n64\t            .collect_vec();\n65\t        prove_whir_opening::<SC, _>(\n66\t            transcript,\n67\t            self.config().hasher(),\n68\t            params.l_skip,\n69\t            params.log_blowup,\n70\t            &params.whir,\n71\t            &committed_mats,\n72\t            u_cube,\n73\t        )\n74\t    }\n75\t}\n76\t\n77\t#[allow(clippy::too_many_arguments, clippy::type_complexity)]\n78\tpub fn prove_whir_opening<SC, TS>(\n79\t    transcript: &mut TS,\n80\t    hasher: &SC::Hasher,\n81\t    l_skip: usize,\n82\t    log_blowup: usize,\n83\t    whir_params: &WhirConfig,\n84\t    committed_mats: &[(&ColMajorMatrix<SC::F>, &MerkleTree<SC::F, SC::Digest>)],\n85\t    u: &[SC::EF],\n86\t) -> Result<WhirProof<SC>, WhirProverError>\n87\twhere\n88\t    SC: StarkProtocolConfig,\n89\t    SC::F: TwoAdicField + Ord,\n90\t    SC::EF: TwoAdicField + ExtensionField<SC::F> + Ord,\n91\t    TS: FiatShamirTranscript<SC>,\n92\t{\n93\t    // Proof-of-work grinding before μ batching challenge.\n94\t    // This amplifies soundness of the initial batching step.\n95\t    let mu_pow_witness = transcript.grind(whir_params.mu_pow_bits);\n96\t\n97\t    // Sample randomness for algebraic batching.\n98\t    // We batch the codewords for \\hat{q}_j together _before_ applying WHIR.\n99\t    let mu = transcript.sample_ext();\n100\t    let total_width = committed_mats.iter().map(|(mat, _)| mat.width()).sum();\n101\t    let mu_powers = mu.powers().take(total_width).collect_vec();\n102\t\n103\t    let height = committed_mats[0].0.height();\n104\t    debug_assert!(committed_mats.iter().all(|(mat, _)| mat.height() == height));\n105\t    let mut m = log2_strict_usize(height);\n106\t\n107\t    let k_whir = whir_params.k;\n108\t    let num_whir_rounds = whir_params.num_whir_rounds();\n109\t    let num_sumcheck_rounds = whir_params.num_sumcheck_rounds();\n110\t\n111\t    let mles: Vec<Vec<SC::F>> = committed_mats\n112\t        .par_iter()\n113\t        .flat_map(|(mat, _)| {\n114\t            mat.par_columns().map(|col| {\n115\t                // Convert column evaluations directly into eval-to-coeff RS coefficients, then\n116\t                // interpret them as MLE coefficients of HatF and compute HatF hypercube evals.\n117\t                let mut x = eval_to_coeff_rs_message(l_skip, col);\n118\t                Mle::coeffs_to_evals_inplace(&mut x);\n119\t                x\n120\t            })\n121\t        })\n122\t        .collect();\n123\t\n124\t    // The evaluations of `\\hat{f}` in the current WHIR round on the hypercube `H_m`.\n125\t    let mut f_evals: Vec<_> = (0..1 << m)\n126\t        .into_par_iter()\n127\t        .map(|i| {\n128\t            mles.iter()\n129\t                .zip(mu_powers.iter())\n130\t                .fold(SC::EF::ZERO, |acc, (mle_j, mu_j)| acc + *mu_j * mle_j[i])\n131\t        })\n132\t        .collect();\n133\t\n134\t    // We assume `\\hat{w}` in a WHIR round is always multilinear and maintain its\n135\t    // evaluations on `H_m`.\n136\t    let mut w_evals = evals_mobius_eq_hypercube(u);\n137\t\n138\t    let mut whir_sumcheck_polys: Vec<[SC::EF; 2]> = Vec::with_capacity(num_sumcheck_rounds);\n139\t    let mut codeword_commits = vec![];\n140\t    let mut ood_values = vec![];\n141\t    // per commitment, per whir query, per column\n142\t    let mut initial_round_opened_rows: Vec<Vec<Vec<Vec<SC::F>>>> =\n143\t        vec![vec![]; committed_mats.len()];\n144\t    let mut initial_round_merkle_proofs: Vec<Vec<MerkleProof<SC::Digest>>> =\n145\t        vec![vec![]; committed_mats.len()];\n146\t    let mut codeword_opened_values: Vec<Vec<Vec<SC::EF>>> = Vec::with_capacity(num_whir_rounds - 1);\n147\t    let mut codeword_merkle_proofs: Vec<Vec<MerkleProof<SC::Digest>>> =\n148\t        Vec::with_capacity(num_whir_rounds - 1);\n149\t    let mut folding_pow_witnesses = Vec::with_capacity(num_sumcheck_rounds);\n150\t    let mut query_phase_pow_witnesses = Vec::with_capacity(num_whir_rounds);\n151\t    let mut rs_tree = None;\n152\t    let mut log_rs_domain_size = m + log_blowup;\n153\t    let mut final_poly = None;\n154\t    for (whir_round, round_params) in whir_params.rounds.iter().enumerate() {\n155\t        let is_last_round = whir_round == num_whir_rounds - 1;\n156\t        // Run k_whir rounds of sumcheck on `sum_{x in H_m} \\hat{w}(\\hat{f}(x), x)`\n157\t        for round in 0..k_whir {\n158\t            debug_assert_eq!(f_evals.len(), 1 << (m - round));\n159\t\n160\t            // \\hat{f} * eq has degree 2\n161\t            let s_deg = 2;\n162\t            let s_evals = (1..=s_deg)\n163\t                .map(|x| {\n164\t                    let x = SC::F::from_usize(x);\n165\t                    let hypercube_dim = m - round - 1;\n166\t                    (0..(1usize << hypercube_dim))\n167\t                        .map(|y| {\n168\t                            let f_0 = f_evals[y << 1];\n169\t                            let f_1 = f_evals[(y << 1) + 1];\n170\t                            let f_x = f_0 + (f_1 - f_0) * x;\n171\t                            let w_0 = w_evals[y << 1];\n172\t                            let w_1 = w_evals[(y << 1) + 1];\n173\t                            let w_x = w_0 + (w_1 - w_0) * x;\n174\t                            f_x * w_x\n175\t                        })\n176\t                        .fold(SC::EF::ZERO, |acc, x| acc + x)\n177\t                })\n178\t                .collect_vec();\n179\t\n180\t            for &eval in &s_evals {\n181\t                transcript.observe_ext(eval);\n182\t            }\n183\t            whir_sumcheck_polys.push(\n184\t                s_evals\n185\t                    .try_into()\n186\t                    .map_err(|_| WhirProverError::TryIntoFailed)?,\n187\t            );\n188\t\n189\t            folding_pow_witnesses.push(transcript.grind(whir_params.folding_pow_bits));\n190\t            // Folding randomness\n191\t            let alpha = transcript.sample_ext();\n192\t\n193\t            // Fold the evaluations\n194\t            let half = f_evals.len() / 2;\n195\t            for y in 0..half {\n196\t                let eval_0 = f_evals[y << 1];\n197\t                let eval_1 = f_evals[(y << 1) + 1];\n198\t                // Linear interpolation at r_round\n199\t                f_evals[y] = eval_0 + alpha * (eval_1 - eval_0);\n200\t\n201\t                let eval_0 = w_evals[y << 1];\n202\t                let eval_1 = w_evals[(y << 1) + 1];\n203\t                w_evals[y] = eval_0 + alpha * (eval_1 - eval_0);\n204\t            }\n205\t            f_evals.truncate(half);\n206\t            w_evals.truncate(half);\n207\t        }\n208\t        // Define g^ = f^(alpha, \\cdot) and send matrix commit of RS(g^)\n209\t        // f_evals is the evaluations of f^(alpha, \\cdot) on hypercube\n210\t        let g_mle = Mle::from_evaluations(&f_evals);\n211\t        let (g_tree, z_0) = if !is_last_round {\n212\t            let dft = Radix2DitParallel::default();\n213\t            let mut g_coeffs = g_mle.coeffs().to_vec();\n214\t            debug_assert_eq!(g_coeffs.len(), 1 << (m - k_whir));\n215\t            g_coeffs.resize(1 << (log_rs_domain_size - 1), SC::EF::ZERO);\n216\t            // `g: \\mathcal{L}^{(2)} \\to \\mathbb F`\n217\t            let g_rs = dft.dft(g_coeffs);\n218\t            let g_tree = MerkleTree::new(hasher, ColMajorMatrix::new(g_rs, 1), 1 << k_whir)?;\n219\t            let g_commit = g_tree.root()?;\n220\t            transcript.observe_commit(g_commit);\n221\t            codeword_commits.push(g_commit);\n222\t\n223\t            let z_0 = transcript.sample_ext();\n224\t            let z_0_vec = z_0.exp_powers_of_2().take(m - k_whir).collect_vec();\n225\t            let g_opened_value = g_mle.eval_at_point(&z_0_vec);\n226\t            transcript.observe_ext(g_opened_value);\n227\t            ood_values.push(g_opened_value);\n228\t\n229\t            (Some(g_tree), Some(z_0))\n230\t        } else {\n231\t            let coeffs = g_mle.into_coeffs();\n232\t            for coeff in &coeffs {\n233\t                transcript.observe_ext(*coeff);\n234\t            }\n235\t            final_poly = Some(coeffs);\n236\t            (None, None)\n237\t        };\n238\t\n239\t        // omega is generator of RS domain `\\mathcal{L}^{(2^k)}`\n240\t        let omega = SC::F::two_adic_generator(log_rs_domain_size - k_whir);\n241\t        let num_queries = round_params.num_queries;\n242\t        let mut query_indices = Vec::with_capacity(num_queries);\n243\t        query_phase_pow_witnesses.push(transcript.grind(whir_params.query_phase_pow_bits));\n244\t        // Sample query indices first\n245\t        for _ in 0..num_queries {\n246\t            // This is the index of the leaf in the Merkle tree\n247\t            let index = transcript.sample_bits(log_rs_domain_size - k_whir);\n248\t            query_indices.push(index as usize);\n249\t        }\n250\t        let mut zs = Vec::with_capacity(num_queries);\n251\t        if !is_last_round {\n252\t            codeword_opened_values.push(vec![]);\n253\t            codeword_merkle_proofs.push(vec![]);\n254\t        }\n255\t        for (query_idx, index) in query_indices.into_iter().enumerate() {\n256\t            let z_i = omega.exp_u64(index as u64);\n257\t            // Get merkle proofs for in-domain samples necessary to evaluate Fold(f, \\vec\n258\t            // \\alpha)(z_i)\n259\t            zs.push(z_i);\n260\t\n261\t            let depth = log_rs_domain_size.saturating_sub(k_whir);\n262\t            // Row openings are different between first WHIR round (width > 1) and other rounds\n263\t            // (width = 1):\n264\t            // NOTE: merkle proof is deterministic from the index and merkle root, so the opened_row\n265\t            // and merkle proof are both hinted and not observed by the transcript.\n266\t            if whir_round == 0 {\n267\t                #[allow(clippy::needless_range_loop)]\n268\t                for com_idx in 0..committed_mats.len() {\n269\t                    debug_assert_eq!(initial_round_merkle_proofs[com_idx].len(), query_idx);\n270\t                    let tree = &committed_mats[com_idx].1;\n271\t                    let tree_height = tree.backing_matrix.height();\n272\t                    let expected = 1 << log_rs_domain_size;\n273\t                    if tree_height != expected {\n274\t                        return Err(WhirProverError::TreeHeightMismatch {\n275\t                            tree_height,\n276\t                            expected,\n277\t                        });\n278\t                    }\n279\t                    let opened_rows = tree.get_opened_rows(index)?;\n280\t                    initial_round_opened_rows[com_idx].push(opened_rows);\n281\t                    debug_assert_eq!(tree.proof_depth(), depth);\n282\t                    let proof = tree.query_merkle_proof(index)?;\n283\t                    debug_assert_eq!(proof.len(), depth);\n284\t                    initial_round_merkle_proofs[com_idx].push(proof);\n285\t                }\n286\t            } else {\n287\t                let tree: &MerkleTree<SC::EF, SC::Digest> =\n288\t                    rs_tree.as_ref().ok_or(WhirProverError::RsTreeNone)?;\n289\t                let width = tree.backing_matrix.width();\n290\t                if width != 1 {\n291\t                    return Err(WhirProverError::TreeWidthNotOne { width });\n292\t                }\n293\t                let opened_rows = tree\n294\t                    .get_opened_rows(index)?\n295\t                    .into_iter()\n296\t                    .flatten()\n297\t                    .collect_vec();\n298\t                codeword_opened_values[whir_round - 1].push(opened_rows);\n299\t                debug_assert_eq!(tree.proof_depth(), depth);\n300\t                let proof = tree.query_merkle_proof(index)?;\n301\t                debug_assert_eq!(proof.len(), depth);\n302\t                codeword_merkle_proofs[whir_round - 1].push(proof);\n303\t            }\n304\t        }\n305\t        rs_tree = g_tree;\n306\t\n307\t        // We still sample on the last round to match the verifier, who uses a\n308\t        // final gamma to unify some logic. But we do not need to update\n309\t        // `w_evals`.\n310\t        let gamma = transcript.sample_ext();\n311\t\n312\t        if !is_last_round {\n313\t            // Update \\hat{w}\n314\t            w_evals_accumulate::<SC::EF, SC::EF>(\n315\t                &mut w_evals,\n316\t                z_0.ok_or(WhirProverError::Z0None)?,\n317\t                gamma,\n318\t            );\n319\t            for (z_i, gamma_pow) in zs.into_iter().zip(gamma.powers().skip(2)) {\n320\t                w_evals_accumulate::<SC::F, SC::EF>(&mut w_evals, z_i, gamma_pow);\n321\t            }\n322\t        }\n323\t\n324\t        m -= k_whir;\n325\t        log_rs_domain_size -= 1;\n326\t    }\n327\t\n328\t    Ok(WhirProof::<SC> {\n329\t        mu_pow_witness,\n330\t        whir_sumcheck_polys,\n331\t        codeword_commits,\n332\t        ood_values,\n333\t        folding_pow_witnesses,\n334\t        query_phase_pow_witnesses,\n335\t        initial_round_opened_rows,\n336\t        initial_round_merkle_proofs,\n337\t        codeword_opened_values,\n338\t        codeword_merkle_proofs,\n339\t        final_poly: final_poly.ok_or(WhirProverError::FinalPolyNone)?,\n340\t    })\n341\t}\n342\t\n343\t/// Given hypercube evaluations `w_evals` of `\\hat{w}` on `H_t`, this updates the evaluations\n344\t/// in place to be the evaluations of `\\hat{w}'(x) = \\hat{w}(x) + γ * eq(x, pow(z))`.\n345\tfn w_evals_accumulate<F: Field, EF: ExtensionField<F>>(w_evals: &mut [EF], z: F, gamma: EF) {\n346\t    let dim = log2_strict_usize(w_evals.len());\n347\t    let z_pows = z.exp_powers_of_2().take(dim).collect_vec();\n348\t    let evals = evals_eq_hypercube(&z_pows);\n349\t    for (w, x) in w_evals.iter_mut().zip(evals.into_iter()) {\n350\t        *w += gamma * x;\n351\t    }\n352\t}\n353\t"}]},"parent_tool_use_id":"toolu_01NK9Fwfcir4ZCi7CJDuEy5J","session_id":"bb5d1119-b0b0-4361-9117-64026afc483a","uuid":"0c4ab935-c620-40f5-a9db-0f3b100141c5","timestamp":"2026-04-15T08:05:16.315Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RsKPUxDcjXpv5C1ryp7X9X","type":"tool_result","content":"1\tuse std::{iter::zip, sync::Arc};\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::{\n5\t    copy::{MemCopyD2H, MemCopyH2D},\n6\t    d_buffer::DeviceBuffer,\n7\t    memory_manager::MemTracker,\n8\t};\n9\tuse openvm_stark_backend::{\n10\t    proof::{MerkleProof, WhirProof},\n11\t    prover::MatrixDimensions,\n12\t    SystemParams,\n13\t};\n14\tuse p3_field::{BasedVectorSpace, PrimeCharacteristicRing, TwoAdicField};\n15\tuse p3_util::log2_strict_usize;\n16\tuse tracing::instrument;\n17\t\n18\tuse crate::{\n19\t    base::DeviceMatrix,\n20\t    cuda::{\n21\t        batch_ntt_small::batch_ntt_small,\n22\t        matrix::{batch_expand_pad, split_ext_to_base_col_major_matrix},\n23\t        mle_interpolate::mle_interpolate_stage_ext,\n24\t        poly::{eval_poly_ext_at_point_from_base, transpose_fp_to_fpext_vec},\n25\t        whir::{\n26\t            _whir_sumcheck_coeff_moments_required_temp_buffer_size, w_moments_accumulate,\n27\t            whir_algebraic_batch_traces, whir_fold_coeffs_and_moments,\n28\t            whir_sumcheck_coeff_moments_round,\n29\t        },\n30\t    },\n31\t    hash_scheme::GpuHashScheme,\n32\t    merkle_tree::{MerkleProofQueryDigest, MerkleTreeConstructor, MerkleTreeGpu},\n33\t    ntt::batch_ntt,\n34\t    poly::evals_eq_hypercube,\n35\t    prelude::{D_EF, EF, F},\n36\t    sponge::GpuFiatShamirTranscript,\n37\t    stacked_pcs::rs_code_matrix,\n38\t    stacked_reduction::StackedPcsData2,\n39\t    WhirProverError,\n40\t};\n41\t\n42\t#[repr(C)]\n43\tpub(crate) struct BatchingTracePacket {\n44\t    /// Pointer to trace device buffer\n45\t    ptr: *const F,\n46\t    /// Trace height\n47\t    height: u32,\n48\t    /// Trace width\n49\t    width: u32,\n50\t    /// Row start in the stacked matrix\n51\t    stacked_row_start: u32,\n52\t    /// Index in mu powers\n53\t    mu_idx: u32,\n54\t}\n55\t\n56\t#[instrument(\n57\t    name = \"prover.openings.whir\",\n58\t    level = \"info\",\n59\t    skip_all,\n60\t    fields(phase = \"prover\")\n61\t)]\n62\tpub fn prove_whir_opening_gpu<HS, TS>(\n63\t    params: &SystemParams,\n64\t    transcript: &mut TS,\n65\t    mut stacked_per_commit: Vec<StackedPcsData2<HS::Digest>>,\n66\t    u: &[EF],\n67\t) -> Result<WhirProof<HS::SC>, WhirProverError>\n68\twhere\n69\t    HS: GpuHashScheme,\n70\t    TS: GpuFiatShamirTranscript<HS::SC>,\n71\t    HS::MerkleHash: MerkleTreeConstructor,\n72\t    HS::Digest: MerkleProofQueryDigest,\n73\t{\n74\t    let mem = MemTracker::start(\"prover.prove_whir_opening\");\n75\t    let l_skip = params.l_skip;\n76\t    let log_blowup = params.log_blowup;\n77\t    let k_whir = params.k_whir();\n78\t    let whir_params = params.whir();\n79\t    let log_final_poly_len = params.log_final_poly_len();\n80\t\n81\t    let height = stacked_per_commit[0].layout().height();\n82\t    debug_assert!(stacked_per_commit\n83\t        .iter()\n84\t        .all(|d| d.layout().height() == height));\n85\t    let mut m = log2_strict_usize(height);\n86\t    assert_eq!(m, u.len());\n87\t    debug_assert!(m >= l_skip);\n88\t\n89\t    // Proof-of-work grinding before μ batching challenge.\n90\t    // This amplifies soundness of the initial batching step.\n91\t    let mu_pow_witness = transcript\n92\t        .grind_gpu(whir_params.mu_pow_bits)\n93\t        .map_err(WhirProverError::MuGrind)?;\n94\t    // Sample randomness for algebraic batching.\n95\t    // We batch the codewords for \\hat{q}_j together _before_ applying WHIR.\n96\t    let mu = transcript.sample_ext();\n97\t    let num_commits = stacked_per_commit.len();\n98\t\n99\t    // The coefficient table of `\\hat{f}` in the current WHIR round (MLE coefficient form).\n100\t    let mut f_ple_evals = DeviceBuffer::<F>::with_capacity(height * D_EF);\n101\t    // We algebraically batch all matrices together so we only need to interpolate one column vector\n102\t    {\n103\t        let mut packets = Vec::new();\n104\t        let mut total_stacked_width = 0u32;\n105\t        for stacked in &stacked_per_commit {\n106\t            let layout = stacked.layout();\n107\t            for (trace, &idx) in zip(&stacked.traces, &layout.mat_starts) {\n108\t                let (_, _, s) = layout.sorted_cols[idx];\n109\t                let packet = BatchingTracePacket {\n110\t                    ptr: trace.buffer().as_ptr(),\n111\t                    height: trace.height() as u32,\n112\t                    width: trace.width() as u32,\n113\t                    stacked_row_start: s.row_idx as u32,\n114\t                    mu_idx: total_stacked_width + s.col_idx as u32,\n115\t                };\n116\t                packets.push(packet);\n117\t            }\n118\t            total_stacked_width += layout.width() as u32;\n119\t        }\n120\t        let mu_powers = mu.powers().take(total_stacked_width as usize).collect_vec();\n121\t        let d_mu_powers = mu_powers.to_device()?;\n122\t        let d_packets = packets.to_device()?;\n123\t        // SAFETY:\n124\t        // - `mu_powers` has length `total_width`.\n125\t        // - `f_ple_evals` has capacity `height * D_EF` (stacked height in base coordinates).\n126\t        // - `d_packets` contain valid pointers and stacked row indices by construction.\n127\t        unsafe {\n128\t            whir_algebraic_batch_traces(&mut f_ple_evals, &d_packets, &d_mu_powers, 1 << l_skip)\n129\t                .map_err(WhirProverError::AlgebraicBatch)?;\n130\t        }\n131\t        for stacked in &mut stacked_per_commit {\n132\t            // drop traces to free device memory if RS codewords matrix exists\n133\t            if stacked.inner.tree.backing_matrix.is_some() {\n134\t                stacked.traces.clear();\n135\t            }\n136\t        }\n137\t    } // common_main_pcs_data.matrix has now been freed\n138\t\n139\t    // Compute \\hat{f} coefficients:\n140\t    //\n141\t    // Step 1: iDFT per chunk of size 2^l_skip. After this, each chunk holds univariate\n142\t    // coefficients c_z(x) of f(Z, x) for a fixed boolean assignment x in H_{m - l_skip}.\n143\t    unsafe {\n144\t        let num_poly = f_ple_evals.len() >> l_skip;\n145\t        batch_ntt_small(&mut f_ple_evals, l_skip, num_poly, true)\n146\t            .map_err(WhirProverError::CustomBatchIntt)?;\n147\t    }\n148\t    let mut f_coeffs = DeviceBuffer::<EF>::with_capacity(height);\n149\t    // SAFETY: `f_ple_evals` is constructed with length `height * D_EF`.\n150\t    unsafe {\n151\t        transpose_fp_to_fpext_vec(&mut f_coeffs, &f_ple_evals)\n152\t            .map_err(WhirProverError::Transpose)?;\n153\t    }\n154\t    drop(f_ple_evals);\n155\t    // Step 2: Within-chunk zeta (stages 0..l_skip). Applies the subset-zeta transform\n156\t    // over the Z-index bits, converting univariate coefficients (root-of-unity basis)\n157\t    // into hypercube evaluations over H_{l_skip}. Together with step 1, this computes\n158\t    // eval_to_coeff_rs_message, i.e. the MLE coefficient table of \\hat{f}.\n159\t    for i in 0..l_skip {\n160\t        let step = 1u32 << i;\n161\t        // SAFETY: `f_coeffs` has length `2^m` with `m >= l_skip`.\n162\t        unsafe {\n163\t            mle_interpolate_stage_ext(&mut f_coeffs, step, false)\n164\t                .map_err(|error| WhirProverError::MleInterpolate { error, step })?;\n165\t        }\n166\t    }\n167\t\n168\t    debug_assert_eq!((m - log_final_poly_len) % k_whir, 0);\n169\t    let num_whir_rounds = (m - log_final_poly_len) / k_whir;\n170\t    assert!(num_whir_rounds > 0);\n171\t\n172\t    // We maintain moments of \\hat{w}:\n173\t    // M[T] = sum_{x superset T} \\hat{w}(x).\n174\t    // For initial \\hat{w} = mobius_eq(u, -), these moments are exactly eq(u, -).\n175\t    let mut w_moments = DeviceBuffer::<EF>::with_capacity(1 << m);\n176\t    unsafe {\n177\t        evals_eq_hypercube(&mut w_moments, u).map_err(WhirProverError::EvalEq)?;\n178\t    }\n179\t\n180\t    let mut whir_sumcheck_polys: Vec<[EF; 2]> = vec![];\n181\t    let mut codeword_commits = vec![];\n182\t    let mut ood_values = vec![];\n183\t    // per commitment, per whir query, per column\n184\t    let mut initial_round_opened_rows: Vec<Vec<Vec<Vec<F>>>> = vec![vec![]; num_commits];\n185\t    let mut initial_round_merkle_proofs: Vec<Vec<MerkleProof<HS::Digest>>> = vec![];\n186\t    let mut codeword_opened_values: Vec<Vec<Vec<EF>>> = vec![];\n187\t    let mut codeword_merkle_proofs: Vec<Vec<MerkleProof<HS::Digest>>> = vec![];\n188\t    let mut folding_pow_witnesses = vec![];\n189\t    let mut query_phase_pow_witnesses = vec![];\n190\t    let mut rs_tree = None;\n191\t    let mut log_rs_domain_size = m + log_blowup;\n192\t    let mut final_poly = None;\n193\t\n194\t    let mut d_s_evals = DeviceBuffer::<EF>::with_capacity(2);\n195\t    let mut d_sumcheck_tmp = DeviceBuffer::<EF>::new();\n196\t\n197\t    mem.tracing_info(\"before_whir_rounds\");\n198\t    // We will drop `stacked_per_commit` and hence `common_main_pcs_data` after whir round 0.\n199\t    for (whir_round, round_params) in whir_params.rounds.iter().enumerate() {\n200\t        let is_last_round = whir_round == num_whir_rounds - 1;\n201\t        // Run k_whir rounds of sumcheck on `sum_{x in H_m} \\hat{w}(\\hat{f}(x), x)`\n202\t        for round in 0..k_whir {\n203\t            // Do not use f_coeffs.len() because it might have extra capacity.\n204\t            let f_height = 1 << (m - round);\n205\t            debug_assert!(\n206\t                f_coeffs.len() >= f_height,\n207\t                \"f_coeffs has length {}, expected 2^{} for m={m}, round={round}\",\n208\t                f_coeffs.len(),\n209\t                m - round\n210\t            );\n211\t            debug_assert!(w_moments.len() >= f_height);\n212\t            let output_height = f_height / 2;\n213\t            let tmp_buffer_capacity =\n214\t                unsafe { _whir_sumcheck_coeff_moments_required_temp_buffer_size(f_height as u32) };\n215\t            if d_sumcheck_tmp.len() < tmp_buffer_capacity as usize {\n216\t                d_sumcheck_tmp = DeviceBuffer::<EF>::with_capacity(tmp_buffer_capacity as usize);\n217\t            }\n218\t            let mut new_f_coeffs = DeviceBuffer::<EF>::with_capacity(output_height);\n219\t            let mut new_w_moments = DeviceBuffer::<EF>::with_capacity(output_height);\n220\t            // SAFETY:\n221\t            // - `d_s_evals` has length 2\n222\t            // - `d_sumcheck_tmp` has at least required scratch length\n223\t            unsafe {\n224\t                whir_sumcheck_coeff_moments_round(\n225\t                    &f_coeffs,\n226\t                    &w_moments,\n227\t                    &mut d_s_evals,\n228\t                    &mut d_sumcheck_tmp,\n229\t                    f_height as u32,\n230\t                )\n231\t                .map_err(|error| WhirProverError::SumcheckMleRound {\n232\t                    error,\n233\t                    whir_round,\n234\t                    round,\n235\t                })?;\n236\t            }\n237\t            let s_evals = d_s_evals.to_host()?;\n238\t            for &eval in &s_evals {\n239\t                transcript.observe_ext(eval);\n240\t            }\n241\t            whir_sumcheck_polys.push(s_evals.try_into().unwrap());\n242\t\n243\t            folding_pow_witnesses.push(\n244\t                transcript\n245\t                    .grind_gpu(whir_params.folding_pow_bits)\n246\t                    .map_err(WhirProverError::FoldingGrind)?,\n247\t            );\n248\t            let alpha = transcript.sample_ext();\n249\t\n250\t            // Fold `f` and `w` in coefficient/moment form with respect to `alpha`.\n251\t            // SAFETY:\n252\t            // - input buffers have length `f_height`.\n253\t            // - output buffers have length `f_height / 2`.\n254\t            unsafe {\n255\t                whir_fold_coeffs_and_moments(\n256\t                    &f_coeffs,\n257\t                    &w_moments,\n258\t                    &mut new_f_coeffs,\n259\t                    &mut new_w_moments,\n260\t                    alpha,\n261\t                    f_height as u32,\n262\t                )\n263\t                .map_err(|error| WhirProverError::FoldMle {\n264\t                    error,\n265\t                    whir_round,\n266\t                    round,\n267\t                })?;\n268\t            }\n269\t            f_coeffs = new_f_coeffs;\n270\t            w_moments = new_w_moments;\n271\t        }\n272\t        // Define g^ = f^(alpha, \\cdot) and send matrix commit of RS(g^)\n273\t        // `f_coeffs` is the coefficient form of f^(alpha, \\cdot).\n274\t        let f_height = 1 << (m - k_whir);\n275\t        debug_assert!(f_coeffs.len() >= f_height);\n276\t        debug_assert_eq!(size_of::<EF>() / size_of::<F>(), D_EF);\n277\t        let mut g_coeffs = DeviceBuffer::<F>::with_capacity(f_height * D_EF);\n278\t        // SAFETY: we allocated `f_coeffs.len() * D_EF` space for `g_coeffs` to do a 1-to-D_EF\n279\t        // (1-to-4) split\n280\t        unsafe {\n281\t            split_ext_to_base_col_major_matrix(\n282\t                &mut g_coeffs,\n283\t                &f_coeffs,\n284\t                f_height as u64,\n285\t                f_height as u32,\n286\t            )\n287\t            .map_err(|error| WhirProverError::SplitExtPoly { error, whir_round })?;\n288\t        }\n289\t        let (g_tree, z_0) = if !is_last_round {\n290\t            let codeword_height = 1 << (log_rs_domain_size - 1);\n291\t            // `g: \\mathcal{L}^{(2)} \\to \\mathbb F`\n292\t            let g_rs = DeviceBuffer::<F>::with_capacity(D_EF * codeword_height);\n293\t            // SAFETY:\n294\t            // - g_coeffs is a single EF polynomial, treated as 4 F-polynomials of height\n295\t            //   2^{m-k_whir}\n296\t            // - We resize each F-poly to RS domain size 2^{log_rs_domain_size - 1}, which is\n297\t            //   equivalent to resizing the EF-polynomial\n298\t            unsafe {\n299\t                batch_expand_pad(\n300\t                    g_rs.as_mut_ptr(),\n301\t                    g_coeffs.as_ptr(),\n302\t                    D_EF as u32,\n303\t                    codeword_height as u32,\n304\t                    f_height as u32,\n305\t                )\n306\t                .map_err(|error| WhirProverError::BatchExpandPad { error, whir_round })?;\n307\t\n308\t                batch_ntt(\n309\t                    &g_rs,\n310\t                    (log_rs_domain_size - 1) as u32,\n311\t                    0u32,\n312\t                    D_EF as u32,\n313\t                    true,\n314\t                    false,\n315\t                );\n316\t            }\n317\t\n318\t            let g_tree = MerkleTreeGpu::<F, HS::Digest>::new_with_hash::<HS::MerkleHash>(\n319\t                DeviceMatrix::new(Arc::new(g_rs), codeword_height, D_EF),\n320\t                1 << k_whir,\n321\t                true,\n322\t            )\n323\t            .map_err(WhirProverError::MerkleTree)?;\n324\t            let g_commit = g_tree.root();\n325\t            transcript.observe_commit(g_commit);\n326\t            codeword_commits.push(g_commit);\n327\t\n328\t            let z_0 = transcript.sample_ext();\n329\t            // SAFETY:\n330\t            // - `g_coeffs` is coefficient form of `\\hat{g}`, which is degree `2^{m-k_whir}`.\n331\t            // - `g_coeffs` is F-column major matrix.\n332\t            let g_opened_value = unsafe {\n333\t                eval_poly_ext_at_point_from_base(&g_coeffs, 1 << (m - k_whir), z_0)\n334\t                    .map_err(|error| WhirProverError::EvalPolyAtPoint { error, whir_round })?\n335\t            };\n336\t            transcript.observe_ext(g_opened_value);\n337\t            ood_values.push(g_opened_value);\n338\t\n339\t            (Some(g_tree), Some(z_0))\n340\t        } else {\n341\t            // Observe the final poly\n342\t            debug_assert_eq!(log_final_poly_len, m - k_whir);\n343\t            let final_poly_len = 1 << log_final_poly_len;\n344\t            let base_coeffs = g_coeffs.to_host()?;\n345\t            debug_assert_eq!(base_coeffs.len(), D_EF * final_poly_len);\n346\t            let mut coeffs = Vec::with_capacity(final_poly_len);\n347\t            for i in 0..final_poly_len {\n348\t                let coeff = EF::from_basis_coefficients_fn(|j| base_coeffs[j * final_poly_len + i]);\n349\t                transcript.observe_ext(coeff);\n350\t                coeffs.push(coeff);\n351\t            }\n352\t            final_poly = Some(coeffs);\n353\t            (None, None)\n354\t        };\n355\t\n356\t        // omega is generator of RS domain `\\mathcal{L}^{(2^k)}`\n357\t        let omega = F::two_adic_generator(log_rs_domain_size - k_whir);\n358\t        let num_queries = round_params.num_queries;\n359\t        let mut query_indices = Vec::with_capacity(num_queries);\n360\t        query_phase_pow_witnesses.push(\n361\t            transcript\n362\t                .grind_gpu(whir_params.query_phase_pow_bits)\n363\t                .map_err(WhirProverError::QueryPhaseGrind)?,\n364\t        );\n365\t        // Sample query indices first\n366\t        for _ in 0..num_queries {\n367\t            // This is the index of the leaf in the Merkle tree\n368\t            let index = transcript.sample_bits(log_rs_domain_size - k_whir);\n369\t            query_indices.push(index as usize);\n370\t        }\n371\t        if !is_last_round {\n372\t            codeword_opened_values.push(vec![]);\n373\t            codeword_merkle_proofs.push(vec![]);\n374\t        }\n375\t        if whir_round == 0 {\n376\t            // Vector to hold owned copies of backing matrices that are regenerated in the case they\n377\t            // were not cached\n378\t            let mut backing_mats_owned = vec![None; stacked_per_commit.len()];\n379\t            let mut backing_matrices = Vec::with_capacity(stacked_per_commit.len());\n380\t            let mut trees = Vec::with_capacity(stacked_per_commit.len());\n381\t            for (d, backing_mat_owned) in zip(&mut stacked_per_commit, &mut backing_mats_owned) {\n382\t                trees.push(&d.inner.tree);\n383\t                if let Some(matrix) = d.inner.tree.backing_matrix.as_ref() {\n384\t                    backing_matrices.push(matrix);\n385\t                } else {\n386\t                    let layout = d.layout();\n387\t                    let traces = d.traces.iter().collect_vec();\n388\t                    debug_assert!(!traces.is_empty());\n389\t                    let backing_matrix =\n390\t                        rs_code_matrix(log_blowup, layout, &traces, &d.inner.matrix)\n391\t                            .map_err(WhirProverError::RsCodeMatrix)?;\n392\t                    d.traces.clear();\n393\t                    *backing_mat_owned = Some(backing_matrix);\n394\t                    backing_matrices.push(backing_mat_owned.as_ref().unwrap());\n395\t                }\n396\t            }\n397\t            // Get merkle proofs for in-domain samples necessary to evaluate Fold(f, \\vec\n398\t            // \\alpha)(z_i)\n399\t            initial_round_merkle_proofs =\n400\t                <MerkleTreeGpu<F, HS::Digest>>::batch_query_merkle_proofs(\n401\t                    trees.as_slice(),\n402\t                    &query_indices,\n403\t                )\n404\t                .map_err(WhirProverError::MerkleTree)?;\n405\t\n406\t            let query_stride = trees[0].query_stride();\n407\t            debug_assert!(\n408\t                trees.iter().all(|tree| tree.query_stride() == query_stride),\n409\t                \"Merkle trees don't have same layer size\"\n410\t            );\n411\t            let num_rows_per_query = trees[0].rows_per_query;\n412\t            debug_assert!(\n413\t                trees\n414\t                    .iter()\n415\t                    .all(|tree| tree.rows_per_query == num_rows_per_query),\n416\t                \"Merkle trees don't have same rows_per_query\"\n417\t            );\n418\t\n419\t            initial_round_opened_rows = MerkleTreeGpu::<F, HS::Digest>::batch_open_rows(\n420\t                &backing_matrices,\n421\t                &query_indices,\n422\t                query_stride,\n423\t                num_rows_per_query,\n424\t            )\n425\t            .map_err(WhirProverError::MerkleTree)?\n426\t            .into_iter()\n427\t            .map(|rows_per_commit| {\n428\t                rows_per_commit\n429\t                    .into_iter()\n430\t                    .map(|rows| {\n431\t                        let width = rows.len() / num_rows_per_query;\n432\t                        rows.chunks_exact(width).map(|row| row.to_vec()).collect()\n433\t                    })\n434\t                    .collect()\n435\t            })\n436\t            .collect();\n437\t            debug_assert_eq!(\n438\t                Arc::strong_count(&stacked_per_commit[0].inner),\n439\t                1,\n440\t                \"common_main_pcs_data should be owned\"\n441\t            );\n442\t            stacked_per_commit.clear(); // this drops common_main_pcs_data\n443\t            mem.tracing_info(\"after_initial_whir_round\");\n444\t        } else {\n445\t            let tree: &MerkleTreeGpu<F, HS::Digest> = rs_tree.as_ref().unwrap();\n446\t            codeword_merkle_proofs[whir_round - 1] =\n447\t                <MerkleTreeGpu<F, HS::Digest>>::batch_query_merkle_proofs(&[tree], &query_indices)\n448\t                    .map_err(WhirProverError::MerkleTree)?\n449\t                    .pop()\n450\t                    .expect(\"exactly 1 tree\");\n451\t            codeword_opened_values[whir_round - 1] =\n452\t                MerkleTreeGpu::<F, HS::Digest>::batch_open_rows(\n453\t                    &[tree.backing_matrix.as_ref().unwrap()],\n454\t                    &query_indices,\n455\t                    tree.query_stride(),\n456\t                    tree.rows_per_query,\n457\t                )\n458\t                .map_err(WhirProverError::MerkleTree)?\n459\t                .pop()\n460\t                .unwrap()\n461\t                .into_iter()\n462\t                .map(EF::reconstitute_from_base)\n463\t                .collect();\n464\t        }\n465\t        rs_tree = g_tree;\n466\t\n467\t        // We still sample on the last round to match the verifier, who uses a\n468\t        // final gamma to unify some logic. But we do not need to update\n469\t        // `w_moments`.\n470\t        let gamma = transcript.sample_ext();\n471\t\n472\t        if !is_last_round {\n473\t            // Update moments of \\hat{w}:\n474\t            // M(T) += gamma * z0^T + sum_i gamma^{i+1} * z_i^T.\n475\t            let log_height = (m - k_whir) as u32;\n476\t            let z0 = z_0.unwrap();\n477\t            let z_points = query_indices\n478\t                .iter()\n479\t                .map(|&index| omega.exp_u64(index as u64))\n480\t                .collect_vec();\n481\t\n482\t            let mut z0_pows2 = Vec::with_capacity(log_height as usize);\n483\t            let mut z0_pow = z0;\n484\t            for _ in 0..log_height {\n485\t                z0_pows2.push(z0_pow);\n486\t                z0_pow = z0_pow.square();\n487\t            }\n488\t\n489\t            let mut z_pows2 = Vec::with_capacity(num_queries * log_height as usize);\n490\t            for z in &z_points {\n491\t                let mut z_pow = *z;\n492\t                for _ in 0..log_height {\n493\t                    z_pows2.push(z_pow);\n494\t                    z_pow = z_pow.square();\n495\t                }\n496\t            }\n497\t\n498\t            let d_z0_pows2 = z0_pows2.to_device()?;\n499\t            let d_z_pows2 = z_pows2.to_device()?;\n500\t            unsafe {\n501\t                w_moments_accumulate(\n502\t                    &mut w_moments,\n503\t                    &d_z0_pows2,\n504\t                    &d_z_pows2,\n505\t                    gamma,\n506\t                    num_queries as u32,\n507\t                    log_height,\n508\t                )\n509\t                .map_err(|error| WhirProverError::WMomentsAccumulate { error, whir_round })?;\n510\t            }\n511\t        }\n512\t\n513\t        m -= k_whir;\n514\t        log_rs_domain_size -= 1;\n515\t    }\n516\t\n517\t    mem.emit_metrics();\n518\t    Ok(WhirProof {\n519\t        mu_pow_witness,\n520\t        whir_sumcheck_polys,\n521\t        codeword_commits,\n522\t        ood_values,\n523\t        folding_pow_witnesses,\n524\t        query_phase_pow_witnesses,\n525\t        initial_round_opened_rows,\n526\t        initial_round_merkle_proofs,\n527\t        codeword_opened_values,\n528\t        codeword_merkle_proofs,\n529\t        final_poly: final_poly.unwrap(),\n530\t    })\n531\t}\n532\t\n533\t#[cfg(test)]\n534\tmod tests {\n535\t    use std::sync::Arc;\n536\t\n537\t    use itertools::Itertools;\n538\t    use openvm_stark_backend::{\n539\t        keygen::types::MultiStarkProvingKey,\n540\t        prover::{\n541\t            stacked_pcs::stacked_commit, CpuColMajorBackend, DeviceDataTransporter, ProvingContext,\n542\t        },\n543\t        test_utils::{FibFixture, TestFixture},\n544\t        verifier::whir::{verify_whir, VerifyWhirError},\n545\t        StarkEngine, StarkProtocolConfig, SystemParams, WhirConfig, WhirParams,\n546\t        WhirProximityStrategy,\n547\t    };\n548\t    use openvm_stark_sdk::{\n549\t        config::{\n550\t            baby_bear_poseidon2::{\n551\t                default_duplex_sponge, BabyBearPoseidon2RefEngine, DuplexSponge,\n552\t            },\n553\t            log_up_params::log_up_security_params_baby_bear_100_bits,\n554\t        },\n555\t        utils::setup_tracing_with_log_level,\n556\t    };\n557\t    use rand::{rngs::StdRng, SeedableRng};\n558\t    use test_case::test_case;\n559\t    use tracing::Level;\n560\t\n561\t    use crate::{\n562\t        prelude::SC, sponge::DuplexSpongeGpu, stacked_reduction::StackedPcsData2,\n563\t        whir::prove_whir_opening_gpu, BabyBearPoseidon2GpuEngine, GpuBackend,\n564\t    };\n565\t\n566\t    /// GPU-specific WHIR test runner. Uses `prove_whir_opening_gpu` for the\n567\t    /// proving step and the shared CPU verifier for verification.\n568\t    fn run_whir_test_gpu(\n569\t        params: SystemParams,\n570\t        pk: MultiStarkProvingKey<SC>,\n571\t        ctx: ProvingContext<CpuColMajorBackend<SC>>,\n572\t    ) -> Result<(), VerifyWhirError> {\n573\t        let engine = BabyBearPoseidon2GpuEngine::new(params.clone());\n574\t        let device = engine.device();\n575\t        let mut rng = StdRng::seed_from_u64(0);\n576\t        let (z_prism, z_cube) = openvm_backend_tests::generate_random_z(&params, &mut rng);\n577\t\n578\t        let common_main_traces = ctx\n579\t            .common_main_traces()\n580\t            .map(|(_, trace)| trace)\n581\t            .collect_vec();\n582\t        // Use CPU stacked_commit to isolate GPU testing to WHIR prover\n583\t        let (common_main_commit, common_main_pcs_data) = stacked_commit(\n584\t            engine.config().hasher(),\n585\t            params.l_skip,\n586\t            params.n_stack,\n587\t            params.log_blowup,\n588\t            params.k_whir(),\n589\t            &common_main_traces,\n590\t        )\n591\t        .unwrap();\n592\t        let d_common_main_traces = common_main_traces\n593\t            .iter()\n594\t            .map(|t| {\n595\t                <_ as DeviceDataTransporter<SC, GpuBackend>>::transport_matrix_to_device(device, t)\n596\t            })\n597\t            .collect_vec();\n598\t        let d_common_main_pcs_data =\n599\t            <_ as DeviceDataTransporter<SC, GpuBackend>>::transport_pcs_data_to_device(\n600\t                device,\n601\t                &common_main_pcs_data,\n602\t            );\n603\t\n604\t        let mut stacking_openings = vec![openvm_backend_tests::stacking_openings_for_matrix(\n605\t            &params,\n606\t            &z_prism,\n607\t            &common_main_pcs_data.matrix,\n608\t        )];\n609\t        let mut commits = vec![common_main_commit];\n610\t        let mut stacked_per_commit = vec![StackedPcsData2 {\n611\t            inner: Arc::new(d_common_main_pcs_data),\n612\t            traces: d_common_main_traces,\n613\t        }];\n614\t        for (air_id, air_ctx) in ctx.per_trace {\n615\t            for data in pk.per_air[air_id]\n616\t                .preprocessed_data\n617\t                .iter()\n618\t                .chain(air_ctx.cached_mains.iter().map(|cd| &cd.data))\n619\t            {\n620\t                let trace =\n621\t                    <_ as DeviceDataTransporter<SC, GpuBackend>>::transport_matrix_to_device(\n622\t                        device,\n623\t                        &data.mat_view(0).to_matrix(),\n624\t                    );\n625\t                commits.push(data.commit().unwrap());\n626\t                stacking_openings.push(openvm_backend_tests::stacking_openings_for_matrix(\n627\t                    &params,\n628\t                    &z_prism,\n629\t                    &data.matrix,\n630\t                ));\n631\t                let d_data =\n632\t                    <_ as DeviceDataTransporter<SC, GpuBackend>>::transport_pcs_data_to_device(\n633\t                        device, data,\n634\t                    );\n635\t                stacked_per_commit.push(StackedPcsData2 {\n636\t                    inner: Arc::new(d_data),\n637\t                    traces: vec![trace],\n638\t                });\n639\t            }\n640\t        }\n641\t\n642\t        let mut prover_sponge = DuplexSpongeGpu::default();\n643\t\n644\t        let proof = prove_whir_opening_gpu::<crate::DefaultHashScheme, _>(\n645\t            &params,\n646\t            &mut prover_sponge,\n647\t            stacked_per_commit,\n648\t            &z_cube,\n649\t        )\n650\t        .unwrap();\n651\t\n652\t        let mut verifier_sponge = default_duplex_sponge();\n653\t        verify_whir(\n654\t            &mut verifier_sponge,\n655\t            engine.config(),\n656\t            &proof,\n657\t            &stacking_openings,\n658\t            &commits,\n659\t            &z_cube,\n660\t        )\n661\t    }\n662\t\n663\t    fn run_whir_fib_test_gpu(params: SystemParams) -> Result<(), VerifyWhirError> {\n664\t        let engine = BabyBearPoseidon2RefEngine::<DuplexSponge>::new(params.clone());\n665\t        let fib = FibFixture::new(0, 1, 1 << params.log_stacked_height());\n666\t        let (pk, _vk) = fib.keygen(&engine);\n667\t        let ctx = fib.generate_proving_ctx();\n668\t        run_whir_test_gpu(params, pk, ctx)\n669\t    }\n670\t\n671\t    fn whir_test_params(k_whir: usize, log_final_poly_len: usize) -> WhirParams {\n672\t        WhirParams {\n673\t            k: k_whir,\n674\t            log_final_poly_len,\n675\t            query_phase_pow_bits: 2,\n676\t            folding_pow_bits: 1,\n677\t            mu_pow_bits: 3,\n678\t            proximity: WhirProximityStrategy::UniqueDecoding,\n679\t        }\n680\t    }\n681\t\n682\t    #[test_case(0, 1, 1, 0)]\n683\t    #[test_case(2, 1, 1, 2)]\n684\t    #[test_case(2, 1, 2, 0)]\n685\t    #[test_case(2, 1, 3, 1)]\n686\t    #[test_case(2, 1, 4, 0)]\n687\t    #[test_case(2, 2, 4, 0)]\n688\t    fn test_whir_single_fib_gpu(\n689\t        n_stack: usize,\n690\t        log_blowup: usize,\n691\t        k_whir: usize,\n692\t        log_final_poly_len: usize,\n693\t    ) -> Result<(), VerifyWhirError> {\n694\t        setup_tracing_with_log_level(Level::DEBUG);\n695\t\n696\t        let l_skip = 2;\n697\t        let w_stack = 8;\n698\t        let whir = WhirConfig::new(\n699\t            log_blowup,\n700\t            l_skip + n_stack,\n701\t            whir_test_params(k_whir, log_final_poly_len),\n702\t            10,\n703\t        );\n704\t        let params = SystemParams {\n705\t            l_skip: 2,\n706\t            n_stack,\n707\t            w_stack,\n708\t            log_blowup,\n709\t            whir,\n710\t            logup: log_up_security_params_baby_bear_100_bits(),\n711\t            max_constraint_degree: 3,\n712\t        };\n713\t        run_whir_fib_test_gpu(params)\n714\t    }\n715\t\n716\t    // TODO: test multiple commitments with GPU prover\n717\t}\n718\t"}]},"parent_tool_use_id":"toolu_01NK9Fwfcir4ZCi7CJDuEy5J","session_id":"bb5d1119-b0b0-4361-9117-64026afc483a","uuid":"439eadf7-a3a0-45fd-9b43-c2d65754aa77","timestamp":"2026-04-15T08:05:16.415Z"}
