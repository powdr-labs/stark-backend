d_intermediates,\n605\t    uint32_t skip_domain,\n606\t    uint32_t num_x,\n607\t    uint32_t height,\n608\t    uint32_t num_cosets,\n609\t    Fp g_shift,\n610\t    size_t max_temp_bytes\n611\t) {\n612\t    auto [grid, block] = coset_parallel_round0_config::eval_constraints_launch_params(\n613\t        buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n614\t    );\n615\t\n616\t    size_t shared_sum_size = sizeof(FracExt) * block.x;\n617\t    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n618\t    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n619\t\n620\t    logup_r0_ntt_eval_interactions_coset_parallel_kernel<GLOBAL, NEEDS_SHMEM>\n621\t        <<<grid, block, shmem_bytes>>>(\n622\t            tmp_sums_buffer,\n623\t            selectors_cube,\n624\t            preprocessed,\n625\t            main_parts,\n626\t            eq_cube,\n627\t            public_values,\n628\t            numer_weights,\n629\t            denom_weights,\n630\t            denom_sum_init,\n631\t            d_rules,\n632\t            rules_len,\n633\t            buffer_size,\n634\t            d_intermediates,\n635\t            skip_domain,\n636\t            num_x,\n637\t            height,\n638\t            g_shift\n639\t        );\n640\t    int err = CHECK_KERNEL();\n641\t    if (err != 0) {\n642\t        return err;\n643\t    }\n644\t\n645\t    // Final reduction: same as lockstep\n646\t    auto num_blocks = grid.x;\n647\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n648\t    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n649\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n650\t    auto large_domain = num_cosets * skip_domain;\n651\t    sumcheck::final_reduce_block_sums<<<2 * large_domain, reduce_block, reduce_shmem>>>(\n652\t        reinterpret_cast<FpExt *>(tmp_sums_buffer), reinterpret_cast<FpExt *>(output), num_blocks\n653\t    );\n654\t\n655\t    