{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013Lc6KZTE2dHkH5NCnuWoWa","type":"tool_result","content":"1\tuse std::{array::from_fn, cmp::max, ffi::c_void, iter::zip, mem, sync::Arc};\n2\t\n3\tuse itertools::{zip_eq, Itertools};\n4\tuse openvm_cuda_common::{\n5\t    copy::{cuda_memcpy, MemCopyD2H, MemCopyH2D},\n6\t    d_buffer::DeviceBuffer,\n7\t    memory_manager::MemTracker,\n8\t};\n9\tuse openvm_stark_backend::{\n10\t    dft::Radix2BowersSerial,\n11\t    p3_matrix::dense::RowMajorMatrix,\n12\t    poly_common::{\n13\t        eq_uni_poly, eval_eq_mle, eval_eq_uni, eval_eq_uni_at_one, eval_in_uni, Squarable,\n14\t        UnivariatePoly,\n15\t    },\n16\t    proof::StackingProof,\n17\t    prover::{\n18\t        stacked_pcs::StackedLayout, sumcheck::sumcheck_round0_deg, DeviceMultiStarkProvingKey,\n19\t        MatrixDimensions, ProvingContext,\n20\t    },\n21\t};\n22\tuse p3_dft::TwoAdicSubgroupDft;\n23\tuse p3_field::{PrimeCharacteristicRing, TwoAdicField};\n24\tuse tracing::{debug, info_span, instrument};\n25\t\n26\tuse crate::{\n27\t    base::DeviceMatrix,\n28\t    cuda::{\n29\t        batch_ntt_small::ensure_device_ntt_twiddles_initialized,\n30\t        poly::vector_scalar_multiply_ext,\n31\t        stacked_reduction::{\n32\t            _stacked_reduction_r0_required_temp_buffer_size, initialize_k_rot_from_eq_segments,\n33\t            stacked_reduction_fold_ple, stacked_reduction_sumcheck_mle_round,\n34\t            stacked_reduction_sumcheck_mle_round_degenerate, stacked_reduction_sumcheck_round0,\n35\t            NUM_G,\n36\t        },\n37\t        sumcheck::{fold_mle, triangular_fold_mle},\n38\t    },\n39\t    gpu_backend::GenericGpuBackend,\n40\t    hash_scheme::GpuHashScheme,\n41\t    poly::EqEvalSegments,\n42\t    prelude::{Digest, D_EF, EF, F},\n43\t    sponge::GpuFiatShamirTranscript,\n44\t    stacked_pcs::StackedPcsDataGpu,\n45\t    utils::{compute_barycentric_inv_lagrange_denoms, reduce_raw_u64_to_ef},\n46\t    GpuDevice, StackedReductionError,\n47\t};\n48\t\n49\t/// Degree of the sumcheck polynomial for stacked reduction.\n50\tpub const STACKED_REDUCTION_S_DEG: usize = 2;\n51\t\n52\tpub struct StackedReductionGpu<D = Digest> {\n53\t    sm_count: u32,\n54\t\n55\t    l_skip: usize,\n56\t    n_stack: usize,\n57\t\n58\t    omega_skip: F,\n59\t    omega_skip_pows: Vec<F>,\n60\t    d_omega_skip_pows: DeviceBuffer<F>,\n61\t\n62\t    r_0: EF,\n63\t    d_lambda_pows: DeviceBuffer<EF>,\n64\t    eq_const: EF,\n65\t\n66\t    pub(crate) stacked_per_commit: Vec<StackedPcsData2<D>>,\n67\t    d_q_widths: DeviceBuffer<u32>,\n68\t    q_width_max: u32,\n69\t    d_q_eval_ptrs: DeviceBuffer<*const EF>,\n70\t\n71\t    trace_ptrs: Vec<(\n72\t        *const F, /* trace_ptr */\n73\t        usize,    /* height */\n74\t        usize,    /* width */\n75\t    )>,\n76\t    unstacked_cols: Vec<UnstackedSlice>,\n77\t    d_unstacked_cols: DeviceBuffer<UnstackedSlice>,\n78\t    // boundary indices where heights change. all columns between two boundaries must have the same\n79\t    // height. We can have multiple chunks of the same height if that is needed to reduce peak GPU\n80\t    // memory.\n81\t    ht_diff_idxs: Vec<usize>,\n82\t    n_max: usize,\n83\t\n84\t    // Initially holds eq(r[1..=n], H_n) for n=0..=n_max but gets updated after each sumcheck round\n85\t    // by some custom folding\n86\t    eq_r_ns: EqEvalSegments<EF>,\n87\t\n88\t    // == After round 0 ==\n89\t    q_evals: Vec<DeviceBuffer<EF>>, // get width from stacked_per_commit\n90\t    // Stores folded eq values that won't change anymore (no more folding)\n91\t    // Corresponds to log_height in 0..l_skip+round-1 _before_ round `round`. Gets updated with one\n92\t    // new element after each round.\n93\t    eq_stable: Vec<EF>,\n94\t    k_rot_stable: Vec<EF>,\n95\t\n96\t    /// Stores the folded k_rot evaluations for `\\kappa_\\rot(x, r) = eq_n(rot^{-1}(x), r)` for each\n97\t    /// `n` after each round. We use the [EqEvalSegments] type to guard the segment-based\n98\t    /// memory layout.\n99\t    k_rot_ns: EqEvalSegments<EF>,\n100\t    /// Stores eq(u[1+n_T..round-1], b_{T,j}[..round-n_T-1])\n101\t    eq_ub_per_trace: Vec<EF>,\n102\t    d_eq_ub_all: DeviceBuffer<EF>,\n103\t\n104\t    d_block_sums: DeviceBuffer<EF>,\n105\t    d_accum: DeviceBuffer<u64>,\n106\t    d_input_ptrs: DeviceBuffer<*const EF>,\n107\t    d_output_ptrs: DeviceBuffer<*mut EF>,\n108\t\n109\t    mem: MemTracker,\n110\t}\n111\t\n112\t/// A struct for holding stacked pcs data. We only need the `MerkleTreeGpu` from `StackedPcsDataGpu`\n113\t/// but we wrap the latter in an `Arc` to provide uniformity in dealing with common main and\n114\t/// preprocessed/cached traces. This struct stores the unstacked `traces`, in prismalinear\n115\t/// evaluation form, corresponding to the stacked pcs data.\n116\t///\n117\t/// Generic over the Merkle digest type `D`.  The default `D = Digest` preserves the existing\n118\t/// BabyBear-Poseidon2 behaviour.\n119\tpub struct StackedPcsData2<D = Digest> {\n120\t    pub(crate) inner: Arc<StackedPcsDataGpu<F, D>>,\n121\t    /// The unstacked traces corresponding to `inner`'s commitment.\n122\t    pub(crate) traces: Vec<DeviceMatrix<F>>,\n123\t}\n124\t\n125\timpl<D> StackedPcsData2<D> {\n126\t    /// # Safety\n127\t    /// `traces` must be the traces that were committed to in `pcs_data`.\n128\t    pub unsafe fn from_raw(\n129\t        pcs_data: Arc<StackedPcsDataGpu<F, D>>,\n130\t        traces: Vec<DeviceMatrix<F>>,\n131\t    ) -> Self {\n132\t        Self {\n133\t            inner: pcs_data,\n134\t            traces,\n135\t        }\n136\t    }\n137\t\n138\t    pub fn layout(&self) -> &StackedLayout {\n139\t        &self.inner.layout\n140\t    }\n141\t}\n142\t\n143\t/// Pointer with length to location in a big device buffer. The device buffer is identified by\n144\t/// `commit_idx`. Due to pecuarlities with `l_skip`, the length of the slice is defined as\n145\t/// `max(2^log_height, 2^l_skip)`. In other words, this is a pointer to the slice\n146\t/// `q[commit_idx].column(stacked_col_idx)[stacked_row_idx..stacked_row_idx + len]`.\n147\t///\n148\t/// # Safety\n149\t/// - this type is `repr(C)` as it will cross FFI boundaries for CUDA usage.\n150\t#[repr(C)]\n151\t#[derive(Clone, Copy, Debug)]\n152\tpub(crate) struct UnstackedSlice {\n153\t    commit_idx: u32,\n154\t    log_height: u32,\n155\t    stacked_row_idx: u32,\n156\t    stacked_col_idx: u32,\n157\t}\n158\t\n159\timpl<D> StackedReductionGpu<D> {\n160\t    fn log_stacked_height(&self, round: usize) -> usize {\n161\t        self.n_stack - (round - 1)\n162\t    }\n163\t\n164\t    fn stacked_height(&self, round: usize) -> usize {\n165\t        1 << self.log_stacked_height(round)\n166\t    }\n167\t\n168\t    /// Current maximum `n` supported by eq_r_ns\n169\t    fn cur_max_n(&self, round: usize) -> usize {\n170\t        self.n_max - (round - 1)\n171\t    }\n172\t}\n173\t\n174\t/// Batch sumcheck to reduce trace openings, including rotations, to stacked matrix opening.\n175\t///\n176\t/// The `stacked_matrix, stacked_layout` should be the result of stacking the `traces` with\n177\t/// parameters `l_skip` and `n_stack`.\n178\t#[allow(clippy::type_complexity)]\n179\t#[instrument(\n180\t    name = \"prover.openings.stacked_reduction\",\n181\t    level = \"info\",\n182\t    skip_all,\n183\t    fields(phase = \"prover\")\n184\t)]\n185\tpub fn prove_stacked_opening_reduction_gpu<HS, TS>(\n186\t    device: &GpuDevice,\n187\t    transcript: &mut TS,\n188\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n189\t    ctx: ProvingContext<GenericGpuBackend<HS>>,\n190\t    common_main_pcs_data: StackedPcsDataGpu<F, HS::Digest>,\n191\t    r: &[EF],\n192\t) -> Result<\n193\t    (\n194\t        StackingProof<HS::SC>,\n195\t        Vec<EF>,\n196\t        Vec<StackedPcsData2<HS::Digest>>,\n197\t    ),\n198\t    StackedReductionError,\n199\t>\n200\twhere"}]},"parent_tool_use_id":"toolu_01SsLpYZqsjSNJyvURFPPJ4p","session_id":"8112afd3-6b71-4b0c-b23a-9001717999d3","uuid":"b5a1dafd-c842-47f9-b18f-7f3ebda149b9","timestamp":"2026-04-13T04:31:11.684Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ReqKqf9SitKGrNmhZsZbmb","type":"tool_result","content":"700\t            .iter()\n701\t            .map(|(air_idx, _)| pk.per_air[*air_idx].vk.params.need_rot)\n702\t            .collect::<Vec<_>>();\n703\t\n704\t        Ok(Self {\n705\t            alpha_logup,\n706\t            beta_pows,\n707\t            d_challenges,\n708\t            l_skip,\n709\t            n_logup,\n710\t            n_global,\n711\t            omega_skip,\n712\t            omega_skip_pows,\n713\t            d_omega_skip_pows,\n714\t            interactions_layout,\n715\t            constraint_degree,\n716\t            n_per_trace,\n717\t            max_num_constraints,\n718\t            sm_count,\n719\t            xi: vec![],\n720\t            lambda_pows: None,\n721\t            lambda_combinations: (0..pk.per_air.len()).map(|_| None).collect(),\n722\t            d_beta_pows,\n723\t            logup_combinations: (0..num_airs_present).map(|_| None).collect(),\n724\t            eq_xis: FxHashMap::default(),\n725\t            eq_3b_per_trace: vec![],\n726\t            d_eq_3b_per_trace: vec![],\n727\t            sels_per_trace_base: vec![],\n728\t            mat_evals_per_trace: vec![],\n729\t            sels_per_trace: vec![],\n730\t            public_values_per_trace: ctx\n731\t                .per_trace\n732\t                .iter()\n733\t                .map(|(_, air_ctx)| {\n734\t                    if air_ctx.public_values.is_empty() {\n735\t                        Ok(DeviceBuffer::new())\n736\t                    } else {\n737\t                        air_ctx.public_values.to_device()\n738\t                    }\n739\t                })\n740\t                .collect::<Result<Vec<_>, _>>()?,\n741\t            air_indices_per_trace: ctx\n742\t                .per_trace\n743\t                .iter()\n744\t                .map(|(air_idx, _)| *air_idx)\n745\t                .collect_vec(),\n746\t            zerocheck_tilde_evals: vec![EF::ZERO; num_airs_present],\n747\t            logup_tilde_evals: vec![[EF::ZERO; 2]; num_airs_present],\n748\t            needs_next_per_trace,\n749\t            trace_interactions,\n750\t            pk,\n751\t            prev_s_eval: EF::ZERO,\n752\t            eq_ns: Vec::with_capacity(n_max + 1),\n753\t            eq_sharp_ns: Vec::with_capacity(n_max + 1),\n754\t            mem,\n755\t            save_memory,\n756\t            gkr_mem_contribution: 0,\n757\t            memory_limit_bytes: 0, // Set after GKR input eval\n758\t            monomial_num_y_threshold,\n759\t        })\n760\t    }\n761\t\n762\t    // PERF[jpw]: we could return evals and batch zerocheck poly by degree before interpolating.\n763\t    // Cannot do it for logup because we need to calculate the sum claims.\n764\t    #[instrument(name = \"prover.rap_constraints.ple_round0\", level = \"info\", skip_all)]\n765\t    fn sumcheck_uni_round0_polys(\n766\t        &mut self,\n767\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n768\t        lambda: EF,\n769\t    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n770\t        self.mem\n771\t            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n772\t        self.mem.reset_peak();\n773\t        let n_logup = self.n_logup;\n774\t        let l_skip = self.l_skip;\n775\t        let xi = &self.xi;\n776\t        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n777\t        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n778\t            h_lambda_pows.to_device()?\n779\t        } else {\n780\t            DeviceBuffer::new()\n781\t        });\n782\t        // Precompute lambda combinations for all AIRs with monomials\n783\t        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n784\t        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n785\t            if air_pk.other_data.zerocheck_monomials.is_some() {\n786\t                self.lambda_combinations[air_idx] = Some(\n787\t                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n788\t                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n789\t                );\n790\t            }\n791\t        }\n792\t        let num_present_airs = ctx.per_trace.len();\n793\t        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n794\t\n795\t        self.eq_3b_per_trace = ctx\n796\t            .per_trace\n797\t            .iter()\n798\t            .enumerate()\n799\t            .map(|(trace_idx, (air_idx, _))| {\n800\t                let vk = &self.pk.per_air[*air_idx].vk;\n801\t                let num_interactions = vk.num_interactions();\n802\t                if num_interactions > 0 {\n803\t                    let n = self.n_per_trace[trace_idx];\n804\t                    let n_lift = n.max(0) as usize;\n805\t                    let mut b_vec = vec![F::ZERO; n_logup - n_lift];\n806\t                    let mut weights = Vec::with_capacity(num_interactions);\n807\t                    for interaction_idx in 0..num_interactions {\n808\t                        let stacked_idx = self\n809\t                            .interactions_layout\n810\t                            .get(trace_idx, interaction_idx)\n811\t                            .unwrap()\n812\t                            .row_idx;\n813\t                        let mut b_int = stacked_idx >> (l_skip + n_lift);\n814\t                        for bit in &mut b_vec {\n815\t                            *bit = F::from_bool(b_int & 1 == 1);\n816\t                            b_int >>= 1;\n817\t                        }\n818\t                        let weight =\n819\t                            eval_eq_mle(&self.xi[l_skip + n_lift..l_skip + n_logup], &b_vec);\n820\t                        weights.push(weight);\n821\t                    }\n822\t                    weights\n823\t                } else {\n824\t                    vec![]\n825\t                }\n826\t            })\n827\t            .collect_vec();\n828\t        self.d_eq_3b_per_trace = self\n829\t            .eq_3b_per_trace\n830\t            .iter()\n831\t            .map(|eq_3bs| {\n832\t                if eq_3bs.is_empty() {\n833\t                    Ok(DeviceBuffer::new())\n834\t                } else {\n835\t                    eq_3bs.to_device()\n836\t                }\n837\t            })\n838\t            .collect::<Result<Vec<_>, _>>()?;\n839\t\n840\t        // Precompute logup combinations for all traces with interaction monomials\n841\t        for (trace_idx, (air_idx, _)) in ctx.per_trace.iter().enumerate() {\n842\t            let air_pk = &self.pk.per_air[*air_idx];\n843\t            if air_pk.other_data.interaction_monomials.is_some()\n844\t                && !self.eq_3b_per_trace[trace_idx].is_empty()\n845\t            {\n846\t                self.logup_combinations[trace_idx] = Some(\n847\t                    compute_logup_combinations(\n848\t                        self.pk,\n849\t                        *air_idx,\n850\t                        &self.d_beta_pows,\n851\t                        &self.d_eq_3b_per_trace[trace_idx],\n852\t                        &self.eq_3b_per_trace[trace_idx],\n853\t                        &self.beta_pows,\n854\t                    )\n855\t                    .map_err(LogupZerocheckError::LogupCombinations)?,\n856\t                );\n857\t            }\n858\t        }\n859\t\n860\t        // PERF[jpw]: we could also build the layers for different n in a transposed way using\n861\t        // eq_nonoverlapping_stage_ext, which is more memory efficient\n862\t        for &n in &self.n_per_trace {\n863\t            let n_lift = n.max(0) as usize;\n864\t            if let Entry::Vacant(entry) = self.eq_xis.entry(n_lift) {\n865\t                let layers =\n866\t                    EqEvalLayers::new_rev(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n867\t                        .map_err(LogupZerocheckError::EqEvalLayers)?;\n868\t                entry.insert(layers);\n869\t            }\n870\t        }\n871\t\n872\t        self.sels_per_trace_base = self\n873\t            .n_per_trace\n874\t            .iter()\n875\t            .map(|&n| {\n876\t                let n_lift = n.max(0) as usize;\n877\t                let height = 1 << n_lift;\n878\t                let mut cols = F::zero_vec(3 * height);\n879\t                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n880\t                cols[0] = F::ONE; // is_first\n881\t                cols[2 * height + height - 1] = F::ONE; // is_last\n882\t                let d_cols = cols.to_device()?;\n883\t                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n884\t            })\n885\t            .collect::<Result<Vec<_>, MemCopyError>>()?;\n886\t\n887\t        let selectors_base = self.sels_per_trace_base.clone();\n888\t\n889\t        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n890\t        // present AIR\n891\t        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n892\t        let d_lambda_pows = self\n893\t            .lambda_pows\n894\t            .as_ref()\n895\t            .expect(\"lambda powers must be set before round-0 evaluation\");\n896\t\n897\t        // Phase 1: Build work items (main thread, pure CPU)\n898\t        let per_thread_temp_bytes = self.memory_limit_bytes / NUM_ROUND0_STREAMS.max(1);\n899\t        let mut work_items: Vec<Round0AirWorkItem<HS>> = izip!(\n900\t            &ctx.per_trace,\n901\t            &self.n_per_trace,\n902\t            &selectors_base,\n903\t            &self.public_values_per_trace,\n904\t            &self.eq_3b_per_trace,\n905\t        )\n906\t        .enumerate()\n907\t        .map(|(trace_idx, ((air_idx, air_ctx), &n, sel, pv, eq3b))| Round0AirWorkItem {\n908\t            trace_idx,\n909\t            single_pk: &self.pk.per_air[*air_idx],\n910\t            n,\n911\t            selectors_cube: sel,\n912\t            public_values: pv,\n913\t            eq_3bs: eq3b,\n914\t            cached_mains: &air_ctx.cached_mains,\n915\t            common_main: &air_ctx.common_main,\n916\t            eq_xis: &self.eq_xis,\n917\t            d_lambda_pows,\n918\t            beta_pows: &self.beta_pows,\n919\t            l_skip,\n920\t            constraint_degree: self.constraint_degree,\n921\t            xi: &self.xi,\n922\t            max_temp_bytes: per_thread_temp_bytes,\n923\t        })\n924\t        .collect();\n925\t\n926\t        // Sort by descending height for better load balance across thread chunks.\n927\t        work_items.sort_by(|a, b| b.common_main.height().cmp(&a.common_main.height()));\n928\t\n929\t        // Barrier: ensure all prior GPU work (trace uploads, pk data, selectors)\n930\t        // is visible to worker thread streams.\n931\t        current_stream_sync().map_err(MemCopyError::from)?;\n932\t\n933\t        // Phase 2: Process AIRs in parallel across N OS threads.\n934\t        // Only use multi-threading when there are enough AIRs to benefit from concurrent\n935\t        // kernel execution. With few large AIRs (e.g., APC 0 has ~20 per segment), each\n936\t        // kernel already saturates the GPU and multi-threading adds memory pool overhead.\n937\t        let num_threads = if work_items.len() >= 100 {\n938\t            NUM_ROUND0_STREAMS.min(work_items.len())\n939\t        } else {\n940\t            1\n941\t        };\n942\t        let results: Vec<Round0AirResult> = if num_threads <= 1 {\n943\t            work_items\n944\t                .iter()\n945\t                .map(|w| process_air_round0(w))\n946\t                .collect::<Result<Vec<_>, _>>()?\n947\t        } else {\n948\t            let chunk_size = work_items.len().div_ceil(num_threads);\n949\t            std::thread::scope(|s| {\n950\t                let handles: Vec<_> = work_items\n951\t                    .chunks(chunk_size)\n952\t                    .map(|chunk| {\n953\t                        s.spawn(move || -> Result<Vec<Round0AirResult>, LogupZerocheckError> {\n954\t                            chunk.iter().map(|w| process_air_round0(w)).collect()\n955\t                        })\n956\t                    })\n957\t                    .collect();\n958\t                let mut all_results = Vec::with_capacity(work_items.len());\n959\t                for handle in handles {\n960\t                    all_results.extend(handle.join().unwrap()?);\n961\t                }\n962\t                Ok::<_, LogupZerocheckError>(all_results)\n963\t            })?\n964\t        };\n965\t\n966\t        // Phase 3: Scatter results into batch_sp_poly (main thread, pure CPU)\n967\t        for result in results {\n968\t            if let Some(poly) = result.zerocheck_poly {\n969\t                batch_sp_poly[2 * num_present_airs + result.trace_idx] = poly;\n970\t            }\n971\t            if let Some(poly) = result.logup_numer_poly {\n972\t                batch_sp_poly[2 * result.trace_idx] = poly;\n973\t            }\n974\t            if let Some(poly) = result.logup_denom_poly {\n975\t                batch_sp_poly[2 * result.trace_idx + 1] = poly;\n976\t            }\n977\t        }\n978\t        self.mem\n979\t            .emit_metrics_with_label(\"prover.batch_constraints.round0\");\n980\t        Ok(batch_sp_poly)\n981\t    }\n982\t\n983\t    // Note: there are no gpu sync points in this function, so span does not indicate kernel times\n984\t    #[instrument(name = \"LogupZerocheck::fold_ple_evals\", level = \"debug\", skip_all)]\n985\t    fn fold_ple_evals(\n986\t        &mut self,\n987\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n988\t        r_0: EF,\n989\t    ) -> Result<(), LogupZerocheckError> {\n990\t        let l_skip = self.l_skip;\n991\t        let inv_lagrange_denoms_r0 =\n992\t            compute_barycentric_inv_lagrange_denoms(l_skip, &self.omega_skip_pows, r_0);\n993\t        let d_inv_lagrange_denoms_r0 = inv_lagrange_denoms_r0.to_device()?;\n994\t\n995\t        let mut mem_limit = self.gkr_mem_contribution;\n996\t        // GPU folding for mat_evals_per_trace\n997\t        self.mat_evals_per_trace = ctx\n998\t            .per_trace\n999\t            .iter()\n1000\t            .map(|(air_idx, air_ctx)| {\n1001\t                let air_pk = &self.pk.per_air[*air_idx];\n1002\t                let need_rot = air_pk.vk.params.need_rot;\n1003\t                let mut results: Vec<DeviceMatrix<EF>> = Vec::new();\n1004\t\n1005\t                // Preprocessed (if exists)\n1006\t                if let Some(committed) = &air_pk.preprocessed_data {\n1007\t                    let trace = &committed.trace;\n1008\t                    let folded = fold_ple_evals_rotate(\n1009\t                        l_skip,\n1010\t                        &self.d_omega_skip_pows,\n1011\t                        trace,\n1012\t                        &d_inv_lagrange_denoms_r0,\n1013\t                        need_rot,\n1014\t                    )?;\n1015\t                    results.push(folded);\n1016\t                }\n1017\t\n1018\t                // Cached mains\n1019\t                for committed in &air_ctx.cached_mains {\n1020\t                    let trace = &committed.trace;\n1021\t                    let folded = fold_ple_evals_rotate(\n1022\t                        l_skip,\n1023\t                        &self.d_omega_skip_pows,\n1024\t                        trace,\n1025\t                        &d_inv_lagrange_denoms_r0,\n1026\t                        need_rot,\n1027\t                    )?;\n1028\t                    results.push(folded);\n1029\t                }\n1030\t\n1031\t                // Common main\n1032\t                let trace = &air_ctx.common_main;\n1033\t                let folded = fold_ple_evals_rotate(\n1034\t                    l_skip,\n1035\t                    &self.d_omega_skip_pows,\n1036\t                    trace,\n1037\t                    &d_inv_lagrange_denoms_r0,\n1038\t                    need_rot,\n1039\t                )?;\n1040\t                mem_limit = mem_limit.saturating_sub(folded.buffer().len() * size_of::<EF>());\n1041\t                results.push(folded);\n1042\t\n1043\t                Ok(results)\n1044\t            })\n1045\t            .collect::<Result<Vec<_>, FoldPleError>>()?;\n1046\t        if self.save_memory {\n1047\t            self.memory_limit_bytes = mem_limit;\n1048\t        }\n1049\t\n1050\t        // GPU folding for sels_per_trace (rotate=false, only need offset=0)\n1051\t        self.sels_per_trace = std::mem::take(&mut self.sels_per_trace_base)\n1052\t            .into_iter()\n1053\t            .enumerate()\n1054\t            .map(|(trace_idx, selectors_cube)| {\n1055\t                let n = self.n_per_trace[trace_idx];\n1056\t                let num_x = selectors_cube.height();\n1057\t                debug_assert_eq!(num_x, 1 << n.max(0));\n1058\t                debug_assert_eq!(selectors_cube.width(), 3);\n1059\t                let (l, r) = if n.is_negative() {\n1060\t                    (\n1061\t                        l_skip.wrapping_add_signed(n),\n1062\t                        r_0.exp_power_of_2(-n as usize),\n1063\t                    )\n1064\t                } else {\n1065\t                    (l_skip, r_0)\n1066\t                };\n1067\t                let omega = F::two_adic_generator(l);\n1068\t                let is_first = eval_eq_uni_at_one(l, r);\n1069\t                let is_last = eval_eq_uni_at_one(l, r * omega);\n1070\t                let folded_buf = DeviceBuffer::<EF>::with_capacity(num_x * 3);\n1071\t                unsafe {\n1072\t                    fold_selectors_round0(\n1073\t                        folded_buf.as_mut_ptr(),\n1074\t                        selectors_cube.buffer().as_ptr(),\n1075\t                        is_first,\n1076\t                        is_last,\n1077\t                        num_x,\n1078\t                    )\n1079\t                    .map_err(LogupZerocheckError::FoldSelectorsRound0)?;\n1080\t                }\n1081\t                Ok(DeviceMatrix::new(Arc::new(folded_buf), num_x, 3))\n1082\t            })\n1083\t            .collect::<Result<Vec<_>, LogupZerocheckError>>()?;\n1084\t\n1085\t        // GPU scalar multiplication for eq_xi_per_trace and eq_sharp_per_trace\n1086\t        // Compute scalars on CPU (small computation)\n1087\t        let eq_r0 = eval_eq_uni(l_skip, self.xi[0], r_0);\n1088\t        let eq_sharp_r0 = eval_eq_sharp_uni(&self.omega_skip_pows, &self.xi[..l_skip], r_0);\n1089\t        self.eq_ns.push(eq_r0);\n1090\t        self.eq_sharp_ns.push(eq_sharp_r0);\n1091\t        for tree in self.eq_xis.values_mut() {\n1092\t            // trim the back (which corresponds to r_{j-1}) because we don't need it anymore\n1093\t            if tree.layers.len() > 1 {\n1094\t                tree.layers.pop();\n1095\t            }\n1096\t        }\n1097\t\n1098\t        self.mem\n1099\t            .emit_metrics_with_label(\"prover.batch_constraints.fold_ple_evals\");"}]},"parent_tool_use_id":"toolu_01VJiYRQA9nt5XbKFFAXpUpv","session_id":"8112afd3-6b71-4b0c-b23a-9001717999d3","uuid":"97ddb4ce-1926-4a33-9529-a84f909ff1f5","timestamp":"2026-04-13T04:31:11.869Z"}
