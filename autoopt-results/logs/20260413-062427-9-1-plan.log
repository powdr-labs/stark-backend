  bool const is_identity_coset = (coset_idx == 0);\n362\t\n363\t    // Precompute values for this single coset\n364\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n365\t    Fp const omega_skip = TWO_ADIC_GENERATORS[l_skip];\n366\t\n367\t    uint32_t const log_height_total = __ffs(height) - 1;\n368\t    uint32_t const log_segment = min(l_skip, log_height_total);\n369\t    uint32_t const segment_size = 1u << log_segment;\n370\t    uint32_t const log_stride = l_skip - log_segment;\n371\t\n372\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n373\t    Fp const omega_skip_ntt = pow(omega_skip, ntt_idx);\n374\t\n375\t    // Compute for single coset: coset 0 has shift=1, rest have shift=g^coset_idx\n376\t    Fp const g_coset = is_identity_coset ? Fp::one() : pow(g_shift, coset_idx);\n377\t    Fp const eval_point = is_identity_coset ? omega_skip_ntt : (g_coset * omega_skip_ntt);\n378\t    Fp const omega = exp_power_of_2(eval_point, log_stride);\n379\t    Fp const is_first_mult = avg_gp(omega, segment_size);\n380\t    Fp const is_last_mult = avg_gp(omega * eta, segment_size);\n381\t    Fp const omega_shift = is_identity_coset ? Fp::one() : pow(g_coset, ntt_idx_rev);\n382\t\n383\t    // Intermediate buffer setup (single coset, no NUM_COSETS multiplier)\n384\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD];\n385\t    Fp *inter_buffer;\n386\t    uint32_t buffer_stride;\n387\t    if constexpr (GLOBAL) {\n388\t        // Layout: [buffer_size][num_cosets * num_threads_per_coset]\n389\t        uint32_t global_tidx = coset_idx * gridDim.x * blockDim.x + tidx;\n390\t        inter_buffer = d_intermediates + global_tidx;\n391\t        buffer_stride = gridDim.x * gridDim.y * blockDim.x;\n392\t    } else {\n393\t        inter_buffer = local_buffer;\n394\t        buffer_stride = 1;\n395\t    }\n396\t\n397\t    FracExt sum = {FpExt(Fp::zero()), FpExt(Fp::zero())};\n398\t\n399\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n400\t"}]},"par