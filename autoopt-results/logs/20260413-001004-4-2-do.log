(\n            &mut elapsed_ms,\n            start.event,\n            stop.event,\n        ))?\n    };\n\n    metrics::gauge!(name.into()).set(elapsed_ms as f64);\n    Ok(res)\n}\n","numLines":248,"startLine":1,"totalLines":248}}}
