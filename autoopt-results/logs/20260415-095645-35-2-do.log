{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QfhG3yinPSdKFZ4LuJw3ge","type":"tool_result","content":"1\t#![allow(non_camel_case_types, non_upper_case_globals, non_snake_case)]\n2\t\n3\tuse std::{\n4\t    collections::{BTreeMap, HashMap},\n5\t    ffi::c_void,\n6\t    sync::Arc,\n7\t};\n8\t\n9\tuse bytesize::ByteSize;\n10\t\n11\tuse super::cuda::*;\n12\tuse crate::{\n13\t    common::set_device,\n14\t    error::MemoryError,\n15\t    stream::{\n16\t        current_stream_id, current_stream_sync, default_stream_wait, CudaEvent, CudaStreamId,\n17\t    },\n18\t};\n19\t\n20\t#[link(name = \"cudart\")]\n21\textern \"C\" {\n22\t    fn cudaMemGetInfo(free_bytes: *mut usize, total_bytes: *mut usize) -> i32;\n23\t}\n24\t\n25\t// ============================================================================\n26\t// Configuration\n27\t// ============================================================================\n28\t\n29\tconst DEFAULT_VA_SIZE: usize = 8 << 40; // 8 TB\n30\t\n31\t/// Configuration for the Virtual Memory Pool.\n32\t///\n33\t/// Use `VpmmConfig::from_env()` to load from environment variables,\n34\t/// or construct directly for testing.\n35\t#[derive(Debug, Clone)]\n36\tpub(super) struct VpmmConfig {\n37\t    /// Page size override. If `None`, uses CUDA's minimum granularity for the device.\n38\t    pub page_size: Option<usize>,\n39\t    /// Virtual address space size per reserved chunk (default: 8 TB).\n40\t    pub va_size: usize,\n41\t    /// Number of pages to preallocate at startup (default: 0).\n42\t    pub initial_pages: usize,\n43\t}\n44\t\n45\timpl Default for VpmmConfig {\n46\t    fn default() -> Self {\n47\t        Self {\n48\t            page_size: None,\n49\t            va_size: DEFAULT_VA_SIZE,\n50\t            initial_pages: 0,\n51\t        }\n52\t    }\n53\t}\n54\t\n55\timpl VpmmConfig {\n56\t    /// Load configuration from environment variables:\n57\t    /// - `VPMM_PAGE_SIZE`: Page size in bytes (must be multiple of CUDA granularity)\n58\t    /// - `VPMM_VA_SIZE`: Virtual address space size per chunk (default: 8 TB)\n59\t    /// - `VPMM_PAGES`: Number of pages to preallocate (default: 0)\n60\t    pub fn from_env() -> Self {\n61\t        let page_size = std::env::var(\"VPMM_PAGE_SIZE\").ok().map(|val| {\n62\t            let size: usize = val.parse().expect(\"VPMM_PAGE_SIZE must be a valid number\");\n63\t            assert!(size > 0, \"VPMM_PAGE_SIZE must be > 0\");\n64\t            size\n65\t        });\n66\t\n67\t        let va_size = match std::env::var(\"VPMM_VA_SIZE\") {\n68\t            Ok(val) => {\n69\t                let size: usize = val.parse().expect(\"VPMM_VA_SIZE must be a valid number\");\n70\t                assert!(size > 0, \"VPMM_VA_SIZE must be > 0\");\n71\t                size\n72\t            }\n73\t            Err(_) => DEFAULT_VA_SIZE,\n74\t        };\n75\t\n76\t        let initial_pages = match std::env::var(\"VPMM_PAGES\") {\n77\t            Ok(val) => val.parse().expect(\"VPMM_PAGES must be a valid number\"),\n78\t            Err(_) => 0,\n79\t        };\n80\t\n81\t        Self {\n82\t            page_size,\n83\t            va_size,\n84\t            initial_pages,\n85\t        }\n86\t    }\n87\t}\n88\t\n89\t// ============================================================================\n90\t// Pool Implementation\n91\t// ============================================================================\n92\t\n93\t/// Metadata for a free region in the virtual address space.\n94\t#[derive(Debug, Clone)]\n95\tstruct FreeRegionMeta {\n96\t    size: usize,\n97\t    event: Arc<CudaEvent>,\n98\t    stream_id: CudaStreamId,\n99\t    id: usize,\n100\t}\n101\t\n102\t/// Remapped region that will be unmapped when the event completes.\n103\t#[derive(Debug)]\n104\tstruct ZombieRegion {\n105\t    ptr: CUdeviceptr,\n106\t    size: usize,\n107\t    event: Arc<CudaEvent>,\n108\t}\n109\t\n110\t/// Virtual memory pool implementation.\n111\tpub(super) struct VirtualMemoryPool {\n112\t    // Virtual address space roots\n113\t    pub(super) roots: Vec<CUdeviceptr>,\n114\t\n115\t    // Map for all active pages\n116\t    active_pages: HashMap<CUdeviceptr, CUmemGenericAllocationHandle>,\n117\t\n118\t    // Free regions in virtual space (sorted by address)\n119\t    free_regions: BTreeMap<CUdeviceptr, FreeRegionMeta>,\n120\t\n121\t    // Active allocations: (ptr, size)\n122\t    malloc_regions: HashMap<CUdeviceptr, usize>,\n123\t\n124\t    // Unmapped regions: (ptr, size)\n125\t    unmapped_regions: BTreeMap<CUdeviceptr, usize>,\n126\t\n127\t    // Zombie regions: (remapped, but not unmapped yet)\n128\t    zombie_regions: Vec<ZombieRegion>,\n129\t\n130\t    // Number of free calls (used to assign ids to free regions)\n131\t    free_num: usize,\n132\t\n133\t    // Granularity size: (page % 2MB must be 0)\n134\t    pub(super) page_size: usize,\n135\t\n136\t    // Reserved virtual address span in bytes\n137\t    va_size: usize,\n138\t\n139\t    // Device ordinal\n140\t    pub(super) device_id: i32,\n141\t}\n142\t\n143\t/// # Safety\n144\t/// `VirtualMemoryPool` is not internally synchronized. These impls are safe because\n145\t/// all access goes through `Mutex<MemoryManager>` in the parent module.\n146\tunsafe impl Send for VirtualMemoryPool {}\n147\tunsafe impl Sync for VirtualMemoryPool {}\n148\t\n149\timpl VirtualMemoryPool {\n150\t    pub(super) fn new(config: VpmmConfig) -> Self {\n151\t        let device_id = set_device().unwrap();\n152\t\n153\t        // Check VPMM support and resolve page_size\n154\t        let (root, page_size, va_size) = unsafe {\n155\t            match vpmm_check_support(device_id) {\n156\t                Ok(_) => {\n157\t                    let granularity = vpmm_min_granularity(device_id).unwrap();\n158\t\n159\t                    // Resolve page_size: use config override or device granularity\n160\t                    let page_size = match config.page_size {\n161\t                        Some(size) => {\n162\t                            assert!(\n163\t                                size > 0 && size % granularity == 0,\n164\t                                \"VPMM_PAGE_SIZE must be > 0 and multiple of {}\",\n165\t                                granularity\n166\t                            );\n167\t                            size\n168\t                        }\n169\t                        None => {\n170\t                            // Use 8x the minimum granularity (typically 16 MiB) to reduce\n171\t                            // the number of cuMemCreate calls for large allocations.\n172\t                            // Each cuMemCreate has ~0.4ms driver overhead; with 2 MiB pages\n173\t                            // a 256 MiB allocation requires 128 calls (~51ms). With 16 MiB\n174\t                            // pages it requires only 16 calls (~6ms).\n175\t                            // Allocations smaller than the page size use cudaMallocAsync.\n176\t                            8 * granularity\n177\t                        }\n178\t                    };\n179\t\n180\t                    // Validate va_size\n181\t                    let va_size = config.va_size;\n182\t                    assert!(\n183\t                        va_size > 0 && va_size.is_multiple_of(page_size),\n184\t                        \"VPMM_VA_SIZE must be > 0 and multiple of page size ({})\",\n185\t                        page_size\n186\t                    );\n187\t\n188\t                    // Reserve initial VA chunk\n189\t                    let va_base = vpmm_reserve(va_size, page_size).unwrap();\n190\t                    tracing::debug!(\n191\t                        \"VPMM: Reserved virtual address space {} with page size {}\",\n192\t                        ByteSize::b(va_size as u64),\n193\t                        ByteSize::b(page_size as u64)\n194\t                    );\n195\t                    (va_base, page_size, va_size)\n196\t                }\n197\t                Err(_) => {\n198\t                    tracing::warn!(\"VPMM not supported, falling back to cudaMallocAsync\");\n199\t                    (0, usize::MAX, 0)\n200\t                }\n201\t            }\n202\t        };\n203\t\n204\t        let mut pool = Self {\n205\t            roots: vec![root],\n206\t            active_pages: HashMap::new(),\n207\t            free_regions: BTreeMap::new(),\n208\t            malloc_regions: HashMap::new(),\n209\t            unmapped_regions: if va_size > 0 {\n210\t                BTreeMap::from_iter([(root, va_size)])\n211\t            } else {\n212\t                BTreeMap::new()\n213\t            },\n214\t            zombie_regions: Vec::new(),\n215\t            free_num: 0,\n216\t            page_size,\n217\t            va_size,\n218\t            device_id,\n219\t        };\n220\t\n221\t        // Preallocate pages if requested (skip if VPMM not supported)\n222\t        if config.initial_pages > 0 && page_size != usize::MAX {\n223\t            let alloc_size = config.initial_pages * page_size;\n224\t            if let Err(e) =\n225\t                pool.defragment_or_create_new_pages(alloc_size, current_stream_id().unwrap())\n226\t            {\n227\t                let mut free_mem = 0usize;\n228\t                let mut total_mem = 0usize;\n229\t                unsafe {\n230\t                    cudaMemGetInfo(&mut free_mem, &mut total_mem);\n231\t                }\n232\t                panic!(\n233\t                    \"VPMM preallocation failed: {:?}\\n\\\n234\t                     Config: pages={}, page_size={}\\n\\\n235\t                     GPU Memory: free={}, total={}\",\n236\t                    e,\n237\t                    config.initial_pages,\n238\t                    ByteSize::b(page_size as u64),\n239\t                    ByteSize::b(free_mem as u64),\n240\t                    ByteSize::b(total_mem as u64)\n241\t                );\n242\t            }\n243\t        }\n244\t\n245\t        pool\n246\t    }\n247\t\n248\t    /// Allocates memory from the pool's free regions.\n249\t    /// Attempts defragmentation if no suitable free region exists.\n250\t    /// Returns an error if there's insufficient memory even after defragmentation.\n251\t    pub(super) fn malloc_internal(\n252\t        &mut self,\n253\t        requested: usize,\n254\t        stream_id: CudaStreamId,\n255\t    ) -> Result<*mut c_void, MemoryError> {\n256\t        debug_assert!(\n257\t            requested != 0 && requested.is_multiple_of(self.page_size),\n258\t            \"Requested size must be a multiple of the page size\"\n259\t        );\n260\t\n261\t        // Phase 0: Cleanup zombie regions\n262\t        self.cleanup_zombie_regions();\n263\t\n264\t        // Phase 1: Zero-cost attempts\n265\t        let mut best_region = self.find_best_fit(requested, stream_id);\n266\t\n267\t        if best_region.is_none() {\n268\t            // Phase 2: Defragmentation\n269\t            best_region = self.defragment_or_create_new_pages(requested, stream_id)?;\n270\t        }\n271\t\n272\t        if let Some(ptr) = best_region {\n273\t            let region = self\n274\t                .free_regions\n275\t                .remove(&ptr)\n276\t                .expect(\"BUG: free region address not found after find_best_fit\");\n277\t            debug_assert_eq!(region.stream_id, stream_id);\n278\t\n279\t            // If region is larger, return remainder to free list\n280\t            if region.size > requested {\n281\t                self.free_regions.insert(\n282\t                    ptr + requested as u64,\n283\t                    FreeRegionMeta {\n284\t                        size: region.size - requested,\n285\t                        event: region.event,\n286\t                        stream_id,\n287\t                        id: region.id,\n288\t                    },\n289\t                );\n290\t            }\n291\t\n292\t            self.malloc_regions.insert(ptr, requested);\n293\t            return Ok(ptr as *mut c_void);\n294\t        }\n295\t\n296\t        Err(MemoryError::OutOfMemory {\n297\t            requested,\n298\t            available: self.free_regions.values().map(|r| r.size).sum(),\n299\t        })\n300\t    }\n301\t\n302\t    /// Reclaims zombie regions whose events have completed.\n303\t    ///\n304\t    /// Zombies are old regions that have been double-mapped to new locations during defrag.\n305\t    /// Once the associated event completes (meaning no GPU work is using the old VA),\n306\t    /// we can safely unmap the old VA and return it to `unmapped_regions` for reuse.\n307\t    fn cleanup_zombie_regions(&mut self) {\n308\t        let mut i = 0;\n309\t        while i < self.zombie_regions.len() {\n310\t            if self.zombie_regions[i].event.completed() {\n311\t                let zombie = self.zombie_regions.swap_remove(i);\n312\t                if let Err(e) = unsafe { vpmm_unmap(zombie.ptr, zombie.size) } {\n313\t                    tracing::error!(\n314\t                        \"vpmm_unmap (zombie) failed: addr={:#x}, size={}: {:?}\",\n315\t                        zombie.ptr,\n316\t                        zombie.size,\n317\t                        e\n318\t                    );\n319\t                }\n320\t                self.insert_unmapped_region(zombie.ptr, zombie.size);\n321\t            } else {\n322\t                i += 1;\n323\t            }\n324\t        }\n325\t    }\n326\t\n327\t    /// Phase 1: Try to find a suitable free region without defragmentation\n328\t    /// Returns address if found, None otherwise\n329\t    fn find_best_fit(&mut self, requested: usize, stream_id: CudaStreamId) -> Option<CUdeviceptr> {\n330\t        let mut candidates: Vec<(CUdeviceptr, &mut FreeRegionMeta)> = self\n331\t            .free_regions\n332\t            .iter_mut()\n333\t            .filter(|(_, region)| region.size >= requested)\n334\t            .map(|(addr, region)| (*addr, region))\n335\t            .collect();\n336\t\n337\t        if candidates.is_empty() {\n338\t            return None;\n339\t        }\n340\t\n341\t        // 1a. Prefer current stream (smallest fit) - could be not completed\n342\t        if let Some((addr, _)) = candidates\n343\t            .iter()\n344\t            .filter(|(_, region)| region.stream_id == stream_id)\n345\t            .min_by_key(|(_, region)| region.size)\n346\t        {\n347\t            return Some(*addr);\n348\t        }\n349\t\n350\t        // 1b. Other streams (smallest fit) - ONLY if already completed (no sync)\n351\t        candidates\n352\t            .iter_mut()\n353\t            .filter(|(_, region)| region.event.completed())\n354\t            .min_by_key(|(_, region)| region.size)\n355\t            .map(|(addr, region)| {\n356\t                region.stream_id = stream_id;\n357\t                *addr\n358\t            })\n359\t    }\n360\t\n361\t    /// Frees a pointer and returns the size of the freed memory.\n362\t    /// Coalesces adjacent free regions.\n363\t    ///\n364\t    /// # Assumptions\n365\t    /// No CUDA streams will use the malloc region starting at `ptr` after the newly recorded event\n366\t    /// on `stream_id` at this point in time.\n367\t    pub(super) fn free_internal(\n368\t        &mut self,\n369\t        ptr: *mut c_void,\n370\t        stream_id: CudaStreamId,\n371\t    ) -> Result<usize, MemoryError> {\n372\t        let ptr = ptr as CUdeviceptr;\n373\t        let size = self\n374\t            .malloc_regions\n375\t            .remove(&ptr)\n376\t            .ok_or(MemoryError::InvalidPointer)?;\n377\t\n378\t        let _ = self.free_region_insert(ptr, size, stream_id);\n379\t\n380\t        Ok(size)\n381\t    }\n382\t\n383\t    /// Inserts a new free region for `(ptr, size)` into the free regions map, **possibly** merging\n384\t    /// with existing adjacent regions. Merges only occur if the regions are both adjacent in memory\n385\t    /// and on the same stream as `stream_id`. The new free region always records a new event on the\n386\t    /// stream.\n387\t    ///\n388\t    /// Returns the starting pointer and size of the (possibly merged) free region containing `(ptr,\n389\t    /// size)`.\n390\t    fn free_region_insert(\n391\t        &mut self,\n392\t        mut ptr: CUdeviceptr,\n393\t        mut size: usize,\n394\t        stream_id: CudaStreamId,\n395\t    ) -> (CUdeviceptr, usize) {\n396\t        // Potential merge with next neighbor\n397\t        if let Some((&next_ptr, next_region)) = self.free_regions.range(ptr + 1..).next() {\n398\t            if next_region.stream_id == stream_id && ptr + size as u64 == next_ptr {\n399\t                let next_region = self.free_regions.remove(&next_ptr).unwrap();\n400\t                size += next_region.size;\n401\t            }\n402\t        }\n403\t        // Potential merge with previous neighbor\n404\t        if let Some((&prev_ptr, prev_region)) = self.free_regions.range(..ptr).next_back() {\n405\t            if prev_region.stream_id == stream_id && prev_ptr + prev_region.size as u64 == ptr {\n406\t                let prev_region = self.free_regions.remove(&prev_ptr).unwrap();\n407\t                ptr = prev_ptr;\n408\t                size += prev_region.size;\n409\t            }\n410\t        }\n411\t        // Record a new event to capture the current point in the stream\n412\t        let event = Arc::new(CudaEvent::new().unwrap());\n413\t        event.record_on_this().unwrap();\n414\t        // Assign an id to the free region\n415\t        let id = self.free_num;\n416\t        self.free_num += 1;\n417\t\n418\t        self.free_regions.insert(\n419\t            ptr,\n420\t            FreeRegionMeta {\n421\t                size,\n422\t                event,\n423\t                stream_id,\n424\t                id,\n425\t            },\n426\t        );\n427\t        (ptr, size)\n428\t    }\n429\t\n430\t    /// Return the base address of a virtual hole large enough for `requested` bytes.\n431\t    ///\n432\t    /// The returned region is not inside `free_region` or `unmapped_region` map and must be\n433\t    /// properly handled.\n434\t    fn take_unmapped_region(&mut self, requested: usize) -> Result<CUdeviceptr, MemoryError> {\n435\t        debug_assert!(requested != 0);\n436\t        debug_assert_eq!(requested % self.page_size, 0);\n437\t\n438\t        if let Some((&addr, &size)) = self\n439\t            .unmapped_regions\n440\t            .iter()\n441\t            .filter(|(_, region_size)| **region_size >= requested)\n442\t            .min_by_key(|(_, region_size)| *region_size)\n443\t        {\n444\t            self.unmapped_regions.remove(&addr);\n445\t            if size > requested {\n446\t                self.unmapped_regions\n447\t                    .insert(addr + requested as u64, size - requested);\n448\t            }\n449\t            return Ok(addr);\n450\t        }\n451\t\n452\t        let addr = unsafe {\n453\t            vpmm_reserve(self.va_size, self.page_size).map_err(|_| MemoryError::ReserveFailed {\n454\t                size: self.va_size,\n455\t                page_size: self.page_size,\n456\t            })?\n457\t        };\n458\t        self.roots.push(addr);\n459\t        self.insert_unmapped_region(addr + requested as u64, self.va_size - requested);\n460\t        Ok(addr)\n461\t    }\n462\t\n463\t    /// Insert a hole back into the unmapped set, coalescing with neighbors.\n464\t    fn insert_unmapped_region(&mut self, mut addr: CUdeviceptr, mut size: usize) {\n465\t        if size == 0 {\n466\t            return;\n467\t        }\n468\t\n469\t        if let Some((&prev_addr, &prev_size)) = self.unmapped_regions.range(..addr).next_back() {\n470\t            if prev_addr + prev_size as u64 == addr {\n471\t                self.unmapped_regions.remove(&prev_addr);\n472\t                addr = prev_addr;\n473\t                size += prev_size;\n474\t            }\n475\t        }\n476\t\n477\t        if let Some((&next_addr, &next_size)) = self.unmapped_regions.range(addr + 1..).next() {\n478\t            if addr + size as u64 == next_addr {\n479\t                self.unmapped_regions.remove(&next_addr);\n480\t                size += next_size;\n481\t            }\n482\t        }\n483\t\n484\t        self.unmapped_regions.insert(addr, size);\n485\t    }\n486\t\n487\t    /// Roll back partially allocated pages when allocation fails.\n488\t    /// Unmaps and releases any mapped pages and restores the reserved VA span.\n489\t    fn rollback_new_pages(\n490\t        &mut self,\n491\t        reserved_ptr: CUdeviceptr,\n492\t        reserved_size: usize,\n493\t        allocated_pages: &[(CUdeviceptr, CUmemGenericAllocationHandle)],\n494\t    ) {\n495\t        for (addr, handle) in allocated_pages {\n496\t            if let Err(e) = unsafe { vpmm_unmap(*addr, self.page_size) } {\n497\t                tracing::error!(\n498\t                    \"rollback: vpmm_unmap failed: addr={:#x}, size={}: {:?}\",\n499\t                    addr,\n500\t                    self.page_size,\n501\t                    e\n502\t                );\n503\t            }\n504\t            self.active_pages.remove(addr);\n505\t            if let Err(e) = unsafe { vpmm_release(*handle) } {\n506\t                tracing::error!(\"rollback: vpmm_release failed: handle={}: {:?}\", handle, e);\n507\t            }\n508\t        }\n509\t        self.insert_unmapped_region(reserved_ptr, reserved_size);\n510\t    }\n511\t\n512\t    /// Defragments the pool by reusing existing holes and, if needed, reserving more VA space.\n513\t    /// Moves just enough pages to satisfy `requested`, keeping the remainder in place.\n514\t    ///\n515\t    /// The returned `pointer`, if not `None`, is guaranteed to exist as a key in the `free_regions`\n516\t    /// map. The corresponding free region will have size `>= requested`. Note the size _may_ be\n517\t    /// larger than requested.\n518\t    fn defragment_or_create_new_pages(\n519\t        &mut self,\n520\t        requested: usize,\n521\t        stream_id: CudaStreamId,\n522\t    ) -> Result<Option<CUdeviceptr>, MemoryError> {\n523\t        debug_assert_eq!(requested % self.page_size, 0);\n524\t        if requested == 0 {\n525\t            return Ok(None);\n526\t        }\n527\t\n528\t        let total_free_size = self.free_regions.values().map(|r| r.size).sum::<usize>();\n529\t        tracing::debug!(\n530\t            \"VPMM: Defragging or creating new pages: requested={}, free={} stream_id={}\",\n531\t            ByteSize::b(requested as u64),\n532\t            ByteSize::b(total_free_size as u64),\n533\t            stream_id\n534\t        );\n535\t\n536\t        // Find a best fit unmapped region\n537\t        let dst = self.take_unmapped_region(requested)?;\n538\t        // Sentinel value until we have a valid free region pointer from allocation\n539\t        let mut allocated_ptr = CUdeviceptr::MAX;\n540\t\n541\t        // Allocate new pages if we don't have enough free regions\n542\t        let mut allocated_dst = dst;\n543\t        let mut allocate_size = requested.saturating_sub(total_free_size);\n544\t        debug_assert_eq!(allocate_size % self.page_size, 0);\n545\t        let mut allocated_pages: Vec<(CUdeviceptr, CUmemGenericAllocationHandle)> = Vec::new();\n546\t        while allocated_dst < dst + allocate_size as u64 {\n547\t            let handle = unsafe {\n548\t                match vpmm_create_physical(self.device_id, self.page_size) {\n549\t                    Ok(handle) => handle,\n550\t                    Err(e) => {\n551\t                        tracing::error!(\n552\t                            \"vpmm_create_physical failed: device={}, page_size={}: {:?}\",\n553\t                            self.device_id,\n554\t                            self.page_size,\n555\t                            e\n556\t                        );\n557\t                        if e.is_out_of_memory() {\n558\t                            self.rollback_new_pages(dst, requested, &allocated_pages);\n559\t                            return Err(MemoryError::OutOfMemory {\n560\t                                requested: allocate_size,\n561\t                                available: (allocated_dst - dst) as usize,\n562\t                            });\n563\t                        } else {\n564\t                            return Err(MemoryError::from(e));\n565\t                        }\n566\t                    }\n567\t                }\n568\t            };\n569\t            unsafe {\n570\t                vpmm_map(allocated_dst, self.page_size, handle).map_err(|e| {\n571\t                    tracing::error!(\n572\t                        \"vpmm_map failed: addr={:#x}, page_size={}, handle={}: {:?}\",\n573\t                        allocated_dst,\n574\t                        self.page_size,\n575\t                        handle,\n576\t                        e\n577\t                    );\n578\t                    MemoryError::from(e)\n579\t                })?;\n580\t            }\n581\t            self.active_pages.insert(allocated_dst, handle);\n582\t            allocated_pages.push((allocated_dst, handle));\n583\t            allocated_dst += self.page_size as u64;\n584\t        }\n585\t        debug_assert_eq!(allocated_dst, dst + allocate_size as u64);\n586\t        if allocate_size > 0 {\n587\t            tracing::debug!(\n588\t                \"VPMM: Allocated {} bytes on stream {}. Total allocated: {}\",\n589\t                ByteSize::b(allocate_size as u64),\n590\t                stream_id,\n591\t                ByteSize::b(self.memory_usage() as u64)\n592\t            );\n593\t            unsafe {\n594\t                vpmm_set_access(dst, allocate_size, self.device_id).map_err(|e| {\n595\t                    tracing::error!(\n596\t                        \"vpmm_set_access failed: addr={:#x}, size={}, device={}: {:?}\",\n597\t                        dst,\n598\t                        allocate_size,\n599\t                        self.device_id,\n600\t                        e\n601\t                    );\n602\t                    MemoryError::from(e)\n603\t                })?;\n604\t            }\n605\t            let (merged_ptr, merged_size) = self.free_region_insert(dst, allocate_size, stream_id);\n606\t            debug_assert!(merged_size >= allocate_size);\n607\t            allocated_ptr = merged_ptr;\n608\t            allocate_size = merged_size;\n609\t        }\n610\t        // At this point, allocated_ptr is either\n611\t        // - CUdeviceptr::MAX if no allocations occurred\n612\t        // - or some pointer `<= dst` for the start of a free region (with VA-mapping) of at least\n613\t        //   `requested` bytes. The case `allocated_ptr < dst` happens if `free_region_insert`\n614\t        //   merged the allocated region with a previous free region. This only happens if the\n615\t        //   previous free region is on the same `stream_id`. In this case, we have\n616\t        //   [allocated_ptr..dst][dst..allocated_dst] which is all free and safe to use on the\n617\t        //   stream `stream_id` _without_ synchronization, because all events will be sequenced\n618\t        //   afterwards on the stream.\n619\t        let mut remaining = requested.saturating_sub(allocate_size);\n620\t        if remaining == 0 {\n621\t            debug_assert_ne!(\n622\t                allocated_ptr,\n623\t                CUdeviceptr::MAX,\n624\t                \"Allocation returned no valid free region\"\n625\t            );\n626\t            return Ok(Some(allocated_ptr));\n627\t        }\n628\t        debug_assert!(allocate_size == 0 || allocated_ptr <= dst);\n629\t\n630\t        // Pull free regions (current stream first, the other stream oldest first) until we've\n631\t        // gathered enough pages.\n632\t        let mut to_defrag: Vec<(CUdeviceptr, usize)> = Vec::new();\n633\t        let mut ordered_free_regions: Vec<_> = self\n634\t            .free_regions\n635\t            .iter()\n636\t            .filter(|(&addr, _)| allocate_size == 0 || addr != allocated_ptr)\n637\t            .map(|(&addr, region)| (region.stream_id != stream_id, region.id, addr))\n638\t            .collect();\n639\t        ordered_free_regions.sort_by_key(|(is_other, id, _)| (*is_other, *id));\n640\t        for (other_stream, _, addr) in ordered_free_regions {\n641\t            if remaining == 0 {\n642\t                break;\n643\t            }\n644\t\n645\t            let region = self\n646\t                .free_regions\n647\t                .remove(&addr)\n648\t                .expect(\"BUG: free region disappeared\");\n649\t\n650\t            if other_stream && !region.event.completed() {\n651\t                // default_stream_wait always uses current stream (= stream_id)\n652\t                default_stream_wait(&region.event)?;\n653\t            }\n654\t\n655\t            let take = remaining.min(region.size);\n656\t\n657\t            self.zombie_regions.push(ZombieRegion {\n658\t                ptr: addr,\n659\t                size: take,\n660\t                event: region.event.clone(),\n661\t            });\n662\t\n663\t            to_defrag.push((addr, take));\n664\t            remaining -= take;\n665\t\n666\t            if region.size > take {\n667\t                // Return the unused tail to the free list so it stays available.\n668\t                let leftover_addr = addr + take as u64;\n669\t                let leftover_size = region.size - take;\n670\t                let _ = self.free_region_insert(leftover_addr, leftover_size, region.stream_id);\n671\t            }\n672\t        }\n673\t        let remapped_ptr = self.remap_regions(to_defrag, allocated_dst, stream_id)?;\n674\t        // Take the minimum in case allocated_ptr is CUdeviceptr::MAX when allocate_size = 0\n675\t        let result = std::cmp::min(allocated_ptr, remapped_ptr);\n676\t        debug_assert!(allocate_size == 0 || allocated_ptr == remapped_ptr);\n677\t        debug_assert_ne!(\n678\t            result,\n679\t            CUdeviceptr::MAX,\n680\t            \"Both allocation and remapping returned no valid free region\"\n681\t        );\n682\t        Ok(Some(result))\n683\t    }\n684\t\n685\t    /// Remap a list of regions to a new base address via double-mapping.\n686\t    ///\n687\t    /// The regions are mapped consecutively starting at `dst`. The old regions remain mapped\n688\t    /// (double-mapped) and are added to `zombie_regions` by the caller for async unmap.\n689\t    ///\n690\t    /// Returns the starting pointer of the new remapped free region or `CUdeviceptr::MAX` if no\n691\t    /// remapping is needed.\n692\t    ///\n693\t    /// # Assumptions\n694\t    /// The regions are already removed from the free regions map.\n695\t    fn remap_regions(\n696\t        &mut self,\n697\t        regions: Vec<(CUdeviceptr, usize)>,\n698\t        dst: CUdeviceptr,\n699\t        stream_id: CudaStreamId,\n700\t    ) -> Result<CUdeviceptr, MemoryError> {\n701\t        if regions.is_empty() {\n702\t            // Nothing to remap; return sentinel so caller's min() picks the other operand\n703\t            return Ok(CUdeviceptr::MAX);\n704\t        }\n705\t\n706\t        let bytes_to_remap = regions.iter().map(|(_, size)| *size).sum::<usize>();\n707\t        tracing::debug!(\n708\t            \"VPMM: Remapping {} regions. Total size = {}\",\n709\t            regions.len(),\n710\t            ByteSize::b(bytes_to_remap as u64)\n711\t        );\n712\t\n713\t        let mut curr_dst = dst;\n714\t        for (region_addr, region_size) in regions {\n715\t            // Double-map: map pages to new VA (old VA remains mapped, will be cleaned up as zombie)\n716\t            let num_pages = region_size / self.page_size;\n717\t            for i in 0..num_pages {\n718\t                let page = region_addr + (i * self.page_size) as u64;\n719\t                let handle = self\n720\t                    .active_pages\n721\t                    .remove(&page)\n722\t                    .expect(\"BUG: active page not found during remapping\");\n723\t                unsafe {\n724\t                    vpmm_map(curr_dst, self.page_size, handle).map_err(|e| {\n725\t                        tracing::error!(\n726\t                            \"vpmm_map (remap) failed: dst={:#x}, page_size={}, handle={}: {:?}\",\n727\t                            curr_dst,\n728\t                            self.page_size,\n729\t                            handle,\n730\t                            e\n731\t                        );\n732\t                        MemoryError::from(e)\n733\t                    })?;\n734\t                }\n735\t                self.active_pages.insert(curr_dst, handle);\n736\t                curr_dst += self.page_size as u64;\n737\t            }\n738\t        }\n739\t\n740\t        debug_assert_eq!(curr_dst - dst, bytes_to_remap as u64);\n741\t\n742\t        // Set access permissions for the remapped region\n743\t        unsafe {\n744\t            vpmm_set_access(dst, bytes_to_remap, self.device_id).map_err(|e| {\n745\t                tracing::error!(\n746\t                    \"vpmm_set_access (remap) failed: addr={:#x}, size={}, device={}: {:?}\",\n747\t                    dst,\n748\t                    bytes_to_remap,\n749\t                    self.device_id,\n750\t                    e\n751\t                );\n752\t                MemoryError::from(e)\n753\t            })?;\n754\t        }\n755\t        let (remapped_ptr, _) = self.free_region_insert(dst, bytes_to_remap, stream_id);\n756\t        Ok(remapped_ptr)\n757\t    }\n758\t\n759\t    /// Returns the total physical memory currently mapped in this pool (in bytes).\n760\t    pub(super) fn memory_usage(&self) -> usize {\n761\t        self.active_pages.len() * self.page_size\n762\t    }\n763\t}\n764\t\n765\timpl Drop for VirtualMemoryPool {\n766\t    fn drop(&mut self) {\n767\t        current_stream_sync().unwrap();\n768\t\n769\t        // Unmap zombie regions first\n770\t        for zombie in self.zombie_regions.drain(..) {\n771\t            unsafe {\n772\t                vpmm_unmap(zombie.ptr, zombie.size).unwrap();\n773\t            }\n774\t        }\n775\t\n776\t        for (ptr, handle) in self.active_pages.drain() {\n777\t            unsafe {\n778\t                vpmm_unmap(ptr, self.page_size).unwrap();\n779\t                vpmm_release(handle).unwrap();\n780\t            }\n781\t        }\n782\t\n783\t        for root in self.roots.drain(..) {\n784\t            unsafe {\n785\t                vpmm_release_va(root, self.va_size).unwrap();\n786\t            }\n787\t        }\n788\t    }\n789\t}\n790\t\n791\timpl Default for VirtualMemoryPool {\n792\t    fn default() -> Self {\n793\t        Self::new(VpmmConfig::from_env())\n794\t    }\n795\t}\n796\t\n797\t#[allow(unused)]\n798\timpl std::fmt::Debug for VirtualMemoryPool {\n799\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n800\t        writeln!(\n801\t            f,\n802\t            \"VMPool (VA_SIZE={}, PAGE_SIZE={})\",\n803\t            ByteSize::b(self.va_size as u64),\n804\t            ByteSize::b(self.page_size as u64)\n805\t        )?;\n806\t\n807\t        let reserved = self.roots.len() * self.va_size;\n808\t        let allocated = self.memory_usage();\n809\t        let free_bytes: usize = self.free_regions.values().map(|r| r.size).sum();\n810\t        let malloc_bytes: usize = self.malloc_regions.values().sum();\n811\t        let unmapped_bytes: usize = self.unmapped_regions.values().sum();\n812\t        let zombies_bytes: usize = self.zombie_regions.iter().map(|r| r.size).sum();\n813\t\n814\t        writeln!(\n815\t            f,\n816\t            \"Total: reserved={}, allocated={}, free={}, malloc={}, unmapped={}, (zombies={})\",\n817\t            ByteSize::b(reserved as u64),\n818\t            ByteSize::b(allocated as u64),\n819\t            ByteSize::b(free_bytes as u64),\n820\t            ByteSize::b(malloc_bytes as u64),\n821\t            ByteSize::b(unmapped_bytes as u64),\n822\t            ByteSize::b(zombies_bytes as u64),\n823\t        )?;\n824\t\n825\t        let mut regions: Vec<(CUdeviceptr, usize, String)> = Vec::new();\n826\t        for (addr, region) in &self.free_regions {\n827\t            regions.push((*addr, region.size, format!(\"free (s {})\", region.stream_id)));\n828\t        }\n829\t        for (addr, size) in &self.malloc_regions {\n830\t            regions.push((*addr, *size, \"malloc\".to_string()));\n831\t        }\n832\t        for (addr, size) in &self.unmapped_regions {\n833\t            regions.push((*addr, *size, \"unmapped\".to_string()));\n834\t        }\n835\t        regions.sort_by_key(|(addr, _, _)| *addr);\n836\t\n837\t        write!(f, \"Regions: \")?;\n838\t        for (_, size, label) in regions.iter() {\n839\t            write!(f, \"[{} {}]\", label, ByteSize::b(*size as u64))?;\n840\t        }\n841\t        Ok(())\n842\t    }\n843\t}\n844\t"}]},"parent_tool_use_id":null,"session_id":"d17da326-31f8-4485-a87a-6ade452cd319","uuid":"81c526d1-a969-4ae6-abd6-f43531027255","timestamp":"2026-04-15T08:29:15.355Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-common/src/memory_manager/vm_pool.rs","content":"#![allow(non_camel_case_types, non_upper_case_globals, non_snake_case)]\n\nuse std::{\n    collections::{BTreeMap, HashMap},\n    ffi::c_void,\n    sync::Arc,\n};\n\nuse bytesize::ByteSize;\n\nuse super::cuda::*;\nuse crate::{\n    common::set_device,\n    error::MemoryError,\n    stream::{\n        current_stream_id, current_stream_sync, default_stream_wait, CudaEvent, CudaStreamId,\n    },\n};\n\n#[link(name = \"cudart\")]\nextern \"C\" {\n    fn cudaMemGetInfo(free_bytes: *mut usize, total_bytes: *mut usize) -> i32;\n}\n\n// ============================================================================\n// Configuration\n// ============================================================================\n\nconst DEFAULT_VA_SIZE: usize = 8 << 40; // 8 TB\n\n/// Configuration for the Virtual Memory Pool.\n///\n/// Use `VpmmConfig::from_env()` to load from environment variables,\n/// or construct directly for testing.\n#[derive(Debug, Clone)]\npub(super) struct VpmmConfig {\n    /// Page size override. If `None`, uses CUDA's minimum granularity for the device.\n    pub page_size: Option<usize>,\n    /// Virtual address space size per reserved chunk (default: 8 TB).\n    pub va_size: usize,\n    /// Number of pages to preallocate at startup (default: 0).\n    pub initial_pages: usize,\n}\n\nimpl Default for VpmmConfig {\n    fn default() -> Self {\n        Self {\n            page_size: None,\n            va_size: DEFAULT_VA_SIZE,\n            initial_pages: 0,\n        }\n    }\n}\n\nimpl VpmmConfig {\n    /// Load configuration from environment variables:\n    /// - `VPMM_PAGE_SIZE`: Page size in bytes (must be multiple of CUDA granularity)\n    /// - `VPMM_VA_SIZE`: Virtual address space size per chunk (default: 8 TB)\n    /// - `VPMM_PAGES`: Number of pages to preallocate (default: 0)\n    pub fn from_env() -> Self {\n        let page_size = std::env::var(\"VPMM_PAGE_SIZE\").ok().map(|val| {\n            let size: usize = val.parse().expect(\"VPMM_PAGE_SIZE must be a valid number\");\n            assert!(size > 0, \"VPMM_PAGE_SIZE must be > 0\");\n            size\n        });\n\n        let va_size = match std::env::var(\"VPMM_VA_SIZE\") {\n            Ok(val) => {\n                let size: usize = val.parse().expect(\"VPMM_VA_SIZE must be a valid number\");\n                assert!(size > 0, \"VPMM_VA_SIZE must be > 0\");\n                size\n            }\n            Err(_) => DEFAULT_VA_SIZE,\n        };\n\n        let initial_pages = match std::env::var(\"VPMM_PAGES\") {\n            Ok(val) => val.parse().expect(\"VPMM_PAGES must be a valid number\"),\n            Err(_) => 0,\n        };\n\n        Self {\n            page_size,\n            va_size,\n            initial_pages,\n        }\n    }\n}\n\n// ============================================================================\n// Pool Implementation\n// ============================================================================\n\n/// Metadata for a free region in the virtual address space.\n#[derive(Debug, Clone)]\nstruct FreeRegionMeta {\n    size: usize,\n    event: Arc<CudaEvent>,\n    stream_id: CudaStreamId,\n    id: usize,\n}\n\n/// Remapped region that will be unmapped when the event completes.\n#[derive(Debug)]\nstruct ZombieRegion {\n    ptr: CUdeviceptr,\n    size: usize,\n    event: Arc<CudaEvent>,\n}\n\n/// Virtual memory pool implementation.\npub(super) struct VirtualMemoryPool {\n    // Virtual address space roots\n    pub(super) roots: Vec<CUdeviceptr>,\n\n    // Map for all active pages\n    active_pages: HashMap<CUdeviceptr, CUmemGenericAllocationHandle>,\n\n    // Free regions in virtual space (sorted by address)\n    free_regions: BTreeMap<CUdeviceptr, FreeRegionMeta>,\n\n    // Active allocations: (ptr, size)\n    malloc_regions: HashMap<CUdeviceptr, usize>,\n\n    // Unmapped regions: (ptr, size)\n    unmapped_regions: BTreeMap<CUdeviceptr, usize>,\n\n    // Zombie regions: (remapped, but not unmapped yet)\n    zombie_regions: Vec<ZombieRegion>,\n\n    // Number of free calls (used to assign ids to free regions)\n    free_num: usize,\n\n    // Granularity size: (page % 2MB must be 0)\n    pub(super) page_size: usize,\n\n    // Reserved virtual address span in bytes\n    va_size: usize,\n\n    // Device ordinal\n    pub(super) device_id: i32,\n}\n\n/// # Safety\n/// `VirtualMemoryPool` is not internally synchronized. These impls are safe because\n/// all access goes through `Mutex<MemoryManager>` in the parent module.\nunsafe impl Send for VirtualMemoryPool {}\nunsafe impl Sync for VirtualMemoryPool {}\n\nimpl VirtualMemoryPool {\n    pub(super) fn new(config: VpmmConfig) -> Self {\n        let device_id = set_device().unwrap();\n\n        // Check VPMM support and resolve page_size\n        let (root, page_size, va_size) = unsafe {\n            match vpmm_check_support(device_id) {\n                Ok(_) => {\n                    let granularity = vpmm_min_granularity(device_id).unwrap();\n\n                    // Resolve page_size: use config override or device granularity\n                    let page_size = match config.page_size {\n                        Some(size) => {\n                            assert!(\n                                size > 0 && size % granularity == 0,\n                                \"VPMM_PAGE_SIZE must be > 0 and multiple of {}\",\n                                granularity\n                            );\n                            size\n                        }\n                        None => {\n                            // Use 8x the minimum granularity (typically 16 MiB) to reduce\n                            // the number of cuMemCreate calls for large allocations.\n                            // Each cuMemCreate has ~0.4ms driver overhead; with 2 MiB pages\n                            // a 256 MiB allocation requires 128 calls (~51ms). With 16 MiB\n                            // pages it requires only 16 calls (~6ms).\n                            // Allocations smaller than the page size use cudaMallocAsync.\n                            8 * granularity\n                        }\n                    };\n\n                    // Validate va_size\n                    let va_size = config.va_size;\n                    assert!(\n                        va_size > 0 && va_size.is_multiple_of(page_size),\n                        \"VPMM_VA_SIZE must be > 0 and multiple of page size ({})\",\n                        page_size\n                    );\n\n                    // Reserve initial VA chunk\n                    let va_base = vpmm_reserve(va_size, page_size).unwrap();\n                    tracing::debug!(\n                        \"VPMM: Reserved virtual address space {} with page size {}\",\n                        ByteSize::b(va_size as u64),\n                        ByteSize::b(page_size as u64)\n                    );\n                    (va_base, page_size, va_size)\n                }\n                Err(_) => {\n                    tracing::warn!(\"VPMM not supported, falling back to cudaMallocAsync\");\n                    (0, usize::MAX, 0)\n                }\n            }\n        };\n\n        let mut pool = Self {\n            roots: vec![root],\n            active_pages: HashMap::new(),\n            free_regions: BTreeMap::new(),\n            malloc_regions: HashMap::new(),\n            unmapped_regions: if va_size > 0 {\n                BTreeMap::from_iter([(root, va_size)])\n            } else {\n                BTreeMap::new()\n            },\n            zombie_regions: Vec::new(),\n            free_num: 0,\n            page_size,\n            va_size,\n            device_id,\n        };\n\n        // Preallocate pages if requested (skip if VPMM not supported)\n        if config.initial_pages > 0 && page_size != usize::MAX {\n            let alloc_size = config.initial_pages * page_size;\n            if let Err(e) =\n                pool.defragment_or_create_new_pages(alloc_size, current_stream_id().unwrap())\n            {\n                let mut free_mem = 0usize;\n                let mut total_mem = 0usize;\n                unsafe {\n                    cudaMemGetInfo(&mut free_mem, &mut total_mem);\n                }\n                panic!(\n                    \"VPMM preallocation failed: {:?}\\n\\\n                     Config: pages={}, page_size={}\\n\\\n                     GPU Memory: free={}, total={}\",\n                    e,\n                    config.initial_pages,\n                    ByteSize::b(page_size as u64),\n                    ByteSize::b(free_mem as u64),\n                    ByteSize::b(total_mem as u64)\n                );\n            }\n        }\n\n        pool\n    }\n\n    /// Allocates memory from the pool's free regions.\n    /// Attempts defragmentation if no suitable free region exists.\n    /// Returns an error if there's insufficient memory even after defragmentation.\n    pub(super) fn malloc_internal(\n        &mut self,\n        requested: usize,\n        stream_id: CudaStreamId,\n    ) -> Result<*mut c_void, MemoryError> {\n        debug_assert!(\n            requested != 0 && requested.is_multiple_of(self.page_size),\n            \"Requested size must be a multiple of the page size\"\n        );\n\n        // Phase 0: Cleanup zombie regions\n        self.cleanup_zombie_regions();\n\n        // Phase 1: Zero-cost attempts\n        let mut best_region = self.find_best_fit(requested, stream_id);\n\n        if best_region.is_none() {\n            // Phase 2: Defragmentation\n            best_region = self.defragment_or_create_new_pages(requested, stream_id)?;\n        }\n\n        if let Some(ptr) = best_region {\n            let region = self\n                .free_regions\n                .remove(&ptr)\n                .expect(\"BUG: free region address not found after find_best_fit\");\n            debug_assert_eq!(region.stream_id, stream_id);\n\n            // If region is larger, return remainder to free list\n            if region.size > requested {\n                self.free_regions.insert(\n                    ptr + requested as u64,\n                    FreeRegionMeta {\n                        size: region.size - requested,\n                        event: region.event,\n                        stream_id,\n                        id: region.id,\n                    },\n                );\n            }\n\n            self.malloc_regions.insert(ptr, requested);\n            return Ok(ptr as *mut c_void);\n        }\n\n        Err(MemoryError::OutOfMemory {\n            requested,\n            available: self.free_regions.values().map(|r| r.size).sum(),\n        })\n    }\n\n    /// Reclaims zombie regions whose events have completed.\n    ///\n    /// Zombies are old regions that have been double-mapped to new locations during defrag.\n    /// Once the associated event completes (meaning no GPU work is using the old VA),\n    /// we can safely unmap the old VA and return it to `unmapped_regions` for reuse.\n    fn cleanup_zombie_regions(&mut self) {\n        let mut i = 0;\n        while i < self.zombie_regions.len() {\n            if self.zombie_regions[i].event.completed() {\n                let zombie = self.zombie_regions.swap_remove(i);\n                if let Err(e) = unsafe { vpmm_unmap(zombie.ptr, zombie.size) } {\n                    tracing::error!(\n                        \"vpmm_unmap (zombie) failed: addr={:#x}, size={}: {:?}\",\n                        zombie.ptr,\n                        zombie.size,\n                        e\n                    );\n                }\n                self.insert_unmapped_region(zombie.ptr, zombie.size);\n            } else {\n                i += 1;\n            }\n        }\n    }\n\n    /// Phase 1: Try to find a suitable free region without defragmentation\n    /// Returns address if found, None otherwise\n    fn find_best_fit(&mut self, requested: usize, stream_id: CudaStreamId) -> Option<CUdeviceptr> {\n        let mut candidates: Vec<(CUdeviceptr, &mut FreeRegionMeta)> = self\n            .free_regions\n            .iter_mut()\n            .filter(|(_, region)| region.size >= requested)\n            .map(|(addr, region)| (*addr, region))\n            .collect();\n\n        if candidates.is_empty() {\n            return None;\n        }\n\n        // 1a. Prefer current stream (smallest fit) - could be not completed\n        if let Some((addr, _)) = candidates\n            .iter()\n            .filter(|(_, region)| region.stream_id == stream_id)\n            .min_by_key(|(_, region)| region.size)\n        {\n            return Some(*addr);\n        }\n\n        // 1b. Other streams (smallest fit) - ONLY if already completed (no sync)\n        candidates\n            .iter_mut()\n            .filter(|(_, region)| region.event.completed())\n            .min_by_key(|(_, region)| region.size)\n            .map(|(addr, region)| {\n                region.stream_id = stream_id;\n                *addr\n            })\n    }\n\n    /// Frees a pointer and returns the size of the freed memory.\n    /// Coalesces adjacent free regions.\n    ///\n    /// # Assumptions\n    /// No CUDA streams will use the malloc region starting at `ptr` after the newly recorded event\n    /// on `stream_id` at this point in time.\n    pub(super) fn free_internal(\n        &mut self,\n        ptr: *mut c_void,\n        stream_id: CudaStreamId,\n    ) -> Result<usize, MemoryError> {\n        let ptr = ptr as CUdeviceptr;\n        let size = self\n            .malloc_regions\n            .remove(&ptr)\n            .ok_or(MemoryError::InvalidPointer)?;\n\n        let _ = self.free_region_insert(ptr, size, stream_id);\n\n        Ok(size)\n    }\n\n    /// Inserts a new free region for `(ptr, size)` into the free regions map, **possibly** merging\n    /// with existing adjacent regions. Merges only occur if the regions are both adjacent in memory\n    /// and on the same stream as `stream_id`. The new free region always records a new event on the\n    /// stream.\n    ///\n    /// Returns the starting pointer and size of the (possibly merged) free region containing `(ptr,\n    /// size)`.\n    fn free_region_insert(\n        &mut self,\n        mut ptr: CUdeviceptr,\n        mut size: usize,\n        stream_id: CudaStreamId,\n    ) -> (CUdeviceptr, usize) {\n        // Potential merge with next neighbor\n        if let Some((&next_ptr, next_region)) = self.free_regions.range(ptr + 1..).next() {\n            if next_region.stream_id == stream_id && ptr + size as u64 == next_ptr {\n                let next_region = self.free_regions.remove(&next_ptr).unwrap();\n                size += next_region.size;\n            }\n        }\n        // Potential merge with previous neighbor\n        if let Some((&prev_ptr, prev_region)) = self.free_regions.range(..ptr).next_back() {\n            if prev_region.stream_id == stream_id && prev_ptr + prev_region.size as u64 == ptr {\n                let prev_region = self.free_regions.remove(&prev_ptr).unwrap();\n                ptr = prev_ptr;\n                size += prev_region.size;\n            }\n        }\n        // Record a new event to capture the current point in the stream\n        let event = Arc::new(CudaEvent::new().unwrap());\n        event.record_on_this().unwrap();\n        // Assign an id to the free region\n        let id = self.free_num;\n        self.free_num += 1;\n\n        self.free_regions.insert(\n            ptr,\n            FreeRegionMeta {\n                size,\n                event,\n                stream_id,\n                id,\n            },\n        );\n        (ptr, size)\n    }\n\n    /// Return the base address of a virtual hole large enough for `requested` bytes.\n    ///\n    /// The returned region is not inside `free_region` or `unmapped_region` map and must be\n    /// properly handled.\n    fn take_unmapped_region(&mut self, requested: usize) -> Result<CUdeviceptr, MemoryError> {\n        debug_assert!(requested != 0);\n        debug_assert_eq!(requested % self.page_size, 0);\n\n        if let Some((&addr, &size)) = self\n            .unmapped_regions\n            .iter()\n            .filter(|(_, region_size)| **region_size >= requested)\n            .min_by_key(|(_, region_size)| *region_size)\n        {\n            self.unmapped_regions.remove(&addr);\n            if size > requested {\n                self.unmapped_regions\n                    .insert(addr + requested as u64, size - requested);\n            }\n            return Ok(addr);\n        }\n\n        let addr = unsafe {\n            vpmm_reserve(self.va_size, self.page_size).map_err(|_| MemoryError::ReserveFailed {\n                size: self.va_size,\n                page_size: self.page_size,\n            })?\n        };\n        self.roots.push(addr);\n        self.insert_unmapped_region(addr + requested as u64, self.va_size - requested);\n        Ok(addr)\n    }\n\n    /// Insert a hole back into the unmapped set, coalescing with neighbors.\n    fn insert_unmapped_region(&mut self, mut addr: CUdeviceptr, mut size: usize) {\n        if size == 0 {\n            return;\n        }\n\n        if let Some((&prev_addr, &prev_size)) = self.unmapped_regions.range(..addr).next_back() {\n            if prev_addr + prev_size as u64 == addr {\n                self.unmapped_regions.remove(&prev_addr);\n                addr = prev_addr;\n                size += prev_size;\n            }\n        }\n\n        if let Some((&next_addr, &next_size)) = self.unmapped_regions.range(addr + 1..).next() {\n            if addr + size as u64 == next_addr {\n                self.unmapped_regions.remove(&next_addr);\n                size += next_size;\n            }\n        }\n\n        self.unmapped_regions.insert(addr, size);\n    }\n\n    /// Roll back partially allocated pages when allocation fails.\n    /// Unmaps and releases any mapped pages and restores the reserved VA span.\n    fn rollback_new_pages(\n        &mut self,\n        reserved_ptr: CUdeviceptr,\n        reserved_size: usize,\n        allocated_pages: &[(CUdeviceptr, CUmemGenericAllocationHandle)],\n    ) {\n        for (addr, handle) in allocated_pages {\n            if let Err(e) = unsafe { vpmm_unmap(*addr, self.page_size) } {\n                tracing::error!(\n                    \"rollback: vpmm_unmap failed: addr={:#x}, size={}: {:?}\",\n                    addr,\n                    self.page_size,\n                    e\n                );\n            }\n            self.active_pages.remove(addr);\n            if let Err(e) = unsafe { vpmm_release(*handle) } {\n                tracing::error!(\"rollback: vpmm_release failed: handle={}: {:?}\", handle, e);\n            }\n        }\n        self.insert_unmapped_region(reserved_ptr, reserved_size);\n    }\n\n    /// Defragments the pool by reusing existing holes and, if needed, reserving more VA space.\n    /// Moves just enough pages to satisfy `requested`, keeping the remainder in place.\n    ///\n    /// The returned `pointer`, if not `None`, is guaranteed to exist as a key in the `free_regions`\n    /// map. The corresponding free region will have size `>= requested`. Note the size _may_ be\n    /// larger than requested.\n    fn defragment_or_create_new_pages(\n        &mut self,\n        requested: usize,\n        stream_id: CudaStreamId,\n    ) -> Result<Option<CUdeviceptr>, MemoryError> {\n        debug_assert_eq!(requested % self.page_size, 0);\n        if requested == 0 {\n            return Ok(None);\n        }\n\n        let total_free_size = self.free_regions.values().map(|r| r.size).sum::<usize>();\n        tracing::debug!(\n            \"VPMM: Defragging or creating new pages: requested={}, free={} stream_id={}\",\n            ByteSize::b(requested as u64),\n            ByteSize::b(total_free_size as u64),\n            stream_id\n        );\n\n        // Find a best fit unmapped region\n        let dst = self.take_unmapped_region(requested)?;\n        // Sentinel value until we have a valid free region pointer from allocation\n        let mut allocated_ptr = CUdeviceptr::MAX;\n\n        // Allocate new pages if we don't have enough free regions\n        let mut allocated_dst = dst;\n        let mut allocate_size = requested.saturating_sub(total_free_size);\n        debug_assert_eq!(allocate_size % self.page_size, 0);\n        let mut allocated_pages: Vec<(CUdeviceptr, CUmemGenericAllocationHandle)> = Vec::new();\n        while allocated_dst < dst + allocate_size as u64 {\n            let handle = unsafe {\n                match vpmm_create_physical(self.device_id, self.page_size) {\n                    Ok(handle) => handle,\n                    Err(e) => {\n                        tracing::error!(\n                            \"vpmm_create_physical failed: device={}, page_size={}: {:?}\",\n                            self.device_id,\n                            self.page_size,\n                            e\n                        );\n                        if e.is_out_of_memory() {\n                            self.rollback_new_pages(dst, requested, &allocated_pages);\n                            return Err(MemoryError::OutOfMemory {\n                                requested: allocate_size,\n                                available: (allocated_dst - dst) as usize,\n                            });\n                        } else {\n                            return Err(MemoryError::from(e));\n                        }\n                    }\n                }\n            };\n            unsafe {\n                vpmm_map(allocated_dst, self.page_size, handle).map_err(|e| {\n                    tracing::error!(\n                        \"vpmm_map failed: addr={:#x}, page_size={}, handle={}: {:?}\",\n                        allocated_dst,\n                        self.page_size,\n                        handle,\n                        e\n                    );\n                    MemoryError::from(e)\n                })?;\n            }\n            self.active_pages.insert(allocated_dst, handle);\n            allocated_pages.push((allocated_dst, handle));\n            allocated_dst += self.page_size as u64;\n        }\n        debug_assert_eq!(allocated_dst, dst + allocate_size as u64);\n        if allocate_size > 0 {\n            tracing::debug!(\n                \"VPMM: Allocated {} bytes on stream {}. Total allocated: {}\",\n                ByteSize::b(allocate_size as u64),\n                stream_id,\n                ByteSize::b(self.memory_usage() as u64)\n            );\n            unsafe {\n                vpmm_set_access(dst, allocate_size, self.device_id).map_err(|e| {\n                    tracing::error!(\n                        \"vpmm_set_access failed: addr={:#x}, size={}, device={}: {:?}\",\n                        dst,\n                        allocate_size,\n                        self.device_id,\n                        e\n                    );\n                    MemoryError::from(e)\n                })?;\n            }\n            let (merged_ptr, merged_size) = self.free_region_insert(dst, allocate_size, stream_id);\n            debug_assert!(merged_size >= allocate_size);\n            allocated_ptr = merged_ptr;\n            allocate_size = merged_size;\n        }\n        // At this point, allocated_ptr is either\n        // - CUdeviceptr::MAX if no allocations occurred\n        // - or some pointer `<= dst` for the start of a free region (with VA-mapping) of at least\n        //   `requested` bytes. The case `allocated_ptr < dst` happens if `free_region_insert`\n        //   merged the allocated region with a previous free region. This only happens if the\n        //   previous free region is on the same `stream_id`. In this case, we have\n        //   [allocated_ptr..dst][dst..allocated_dst] which is all free and safe to use on the\n        //   stream `stream_id` _without_ synchronization, because all events will be sequenced\n        //   afterwards on the stream.\n        let mut remaining = requested.saturating_sub(allocate_size);\n        if remaining == 0 {\n            debug_assert_ne!(\n                allocated_ptr,\n                CUdeviceptr::MAX,\n                \"Allocation returned no valid free region\"\n            );\n            return Ok(Some(allocated_ptr));\n        }\n        debug_assert!(allocate_size == 0 || allocated_ptr <= dst);\n\n        // Pull free regions (current stream first, the other stream oldest first) until we've\n        // gathered enough pages.\n        let mut to_defrag: Vec<(CUdeviceptr, usize)> = Vec::new();\n        let mut ordered_free_regions: Vec<_> = self\n            .free_regions\n            .iter()\n            .filter(|(&addr, _)| allocate_size == 0 || addr != allocated_ptr)\n            .map(|(&addr, region)| (region.stream_id != stream_id, region.id, addr))\n            .collect();\n        ordered_free_regions.sort_by_key(|(is_other, id, _)| (*is_other, *id));\n        for (other_stream, _, addr) in ordered_free_regions {\n            if remaining == 0 {\n                break;\n            }\n\n            let region = self\n                .free_regions\n                .remove(&addr)\n                .expect(\"BUG: free region disappeared\");\n\n            if other_stream && !region.event.completed() {\n                // default_stream_wait always uses current stream (= stream_id)\n                default_stream_wait(&region.event)?;\n            }\n\n            let take = remaining.min(region.size);\n\n            self.zombie_regions.push(ZombieRegion {\n                ptr: addr,\n                size: take,\n                event: region.event.clone(),\n            });\n\n            to_defrag.push((addr, take));\n            remaining -= take;\n\n            if region.size > take {\n                // Return the unused tail to the free list so it stays available.\n                let leftover_addr = addr + take as u64;\n                let leftover_size = region.size - take;\n                let _ = self.free_region_insert(leftover_addr, leftover_size, region.stream_id);\n            }\n        }\n        let remapped_ptr = self.remap_regions(to_defrag, allocated_dst, stream_id)?;\n        // Take the minimum in case allocated_ptr is CUdeviceptr::MAX when allocate_size = 0\n        let result = std::cmp::min(allocated_ptr, remapped_ptr);\n        debug_assert!(allocate_size == 0 || allocated_ptr == remapped_ptr);\n        debug_assert_ne!(\n            result,\n            CUdeviceptr::MAX,\n            \"Both allocation and remapping returned no valid free region\"\n        );\n        Ok(Some(result))\n    }\n\n    /// Remap a list of regions to a new base address via