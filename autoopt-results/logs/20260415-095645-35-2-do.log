es only 16 calls (~6ms).\n189\t                            // Allocations smaller than the page size use cudaMallocAsync.\n190\t                            8 * granularity\n191\t                        }\n192\t                    };\n193\t\n194\t                    // Validate va_size\n195\t                    let va_size = config.va_size;\n196\t                    assert!(\n197\t                        va_size > 0 && va_size.is_multiple_of(page_size),\n198\t                        \"VPMM_VA_SIZE must be > 0 and multiple of page size ({})\",\n199\t                        page_size\n200\t                    );\n201\t\n202\t                    // Reserve initial VA chunk\n203\t                    let va_base = vpmm_reserve(va_size, page_size).unwrap();\n204\t                    tracing::debug!(\n205\t                        \"VPMM: Reserved virtual address space {} with page size {}\",\n206\t                        ByteSize::b(va_size as u64),\n207\t                        ByteSize::b(page_size as u64)\n208\t                    );\n209\t                    (va_base, page_size, va_size)\n210\t                }\n211\t                Err(_) => {\n212\t                    tracing::warn!(\"VPMM not supported, falling back to cudaMallocAsync\");\n213\t                    (0, usize::MAX, 0)\n214\t                }\n215\t            }\n216\t        };\n217\t\n218\t        let mut pool = Self {\n219\t            roots: vec![root],\n220\t            active_pages: HashMap::new(),\n221\t            free_regions: BTreeMap::new(),\n222\t            malloc_regions: HashMap::new(),\n223\t            unmapped_regions: if va_size > 0 {\n224\t                BTreeMap::from_iter([(root, va_size)])\n225\t            } else {\n226\t                BTreeMap::new()\n227\t            },\n228\t            zombie_regions: Vec::new(),\n229\t            free_num: 0,\n230\t            page_size,\n231\t            va_size,"}]},"parent_tool_use_id":null,"session_id":"d17da326-31f8-4485-a87a-6ade452c