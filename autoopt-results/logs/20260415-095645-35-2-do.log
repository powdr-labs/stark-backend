{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LxUQagjd7icyYMZNQGhGZq","type":"tool_result","content":"1\t//! Tests for memory_manager - focused on edge cases and dangerous scenarios\n2\t\n3\tuse super::vm_pool::{VirtualMemoryPool, VpmmConfig};\n4\tuse crate::{\n5\t    d_buffer::DeviceBuffer,\n6\t    stream::{current_stream_id, current_stream_sync},\n7\t};\n8\t\n9\t#[link(name = \"cudart\")]\n10\textern \"C\" {\n11\t    fn cudaMemGetInfo(free_bytes: *mut usize, total_bytes: *mut usize) -> i32;\n12\t}\n13\t\n14\tfn get_gpu_free_memory() -> usize {\n15\t    let mut free = 0usize;\n16\t    let mut total = 0usize;\n17\t    let err = unsafe { cudaMemGetInfo(&mut free, &mut total) };\n18\t    assert_eq!(err, 0, \"cudaMemGetInfo failed: {}\", err);\n19\t    free\n20\t}\n21\t\n22\t// ============================================================================\n23\t// Coalescing: free B first, then A, then C - should coalesce into one region\n24\t// ============================================================================\n25\t#[test]\n26\tfn test_coalescing_via_combined_alloc() {\n27\t    let len = 2 << 30; // 2 GB per allocation\n28\t    let buf_a = DeviceBuffer::<u8>::with_capacity(len);\n29\t    let buf_b = DeviceBuffer::<u8>::with_capacity(len);\n30\t    let buf_c = DeviceBuffer::<u8>::with_capacity(len);\n31\t\n32\t    let addr_a = buf_a.as_raw_ptr();\n33\t\n34\t    // Free in order: B, A, C - this tests both next and prev neighbor coalescing\n35\t    drop(buf_b);\n36\t    drop(buf_a);\n37\t    drop(buf_c);\n38\t\n39\t    // Request combined size - if coalescing worked, this should reuse from A's start\n40\t    let combined_len = 3 * len;\n41\t    let buf_combined = DeviceBuffer::<u8>::with_capacity(combined_len);\n42\t    assert_eq!(\n43\t        addr_a,\n44\t        buf_combined.as_raw_ptr(),\n45\t        \"Should reuse coalesced region starting at A\"\n46\t    );\n47\t}\n48\t\n49\t// ============================================================================\n50\t// VA exhaustion: use tiny VA size to force multiple VA reservations\n51\t// ============================================================================\n52\t#[test]\n53\tfn test_va_exhaustion_reserves_more() {\n54\t    // Create pool with very small VA (4 MB) - will exhaust quickly\n55\t    let config = VpmmConfig {\n56\t        page_size: None,\n57\t        va_size: 4 << 20, // 4 MB VA per chunk\n58\t        initial_pages: 0,\n59\t    };\n60\t    let mut pool = VirtualMemoryPool::new(config);\n61\t\n62\t    if pool.page_size == usize::MAX {\n63\t        println!(\"VPMM not supported, skipping test\");\n64\t        return;\n65\t    }\n66\t\n67\t    let page_size = pool.page_size;\n68\t    let stream_id = current_stream_id().unwrap();\n69\t\n70\t    // Initial state: 1 VA root\n71\t    assert_eq!(pool.roots.len(), 1);\n72\t\n73\t    // Allocate enough pages to exhaust first VA chunk and trigger second reservation\n74\t    // 4MB VA / 2MB page = 2 pages max in first chunk\n75\t    let mut ptrs = Vec::new();\n76\t    for _ in 0..4 {\n77\t        // Allocate 4 pages total → needs 2 VA chunks\n78\t        match pool.malloc_internal(page_size, stream_id) {\n79\t            Ok(ptr) => ptrs.push(ptr),\n80\t            Err(e) => panic!(\"Allocation failed: {:?}\", e),\n81\t        }\n82\t    }\n83\t\n84\t    assert!(\n85\t        pool.roots.len() >= 2,\n86\t        \"Should have reserved additional VA chunks. Got {} roots\",\n87\t        pool.roots.len()\n88\t    );\n89\t\n90\t    // Cleanup\n91\t    for ptr in ptrs {\n92\t        pool.free_internal(ptr, stream_id).unwrap();\n93\t    }\n94\t}\n95\t\n96\t// ============================================================================\n97\t// Defragmentation scenario from vpmm_spec.md:\n98\t//   +10  >  +1  >  -10  >  +4  >  +11 (in units of PAGE_SIZE)\n99\t//\n100\t// X = PAGES - 11 determines behavior:"}]},"parent_tool_use_id":null,"session_id":"d17da326-31f8-4485-a87a-6ade452cd319","uuid":"2af45496-f2ab-4a4c-a808-fd68950c8586","timestamp":"2026-04-15T08:29:20.758Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-common/src/memory_manager/tests.rs","content":"//! Tests for memory_manager - focused on edge cases and dangerous scenarios\n\nuse super::vm_pool::{VirtualMemoryPool, VpmmConfig};\nuse crate::{\n    d_buffer::DeviceBuffer,\n    stream::{current_stream_id, current_stream_sync},\n};\n\n#[link(name = \"cudart\")]\nextern \"C\" {\n    fn cudaMemGetInfo(free_bytes: *mut usize, total_bytes: *mut usize) -> i32;\n}\n\nfn get_gpu_free_memory() -> usize {\n    let mut free = 0usize;\n    let mut total = 0usize;\n    let err = unsafe { cudaMemGetInfo(&mut free, &mut total) };\n    assert_eq!(err, 0, \"cudaMemGetInfo failed: {}\", err);\n    free\n}\n\n// ============================================================================\n// Coalescing: free B first, then A, then C - should coalesce into one region\n// ============================================================================\n#[test]\nfn test_coalescing_via_combined_alloc() {\n    let len = 2 << 30; // 2 GB per allocation\n    let buf_a = DeviceBuffer::<u8>::with_capacity(len);\n    let buf_b = DeviceBuffer::<u8>::with_capacity(len);\n    let buf_c = DeviceBuffer::<u8>::with_capacity(len);\n\n    let addr_a = buf_a.as_raw_ptr();\n\n    // Free in order: B, A, C - this tests both next and prev neighbor coalescing\n    drop(buf_b);\n    drop(buf_a);\n    drop(buf_c);\n\n    // Request combined size - if coalescing worked, this should reuse from A's start\n    let combined_len = 3 * len;\n    let buf_combined = DeviceBuffer::<u8>::with_capacity(combined_len);\n    assert_eq!(\n        addr_a,\n        buf_combined.as_raw_ptr(),\n        \"Should reuse coalesced region starting at A\"\n    );\n}\n\n// ============================================================================\n// VA exhaustion: use tiny VA size to force multiple VA reservations\n// ============================================================================\n#[test]\nfn test_va_exhaustion_reserves_more() {\n    // Create pool with very small VA (4 MB) - will exhaust quickly\n    let config = VpmmConfig {\n        page_size: None,\n        va_size: 4 << 20, // 4 MB VA per chunk\n        initial_pages: 0,\n    };\n    let mut pool = VirtualMemoryPool::new(config);\n\n    if pool.page_size == usize::MAX {\n        println!(\"VPMM not supported, skipping test\");\n        return;\n    }\n\n    let page_size = pool.page_size;\n    let stream_id = current_stream_id().unwrap();\n\n    // Initial state: 1 VA root\n    assert_eq!(pool.roots.len(), 1);\n\n    // Allocate enough pages to exhaust first VA chunk and trigger second reservation\n    // 4MB VA / 2MB page = 2 pages max in first chunk\n    let mut ptrs = Vec::new();\n    for _ in 0..4 {\n        // Allocate 4 pages total → needs 2 VA chunks\n        match pool.malloc_internal(page_size, stream_id) {\n            Ok(ptr) => ptrs.push(ptr),\n            Err(e) => panic!(\"Allocation failed: {:?}\", e),\n        }\n    }\n\n    assert!(\n        pool.roots.len() >= 2,\n        \"Should have reserved additional VA chunks. Got {} roots\",\n        pool.roots.len()\n    );\n\n    // Cleanup\n    for ptr in ptrs {\n        pool.free_internal(ptr, stream_id).unwrap();\n    }\n}\n\n// ============================================================================\n// Defragmentation scenario from vpmm_spec.md:\n//   +10  >  +1  >  -10  >  +4  >  +11 (in units of PAGE_SIZE)\n//\n// X = PAGES - 11 determines behavior:","numLines":100,"startLine":1,"totalLines":702}}}
