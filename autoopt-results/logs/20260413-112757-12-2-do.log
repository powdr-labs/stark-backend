ads_per_block,\n        )?;\n    }\n    Ok(output)\n}\n","structuredPatch":[{"oldStart":470,"oldLines":7,"newStart":470,"newLines":7,"lines":["                 t.eq_xi_ptr,","                 t.sels_ptr,","                 t.prep_ptr,","-                &t.main_ptrs_dev,","+                t.main_ptrs_ptr,","                 t.public_ptr,","                 lambda_pows,","                 rules,"]}],"userModified":false,"replaceAll":false}}
