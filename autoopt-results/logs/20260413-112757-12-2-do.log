{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01886WZd1MH9UyhbBzdtAmUp","type":"tool_result","content":"1100\t        self.mem\n1101\t            .emit_metrics_with_label(\"prover.batch_constraints.fold_ple_evals\");\n1102\t        Ok(())\n1103\t    }\n1104\t\n1105\t    #[instrument(\n1106\t        name = \"LogupZerocheck::sumcheck_polys_batch_eval\",\n1107\t        level = \"info\",\n1108\t        skip_all,\n1109\t        fields(round = round)\n1110\t    )]\n1111\t    fn sumcheck_polys_batch_eval(\n1112\t        &mut self,\n1113\t        round: usize,\n1114\t        r_prev: EF,\n1115\t    ) -> Result<Vec<Vec<EF>>, LogupZerocheckError> {\n1116\t        let sp_deg = self.constraint_degree;\n1117\t\n1118\t        // Per-trace outputs (filled as we go)\n1119\t        let mut zc_out: Vec<Vec<EF>> = vec![vec![EF::ZERO; sp_deg]; self.n_per_trace.len()];\n1120\t        let mut logup_out: Vec<[Vec<EF>; 2]> =\n1121\t            vec![[vec![EF::ZERO; sp_deg], vec![EF::ZERO; sp_deg]]; self.n_per_trace.len()];\n1122\t\n1123\t        let mut late_eval: Vec<TraceCtx> = Vec::new(); // round == n_lift + 1\n1124\t        let mut early_eval: Vec<TraceCtx> = Vec::new(); // round <= n_lift\n1125\t\n1126\t        // ── Phase 1: Collect metadata, split into Case A / Case B (no CUDA calls) ──\n1127\t        // For Case B traces, we collect column pointers and sizing info to batch the\n1128\t        // interpolation into a single kernel launch.\n1129\t        struct CaseBMeta {\n1130\t            trace_idx: usize,\n1131\t            air_idx: usize,\n1132\t            n_lift: usize,\n1133\t            num_y: usize,\n1134\t            num_columns: usize, // total columns (selectors + preprocessed + mains)\n1135\t            interp_offset: usize, // element offset within the big interpolated buffer\n1136\t            col_start: usize,   // start index in the flat all_columns array\n1137\t            has_preprocessed: bool,\n1138\t            need_rot: bool,\n1139\t            has_constraints: bool,\n1140\t            has_interactions: bool,\n1141\t            norm_factor: F,\n1142\t        }\n1143\t        let mut case_b_traces: Vec<CaseBMeta> = Vec::new();\n1144\t        let mut all_columns: Vec<*const EF> = Vec::new();\n1145\t        let mut total_interp_elems: usize = 0;\n1146\t\n1147\t        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n1148\t            self.n_per_trace.iter(),\n1149\t            self.mat_evals_per_trace.iter(),\n1150\t            self.sels_per_trace.iter(),\n1151\t            self.d_eq_3b_per_trace.iter(),\n1152\t            self.public_values_per_trace.iter(),\n1153\t            self.air_indices_per_trace.iter()\n1154\t        )\n1155\t        .enumerate()\n1156\t        {\n1157\t            let pk = &self.pk.per_air[air_idx];\n1158\t            let dag = &pk.vk.symbolic_constraints;\n1159\t            let has_constraints = dag.constraints.num_constraints() > 0;\n1160\t            let has_interactions = !dag.interactions.is_empty();\n1161\t            if !has_constraints && !has_interactions {\n1162\t                continue;\n1163\t            }\n1164\t\n1165\t            let n_lift = n.max(0) as usize;\n1166\t            let norm_factor_denom = 1 << (-n).max(0);\n1167\t            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n1168\t            let has_preprocessed = pk.preprocessed_data.is_some();\n1169\t            let need_rot = pk.vk.params.need_rot;\n1170\t            let first_main_idx = usize::from(has_preprocessed);\n1171\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n1172\t\n1173\t            if round > n_lift {\n1174\t                // Case A\n1175\t                if round == n_lift + 1 {\n1176\t                    // A.1: evaluate directly at (num_x=1, num_y=1)\n1177\t                    let prep_ptr = if has_preprocessed {\n1178\t                        MainMatrixPtrs {\n1179\t                            data: mats[0].buffer().as_ptr(),\n1180\t                            air_width: air_width_for_mat(need_rot, mats[0].width()),\n1181\t                        }\n1182\t                    } else {\n1183\t                        MainMatrixPtrs {\n1184\t                            data: std::ptr::null(),\n1185\t                            air_width: 0,\n1186\t                        }\n1187\t                    };\n1188\t                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1189\t                        .iter()\n1190\t                        .map(|m| MainMatrixPtrs {\n1191\t                            data: m.buffer().as_ptr(),\n1192\t                            air_width: air_width_for_mat(need_rot, m.width()),\n1193\t                        })\n1194\t                        .collect_vec();\n1195\t                    let main_ptrs_dev = main_ptrs.to_device()?;\n1196\t\n1197\t                    late_eval.push(TraceCtx {\n1198\t                        trace_idx,\n1199\t                        air_idx,\n1200\t                        n_lift,\n1201\t                        num_y: 1,\n1202\t                        has_constraints,\n1203\t                        has_interactions,\n1204\t                        norm_factor,\n1205\t                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n1206\t                        sels_ptr: sels.buffer().as_ptr(),\n1207\t                        prep_ptr,\n1208\t                        main_ptrs_dev,\n1209\t                        public_ptr: public_vals.as_ptr(),\n1210\t                        eq_3bs_ptr: eq_3bs.as_ptr(),\n1211\t                    });\n1212\t                } else {\n1213\t                    // A.2: scale tilde evals only\n1214\t                    if has_constraints {\n1215\t                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n1216\t                        *tilde_eval *= r_prev;\n1217\t                    }\n1218\t                    if has_interactions {\n1219\t                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n1220\t                            *x *= r_prev;\n1221\t                        }\n1222\t                    }\n1223\t                }\n1224\t            } else {\n1225\t                // Case B: collect metadata for batched interpolation\n1226\t                let log_num_y = n_lift - round;\n1227\t                let num_y = 1 << log_num_y;\n1228\t                let height = 2 * num_y;\n1229\t                debug_assert_eq!(height, mats[0].height());\n1230\t\n1231\t                let col_start = all_columns.len();\n1232\t                // Collect all column pointers: selectors + all matrices (preprocessed + mains)\n1233\t                all_columns.extend(\n1234\t                    iter::once(sels)\n1235\t                        .chain(mats.iter())\n1236\t                        .flat_map(|m| {\n1237\t                            assert_eq!(m.height(), height);\n1238\t                            (0..m.width())\n1239\t                                .map(|col| m.buffer().as_ptr().wrapping_add(col * m.height()))\n1240\t                        }),\n1241\t                );\n1242\t                let num_columns = all_columns.len() - col_start;\n1243\t                let interp_size = sp_deg * num_y * num_columns;\n1244\t\n1245\t                case_b_traces.push(CaseBMeta {\n1246\t                    trace_idx,\n1247\t                    air_idx,\n1248\t                    n_lift,\n1249\t                    num_y,\n1250\t                    num_columns,\n1251\t                    interp_offset: total_interp_elems,\n1252\t                    col_start,\n1253\t                    has_preprocessed,\n1254\t                    need_rot,\n1255\t                    has_constraints,\n1256\t                    has_interactions,\n1257\t                    norm_factor,\n1258\t                });\n1259\t                total_interp_elems += interp_size;\n1260\t            }\n1261\t        }\n1262\t\n1263\t        // ── Phase 2: Batch allocate + single kernel launch ──\n1264\t        // One big buffer for all interpolated data, one kernel launch for all Case B traces.\n1265\t        let _keepalive_interpolated = if !case_b_traces.is_empty() {\n1266\t            let big_buf = DeviceBuffer::<EF>::with_capacity(total_interp_elems);\n1267\t            let big_ptr = big_buf.as_mut_ptr();\n1268\t\n1269\t            // Build descriptors with multi-block-per-trace assignment\n1270\t            const THREADS_PER_BLOCK: u32 = 512;\n1271\t            let mut block_offset: u32 = 0;\n1272\t            let descs: Vec<InterpColDesc> = case_b_traces\n1273\t                .iter()\n1274\t                .map(|meta| {\n1275\t                    let total_threads = (meta.num_y * meta.num_columns) as u32;\n1276\t                    let blocks = total_threads.div_ceil(THREADS_PER_BLOCK);\n1277\t                    let desc = InterpColDesc {\n1278\t                        output: unsafe { big_ptr.add(meta.interp_offset) },\n1279\t                        columns_offset: meta.col_start as u32,\n1280\t                        num_y: meta.num_y as u32,\n1281\t                        num_columns: meta.num_columns as u32,\n1282\t                        total_threads,\n1283\t                        block_start: block_offset,\n1284\t                    };\n1285\t                    block_offset += blocks;\n1286\t                    desc\n1287\t                })\n1288\t                .collect();\n1289\t            let total_blocks = block_offset as usize;\n1290\t\n1291\t            let d_descs = descs.to_device()?;\n1292\t            let d_all_columns = all_columns.to_device()?;\n1293\t            unsafe {\n1294\t                batched_interpolate_columns_gpu(&d_descs, &d_all_columns, sp_deg, total_blocks)\n1295\t                    .map_err(|e| LogupZerocheckError::InterpolateColumns(e.into()))?;\n1296\t            }\n1297\t\n1298\t            Some(big_buf)\n1299\t        } else {\n1300\t            None\n1301\t        };\n1302\t\n1303\t        // ── Phase 3: Build TraceCtx for each Case B trace ──\n1304\t        for meta in &case_b_traces {\n1305\t            let mats = &self.mat_evals_per_trace[meta.trace_idx];\n1306\t            let first_main_idx = usize::from(meta.has_preprocessed);\n1307\t            let eq_xi_tree = &self.eq_xis[&meta.n_lift];\n1308\t            let log_num_y = meta.n_lift - round;\n1309\t            let interpolated_height = sp_deg * meta.num_y;\n1310\t\n1311\t            let base_ptr = _keepalive_interpolated\n1312\t                .as_ref()\n1313\t                .unwrap()\n1314\t                .as_ptr()\n1315\t                .wrapping_add(meta.interp_offset);\n1316\t\n1317\t            let mut widths_so_far = 0usize;\n1318\t            let sels_ptr = base_ptr.wrapping_add(widths_so_far * interpolated_height);\n1319\t            widths_so_far += 3; // selector width is always 3\n1320\t\n1321\t            let prep_ptr = if meta.has_preprocessed {\n1322\t                MainMatrixPtrs {\n1323\t                    data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1324\t                    air_width: air_width_for_mat(meta.need_rot, mats[0].width()),\n1325\t                }\n1326\t            } else {\n1327\t                MainMatrixPtrs {\n1328\t                    data: std::ptr::null(),\n1329\t                    air_width: 0,\n1330\t                }\n1331\t            };\n1332\t            if meta.has_preprocessed {\n1333\t                widths_so_far += mats[0].width();\n1334\t            }\n1335\t            let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1336\t                .iter()\n1337\t                .map(|m| {\n1338\t                    let main_ptr = MainMatrixPtrs {\n1339\t                        data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1340\t                        air_width: air_width_for_mat(meta.need_rot, m.width()),\n1341\t                    };\n1342\t                    widths_so_far += m.width();\n1343\t                    main_ptr\n1344\t                })\n1345\t                .collect_vec();\n1346\t            debug_assert_eq!(widths_so_far, meta.num_columns);\n1347\t            let main_ptrs_dev = main_ptrs.to_device()?;\n1348\t\n1349\t            early_eval.push(TraceCtx {\n1350\t                trace_idx: meta.trace_idx,\n1351\t                air_idx: meta.air_idx,\n1352\t                n_lift: meta.n_lift,\n1353\t                num_y: meta.num_y as u32,\n1354\t                has_constraints: meta.has_constraints,\n1355\t                has_interactions: meta.has_interactions,\n1356\t                norm_factor: meta.norm_factor,\n1357\t                eq_xi_ptr: eq_xi_tree.get_ptr(log_num_y),\n1358\t                sels_ptr,\n1359\t                prep_ptr,\n1360\t                main_ptrs_dev,\n1361\t                public_ptr: self.public_values_per_trace[meta.trace_idx].as_ptr(),\n1362\t                eq_3bs_ptr: self.d_eq_3b_per_trace[meta.trace_idx].as_ptr(),\n1363\t            });\n1364\t        }\n1365\t\n1366\t        let d_challenges_ptr = self.d_challenges.as_ptr();\n1367\t\n1368\t        // Late traces (num_y=1): always use monomial\n1369\t        let late_logup_traces: Vec<_> = late_eval.iter().filter(|t| t.has_interactions).collect();\n1370\t        if !late_logup_traces.is_empty() {\n1371\t            let logup_combs: Vec<_> = late_logup_traces\n1372\t                .iter()\n1373\t                .map(|t| {\n1374\t                    self.logup_combinations[t.trace_idx]\n1375\t                        .as_ref()\n1376\t                        .expect(\"missing logup monomial combinations for late trace\")\n1377\t                })\n1378\t                .collect();\n1379\t            let batch =\n1380\t                LogupMonomialBatch::new(late_logup_traces.iter().copied(), self.pk, &logup_combs)?;\n1381\t            let out = batch\n1382\t                .evaluate(1)\n1383\t                .map_err(LogupZerocheckError::MleInteractionEval)?;\n1384\t            let host = out.to_host()?;\n1385\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1386\t                self.logup_tilde_evals[trace_idx][0] = host[i].p * late_logup_traces[i].norm_factor;\n1387\t                self.logup_tilde_evals[trace_idx][1] = host[i].q;\n1388\t            }\n1389\t        }\n1390\t        let late_mono_traces: Vec<_> = late_eval\n1391\t            .iter()\n1392\t            .filter(|t| trace_has_monomials(t, self.pk))\n1393\t            .collect();\n1394\t        if !late_mono_traces.is_empty() {\n1395\t            let lambda_combs: Vec<_> = late_mono_traces\n1396\t                .iter()\n1397\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1398\t                .collect();\n1399\t            let batch = ZerocheckMonomialBatch::new(late_mono_traces, self.pk, &lambda_combs)?;\n1400\t            let out = batch\n1401\t                .evaluate(1)\n1402\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1403\t            let host = out.to_host()?;\n1404\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1405\t                self.zerocheck_tilde_evals[trace_idx] = host[i];\n1406\t                // zc_out not set for num_x=1, handled from tilde_eval in compute_batch_s\n1407\t            }\n1408\t        }\n1409\t\n1410\t        // Logup for early traces: partition by num_y threshold\n1411\t        if !early_eval.is_empty() {\n1412\t            evaluate_logup_batched(\n1413\t                &early_eval,\n1414\t                self.pk,\n1415\t                d_challenges_ptr,\n1416\t                sp_deg as u32,\n1417\t                self.monomial_num_y_threshold,\n1418\t                &self.logup_combinations,\n1419\t                &mut logup_out,\n1420\t                &mut self.logup_tilde_evals,\n1421\t                self.memory_limit_bytes,\n1422\t            )\n1423\t            .map_err(LogupZerocheckError::MleInteractionEval)?;\n1424\t        }\n1425\t\n1426\t        // Early traces (num_y>1): partition by threshold for zerocheck path\n1427\t        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n1428\t            .iter()\n1429\t            .filter(|t| t.has_constraints)\n1430\t            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n1431\t\n1432\t        // Partition high num_y traces by monomial-to-rules ratio\n1433\t        // (traces without monomials are skipped - they contribute zero)\n1434\t        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n1435\t            high_early.iter().partition(|t| {\n1436\t                let num_monomials = get_num_monomials(t, self.pk);\n1437\t                let rules_len = get_zerocheck_rules_len(t, self.pk);\n1438\t                // Use DAG when monomial expansion significantly increased the term count\n1439\t                num_monomials as usize >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len\n1440\t            });\n1441\t\n1442\t        // DAG evaluation for high num_y traces with high monomial-to-rules ratio\n1443\t        if !high_dag_traces.is_empty() {\n1444\t            let lambda_pows = self.lambda_pows.as_ref().unwrap();\n1445\t            evaluate_zerocheck_batched(\n1446\t                high_dag_traces,\n1447\t                self.pk,\n1448\t                lambda_pows,\n1449\t                sp_deg as u32,\n1450\t                &mut zc_out,\n1451\t                self.memory_limit_bytes,\n1452\t            )\n1453\t            .map_err(LogupZerocheckError::MleConstraintEval)?;\n1454\t        }\n1455\t\n1456\t        // Par-Y monomial kernel for high num_y traces\n1457\t        if !high_mono_traces.is_empty() {\n1458\t            let lambda_combs: Vec<_> = high_mono_traces\n1459\t                .iter()\n1460\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1461\t                .collect();\n1462\t            let batch = ZerocheckMonomialParYBatch::new(\n1463\t                high_mono_traces,\n1464\t                self.pk,\n1465\t                &lambda_combs,\n1466\t                self.sm_count,\n1467\t                sp_deg as u32,\n1468\t                None,\n1469\t            )?;\n1470\t            let out = batch\n1471\t                .evaluate(sp_deg as u32)\n1472\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1473\t            let host = out.to_host()?;\n1474\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1475\t                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n1476\t            }\n1477\t        }\n1478\t\n1479\t        // Monomial zerocheck for low num_y traces\n1480\t        let low_mono_traces = low_early;\n1481\t        if !low_mono_traces.is_empty() {\n1482\t            let lambda_combs: Vec<_> = low_mono_traces\n1483\t                .iter()\n1484\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1485\t                .collect();\n1486\t            let batch = ZerocheckMonomialBatch::new(low_mono_traces, self.pk, &lambda_combs)?;\n1487\t            let out = batch\n1488\t                .evaluate(sp_deg as u32)\n1489\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1490\t            let host = out.to_host()?;\n1491\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1492\t                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n1493\t            }\n1494\t        }\n1495\t\n1496\t        Ok(logup_out.into_iter().flatten().chain(zc_out).collect())\n1497\t    }\n1498\t\n1499\t    #[instrument(level = \"debug\", skip_all, fields(round = round))]"}]},"parent_tool_use_id":null,"session_id":"6b231730-29d0-498c-8e87-666663f10549","uuid":"e3277306-6628-4c92-ab40-825d3a875481","timestamp":"2026-04-13T09:51:16.249Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/mod.rs","content":"        self.mem\n            .emit_metrics_with_label(\"prover.batch_constraints.fold_ple_evals\");\n        Ok(())\n    }\n\n    #[instrument(\n        name = \"LogupZerocheck::sumcheck_polys_batch_eval\",\n        level = \"info\",\n        skip_all,\n        fields(round = round)\n    )]\n    fn sumcheck_polys_batch_eval(\n        &mut self,\n        round: usize,\n        r_prev: EF,\n    ) -> Result<Vec<Vec<EF>>, LogupZerocheckError> {\n        let sp_deg = self.constraint_degree;\n\n        // Per-trace outputs (filled as we go)\n        let mut zc_out: Vec<Vec<EF>> = vec![vec![EF::ZERO; sp_deg]; self.n_per_trace.len()];\n        let mut logup_out: Vec<[Vec<EF>; 2]> =\n            vec![[vec![EF::ZERO; sp_deg], vec![EF::ZERO; sp_deg]]; self.n_per_trace.len()];\n\n        let mut late_eval: Vec<TraceCtx> = Vec::new(); // round == n_lift + 1\n        let mut early_eval: Vec<TraceCtx> = Vec::new(); // round <= n_lift\n\n        // ── Phase 1: Collect metadata, split into Case A / Case B (no CUDA calls) ──\n        // For Case B traces, we collect column pointers and sizing info to batch the\n        // interpolation into a single kernel launch.\n        struct CaseBMeta {\n            trace_idx: usize,\n            air_idx: usize,\n            n_lift: usize,\n            num_y: usize,\n            num_columns: usize, // total columns (selectors + preprocessed + mains)\n            interp_offset: usize, // element offset within the big interpolated buffer\n            col_start: usize,   // start index in the flat all_columns array\n            has_preprocessed: bool,\n            need_rot: bool,\n            has_constraints: bool,\n            has_interactions: bool,\n            norm_factor: F,\n        }\n        let mut case_b_traces: Vec<CaseBMeta> = Vec::new();\n        let mut all_columns: Vec<*const EF> = Vec::new();\n        let mut total_interp_elems: usize = 0;\n\n        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n            self.n_per_trace.iter(),\n            self.mat_evals_per_trace.iter(),\n            self.sels_per_trace.iter(),\n            self.d_eq_3b_per_trace.iter(),\n            self.public_values_per_trace.iter(),\n            self.air_indices_per_trace.iter()\n        )\n        .enumerate()\n        {\n            let pk = &self.pk.per_air[air_idx];\n            let dag = &pk.vk.symbolic_constraints;\n            let has_constraints = dag.constraints.num_constraints() > 0;\n            let has_interactions = !dag.interactions.is_empty();\n            if !has_constraints && !has_interactions {\n                continue;\n            }\n\n            let n_lift = n.max(0) as usize;\n            let norm_factor_denom = 1 << (-n).max(0);\n            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n            let has_preprocessed = pk.preprocessed_data.is_some();\n            let need_rot = pk.vk.params.need_rot;\n            let first_main_idx = usize::from(has_preprocessed);\n            let eq_xi_tree = &self.eq_xis[&n_lift];\n\n            if round > n_lift {\n                // Case A\n                if round == n_lift + 1 {\n                    // A.1: evaluate directly at (num_x=1, num_y=1)\n                    let prep_ptr = if has_preprocessed {\n                        MainMatrixPtrs {\n                            data: mats[0].buffer().as_ptr(),\n                            air_width: air_width_for_mat(need_rot, mats[0].width()),\n                        }\n                    } else {\n                        MainMatrixPtrs {\n                            data: std::ptr::null(),\n                            air_width: 0,\n                        }\n                    };\n                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n                        .iter()\n                        .map(|m| MainMatrixPtrs {\n                            data: m.buffer().as_ptr(),\n                            air_width: air_width_for_mat(need_rot, m.width()),\n                        })\n                        .collect_vec();\n                    let main_ptrs_dev = main_ptrs.to_device()?;\n\n                    late_eval.push(TraceCtx {\n                        trace_idx,\n                        air_idx,\n                        n_lift,\n                        num_y: 1,\n                        has_constraints,\n                        has_interactions,\n                        norm_factor,\n                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n                        sels_ptr: sels.buffer().as_ptr(),\n                        prep_ptr,\n                        main_ptrs_dev,\n                        public_ptr: public_vals.as_ptr(),\n                        eq_3bs_ptr: eq_3bs.as_ptr(),\n                    });\n                } else {\n                    // A.2: scale tilde evals only\n                    if has_constraints {\n                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n                        *tilde_eval *= r_prev;\n                    }\n                    if has_interactions {\n                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n                            *x *= r_prev;\n                        }\n                    }\n                }\n            } else {\n                // Case B: collect metadata for batched interpolation\n                let log_num_y = n_lift - round;\n                let num_y = 1 << log_num_y;\n                let height = 2 * num_y;\n                debug_assert_eq!(height, mats[0].height());\n\n                let col_start = all_columns.len();\n                // Collect all column pointers: selectors + all matrices (preprocessed + mains)\n                all_columns.extend(\n                    iter::once(sels)\n                        .chain(mats.iter())\n                        .flat_map(|m| {\n                            assert_eq!(m.height(), height);\n                            (0..m.width())\n                                .map(|col| m.buffer().as_ptr().wrapping_add(col * m.height()))\n                        }),\n                );\n                let num_columns = all_columns.len() - col_start;\n                let interp_size = sp_deg * num_y * num_columns;\n\n                case_b_traces.push(CaseBMeta {\n                    trace_idx,\n                    air_idx,\n                    n_lift,\n                    num_y,\n                    num_columns,\n                    interp_offset: total_interp_elems,\n                    col_start,\n                    has_preprocessed,\n                    need_rot,\n                    has_constraints,\n                    has_interactions,\n                    norm_factor,\n                });\n                total_interp_elems += interp_size;\n            }\n        }\n\n        // ── Phase 2: Batch allocate + single kernel launch ──\n        // One big buffer for all interpolated data, one kernel launch for all Case B traces.\n        let _keepalive_interpolated = if !case_b_traces.is_empty() {\n            let big_buf = DeviceBuffer::<EF>::with_capacity(total_interp_elems);\n            let big_ptr = big_buf.as_mut_ptr();\n\n            // Build descriptors with multi-block-per-trace assignment\n            const THREADS_PER_BLOCK: u32 = 512;\n            let mut block_offset: u32 = 0;\n            let descs: Vec<InterpColDesc> = case_b_traces\n                .iter()\n                .map(|meta| {\n                    let total_threads = (meta.num_y * meta.num_columns) as u32;\n                    let blocks = total_threads.div_ceil(THREADS_PER_BLOCK);\n                    let desc = InterpColDesc {\n                        output: unsafe { big_ptr.add(meta.interp_offset) },\n                        columns_offset: meta.col_start as u32,\n                        num_y: meta.num_y as u32,\n                        num_columns: meta.num_columns as u32,\n                        total_threads,\n                        block_start: block_offset,\n                    };\n                    block_offset += blocks;\n                    desc\n                })\n                .collect();\n            let total_blocks = block_offset as usize;\n\n            let d_descs = descs.to_device()?;\n            let d_all_columns = all_columns.to_device()?;\n            unsafe {\n                batched_interpolate_columns_gpu(&d_descs, &d_all_columns, sp_deg, total_blocks)\n                    .map_err(|e| LogupZerocheckError::InterpolateColumns(e.into()))?;\n            }\n\n            Some(big_buf)\n        } else {\n            None\n        };\n\n        // ── Phase 3: Build TraceCtx for each Case B trace ──\n        for meta in &case_b_traces {\n            let mats = &self.mat_evals_per_trace[meta.trace_idx];\n            let first_main_idx = usize::from(meta.has_preprocessed);\n            let eq_xi_tree = &self.eq_xis[&meta.n_lift];\n            let log_num_y = meta.n_lift - round;\n            let interpolated_height = sp_deg * meta.num_y;\n\n            let base_ptr = _keepalive_interpolated\n                .as_ref()\n                .unwrap()\n                .as_ptr()\n                .wrapping_add(meta.interp_offset);\n\n            let mut widths_so_far = 0usize;\n            let sels_ptr = base_ptr.wrapping_add(widths_so_far * interpolated_height);\n            widths_so_far += 3; // selector width is always 3\n\n            let prep_ptr = if meta.has_preprocessed {\n                MainMatrixPtrs {\n                    data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n                    air_width: air_width_for_mat(meta.need_rot, mats[0].width()),\n                }\n            } else {\n                MainMatrixPtrs {\n                    data: std::ptr::null(),\n                    air_width: 0,\n                }\n            };\n            if meta.has_preprocessed {\n                widths_so_far += mats[0].width();\n            }\n            let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n                .iter()\n                .map(|m| {\n                    let main_ptr = MainMatrixPtrs {\n                        data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n                        air_width: air_width_for_mat(meta.need_rot, m.width()),\n                    };\n                    widths_so_far += m.width();\n                    main_ptr\n                })\n                .collect_vec();\n            debug_assert_eq!(widths_so_far, meta.num_columns);\n            let main_ptrs_dev = main_ptrs.to_device()?;\n\n            early_eval.push(TraceCtx {\n                trace_idx: meta.trace_idx,\n                air_idx: meta.air_idx,\n                n_lift: meta.n_lift,\n                num_y: meta.num_y as u32,\n                has_constraints: meta.has_constraints,\n                has_interactions: meta.has_interactions,\n                norm_factor: meta.norm_factor,\n                eq_xi_ptr: eq_xi_tree.get_ptr(log_num_y),\n                sels_ptr,\n                prep_ptr,\n                main_ptrs_dev,\n                public_ptr: self.public_values_per_trace[meta.trace_idx].as_ptr(),\n                eq_3bs_ptr: self.d_eq_3b_per_trace[meta.trace_idx].as_ptr(),\n            });\n        }\n\n        let d_challenges_ptr = self.d_challenges.as_ptr();\n\n        // Late traces (num_y=1): always use monomial\n        let late_logup_traces: Vec<_> = late_eval.iter().filter(|t| t.has_interactions).collect();\n        if !late_logup_traces.is_empty() {\n            let logup_combs: Vec<_> = late_logup_traces\n                .iter()\n                .map(|t| {\n                    self.logup_combinations[t.trace_idx]\n                        .as_ref()\n                        .expect(\"missing logup monomial combinations for late trace\")\n                })\n                .collect();\n            let batch =\n                LogupMonomialBatch::new(late_logup_traces.iter().copied(), self.pk, &logup_combs)?;\n            let out = batch\n                .evaluate(1)\n                .map_err(LogupZerocheckError::MleInteractionEval)?;\n            let host = out.to_host()?;\n            for (i, trace_idx) in batch.trace_indices().enumerate() {\n                self.logup_tilde_evals[trace_idx][0] = host[i].p * late_logup_traces[i].norm_factor;\n                self.logup_tilde_evals[trace_idx][1] = host[i].q;\n            }\n        }\n        let late_mono_traces: Vec<_> = late_eval\n            .iter()\n            .filter(|t| trace_has_monomials(t, self.pk))\n            .collect();\n        if !late_mono_traces.is_empty() {\n            let lambda_combs: Vec<_> = late_mono_traces\n                .iter()\n                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n                .collect();\n            let batch = ZerocheckMonomialBatch::new(late_mono_traces, self.pk, &lambda_combs)?;\n            let out = batch\n                .evaluate(1)\n                .map_err(LogupZerocheckError::MleConstraintEval)?;\n            let host = out.to_host()?;\n            for (i, trace_idx) in batch.trace_indices().enumerate() {\n                self.zerocheck_tilde_evals[trace_idx] = host[i];\n                // zc_out not set for num_x=1, handled from tilde_eval in compute_batch_s\n            }\n        }\n\n        // Logup for early traces: partition by num_y threshold\n        if !early_eval.is_empty() {\n            evaluate_logup_batched(\n                &early_eval,\n                self.pk,\n                d_challenges_ptr,\n                sp_deg as u32,\n                self.monomial_num_y_threshold,\n                &self.logup_combinations,\n                &mut logup_out,\n                &mut self.logup_tilde_evals,\n                self.memory_limit_bytes,\n            )\n            .map_err(LogupZerocheckError::MleInteractionEval)?;\n        }\n\n        // Early traces (num_y>1): partition by threshold for zerocheck path\n        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n            .iter()\n            .filter(|t| t.has_constraints)\n            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n\n        // Partition high num_y traces by monomial-to-rules ratio\n        // (traces without monomials are skipped - they contribute zero)\n        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n            high_early.iter().partition(|t| {\n                let num_monomials = get_num_monomials(t, self.pk);\n                let rules_len = get_zerocheck_rules_len(t, self.pk);\n                // Use DAG when monomial expansion significantly increased the term count\n                num_monomials as usize >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len\n            });\n\n        // DAG evaluation for high num_y traces with high monomial-to-rules ratio\n        if !high_dag_traces.is_empty() {\n            let lambda_pows = self.lambda_pows.as_ref().unwrap();\n            evaluate_zerocheck_batched(\n                high_dag_traces,\n                self.pk,\n                lambda_pows,\n                sp_deg as u32,\n                &mut zc_out,\n                self.memory_limit_bytes,\n            )\n            .map_err(LogupZerocheckError::MleConstraintEval)?;\n        }\n\n        // Par-Y monomial kernel for high num_y traces\n        if !high_mono_traces.is_empty() {\n            let lambda_combs: Vec<_> = high_mono_traces\n                .iter()\n                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n                .collect();\n            let batch = ZerocheckMonomialParYBatch::new(\n                high_mono_traces,\n                self.pk,\n                &lambda_combs,\n                self.sm_count,\n                sp_deg as u32,\n                None,\n            )?;\n            let out = batch\n                .evaluate(sp_deg as u32)\n                .map_err(LogupZerocheckError::MleConstraintEval)?;\n            let host = out.to_host()?;\n            for (i, trace_idx) in batch.trace_indices().enumerate() {\n                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n            }\n        }\n\n        // Monomial zerocheck for low num_y traces\n        let low_mono_traces = low_early;\n        if !low_mono_traces.is_empty() {\n            let lambda_combs: Vec<_> = low_mono_traces\n                .iter()\n                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n                .collect();\n            let batch = ZerocheckMonomialBatch::new(low_mono_traces, self.pk, &lambda_combs)?;\n            let out = batch\n                .evaluate(sp_deg as u32)\n                .map_err(LogupZerocheckError::MleConstraintEval)?;\n            let host = out.to_host()?;\n            for (i, trace_idx) in batch.trace_indices().enumerate() {\n                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n            }\n        }\n\n        Ok(logup_out.into_iter().flatten().chain(zc_out).collect())\n    }\n\n    #[instrument(level = \"debug\", skip_all, fields(round = round))]","numLines":400,"startLine":1100,"totalLines":1772}}}
