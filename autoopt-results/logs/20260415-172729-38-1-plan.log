{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TtAcJhgs1uUsTPXoEVuBry","type":"tool_result","content":"0\tuse itertools::Itertools;\n1\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer};\n2\tuse openvm_stark_backend::{\n3\t    air_builders::symbolic::{\n4\t        symbolic_expression::SymbolicExpression, SymbolicConstraints, SymbolicDagBuilder,\n5\t        SymbolicExpressionDag,\n6\t    },\n7\t    prover::{fractional_sumcheck_gkr::Frac, DeviceStarkProvingKey},\n8\t};\n9\tuse p3_field::PrimeCharacteristicRing;\n10\tuse tracing::{debug, warn};\n11\t\n12\tuse super::errors::Round0EvalError;\n13\tuse crate::{\n14\t    cuda::logup_zerocheck::{\n15\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n16\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n17\t        logup_bary_eval_interactions_round0, zerocheck_ntt_eval_constraints,\n18\t    },\n19\t    gpu_backend::GenericGpuBackend,\n20\t    hash_scheme::GpuHashScheme,\n21\t    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n22\t    prelude::{EF, F},\n23\t};\n24\t\n25\t/// Pre-allocated per-thread GPU buffers for Round 0 evaluation.\n26\t/// Reused across AIRs to eliminate per-AIR mutex contention on the global memory manager.\n27\tpub(crate) struct Round0ThreadBuffers {\n28\t    pub zc_intermediates: DeviceBuffer<F>,\n29\t    pub zc_temp_sums: DeviceBuffer<EF>,\n30\t    pub logup_intermediates: DeviceBuffer<F>,\n31\t    pub logup_temp_sums: DeviceBuffer<Frac<EF>>,\n32\t}\n33\t\n34\t/// Evaluate plain AIR constraints (not interactions) for a single AIR, given prepared trace input.\n35\t///\n36\t/// `num_cosets` should equal `constraint_degree - 1` because we evaluate the quotient polynomial.\n37\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n38\t#[allow(clippy::too_many_arguments)]\n39\tpub fn evaluate_round0_constraints_gpu<HS: GpuHashScheme>(\n40\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n41\t    selectors_cube: &DeviceBuffer<F>,\n42\t    main_parts: &DeviceBuffer<*const F>,\n43\t    public_values: &DeviceBuffer<F>,\n44\t    eq_cube: *const EF,\n45\t    lambda_pows: &DeviceBuffer<EF>,\n46\t    skip_domain: u32,\n47\t    num_x: u32,\n48\t    height: u32,\n49\t    num_cosets: u32,\n50\t    g_shift: F,\n51\t    max_temp_bytes: usize,\n52\t    prealloc_intermediates: Option<&mut DeviceBuffer<F>>,\n53\t    prealloc_temp_sums: Option<&mut DeviceBuffer<EF>>,\n54\t) -> Result<DeviceBuffer<EF>, Round0EvalError> {\n55\t    let constraints_dag = &pk.vk.symbolic_constraints;\n56\t    if constraints_dag.constraints.constraint_idx.is_empty() || num_cosets == 0 {\n57\t        // No plain AIR constraints, return empty buffer\n58\t        return Ok(DeviceBuffer::new());\n59\t    }\n60\t\n61\t    let rules = &pk.other_data.zerocheck_round0;\n62\t\n63\t    let buffer_size: u32 = rules.inner.buffer_size;\n64\t    let intermed_capacity = unsafe {\n65\t        _zerocheck_r0_intermediates_buffer_size(\n66\t            buffer_size,\n67\t            skip_domain,\n68\t            num_x,\n69\t            num_cosets,\n70\t            max_temp_bytes,\n71\t        )\n72\t    };\n73\t\n74\t    let use_prealloc_inter = prealloc_intermediates\n75\t        .as_ref()\n76\t        .map_or(false, |p| intermed_capacity > 0 && p.len() >= intermed_capacity);\n77\t    let mut fallback_intermediates;\n78\t    let intermediates = if use_prealloc_inter {\n79\t        prealloc_intermediates.unwrap()\n80\t    } else {\n81\t        fallback_intermediates = if intermed_capacity > 0 {\n82\t            debug!(\"zerocheck:intermediates_capacity={intermed_capacity}\");\n83\t            DeviceBuffer::<F>::with_capacity(intermed_capacity)\n84\t        } else {\n85\t            DeviceBuffer::<F>::new()\n86\t        };\n87\t        &mut fallback_intermediates\n88\t    };\n89\t\n90\t    let temp_sums_buffer_capacity = unsafe {\n91\t        _zerocheck_r0_temp_sums_buffer_size(\n92\t            buffer_size,\n93\t            skip_domain,\n94\t            num_x,\n95\t            num_cosets,\n96\t            max_temp_bytes,\n97\t        )\n98\t    };\n99\t"}]},"parent_tool_use_id":"toolu_01R6kMM65U6pPfUMMgWraCe7","session_id":"f245fed0-0457-4d6a-9da2-744553774a6f","uuid":"7b05196c-95c0-48b0-878e-845d32f70ca5","timestamp":"2026-04-15T16:15:55.940Z"}
