{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012JW7bGANUGsFss5Sv2pf4Z","type":"tool_result","content":"1\tuse itertools::Itertools;\n2\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer};\n3\tuse openvm_stark_backend::{\n4\t    air_builders::symbolic::{\n5\t        symbolic_expression::SymbolicExpression, SymbolicConstraints, SymbolicDagBuilder,\n6\t        SymbolicExpressionDag,\n7\t    },\n8\t    prover::{fractional_sumcheck_gkr::Frac, DeviceStarkProvingKey},\n9\t};\n10\tuse p3_field::PrimeCharacteristicRing;\n11\tuse tracing::{debug, warn};\n12\t\n13\tuse super::errors::Round0EvalError;\n14\tuse crate::{\n15\t    cuda::logup_zerocheck::{\n16\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n17\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n18\t        logup_bary_eval_interactions_round0, zerocheck_ntt_eval_constraints,\n19\t    },\n20\t    gpu_backend::GenericGpuBackend,\n21\t    hash_scheme::GpuHashScheme,\n22\t    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n23\t    prelude::{EF, F},\n24\t};\n25\t\n26\t/// Pre-allocated per-thread GPU buffers for Round 0 evaluation.\n27\t/// Reused across AIRs to eliminate per-AIR mutex contention on the global memory manager.\n28\tpub(crate) struct Round0ThreadBuffers {\n29\t    pub zc_intermediates: DeviceBuffer<F>,\n30\t    pub zc_temp_sums: DeviceBuffer<EF>,\n31\t    pub logup_intermediates: DeviceBuffer<F>,\n32\t    pub logup_temp_sums: DeviceBuffer<Frac<EF>>,\n33\t}\n34\t\n35\t/// Evaluate plain AIR constraints (not interactions) for a single AIR, given prepared trace input.\n36\t///\n37\t/// `num_cosets` should equal `constraint_degree - 1` because we evaluate the quotient polynomial.\n38\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n39\t#[allow(clippy::too_many_arguments)]\n40\tpub fn evaluate_round0_constraints_gpu<HS: GpuHashScheme>(\n41\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n42\t    selectors_cube: &DeviceBuffer<F>,\n43\t    main_parts: &DeviceBuffer<*const F>,\n44\t    public_values: &DeviceBuffer<F>,\n45\t    eq_cube: *const EF,\n46\t    lambda_pows: &DeviceBuffer<EF>,\n47\t    skip_domain: u32,\n48\t    num_x: u32,\n49\t    height: u32,\n50\t    num_cosets: u32,\n51\t    g_shift: F,\n52\t    max_temp_bytes: usize,\n53\t    prealloc_intermediates: Option<&mut DeviceBuffer<F>>,\n54\t    prealloc_temp_sums: Option<&mut DeviceBuffer<EF>>,\n55\t) -> Result<DeviceBuffer<EF>, Round0EvalError> {\n56\t    let constraints_dag = &pk.vk.symbolic_constraints;\n57\t    if constraints_dag.constraints.constraint_idx.is_empty() || num_cosets == 0 {\n58\t        // No plain AIR constraints, return empty buffer\n59\t        return Ok(DeviceBuffer::new());\n60\t    }\n61\t\n62\t    let rules = &pk.other_data.zerocheck_round0;\n63\t\n64\t    let buffer_size: u32 = rules.inner.buffer_size;\n65\t    let intermed_capacity = unsafe {\n66\t        _zerocheck_r0_intermediates_buffer_size(\n67\t            buffer_size,\n68\t            skip_domain,\n69\t            num_x,\n70\t            num_cosets,\n71\t            max_temp_bytes,\n72\t        )\n73\t    };\n74\t\n75\t    let use_prealloc_inter = prealloc_intermediates\n76\t        .as_ref()\n77\t        .map_or(false, |p| intermed_capacity > 0 && p.len() >= intermed_capacity);\n78\t    let mut fallback_intermediates;\n79\t    let intermediates = if use_prealloc_inter {\n80\t        prealloc_intermediates.unwrap()"}]},"parent_tool_use_id":"toolu_016YMbBdxr7jKnQmakTAbjjJ","session_id":"f245fed0-0457-4d6a-9da2-744553774a6f","uuid":"69003c11-eb34-4d69-9a9f-eeb4f59404d1","timestamp":"2026-04-15T16:09:36.914Z"}
