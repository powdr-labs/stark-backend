{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018ZKvCVCwjPmR82c3BPbzCo","type":"tool_result","content":"344\t// ============================================================================\n345\t// LAUNCHERS\n346\t// ============================================================================\n347\t\n348\t// ============================================================================\n349\t// SIZE HELPERS (batch kernels)\n350\t// ============================================================================\n351\t//\n352\t// Batch kernels always use global intermediates when buffer_size > 0 (no local-threshold path),\n353\t// so we need dedicated sizing helpers instead of `_zerocheck_mle_intermediates_buffer_size` /\n354\t// `_logup_mle_intermediates_buffer_size` from `mle.cu`, which return 0 under local thresholds.\n355\t\n356\t// In FpExt elements.\n357\textern \"C\" size_t _zerocheck_batch_mle_intermediates_buffer_size(\n358\t    uint32_t buffer_size,\n359\t    uint32_t num_x,\n360\t    uint32_t num_y\n361\t) {\n362\t    size_t height = static_cast<size_t>(num_x) * num_y;\n363\t    return height * buffer_size;\n364\t}\n365\t\n366\t// In FpExt elements.\n367\textern \"C\" size_t _logup_batch_mle_intermediates_buffer_size(\n368\t    uint32_t buffer_size,\n369\t    uint32_t num_x,\n370\t    uint32_t num_y\n371\t) {\n372\t    size_t height = static_cast<size_t>(num_x) * num_y;\n373\t    return height * buffer_size;\n374\t}\n375\t\n376\textern \"C\" int _zerocheck_batch_eval_mle(\n377\t    FpExt *tmp_sums_buffer,\n378\t    FpExt *output,\n379\t    const BlockCtx *block_ctxs,\n380\t    const ZerocheckCtx *zc_ctxs,\n381\t    const uint32_t *air_block_offsets, // size = num_airs + 1, grouped by air_idx\n382\t    const FpExt *lambda_pows,\n383\t    size_t lambda_len,\n384\t    uint32_t num_blocks,\n385\t    uint32_t num_x,\n386\t    uint32_t num_airs,\n387\t    uint32_t threads_per_block\n388\t) {\n389\t    dim3 grid(num_blocks, num_x);\n390\t    dim3 block(threads_per_block);\n391\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n392\t\n393\t    zerocheck_batch_mle_kernel<<<grid, block, shmem_bytes>>>(\n394\t        tmp_sums_buffer, block_ctxs, zc_ctxs, lambda_pows, lambda_len\n395\t    );\n396\t    int err = CHECK_KERNEL();\n397\t    if (err != 0)\n398\t        return err;\n399\t\n400\t    // Batched reduction for all AIRs in single launch\n401\t    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n402\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n403\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n404\t\n405\t    dim3 reduce_grid(num_airs, num_x);\n406\t    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n407\t        tmp_sums_buffer, output, air_block_offsets, num_x\n408\t    );\n409\t\n410\t    return CHECK_KERNEL();\n411\t}\n412\t\n413\textern \"C\" int _logup_batch_eval_mle(\n414\t    FracExt *tmp_sums_buffer,\n415\t    FracExt *output,\n416\t    const BlockCtx *block_ctxs,\n417\t    const LogupCtx *logup_ctxs,\n418\t    const uint32_t *air_block_offsets, // size = num_airs + 1, grouped by air_idx\n419\t    uint32_t num_blocks,\n420\t    uint32_t num_x,\n421\t    uint32_t num_airs,\n422\t    uint32_t threads_per_block\n423\t) {\n424\t    dim3 grid(num_blocks, num_x);\n425\t    dim3 block(threads_per_block);\n426\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n427\t\n428\t    logup_batch_mle_kernel<<<grid, block, shmem_bytes>>>(tmp_sums_buffer, block_ctxs, logup_ctxs);\n429\t    int err = CHECK_KERNEL();\n430\t    if (err != 0)\n431\t        return err;\n432\t\n433\t    // Batched reduction for all AIRs in single launch\n434\t    // FracExt = (FpExt, FpExt) so d = 2 * num_x\n435\t    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n436\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n437\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n438\t\n439\t    dim3 reduce_grid(num_airs, 2 * num_x);\n440\t    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n441\t        reinterpret_cast<FpExt *>(tmp_sums_buffer),\n442\t        reinterpret_cast<FpExt *>(output),\n443\t        air_block_offsets,"}]},"parent_tool_use_id":"toolu_01AziaoQyUBvBQHrhM4RkX8Z","session_id":"f245fed0-0457-4d6a-9da2-744553774a6f","uuid":"49b596f7-973b-4471-b3ac-ebccc7ac9ece","timestamp":"2026-04-15T15:34:08.030Z"}
