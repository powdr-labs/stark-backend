{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014do3ko9deBC8SckEhXei7P","type":"tool_result","content":"233\t    pub fn sumcheck_uni_round0_polys(\n234\t        &mut self,\n235\t        ctx: &ProvingContext<CpuColMajorBackend<SC>>,\n236\t        lambda: SC::EF,\n237\t    ) -> Result<Vec<UnivariatePoly<SC::EF>>, LogupZerocheckError> {\n238\t        let n_logup = self.n_logup;\n239\t        let l_skip = self.l_skip;\n240\t        let xi = &self.xi;\n241\t        self.lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n242\t\n243\t        // For each trace, for each interaction \\hat\\sigma, the eq(ξ_3,b_{T,\\hat\\sigma}) term.\n244\t        // This is some weight per interaction that does not depend on the row.\n245\t        self.eq_3b_per_trace = self\n246\t            .eval_helpers\n247\t            .par_iter()\n248\t            .zip(&self.n_per_trace)\n249\t            .enumerate()\n250\t            .map(\n251\t                |(trace_idx, (helper, &n))| -> Result<Vec<SC::EF>, LogupZerocheckError> {\n252\t                    // Everything for logup is done with respect to lifted traces\n253\t                    // Note: `n_lift = \\tilde{n}` from the paper\n254\t                    let n_lift = n.max(0) as usize;\n255\t                    if helper.interactions.is_empty() {\n256\t                        return Ok(vec![]);\n257\t                    }\n258\t                    let mut b_vec = vec![SC::F::ZERO; n_logup - n_lift];\n259\t                    (0..helper.interactions.len())\n260\t                        .map(|i| {\n261\t                            // PERF[jpw]: interactions_layout.get is linear\n262\t                            let stacked_idx = self\n263\t                                .interactions_layout\n264\t                                .get(trace_idx, i)\n265\t                                .ok_or(LogupZerocheckError::InteractionsLayoutMissing {\n266\t                                    trace_idx,\n267\t                                    interaction_idx: i,\n268\t                                })?\n269\t                                .row_idx;\n270\t                            debug_assert!(stacked_idx.trailing_zeros() as usize >= n_lift + l_skip);\n271\t                            let mut b_int = stacked_idx >> (l_skip + n_lift);\n272\t                            for b in &mut b_vec {\n273\t                                *b = SC::F::from_bool(b_int & 1 == 1);\n274\t                                b_int >>= 1;\n275\t                            }\n276\t                            Ok(eval_eq_mle(&xi[l_skip + n_lift..l_skip + n_logup], &b_vec))\n277\t                        })\n278\t                        .collect()\n279\t                },\n280\t            )\n281\t            .collect::<Result<Vec<_>, _>>()?;\n282\t\n283\t        // PERF[jpw]: make Hashmap from unique n -> eq_n(xi, -)\n284\t        // NOTE: this is evaluations of `x -> eq_{H_{\\tilde n}}(x, \\xi[l_skip..l_skip + \\tilde n])`\n285\t        // on hypercube `H_{\\tilde n}`. We store the univariate component eq_D separately as\n286\t        // an optimization.\n287\t        self.eq_xi_per_trace = self\n288\t            .n_per_trace\n289\t            .par_iter()\n290\t            .map(|&n| {\n291\t                let n_lift = n.max(0) as usize;\n292\t                // PERF[jpw]: might be able to share computations between eq_xi, eq_sharp\n293\t                // computations the eq(xi, -) evaluations on hyperprism for\n294\t                // zerocheck\n295\t                evals_eq_hypercubes(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n296\t            })\n297\t            .collect();\n298\t\n299\t        // For each trace, create selectors as a 3-column matrix of _the lifts of_ [is_first,\n300\t        // is_transition, is_last]\n301\t        //\n302\t        // PERF[jpw]: I think it's better to not save these and just\n303\t        // interpolate directly using the formulas for selectors\n304\t        self.sels_per_trace_base = self\n305\t            .n_per_trace\n306\t            .iter()\n307\t            .map(|&n| {\n308\t                let log_height = l_skip.checked_add_signed(n).unwrap();\n309\t                let height = 1 << log_height;\n310\t                let lifted_height = height.max(1 << l_skip);\n311\t                let mut mat = SC::F::zero_vec(3 * lifted_height);\n312\t                mat[lifted_height..2 * lifted_height].fill(SC::F::ONE);\n313\t                for i in (0..lifted_height).step_by(height) {\n314\t                    mat[i] = SC::F::ONE; // is_first\n315\t                    mat[lifted_height + i + height - 1] = SC::F::ZERO; // is_transition\n316\t                    mat[2 * lifted_height + i + height - 1] = SC::F::ONE; // is_last\n317\t                }\n318\t                ColMajorMatrix::new(mat, 3)\n319\t            })\n320\t            .collect_vec();\n321\t\n322\t        let sp_0_zerochecks = self\n323\t            .eval_helpers\n324\t            .par_iter()\n325\t            .enumerate()\n326\t            .map(|(trace_idx, helper)| {\n327\t                let trace_ctx = &ctx.per_trace[trace_idx].1;\n328\t                let n_lift = log2_strict_usize(trace_ctx.height()).saturating_sub(l_skip);\n329\t                let mats = &helper.view_mats(trace_ctx);\n330\t                let eq_xi = &self.eq_xi_per_trace[trace_idx][(1 << n_lift) - 1..(2 << n_lift) - 1];\n331\t                let sels = self.sels_per_trace_base[trace_idx].as_view();\n332\t                let mut parts = vec![(sels.into(), false)];\n333\t                parts.extend_from_slice(mats);\n334\t                // s'_0 has degree dependent on this AIR's constraint degree\n335\t                // s'_0(Z) is a univariate polynomial which vanishes on D (zerocheck). Hence q(Z) =\n336\t                // s'_0(Z) / Z_D(Z) = s'_0(Z) / (Z^{2^l_skip} - 1) is a polynomial of degree d *\n337\t                // (2^l_skip - 1) - 2^l_skip = (d - 1) * 2^l_skip - d We can obtain\n338\t                // q(Z) by interpolating evaluations on (d - 1) * 2^l_skip points. For computation\n339\t                // efficiency, we choose these to be (d - 1) cosets of D. To avoid divide by zero,\n340\t                // we avoid the coset equal to the subgroup D itself.\n341\t                let constraint_deg = helper.constraint_degree as usize;\n342\t                if constraint_deg == 0 {\n343\t                    return UnivariatePoly(vec![]);\n344\t                }\n345\t                let num_cosets = constraint_deg - 1;\n346\t                let [q] = sumcheck_uni_round0_poly(\n347\t                    l_skip,\n348\t                    n_lift,\n349\t                    num_cosets,\n350\t                    &parts,\n351\t                    |z, x, row_parts| {\n352\t                        let eq = eq_xi[x];\n353\t                        let constraint_eval = helper.acc_constraints(row_parts, &self.lambda_pows);\n354\t                        let zerofier = z.exp_power_of_2(l_skip) - SC::F::ONE;\n355\t                        [eq * constraint_eval * zerofier.inverse()]\n356\t                    },\n357\t                );\n358\t                // sp_0 = (Z^{2^l_skip} - 1) * q\n359\t                let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_deg);\n360\t                let coeffs = (0..=sp_0_deg)\n361\t                    .map(|i| {\n362\t                        let mut c = -*q.coeffs().get(i).unwrap_or(&SC::EF::ZERO);\n363\t                        if i >= 1 << l_skip {\n364\t                            c += q.coeffs()[i - (1 << l_skip)];\n365\t                        }\n366\t                        c\n367\t                    })\n368\t                    .collect_vec();\n369\t                debug_assert_eq!(\n370\t                    coeffs.iter().step_by(1 << l_skip).copied().sum::<SC::EF>(),\n371\t                    SC::EF::ZERO,\n372\t                    \"Zerocheck sum is not zero for air_id: {}\",\n373\t                    ctx.per_trace[trace_idx].0\n374\t                );\n375\t                UnivariatePoly(coeffs)\n376\t            })\n377\t            .collect::<Vec<_>>();\n378\t        // Reminder: sum claims for zerocheck are zero, per AIR\n379\t\n380\t        // We interpolate each logup round 0 sumcheck poly because we need to use it to compute\n381\t        // sum_{\\hat{p}, T, I}, sum_{\\hat{q}, T, I} per trace.\n382\t        let sp_0_logups = self\n383\t            .eval_helpers\n384\t            .par_iter()\n385\t            .enumerate()\n386\t            .flat_map(|(trace_idx, helper)| {\n387\t                if helper.interactions.is_empty() {\n388\t                    return [(); 2].map(|_| UnivariatePoly::new(vec![]));\n389\t                }\n390\t                let trace_ctx = &ctx.per_trace[trace_idx].1;\n391\t                let log_height = log2_strict_usize(trace_ctx.height());\n392\t                let n_lift = log_height.saturating_sub(l_skip);\n393\t                let mats = &helper.view_mats(trace_ctx);\n394\t                let eq_xi = &self.eq_xi_per_trace[trace_idx][(1 << n_lift) - 1..(2 << n_lift) - 1];\n395\t                let eq_3bs = &self.eq_3b_per_trace[trace_idx];\n396\t                let sels = self.sels_per_trace_base[trace_idx].as_view();\n397\t                let mut parts = vec![(sels.into(), false)];\n398\t                parts.extend_from_slice(mats);\n399\t                let norm_factor_denom = 1 << l_skip.saturating_sub(log_height);\n400\t                let norm_factor = SC::F::from_usize(norm_factor_denom).inverse();\n401\t\n402\t                // degree is constraint_degree + 1 due to eq term\n403\t                let [mut numer, denom] = sumcheck_uni_round0_poly(\n404\t                    l_skip,\n405\t                    n_lift,\n406\t                    helper.constraint_degree as usize,\n407\t                    &parts,\n408\t                    |_z, x, row_parts| {\n409\t                        let eq = eq_xi[x];\n410\t                        let [numer, denom] =\n411\t                            helper.acc_interactions(row_parts, &self.beta_pows, eq_3bs);\n412\t                        [eq * numer, eq * denom]\n413\t                    },\n414\t                );\n415\t                for p in numer.coeffs_mut() {\n416\t                    *p *= norm_factor;\n417\t                }\n418\t                [numer, denom]\n419\t            })\n420\t            .collect::<Vec<_>>();\n421\t\n422\t        Ok(sp_0_logups.into_iter().chain(sp_0_zerochecks).collect())\n423\t    }\n424\t\n425\t    /// After univariate sumcheck round 0, fold prismalinear evaluations using randomness `r_0`.\n426\t    /// Folding _could_ directly mutate inplace the trace matrices in `ctx` as they will not be\n427\t    /// needed after this.\n428\t    pub fn fold_ple_evals(&mut self, ctx: &ProvingContext<CpuColMajorBackend<SC>>, r_0: SC::EF) {\n429\t        let l_skip = self.l_skip;\n430\t        // \"Fold\" all PLE evaluations by interpolating and evaluating at `r_0`.\n431\t        // NOTE: after this folding, \\hat{T} and \\hat{T_{rot}} will be treated as completely\n432\t        // distinct matrices.\n433\t        self.mat_evals_per_trace = self\n434\t            .eval_helpers\n435\t            .par_iter()\n436\t            .zip(ctx.per_trace.par_iter())\n437\t            .map(|(helper, (_, trace_ctx))| {\n438\t                let mats = helper.view_mats(trace_ctx);\n439\t                mats.into_par_iter()\n440\t                    .map(|(mat, is_rot)| fold_ple_evals(l_skip, mat, is_rot, r_0))\n441\t                    .collect::<Vec<_>>()\n442\t            })\n443\t            .collect::<Vec<_>>();\n444\t        self.sels_per_trace =\n445\t            batch_fold_ple_evals(l_skip, take(&mut self.sels_per_trace_base), false, r_0);\n446\t        let eq_r0 = eval_eq_uni(l_skip, self.xi[0], r_0);\n447\t        let eq_sharp_r0 = eval_eq_sharp_uni(&self.omega_skip_pows, &self.xi[..l_skip], r_0);\n448\t        self.eq_ns.push(eq_r0);\n449\t        self.eq_sharp_ns.push(eq_sharp_r0);\n450\t        self.eq_xi_per_trace.iter_mut().for_each(|eq| {\n451\t            // trim the back (which corresponds to r_{j-1}) because we don't need it anymore\n452\t            if eq.len() > 1 {\n453\t                eq.truncate(eq.len() / 2);\n454\t            }\n455\t        });\n456\t    }\n457\t\n458\t    /// Returns length `3 * num_airs_present` polynomials, each polynomial either evaluated at\n459\t    /// `1,...,deg(s')` or at `1` if a linear term (terms in front-loaded sumcheck that have reached\n460\t    /// exhaustion)\n461\t    pub fn sumcheck_polys_eval(\n462\t        &mut self,\n463\t        round: usize,\n464\t        r_prev: SC::EF,\n465\t    ) -> Result<Vec<Vec<SC::EF>>, LogupZerocheckError> {\n466\t        // sp = s'\n467\t        let sp_deg = self.constraint_degree;\n468\t        let eq_r_acc = *self\n469\t            .eq_ns\n470\t            .last()\n471\t            .ok_or(LogupZerocheckError::EqNsEmpty { round })?;\n472\t        let eq_sharp_r_acc = *self\n473\t            .eq_sharp_ns\n474\t            .last()\n475\t            .ok_or(LogupZerocheckError::EqSharpNsEmpty { round })?;\n476\t        let sp_zerocheck_evals: Vec<Vec<SC::EF>> = parizip!(\n477\t            &self.eval_helpers,\n478\t            &mut self.zerocheck_tilde_evals,\n479\t            &self.n_per_trace,\n480\t            &self.mat_evals_per_trace,\n481\t            &self.sels_per_trace,\n482\t            &self.eq_xi_per_trace"}]},"parent_tool_use_id":"toolu_01A89cG6Kh1WaUtfLZq1jpHS","session_id":"f245fed0-0457-4d6a-9da2-744553774a6f","uuid":"5d844401-3c02-44cd-93f7-969865c9785c","timestamp":"2026-04-15T16:05:00.463Z"}
