*. We map the\n42\t    /// constraint idx back to unsorted order. ```text\n43\t    /// constraint_idx => 2 * interaction_idx + is_denom\n44\t    /// ```\n45\t    pub(crate) d_pair_idxs: DeviceBuffer<u32>,\n46\t    pub(crate) max_fields_len: usize,\n47\t}\n48\t\n49\t/// Constraints only, no interactions\n50\tpub struct ConstraintOnlyRules<const BUFFER_VARS: bool> {\n51\t    pub(crate) inner: EvalRules,\n52\t}\n53\t\n54\tpub struct EvalRules {\n55\t    /// Encoded rules\n56\t    pub d_rules: DeviceBuffer<u128>,\n57\t    pub d_used_nodes: DeviceBuffer<usize>,\n58\t    pub buffer_size: u32,\n59\t}\n60\t\n61\tpub struct ZerocheckMonomials {\n62\t    pub d_headers: DeviceBuffer<MonomialHeader>,\n63\t    pub d_variables: DeviceBuffer<PackedVar>,\n64\t    pub d_lambda_terms: DeviceBuffer<LambdaTerm<F>>,\n65\t    pub num_monomials: u32,\n66\t}\n67\t\n68\tpub struct InteractionMonomials {\n69\t    pub d_numer_headers: DeviceBuffer<MonomialHeader>,\n70\t    pub d_numer_variables: DeviceBuffer<PackedVar>,\n71\t    pub d_numer_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n72\t    pub num_numer_monomials: u32,\n73\t    pub d_denom_headers: DeviceBuffer<MonomialHeader>,\n74\t    pub d_denom_variables: DeviceBuffer<PackedVar>,\n75\t    pub d_denom_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n76\t    pub num_denom_monomials: u32,\n77\t    pub max_fields_len: usize,\n78\t    pub num_interactions: u32,\n79\t}\n80\t\n81\tfn to_device_or_empty<T>(data: &[T]) -> Result<DeviceBuffer<T>, MemCopyError> {\n82\t    if data.is_empty() {\n83\t        Ok(DeviceBuffer::new())\n84\t    } else {\n85\t        data.to_device()\n86\t    }\n87\t}\n88\t\n89\timpl AirDataGpu {\n90\t    pub fn new<S: StarkProtocolConfig<F = F>>(\n91\t        pk: &StarkProvingKey<S>,\n92\t    ) -> Result<Self, MemCopyError> {\n93\t        let dag = &pk.vk.symbolic_constraints;\n94\t        let symbolic_constraints = SymbolicConstraints::from(dag);\n95\t        let interaction_rules = InteractionEvalRules::new(&sym