{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UJkm4VNmMnM1HfqqXvJdED","type":"tool_result","content":"1\tuse std::sync::Arc;\n2\t\n3\tuse getset::Getters;\n4\tuse itertools::Itertools;\n5\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer, memory_manager::MemTracker};\n6\tuse openvm_stark_backend::{\n7\t    p3_util::log2_strict_usize,\n8\t    prover::{stacked_pcs::StackedLayout, MatrixDimensions},\n9\t};\n10\tuse tracing::instrument;\n11\t\n12\tuse crate::{\n13\t    base::{DeviceMatrix, DeviceMatrixView},\n14\t    cuda::{\n15\t        batch_ntt_small::batch_ntt_small,\n16\t        matrix::{batch_expand_pad, stack_columns, StackColDesc},\n17\t        ntt::bit_rev,\n18\t    },\n19\t    hash_scheme::GpuMerkleHash,\n20\t    merkle_tree::{MerkleTreeConstructor, MerkleTreeGpu},\n21\t    ntt::batch_ntt,\n22\t    poly::{mle_interpolate_stages, PleMatrix},\n23\t    prelude::F,\n24\t    GpuProverConfig, ProverError, RsCodeMatrixError, StackTracesError,\n25\t};\n26\t\n27\t#[derive(Getters)]\n28\tpub struct StackedPcsDataGpu<F, Digest> {\n29\t    /// Layout of the unstacked collection of matrices within the stacked matrix.\n30\t    #[getset(get = \"pub\")]\n31\t    pub(crate) layout: StackedLayout,\n32\t    /// The stacked matrix with height `2^{l_skip + n_stack}`.\n33\t    /// This is optionally cached depending on the prover configuration:\n34\t    /// - Caching increases the peak GPU memory but avoids a recomputation during stacked\n35\t    ///   reduction.\n36\t    /// - Not caching means the stacked matrix computation is recomputed during stacked reduction,\n37\t    ///   but lowers the peak GPU memory.\n38\t    #[getset(get = \"pub\")]\n39\t    pub(crate) matrix: Option<PleMatrix<F>>,\n40\t    /// Merkle tree of the Reed-Solomon codewords of the stacked matrix.\n41\t    /// Depends on `k_whir` parameter.\n42\t    #[getset(get = \"pub\")]\n43\t    pub(crate) tree: MerkleTreeGpu<F, Digest>,\n44\t}\n45\t\n46\t#[allow(clippy::type_complexity)]\n47\t#[instrument(level = \"info\", skip_all)]\n48\tpub fn stacked_commit<MH: GpuMerkleHash + MerkleTreeConstructor>(\n49\t    l_skip: usize,\n50\t    n_stack: usize,\n51\t    log_blowup: usize,\n52\t    k_whir: usize,\n53\t    traces: &[&DeviceMatrix<F>],\n54\t    prover_config: GpuProverConfig,\n55\t) -> Result<(MH::Digest, StackedPcsDataGpu<F, MH::Digest>), ProverError> {\n56\t    let mut mem = MemTracker::start(\"prover.stacked_commit\");\n57\t    mem.tracing_info(\"before stacked_commit\");\n58\t    mem.reset_peak();\n59\t    let layout = get_stacked_layout(l_skip, n_stack, traces);\n60\t    tracing::info!(\n61\t        height = layout.height(),\n62\t        width = layout.width(),\n63\t        \"stacked_matrix_dimensions\"\n64\t    );\n65\t    let opt_stacked_matrix = if prover_config.cache_stacked_matrix {\n66\t        Some(stack_traces(&layout, traces)?)\n67\t    } else {\n68\t        None\n69\t    };\n70\t    let rs_matrix = rs_code_matrix(log_blowup, &layout, traces, &opt_stacked_matrix)?;\n71\t    let tree = MerkleTreeGpu::<F, MH::Digest>::new_with_hash::<MH>(\n72\t        rs_matrix,\n73\t        1 << k_whir,\n74\t        prover_config.cache_rs_code_matrix,\n75\t    )?;\n76\t    let root = tree.root();\n77\t    let data = StackedPcsDataGpu {\n78\t        layout,\n79\t        matrix: opt_stacked_matrix,\n80\t        tree,\n81\t    };\n82\t    mem.emit_metrics();\n83\t    Ok((root, data))\n84\t}\n85\t\n86\t/// The `traces` **must** already be in height-sorted order.\n87\t///\n88\t/// This function is generic in `F` and only relies on CUDA memory operations.\n89\t#[instrument(skip_all)]\n90\tpub fn stacked_matrix(\n91\t    l_skip: usize,\n92\t    n_stack: usize,\n93\t    traces: &[&DeviceMatrix<F>],\n94\t) -> Result<(PleMatrix<F>, StackedLayout), ProverError> {\n95\t    let layout = get_stacked_layout(l_skip, n_stack, traces);\n96\t    let matrix = stack_traces(&layout, traces)?;\n97\t    Ok((matrix, layout))\n98\t}\n99\t\n100\tpub(crate) fn get_stacked_layout(\n101\t    l_skip: usize,\n102\t    n_stack: usize,\n103\t    traces: &[&DeviceMatrix<F>],\n104\t) -> StackedLayout {\n105\t    let sorted_meta = traces\n106\t        .iter()\n107\t        .map(|trace| {\n108\t            // height cannot be zero:\n109\t            let log_height = log2_strict_usize(trace.height());\n110\t            (trace.width(), log_height)\n111\t        })\n112\t        .collect_vec();\n113\t    debug_assert!(sorted_meta.is_sorted_by(|a, b| a.1 >= b.1));\n114\t    StackedLayout::new(l_skip, l_skip + n_stack, sorted_meta).unwrap()\n115\t}\n116\t\n117\tpub(crate) fn stack_traces(\n118\t    layout: &StackedLayout,\n119\t    traces: &[&DeviceMatrix<F>],\n120\t) -> Result<PleMatrix<F>, StackTracesError> {\n121\t    let mem = MemTracker::start(\"prover.stack_traces\");\n122\t    let l_skip = layout.l_skip();\n123\t    let height = layout.height();\n124\t    let width = layout.width();\n125\t    let mut q_evals = DeviceBuffer::<F>::with_capacity(width.checked_mul(height).unwrap());\n126\t    stack_traces_into_expanded(layout, traces, &mut q_evals, height)?;\n127\t    mem.emit_metrics();\n128\t    Ok(PleMatrix::from_evals(l_skip, q_evals, height, width))\n129\t}\n130\t\n131\t/// `buffer` should be the buffer to write the stacked traces into.\n132\t/// `buffer` should be a matrix with dimensions `padded_height x width` where `width` is the stacked\n133\t/// width and `padded_height` must be a multiple of the stacked height.\n134\tpub(crate) fn stack_traces_into_expanded(\n135\t    layout: &StackedLayout,\n136\t    traces: &[&DeviceMatrix<F>],\n137\t    buffer: &mut DeviceBuffer<F>,\n138\t    padded_height: usize,\n139\t) -> Result<(), StackTracesError> {\n140\t    let l_skip = layout.l_skip();\n141\t    debug_assert_eq!(padded_height % layout.height(), 0);\n142\t    debug_assert_eq!(buffer.len() % padded_height, 0);\n143\t    debug_assert_eq!(buffer.len() / padded_height, layout.width());\n144\t    buffer.fill_zero().map_err(StackTracesError::FillZero)?;\n145\t\n146\t    // Phase 1: Build descriptor array on host (CPU-only, no CUDA API calls)\n147\t    let mut descs: Vec<StackColDesc> = Vec::with_capacity(layout.sorted_cols.len());\n148\t    for (mat_idx, j, s) in &layout.sorted_cols {\n149\t        let start = s.col_idx * padded_height + s.row_idx;\n150\t        let trace = traces[*mat_idx];\n151\t        let s_len = s.len(l_skip);\n152\t        debug_assert_eq!(trace.height(), 1 << s.log_height());\n153\t        let (src, height, stride) = if s.log_height() >= l_skip {\n154\t            debug_assert_eq!(trace.height(), s_len);\n155\t            let src = unsafe { trace.buffer().as_ptr().add(*j * s_len) };\n156\t            (src, s_len as u32, 1u32)\n157\t        } else {\n158\t            let stride = s.stride(l_skip);\n159\t            debug_assert_eq!(stride * trace.height(), s_len);\n160\t            let src = unsafe { trace.buffer().as_ptr().add(*j * trace.height()) };\n161\t            (src, trace.height() as u32, stride as u32)\n162\t        };\n163\t        let dst = unsafe { buffer.as_mut_ptr().add(start) };\n164\t        descs.push(StackColDesc { src, dst, height, stride });\n165\t    }\n166\t\n167\t    // Phase 2: Upload descriptors to GPU and launch single scatter kernel\n168\t    if !descs.is_empty() {\n169\t        let d_descs = descs.to_device().map_err(StackTracesError::DescriptorUpload)?;\n170\t        unsafe { stack_columns(&d_descs).map_err(StackTracesError::StackColumns)? };\n171\t    }\n172\t    Ok(())\n173\t}\n174\t\n175\t/// Computes the Reed-Solomon codeword of each column vector of `eval_matrix` where the rate is\n176\t/// `2^{-log_blowup}`. The column vectors are treated as evaluations of a prismalinear extension on\n177\t/// a hyperprism.\n178\t///\n179\t/// Uses `stacked_matrix` if available, or else stacks `traces` directly into final codeword matrix\n180\t/// buffer.\n181\t#[instrument(skip_all)]\n182\tpub fn rs_code_matrix(\n183\t    log_blowup: usize,\n184\t    layout: &StackedLayout,\n185\t    traces: &[&DeviceMatrix<F>],\n186\t    stacked_matrix: &Option<PleMatrix<F>>,\n187\t) -> Result<DeviceMatrix<F>, RsCodeMatrixError> {\n188\t    let mem = MemTracker::start_and_reset_peak(\"prover.rs_code_matrix\");\n189\t    let l_skip = layout.l_skip();\n190\t    let height = layout.height();\n191\t    let width = layout.width();\n192\t    debug_assert!(height >= (1 << l_skip));\n193\t    let codeword_height = height.checked_shl(log_blowup as u32).unwrap();\n194\t    let mut codewords = DeviceBuffer::<F>::with_capacity(codeword_height * width);\n195\t    // The following kernels together perform MLE interpolation followed by coset NTT for\n196\t    // `width` polys from `height -> codeword_height` size domains.\n197\t    if let Some(stacked_matrix) = stacked_matrix.as_ref() {\n198\t        // SAFETY: `codewords` is allocated for `width` polys of `codeword_height` each, and we\n199\t        // expand from `matrix.mixed` which is `width` polys of `height` each.\n200\t        unsafe {\n201\t            batch_expand_pad(\n202\t                codewords.as_mut_ptr(),\n203\t                stacked_matrix.mixed.as_ptr(),\n204\t                width as u32,\n205\t                codeword_height as u32,\n206\t                height as u32,\n207\t            )\n208\t            .map_err(RsCodeMatrixError::BatchExpandPad)?;\n209\t        }\n210\t    } else {\n211\t        stack_traces_into_expanded(layout, traces, &mut codewords, codeword_height)\n212\t            .map_err(RsCodeMatrixError::StackTraces)?;\n213\t        // Currently codewords has the stacked matrix, batch expanded, in evaluation form on\n214\t        // hyperprism. We convert it to mixed form, i.e., unroll `PleMatrix::from_evals`.\n215\t        // PERF[jpw]: We do some wasted work on the padded zero part. A more specialized kernel\n216\t        // could be written to avoid this.\n217\t        if l_skip > 0 {\n218\t            // For univariate coordinate, perform inverse NTT for each 2^l_skip chunk per column:\n219\t            // (width cols) * (codeword_height / 2^l_skip chunks per col). Use natural ordering.\n220\t            let num_uni_poly = width * (codeword_height >> l_skip);\n221\t            unsafe {\n222\t                batch_ntt_small(&mut codewords, l_skip, num_uni_poly, true)\n223\t                    .map_err(RsCodeMatrixError::CustomBatchIntt)?;\n224\t            }\n225\t        }\n226\t    }\n227\t    // Eval-to-coeff RS encoding: Instead of full n-stage MLE evals→coeffs interpolation\n228\t    // (where n = log_height - l_skip), we only need l_skip stages of coeffs→evals\n229\t    // (subset-zeta transform) within each 2^l_skip chunk. This is a major optimization:\n230\t    // e.g. for log_height=17, l_skip=2: 2 stages instead of 15.\n231\t    let log_codeword_height = log2_strict_usize(codeword_height);\n232\t\n233\t    // Apply l_skip stages of coeffs_to_evals within each 2^l_skip chunk.\n234\t    // After iNTT, each chunk holds Z-monomial coefficients. We apply the subset-zeta\n235\t    // transform to convert to hypercube evaluations over the Z-bit variables.\n236\t    if l_skip > 0 {\n237\t        // SAFETY: `codewords` is properly initialized and parameters are valid.\n238\t        // Steps 2^0, 2^1, ..., 2^(l_skip-1) stay within chunk boundaries.\n239\t        unsafe {\n240\t            mle_interpolate_stages(\n241\t                codewords.as_mut_ptr(),\n242\t                width as u16,\n243\t                codeword_height as u32,\n244\t                log_blowup as u32,\n245\t                0,                 // start_log_step\n246\t                l_skip as u32 - 1, // end_log_step (inclusive)\n247\t                false,             // coeffs to evals (NOT eval to coeff)\n248\t                false,             // natural order\n249\t            )\n250\t            .map_err(|error| RsCodeMatrixError::MleInterpolateStage2d { error, step: 1 })?;\n251\t        }\n252\t    }\n253\t\n254\t    // Bit-reverse the entire buffer in-place (required for NTT)\n255\t    unsafe {\n256\t        bit_rev(\n257\t            &codewords,\n258\t            &codewords,\n259\t            log_codeword_height as u32,\n260\t            codeword_height as u32,\n261\t            width as u32,\n262\t        )\n263\t        .map_err(RsCodeMatrixError::BitRev)?;\n264\t    }\n265\t\n266\t    // Compute RS codeword via DFT on the smoothly-embedded domain.\n267\t    batch_ntt(\n268\t        &codewords,\n269\t        log_codeword_height as u32,\n270\t        0u32,\n271\t        width as u32,\n272\t        false, // bit-reversal already done\n273\t        false,\n274\t    );\n275\t    let code_matrix = DeviceMatrix::new(Arc::new(codewords), codeword_height, width);\n276\t    mem.emit_metrics();\n277\t\n278\t    Ok(code_matrix)\n279\t}\n280\t\n281\timpl<F, Digest> StackedPcsDataGpu<F, Digest> {\n282\t    /// Returns a view of the specified unstacked matrix in mixed form.\n283\t    ///\n284\t    /// # Notes\n285\t    /// - `width` must be the width of the unstacked matrix.\n286\t    /// - The unstacked matrix may be strided - this must be handled by the caller.\n287\t    pub fn mixed_view<'a>(\n288\t        &'a self,\n289\t        mat_idx: usize,\n290\t        width: usize,\n291\t    ) -> Option<DeviceMatrixView<'a, F>> {\n292\t        if let Some(matrix) = self.matrix.as_ref() {\n293\t            debug_assert_eq!(self.layout.width_of(mat_idx), width);\n294\t            let s = self\n295\t                .layout\n296\t                .get(mat_idx, 0)\n297\t                .unwrap_or_else(|| panic!(\"Invalid matrix index: {mat_idx}\"));\n298\t            let l_skip = self.layout.l_skip();\n299\t            let lifted_height = s.len(l_skip);\n300\t            let offset = s.col_idx * matrix.height() + s.row_idx;\n301\t            // SAFETY:\n302\t            // - by definition of stacked layout and stacked matrix, `ptr` is valid and allocated\n303\t            //   for `lifted_height * width` elements.\n304\t            unsafe {\n305\t                let ptr = matrix.mixed.as_ptr().add(offset);\n306\t                Some(DeviceMatrixView::from_raw_parts(ptr, lifted_height, width))\n307\t            }\n308\t        } else {\n309\t            None\n310\t        }\n311\t    }\n312\t}\n313\t\n314\t#[cfg(test)]\n315\tmod tests {\n316\t    use itertools::Itertools;\n317\t    use openvm_stark_backend::{\n318\t        prover::ColMajorMatrix,\n319\t        test_utils::{InteractionsFixture11, TestFixture},\n320\t    };\n321\t    use p3_field::PrimeCharacteristicRing;\n322\t\n323\t    use super::*;\n324\t    use crate::{\n325\t        data_transporter::{transport_matrix_d2h_col_major, transport_matrix_h2d_col_major},\n326\t        prelude::{F, SC},\n327\t    };\n328\t\n329\t    #[test]\n330\t    fn test_stacked_matrix_manual_0() {\n331\t        let columns = [vec![1, 2, 3, 4], vec![5, 6], vec![7]]\n332\t            .map(|v| v.into_iter().map(F::from_u32).collect_vec());\n333\t        let mats = columns\n334\t            .into_iter()\n335\t            .map(|c| transport_matrix_h2d_col_major(&ColMajorMatrix::new(c, 1)).unwrap())\n336\t            .collect_vec();\n337\t        let mat_refs = mats.iter().collect_vec();\n338\t        let l_skip = 0;\n339\t        let (stacked_mat, _layout) = stacked_matrix(0, 2, &mat_refs).unwrap();\n340\t        assert_eq!(stacked_mat.height(), 4);\n341\t        assert_eq!(stacked_mat.width(), 2);\n342\t        let stacked_h_mat =\n343\t            transport_matrix_d2h_col_major(&stacked_mat.to_evals(l_skip).unwrap()).unwrap();\n344\t        assert_eq!(\n345\t            stacked_h_mat.values,\n346\t            [1, 2, 3, 4, 5, 6, 7, 0].map(F::from_u32).to_vec()\n347\t        );\n348\t    }\n349\t\n350\t    #[test]\n351\t    fn test_stacked_matrix_manual_1() {\n352\t        let ctx = TestFixture::<SC>::generate_proving_ctx(&InteractionsFixture11);\n353\t        let [send_trace, rcv_trace] = [0, 1]\n354\t            .map(|i| transport_matrix_h2d_col_major(&ctx.per_trace[i].1.common_main).unwrap());\n355\t        let l_skip = 2;\n356\t        let n_stack = 8;\n357\t        let (stacked_mat, _layout) =\n358\t            stacked_matrix(l_skip, n_stack, &[&rcv_trace, &send_trace]).unwrap();\n359\t        assert_eq!(stacked_mat.height(), 1 << (l_skip + n_stack));\n360\t        assert_eq!(stacked_mat.width(), 1);\n361\t        let stacked_h_mat =\n362\t            transport_matrix_d2h_col_major(&stacked_mat.to_evals(l_skip).unwrap()).unwrap();\n363\t        let mut expected = vec![F::ZERO; 1 << (l_skip + n_stack)];\n364\t        expected[..24].copy_from_slice(\n365\t            &[\n366\t                1, 3, 4, 2, 0, 545, 1, 0, 5, 4, 4, 5, 123, 889, 889, 456, 0, 3, 7, 546, 1, 5, 4,\n367\t                889,\n368\t            ]\n369\t            .map(F::from_u32),\n370\t        );\n371\t        assert_eq!(stacked_h_mat.values, expected);\n372\t    }\n373\t\n374\t    #[test]\n375\t    fn test_stacked_matrix_manual_strided_0() {\n376\t        let columns = [vec![1, 2, 3, 4], vec![5, 6], vec![7]]\n377\t            .map(|v| v.into_iter().map(F::from_u32).collect_vec());\n378\t        let mats = columns\n379\t            .into_iter()\n380\t            .map(|c| transport_matrix_h2d_col_major(&ColMajorMatrix::new(c, 1)).unwrap())\n381\t            .collect_vec();\n382\t        let mat_refs = mats.iter().collect_vec();\n383\t        let l_skip = 2;\n384\t        let (stacked_mat, _layout) = stacked_matrix(l_skip, 0, &mat_refs).unwrap();\n385\t        assert_eq!(stacked_mat.height(), 4);\n386\t        assert_eq!(stacked_mat.width(), 3);\n387\t        let stacked_h_mat =\n388\t            transport_matrix_d2h_col_major(&stacked_mat.to_evals(l_skip).unwrap()).unwrap();\n389\t        assert_eq!(\n390\t            stacked_h_mat.values,\n391\t            [1, 2, 3, 4, 5, 0, 6, 0, 7, 0, 0, 0]\n392\t                .map(F::from_u32)\n393\t                .to_vec()\n394\t        );\n395\t    }\n396\t\n397\t    #[test]\n398\t    fn test_stacked_matrix_manual_strided_1() {\n399\t        let columns = [vec![1, 2, 3, 4], vec![5, 6], vec![7]]\n400\t            .map(|v| v.into_iter().map(F::from_u32).collect_vec());\n401\t        let mats = columns\n402\t            .into_iter()\n403\t            .map(|c| transport_matrix_h2d_col_major(&ColMajorMatrix::new(c, 1)).unwrap())\n404\t            .collect_vec();\n405\t        let mat_refs = mats.iter().collect_vec();\n406\t        let l_skip = 3;\n407\t        let (stacked_mat, _layout) = stacked_matrix(l_skip, 0, &mat_refs).unwrap();\n408\t        assert_eq!(stacked_mat.height(), 8);\n409\t        assert_eq!(stacked_mat.width(), 3);\n410\t        let stacked_h_mat =\n411\t            transport_matrix_d2h_col_major(&stacked_mat.to_evals(l_skip).unwrap()).unwrap();\n412\t        assert_eq!(\n413\t            stacked_h_mat.values,\n414\t            [\n415\t                [1, 0, 2, 0, 3, 0, 4, 0],\n416\t                [5, 0, 0, 0, 6, 0, 0, 0],\n417\t                [7, 0, 0, 0, 0, 0, 0, 0]\n418\t            ]\n419\t            .into_iter()\n420\t            .flatten()\n421\t            .map(F::from_u32)\n422\t            .collect_vec()\n423\t        );\n424\t    }\n425\t}\n426\t"}]},"parent_tool_use_id":"toolu_0159hH4W4kt29erVnVmUDM6W","session_id":"f245fed0-0457-4d6a-9da2-744553774a6f","uuid":"bc7ca8e1-4b8c-4d4d-9c54-8590173e4a1f","timestamp":"2026-04-15T15:33:59.358Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TcjoZcLatHe3zfSBbHVBp6","type":"tool_result","content":"1\tuse std::array::from_fn;\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::{\n5\t    copy::{MemCopyD2H, MemCopyH2D},\n6\t    d_buffer::DeviceBuffer,\n7\t    memory_manager::MemTracker,\n8\t};\n9\tuse openvm_stark_backend::prover::MatrixDimensions;\n10\tuse p3_util::log2_strict_usize;\n11\tuse tracing::{info_span, instrument};\n12\t\n13\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n14\tuse crate::cuda::bn254_merkle_tree::Bn254Digest;\n15\tuse crate::{\n16\t    base::DeviceMatrix,\n17\t    cuda::{matrix::matrix_get_rows_fp_kernel, merkle_tree::query_digest_layers},\n18\t    hash_scheme::{GpuMerkleHash, Poseidon2MerkleHash},\n19\t    prelude::{Digest, DIGEST_SIZE, EF, F},\n20\t    MerkleTreeError,\n21\t};\n22\t\n23\t/// Trait for reconstructing a digest from a flat slice of F elements as\n24\t/// produced by the `query_digest_layers` CUDA kernel.\n25\t///\n26\t/// Both `Digest = [F; 8]` (BabyBear Poseidon2) and `Bn254Digest = [Bn254Scalar; 1]`\n27\t/// occupy exactly `DIGEST_SIZE * size_of::<F>()` = 32 bytes, so the same kernel\n28\t/// can be reused for both.\n29\tpub trait BatchQueryMerkle: Copy + Sized + 'static {\n30\t    /// Reconstruct one digest from `DIGEST_SIZE` consecutive F-valued words in `out`\n31\t    /// starting at index `base`.\n32\t    fn reconstruct_from_f(out: &[F], base: usize) -> Self;\n33\t}\n34\t\n35\timpl BatchQueryMerkle for Digest {\n36\t    fn reconstruct_from_f(out: &[F], base: usize) -> Self {\n37\t        from_fn(|i| out[base + i])\n38\t    }\n39\t}\n40\t\n41\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n42\timpl BatchQueryMerkle for Bn254Digest {\n43\t    fn reconstruct_from_f(out: &[F], base: usize) -> Self {\n44\t        // Safety: [F; DIGEST_SIZE] and Bn254Digest have the same size (32 bytes).\n45\t        const _: () =\n46\t            assert!(std::mem::size_of::<Bn254Digest>() == DIGEST_SIZE * std::mem::size_of::<F>());\n47\t        let f_arr: [F; DIGEST_SIZE] = from_fn(|i| out[base + i]);\n48\t        unsafe { std::ptr::read_unaligned(f_arr.as_ptr() as *const Bn254Digest) }\n49\t    }\n50\t}\n51\t\n52\tpub struct MerkleTreeGpu<F, Digest> {\n53\t    /// The matrix that is used to form the leaves of the Merkle tree, which are\n54\t    /// in turn hashed into the bottom digest layer.\n55\t    ///\n56\t    /// This matrix is optionally cached depending on the prover configuration:\n57\t    /// - Caching increases the peak GPU memory but avoids a recomputation of MLE eval-to-coeffs,\n58\t    ///   batch_expand, and forward NTT.\n59\t    /// - Not caching pays a performance penalty due to the above recomputation.\n60\t    pub(crate) backing_matrix: Option<DeviceMatrix<F>>,\n61\t    pub(crate) digest_layers: Vec<DeviceBuffer<Digest>>,\n62\t    pub(crate) rows_per_query: usize,\n63\t    pub(crate) root: Digest,\n64\t}\n65\t\n66\tpub trait MerkleTreeConstructor: GpuMerkleHash {\n67\t    fn new_merkle_tree(\n68\t        matrix: DeviceMatrix<F>,\n69\t        rows_per_query: usize,\n70\t        cache_backing_matrix: bool,\n71\t    ) -> Result<MerkleTreeGpu<F, Self::Digest>, MerkleTreeError>;\n72\t}\n73\t\n74\tpub trait MerkleProofQueryDigest: BatchQueryMerkle + Copy + Send + Sync + 'static {\n75\t    fn batch_query_merkle_proofs(\n76\t        trees: &[&MerkleTreeGpu<F, Self>],\n77\t        query_indices: &[usize],\n78\t    ) -> Result<Vec<Vec<Vec<Self>>>, MerkleTreeError>;\n79\t}\n80\t\n81\timpl<F, Digest> MerkleTreeGpu<F, Digest> {\n82\t    pub fn root(&self) -> Digest\n83\t    where\n84\t        Digest: Clone,\n85\t    {\n86\t        self.root.clone()\n87\t    }\n88\t\n89\t    pub fn query_stride(&self) -> usize {\n90\t        self.digest_layers[0].len()\n91\t    }\n92\t\n93\t    pub fn proof_depth(&self) -> usize {\n94\t        self.digest_layers.len() - 1\n95\t    }\n96\t}\n97\t\n98\t// Base field merkle tree — generic constructor\n99\timpl<D: Copy + Send + Sync + 'static> MerkleTreeGpu<F, D> {\n100\t    /// Build a Merkle tree using the given hash scheme `MH`.\n101\t    ///\n102\t    /// This is the primary constructor; `new()` is a convenience wrapper that\n103\t    /// fixes `MH = Poseidon2MerkleHash`.\n104\t    #[instrument(name = \"merkle_tree\", skip_all)]\n105\t    pub fn new_with_hash<MH: MerkleTreeConstructor<Digest = D>>(\n106\t        matrix: DeviceMatrix<F>,\n107\t        rows_per_query: usize,\n108\t        cache_backing_matrix: bool,\n109\t    ) -> Result<Self, MerkleTreeError> {\n110\t        MH::new_merkle_tree(matrix, rows_per_query, cache_backing_matrix)\n111\t    }\n112\t\n113\t    fn new_generic_with_hash<MH: GpuMerkleHash<Digest = D>>(\n114\t        matrix: DeviceMatrix<F>,\n115\t        rows_per_query: usize,\n116\t        cache_backing_matrix: bool,\n117\t    ) -> Result<Self, MerkleTreeError> {\n118\t        let mem = MemTracker::start(\"prover.merkle_tree\");\n119\t        let height = matrix.height();\n120\t        assert!(height.is_power_of_two());\n121\t        let k = log2_strict_usize(rows_per_query);\n122\t        assert!(\n123\t            rows_per_query <= height,\n124\t            \"rows_per_query ({rows_per_query}) must not exceed height ({height})\"\n125\t        );\n126\t        let query_stride = height / rows_per_query;\n127\t        let mut query_digest_layer = DeviceBuffer::<D>::with_capacity(query_stride);\n128\t        // SAFETY: query_digest_layer properly allocated\n129\t        unsafe {\n130\t            MH::compress_rows(\n131\t                &mut query_digest_layer,\n132\t                matrix.buffer(),\n133\t                matrix.width(),\n134\t                query_stride,\n135\t                k,\n136\t            )\n137\t            .map_err(MerkleTreeError::CompressingRowHashes)?;\n138\t        }\n139\t        // If not caching, drop the backing matrix at this point to save memory.\n140\t        let backing_matrix = cache_backing_matrix.then_some(matrix);\n141\t\n142\t        let mut digest_layers = vec![query_digest_layer];\n143\t        while digest_layers.last().unwrap().len() > 1 {\n144\t            let prev_layer = digest_layers.last().unwrap();\n145\t            let mut layer = DeviceBuffer::<D>::with_capacity(prev_layer.len() / 2);\n146\t            let layer_len = layer.len();\n147\t            let layer_idx = digest_layers.len();\n148\t            // SAFETY:\n149\t            // - `layer` is properly allocated with half the size of `prev_layer` and does not\n150\t            //   overlap with it.\n151\t            unsafe {\n152\t                MH::compress_layer(&mut layer, prev_layer, layer_len).map_err(|error| {\n153\t                    MerkleTreeError::AdjacentCompressLayer {\n154\t                        error,\n155\t                        layer: layer_idx,\n156\t                    }\n157\t                })?;\n158\t            }\n159\t            digest_layers.push(layer);\n160\t        }\n161\t        let d_root = digest_layers.last().unwrap();\n162\t        assert_eq!(d_root.len(), 1, \"Only one root is supported\");\n163\t        let root = d_root.to_host()?.pop().unwrap();\n164\t\n165\t        mem.emit_metrics();\n166\t        Ok(Self {\n167\t            backing_matrix,\n168\t            digest_layers,\n169\t            rows_per_query,\n170\t            root,\n171\t        })\n172\t    }\n173\t\n174\t    #[instrument(name = \"batch_open_rows\", skip_all)]\n175\t    pub fn batch_open_rows(\n176\t        backing_matrices: &[&DeviceMatrix<F>],\n177\t        query_indices: &[usize],\n178\t        query_stride: usize,\n179\t        rows_per_query: usize,\n180\t    ) -> Result<\n181\t        Vec<\n182\t            // per tree\n183\t            Vec<\n184\t                // per query index\n185\t                Vec<F>, // opened rows, concatenated for rows_per_query strided rows\n186\t            >,\n187\t        >,\n188\t        MerkleTreeError,\n189\t    > {\n190\t        let row_idxs = query_indices\n191\t            .iter()\n192\t            .flat_map(|&query_idx| {\n193\t                debug_assert!(query_idx < query_stride);\n194\t                (0..rows_per_query)\n195\t                    .map(move |row_offset| (row_offset * query_stride + query_idx) as u32)\n196\t            })\n197\t            .collect_vec();\n198\t        let d_row_idxs = row_idxs.to_device()?;\n199\t        // PERF[jpw]: I did not batch across trees into a single kernel call because widths are\n200\t        // different so it was inconvenient. Make a new kernel if slow.\n201\t        // NOTE: par_iter requires cross-stream waits, not worth the effort\n202\t        backing_matrices\n203\t            .iter()\n204\t            .enumerate()\n205\t            .map(|(matrix_idx, matrix)| {\n206\t                let d_out = DeviceBuffer::<F>::with_capacity(row_idxs.len() * matrix.width());\n207\t                // SAFETY:\n208\t                // - `output_rows` is allocated with row_idxs.len() * width\n209\t                // - row indices are within bounds\n210\t                unsafe {\n211\t                    matrix_get_rows_fp_kernel(\n212\t                        &d_out,\n213\t                        matrix.buffer(),\n214\t                        &d_row_idxs,\n215\t                        matrix.width() as u64,\n216\t                        matrix.height() as u64,\n217\t                        d_row_idxs.len() as u32,\n218\t                    )\n219\t                    .map_err(|error| MerkleTreeError::MatrixGetRows { error, matrix_idx })?;\n220\t                }\n221\t                let width = matrix.width();\n222\t                let out = info_span!(\"opened_rows_d2h\").in_scope(|| d_out.to_host())?;\n223\t                let opened_rows_per_query = out\n224\t                    .chunks_exact(rows_per_query * width)\n225\t                    .map(|rows| rows.to_vec())\n226\t                    .collect_vec();\n227\t                Ok(opened_rows_per_query)\n228\t            })\n229\t            .collect::<Result<Vec<_>, MerkleTreeError>>()\n230\t    }\n231\t}\n232\t\n233\timpl MerkleTreeConstructor for Poseidon2MerkleHash {\n234\t    fn new_merkle_tree(\n235\t        matrix: DeviceMatrix<F>,\n236\t        rows_per_query: usize,\n237\t        cache_backing_matrix: bool,\n238\t    ) -> Result<MerkleTreeGpu<F, Self::Digest>, MerkleTreeError> {\n239\t        MerkleTreeGpu::<F, Self::Digest>::new_generic_with_hash::<Self>(\n240\t            matrix,\n241\t            rows_per_query,\n242\t            cache_backing_matrix,\n243\t        )\n244\t    }\n245\t}\n246\t\n247\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n248\timpl MerkleTreeConstructor for crate::hash_scheme::Bn254Poseidon2MerkleHash {\n249\t    fn new_merkle_tree(\n250\t        matrix: DeviceMatrix<F>,\n251\t        rows_per_query: usize,\n252\t        cache_backing_matrix: bool,\n253\t    ) -> Result<MerkleTreeGpu<F, Self::Digest>, MerkleTreeError> {\n254\t        MerkleTreeGpu::<F, Self::Digest>::new_generic_with_hash::<Self>(\n255\t            matrix,\n256\t            rows_per_query,\n257\t            cache_backing_matrix,\n258\t        )\n259\t    }\n260\t}\n261\t\n262\t// Base field merkle tree — Poseidon2 default constructor\n263\timpl MerkleTreeGpu<F, Digest> {\n264\t    /// Build a Merkle tree using the default Poseidon2 hash.\n265\t    ///\n266\t    /// Equivalent to `new_with_hash::<Poseidon2MerkleHash>(...)`.\n267\t    pub fn new(\n268\t        matrix: DeviceMatrix<F>,\n269\t        rows_per_query: usize,\n270\t        cache_backing_matrix: bool,\n271\t    ) -> Result<Self, MerkleTreeError> {\n272\t        Self::new_with_hash::<Poseidon2MerkleHash>(matrix, rows_per_query, cache_backing_matrix)\n273\t    }\n274\t}\n275\t\n276\t// Base field merkle tree — generic batch query (works for any BatchQueryMerkle digest)\n277\timpl<D: BatchQueryMerkle + Send + Sync + 'static> MerkleTreeGpu<F, D> {\n278\t    fn batch_query_proofs(\n279\t        trees: &[&Self],\n280\t        query_indices: &[usize],\n281\t    ) -> Result<Vec<Vec<Vec<D>>>, MerkleTreeError> {\n282\t        // The kernel treats each layer as a separate array and does parallel accesses;\n283\t        // we lay out all the layer pointers flattened into a vec.\n284\t        let num_trees = trees.len();\n285\t        let num_queries = query_indices.len();\n286\t        let depth = trees[0].proof_depth();\n287\t        debug_assert!(\n288\t            trees.iter().all(|tree| tree.proof_depth() == depth),\n289\t            \"Merkle trees don't have same depth\"\n290\t        );\n291\t        let layers_ptr = trees\n292\t            .iter()\n293\t            .flat_map(|tree| {\n294\t                // skip root layer [depth]\n295\t                tree.digest_layers\n296\t                    .iter()\n297\t                    .take(depth)\n298\t                    .map(|layer| layer.as_ptr() as u64)\n299\t            })\n300\t            .collect_vec();\n301\t        let d_layers_ptr = layers_ptr.to_device()?;\n302\t        debug_assert_eq!(d_layers_ptr.len(), num_trees * depth);\n303\t\n304\t        // [query_idx] is the top level grouping\n305\t        let indices = query_indices\n306\t            .iter()\n307\t            .flat_map(|&index| {\n308\t                (0..num_trees).flat_map(move |tree_idx| {\n309\t                    (0..depth).map(move |layer_idx| {\n310\t                        debug_assert!(index < trees[tree_idx].query_stride());\n311\t                        ((index >> layer_idx) ^ 1) as u64\n312\t                    })\n313\t                })\n314\t            })\n315\t            .collect_vec();\n316\t        let d_indices = indices.to_device()?;\n317\t        debug_assert_eq!(d_indices.len(), d_layers_ptr.len() * num_queries);\n318\t\n319\t        let mut d_out =\n320\t            DeviceBuffer::<F>::with_capacity(d_layers_ptr.len() * num_queries * DIGEST_SIZE);\n321\t        // SAFETY:\n322\t        // - d_out has size num_trees * depth * num_queries * DIGEST_SIZE in `F` elements\n323\t        // - d_layers_ptr is size `num_trees * depth` device pointers\n324\t        // - d_indices is size `num_trees * depth * num_queries` indices for merkle proof sibling\n325\t        //   indices\n326\t        // - Both Digest=[F;8] and Bn254Digest=[Bn254Scalar;1] are 32 bytes == DIGEST_SIZE * 4, so\n327\t        //   the same kernel correctly copies the raw bytes for either digest type.\n328\t        unsafe {\n329\t            query_digest_layers(\n330\t                &mut d_out,\n331\t                &d_layers_ptr,\n332\t                &d_indices,\n333\t                num_queries as u64,\n334\t                d_layers_ptr.len() as u64,\n335\t            )\n336\t            .map_err(MerkleTreeError::QueryDigestLayers)?;\n337\t        }\n338\t        let out = d_out.to_host()?;\n339\t        // Chunk up the array using D::reconstruct_from_f\n340\t        let res = (0..num_trees)\n341\t            .map(|tree_idx| {\n342\t                (0..num_queries)\n343\t                    .map(|query_idx| {\n344\t                        (0..depth)\n345\t                            .map(|layer_idx| {\n346\t                                let base =\n347\t                                    (query_idx * num_trees * depth + tree_idx * depth + layer_idx)\n348\t                                        * DIGEST_SIZE;\n349\t                                D::reconstruct_from_f(&out, base)\n350\t                            })\n351\t                            .collect_vec()\n352\t                    })\n353\t                    .collect_vec()\n354\t            })\n355\t            .collect_vec();\n356\t        Ok(res)\n357\t    }\n358\t\n359\t    /// Batch queries multiple `trees` at _the same_ `query_indices` for merkle proofs.\n360\t    ///\n361\t    /// # Assumptions\n362\t    /// - All `trees` have the same depth.\n363\t    pub fn batch_query_merkle_proofs(\n364\t        trees: &[&Self],\n365\t        query_indices: &[usize],\n366\t    ) -> Result<\n367\t        Vec<\n368\t            // per tree\n369\t            Vec<\n370\t                // per query index\n371\t                Vec<D>, // merkle proof\n372\t            >,\n373\t        >,\n374\t        MerkleTreeError,\n375\t    >\n376\t    where\n377\t        D: MerkleProofQueryDigest,\n378\t    {\n379\t        D::batch_query_merkle_proofs(trees, query_indices)\n380\t    }\n381\t}\n382\t\n383\timpl MerkleProofQueryDigest for Digest {\n384\t    fn batch_query_merkle_proofs(\n385\t        trees: &[&MerkleTreeGpu<F, Self>],\n386\t        query_indices: &[usize],\n387\t    ) -> Result<Vec<Vec<Vec<Self>>>, MerkleTreeError> {\n388\t        MerkleTreeGpu::<F, Self>::batch_query_proofs(trees, query_indices)\n389\t    }\n390\t}\n391\t\n392\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n393\timpl MerkleProofQueryDigest for Bn254Digest {\n394\t    fn batch_query_merkle_proofs(\n395\t        trees: &[&MerkleTreeGpu<F, Self>],\n396\t        query_indices: &[usize],\n397\t    ) -> Result<Vec<Vec<Vec<Self>>>, MerkleTreeError> {\n398\t        MerkleTreeGpu::<F, Self>::batch_query_proofs(trees, query_indices)\n399\t    }\n400\t}\n401\t\n402\t// Extension field merkle tree — generic constructor\n403\timpl<D: Copy + Send + Sync + 'static> MerkleTreeGpu<EF, D> {\n404\t    /// Build a Merkle tree from an extension-field matrix using hash scheme `MH`.\n405\t    #[instrument(name = \"merkle_tree_ext\", skip_all)]\n406\t    pub fn new_with_hash<MH: GpuMerkleHash<Digest = D>>(\n407\t        matrix: DeviceMatrix<EF>,\n408\t        rows_per_query: usize,\n409\t        cache_backing_matrix: bool,\n410\t    ) -> Result<Self, MerkleTreeError> {\n411\t        let height = matrix.height();\n412\t        assert!(height.is_power_of_two());\n413\t        let k = log2_strict_usize(rows_per_query);\n414\t        assert!(\n415\t            rows_per_query <= height,\n416\t            \"rows_per_query ({rows_per_query}) must not exceed height ({height})\"\n417\t        );\n418\t        let query_stride = height / rows_per_query;\n419\t        let mut query_digest_layer = DeviceBuffer::<D>::with_capacity(query_stride);\n420\t        // SAFETY: query_digest_layer properly allocated\n421\t        unsafe {\n422\t            MH::compress_rows_ext(\n423\t                &mut query_digest_layer,\n424\t                matrix.buffer(),\n425\t                matrix.width(),\n426\t                query_stride,\n427\t                k,\n428\t            )\n429\t            .map_err(MerkleTreeError::CompressingRowHashesExt)?;\n430\t        }\n431\t        // If not caching, drop the backing matrix at this point to save memory.\n432\t        let backing_matrix = cache_backing_matrix.then_some(matrix);\n433\t\n434\t        let mut digest_layers = vec![query_digest_layer];\n435\t        while digest_layers.last().unwrap().len() > 1 {\n436\t            let prev_layer = digest_layers.last().unwrap();\n437\t            let mut layer = DeviceBuffer::<D>::with_capacity(prev_layer.len() / 2);\n438\t            let layer_len = layer.len();\n439\t            let layer_idx = digest_layers.len();\n440\t            // SAFETY:\n441\t            // - `layer` is properly allocated with half the size of `prev_layer` and does not\n442\t            //   overlap with it.\n443\t            unsafe {\n444\t                MH::compress_layer(&mut layer, prev_layer, layer_len).map_err(|error| {\n445\t                    MerkleTreeError::AdjacentCompressLayer {\n446\t                        error,\n447\t                        layer: layer_idx,\n448\t                    }\n449\t                })?;\n450\t            }\n451\t            digest_layers.push(layer);\n452\t        }\n453\t        let d_root = digest_layers.last().unwrap();\n454\t        assert_eq!(d_root.len(), 1, \"Only one root is supported\");\n455\t        let root = d_root.to_host()?.pop().unwrap();\n456\t\n457\t        Ok(Self {\n458\t            backing_matrix,\n459\t            digest_layers,\n460\t            rows_per_query,\n461\t            root,\n462\t        })\n463\t    }\n464\t}\n465\t\n466\t// Extension field merkle tree — Poseidon2 default constructor\n467\timpl MerkleTreeGpu<EF, Digest> {\n468\t    /// Build a Merkle tree from an extension-field matrix using Poseidon2.\n469\t    ///\n470\t    /// NOTE: currently unused because we transpose `DeviceMatrix<EF>` to\n471\t    /// `DeviceMatrix<F>` beforehand in our use cases.\n472\t    pub fn new(\n473\t        matrix: DeviceMatrix<EF>,\n474\t        rows_per_query: usize,\n475\t        cache_backing_matrix: bool,\n476\t    ) -> Result<Self, MerkleTreeError> {\n477\t        Self::new_with_hash::<Poseidon2MerkleHash>(matrix, rows_per_query, cache_backing_matrix)\n478\t    }\n479\t}\n480\t"}]},"parent_tool_use_id":"toolu_0159hH4W4kt29erVnVmUDM6W","session_id":"f245fed0-0457-4d6a-9da2-744553774a6f","uuid":"f5af1c8c-e89b-4e02-a8bb-365a45831a3e","timestamp":"2026-04-15T15:33:59.358Z"}
