{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P5U4JVvBBPZCfMDn77e38u","type":"tool_result","content":"1022\t        // Phase 1: Build work items with pre-computed buffer sizes (main thread, pure CPU)\n1023\t        let per_thread_temp_bytes = self.memory_limit_bytes / NUM_ROUND0_STREAMS.max(1);\n1024\t        let mut work_items: Vec<Round0AirWorkItem<HS>> = izip!(\n1025\t            &ctx.per_trace,\n1026\t            &self.n_per_trace,\n1027\t            &selectors_base,\n1028\t            &self.public_values_per_trace,\n1029\t            &self.eq_3b_per_trace,\n1030\t        )\n1031\t        .enumerate()\n1032\t        .map(|(trace_idx, ((air_idx, air_ctx), &n, sel, pv, eq3b))| {\n1033\t            let single_pk = &self.pk.per_air[*air_idx];\n1034\t            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n1035\t            let n_lift = n.max(0) as usize;\n1036\t            let skip_domain = 1u32 << l_skip;\n1037\t            let num_x = 1u32 << n_lift;\n1038\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1) as u32;\n1039\t            let num_cosets_logup = local_constraint_deg as u32;\n1040\t\n1041\t            // Pre-compute zerocheck buffer sizes\n1042\t            let zc_buffer_size = single_pk.other_data.zerocheck_round0.inner.buffer_size;\n1043\t            let zc_intermed_cap = if num_cosets_zc > 0 && !single_pk.vk.symbolic_constraints.constraints.constraint_idx.is_empty() {\n1044\t                unsafe {\n1045\t                    _zerocheck_r0_intermediates_buffer_size(\n1046\t                        zc_buffer_size, skip_domain, num_x, num_cosets_zc, per_thread_temp_bytes,\n1047\t                    )\n1048\t                }\n1049\t            } else {\n1050\t                0\n1051\t            };\n1052\t            let zc_temp_sums_cap = if num_cosets_zc > 0 && !single_pk.vk.symbolic_constraints.constraints.constraint_idx.is_empty() {\n1053\t                unsafe {\n1054\t                    _zerocheck_r0_temp_sums_buffer_size(\n1055\t                        zc_buffer_size, skip_domain, num_x, num_cosets_zc, per_thread_temp_bytes,\n1056\t                    )\n1057\t                }\n1058\t            } else {\n1059\t                0\n1060\t            };\n1061\t\n1062\t            // Pre-compute logup buffer sizes (using logup_round0_buffer_size from Step 1)\n1063\t            let logup_buffer_size = single_pk.other_data.logup_round0_buffer_size;\n1064\t            let has_interactions = !eq3b.is_empty();\n1065\t            let logup_intermed_cap = if has_interactions && logup_buffer_size > 0 {\n1066\t                unsafe {\n1067\t                    _logup_r0_intermediates_buffer_size(\n1068\t                        logup_buffer_size, skip_domain, num_x, num_cosets_logup, per_thread_temp_bytes,\n1069\t                    )\n1070\t                }\n1071\t            } else {\n1072\t                0\n1073\t            };\n1074\t            let logup_temp_sums_cap = if has_interactions && logup_buffer_size > 0 {\n1075\t                unsafe {\n1076\t                    _logup_r0_temp_sums_buffer_size(\n1077\t                        logup_buffer_size, skip_domain, num_x, num_cosets_logup, per_thread_temp_bytes,\n1078\t                    )\n1079\t                }\n1080\t            } else {\n1081\t                0\n1082\t            };\n1083\t\n1084\t            Round0AirWorkItem {\n1085\t                trace_idx,\n1086\t                single_pk,\n1087\t                n,\n1088\t                selectors_cube: sel,\n1089\t                public_values: pv,\n1090\t                eq_3bs: eq3b,\n1091\t                cached_mains: &air_ctx.cached_mains,\n1092\t                common_main: &air_ctx.common_main,\n1093\t                eq_xis: &self.eq_xis,\n1094\t                d_lambda_pows,\n1095\t                beta_pows: &self.beta_pows,\n1096\t                l_skip,\n1097\t                constraint_degree: self.constraint_degree,\n1098\t                xi: &self.xi,\n1099\t                max_temp_bytes: per_thread_temp_bytes,\n1100\t                zc_intermed_cap,\n1101\t                zc_temp_sums_cap,\n1102\t                logup_intermed_cap,\n1103\t                logup_temp_sums_cap,\n1104\t                zc_batch_offset: 0,    // set after max_poly_len is computed\n1105\t                numer_batch_offset: 0,\n1106\t                denom_batch_offset: 0,\n1107\t            }\n1108\t        })\n1109\t        .collect();\n1110\t\n1111\t        // Sort by descending height for better load balance across thread chunks.\n1112\t        work_items.sort_by(|a, b| b.common_main.height().cmp(&a.common_main.height()));\n1113\t\n1114\t        // Pre-compute polynomial extraction transform matrices per unique constraint degree.\n1115\t        let skip_domain = 1usize << l_skip;\n1116\t        let mut extract_tables: FxHashMap<usize, Round0ExtractTables> = FxHashMap::default();\n1117\t        for w in &work_items {\n1118\t            let d = w.single_pk.vk.max_constraint_degree as usize;\n1119\t            if !extract_tables.contains_key(&d) {\n1120\t                extract_tables.insert(d, compute_round0_extract_tables(d, l_skip)?);\n1121\t            }\n1122\t        }\n1123\t\n1124\t        // Pre-allocate device batch polynomial array.\n1125\t        // All polynomial coefficients are written here by GPU extraction kernels,\n1126\t        // then copied to host in a single D2H transfer.\n1127\t        let max_poly_len = work_items\n1128\t            .iter()\n1129\t            .map(|w| {\n1130\t                let d = w.single_pk.vk.max_constraint_degree as usize;\n1131\t                let zc_len = sumcheck_round0_deg(l_skip, d) + 1;\n1132\t                let logup_len = d * skip_domain;\n1133\t                zc_len.max(logup_len)\n1134\t            })\n1135\t            .max()\n1136\t            .unwrap_or(0);\n1137\t\n1138\t        let batch_total = 3 * num_present_airs * max_poly_len;\n1139\t        let d_batch_array = if batch_total > 0 {\n1140\t            let buf = DeviceBuffer::<EF>::with_capacity(batch_total);\n1141\t            buf.fill_zero().map_err(MemCopyError::from)?;\n1142\t            buf\n1143\t        } else {\n1144\t            DeviceBuffer::new()\n1145\t        };\n1146\t\n1147\t        // Set per-AIR batch offsets.\n1148\t        for w in &mut work_items {\n1149\t            w.zc_batch_offset = (2 * num_present_airs + w.trace_idx) * max_poly_len;\n1150\t            w.numer_batch_offset = (2 * w.trace_idx) * max_poly_len;\n1151\t            w.denom_batch_offset = (2 * w.trace_idx + 1) * max_poly_len;\n1152\t        }\n1153\t\n1154\t        // Track per-AIR polynomial lengths for host-side reconstruction.\n1155\t        let poly_lens: Vec<(usize, usize, usize)> = {\n1156\t            // Build a map from trace_idx to (zc_len, logup_len)\n1157\t            let mut lens = vec![(0usize, 0usize, 0usize); num_present_airs];\n1158\t            for w in &work_items {\n1159\t                let d = w.single_pk.vk.max_constraint_degree as usize;\n1160\t                let has_constraints = d > 1\n1161\t                    && !w\n1162\t                        .single_pk\n1163\t                        .vk\n1164\t                        .symbolic_constraints\n1165\t                        .constraints\n1166\t                        .constraint_idx\n1167\t                        .is_empty();\n1168\t                let has_interactions = !w.eq_3bs.is_empty();\n1169\t                let zc_len = if has_constraints {\n1170\t                    sumcheck_round0_deg(l_skip, d) + 1\n1171\t                } else {\n1172\t                    0\n1173\t                };\n1174\t                let logup_len = if has_interactions { d * skip_domain } else { 0 };\n1175\t                lens[w.trace_idx] = (zc_len, logup_len, logup_len);\n1176\t            }\n1177\t            lens\n1178\t        };\n1179\t\n1180\t        // Pre-compute buffer sizes for pre-allocation using a percentile threshold.\n1181\t        // Using the max would require enormous buffers (driven by a few large AIRs),\n1182\t        // causing GPU memory pressure that degrades all phases. The 95th percentile\n1183\t        // covers 95%+ of AIRs while keeping total allocation manageable. The few\n1184\t        // large AIRs above the threshold fall back to dynamic allocation.\n1185\t        let percentile_idx = |n: usize| -> usize { (n * 95 / 100).min(n.saturating_sub(1)) };\n1186\t        let (max_zc_intermed, max_zc_temp_sums, max_logup_intermed, max_logup_temp_sums) = {\n1187\t            let n = work_items.len();\n1188\t            let mut zc_i: Vec<usize> = work_items.iter().map(|w| w.zc_intermed_cap).collect();\n1189\t            let mut zc_t: Vec<usize> = work_items.iter().map(|w| w.zc_temp_sums_cap).collect();\n1190\t            let mut li: Vec<usize> = work_items.iter().map(|w| w.logup_intermed_cap).collect();\n1191\t            let mut lt: Vec<usize> = work_items.iter().map(|w| w.logup_temp_sums_cap).collect();\n1192\t            zc_i.sort_unstable();\n1193\t            zc_t.sort_unstable();\n1194\t            li.sort_unstable();\n1195\t            lt.sort_unstable();\n1196\t            let idx = percentile_idx(n);\n1197\t            (zc_i[idx], zc_t[idx], li[idx], lt[idx])\n1198\t        };\n1199\t\n1200\t        // Barrier: ensure all prior GPU work (trace uploads, pk data, selectors)\n1201\t        // is visible to worker thread streams.\n1202\t        current_stream_sync().map_err(MemCopyError::from)?;\n1203\t\n1204\t        // Phase 2: Process AIRs in parallel across N OS threads.\n1205\t        // Only use multi-threading when there are enough AIRs to benefit from concurrent\n1206\t        // kernel execution. With few large AIRs (e.g., APC 0 has ~20 per segment), each\n1207\t        // kernel already saturates the GPU and multi-threading adds memory pool overhead.\n1208\t        let mut num_threads = if work_items.len() >= 100 {\n1209\t            NUM_ROUND0_STREAMS.min(work_items.len())\n1210\t        } else {\n1211\t            1\n1212\t        };\n1213\t\n1214\t        // Memory budget check: reduce num_threads if pre-allocation would exceed budget.\n1215\t        let per_thread_bytes = max_zc_intermed * size_of::<F>()\n1216\t            + max_zc_temp_sums * size_of::<EF>()\n1217\t            + max_logup_intermed * size_of::<F>()\n1218\t            + max_logup_temp_sums * size_of::<Frac<EF>>();\n1219\t        while num_threads > 1 && num_threads * per_thread_bytes > 2_000_000_000 {\n1220\t            num_threads /= 2;\n1221\t            tracing::warn!("}]},"parent_tool_use_id":"toolu_01RS5ZqxNfusht1ytueLXki3","session_id":"f245fed0-0457-4d6a-9da2-744553774a6f","uuid":"ab7e0c1f-c25b-43e0-824b-9f30a51b1869","timestamp":"2026-04-15T17:01:19.096Z"}
