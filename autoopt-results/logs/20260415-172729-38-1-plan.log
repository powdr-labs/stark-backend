{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UzhfeJcGju6Y3xMqsJGDJt","type":"tool_result","content":"922\t    fn sumcheck_uni_round0_polys(\n923\t        &mut self,\n924\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n925\t        lambda: EF,\n926\t    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n927\t        self.mem\n928\t            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n929\t        self.mem.reset_peak();\n930\t        let n_logup = self.n_logup;\n931\t        let l_skip = self.l_skip;\n932\t        let xi = &self.xi;\n933\t        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n934\t        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n935\t            h_lambda_pows.to_device()?\n936\t        } else {\n937\t            DeviceBuffer::new()\n938\t        });\n939\t        // Precompute lambda combinations for all AIRs with monomials\n940\t        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n941\t        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n942\t            if air_pk.other_data.zerocheck_monomials.is_some() {\n943\t                self.lambda_combinations[air_idx] = Some(\n944\t                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n945\t                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n946\t                );\n947\t            }\n948\t        }\n949\t        let num_present_airs = ctx.per_trace.len();\n950\t        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n951\t\n952\t        self.eq_3b_per_trace = ctx\n953\t            .per_trace\n954\t            .iter()\n955\t            .enumerate()\n956\t            .map(|(trace_idx, (air_idx, _))| {\n957\t                let vk = &self.pk.per_air[*air_idx].vk;\n958\t                let num_interactions = vk.num_interactions();\n959\t                if num_interactions > 0 {\n960\t                    let n = self.n_per_trace[trace_idx];\n961\t                    let n_lift = n.max(0) as usize;\n962\t                    let mut b_vec = vec![F::ZERO; n_logup - n_lift];\n963\t                    let mut weights = Vec::with_capacity(num_interactions);\n964\t                    for interaction_idx in 0..num_interactions {\n965\t                        let stacked_idx = self\n966\t                            .interactions_layout\n967\t                            .get(trace_idx, interaction_idx)\n968\t                            .unwrap()\n969\t                            .row_idx;\n970\t                        let mut b_int = stacked_idx >> (l_skip + n_lift);\n971\t                        for bit in &mut b_vec {\n972\t                            *bit = F::from_bool(b_int & 1 == 1);\n973\t                            b_int >>= 1;\n974\t                        }\n975\t                        let weight =\n976\t                            eval_eq_mle(&self.xi[l_skip + n_lift..l_skip + n_logup], &b_vec);\n977\t                        weights.push(weight);\n978\t                    }\n979\t                    weights\n980\t                } else {\n981\t                    vec![]\n982\t                }\n983\t            })\n984\t            .collect_vec();\n985\t        // PERF[jpw]: we could also build the layers for different n in a transposed way using\n986\t        // eq_nonoverlapping_stage_ext, which is more memory efficient\n987\t        for &n in &self.n_per_trace {\n988\t            let n_lift = n.max(0) as usize;\n989\t            if let Entry::Vacant(entry) = self.eq_xis.entry(n_lift) {\n990\t                let layers =\n991\t                    EqEvalLayers::new_rev(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n992\t                        .map_err(LogupZerocheckError::EqEvalLayers)?;\n993\t                entry.insert(layers);\n994\t            }\n995\t        }\n996\t\n997\t        self.sels_per_trace_base = self\n998\t            .n_per_trace\n999\t            .iter()\n1000\t            .map(|&n| {\n1001\t                let n_lift = n.max(0) as usize;\n1002\t                let height = 1 << n_lift;\n1003\t                let mut cols = F::zero_vec(3 * height);\n1004\t                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n1005\t                cols[0] = F::ONE; // is_first\n1006\t                cols[2 * height + height - 1] = F::ONE; // is_last\n1007\t                let d_cols = cols.to_device()?;\n1008\t                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n1009\t            })\n1010\t            .collect::<Result<Vec<_>, MemCopyError>>()?;\n1011\t\n1012\t        let selectors_base = self.sels_per_trace_base.clone();\n1013\t\n1014\t        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n1015\t        // present AIR\n1016\t        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n1017\t        let d_lambda_pows = self\n1018\t            .lambda_pows\n1019\t            .as_ref()\n1020\t            .expect(\"lambda powers must be set before round-0 evaluation\");\n1021\t\n1022\t        // Phase 1: Build work items with pre-computed buffer sizes (main thread, pure CPU)\n1023\t        let per_thread_temp_bytes = self.memory_limit_bytes / NUM_ROUND0_STREAMS.max(1);\n1024\t        let mut work_items: Vec<Round0AirWorkItem<HS>> = izip!(\n1025\t            &ctx.per_trace,\n1026\t            &self.n_per_trace,\n1027\t            &selectors_base,\n1028\t            &self.public_values_per_trace,\n1029\t            &self.eq_3b_per_trace,\n1030\t        )\n1031\t        .enumerate()\n1032\t        .map(|(trace_idx, ((air_idx, air_ctx), &n, sel, pv, eq3b))| {\n1033\t            let single_pk = &self.pk.per_air[*air_idx];\n1034\t            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n1035\t            let n_lift = n.max(0) as usize;\n1036\t            let skip_domain = 1u32 << l_skip;\n1037\t            let num_x = 1u32 << n_lift;\n1038\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1) as u32;\n1039\t            let num_cosets_logup = local_constraint_deg as u32;\n1040\t\n1041\t            // Pre-compute zerocheck buffer sizes\n1042\t            let zc_buffer_size = single_pk.other_data.zerocheck_round0.inner.buffer_size;\n1043\t            let zc_intermed_cap = if num_cosets_zc > 0 && !single_pk.vk.symbolic_constraints.constraints.constraint_idx.is_empty() {\n1044\t                unsafe {\n1045\t                    _zerocheck_r0_intermediates_buffer_size(\n1046\t                        zc_buffer_size, skip_domain, num_x, num_cosets_zc, per_thread_temp_bytes,\n1047\t                    )\n1048\t                }\n1049\t            } else {\n1050\t                0\n1051\t            };\n1052\t            let zc_temp_sums_cap = if num_cosets_zc > 0 && !single_pk.vk.symbolic_constraints.constraints.constraint_idx.is_empty() {\n1053\t                unsafe {\n1054\t                    _zerocheck_r0_temp_sums_buffer_size(\n1055\t                        zc_buffer_size, skip_domain, num_x, num_cosets_zc, per_thread_temp_bytes,\n1056\t                    )\n1057\t                }\n1058\t            } else {\n1059\t                0\n1060\t            };\n1061\t\n1062\t            // Pre-compute logup buffer sizes (using logup_round0_buffer_size from Step 1)\n1063\t            let logup_buffer_size = single_pk.other_data.logup_round0_buffer_size;\n1064\t            let has_interactions = !eq3b.is_empty();\n1065\t            let logup_intermed_cap = if has_interactions && logup_buffer_size > 0 {\n1066\t                unsafe {\n1067\t                    _logup_r0_intermediates_buffer_size(\n1068\t                        logup_buffer_size, skip_domain, num_x, num_cosets_logup, per_thread_temp_bytes,\n1069\t                    )\n1070\t                }\n1071\t            } else {\n1072\t                0\n1073\t            };\n1074\t            let logup_temp_sums_cap = if has_interactions && logup_buffer_size > 0 {\n1075\t                unsafe {\n1076\t                    _logup_r0_temp_sums_buffer_size(\n1077\t                        logup_buffer_size, skip_domain, num_x, num_cosets_logup, per_thread_temp_bytes,\n1078\t                    )\n1079\t                }\n1080\t            } else {\n1081\t                0\n1082\t            };\n1083\t\n1084\t            Round0AirWorkItem {\n1085\t                trace_idx,\n1086\t                single_pk,\n1087\t                n,\n1088\t                selectors_cube: sel,\n1089\t                public_values: pv,\n1090\t                eq_3bs: eq3b,\n1091\t                cached_mains: &air_ctx.cached_mains,\n1092\t                common_main: &air_ctx.common_main,\n1093\t                eq_xis: &self.eq_xis,\n1094\t                d_lambda_pows,\n1095\t                beta_pows: &self.beta_pows,\n1096\t                l_skip,\n1097\t                constraint_degree: self.constraint_degree,\n1098\t                xi: &self.xi,\n1099\t                max_temp_bytes: per_thread_temp_bytes,\n1100\t                zc_intermed_cap,\n1101\t                zc_temp_sums_cap,\n1102\t                logup_intermed_cap,\n1103\t                logup_temp_sums_cap,\n1104\t                zc_batch_offset: 0,    // set after max_poly_len is computed\n1105\t                numer_batch_offset: 0,\n1106\t                denom_batch_offset: 0,\n1107\t            }\n1108\t        })\n1109\t        .collect();\n1110\t\n1111\t        // Sort by descending height for better load balance across thread chunks.\n1112\t        work_items.sort_by(|a, b| b.common_main.height().cmp(&a.common_main.height()));\n1113\t\n1114\t        // Pre-compute polynomial extraction transform matrices per unique constraint degree.\n1115\t        let skip_domain = 1usize << l_skip;\n1116\t        let mut extract_tables: FxHashMap<usize, Round0ExtractTables> = FxHashMap::defau