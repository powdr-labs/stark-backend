              l_skip,\n1490\t                        &self.d_omega_skip_pows,\n1491\t                        trace,\n1492\t                        &d_inv_lagrange_denoms_r0,\n1493\t                        need_rot,\n1494\t                    )?;\n1495\t                    results.push(folded);\n1496\t                }\n1497\t\n1498\t                // Common main\n1499\t                let trace = &air_ctx.common_main;\n1500\t                let folded = fold_ple_evals_rotate(\n1501\t                    l_skip,\n1502\t                    &self.d_omega_skip_pows,\n1503\t                    trace,\n1504\t                    &d_inv_lagrange_denoms_r0,\n1505\t                    need_rot,\n1506\t                )?;\n1507\t                mem_limit = mem_limit.saturating_sub(folded.buffer().len() * size_of::<EF>());\n1508\t                results.push(folded);\n1509\t\n1510\t                Ok(results)\n1511\t            })\n1512\t            .collect::<Result<Vec<_>, FoldPleError>>()?;\n1513\t        if self.save_memory {\n1514\t            self.memory_limit_bytes = mem_limit;\n1515\t        }\n1516\t\n1517\t        // GPU folding for sels_per_trace (rotate=false, only need offset=0)\n1518\t        self.sels_per_trace = std::mem::take(&mut self.sels_per_trace_base)\n1519\t            .into_iter()\n1520\t            .enumerate()\n1521\t            .map(|(trace_idx, selectors_cube)| {\n1522\t                let n = self.n_per_trace[trace_idx];\n1523\t                let num_x = selectors_cube.height();\n1524\t                debug_assert_eq!(num_x, 1 << n.max(0));\n1525\t                debug_assert_eq!(selectors_cube.width(), 3);\n1526\t                let (l, r) = if n.is_negative() {\n1527\t                    (\n1528\t                        l_skip.wrapping_add_signed(n),\n1529\t                        r_0.exp_power_of_2(-n as usize),\n1530\t                    )\n1531\t                } else {\n1532\t                    (l_skip, r_0)\n1533\t                };\n1534\t