{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016Sn4pkQJspnEftANKXtihc","type":"tool_result","content":"1\t#include \"codec.cuh\"\n2\t#include \"eval_ctx.cuh\"\n3\t#include \"frac_ext.cuh\"\n4\t#include \"launcher.cuh\"\n5\t#include \"sumcheck.cuh\"\n6\t\n7\t#include <algorithm>\n8\t#include <cassert>\n9\t#include <cstdint>\n10\t#include <stdio.h>\n11\t#include <vector_types.h>\n12\t\n13\tnamespace logup_zerocheck_mle {\n14\t\n15\tstruct ZerocheckCtx {\n16\t    EvalCoreCtx eval_ctx;\n17\t    FpExt *__restrict__ d_intermediates;\n18\t    uint32_t num_y;\n19\t    const FpExt *__restrict__ d_eq_xi;\n20\t    const Rule *__restrict__ d_rules;\n21\t    size_t rules_len;\n22\t    const size_t *__restrict__ d_used_nodes;\n23\t    size_t used_nodes_len;\n24\t    uint32_t buffer_size;\n25\t};\n26\t\n27\tstruct LogupCtx {\n28\t    EvalCoreCtx eval_ctx;\n29\t    FpExt *__restrict__ d_intermediates;\n30\t    uint32_t num_y;\n31\t    const FpExt *__restrict__ d_eq_xi;\n32\t    const FpExt *__restrict__ d_challenges;\n33\t    const FpExt *__restrict__ d_eq_3bs;\n34\t    const Rule *__restrict__ d_rules;\n35\t    size_t rules_len;\n36\t    const size_t *__restrict__ d_used_nodes;\n37\t    const uint32_t *__restrict__ d_pair_idxs;\n38\t    size_t used_nodes_len;\n39\t    uint32_t buffer_size;\n40\t};\n41\t\n42\t// Local context for device use only\n43\tstruct EvalCtx {\n44\t    const FpExt *__restrict__ d_selectors;\n45\t    const MainMatrixPtrs<FpExt> d_preprocessed;\n46\t    const MainMatrixPtrs<FpExt> *__restrict__ d_main;\n47\t    const Fp *__restrict__ d_public;\n48\t    FpExt *__restrict__ d_intermediates;\n49\t    uint32_t height;\n50\t};\n51\t\n52\t__device__ __forceinline__ FpExt evaluate_mle_entry(\n53\t    const SourceInfo &src,\n54\t    uint32_t row,\n55\t    const EvalCtx &ctx,\n56\t    uint32_t buffer_stride,\n57\t    const FpExt *__restrict__ d_challenges = nullptr\n58\t) {\n59\t    switch (src.type) {\n60\t    case ENTRY_PREPROCESSED: {\n61\t#ifdef CUDA_DEBUG\n62\t        assert(ctx.d_preprocessed.data);\n63\t#endif\n64\t        const auto stride = ctx.height * ctx.d_preprocessed.air_width;\n65\t        const FpExt *__restrict__ matrix = ctx.d_preprocessed.data + stride * src.offset;\n66\t        const FpExt *__restrict__ column = matrix + ctx.height * src.index;\n67\t        return column[row];\n68\t    }\n69\t    case ENTRY_MAIN: {\n70\t        auto main_ptr = ctx.d_main[src.part];\n71\t        const auto stride = ctx.height * main_ptr.air_width;\n72\t        const FpExt *__restrict__ matrix = main_ptr.data + stride * src.offset;\n73\t        const FpExt *__restrict__ column = matrix + ctx.height * src.index;\n74\t        return column[row];\n75\t    }\n76\t    case SRC_INTERMEDIATE:\n77\t        return ctx.d_intermediates[src.index * buffer_stride];\n78\t    case SRC_IS_FIRST: {\n79\t        const FpExt *__restrict__ column = ctx.d_selectors;\n80\t        return FpExt(column[row]);\n81\t    }\n82\t    case SRC_IS_LAST: {\n83\t        const FpExt *__restrict__ column = ctx.d_selectors + 2 * ctx.height;\n84\t        return FpExt(column[row]);\n85\t    }\n86\t    case SRC_IS_TRANSITION: {\n87\t        const FpExt *__restrict__ column = ctx.d_selectors + ctx.height;\n88\t        return FpExt(column[row]);\n89\t    }\n90\t    case ENTRY_CHALLENGE:\n91\t#ifdef CUDA_DEBUG\n92\t        assert(d_challenges);\n93\t#endif\n94\t        return d_challenges[src.index];\n95\t    case ENTRY_PUBLIC:\n96\t        return FpExt(ctx.d_public[src.index]);\n97\t    case SRC_CONSTANT:\n98\t        return FpExt(Fp(src.index));\n99\t    default:\n100\t        assert(false);\n101\t    }\n102\t    return FpExt(Fp::zero());\n103\t}\n104\t\n105\t// ============================================================================\n106\t// KERNELS\n107\t// ============================================================================\n108\t\n109\t__global__ void zerocheck_batch_mle_kernel(\n110\t    FpExt *__restrict__ tmp_sums_buffer,\n111\t    const BlockCtx *__restrict__ d_block_ctxs,\n112\t    const ZerocheckCtx *__restrict__ d_zc_ctxs,\n113\t    const FpExt *__restrict__ d_lambda_pows,\n114\t    size_t lambda_len\n115\t) {\n116\t    extern __shared__ char smem[];\n117\t    FpExt *shared = (FpExt *)smem;\n118\t\n119\t    BlockCtx block_ctx = d_block_ctxs[blockIdx.x];\n120\t    ZerocheckCtx zc_ctx = d_zc_ctxs[block_ctx.air_idx];\n121\t\n122\t    uint32_t num_x = gridDim.y;\n123\t    uint32_t x_int = blockIdx.y;\n124\t    uint32_t y_int = threadIdx.x + block_ctx.local_block_idx_x * blockDim.x;\n125\t    bool const active_thread = (y_int < zc_ctx.num_y);\n126\t\n127\t    FpExt sum(Fp::zero());\n128\t\n129\t    if (active_thread) {\n130\t        uint32_t height = num_x * zc_ctx.num_y;\n131\t        uint32_t row = x_int * zc_ctx.num_y + y_int;\n132\t        // No tiling: task_offset = row, task_stride = height\n133\t        uint32_t buffer_stride = 0;\n134\t        FpExt *__restrict__ intermediates = nullptr;\n135\t        if (zc_ctx.buffer_size > 0) {\n136\t#ifdef CUDA_DEBUG\n137\t            assert(zc_ctx.d_intermediates != nullptr);\n138\t#endif\n139\t            intermediates = zc_ctx.d_intermediates + row;\n140\t            buffer_stride = height;\n141\t        }\n142\t        EvalCtx eval_ctx{\n143\t            zc_ctx.eval_ctx.d_selectors,\n144\t            zc_ctx.eval_ctx.d_preprocessed,\n145\t            zc_ctx.eval_ctx.d_main,\n146\t            zc_ctx.eval_ctx.d_public,\n147\t            intermediates,\n148\t            height\n149\t        };\n150\t        uint32_t lambda_idx = 0;\n151\t\n152\t        for (size_t node = 0; node < zc_ctx.rules_len; ++node) {\n153\t            Rule rule = zc_ctx.d_rules[node];\n154\t            DecodedRule decoded = decode_rule(rule);\n155\t\n156\t            FpExt x_val = evaluate_mle_entry(decoded.x, row, eval_ctx, buffer_stride);\n157\t            FpExt result;\n158\t            switch (decoded.op) {\n159\t            case OP_ADD: {\n160\t                FpExt y_val = evaluate_mle_entry(decoded.y, row, eval_ctx, buffer_stride);\n161\t                result = x_val + y_val;\n162\t                break;\n163\t            }\n164\t            case OP_SUB: {\n165\t                FpExt y_val = evaluate_mle_entry(decoded.y, row, eval_ctx, buffer_stride);\n166\t                result = x_val - y_val;\n167\t                break;\n168\t            }\n169\t            case OP_MUL: {\n170\t                FpExt y_val = evaluate_mle_entry(decoded.y, row, eval_ctx, buffer_stride);\n171\t                result = x_val * y_val;\n172\t                break;\n173\t            }\n174\t            case OP_NEG:\n175\t                result = -x_val;\n176\t                break;\n177\t            case OP_VAR:\n178\t                result = x_val;\n179\t                break;\n180\t            default:\n181\t                assert(false);\n182\t            }\n183\t\n184\t            if (decoded.buffer_result && zc_ctx.buffer_size > 0) {\n185\t                eval_ctx.d_intermediates[decoded.z_index * buffer_stride] = result;\n186\t            }\n187\t\n188\t            if (decoded.is_constraint) {\n189\t                while (lambda_idx < lambda_len && lambda_idx < zc_ctx.used_nodes_len &&\n190\t                       zc_ctx.d_used_nodes[lambda_idx] == node) {\n191\t                    FpExt lambda = d_lambda_pows[lambda_idx];\n192\t                    lambda_idx++;\n193\t                    sum += lambda * result;\n194\t                }\n195\t            }\n196\t        }\n197\t        sum *= zc_ctx.d_eq_xi[y_int];\n198\t    }\n199\t\n200\t    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);"}]},"parent_tool_use_id":"toolu_01AziaoQyUBvBQHrhM4RkX8Z","session_id":"f245fed0-0457-4d6a-9da2-744553774a6f","uuid":"8028dfd6-96ef-4274-8e17-7499c0ed8c7f","timestamp":"2026-04-15T15:33:52.784Z"}
