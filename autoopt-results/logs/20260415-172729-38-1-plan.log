0\t                        );\n281\t                        node_result = x_val + y_val;\n282\t                        break;\n283\t                    }\n284\t                    case OP_SUB: {\n285\t                        FpExt y_val = evaluate_mle_entry(\n286\t                            decoded.y, row, eval_ctx, buffer_stride, logup_ctx.d_challenges\n287\t                        );\n288\t                        node_result = x_val - y_val;\n289\t                        break;\n290\t                    }\n291\t                    case OP_MUL: {\n292\t                        FpExt y_val = evaluate_mle_entry(\n293\t                            decoded.y, row, eval_ctx, buffer_stride, logup_ctx.d_challenges\n294\t                        );\n295\t                        node_result = x_val * y_val;\n296\t                        break;\n297\t                    }\n298\t                    case OP_NEG:\n299\t                        node_result = -x_val;\n300\t                        break;\n301\t                    case OP_VAR:\n302\t                        node_result = x_val;\n303\t                        break;\n304\t                    default:\n305\t                        assert(false);\n306\t                    }\n307\t\n308\t                    if (decoded.buffer_result && logup_ctx.buffer_size > 0) {\n309\t                        eval_ctx.d_intermediates[decoded.z_index * buffer_stride] = node_result;\n310\t                    }\n311\t\n312\t                    // If this is the node we're looking for, use it\n313\t                    if (rules_evaluated == node_idx) {\n314\t                        result = node_result;\n315\t                    }\n316\t                }\n317\t            }\n318\t\n319\t            // Use pair_idxs to get the actual pair index for this used node\n320\t            // pair_idx = 2 * interaction_idx + is_denom\n321\t            uint32_t pair_idx = logup_ctx.d_pair_idxs[used_idx];\n322\t            result *= logup_ctx.d_eq_3bs[pai