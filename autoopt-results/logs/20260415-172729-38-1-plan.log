{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014xUCYCHVtSEFvttQQC83ei","type":"tool_result","content":"393\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n394\t    transcript: &mut TS,\n395\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n396\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n397\t    save_memory: bool,\n398\t    monomial_num_y_threshold: u32,\n399\t    sm_count: u32,\n400\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n401\twhere\n402\t    HS: GpuHashScheme,\n403\t    TS: GpuFiatShamirTranscript<HS::SC>,\n404\t{\n405\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n406\t    let l_skip = mpk.params.l_skip;\n407\t    let constraint_degree = mpk.max_constraint_degree;\n408\t    let num_traces = ctx.per_trace.len();\n409\t\n410\t    // Traces are sorted\n411\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n412\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n413\t    // heights\n414\t    let mut total_interactions = 0u64;\n415\t    let interactions_meta: Vec<_> = ctx\n416\t        .per_trace\n417\t        .iter()\n418\t        .map(|(air_idx, air_ctx)| {\n419\t            let pk = &mpk.per_air[*air_idx];\n420\t\n421\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n422\t            let height = air_ctx.common_main.height();\n423\t            let log_height = log2_strict_usize(height);\n424\t            let log_lifted_height = log_height.max(l_skip);\n425\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n426\t            (num_interactions, log_lifted_height)\n427\t        })\n428\t        .collect();\n429\t    // Implicitly, the width of this stacking should be 1\n430\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n431\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n432\t    // GKR\n433\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n434\t\n435\t    // Grind to increase soundness of random sampling for LogUp\n436\t    let logup_pow_witness = transcript\n437\t        .grind_gpu(mpk.params.logup.pow_bits)\n438\t        .map_err(LogupZerocheckError::Grind)?;\n439\t    let alpha_logup = transcript.sample_ext();\n440\t    let beta_logup = transcript.sample_ext();\n441\t    debug!(%alpha_logup, %beta_logup);\n442\t\n443\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n444\t    let mut prover = LogupZerocheckGpu::new(\n445\t        mpk,\n446\t        ctx,\n447\t        n_logup,\n448\t        interactions_layout,\n449\t        alpha_logup,\n450\t        beta_logup,\n451\t        save_memory,\n452\t        monomial_num_y_threshold,\n453\t        sm_count,\n454\t    )?;\n455\t    let n_global = prover.n_global;\n456\t\n457\t    let total_leaves = 1 << (l_skip + n_logup);\n458\t    prover\n459\t        .mem\n460\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n461\t    prover.mem.reset_peak();\n462\t    let (inputs, alpha) = if has_interactions {\n463\t        log_gkr_input_evals(\n464\t            &prover.trace_interactions,\n465\t            mpk,\n466\t            ctx,\n467\t            l_skip,\n468\t            alpha_logup,\n469\t            &prover.d_challenges,\n470\t            total_leaves,\n471\t        )?\n472\t    } else {\n473\t        (DeviceBuffer::new(), EF::ZERO)\n474\t    };\n475\t    // Set memory limit for batch MLE based on inputs buffer size\n476\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n477\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n478\t    if !prover.save_memory {\n479\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n480\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n481\t            tracing::warn!(\n482\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n483\t                prover.memory_limit_bytes\n484\t            );\n485\t        }\n486\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n487\t    }\n488\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n489\t\n490\t    let (frac_sum_proof, mut xi) =\n491\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n492\t    while xi.len() != l_skip + n_global {\n493\t        xi.push(transcript.sample_ext());\n494\t    }\n495\t    debug!(?xi);\n496\t    prover.xi = xi;\n497\t\n498\t    logup_gkr_span.exit();\n499\t\n500\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does\n501\t    // not include the kernel times for the actual folding\n502\t    let round0_span = info_span!(\"prover.rap_constraints.round0\", phase = \"prover\").entered();\n503\t    // begin batch sumcheck\n504\t    let mut sumcheck_round_polys = Vec::with_capacity(n_max);\n505\t    let mut r = Vec::with_capacity(n_max + 1);\n506\t    // batching randomness\n507\t    let lambda = transcript.sample_ext();\n508\t    debug!(%lambda);\n509\t\n510\t    let sp_0_polys = prover.sumcheck_uni_round0_polys(ctx, lambda)?;\n511\t    let s_0_cpu_span = info_span!(\"s'_0 -> s_0 cpu interpolations\").entered();\n512\t    let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_degree);\n513\t    let s_deg = constraint_degree + 1;\n514\t    let s_0_deg = sumcheck_round0_deg(l_skip, s_deg);\n515\t    let large_uni_domain = (s_0_deg + 1).next_power_of_two();\n516\t    let dft = Radix2BowersSerial;\n517\t    let s_0_logup_polys = {\n518\t        let eq_sharp_uni = eq_sharp_uni_poly(&prover.xi[..l_skip]);\n519\t        let mut eq_coeffs = eq_sharp_uni.into_coeffs();\n520\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n521\t        let eq_evals = dft.dft(eq_coeffs);\n522\t\n523\t        let width = 2 * num_traces;\n524\t        let mut sp_coeffs_mat = EF::zero_vec(width * large_uni_domain);\n525\t        for (i, coeffs) in sp_0_polys[..2 * num_traces].iter().enumerate() {\n526\t            for (j, &c_j) in coeffs.coeffs().iter().enumerate().take(sp_0_deg + 1) {\n527\t                // SAFETY:\n528\t                // - coeffs length is <= sp_0_deg + 1 <= s_0_deg < large_uni_domain\n529\t                // - sp_coeffs_mat allocated for width\n530\t                unsafe {\n531\t                    *sp_coeffs_mat.get_unchecked_mut(j * width + i) = c_j;\n532\t                }\n533\t            }\n534\t        }\n535\t        let mut s_evals = dft.dft_batch(RowMajorMatrix::new(sp_coeffs_mat, width));\n536\t        for (eq, row) in zip(eq_evals, s_evals.values.chunks_mut(width)) {\n537\t            for x in row {\n538\t                *x *= eq;\n539\t            }\n540\t        }\n541\t        dft.idft_batch(s_evals)\n542\t    };\n543\t    let skip_domain_size = F::from_usize(1 << l_skip);\n544\t    // logup sum claims (sum_{\\hat p}, sum_{\\hat q}) per present AIR\n545\t    let (numerator_term_per_air, denominator_term_per_air): (Vec<_>, Vec<_>) = (0..num_traces)\n546\t        .map(|trace_idx| {\n547\t            let [sum_claim_p, sum_claim_q] = [0, 1].map(|is_denom| {\n548\t                // Compute sum over D of s_0(Z) to get the sum claim\n549\t                (0..=s_0_deg)\n550\t                    .step_by(1 << l_skip)\n551\t                    .map(|j| unsafe {\n552\t                        // SAFETY: matrix is 2 * num_trace x large_uni_domain, s_0_deg <\n553\t                        // large_uni_domain\n554\t                        *s_0_logup_polys\n555\t                            .values\n556\t                            .get_unchecked(j * 2 * num_traces + 2 * trace_idx + is_denom)\n557\t                    })\n558\t                    .sum::<EF>()\n559\t                    * skip_domain_size\n560\t            });\n561\t            transcript.observe_ext(sum_claim_p);\n562\t            transcript.observe_ext(sum_claim_q);\n563\t\n564\t            (sum_claim_p, sum_claim_q)\n565\t        })\n566\t        .unzip();\n567\t\n568\t    let mu = transcript.sample_ext();\n569\t    debug!(%mu);\n570\t    let mu_pows = mu.powers().take(3 * num_traces).collect_vec();\n571\t\n572\t    let s_0_zc_poly = {\n573\t        let eq_uni = eq_uni_poly::<F, _>(l_skip, prover.xi[0]);\n574\t        let mut eq_coeffs = eq_uni.into_coeffs();\n575\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n576\t        let eq_evals = dft.dft(eq_coeffs);\n577\t\n578\t        // Algebraically batch\n579\t        let mut sp_coeffs = EF::zero_vec(large_uni_domain);\n580\t        let mus = &mu_pows[2 * num_traces..];\n581\t        let polys = &sp_0_polys[2 * num_traces..];\n582\t        for (j, batch_coeff) in sp_coeffs.iter_mut().enumerate().take(sp_0_deg + 1) {\n583\t            for (&mu, poly) in zip(mus, polys) {\n584\t                *batch_coeff += mu * *poly.coeffs().get(j).unwrap_or(&EF::ZERO);\n585\t            }\n586\t        }\n587\t        let mut s_evals = dft.dft(sp_coeffs);\n588\t        for (eq, x) in zip(eq_evals, &mut s_evals) {\n589\t            *x *= eq;\n590\t        }\n591\t        dft.idft(s_evals)\n592\t    };\n593\t\n594\t    // Algebraically batch\n595\t    let s_0_poly = UnivariatePoly::new(\n596\t        zip(\n597\t            s_0_logup_polys.values.chunks_exact(2 * num_traces),\n598\t            s_0_zc_poly,\n599\t        )\n600\t        .take(s_0_deg + 1)\n601\t        .map(|(logup_row, batched_zc)| {\n602\t            let coeff = batched_zc\n603\t                + zip(&mu_pows, logup_row)\n604\t                    .map(|(&mu_j, &x)| mu_j * x)\n605\t                    .sum::<EF>();\n606\t            transcript.observe_ext(coeff);\n607\t            coeff\n608\t        })\n609\t        .collect(),\n610\t    );\n611\t    drop(s_0_cpu_span);\n612\t\n613\t    let r_0 = transcript.sample_ext();\n614\t    r.push(r_0);\n615\t    debug!(round = 0, r_round = %r_0);\n616\t    prover.prev_s_eval = s_0_poly.eval_at_point(r_0);\n617\t    debug!(\"s_0(r_0) = {}\", prover.prev_s_eval);\n618\t\n619\t    prover.fold_ple_evals(ctx, r_0)?;\n620\t    drop(round0_span);\n621\t\n622\t    // Allocate ping-pong buffers for MLE fold. These eliminate per-round per-matrix\n623\t    // cudaMallocAsync/cudaFreeAsync in fold_mle_evals. The first fold round reads from\n624\t    // original DeviceMatrix objects (no initial D2D pack needed); subsequent rounds read\n625\t    // from the ping-pong buffers.\n626\t    {\n627\t        let mat_total_cells: usize = prover\n628\t            .mat_evals_per_trace\n629\t            .iter()\n630\t            .flatten()\n631\t            .map(|m| m.height() * m.width())\n632\t            .sum();\n633\t        if mat_total_cells > 0 {\n634\t            prover.fold_mat_buf_a = Some(DeviceBuffer::<EF>::with_capacity(mat_total_cells));\n635\t            prover.fold_mat_buf_b = Some(DeviceBuffer::<EF>::with_capacity(mat_total_cells));\n636\t        }\n637\t\n638\t        let sel_total_cells: usize = prover\n639\t            .sels_per_trace\n640\t            .iter()\n641\t            .map(|m| m.height() * m.width())\n642\t            .sum();\n643\t        if sel_total_cells > 0 {\n644\t            prover.fold_sel_buf_a = Some(DeviceBuffer::<EF>::with_capacity(sel_total_cells));\n645\t            prover.fold_sel_buf_b = Some(DeviceBuffer::<EF>::with_capacity(sel_total_cells));\n646\t        }\n647\t    }\n648\t\n649\t    // Sumcheck rounds:\n650\t    // - each round the prover needs to compute univariate polynomial `s_round`. This poly is linear\n651\t    //   since we are taking MLE of `evals`.\n652\t    // - at end of each round, sample random `r_round` in `EF`\n653\t    //\n654\t    // `s_round` is degree `s_deg` so we evaluate it at `0, ..., =s_deg`. The prover skips\n655\t    // evaluation at `0` because the verifier can infer it from the previous round's\n656\t    // `s_{round-1}(r)` claim. The degree is constraint_degree + 1, where + 1 is from eq term\n657\t    let mle_rounds_span =\n658\t        info_span!(\"prover.rap_constraints.mle_rounds\", phase = \"prover\").entered();\n659\t    debug!(%s_deg);\n660\t    for round in 1..=n_max {\n661\t        let sp_round_evals = prover.sumcheck_polys_batch_eval(round, r[round - 1])?;\n662\t        let batch_s = prover.compute_batch_s_poly(sp_round_evals, num_traces, round, &mu_pows);\n663\t        let batch_s_evals = (1..=s_deg)\n664\t            .map(|i| batch_s.eval_at_point(EF::from_usize(i)))\n665\t            .collect_vec();\n666\t        for &eval in &batch_s_evals {\n667\t            transcript.observe_ext(eval);\n668\t        }\n669\t        sumcheck_round_polys.push(batch_s_evals);\n670\t\n671\t        let r_round = transcript.sample_ext();\n672\t        debug!(%round, %r_round);\n673\t        r.push(r_round);\n674\t        prover.prev_s_eval = batch_s.eval_at_point(r_round);\n675\t\n676\t        prover.fold_mle_evals(round, r_round)?;\n677\t    }\n678\t    assert_eq!(r.len(), n_max + 1);\n679\t\n680\t    let column_openings = prover.into_column_openings()?;\n681\t\n682\t    let need_rot_per_trace = ctx\n683\t        .per_trace\n684\t        .iter()\n685\t        .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n686\t        .collect::<Vec<_>>();\n687\t    // Observe common main openings first, and then preprocessed/cached\n688\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n689\t        for (claim, claim_rot) in column_openings_by_rot(&openings[0], *need_rot) {\n690\t            transcript.observe_ext(claim);\n691\t            transcript.observe_ext(claim_rot);\n692\t        }\n693\t    }\n694\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n695\t        for part in openings.iter().skip(1) {\n696\t            for (claim, claim_rot) in column_openings_by_rot(part, *need_rot) {\n697\t                transcript.observe_ext(claim);\n698\t                transcript.observe_ext(claim_rot);\n699\t            }\n700\t        }\n701\t    }\n702\t    drop(mle_rounds_span);\n703\t\n704\t    let batch_constraint_proof = BatchConstraintProof {\n705\t        numerator_term_per_air,\n706\t        denominator_term_per_air,\n707\t        univariate_round_coeffs: s_0_poly.into_coeffs(),\n708\t        sumcheck_round_polys,\n709\t        column_openings,\n710\t    };\n711\t    let gkr_proof = GkrProof {\n712\t        logup_pow_witness,\n713\t        q0_claim: frac_sum_proof.fractional_sum.1,\n714\t        claims_per_layer: frac_sum_proof.claims_per_layer,\n715\t        sumcheck_polys: frac_sum_proof.sumcheck_polys,\n716\t    };\n717\t    Ok((gkr_proof, batch_constraint_proof, r))\n718\t}\n719\t\n720\tpub struct LogupZerocheckGpu<'a, HS: GpuHashScheme> {\n721\t    pub alpha_logup: EF,\n722\t    pub beta_pows: Vec<EF>,\n723\t    // [alpha, beta^0, beta^1, .., beta^max_interaction_len]\n724\t    pub d_challenges: DeviceBuffer<EF>,\n725\t\n726\t    pub l_skip: usize,\n727\t    n_logup: usize,\n728\t    n_global: usize,\n729\t\n730\t    pub omega_skip: F,\n731\t    pub omega_skip_pows: Vec<F>,\n732\t    d_omega_skip_pows: DeviceBuffer<F>,\n733\t\n734\t    pub interactions_layout: StackedLayout,\n735\t    pub constraint_degree: usize,\n736\t    n_per_trace: Vec<isize>,\n737\t    max_num_constraints: usize,\n738\t    pub monomial_num_y_threshold: u32,\n739\t    sm_count: u32,\n740\t    // Available after GKR:\n741\t    pub xi: Vec<EF>,\n742\t    pub lambda_pows: Option<DeviceBuffer<EF>>,\n743\t    /// Precomputed lambda combinations per AIR (indexed by air_idx). Set when lambda is sampled.\n744\t    lambda_combinations: Vec<Option<DeviceBuffer<EF>>>,\n745\t    /// Beta powers on device for logup MLE rounds.\n746\t    d_beta_pows: DeviceBuffer<EF>,\n747\t    /// Precomputed logup combinations per trace (indexed by trace_idx). Set when xi is sampled.\n748\t    logup_combinations: Vec<Option<LogupCombinations>>,\n749\t\n750\t    // n_T => segment tree of eq(xi[j..1+n_T]) for j=1..={n_T-round+1} in _reverse_ layout\n751\t    eq_xis: FxHashMap<usize, EqEvalLayers<EF>>,\n752\t    eq_3b_per_trace: Vec<Vec<EF>>,\n753\t    d_eq_3b_per_trace: Vec<DeviceBuffer<EF>>,\n754\t    // Evaluations on hypercube only, for round 0\n755\t    sels_per_trace_base: Vec<DeviceMatrix<F>>,\n756\t    // After univariate round 0:\n757\t    mat_evals_per_trace: Vec<Vec<DeviceMatrix<EF>>>,\n758\t    sels_per_trace: Vec<DeviceMatrix<EF>>,\n759\t    // Store public_values per trace (similar to CPU's EvalHelper)\n760\t    public_values_per_trace: Vec<DeviceBuffer<F>>,\n761\t    air_indices_per_trace: Vec<usize>,\n762\t    zerocheck_tilde_evals: Vec<EF>,\n763\t    logup_tilde_evals: Vec<[EF; 2]>,\n764\t    needs_next_per_trace: Vec<bool>,\n765\t\n766\t    trace_interactions: Vec<Option<TraceInteractionMeta>>,\n767\t    // round0: Round0Buffers,\n768\t    pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n769\t\n770\t    // In round `j`, contains `s_{j-1}(r_{j-1})`\n771\t    pub(crate) prev_s_eval: EF,\n772\t    pub(crate) eq_ns: Vec<EF>,\n773\t    pub(crate) eq_sharp_ns: Vec<EF>,\n774\t\n775\t    mem: MemTracker,\n776\t    save_memory: bool,\n777\t\n778\t    gkr_mem_contribution: usize,\n779\t    /// Memory limit for batch MLE intermediate buffers (set after GKR input eval)\n780\t    memory_limit_bytes: usize,\n781\t\n782\t    /// Ping-pong buffers for MLE fold. When active, mat_evals_per_trace and sels_per_trace\n783\t    /// contain non-owning DeviceMatrix views into these buffers.\n784\t    fold_mat_buf_a: Option<DeviceBuffer<EF>>,\n785\t    fold_mat_buf_b: Option<DeviceBuffer<EF>>,\n786\t    fold_sel_buf_a: Option<DeviceBuffer<EF>>,\n787\t    fold_sel_buf_b: Option<DeviceBuffer<EF>>,\n788\t}\n789\t\n790\timpl<'a, HS: GpuHashScheme> LogupZerocheckGpu<'a, HS> {\n791\t    #[allow(clippy::too_many_arguments)]\n792\t    fn new(\n793\t        pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n794\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n795\t        n_logup: usize,\n796\t        interactions_layout: StackedLayout,\n797\t        alpha_logup: EF,\n798\t        beta_logup: EF,\n799\t        save_memory: bool,\n800\t        monomial_num_y_threshold: u32,\n801\t        sm_count: u32,\n802\t    ) -> Result<Self, LogupZerocheckError> {\n803\t        let mem = MemTracker::start(\"prover.logup_zerocheck_prover\");\n804\t        let l_skip = pk.params.l_skip;\n805\t        let omega_skip = F::two_adic_generator(l_skip);\n806\t        let omega_skip_pows = omega_skip.powers().take(1 << l_skip).collect_vec();\n807\t        let d_omega_skip_pows = omega_skip_pows.to_device()?;\n808\t        let num_airs_present = ctx.per_trace.len();\n809\t\n810\t        let constraint_degree = pk.max_constraint_degree;\n811\t\n812\t        let max_interaction_length = pk\n813\t            .per_air\n814\t            .iter()\n815\t            .map(|air_pk| air_pk.other_data.interaction_rules.max_fields_len)\n816\t            .max()\n817\t            .unwrap_or(0);\n818\t        let beta_pows = beta_logup\n819\t            .powers()\n820\t            .take(max_interaction_length + 1)\n821\t            .collect_vec();\n822\t        let challenges = [&[alpha_logup], &beta_pows[..]].concat();\n823\t        let d_challenges = challenges.to_device()?;\n824\t        let d_beta_pows = beta_pows.to_device()?;\n825\t\n826\t        let n_per_trace: Vec<isize> = ctx\n827\t            .common_main_traces()\n828\t            .map(|(_, t)| log2_strict_usize(t.height()) as isize - l_skip as isize)\n829\t            .collect();\n830\t        let n_max = n_per_trace[0].max(0) as usize;\n831\t        let n_global = max(n_max, n_logup);\n832\t        info!(%n_global, %n_logup);\n833\t\n834\t        let max_num_constraints = pk\n835\t            .per_air\n836\t            .iter()\n837\t            .map(|air_pk| {\n838\t                air_pk\n839\t                    .vk\n840\t                    .symbolic_constraints\n841\t                    .constraints\n842\t                    .constraint_idx\n843\t                    .len()\n844\t            })\n845\t            .max()\n846\t            .unwrap_or(0);\n847\t\n848\t        // Collect interaction metadata for GPU execution (evaluations still run on CPU for now).\n849\t        let trace_interactions = collect_trace_interactions(pk, ctx, &interactions_layout);\n850\t\n851\t        let needs_next_per_trace = ctx\n852\t            .per_trace\n853\t            .iter()\n854\t            .map(|(air_idx, _)| pk.per_air[*air_idx].vk.params.need_rot)\n855\t            .collect::<Vec<_>>();\n856\t\n857\t        Ok(Self {\n858\t            alpha_logup,\n859\t            beta_pows,\n860\t            d_challenges,\n861\t            l_skip,\n862\t            n_logup,\n863\t            n_global,\n864\t            omega_skip,\n865\t            omega_skip_pows,\n866\t            d_omega_skip_pows,\n867\t            interactions_layout,\n868\t            constraint_degree,\n869\t            n_per_trace,\n870\t            max_num_constraints,\n871\t            sm_count,\n872\t            xi: vec![],\n873\t            lambda_pows: None,\n874\t            lambda_combinations: (0..pk.per_air.len()).map(|_| None).collect(),\n875\t            d_beta_pows,\n876\t            logup_combinations: (0..num_airs_present).map(|_| None).collect(),\n877\t            eq_xis: FxHashMap::default(),\n878\t            eq_3b_per_trace: vec![],\n879\t            d_eq_3b_per_trace: vec![],\n880\t            sels_per_trace_base: vec![],\n881\t            mat_evals_per_trace: vec![],\n882\t            sels_per_trace: vec![],\n883\t            public_values_per_trace: ctx\n884\t                .per_trace\n885\t                .iter()\n886\t                .map(|(_, air_ctx)| {\n887\t                    if air_ctx.public_values.is_empty() {\n888\t                        Ok(Device