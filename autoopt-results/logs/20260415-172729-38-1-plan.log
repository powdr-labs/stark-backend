       }\n195\t            }\n196\t        }\n197\t        sum *= zc_ctx.d_eq_xi[y_int];\n198\t    }\n199\t\n200\t    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n201\t    if (threadIdx.x == 0) {\n202\t        tmp_sums_buffer[blockIdx.x * num_x + x_int] = reduced;\n203\t    }\n204\t}\n205\t\n206\t__global__ void logup_batch_mle_kernel(\n207\t    FracExt *__restrict__ tmp_sums_buffer,\n208\t    const BlockCtx *__restrict__ d_block_ctxs,\n209\t    const LogupCtx *__restrict__ d_logup_ctxs\n210\t) {\n211\t    extern __shared__ char smem[];\n212\t    FpExt *shared = reinterpret_cast<FpExt *>(smem);\n213\t\n214\t    BlockCtx block_ctx = d_block_ctxs[blockIdx.x];\n215\t    LogupCtx logup_ctx = d_logup_ctxs[block_ctx.air_idx];\n216\t\n217\t    uint32_t num_x = gridDim.y;\n218\t    uint32_t x_int = blockIdx.y;\n219\t    uint32_t y_int = threadIdx.x + block_ctx.local_block_idx_x * blockDim.x;\n220\t    bool const active_thread = (y_int < logup_ctx.num_y);\n221\t\n222\t    FpExt numer_sum = FpExt(Fp::zero());\n223\t    FpExt denom_sum = FpExt(Fp::zero());\n224\t\n225\t    if (active_thread) {\n226\t        uint32_t height = num_x * logup_ctx.num_y;\n227\t        uint32_t row = x_int * logup_ctx.num_y + y_int;\n228\t        // No tiling: task_offset = row, task_stride = height\n229\t        uint32_t buffer_stride = 0;\n230\t        FpExt *intermediates = nullptr;\n231\t        if (logup_ctx.buffer_size > 0) {\n232\t            assert(logup_ctx.d_intermediates != nullptr);\n233\t            intermediates = logup_ctx.d_intermediates + row;\n234\t            buffer_stride = height;\n235\t        }\n236\t\n237\t        // Build local EvalCtx with correct intermediates backing.\n238\t        // NOTE: `eval_ctx.d_intermediates` points at the current task's base, so indexing uses\n239\t        // `decoded.z_index * buffer_stride`.\n240\t        EvalCtx eval_ctx{\n241\t            logup_ctx.eval_ctx.d_selectors,\n242\t            logup_ctx.eval_ctx.d_preprocessed,\n243\t 