{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G6pGCCQAHXKZVjaUw5a9r5","type":"tool_result","content":"575\t}\n576\t\n577\t// (Not a launcher) Utility function to calculate required size of temp buffer.\n578\t// Required length of *block_sums in FpExt elements\n579\t// SP_DEG=1: outputs NUM_G=3 values per z (G0, G1, G2)\n580\textern \"C\" uint32_t _stacked_reduction_r0_required_temp_buffer_size(\n581\t    uint32_t trace_height,\n582\t    uint32_t trace_width,\n583\t    uint32_t l_skip\n584\t) {\n585\t    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n586\t    return ((grid.x * grid.y) << l_skip) * NUM_G;\n587\t}\n588\t\n589\t// SP_DEG=1: No z_packets needed, outputs G0, G1, G2 on identity coset only.\n590\t// Uses ADD_TO_OUTPUT=true to accumulate into output buffer (for bucket-based accumulation).\n591\textern \"C\" int _stacked_reduction_sumcheck_round0(\n592\t    const FpExt *eq_r_ns,\n593\t    const Fp *trace_ptr,\n594\t    const FpExt *lambda_pows,\n595\t    FpExt *block_sums,\n596\t    FpExt *output, // length should be NUM_G * skip_domain, ADD to existing values\n597\t    uint32_t trace_height,\n598\t    uint32_t trace_width,\n599\t    uint32_t l_skip,\n600\t    uint32_t num_x\n601\t) {\n602\t    uint32_t skip_domain = 1u << l_skip;\n603\t    uint32_t stride = std::max(skip_domain / trace_height, 1u);\n604\t    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n605\t\n606\t    // Use block.x + 1 stride for shared_sum to avoid bank conflicts\n607\t    // NUM_G=3 outputs per z (G0, G1, G2)\n608\t    size_t shmem_sum_size = sizeof(FpExt) * (block.x + 1) * NUM_G;\n609\t\n610\t    stacked_reduction_round0_block_sum_kernel<<<grid, block, shmem_sum_size>>>(\n611\t        eq_r_ns, trace_ptr, lambda_pows, block_sums,\n612\t        trace_height, trace_width, l_skip,\n613\t        skip_domain - 1, num_x, 31 - __builtin_clz(stride)\n614\t    );\n615\t\n616\t    int err = CHECK_KERNEL();\n617\t    if (err != 0)\n618\t        return err;\n619\t\n620\t    // Launch final reduction kernel - reads from block_sums, ADDs to output\n621\t    auto num_blocks = grid.x * grid.y;\n622\t    auto output_size = NUM_G * skip_domain;\n623\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n624\t    size_t reduce_shmem = div_ceil(reduce_block.x, WARP_SIZE) * sizeof(FpExt);\n625\t    sumcheck::final_reduce_block_sums<true>\n626\t        <<<output_size, reduce_block, reduce_shmem>>>(block_sums, output, num_blocks);\n627\t\n628\t    return CHECK_KERNEL();\n629\t}\n630\t\n631\t// Parallelizes barycentric interpolation across 2^l_skip threads per output cell\n632\textern \"C\" int _stacked_reduction_fold_ple(\n633\t    const Fp *src,\n634\t    FpExt *dst,\n635\t    const Fp *omega_skip_pows,\n636\t    const FpExt *inv_lagrange_denoms,\n637\t    uint32_t trace_height,\n638\t    uint32_t trace_width,\n639\t    uint32_t l_skip\n640\t) {\n641\t    uint32_t skip_domain = 1u << l_skip;\n642\t    uint32_t new_height = std::max(trace_height, skip_domain) / skip_domain;\n643\t\n644\t    // Block size: at least skip_domain, prefer 256 for occupancy\n645\t    uint32_t block_size = std::max(256u, skip_domain);\n646\t    uint32_t chunks_per_block = block_size / skip_domain;\n647\t\n648\t    // 2D grid: x-dim for rows, y-dim for columns\n649\t    dim3 grid(div_ceil(new_height, chunks_per_block), trace_width);\n650\t    dim3 block(block_size);\n651\t\n652\t    // Shared memory for cross-warp reduction (needed when skip_domain > 32)\n653\t    // Each warp in the block needs one FpExt slot for cross-warp reduction\n654\t    uint32_t total_warps_in_block = block_size / WARP_SIZE;\n655\t    size_t smem_bytes = (skip_domain > WARP_SIZE) ? total_warps_in_block * sizeof(FpExt) : 0;\n656\t\n657\t    stacked_reduction_fold_ple_kernel<<<grid, block, smem_bytes>>>(\n658\t        src, dst, omega_skip_pows, inv_lagrange_denoms, trace_height, new_height, skip_domain\n659\t    );\n660\t\n661\t    return CHECK_KERNEL();\n662\t}\n663\t\n664\textern \"C\" int _initialize_k_rot_from_eq_segments(\n665\t    const FpExt *eq_r_ns,\n666\t    FpExt *k_rot_ns,\n667\t    FpExt k_rot_uni_0,\n668\t    FpExt k_rot_uni_1,\n669\t    uint32_t max_n\n670\t) {\n671\t    auto [grid, block] = kernel_launch_params(1 << max_n);\n672\t    grid.y = max_n + 1;\n673\t\n674\t    initialize_k_rot_from_eq_segments_kernel<<<grid, block>>>(\n675\t        eq_r_ns, k_rot_ns, k_rot_uni_0, k_rot_uni_1\n676\t    );\n677\t\n678\t    return CHECK_KERNEL();\n679\t}\n680\t\n681\textern \"C\" int _stacked_reduction_sumcheck_mle_round(\n682\t    const FpExt *const *q_evals,\n683\t    const FpExt *eq_r_ns,\n684\t    const FpExt *k_rot_ns,\n685\t    const UnstackedSlice *unstacked_cols,\n686\t    const FpExt *lambda_pows,\n687\t    uint64_t *output, // [S_DEG * D_EF] - atomic accumulator, reduced on CPU\n688\t    uint32_t q_height,\n689\t    uint32_t window_len,\n690\t    uint32_t num_y,\n691\t    uint32_t sm_count\n692\t) {\n693\t    // Smaller block size for more eligible warps to hide latency\n694\t    auto [grid, block] = kernel_launch_params(num_y, 256);\n695\t    assert(sm_count);\n696\t\n697\t    // Heuristic auto-tuning for window-stride (grid.y):\n698\t    // - Increase work per thread (reduce atomics) by targeting multiple window iterations/thread\n699\t    // - Ensure enough total blocks to keep SMs busy when num_y is small\n700\t    constexpr uint32_t WAVES_TARGET = 4; // blocks/SM target\n701\t    constexpr uint32_t ITERS_MIN = 4;    // prefer >= this many window iterations/thread\n702\t    constexpr uint32_t ITERS_MAX = 16;   // prefer <= this many window iterations/thread\n703\t\n704\t    uint32_t stride_occ = div_ceil(sm_count * WAVES_TARGET, grid.x);"}]},"parent_tool_use_id":null,"session_id":"fca59fa0-eca1-4639-8acf-142eae8eef60","uuid":"19525a15-dfe3-4ffa-89f3-faf03793e11a","timestamp":"2026-04-16T14:37:31.864Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/cuda/src/stacked_reduction.cu","content":"}\n\n// (Not a launcher) Utility function to calculate required size of temp buffer.\n// Required length of *block_sums in FpExt elements\n// SP_DEG=1: outputs NUM_G=3 values per z (G0, G1, G2)\nextern \"C\" uint32_t _stacked_reduction_r0_required_temp_buffer_size(\n    uint32_t trace_height,\n    uint32_t trace_width,\n    uint32_t l_skip\n) {\n    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n    return ((grid.x * grid.y) << l_skip) * NUM_G;\n}\n\n// SP_DEG=1: No z_packets needed, outputs G0, G1, G2 on identity coset only.\n// Uses ADD_TO_OUTPUT=true to accumulate into output buffer (for bucket-based accumulation).\nextern \"C\" int _stacked_reduction_sumcheck_round0(\n    const FpExt *eq_r_ns,\n    const Fp *trace_ptr,\n    const FpExt *lambda_pows,\n    FpExt *block_sums,\n    FpExt *output, // length should be NUM_G * skip_domain, ADD to existing values\n    uint32_t trace_height,\n    uint32_t trace_width,\n    uint32_t l_skip,\n    uint32_t num_x\n) {\n    uint32_t skip_domain = 1u << l_skip;\n    uint32_t stride = std::max(skip_domain / trace_height, 1u);\n    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n\n    // Use block.x + 1 stride for shared_sum to avoid bank conflicts\n    // NUM_G=3 outputs per z (G0, G1, G2)\n    size_t shmem_sum_size = sizeof(FpExt) * (block.x + 1) * NUM_G;\n\n    stacked_reduction_round0_block_sum_kernel<<<grid, block, shmem_sum_size>>>(\n        eq_r_ns, trace_ptr, lambda_pows, block_sums,\n        trace_height, trace_width, l_skip,\n        skip_domain - 1, num_x, 31 - __builtin_clz(stride)\n    );\n\n    int err = CHECK_KERNEL();\n    if (err != 0)\n        return err;\n\n    // Launch final reduction kernel - reads from block_sums, ADDs to output\n    auto num_blocks = grid.x * grid.y;\n    auto output_size = NUM_G * skip_domain;\n    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n    size_t reduce_shmem = div_ceil(reduce_block.x, WARP_SIZE) * sizeof(FpExt);\n    sumcheck::final_reduce_block_sums<true>\n        <<<output_size, reduce_block, reduce_shmem>>>(block_sums, output, num_blocks);\n\n    return CHECK_KERNEL();\n}\n\n// Parallelizes barycentric interpolation across 2^l_skip threads per output cell\nextern \"C\" int _stacked_reduction_fold_ple(\n    const Fp *src,\n    FpExt *dst,\n    const Fp *omega_skip_pows,\n    const FpExt *inv_lagrange_denoms,\n    uint32_t trace_height,\n    uint32_t trace_width,\n    uint32_t l_skip\n) {\n    uint32_t skip_domain = 1u << l_skip;\n    uint32_t new_height = std::max(trace_height, skip_domain) / skip_domain;\n\n    // Block size: at least skip_domain, prefer 256 for occupancy\n    uint32_t block_size = std::max(256u, skip_domain);\n    uint32_t chunks_per_block = block_size / skip_domain;\n\n    // 2D grid: x-dim for rows, y-dim for columns\n    dim3 grid(div_ceil(new_height, chunks_per_block), trace_width);\n    dim3 block(block_size);\n\n    // Shared memory for cross-warp reduction (needed when skip_domain > 32)\n    // Each warp in the block needs one FpExt slot for cross-warp reduction\n    uint32_t total_warps_in_block = block_size / WARP_SIZE;\n    size_t smem_bytes = (skip_domain > WARP_SIZE) ? total_warps_in_block * sizeof(FpExt) : 0;\n\n    stacked_reduction_fold_ple_kernel<<<grid, block, smem_bytes>>>(\n        src, dst, omega_skip_pows, inv_lagrange_denoms, trace_height, new_height, skip_domain\n    );\n\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _initialize_k_rot_from_eq_segments(\n    const FpExt *eq_r_ns,\n    FpExt *k_rot_ns,\n    FpExt k_rot_uni_0,\n    FpExt k_rot_uni_1,\n    uint32_t max_n\n) {\n    auto [grid, block] = kernel_launch_params(1 << max_n);\n    grid.y = max_n + 1;\n\n    initialize_k_rot_from_eq_segments_kernel<<<grid, block>>>(\n        eq_r_ns, k_rot_ns, k_rot_uni_0, k_rot_uni_1\n    );\n\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _stacked_reduction_sumcheck_mle_round(\n    const FpExt *const *q_evals,\n    const FpExt *eq_r_ns,\n    const FpExt *k_rot_ns,\n    const UnstackedSlice *unstacked_cols,\n    const FpExt *lambda_pows,\n    uint64_t *output, // [S_DEG * D_EF] - atomic accumulator, reduced on CPU\n    uint32_t q_height,\n    uint32_t window_len,\n    uint32_t num_y,\n    uint32_t sm_count\n) {\n    // Smaller block size for more eligible warps to hide latency\n    auto [grid, block] = kernel_launch_params(num_y, 256);\n    assert(sm_count);\n\n    // Heuristic auto-tuning for window-stride (grid.y):\n    // - Increase work per thread (reduce atomics) by targeting multiple window iterations/thread\n    // - Ensure enough total blocks to keep SMs busy when num_y is small\n    constexpr uint32_t WAVES_TARGET = 4; // blocks/SM target\n    constexpr uint32_t ITERS_MIN = 4;    // prefer >= this many window iterations/thread\n    constexpr uint32_t ITERS_MAX = 16;   // prefer <= this many window iterations/thread\n\n    uint32_t stride_occ = div_ceil(sm_count * WAVES_TARGET, grid.x);","numLines":130,"startLine":575,"totalLines":810}}}
