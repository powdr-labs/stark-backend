ceil(num_y / 256)\n57\t};\n58\t\n59\t__device__ __forceinline__ FpExt get_eq_cube(const FpExt *eq_r_ns, uint32_t cube_size, uint32_t x) {\n60\t    return eq_r_ns[cube_size + x];\n61\t}\n62\t\n63\t__device__ __forceinline__ uint32_t rot_prev(uint32_t x_int, uint32_t cube_size) {\n64\t    return x_int == 0 ? cube_size - 1 : x_int - 1;\n65\t}\n66\t\n67\t__device__ __forceinline__ Fp eq1(Fp x, Fp y) { return Fp::one() - x - y + Fp(2) * x * y; }\n68\t\n69\t__device__ __forceinline__ Fp barycentric_interpolate_strided(\n70\t    const Fp *evals,\n71\t    uint32_t evals_len,\n72\t    uint32_t z,\n73\t    uint32_t expansion_factor,     // large_domain / skip_domain\n74\t    const Fp *inv_lagrange_denoms, // denoms specifically for z\n75\t    const Fp *omega_skip_pows,\n76\t    uint32_t skip_domain\n77\t) {\n78\t    Fp q = Fp::zero();\n79\t    uint32_t stride = evals_len >= skip_domain ? 1 : skip_domain / evals_len;\n80\t    if (z % expansion_factor == 0) {\n81\t        auto i = z / expansion_factor;\n82\t        if (i % stride == 0)\n83\t            q = evals[i / stride];\n84\t    } else {\n85\t        for (int idx = 0; idx < (skip_domain / stride); idx++) {\n86\t            q += evals[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n87\t        }\n88\t    }\n89\t    return q;\n90\t}\n91\t\n92\t// SP_DEG=1 kernel: compute 3 partial sums G0, G1, G2 on identity coset only.\n93\t// No iNTT/NTT operations - reconstruction happens on CPU via NTT-based polynomial multiplication.\n94\t//\n95\t// Each block covers a tile of z-values (threadIdx.x) and collaborates across threads\n96\t// to sum over x for a single column. Blocks stride over columns via gridDim.y.\n97\t//\n98\t// G0(Z) = Σ_{col,x} coeff_eq[col] * eq_cube(x) * q_{col,x}(Z)\n99\t// G1(Z) = Σ_{col,x} coeff_rot[col] * eq_cube(x) * q_{col,x}(Z)"}]},"parent_tool_use_id":null,"session_id":"fca59fa0-eca1-4639-8acf-142eae8eef60","uuid":"c1b26a22-ac1e-40fe-93fc-e95e2251169c","timestamp":"2026-04-16T14:3