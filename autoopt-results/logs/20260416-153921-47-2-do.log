(crate) struct DegenMleDesc {\n    pub col_offset: u32,\n    pub window_len: u32,\n    pub eq_r: EF,\n    pub k_rot_r: EF,\n}\n\n/// Descriptor for batched non-degenerate MLE round kernel. Layout must match CUDA `NonDegenMleDesc`.\n#[repr(C)]\n#[derive(Clone, Copy)]\npub(crate) struct NonDegenMleDesc {\n    pub col_offset: u32,\n    pub window_len: u32,\n    pub num_y: u32,\n    pub stride: u32,\n    pub blocks_x: u32,\n}\n\n/// Number of G outputs per z in round 0: G0, G1, G2\npub const NUM_G: usize = 3;\n\nextern \"C\" {\n    pub fn _stacked_reduction_r0_required_temp_buffer_size(\n        trace_height: u32,\n        trace_width: u32,\n        l_skip: u32,","numLines":40,"startLine":0,"totalLines":413}}}
