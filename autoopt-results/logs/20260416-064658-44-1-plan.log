{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U1ycU76T5EZFQdnSaWhQmk","type":"tool_result","content":"1\t//! Batch MLE evaluation for zerocheck and logup.\n2\t//!\n3\t//! This module provides builders for batching MLE evaluations across multiple AIRs,\n4\t//! enabling efficient GPU kernel launches that process multiple traces in parallel.\n5\t\n6\tuse openvm_cuda_common::{\n7\t    copy::{MemCopyD2H, MemCopyH2D},\n8\t    d_buffer::DeviceBuffer,\n9\t    error::MemCopyError,\n10\t};\n11\tuse openvm_stark_backend::prover::{fractional_sumcheck_gkr::Frac, DeviceMultiStarkProvingKey};\n12\t\n13\tuse crate::{\n14\t    cuda::logup_zerocheck::{\n15\t        _logup_batch_mle_intermediates_buffer_size, _zerocheck_batch_mle_intermediates_buffer_size,\n16\t        logup_batch_eval_mle, zerocheck_batch_eval_mle, BlockCtx, EvalCoreCtx, LogupCtx,\n17\t        MainMatrixPtrs, ZerocheckCtx,\n18\t    },\n19\t    error::KernelError,\n20\t    gpu_backend::GenericGpuBackend,\n21\t    hash_scheme::GpuHashScheme,\n22\t    logup_zerocheck::{\n23\t        batch_mle_monomial::{LogupCombinations, LogupMonomialBatch},\n24\t        mle_round::{evaluate_mle_constraints_gpu, evaluate_mle_interactions_gpu},\n25\t    },\n26\t    prelude::{EF, F},\n27\t};\n28\t\n29\tconst MAX_THREADS_PER_BLOCK: u32 = 128;\n30\t\n31\t// ============================================================================\n32\t// Memory calculation helpers\n33\t// ============================================================================\n34\t\n35\t/// Computes zerocheck intermediate buffer memory in bytes for a trace.\n36\tfn zerocheck_batch_mle_intermediates_buffer_bytes(\n37\t    buffer_size: u32,\n38\t    num_x: u32,\n39\t    num_y: u32,\n40\t) -> usize {\n41\t    unsafe {\n42\t        _zerocheck_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n43\t            * std::mem::size_of::<EF>()\n44\t    }\n45\t}\n46\t\n47\t/// Computes logup intermediate buffer memory in bytes for a trace.\n48\tfn logup_batch_mle_intermediates_buffer_bytes(buffer_size: u32, num_x: u32, num_y: u32) -> usize {\n49\t    unsafe {\n50\t        _logup_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n51\t            * std::mem::size_of::<EF>()\n52\t    }\n53\t}\n54\t\n55\t// ============================================================================\n56\t// Batching helpers\n57\t// ============================================================================\n58\t\n59\t/// Find how many traces fit in the memory budget.\n60\t/// Returns (count, total_memory_of_batch).\n61\tfn find_batch_end<T, M>(traces: &[T], memory_fn: M, memory_limit_bytes: usize) -> (usize, usize)\n62\twhere\n63\t    M: Fn(&T) -> usize,\n64\t{\n65\t    let mut batch_end = 0;\n66\t    let mut batch_memory = 0usize;\n67\t\n68\t    while batch_end < traces.len() {\n69\t        let trace_memory = memory_fn(&traces[batch_end]);\n70\t\n71\t        if batch_end == 0 {\n72\t            // First trace always included (even if oversized)\n73\t            batch_memory = trace_memory;\n74\t            batch_end = 1;\n75\t            if trace_memory > memory_limit_bytes {\n76\t                break; // Single oversized trace\n77\t            }\n78\t        } else if batch_memory + trace_memory <= memory_limit_bytes {\n79\t            batch_memory += trace_memory;\n80\t            batch_end += 1;\n81\t        } else {\n82\t            break; // Would exceed limit\n83\t        }\n84\t    }\n85\t    (batch_end, batch_memory)\n86\t}\n87\t\n88\t/// Context for a single trace used in batch MLE evaluation.\n89\tpub(crate) struct TraceCtx {\n90\t    pub trace_idx: usize,\n91\t    pub air_idx: usize,\n92\t    #[allow(dead_code)]\n93\t    pub n_lift: usize,\n94\t    pub num_y: u32,\n95\t    pub has_constraints: bool,\n96\t    pub has_interactions: bool,\n97\t    pub norm_factor: F,\n98\t    // shared eval pointers (same for zerocheck + logup)\n99\t    pub eq_xi_ptr: *const EF,\n100\t    pub sels_ptr: *const EF,"}]},"parent_tool_use_id":null,"session_id":"fae41bbf-912e-42ee-9c72-17c79e3a14c7","uuid":"7a4228c1-453b-44a8-b85d-b22e6960605d","timestamp":"2026-04-16T05:05:43.776Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/batch_mle.rs","content":"//! Batch MLE evaluation for zerocheck and logup.\n//!\n//! This module provides builders for batching MLE evaluations across multiple AIRs,\n//! enabling efficient GPU kernel launches that process multiple traces in parallel.\n\nuse openvm_cuda_common::{\n    copy::{MemCopyD2H, MemCopyH2D},\n    d_buffer::DeviceBuffer,\n    error::MemCopyError,\n};\nuse openvm_stark_backend::prover::{fractional_sumcheck_gkr::Frac, DeviceMultiStarkProvingKey};\n\nuse crate::{\n    cuda::logup_zerocheck::{\n        _logup_batch_mle_intermediates_buffer_size, _zerocheck_batch_mle_intermediates_buffer_size,\n        logup_batch_eval_mle, zerocheck_batch_eval_mle, BlockCtx, EvalCoreCtx, LogupCtx,\n        MainMatrixPtrs, ZerocheckCtx,\n    },\n    error::KernelError,\n    gpu_backend::GenericGpuBackend,\n    hash_scheme::GpuHashScheme,\n    logup_zerocheck::{\n        batch_mle_monomial::{LogupCombinations, LogupMonomialBatch},\n        mle_round::{evaluate_mle_constraints_gpu, evaluate_mle_interactions_gpu},\n    },\n    prelude::{EF, F},\n};\n\nconst MAX_THREADS_PER_BLOCK: u32 = 128;\n\n// ============================================================================\n// Memory calculation helpers\n// ============================================================================\n\n/// Computes zerocheck intermediate buffer memory in bytes for a trace.\nfn zerocheck_batch_mle_intermediates_buffer_bytes(\n    buffer_size: u32,\n    num_x: u32,\n    num_y: u32,\n) -> usize {\n    unsafe {\n        _zerocheck_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n            * std::mem::size_of::<EF>()\n    }\n}\n\n/// Computes logup intermediate buffer memory in bytes for a trace.\nfn logup_batch_mle_intermediates_buffer_bytes(buffer_size: u32, num_x: u32, num_y: u32) -> usize {\n    unsafe {\n        _logup_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n            * std::mem::size_of::<EF>()\n    }\n}\n\n// ============================================================================\n// Batching helpers\n// ============================================================================\n\n/// Find how many traces fit in the memory budget.\n/// Returns (count, total_memory_of_batch).\nfn find_batch_end<T, M>(traces: &[T], memory_fn: M, memory_limit_bytes: usize) -> (usize, usize)\nwhere\n    M: Fn(&T) -> usize,\n{\n    let mut batch_end = 0;\n    let mut batch_memory = 0usize;\n\n    while batch_end < traces.len() {\n        let trace_memory = memory_fn(&traces[batch_end]);\n\n        if batch_end == 0 {\n            // First trace always included (even if oversized)\n            batch_memory = trace_memory;\n            batch_end = 1;\n            if trace_memory > memory_limit_bytes {\n                break; // Single oversized trace\n            }\n        } else if batch_memory + trace_memory <= memory_limit_bytes {\n            batch_memory += trace_memory;\n            batch_end += 1;\n        } else {\n            break; // Would exceed limit\n        }\n    }\n    (batch_end, batch_memory)\n}\n\n/// Context for a single trace used in batch MLE evaluation.\npub(crate) struct TraceCtx {\n    pub trace_idx: usize,\n    pub air_idx: usize,\n    #[allow(dead_code)]\n    pub n_lift: usize,\n    pub num_y: u32,\n    pub has_constraints: bool,\n    pub has_interactions: bool,\n    pub norm_factor: F,\n    // shared eval pointers (same for zerocheck + logup)\n    pub eq_xi_ptr: *const EF,\n    pub sels_ptr: *const EF,","numLines":100,"startLine":1,"totalLines":736}}}
