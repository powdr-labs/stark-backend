               .map(|cd| cd.data.clone())\n160\t            })\n161\t            .collect();\n162\t\n163\t        let mut stacked_per_commit = vec![&common_main_pcs_data];\n164\t        for data in &pre_cached_pcs_data_per_commit {\n165\t            stacked_per_commit.push(data);\n166\t        }\n167\t        #[cfg(debug_assertions)]\n168\t        {\n169\t            let total_stacked_width: usize =\n170\t                stacked_per_commit.iter().map(|d| d.layout.width()).sum();\n171\t            debug_assert!(\n172\t                total_stacked_width <= params.w_stack,\n173\t                \"total stacked width across commits ({total_stacked_width}) exceeds w_stack ({})\",\n174\t                params.w_stack\n175\t            );\n176\t        }\n177\t\n178\t        let mut need_rot_per_commit = vec![need_rot_per_trace];\n179\t        for (air_idx, trace_ctx) in &ctx.per_trace {\n180\t            let need_rot = mpk.per_air[*air_idx].vk.params.need_rot;\n181\t            if mpk.per_air[*air_idx].preprocessed_data.is_some() {\n182\t                need_rot_per_commit.push(vec![need_rot]);\n183\t            }\n184\t            for _ in &trace_ctx.cached_mains {\n185\t                need_rot_per_commit.push(vec![need_rot]);\n186\t            }\n187\t        }\n188\t        let (stacking_proof, u_prisma) =\n189\t            prove_stacked_opening_reduction::<SC, _, _, _, StackedReductionCpu<SC>>(\n190\t                self,\n191\t                transcript,\n192\t                params.n_stack,\n193\t                stacked_per_commit,\n194\t                need_rot_per_commit,\n195\t                &r,\n196\t            );\n197\t\n198\t        let (&u0, u_rest) = u_prisma\n199\t            .split_first()\n200\t            .ok_or(crate::prover::error::WhirProverError::UPrismaEmpty)?;\n201\t        let u_cube = u0\n202\t            .exp_powers_of_2()\n203\t            .take(params.l_skip)\n204\t            .chain(u_rest.iter().copied())\n205\t            .collect_vec();\n206\t\n207\t        let whir_proof = self.prove_whir(\n208\t            transcript,\n209\t            common_main_pcs_data,\n210\t            pre_cached_pcs_data_per_commit,\n211\t            &u_cube,\n212\t        )?;\n213\t        Ok((stacking_proof, whir_proof))\n214\t    }\n215\t}\n216\t\n217\timpl<SC: StarkProtocolConfig> DeviceDataTransporter<SC, CpuColMajorBackend<SC>>\n218\t    for ReferenceDevice<SC>\n219\t{\n220\t    fn transport_pk_to_device(\n221\t        &self,\n222\t        mpk: &MultiStarkProvingKey<SC>,\n223\t    ) -> DeviceMultiStarkProvingKey<CpuColMajorBackend<SC>> {\n224\t        let per_air = mpk\n225\t            .per_air\n226\t            .iter()\n227\t            .map(|pk| {\n228\t                let preprocessed_data = pk.preprocessed_data.as_ref().map(|d| {\n229\t                    let trace = d.mat_view(0).to_matrix();\n230\t                    CommittedTraceData {\n231\t                        commitment: d.commit().unwrap(),\n232\t                        trace,\n233\t                        data: d.clone(),\n234\t                    }\n235\t                });\n236\t                DeviceStarkProvingKey {\n237\t                    air_name: pk.air_name.clone(),\n238\t                    vk: pk.vk.clone(),\n239\t                    preprocessed_data,\n240\t                    other_data: (),\n241\t                }\n242\t            })\n243\t            .collect();\n244\t        DeviceMultiStarkProvingKey::new(\n245\t            per_air,\n246\t            mpk.trace_height_constraints.clone(),\n247\t            mpk.max_constraint_degree,\n248\t            mpk.params.clone(),\n249\t            mpk.vk_pre_hash,\n250\t        )\n251\t    }\n252\t\n253\t    fn transport_matrix_to_device(&self, matrix: &ColMajorMatrix<SC::F>) -> ColMajorMatrix<SC::F> {\n254\t        matrix.clone()\n255\t    }\n256\t\n257\t    fn transport_pcs_data_to_device(\n258\t        &self,\n259\t        pcs_data: &StackedPcsData<SC::F, SC::Digest>,\n260\t    ) -> Stac