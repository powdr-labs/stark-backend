{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Py2CwqjGXLdgEgyNb7TpxJ","type":"tool_result","content":"1\t#pragma once\n2\t\n3\t#include \"fp.h\"\n4\t#include \"utils.cuh\"\n5\t#include <cstdint>\n6\t\n7\tnamespace device_ntt {\n8\t\n9\t// ============================================================================\n10\t// Precomputed Twiddle Tables in Constant Memory\n11\t// ============================================================================\n12\t//\n13\t// Layout: twiddles for level L contain omega_L^i for i in [0, 2^L)\n14\t// where omega_L = TWO_ADIC_GENERATORS[L].\n15\t//\n16\t// Twiddles for level L (1 <= L <= MAX_NTT_LEVEL) start at offset (2^L - 2).\n17\t// Total size: sum(2^i for i=1..MAX_NTT_LEVEL) = 2^(MAX_NTT_LEVEL+1) - 2\n18\t//\n19\t// For MAX_NTT_LEVEL=10: 2^11 - 2 = 2046 elements * 4 bytes = ~8KB\n20\t\n21\tconstexpr uint32_t MAX_NTT_LEVEL = 10;\n22\tconstexpr uint32_t DEVICE_NTT_TWIDDLES_SIZE = (1u << (MAX_NTT_LEVEL + 1)) - 2;\n23\t\n24\t// Constant memory for precomputed twiddles\n25\textern __constant__ Fp DEVICE_NTT_TWIDDLES[DEVICE_NTT_TWIDDLES_SIZE];\n26\t\n27\t// Get offset into DEVICE_NTT_TWIDDLES for level L (L >= 1)\n28\t__device__ __host__ __forceinline__ constexpr uint32_t twiddle_offset(uint32_t level) {\n29\t    return (1u << level) - 2;\n30\t}\n31\t\n32\t// Get precomputed twiddle: omega_level^index\n33\t// Requires: level >= 1 && level <= MAX_NTT_LEVEL && index < 2^level\n34\t__device__ __forceinline__ Fp get_twiddle(uint32_t level, uint32_t index) {\n35\t    return DEVICE_NTT_TWIDDLES[twiddle_offset(level) + index];\n36\t}\n37\t\n38\ttemplate <bool intt> __device__ __forceinline__ Fp sum_or_semi_sum(Fp &&x) {\n39\t    if constexpr (intt) {\n40\t        return x.halve();\n41\t    } else {\n42\t        return x;\n43\t    }\n44\t}\n45\t\n46\t// Reusable device function for entirely on-device NTT of size `2^l_skip`.\n47\t// Uses shared memory for sizes > warp, warp shuffles for sizes <= warp.\n48\t//\n49\t// Decimation in frequency NTT: natural order to bit reversed order.\n50\t//\n51\t// Uses exactly `2^l_skip` threads, and `this_thread_value` will be set with the output of the NTT.\n52\t// The input should be the evaluation at `omega^i`.\n53\t// - If `needs_shmem` is true, then `sbuf[i]` must already contain the input.\n54\t// - If `needs_shmem` is false, then `this_thread_value` must already contain the input.\n55\t//\n56\t// `active_thread` indicates whether this thread has valid data; inactive threads still participate in syncs.\n57\t//\n58\t// # Assumption\n59\t// - No warp has exited early before this call. We use the full `0xffffffff` mask.\n60\ttemplate <bool intt, bool needs_shmem>\n61\t__device__ __forceinline__ void ntt_natural_to_bitrev(\n62\t    Fp &this_thread_value,\n63\t    Fp *__restrict__ sbuf, // shared memory buffer for this thread's NTT (size 1 << l_skip)\n64\t    uint32_t const i,      // thread index within NTT [0, 1 << l_skip)\n65\t    uint32_t const l_skip, // log2 of NTT size\n66\t    bool const active_thread = true\n67\t) {\n68\t    uint32_t log_interwarp;\n69\t    if constexpr (needs_shmem) {\n70\t        log_interwarp = LOG_WARP_SIZE;\n71\t    } else {\n72\t        log_interwarp = l_skip;\n73\t    }\n74\t    // reverse index for iNTT to get the inverse twiddle\n75\t    uint32_t const twiddle_idx = intt ? (i ? (1 << l_skip) - i : 0) : i;\n76\t    Fp twiddle = get_twiddle(l_skip, twiddle_idx);\n77\t\n78\t    // Shared memory phase (for l_skip > LOG_WARP_SIZE)\n79\t    if constexpr (needs_shmem) {\n80\t        for (uint32_t log_len = l_skip; log_len-- > LOG_WARP_SIZE;) {\n81\t            if (active_thread) {\n82\t                uint32_t const len = 1u << log_len;\n83\t                if (!(i & len)) {\n84\t                    Fp const sum = sbuf[i];\n85\t                    Fp const diff = sbuf[i + len];\n86\t                    sbuf[i] = sum_or_semi_sum<intt>(sum + diff);\n87\t                    sbuf[i + len] = sum_or_semi_sum<intt>(sum - diff) * twiddle;\n88\t                }\n89\t                twiddle *= twiddle;\n90\t            }\n91\t            __syncthreads();\n92\t        }\n93\t        this_thread_value = sbuf[i];\n94\t    }\n95\t    // Warp shuffle phase (for remaining log_interwarp levels)\n96\t    for (uint32_t log_len = log_interwarp; log_len-- > 0;) {\n97\t        uint32_t const len = 1u << log_len;\n98\t        Fp const other_value =\n99\t            Fp::fromRaw(__shfl_xor_sync(0xffffffff, this_thread_value.asRaw(), len));\n100\t        if (!(i & len)) {\n101\t            // this_thread_value = sum, other_value = diff\n102\t            this_thread_value = sum_or_semi_sum<intt>(this_thread_value + other_value);\n103\t        } else {\n104\t            // this_thread_value = diff, other_value = sum\n105\t            this_thread_value = sum_or_semi_sum<intt>(this_thread_value - other_value) * twiddle;\n106\t        }\n107\t        twiddle *= twiddle;\n108\t    }\n109\t}\n110\t\n111\t// Decimation in time NTT: bit reversed order to natural order.\n112\t//\n113\t// Uses exactly `2^l_skip` threads, and `this_thread_value` will be set with the output of the NTT.\n114\t// For both `needs_shmem` equals `true` and `false`, `this_thread_value` must already contain the input, which should be the `rev_len(i, l_skip)`-th element.\n115\t//\n116\t// # Assumption\n117\t// - No warp has exited early before this call. We use the full `0xffffffff` mask.\n118\ttemplate <bool intt, bool needs_shmem>\n119\t__device__ __forceinline__ void ntt_bitrev_to_natural(\n120\t    Fp &this_thread_value,\n121\t    Fp *__restrict__ sbuf,\n122\t    uint32_t const i,\n123\t    uint32_t const l_skip\n124\t) {\n125\t    uint32_t const warp_levels = needs_shmem ? LOG_WARP_SIZE : l_skip;\n126\t\n127\t    // Warp shuffle phase: levels 0 to warp_levels-1 (small to large)\n128\t    for (uint32_t m = 0; m < warp_levels; m++) {\n129\t        uint32_t const len = 1u << m;\n130\t        // Twiddle for DIT: primitive 2^(m+1)-th root raised to (i & (len-1))\n131\t        uint32_t j = i & (len - 1);\n132\t        if constexpr (intt)\n133\t            j = j ? ((2u << m) - j) : 0;\n134\t        Fp twiddle = get_twiddle(m + 1, j);\n135\t\n136\t        Fp other = Fp::fromRaw(__shfl_xor_sync(0xffffffff, this_thread_value.asRaw(), len));\n137\t\n138\t        if (i & len) {\n139\t            // Bottom: result = a - b * twiddle\n140\t            Fp b_tw = this_thread_value * twiddle;\n141\t            this_thread_value = sum_or_semi_sum<intt>(other - b_tw);\n142\t        } else {\n143\t            // Top: result = a + b * twiddle\n144\t            Fp b_tw = other * twiddle;\n145\t            this_thread_value = sum_or_semi_sum<intt>(this_thread_value + b_tw);\n146\t        }\n147\t    }\n148\t\n149\t    // Shared memory phase: levels LOG_WARP_SIZE to l_skip-1\n150\t    if constexpr (needs_shmem) {\n151\t        sbuf[i] = this_thread_value;\n152\t        __syncthreads();\n153\t\n154\t        for (uint32_t m = LOG_WARP_SIZE; m < l_skip; m++) {\n155\t            uint32_t const len = 1u << m;\n156\t            uint32_t j = i & (len - 1);\n157\t            if constexpr (intt)\n158\t                j = j ? ((2u << m) - j) : 0;\n159\t            Fp twiddle = get_twiddle(m + 1, j);\n160\t\n161\t            if (!(i & len)) {\n162\t                Fp a = sbuf[i];\n163\t                Fp b_tw = sbuf[i + len] * twiddle;\n164\t                sbuf[i] = sum_or_semi_sum<intt>(a + b_tw);\n165\t                sbuf[i + len] = sum_or_semi_sum<intt>(a - b_tw);\n166\t            }\n167\t            __syncthreads();\n168\t        }\n169\t        this_thread_value = sbuf[i];\n170\t    }\n171\t}\n172\t\n173\t} // namespace device_ntt\n174\t"}]},"parent_tool_use_id":"toolu_013TAmRjFGtMgqpckjApbrer","session_id":"fae41bbf-912e-42ee-9c72-17c79e3a14c7","uuid":"07c0eb43-b96f-487a-974c-6cb0982d3e5f","timestamp":"2026-04-16T08:06:42.135Z"}
