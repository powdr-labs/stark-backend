                 has_interactions,\n1758\t                    norm_factor,\n1759\t                });\n1760\t                total_interp_elems += interp_size;\n1761\t            }\n1762\t        }\n1763\t\n1764\t        // ── Phase 2: Batch allocate + single kernel launch ──\n1765\t        // One big buffer for all interpolated data, one kernel launch for all Case B traces.\n1766\t        let _keepalive_interpolated = if !case_b_traces.is_empty() {\n1767\t            let big_buf = DeviceBuffer::<EF>::with_capacity(total_interp_elems);\n1768\t            let big_ptr = big_buf.as_mut_ptr();\n1769\t\n1770\t            // Build descriptors with multi-block-per-trace assignment\n1771\t            const THREADS_PER_BLOCK: u32 = 512;\n1772\t            let mut block_offset: u32 = 0;\n1773\t            let descs: Vec<InterpTraceDescM> = case_b_traces\n1774\t                .iter()\n1775\t                .map(|meta| {\n1776\t                    let total_threads = (meta.num_y * meta.num_columns) as u32;\n1777\t                    let blocks = total_threads.div_ceil(THREADS_PER_BLOCK);\n1778\t                    let desc = InterpTraceDescM {\n1779\t                        output: unsafe { big_ptr.add(meta.interp_offset) },\n1780\t                        matrix_offset: meta.matrix_offset as u32,\n1781\t                        num_matrices: meta.num_matrices as u32,\n1782\t                        num_y: meta.num_y as u32,\n1783\t                        num_columns: meta.num_columns as u32,\n1784\t                        total_threads,\n1785\t                        block_start: block_offset,\n1786\t                    };\n1787\t                    block_offset += blocks;\n1788\t                    desc\n1789\t                })\n1790\t                .collect();\n1791\t            let total_blocks = block_offset as usize;\n1792\t\n1793\t            let d_matrices = all_matrices.to_device()?;\n1794\t            let d_descs = descs.to_device()?;\n1795\t            unsafe {\n1796\t                batched_interpolate_columns_matrix_gpu(\n1797\t                    &d_descs,\n1798\t                    &d_matrices,\n1799\t                    sp_deg,\n1800\t                    total_blocks,\n1801\t                )\n1802\t                .map_err(|e| LogupZerocheckError::InterpolateColumns(e.into()))?;\n1803\t            }\n1804\t\n1805\t            Some(big_buf)\n1806\t        } else {\n1807\t            None\n1808\t        };\n1809\t\n1810\t        // ── Phase 3: Build TraceCtx for each Case B trace ──\n1811\t        for meta in &case_b_traces {\n1812\t            let mats = &self.mat_evals_per_trace[meta.trace_idx];\n1813\t            let first_main_idx = usize::from(meta.has_preprocessed);\n1814\t            let eq_xi_tree = &self.eq_xis[&meta.n_lift];\n1815\t            let log_num_y = meta.n_lift - round;\n1816\t            let interpolated_height = sp_deg * meta.num_y;\n1817\t\n1818\t            let base_ptr = _keepalive_interpolated\n1819\t                .as_ref()"}]},"parent_tool_use_id":"toolu_018v8Gcdse3Q5hdsnfcAeYbS","session_id":"fae41bbf-912e-42ee-9c72-17c79e3a14c7","uuid":"5d3dfe55-9a60-4198-9844-ddd976da179f","timestamp":"2026-04-16T04:54:36.409Z"}
