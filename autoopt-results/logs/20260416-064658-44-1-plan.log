{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M6u35opzVoHicUqALKpEar","type":"tool_result","content":"1\t//! Batch MLE evaluation for zerocheck and logup.\n2\t//!\n3\t//! This module provides builders for batching MLE evaluations across multiple AIRs,\n4\t//! enabling efficient GPU kernel launches that process multiple traces in parallel.\n5\t\n6\tuse openvm_cuda_common::{\n7\t    copy::{MemCopyD2H, MemCopyH2D},\n8\t    d_buffer::DeviceBuffer,\n9\t    error::MemCopyError,\n10\t};\n11\tuse openvm_stark_backend::prover::{fractional_sumcheck_gkr::Frac, DeviceMultiStarkProvingKey};\n12\t\n13\tuse crate::{\n14\t    cuda::logup_zerocheck::{\n15\t        _logup_batch_mle_intermediates_buffer_size, _zerocheck_batch_mle_intermediates_buffer_size,\n16\t        logup_batch_eval_mle, zerocheck_batch_eval_mle, BlockCtx, EvalCoreCtx, LogupCtx,\n17\t        MainMatrixPtrs, ZerocheckCtx,\n18\t    },\n19\t    error::KernelError,\n20\t    gpu_backend::GenericGpuBackend,\n21\t    hash_scheme::GpuHashScheme,\n22\t    logup_zerocheck::{\n23\t        batch_mle_monomial::{LogupCombinations, LogupMonomialBatch},\n24\t        mle_round::{evaluate_mle_constraints_gpu, evaluate_mle_interactions_gpu},\n25\t    },\n26\t    prelude::{EF, F},\n27\t};\n28\t\n29\tconst MAX_THREADS_PER_BLOCK: u32 = 128;\n30\t\n31\t// ============================================================================\n32\t// Memory calculation helpers\n33\t// ============================================================================\n34\t\n35\t/// Computes zerocheck intermediate buffer memory in bytes for a trace.\n36\tfn zerocheck_batch_mle_intermediates_buffer_bytes(\n37\t    buffer_size: u32,\n38\t    num_x: u32,\n39\t    num_y: u32,\n40\t) -> usize {\n41\t    unsafe {\n42\t        _zerocheck_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n43\t            * std::mem::size_of::<EF>()\n44\t    }\n45\t}\n46\t\n47\t/// Computes logup intermediate buffer memory in bytes for a trace.\n48\tfn logup_batch_mle_intermediates_buffer_bytes(buffer_size: u32, num_x: u32, num_y: u32) -> usize {\n49\t    unsafe {\n50\t        _logup_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n51\t            * std::mem::size_of::<EF>()\n52\t    }\n53\t}\n54\t\n55\t// ============================================================================\n56\t// Batching helpers\n57\t// ============================================================================\n58\t\n59\t/// Find how many traces fit in the memory budget.\n60\t/// Returns (count, total_memory_of_batch).\n61\tfn find_batch_end<T, M>(traces: &[T], memory_fn: M, memory_limit_bytes: usize) -> (usize, usize)\n62\twhere\n63\t    M: Fn(&T) -> usize,\n64\t{\n65\t    let mut batch_end = 0;\n66\t    let mut batch_memory = 0usize;\n67\t\n68\t    while batch_end < traces.len() {\n69\t        let trace_memory = memory_fn(&traces[batch_end]);\n70\t\n71\t        if batch_end == 0 {\n72\t            // First trace always included (even if oversized)\n73\t            batch_memory = trace_memory;\n74\t            batch_end = 1;\n75\t            if trace_memory > memory_limit_bytes {\n76\t                break; // Single oversized trace\n77\t            }\n78\t        } else if batch_memory + trace_memory <= memory_limit_bytes {\n79\t            batch_memory += trace_memory;\n80\t            batch_end += 1;\n81\t        } else {\n82\t            break; // Would exceed limit\n83\t        }\n84\t    }\n85\t    (batch_end, batch_memory)\n86\t}\n87\t\n88\t/// Context for a single trace used in batch MLE evaluation.\n89\tpub(crate) struct TraceCtx {\n90\t    pub trace_idx: usize,\n91\t    pub air_idx: usize,\n92\t    #[allow(dead_code)]\n93\t    pub n_lift: usize,\n94\t    pub num_y: u32,\n95\t    pub has_constraints: bool,\n96\t    pub has_interactions: bool,\n97\t    pub norm_factor: F,\n98\t    // shared eval pointers (same for zerocheck + logup)\n99\t    pub eq_xi_ptr: *const EF,\n100\t    pub sels_ptr: *const EF,\n101\t    pub prep_ptr: MainMatrixPtrs<EF>,\n102\t    pub main_ptrs_dev: DeviceBuffer<MainMatrixPtrs<EF>>,\n103\t    pub public_ptr: *const F,\n104\t    pub eq_3bs_ptr: *const EF,\n105\t}\n106\t\n107\t// NOTE[jpw]: we do not expect to use this since most of the time zerocheck will use monomial_par_y.\n108\t// We use DAG evaluation primarily for Poseidon2Air. Consider deleting either the non-batch or batch\n109\t// dag version to reduce code duplication.\n110\t/// Builder for batched zerocheck MLE evaluation.\n111\t///\n112\t/// Collects traces and pre-builds all GPU contexts, then evaluates in a single kernel launch.\n113\tpub(crate) struct ZerocheckMleBatchBuilder<'a> {\n114\t    traces: Vec<&'a TraceCtx>,\n115\t    d_block_ctxs: DeviceBuffer<BlockCtx>,\n116\t    d_zc_ctxs: DeviceBuffer<ZerocheckCtx>,\n117\t    air_offsets: DeviceBuffer<u32>,\n118\t    threads_per_block: u32,\n119\t    _intermediates_keepalive: Vec<DeviceBuffer<EF>>,\n120\t}\n121\t\n122\timpl<'a> ZerocheckMleBatchBuilder<'a> {\n123\t    /// Creates a new builder from an iterator of traces.\n124\t    ///\n125\t    /// This constructor filters traces with constraints, computes thread configuration,\n126\t    /// builds all block and zerocheck contexts, and uploads them to the device.\n127\t    pub fn new<HS: GpuHashScheme>(\n128\t        traces: impl Iterator<Item = &'a TraceCtx>,\n129\t        pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n130\t        num_x: u32,\n131\t    ) -> Result<Self, MemCopyError> {\n132\t        let traces: Vec<&TraceCtx> = traces.filter(|t| t.has_constraints).collect();\n133\t\n134\t        if traces.is_empty() {\n135\t            return Ok(Self {\n136\t                traces: vec![],\n137\t                d_block_ctxs: DeviceBuffer::new(),\n138\t                d_zc_ctxs: DeviceBuffer::new(),\n139\t                air_offsets: DeviceBuffer::new(),\n140\t                threads_per_block: 0,\n141\t                _intermediates_keepalive: vec![],\n142\t            });\n143\t        }\n144\t\n145\t        // Compute threads_per_block from max_num_y\n146\t        let max_num_y = traces.iter().map(|t| t.num_y).max().unwrap_or(0);\n147\t        let threads_per_block = max_num_y.min(MAX_THREADS_PER_BLOCK);\n148\t\n149\t        // Build block_ctxs and air_offsets\n150\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();\n151\t        let mut air_offsets: Vec<u32> = Vec::with_capacity(traces.len() + 1);\n152\t        air_offsets.push(0);\n153\t\n154\t        for (local_air, t) in traces.iter().enumerate() {\n155\t            let nb = t.num_y.div_ceil(threads_per_block);\n156\t            for b in 0..nb {\n157\t                block_ctxs_h.push(BlockCtx {\n158\t                    local_block_idx_x: b,\n159\t                    air_idx: local_air as u32,\n160\t                });\n161\t            }\n162\t            air_offsets.push(block_ctxs_h.len() as u32);\n163\t        }\n164\t\n165\t        // Build ZerocheckCtx for each trace\n166\t        let mut intermediates_keepalive: Vec<DeviceBuffer<EF>> = Vec::new();\n167\t        let mut zc_ctxs_h: Vec<ZerocheckCtx> = Vec::with_capacity(traces.len());\n168\t\n169\t        for t in traces.iter() {\n170\t            let air_pk = &pk.per_air[t.air_idx];\n171\t            let buffer_size = air_pk.other_data.zerocheck_mle.inner.buffer_size;\n172\t\n173\t            let d_intermediates = if buffer_size > 0 {\n174\t                let intermediates_len = unsafe {\n175\t                    _zerocheck_batch_mle_intermediates_buffer_size(buffer_size, num_x, t.num_y)\n176\t                };\n177\t                let buf = DeviceBuffer::<EF>::with_capacity(intermediates_len);\n178\t                let ptr = buf.as_mut_ptr();\n179\t                intermediates_keepalive.push(buf);\n180\t                ptr\n181\t            } else {\n182\t                std::ptr::null_mut()\n183\t            };\n184\t\n185\t            let eval_ctx = EvalCoreCtx {\n186\t                d_selectors: t.sels_ptr,\n187\t                d_preprocessed: t.prep_ptr,\n188\t                d_main: t.main_ptrs_dev.as_ptr(),\n189\t                d_public: t.public_ptr,\n190\t            };\n191\t\n192\t            zc_ctxs_h.push(ZerocheckCtx {\n193\t                eval_ctx,\n194\t                d_intermediates,\n195\t                num_y: t.num_y,\n196\t                d_eq_xi: t.eq_xi_ptr,\n197\t                d_rules: air_pk.other_data.zerocheck_mle.inner.d_rules.as_raw_ptr(),\n198\t                rules_len: air_pk.other_data.zerocheck_mle.inner.d_rules.len(),\n199\t                d_used_nodes: air_pk.other_data.zerocheck_mle.inner.d_used_nodes.as_ptr(),\n200\t                used_nodes_len: air_pk.other_data.zerocheck_mle.inner.d_used_nodes.len(),\n201\t                buffer_size,\n202\t            });\n203\t        }\n204\t\n205\t        // Upload to device\n206\t        let d_block_ctxs = block_ctxs_h.to_device()?;\n207\t        let d_zc_ctxs = zc_ctxs_h.to_device()?;\n208\t        let air_offsets = air_offsets.to_device()?;\n209\t\n210\t        Ok(Self {\n211\t            traces,\n212\t            d_block_ctxs,\n213\t            d_zc_ctxs,\n214\t            air_offsets,\n215\t            threads_per_block,\n216\t            _intermediates_keepalive: intermediates_keepalive,\n217\t        })\n218\t    }\n219\t\n220\t    /// Returns true if there are no traces to evaluate.\n221\t    #[allow(dead_code)]\n222\t    pub fn is_empty(&self) -> bool {\n223\t        self.traces.is_empty()\n224\t    }\n225\t\n226\t    /// Returns the trace indices in order.\n227\t    pub fn trace_indices(&self) -> impl Iterator<Item = usize> + '_ {\n228\t        self.traces.iter().map(|t| t.trace_idx)\n229\t    }\n230\t\n231\t    /// Evaluates the batch and returns the output device buffer.\n232\t    ///\n233\t    /// The buffer contains `num_airs * num_x` elements, laid out as\n234\t    /// `[air0_x0, air0_x1, ..., air1_x0, air1_x1, ...]`.\n235\t    pub fn evaluate(\n236\t        &self,\n237\t        lambda_pows: &DeviceBuffer<EF>,\n238\t        num_x: u32,\n239\t    ) -> Result<DeviceBuffer<EF>, KernelError> {\n240\t        if self.traces.is_empty() {\n241\t            return Ok(DeviceBuffer::new());\n242\t        }\n243\t\n244\t        evaluate_mle_constraints_gpu_batch(\n245\t            &self.d_block_ctxs,\n246\t            &self.d_zc_ctxs,\n247\t            &self.air_offsets,\n248\t            lambda_pows,\n249\t            lambda_pows.len(),\n250\t            num_x,\n251\t            self.threads_per_block,\n252\t        )\n253\t    }\n254\t}\n255\t\n256\t/// Builder for batched logup MLE evaluation.\n257\t///\n258\t/// Collects traces and pre-builds all GPU contexts, then evaluates in a single kernel launch.\n259\tpub(crate) struct LogupMleBatchBuilder<'a> {\n260\t    traces: Vec<&'a TraceCtx>,\n261\t    d_block_ctxs: DeviceBuffer<BlockCtx>,\n262\t    d_logup_ctxs: DeviceBuffer<LogupCtx>,\n263\t    air_offsets: DeviceBuffer<u32>,\n264\t    threads_per_block: u32,\n265\t    _intermediates_keepalive: Vec<DeviceBuffer<EF>>,\n266\t}\n267\t\n268\timpl<'a> LogupMleBatchBuilder<'a> {\n269\t    /// Creates a new builder from an iterator of traces.\n270\t    ///\n271\t    /// This constructor filters traces with interactions, computes thread configuration,\n272\t    /// builds all block and logup contexts, and uploads them to the device.\n273\t    pub fn new<HS: GpuHashScheme>(\n274\t        traces: impl Iterator<Item = &'a TraceCtx>,\n275\t        pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n276\t        d_challenges_ptr: *const EF,\n277\t        num_x: u32,\n278\t    ) -> Result<Self, MemCopyError> {\n279\t        let traces: Vec<&TraceCtx> = traces.filter(|t| t.has_interactions).collect();\n280\t\n281\t        if traces.is_empty() {\n282\t            return Ok(Self {\n283\t                traces: vec![],\n284\t                d_block_ctxs: DeviceBuffer::new(),\n285\t                d_logup_ctxs: DeviceBuffer::new(),\n286\t                air_offsets: DeviceBuffer::new(),\n287\t                threads_per_block: 0,\n288\t                _intermediates_keepalive: vec![],\n289\t            });\n290\t        }\n291\t\n292\t        // Compute threads_per_block from max_num_y\n293\t        let max_num_y = traces.iter().map(|t| t.num_y).max().unwrap_or(0);\n294\t        let threads_per_block = max_num_y.min(MAX_THREADS_PER_BLOCK);\n295\t\n296\t        // Build block_ctxs and air_offsets\n297\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();\n298\t        let mut air_offsets: Vec<u32> = Vec::with_capacity(traces.len() + 1);\n299\t        air_offsets.push(0);\n300\t\n301\t        for (local_air, t) in traces.iter().enumerate() {\n302\t            let nb = t.num_y.div_ceil(threads_per_block);\n303\t            for b in 0..nb {\n304\t                block_ctxs_h.push(BlockCtx {\n305\t                    local_block_idx_x: b,\n306\t                    air_idx: local_air as u32,\n307\t                });\n308\t            }\n309\t            air_offsets.push(block_ctxs_h.len() as u32);\n310\t        }\n311\t\n312\t        // Build LogupCtx for each trace\n313\t        let mut intermediates_keepalive: Vec<DeviceBuffer<EF>> = Vec::new();\n314\t        let mut logup_ctxs_h: Vec<LogupCtx> = Vec::with_capacity(traces.len());\n315\t\n316\t        for t in traces.iter() {\n317\t            let air_pk = &pk.per_air[t.air_idx];\n318\t            let buffer_size = air_pk.other_data.interaction_rules.inner.buffer_size;\n319\t\n320\t            let d_intermediates = if buffer_size > 0 {\n321\t                let intermediates_len = unsafe {\n322\t                    _logup_batch_mle_intermediates_buffer_size(buffer_size, num_x, t.num_y)\n323\t                };\n324\t                let buf = DeviceBuffer::<EF>::with_capacity(intermediates_len);\n325\t                let ptr = buf.as_mut_ptr();\n326\t                intermediates_keepalive.push(buf);\n327\t                ptr\n328\t            } else {\n329\t                std::ptr::null_mut()\n330\t            };\n331\t\n332\t            let eval_ctx = EvalCoreCtx {\n333\t                d_selectors: t.sels_ptr,\n334\t                d_preprocessed: t.prep_ptr,\n335\t                d_main: t.main_ptrs_dev.as_ptr(),\n336\t                d_public: t.public_ptr,\n337\t            };\n338\t\n339\t            logup_ctxs_h.push(LogupCtx {\n340\t                eval_ctx,\n341\t                d_intermediates,\n342\t                num_y: t.num_y,\n343\t                d_eq_xi: t.eq_xi_ptr,\n344\t                d_challenges: d_challenges_ptr,\n345\t                d_eq_3bs: t.eq_3bs_ptr,\n346\t                d_rules: air_pk\n347\t                    .other_data\n348\t                    .interaction_rules\n349\t                    .inner\n350\t                    .d_rules\n351\t                    .as_raw_ptr(),\n352\t                rules_len: air_pk.other_data.interaction_rules.inner.d_rules.len(),\n353\t                d_used_nodes: air_pk\n354\t                    .other_data\n355\t                    .interaction_rules\n356\t                    .inner\n357\t                    .d_used_nodes\n358\t                    .as_ptr(),\n359\t                d_pair_idxs: air_pk.other_data.interaction_rules.d_pair_idxs.as_ptr(),\n360\t                used_nodes_len: air_pk.other_data.interaction_rules.inner.d_used_nodes.len(),\n361\t                buffer_size,\n362\t            });\n363\t        }\n364\t\n365\t        // Upload to device\n366\t        let d_block_ctxs = block_ctxs_h.to_device()?;\n367\t        let d_logup_ctxs = logup_ctxs_h.to_device()?;\n368\t        let air_offsets = air_offsets.to_device()?;\n369\t\n370\t        Ok(Self {\n371\t            traces,\n372\t            d_block_ctxs,\n373\t            d_logup_ctxs,\n374\t            air_offsets,\n375\t            threads_per_block,\n376\t            _intermediates_keepalive: intermediates_keepalive,\n377\t        })\n378\t    }\n379\t\n380\t    /// Returns true if there are no traces to evaluate.\n381\t    #[allow(dead_code)]\n382\t    pub fn is_empty(&self) -> bool {\n383\t        self.traces.is_empty()\n384\t    }\n385\t\n386\t    /// Returns the trace indices and norm factors in order.\n387\t    pub fn trace_info(&self) -> impl Iterator<Item = (usize, F)> + '_ {\n388\t        self.traces.iter().map(|t| (t.trace_idx, t.norm_factor))\n389\t    }\n390\t\n391\t    /// Evaluates the batch and returns the output device buffer.\n392\t    ///\n393\t    /// The buffer contains `num_airs * num_x` elements, laid out as\n394\t    /// `[air0_x0, air0_x1, ..., air1_x0, air1_x1, ...]`.\n395\t    pub fn evaluate(&self, num_x: u32) -> Result<DeviceBuffer<Frac<EF>>, KernelError> {\n396\t        if self.traces.is_empty() {\n397\t            return Ok(DeviceBuffer::new());\n398\t        }\n399\t\n400\t        evaluate_mle_interactions_gpu_batch(\n401\t            &self.d_block_ctxs,\n402\t            &self.d_logup_ctxs,\n403\t            &self.air_offsets,\n404\t            num_x,\n405\t            self.threads_per_block,\n406\t        )\n407\t    }\n408\t}\n409\t\n410\t// ============================================================================\n411\t// Memory-aware batched evaluation\n412\t// ============================================================================\n413\t\n414\tpub(crate) fn evaluate_zerocheck_batched<'a, HS: GpuHashScheme>(\n415\t    traces: impl IntoIterator<Item = &'a TraceCtx>,\n416\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n417\t    lambda_pows: &DeviceBuffer<EF>,\n418\t    num_x: u32,\n419\t    zc_out: &mut [Vec<EF>],\n420\t    memory_limit_bytes: usize,\n421\t) -> Result<(), KernelError> {\n422\t    // Collect traces with constraints and their buffer sizes\n423\t    let mut zc_traces_with_size: Vec<(&TraceCtx, usize)> = traces\n424\t        .into_iter()\n425\t        .filter(|t| t.has_constraints)\n426\t        .map(|t| {\n427\t            let buffer_size = pk.per_air[t.air_idx]\n428\t                .other_data\n429\t                .zerocheck_mle\n430\t                .inner\n431\t                .buffer_size;\n432\t            let mem = zerocheck_batch_mle_intermediates_buffer_bytes(buffer_size, num_x, t.num_y);\n433\t            (t, mem)\n434\t        })\n435\t        .collect();\n436\t    if zc_traces_with_size.is_empty() {\n437\t        return Ok(());\n438\t    }\n439\t\n440\t    // Sort by buffer size descending for better bin packing (First Fit Decreasing)\n441\t    zc_traces_with_size.sort_by(|a, b| b.1.cmp(&a.1));\n442\t\n443\t    let num_x_usize = num_x as usize;\n444\t    let mut batch_start = 0;\n445\t\n446\t    while batch_start < zc_traces_with_size.len() {\n447\t        let (batch_count, batch_memory) = find_batch_end(\n448\t            &zc_traces_with_size[batch_start..],\n449\t            |(_, mem)| *mem,\n450\t            memory_limit_bytes,\n451\t        );\n452\t        let batch: Vec<&TraceCtx> = zc_traces_with_size[batch_start..batch_start + batch_count]\n453\t            .iter()\n454\t            .map(|(t, _)| *t)\n455\t            .collect();\n456\t\n457\t        if batch.len() == 1 {\n458\t            // Single trace: use non-batch kernel\n459\t            let t = batch[0];\n460\t            if batch_memory > memory_limit_bytes {\n461\t                tracing::warn!(\n462\t                    air_idx = t.air_idx,\n463\t                    intermediate_buffer_bytes = batch_memory,\n464\t                    memory_limit_bytes,\n465\t                    \"zerocheck: trace exceeds memory limit, using non-batch kernel\"\n466\t                );\n467\t            }\n468\t            let rules = &pk.per_air[t.air_idx].other_data.zerocheck_mle;\n469\t            let out = evaluate_mle_constraints_gpu(\n470\t                t.eq_xi_ptr,\n471\t                t.sels_ptr,\n472\t                t.prep_ptr,\n473\t                &t.main_ptrs_dev,\n474\t                t.public_ptr,\n475\t                lambda_pows,\n476\t                rules,\n477\t                t.num_y,\n478\t                num_x,\n479\t            )?;\n480\t            let out_host = out.to_host()?;\n481\t            zc_out[t.trace_idx].copy_from_slice(&out_host);\n482\t        } else {\n483\t            // Normal batch using ZerocheckMleBatchBuilder\n484\t            tracing::debug!(\n485\t                batch_size = batch.len(),\n486\t                batch_memory,\n487\t                memory_limit_bytes,\n488\t                \"zerocheck: batching traces\"\n489\t            );\n490\t            let builder = ZerocheckMleBatchBuilder::new(batch.iter().copied(), pk, num_x)?;\n491\t            let out = builder.evaluate(lambda_pows, num_x)?;\n492\t            let host = out.to_host()?;\n493\t\n494\t            for (i, trace_idx) in builder.trace_indices().enumerate() {\n495\t                let evals = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n496\t                zc_out[trace_idx].copy_from_slice(evals);\n497\t            }\n498\t        }\n499\t        batch_start += batch_count;\n500\t    }\n501\t    Ok(())\n502\t}\n503\t\n504\t#[allow(clippy::too_many_arguments)]\n505\tpub(crate) fn evaluate_logup_batched<HS: GpuHashScheme>(\n506\t    traces: &[TraceCtx],\n507\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n508\t    d_challenges_ptr: *const EF,\n509\t    num_x: u32,\n510\t    monomial_num_y_threshold: u32,\n511\t    logup_combinations: &[Option<LogupCombinations>],\n512\t    logup_out: &mut [[Vec<EF>; 2]],\n513\t    logup_tilde_evals: &mut [[EF; 2]],\n514\t    memory_limit_bytes: usize,\n515\t) -> Result<(), KernelError> {\n516\t    let (low_traces, high_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) = traces\n517\t        .iter()\n518\t        .filter(|t| t.has_interactions)\n519\t        .partition(|t| t.num_y <= monomial_num_y_threshold);\n520\t\n521\t    if !low_traces.is_empty() {\n522\t        let logup_combs: Vec<_> = low_traces\n523\t            .iter()\n524\t            .map(|t| logup_combinations[t.trace_idx].as_ref().unwrap())\n525\t            .collect();\n526\t        let batch = LogupMonomialBatch::new(low_traces.iter().copied(), pk, &logup_combs)?;\n527\t        let out = batch.evaluate(num_x)?;\n528\t        let host = out.to_host()?;\n529\t        let num_x_usize = num_x as usize;\n530\t        for (i, trace_idx) in batch.trace_indices().enumerate() {\n531\t            let fracs = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n532\t            let norm = low_traces[i].norm_factor;\n533\t            if num_x == 1 {\n534\t                logup_tilde_evals[trace_idx][0] = fracs[0].p * norm;\n535\t                logup_tilde_evals[trace_idx][1] = fracs[0].q;\n536\t            } else {\n537\t                for (j, frac) in fracs.iter().enumerate() {\n538\t                    logup_out[trace_idx][0][j] = frac.p * norm;\n539\t                    logup_out[trace_idx][1][j] = frac.q;\n540\t                }\n541\t            }\n542\t        }\n543\t    }\n544\t\n545\t    if high_traces.is_empty() {\n546\t        return Ok(());\n547\t    }\n548\t\n549\t    // Collect high traces with interactions and their buffer sizes\n550\t    let mut logup_traces_with_size: Vec<(&TraceCtx, usize)> = high_traces\n551\t        .iter()\n552\t        .copied()\n553\t        .map(|t| {\n554\t            let buffer_size = pk.per_air[t.air_idx]\n555\t                .other_data\n556\t                .interaction_rules\n557\t                .inner\n558\t                .buffer_size;\n559\t            let mem = logup_batch_mle_intermediates_buffer_bytes(buffer_size, num_x, t.num_y);\n560\t            (t, mem)\n561\t        })\n562\t        .collect();\n563\t\n564\t    // Sort by buffer size descending for better bin packing (First Fit Decreasing)\n565\t    logup_traces_with_size.sort_by(|a, b| b.1.cmp(&a.1));\n566\t\n567\t    let num_x_usize = num_x as usize;\n568\t    let mut batch_start = 0;\n569\t\n570\t    while batch_start < logup_traces_with_size.len() {\n571\t        let (batch_count, batch_memory) = find_batch_end(\n572\t            &logup_traces_with_size[batch_start..],\n573\t            |(_, mem)| *mem,\n574\t            memory_limit_bytes,\n575\t        );\n576\t        let batch: Vec<&TraceCtx> = logup_traces_with_size[batch_start..batch_start + batch_count]\n577\t            .iter()\n578\t            .map(|(t, _)| *t)\n579\t            .collect();\n580\t\n581\t        if batch.len() == 1 && batch_memory > memory_limit_bytes {\n582\t            // Single oversized trace: use non-batch kernel\n583\t            let t = batch[0];\n584\t            tracing::warn!(\n585\t                air_idx = t.air_idx,\n586\t                intermediate_buffer_bytes = batch_memory,\n587\t                memory_limit_bytes,\n588\t                \"logup: trace exceeds memory limit, using non-batch kernel\"\n589\t            );\n590\t            evaluate_single_logup(\n591\t                t,\n592\t                pk,\n593\t                d_challenges_ptr,\n594\t                num_x,\n595\t                &mut logup_out[t.trace_idx],\n596\t                &mut logup_tilde_evals[t.trace_idx],\n597\t            )?;\n598\t        } else {\n599\t            // Normal batch using LogupMleBatchBuilder\n600\t            tracing::debug!(\n601\t                batch_size = batch.len(),\n602\t                batch_memory,\n603\t                memory_limit_bytes,\n604\t                \"logup: batching traces\"\n605\t            );\n606\t            let builder =\n607\t                LogupMleBatchBuilder::new(batch.iter().copied(), pk, d_challenges_ptr, num_x)?;\n608\t            let out = builder.evaluate(num_x)?;\n609\t            let host = out.to_host()?;\n610\t\n611\t            for (i, (trace_idx, norm_factor)) in builder.trace_info().enumerate() {\n612\t                let fracs = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n613\t                if num_x == 1 {\n614\t                    logup_tilde_evals[trace_idx][0] = fracs[0].p * norm_factor;\n615\t                    logup_tilde_evals[trace_idx][1] = fracs[0].q;\n616\t                } else {\n617\t                    let numer: Vec<EF> = fracs.iter().map(|f| f.p * norm_factor).collect();\n618\t                    let denom: Vec<EF> = fracs.iter().map(|f| f.q).collect();\n619\t                    logup_out[trace_idx] = [numer, denom];\n620\t                }\n621\t            }\n622\t        }\n623\t        batch_start += batch_count;\n624\t    }\n625\t    Ok(())\n626\t}\n627\t\n628\t/// Evaluate logup for a single trace using non-batch kernel.\n629\tfn evaluate_single_logup<HS: GpuHashScheme>(\n630\t    t: &TraceCtx,\n631\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n632\t    d_challenges_ptr: *const EF,\n633\t    num_x: u32,\n634\t    logup_out: &mut [Vec<EF>; 2],\n635\t    logup_tilde_eval: &mut [EF; 2],\n636\t) -> Result<(), KernelError> {\n637\t    let air_pk = &pk.per_air[t.air_idx];\n638\t    let out = evaluate_mle_interactions_gpu(\n639\t        t.eq_xi_ptr,\n640\t        t.sels_ptr,\n641\t        t.prep_ptr,\n642\t        &t.main_ptrs_dev,\n643\t        t.public_ptr,\n644\t        d_challenges_ptr,\n645\t        t.eq_3bs_ptr,\n646\t        &air_pk.other_data.interaction_rules,\n647\t        t.num_y,\n648\t        num_x,\n649\t    )?;\n650\t    let fracs = out.to_host()?;\n651\t\n652\t    if num_x == 1 {\n653\t        logup_tilde_eval[0] = fracs[0].p * t.norm_factor;\n654\t        logup_tilde_eval[1] = fracs[0].q;\n655\t        // logup_out not set, will be handled directly from tilde eval in compute_batch_s\n656\t    } else {\n657\t        let numer: Vec<EF> = fracs.iter().map(|f| f.p * t.norm_factor).collect();\n658\t        let denom: Vec<EF> = fracs.iter().map(|f| f.q).collect();\n659\t        *logup_out = [numer, denom];\n660\t    }\n661\t    Ok(())\n662\t}\n663\t\n664\t// ============================================================================\n665\t// FFI wrappers\n666\t// ============================================================================\n667\t\n668\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n669\tfn evaluate_mle_constraints_gpu_batch(\n670\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n671\t    zc_ctxs: &DeviceBuffer<ZerocheckCtx>,\n672\t    air_block_offsets: &DeviceBuffer<u32>,\n673\t    lambda_pows: &DeviceBuffer<EF>,\n674\t    lambda_len: usize,\n675\t    num_x: u32,\n676\t    threads_per_block: u32,\n677\t) -> Result<DeviceBuffer<EF>, KernelError> {\n678\t    let num_blocks = block_ctxs.len();\n679\t    let num_airs = zc_ctxs.len();\n680\t    tracing::debug!(\n681\t        %num_blocks,\n682\t        %num_x,\n683\t        %threads_per_block,\n684\t        %num_airs,\n685\t        \"zerocheck_batch_eval_mle\"\n686\t    );\n687\t    // Need one buffer slot per block\n688\t    let mut tmp_sums_buffer = DeviceBuffer::<EF>::with_capacity(num_blocks * num_x as usize);\n689\t    let mut output = DeviceBuffer::<EF>::with_capacity(num_airs * num_x as usize);\n690\t    unsafe {\n691\t        zerocheck_batch_eval_mle(\n692\t            &mut tmp_sums_buffer,\n693\t            &mut output,\n694\t            block_ctxs,\n695\t            zc_ctxs,\n696\t            air_block_offsets,\n697\t            lambda_pows,\n698\t            lambda_len,\n699\t            num_blocks as u32,\n700\t            num_x,\n701\t            num_airs as u32,\n702\t            threads_per_block,\n703\t        )?;\n704\t    }\n705\t    Ok(output)\n706\t}\n707\t\n708\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n709\tfn evaluate_mle_interactions_gpu_batch(\n710\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n711\t    logup_ctxs: &DeviceBuffer<LogupCtx>,\n712\t    air_block_offsets: &DeviceBuffer<u32>,\n713\t    num_x: u32,\n714\t    threads_per_block: u32,\n715\t) -> Result<DeviceBuffer<Frac<EF>>, KernelError> {\n716\t    let num_blocks = block_ctxs.len();\n717\t    let num_airs = logup_ctxs.len();\n718\t    // Need one buffer slot per block\n719\t    let mut tmp_sums_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(num_blocks * num_x as usize);\n720\t    let mut output = DeviceBuffer::<Frac<EF>>::with_capacity(num_airs * num_x as usize);\n721\t    unsafe {\n722\t        logup_batch_eval_mle(\n723\t            &mut tmp_sums_buffer,\n724\t            &mut output,\n725\t            block_ctxs,\n726\t            logup_ctxs,\n727\t            air_block_offsets,\n728\t            num_blocks as u32,\n729\t            num_x,\n730\t            num_airs as u32,\n731\t            threads_per_block,\n732\t        )?;\n733\t    }\n734\t    Ok(output)\n735\t}\n736\t"}]},"parent_tool_use_id":"toolu_018v8Gcdse3Q5hdsnfcAeYbS","session_id":"fae41bbf-912e-42ee-9c72-17c79e3a14c7","uuid":"d9642559-bdb4-4526-bab7-63368b47923d","timestamp":"2026-04-16T04:53:56.142Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RC2vC57GZQkAPXPk73QMXL","type":"tool_result","content":"1\t/// BN254 Poseidon2 CUDA kernels.\n2\t///\n3\t/// All BN254 code lives in this single translation unit to avoid device-side\n4\t/// linkage issues with `static __device__` variables.\n5\t///\n6\t/// Entry points (called from Rust via FFI):\n7\t///   _init_bn254_poseidon2_rc         - Upload round constants from Rust\n8\t///   _bn254_poseidon2_compressing_row_hashes     - Merkle leaf hashes (F matrix)\n9\t///   _bn254_poseidon2_compressing_row_hashes_ext - Merkle leaf hashes (EF matrix)\n10\t///   _bn254_poseidon2_adjacent_compress_layer    - Merkle internal compress\n11\t///   _bn254_sponge_grind              - PoW grinding for BN254 transcript\n12\t\n13\t#include \"poseidon2_bn254.cuh\"\n14\t#include \"fp.h\"\n15\t#include \"fpext.h\"\n16\t#include \"launcher.cuh\"\n17\t#include <cstdint>\n18\t\n19\t// ---------------------------------------------------------------------------\n20\t// Round constant device memory (filled by _init_bn254_poseidon2_rc)\n21\t// ---------------------------------------------------------------------------\n22\t\n23\t/// External initial round constants: 4 rounds × 3 elements\n24\t__device__ __constant__ Bn254Fr g_initial_rc[4][3];\n25\t\n26\t/// Internal (partial) round constants: 56 rounds × 1 element (for state[0] only)\n27\t__device__ __constant__ Bn254Fr g_partial_rc[56];\n28\t\n29\t/// External terminal round constants: 4 rounds × 3 elements\n30\t__device__ __constant__ Bn254Fr g_terminal_rc[4][3];\n31\t\n32\t// ---------------------------------------------------------------------------\n33\t// BN254 Poseidon2 permutation (WIDTH=3, 4 + 56 + 4 rounds)\n34\t//\n35\t// Matches p3-bn254's Poseidon2Bn254<3> permutation exactly:\n36\t//   external_initial_permute_state:  MDS first, then 4×(add_RC + sbox_all + MDS)\n37\t//   internal_permute_state:          56×(add_RC[0] + sbox[0] + matmul_internal)\n38\t//   external_terminal_permute_state: 4×(add_RC + sbox_all + MDS)\n39\t// ---------------------------------------------------------------------------\n40\t\n41\tstatic __device__ __forceinline__\n42\tvoid bn254_poseidon2_permute(Bn254Fr state[3]) {\n43\t    // --- Initial external layer ---\n44\t    bn254_mds_external(state); // MDS without round constants\n45\t    for (int r = 0; r < 4; r++) {\n46\t        for (int i = 0; i < 3; i++) {\n47\t            state[i] = bn254_add(state[i], g_initial_rc[r][i]);\n48\t            state[i] = bn254_sbox(state[i]);\n49\t        }\n50\t        bn254_mds_external(state);\n51\t    }\n52\t\n53\t    // --- Internal (partial) layer ---\n54\t    for (int r = 0; r < 56; r++) {\n55\t        state[0] = bn254_add(state[0], g_partial_rc[r]);\n56\t        state[0] = bn254_sbox(state[0]);\n57\t        bn254_mds_internal(state);\n58\t    }\n59\t\n60\t    // --- Terminal external layer ---\n61\t    for (int r = 0; r < 4; r++) {\n62\t        for (int i = 0; i < 3; i++) {\n63\t            state[i] = bn254_add(state[i], g_terminal_rc[r][i]);\n64\t            state[i] = bn254_sbox(state[i]);\n65\t        }\n66\t        bn254_mds_external(state);\n67\t    }\n68\t}\n69\t\n70\t// ---------------------------------------------------------------------------\n71\t// BN254 Merkle digest: a single Bn254Fr element (32 bytes)\n72\t// Matches Digest = [Bn254Scalar; 1] on the Rust side.\n73\t// ---------------------------------------------------------------------------\n74\t\n75\tstruct bn254_digest_t {\n76\t    Bn254Fr elem;\n77\t};\n78\t\n79\t// ---------------------------------------------------------------------------\n80\t// Helper: zero-initialize a Bn254Fr\n81\t// ---------------------------------------------------------------------------\n82\t\n83\tstatic __device__ __forceinline__\n84\tBn254Fr bn254_zero_init() {\n85\t    Bn254Fr z;\n86\t    for (int i = 0; i < 4; i++) z.limbs[i] = 0;\n87\t    return z;\n88\t}\n89\t\n90\t// ---------------------------------------------------------------------------\n91\t// Sponge constants for Merkle hashing\n92\t//\n93\t// Matches MultiField32PaddingFreeSponge<BabyBear, Bn254Scalar, Perm, 3, 16, 1>:\n94\t//   BABY_BEAR_RATE = 16  BabyBear values absorbed per permutation\n95\t//   NUM_F_ELMS = 8       BabyBear values packed per Bn254Fr (floor(254/31) = 8)\n96\t// ---------------------------------------------------------------------------\n97\t\n98\tstatic const int BN254_BABY_BEAR_RATE = 16;\n99\tstatic const int BN254_NUM_F_ELMS    = 8;\n100\t\n101\t// ---------------------------------------------------------------------------\n102\t// Row hash helpers\n103\t// ---------------------------------------------------------------------------\n104\t\n105\t/// Row hash for a base-field (Fp / BabyBear) matrix row.\n106\tstatic __device__ __forceinline__\n107\tBn254Fr bn254_row_hash(const Fp* matrix, int width, int height, int row) {\n108\t    Bn254Fr state[3];\n109\t    state[0] = bn254_zero_init();\n110\t    state[1] = bn254_zero_init();\n111\t    state[2] = bn254_zero_init();\n112\t\n113\t    uint32_t buf[BN254_BABY_BEAR_RATE];\n114\t    int cnt = 0;\n115\t\n116\t    for (int col = 0; col < width; col++) {\n117\t        buf[cnt++] = matrix[col * height + row].asUInt32();\n118\t        if (cnt == BN254_BABY_BEAR_RATE) {\n119\t            state[0] = bn254_reduce_32(buf, BN254_NUM_F_ELMS);\n120\t            state[1] = bn254_reduce_32(buf + BN254_NUM_F_ELMS, BN254_NUM_F_ELMS);\n121\t            bn254_poseidon2_permute(state);\n122\t            cnt = 0;\n123\t        }\n124\t    }\n125\t    if (cnt > 0) {\n126\t        state[0] = bn254_reduce_32(buf, min(BN254_NUM_F_ELMS, cnt));\n127\t        if (cnt > BN254_NUM_F_ELMS)\n128\t            state[1] = bn254_reduce_32(buf + BN254_NUM_F_ELMS,\n129\t                                       min(BN254_NUM_F_ELMS, cnt - BN254_NUM_F_ELMS));\n130\t        bn254_poseidon2_permute(state);\n131\t    }\n132\t    return state[0];\n133\t}\n134\t\n135\t/// Row hash for an extension-field (FpExt / BinomialExtensionField<BabyBear,4>) matrix row.\n136\tstatic __device__ __forceinline__\n137\tBn254Fr bn254_row_hash_ext(const FpExt* matrix, int width, int height, int row) {\n138\t    Bn254Fr state[3];\n139\t    state[0] = bn254_zero_init();\n140\t    state[1] = bn254_zero_init();\n141\t    state[2] = bn254_zero_init();\n142\t\n143\t    uint32_t buf[BN254_BABY_BEAR_RATE];\n144\t    int cnt = 0;\n145\t\n146\t    for (int col = 0; col < width; col++) {\n147\t        FpExt elem = matrix[col * height + row];\n148\t        for (int d = 0; d < 4; d++) {\n149\t            buf[cnt++] = elem.elems[d].asUInt32();\n150\t            if (cnt == BN254_BABY_BEAR_RATE) {\n151\t                state[0] = bn254_reduce_32(buf, BN254_NUM_F_ELMS);\n152\t                state[1] = bn254_reduce_32(buf + BN254_NUM_F_ELMS, BN254_NUM_F_ELMS);\n153\t                bn254_poseidon2_permute(state);\n154\t                cnt = 0;\n155\t            }\n156\t        }\n157\t    }\n158\t    if (cnt > 0) {\n159\t        state[0] = bn254_reduce_32(buf, min(BN254_NUM_F_ELMS, cnt));\n160\t        if (cnt > BN254_NUM_F_ELMS)\n161\t            state[1] = bn254_reduce_32(buf + BN254_NUM_F_ELMS,\n162\t                                       min(BN254_NUM_F_ELMS, cnt - BN254_NUM_F_ELMS));\n163\t        bn254_poseidon2_permute(state);\n164\t    }\n165\t    return state[0];\n166\t}\n167\t\n168\t/// TruncatedPermutation compress: (left, right) → permute([left, right, 0])[0].\n169\tstatic __device__ __forceinline__\n170\tBn254Fr bn254_compress(Bn254Fr left, Bn254Fr right) {\n171\t    Bn254Fr state[3];\n172\t    state[0] = left;\n173\t    state[1] = right;\n174\t    state[2] = bn254_zero_init();\n175\t    bn254_poseidon2_permute(state);\n176\t    return state[0];\n177\t}\n178\t\n179\t// ---------------------------------------------------------------------------\n180\t// Merkle row-hash kernel (F / BabyBear matrix)\n181\t// ---------------------------------------------------------------------------\n182\t\n183\t__global__ void bn254_compressing_row_hashes_kernel(\n184\t    bn254_digest_t* out,\n185\t    const Fp*       matrix,\n186\t    size_t          width,\n187\t    size_t          height,\n188\t    size_t          query_stride,\n189\t    size_t          log_rows_per_query\n190\t) {\n191\t    extern __shared__ char smem[]; // Bn254Fr[blockDim.x * (blockDim.y/2)]\n192\t    Bn254Fr* shared = reinterpret_cast<Bn254Fr*>(smem);\n193\t\n194\t    const uint32_t stride_idx = blockDim.x * blockIdx.x + threadIdx.x;\n195\t    uint32_t       leaf_idx   = threadIdx.y;\n196\t    const uint32_t row        = leaf_idx * query_stride + stride_idx;\n197\t\n198\t    Bn254Fr digest = bn254_zero_init();\n199\t\n200\t    if (stride_idx < query_stride) {\n201\t        digest = bn254_row_hash(matrix, (int)width, (int)height, (int)row);\n202\t    }\n203\t\n204\t    // Tree reduction (same structure as the BabyBear kernel)\n205\t    for (int layer = 0; layer < (int)log_rows_per_query; ++layer) {\n206\t        uint32_t mask          = (1 << (layer + 1)) - 1;\n207\t        uint32_t shared_offset = ((leaf_idx >> (layer + 1)) << layer) * blockDim.x + threadIdx.x;\n208\t\n209\t        if ((leaf_idx & mask) == (1u << layer)) {\n210\t            shared[shared_offset] = digest;\n211\t        }\n212\t        __syncthreads();\n213\t        if ((leaf_idx & mask) == 0) {\n214\t            Bn254Fr sibling = shared[shared_offset];\n215\t            digest = bn254_compress(digest, sibling);\n216\t        }\n217\t        __syncthreads();\n218\t    }\n219\t\n220\t    if (leaf_idx == 0 && stride_idx < query_stride) {\n221\t        out[stride_idx].elem = digest;\n222\t    }\n223\t}\n224\t\n225\t// ---------------------------------------------------------------------------\n226\t// Merkle row-hash kernel (EF / BinomialExtensionField<BabyBear,4> matrix)\n227\t// ---------------------------------------------------------------------------\n228\t\n229\t__global__ void bn254_compressing_row_hashes_ext_kernel(\n230\t    bn254_digest_t* out,\n231\t    const FpExt*    matrix,\n232\t    size_t          width,\n233\t    size_t          height,\n234\t    size_t          query_stride,\n235\t    size_t          log_rows_per_query\n236\t) {\n237\t    extern __shared__ char smem[];\n238\t    Bn254Fr* shared = reinterpret_cast<Bn254Fr*>(smem);\n239\t\n240\t    const uint32_t stride_idx = blockDim.x * blockIdx.x + threadIdx.x;\n241\t    uint32_t       leaf_idx   = threadIdx.y;\n242\t    const uint32_t row        = leaf_idx * query_stride + stride_idx;\n243\t\n244\t    Bn254Fr digest = bn254_zero_init();\n245\t\n246\t    if (stride_idx < query_stride) {\n247\t        digest = bn254_row_hash_ext(matrix, (int)width, (int)height, (int)row);\n248\t    }\n249\t\n250\t    for (int layer = 0; layer < (int)log_rows_per_query; ++layer) {\n251\t        uint32_t mask          = (1 << (layer + 1)) - 1;\n252\t        uint32_t shared_offset = ((leaf_idx >> (layer + 1)) << layer) * blockDim.x + threadIdx.x;\n253\t\n254\t        if ((leaf_idx & mask) == (1u << layer)) {\n255\t            shared[shared_offset] = digest;\n256\t        }\n257\t        __syncthreads();\n258\t        if ((leaf_idx & mask) == 0) {\n259\t            Bn254Fr sibling = shared[shared_offset];\n260\t            digest = bn254_compress(digest, sibling);\n261\t        }\n262\t        __syncthreads();\n263\t    }\n264\t\n265\t    if (leaf_idx == 0 && stride_idx < query_stride) {\n266\t        out[stride_idx].elem = digest;\n267\t    }\n268\t}\n269\t\n270\tstatic_assert(BN254_BABY_BEAR_RATE % 4 == 0,\n271\t              \"BN254_BABY_BEAR_RATE must be a multiple of FpExt degree (4)\");\n272\t\n273\t// ---------------------------------------------------------------------------\n274\t// Adjacent compress layer kernel\n275\t// ---------------------------------------------------------------------------\n276\t\n277\t__global__ void bn254_adjacent_compress_layer_kernel(\n278\t    bn254_digest_t*       output,\n279\t    const bn254_digest_t* prev_layer,\n280\t    size_t                output_size\n281\t) {\n282\t    uint32_t gid = blockDim.x * blockIdx.x + threadIdx.x;\n283\t    if (gid >= output_size) return;\n284\t\n285\t    Bn254Fr left  = prev_layer[2 * gid    ].elem;\n286\t    Bn254Fr right = prev_layer[2 * gid + 1].elem;\n287\t    output[gid].elem = bn254_compress(left, right);\n288\t}\n289\t\n290\t// ---------------------------------------------------------------------------\n291\t// BN254 sponge state for GPU grinding\n292\t//\n293\t// Matches MultiField32Challenger<BabyBear, Bn254Scalar, Perm, WIDTH=3, RATE=2>:\n294\t//   num_f_elms = PF::bits() / 64 = 3   (BabyBear values per Bn254Scalar for challenger)\n295\t//   max input_buffer  = num_f_elms * RATE  = 3 * 2 = 6\n296\t//   max output_buffer = num_f_elms * WIDTH = 3 * 3 = 9\n297\t//\n298\t// Rust DeviceBn254SpongeState must have identical layout (verified by size assert).\n299\t// ---------------------------------------------------------------------------\n300\t\n301\tstruct DeviceBn254SpongeState {\n302\t    Bn254Fr  sponge_state[3]; // 3 * 32 = 96 bytes, align 8\n303\t    uint32_t input_buffer[6]; // 24 bytes\n304\t    uint32_t input_len;       // 4 bytes\n305\t    uint32_t output_buffer[9]; // 36 bytes\n306\t    uint32_t output_len;       // 4 bytes\n307\t    // Trailing padding: 4 bytes → total 168 bytes (aligned to 8)\n308\t};\n309\t\n310\tstatic_assert(sizeof(DeviceBn254SpongeState) == 168,\n311\t              \"DeviceBn254SpongeState size mismatch with Rust\");\n312\t\n313\t// Sponge constants for the grind transcript (MultiField32Challenger, num_f_elms=3)\n314\tstatic const int BN254_GRIND_NUM_F_ELMS = 3;     // PF::bits()/64 = 254/64 = 3\n315\tstatic const int BN254_GRIND_WIDTH      = 3;      // WIDTH\n316\tstatic const uint32_t BN254_GRIND_MAX_INPUT = 6;  // num_f_elms * RATE = 6\n317\t\n318\t/// Duplexing: pack input → sponge_state, permute, fill output.\n319\t/// Matches MultiField32Challenger::duplexing().\n320\t__device__ void bn254_sponge_duplex(DeviceBn254SpongeState& s) {\n321\t    // Pack input_buffer into sponge_state in chunks of BN254_GRIND_NUM_F_ELMS=3\n322\t    for (int i = 0; (uint32_t)(i * BN254_GRIND_NUM_F_ELMS) < s.input_len; i++) {\n323\t        int start = i * BN254_GRIND_NUM_F_ELMS;\n324\t        int cnt   = (int)s.input_len - start;\n325\t        if (cnt > BN254_GRIND_NUM_F_ELMS) cnt = BN254_GRIND_NUM_F_ELMS;\n326\t        s.sponge_state[i] = bn254_reduce_32(s.input_buffer + start, cnt);\n327\t    }\n328\t    s.input_len = 0;\n329\t\n330\t    bn254_poseidon2_permute(s.sponge_state);\n331\t\n332\t    // Split each Bn254Fr into BN254_GRIND_NUM_F_ELMS=3 BabyBear values\n333\t    s.output_len = 0;\n334\t    for (int i = 0; i < BN254_GRIND_WIDTH; i++) {\n335\t        uint32_t bb[3];\n336\t        bn254_split_32_3(bb, s.sponge_state[i]);\n337\t        for (int j = 0; j < BN254_GRIND_NUM_F_ELMS; j++) {\n338\t            s.output_buffer[s.output_len++] = bb[j];\n339\t        }\n340\t    }\n341\t    // output_len == 9 after full duplexing\n342\t}\n343\t\n344\t/// Observe a canonical BabyBear u32 value into the sponge.\n345\t/// Matches MultiField32Challenger::observe().\n346\t__device__ void bn254_sponge_observe(DeviceBn254SpongeState& s, uint32_t value) {\n347\t    s.output_len = 0; // invalidate buffered output\n348\t    s.input_buffer[s.input_len++] = value;\n349\t    if (s.input_len == BN254_GRIND_MAX_INPUT) {\n350\t        bn254_sponge_duplex(s);\n351\t    }\n352\t}\n353\t\n354\t/// Sample a canonical BabyBear u32 value from the sponge.\n355\t/// Matches MultiField32Challenger::sample() (uses Vec::pop, i.e. last element).\n356\t__device__ uint32_t bn254_sponge_sample(DeviceBn254SpongeState& s) {\n357\t    if (s.input_len > 0 || s.output_len == 0) {\n358\t        bn254_sponge_duplex(s);\n359\t    }\n360\t    return s.output_buffer[--s.output_len]; // pop from end\n361\t}\n362\t\n363\t/// Returns true if check_witness(bits, witness) passes.\n364\t__device__ bool bn254_sponge_check_witness(DeviceBn254SpongeState& s,\n365\t                                           uint32_t bits, uint32_t witness) {\n366\t    bn254_sponge_observe(s, witness);\n367\t    uint32_t sample = bn254_sponge_sample(s);\n368\t    return (sample & ((1u << bits) - 1)) == 0;\n369\t}\n370\t\n371\tstatic const uint32_t BN254_GRIND_BLOCK_SIZE = 32;\n372\t\n373\t/// Grinding kernel: find any w in [min_witness, max_witness] with check_witness(bits,w)==true.\n374\t__launch_bounds__(BN254_GRIND_BLOCK_SIZE) __global__ void bn254_grind_kernel(\n375\t    const DeviceBn254SpongeState* init_state,\n376\t    uint32_t bits,\n377\t    uint32_t min_witness,\n378\t    uint32_t max_witness,\n379\t    uint32_t* result\n380\t) {\n381\t    const uint32_t tid = blockIdx.x * blockDim.x + threadIdx.x;\n382\t    const uint32_t stride = gridDim.x * blockDim.x;\n383\t    uint32_t w = min_witness + tid;\n384\t\n385\t    if (w > max_witness || *result != UINT32_MAX) return;\n386\t\n387\t    while (w <= max_witness) {\n388\t        if (*result != UINT32_MAX) return;\n389\t\n390\t        DeviceBn254SpongeState local_state = *init_state;\n391\t        if (bn254_sponge_check_witness(local_state, bits, w)) {\n392\t            atomicCAS(result, UINT32_MAX, w);\n393\t            return;\n394\t        }\n395\t\n396\t        if (max_witness - w < stride) return;\n397\t        w += stride;\n398\t    }\n399\t}\n400\t\n401\t// ---------------------------------------------------------------------------\n402\t// Extern \"C\" launchers\n403\t// ---------------------------------------------------------------------------\n404\t\n405\t/// Upload BN254 Poseidon2 round constants (in Montgomery form) to device constant memory.\n406\t///\n407\t/// @param initial_rc   Flat array of 4*3*4 = 48 uint64s  (initial external rounds)\n408\t/// @param partial_rc   Flat array of 56*4 = 224 uint64s  (internal/partial rounds)\n409\t/// @param terminal_rc  Flat array of 4*3*4 = 48 uint64s  (terminal external rounds)\n410\textern \"C\" int _init_bn254_poseidon2_rc(\n411\t    const uint64_t* initial_rc,\n412\t    const uint64_t* partial_rc,\n413\t    const uint64_t* terminal_rc\n414\t) {\n415\t    cudaError_t err;\n416\t    err = cudaMemcpyToSymbol(g_initial_rc,  initial_rc,  4 * 3 * 4 * sizeof(uint64_t));\n417\t    if (err != cudaSuccess) return (int)err;\n418\t    err = cudaMemcpyToSymbol(g_partial_rc,  partial_rc,  56  * 4 * sizeof(uint64_t));\n419\t    if (err != cudaSuccess) return (int)err;\n420\t    err = cudaMemcpyToSymbol(g_terminal_rc, terminal_rc, 4 * 3 * 4 * sizeof(uint64_t));\n421\t    if (err != cudaSuccess) return (int)err;\n422\t    return (int)cudaSuccess;\n423\t}\n424\t\n425\textern \"C\" int _bn254_poseidon2_compressing_row_hashes(\n426\t    bn254_digest_t* out,\n427\t    const Fp*       matrix,\n428\t    size_t          width,\n429\t    size_t          query_stride,\n430\t    size_t          log_rows_per_query\n431\t) {\n432\t    auto [grid, block] = kernel_launch_params(query_stride, 512 >> log_rows_per_query);\n433\t    block.y = 1 << log_rows_per_query;\n434\t    size_t shared_stride = block.x * div_ceil(block.y, 2);\n435\t    size_t shmem_bytes   = shared_stride * sizeof(Bn254Fr);\n436\t    auto   height        = query_stride << log_rows_per_query;\n437\t\n438\t    bn254_compressing_row_hashes_kernel<<<grid, block, shmem_bytes>>>(\n439\t        out, matrix, width, height, query_stride, log_rows_per_query\n440\t    );\n441\t    return CHECK_KERNEL();\n442\t}\n443\t\n444\textern \"C\" int _bn254_poseidon2_compressing_row_hashes_ext(\n445\t    bn254_digest_t* out,\n446\t    const FpExt*    matrix,\n447\t    size_t          width,\n448\t    size_t          query_stride,\n449\t    size_t          log_rows_per_query\n450\t) {\n451\t    auto [grid, block] = kernel_launch_params(query_stride, 512 >> log_rows_per_query);\n452\t    block.y = 1 << log_rows_per_query;\n453\t    size_t shared_stride = block.x * div_ceil(block.y, 2);\n454\t    size_t shmem_bytes   = shared_stride * sizeof(Bn254Fr);\n455\t    auto   height        = query_stride << log_rows_per_query;\n456\t\n457\t    bn254_compressing_row_hashes_ext_kernel<<<grid, block, shmem_bytes>>>(\n458\t        out, matrix, width, height, query_stride, log_rows_per_query\n459\t    );\n460\t    return CHECK_KERNEL();\n461\t}\n462\t\n463\textern \"C\" int _bn254_poseidon2_adjacent_compress_layer(\n464\t    bn254_digest_t*       output,\n465\t    const bn254_digest_t* prev_layer,\n466\t    size_t                output_size\n467\t) {\n468\t    auto [grid, block] = kernel_launch_params(output_size);\n469\t    bn254_adjacent_compress_layer_kernel<<<grid, block>>>(output, prev_layer, output_size);\n470\t    return CHECK_KERNEL();\n471\t}\n472\t\n473\textern \"C\" int _bn254_sponge_grind(\n474\t    const DeviceBn254SpongeState* init_state,\n475\t    uint32_t bits,\n476\t    uint32_t min_witness,\n477\t    uint32_t max_witness,\n478\t    uint32_t* result\n479\t) {\n480\t    const size_t block_size = BN254_GRIND_BLOCK_SIZE;\n481\t    size_t total_threads = size_t{1} << bits;\n482\t    size_t grid_size = div_ceil(total_threads, block_size);\n483\t\n484\t    bn254_grind_kernel<<<grid_size, block_size>>>(init_state, bits, min_witness, max_witness, result);\n485\t\n486\t    cudaError_t err = cudaGetLastError();\n487\t    if (err != cudaSuccess) return (int)err;\n488\t\n489\t    err = cudaDeviceSynchronize();\n490\t    if (err != cudaSuccess) return (int)err;\n491\t\n492\t    return CHECK_KERNEL();\n493\t}\n494\t"}]},"parent_tool_use_id":"toolu_019dbXRLT3Zn35MpG9vuTsYs","session_id":"fae41bbf-912e-42ee-9c72-17c79e3a14c7","uuid":"494d9fcf-00ab-4f6d-86e9-e17b245781da","timestamp":"2026-04-16T04:53:56.149Z"}
