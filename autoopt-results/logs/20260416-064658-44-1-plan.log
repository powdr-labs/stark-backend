{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ao1N8x68j87RZTL6CNUVYa","type":"tool_result","content":"1\t//! CPU [ProverBackend] trait implementation.\n2\t\n3\tuse std::marker::PhantomData;\n4\t\n5\tuse getset::Getters;\n6\tuse itertools::Itertools;\n7\tuse p3_field::{ExtensionField, TwoAdicField};\n8\t\n9\tuse crate::{\n10\t    keygen::types::MultiStarkProvingKey,\n11\t    poly_common::Squarable,\n12\t    proof::{BatchConstraintProof, GkrProof, StackingProof, WhirProof},\n13\t    prover::{\n14\t        error::RefProverError,\n15\t        prove_zerocheck_and_logup,\n16\t        stacked_pcs::{stacked_commit, StackedPcsData},\n17\t        stacked_reduction::{prove_stacked_opening_reduction, StackedReductionCpu},\n18\t        whir::WhirProver,\n19\t        ColMajorMatrix, CommittedTraceData, DeviceDataTransporter, DeviceMultiStarkProvingKey,\n20\t        DeviceStarkProvingKey, MultiRapProver, OpeningProver, ProverBackend, ProverDevice,\n21\t        ProvingContext, TraceCommitter,\n22\t    },\n23\t    FiatShamirTranscript, StarkProtocolConfig, SystemParams,\n24\t};\n25\t\n26\t#[derive(Clone, Copy)]\n27\tpub struct CpuColMajorBackend<SC: StarkProtocolConfig>(PhantomData<SC>);\n28\t\n29\timpl<SC: StarkProtocolConfig> CpuColMajorBackend<SC> {\n30\t    pub fn new() -> Self {\n31\t        Self(PhantomData)\n32\t    }\n33\t}\n34\t\n35\timpl<SC: StarkProtocolConfig> Default for CpuColMajorBackend<SC> {\n36\t    fn default() -> Self {\n37\t        Self::new()\n38\t    }\n39\t}\n40\t\n41\t#[derive(Clone, Getters, derive_new::new)]\n42\tpub struct ReferenceDevice<SC> {\n43\t    #[getset(get = \"pub\")]\n44\t    config: SC,\n45\t}\n46\t\n47\timpl<SC: StarkProtocolConfig> ReferenceDevice<SC> {\n48\t    pub fn params(&self) -> &SystemParams {\n49\t        self.config.params()\n50\t    }\n51\t}\n52\t\n53\timpl<SC: StarkProtocolConfig> ProverBackend for CpuColMajorBackend<SC> {\n54\t    const CHALLENGE_EXT_DEGREE: u8 = SC::D_EF as u8;\n55\t\n56\t    type Val = SC::F;\n57\t    type Challenge = SC::EF;\n58\t    type Commitment = SC::Digest;\n59\t    type Matrix = ColMajorMatrix<SC::F>;\n60\t    type OtherAirData = ();\n61\t    type PcsData = StackedPcsData<SC::F, SC::Digest>;\n62\t}\n63\t\n64\timpl<SC, TS> ProverDevice<CpuColMajorBackend<SC>, TS> for ReferenceDevice<SC>\n65\twhere\n66\t    SC: StarkProtocolConfig,\n67\t    SC::F: Ord,\n68\t    SC::EF: TwoAdicField + ExtensionField<SC::F> + Ord,\n69\t    TS: FiatShamirTranscript<SC>,\n70\t{\n71\t    type Error = RefProverError;\n72\t}\n73\t\n74\timpl<SC: StarkProtocolConfig> TraceCommitter<CpuColMajorBackend<SC>> for ReferenceDevice<SC>\n75\twhere\n76\t    SC::F: Ord,\n77\t{\n78\t    type Error = RefProverError;\n79\t\n80\t    fn commit(\n81\t        &self,\n82\t        traces: &[&ColMajorMatrix<SC::F>],\n83\t    ) -> Result<(SC::Digest, StackedPcsData<SC::F, SC::Digest>), Self::Error> {\n84\t        Ok(stacked_commit(\n85\t            self.config().hasher(),\n86\t            self.params().l_skip,\n87\t            self.params().n_stack,\n88\t            self.params().log_blowup,\n89\t            self.params().k_whir(),\n90\t            traces,\n91\t        )?)\n92\t    }\n93\t}\n94\t\n95\timpl<SC, TS> MultiRapProver<CpuColMajorBackend<SC>, TS> for ReferenceDevice<SC>\n96\twhere\n97\t    SC: StarkProtocolConfig,\n98\t    SC::EF: TwoAdicField + ExtensionField<SC::F>,\n99\t    TS: FiatShamirTranscript<SC>,\n100\t{\n101\t    type PartialProof = (GkrProof<SC>, BatchConstraintProof<SC>);\n102\t    /// The random opening point `r` where the batch constraint sumcheck reduces to evaluation\n103\t    /// claims of trace matrices `T, T_{rot}` at `r_{n_T}`.\n104\t    type Artifacts = Vec<SC::EF>;\n105\t\n106\t    type Error = RefProverError;\n107\t\n108\t    fn prove_rap_constraints(\n109\t        &self,\n110\t        transcript: &mut TS,\n111\t        mpk: &DeviceMultiStarkProvingKey<CpuColMajorBackend<SC>>,\n112\t        ctx: &ProvingContext<CpuColMajorBackend<SC>>,\n113\t       