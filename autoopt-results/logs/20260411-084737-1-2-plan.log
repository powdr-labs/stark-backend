\t            num_cosets_logup: usize,\n740\t            local_constraint_deg: usize,\n741\t            omega_root: F,\n742\t            n: isize,\n743\t            // For individual (non-batched) launches:\n744\t            zc_result: DeviceBuffer<EF>,\n745\t            logup_result: DeviceBuffer<Frac<EF>>,\n746\t            // For batched launches (index within the batch, None if individual):\n747\t            zc_batch_idx: Option<usize>,\n748\t            logup_batch_idx: Option<usize>,\n749\t        }\n750\t\n751\t        let skip_domain: u32 = 1 << l_skip;\n752\t        let block_x = skip_domain.max(MAX_THREADS_ROUND0);\n753\t\n754\t        // Pre-check: disable batching if skip_domain is large enough that batch\n755\t        // temp buffers would exceed the memory budget. Each batched block contributes\n756\t        // max_num_cosets * skip_domain * sizeof(T) to the temp buffer. With ~600\n757\t        // AIRs and ~8 blocks each, the total can reach hundreds of MB.\n758\t        // Conservative estimate: if d * num_airs * max_blocks_per_air * sizeof(Frac<EF>) > 128 MB,\n759\t        // skip batching. This typically triggers for skip_domain >= 256.\n760\t        const BATCH_TMP_BUDGET: usize = 128 * 1024 * 1024;\n761\t        let max_cosets_estimate = self.constraint_degree; // upper bound\n762\t        let d_estimate = max_cosets_estimate * skip_domain as usize;\n763\t        let blocks_per_air_estimate = skip_domain.div_ceil(block_x) as usize;\n764\t        let estimated_batch_tmp = num_present_airs\n765\t            * blocks_per_air_estimate\n766\t            * d_estimate\n767\t            * std::mem::size_of::<Frac<EF>>();\n768\t        let batching_enabled = estimated_batch_tmp <= BATCH_TMP_BUDGET;\n769\t        debug!(\n770\t            \"Round 0: l_skip={l_skip}, skip_domain={skip_domain}, batching_enabled={batching_enabled}, estimated_tmp={estimated_batch_tmp}\"\n771\t        );\n772\t\n773\t        // Phase 1: Classify AIRs, collect metadata for batching, launch kernels.\n774\t        let mut pending: Vec<Round0Pending<F, EF>> = Vec::with_capacity(num_present_airs);\n775\t        let mut d_main_parts_vec: Vec<DeviceBuffer<*const F>> =\n776\t            Vec::with_capacity(num_present_airs);\n777\t\n778\t        // Batched zerocheck metadata\n779\t        let mut zc_batch_metas: Vec<ZerocheckBatchMeta> = Vec::new();\n780\t        let mut zc_batch_x_blocks: Vec<u32> = Vec::new();\n781\t\n782\t        // Batched logup metadata + keep-alive buffers for per-AIR device data\n783\t        let mut logup_batch_metas: Vec<LogupBatchMeta> = Vec::new();\n784\t        let mut logup_batch_x_blocks: Vec<u32> = Vec::new();\n785\t        // Keep per-AIR logup device buffers alive until stream sync\n786\t        let mut logup_keepalive_rules: Vec<DeviceBuffer<u128>> = Vec::new();\n787\t        let mut logup_keepalive_numer_w: Vec<DeviceBuffer<EF>> = Vec::new();\n788\t        let mut logup_keepalive_denom_w: Vec<DeviceBuffer<EF>> = Vec::new();\n789\t\n790\t        // Sub-phase A: Classify AIRs and collect metadata\n791\t        for (trace_idx, ((air_idx, air_ctx), &n, selectors_cube, public_values, eq_3bs)) in izip!(\n792\t            &ctx.per_trace,\n793\t            &self.n_per_trace,\n794\t            &selectors_base,\n795\t            &self.public_values_per_trace,\n796\t            &self.eq_3b_per_trace,\n797\t        )\n798\t        .enumerate()\n799\t        {\n800\t            debug!(\"starting batch constraints for air_idx={air_idx} (trace_idx={trace_idx})\");\n801\t            let single_pk = &self.pk.per_air[*air_idx];\n802\t            let single_air_constraints =\n803\t                SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n804\t            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n805\t            debug_assert_eq!(\n806\t                single_air_constraints.max_constraint_degree(),\n807\t                local_constraint_deg\n808\t            );\n809\t            