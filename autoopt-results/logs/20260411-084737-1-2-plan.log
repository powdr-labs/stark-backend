{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W2AudAvZf3QGypvkG5SCiV","type":"tool_result","content":"730\t            .lambda_pows\n731\t            .as_ref()\n732\t            .expect(\"lambda powers must be set before round-0 evaluation\");\n733\t\n734\t        // Metadata stored per AIR during Phase 1, consumed in Phase 2\n735\t        struct Round0Pending<F, EF> {\n736\t            trace_idx: usize,\n737\t            air_idx: usize,\n738\t            num_cosets_zc: usize,\n739\t            num_cosets_logup: usize,\n740\t            local_constraint_deg: usize,\n741\t            omega_root: F,\n742\t            n: isize,\n743\t            // For individual (non-batched) launches:\n744\t            zc_result: DeviceBuffer<EF>,\n745\t            logup_result: DeviceBuffer<Frac<EF>>,\n746\t            // For batched launches (index within the batch, None if individual):\n747\t            zc_batch_idx: Option<usize>,\n748\t            logup_batch_idx: Option<usize>,\n749\t        }\n750\t\n751\t        let skip_domain: u32 = 1 << l_skip;\n752\t        let block_x = skip_domain.max(MAX_THREADS_ROUND0);\n753\t\n754\t        // Pre-check: disable batching if skip_domain is large enough that batch\n755\t        // temp buffers would exceed the memory budget. Each batched block contributes\n756\t        // max_num_cosets * skip_domain * sizeof(T) to the temp buffer. With ~600\n757\t        // AIRs and ~8 blocks each, the total can reach hundreds of MB.\n758\t        // Conservative estimate: if d * num_airs * max_blocks_per_air * sizeof(Frac<EF>) > 128 MB,\n759\t        // skip batching. This typically triggers for skip_domain >= 256.\n760\t        const BATCH_TMP_BUDGET: usize = 128 * 1024 * 1024;\n761\t        let max_cosets_estimate = self.constraint_degree; // upper bound\n762\t        let d_estimate = max_cosets_estimate * skip_domain as usize;\n763\t        let blocks_per_air_estimate = skip_domain.div_ceil(block_x) as usize;\n764\t        let estimated_batch_tmp = num_present_airs\n765\t            * blocks_per_air_estimate\n766\t            * d_estimate\n767\t            * std::mem::size_of::<Frac<EF>>();\n768\t        let batching_enabled = estimated_batch_tmp <= BATCH_TMP_BUDGET;\n769\t        debug!(\n770\t            \"Round 0: l_skip={l_skip}, skip_domain={skip_domain}, batching_enabled={batching_enabled}, estimated_tmp={estimated_batch_tmp}\"\n771\t        );\n772\t\n773\t        // Phase 1: Classify AIRs, collect metadata for batching, launch kernels.\n774\t        let mut pending: Vec<Round0Pending<F, EF>> = Vec::with_capacity(num_present_airs);\n775\t        let mut d_main_parts_vec: Vec<DeviceBuffer<*const F>> =\n776\t            Vec::with_capacity(num_present_airs);\n777\t\n778\t        // Batched zerocheck metadata\n779\t        let mut zc_batch_metas: Vec<ZerocheckBatchMeta> = Vec::new();\n780\t        let mut zc_batch_x_blocks: Vec<u32> = Vec::new();\n781\t\n782\t        // Batched logup metadata + keep-alive buffers for per-AIR device data\n783\t        let mut logup_batch_metas: Vec<LogupBatchMeta> = Vec::new();\n784\t        let mut logup_batch_x_blocks: Vec<u32> = Vec::new();\n785\t        // Keep per-AIR logup device buffers alive until stream sync\n786\t        let mut logup_keepalive_rules: Vec<DeviceBuffer<u128>> = Vec::new();\n787\t        let mut logup_keepalive_numer_w: Vec<DeviceBuffer<EF>> = Vec::new();\n788\t        let mut logup_keepalive_denom_w: Vec<DeviceBuffer<EF>> = Vec::new();\n789\t\n790\t        // Sub-phase A: Classify AIRs and collect metadata\n791\t        for (trace_idx, ((air_idx, air_ctx), &n, selectors_cube, public_values, eq_3bs)) in izip!(\n792\t            &ctx.per_trace,\n793\t            &self.n_per_trace,\n794\t            &selectors_base,\n795\t            &self.public_values_per_trace,\n796\t            &self.eq_3b_per_trace,\n797\t        )\n798\t        .enumerate()\n799\t        {\n800\t            debug!(\"starting batch constraints for air_idx={air_idx} (trace_idx={trace_idx})\");\n801\t            let single_pk = &self.pk.per_air[*air_idx];\n802\t            let single_air_constraints =\n803\t                SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n804\t            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n805\t            debug_assert_eq!(\n806\t                single_air_constraints.max_constraint_degree(),\n807\t                local_constraint_deg\n808\t            );\n809\t            assert!(\n810\t                local_constraint_deg <= self.constraint_degree,\n811\t                \"Max constraint degree ({local_constraint_deg}) of AIR {air_idx} exceeds the global maximum {}\",\n812\t                self.constraint_degree\n813\t            );\n814\t\n815\t            let log_large_domain = log2_ceil_usize(local_constraint_deg << l_skip);\n816\t            let omega_root = F::two_adic_generator(log_large_domain);\n817\t            assert!(!xi.is_empty(), \"xi vector must not be empty\");\n818\t\n819\t            let height = air_ctx.common_main.height();\n820\t            let mut main_parts = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n821\t            for committed in &air_ctx.cached_mains {\n822\t                main_parts.push(committed.trace.buffer().as_ptr());\n823\t            }\n824\t            main_parts.push(air_ctx.common_main.buffer().as_ptr());\n825\t            let d_main_parts = main_parts.to_device()?;\n826\t\n827\t            let n_lift = n.max(0) as usize;\n828\t            let num_x: u32 = 1 << n_lift;\n829\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n830\t            let max_temp_bytes = self.memory_limit_bytes;\n831\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n832\t            let num_cosets_logup = local_constraint_deg;\n833\t\n834\t            let is_coset_parallel = (num_x * skip_domain) < COSET_PARALLEL_THRESHOLD;\n835\t\n836\t            // --- Zerocheck classification ---\n837\t            let constraints_dag = &single_pk.vk.symbolic_constraints;\n838\t            let has_constraints =\n839\t                !constraints_dag.constraints.constraint_idx.is_empty() && num_cosets_zc > 0;\n840\t\n841\t            let zc_buffer_size = if has_constraints {\n842\t                single_pk.other_data.zerocheck_round0.inner.buffer_size\n843\t            } else {\n844\t                0\n845\t            };\n846\t            let zc_batch_eligible = batching_enabled\n847\t                && has_constraints\n848\t                && is_coset_parallel\n849\t                && zc_buffer_size <= BUFFER_THRESHOLD;\n850\t\n851\t            let (zc_result, zc_batch_idx) = if zc_batch_eligible {\n852\t                let idx = zc_batch_metas.len();\n853\t                let preprocessed_ptr = single_pk\n854\t                    .preprocessed_data\n855\t                    .as_ref()\n856\t                    .map(|cd| cd.trace.buffer().as_ptr())\n857\t                    .unwrap_or(std::ptr::null());\n858\t                let rules = &single_pk.other_data.zerocheck_round0.inner;\n859\t                zc_batch_metas.push(ZerocheckBatchMeta {\n860\t                    selectors_cube: selectors_cube.buffer().as_ptr(),\n861\t                    preprocessed: preprocessed_ptr,\n862\t                    main_parts: d_main_parts.as_ptr(),\n863\t                    eq_cube: eq_xi_tree.get_ptr(n_lift),\n864\t                    public_values: public_values.as_ptr(),\n865\t                    d_rules: rules.d_rules.as_raw_ptr(),\n866\t                    d_used_nodes: rules.d_used_nodes.as_ptr(),\n867\t                    rules_len: rules.d_rules.len(),\n868\t                    used_nodes_len: rules.d_used_nodes.len(),\n869\t                    buffer_size: zc_buffer_size,\n870\t                    num_x,\n871\t                    height: height as u32,\n872\t                    num_cosets: num_cosets_zc as u32,\n873\t                    g_shift: omega_root,\n874\t                });\n875\t                let x_blocks = (num_x * skip_domain).div_ceil(block_x);\n876\t                zc_batch_x_blocks.push(x_blocks);\n877\t                (DeviceBuffer::new(), Some(idx))\n878\t            } else {\n879\t                // Individual launch\n880\t                let result = evaluate_round0_constraints_gpu(\n881\t                    single_pk,\n882\t                    selectors_cube.buffer(),\n883\t                    &d_main_parts,\n884\t                    public_values,\n885\t                    eq_xi_tree.get_ptr(n_lift),\n886\t                    d_lambda_pows,\n887\t                    skip_domain,\n888\t                    num_x,\n889\t                    height as u32,\n890\t                    num_cosets_zc as u32,\n891\t                    omega_root,\n892\t                    max_temp_bytes,\n893\t                )?;\n894\t                (result, None)\n895\t            };\n896\t\n897\t            // --- Logup classification ---\n898\t            let has_interactions = !eq_3bs.is_empty();\n899\t            let (logup_result, logup_batch_idx) = if has_interactions {\n900\t                // Per-AIR CPU work: build symbolic DAG, compute weights\n901\t                use openvm_stark_backend::air_builders::symbolic::{\n902\t                    symbolic_expression::SymbolicExpression, SymbolicExpressionDag,\n903\t                };\n904\t\n905\t                use crate::logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu};\n906\t\n907\t                let mut dag_builder =\n908\t                    openvm_stark_backend::air_builders::symbolic::SymbolicDagBuilder::new();\n909\t                let mut sorted_used_dag_idxs = Vec::new();\n910\t                for interaction in &single_air_constraints.interactions {\n911\t                    let count = dag_builder.add_expr(&interaction.count);\n912\t                    sorted_used_dag_idxs.push(count);\n913\t                    sorted_used_dag_idxs.extend(\n914\t                        interaction\n915\t                            .message\n916\t                            .iter()\n917\t                            .map(|field_expr| dag_builder.add_expr(field_expr)),\n918\t                    );\n919\t                }\n920\t                sorted_used_dag_idxs.sort();\n921\t                sorted_used_dag_idxs.dedup();\n922\t                let dag = SymbolicExpressionDag {\n923\t                    nodes: dag_builder.nodes,\n924\t                    constraint_idx: sorted_used_dag_idxs,\n925\t                };\n926\t                let rules = SymbolicRulesGpu::new(&dag, true);\n927\t                let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n928\t                let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n929\t                let mut denom_sum_init = EF::ZERO;\n930\t                for (interaction_idx, interaction) in\n931\t                    single_air_constraints.interactions.iter().enumerate()\n932\t                {\n933\t                    let count_dag_idx = dag_builder.expr_to_idx\n934\t                        [&(&interaction.count as *const SymbolicExpression<_>)];\n935\t                    let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n936\t                    numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n937\t                    denom_sum_init += eq_3bs[interaction_idx]\n938\t                        * self.beta_pows[interaction.message.len()]\n939\t                        * F::from_u32(interaction.bus_index as u32 + 1);\n940\t\n941\t                    for (message_idx, message) in interaction.message.iter().enumerate() {\n942\t                        let message_dag_idx =\n943\t                            dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n944\t                        let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n945\t                        denom_weights[message_rule_idx] +=\n946\t                            eq_3bs[interaction_idx] * self.beta_pows[message_idx];\n947\t                    }\n948\t                }\n949\t\n950\t                let logup_buffer_size: u32 = rules.buffer_size.try_into().unwrap();\n951\t                let logup_batch_eligible =\n952\t                    batching_enabled && is_coset_parallel && logup_buffer_size <= BUFFER_THRESHOLD;\n953\t\n954\t                if logup_batch_eligible {\n955\t                    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n956\t                    let d_rules = encoded_rules.to_device()?;\n957\t                    let d_numer_weights = numer_weights.to_device()?;\n958\t                    let d_denom_weights = denom_weights.to_device()?;\n959\t\n960\t                    let preprocessed_ptr = single_pk\n961\t                        .preprocessed_data\n962\t                        .as_ref()\n963\t                        .map(|cd| cd.trace.buffer().as_ptr())\n964\t                        .unwrap_or(std::ptr::null());\n965\t\n966\t                    let idx = logup_batch_metas.len();\n967\t                    logup_batch_metas.push(LogupBatchMeta {\n968\t                        selectors_cube: selectors_cube.buffer().as_ptr(),\n969\t                        preprocessed: preprocessed_ptr,\n970\t                        main_parts: d_main_parts.as_ptr(),\n971\t                        eq_cube: eq_xi_tree.get_ptr(n_lift),\n972\t                        public_values: public_values.as_ptr(),\n973\t                        numer_weights: d_numer_weights.as_ptr(),\n974\t                        denom_weights: d_denom_weights.as_ptr(),\n975\t                        d_rules: d_rules.as_raw_ptr(),\n976\t                        rules_len: d_rules.len(),\n977\t                        denom_sum_init,\n978\t                        buffer_size: logup_buffer_size,\n979\t                        num_x,\n980\t                        height: height as u32,\n981\t                        num_cosets: num_cosets_logup as u32,\n982\t                        g_shift: omega_root,\n983\t                    });\n984\t                    let x_blocks = (num_x * skip_domain).div_ceil(block_x);\n985\t                    logup_batch_x_blocks.push(x_blocks);\n986\t\n987\t                    // Keep device buffers alive\n988\t                    logup_keepalive_rules.push(d_rules);\n989\t                    logup_keepalive_numer_w.push(d_numer_weights);\n990\t                    logup_keepalive_denom_w.push(d_denom_weights);\n991\t\n992\t                    (DeviceBuffer::new(), Some(idx))\n993\t                } else {\n994\t                    // Individual launch via existing function\n995\t                    let result = evaluate_round0_interactions_gpu(\n996\t                        single_pk,\n997\t                        &single_air_constraints,\n998\t                        selectors_cube.buffer(),\n999\t                        &d_main_parts,\n1000\t                        public_values,\n1001\t                        eq_xi_tree.get_ptr(n_lift),\n1002\t                        &self.beta_pows,\n1003\t                        eq_3bs,\n1004\t                        skip_domain,\n1005\t                        num_x,\n1006\t                        height as u32,\n1007\t                        num_cosets_logup as u32,\n1008\t                        omega_root,\n1009\t                        max_temp_bytes,\n1010\t                    )?;\n1011\t                    (result, None)\n1012\t                }\n1013\t            } else {\n1014\t                (DeviceBuffer::new(), None)\n1015\t            };\n1016\t\n1017\t            d_main_parts_vec.push(d_main_parts);\n1018\t            pending.push(Round0Pending {\n1019\t                trace_idx,\n1020\t                air_idx: *air_idx,\n1021\t                num_cosets_zc,\n1022\t                num_cosets_logup,\n1023\t                local_constraint_deg,\n1024\t                omega_root,\n1025\t                n,\n1026\t                zc_result,\n1027\t                logup_result,\n1028\t                zc_batch_idx,\n1029\t                logup_batch_idx,"}]},"parent_tool_use_id":"toolu_01GNjZk7xXZVohfSUdij8Mkz","session_id":"b7092ff3-dad3-4115-bd08-06aa847648b3","uuid":"03e7af4b-da4a-4dfd-a386-1e7f67899a83","timestamp":"2026-04-11T07:51:37.568Z"}
