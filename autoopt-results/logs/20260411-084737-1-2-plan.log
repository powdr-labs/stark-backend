{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PEZGEFBaKjv5tCwapK4mBH","type":"tool_result","content":"1\tuse std::fmt::Debug;\n2\t\n3\tuse p3_air::AirBuilder;\n4\tuse p3_field::{Field, PrimeCharacteristicRing};\n5\tuse p3_util::log2_ceil_usize;\n6\tuse serde::{Deserialize, Serialize};\n7\t\n8\tuse crate::air_builders::symbolic::symbolic_expression::SymbolicExpression;\n9\t\n10\t/// Interaction debugging tools\n11\tpub mod debug;\n12\t\n13\t// Must be a type smaller than u32 to make BusIndex p - 1 unrepresentable.\n14\tpub type BusIndex = u16;\n15\t\n16\t#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n17\tpub struct Interaction<Expr> {\n18\t    pub message: Vec<Expr>,\n19\t    pub count: Expr,\n20\t    /// The bus index specifying the bus to send the message over. All valid instantiations of\n21\t    /// `BusIndex` are safe.\n22\t    pub bus_index: BusIndex,\n23\t    /// Determines the contribution of each interaction message to a linear constraint on the trace\n24\t    /// heights in the verifier.\n25\t    ///\n26\t    /// For each bus index and trace, `count_weight` values are summed per interaction on that\n27\t    /// bus index and multiplied by the trace height. The total sum over all traces is constrained\n28\t    /// by the verifier to not overflow the field characteristic \\( p \\).\n29\t    ///\n30\t    /// This is used to impose sufficient conditions for bus constraint soundness and setting a\n31\t    /// proper value depends on the bus and the constraint it imposes.\n32\t    pub count_weight: u32,\n33\t}\n34\t\n35\tpub type SymbolicInteraction<F> = Interaction<SymbolicExpression<F>>;\n36\t\n37\t/// An [AirBuilder] with additional functionality to build special logUp arguments for\n38\t/// communication between AIRs across buses. These arguments use randomness to\n39\t/// add additional trace columns (in the extension field) and constraints to the AIR.\n40\t///\n41\t/// An interactive AIR is a AIR that can specify buses for sending and receiving data\n42\t/// to other AIRs. The original AIR is augmented by virtual columns determined by\n43\t/// the interactions to define a [RAP](crate::rap::Rap).\n44\tpub trait InteractionBuilder: AirBuilder<F: Field, Var: Copy> {\n45\t    /// Stores a new interaction in the builder.\n46\t    ///\n47\t    /// See [Interaction] for more details on `count_weight`.\n48\t    fn push_interaction<E: Into<Self::Expr>>(\n49\t        &mut self,\n50\t        bus_index: BusIndex,\n51\t        fields: impl IntoIterator<Item = E>,\n52\t        count: impl Into<Self::Expr>,\n53\t        count_weight: u32,\n54\t    );\n55\t\n56\t    /// Returns the current number of interactions.\n57\t    fn num_interactions(&self) -> usize;\n58\t\n59\t    /// Returns all interactions stored.\n60\t    fn all_interactions(&self) -> &[Interaction<Self::Expr>];\n61\t\n62\t    // This used to be in Plonky3 but is no longer there. We preserve the\n63\t    // implementation here for downstream callers.\n64\t    fn assert_tern(&mut self, x: impl Into<Self::Expr>) {\n65\t        let x = x.into();\n66\t        self.assert_zero(x.clone() * (x.clone() - Self::Expr::ONE) * (x - Self::Expr::TWO));\n67\t    }\n68\t}\n69\t\n70\t/// A `Lookup` bus is used to establish that one multiset of values (the queries) are subset of\n71\t/// another multiset of values (the keys).\n72\t///\n73\t/// Soundness requires that the total number of queries sent over the bus per message is at most the\n74\t/// field characteristic.\n75\t#[derive(Copy, Clone, Debug, PartialEq, Eq)]\n76\tpub struct LookupBus {\n77\t    pub index: BusIndex,\n78\t}\n79\t\n80\timpl LookupBus {\n81\t    pub const fn new(index: BusIndex) -> Self {\n82\t        Self { index }\n83\t    }\n84\t\n85\t    /// Performs a lookup on the given bus.\n86\t    ///\n87\t    /// This method asserts that `key` is present in the lookup table. The parameter `enabled`\n88\t    /// must be constrained to be boolean, and the lookup constraint is imposed provided `enabled`\n89\t    /// is one.\n90\t    ///\n91\t    /// Caller must constrain that `enabled` is boolean.\n92\t    pub fn lookup_key<AB, E>(\n93\t        &self,\n94\t        builder: &mut AB,\n95\t        query: impl IntoIterator<Item = E>,\n96\t        enabled: impl Into<AB::Expr>,\n97\t    ) where\n98\t        AB: InteractionBuilder,\n99\t        E: Into<AB::Expr>,\n100\t    {\n101\t        // We embed the query multiplicity as {0, 1} in the integers and the lookup table key\n102\t        // multiplicity to be {0, -1, ..., -p + 1}. Setting `count_weight = 1` will ensure that the\n103\t        // total number of lookups is at most p, which is sufficient to establish lookup multiset is\n104\t        // a subset of the key multiset. See Corollary 3.6 in\n105\t        // [docs/Soundess_of_Interactions_via_LogUp.pdf].\n106\t        builder.push_interaction(self.index, query, enabled, 1);\n107\t    }\n108\t\n109\t    /// Adds a key to the lookup table.\n110\t    ///\n111\t    /// The `num_lookups` parameter should equal the number of enabled lookups performed.\n112\t    pub fn add_key_with_lookups<AB, E>(\n113\t        &self,\n114\t        builder: &mut AB,\n115\t        key: impl IntoIterator<Item = E>,\n116\t        num_lookups: impl Into<AB::Expr>,\n117\t    ) where\n118\t        AB: InteractionBuilder,\n119\t        E: Into<AB::Expr>,\n120\t    {\n121\t        // Since we only want a subset constraint, `count_weight` can be zero here. See the comment\n122\t        // in `LookupBus::lookup_key`.\n123\t        builder.push_interaction(self.index, key, -num_lookups.into(), 0);\n124\t    }\n125\t}\n126\t\n127\t/// A `PermutationCheckBus` bus is used to establish that two multi-sets of values are equal.\n128\t///\n129\t/// Soundness requires that both the total number of messages sent and received over the bus per\n130\t/// message is at most the field characteristic.\n131\t#[derive(Copy, Clone, Debug, PartialEq, Eq)]\n132\tpub struct PermutationCheckBus {\n133\t    pub index: BusIndex,\n134\t}\n135\t\n136\t#[derive(Copy, Clone, Debug, PartialEq, Eq)]\n137\tpub enum PermutationInteractionType {\n138\t    Send,\n139\t    Receive,\n140\t}\n141\t\n142\timpl PermutationCheckBus {\n143\t    pub const fn new(index: BusIndex) -> Self {\n144\t        Self { index }\n145\t    }\n146\t\n147\t    /// Send a message.\n148\t    ///\n149\t    /// Caller must constrain `enabled` to be boolean.\n150\t    pub fn send<AB, E>("}]},"parent_tool_use_id":"toolu_014UkkwKYjphHPQNGM8xTpYp","session_id":"b7092ff3-dad3-4115-bd08-06aa847648b3","uuid":"c579eeb3-ad7a-406c-adcb-6218822b51c5","timestamp":"2026-04-11T07:42:34.452Z"}
