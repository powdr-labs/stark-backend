{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013UTjC4pzYf7Kk3cG4HKH53","type":"tool_result","content":"1\t// A simple custom codec for symbolic constraints that's easy to implement in CUDA\n2\t\n3\tuse openvm_stark_backend::air_builders::symbolic::symbolic_variable::{Entry, SymbolicVariable};\n4\tuse p3_field::{Field, PrimeField32};\n5\t\n6\tuse super::{Rule, RuleWithFlag, Source};\n7\t\n8\t// Basic codec trait\n9\tpub trait Codec {\n10\t    type Encoded;\n11\t\n12\t    fn encode(&self) -> Self::Encoded;\n13\t\n14\t    #[allow(unused)]\n15\t    fn decode(encoded: Self::Encoded) -> Self\n16\t    where\n17\t        Self: Sized;\n18\t}\n19\t\n20\tconst PREPROCESSED: u64 = 0;\n21\tconst MAIN: u64 = 1;\n22\tconst PERMUTATION: u64 = 2;\n23\tconst PUBLIC: u64 = 3;\n24\tconst CHALLENGE: u64 = 4;\n25\tconst EXPOSED: u64 = 5;\n26\t\n27\t// Entry is encoded in 16-bit little-endian\n28\timpl Codec for Entry {\n29\t    type Encoded = u64;\n30\t\n31\t    fn encode(&self) -> u64 {\n32\t        let (src, part_index, offset) = match self {\n33\t            Entry::Preprocessed { offset } => (PREPROCESSED, 0, *offset),\n34\t            Entry::Main { part_index, offset } => (MAIN, *part_index, *offset),\n35\t            Entry::Permutation { offset } => (PERMUTATION, 0, *offset),\n36\t            Entry::Public => (PUBLIC, 0, 0),\n37\t            Entry::Challenge => (CHALLENGE, 0, 0),\n38\t            Entry::Exposed => (EXPOSED, 0, 0),\n39\t        };\n40\t        // 4-bit src | 8-bit part_index | 4-bit offset\n41\t        assert!(src < 16);\n42\t        assert!(part_index < 256);\n43\t        assert!(offset < 16);\n44\t        src | (part_index << 4) as u64 | (offset << 12) as u64\n45\t    }\n46\t\n47\t    fn decode(encoded: u64) -> Self {\n48\t        // 4-bit src | 8-bit part_index | 4-bit offset\n49\t        let src = encoded & 0x0f;\n50\t        let part_index = ((encoded >> 4) & 0xff) as usize;\n51\t        let offset = ((encoded >> 12) & 0x0f) as usize;\n52\t        match src {\n53\t            PREPROCESSED => Entry::Preprocessed { offset },\n54\t            MAIN => Entry::Main { part_index, offset },\n55\t            PERMUTATION => Entry::Permutation { offset },\n56\t            PUBLIC => Entry::Public,\n57\t            CHALLENGE => Entry::Challenge,\n58\t            EXPOSED => Entry::Exposed,\n59\t            _ => panic!(\n60\t                \"Invalid Entry: src={} part_index={} offset={}\",\n61\t                src, part_index, offset\n62\t            ),\n63\t        }\n64\t    }\n65\t}\n66\t\n67\t// SymbolicVariable is encoded in 32-bit little-endian\n68\timpl<F: Field> Codec for SymbolicVariable<F> {\n69\t    type Encoded = u64;\n70\t\n71\t    fn encode(&self) -> u64 {\n72\t        let entry_code = self.entry.encode();\n73\t        let index = self.index as u64;\n74\t\n75\t        assert!(entry_code <= 0xffff);\n76\t        assert!(index <= 0xffff);\n77\t        // 16-bit entry | 16-bit index\n78\t        const ENTRY_SHIFT: u64 = 16;\n79\t        entry_code | (index << ENTRY_SHIFT)\n80\t    }\n81\t\n82\t    fn decode(encoded: u64) -> Self {\n83\t        // 16-bit entry | 16-bit index\n84\t        const ENTRY_MASK: u64 = 0xffff;\n85\t        const ENTRY_SHIFT: u64 = 16;\n86\t        let entry = Entry::decode(encoded & ENTRY_MASK);\n87\t        let index = (encoded >> ENTRY_SHIFT) as usize;\n88\t        Self::new(entry, index)\n89\t    }\n90\t}\n91\t\n92\t// 0..=5 is reserved for Source::Var\n93\tconst SOURCE_INTERMEDIATE: u64 = EXPOSED + 1;\n94\tconst SOURCE_CONSTANT: u64 = SOURCE_INTERMEDIATE + 1;\n95\tconst SOURCE_IS_FIRST: u64 = SOURCE_CONSTANT + 1;\n96\tconst SOURCE_IS_LAST: u64 = SOURCE_IS_FIRST + 1;\n97\tconst SOURCE_IS_TRANSITION: u64 = SOURCE_IS_LAST + 1;\n98\t\n99\t// Source is encoded in 48-bit little-endian and the enum discriminant is encoded by least\n100\t// significant 4-bits"}]},"parent_tool_use_id":"toolu_014UkkwKYjphHPQNGM8xTpYp","session_id":"b7092ff3-dad3-4115-bd08-06aa847648b3","uuid":"20975e76-661a-42f4-aa7c-a72342d5eb63","timestamp":"2026-04-11T07:42:25.429Z"}
