:c_void,\n44\t    pub d_used_nodes: *const usize,\n45\t    pub rules_len: usize,\n46\t    pub used_nodes_len: usize,\n47\t    pub buffer_size: u32,\n48\t    pub num_x: u32,\n49\t    pub height: u32,\n50\t    pub num_cosets: u32,\n51\t    pub g_shift: F,\n52\t}\n53\t\n54\t// SAFETY: All pointers refer to device memory managed by DeviceBuffer kept alive\n55\t// until stream sync.\n56\tunsafe impl Send for ZerocheckBatchMeta {}\n57\t\n58\t/// Per-AIR metadata for batched logup coset-parallel evaluation.\n59\t/// Must match the C struct `LogupBatchMeta` in logup_round0.cu exactly.\n60\t#[repr(C)]\n61\t#[derive(Clone, Copy)]\n62\tpub(crate) struct LogupBatchMeta {\n63\t    pub selectors_cube: *const F,\n64\t    pub preprocessed: *const F,\n65\t    pub main_parts: *const *const F,\n66\t    pub eq_cube: *const EF,\n67\t    pub public_values: *const F,\n68\t    pub numer_weights: *const EF,\n69\t    pub denom_weights: *const EF,\n70\t    pub d_rules: *const std::ffi::c_void,\n71\t    pub rules_len: usize,\n72\t    pub denom_sum_init: EF,\n73\t    pub buffer_size: u32,\n74\t    pub num_x: u32,\n75\t    pub height: u32,\n76\t    pub num_cosets: u32,\n77\t    pub g_shift: F,\n78\t}\n79\t\n80\t// SAFETY: All pointers refer to device memory managed by DeviceBuffer kept alive\n81\t// until stream sync.\n82\tunsafe impl Send for LogupBatchMeta {}\n83\t\n84\t/// Evaluate plain AIR constraints (not interactions) for a single AIR, given prepared trace input.\n85\t///\n86\t/// `num_cosets` should equal `constraint_degree - 1` because we evaluate the quotient polynomial.\n87\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n88\t#[allow(clippy::too_many_arguments)]\n89\tpub fn evaluate_round0_constraints_gpu<HS: GpuHashScheme>(\n90\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n91\t    selectors_cube: &DeviceBuffer<F>,\n92\t    main_parts: &DeviceBuffer<*const F>,\n93\t    public_values: &DeviceBuffer<F>,\n94\t    eq_cube: *const EF,\n95\t    lambda_pows: &DeviceBuffer<EF>,\n96\t    skip_domain: u32,\n97\t    num_x: u32,\n98\t    height: u32,\n99\t    num_cosets: u32,\n100\t    g_shift: F,\n101\t    max_temp_bytes: usize,\n102\t) -> Result<DeviceBuffer<EF>, Round0EvalError> {\n103\t    let constraints_dag = &pk.vk.symbolic_constraints;\n104\t    if constraints_dag.constraints.constraint_idx.is_empty() || num_cosets == 0 {\n105\t        // No plain AIR constraints, return empty buffer\n106\t        return Ok(DeviceBuffer::new());\n107\t    }\n108\t\n109\t    let rules = &pk.other_data.zerocheck_round0;\n110\t\n111\t    let buffer_size: u32 = rules.inner.buffer_size;\n112\t    let intermed_capacity = unsafe {\n113\t        _zerocheck_r0_intermediates_buffer_size(\n114\t            buffer_size,\n115\t            skip_domain,\n116\t            num_x,\n117\t            num_cosets,\n118\t            max_temp_bytes,\n119\t        )\n120\t    };\n121\t    let mut intermediates = if intermed_capacity > 0 {\n122\t        debug!(\"zerocheck:intermediates_capacity={intermed_capacity}\");\n123\t        DeviceBuffer::<F>::with_capacity(intermed_capacity)\n124\t    } else {\n125\t        DeviceBuffer::<F>::new()\n126\t    };\n127\t\n128\t    let temp_sums_buffer_capacity = unsafe {\n129\t        _zerocheck_r0_temp_sums_buffer_size(\n130\t            buffer_size,\n131\t            skip_domain,\n132\t            num_x,\n133\t            num_cosets,\n134\t            max_temp_bytes,\n135\t        )\n136\t    };\n137\t    debug!(\"zerocheck:temp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n138\t    let mut temp_sums_buffer = DeviceBuffer::<EF>::with_capacity(temp_sums_buffer_capacity);\n139\t    let used_temp_bytes =\n140\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<EF>();\n141\t    if used_temp_bytes > max_temp_bytes {\n142\t        // We do not error if the required bytes is greater than the requested max, but this may\n143\t        // lead to unexpected peak memory usage.\n144\t        warn!(\"zerocheck used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\");\n145\t    }\n146\t\n147\t    let preprocessed_ptr = pk\n148\t        .preprocessed_data\n149\t        .as_ref()\n150\t        .map(|cd| cd.trace.buffer().as_ptr())\n151\t        .unwrap_or(std::ptr::null());\n152\t\n153\t    let mut sp_evals =\n154\t        DeviceBuffer::<EF>::with_capacity(num_cosets as usize * skip_domain as usize);\n155\t    // SAFETY:\n156\t    // - No bounds checks are done in this kernel. It fully assumes that the Rules are trusted and\n157\t    //   all nodes are valid.\n158\t    unsafe {\n159\t        zerocheck_ntt_eval_constraints(\n160\t            &mut temp_sums_buffer,\n161\t            &mut sp_evals,\n162\t            selectors_cube,\n163\t            preprocessed_ptr,\n164\t            main_parts,\n165\t            eq_cube,\n166\t            lambda_pows,\n167\t            public_values,\n168\t            &rules.inner.d_rules,\n169\t            &rules.inner.d_used_nodes,\n170\t            buffer_size,\n171\t            &mut intermediates,\n172\t            skip_domain,\n173\t            num_x,\n174\t            height,\n175\t            num_cosets,\n176\t            g_shift,\n177\t            max_temp_bytes,\n178\t        )?;\n179\t    }\n180\t\n181\t    Ok(sp_evals)\n182\t}\n183\t\n184\t/// Evaluate interaction constraints (excluding plain AIR constraints) for a single AIR, given\n185\t/// prepared trace input.\n186\t///\n187\t/// `constraints` includes interaction expressions for the AIR.\n188\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n189\t#[allow(clippy::too_many_arguments)]\n190\tpub fn evaluate_round0_interactions_gpu<HS: GpuHashScheme>(\n191\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n192\t    symbolic: &SymbolicConstraints<F>,\n193\t    selectors_cube: &DeviceBuffer<F>,\n194\t    main_parts: &DeviceBuffer<*const F>,\n195\t    public_values: &DeviceBuffer<F>,\n196\t    eq_cube: *const EF,\n197\t    beta_pows: &[EF],\n198\t    eq_3bs: &[EF],\n199\t    skip_domain: u32,\n200\t    num_x: u32,\n201\t    height: u32,\n202\t    num_cosets: u32,\n203\t    g_shift: F,\n204\t    max_temp_bytes: usize,\n205\t) -> Result<DeviceBuffer<Frac<EF>>, Round0EvalError> {\n206\t    // Check if this trace has interactions\n207\t    if eq_3bs.is_empty() {\n208\t        return Ok(DeviceBuffer::new());\n209\t    }\n210\t    let large_domain = num_cosets * skip_domain;\n211\t\n212\t    // We create a new \"interactions DAG\" where the new .constraints are the interaction [count,\n213\t    // message_0, message_1, ..] expressions themselves, while the .interactions are empty\n214\t    // We track the indices with InteractionNode\n215\t\n216\t    // Copied from build_symbolic_constraints_dag to handle sorting of constraints\n217\t    // NOTE: For logup round0, the kernel uses weights indexed by rule_idx, not constraint_idx.\n218\t    // So we deduplicate constraint_idx and use dag_idx_to_rule_idx for weight mapping.\n219\t    let (rules, d_numer_weights, d_denom_weights, denom_sum_init) = {\n220\t        let mut dag_builder = SymbolicDagBuilder::new();\n221\t        let mut sorted_used_dag_idxs = Vec::new();\n222\t        for interaction in &symbolic.interactions {\n223\t            let count = dag_builder.add_expr(&interaction.count);\n224\t            sorted_used_dag_idxs.push(count);\n225\t            sorted_used_dag_idxs.extend(\n226\t                interaction\n227\t                    .message\n228\t                    .iter()\n229\t                    .map(|field_expr| dag_builder.add_expr(field_expr)),\n230\t            );\n231\t        }\n232\t        sorted_used_dag_idxs.sort();\n233\t        // Deduplicate for the dag since logup round0 kernel doesn't use used_nodes\n234\t        sorted_used_dag_idxs.dedup();\n235\t        let dag = SymbolicExpressionDag {\n236\t            nodes: dag_builder.nodes,\n237\t            constraint_idx: sorted_used_dag_idxs,\n238\t        };\n239\t        let rules = SymbolicRulesGpu::new(&dag, true);\n240\t        let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n241\t        let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n242\t        let mut denom_sum_init = EF::ZERO;\n243\t        for (interaction_idx, interaction) in symbolic.interactions.iter().enumerate() {\n244\t            // CAUTION: an expression node could be used in multiple interactions, and might even be\n245\t            // used as `count` in one, but message field in another. We only care about their\n246\t            // weighted sum with eq_3b, so we compute the weights ahead of time.\n247\t            let count_dag_idx =\n248\t                dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];\n249\t            let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n250\t            numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n251\t            denom_sum_init += eq_3bs[interaction_idx]\n252\t                * beta_pows[interaction.message.len()]\n253\t                * F::from_u32(interaction.bus_index as u32 + 1);\n254\t\n255\t            for (message_idx, message) in interaction.message.iter().enumerate() {\n256\t                let message_dag_idx =\n257\t                    dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n258\t                let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n259\t                denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];\n260\t            }\n261\t        }\n262\t        let d_numer_weights = numer_weights.to_device()?;\n263\t        let d_denom_weights = denom_weights.to_device()?;\n264\t        (rules, d_numer_weights, d_denom_weights, denom_sum_init)\n265\t    };\n266\t\n267\t    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n268\t    let d_rules = encoded_rules.to_device()?;\n269\t\n270\t    let buffer_size: u32 = rules.buffer_size.try_into().unwrap();\n271\t    let intermed_capacity = unsafe {\n272\t        _logup_r0_intermediates_buffer_size(\n273\t            buffer_size,\n274\t            skip_domain,\n275\t            num_x,\n276\t            num_cosets,\n277\t            max_temp_bytes,\n278\t        )\n279\t    };\n280\t    let mut intermediates = if intermed_capacity > 0 {\n281\t        debug!(\"logup_r0:intermediates_capacity={intermed_capacity}\");\n282\t        DeviceBuffer::<F>::with_capacity(intermed_capacity)\n283\t    } else {\n284\t        DeviceBuffer::<F>::new()\n285\t    };\n286\t\n287\t    let temp_sums_buffer_capacity = unsafe {\n288\t        _logup_r0_temp_sums_buffer_size(buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes)\n289\t    };\n290\t    debug!(\"logup_r0:tmp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n291\t    let mut temp_sums_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(temp_sums_buffer_capacity);\n292\t    let used_temp_bytes =\n293\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<Frac<EF>>();\n294\t    if used_temp_bytes > max_temp_bytes {\n295\t        warn!(\n296\t            \"logup_round0 used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\"\n297\t        );\n298\t    }\n299\t\n300\t    let preprocessed_ptr = pk\n301\t        .preprocessed_data\n302\t        .as_ref()\n303\t        .map(|cd| cd.trace.buffer().as_ptr())\n304\t        .unwrap_or(std::ptr::null());\n305\t\n306\t    let mut s_evals = DeviceBuffer::<Frac<EF>>::with_capacity(large_domain as usize);\n307\t\n308\t    unsafe {\n309\t        logup_bary_eval_interactions_round0(\n310\t            &mut temp_sums_buffer,\n311\t            &mut s_evals,\n312\t            selectors_cube,\n313\t            preprocessed_ptr,\n314\t            main_parts,\n315\t            eq_cube,\n316\t            public_values,\n317\t            &d_numer_weights,\n318\t            &d_denom_weights,\n319\t            denom_sum_init,\n320\t            &d_rules,\n321\t            buffer_size,\n322\t            &mut intermediates,\n323\t            skip_domain,\n324\t            num_x,\n325\t            height,\n326\t            num_cosets,\n327\t            g_shift,\n328\t            max_temp_bytes,\n329\t        )?;\n330\t    }\n331\t\n332\t    Ok(s_evals)\n333\t}\n334\t"}]},"parent_tool_use_id":"toolu_01V4H1wszCt4FJV4NQXjUweb","session_id":"b7092ff3-dad3-4115-bd08-06aa847648b3","uuid":"256daa86-4d7e-4640-ad69-4d6bd4117049","timestamp":"2026-04-11T07:46:14.811Z"}
