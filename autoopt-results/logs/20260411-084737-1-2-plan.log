{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T5GuYddgikp5AFAJdpdZA2","type":"tool_result","content":"1\t// Originally copied from uni-stark/src/symbolic_builder.rs to allow A: ?Sized\n2\t\n3\tuse std::iter;\n4\t\n5\tuse itertools::Itertools;\n6\tuse p3_air::{\n7\t    Air, AirBuilder, AirBuilderWithPublicValues, BaseAirWithPublicValues, ExtensionBuilder,\n8\t    PairBuilder, PermutationAirBuilder,\n9\t};\n10\tuse p3_field::Field;\n11\tuse p3_matrix::{dense::RowMajorMatrix, Matrix};\n12\tuse tracing::instrument;\n13\t\n14\tuse self::{\n15\t    symbolic_expression::SymbolicExpression,\n16\t    symbolic_variable::{Entry, SymbolicVariable},\n17\t};\n18\tuse super::PartitionedAirBuilder;\n19\tuse crate::{\n20\t    interaction::{Interaction, InteractionBuilder, SymbolicInteraction},\n21\t    keygen::types::TraceWidth,\n22\t};\n23\t\n24\tmod dag;\n25\tpub mod statistics;\n26\tpub mod symbolic_expression;\n27\tpub mod symbolic_variable;\n28\t\n29\tpub use dag::*;\n30\t\n31\tuse crate::interaction::BusIndex;\n32\t\n33\t/// Symbolic constraints for a single AIR with interactions.\n34\t#[derive(Clone, Debug)]\n35\tpub struct SymbolicConstraints<F> {\n36\t    /// All plain AIR constraints. These do **not** include interaction constraints that are proven\n37\t    /// via LogUp-GKR.\n38\t    pub constraints: Vec<SymbolicExpression<F>>,\n39\t    /// Symbolic representation of interactions. These are converted into a LogUp fractional sum\n40\t    /// which must be proven using GKR.\n41\t    pub interactions: Vec<SymbolicInteraction<F>>,\n42\t}\n43\t\n44\timpl<F: Field> SymbolicConstraints<F> {\n45\t    pub fn max_constraint_degree(&self) -> usize {\n46\t        iter::empty()\n47\t            .chain(&self.constraints)\n48\t            .chain(\n49\t                self.interactions\n50\t                    .iter()\n51\t                    .flat_map(|i| iter::once(&i.count).chain(&i.message)),\n52\t            )\n53\t            .map(|expr| expr.degree_multiple())\n54\t            .max()\n55\t            .unwrap_or(0)\n56\t    }\n57\t\n58\t    /// Returns the maximum field degree and count degree across all interactions\n59\t    pub fn max_interaction_degrees(&self) -> (usize, usize) {\n60\t        let max_field_degree = self\n61\t            .interactions\n62\t            .iter()\n63\t            .map(|interaction| {\n64\t                interaction\n65\t                    .message\n66\t                    .iter()\n67\t                    .map(|field| field.degree_multiple())\n68\t                    .max()\n69\t                    .unwrap_or(0)\n70\t            })\n71\t            .max()\n72\t            .unwrap_or(0);\n73\t\n74\t        let max_count_degree = self\n75\t            .interactions\n76\t            .iter()\n77\t            .map(|interaction| interaction.count.degree_multiple())\n78\t            .max()\n79\t            .unwrap_or(0);\n80\t\n81\t        (max_field_degree, max_count_degree)\n82\t    }\n83\t}\n84\t\n85\t#[instrument(name = \"evaluate constraints symbolically\", skip_all, level = \"debug\")]\n86\tpub fn get_symbolic_builder<F, R>(\n87\t    rap: &R,\n88\t    width: &TraceWidth,\n89\t    num_challenges_to_sample: &[usize],\n90\t    num_exposed_values_after_challenge: &[usize],\n91\t) -> SymbolicRapBuilder<F>\n92\twhere\n93\t    F: Field,\n94\t    R: Air<SymbolicRapBuilder<F>> + BaseAirWithPublicValues<F> + ?Sized,\n95\t{\n96\t    let mut builder = SymbolicRapBuilder::new(\n97\t        width,\n98\t        rap.num_public_values(),\n99\t        num_challenges_to_sample,\n100\t        num_exposed_values_after_challenge,\n101\t    );\n102\t    Air::eval(rap, &mut builder);\n103\t    builder\n104\t}\n105\t\n106\t/// An `AirBuilder` for evaluating constraints symbolically, and recording them for later use.\n107\t#[derive(Debug)]\n108\tpub struct SymbolicRapBuilder<F> {\n109\t    preprocessed: RowMajorMatrix<SymbolicVariable<F>>,\n110\t    partitioned_main: Vec<RowMajorMatrix<SymbolicVariable<F>>>,\n111\t    after_challenge: Vec<RowMajorMatrix<SymbolicVariable<F>>>,\n112\t    public_values: Vec<SymbolicVariable<F>>,\n113\t    challenges: Vec<Vec<SymbolicVariable<F>>>,\n114\t    exposed_values_after_challenge: Vec<Vec<SymbolicVariable<F>>>,\n115\t    constraints: Vec<SymbolicExpression<F>>,\n116\t    interactions: Vec<SymbolicInteraction<F>>,\n117\t    trace_width: TraceWidth,\n118\t}\n119\t\n120\timpl<F: Field> SymbolicRapBuilder<F> {\n121\t    /// - `num_challenges_to_sample`: for each challenge phase, how many challenges to sample\n122\t    /// - `num_exposed_values_after_challenge`: in each challenge phase, how many values to expose\n123\t    ///   to verifier\n124\t    pub(crate) fn new(\n125\t        width: &TraceWidth,\n126\t        num_public_values: usize,\n127\t        num_challenges_to_sample: &[usize],\n128\t        num_exposed_values_after_challenge: &[usize],\n129\t    ) -> Self {\n130\t        let preprocessed_width = width.preprocessed.unwrap_or(0);\n131\t        let prep_values = [0, 1]\n132\t            .into_iter()\n133\t            .flat_map(|offset| {\n134\t                (0..width.preprocessed.unwrap_or(0))\n135\t                    .map(move |index| SymbolicVariable::new(Entry::Preprocessed { offset }, index))\n136\t            })\n137\t            .collect();\n138\t        let preprocessed = RowMajorMatrix::new(prep_values, preprocessed_width);\n139\t\n140\t        let mut partitioned_main: Vec<_> = width\n141\t            .cached_mains\n142\t            .iter()\n143\t            .enumerate()\n144\t            .map(|(part_index, &width)| gen_main_trace(part_index, width))\n145\t            .collect();\n146\t        if width.common_main != 0 {\n147\t            partitioned_main.push(gen_main_trace(width.cached_mains.len(), width.common_main));\n148\t        }\n149\t        let after_challenge = Self::new_after_challenge(&width.after_challenge);\n150\t\n151\t        let public_values = (0..num_public_values)\n152\t            .map(move |index| SymbolicVariable::new(Entry::Public, index))\n153\t            .collect();\n154\t\n155\t        let challenges = Self::new_challenges(num_challenges_to_sample);\n156\t\n157\t        let exposed_values_after_challenge =\n158\t            Self::new_exposed_values_after_challenge(num_exposed_values_after_challenge);\n159\t\n160\t        Self {\n161\t            preprocessed,\n162\t            partitioned_main,\n163\t            after_challenge,\n164\t            public_values,\n165\t            challenges,\n166\t            exposed_values_after_challenge,\n167\t            constraints: vec![],\n168\t            interactions: vec![],\n169\t            trace_width: width.clone(),\n170\t        }\n171\t    }\n172\t\n173\t    pub fn constraints(self) -> SymbolicConstraints<F> {\n174\t        SymbolicConstraints {\n175\t            constraints: self.constraints,\n176\t            interactions: self.interactions,\n177\t        }\n178\t    }\n179\t\n180\t    pub fn num_public_values(&self) -> usize {\n181\t        self.public_values.len()\n182\t    }\n183\t\n184\t    pub fn width(&self) -> TraceWidth {\n185\t        let mut ret = self.trace_width.clone();\n186\t        ret.after_challenge = self.after_challenge.iter().map(|m| m.width()).collect();\n187\t        ret\n188\t    }\n189\t\n190\t    #[deprecated]\n191\t    pub fn num_exposed_values_after_challenge(&self) -> Vec<usize> {\n192\t        self.exposed_values_after_challenge\n193\t            .iter()\n194\t            .map(|c| c.len())\n195\t            .collect()\n196\t    }\n197\t\n198\t    #[deprecated]\n199\t    pub fn num_challenges_to_sample(&self) -> Vec<usize> {\n200\t        self.challenges.iter().map(|c| c.len()).collect()\n201\t    }\n202\t\n203\t    fn new_after_challenge(\n204\t        width_after_phase: &[usize],\n205\t    ) -> Vec<RowMajorMatrix<SymbolicVariable<F>>> {\n206\t        width_after_phase\n207\t            .iter()\n208\t            .map(|&width| {\n209\t                let mat_values = [0, 1]\n210\t                    .into_iter()\n211\t                    .flat_map(|offset| {\n212\t                        (0..width).map(move |index| {\n213\t                            SymbolicVariable::new(Entry::Permutation { offset }, index)\n214\t                        })\n215\t                    })\n216\t                    .collect_vec();\n217\t                RowMajorMatrix::new(mat_values, width)\n218\t            })\n219\t            .collect_vec()\n220\t    }\n221\t\n222\t    fn new_challenges(num_challenges_to_sample: &[usize]) -> Vec<Vec<SymbolicVariable<F>>> {\n223\t        num_challenges_to_sample\n224\t            .iter()\n225\t            .map(|&num_challenges| {\n226\t                (0..num_challenges)\n227\t                    .map(|index| SymbolicVariable::new(Entry::Challenge, index))\n228\t                    .collect_vec()\n229\t            })\n230\t            .collect_vec()\n231\t    }\n232\t\n233\t    fn new_exposed_values_after_challenge(\n234\t        num_exposed_values_after_challenge: &[usize],\n235\t    ) -> Vec<Vec<SymbolicVariable<F>>> {\n236\t        num_exposed_values_after_challenge\n237\t            .iter()\n238\t            .map(|&num| {\n239\t                (0..num)\n240\t                    .map(|index| SymbolicVariable::new(Entry::Exposed, index))\n241\t                    .collect_vec()\n242\t            })\n243\t            .collect_vec()\n244\t    }\n245\t}\n246\t\n247\timpl<F: Field> AirBuilder for SymbolicRapBuilder<F> {\n248\t    type F = F;\n249\t    type Expr = SymbolicExpression<Self::F>;\n250\t    type Var = SymbolicVariable<Self::F>;\n251\t    type M = RowMajorMatrix<Self::Var>;\n252\t\n253\t    /// It is difficult to horizontally concatenate matrices when the main trace is partitioned, so\n254\t    /// we disable this method in that case.\n255\t    fn main(&self) -> Self::M {\n256\t        if self.partitioned_main.len() == 1 {\n257\t            self.partitioned_main[0].clone()\n258\t        } else {\n259\t            panic!(\"Main trace is either empty or partitioned. This function should not be used.\")\n260\t        }\n261\t    }\n262\t\n263\t    fn is_first_row(&self) -> Self::Expr {\n264\t        SymbolicExpression::IsFirstRow\n265\t    }\n266\t\n267\t    fn is_last_row(&self) -> Self::Expr {\n268\t        SymbolicExpression::IsLastRow\n269\t    }\n270\t\n271\t    fn is_transition_window(&self, size: usize) -> Self::Expr {\n272\t        if size == 2 {\n273\t            SymbolicExpression::IsTransition\n274\t        } else {\n275\t            panic!(\"uni-stark only supports a window size of 2\")\n276\t        }\n277\t    }\n278\t\n279\t    fn assert_zero<I: Into<Self::Expr>>(&mut self, x: I) {\n280\t        self.constraints.push(x.into());\n281\t    }\n282\t}\n283\t\n284\timpl<F: Field> PairBuilder for SymbolicRapBuilder<F> {\n285\t    fn preprocessed(&self) -> Self::M {\n286\t        self.preprocessed.clone()\n287\t    }\n288\t}\n289\t\n290\timpl<F: Field> ExtensionBuilder for SymbolicRapBuilder<F> {\n291\t    type EF = F;\n292\t    type ExprEF = SymbolicExpression<F>;\n293\t    type VarEF = SymbolicVariable<F>;\n294\t\n295\t    fn assert_zero_ext<I>(&mut self, x: I)\n296\t    where\n297\t        I: Into<Self::ExprEF>,\n298\t    {\n299\t        self.constraints.push(x.into());\n300\t    }\n301\t}\n302\t\n303\timpl<F: Field> AirBuilderWithPublicValues for SymbolicRapBuilder<F> {\n304\t    type PublicVar = SymbolicVariable<F>;\n305\t\n306\t    fn public_values(&self) -> &[Self::PublicVar] {\n307\t        &self.public_values\n308\t    }\n309\t}\n310\t\n311\timpl<F: Field> PermutationAirBuilder for SymbolicRapBuilder<F> {\n312\t    type MP = RowMajorMatrix<Self::VarEF>;\n313\t    type RandomVar = SymbolicVariable<F>;\n314\t\n315\t    fn permutation(&self) -> Self::MP {\n316\t        self.after_challenge\n317\t            .first()\n318\t            .expect(\"Challenge phase not supported\")\n319\t            .clone()\n320\t    }\n321\t\n322\t    fn permutation_randomness(&self) -> &[Self::RandomVar] {\n323\t        self.challenges\n324\t            .first()\n325\t            .map(|c| c.as_slice())\n326\t            .expect(\"Challenge phase not supported\")\n327\t    }\n328\t}\n329\t\n330\timpl<F: Field> InteractionBuilder for SymbolicRapBuilder<F> {\n331\t    fn push_interaction<E: Into<Self::Expr>>(\n332\t        &mut self,\n333\t        bus_index: BusIndex,\n334\t        fields: impl IntoIterator<Item = E>,\n335\t        count: impl Into<Self::Expr>,\n336\t        count_weight: u32,\n337\t    ) {\n338\t        let fields = fields.into_iter().map(|f| f.into()).collect();\n339\t        let count = count.into();\n340\t        self.interactions.push(Interaction {\n341\t            bus_index,\n342\t            message: fields,\n343\t            count,\n344\t            count_weight,\n345\t        });\n346\t    }\n347\t\n348\t    fn num_interactions(&self) -> usize {\n349\t        self.interactions.len()\n350\t    }\n351\t\n352\t    fn all_interactions(&self) -> &[Interaction<Self::Expr>] {\n353\t        &self.interactions\n354\t    }\n355\t}\n356\t\n357\timpl<F: Field> PartitionedAirBuilder for SymbolicRapBuilder<F> {\n358\t    fn cached_mains(&self) -> &[Self::M] {\n359\t        &self.partitioned_main[..self.trace_width.cached_mains.len()]\n360\t    }\n361\t    fn common_main(&self) -> &Self::M {\n362\t        assert_ne!(\n363\t            self.trace_width.common_main, 0,\n364\t            \"AIR doesn't have a common main trace\"\n365\t        );\n366\t        &self.partitioned_main[self.trace_width.cached_mains.len()]\n367\t    }\n368\t}\n369\t\n370\t#[allow(dead_code)]\n371\tstruct LocalOnlyChecker;\n372\t\n373\t#[allow(dead_code)]\n374\timpl LocalOnlyChecker {\n375\t    fn check_var<F: Field>(var: SymbolicVariable<F>) -> bool {\n376\t        match var.entry {\n377\t            Entry::Preprocessed { offset } => offset == 0,\n378\t            Entry::Main { offset, .. } => offset == 0,\n379\t            Entry::Permutation { offset } => offset == 0,\n380\t            Entry::Public => true,\n381\t            Entry::Challenge => true,\n382\t            Entry::Exposed => true,\n383\t        }\n384\t    }\n385\t\n386\t    fn check_expr<F: Field>(expr: &SymbolicExpression<F>) -> bool {\n387\t        match expr {\n388\t            SymbolicExpression::Variable(var) => Self::check_var(*var),\n389\t            SymbolicExpression::IsFirstRow => false,\n390\t            SymbolicExpression::IsLastRow => false,\n391\t            SymbolicExpression::IsTransition => false,\n392\t            SymbolicExpression::Constant(_) => true,\n393\t            SymbolicExpression::Add { x, y, .. } => Self::check_expr(x) && Self::check_expr(y),\n394\t            SymbolicExpression::Sub { x, y, .. } => Self::check_expr(x) && Self::check_expr(y),\n395\t            SymbolicExpression::Neg { x, .. } => Self::check_expr(x),\n396\t            SymbolicExpression::Mul { x, y, .. } => Self::check_expr(x) && Self::check_expr(y),\n397\t        }\n398\t    }\n399\t}\n400\t\n401\tfn gen_main_trace<F: Field>(\n402\t    part_index: usize,\n403\t    width: usize,\n404\t) -> RowMajorMatrix<SymbolicVariable<F>> {\n405\t    let mat_values = [0, 1]\n406\t        .into_iter()\n407\t        .flat_map(|offset| {\n408\t            (0..width)\n409\t                .map(move |index| SymbolicVariable::new(Entry::Main { part_index, offset }, index))\n410\t        })\n411\t        .collect_vec();\n412\t    RowMajorMatrix::new(mat_values, width)\n413\t}\n414\t"}]},"parent_tool_use_id":"toolu_01V4H1wszCt4FJV4NQXjUweb","session_id":"b7092ff3-dad3-4115-bd08-06aa847648b3","uuid":"7ccaf1f3-0e11-4ad8-8d61-500550dae37e","timestamp":"2026-04-11T07:46:02.690Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0197cYj5XTb5T2uxdFsefTyW","type":"tool_result","content":"1\tuse std::sync::Arc;\n2\t\n3\tuse p3_field::Field;\n4\tuse rustc_hash::FxHashMap;\n5\tuse serde::{Deserialize, Serialize};\n6\t\n7\tuse super::SymbolicConstraints;\n8\tuse crate::{\n9\t    air_builders::symbolic::{\n10\t        symbolic_expression::SymbolicExpression, symbolic_variable::SymbolicVariable,\n11\t    },\n12\t    interaction::{Interaction, SymbolicInteraction},\n13\t};\n14\t\n15\t/// A node in symbolic expression DAG.\n16\t/// Basically replace `Arc`s in `SymbolicExpression` with node IDs.\n17\t/// Intended to be serializable and deserializable.\n18\t#[derive(Clone, Debug, Hash, Serialize, Deserialize, PartialEq, Eq)]\n19\t#[serde(bound(serialize = \"F: Serialize\", deserialize = \"F: Deserialize<'de>\"))]\n20\t#[repr(C)]\n21\tpub enum SymbolicExpressionNode<F> {\n22\t    Variable(SymbolicVariable<F>),\n23\t    IsFirstRow,\n24\t    IsLastRow,\n25\t    IsTransition,\n26\t    Constant(F),\n27\t    Add {\n28\t        left_idx: usize,\n29\t        right_idx: usize,\n30\t        degree_multiple: usize,\n31\t    },\n32\t    Sub {\n33\t        left_idx: usize,\n34\t        right_idx: usize,\n35\t        degree_multiple: usize,\n36\t    },\n37\t    Neg {\n38\t        idx: usize,\n39\t        degree_multiple: usize,\n40\t    },\n41\t    Mul {\n42\t        left_idx: usize,\n43\t        right_idx: usize,\n44\t        degree_multiple: usize,\n45\t    },\n46\t}\n47\t\n48\t#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n49\t#[serde(bound(serialize = \"F: Serialize\", deserialize = \"F: Deserialize<'de>\"))]\n50\t#[repr(C)]\n51\tpub struct SymbolicExpressionDag<F> {\n52\t    /// Nodes in **topological** order.\n53\t    pub nodes: Vec<SymbolicExpressionNode<F>>,\n54\t    /// Node indices of expressions to assert equal zero.\n55\t    pub constraint_idx: Vec<usize>,\n56\t}\n57\t\n58\timpl<F> SymbolicExpressionDag<F> {\n59\t    pub fn max_rotation(&self) -> usize {\n60\t        let mut rotation = 0;\n61\t        for node in &self.nodes {\n62\t            if let SymbolicExpressionNode::Variable(var) = node {\n63\t                rotation = rotation.max(var.entry.offset().unwrap_or(0));\n64\t            }\n65\t        }\n66\t        rotation\n67\t    }\n68\t\n69\t    pub fn num_constraints(&self) -> usize {\n70\t        self.constraint_idx.len()\n71\t    }\n72\t}\n73\t\n74\t#[derive(Clone, Debug, Serialize, Deserialize)]\n75\t#[serde(bound(serialize = \"F: Serialize\", deserialize = \"F: Deserialize<'de>\"))]\n76\t#[repr(C)]\n77\tpub struct SymbolicConstraintsDag<F> {\n78\t    /// DAG with all symbolic expressions as nodes.\n79\t    /// These nodes include expressions for plain AIR constraints as well as symbolic expressions\n80\t    /// used for `interactions`.\n81\t    pub constraints: SymbolicExpressionDag<F>,\n82\t    /// List of all interactions, where expressions in the interactions\n83\t    /// are referenced by node idx as `usize`.\n84\t    ///\n85\t    /// These expressions are converted into a LogUp fractional sum\n86\t    /// which must be proven using GKR.\n87\t    pub interactions: Vec<Interaction<usize>>,\n88\t}\n89\t\n90\tpub(crate) fn build_symbolic_constraints_dag<F: Field>(\n91\t    constraints: &[SymbolicExpression<F>],\n92\t    interactions: &[SymbolicInteraction<F>],\n93\t) -> SymbolicConstraintsDag<F> {\n94\t    let mut builder = SymbolicDagBuilder::new();\n95\t    let mut constraint_idx: Vec<usize> = constraints\n96\t        .iter()\n97\t        .map(|expr| builder.add_expr(expr))\n98\t        .collect();\n99\t    constraint_idx.sort();\n100\t    constraint_idx.dedup();\n101\t    let interactions: Vec<Interaction<usize>> = interactions\n102\t        .iter()\n103\t        .map(|interaction| {\n104\t            let fields: Vec<usize> = interaction\n105\t                .message\n106\t                .iter()\n107\t                .map(|field_expr| builder.add_expr(field_expr))\n108\t                .collect();\n109\t            let count = builder.add_expr(&interaction.count);\n110\t            Interaction {\n111\t                message: fields,\n112\t                count,\n113\t                bus_index: interaction.bus_index,\n114\t                count_weight: interaction.count_weight,\n115\t            }\n116\t        })\n117\t        .collect();\n118\t    let constraints = SymbolicExpressionDag {\n119\t        nodes: builder.nodes,\n120\t        constraint_idx,\n121\t    };\n122\t    SymbolicConstraintsDag {\n123\t        constraints,\n124\t        interactions,\n125\t    }\n126\t}\n127\t\n128\t/// Builder for constructing a symbolic expression DAG with structural deduplication\n129\t/// and algebraic simplifications.\n130\t///\n131\t/// Two caches are used:\n132\t/// - `expr_to_idx`: Fast path for expressions with the same Arc pointer\n133\t/// - `node_to_idx`: Structural deduplication - catches identical nodes with different Arc pointers\n134\t///\n135\t/// Algebraic simplifications performed:\n136\t/// - Constant folding: `a + b` → `c`, `a - b` → `c`, `a * b` → `c`, `-a` → `c` (for constants a,b)\n137\t/// - `x + 0` → `x`, `0 + x` → `x`\n138\t/// - `x - 0` → `x`\n139\t/// - `x * 1` → `x`, `1 * x` → `x`\n140\t/// - `x * 0` → `0`, `0 * x` → `0`\n141\t/// - `x + (-y)` → `x - y`\n142\t/// - `x - (-y)` → `x + y`\n143\tpub struct SymbolicDagBuilder<F: Field> {\n144\t    /// Cache: Arc pointer -> node index (fast path for same Arc)\n145\t    pub expr_to_idx: FxHashMap<*const SymbolicExpression<F>, usize>,\n146\t    /// Cache: node structure -> node index (structural deduplication)\n147\t    pub node_to_idx: FxHashMap<SymbolicExpressionNode<F>, usize>,\n148\t    /// Nodes in topological order\n149\t    pub nodes: Vec<SymbolicExpressionNode<F>>,\n150\t}\n151\t\n152\timpl<F: Field> Default for SymbolicDagBuilder<F> {\n153\t    fn default() -> Self {\n154\t        Self::new()\n155\t    }\n156\t}\n157\t\n158\timpl<F: Field> SymbolicDagBuilder<F> {\n159\t    pub fn new() -> Self {\n160\t        Self {\n161\t            expr_to_idx: FxHashMap::default(),\n162\t            node_to_idx: FxHashMap::default(),\n163\t            nodes: Vec::new(),\n164\t        }\n165\t    }\n166\t\n167\t    /// Add a symbolic expression to the DAG, returning its node index.\n168\t    /// Performs structural deduplication and algebraic simplifications.\n169\t    pub fn add_expr(&mut self, expr: &SymbolicExpression<F>) -> usize {\n170\t        // Fast path: check if we've seen this exact Arc pointer before\n171\t        let ptr = expr as *const SymbolicExpression<F>;\n172\t        if let Some(&idx) = self.expr_to_idx.get(&ptr) {\n173\t            return idx;\n174\t        }\n175\t\n176\t        let idx = match expr {\n177\t            SymbolicExpression::Variable(var) => {\n178\t                self.intern_node(SymbolicExpressionNode::Variable(*var))\n179\t            }\n180\t            SymbolicExpression::IsFirstRow => self.intern_node(SymbolicExpressionNode::IsFirstRow),\n181\t            SymbolicExpression::IsLastRow => self.intern_node(SymbolicExpressionNode::IsLastRow),\n182\t            SymbolicExpression::IsTransition => {\n183\t                self.intern_node(SymbolicExpressionNode::IsTransition)\n184\t            }\n185\t            SymbolicExpression::Constant(cons) => {\n186\t                self.intern_node(SymbolicExpressionNode::Constant(*cons))\n187\t            }\n188\t            SymbolicExpression::Add {\n189\t                x,\n190\t                y,\n191\t                degree_multiple,\n192\t            } => {\n193\t                let left_idx = self.add_expr(x.as_ref());\n194\t                let right_idx = self.add_expr(y.as_ref());\n195\t\n196\t                // Constant folding: const + const = const\n197\t                if let (Some(a), Some(b)) = (self.get_const(left_idx), self.get_const(right_idx)) {\n198\t                    self.intern_node(SymbolicExpressionNode::Constant(a + b))\n199\t                }\n200\t                // Simplify: 0 + x = x, x + 0 = x\n201\t                else if self.is_const(left_idx, F::ZERO) {\n202\t                    right_idx\n203\t                } else if self.is_const(right_idx, F::ZERO) {\n204\t                    left_idx\n205\t                }\n206\t                // Normalize: x + (-y) = x - y\n207\t                else if let Some(neg_child_idx) = self.get_neg_child(right_idx) {\n208\t                    self.intern_node(SymbolicExpressionNode::Sub {\n209\t                        left_idx,\n210\t                        right_idx: neg_child_idx,\n211\t                        degree_multiple: *degree_multiple,\n212\t                    })\n213\t                } else {\n214\t                    self.intern_node(SymbolicExpressionNode::Add {\n215\t                        left_idx,\n216\t                        right_idx,\n217\t                        degree_multiple: *degree_multiple,\n218\t                    })\n219\t                }\n220\t            }\n221\t            SymbolicExpression::Sub {\n222\t                x,\n223\t                y,\n224\t                degree_multiple,\n225\t            } => {\n226\t                let left_idx = self.add_expr(x.as_ref());\n227\t                let right_idx = self.add_expr(y.as_ref());\n228\t\n229\t                // Constant folding: const - const = const\n230\t                if let (Some(a), Some(b)) = (self.get_const(left_idx), self.get_const(right_idx)) {\n231\t                    self.intern_node(SymbolicExpressionNode::Constant(a - b))\n232\t                }\n233\t                // Simplify: x - 0 = x\n234\t                else if self.is_const(right_idx, F::ZERO) {\n235\t                    left_idx\n236\t                }\n237\t                // Simplify: x - (-y) = x + y (double negation)\n238\t                else if let Some(neg_child_idx) = self.get_neg_child(right_idx) {\n239\t                    self.intern_node(SymbolicExpressionNode::Add {\n240\t                        left_idx,\n241\t                        right_idx: neg_child_idx,\n242\t                        degree_multiple: *degree_multiple,\n243\t                    })\n244\t                } else {\n245\t                    self.intern_node(SymbolicExpressionNode::Sub {\n246\t                        left_idx,\n247\t                        right_idx,\n248\t                        degree_multiple: *degree_multiple,\n249\t                    })\n250\t                }\n251\t            }\n252\t            SymbolicExpression::Neg { x, degree_multiple } => {\n253\t                let child_idx = self.add_expr(x.as_ref());\n254\t\n255\t                // Constant folding: -const = const\n256\t                if let Some(c) = self.get_const(child_idx) {\n257\t                    self.intern_node(SymbolicExpressionNode::Constant(-c))\n258\t                } else {\n259\t                    self.intern_node(SymbolicExpressionNode::Neg {\n260\t                        idx: child_idx,\n261\t                        degree_multiple: *degree_multiple,\n262\t                    })\n263\t                }\n264\t            }\n265\t            SymbolicExpression::Mul {\n266\t                x,\n267\t                y,\n268\t                degree_multiple,\n269\t            } => {\n270\t                // An important case to remember: square will have Arc::as_ptr(&x) ==\n271\t                // Arc::as_ptr(&y) The `expr_to_idx` will ensure only one recursive\n272\t                // call is done to prevent exponential behavior.\n273\t                let left_idx = self.add_expr(x.as_ref());\n274\t                let right_idx = self.add_expr(y.as_ref());\n275\t\n276\t                // Constant folding: const * const = const\n277\t                if let (Some(a), Some(b)) = (self.get_const(left_idx), self.get_const(right_idx)) {\n278\t                    self.intern_node(SymbolicExpressionNode::Constant(a * b))\n279\t                }\n280\t                // Simplify: 0 * x = 0, x * 1 = x (return left_idx)\n281\t                // Simplify: x * 0 = 0, 1 * x = x (return right_idx)\n282\t                else if self.is_const(left_idx, F::ZERO) || self.is_const(right_idx, F::ONE) {\n283\t                    left_idx\n284\t                } else if self.is_const(right_idx, F::ZERO) || self.is_const(left_idx, F::ONE) {\n285\t                    right_idx\n286\t                } else {\n287\t                    self.intern_node(SymbolicExpressionNode::Mul {\n288\t                        left_idx,\n289\t                        right_idx,\n290\t                        degree_multiple: *degree_multiple,\n291\t                    })\n292\t                }\n293\t            }\n294\t        };\n295\t\n296\t        self.expr_to_idx.insert(ptr, idx);\n297\t        idx\n298\t    }\n299\t\n300\t    /// Intern a node: return existing index if the node already exists, otherwise add it.\n301\t    fn intern_node(&mut self, node: SymbolicExpressionNode<F>) -> usize {\n302\t        *self.node_to_idx.entry(node.clone()).or_insert_with(|| {\n303\t            let idx = self.nodes.len();\n304\t            self.nodes.push(node);\n305\t            idx\n306\t        })\n307\t    }\n308\t\n309\t    /// Check if a node at given index is a constant with specific value.\n310\t    fn is_const(&self, idx: usize, val: F) -> bool {\n311\t        matches!(&self.nodes[idx], SymbolicExpressionNode::Constant(c) if *c == val)\n312\t    }\n313\t\n314\t    /// Get constant value from a node, if it is a constant.\n315\t    fn get_const(&self, idx: usize) -> Option<F> {\n316\t        match &self.nodes[idx] {\n317\t            SymbolicExpressionNode::Constant(c) => Some(*c),\n318\t            _ => None,\n319\t        }\n320\t    }\n321\t\n322\t    /// If a node is a Neg, return its child index.\n323\t    fn get_neg_child(&self, idx: usize) -> Option<usize> {\n324\t        match &self.nodes[idx] {\n325\t            SymbolicExpressionNode::Neg { idx, .. } => Some(*idx),\n326\t            _ => None,\n327\t        }\n328\t    }\n329\t}\n330\t\n331\timpl<F: Field> SymbolicExpressionDag<F> {\n332\t    /// Convert each node to a [`SymbolicExpression<F>`] reference and return\n333\t    /// the full list.\n334\t    fn to_symbolic_expressions(&self) -> Vec<Arc<SymbolicExpression<F>>> {\n335\t        let mut exprs: Vec<Arc<SymbolicExpression<_>>> = Vec::with_capacity(self.nodes.len());\n336\t        for node in &self.nodes {\n337\t            let expr = match *node {\n338\t                SymbolicExpressionNode::Variable(var) => SymbolicExpression::Variable(var),\n339\t                SymbolicExpressionNode::IsFirstRow => SymbolicExpression::IsFirstRow,\n340\t                SymbolicExpressionNode::IsLastRow => SymbolicExpression::IsLastRow,\n341\t                SymbolicExpressionNode::IsTransition => SymbolicExpression::IsTransition,\n342\t                SymbolicExpressionNode::Constant(f) => SymbolicExpression::Constant(f),\n343\t                SymbolicExpressionNode::Add {\n344\t                    left_idx,\n345\t                    right_idx,\n346\t                    degree_multiple,\n347\t                } => SymbolicExpression::Add {\n348\t                    x: exprs[left_idx].clone(),\n349\t                    y: exprs[right_idx].clone(),\n350\t                    degree_multiple,\n351\t                },\n352\t                SymbolicExpressionNode::Sub {\n353\t                    left_idx,\n354\t                    right_idx,\n355\t                    degree_multiple,\n356\t                } => SymbolicExpression::Sub {\n357\t                    x: exprs[left_idx].clone(),\n358\t                    y: exprs[right_idx].clone(),\n359\t                    degree_multiple,\n360\t                },\n361\t                SymbolicExpressionNode::Neg {\n362\t                    idx,\n363\t                    degree_multiple,\n364\t                } => SymbolicExpression::Neg {\n365\t                    x: exprs[idx].clone(),\n366\t                    degree_multiple,\n367\t                },\n368\t                SymbolicExpressionNode::Mul {\n369\t                    left_idx,\n370\t                    right_idx,\n371\t                    degree_multiple,\n372\t                } => SymbolicExpression::Mul {\n373\t                    x: exprs[left_idx].clone(),\n374\t                    y: exprs[right_idx].clone(),\n375\t                    degree_multiple,\n376\t                },\n377\t            };\n378\t            exprs.push(Arc::new(expr));\n379\t        }\n380\t        exprs\n381\t    }\n382\t}\n383\t\n384\t// TEMPORARY conversions until we switch main interfaces to use SymbolicConstraintsDag\n385\timpl<'a, F: Field> From<&'a SymbolicConstraintsDag<F>> for SymbolicConstraints<F> {\n386\t    fn from(dag: &'a SymbolicConstraintsDag<F>) -> Self {\n387\t        let exprs = dag.constraints.to_symbolic_expressions();\n388\t        let constraints = dag\n389\t            .constraints\n390\t            .constraint_idx\n391\t            .iter()\n392\t            .map(|&idx| exprs[idx].as_ref().clone())\n393\t            .collect::<Vec<_>>();\n394\t        let interactions = dag\n395\t            .interactions\n396\t            .iter()\n397\t            .map(|interaction| {\n398\t                let fields = interaction\n399\t                    .message\n400\t                    .iter()\n401\t                    .map(|&idx| exprs[idx].as_ref().clone())\n402\t                    .collect();\n403\t                let count = exprs[interaction.count].as_ref().clone();\n404\t                Interaction {\n405\t                    message: fields,\n406\t                    count,\n407\t                    bus_index: interaction.bus_index,\n408\t                    count_weight: interaction.count_weight,\n409\t                }\n410\t            })\n411\t            .collect::<Vec<_>>();\n412\t        SymbolicConstraints {\n413\t            constraints,\n414\t            interactions,\n415\t        }\n416\t    }\n417\t}\n418\t\n419\timpl<F: Field> From<SymbolicConstraintsDag<F>> for SymbolicConstraints<F> {\n420\t    fn from(dag: SymbolicConstraintsDag<F>) -> Self {\n421\t        (&dag).into()\n422\t    }\n423\t}\n424\t\n425\timpl<F: Field> From<SymbolicConstraints<F>> for SymbolicConstraintsDag<F> {\n426\t    fn from(sc: SymbolicConstraints<F>) -> Self {\n427\t        build_symbolic_constraints_dag(&sc.constraints, &sc.interactions)\n428\t    }\n429\t}\n430\t\n431\t#[cfg(test)]\n432\tmod tests {\n433\t    use p3_baby_bear::BabyBear;\n434\t    use p3_field::PrimeCharacteristicRing;\n435\t\n436\t    use crate::{\n437\t        air_builders::symbolic::{\n438\t            dag::{build_symbolic_constraints_dag, SymbolicExpressionDag, SymbolicExpressionNode},\n439\t            symbolic_expression::SymbolicExpression,\n440\t            symbolic_variable::{Entry, SymbolicVariable},\n441\t        },\n442\t        interaction::Interaction,\n443\t    };\n444\t\n445\t    type F = BabyBear;\n446\t\n447\t    #[test]\n448\t    fn test_duplicate_constraints_are_deduplicated() {\n449\t        // Create a simple expression\n450\t        let expr: SymbolicExpression<F> = SymbolicExpression::Variable(SymbolicVariable::new(\n451\t            Entry::Main {\n452\t                part_index: 0,\n453\t                offset: 0,\n454\t            },\n455\t            0,\n456\t        ));\n457\t\n458\t        // Simulate calling assert_zero twice on the same expression\n459\t        let constraints = vec![expr.clone(), expr.clone()];\n460\t        let interactions = vec![];\n461\t\n462\t        let dag = build_symbolic_constraints_dag(&constraints, &interactions);\n463\t\n464\t        // Nodes are deduplicated - there's only 1 node in the DAG\n465\t        assert_eq!(\n466\t            dag.constraints.nodes.len(),\n467\t            1,\n468\t            \"Nodes should be deduplicated\"\n469\t        );\n470\t\n471\t        // constraint_idx should also be deduplicated\n472\t        assert_eq!(\n473\t            dag.constraints.constraint_idx,\n474\t            vec![0],\n475\t            \"constraint_idx should be deduplicated\"\n476\t        );\n477\t\n478\t        // Only 1 constraint\n479\t        assert_eq!(\n480\t            dag.constraints.num_constraints(),\n481\t            1,\n482\t            \"Duplicate constraints should be deduplicated\"\n483\t        );\n484\t    }\n485\t\n486\t    #[test]\n487\t    fn test_structural_deduplication() {\n488\t        // Create two structurally identical expressions with different Arc pointers\n489\t        // This simulates: builder.assert_zero(x - ONE); builder.assert_zero(x - ONE);\n490\t        let var = SymbolicVariable::<F>::new(\n491\t            Entry::Main {\n492\t                part_index: 0,\n493\t                offset: 0,\n494\t            },\n495\t            0,\n496\t        );\n497\t        let expr1 = SymbolicExpression::from(var) - SymbolicExpression::Constant(F::ONE);\n498\t        let expr2 = SymbolicExpression::from(var) - SymbolicExpression::Constant(F::ONE);\n499\t\n500\t        // These are different Arc allocations"}]},"parent_tool_use_id":"toolu_01V4H1wszCt4FJV4NQXjUweb","session_id":"b7092ff3-dad3-4115-bd08-06aa847648b3","uuid":"292e2494-a897-4483-9b11-1f2ddc5e01c0","timestamp":"2026-04-11T07:46:02.866Z"}
