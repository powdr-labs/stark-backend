{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014mroaYeHTqxNAs45rEpTNG","type":"tool_result","content":"600\t    // Cannot do it for logup because we need to calculate the sum claims.\n601\t    #[instrument(name = \"prover.rap_constraints.ple_round0\", level = \"info\", skip_all)]\n602\t    fn sumcheck_uni_round0_polys(\n603\t        &mut self,\n604\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n605\t        lambda: EF,\n606\t    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n607\t        self.mem\n608\t            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n609\t        self.mem.reset_peak();\n610\t        let n_logup = self.n_logup;\n611\t        let l_skip = self.l_skip;\n612\t        let xi = &self.xi;\n613\t        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n614\t        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n615\t            h_lambda_pows.to_device()?\n616\t        } else {\n617\t            DeviceBuffer::new()\n618\t        });\n619\t        // Precompute lambda combinations for all AIRs with monomials\n620\t        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n621\t        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n622\t            if air_pk.other_data.zerocheck_monomials.is_some() {\n623\t                self.lambda_combinations[air_idx] = Some(\n624\t                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n625\t                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n626\t                );\n627\t            }\n628\t        }\n629\t        let num_present_airs = ctx.per_trace.len();\n630\t        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n631\t\n632\t        self.eq_3b_per_trace = ctx\n633\t            .per_trace\n634\t            .iter()\n635\t            .enumerate()\n636\t            .map(|(trace_idx, (air_idx, _))| {\n637\t                let vk = &self.pk.per_air[*air_idx].vk;\n638\t                let num_interactions = vk.num_interactions();\n639\t                if num_interactions > 0 {\n640\t                    let n = self.n_per_trace[trace_idx];\n641\t                    let n_lift = n.max(0) as usize;\n642\t                    let mut b_vec = vec![F::ZERO; n_logup - n_lift];\n643\t                    let mut weights = Vec::with_capacity(num_interactions);\n644\t                    for interaction_idx in 0..num_interactions {\n645\t                        let stacked_idx = self\n646\t                            .interactions_layout\n647\t                            .get(trace_idx, interaction_idx)\n648\t                            .unwrap()\n649\t                            .row_idx;\n650\t                        let mut b_int = stacked_idx >> (l_skip + n_lift);\n651\t                        for bit in &mut b_vec {\n652\t                            *bit = F::from_bool(b_int & 1 == 1);\n653\t                            b_int >>= 1;\n654\t                        }\n655\t                        let weight =\n656\t                            eval_eq_mle(&self.xi[l_skip + n_lift..l_skip + n_logup], &b_vec);\n657\t                        weights.push(weight);\n658\t                    }\n659\t                    weights\n660\t                } else {\n661\t                    vec![]\n662\t                }\n663\t            })\n664\t            .collect_vec();\n665\t        self.d_eq_3b_per_trace = self\n666\t            .eq_3b_per_trace\n667\t            .iter()\n668\t            .map(|eq_3bs| {\n669\t                if eq_3bs.is_empty() {\n670\t                    Ok(DeviceBuffer::new())\n671\t                } else {\n672\t                    eq_3bs.to_device()\n673\t                }\n674\t            })\n675\t            .collect::<Result<Vec<_>, _>>()?;\n676\t\n677\t        // Precompute logup combinations for all traces with interaction monomials\n678\t        for (trace_idx, (air_idx, _)) in ctx.per_trace.iter().enumerate() {\n679\t            let air_pk = &self.pk.per_air[*air_idx];\n680\t            if air_pk.other_data.interaction_monomials.is_some()\n681\t                && !self.eq_3b_per_trace[trace_idx].is_empty()\n682\t            {\n683\t                self.logup_combinations[trace_idx] = Some(\n684\t                    compute_logup_combinations(\n685\t                        self.pk,\n686\t                        *air_idx,\n687\t                        &self.d_beta_pows,\n688\t                        &self.d_eq_3b_per_trace[trace_idx],\n689\t                        &self.eq_3b_per_trace[trace_idx],\n690\t                        &self.beta_pows,\n691\t                    )\n692\t                    .map_err(LogupZerocheckError::LogupCombinations)?,\n693\t                );\n694\t            }\n695\t        }\n696\t\n697\t        // PERF[jpw]: we could also build the layers for different n in a transposed way using\n698\t        // eq_nonoverlapping_stage_ext, which is more memory efficient\n699\t        for &n in &self.n_per_trace {\n700\t            let n_lift = n.max(0) as usize;\n701\t            if let Entry::Vacant(entry) = self.eq_xis.entry(n_lift) {\n702\t                let layers =\n703\t                    EqEvalLayers::new_rev(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n704\t                        .map_err(LogupZerocheckError::EqEvalLayers)?;\n705\t                entry.insert(layers);\n706\t            }\n707\t        }\n708\t\n709\t        self.sels_per_trace_base = self\n710\t            .n_per_trace\n711\t            .iter()\n712\t            .map(|&n| {\n713\t                let n_lift = n.max(0) as usize;\n714\t                let height = 1 << n_lift;\n715\t                let mut cols = F::zero_vec(3 * height);\n716\t                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n717\t                cols[0] = F::ONE; // is_first\n718\t                cols[2 * height + height - 1] = F::ONE; // is_last\n719\t                let d_cols = cols.to_device()?;\n720\t                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n721\t            })\n722\t            .collect::<Result<Vec<_>, MemCopyError>>()?;\n723\t\n724\t        let selectors_base = self.sels_per_trace_base.clone();\n725\t\n726\t        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n727\t        // present AIR\n728\t        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n729\t        let d_lambda_pows = self\n730\t            .lambda_pows\n731\t            .as_ref()\n732\t            .expect(\"lambda powers must be set before round-0 evaluation\");\n733\t\n734\t        // Metadata stored per AIR during Phase 1, consumed in Phase 2\n735\t        struct Round0Pending<F, EF> {\n736\t            trace_idx: usize,\n737\t            air_idx: usize,\n738\t            num_cosets_zc: usize,\n739\t            num_cosets_logup: usize,\n740\t            local_constraint_deg: usize,\n741\t            omega_root: F,\n742\t            n: isize,\n743\t            // For individual (non-batched) launches:\n744\t            zc_result: DeviceBuffer<EF>,\n745\t            logup_result: DeviceBuffer<Frac<EF>>,\n746\t            // For batched launches (index within the batch, None if individual):\n747\t            zc_batch_idx: Option<usize>,\n748\t            logup_batch_idx: Option<usize>,\n749\t        }\n750\t\n751\t        let skip_domain: u32 = 1 << l_skip;\n752\t        let block_x = skip_domain.max(MAX_THREADS_ROUND0);\n753\t\n754\t        // Pre-check: disable batching if skip_domain is large enough that batch\n755\t        // temp buffers would exceed the memory budget. Each batched block contributes\n756\t        // max_num_cosets * skip_domain * sizeof(T) to the temp buffer. With ~600\n757\t        // AIRs and ~8 blocks each, the total can reach hundreds of MB.\n758\t        // Conservative estimate: if d * num_airs * max_blocks_per_air * sizeof(Frac<EF>) > 128 MB,\n759\t        // skip batching. This typically triggers for skip_domain >= 256.\n760\t        const BATCH_TMP_BUDGET: usize = 128 * 1024 * 1024;\n761\t        let max_cosets_estimate = self.constraint_degree; // upper bound\n762\t        let d_estimate = max_cosets_estimate * skip_domain as usize;\n763\t        let blocks_per_air_estimate = skip_domain.div_ceil(block_x) as usize;\n764\t        let estimated_batch_tmp = num_present_airs\n765\t            * blocks_per_air_estimate\n766\t            * d_estimate\n767\t            * std::mem::size_of::<Frac<EF>>();\n768\t        let batching_enabled = estimated_batch_tmp <= BATCH_TMP_BUDGET;\n769\t        debug!(\n770\t            \"Round 0: l_skip={l_skip}, skip_domain={skip_domain}, batching_enabled={batching_enabled}, estimated_tmp={estimated_batch_tmp}\"\n771\t        );\n772\t\n773\t        // Phase 1: Classify AIRs, collect metadata for batching, launch kernels.\n774\t        let mut pending: Vec<Round0Pending<F, EF>> = Vec::with_capacity(num_present_airs);\n775\t        let mut d_main_parts_vec: Vec<DeviceBuffer<*const F>> =\n776\t            Vec::with_capacity(num_present_airs);\n777\t\n778\t        // Batched zerocheck metadata\n779\t        let mut zc_batch_metas: Vec<ZerocheckBatchMeta> = Vec::new();\n780\t        let mut zc_batch_x_blocks: Vec<u32> = Vec::new();\n781\t\n782\t        // Batched logup metadata + keep-alive buffers for per-AIR device data\n783\t        let mut logup_batch_metas: Vec<LogupBatchMeta> = Vec::new();\n784\t        let mut logup_batch_x_blocks: Vec<u32> = Vec::new();\n785\t        // Keep per-AIR logup device buffers alive until stream sync\n786\t        let mut logup_keepalive_rules: Vec<DeviceBuffer<u128>> = Vec::new();\n787\t        let mut logup_keepalive_numer_w: Vec<DeviceBuffer<EF>> = Vec::new();\n788\t        let mut logup_keepalive_denom_w: Vec<DeviceBuffer<EF>> = Vec::new();\n789\t\n790\t        // Sub-phase A: Classify AIRs and collect metadata\n791\t        for (trace_idx, ((air_idx, air_ctx), &n, selectors_cube, public_values, eq_3bs)) in izip!(\n792\t            &ctx.per_trace,\n793\t            &self.n_per_trace,\n794\t            &selectors_base,\n795\t            &self.public_values_per_trace,\n796\t            &self.eq_3b_per_trace,\n797\t        )\n798\t        .enumerate()\n799\t        {\n800\t            debug!(\"starting batch constraints for air_idx={air_idx} (trace_idx={trace_idx})\");\n801\t            let single_pk = &self.pk.per_air[*air_idx];\n802\t            let single_air_constraints =\n803\t                SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n804\t            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n805\t            debug_assert_eq!(\n806\t                single_air_constraints.max_constraint_degree(),\n807\t                local_constraint_deg\n808\t            );\n809\t            assert!(\n810\t                local_constraint_deg <= self.constraint_degree,\n811\t                \"Max constraint degree ({local_constraint_deg}) of AIR {air_idx} exceeds the global maximum {}\",\n812\t                self.constraint_degree\n813\t            );\n814\t\n815\t            let log_large_domain = log2_ceil_usize(local_constraint_deg << l_skip);\n816\t            let omega_root = F::two_adic_generator(log_large_domain);\n817\t            assert!(!xi.is_empty(), \"xi vector must not be empty\");\n818\t\n819\t            let height = air_ctx.common_main.height();\n820\t            let mut main_parts = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n821\t            for committed in &air_ctx.cached_mains {\n822\t                main_parts.push(committed.trace.buffer().as_ptr());\n823\t            }\n824\t            main_parts.push(air_ctx.common_main.buffer().as_ptr());\n825\t            let d_main_parts = main_parts.to_device()?;\n826\t\n827\t            let n_lift = n.max(0) as usize;\n828\t            let num_x: u32 = 1 << n_lift;\n829\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n830\t            let max_temp_bytes = self.memory_limit_bytes;\n831\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n832\t            let num_cosets_logup = local_constraint_deg;\n833\t\n834\t            let is_coset_parallel = (num_x * skip_domain) < COSET_PARALLEL_THRESHOLD;\n835\t\n836\t            // --- Zerocheck classification ---\n837\t            let constraints_dag = &single_pk.vk.symbolic_constraints;\n838\t            let has_constraints =\n839\t                !constraints_dag.constraints.constraint_idx.is_empty() && num_cosets_zc > 0;\n840\t\n841\t            let zc_buffer_size = if has_constraints {\n842\t                single_pk.other_data.zerocheck_round0.inner.buffer_size\n843\t            } else {\n844\t                0\n845\t            };\n846\t            let zc_batch_eligible = batching_enabled\n847\t                && has_constraints\n848\t                && is_coset_parallel\n849\t                && zc_buffer_size <= BUFFER_THRESHOLD;\n850\t\n851\t            let (zc_result, zc_batch_idx) = if zc_batch_eligible {\n852\t                let idx = zc_batch_metas.len();\n853\t                let preprocessed_ptr = single_pk\n854\t                    .preprocessed_data\n855\t                    .as_ref()\n856\t                    .map(|cd| cd.trace.buffer().as_ptr())\n857\t                    .unwrap_or(std::ptr::null());\n858\t                let rules = &single_pk.other_data.zerocheck_round0.inner;\n859\t                zc_batch_metas.push(ZerocheckBatchMeta {\n860\t                    selectors_cube: selectors_cube.buffer().as_ptr(),\n861\t                    preprocessed: preprocessed_ptr,\n862\t                    main_parts: d_main_parts.as_ptr(),\n863\t                    eq_cube: eq_xi_tree.get_ptr(n_lift),\n864\t                    public_values: public_values.as_ptr(),\n865\t                    d_rules: rules.d_rules.as_raw_ptr(),\n866\t                    d_used_nodes: rules.d_used_nodes.as_ptr(),\n867\t                    rules_len: rules.d_rules.len(),\n868\t                    used_nodes_len: rules.d_used_nodes.len(),\n869\t                    buffer_size: zc_buffer_size,\n870\t                    num_x,\n871\t                    height: height as u32,\n872\t                    num_cosets: num_cosets_zc as u32,\n873\t                    g_shift: omega_root,\n874\t                });\n875\t                let x_blocks = (num_x * skip_domain).div_ceil(block_x);\n876\t                zc_batch_x_blocks.push(x_blocks);\n877\t                (DeviceBuffer::new(), Some(idx))\n878\t            } else {\n879\t                // Individual launch\n880\t                let result = evaluate_round0_constraints_gpu(\n881\t                    single_pk,\n882\t                    selectors_cube.buffer(),\n883\t                    &d_main_parts,\n884\t                    public_values,\n885\t                    eq_xi_tree.get_ptr(n_lift),\n886\t                    d_lambda_pows,\n887\t                    skip_domain,\n888\t                    num_x,\n889\t                    height as u32,\n890\t                    num_cosets_zc as u32,\n891\t                    omega_root,\n892\t                    max_temp_bytes,\n893\t                )?;\n894\t                (result, None)\n895\t            };\n896\t\n897\t            // --- Logup classification ---\n898\t            let has_interactions = !eq_3bs.is_empty();\n899\t            let (logup_result, logup_batch_idx) = if has_interactions {\n900\t                // Per-AIR CPU work: build symbolic DAG, compute weights\n901\t                use openvm_stark_backend::air_builders::symbolic::{\n902\t                    symbolic_expression::SymbolicExpression, SymbolicExpressionDag,\n903\t                };\n904\t\n905\t                use crate::logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu};\n906\t\n907\t                let mut dag_builder =\n908\t                    openvm_stark_backend::air_builders::symbolic::SymbolicDagBuilder::new();\n909\t                let mut sorted_used_dag_idxs = Vec::new();\n910\t                for interaction in &single_air_constraints.interactions {\n911\t                    let count = dag_builder.add_expr(&interaction.count);\n912\t                    sorted_used_dag_idxs.push(count);\n913\t                    sorted_used_dag_idxs.extend(\n914\t                        interaction\n915\t                            .message\n916\t                            .iter()\n917\t                            .map(|field_expr| dag_builder.add_expr(field_expr)),\n918\t                    );\n919\t                }\n920\t                sorted_used_dag_idxs.sort();\n921\t                sorted_used_dag_idxs.dedup();\n922\t                let dag = SymbolicExpressionDag {\n923\t                    nodes: dag_builder.nodes,\n924\t                    constraint_idx: sorted_used_dag_idxs,\n925\t                };\n926\t                let rules = SymbolicRulesGpu::new(&dag, true);\n927\t                let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n928\t                let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n929\t                let mut denom_sum_init = EF::ZERO;\n930\t                for (interaction_idx, interaction) in\n931\t                    single_air_constraints.interactions.iter().enumerate()\n932\t                {\n933\t                    let count_dag_idx = dag_builder.expr_to_idx\n934\t                        [&(&interaction.count as *const SymbolicExpression<_>)];\n935\t                    let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n936\t                    numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n937\t                    denom_sum_init += eq_3bs[interaction_idx]\n938\t                        * self.beta_pows[interaction.message.len()]\n939\t                        * F::from_u32(interaction.bus_index as u32 + 1);\n940\t\n941\t                    for (message_idx, message) in interaction.message.iter().enumerate() {\n942\t                        let message_dag_idx =\n943\t                            dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n944\t                        let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n945\t                        denom_weights[message_rule_idx] +=\n946\t                            eq_3bs[interaction_idx] * self.beta_pows[message_idx];\n947\t                    }\n948\t                }\n949\t\n950\t                let logup_buffer_size: u32 = rules.buffer_size.try_into().unwrap();\n951\t                let logup_batch_eligible =\n952\t                    batching_enabled && is_coset_parallel && logup_buffer_size <= BUFFER_THRESHOLD;\n953\t\n954\t                if logup_batch_eligible {\n955\t                    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n956\t                    let d_rules = encoded_rules.to_device()?;\n957\t                    let d_numer_weights = numer_weights.to_device()?;\n958\t                    let d_denom_weights = denom_weights.to_device()?;\n959\t\n960\t                    let preprocessed_ptr = single_pk\n961\t                        .preprocessed_data\n962\t                        .as_ref()\n963\t                        .map(|cd| cd.trace.buffer().as_ptr())\n964\t                        .unwrap_or(std::ptr::null());\n965\t\n966\t                    let idx = logup_batch_metas.len();\n967\t                    logup_batch_metas.push(LogupBatchMeta {\n968\t                        selectors_cube: selectors_cube.buffer().as_ptr(),\n969\t                        preprocessed: preprocessed_ptr,\n970\t                        main_parts: d_main_parts.as_ptr(),\n971\t                        eq_cube: eq_xi_tree.get_ptr(n_lift),\n972\t                        public_values: public_values.as_ptr(),\n973\t                        numer_weights: d_numer_weights.as_ptr(),\n974\t                        denom_weights: d_denom_weights.as_ptr(),\n975\t                        d_rules: d_rules.as_raw_ptr(),\n976\t                        rules_len: d_rules.len(),\n977\t                        denom_sum_init,\n978\t                        buffer_size: logup_buffer_size,\n979\t                        num_x,\n980\t                        height: height as u32,\n981\t                        num_cosets: num_cosets_logup as u32,\n982\t                        g_shift: omega_root,\n983\t                    });\n984\t                    let x_blocks = (num_x * skip_domain).div_ceil(block_x);\n985\t                    logup_batch_x_blocks.push(x_blocks);\n986\t\n987\t                    // Keep device buffers alive\n988\t                    logup_keepalive_rules.push(d_rules);\n989\t                    logup_keepalive_numer_w.push(d_numer_weights);\n990\t                    logup_keepalive_denom_w.push(d_denom_weights);\n991\t\n992\t                    (DeviceBuffer::new(), Some(idx))\n993\t                } else {\n994\t                    // Individual launch via existing function\n995\t                    let result = evaluate_round0_interactions_gpu(\n996\t                        single_pk,\n997\t                        &single_air_constraints,\n998\t                        selectors_cube.buffer(),\n999\t                        &d_main_parts,\n1000\t                        public_values,\n1001\t                        eq_xi_tree.get_ptr(n_lift),\n1002\t                        &self.beta_pows,\n1003\t                        eq_3bs,\n1004\t                        skip_domain,\n1005\t                        num_x,\n1006\t                        height as u32,\n1007\t                        num_cosets_logup as u32,\n1008\t                        omega_root,\n1009\t                        max_temp_bytes,\n1010\t                    )?;\n1011\t                    (result, None)\n1012\t                }\n1013\t            } else {\n1014\t                (DeviceBuffer::new(), None)\n1015\t            };\n1016\t\n1017\t            d_main_parts_vec.push(d_main_parts);\n1018\t            pending.push(Round0Pending {\n1019\t                trace_idx,\n1020\t                air_idx: *air_idx,\n1021\t                num_cosets_zc,\n1022\t                num_cosets_logup,\n1023\t                local_constraint_deg,\n1024\t                omega_root,\n1025\t                n,\n1026\t                zc_result,\n1027\t                logup_result,\n1028\t                zc_batch_idx,\n1029\t                logup_batch_idx,\n1030\t            });\n1031\t        }\n1032\t\n1033\t        // Sub-phase B: Batched launches\n1034\t        let num_zc_batched = zc_batch_metas.len();\n1035\t        let num_logup_batched = logup_batch_metas.len();\n1036\t        debug!(\n1037\t            \"Round 0 batching: zerocheck={num_zc_batched}/{num_present_airs}, logup={num_logup_batched}/{num_present_airs}, skip_domain={skip_domain}\"\n1038\t        );\n1039\t\n1040\t        // Helper to build batch launch data structures\n1041\t        fn build_batch_arrays(x_blocks: &[u32]) -> (Vec<u32>, Vec<u32>) {\n1042\t            let total: u32 = x_blocks.iter().sum();\n1043\t            let mut seg_offsets = Vec::with_capacity(x_blocks.len() + 1);\n1044\t            seg_offsets.push(0u32);\n1045\t            let mut acc = 0u32;\n1046\t            for &xb in x_blocks {\n1047\t                acc += xb;\n1048\t                seg_offsets.push(acc);\n1049\t            }\n1050\t            let mut air_for_block = Vec::with_capacity(total as usize);\n1051\t            for (air_idx, &xb) in x_blocks.iter().enumerate() {\n1052\t                for _ in 0..xb {\n1053\t                    air_for_block.push(air_idx as u32);\n1054\t                }\n1055\t            }\n1056\t            (seg_offsets, air_for_block)\n1057\t        }\n1058\t\n1059\t        // Zerocheck batch output\n1060\t        let mut d_zc_batch_output: DeviceBuffer<EF> = DeviceBuffer::new();\n1061\t        let zc_max_num_cosets: u32 = zc_batch_metas\n1062\t            .iter()\n1063\t            .map(|m| m.num_cosets)\n1064\t            .max()\n1065\t            .unwrap_or(0);\n1066\t        let zc_d: usize = (zc_max_num_cosets * skip_domain) as usize;\n1067\t\n1068\t        if !zc_batch_metas.is_empty() {\n1069\t            let zc_total_x_blocks: u32 = zc_batch_x_blocks.iter().sum();\n1070\t            let (zc_seg_offsets, zc_air_for_block) = build_batch_arrays(&zc_batch_x_blocks);\n1071\t\n1072\t            let d_zc_metas_bytes: DeviceBuffer<u8> = unsafe {\n1073\t                let bytes = std::slice::from_raw_parts(\n1074\t                    zc_batch_metas.as_ptr() as *const u8,\n1075\t                    zc_batch_metas.len() * std::mem::size_of::<ZerocheckBatchMeta>(),\n1076\t                );\n1077\t                bytes.to_device()?\n1078\t            };\n1079\t            let d_zc_air_for_block = zc_air_for_block.to_device()?;\n1080\t            let d_zc_seg_offsets = zc_seg_offsets.to_device()?;\n1081\t\n1082\t            let mut d_zc_tmp = DeviceBuffer::<EF>::with_capacity(zc_total_x_blocks as usize * zc_d);\n1083\t            d_zc_tmp\n1084\t                .fill_zero()\n1085\t                .map_err(|e| LogupZerocheckError::from(MemCopyError::from(e)))?;\n1086\t            d_zc_batch_output = DeviceBuffer::<EF>::with_capacity(num_zc_batched * zc_d);\n1087\t\n1088\t            unsafe {\n1089\t                crate::cuda::logup_zerocheck::zerocheck_ntt_eval_constraints_batched(\n1090\t                    &mut d_zc_tmp,\n1091\t                    &mut d_zc_batch_output,\n1092\t                    &d_zc_metas_bytes,\n1093\t                    &d_zc_air_for_block,\n1094\t                    &d_zc_seg_offsets,\n1095\t                    d_lambda_pows,\n1096\t                    num_zc_batched as u32,\n1097\t                    zc_total_x_blocks,\n1098\t                    zc_max_num_cosets,\n1099\t                    skip_domain,"}]},"parent_tool_use_id":null,"session_id":"b7092ff3-dad3-4115-bd08-06aa847648b3","uuid":"1493a95b-658c-4e62-bda8-f37a46a44a99","timestamp":"2026-04-11T07:43:13.153Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/mod.rs","content":"    // Cannot do it for logup because we need to calculate the sum claims.\n    #[instrument(name = \"prover.rap_constraints.ple_round0\", level = \"info\", skip_all)]\n    fn sumcheck_uni_round0_polys(\n        &mut self,\n        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n        lambda: EF,\n    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n        self.mem\n            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n        self.mem.reset_peak();\n        let n_logup = self.n_logup;\n        let l_skip = self.l_skip;\n        let xi = &self.xi;\n        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n            h_lambda_pows.to_device()?\n        } else {\n            DeviceBuffer::new()\n        });\n        // Precompute lambda combinations for all AIRs with monomials\n        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n            if air_pk.other_data.zerocheck_monomials.is_some() {\n                self.lambda_combinations[air_idx] = Some(\n                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n                );\n            }\n        }\n        let num_present_airs = ctx.per_trace.len();\n        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n\n        self.eq_3b_per_trace = ctx\n            .per_trace\n            .iter()\n            .enumerate()\n            .map(|(trace_idx, (air_idx, _))| {\n                let vk = &self.pk.per_air[*air_idx].vk;\n                let num_interactions = vk.num_interactions();\n                if num_interactions > 0 {\n                    let n = self.n_per_trace[trace_idx];\n                    let n_lift = n.max(0) as usize;\n                    let mut b_vec = vec![F::ZERO; n_logup - n_lift];\n                    let mut weights = Vec::with_capacity(num_interactions);\n                    for interaction_idx in 0..num_interactions {\n                        let stacked_idx = self\n                            .interactions_layout\n                            .get(trace_idx, interaction_idx)\n                            .unwrap()\n                            .row_idx;\n                        let mut b_int = stacked_idx >> (l_skip + n_lift);\n                        for bit in &mut b_vec {\n                            *bit = F::from_bool(b_int & 1 == 1);\n                            b_int >>= 1;\n                        }\n                        let weight =\n                            eval_eq_mle(&self.xi[l_skip + n_lift..l_skip + n_logup], &b_vec);\n                        weights.push(weight);\n                    }\n                    weights\n                } else {\n                    vec![]\n                }\n            })\n            .collect_vec();\n        self.d_eq_3b_per_trace = self\n            .eq_3b_per_trace\n            .iter()\n            .map(|eq_3bs| {\n                if eq_3bs.is_empty() {\n                    Ok(DeviceBuffer::new())\n                } else {\n                    eq_3bs.to_device()\n                }\n            })\n            .collect::<Result<Vec<_>, _>>()?;\n\n        // Precompute logup combinations for all traces with interaction monomials\n        for (trace_idx, (air_idx, _)) in ctx.per_trace.iter().enumerate() {\n            let air_pk = &self.pk.per_air[*air_idx];\n            if air_pk.other_data.interaction_monomials.is_some()\n                && !self.eq_3b_per_trace[trace_idx].is_empty()\n            {\n                self.logup_combinations[trace_idx] = Some(\n                    compute_logup_combinations(\n                        self.pk,\n                        *air_idx,\n                        &self.d_beta_pows,\n                        &self.d_eq_3b_per_trace[trace_idx],\n                        &self.eq_3b_per_trace[trace_idx],\n                        &self.beta_pows,\n                    )\n                    .map_err(LogupZerocheckError::LogupCombinations)?,\n                );\n            }\n        }\n\n        // PERF[jpw]: we could also build the layers for different n in a transposed way using\n        // eq_nonoverlapping_stage_ext, which is more memory efficient\n        for &n in &self.n_per_trace {\n            let n_lift = n.max(0) as usize;\n            if let Entry::Vacant(entry) = self.eq_xis.entry(n_lift) {\n                let layers =\n                    EqEvalLayers::new_rev(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n                        .map_err(LogupZerocheckError::EqEvalLayers)?;\n                entry.insert(layers);\n            }\n        }\n\n        self.sels_per_trace_base = self\n            .n_per_trace\n            .iter()\n            .map(|&n| {\n                let n_lift = n.max(0) as usize;\n                let height = 1 << n_lift;\n                let mut cols = F::zero_vec(3 * height);\n                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n                cols[0] = F::ONE; // is_first\n                cols[2 * height + height - 1] = F::ONE; // is_last\n                let d_cols = cols.to_device()?;\n                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n            })\n            .collect::<Result<Vec<_>, MemCopyError>>()?;\n\n        let selectors_base = self.sels_per_trace_base.clone();\n\n        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n        // present AIR\n        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n        let d_lambda_pows = self\n            .lambda_pows\n            .as_ref()\n            .expect(\"lambda powers must be set before round-0 evaluation\");\n\n        // Metadata stored per AIR during Phase 1, consumed in Phase 2\n        struct Round0Pending<F, EF> {\n            trace_idx: usize,\n            air_idx: usize,\n            num_cosets_zc: usize,\n            num_cosets_logup: usize,\n            local_constraint_deg: usize,\n            omega_root: F,\n            n: isize,\n            // For individual (non-batched) launches:\n            zc_result: DeviceBuffer<EF>,\n            logup_result: DeviceBuffer<Frac<EF>>,\n            // For batched launches (index within the batch, None if individual):\n            zc_batch_idx: Option<usize>,\n            logup_batch_idx: Option<usize>,\n        }\n\n        let skip_domain: u32 = 1 << l_skip;\n        let block_x = skip_domain.max(MAX_THREADS_ROUND0);\n\n        // Pre-check: disable batching if skip_domain is large enough that batch\n        // temp buffers would exceed the memory budget. Each batched block contributes\n        // max_num_cosets * skip_domain * sizeof(T) to the temp buffer. With ~600\n        // AIRs and ~8 blocks each, the total can reach hundreds of MB.\n        // Conservative estimate: if d * num_airs * max_blocks_per_air * sizeof(Frac<EF>) > 128 MB,\n        // skip batching. This typically triggers for skip_domain >= 256.\n        const BATCH_TMP_BUDGET: usize = 128 * 1024 * 1024;\n        let max_cosets_estimate = self.constraint_degree; // upper bound\n        let d_estimate = max_cosets_estimate * skip_domain as usize;\n        let blocks_per_air_estimate = skip_domain.div_ceil(block_x) as usize;\n        let estimated_batch_tmp = num_present_airs\n            * blocks_per_air_estimate\n            * d_estimate\n            * std::mem::size_of::<Frac<EF>>();\n        let batching_enabled = estimated_batch_tmp <= BATCH_TMP_BUDGET;\n        debug!(\n            \"Round 0: l_skip={l_skip}, skip_domain={skip_domain}, batching_enabled={batching_enabled}, estimated_tmp={estimated_batch_tmp}\"\n        );\n\n        // Phase 1: Classify AIRs, collect metadata for batching, launch kernels.\n        let mut pending: Vec<Round0Pending<F, EF>> = Vec::with_capacity(num_present_airs);\n        let mut d_main_parts_vec: Vec<DeviceBuffer<*const F>> =\n            Vec::with_capacity(num_present_airs);\n\n        // Batched zerocheck metadata\n        let mut zc_batch_metas: Vec<ZerocheckBatchMeta> = Vec::new();\n        let mut zc_batch_x_blocks: Vec<u32> = Vec::new();\n\n        // Batched logup metadata + keep-alive buffers for per-AIR device data\n        let mut logup_batch_metas: Vec<LogupBatchMeta> = Vec::new();\n        let mut logup_batch_x_blocks: Vec<u32> = Vec::new();\n        // Keep per-AIR logup device buffers alive until stream sync\n        let mut logup_keepalive_rules: Vec<DeviceBuffer<u128>> = Vec::new();\n        let mut logup_keepalive_numer_w: Vec<DeviceBuffer<EF>> = Vec::new();\n        let mut logup_keepalive_denom_w: Vec<DeviceBuffer<EF>> = Vec::new();\n\n        // Sub-phase A: Classify AIRs and collect metadata\n        for (trace_idx, ((air_idx, air_ctx), &n, selectors_cube, public_values, eq_3bs)) in izip!(\n            &ctx.per_trace,\n            &self.n_per_trace,\n            &selectors_base,\n            &self.public_values_per_trace,\n            &self.eq_3b_per_trace,\n        )\n        .enumerate()\n        {\n            debug!(\"starting batch constraints for air_idx={air_idx} (trace_idx={trace_idx})\");\n            let single_pk = &self.pk.per_air[*air_idx];\n            let single_air_constraints =\n                SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n            debug_assert_eq!(\n                single_air_constraints.max_constraint_degree(),\n                local_constraint_deg\n            );\n            assert!(\n                local_constraint_deg <= self.constraint_degree,\n                \"Max constraint degree ({local_constraint_deg}) of AIR {air_idx} exceeds the global maximum {}\",\n                self.constraint_degree\n            );\n\n            let log_large_domain = log2_ceil_usize(local_constraint_deg << l_skip);\n            let omega_root = F::two_adic_generator(log_large_domain);\n            assert!(!xi.is_empty(), \"xi vector must not be empty\");\n\n            let height = air_ctx.common_main.height();\n            let mut main_parts = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n            for committed in &air_ctx.cached_mains {\n                main_parts.push(committed.trace.buffer().as_ptr());\n            }\n            main_parts.push(air_ctx.common_main.buffer().as_ptr());\n            let d_main_parts = main_parts.to_device()?;\n\n            let n_lift = n.max(0) as usize;\n            let num_x: u32 = 1 << n_lift;\n            let eq_xi_tree = &self.eq_xis[&n_lift];\n            let max_temp_bytes = self.memory_limit_bytes;\n            let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n            let num_cosets_logup = local_constraint_deg;\n\n            let is_coset_parallel = (num_x * skip_domain) < COSET_PARALLEL_THRESHOLD;\n\n            // --- Zerocheck classification ---\n            let constraints_dag = &single_pk.vk.symbolic_constraints;\n            let has_constraints =\n                !constraints_dag.constraints.constraint_idx.is_empty() && num_cosets_zc > 0;\n\n            let zc_buffer_size = if has_constraints {\n                single_pk.other_data.zerocheck_round0.inner.buffer_size\n            } else {\n                0\n            };\n            let zc_batch_eligible = batching_enabled\n                && has_constraints\n                && is_coset_parallel\n                && zc_buffer_size <= BUFFER_THRESHOLD;\n\n            let (zc_result, zc_batch_idx) = if zc_batch_eligible {\n                let idx = zc_batch_metas.len();\n                let preprocessed_ptr = single_pk\n                    .preprocessed_data\n                    .as_ref()\n                    .map(|cd| cd.trace.buffer().as_ptr())\n                    .unwrap_or(std::ptr::null());\n                let rules = &single_pk.other_data.zerocheck_round0.inner;\n                zc_batch_metas.push(ZerocheckBatchMeta {\n                    selectors_cube: selectors_cube.buffer().as_ptr(),\n                    preprocessed: preprocessed_ptr,\n                    main_parts: d_main_parts.as_ptr(),\n                    eq_cube: eq_xi_tree.get_ptr(n_lift),\n                    public_values: public_values.as_ptr(),\n                    d_rules: rules.d_rules.as_raw_ptr(),\n                    d_used_nodes: rules.d_used_nodes.as_ptr(),\n                    rules_len: rules.d_rules.len(),\n                    used_nodes_len: rules.d_used_nodes.len(),\n                    buffer_size: zc_buffer_size,\n                    num_x,\n                    height: height as u32,\n                    num_cosets: num_cosets_zc as u32,\n                    g_shift: omega_root,\n                });\n                let x_blocks = (num_x * skip_domain).div_ceil(block_x);\n                zc_batch_x_blocks.push(x_blocks);\n                (DeviceBuffer::new(), Some(idx))\n            } else {\n                // Individual launch\n                let result = evaluate_round0_constraints_gpu(\n                    single_pk,\n                    selectors_cube.buffer(),\n                    &d_main_parts,\n                    public_values,\n                    eq_xi_tree.get_ptr(n_lift),\n                    d_lambda_pows,\n                    skip_domain,\n                    num_x,\n                    height as u32,\n                    num_cosets_zc as u32,\n                    omega_root,\n                    max_temp_bytes,\n                )?;\n                (result, None)\n            };\n\n            // --- Logup classification ---\n            let has_interactions = !eq_3bs.is_empty();\n            let (logup_result, logup_batch_idx) = if has_interactions {\n                // Per-AIR CPU work: build symbolic DAG, compute weights\n                use openvm_stark_backend::air_builders::symbolic::{\n                    symbolic_expression::SymbolicExpression, SymbolicExpressionDag,\n                };\n\n                use crate::logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu};\n\n                let mut dag_builder =\n                    openvm_stark_backend::air_builders::symbolic::SymbolicDagBuilder::new();\n                let mut sorted_used_dag_idxs = Vec::new();\n                for interaction in &single_air_constraints.interactions {\n                    let count = dag_builder.add_expr(&interaction.count);\n                    sorted_used_dag_idxs.push(count);\n                    sorted_used_dag_idxs.extend(\n                        interaction\n                            .message\n                            .iter()\n                            .map(|field_expr| dag_builder.add_expr(field_expr)),\n                    );\n                }\n                sorted_used_dag_idxs.sort();\n                sorted_used_dag_idxs.dedup();\n                let dag = SymbolicExpressionDag {\n                    nodes: dag_builder.nodes,\n                    constraint_idx: sorted_used_dag_idxs,\n                };\n                let rules = SymbolicRulesGpu::new(&dag, true);\n                let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n                let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n                let mut denom_sum_init = EF::ZERO;\n                for (interaction_idx, interaction) in\n                    single_air_constraints.interactions.iter().enumerate()\n                {\n                    let count_dag_idx = dag_builder.expr_to_idx\n                        [&(&interaction.count as *const SymbolicExpression<_>)];\n                    let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n                    numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n                    denom_sum_init += eq_3bs[interaction_idx]\n                        * self.beta_pows[interaction.message.len()]\n                        * F::from_u32(interaction.bus_index as u32 + 1);\n\n                    for (message_idx, message) in interaction.message.iter().enumerate() {\n                        let message_dag_idx =\n                            dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n                        let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n                        denom_weights[message_rule_idx] +=\n                            eq_3bs[interaction_idx] * self.beta_pows[message_idx];\n                    }\n                }\n\n                let logup_buffer_size: u32 = rules.buffer_size.try_into().unwrap();\n                let logup_batch_eligible =\n                    batching_enabled && is_coset_parallel && logup_buffer_size <= BUFFER_THRESHOLD;\n\n                if logup_batch_eligible {\n                    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n                    let d_rules = encoded_rules.to_device()?;\n                    let d_numer_weights = numer_weights.to_device()?;\n                    let d_denom_weights = denom_weights.to_device()?;\n\n                    let preprocessed_ptr = single_pk\n                        .preprocessed_data\n                        .as_ref()\n                        .map(|cd| cd.trace.buffer().as_ptr())\n                        .unwrap_or(std::ptr::null());\n\n                    let idx = logup_batch_metas.len();\n                    logup_batch_metas.push(LogupBatchMeta {\n                        selecto