 .unwrap_or(std::ptr::null());\n965\t\n966\t                    let idx = logup_batch_metas.len();\n967\t                    logup_batch_metas.push(LogupBatchMeta {\n968\t                        selectors_cube: selectors_cube.buffer().as_ptr(),\n969\t                        preprocessed: preprocessed_ptr,\n970\t                        main_parts: d_main_parts.as_ptr(),\n971\t                        eq_cube: eq_xi_tree.get_ptr(n_lift),\n972\t                        public_values: public_values.as_ptr(),\n973\t                        numer_weights: d_numer_weights.as_ptr(),\n974\t                        denom_weights: d_denom_weights.as_ptr(),\n975\t                        d_rules: d_rules.as_raw_ptr(),\n976\t                        rules_len: d_rules.len(),\n977\t                        denom_sum_init,\n978\t                        buffer_size: logup_buffer_size,\n979\t                        num_x,\n980\t                        height: height as u32,\n981\t                        num_cosets: num_cosets_logup as u32,\n982\t                        g_shift: omega_root,\n983\t                    });\n984\t                    let x_blocks = (num_x * skip_domain).div_ceil(block_x);\n985\t                    logup_batch_x_blocks.push(x_blocks);\n986\t\n987\t                    // Keep device buffers alive\n988\t                    logup_keepalive_rules.push(d_rules);\n989\t                    logup_keepalive_numer_w.push(d_numer_weights);\n990\t                    logup_keepalive_denom_w.push(d_denom_weights);\n991\t\n992\t                    (DeviceBuffer::new(), Some(idx))\n993\t                } else {\n994\t                    // Individual launch via existing function\n995\t                    let result = evaluate_round0_interactions_gpu(\n996\t                        single_pk,\n997\t                        &single_air_constraints,\n998\t                        selectors_cube.buffer(),\n999\t                        &d_main_parts,\n1000\t                        publi