{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D8BzdJEny8QgrLiRw3BS3r","type":"tool_result","content":"1\t#include \"device_ntt.cuh\"\n2\t#include \"fp.h\"\n3\t#include \"fpext.h\"\n4\t#include \"frac_ext.cuh\"\n5\t#include \"launcher.cuh\"\n6\t#include \"sumcheck.cuh\"\n7\t#include \"utils.cuh\"\n8\t#include <algorithm>\n9\t#include <cassert>\n10\t#include <cmath>\n11\t#include <cstddef>\n12\t#include <cstdint>\n13\t#include <cuda_runtime.h>\n14\t#include <utility>\n15\t#include <vector_types.h>\n16\t\n17\tusing namespace device_ntt;\n18\t\n19\tnamespace {\n20\t\n21\tconstexpr uint32_t MAX_GRID_DIM = 65535u;\n22\t// S_DEG=2 for MLE sumcheck rounds (kept for backward compatibility)\n23\tconstexpr int S_DEG = 2;\n24\t// Number of G outputs per z in round 0 (SP_DEG=1): G0, G1, G2\n25\tconstexpr int NUM_G = 3;\n26\t\n27\t} // namespace\n28\t\n29\tstruct UnstackedSlice {\n30\t    uint32_t commit_idx;\n31\t    uint32_t log_height;\n32\t    uint32_t stacked_row_idx;\n33\t    uint32_t stacked_col_idx;\n34\t};\n35\t\n36\tstruct UnstackedPleFoldPacket {\n37\t    const Fp *__restrict__ src;\n38\t    FpExt *__restrict__ dst;\n39\t    uint32_t height;\n40\t    uint32_t width;\n41\t};\n42\t\n43\t__device__ __forceinline__ FpExt get_eq_cube(const FpExt *eq_r_ns, uint32_t cube_size, uint32_t x) {\n44\t    return eq_r_ns[cube_size + x];\n45\t}\n46\t\n47\t__device__ __forceinline__ uint32_t rot_prev(uint32_t x_int, uint32_t cube_size) {\n48\t    return x_int == 0 ? cube_size - 1 : x_int - 1;\n49\t}\n50\t\n51\t__device__ __forceinline__ Fp eq1(Fp x, Fp y) { return Fp::one() - x - y + Fp(2) * x * y; }\n52\t\n53\t__device__ __forceinline__ Fp barycentric_interpolate_strided(\n54\t    const Fp *evals,\n55\t    uint32_t evals_len,\n56\t    uint32_t z,\n57\t    uint32_t expansion_factor,     // large_domain / skip_domain\n58\t    const Fp *inv_lagrange_denoms, // denoms specifically for z\n59\t    const Fp *omega_skip_pows,\n60\t    uint32_t skip_domain\n61\t) {\n62\t    Fp q = Fp::zero();\n63\t    uint32_t stride = evals_len >= skip_domain ? 1 : skip_domain / evals_len;\n64\t    if (z % expansion_factor == 0) {\n65\t        auto i = z / expansion_factor;\n66\t        if (i % stride == 0)\n67\t            q = evals[i / stride];\n68\t    } else {\n69\t        for (int idx = 0; idx < (skip_domain / stride); idx++) {\n70\t            q += evals[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n71\t        }\n72\t    }\n73\t    return q;\n74\t}\n75\t\n76\t// SP_DEG=1 kernel: compute 3 partial sums G0, G1, G2 on identity coset only.\n77\t// No iNTT/NTT operations - reconstruction happens on CPU via NTT-based polynomial multiplication.\n78\t//\n79\t// Each block covers a tile of z-values (threadIdx.x) and collaborates across threads\n80\t// to sum over x for a single column. Blocks stride over columns via gridDim.y.\n81\t//\n82\t// G0(Z) = Σ_{col,x} coeff_eq[col] * eq_cube(x) * q_{col,x}(Z)\n83\t// G1(Z) = Σ_{col,x} coeff_rot[col] * eq_cube(x) * q_{col,x}(Z)\n84\t// G2(Z) = Σ_{col,x} coeff_rot[col] * (eq_cube(rot_prev(x)) - eq_cube(x)) * q_{col,x}(Z)\n85\t//\n86\t// where coeff_eq[col] = lambda_pows[2*col], coeff_rot[col] = lambda_pows[2*col+1]\n87\t__global__ void stacked_reduction_round0_block_sum_kernel(\n88\t    const FpExt *__restrict__ eq_r_ns, // pointer to EqEvalSegments\n89\t    const Fp *__restrict__ trace_ptr,\n90\t    const FpExt *__restrict__ lambda_pows, // pointer to lambda_pows at window start\n91\t    FpExt *__restrict__ block_sums, // [gridDim.x * gridDim.y][NUM_G * skip_domain]\n92\t    uint32_t height,                // trace height\n93\t    uint32_t width,                 // trace width\n94\t    uint32_t l_skip,\n95\t    uint32_t skip_mask, // 2^l_skip - 1\n96\t    uint32_t num_x,     // 1 << n_lift\n97\t    uint32_t log_stride\n98\t) {\n99\t    extern __shared__ char smem[];\n100\t    // Use blockDim.x + 1 stride to avoid shared memory bank conflicts\n101\t    const uint32_t PADDED_X = blockDim.x + 1;\n102\t    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem); // FpExt[NUM_G][PADDED_X]\n103\t\n104\t    uint32_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n105\t    uint32_t z_idx = tidx & skip_mask;\n106\t    uint32_t x_int = tidx >> l_skip;\n107\t    uint32_t col_idx = blockIdx.y;\n108\t\n109\t    // Compute G weights (no z-dependent packets needed)\n110\t    FpExt eq_cube = get_eq_cube(eq_r_ns, num_x, x_int);\n111\t    FpExt eq_cube_rot_prev = get_eq_cube(eq_r_ns, num_x, rot_prev(x_int, num_x));\n112\t    FpExt k_rot_diff = eq_cube_rot_prev - eq_cube;\n113\t\n114\t    FpExt coeff_eq = lambda_pows[2 * col_idx];      // for G0\n115\t    FpExt coeff_rot = lambda_pows[2 * col_idx + 1]; // for G1, G2\n116\t\n117\t    FpExt w0 = coeff_eq * eq_cube;      // weight for G0\n118\t    FpExt w1 = coeff_rot * eq_cube;     // weight for G1\n119\t    FpExt w2 = coeff_rot * k_rot_diff;  // weight for G2\n120\t\n121\t    // Load trace value (identity coset only, no NTT needed)\n122\t    auto evals = trace_ptr + col_idx * height + (x_int << (l_skip - log_stride));\n123\t    auto stride_mask = (1u << log_stride) - 1;\n124\t    Fp q = (z_idx & stride_mask) == 0 ? evals[z_idx >> log_stride] : Fp::zero();\n125\t\n126\t    // Store 3 partial sums to shared memory\n127\t    shared_sum[0 * PADDED_X + threadIdx.x] = w0 * q;\n128\t    shared_sum[1 * PADDED_X + threadIdx.x] = w1 * q;\n129\t    shared_sum[2 * PADDED_X + threadIdx.x] = w2 * q;\n130\t\n131\t    __syncthreads();\n132\t\n133\t    // Reduction: only threads in first x-slice participate\n134\t    if ((threadIdx.x >> l_skip) == 0) {\n135\t        FpExt g0 = shared_sum[0 * PADDED_X + z_idx];\n136\t        FpExt g1 = shared_sum[1 * PADDED_X + z_idx];\n137\t        FpExt g2 = shared_sum[2 * PADDED_X + z_idx];\n138\t\n139\t        for (int lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n140\t            g0 += shared_sum[0 * PADDED_X + (lane << l_skip) + z_idx];\n141\t            g1 += shared_sum[1 * PADDED_X + (lane << l_skip) + z_idx];\n142\t            g2 += shared_sum[2 * PADDED_X + (lane << l_skip) + z_idx];\n143\t        }\n144\t\n145\t        // Output: 3 values per z_idx, stored contiguously\n146\t        uint32_t skip_domain = 1u << l_skip;\n147\t        FpExt *out_ptr =\n148\t            block_sums + (col_idx * gridDim.x + blockIdx.x) * (NUM_G * skip_domain);\n149\t        out_ptr[0 * skip_domain + z_idx] = g0;\n150\t        out_ptr[1 * skip_domain + z_idx] = g1;\n151\t        out_ptr[2 * skip_domain + z_idx] = g2;\n152\t    }\n153\t}\n154\t\n155\t// Single-trace kernel: each chunk of skip_domain threads handles one output cell\n156\t// Parallelizes barycentric interpolation across threads for better performance\n157\t// Grid: (num_row_blocks, trace_width) where blockIdx.y selects the column\n158\t__global__ void stacked_reduction_fold_ple_kernel(\n159\t    const Fp *__restrict__ src,\n160\t    FpExt *__restrict__ dst,\n161\t    const Fp *__restrict__ omega_skip_pows,\n162\t    const FpExt *__restrict__ inv_lagrange_denoms,\n163\t    uint32_t trace_height,\n164\t    uint32_t new_height,\n165\t    uint32_t skip_domain\n166\t) {\n167\t    extern __shared__ char smem_raw[];\n168\t    FpExt *smem = reinterpret_cast<FpExt *>(smem_raw);\n169\t\n170\t    uint32_t col_idx = blockIdx.y;\n171\t    uint32_t chunks_per_block = blockDim.x / skip_domain;\n172\t    uint32_t chunk_in_block = threadIdx.x / skip_domain;\n173\t    uint32_t tid_in_chunk = threadIdx.x % skip_domain;\n174\t    uint32_t row_idx = blockIdx.x * chunks_per_block + chunk_in_block;\n175\t\n176\t    // Cannot early-return: all threads must participate in chunk_reduce_sum (uses __syncthreads)\n177\t    bool const active_chunk = (row_idx < new_height);\n178\t\n179\t    // Barycentric interpolation: each thread handles exactly ONE term\n180\t    // (since src_len <= skip_domain, each thread contributes at most one term)\n181\t    FpExt local_val(Fp::zero());\n182\t    if (active_chunk) {\n183\t        uint32_t src_len = std::min(trace_height, skip_domain);\n184\t        uint32_t stride = skip_domain / src_len;\n185\t        const Fp *cell_src = src + col_idx * trace_height + row_idx * src_len;\n186\t\n187\t        if (tid_in_chunk < src_len) {\n188\t            uint32_t idx = tid_in_chunk;\n189\t            local_val =\n190\t                cell_src[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n191\t        }\n192\t    }\n193\t\n194\t    // Reduce within chunk using the helper from sumcheck.cuh\n195\t    // All threads must participate; inactive chunks contribute zero\n196\t    FpExt result =\n197\t        sumcheck::chunk_reduce_sum(local_val, smem, tid_in_chunk, skip_domain, chunk_in_block);\n198\t\n199\t    // No __syncthreads() needed: each chunk writes to a distinct dst location\n200\t    // and kernel exits immediately after this write\n201\t    if (active_chunk && tid_in_chunk == 0) {\n202\t        dst[col_idx * new_height + row_idx] = result;\n203\t    }\n204\t}\n205\t\n206\t// Triangular sweep\n207\t__global__ void initialize_k_rot_from_eq_segments_kernel(\n208\t    const FpExt *eq_r_ns,\n209\t    FpExt *k_rot_ns,\n210\t    FpExt k_rot_uni_0,\n211\t    FpExt k_rot_uni_1\n212\t) {\n213\t    uint32_t x = blockIdx.x * blockDim.x + threadIdx.x;\n214\t    uint32_t n = blockIdx.y;\n215\t    uint32_t num_x = 1 << n;\n216\t\n217\t    if (x >= num_x)\n218\t        return;\n219\t\n220\t    auto eq_cube = get_eq_cube(eq_r_ns, num_x, x);\n221\t    auto k_rot_cube = get_eq_cube(eq_r_ns, num_x, rot_prev(x, num_x));\n222\t\n223\t    k_rot_ns[num_x + x] = k_rot_uni_0 * eq_cube + k_rot_uni_1 * (k_rot_cube - eq_cube);\n224\t}\n225\t\n226\t// Assumes we are not in degenerate case, in particular n = n_lift > 0\n227\t// Uses warp-aggregated atomics for reduction - no shared memory or __syncthreads() needed.\n228\t__global__ void stacked_reduction_sumcheck_mle_round_kernel(\n229\t    const FpExt *__restrict__ const\n230\t        *__restrict__ q_evals,          // pointers to matrices of same height, one per [commit_idx]\n231\t    const FpExt *__restrict__ eq_r_ns,  // pointer to EqEvalSegments\n232\t    const FpExt *__restrict__ k_rot_ns, // pointer to `k_rot` segments\n233\t    const UnstackedSlice *__restrict__ unstacked_cols, // pointer to unstacked_cols at window start\n234\t    const FpExt *__restrict__ lambda_pows,             // pointer to lambda_pows at window start\n235\t    uint64_t *__restrict__ output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n236\t    uint32_t q_height,             // height of each matrix in q_evals\n237\t    uint32_t window_len,\n238\t    uint32_t num_y\n239\t) {\n240\t    extern __shared__ char smem[];\n241\t    FpExt *shared = (FpExt *)smem;\n242\t    // Map phase: compute local sum by striding over window\n243\t    FpExt local_sums[S_DEG];\n244\t// Initialize accumulators\n245\t#pragma unroll\n246\t    for (int i = 0; i < S_DEG; i++) {\n247\t        local_sums[i] = FpExt(0);\n248\t    }\n249\t\n250\t    uint32_t window_idx_base = blockIdx.y;\n251\t    uint32_t y_int = blockIdx.x * blockDim.x + threadIdx.x;\n252\t    bool const active_thread = (y_int < num_y);\n253\t\n254\t    if (active_thread) {\n255\t        uint32_t num_evals = num_y * 2;\n256\t\n257\t        auto eq_0 = get_eq_cube(eq_r_ns, num_evals, y_int << 1);\n258\t        auto eq_1 = get_eq_cube(eq_r_ns, num_evals, (y_int << 1) | 1);\n259\t        auto eq_c1 = eq_1 - eq_0;\n260\t        auto k_rot_0 = get_eq_cube(k_rot_ns, num_evals, y_int << 1);\n261\t        auto k_rot_1 = get_eq_cube(k_rot_ns, num_evals, (y_int << 1) | 1);\n262\t        auto k_rot_c1 = k_rot_1 - k_rot_0;\n263\t\n264\t        // We sum over window at a stride, where stride = gridDim.y is tuned based on compute / memory\n265\t        // Currently assumes blockDim.y = 1\n266\t        for (uint32_t window_idx = window_idx_base; window_idx < window_len;\n267\t             window_idx += gridDim.y) {\n268\t            UnstackedSlice s = unstacked_cols[window_idx];\n269\t            const FpExt *__restrict__ q = q_evals[s.commit_idx];\n270\t\n271\t            auto log_height = s.log_height;\n272\t            auto col_idx = s.stacked_col_idx;\n273\t            auto row_start = (s.stacked_row_idx >> log_height) * num_evals;\n274\t            auto q_offset = col_idx * q_height + row_start;\n275\t\n276\t            auto q_0 = q[q_offset + (y_int << 1)];\n277\t            auto q_1 = q[q_offset + (y_int << 1) + 1];\n278\t            auto q_c1 = q_1 - q_0;\n279\t\n280\t#pragma unroll\n281\t            for (int x_int = 1; x_int <= S_DEG; ++x_int) {\n282\t                Fp x = Fp(x_int);\n283\t                auto q_x = q_0 + q_c1 * x;\n284\t                auto eq = eq_0 + eq_c1 * x;\n285\t                auto k_rot = k_rot_0 + k_rot_c1 * x;\n286\t\n287\t                local_sums[x_int - 1] +=\n288\t                    (lambda_pows[2 * window_idx] * eq + lambda_pows[2 * window_idx + 1] * k_rot) *\n289\t                    q_x;\n290\t            }\n291\t        }\n292\t    }\n293\t\n294\t#pragma unroll\n295\t    for (int idx = 0; idx < S_DEG; idx++) {\n296\t        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n297\t        if (threadIdx.x == 0) {\n298\t            sumcheck::atomic_add_fpext_to_u64(output + idx * 4, reduced);\n299\t        }\n300\t        __syncthreads();\n301\t    }\n302\t}\n303\t\n304\t// Degenerate case\n305\t// Uses warp-aggregated atomics for reduction - no shared memory or __syncthreads() needed.\n306\t__global__ void stacked_reduction_sumcheck_mle_round_degenerate_kernel(\n307\t    const FpExt *__restrict__ const\n308\t        *__restrict__ q_evals, // pointers to matrices of same height, one per [commit_idx]\n309\t    const FpExt *__restrict__ eq_ub_ptr, // pointer to `eq_ub_per_trace` at window start\n310\t    FpExt eq_r,                          // pointer to EqEvalSegments\n311\t    FpExt k_rot_r,                       // pointer to `k_rot` segments\n312\t    const UnstackedSlice *__restrict__ unstacked_cols, // pointer to unstacked_cols at window start\n313\t    const FpExt *__restrict__ lambda_pows,             // pointer to lambda_pows at window start\n314\t    uint64_t *__restrict__ output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n315\t    uint32_t q_height,             // height of each matrix in q_evals\n316\t    uint32_t window_len,\n317\t    uint32_t shift_factor // = l_skip + round\n318\t) {\n319\t    extern __shared__ char smem[];\n320\t    FpExt *shared = (FpExt *)smem;\n321\t\n322\t    FpExt local_sums[S_DEG];\n323\t#pragma unroll\n324\t    for (int i = 0; i < S_DEG; i++) {\n325\t        local_sums[i] = FpExt(0);\n326\t    }\n327\t\n328\t    for (uint32_t window_idx = threadIdx.x; window_idx < window_len; window_idx += blockDim.x) {\n329\t        UnstackedSlice s = unstacked_cols[window_idx];\n330\t        const FpExt *__restrict__ q = q_evals[s.commit_idx];\n331\t\n332\t        auto col_idx = s.stacked_col_idx;\n333\t        auto row_idx = s.stacked_row_idx;\n334\t        auto row_start = (row_idx >> shift_factor) << 1;\n335\t        auto q_offset = col_idx * q_height + row_start;\n336\t\n337\t        auto q_0 = q[q_offset];\n338\t        auto q_1 = q[q_offset + 1];\n339\t        auto q_c1 = q_1 - q_0;\n340\t\n341\t        uint32_t b_bool = (row_idx >> (shift_factor - 1)) & 1;\n342\t        Fp b = Fp(b_bool);\n343\t\n344\t        auto eq_ub = eq_ub_ptr[window_idx];\n345\t\n346\t#pragma unroll\n347\t        for (int x_int = 1; x_int <= S_DEG; ++x_int) {\n348\t            Fp x = Fp(x_int);\n349\t            auto eq_ub_x = eq_ub * eq1(x, b);\n350\t            auto eq = eq_r * eq_ub_x;\n351\t            auto k_rot = k_rot_r * eq_ub_x;\n352\t\n353\t            auto q_x = q_0 + q_c1 * x;\n354\t\n355\t            local_sums[x_int - 1] +=\n356\t                (lambda_pows[2 * window_idx] * eq + lambda_pows[2 * window_idx + 1] * k_rot) * q_x;\n357\t        }\n358\t    }\n359\t\n360\t#pragma unroll\n361\t    for (int idx = 0; idx < S_DEG; idx++) {\n362\t        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n363\t        if (threadIdx.x == 0) {\n364\t            sumcheck::atomic_add_fpext_to_u64(output + idx * 4, reduced);\n365\t        }\n366\t        __syncthreads();\n367\t    }\n368\t}\n369\t\n370\t// ============================================================================\n371\t// LAUNCHERS\n372\t// ============================================================================\n373\t\n374\tinline std::pair<dim3, dim3> stacked_reduction_round0_launch_params(\n375\t    uint32_t trace_height,\n376\t    uint32_t trace_width,\n377\t    uint32_t l_skip\n378\t) {\n379\t    uint32_t skip_domain = 1u << l_skip;\n380\t    auto lifted_height = std::max(trace_height, skip_domain);\n381\t    // Entire skip domain must fit within a block\n382\t    auto max_threads = std::max(skip_domain, 256u);\n383\t    auto [grid, block] = kernel_launch_params(lifted_height, max_threads);\n384\t    // NOTE: lifted_height = skip_domain * num_x will always be divisible by block.x since num_x is a power of 2. Therefore all threads in a block will be active.\n385\t    grid.y = trace_width;\n386\t    return {grid, block};\n387\t}\n388\t\n389\t// (Not a launcher) Utility function to calculate required size of temp buffer.\n390\t// Required length of *block_sums in FpExt elements\n391\t// SP_DEG=1: outputs NUM_G=3 values per z (G0, G1, G2)\n392\textern \"C\" uint32_t _stacked_reduction_r0_required_temp_buffer_size(\n393\t    uint32_t trace_height,\n394\t    uint32_t trace_width,\n395\t    uint32_t l_skip\n396\t) {\n397\t    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n398\t    return ((grid.x * grid.y) << l_skip) * NUM_G;\n399\t}\n400\t\n401\t// SP_DEG=1: No z_packets needed, outputs G0, G1, G2 on identity coset only.\n402\t// Uses ADD_TO_OUTPUT=true to accumulate into output buffer (for bucket-based accumulation).\n403\textern \"C\" int _stacked_reduction_sumcheck_round0(\n404\t    const FpExt *eq_r_ns,\n405\t    const Fp *trace_ptr,\n406\t    const FpExt *lambda_pows,\n407\t    FpExt *block_sums,\n408\t    FpExt *output, // length should be NUM_G * skip_domain, ADD to existing values\n409\t    uint32_t trace_height,\n410\t    uint32_t trace_width,\n411\t    uint32_t l_skip,\n412\t    uint32_t num_x\n413\t) {\n414\t    uint32_t skip_domain = 1u << l_skip;\n415\t    uint32_t stride = std::max(skip_domain / trace_height, 1u);\n416\t    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n417\t\n418\t    // Use block.x + 1 stride for shared_sum to avoid bank conflicts\n419\t    // NUM_G=3 outputs per z (G0, G1, G2)\n420\t    size_t shmem_sum_size = sizeof(FpExt) * (block.x + 1) * NUM_G;\n421\t\n422\t    stacked_reduction_round0_block_sum_kernel<<<grid, block, shmem_sum_size>>>(\n423\t        eq_r_ns, trace_ptr, lambda_pows, block_sums,\n424\t        trace_height, trace_width, l_skip,\n425\t        skip_domain - 1, num_x, 31 - __builtin_clz(stride)\n426\t    );\n427\t\n428\t    int err = CHECK_KERNEL();\n429\t    if (err != 0)\n430\t        return err;\n431\t\n432\t    // Launch final reduction kernel - reads from block_sums, ADDs to output\n433\t    auto num_blocks = grid.x * grid.y;\n434\t    auto output_size = NUM_G * skip_domain;\n435\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n436\t    size_t reduce_shmem = div_ceil(reduce_block.x, WARP_SIZE) * sizeof(FpExt);\n437\t    sumcheck::final_reduce_block_sums<true>\n438\t        <<<output_size, reduce_block, reduce_shmem>>>(block_sums, output, num_blocks);\n439\t\n440\t    return CHECK_KERNEL();\n441\t}\n442\t\n443\t// Parallelizes barycentric interpolation across 2^l_skip threads per output cell\n444\textern \"C\" int _stacked_reduction_fold_ple(\n445\t    const Fp *src,\n446\t    FpExt *dst,\n447\t    const Fp *omega_skip_pows,\n448\t    const FpExt *inv_lagrange_denoms,\n449\t    uint32_t trace_height,\n450\t    uint32_t trace_width,\n451\t    uint32_t l_skip\n452\t) {\n453\t    uint32_t skip_domain = 1u << l_skip;\n454\t    uint32_t new_height = std::max(trace_height, skip_domain) / skip_domain;\n455\t\n456\t    // Block size: at least skip_domain, prefer 256 for occupancy\n457\t    uint32_t block_size = std::max(256u, skip_domain);\n458\t    uint32_t chunks_per_block = block_size / skip_domain;\n459\t\n460\t    // 2D grid: x-dim for rows, y-dim for columns\n461\t    dim3 grid(div_ceil(new_height, chunks_per_block), trace_width);\n462\t    dim3 block(block_size);\n463\t\n464\t    // Shared memory for cross-warp reduction (needed when skip_domain > 32)\n465\t    // Each warp in the block needs one FpExt slot for cross-warp reduction\n466\t    uint32_t total_warps_in_block = block_size / WARP_SIZE;\n467\t    size_t smem_bytes = (skip_domain > WARP_SIZE) ? total_warps_in_block * sizeof(FpExt) : 0;\n468\t\n469\t    stacked_reduction_fold_ple_kernel<<<grid, block, smem_bytes>>>(\n470\t        src, dst, omega_skip_pows, inv_lagrange_denoms, trace_height, new_height, skip_domain\n471\t    );\n472\t\n473\t    return CHECK_KERNEL();\n474\t}\n475\t\n476\textern \"C\" int _initialize_k_rot_from_eq_segments(\n477\t    const FpExt *eq_r_ns,\n478\t    FpExt *k_rot_ns,\n479\t    FpExt k_rot_uni_0,\n480\t    FpExt k_rot_uni_1,\n481\t    uint32_t max_n\n482\t) {\n483\t    auto [grid, block] = kernel_launch_params(1 << max_n);\n484\t    grid.y = max_n + 1;\n485\t\n486\t    initialize_k_rot_from_eq_segments_kernel<<<grid, block>>>(\n487\t        eq_r_ns, k_rot_ns, k_rot_uni_0, k_rot_uni_1\n488\t    );\n489\t\n490\t    return CHECK_KERNEL();\n491\t}\n492\t\n493\textern \"C\" int _stacked_reduction_sumcheck_mle_round(\n494\t    const FpExt *const *q_evals,\n495\t    const FpExt *eq_r_ns,\n496\t    const FpExt *k_rot_ns,\n497\t    const UnstackedSlice *unstacked_cols,\n498\t    const FpExt *lambda_pows,\n499\t    uint64_t *output, // [S_DEG * D_EF] - atomic accumulator, reduced on CPU\n500\t    uint32_t q_height,\n501\t    uint32_t window_len,\n502\t    uint32_t num_y,\n503\t    uint32_t sm_count\n504\t) {\n505\t    // Smaller block size for more eligible warps to hide latency\n506\t    auto [grid, block] = kernel_launch_params(num_y, 256);\n507\t    assert(sm_count);\n508\t\n509\t    // Heuristic auto-tuning for window-stride (grid.y):\n510\t    // - Increase work per thread (reduce atomics) by targeting multiple window iterations/thread\n511\t    // - Ensure enough total blocks to keep SMs busy when num_y is small\n512\t    constexpr uint32_t WAVES_TARGET = 4; // blocks/SM target\n513\t    constexpr uint32_t ITERS_MIN = 4;    // prefer >= this many window iterations/thread\n514\t    constexpr uint32_t ITERS_MAX = 16;   // prefer <= this many window iterations/thread\n515\t\n516\t    uint32_t stride_occ = div_ceil(sm_count * WAVES_TARGET, grid.x);\n517\t    uint32_t stride_loop_lo = div_ceil(window_len, ITERS_MAX);\n518\t    uint32_t stride_loop_hi = div_ceil(window_len, ITERS_MIN);\n519\t\n520\t    uint32_t lo = std::max(1u, std::max(stride_occ, stride_loop_lo));\n521\t    uint32_t hi = std::min(std::min(window_len, MAX_GRID_DIM), stride_loop_hi);\n522\t\n523\t    uint32_t tuned_stride = (lo <= hi) ? lo : std::min(lo, std::min(window_len, MAX_GRID_DIM));\n524\t    grid.y = tuned_stride;\n525\t\n526\t    // Ensure that atomic add does not overflow u64\n527\t    assert((size_t)num_y * grid.y < (size_t)1u << 32);\n528\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n529\t\n530\t    stacked_reduction_sumcheck_mle_round_kernel<<<grid, block, shmem_bytes>>>(\n531\t        q_evals, eq_r_ns, k_rot_ns, unstacked_cols, lambda_pows, output, q_height, window_len, num_y\n532\t    );\n533\t\n534\t    return CHECK_KERNEL();\n535\t}\n536\t\n537\textern \"C\" int _stacked_reduction_sumcheck_mle_round_degenerate(\n538\t    const FpExt *const *q_evals,\n539\t    const FpExt *eq_ub_ptr,\n540\t    FpExt eq_r,\n541\t    FpExt k_rot_r,\n542\t    const UnstackedSlice *unstacked_cols,\n543\t    const FpExt *lambda_pows,\n544\t    uint64_t *output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n545\t    uint32_t q_height,\n546\t    uint32_t window_len,\n547\t    uint32_t l_skip,\n548\t    uint32_t round\n549\t) {\n550\t    auto shift_factor = l_skip + round;\n551\t    dim3 block(std::min(window_len, 256u));\n552\t    dim3 grid(1);\n553\t    // block.x <= 512 < 2^32 so atomic u64 will not overflow\n554\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n555\t\n556\t    stacked_reduction_sumcheck_mle_round_degenerate_kernel<<<grid, block, shmem_bytes>>>(\n557\t        q_evals,\n558\t        eq_ub_ptr,\n559\t        eq_r,\n560\t        k_rot_r,\n561\t        unstacked_cols,\n562\t        lambda_pows,\n563\t        output,\n564\t        q_height,\n565\t        window_len,\n566\t        shift_factor\n567\t    );\n568\t\n569\t    return CHECK_KERNEL();\n570\t}\n571\t"}]},"parent_tool_use_id":null,"session_id":"03176189-f3e8-4185-8773-a32af1748382","uuid":"36e7ef12-72a3-46b7-ad5a-a52e34894635","timestamp":"2026-04-13T04:48:31.024Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/cuda/src/stacked_reduction.cu","content":"#include \"device_ntt.cuh\"\n#include \"fp.h\"\n#include \"fpext.h\"\n#include \"frac_ext.cuh\"\n#include \"launcher.cuh\"\n#include \"sumcheck.cuh\"\n#include \"utils.cuh\"\n#include <algorithm>\n#include <cassert>\n#include <cmath>\n#include <cstddef>\n#include <cstdint>\n#include <cuda_runtime.h>\n#include <utility>\n#include <vector_types.h>\n\nusing namespace device_ntt;\n\nnamespace {\n\nconstexpr uint32_t MAX_GRID_DIM = 65535u;\n// S_DEG=2 for MLE sumcheck rounds (kept for backward compatibility)\nconstexpr int S_DEG = 2;\n// Number of G outputs per z in round 0 (SP_DEG=1): G0, G1, G2\nconstexpr int NUM_G = 3;\n\n} // namespace\n\nstruct UnstackedSlice {\n    uint32_t commit_idx;\n    uint32_t log_height;\n    uint32_t stacked_row_idx;\n    uint32_t stacked_col_idx;\n};\n\nstruct UnstackedPleFoldPacket {\n    const Fp *__restrict__ src;\n    FpExt *__restrict__ dst;\n    uint32_t height;\n    uint32_t width;\n};\n\n__device__ __forceinline__ FpExt get_eq_cube(const FpExt *eq_r_ns, uint32_t cube_size, uint32_t x) {\n    return eq_r_ns[cube_size + x];\n}\n\n__device__ __forceinline__ uint32_t rot_prev(uint32_t x_int, uint32_t cube_size) {\n    return x_int == 0 ? cube_size - 1 : x_int - 1;\n}\n\n__device__ __forceinline__ Fp eq1(Fp x, Fp y) { return Fp::one() - x - y + Fp(2) * x * y; }\n\n__device__ __forceinline__ Fp barycentric_interpolate_strided(\n    const Fp *evals,\n    uint32_t evals_len,\n    uint32_t z,\n    uint32_t expansion_factor,     // large_domain / skip_domain\n    const Fp *inv_lagrange_denoms, // denoms specifically for z\n    const Fp *omega_skip_pows,\n    uint32_t skip_domain\n) {\n    Fp q = Fp::zero();\n    uint32_t stride = evals_len >= skip_domain ? 1 : skip_domain / evals_len;\n    if (z % expansion_factor == 0) {\n        auto i = z / expansion_factor;\n        if (i % stride == 0)\n            q = evals[i / stride];\n    } else {\n        for (int idx = 0; idx < (skip_domain / stride); idx++) {\n            q += evals[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n        }\n    }\n    return q;\n}\n\n// SP_DEG=1 kernel: compute 3 partial sums G0, G1, G2 on identity coset only.\n// No iNTT/NTT operations - reconstruction happens on CPU via NTT-based polynomial multiplication.\n//\n// Each block covers a tile of z-values (threadIdx.x) and collaborates across threads\n// to sum over x for a single column. Blocks stride over columns via gridDim.y.\n//\n// G0(Z) = Σ_{col,x} coeff_eq[col] * eq_cube(x) * q_{col,x}(Z)\n// G1(Z) = Σ_{col,x} coeff_rot[col] * eq_cube(x) * q_{col,x}(Z)\n// G2(Z) = Σ_{col,x} coeff_rot[col] * (eq_cube(rot_prev(x)) - eq_cube(x)) * q_{col,x}(Z)\n//\n// where coeff_eq[col] = lambda_pows[2*col], coeff_rot[col] = lambda_pows[2*col+1]\n__global__ void stacked_reduction_round0_block_sum_kernel(\n    const FpExt *__restrict__ eq_r_ns, // pointer to EqEvalSegments\n    const Fp *__restrict__ trace_ptr,\n    const FpExt *__restrict__ lambda_pows, // pointer to lambda_pows at window start\n    FpExt *__restrict__ block_sums, // [gridDim.x * gridDim.y][NUM_G * skip_domain]\n    uint32_t height,                // trace height\n    uint32_t width,                 // trace width\n    uint32_t l_skip,\n    uint32_t skip_mask, // 2^l_skip - 1\n    uint32_t num_x,     // 1 << n_lift\n    uint32_t log_stride\n) {\n    extern __shared__ char smem[];\n    // Use blockDim.x + 1 stride to avoid shared memory bank conflicts\n    const uint32_t PADDED_X = blockDim.x + 1;\n    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem); // FpExt[NUM_G][PADDED_X]\n\n    uint32_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n    uint32_t z_idx = tidx & skip_mask;\n    uint32_t x_int = tidx >> l_skip;\n    uint32_t col_idx = blockIdx.y;\n\n    // Compute G weights (no z-dependent packets needed)\n    FpExt eq_cube = get_eq_cube(eq_r_ns, num_x, x_int);\n    FpExt eq_cube_rot_prev = get_eq_cube(eq_r_ns, num_x, rot_prev(x_int, num_x));\n    FpExt k_rot_diff = eq_cube_rot_prev - eq_cube;\n\n    FpExt coeff_eq = lambda_pows[2 * col_idx];      // for G0\n    FpExt coeff_rot = lambda_pows[2 * col_idx + 1]; // for G1, G2\n\n    FpExt w0 = coeff_eq * eq_cube;      // weight for G0\n    FpExt w1 = coeff_rot * eq_cube;     // weight for G1\n    FpExt w2 = coeff_rot * k_rot_diff;  // weight for G2\n\n    // Load trace value (identity coset only, no NTT needed)\n    auto evals = trace_ptr + col_idx * height + (x_int << (l_skip - log_stride));\n    auto stride_mask = (1u << log_stride) - 1;\n    Fp q = (z_idx & stride_mask) == 0 ? evals[z_idx >> log_stride] : Fp::zero();\n\n    // Store 3 partial sums to shared memory\n    shared_sum[0 * PADDED_X + threadIdx.x] = w0 * q;\n    shared_sum[1 * PADDED_X + threadIdx.x] = w1 * q;\n    shared_sum[2 * PADDED_X + threadIdx.x] = w2 * q;\n\n    __syncthreads();\n\n    // Reduction: only threads in first x-slice participate\n    if ((threadIdx.x >> l_skip) == 0) {\n        FpExt g0 = shared_sum[0 * PADDED_X + z_idx];\n        FpExt g1 = shared_sum[1 * PADDED_X + z_idx];\n        FpExt g2 = shared_sum[2 * PADDED_X + z_idx];\n\n        for (int lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n            g0 += shared_sum[0 * PADDED_X + (lane << l_skip) + z_idx];\n            g1 += shared_sum[1 * PADDED_X + (lane << l_skip) + z_idx];\n            g2 += shared_sum[2 * PADDED_X + (lane << l_skip) + z_idx];\n        }\n\n        // Output: 3 values per z_idx, stored contiguously\n        uint32_t skip_domain = 1u << l_skip;\n        FpExt *out_ptr =\n            block_sums + (col_idx * gridDim.x + blockIdx.x) * (NUM_G * skip_domain);\n        out_ptr[0 * skip_domain + z_idx] = g0;\n        out_ptr[1 * skip_domain + z_idx] = g1;\n        out_ptr[2 * skip_domain + z_idx] = g2;\n    }\n}\n\n// Single-trace kernel: each chunk of skip_domain threads handles one output cell\n// Parallelizes barycentric interpolation across threads for better performance\n// Grid: (num_row_blocks, trace_width) where blockIdx.y selects the column\n__global__ void stacked_reduction_fold_ple_kernel(\n    const Fp *__restrict__ src,\n    FpExt *__restrict__ dst,\n    const Fp *__restrict__ omega_skip_pows,\n    const FpExt *__restrict__ inv_lagrange_denoms,\n    uint32_t trace_height,\n    uint32_t new_height,\n    uint32_t skip_domain\n) {\n    extern __shared__ char smem_raw[];\n    FpExt *smem = reinterpret_cast<FpExt *>(smem_raw);\n\n    uint32_t col_idx = blockIdx.y;\n    uint32_t chunks_per_block = blockDim.x / skip_domain;\n    uint32_t chunk_in_block = threadIdx.x / skip_domain;\n    uint32_t tid_in_chunk = threadIdx.x % skip_domain;\n    uint32_t row_idx = blockIdx.x * chunks_per_block + chunk_in_block;\n\n    // Cannot early-return: all threads must participate in chunk_reduce_sum (uses __syncthreads)\n    bool const active_chunk = (row_idx < new_height);\n\n    // Barycentric interpolation: each thread handles exactly ONE term\n    // (since src_len <= skip_domain, each thread contributes at most one term)\n    FpExt local_val(Fp::zero());\n    if (active_chunk) {\n        uint32_t src_len = std::min(trace_height, skip_domain);\n        uint32_t stride = skip_domain / src_len;\n        const Fp *cell_src = src + col_idx * trace_height + row_idx * src_len;\n\n        if (tid_in_chunk < src_len) {\n            uint32_t idx = tid_in_chunk;\n            local_val =\n                cell_src[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n        }\n    }\n\n    // Reduce within chunk using the helper from sumcheck.cuh\n    // All threads must participate; inactive chunks contribute zero\n    FpExt result =\n        sumcheck::chunk_reduce_sum(local_val, smem, tid_in_chunk, skip_domain, chunk_in_block);\n\n    // No __syncthreads() needed: each chunk writes to a distinct dst location\n    // and kernel exits immediately after this write\n    if (active_chunk && tid_in_chunk == 0) {\n        dst[col_idx * new_height + row_idx] = result;\n    }\n}\n\n// Triangular sweep\n__global__ void initialize_k_rot_from_eq_segments_kernel(\n    const FpExt *eq_r_ns,\n    FpExt *k_rot_ns,\n    FpExt k_rot_uni_0,\n    FpExt k_rot_uni_1\n) {\n    uint32_t x = blockIdx.x * blockDim.x + threadIdx.x;\n    uint32_t n = blockIdx.y;\n    uint32_t num_x = 1 << n;\n\n    if (x >= num_x)\n        return;\n\n    auto eq_cube = get_eq_cube(eq_r_ns, num_x, x);\n    auto k_rot_cube = get_eq_cube(eq_r_ns, num_x, rot_prev(x, num_x));\n\n    k_rot_ns[num_x + x] = k_rot_uni_0 * eq_cube + k_rot_uni_1 * (k_rot_cube - eq_cube);\n}\n\n// Assumes we are not in degenerate case, in particular n = n_lift > 0\n// Uses warp-aggregated atomics for reduction - no shared memory or __syncthreads() needed.\n__global__ void stacked_reduction_sumcheck_mle_round_kernel(\n    const FpExt *__restrict__ const\n        *__restrict__ q_evals,          // pointers to matrices of same height, one per [commit_idx]\n    const FpExt *__restrict__ eq_r_ns,  // pointer to EqEvalSegments\n    const FpExt *__restrict__ k_rot_ns, // pointer to `k_rot` segments\n    const UnstackedSlice *__restrict__ unstacked_cols, // pointer to unstacked_cols at window start\n    const FpExt *__restrict__ lambda_pows,             // pointer to lambda_pows at window start\n    uint64_t *__restrict__ output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n    uint32_t q_height,             // height of each matrix in q_evals\n    uint32_t window_len,\n    uint32_t num_y\n) {\n    extern __shared__ char smem[];\n    FpExt *shared = (FpExt *)smem;\n    // Map phase: compute local sum by striding over window\n    FpExt local_sums[S_DEG];\n// Initialize accumulators\n#pragma unroll\n    for (int i = 0; i < S_DEG; i++) {\n        local_sums[i] = FpExt(0);\n    }\n\n    uint32_t window_idx_base = blockIdx.y;\n    uint32_t y_int = blockIdx.x * blockDim.x + threadIdx.x;\n    bool const active_thread = (y_int < num_y);\n\n    if (active_thread) {\n        uint32_t num_evals = num_y * 2;\n\n        auto eq_0 = get_eq_cube(eq_r_ns, num_evals, y_int << 1);\n        auto eq_1 = get_eq_cube(eq_r_ns, num_evals, (y_int << 1) | 1);\n        auto eq_c1 = eq_1 - eq_0;\n        auto k_rot_0 = get_eq_cube(k_rot_ns, num_evals, y_int << 1);\n        auto k_rot_1 = get_eq_cube(k_rot_ns, num_evals, (y_int << 1) | 1);\n        auto k_rot_c1 = k_rot_1 - k_rot_0;\n\n        // We sum over window at a stride, where stride = gridDim.y is tuned based on compute / memory\n        // Currently assumes blockDim.y = 1\n        for (uint32_t window_idx = window_idx_base; window_idx < window_len;\n             window_idx += gridDim.y) {\n            UnstackedSlice s = unstacked_cols[window_idx];\n            const FpExt *__restrict__ q = q_evals[s.commit_idx];\n\n            auto log_height = s.log_height;\n            auto col_idx = s.stacked_col_idx;\n            auto row_start = (s.stacked_row_idx >> log_height) * num_evals;\n            auto q_offset = col_idx * q_height + row_start;\n\n            auto q_0 = q[q_offset + (y_int << 1)];\n            auto q_1 = q[q_offset + (y_int << 1) + 1];\n            auto q_c1 = q_1 - q_0;\n\n#pragma unroll\n            for (int x_int = 1; x_int <= S_DEG; ++x_int) {\n                Fp x = Fp(x_int);\n                auto q_x = q_0 + q_c1 * x;\n                auto eq = eq_0 + eq_c1 * x;\n                auto k_rot = k_rot_0 + k_rot_c1 * x;\n\n                local_sums[x_int - 1] +=\n                    (lambda_pows[2 * window_idx] * eq + lambda_pows[2 * window_idx + 1] * k_rot) *\n                    q_x;\n            }\n        }\n    }\n\n#pragma unroll\n    for (int idx = 0; idx < S_DEG; idx++) {\n        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n        if (threadIdx.x == 0) {\n            sumcheck::atomic_add_fpext_to_u64(output + idx * 4, reduced);\n        }\n        __syncthreads();\n    }\n}\n\n// Degenerate case\n// Uses warp-aggregated atomics for reduction - no shared memory or __syncthreads() needed.\n__global__ void stacked_reduction_sumcheck_mle_round_degenerate_kernel(\n    const FpExt *__restrict__ const\n        *__restrict__ q_evals, // pointers to matrices of same height, one per [commit_idx]\n    const FpExt *__restrict__ eq_ub_ptr, // pointer to `eq_ub_per_trace` at window start\n    FpExt eq_r,                          // pointer to EqEvalSegments\n    FpExt k_rot_r,                       // pointer to `k_rot` segments\n    const UnstackedSlice *__restrict__ unstacked_cols, // pointer to unstacked_cols at window start\n    const FpExt *__restrict__ lambda_pows,             // pointer to lambda_pows at window start\n    uint64_t *__restrict__ output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n    uint32_t q_height,             // height of each matrix in q_evals\n    uint32_t window_len,\n    uint32_t shift_factor // = l_skip + round\n) {\n    extern __shared__ char smem[];\n    FpExt *shared = (FpExt *)smem;\n\n    FpExt local_sums[S_DEG];\n#pragma unroll\n    for (int i = 0; i < S_DEG; i++) {\n        local_sums[i] = FpExt(0);\n    }\n\n    for (uint32_t window_idx = threadIdx.x; window_idx < window_len; window_idx += blockDim.x) {\n        UnstackedSlice s = unstacked_cols[window_idx];\n        const FpExt *__restrict__ q = q_evals[s.commit_idx];\n\n        auto col_idx = s.stacked_col_idx;\n        auto row_idx = s.stacked_row_idx;\n        auto row_start = (row_idx >> shift_factor) << 1;\n        auto q_offset = col_idx * q_height + row_start;\n\n        auto q_0 = q[q_offset];\n        auto q_1 = q[q_offset + 1];\n        auto q_c1 = q_1 - q_0;\n\n        uint32_t b_bool = (row_idx >> (shift_factor - 1)) & 1;\n        Fp b = Fp(b_bool);\n\n        auto eq_ub = eq_ub_ptr[window_idx];\n\n#pragma unroll\n        for (int x_int = 1; x_int <= S_DEG; ++x_int) {\n            Fp x = Fp(x_int);\n            auto eq_ub_x = eq_ub * eq1(x, b);\n            auto eq = eq_r * eq_ub_x;\n            auto k_rot = k_rot_r * eq_ub_x;\n\n            auto q_x = q_0 + q_c1 * x;\n\n            local_sums[x_int - 1] +=\n                (lambda_pows[2 * window_idx] * eq + lambda_pows[2 * window_idx + 1] * k_rot) * q_x;\n        }\n    }\n\n#pragma unroll\n    for (int idx = 0; idx < S_DEG; idx++) {\n        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n        if (threadIdx.x == 0) {\n            sumcheck::atomic_add_fpext_to_u64(output + idx * 4, reduced);\n        }\n        __syncthreads();\n    }\n}\n\n// ============================================================================\n// LAUNCHERS\n// ============================================================================\n\ninline std::pair<dim3, dim3> stacked_reduction_round0_launch_params(\n    uint32_t trace_height,\n    uint32_t trace_width,\n    uint32_t l_skip\n) {\n    uint32_t skip_domain = 1u << l_skip;\n    auto lifted_height = std::max(trace_height, skip_domain);\n    // Entire skip domain must fit within a block\n    auto max_threads = std::max(skip_domain, 256u);\n    auto [grid, block] = kernel_launch_params(lifted_height, max_threads);\n    // NOTE: lifted_height = skip_domain * num_x will always be divisible by block.x since num_x is a power of 2. Therefore all threads in a block will be active.\n    grid.y = trace_width;\n    return {grid, block};\n}\n\n// (Not a launcher) Utility function to calculate required size of temp buffer.\n// Required length of *block_sums in FpExt elements\n// SP_DEG=1: outputs NUM_G=3 values per z (G0, G1, G2)\nextern \"C\" uint32_t _stacked_reduction_r0_required_temp_buffer_size(\n    uint32_t trace_height,\n    uint32_t trace_width,\n    uint32_t l_skip\n) {\n    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n    return ((grid.x * grid.y) << l_skip) * NUM_G;\n}\n\n// SP_DEG=1: No z_packets needed, outputs G0, G1, G2 on identity coset only.\n// Uses ADD_TO_OUTPUT=true to accumulate into output buffer (for bucket-based accumulation).\nextern \"C\" int _stacked_reduction_sumcheck_round0(\n    const FpExt *eq_r_ns,\n    const Fp *trace_ptr,\n    const FpExt *lambda_pows,\n    FpExt *block_sums,\n    FpExt *output, // length should be NUM_G * skip_domain, ADD to existing values\n    uint32_t trace_height,\n    uint32_t trace_width,\n    uint32_t l_skip,\n    uint32_t num_x\n) {\n    uint32_t skip_domain = 1u << l_skip;\n    uint32_t stride = std::max(skip_domain / trace_height, 1u);\n    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n\n    // Use block.x + 1 stride for shared_sum to avoid bank conflicts\n    // NUM_G=3 outputs per z (G0, G1, G2)\n    size_t shmem_sum_size = sizeof(FpExt) * (block.x + 1) * NUM_G;\n\n    stacked_reduction_round0_block_sum_kernel<<<grid, block, shmem_sum_size>>>(\n        eq_r_ns, trace_ptr, lambda_pows, block_sums,\n        trace_height, trace_width, l_skip,\n        skip_domain - 1, num_x, 31 - __builtin_clz(stride)\n    );\n\n    int err = CHECK_KERNEL();\n    if (err != 0)\n        return err;\n\n    // Launch final reduction kernel - reads from block_sums, ADDs to output\n    auto num_blocks = grid.x * grid.y;\n    auto output_size = NUM_G * skip_domain;\n    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n    size_t reduce_shmem = div_ceil(reduce_block.x, WARP_SIZE) * sizeof(FpExt);\n    sumcheck::final_reduce_block_sums<true>\n        <<<output_size, reduce_block, reduce_shmem>>>(block_sums, output, num_blocks);\n\n    return CHECK_KERNEL();\n}\n\n// Parallelizes barycentric interpolation across 2^l_skip threads per output cell\nextern \"C\" int _stacked_reduction_fold_ple(\n    const Fp *src,\n    FpExt *dst,\n    const Fp *omega_skip_pows,\n    const FpExt *inv_lagrange_denoms,\n    uint32_t trace_height,\n    uint32_t trace_width,\n    uint32_t l_skip\n) {\n    uint32_t skip_domain = 1u << l_skip;\n    uint32_t new_height = std::max(trace_height, skip_domain) / skip_domain;\n\n    // Block size: at least skip_domain, prefer 256 for occupancy\n    uint32_t block_size = std::max(256u, skip_domain);\n    uint32_t chunks_per_block = block_size / skip_domain;\n\n    // 2D grid: x-dim for rows, y-dim for columns\n    dim3 grid(div_ceil(new_height, chunks_per_block), trace_width);\n    dim3 block(block_size);\n\n    // Shared memory for cross-warp reduction (needed when skip_domain > 32)\n    // Each warp in the block needs one FpExt slot for cross-warp reduction\n    uint32_t total_warps_in_block = block_size / WARP_SIZE;\n    size_t smem_bytes = (skip_domain > WARP_SIZE) ? total_warps_in_block * sizeof(FpExt) : 0;\n\n    stacked_reduction_fold_ple_kernel<<<grid, block, smem_bytes>>>(\n        src, dst, omega_skip_pows, inv_lagrange_denoms, trace_height, new_height, skip_domain\n    );\n\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _initialize_k_rot_from_eq_segments(\n    const FpExt *eq_r_ns,\n    FpExt *k_rot_ns,\n    FpExt k_rot_uni_0,\n    FpExt k_rot_uni_1,\n    uint32_t max_n\n) {\n    auto [grid, block] = kernel_launch_params(1 << max_n);\n    grid.y = max_n + 1;\n\n    initialize_k_rot_from_eq_segments_kernel<<<grid, block>>>(\n        eq_r_ns, k_rot_ns, k_rot_uni_0, k_rot_uni_1\n    );\n\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _stacked_reduction_sumcheck_mle_round(\n    const FpExt *const *q_evals,\n    const FpExt *eq_r_ns,\n    const FpExt *k_rot_ns,\n    const UnstackedSlice *unstacked_cols,\n    const FpExt *lambda_pows,\n    uint64_t *output, // [S_DEG * D_EF] - atomic accumulator, reduced on CPU\n    uint32_t q_height,\n    uint32_t window_len,\n    uint32_t num_y,\n    uint32_t sm_count\n) {\n    // Smaller block size for more eligible warps to hide latency\n    auto [grid, block] = kernel_launch_params(num_y, 256);\n    assert(sm_count);\n\n    // Heuristic auto-tuning for window-stride (grid.y):\n    // - Increase work per thread (reduce atomics) by targeting multiple window iterations/thread\n    // - Ensure enough total blocks to keep SMs busy when num_y is small\n    constexpr uint32_t WAVES_TARGET = 4; // blocks/SM target\n    constexpr uint32_t ITERS_MIN = 4;    // prefer >= this many window iterations/thread\n    constexpr uint32_t ITERS_MAX = 16;   // prefer <= this many window iterations/thread\n\n    uint32_t stride_occ = div_ceil(sm_count * WAVES_TARGET, grid.x);\n    uint32_t stride_loop_lo = div_ceil(window_len, ITERS_MAX);\n    uint32_t stride_loop_hi = div_ceil(window_len, ITERS_MIN);\n\n    uint32_t lo = std::max(1u, std::max(stride_occ, stride_loop_lo));\n    uint32_t hi = std::min(std::min(window_len, MAX_GRID_DIM), stride_loop_hi);\n\n    uint32_t tuned_stride = (lo <= hi) ? lo : std::min(lo, std::min(window_len, MAX_GRID_DIM));\n    grid.y = tuned_stride;\n\n    // Ensure that atomic add does not overflow u64\n    assert((size_t)num_y * grid.y < (size_t)1u << 32);\n    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n\n    stacked_reduction_sumcheck_mle_round_kernel<<<grid, block, shmem_bytes>>>(\n        q_evals, eq_r_ns, k_rot_ns, unstacked_cols, lambda_pows, output, q_height, window_len, num_y\n    );\n\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _stacked_reduction_sumcheck_mle_round_degenerate(\n    const FpExt *const *q_evals,\n    const FpExt *eq_ub_ptr,\n    FpExt eq_r,\n    FpExt k_rot_r,\n    const UnstackedSlice *unstacked_cols,\n    const FpExt *lambda_pows,\n    uint64_t *output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n    uint32_t q_height,\n    uint32_t window_len,\n    uint32_t l_skip,\n    uint32_t round\n) {\n    auto shift_factor = l_skip + round;\n    dim3 block(std::min(window_len, 256u));\n    dim3 grid(1);\n    // block.x <= 512 < 2^32 so atomic u64 will not overflow\n    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n\n    stacked_reduction_sumcheck_mle_round_degenerate_kernel<<<grid, block, shmem_bytes>>>(\n        q_evals,\n        eq_ub_ptr,\n        eq_r,\n        k_rot_r,\n        unstacked_cols,\n        lambda_pows,\n        output,\n        q_height,\n        window_len,\n        shift_factor\n    );\n\n    return CHECK_KERNEL();\n}\n","numLines":571,"startLine":1,"totalLines":571}}}
