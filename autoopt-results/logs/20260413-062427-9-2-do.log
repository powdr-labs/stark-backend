41\t///\n242\t/// # Safety\n243\t/// - `output` must have length at least `S_DEG * D_EF = 8` and be zero-initialized.\n244\t#[allow(clippy::too_many_arguments)]\n245\tpub unsafe fn stacked_reduction_sumcheck_mle_round_degenerate(\n246\t    q_evals: &DeviceBuffer<*const EF>,\n247\t    eq_ub_ptr: *const EF,\n248\t    eq_r: EF,\n249\t    k_rot_r: EF,\n250\t    unstacked_cols: *const UnstackedSlice,\n251\t    lambda_pows: *const EF,\n252\t    output: &mut DeviceBuffer<u64>,\n253\t    q_height: usize,\n254\t    window_len: usize,\n255\t    l_skip: usize,\n256\t    round: usize,\n257\t) -> Result<(), CudaError> {\n258\t    debug_assert!(output.len() >= STACKED_REDUCTION_S_DEG * D_EF);\n259\t\n260\t    check(_stacked_reduction_sumcheck_mle_round_degenerate(\n261\t        q_evals.as_ptr(),\n262\t        eq_ub_ptr,\n263\t        eq_r,\n264\t        k_rot_r,\n265\t        unstacked_cols,\n266\t        lambda_pows,\n267\t        output.as_mut_ptr(),\n268\t        q_height as u32,\n269\t        window_len as u32,\n270\t        l_skip as u32,\n271\t        round as u32,\n272\t    ))\n273\t}\n274\t"}]},"parent_tool_use_id":null,"session_id":"03176189-f3e8-4185-8773-a32af1748382","uuid":"a666edc2-076d-42f7-8f42-7c22a2c15d98","timestamp":"2026-04-13T04:48:28.699Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/cuda/stacked_reduction.rs","content":"use openvm_cuda_common::{\n    d_buffer::DeviceBuffer,\n    error::{check, CudaError},\n};\n\nuse crate::{\n    poly::EqEvalSegments,\n    prelude::{D_EF, EF, F},\n    stacked_reduction::{UnstackedSlice, STACKED_REDUCTION_S_DEG},\n};\n\n/// Number of G outputs per z in round 0: G0, G1, G2\npub const NUM_G: usize = 3;\n\nextern \"C\" {\n    pub fn _stacked_reduction_r0_required_temp_buffer_size(\n        trace_height: u32,\n        trace_width: u32,\n        l_skip: u32,\n    ) -> u32;\n\n    // SP_DEG=1: no z_packets needed, outputs [NUM_G * skip_domain] to be ADDed\n    fn _stacked_