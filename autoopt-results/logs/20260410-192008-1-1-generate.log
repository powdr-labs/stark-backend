t eq_r,\n541\t    FpExt k_rot_r,\n542\t    const UnstackedSlice *unstacked_cols,\n543\t    const FpExt *lambda_pows,\n544\t    uint64_t *output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n545\t    uint32_t q_height,\n546\t    uint32_t window_len,\n547\t    uint32_t l_skip,\n548\t    uint32_t round\n549\t) {\n550\t    auto shift_factor = l_skip + round;\n551\t    dim3 block(std::min(window_len, 256u));\n552\t    dim3 grid(1);\n553\t    // block.x <= 512 < 2^32 so atomic u64 will not overflow\n554\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n555\t\n556\t    stacked_reduction_sumcheck_mle_round_degenerate_kernel<<<grid, block, shmem_bytes>>>(\n557\t        q_evals,\n558\t        eq_ub_ptr,\n559\t        eq_r,\n560\t        k_rot_r,\n561\t        unstacked_cols,\n562\t        lambda_pows,\n563\t        output,\n564\t        q_height,\n565\t        window_len,\n566\t        shift_factor\n567\t    );\n568\t\n569\t    return CHECK_KERNEL();\n570\t}\n571\t"}]},"parent_tool_use_id":"toolu_012AboZSK1JwAJAuCM1sMiKL","session_id":"9f2238e8-ef27-4ab7-979f-317ec3807970","uuid":"7440d5a9-8431-4933-93a8-d74bef6a893f","timestamp":"2026-04-10T17:26:20.764Z"}
