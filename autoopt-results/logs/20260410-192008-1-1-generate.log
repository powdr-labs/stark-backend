{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SBmbkyLRRGmXG71PRK6LDC","type":"tool_result","content":"1\t#include <algorithm>\n2\t#include <cassert>\n3\t#include <cmath>\n4\t#include <cstdint>\n5\t#include <cstdio>\n6\t#include <cstdlib>\n7\t#include <utility>\n8\t#include <vector_types.h>\n9\t\n10\t#include \"codec.cuh\"\n11\t#include \"dag_entry.cuh\"\n12\t#include \"eval_config.cuh\"\n13\t#include \"fp.h\"\n14\t#include \"fpext.h\"\n15\t#include \"launcher.cuh\"\n16\t#include \"sumcheck.cuh\"\n17\t#include \"utils.cuh\"\n18\t\n19\tusing namespace symbolic_dag;\n20\t\n21\tnamespace zerocheck_round0 {\n22\t\n23\tconstexpr uint32_t BUFFER_THRESHOLD = 16;\n24\t// Threshold for switching between coset-parallel and lockstep modes.\n25\t// When num_x * skip_domain < threshold, use coset-parallel (grid.y = num_cosets) for better GPU utilization.\n26\t// When >= threshold, use lockstep (single thread handles all cosets) to avoid redundant iNTT.\n27\tconstexpr uint32_t COSET_PARALLEL_THRESHOLD = 32768; // 2^15\n28\t\n29\t// Device function to compute constraint sums for all cosets in lockstep with DAG traversal.\n30\t// This computes: sum(lambda_i * constraint_i) for all constraints, for each coset.\n31\t// NOTE: Using __inline__ instead of __forceinline__ to let compiler decide based on register pressure.\n32\ttemplate <uint32_t NUM_COSETS, bool NEEDS_SHMEM>\n33\t__device__ __inline__ void acc_constraints(\n34\t    FpExt *__restrict__ constraint_sums, // output [NUM_COSETS]\n35\t    const NttEvalContext<NUM_COSETS> &eval_ctx,\n36\t    const Fp *is_first, // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n37\t    const Fp *is_last,  // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n38\t    uint32_t x_int,\n39\t    const FpExt *__restrict__ d_lambda_pows,\n40\t    const Rule *__restrict__ d_rules,\n41\t    size_t rules_len,\n42\t    const size_t *__restrict__ d_used_nodes,\n43\t    size_t used_nodes_len,\n44\t    size_t lambda_len\n45\t) {\n46\t    size_t lambda_idx = 0;\n47\t\n48\t    // Initialize constraint sums to zero\n49\t#pragma unroll\n50\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n51\t        constraint_sums[c] = FpExt(Fp::zero());\n52\t    }\n53\t\n54\t    for (size_t node = 0; node < rules_len; ++node) {\n55\t        Rule rule = d_rules[node];\n56\t        // Lazy decoding: only decode header (op, flags, x) upfront\n57\t        RuleHeader header = decode_rule_header(rule);\n58\t\n59\t        // Evaluate x operand for all cosets\n60\t        Fp x_vals[NUM_COSETS];\n61\t        ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(x_vals, header.x, eval_ctx, is_first, is_last, x_int);\n62\t\n63\t        switch (header.op) {\n64\t        case OP_ADD: {\n65\t            // Decode y only for binary ops\n66\t            SourceInfo y_src = decode_y(rule);\n67\t            Fp y_vals[NUM_COSETS];\n68\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n69\t#pragma unroll\n70\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n71\t                x_vals[c] += y_vals[c];\n72\t            }\n73\t            break;\n74\t        }\n75\t        case OP_SUB: {\n76\t            SourceInfo y_src = decode_y(rule);\n77\t            Fp y_vals[NUM_COSETS];\n78\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n79\t#pragma unroll\n80\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n81\t                x_vals[c] -= y_vals[c];\n82\t            }\n83\t            break;\n84\t        }\n85\t        case OP_MUL: {\n86\t            SourceInfo y_src = decode_y(rule);\n87\t            Fp y_vals[NUM_COSETS];\n88\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n89\t#pragma unroll\n90\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n91\t                x_vals[c] *= y_vals[c];\n92\t            }\n93\t            break;\n94\t        }\n95\t        case OP_NEG:\n96\t#pragma unroll\n97\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n98\t                x_vals[c] = -x_vals[c];\n99\t            }\n100\t            break;"}]},"parent_tool_use_id":"toolu_01MQvLWwmfYrQkKhNwfzkjse","session_id":"9f2238e8-ef27-4ab7-979f-317ec3807970","uuid":"3421303c-3c63-46e5-ae04-978e4091be81","timestamp":"2026-04-10T17:26:30.094Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017uZq9ttQp7AT6N1RphZUrf","type":"tool_result","content":"0\tuse std::{ffi::c_void, sync::Arc};\n1\t\n2\tuse getset::Getters;\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::{copy::cuda_memcpy, d_buffer::DeviceBuffer, memory_manager::MemTracker};\n5\tuse openvm_stark_backend::{\n6\t    p3_util::log2_strict_usize,\n7\t    prover::{stacked_pcs::StackedLayout, MatrixDimensions},\n8\t};\n9\tuse tracing::instrument;\n10\t\n11\tuse crate::{\n12\t    base::{DeviceMatrix, DeviceMatrixView},\n13\t    cuda::{\n14\t        batch_ntt_small::batch_ntt_small,\n15\t        matrix::{batch_expand_pad, batch_expand_pad_wide},\n16\t        ntt::bit_rev,\n17\t    },\n18\t    hash_scheme::GpuMerkleHash,\n19\t    merkle_tree::{MerkleTreeConstructor, MerkleTreeGpu},\n20\t    ntt::batch_ntt,\n21\t    poly::{mle_interpolate_stages, PleMatrix},\n22\t    prelude::F,\n23\t    GpuProverConfig, ProverError, RsCodeMatrixError, StackTracesError,\n24\t};\n25\t\n26\t#[derive(Getters)]\n27\tpub struct StackedPcsDataGpu<F, Digest> {\n28\t    /// Layout of the unstacked collection of matrices within the stacked matrix.\n29\t    #[getset(get = \"pub\")]\n30\t    pub(crate) layout: StackedLayout,\n31\t    /// The stacked matrix with height `2^{l_skip + n_stack}`.\n32\t    /// This is optionally cached depending on the prover configuration:\n33\t    /// - Caching increases the peak GPU memory but avoids a recomputation during stacked\n34\t    ///   reduction.\n35\t    /// - Not caching means the stacked matrix computation is recomputed during stacked reduction,\n36\t    ///   but lowers the peak GPU memory.\n37\t    #[getset(get = \"pub\")]\n38\t    pub(crate) matrix: Option<PleMatrix<F>>,\n39\t    /// Merkle tree of the Reed-Solomon codewords of the stacked matrix.\n40\t    /// Depends on `k_whir` parameter.\n41\t    #[getset(get = \"pub\")]\n42\t    pub(crate) tree: MerkleTreeGpu<F, Digest>,\n43\t}\n44\t\n45\t#[allow(clippy::type_complexity)]\n46\t#[instrument(level = \"info\", skip_all)]\n47\tpub fn stacked_commit<MH: GpuMerkleHash + MerkleTreeConstructor>(\n48\t    l_skip: usize,\n49\t    n_stack: usize,\n50\t    log_blowup: usize,\n51\t    k_whir: usize,\n52\t    traces: &[&DeviceMatrix<F>],\n53\t    prover_config: GpuProverConfig,\n54\t) -> Result<(MH::Digest, StackedPcsDataGpu<F, MH::Digest>), ProverError> {\n55\t    let mut mem = MemTracker::start(\"prover.stacked_commit\");\n56\t    mem.tracing_info(\"before stacked_commit\");\n57\t    mem.reset_peak();\n58\t    let layout = get_stacked_layout(l_skip, n_stack, traces);\n59\t    tracing::info!(\n60\t        height = layout.height(),\n61\t        width = layout.width(),\n62\t        \"stacked_matrix_dimensions\"\n63\t    );\n64\t    let opt_stacked_matrix = if prover_config.cache_stacked_matrix {\n65\t        Some(stack_traces(&layout, traces)?)\n66\t    } else {\n67\t        None\n68\t    };\n69\t    let rs_matrix = rs_code_matrix(log_blowup, &layout, traces, &opt_stacked_matrix)?;\n70\t    let tree = MerkleTreeGpu::<F, MH::Digest>::new_with_hash::<MH>(\n71\t        rs_matrix,\n72\t        1 << k_whir,\n73\t        prover_config.cache_rs_code_matrix,\n74\t    )?;\n75\t    let root = tree.root();\n76\t    let data = StackedPcsDataGpu {\n77\t        layout,\n78\t        matrix: opt_stacked_matrix,\n79\t        tree,\n80\t    };\n81\t    mem.emit_metrics();\n82\t    Ok((root, data))\n83\t}\n84\t\n85\t/// The `traces` **must** already be in height-sorted order.\n86\t///\n87\t/// This function is generic in `F` and only relies on CUDA memory operations.\n88\t#[instrument(skip_all)]\n89\tpub fn stacked_matrix(\n90\t    l_skip: usize,\n91\t    n_stack: usize,\n92\t    traces: &[&DeviceMatrix<F>],\n93\t) -> Result<(PleMatrix<F>, StackedLayout), ProverError> {\n94\t    let layout = get_stacked_layout(l_skip, n_stack, traces);\n95\t    let matrix = stack_traces(&layout, traces)?;\n96\t    Ok((matrix, layout))\n97\t}\n98\t\n99\tpub(crate) fn get_stacked_layout(\n100\t    l_skip: usize,\n101\t    n_stack: usize,\n102\t    traces: &[&DeviceMatrix<F>],\n103\t) -> StackedLayout {\n104\t    let sorted_meta = traces\n105\t        .iter()\n106\t        .map(|trace| {\n107\t            // height cannot be zero:\n108\t            let log_height = log2_strict_usize(trace.height());\n109\t            (trace.width(), log_height)\n110\t        })\n111\t        .collect_vec();\n112\t    debug_assert!(sorted_meta.is_sorted_by(|a, b| a.1 >= b.1));\n113\t    StackedLayout::new(l_skip, l_skip + n_stack, sorted_meta).unwrap()\n114\t}\n115\t\n116\tpub(crate) fn stack_traces(\n117\t    layout: &StackedLayout,\n118\t    traces: &[&DeviceMatrix<F>],\n119\t) -> Result<PleMatrix<F>, StackTracesError> {\n120\t    let mem = MemTracker::start(\"prover.stack_traces\");\n121\t    let l_skip = layout.l_skip();\n122\t    let height = layout.height();\n123\t    let width = layout.width();\n124\t    let mut q_evals = DeviceBuffer::<F>::with_capacity(width.checked_mul(height).unwrap());\n125\t    stack_traces_into_expanded(layout, traces, &mut q_evals, height)?;\n126\t    mem.emit_metrics();\n127\t    Ok(PleMatrix::from_evals(l_skip, q_evals, height, width))\n128\t}\n129\t\n130\t/// `buffer` should be the buffer to write the stacked traces into.\n131\t/// `buffer` should be a matrix with dimensions `padded_height x width` where `width` is the stacked\n132\t/// width and `padded_height` must be a multiple of the stacked height.\n133\tpub(crate) fn stack_traces_into_expanded(\n134\t    layout: &StackedLayout,\n135\t    traces: &[&DeviceMatrix<F>],\n136\t    buffer: &mut DeviceBuffer<F>,\n137\t    padded_height: usize,\n138\t) -> Result<(), StackTracesError> {\n139\t    let l_skip = layout.l_skip();\n140\t    debug_assert_eq!(padded_height % layout.height(), 0);\n141\t    debug_assert_eq!(buffer.len() % padded_height, 0);\n142\t    debug_assert_eq!(buffer.len() / padded_height, layout.width());\n143\t    buffer.fill_zero().map_err(StackTracesError::FillZero)?;\n144\t    for (mat_idx, j, s) in &layout.sorted_cols {\n145\t        let start = s.col_idx * padded_height + s.row_idx;\n146\t        let trace = traces[*mat_idx];\n147\t        let s_len = s.len(l_skip);\n148\t        debug_assert_eq!(trace.height(), 1 << s.log_height());\n149\t        if s.log_height() >= l_skip {\n150\t            debug_assert_eq!(trace.height(), s_len);\n151\t            // SAFETY: matrix buffers are allocated correctly with respect to dimensions\n152\t            // - `trace.height() = s_len` since `log_height >= l_skip`\n153\t            // - `q_buf` has enough capacity by definition of stacked `layout`\n154\t            unsafe {\n155\t                let src = trace.buffer().as_ptr().add(*j * s_len);\n156\t                let dst = buffer.as_mut_ptr().add(start);\n157\t                // D2D memcpy\n158\t                cuda_memcpy::<true, true>(\n159\t                    dst as *mut c_void,\n160\t                    src as *const c_void,\n161\t                    s_len * size_of::<F>(),\n162\t                )?;\n163\t            }\n164\t        } else {\n165\t            let stride = s.stride(l_skip);\n166\t            debug_assert_eq!(stride * trace.height(), s_len);\n167\t            // SAFETY: matrix buffers are allocated correctly\n168\t            // - `q_buf` has enough capacity by definition of stacked `layout`\n169\t            // - we abuse `batch_expand_pad` with `poly_count = trace.height()` to create a strided\n170\t            //   column of length `s_len = stride * trace.height()`\n171\t            unsafe {\n172\t                let src = trace.buffer().as_ptr().add(*j * trace.height());\n173\t                let dst = buffer.as_mut_ptr().add(start);\n174\t                batch_expand_pad_wide(dst, src, trace.height() as u32, stride as u32, 1)\n175\t                    .map_err(StackTracesError::BatchExpandPadWide)?;\n176\t            }\n177\t        }\n178\t    }\n179\t    Ok(())\n180\t}\n181\t\n182\t/// Computes the Reed-Solomon codeword of each column vector of `eval_matrix` where the rate is\n183\t/// `2^{-log_blowup}`. The column vectors are treated as evaluations of a prismalinear extension on\n184\t/// a hyperprism.\n185\t///\n186\t/// Uses `stacked_matrix` if available, or else stacks `traces` directly into final codeword matrix\n187\t/// buffer.\n188\t#[instrument(skip_all)]\n189\tpub fn rs_code_matrix(\n190\t    log_blowup: usize,\n191\t    layout: &StackedLayout,\n192\t    traces: &[&DeviceMatrix<F>],\n193\t    stacked_matrix: &Option<PleMatrix<F>>,\n194\t) -> Result<DeviceMatrix<F>, RsCodeMatrixError> {\n195\t    let mem = MemTracker::start_and_reset_peak(\"prover.rs_code_matrix\");\n196\t    let l_skip = layout.l_skip();\n197\t    let height = layout.height();\n198\t    let width = layout.width();\n199\t    debug_assert!(height >= (1 << l_skip));\n200\t    let codeword_height = height.checked_shl(log_blowup as u32).unwrap();\n201\t    let mut codewords = DeviceBuffer::<F>::with_capacity(codeword_height * width);\n202\t    // The following kernels together perform MLE interpolation followed by coset NTT for\n203\t    // `width` polys from `height -> codeword_height` size domains.\n204\t    if let Some(stacked_matrix) = stacked_matrix.as_ref() {\n205\t        // SAFETY: `codewords` is allocated for `width` polys of `codeword_height` each, and we\n206\t        // expand from `matrix.mixed` which is `width` polys of `height` each.\n207\t        unsafe {\n208\t            batch_expand_pad(\n209\t                codewords.as_mut_ptr(),\n210\t                stacked_matrix.mixed.as_ptr(),\n211\t                width as u32,\n212\t                codeword_height as u32,\n213\t                height as u32,\n214\t            )\n215\t            .map_err(RsCodeMatrixError::BatchExpandPad)?;\n216\t        }\n217\t    } else {\n218\t        stack_traces_into_expanded(layout, traces, &mut codewords, codeword_height)\n219\t            .map_err(RsCodeMatrixError::