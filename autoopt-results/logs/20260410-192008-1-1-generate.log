        let l_skip = self.l_skip;\n918\t        let (folded_q_evals, input_ptrs, output_ptrs): (Vec<_>, Vec<_>, Vec<_>) = self\n919\t            .q_evals\n920\t            .iter()\n921\t            .map(|q| {\n922\t                let folded = DeviceBuffer::with_capacity(q.len() >> 1);\n923\t                let output_ptr = folded.as_mut_ptr();\n924\t                (folded, q.as_ptr(), output_ptr)\n925\t            })\n926\t            .multiunzip();\n927\t        input_ptrs.copy_to(&mut self.d_input_ptrs)?;\n928\t        output_ptrs.copy_to(&mut self.d_output_ptrs)?;\n929\t\n930\t        // SAFETY:\n931\t        // - `d_input_ptrs` points to matrices with widths specified by `d_q_widths` and heights\n932\t        //   `stacked_height(round) = stacked_height(round + 1) * 2`.\n933\t        // - `d_output_ptrs` points to matrices just allocated with widths specified by `d_q_widths`\n934\t        //   and heights `stacked_height(round + 1)`.\n935\t        let output_height = self.stacked_height(round + 1) as u32;\n936\t        unsafe {\n937\t            fold_mle(\n938\t                &self.d_input_ptrs,\n939\t                &self.d_output_ptrs,\n940\t                &self.d_q_widths,\n941\t                self.q_evals.len().try_into().unwrap(),\n942\t                self.stacked_height(round + 1) as u32,\n943\t                self.q_width_max * output_height,\n944\t                u_round,\n945\t            )\n946\t            .map_err(StackedReductionError::FoldMle)?;\n947\t        }\n948\t        self.q_evals = folded_q_evals;\n949\t\n950\t        if self.n_max >= (round - 1) {\n951\t            let input_max_n = self.cur_max_n(round);\n952\t            let output_max_n = input_max_n.saturating_sub(1);\n953\t            let output_len = 1 << input_max_n;\n954\t\n955\t            let mut buffer = DeviceBuffer::<EF>::with_capacity(output_len);\n956\t            [EF::ZERO].copy_to(&mut buffer)?;\n957\t            // SAFETY:\n958\t            // - eq_r_ns has max_n eq