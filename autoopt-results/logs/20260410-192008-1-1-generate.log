hts,\n667\t    const FpExt *denom_weights,\n668\t    FpExt denom_sum_init,\n669\t    const Rule *d_rules,\n670\t    size_t rules_len,\n671\t    uint32_t buffer_size,\n672\t    Fp *d_intermediates,\n673\t    uint32_t skip_domain,\n674\t    uint32_t num_x,\n675\t    uint32_t height,\n676\t    uint32_t num_cosets,\n677\t    Fp g_shift,\n678\t    size_t max_temp_bytes\n679\t) {\n680\t    bool is_global = buffer_size > BUFFER_THRESHOLD;\n681\t    bool needs_shmem = skip_domain > WARP_SIZE;\n682\t\n683\t    // Threshold-based dispatch: use coset-parallel for small workloads\n684\t    if (use_coset_parallel_mode(num_x, skip_domain)) {\n685\t        // Coset-parallel mode: grid.y = num_cosets, each block handles one coset\n686\t        if (is_global) {\n687\t            if (needs_shmem) {\n688\t                return launch_logup_coset_parallel<true, true>(\n689\t                    tmp_sums_buffer,\n690\t                    output,\n691\t                    selectors_cube,\n692\t                    preprocessed,\n693\t                    main_parts,\n694\t                    eq_cube,\n695\t                    public_values,\n696\t                    numer_weights,\n697\t                    denom_weights,\n698\t                    denom_sum_init,\n699\t                    d_rules,\n700\t                    rules_len,\n701\t                    buffer_size,\n702\t                    d_intermediates,\n703\t                    skip_domain,\n704\t                    num_x,\n705\t                    height,\n706\t                    num_cosets,\n707\t                    g_shift,\n708\t                    max_temp_bytes\n709\t                );\n710\t            } else {\n711\t                return launch_logup_coset_parallel<true, false>(\n712\t                    tmp_sums_buffer,\n713\t                    output,\n714\t                    selectors_cube,\n715\t                    preprocessed,\n716\t                    main_parts,"}]},"parent_tool_use_id":"toolu_01MQvLWwmfYrQkK