{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Epkq4W9M4Sc2yUaxKtRJcr","type":"tool_result","content":"1\tuse std::sync::Arc;\n2\t\n3\tuse itertools::Itertools;\n4\t\n5\tuse crate::{\n6\t    air_builders::debug::{debug_constraints_and_interactions, AirProofRawInput},\n7\t    keygen::{\n8\t        types::{MultiStarkProvingKey, MultiStarkVerifyingKey},\n9\t        MultiStarkKeygenBuilder,\n10\t    },\n11\t    proof::*,\n12\t    prover::{\n13\t        AirProvingContext, ColMajorMatrix, Coordinator, DeviceDataTransporter,\n14\t        DeviceMultiStarkProvingKey, MultiRapProver, OpeningProver, Prover, ProverBackend,\n15\t        ProverDevice, ProvingContext, StridedColMajorMatrixView,\n16\t    },\n17\t    verifier::{verify, VerifierError},\n18\t    AirRef, FiatShamirTranscript, StarkProtocolConfig, SystemParams,\n19\t};\n20\t\n21\t/// Data for verifying a Stark proof.\n22\t#[derive(Debug)]\n23\tpub struct VerificationData<SC: StarkProtocolConfig> {\n24\t    pub vk: MultiStarkVerifyingKey<SC>,\n25\t    pub proof: Proof<SC>,\n26\t}\n27\t\n28\tpub type ProverError<E> =\n29\t    <<E as StarkEngine>::PD as ProverDevice<<E as StarkEngine>::PB, <E as StarkEngine>::TS>>::Error;\n30\t\n31\t/// A helper trait to collect the different steps in multi-trace STARK\n32\t/// keygen and proving.\n33\tpub trait StarkEngine\n34\twhere\n35\t    <Self::PD as MultiRapProver<Self::PB, Self::TS>>::Artifacts:\n36\t        Into<<Self::PD as OpeningProver<Self::PB, Self::TS>>::OpeningPoints>,\n37\t    <Self::PD as MultiRapProver<Self::PB, Self::TS>>::PartialProof:\n38\t        Into<(GkrProof<Self::SC>, BatchConstraintProof<Self::SC>)>,\n39\t    <Self::PD as OpeningProver<Self::PB, Self::TS>>::OpeningProof:\n40\t        Into<(StackingProof<Self::SC>, WhirProof<Self::SC>)>,\n41\t{\n42\t    type SC: StarkProtocolConfig;\n43\t    type PB: ProverBackend<\n44\t        Val = <Self::SC as StarkProtocolConfig>::F,\n45\t        Challenge = <Self::SC as StarkProtocolConfig>::EF,\n46\t        Commitment = <Self::SC as StarkProtocolConfig>::Digest,\n47\t    >;\n48\t    type PD: ProverDevice<Self::PB, Self::TS> + DeviceDataTransporter<Self::SC, Self::PB>;\n49\t    type TS: FiatShamirTranscript<Self::SC>;\n50\t\n51\t    /// Constructor from only system parameters. In particular, the transcript and hasher must have\n52\t    /// a default configuration.\n53\t    fn new(params: SystemParams) -> Self;\n54\t\n55\t    fn config(&self) -> &Self::SC;\n56\t\n57\t    fn params(&self) -> &SystemParams {\n58\t        self.config().params()\n59\t    }\n60\t\n61\t    fn device(&self) -> &Self::PD;\n62\t\n63\t    /// Creates transcript with a deterministic initial state.\n64\t    fn initial_transcript(&self) -> Self::TS;\n65\t\n66\t    fn prover_from_transcript(\n67\t        &self,\n68\t        transcript: Self::TS,\n69\t    ) -> Coordinator<Self::SC, Self::PB, Self::PD, Self::TS>;\n70\t\n71\t    fn prover(&self) -> Coordinator<Self::SC, Self::PB, Self::PD, Self::TS> {\n72\t        let transcript = self.initial_transcript();\n73\t        self.prover_from_transcript(transcript)\n74\t    }\n75\t\n76\t    fn keygen(\n77\t        &self,\n78\t        airs: &[AirRef<Self::SC>],\n79\t    ) -> (\n80\t        MultiStarkProvingKey<Self::SC>,\n81\t        MultiStarkVerifyingKey<Self::SC>,\n82\t    ) {\n83\t        let mut keygen_builder = MultiStarkKeygenBuilder::new(self.config().clone());\n84\t        for air in airs {\n85\t            keygen_builder.add_air(air.clone());\n86\t        }\n87\t\n88\t        let pk = keygen_builder.generate_pk().unwrap();\n89\t        let vk = pk.get_vk();\n90\t        (pk, vk)\n91\t    }\n92\t\n93\t    fn prove(\n94\t        &self,\n95\t        pk: &DeviceMultiStarkProvingKey<Self::PB>,\n96\t        ctx: ProvingContext<Self::PB>,\n97\t    ) -> Result<Proof<Self::SC>, ProverError<Self>> {\n98\t        let mut prover = self.prover();\n99\t        prover.prove(pk, ctx)\n100\t    }\n101\t\n102\t    /// Verifies using a default instantiation of the Fiat-Shamir transcript.\n103\t    fn verify(\n104\t        &self,\n105\t        vk: &MultiStarkVerifyingKey<Self::SC>,\n106\t        proof: &Proof<Self::SC>,\n107\t    ) -> Result<(), VerifierError<<Self::SC as StarkProtocolConfig>::EF>> {\n108\t        let mut transcript = self.initial_transcript();\n109\t        verify(self.config(), vk, proof, &mut transcript)\n110\t    }\n111\t\n112\t    /// The indexing of AIR ID in `ctx` should be consistent with the order of `airs`. In\n113\t    /// particular, `airs` should correspond to the global proving key with all AIRs, including ones\n114\t    /// not present in the `ctx`.\n115\t    fn debug(&self, airs: &[AirRef<Self::SC>], ctx: &ProvingContext<Self::PB>) {\n116\t        let mut keygen_builder = MultiStarkKeygenBuilder::new(self.config().clone());\n117\t        for air in airs {\n118\t            keygen_builder.add_air(air.clone());\n119\t        }\n120\t        let pk = keygen_builder.generate_pk().unwrap();\n121\t\n122\t        let transpose = |mat: ColMajorMatrix<<Self::SC as StarkProtocolConfig>::F>| {\n123\t            let row_major = StridedColMajorMatrixView::from(mat.as_view()).to_row_major_matrix();\n124\t            Arc::new(row_major)\n125\t        };\n126\t        let (inputs, used_airs, used_pks): (Vec<_>, Vec<_>, Vec<_>) = ctx\n127\t            .per_trace\n128\t            .iter()\n129\t            .map(|(air_id, trace_ctx)| {\n130\t                let common_main = self\n131\t                    .device()\n132\t                    .transport_matrix_from_device_to_host(&trace_ctx.common_main);\n133\t                let cached_mains = trace_ctx\n134\t                    .cached_mains\n135\t                    .iter()\n136\t                    .map(|cd| {\n137\t                        transpose(\n138\t                            self.device()\n139\t                                .transport_matrix_from_device_to_host(&cd.trace),\n140\t                        )\n141\t                    })\n142\t                    .collect_vec();\n143\t                let common_main = Some(transpose(common_main));\n144\t                let public_values = trace_ctx.public_values.clone();\n145\t                (\n146\t                    AirProofRawInput {\n147\t                        cached_mains,\n148\t                        common_main,\n149\t                        public_values,\n150\t                    },\n151\t                    airs[*air_id].clone(),\n152\t                    &pk.per_air[*air_id],\n153\t                )\n154\t            })\n155\t            .multiunzip();\n156\t\n157\t        debug_constraints_and_interactions(&used_airs, &used_pks, &inputs);\n158\t    }\n159\t\n160\t    /// Runs a single end-to-end test for a given set of chips and traces partitions.\n161\t    /// This includes proving/verifying key generation, creating a proof, and verifying the proof.\n162\t    fn run_test(\n163\t        &self,\n164\t        airs: Vec<AirRef<Self::SC>>,\n165\t        ctxs: Vec<AirProvingContext<Self::PB>>,\n166\t    ) -> RunTestResult<Self::SC, Self::PB, Self::PD, Self::TS> {\n167\t        let (pk, vk) = self.keygen(&airs);\n168\t        let device = self.prover().device;\n169\t        let d_pk = device.transport_pk_to_device(&pk);\n170\t        let ctx = ProvingContext::new(ctxs.into_iter().enumerate().collect());\n171\t        let proof = self.prove(&d_pk, ctx).map_err(StarkTestError::Prover)?;\n172\t        self.verify(&vk, &proof).map_err(StarkTestError::Verifier)?;\n173\t        Ok(VerificationData { vk, proof })\n174\t    }\n175\t}\n176\t\n177\ttype RunTestResult<SC, PB, PD, TS> = Result<\n178\t    VerificationData<SC>,\n179\t    StarkTestError<<PD as ProverDevice<PB, TS>>::Error, <SC as StarkProtocolConfig>::EF>,\n180\t>;\n181\t\n182\t/// Error type for end-to-end tests that can fail in either the prover or verifier.\n183\t#[derive(Debug)]\n184\tpub enum StarkTestError<\n185\t    PE: std::error::Error,\n186\t    EF: std::fmt::Debug + std::fmt::Display + PartialEq + Eq,\n187\t> {\n188\t    Prover(PE),\n189\t    Verifier(VerifierError<EF>),\n190\t}\n191\t\n192\timpl<PE: std::error::Error, EF: core::fmt::Debug + core::fmt::Display + PartialEq + Eq>\n193\t    core::fmt::Display for StarkTestError<PE, EF>\n194\t{\n195\t    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n196\t        match self {\n197\t            Self::Prover(e) => write!(f, \"Prover error: {e:?}\"),\n198\t            Self::Verifier(e) => write!(f, \"Verifier error: {e}\"),\n199\t        }\n200\t    }\n201\t}\n202\t\n203\timpl<PE: std::error::Error, EF: core::fmt::Debug + core::fmt::Display + PartialEq + Eq>\n204\t    std::error::Error for StarkTestError<PE, EF>\n205\t{\n206\t}\n207\t"}]},"parent_tool_use_id":"toolu_01CbG7hne4kzjjnk4LuXfxhY","session_id":"9f2238e8-ef27-4ab7-979f-317ec3807970","uuid":"7325cf22-86fa-4189-9b07-56a75662e541","timestamp":"2026-04-10T17:26:26.467Z"}
