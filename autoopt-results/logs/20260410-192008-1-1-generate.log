edReductionError,\n46\t};\n47\t\n48\t/// Degree of the sumcheck polynomial for stacked reduction.\n49\tpub const STACKED_REDUCTION_S_DEG: usize = 2;\n50\t\n51\tpub struct StackedReductionGpu<D = Digest> {\n52\t    sm_count: u32,\n53\t\n54\t    l_skip: usize,\n55\t    n_stack: usize,\n56\t\n57\t    omega_skip: F,\n58\t    omega_skip_pows: Vec<F>,\n59\t    d_omega_skip_pows: DeviceBuffer<F>,\n60\t\n61\t    r_0: EF,\n62\t    d_lambda_pows: DeviceBuffer<EF>,\n63\t    eq_const: EF,\n64\t\n65\t    pub(crate) stacked_per_commit: Vec<StackedPcsData2<D>>,\n66\t    d_q_widths: DeviceBuffer<u32>,\n67\t    q_width_max: u32,\n68\t    d_q_eval_ptrs: DeviceBuffer<*const EF>,\n69\t\n70\t    trace_ptrs: Vec<(\n71\t        *const F, /* trace_ptr */\n72\t        usize,    /* height */\n73\t        usize,    /* width */\n74\t    )>,\n75\t    unstacked_cols: Vec<UnstackedSlice>,\n76\t    d_unstacked_cols: DeviceBuffer<UnstackedSlice>,\n77\t    // boundary indices where heights change. all columns between two boundaries must have the same\n78\t    // height. We can have multiple chunks of the same height if that is needed to reduce peak GPU\n79\t    // memory.\n80\t    ht_diff_idxs: Vec<usize>,\n81\t    n_max: usize,\n82\t\n83\t    // Initially holds eq(r[1..=n], H_n) for n=0..=n_max but gets updated after each sumcheck round\n84\t    // by some custom folding\n85\t    eq_r_ns: EqEvalSegments<EF>,\n86\t\n87\t    // == After round 0 ==\n88\t    q_evals: Vec<DeviceBuffer<EF>>, // get width from stacked_per_commit\n89\t    // Stores folded eq values that won't change anymore (no more folding)\n90\t    // Corresponds to log_height in 0..l_skip+round-1 _before_ round `round`. Gets updated with one\n91\t    // new element after each round.\n92\t    eq_stable: Vec<EF>,\n93\t    k_rot_stable: Vec<EF>,\n94\t\n95\t    /// Stores the folded k_rot evaluations for `\\kappa_\\rot(x, r) = eq_n(rot^{-1}(x), r)` for each\n96\t    /// `n` after each round. We use the [EqEvalSegments] type to guard the segment-based\n97\t    /// memory layout.\n98\t    k_rot_ns: EqEvalSegments<EF>,\n99\t    /// Stores eq(u[1+n_T..round-1], b_{T,j}[..round-n_T-1])\n100\t    eq_ub_per_trace: Vec<EF>,\n101\t    d_eq_ub: DeviceBuffer<EF>,\n102\t\n103\t    d_block_sums: DeviceBuffer<EF>,\n104\t    d_accum: DeviceBuffer<u64>,\n105\t    d_input_ptrs: DeviceBuffer<*const EF>,\n106\t    d_output_ptrs: DeviceBuffer<*mut EF>,\n107\t\n108\t    mem: MemTracker,\n109\t}\n110\t\n111\t/// A struct for holding stacked pcs data. We only need the `MerkleTreeGpu` from `StackedPcsDataGpu`\n112\t/// but we wrap the latter in an `Arc` to provide uniformity in dealing with common main and\n113\t/// preprocessed/cached traces. This struct stores the unstacked `traces`, in prismalinear\n114\t/// evaluation form, corresponding to the stacked pcs data.\n115\t///\n116\t/// Generic over the Merkle digest type `D`.  The default `D = Digest` preserves the existing\n117\t/// BabyBear-Poseidon2 behaviour.\n118\tpub struct StackedPcsData2<D = Digest> {\n119\t    pub(crate) inner: Arc<StackedPcsDataGpu<F, D>>,\n120\t    /// The unstacked traces corresponding to `inner`'s commitment.\n121\t    pub(crate) traces: Vec<DeviceMatrix<F>>,\n122\t}\n123\t\n124\timpl<D> StackedPcsData2<D> {\n125\t    /// # Safety\n126\t    /// `traces` must be the traces that were committed to in `pcs_data`.\n127\t    pub unsafe fn from_raw(\n128\t        pcs_data: Arc<StackedPcsDataGpu<F, D>>,\n129\t        traces: Vec<DeviceMatrix<F>>,\n130\t    ) -> Self {\n131\t        Self {\n132\t            inner: pcs_data,\n133\t            traces,\n134\t        }\n135\t    }\n136\t\n137\t    pub fn layout(&self) -> &StackedLayout {\n138\t        &self.inner.layout\n139\t    }\n140\t}\n141\t\n142\t/// Pointer with length to location in a big device buffer. The device buffer is identified by\n143\t/// `commit_idx`. Due to pecuarlities with `l_skip`, the length of the slice is defined as\n144\t/// `max(2^log_height, 2^l_skip)`. In other words, this is a pointer to the slice\n145\t/// `q[commit_idx].column(stacked_col_idx)[stacked_row_idx..stacked_row_idx + len]`.\n146\t///\n147\t/// # Safety\n148\t/// - this type is `repr(C)` as it will cross FFI boundaries for CUDA usage.\n149\t#[repr(C)]\n150\t#[derive(Clone, Copy, Debug)]\n151\tpub(crate) struct UnstackedSlice {\n152\t    commit_idx: u32,\n153\t    log_height: u32,\n154\t    stacked_row_idx: u32,\n155\t    stacked_col_idx: u32,\n156\t}\n157\t\n158\timpl<D> StackedReductionGpu<D> {\n159\t    fn log_stacked_height(&self, round: usize) -> usize {\n160\t        self.n_stack - (round - 1)\n161\t    }\n162\t\n163\t    fn stacked_height(&self, round: usize) -> usize {\n164\t        1 << self.log_stacked_height(round)\n165\t    }\n166\t\n167\t    /// Current maximum `n` supported by eq_r_ns\n168\t    fn cur_max_n(&self, round: usize) -> usize {\n169\t        self.n_max - (round - 1)\n170\t    }\n171\t}\n172\t\n173\t/// Batch sumcheck to reduce trace openings, including rotations, to stacked matrix opening.\n174\t///\n175\t/// The `stacked_matrix, stacked_layout` should be the result of stacking the `traces` with\n176\t/// parameters `l_skip` and `n_stack`.\n177\t#[allow(clippy::type_complexity)]\n178\t#[instrument(\n179\t    name = \"prover.openings.stacked_reduction\",\n180\t    level = \"info\",\n181\t    skip_all,\n182\t    fields(phase = \"prover\")\n183\t)]\n184\tpub fn prove_stacked_opening_reduction_gpu<HS, TS>(\n185\t    device: &GpuDevice,\n186\t    transcript: &mut TS,\n187\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n188\t    ctx: ProvingContext<GenericGpuBackend<HS>>,\n189\t    common_main_pcs_data: StackedPcsDataGpu<F, HS::Digest>,\n190\t    r: &[EF],\n191\t) -> Result<\n192\t    (\n193\t        StackingProof<HS::SC>,\n194\t        Vec<EF>,\n195\t        Vec<StackedPcsData2<HS::Digest>>,\n196\t    ),\n197\t    StackedReductionError,\n198\t>\n199\twhere\n200\t    HS: GpuHashScheme,\n201\t    TS: GpuFiatShamirTranscript<HS::SC>,\n202\t{\n203\t    let n_stack = device.config.n_stack;\n204\t    // Batching randomness\n205\t    let lambda = transcript.sample_ext();\n206\t\n207\t    let _round0_span =\n208\t        info_span!(\"prover.openings.stacked_reduction.round0\", phase = \"prover\").entered();\n209\t    let mut prover = StackedReductionGpu::new::<HS>(\n210\t        mpk,\n211\t        ctx,\n212\t        common_main_pcs_data,\n213\t        r,\n214\t        lambda,\n215\t        device.sm_count(),\n216\t    )?;\n217\t\n218\t    // Round 0: univariate sumcheck\n219\t    let s_0 = prover.batch_sumcheck_uni_round0_poly()?;\n220\t    for &coeff in s_0.coeffs() {\n221\t        transcript.observe_ext(coeff);\n222\t    }\n223\t\n224\t    let mut u_vec = Vec::with_capacity(n_stack + 1);\n225\t    let u_0 = transcript.sample_ext();\n226\t    u_vec.push(u_0);\n227\t    debug!(round = 0, u_round = %u_0);\n228\t\n229\t    prover.fold_ple_evals(u_0)?;\n230\t    drop(_round0_span);\n231\t    // end round 0\n232\t\n233\t    let mut sumcheck_round_polys = Vec::with_capacity(n_stack);\n234\t\n235\t    // Rounds 1..=n_stack: MLE sumcheck\n236\t    let _mle_rounds_span = info_span!(\n237\t        \"prover.openings.stacked_reduction.mle_rounds\",\n238\t        phase = \"prover\"\n239\t    )\n240\t    .entered();\n241\t    #[allow(clippy::needless_range_loop)]\n242\t    for round in 1..=n_stack {\n243\t        let batch_s_evals = prover.batch_sumcheck_poly_eval(round, u_vec[round - 1])?;\n244\t\n245\t        for &eval in &batch_s_evals {\n246\t            transcript.observe_ext(eval);\n247\t        }\n248\t        sumcheck_round_polys.push(batch_s_evals);\n249\t\n250\t        let u_round = transcript.sample_ext();\n251\t        u_vec.push(u_round);\n252\t        debug!(%round, %u_round);\n253\t\n254\t        prover.fold_mle_evals(round, u_round)?;\n255\t    }\n256\t    let stacking_openings = prover.get_stacked_openings()?;\n257\t    for claims_for_com in &stacking_openings {\n258\t        for &claim in claims_for_com {\n259\t            transcript.observe_ext(claim);\n260\t        }\n261\t    }\n262\t    drop(_mle_rounds_span);\n263\t    let proof = StackingProof {\n264\t        univariate_round_coeffs: s_0.into_coeffs(),\n265\t        sumcheck_round_polys,\n266\t        stacking_openings,\n267\t    };\n268\t    Ok((proof, u_vec, prover.stacked_per_commit))\n269\t}\n270\t\n271\timpl<D: Copy + Clone + Send + Sync + 'static> StackedReductionGpu<D> {\n272\t    #[instrument(\"stacked_reduction_new\", level = \"debug\", skip_all)]\n273\t    fn new<HS: GpuHashScheme<Digest = D>>(\n274\t        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n275\t        ctx: ProvingContext<GenericGpuBackend<HS>>,\n276\t        common_main_pcs_data: StackedPcsDataGpu<F, D>,\n277\t        r: &[EF],\n278\t        lambda: EF,\n279\t        sm_count: u32,\n280\t    ) -> Result<Self, StackedReductionError> {\n281\t        ensure_device_ntt_twiddles_initialized();\n282\t        let mem = MemTracker::start(\"prover.stacked_reduction_new\");\n283\t        let l_skip = mpk.params.l_skip;\n284\t        let n_stack = mpk.params.n_stack;\n285\t\n286\t        let omega_skip = F::two_adic_generator(l_skip);\n287\t        let omega_skip_pows = omega_skip.powers().take(1 << l_skip).collect_vec();\n288\t        let d_omega_skip_pows = omega_skip_pows.to_device()?;\n289\t\n290\t        // NOTE: DeviceMatrix contains an Arc, so clone is lightweight [for now].\n291\t        // PERF[jpw]: stack the traces all at once. To save memory, we could either stack and drop\n292\t        // traces as we go or even at commit time only store the stacked matrix and drop the traces\n293\t        // much earlier.\n294\t        let common_main_traces = ctx\n295\t            .per_trace\n296\t            .iter()\n297\t            .map(|(_, air_ctx)| air_ctx.common_main.clone())\n298\t            .collect_vec();\n299\t        // SAFETY: common_main_traces commits to common_main_pcs_data\n300\t        let common_main_stacked = unsafe {\n301\t            StackedPcsData2::from_raw(Arc::new(common_main_pcs_data), common_main_traces)\n302\t        };\n303\t        let mut stacked_per_commit = vec![common_main_stacked];\n304\t        for (air_idx, air_ctx) in ctx.per_trace.iter() {\n305\t            for committed in mpk.per_air[*air_idx]\n306\t                .preprocessed_data\n307\t                .iter()\n308\t                .chain(air_ctx.cached_mains.iter())\n309\t            {\n310\t                // SAFETY: committed.trace commits to committed.data\n311\t                let stacked = unsafe {\n312\t                    StackedPcsData2::from_raw(committed.data.clone(), vec![committed.trace.clone()])\n313\t                };\n314\t                stacked_per_commit.push(stacked);\n315\t            }\n316\t        }\n317\t\n318\t        debug_assert!(stacked_per_commit\n319\t            .iter()\n320\t            .all(|d| d.layout().height() == 1 << (l_skip + n_stack)));\n321\t\n322\t        let need_rot_per_trace = ctx\n323\t            .per_trace\n324\t            .iter()\n325\t            .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n326\t            .collect_vec();\n327\t        let mut need_rot_per_commit = vec![need_rot_per_trace];\n328\t        for (air_idx, air_ctx) in ctx.per_trace.iter() {\n329\t            let need_rot = mpk.per_air[*air_idx].vk.params.need_rot;\n330\t            if mpk.per_air[*air_idx].preprocessed_data.is_some() {\n331\t                need_rot_per_commit.push(vec![need_rot]);\n332\t            }\n333\t            for _ in &air_ctx.cached_mains {\n334\t                need_rot_per_commit.push(vec![need_rot]);\n335\t            }\n336\t        }\n337\t        let q_widths = stacked_per_commit\n338\t            .iter()\n339\t            .map(|d| d.layout().width() as u32)\n340\t            .collect_vec();\n341\t        let q_width_max = *q_widths.iter().max().unwrap();\n342\t        let d_q_widths = q_widths.to_device()?;\n343\t\n344\t        let total_num_cols: usize = stacked_per_commit\n345\t            .iter()\n346\t            .map(|d| d.layout().sorted_cols.len())\n347\t            .sum();\n348\t        let mut unstacked_cols = Vec::with_capacity(total_num_cols);\n349\t        let mut need_rot_per_col = Vec::with_capacity(total_num_cols);\n350\t        let mut ht_diff_idxs = Vec::new();\n351\t        let mut trace_ptrs = Vec::new();\n352\t        for (commit_idx, stacked) in stacked_per_commit.iter().enumerate() {\n353\t            let layout = stacked.layout();\n354\t            let need_rot_for_commit = &need_rot_per_commit[commit_idx];\n355\t            debug_assert_eq!(need_rot_for_commit.len(), layout.mat_starts.len());\n356\t            for (mat_idx, (trace, &idx)) in zip_eq(&stacked.traces, &layout.mat_starts).enumerate()\n357\t            {\n358\t                debug_assert_ne!(trace.width(), 0);\n359\t                debug_assert_ne!(trace.height(), 0);\n360\t                ht_diff_idxs.push(unstacked_cols.len());\n361\t                trace_ptrs.push((trace.buffer().as_ptr(), trace.height(), trace.width()));\n362\t                let need_rot = need_rot_for_commit[mat_idx];\n363\t                for j in 0..trace.width() {\n364\t                    let (_, _j, s) = layout.sorted_cols[idx + j];\n365\t                    debug_assert_eq!(_j, j);\n366\t                    debug_assert_eq!(1 << s.log_height(), trace.height());\n367\t                    unstacked_cols.push(UnstackedSlice {\n368\t                        commit_idx: commit_idx as u32,\n369\t                        log_height: s.log_height() as u32,\n370\t                        stacked_row_idx: s.row_idx as u32,\n371\t                        stacked_col_idx: s.col_idx as u32,\n372\t                    });\n373\t                    need_rot_per_col.push(need_rot);\n374\t                }\n375\t            }\n376\t        }\n377\t        debug_assert_eq!(unstacked_cols.len(), total_num_cols);\n378\t        ht_diff_idxs.push(unstacked_cols.len());\n379\t\n380\t        let lambda_pows_used = lambda.powers().take(total_num_cols * 2).collect_vec();\n381\t        let mut lambda_pows = vec![EF::ZERO; total_num_cols * 2];\n382\t        for (col_idx, need_rot) in need_rot_per_col.into_iter().enumerate() {\n383\t            let lambda_eq_idx = 2 * col_idx;\n384\t            let lambda_rot_idx = 2 * col_idx + 1;\n385\t            lambda_pows[lambda_eq_idx] = lambda_pows_used[lambda_eq_idx];\n386\t            if need_rot {\n387\t                lambda_pows[lambda_rot_idx] = lambda_pows_used[lambda_rot_idx];\n388\t            }\n389\t        }\n390\t        let d_lambda_pows = lambda_pows.to_device()?;\n391\t\n392\t        let d_unstacked_cols = unstacked_cols.to_device()?;\n393\t        let max_window_len = ht_diff_idxs\n394\t            .windows(2)\n395\t            .map(|window| window[1] - window[0])\n396\t            .max()\n397\t            .unwrap_or(0);\n398\t\n399\t        // layout per commit is sorted, first height is largest\n400\t        let n_max = r.len() - 1;\n401\t        debug_assert_eq!(\n402\t            n_max,\n403\t            stacked_per_commit\n404\t                .iter()\n405\t                .map(|d| d.layout().sorted_cols[0].2.log_height())\n406\t                .max()\n407\t                .unwrap_or(0)\n408\t                .saturating_sub(l_skip)\n409\t        );\n410\t        let eq_r_ns =\n411\t            EqEvalSegments::new(&r[1..]).map_err(StackedReductionError::EqEvalSegments)?;\n412\t\n413\t        let eq_const = eval_eq_uni_at_one(l_skip, r[0] * omega_skip);\n414\t        let eq_ub_per_trace = vec![EF::ONE; unstacked_cols.len()];\n415\t        let d_q_eval_ptrs = if stacked_per_commit.is_empty() {\n416\t            DeviceBuffer::new()\n417\t        } else {\n418\t            DeviceBuffer::with_capacity(stacked_per_commit.len())\n419\t        };\n420\t        let d_input_ptrs = if stacked_per_commit.is_empty() {\n421\t            DeviceBuffer::new()\n422\t        } else {\n423\t            DeviceBuffer::with_capacity(stacked_per_commit.len())\n424\t        };\n425\t        let d_output_ptrs = if stacked_per_commit.is_empty() {\n426\t            DeviceBuffer::new()\n427\t        } else {\n428\t            DeviceBuffer::with_capacity(stacked_per_commit.len())\n429\t        };\n430\t        let d_accum = DeviceBuffer::<u64>::with_capacity(STACKED_REDUCTION_S_DEG * D_EF);\n431\t        let d_eq_ub = if max_window_len > 0 {\n432\t            DeviceBuffer::with_capacity(max_window_len)\n433\t        } else {\n434\t            DeviceBuffer::new()\n435\t        };\n436\t\n437\t        Ok(Self {\n438\t            sm_count,\n439\t            l_skip,\n440\t            n_stack,\n441\t            omega_skip,\n442\t            omega_skip_pows,\n443\t            d_omega_skip_pows,\n444\t            r_0: r[0],\n445\t            d_lambda_pows,\n446\t            eq_const,\n447\t            stacked_per_commit,\n448\t            d_q_widths,\n449\t            q_width_max,\n450\t            d_q_eval_ptrs,\n451\t            trace_ptrs,\n452\t            unstacked_cols,\n453\t            d_unstacked_cols,\n454\t            ht_diff_idxs,\n455\t            n_max,\n456\t            eq_r_ns,\n457\t            q_evals: vec![],\n458\t            eq_stable: vec![],\n459\t            k_rot_stable: vec![],\n460\t            // SAFETY: This is unused in round 0 and will be initialized properly after round 0.\n461\t            k_rot_ns: unsafe { EqEvalSegments::from_raw_parts(DeviceBuffer::new(), 0) },\n462\t            eq_ub_per_trace,\n463\t            d_eq_ub,\n464\t            d_block_sums: DeviceBuffer::new(),\n465\t            d_accum,\n466\t            d_input_ptrs,\n467\t            d_output_ptrs,\n468\t            mem,\n469\t        })\n470\t    }\n471\t\n472\t    /// SP_DEG=1 round 0: computes G0, G1, G2 on identity coset, then reconstructs s_0 on CPU.\n473\t    ///\n474\t    /// Key insight: Instead of computing s₀(Z) directly on 2 cosets with in-kernel NTT,\n475\t    /// we compute three partial sums G0, G1, G2 on the identity coset only, then\n476\t    /// reconstruct s₀ via CPU-side NTT-based polynomial multiplication.\n477\t    #[instrument(\n478\t        \"stacked_reduction_sumcheck\",\n479\t        level = \"debug\",\n480\t        skip_all,\n481\t        fields(round = 0)\n482\t    )]\n483\t    fn batch_sumcheck_uni_round0_poly(\n484\t        &mut self,\n485\t    ) -> Result<UnivariatePoly<EF>, StackedReductionError> {\n486\t        let l_skip = self.l_skip;\n487\t        let skip_domain = 1 << l_skip;\n488\t        let s_0_deg = sumcheck_round0_deg(l_skip, STACKED_REDUCTION_S_DEG);\n489\t\n490\t        // Accumulation buffers for G0, G1, G2 (on identity coset)\n491\t        // d_g_pos: for n >= 0 traces\n492\t        let mut d_g_pos = DeviceBuffer::<EF>::with_capacity(NUM_G * skip_domain);\n493\t        d_g_pos\n494\t            .fill_zero()\n495\t            .map_err(StackedReductionError::FillZero)?;\n496\t\n497\t        // d_g_neg[k]: for traces with |n| = k+1, where n < 0 and k in 0..l_skip\n498\t        let mut d_g_neg: Vec<DeviceBuffer<EF>> = (0..l_skip)\n499\t            .map(|_| {"}]},"parent_tool_use_id":"toolu_012AboZSK1JwAJAuCM1sMiKL","session_id":"9f2238e8-ef27-4ab7-979f-317ec3807970","uuid":"d1dff988-d066-4acb-9af3-d1d054e1b5dd","timestamp":"2026-04-10T17:26:23.915Z"}
