{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018niJggFWtab3WxK9UmXwNn","type":"tool_result","content":"1\tuse openvm_cuda_common::{\n2\t    copy::MemCopyD2H,\n3\t    d_buffer::DeviceBuffer,\n4\t    error::{check, CudaError},\n5\t};\n6\t\n7\tuse crate::{\n8\t    prelude::{D_EF, EF, F},\n9\t    KernelError,\n10\t};\n11\t\n12\textern \"C\" {\n13\t    fn _algebraic_batch_matrices(\n14\t        output: *mut EF,\n15\t        mats: *const *const F,\n16\t        mu_powers: *const EF,\n17\t        mu_idxs: *const u32,\n18\t        widths: *const u32,\n19\t        height: usize,\n20\t        num_mats: usize,\n21\t    ) -> i32;\n22\t\n23\t    fn _eq_hypercube_stage_ext(out: *mut EF, x_i: EF, step: u32) -> i32;\n24\t\n25\t    fn _mobius_eq_hypercube_stage_ext(out: *mut EF, omega_i: EF, step: u32) -> i32;\n26\t\n27\t    fn _eq_hypercube_nonoverlapping_stage_ext(\n28\t        out: *mut EF,\n29\t        input: *const EF,\n30\t        x_i: EF,\n31\t        step: u32,\n32\t    ) -> i32;\n33\t\n34\t    fn _eq_hypercube_interleaved_stage_ext(\n35\t        out: *mut EF,\n36\t        input: *const EF,\n37\t        x_i: EF,\n38\t        step: u32,\n39\t    ) -> i32;\n40\t\n41\t    // `x` must be **device** buffer\n42\t    fn _batch_eq_hypercube_stage(\n43\t        out: *mut F,\n44\t        x: *const F,\n45\t        step: u32,\n46\t        width: u32,\n47\t        height: u32,\n48\t    ) -> i32;\n49\t\n50\t    // `out` must be device ptr\n51\t    fn _eval_poly_ext_at_point(base_coeffs: *const F, coeff_len: usize, x: EF, out: *mut EF)\n52\t        -> i32;\n53\t\n54\t    fn _vector_scalar_multiply_ext(vec: *mut EF, scalar: EF, length: u32) -> i32;\n55\t\n56\t    fn _transpose_fp_to_fpext_vec(output: *mut EF, input: *const F, height: u32) -> i32;\n57\t}\n58\t\n59\t/// Computes the algebraic batch of the column vectors from input matrices `mats`, in order.\n60\t/// In other words, `output = sum_i sum_{j=0..widths[i]} mu_powers[mu_idx[i]] * mats[i][j]`.\n61\t///\n62\t/// # Safety\n63\t/// - `output` must have length `>= height`.\n64\t/// - `mats[i]` must have length `>= widths[i] * height` for all `i`.\n65\t/// - `mats`, `mu_idxs`, `widths` must have length `>= num_mats`.\n66\t/// - `mu_idxs[i] < mu_powers.len()` for all `i`.\n67\tpub unsafe fn algebraic_batch_matrices(\n68\t    output: &mut DeviceBuffer<EF>,\n69\t    mat_ptrs: &DeviceBuffer<*const F>,\n70\t    mu_powers: &DeviceBuffer<EF>,\n71\t    mu_idxs: &DeviceBuffer<u32>,\n72\t    widths: &DeviceBuffer<u32>,\n73\t    height: usize,\n74\t    num_mats: usize,\n75\t) -> Result<(), CudaError> {\n76\t    check(_algebraic_batch_matrices(\n77\t        output.as_mut_ptr(),\n78\t        mat_ptrs.as_ptr(),\n79\t        mu_powers.as_ptr(),\n80\t        mu_idxs.as_ptr(),\n81\t        widths.as_ptr(),\n82\t        height,\n83\t        num_mats,\n84\t    ))\n85\t}\n86\t\n87\t/// Performs an in-place update of:\n88\t/// ```text\n89\t/// out[i + step] = out[i] * x_i\n90\t/// out[i] = out[i] * (1 - x_i)\n91\t/// ```\n92\t/// for `i` in `0..step`.\n93\t///\n94\t/// # Safety\n95\t/// - `out` is **device** pointer with length `>= 2 * step`.\n96\tpub unsafe fn eq_hypercube_stage_ext(out: *mut EF, x_i: EF, step: u32) -> Result<(), CudaError> {\n97\t    check(_eq_hypercube_stage_ext(out, x_i, step))\n98\t}\n99\t\n100\t/// Performs an in-place update for the Möbius-adjusted equality kernel:\n101\t/// ```text\n102\t/// out[i + step] = out[i] * u_tilde_i\n103\t/// out[i] = out[i] * (1 - 2 * u_tilde_i)\n104\t/// ```\n105\t/// for `i` in `0..step`.\n106\t///\n107\t/// # Safety\n108\t/// - `out` is **device** pointer with length `>= 2 * step`.\n109\tpub unsafe fn mobius_eq_hypercube_stage_ext(\n110\t    out: *mut EF,\n111\t    omega_i: EF,\n112\t    step: u32,\n113\t) -> Result<(), CudaError> {\n114\t    check(_mobius_eq_hypercube_stage_ext(out, omega_i, step))\n115\t}\n116\t\n117\t/// Performs an update of:\n118\t/// ```text\n119\t/// out[i + step] = input[i] * x_i\n120\t/// out[i] = input[i] * (1 - x_i)\n121\t/// ```\n122\t/// for `i` in `0..step`.\n123\t///\n124\t/// # Safety\n125\t/// - `out` is **device** pointer with length `>= 2 * step`.\n126\t/// - `input` is **device** pointer with length `>= step`.\n127\t/// - It is expected that `out` and `input` do not overlap in device memory. This kernel should\n128\t///   still work properly if `out = input`, but in that case one should use [eq_hypercube_stage_ext]\n129\t///   instead.\n130\tpub unsafe fn eq_hypercube_nonoverlapping_stage_ext(\n131\t    out: *mut EF,\n132\t    input: *const EF,\n133\t    x_i: EF,\n134\t    step: u32,\n135\t) -> Result<(), CudaError> {\n136\t    check(_eq_hypercube_nonoverlapping_stage_ext(\n137\t        out, input, x_i, step,\n138\t    ))\n139\t}\n140\t\n141\t/// Same as [eq_hypercube_nonoverlapping_stage_ext] except `x_i` is inserted from the front.\n142\tpub unsafe fn eq_hypercube_interleaved_stage_ext(\n143\t    out: *mut EF,\n144\t    input: *const EF,\n145\t    x_i: EF,\n146\t    step: u32,\n147\t) -> Result<(), CudaError> {\n148\t    check(_eq_hypercube_interleaved_stage_ext(out, input, x_i, step))\n149\t}\n150\t\n151\t/// Same as `eq_hypercube_stage`, over base field, but computes `eq` evals in batch for multiple\n152\t/// `x_i`.\n153\t///\n154\t/// # Safety\n155\t/// - `out` must be column-major matrix with size `>= width * height` where `width = x.len()`.\n156\t/// - `step < height` is a power of two.\n157\tpub unsafe fn batch_eq_hypercube_stage(\n158\t    out: &mut DeviceBuffer<F>,\n159\t    x: &DeviceBuffer<F>,\n160\t    step: u32,\n161\t    height: u32,\n162\t) -> Result<(), CudaError> {\n163\t    let width = x.len() as u32;\n164\t    debug_assert!(step < height);\n165\t    debug_assert!(out.len() <= (width * height) as usize);\n166\t    check(_batch_eq_hypercube_stage(\n167\t        out.as_mut_ptr(),\n168\t        x.as_ptr(),\n169\t        step,\n170\t        width,\n171\t        height,\n172\t    ))\n173\t}\n174\t\n175\t/// Evaluates a `EF`-polynomial stored in coefficient form as column-major `F`-matrix at point `x`.\n176\t///\n177\t/// # Safety\n178\t/// - `base_coeffs` is in column-major form for the **base** field `F`.\n179\t/// - `base_coeffs.len() >= coeff_len * D_EF`, where `D_EF` is the degree of extension for `EF`.\n180\tpub unsafe fn eval_poly_ext_at_point_from_base(\n181\t    base_coeffs: &DeviceBuffer<F>,\n182\t    coeff_len: usize,\n183\t    x: EF,\n184\t) -> Result<EF, KernelError> {\n185\t    debug_assert!(base_coeffs.len() >= coeff_len * D_EF);\n186\t    let d_out = DeviceBuffer::<EF>::with_capacity(1);\n187\t    check(_eval_poly_ext_at_point(\n188\t        base_coeffs.as_ptr(),\n189\t        coeff_len,\n190\t        x,\n191\t        d_out.as_mut_ptr(),\n192\t    ))\n193\t    .map_err(KernelError::Kernel)?;\n194\t    let out = d_out.to_host().map_err(KernelError::MemCopy)?;\n195\t    Ok(out[0])\n196\t}\n197\t\n198\t/// Scalar multiplication of a vector in-place by `scalar.\n199\tpub fn vector_scalar_multiply_ext(vec: &mut DeviceBuffer<EF>, scalar: EF) -> Result<(), CudaError> {\n200\t    // SAFETY: `vec` is allocated for `vec.len()` so scalar multiplication is safe.\n201\t    unsafe {\n202\t        check(_vector_scalar_multiply_ext(\n203\t            vec.as_mut_ptr(),\n204\t            scalar,\n205\t            vec.len() as u32,\n206\t        ))\n207\t    }\n208\t}\n209\t\n210\t/// Transposes a `DeviceBuffer<F>` as a column-major `height x D_EF` matrix into a single\n211\t/// `DeviceBuffer<EF>` of length `height`.\n212\t///\n213\t/// # Safety\n214\t/// - `input.len() == output.len() * D_EF`.\n215\tpub unsafe fn transpose_fp_to_fpext_vec(\n216\t    output: &mut DeviceBuffer<EF>,\n217\t    input: &DeviceBuffer<F>,\n218\t) -> Result<(), CudaError> {\n219\t    let height = output.len();\n220\t    debug_assert_eq!(height * D_EF, input.len());\n221\t    check(_transpose_fp_to_fpext_vec(\n222\t        output.as_mut_ptr(),\n223\t        input.as_ptr(),\n224\t        height as u32,\n225\t    ))\n226\t}\n227\t"}]},"pare