49\t// Decimation in frequency NTT: natural order to bit reversed order.\n50\t//\n51\t// Uses exactly `2^l_skip` threads, and `this_thread_value` will be set with the output of the NTT.\n52\t// The input should be the evaluation at `omega^i`.\n53\t// - If `needs_shmem` is true, then `sbuf[i]` must already contain the input.\n54\t// - If `needs_shmem` is false, then `this_thread_value` must already contain the input.\n55\t//\n56\t// `active_thread` indicates whether this thread has valid data; inactive threads still participate in syncs.\n57\t//\n58\t// # Assumption\n59\t// - No warp has exited early before this call. We use the full `0xffffffff` mask.\n60\ttemplate <bool intt, bool needs_shmem>\n61\t__device__ __forceinline__ void ntt_natural_to_bitrev(\n62\t    Fp &this_thread_value,\n63\t    Fp *__restrict__ sbuf, // shared memory buffer for this thread's NTT (size 1 << l_skip)\n64\t    uint32_t const i,      // thread index within NTT [0, 1 << l_skip)\n65\t    uint32_t const l_skip, // log2 of NTT size\n66\t    bool const active_thread = true\n67\t) {\n68\t    uint32_t log_interwarp;\n69\t    if constexpr (needs_shmem) {\n70\t        log_interwarp = LOG_WARP_SIZE;\n71\t    } else {\n72\t        log_interwarp = l_skip;\n73\t    }\n74\t    // reverse index for iNTT to get the inverse twiddle\n75\t    uint32_t const twiddle_idx = intt ? (i ? (1 << l_skip) - i : 0) : i;\n76\t    Fp twiddle = get_twiddle(l_skip, twiddle_idx);\n77\t\n78\t    // Shared memory phase (for l_skip > LOG_WARP_SIZE)\n79\t    if constexpr (needs_shmem) {\n80\t        for (uint32_t log_len = l_skip; log_len-- > LOG_WARP_SIZE;) {\n81\t            if (active_thread) {\n82\t                uint32_t const len = 1u << log_len;\n83\t                if (!(i & len)) {\n84\t                    Fp const sum = sbuf[i];\n85\t                    Fp const diff = sbuf[i + len];\n86\t                    sbuf[i] = sum_or_semi_sum<intt>(sum + diff);\n87\t                    sbuf[i + len] = sum_or_semi_sum<intt>(