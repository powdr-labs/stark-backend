{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QP6WEQwJXygGWpngqEtBTE","type":"tool_result","content":"1\t#include \"device_ntt.cuh\"\n2\t#include \"fp.h\"\n3\t#include \"fpext.h\"\n4\t#include \"frac_ext.cuh\"\n5\t#include \"launcher.cuh\"\n6\t#include \"sumcheck.cuh\"\n7\t#include \"utils.cuh\"\n8\t#include <algorithm>\n9\t#include <cassert>\n10\t#include <cmath>\n11\t#include <cstddef>\n12\t#include <cstdint>\n13\t#include <cuda_runtime.h>\n14\t#include <utility>\n15\t#include <vector_types.h>\n16\t\n17\tusing namespace device_ntt;\n18\t\n19\tnamespace {\n20\t\n21\tconstexpr uint32_t MAX_GRID_DIM = 65535u;\n22\t// S_DEG=2 for MLE sumcheck rounds (kept for backward compatibility)\n23\tconstexpr int S_DEG = 2;\n24\t// Number of G outputs per z in round 0 (SP_DEG=1): G0, G1, G2\n25\tconstexpr int NUM_G = 3;\n26\t\n27\t} // namespace\n28\t\n29\tstruct UnstackedSlice {\n30\t    uint32_t commit_idx;\n31\t    uint32_t log_height;\n32\t    uint32_t stacked_row_idx;\n33\t    uint32_t stacked_col_idx;\n34\t};\n35\t\n36\tstruct UnstackedPleFoldPacket {\n37\t    const Fp *__restrict__ src;\n38\t    FpExt *__restrict__ dst;\n39\t    uint32_t height;\n40\t    uint32_t width;\n41\t};\n42\t\n43\t// Descriptor for batched degenerate MLE round kernel\n44\tstruct DegenMleDesc {\n45\t    uint32_t col_offset;    // = window[0], indexes into unstacked_cols, eq_ub, lambda_pows\n46\t    uint32_t window_len;    // = window[1] - window[0]\n47\t    FpExt eq_r;             // from eq_stable[log_height]\n48\t    FpExt k_rot_r;          // from k_rot_stable[log_height]\n49\t};\n50\t\n51\t// Descriptor for batched non-degenerate MLE round kernel\n52\tstruct NonDegenMleDesc {\n53\t    uint32_t col_offset;    // = window[0]\n54\t    uint32_t window_len;    // = window[1] - window[0]\n55\t    uint32_t num_y;         // = 1 << (log_height - l_skip - round)\n56\t    uint32_t stride;        // auto-tuned grid.y from existing heuristic\n57\t    uint32_t blocks_x;      // = ceil(num_y / 256)\n58\t};\n59\t\n60\t__device__ __forceinline__ FpExt get_eq_cube(const FpExt *eq_r_ns, uint32_t cube_size, uint32_t x) {\n61\t    return eq_r_ns[cube_size + x];\n62\t}\n63\t\n64\t__device__ __forceinline__ uint32_t rot_prev(uint32_t x_int, uint32_t cube_size) {\n65\t    return x_int == 0 ? cube_size - 1 : x_int - 1;\n66\t}\n67\t\n68\t__device__ __forceinline__ Fp eq1(Fp x, Fp y) { return Fp::one() - x - y + Fp(2) * x * y; }\n69\t\n70\t__device__ __forceinline__ Fp barycentric_interpolate_strided(\n71\t    const Fp *evals,\n72\t    uint32_t evals_len,\n73\t    uint32_t z,\n74\t    uint32_t expansion_factor,     // large_domain / skip_domain\n75\t    const Fp *inv_lagrange_denoms, // denoms specifically for z\n76\t    const Fp *omega_skip_pows,\n77\t    uint32_t skip_domain\n78\t) {\n79\t    Fp q = Fp::zero();\n80\t    uint32_t stride = evals_len >= skip_domain ? 1 : skip_domain / evals_len;\n81\t    if (z % expansion_factor == 0) {\n82\t        auto i = z / expansion_factor;\n83\t        if (i % stride == 0)\n84\t            q = evals[i / stride];\n85\t    } else {\n86\t        for (int idx = 0; idx < (skip_domain / stride); idx++) {\n87\t            q += evals[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n88\t        }\n89\t    }\n90\t    return q;\n91\t}\n92\t\n93\t// SP_DEG=1 kernel: compute 3 partial sums G0, G1, G2 on identity coset only.\n94\t// No iNTT/NTT operations - reconstruction happens on CPU via NTT-based polynomial multiplication.\n95\t//\n96\t// Each block covers a tile of z-values (threadIdx.x) and collaborates across threads\n97\t// to sum over x for a single column. Blocks stride over columns via gridDim.y.\n98\t//\n99\t// G0(Z) = Σ_{col,x} coeff_eq[col] * eq_cube(x) * q_{col,x}(Z)\n100\t// G1(Z) = Σ_{col,x} coeff_rot[col] * eq_cube(x) * q_{col,x}(Z)\n101\t// G2(Z) = Σ_{col,x} coeff_rot[col] * (eq_cube(rot_prev(x)) - eq_cube(x)) * q_{col,x}(Z)\n102\t//\n103\t// where coeff_eq[col] = lambda_pows[2*col], coeff_rot[col] = lambda_pows[2*col+1]\n104\t__global__ void stacked_reduction_round0_block_sum_kernel(\n105\t    const FpExt *__restrict__ eq_r_ns, // pointer to EqEvalSegments\n106\t    const Fp *__restrict__ trace_ptr,\n107\t    const FpExt *__restrict__ lambda_pows, // pointer to lambda_pows at window start\n108\t    FpExt *__restrict__ block_sums, // [gridDim.x * gridDim.y][NUM_G * skip_domain]\n109\t    uint32_t height,                // trace height\n110\t    uint32_t width,                 // trace width\n111\t    uint32_t l_skip,\n112\t    uint32_t skip_mask, // 2^l_skip - 1\n113\t    uint32_t num_x,     // 1 << n_lift\n114\t    uint32_t log_stride\n115\t) {\n116\t    extern __shared__ char smem[];\n117\t    // Use blockDim.x + 1 stride to avoid shared memory bank conflicts\n118\t    const uint32_t PADDED_X = blockDim.x + 1;\n119\t    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem); // FpExt[NUM_G][PADDED_X]\n120\t\n121\t    uint32_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n122\t    uint32_t z_idx = tidx & skip_mask;\n123\t    uint32_t x_int = tidx >> l_skip;\n124\t    uint32_t col_idx = blockIdx.y;\n125\t\n126\t    // Compute G weights (no z-dependent packets needed)\n127\t    FpExt eq_cube = get_eq_cube(eq_r_ns, num_x, x_int);\n128\t    FpExt eq_cube_rot_prev = get_eq_cube(eq_r_ns, num_x, rot_prev(x_int, num_x));\n129\t    FpExt k_rot_diff = eq_cube_rot_prev - eq_cube;\n130\t\n131\t    FpExt coeff_eq = lambda_pows[2 * col_idx];      // for G0\n132\t    FpExt coeff_rot = lambda_pows[2 * col_idx + 1]; // for G1, G2\n133\t\n134\t    FpExt w0 = coeff_eq * eq_cube;      // weight for G0\n135\t    FpExt w1 = coeff_rot * eq_cube;     // weight for G1\n136\t    FpExt w2 = coeff_rot * k_rot_diff;  // weight for G2\n137\t\n138\t    // Load trace value (identity coset only, no NTT needed)\n139\t    auto evals = trace_ptr + col_idx * height + (x_int << (l_skip - log_stride));\n140\t    auto stride_mask = (1u << log_stride) - 1;\n141\t    Fp q = (z_idx & stride_mask) == 0 ? evals[z_idx >> log_stride] : Fp::zero();\n142\t\n143\t    // Store 3 partial sums to shared memory\n144\t    shared_sum[0 * PADDED_X + threadIdx.x] = w0 * q;\n145\t    shared_sum[1 * PADDED_X + threadIdx.x] = w1 * q;\n146\t    shared_sum[2 * PADDED_X + threadIdx.x] = w2 * q;\n147\t\n148\t    __syncthreads();\n149\t\n150\t    // Reduction: only threads in first x-slice participate\n151\t    if ((threadIdx.x >> l_skip) == 0) {\n152\t        FpExt g0 = shared_sum[0 * PADDED_X + z_idx];\n153\t        FpExt g1 = shared_sum[1 * PADDED_X + z_idx];\n154\t        FpExt g2 = shared_sum[2 * PADDED_X + z_idx];\n155\t\n156\t        for (int lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n157\t            g0 += shared_sum[0 * PADDED_X + (lane << l_skip) + z_idx];\n158\t            g1 += shared_sum[1 * PADDED_X + (lane << l_skip) + z_idx];\n159\t            g2 += shared_sum[2 * PADDED_X + (lane << l_skip) + z_idx];\n160\t        }\n161\t\n162\t        // Output: 3 values per z_idx, stored contiguously\n163\t        uint32_t skip_domain = 1u << l_skip;\n164\t        FpExt *out_ptr =\n165\t            block_sums + (col_idx * gridDim.x + blockIdx.x) * (NUM_G * skip_domain);\n166\t        out_ptr[0 * skip_domain + z_idx] = g0;\n167\t        out_ptr[1 * skip_domain + z_idx] = g1;\n168\t        out_ptr[2 * skip_domain + z_idx] = g2;\n169\t    }\n170\t}\n171\t\n172\t// Single-trace kernel: each chunk of skip_domain threads handles one output cell\n173\t// Parallelizes barycentric interpolation across threads for better performance\n174\t// Grid: (num_row_blocks, trace_width) where blockIdx.y selects the column\n175\t__global__ void stacked_reduction_fold_ple_kernel(\n176\t    const Fp *__restrict__ src,\n177\t    FpExt *__restrict__ dst,\n178\t    const Fp *__restrict__ omega_skip_pows,\n179\t    const FpExt *__restrict__ inv_lagrange_denoms,\n180\t    uint32_t trace_height,\n181\t    uint32_t new_height,\n182\t    uint32_t skip_domain\n183\t) {\n184\t    extern __shared__ char smem_raw[];\n185\t    FpExt *smem = reinterpret_cast<FpExt *>(smem_raw);\n186\t\n187\t    uint32_t col_idx = blockIdx.y;\n188\t    uint32_t chunks_per_block = blockDim.x / skip_domain;\n189\t    uint32_t chunk_in_block = threadIdx.x / skip_domain;\n190\t    uint32_t tid_in_chunk = threadIdx.x % skip_domain;\n191\t    uint32_t row_idx = blockIdx.x * chunks_per_block + chunk_in_block;\n192\t\n193\t    // Cannot early-return: all threads must participate in chunk_reduce_sum (uses __syncthreads)\n194\t    bool const active_chunk = (row_idx < new_height);\n195\t\n196\t    // Barycentric interpolation: each thread handles exactly ONE term\n197\t    // (since src_len <= skip_domain, each thread contributes at most one term)\n198\t    FpExt local_val(Fp::zero());\n199\t    if (active_chunk) {\n200\t        uint32_t src_len = std::min(trace_height, skip_domain);\n201\t        uint32_t stride = skip_domain / src_len;\n202\t        const Fp *cell_src = src + col_idx * trace_height + row_idx * src_len;\n203\t\n204\t        if (tid_in_chunk < src_len) {\n205\t            uint32_t idx = tid_in_chunk;\n206\t            local_val =\n207\t                cell_src[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n208\t        }\n209\t    }\n210\t\n211\t    // Reduce within chunk using the helper from sumcheck.cuh\n212\t    // All threads must participate; inactive chunks contribute zero\n213\t    FpExt result =\n214\t        sumcheck::chunk_reduce_sum(local_val, smem, tid_in_chunk, skip_domain, chunk_in_block);\n215\t\n216\t    // No __syncthreads() needed: each chunk writes to a distinct dst location\n217\t    // and kernel exits immediately after this write\n218\t    if (active_chunk && tid_in_chunk == 0) {\n219\t        dst[col_idx * new_height + row_idx] = result;\n220\t    }\n221\t}\n222\t\n223\t// Triangular sweep\n224\t__global__ void initialize_k_rot_from_eq_segments_kernel(\n225\t    const FpExt *eq_r_ns,\n226\t    FpExt *k_rot_ns,\n227\t    FpExt k_rot_uni_0,\n228\t    FpExt k_rot_uni_1\n229\t) {\n230\t    uint32_t x = blockIdx.x * blockDim.x + threadIdx.x;\n231\t    uint32_t n = blockIdx.y;\n232\t    uint32_t num_x = 1 << n;\n233\t\n234\t    if (x >= num_x)\n235\t        return;\n236\t\n237\t    auto eq_cube = get_eq_cube(eq_r_ns, num_x, x);\n238\t    auto k_rot_cube = get_eq_cube(eq_r_ns, num_x, rot_prev(x, num_x));\n239\t\n240\t    k_rot_ns[num_x + x] = k_rot_uni_0 * eq_cube + k_rot_uni_1 * (k_rot_cube - eq_cube);\n241\t}\n242\t\n243\t// Assumes we are not in degenerate case, in particular n = n_lift > 0\n244\t// Uses warp-aggregated atomics for reduction - no shared memory or __syncthreads() needed.\n245\t__global__ void stacked_reduction_sumcheck_mle_round_kernel(\n246\t    const FpExt *__restrict__ const\n247\t        *__restrict__ q_evals,          // pointers to matrices of same height, one per [commit_idx]\n248\t    const FpExt *__restrict__ eq_r_ns,  // pointer to EqEvalSegments\n249\t    const FpExt *__restrict__ k_rot_ns, // pointer to `k_rot` segments\n250\t    const UnstackedSlice *__restrict__ unstacked_cols, // pointer to unstacked_cols at window start\n251\t    const FpExt *__restrict__ lambda_pows,             // pointer to lambda_pows at window start\n252\t    uint64_t *__restrict__ output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n253\t    uint32_t q_height,             // height of each matrix in q_evals\n254\t    uint32_t window_len,\n255\t    uint32_t num_y\n256\t) {\n257\t    extern __shared__ char smem[];\n258\t    FpExt *shared = (FpExt *)smem;\n259\t    // Map phase: compute local sum by striding over window\n260\t    FpExt local_sums[S_DEG];\n261\t// Initialize accumulators\n262\t#pragma unroll\n263\t    for (int i = 0; i < S_DEG; i++) {\n264\t        local_sums[i] = FpExt(0);\n265\t    }\n266\t\n267\t    uint32_t window_idx_base = blockIdx.y;\n268\t    uint32_t y_int = blockIdx.x * blockDim.x + threadIdx.x;\n269\t    bool const active_thread = (y_int < num_y);\n270\t\n271\t    if (active_thread) {\n272\t        uint32_t num_evals = num_y * 2;\n273\t\n274\t        auto eq_0 = get_eq_cube(eq_r_ns, num_evals, y_int << 1);\n275\t        auto eq_1 = get_eq_cube(eq_r_ns, num_evals, (y_int << 1) | 1);\n276\t        auto eq_c1 = eq_1 - eq_0;\n277\t        auto k_rot_0 = get_eq_cube(k_rot_ns, num_evals, y_int << 1);\n278\t        auto k_rot_1 = get_eq_cube(k_rot_ns, num_evals, (y_int << 1) | 1);\n279\t        auto k_rot_c1 = k_rot_1 - k_rot_0;\n280\t\n281\t        // We sum over window at a stride, where stride = gridDim.y is tuned based on compute / memory\n282\t        // Currently assumes blockDim.y = 1\n283\t        for (uint32_t window_idx = window_idx_base; window_idx < window_len;\n284\t             window_idx += gridDim.y) {\n285\t            UnstackedSlice s = unstacked_cols[window_idx];\n286\t            const FpExt *__restrict__ q = q_evals[s.commit_idx];\n287\t\n288\t            auto log_height = s.log_height;\n289\t            auto col_idx = s.stacked_col_idx;\n290\t            auto row_start = (s.stacked_row_idx >> log_height) * num_evals;\n291\t            auto q_offset = col_idx * q_height + row_start;\n292\t\n293\t            auto q_0 = q[q_offset + (y_int << 1)];\n294\t            auto q_1 = q[q_offset + (y_int << 1) + 1];\n295\t            auto q_c1 = q_1 - q_0;\n296\t\n297\t#pragma unroll\n298\t            for (int x_int = 1; x_int <= S_DEG; ++x_int) {\n299\t                Fp x = Fp(x_int);\n300\t                auto q_x = q_0 + q_c1 * x;\n301\t                auto eq = eq_0 + eq_c1 * x;\n302\t                auto k_rot = k_rot_0 + k_rot_c1 * x;\n303\t\n304\t                local_sums[x_int - 1] +=\n305\t                    (lambda_pows[2 * window_idx] * eq + lambda_pows[2 * window_idx + 1] * k_rot) *\n306\t                    q_x;\n307\t            }\n308\t        }\n309\t    }\n310\t\n311\t#pragma unroll\n312\t    for (int idx = 0; idx < S_DEG; idx++) {\n313\t        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n314\t        if (threadIdx.x == 0) {\n315\t            sumcheck::atomic_add_fpext_to_u64(output + idx * 4, reduced);\n316\t        }\n317\t        __syncthreads();\n318\t    }\n319\t}\n320\t\n321\t// Degenerate case\n322\t// Uses warp-aggregated atomics for reduction - no shared memory or __syncthreads() needed.\n323\t__global__ void stacked_reduction_sumcheck_mle_round_degenerate_kernel(\n324\t    const FpExt *__restrict__ const\n325\t        *__restrict__ q_evals, // pointers to matrices of same height, one per [commit_idx]\n326\t    const FpExt *__restrict__ eq_ub_ptr, // pointer to `eq_ub_per_trace` at window start\n327\t    FpExt eq_r,                          // pointer to EqEvalSegments\n328\t    FpExt k_rot_r,                       // pointer to `k_rot` segments\n329\t    const UnstackedSlice *__restrict__ unstacked_cols, // pointer to unstacked_cols at window start\n330\t    const FpExt *__restrict__ lambda_pows,             // pointer to lambda_pows at window start\n331\t    uint64_t *__restrict__ output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n332\t    uint32_t q_height,             // height of each matrix in q_evals\n333\t    uint32_t window_len,\n334\t    uint32_t shift_factor // = l_skip + round\n335\t) {\n336\t    extern __shared__ char smem[];\n337\t    FpExt *shared = (FpExt *)smem;\n338\t\n339\t    FpExt local_sums[S_DEG];\n340\t#pragma unroll\n341\t    for (int i = 0; i < S_DEG; i++) {\n342\t        local_sums[i] = FpExt(0);\n343\t    }\n344\t\n345\t    for (uint32_t window_idx = threadIdx.x; window_idx < window_len; window_idx += blockDim.x) {\n346\t        UnstackedSlice s = unstacked_cols[window_idx];\n347\t        const FpExt *__restrict__ q = q_evals[s.commit_idx];\n348\t\n349\t        auto col_idx = s.stacked_col_idx;\n350\t        auto row_idx = s.stacked_row_idx;\n351\t        auto row_start = (row_idx >> shift_factor) << 1;\n352\t        auto q_offset = col_idx * q_height + row_start;\n353\t\n354\t        auto q_0 = q[q_offset];\n355\t        auto q_1 = q[q_offset + 1];\n356\t        auto q_c1 = q_1 - q_0;\n357\t\n358\t        uint32_t b_bool = (row_idx >> (shift_factor - 1)) & 1;\n359\t        Fp b = Fp(b_bool);\n360\t\n361\t        auto eq_ub = eq_ub_ptr[window_idx];\n362\t\n363\t#pragma unroll\n364\t        for (int x_int = 1; x_int <= S_DEG; ++x_int) {\n365\t            Fp x = Fp(x_int);\n366\t            auto eq_ub_x = eq_ub * eq1(x, b);\n367\t            auto eq = eq_r * eq_ub_x;\n368\t            auto k_rot = k_rot_r * eq_ub_x;\n369\t\n370\t            auto q_x = q_0 + q_c1 * x;\n371\t\n372\t            local_sums[x_int - 1] +=\n373\t                (lambda_pows[2 * window_idx] * eq + lambda_pows[2 * window_idx + 1] * k_rot) * q_x;\n374\t        }\n375\t    }\n376\t\n377\t#pragma unroll\n378\t    for (int idx = 0; idx < S_DEG; idx++) {\n379\t        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n380\t        if (threadIdx.x == 0) {\n381\t            sumcheck::atomic_add_fpext_to_u64(output + idx * 4, reduced);\n382\t        }\n383\t        __syncthreads();\n384\t    }\n385\t}\n386\t\n387\t// Batched degenerate MLE round kernel: one block per descriptor (one AIR each).\n388\t// Grid: (num_descs, 1), Block: (256, 1)\n389\t__global__ void batched_degenerate_mle_round_kernel(\n390\t    const DegenMleDesc *__restrict__ descs,\n391\t    const FpExt *__restrict__ const *__restrict__ q_evals,\n392\t    const FpExt *__restrict__ eq_ub_base,\n393\t    const UnstackedSlice *__restrict__ unstacked_cols_base,\n394\t    const FpExt *__restrict__ lambda_pows_base,\n395\t    uint64_t *__restrict__ output,\n396\t    uint32_t q_height,\n397\t    uint32_t shift_factor\n398\t) {\n399\t    extern __shared__ char smem[];\n400\t    FpExt *shared = (FpExt *)smem;\n401\t\n402\t    const DegenMleDesc desc = descs[blockIdx.x];\n403\t    const FpExt *eq_ub_ptr = eq_ub_base + desc.col_offset;\n404\t    const UnstackedSlice *unstacked_cols = unstacked_cols_base + desc.col_offset;\n405\t    const FpExt *lambda_pows = lambda_pows_base + 2 * desc.col_offset;\n406\t    FpExt eq_r = desc.eq_r;\n407\t    FpExt k_rot_r = desc.k_rot_r;\n408\t    uint32_t window_len = desc.window_len;\n409\t\n410\t    FpExt local_sums[S_DEG];\n411\t#pragma unroll\n412\t    for (int i = 0; i < S_DEG; i++) {\n413\t        local_sums[i] = FpExt(0);\n414\t    }\n415\t\n416\t    for (uint32_t window_idx = threadIdx.x; window_idx < window_len; window_idx += blockDim.x) {\n417\t        UnstackedSlice s = unstacked_cols[window_idx];\n418\t        const FpExt *__restrict__ q = q_evals[s.commit_idx];\n419\t\n420\t        auto col_idx = s.stacked_col_idx;\n421\t        auto row_idx = s.stacked_row_idx;\n422\t        auto row_start = (row_idx >> shift_factor) << 1;\n423\t        auto q_offset = col_idx * q_height + row_start;\n424\t\n425\t        auto q_0 = q[q_offset];\n426\t        auto q_1 = q[q_offset + 1];\n427\t        auto q_c1 = q_1 - q_0;\n428\t\n429\t        uint32_t b_bool = (row_idx >> (shift_factor - 1)) & 1;\n430\t        Fp b = Fp(b_bool);\n431\t\n432\t        auto eq_ub = eq_ub_ptr[window_idx];\n433\t\n434\t#pragma unroll\n435\t        for (int x_int = 1; x_int <= S_DEG; ++x_int) {\n436\t            Fp x = Fp(x_int);\n437\t            auto eq_ub_x = eq_ub * eq1(x, b);\n438\t            auto eq = eq_r * eq_ub_x;\n439\t            auto k_rot = k_rot_r * eq_ub_x;\n440\t\n441\t            auto q_x = q_0 + q_c1 * x;\n442\t\n443\t            local_sums[x_int - 1] +=\n444\t                (lambda_pows[2 * window_idx] * eq + lambda_pows[2 * window_idx + 1] * k_rot) * q_x;\n445\t        }\n446\t    }\n447\t\n448\t#pragma unroll\n449\t    for (int idx = 0; idx < S_DEG; idx++) {\n450\t        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n451\t        if (threadIdx.x == 0) {\n452\t            sumcheck::atomic_add_fpext_to_u64(output + idx * 4, reduced);\n453\t        }\n454\t        __syncthreads();\n455\t    }\n456\t}\n457\t\n458\t// Batched non-degenerate MLE round kernel: blocks are mapped to AIRs via prefix sum.\n459\t// Grid: (total_blocks, 1), Block: (256, 1)\n460\t__global__ void batched_nondegen_mle_round_kernel(\n461\t    const NonDegenMleDesc *__restrict__ descs,\n462\t    const uint32_t *__restrict__ block_prefix_sums,\n463\t    uint32_t num_descs,\n464\t    const FpExt *__restrict__ const *__restrict__ q_evals,\n465\t    const FpExt *__restrict__ eq_r_ns,\n466\t    const FpExt *__restrict__ k_rot_ns,\n467\t    const UnstackedSlice *__restrict__ unstacked_cols_base,\n468\t    const FpExt *__restrict__ lambda_pows_base,\n469\t    uint64_t *__restrict__ output,\n470\t    uint32_t q_height\n471\t) {\n472\t    extern __shared__ char smem[];\n473\t    FpExt *shared = (FpExt *)smem;\n474\t\n475\t    // Binary search to find which AIR this block belongs to\n476\t    uint32_t global_block = blockIdx.x;\n477\t    uint32_t lo = 0, hi = num_descs;\n478\t    while (lo < hi) {\n479\t        uint32_t mid = (lo + hi) / 2;\n480\t        if (block_prefix_sums[mid] <= global_block) {\n481\t            lo = mid + 1;\n482\t        } else {\n483\t            hi = mid;\n484\t        }\n485\t    }\n486\t    uint32_t air_idx = lo - 1;\n487\t\n488\t    const NonDegenMleDesc desc = descs[air_idx];\n489\t    uint32_t local_block = global_block - block_prefix_sums[air_idx];\n490\t\n491\t    // Decompose into y-block and stride-block\n492\t    uint32_t y_block = local_block % desc.blocks_x;\n493\t    uint32_t stride_block = local_block / desc.blocks_x;\n494\t\n495\t    const UnstackedSlice *unstacked_cols = unstacked_cols_base + desc.col_offset;\n496\t    const FpExt *lambda_pows = lambda_pows_base + 2 * desc.col_offset;\n497\t    uint32_t num_y = desc.num_y;\n498\t    uint32_t window_len = desc.window_len;\n499\t\n500\t    FpExt local_sums[S_DEG];\n501\t#pragma unroll\n502\t    for (int i = 0; i < S_DEG; i++) {\n503\t        local_sums[i] = FpExt(0);\n504\t    }\n505\t\n506\t    uint32_t y_int = y_block * blockDim.x + threadIdx.x;\n507\t    bool const active_thread = (y_int < num_y);\n508\t\n509\t    if (active_thread) {\n510\t        uint32_t num_evals = num_y * 2;\n511\t\n512\t        auto eq_0 = get_eq_cube(eq_r_ns, num_evals, y_int << 1);\n513\t        auto eq_1 = get_eq_cube(eq_r_ns, num_evals, (y_int << 1) | 1);\n514\t        auto eq_c1 = eq_1 - eq_0;\n515\t        auto k_rot_0 = get_eq_cube(k_rot_ns, num_evals, y_int << 1);\n516\t        auto k_rot_1 = get_eq_cube(k_rot_ns, num_evals, (y_int << 1) | 1);\n517\t        auto k_rot_c1 = k_rot_1 - k_rot_0;\n518\t\n519\t        uint32_t window_idx_base = stride_block;\n520\t        for (uint32_t window_idx = window_idx_base; window_idx < window_len;\n521\t             window_idx += desc.stride) {\n522\t            UnstackedSlice s = unstacked_cols[window_idx];\n523\t            const FpExt *__restrict__ q = q_evals[s.commit_idx];\n524\t\n525\t            auto log_height = s.log_height;\n526\t            auto col_idx = s.stacked_col_idx;\n527\t            auto row_start = (s.stacked_row_idx >> log_height) * num_evals;\n528\t            auto q_offset = col_idx * q_height + row_start;\n529\t\n530\t            auto q_0 = q[q_offset + (y_int << 1)];\n531\t            auto q_1 = q[q_offset + (y_int << 1) + 1];\n532\t            auto q_c1 = q_1 - q_0;\n533\t\n534\t#pragma unroll\n535\t            for (int x_int = 1; x_int <= S_DEG; ++x_int) {\n536\t                Fp x = Fp(x_int);\n537\t                auto q_x = q_0 + q_c1 * x;\n538\t                auto eq = eq_0 + eq_c1 * x;\n539\t                auto k_rot = k_rot_0 + k_rot_c1 * x;\n540\t\n541\t                local_sums[x_int - 1] +=\n542\t                    (lambda_pows[2 * window_idx] * eq + lambda_pows[2 * window_idx + 1] * k_rot) *\n543\t                    q_x;\n544\t            }\n545\t        }\n546\t    }\n547\t\n548\t#pragma unroll\n549\t    for (int idx = 0; idx < S_DEG; idx++) {\n550\t        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n551\t        if (threadIdx.x == 0) {\n552\t            sumcheck::atomic_add_fpext_to_u64(output + idx * 4, reduced);\n553\t        }\n554\t        __syncthreads();\n555\t    }\n556\t}\n557\t\n558\t// ============================================================================\n559\t// LAUNCHERS\n560\t// ============================================================================\n561\t\n562\tinline std::pair<dim3, dim3> stacked_reduction_round0_launch_params(\n563\t    uint32_t trace_height,\n564\t    uint32_t trace_width,\n565\t    uint32_t l_skip\n566\t) {\n567\t    uint32_t skip_domain = 1u << l_skip;\n568\t    auto lifted_height = std::max(trace_height, skip_domain);\n569\t    // Entire skip domain must fit within a block\n570\t    auto max_threads = std::max(skip_domain, 256u);\n571\t    auto [grid, block] = kernel_launch_params(lifted_height, max_threads);\n572\t    // NOTE: lifted_height = skip_domain * num_x will always be divisible by block.x since num_x is a power of 2. Therefore all threads in a block will be active.\n573\t    grid.y = trace_width;\n574\t    return {grid, block};\n575\t}\n576\t\n577\t// (Not a launcher) Utility function to calculate required size of temp buffer.\n578\t// Required length of *block_sums in FpExt elements\n579\t// SP_DEG=1: outputs NUM_G=3 values per z (G0, G1, G2)\n580\textern \"C\" uint32_t _stacked_reduction_r0_required_temp_buffer_size(\n581\t    uint32_t trace_height,\n582\t    uint32_t trace_width,\n583\t    uint32_t l_skip\n584\t) {\n585\t    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n586\t    return ((grid.x * grid.y) << l_skip) * NUM_G;\n587\t}\n588\t\n589\t// SP_DEG=1: No z_packets needed, outputs G0, G1, G2 on identity coset only.\n590\t// Uses ADD_TO_OUTPUT=true to accumulate into output buffer (for bucket-based accumulation).\n591\textern \"C\" int _stacked_reduction_sumcheck_round0(\n592\t    const FpExt *eq_r_ns,\n593\t    const Fp *trace_ptr,\n594\t    const FpExt *lambda_pows,\n595\t    FpExt *block_sums,\n596\t    FpExt *output, // length should be NUM_G * skip_domain, ADD to existing values\n597\t    uint32_t trace_height,\n598\t    uint32_t trace_width,\n599\t    uint32_t l_skip,\n600\t    uint32_t num_x\n601\t) {\n602\t    uint32_t skip_domain = 1u << l_skip;\n603\t    uint32_t stride = std::max(skip_domain / trace_height, 1u);\n604\t    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n605\t\n606\t    // Use block.x + 1 stride for shared_sum to avoid bank conflicts\n607\t    // NUM_G=3 outputs per z (G0, G1, G2)\n608\t    size_t shmem_sum_size = sizeof(FpExt) * (block.x + 1) * NUM_G;\n609\t\n610\t    stacked_reduction_round0_block_sum_kernel<<<grid, block, shmem_sum_size>>>(\n611\t        eq_r_ns, trace_ptr, lambda_pows, block_sums,\n612\t        trace_height, trace_width, l_skip,\n613\t        skip_domain - 1, num_x, 31 - __builtin_clz(stride)\n614\t    );\n615\t\n616\t    int err = CHECK_KERNEL();\n617\t    if (err != 0)\n618\t        return err;\n619\t\n620\t    // Launch final reduction kernel - reads from block_sums, ADDs to output\n621\t    auto num_blocks = grid.x * grid.y;\n622\t    auto output_size = NUM_G * skip_domain;\n623\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n624\t    size_t reduce_shmem = div_ceil(reduce_block.x, WARP_SIZE) * sizeof(FpExt);\n625\t    sumcheck::final_reduce_block_sums<true>\n626\t        <<<output_size, reduce_block, reduce_shmem>>>(block_sums, output, num_blocks);\n627\t\n628\t    return CHECK_KERNEL();\n629\t}\n630\t\n631\t// Parallelizes barycentric interpolation across 2^l_skip threads per output cell\n632\textern \"C\" int _stacked_reduction_fold_ple(\n633\t    const Fp *src,\n634\t    FpExt *dst,\n635\t    const Fp *omega_skip_pows,\n636\t    const FpExt *inv_lagrange_denoms,\n637\t    uint32_t trace_height,\n638\t    uint32_t trace_width,\n639\t    uint32_t l_skip\n640\t) {\n641\t    uint32_t skip_domain = 1u << l_skip;\n642\t    uint32_t new_height = std::max(trace_height, skip_domain) / skip_domain;\n643\t\n644\t    // Block size: at least skip_domain, prefer 256 for occupancy\n645\t    uint32_t block_size = std::max(256u, skip_domain);\n646\t    uint32_t chunks_per_block = block_size / skip_domain;\n647\t\n648\t    // 2D grid: x-dim for rows, y-dim for columns\n649\t    dim3 grid(div_ceil(new_height, chunks_per_block), trace_width);\n650\t    dim3 block(block_size);\n651\t\n652\t    // Shared memory for cross-warp reduction (needed when skip_domain > 32)\n653\t    // Each warp in the block needs one FpExt slot for cross-warp reduction\n654\t    uint32_t total_warps_in_block = block_size / WARP_SIZE;\n655\t    size_t smem_bytes = (skip_domain > WARP_SIZE) ? total_warps_in_block * sizeof(FpExt) : 0;\n656\t\n657\t    stacked_reduction_fold_ple_kernel<<<grid, block, smem_bytes>>>(\n658\t        src, dst, omega_skip_pows, inv_lagrange_denoms, trace_height, new_height, skip_domain\n659\t    );\n660\t\n661\t    return CHECK_KERNEL();\n662\t}\n663\t\n664\textern \"C\" int _initialize_k_rot_from_eq_segments(\n665\t    const FpExt *eq_r_ns,\n666\t    FpExt *k_rot_ns,\n667\t    FpExt k_rot_uni_0,\n668\t    FpExt k_rot_uni_1,\n669\t    uint32_t max_n\n670\t) {\n671\t    auto [grid, block] = kernel_launch_params(1 << max_n);\n672\t    grid.y = max_n + 1;\n673\t\n674\t    initialize_k_rot_from_eq_segments_kernel<<<grid, block>>>(\n675\t        eq_r_ns, k_rot_ns, k_rot_uni_0, k_rot_uni_1\n676\t    );\n677\t\n678\t    return CHECK_KERNEL();\n679\t}\n680\t\n681\textern \"C\" int _stacked_reduction_sumcheck_mle_round(\n682\t    const FpExt *const *q_evals,\n683\t    const FpExt *eq_r_ns,\n684\t    const FpExt *k_rot_ns,\n685\t    const UnstackedSlice *unstacked_cols,\n686\t    const FpExt *lambda_pows,\n687\t    uint64_t *output, // [S_DEG * D_EF] - atomic accumulator, reduced on CPU\n688\t    uint32_t q_height,\n689\t    uint32_t window_len,\n690\t    uint32_t num_y,\n691\t    uint32_t sm_count\n692\t) {\n693\t    // Smaller block size for more eligible warps to hide latency\n694\t    auto [grid, block] = kernel_launch_params(num_y, 256);\n695\t    assert(sm_count);\n696\t\n697\t    // Heuristic auto-tuning for window-stride (grid.y):\n698\t    // - Increase work per thread (reduce atomics) by targeting multiple window iterations/thread\n699\t    // - Ensure enough total blocks to keep SMs busy when num_y is small\n700\t    constexpr uint32_t WAVES_TARGET = 4; // blocks/SM target\n701\t    constexpr uint32_t ITERS_MIN = 4;    // prefer >= this many window iterations/thread\n702\t    constexpr uint32_t ITERS_MAX = 16;   // prefer <= this many window iterations/thread\n703\t\n704\t    uint32_t stride_occ = div_ceil(sm_count * WAVES_TARGET, grid.x);\n705\t    uint32_t stride_loop_lo = div_ceil(window_len, ITERS_MAX);\n706\t    uint32_t stride_loop_hi = div_ceil(window_len, ITERS_MIN);\n707\t\n708\t    uint32_t lo = std::max(1u, std::max(stride_occ, stride_loop_lo));\n709\t    uint32_t hi = std::min(std::min(window_len, MAX_GRID_DIM), stride_loop_hi);\n710\t\n711\t    uint32_t tuned_stride = (lo <= hi) ? lo : std::min(lo, std::min(window_len, MAX_GRID_DIM));\n712\t    grid.y = tuned_stride;\n713\t\n714\t    // Ensure that atomic add does not overflow u64\n715\t    assert((size_t)num_y * grid.y < (size_t)1u << 32);\n716\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n717\t\n718\t    stacked_reduction_sumcheck_mle_round_kernel<<<grid, block, shmem_bytes>>>(\n719\t        q_evals, eq_r_ns, k_rot_ns, unstacked_cols, lambda_pows, output, q_height, window_len, num_y\n720\t    );\n721\t\n722\t    return CHECK_KERNEL();\n723\t}\n724\t\n725\textern \"C\" int _stacked_reduction_sumcheck_mle_round_degenerate(\n726\t    const FpExt *const *q_evals,\n727\t    const FpExt *eq_ub_ptr,\n728\t    FpExt eq_r,\n729\t    FpExt k_rot_r,\n730\t    const UnstackedSlice *unstacked_cols,\n731\t    const FpExt *lambda_pows,\n732\t    uint64_t *output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n733\t    uint32_t q_height,\n734\t    uint32_t window_len,\n735\t    uint32_t l_skip,\n736\t    uint32_t round\n737\t) {\n738\t    auto shift_factor = l_skip + round;\n739\t    dim3 block(std::min(window_len, 256u));\n740\t    dim3 grid(1);\n741\t    // block.x <= 512 < 2^32 so atomic u64 will not overflow\n742\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n743\t\n744\t    stacked_reduction_sumcheck_mle_round_degenerate_kernel<<<grid, block, shmem_bytes>>>(\n745\t        q_evals,\n746\t        eq_ub_ptr,\n747\t        eq_r,\n748\t        k_rot_r,\n749\t        unstacked_cols,\n750\t        lambda_pows,\n751\t        output,\n752\t        q_height,\n753\t        window_len,\n754\t        shift_factor\n755\t    );\n756\t\n757\t    return CHECK_KERNEL();\n758\t}\n759\t\n760\textern \"C\" int _batched_stacked_reduction_sumcheck_mle_round_degenerate(\n761\t    const DegenMleDesc *descs,\n762\t    uint32_t num_descs,\n763\t    const FpExt *const *q_evals,\n764\t    const FpExt *eq_ub_base,\n765\t    const UnstackedSlice *unstacked_cols_base,\n766\t    const FpExt *lambda_pows_base,\n767\t    uint64_t *output,\n768\t    uint32_t q_height,\n769\t    uint32_t shift_factor\n770\t) {\n771\t    if (num_descs == 0) return 0;\n772\t    dim3 grid(num_descs);\n773\t    dim3 block(256);\n774\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n775\t\n776\t    batched_degenerate_mle_round_kernel<<<grid, block, shmem_bytes>>>(\n777\t        descs, q_evals, eq_ub_base, unstacked_cols_base, lambda_pows_base,\n778\t        output, q_height, shift_factor\n779\t    );\n780\t\n781\t    return CHECK_KERNEL();\n782\t}\n783\t\n784\textern \"C\" int _batched_stacked_reduction_sumcheck_mle_round(\n785\t    const NonDegenMleDesc *descs,\n786\t    const uint32_t *block_prefix_sums,\n787\t    uint32_t num_descs,\n788\t    uint32_t total_blocks,\n789\t    const FpExt *const *q_evals,\n790\t    const FpExt *eq_r_ns,\n791\t    const FpExt *k_rot_ns,\n792\t    const UnstackedSlice *unstacked_cols_base,\n793\t    const FpExt *lambda_pows_base,\n794\t    uint64_t *output,\n795\t    uint32_t q_height\n796\t) {\n797\t    if (total_blocks == 0) return 0;\n798\t    dim3 grid(total_blocks);\n799\t    dim3 block(256);\n800\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n801\t\n802\t    batched_nondegen_mle_round_kernel<<<grid, block, shmem_bytes>>>(\n803\t        descs, block_prefix_sums, num_descs,\n804\t        q_evals, eq_r_ns, k_rot_ns, unstacked_cols_base, lambda_pows_base,\n805\t        output, q_height\n806\t    );\n807\t\n808\t    return CHECK_KERNEL();\n809\t}\n810\t"}]},"parent_tool_use_id":"toolu_01Jzjk7joB1fSYxCHKzMCjmq","session_id":"a7dc5947-1fd2-4f8b-9741-c3b82c298994","uuid":"27ee46c0-3ddd-4ee0-8c5a-c7b699ab5572","timestamp":"2026-04-16T08:14:19.379Z"}
