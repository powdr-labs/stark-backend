{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DLPV5cC9q4bb5W2rconkht","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    sync::Arc,\n15\t};\n16\t\n17\tuse itertools::{izip, Itertools};\n18\tuse openvm_cuda_common::{\n19\t    copy::{MemCopyD2H, MemCopyH2D},\n20\t    d_buffer::DeviceBuffer,\n21\t    error::MemCopyError,\n22\t    memory_manager::MemTracker,\n23\t};\n24\tuse openvm_stark_backend::{\n25\t    air_builders::symbolic::SymbolicConstraints,\n26\t    calculate_n_logup,\n27\t    dft::Radix2BowersSerial,\n28\t    p3_matrix::dense::RowMajorMatrix,\n29\t    poly_common::{\n30\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n31\t        UnivariatePoly,\n32\t    },\n33\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n34\t    prover::{\n35\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n36\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, DeviceMultiStarkProvingKey,\n37\t        MatrixDimensions, ProvingContext,\n38\t    },\n39\t};\n40\tuse p3_dft::TwoAdicSubgroupDft;\n41\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n42\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n43\tuse rustc_hash::FxHashMap;\n44\tuse tracing::{debug, info, info_span, instrument};\n45\t\n46\tuse crate::{\n47\t    base::DeviceMatrix,\n48\t    cuda::{\n49\t        logup_zerocheck::{fold_selectors_round0, interpolate_columns_gpu, MainMatrixPtrs},\n50\t        sumcheck::batch_fold_mle,\n51\t    },\n52\t    data_transporter::transport_matrix_d2h_col_major,\n53\t    error::LogupZerocheckError,\n54\t    gpu_backend::GenericGpuBackend,\n55\t    hash_scheme::GpuHashScheme,\n56\t    logup_zerocheck::{\n57\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n58\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n59\t    },\n60\t    poly::EqEvalLayers,\n61\t    prelude::{EF, F},\n62\t    sponge::GpuFiatShamirTranscript,\n63\t    utils::compute_barycentric_inv_lagrange_denoms,\n64\t};\n65\t\n66\tpub(crate) mod batch_mle;\n67\tpub(crate) mod batch_mle_monomial;\n68\tmod errors;\n69\tpub(crate) mod fold_ple;\n70\t/// Fraction sumcheck via GKR\n71\tmod fractional;\n72\t/// Logup interaction evaluations for GKR input\n73\tmod gkr_input;\n74\tmod mle_round;\n75\tmod round0;\n76\tpub(crate) mod rules;\n77\t\n78\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n79\tuse batch_mle_monomial::{\n80\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n81\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n82\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n83\t};\n84\tpub use errors::*;\n85\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n86\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n87\tuse round0::evaluate_round0_constraints_gpu;\n88\t\n89\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n90\t/// instead of the monomial kernel for high num_y traces.\n91\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n92\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n93\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n94\t\n95\t#[inline]\n96\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n97\t    if need_rot {\n98\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n99\t        (mat_width / 2) as u32\n100\t    } else {\n101\t        mat_width as u32\n102\t    }\n103\t}\n104\t\n105\t#[allow(clippy::type_complexity)]\n106\t#[instrument(level = \"info\", skip_all)]\n107\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n108\t    transcript: &mut TS,\n109\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n110\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n111\t    save_memory: bool,\n112\t    monomial_num_y_threshold: u32,\n113\t    sm_count: u32,\n114\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n115\twhere\n116\t    HS: GpuHashScheme,\n117\t    TS: GpuFiatShamirTranscript<HS::SC>,\n118\t{\n119\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n120\t    let l_skip = mpk.params.l_skip;\n121\t    let constraint_degree = mpk.max_constraint_degree;\n122\t    let num_traces = ctx.per_trace.len();\n123\t\n124\t    // Traces are sorted\n125\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n126\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n127\t    // heights\n128\t    let mut total_interactions = 0u64;\n129\t    let interactions_meta: Vec<_> = ctx\n130\t        .per_trace\n131\t        .iter()\n132\t        .map(|(air_idx, air_ctx)| {\n133\t            let pk = &mpk.per_air[*air_idx];\n134\t\n135\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n136\t            let height = air_ctx.common_main.height();\n137\t            let log_height = log2_strict_usize(height);\n138\t            let log_lifted_height = log_height.max(l_skip);\n139\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n140\t            (num_interactions, log_lifted_height)\n141\t        })\n142\t        .collect();\n143\t    // Implicitly, the width of this stacking should be 1\n144\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n145\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n146\t    // GKR\n147\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n148\t\n149\t    // Grind to increase soundness of random sampling for LogUp\n150\t    let logup_pow_witness = transcript\n151\t        .grind_gpu(mpk.params.logup.pow_bits)\n152\t        .map_err(LogupZerocheckError::Grind)?;\n153\t    let alpha_logup = transcript.sample_ext();\n154\t    let beta_logup = transcript.sample_ext();\n155\t    debug!(%alpha_logup, %beta_logup);\n156\t\n157\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n158\t    let mut prover = LogupZerocheckGpu::new(\n159\t        mpk,\n160\t        ctx,\n161\t        n_logup,\n162\t        interactions_layout,\n163\t        alpha_logup,\n164\t        beta_logup,\n165\t        save_memory,\n166\t        monomial_num_y_threshold,\n167\t        sm_count,\n168\t    )?;\n169\t    let n_global = prover.n_global;\n170\t\n171\t    let total_leaves = 1 << (l_skip + n_logup);\n172\t    prover\n173\t        .mem\n174\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n175\t    prover.mem.reset_peak();\n176\t    let (inputs, alpha) = if has_interactions {\n177\t        log_gkr_input_evals(\n178\t            &prover.trace_interactions,\n179\t            mpk,\n180\t            ctx,\n181\t            l_skip,\n182\t            alpha_logup,\n183\t            &prover.d_challenges,\n184\t            total_leaves,\n185\t        )?\n186\t    } else {\n187\t        (DeviceBuffer::new(), EF::ZERO)\n188\t    };\n189\t    // Set memory limit for batch MLE based on inputs buffer size\n190\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n191\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n192\t    if !prover.save_memory {\n193\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n194\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n195\t            tracing::warn!(\n196\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n197\t                prover.memory_limit_bytes\n198\t            );\n199\t        }\n200\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n201\t    }\n202\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n203\t\n204\t    let (frac_sum_proof, mut xi) =\n205\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n206\t    while xi.len() != l_skip + n_global {\n207\t        xi.push(transcript.sample_ext());\n208\t    }\n209\t    debug!(?xi);\n210\t    prover.xi = xi;\n211\t\n212\t    logup_gkr_span.exit();\n213\t\n214\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does\n215\t    // not include the kernel times for the actual folding\n216\t    let round0_span = info_span!(\"prover.rap_constraints.round0\", phase = \"prover\").entered();\n217\t    // begin batch sumcheck\n218\t    let mut sumcheck_round_polys = Vec::with_capacity(n_max);\n219\t    let mut r = Vec::with_capacity(n_max + 1);\n220\t    // batching randomness\n221\t    let lambda = transcript.sample_ext();\n222\t    debug!(%lambda);\n223\t\n224\t    let sp_0_polys = prover.sumcheck_uni_round0_polys(ctx, lambda)?;\n225\t    let s_0_cpu_span = info_span!(\"s'_0 -> s_0 cpu interpolations\").entered();\n226\t    let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_degree);\n227\t    let s_deg = constraint_degree + 1;\n228\t    let s_0_deg = sumcheck_round0_deg(l_skip, s_deg);\n229\t    let large_uni_domain = (s_0_deg + 1).next_power_of_two();\n230\t    let dft = Radix2BowersSerial;\n231\t    let s_0_logup_polys = {\n232\t        let eq_sharp_uni = eq_sharp_uni_poly(&prover.xi[..l_skip]);\n233\t        let mut eq_coeffs = eq_sharp_uni.into_coeffs();\n234\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n235\t        let eq_evals = dft.dft(eq_coeffs);\n236\t\n237\t        let width = 2 * num_traces;\n238\t        let mut sp_coeffs_mat = EF::zero_vec(width * large_uni_domain);\n239\t        for (i, coeffs) in sp_0_polys[..2 * num_traces].iter().enumerate() {\n240\t            for (j, &c_j) in coeffs.coeffs().iter().enumerate().take(sp_0_deg + 1) {\n241\t                // SAFETY:\n242\t                // - coeffs length is <= sp_0_deg + 1 <= s_0_deg < large_uni_domain\n243\t                // - sp_coeffs_mat allocated for width\n244\t                unsafe {\n245\t                    *sp_coeffs_mat.get_unchecked_mut(j * width + i) = c_j;\n246\t                }\n247\t            }\n248\t        }\n249\t        let mut s_evals = dft.dft_batch(RowMajorMatrix::new(sp_coeffs_mat, width));\n250\t        for (eq, row) in zip(eq_evals, s_evals.values.chunks_mut(width)) {\n251\t            for x in row {\n252\t                *x *= eq;\n253\t            }\n254\t        }\n255\t        dft.idft_batch(s_evals)\n256\t    };\n257\t    let skip_domain_size = F::from_usize(1 << l_skip);\n258\t    // logup sum claims (sum_{\\hat p}, sum_{\\hat q}) per present AIR\n259\t    let (numerator_term_per_air, denominator_term_per_air): (Vec<_>, Vec<_>) = (0..num_traces)\n260\t        .map(|trace_idx| {\n261\t            let [sum_claim_p, sum_claim_q] = [0, 1].map(|is_denom| {\n262\t                // Compute sum over D of s_0(Z) to get the sum claim\n263\t                (0..=s_0_deg)\n264\t                    .step_by(1 << l_skip)\n265\t                    .map(|j| unsafe {\n266\t                        // SAFETY: matrix is 2 * num_trace x large_uni_domain, s_0_deg <\n267\t                        // large_uni_domain\n268\t                        *s_0_logup_polys\n269\t                            .values\n270\t                            .get_unchecked(j * 2 * num_traces + 2 * trace_idx + is_denom)\n271\t                    })\n272\t                    .sum::<EF>()\n273\t                    * skip_domain_size\n274\t            });\n275\t            transcript.observe_ext(sum_claim_p);\n276\t            transcript.observe_ext(sum_claim_q);\n277\t\n278\t            (sum_claim_p, sum_claim_q)\n279\t        })\n280\t        .unzip();\n281\t\n282\t    let mu = transcript.sample_ext();\n283\t    debug!(%mu);\n284\t    let mu_pows = mu.powers().take(3 * num_traces).collect_vec();\n285\t\n286\t    let s_0_zc_poly = {\n287\t        let eq_uni = eq_uni_poly::<F, _>(l_skip, prover.xi[0]);\n288\t        let mut eq_coeffs = eq_uni.into_coeffs();\n289\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n290\t        let eq_evals = dft.dft(eq_coeffs);\n291\t\n292\t        // Algebraically batch\n293\t        let mut sp_coeffs = EF::zero_vec(large_uni_domain);\n294\t        let mus = &mu_pows[2 * num_traces..];\n295\t        let polys = &sp_0_polys[2 * num_traces..];\n296\t        for (j, batch_coeff) in sp_coeffs.iter_mut().enumerate().take(sp_0_deg + 1) {\n297\t            for (&mu, poly) in zip(mus, polys) {\n298\t                *batch_coeff += mu * *poly.coeffs().get(j).unwrap_or(&EF::ZERO);\n299\t            }\n300\t        }\n301\t        let mut s_evals = dft.dft(sp_coeffs);\n302\t        for (eq, x) in zip(eq_evals, &mut s_evals) {\n303\t            *x *= eq;\n304\t        }\n305\t        dft.idft(s_evals)\n306\t    };\n307\t\n308\t    // Algebraically batch\n309\t    let s_0_poly = UnivariatePoly::new(\n310\t        zip(\n311\t            s_0_logup_polys.values.chunks_exact(2 * num_traces),\n312\t            s_0_zc_poly,\n313\t        )\n314\t        .take(s_0_deg + 1)\n315\t        .map(|(logup_row, batched_zc)| {\n316\t            let coeff = batched_zc\n317\t                + zip(&mu_pows, logup_row)\n318\t                    .map(|(&mu_j, &x)| mu_j * x)\n319\t                    .sum::<EF>();\n320\t            transcript.observe_ext(coeff);\n321\t            coeff\n322\t        })\n323\t        .collect(),\n324\t    );\n325\t    drop(s_0_cpu_span);\n326\t\n327\t    let r_0 = transcript.sample_ext();\n328\t    r.push(r_0);\n329\t    debug!(round = 0, r_round = %r_0);\n330\t    prover.prev_s_eval = s_0_poly.eval_at_point(r_0);\n331\t    debug!(\"s_0(r_0) = {}\", prover.prev_s_eval);\n332\t\n333\t    prover.fold_ple_evals(ctx, r_0)?;\n334\t    drop(round0_span);\n335\t\n336\t    // Sumcheck rounds:\n337\t    // - each round the prover needs to compute univariate polynomial `s_round`. This poly is linear\n338\t    //   since we are taking MLE of `evals`.\n339\t    // - at end of each round, sample random `r_round` in `EF`\n340\t    //\n341\t    // `s_round` is degree `s_deg` so we evaluate it at `0, ..., =s_deg`. The prover skips\n342\t    // evaluation at `0` because the verifier can infer it from the previous round's\n343\t    // `s_{round-1}(r)` claim. The degree is constraint_degree + 1, where + 1 is from eq term\n344\t    let mle_rounds_span =\n345\t        info_span!(\"prover.rap_constraints.mle_rounds\", phase = \"prover\").entered();\n346\t    debug!(%s_deg);\n347\t    for round in 1..=n_max {\n348\t        let sp_round_evals = prover.sumcheck_polys_batch_eval(round, r[round - 1])?;\n349\t        let batch_s = prover.compute_batch_s_poly(sp_round_evals, num_traces, round, &mu_pows);\n350\t        let batch_s_evals = (1..=s_deg)\n351\t            .map(|i| batch_s.eval_at_point(EF::from_usize(i)))\n352\t            .collect_vec();\n353\t        for &eval in &batch_s_evals {\n354\t            transcript.observe_ext(eval);\n355\t        }\n356\t        sumcheck_round_polys.push(batch_s_evals);\n357\t\n358\t        let r_round = transcript.sample_ext();\n359\t        debug!(%round, %r_round);\n360\t        r.push(r_round);\n361\t        prover.prev_s_eval = batch_s.eval_at_point(r_round);\n362\t\n363\t        prover.fold_mle_evals(round, r_round)?;\n364\t    }\n365\t    assert_eq!(r.len(), n_max + 1);\n366\t\n367\t    let column_openings = prover.into_column_openings()?;\n368\t\n369\t    let need_rot_per_trace = ctx\n370\t        .per_trace\n371\t        .iter()\n372\t        .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n373\t        .collect::<Vec<_>>();\n374\t    // Observe common main openings first, and then preprocessed/cached\n375\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n376\t        for (claim, claim_rot) in column_openings_by_rot(&openings[0], *need_rot) {\n377\t            transcript.observe_ext(claim);\n378\t            transcript.observe_ext(claim_rot);\n379\t        }\n380\t    }\n381\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n382\t        for part in openings.iter().skip(1) {\n383\t            for (claim, claim_rot) in column_openings_by_rot(part, *need_rot) {\n384\t                transcript.observe_ext(claim);\n385\t                transcript.observe_ext(claim_rot);\n386\t            }\n387\t        }\n388\t    }\n389\t    drop(mle_rounds_span);\n390\t\n391\t    let batch_constraint_proof = BatchConstraintProof {\n392\t        numerator_term_per_air,\n393\t        denominator_term_per_air,\n394\t        univariate_round_coeffs: s_0_poly.into_coeffs(),\n395\t        sumcheck_round_polys,\n396\t        column_openings,\n397\t    };\n398\t    let gkr_proof = GkrProof {\n399\t        logup_pow_witness,\n400\t        q0_claim: frac_sum_proof.fractional_sum.1,\n401\t        claims_per_layer: frac_sum_proof.claims_per_layer,\n402\t        sumcheck_polys: frac_sum_proof.sumcheck_polys,\n403\t    };\n404\t    Ok((gkr_proof, batch_constraint_proof, r))\n405\t}\n406\t\n407\tpub struct LogupZerocheckGpu<'a, HS: GpuHashScheme> {\n408\t    pub alpha_logup: EF,\n409\t    pub beta_pows: Vec<EF>,\n410\t    // [alpha, beta^0, beta^1, .., beta^max_interaction_len]\n411\t    pub d_challenges: DeviceBuffer<EF>,\n412\t\n413\t    pub l_skip: usize,\n414\t    n_logup: usize,\n415\t    n_global: usize,\n416\t\n417\t    pub omega_skip: F,\n418\t    pub omega_skip_pows: Vec<F>,\n419\t    d_omega_skip_pows: DeviceBuffer<F>,\n420\t\n421\t    pub interactions_layout: StackedLayout,\n422\t    pub constraint_degree: usize,\n423\t    n_per_trace: Vec<isize>,\n424\t    max_num_constraints: usize,\n425\t    pub monomial_num_y_threshold: u32,\n426\t    sm_count: u32,\n427\t    // Available after GKR:\n428\t    pub xi: Vec<EF>,\n429\t    pub lambda_pows: Option<DeviceBuffer<EF>>,\n430\t    /// Precomputed lambda combinations per AIR (indexed by air_idx). Set when lambda is sampled.\n431\t    lambda_combinations: Vec<Option<DeviceBuffer<EF>>>,\n432\t    /// Beta powers on device for logup MLE rounds.\n433\t    d_beta_pows: DeviceBuffer<EF>,\n434\t    /// Precomputed logup combinations per trace (indexed by trace_idx). Set when xi is sampled.\n435\t    logup_combinations: Vec<Option<LogupCombinations>>,\n436\t\n437\t    // n_T => segment tree of eq(xi[j..1+n_T]) for j=1..={n_T-round+1} in _reverse_ layout\n438\t    eq_xis: FxHashMap<usize, EqEvalLayers<EF>>,\n439\t    eq_3b_per_trace: Vec<Vec<EF>>,\n440\t    d_eq_3b_per_trace: Vec<DeviceBuffer<EF>>,\n441\t    // Evaluations on hypercube only, for round 0\n442\t    sels_per_trace_base: Vec<DeviceMatrix<F>>,\n443\t    // After univariate round 0:\n444\t    mat_evals_per_trace: Vec<Vec<DeviceMatrix<EF>>>,\n445\t    sels_per_trace: Vec<DeviceMatrix<EF>>,\n446\t    // Store public_values per trace (similar to CPU's EvalHelper)\n447\t    public_values_per_trace: Vec<DeviceBuffer<F>>,\n448\t    air_indices_per_trace: Vec<usize>,\n449\t    zerocheck_tilde_evals: Vec<EF>,\n450\t    logup_tilde_evals: Vec<[EF; 2]>,\n451\t    needs_next_per_trace: Vec<bool>,\n452\t\n453\t    trace_interactions: Vec<Option<TraceInteractionMeta>>,\n454\t    // round0: Round0Buffers,\n455\t    pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n456\t\n457\t    // In round `j`, contains `s_{j-1}(r_{j-1})`\n458\t    pub(crate) prev_s_eval: EF,\n459\t    pub(crate) eq_ns: Vec<EF>,\n460\t    pub(crate) eq_sharp_ns: Vec<EF>,\n461\t\n462\t    mem: MemTracker,\n463\t    save_memory: bool,\n464\t\n465\t    gkr_mem_contribution: usize,\n466\t    /// Memory limit for batch MLE intermediate buffers (set after GKR input eval)\n467\t    memory_limit_bytes: usize,\n468\t}\n469\t\n470\timpl<'a, HS: GpuHashScheme> LogupZerocheckGpu<'a, HS> {\n471\t    #[allow(clippy::too_many_arguments)]\n472\t    fn new(\n473\t        pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n474\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n475\t        n_logup: usize,\n476\t        interactions_layout: StackedLayout,\n477\t        alpha_logup: EF,\n478\t        beta_logup: EF,\n479\t        save_memory: bool,\n480\t        monomial_num_y_threshold: u32,\n481\t        sm_count: u32,\n482\t    ) -> Result<Self, LogupZerocheckError> {\n483\t        let mem = MemTracker::start(\"prover.logup_zerocheck_prover\");\n484\t        let l_skip = pk.params.l_skip;\n485\t        let omega_skip = F::two_adic_generator(l_skip);\n486\t        let omega_skip_pows = omega_skip.powers().take(1 << l_skip).collect_vec();\n487\t        let d_omega_skip_pows = omega_skip_pows.to_device()?;\n488\t        let num_airs_present = ctx.per_trace.len();\n489\t\n490\t        let constraint_degree = pk.max_constraint_degree;\n491\t\n492\t        let max_interaction_length = pk\n493\t            .per_air\n494\t            .iter()\n495\t            .map(|air_pk| air_pk.other_data.interaction_rules.max_fields_len)\n496\t            .max()\n497\t            .unwrap_or(0);\n498\t        let beta_pows = beta_logup\n499\t            .powers()\n500\t            .take(max_interaction_length + 1)"}]},"par