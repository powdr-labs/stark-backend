{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015KzUQq4hKKHFjG7k4x5ewZ","type":"tool_result","content":"79\tpub(crate) fn compute_lambda_combinations<HS: GpuHashScheme>(\n80\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n81\t    air_idx: usize,\n82\t    lambda_pows: &DeviceBuffer<EF>,\n83\t) -> Result<DeviceBuffer<EF>, CudaError> {\n84\t    let monomials = pk.per_air[air_idx]\n85\t        .other_data\n86\t        .zerocheck_monomials\n87\t        .as_ref()\n88\t        .expect(\"AIR must have monomials\");\n89\t    let mut buf = DeviceBuffer::<EF>::with_capacity(monomials.num_monomials as usize);\n90\t    unsafe {\n91\t        precompute_lambda_combinations(\n92\t            &mut buf,\n93\t            monomials.d_headers.as_ptr(),\n94\t            monomials.d_lambda_terms.as_ptr(),\n95\t            lambda_pows,\n96\t            monomials.num_monomials,\n97\t        )?;\n98\t    }\n99\t    Ok(buf)\n100\t}\n101\t\n102\t/// Batch evaluator for monomial-based zerocheck MLE evaluation.\n103\t///\n104\t/// Pre-builds GPU contexts for all traces, then evaluates in a single kernel launch.\n105\t///\n106\t/// The caller must filter traces using [`trace_has_monomials`] before constructing.\n107\t/// The batch must contain at least one trace.\n108\t///\n109\t/// The struct holds references to `TraceCtx` which guarantees the underlying\n110\t/// device buffers (including `main_ptrs_dev`) remain valid for the struct's lifetime.\n111\tpub(crate) struct ZerocheckMonomialBatch<'a> {\n112\t    traces: Vec<&'a TraceCtx>,\n113\t    block_ctxs: DeviceBuffer<BlockCtx>,\n114\t    air_ctxs: DeviceBuffer<MonomialAirCtx>,\n115\t    air_offsets: DeviceBuffer<u32>,\n116\t}\n117\t\n118\timpl<'a> ZerocheckMonomialBatch<'a> {\n119\t    /// Creates a new batch from an iterator of traces.\n120\t    ///\n121\t    /// `lambda_combinations` must contain one buffer per trace (in iteration order),\n122\t    /// each precomputed via [`compute_lambda_combinations`].\n123\t    ///\n124\t    /// # Panics\n125\t    ///\n126\t    /// Panics if `traces` is empty or if `lambda_combinations` length doesn't match.\n127\t    pub fn new<HS: GpuHashScheme>(\n128\t        traces: impl IntoIterator<Item = &'a TraceCtx>,\n129\t        pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n130\t        lambda_combinations: &[&DeviceBuffer<EF>],\n131\t    ) -> Result<Self, MemCopyError> {\n132\t        let traces: Vec<_> = traces.into_iter().collect();\n133\t        assert!(\n134\t            !traces.is_empty(),\n135\t            \"ZerocheckMonomialBatch requires at least one trace\"\n136\t        );\n137\t        assert_eq!(\n138\t            traces.len(),\n139\t            lambda_combinations.len(),\n140\t            \"lambda_combinations must have one buffer per trace\"\n141\t        );\n142\t\n143\t        let threads_per_block = THREADS_PER_BLOCK;\n144\t\n145\t        // Build block_ctxs and air_offsets\n146\t        // For each AIR: total_blocks = ceil(num_monomials / tpb) * num_y\n147\t        // local_block_idx_x encodes (y_int * mono_blocks + mono_block_idx)\n148\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();\n149\t        let mut air_offsets: Vec<u32> = Vec::with_capacity(traces.len() + 1);\n150\t        air_offsets.push(0);\n151\t\n152\t        for (local_air, t) in traces.iter().enumerate() {\n153\t            let monomials = pk.per_air[t.air_idx]\n154\t                .other_data\n155\t                .zerocheck_monomials\n156\t                .as_ref()\n157\t                .unwrap();\n158\t            let mono_blocks = monomials.num_monomials.div_ceil(threads_per_block);\n159\t            let total_blocks = mono_blocks * t.num_y;\n160\t\n161\t            for local_idx in 0..total_blocks {\n162\t                block_ctxs_h.push(BlockCtx {\n163\t                    local_block_idx_x: local_idx,\n164\t                    air_idx: local_air as u32,\n165\t                });\n166\t            }\n167\t            air_offsets.push(block_ctxs_h.len() as u32);\n168\t        }\n169\t\n170\t        // Build MonomialAirCtx for each trace\n171\t        let air_ctxs_h: Vec<MonomialAirCtx> = traces\n172\t            .iter()\n173\t            .zip(lambda_combinations)\n174\t            .map(|(t, lc)| {\n175\t                let monomials = pk.per_air[t.air_idx]\n176\t                    .other_data\n177\t                    .zerocheck_monomials\n178\t                    .as_ref()"}]},"parent_tool_use_id":"toolu_01Ujx6Ws3TeW3a4NS3MM4CmL","session_id":"bf8cf1a6-3d58-4ca0-8a0c-442b3fb4c97c","uuid":"123ba09c-a0e0-43ed-8fa9-cc6ddc9ed8d0","timestamp":"2026-04-12T22:15:04.723Z"}
