          .map_err(LogupZerocheckError::MleConstraintEval)?;\n1236\t            let host = out.to_host()?;\n1237\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1238\t                self.zerocheck_tilde_evals[trace_idx] = host[i];\n1239\t                // zc_out not set for num_x=1, handled from tilde_eval in compute_batch_s\n1240\t            }\n1241\t        }\n1242\t\n1243\t        // Logup for early traces: partition by num_y threshold\n1244\t        if !early_eval.is_empty() {\n1245\t            evaluate_logup_batched(\n1246\t                &early_eval,\n1247\t                self.pk,\n1248\t                d_challenges_ptr,\n1249\t                sp_deg as u32,\n1250\t                self.monomial_num_y_threshold,\n1251\t                &self.logup_combinations,\n1252\t                &mut logup_out,\n1253\t                &mut self.logup_tilde_evals,\n1254\t                self.memory_limit_bytes,\n1255\t            )\n1256\t            .map_err(LogupZerocheckError::MleInteractionEval)?;\n1257\t        }\n1258\t\n1259\t        // Early traces (num_y>1): partition by threshold for zerocheck path\n1260\t        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n1261\t            .iter()\n1262\t            .filter(|t| t.has_constraints)\n1263\t            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n1264\t\n1265\t        // Partition high num_y traces by monomial-to-rules ratio\n1266\t        // (traces without monomials are skipped - they contribute zero)\n1267\t        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n1268\t            high_early.iter().partition(|t| {\n1269\t                let num_monomials = get_num_monomials(t, self.pk);\n1270\t                let rules_len = get_zerocheck_rules_len(t, self.pk);\n1271\t                // Use DAG when monomial expansion significantly increased the term count\n1272\t                num_monomials as usize >= DAG_FALLB