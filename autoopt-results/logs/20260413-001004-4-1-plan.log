gup_tilde_evals[trace_idx][0] *= eq_sharp_r_acc;\n1356\t                self.logup_tilde_evals[trace_idx][1] *= eq_sharp_r_acc;\n1357\t            }\n1358\t            if round <= n_lift {\n1359\t                for i in 0..constraint_degree {\n1360\t                    sp_head_zc[i] += mu_pows[zc_idx] * sp_round_evals[zc_idx][i];\n1361\t                    sp_head_logup[i] += mu_pows[numer_idx] * sp_round_evals[numer_idx][i]\n1362\t                        + mu_pows[denom_idx] * sp_round_evals[denom_idx][i];\n1363\t                }\n1364\t            } else {\n1365\t                sp_tail += mu_pows[zc_idx] * self.zerocheck_tilde_evals[trace_idx]\n1366\t                    + mu_pows[numer_idx] * self.logup_tilde_evals[trace_idx][0]\n1367\t                    + mu_pows[denom_idx] * self.logup_tilde_evals[trace_idx][1];\n1368\t            }\n1369\t        }\n1370\t        let s_deg = constraint_degree + 1;\n1371\t        let l_skip = self.l_skip;\n1372\t        // With eq(xi,r) contributions\n1373\t        let mut sp_head_evals = vec![EF::ZERO; s_deg];\n1374\t        for i in 0..constraint_degree {\n1375\t            sp_head_evals[i + 1] = self.eq_ns[round - 1] * sp_head_zc[i]\n1376\t                + self.eq_sharp_ns[round - 1] * sp_head_logup[i];\n1377\t        }\n1378\t        // We need to derive s'(0).\n1379\t        // We use that s_j(0) + s_j(1) = s_{j-1}(r_{j-1})\n1380\t        let xi_cur = self.xi[l_skip + round - 1];\n1381\t        {\n1382\t            let eq_xi_0 = EF::ONE - xi_cur;\n1383\t            let eq_xi_1 = xi_cur;\n1384\t            sp_head_evals[0] =\n1385\t                (self.prev_s_eval - eq_xi_1 * sp_head_evals[1] - sp_tail) * eq_xi_0.inverse();\n1386\t        }\n1387\t        // s' has degree s_deg - 1\n1388\t        let sp_head = UnivariatePoly::lagrange_interpolate(\n1389\t            &(0..s_deg).map(F::from_usize).collect_vec(),\n1390\t            &sp_head_evals,\n1391\t        );\n1392\t        // eq(xi, X) = (2 * xi - 1) * X + (1 - xi