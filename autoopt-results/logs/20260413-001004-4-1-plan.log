{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MBu3oXUPevbeYVW6RD7DcQ","type":"tool_result","content":"1\tuse std::{\n2\t    collections::HashMap,\n3\t    ffi::c_void,\n4\t    ptr::NonNull,\n5\t    sync::{Mutex, OnceLock},\n6\t    time::{SystemTime, UNIX_EPOCH},\n7\t};\n8\t\n9\tuse bytesize::ByteSize;\n10\t\n11\tuse crate::{\n12\t    error::{check, MemoryError},\n13\t    stream::{cudaStreamPerThread, cudaStream_t, current_stream_id, device_synchronize},\n14\t};\n15\t\n16\tmod cuda;\n17\tmod vm_pool;\n18\tuse vm_pool::VirtualMemoryPool;\n19\t\n20\t#[cfg(test)]\n21\tmod tests;\n22\t\n23\t#[link(name = \"cudart\")]\n24\textern \"C\" {\n25\t    fn cudaMallocAsync(dev_ptr: *mut *mut c_void, size: usize, stream: cudaStream_t) -> i32;\n26\t    fn cudaFreeAsync(dev_ptr: *mut c_void, stream: cudaStream_t) -> i32;\n27\t    fn cudaMemGetInfo(free: *mut usize, total: *mut usize) -> i32;\n28\t}\n29\t\n30\tstatic MEMORY_MANAGER: OnceLock<Mutex<MemoryManager>> = OnceLock::new();\n31\t\n32\tpub fn device_memory_used() -> usize {\n33\t    let mut free = 0usize;\n34\t    let mut total = 0usize;\n35\t    unsafe { cudaMemGetInfo(&mut free, &mut total) };\n36\t    total - free\n37\t}\n38\t\n39\t#[ctor::ctor]\n40\tfn init() {\n41\t    let _ = MEMORY_MANAGER.set(Mutex::new(MemoryManager::new()));\n42\t    tracing::info!(\"Memory manager initialized at program start\");\n43\t}\n44\t\n45\tpub struct MemoryManager {\n46\t    pool: VirtualMemoryPool,\n47\t    allocated_ptrs: HashMap<NonNull<c_void>, usize>,\n48\t    current_size: usize,\n49\t    max_used_size: usize,\n50\t}\n51\t\n52\t/// # Safety\n53\t/// `MemoryManager` is not internally synchronized. These impls are safe because\n54\t/// the singleton instance is wrapped in `Mutex` via `MEMORY_MANAGER`.\n55\tunsafe impl Send for MemoryManager {}\n56\tunsafe impl Sync for MemoryManager {}\n57\t\n58\timpl MemoryManager {\n59\t    pub fn new() -> Self {\n60\t        // Create virtual memory pool\n61\t        let pool = VirtualMemoryPool::default();\n62\t\n63\t        Self {\n64\t            pool,\n65\t            allocated_ptrs: HashMap::new(),\n66\t            current_size: 0,\n67\t            max_used_size: 0,\n68\t        }\n69\t    }\n70\t\n71\t    fn d_malloc(&mut self, size: usize) -> Result<*mut c_void, MemoryError> {\n72\t        assert!(size != 0, \"Requested size must be non-zero\");\n73\t\n74\t        let mut tracked_size = size;\n75\t        let ptr = if size < self.pool.page_size {\n76\t            let mut ptr: *mut c_void = std::ptr::null_mut();\n77\t            check(unsafe { cudaMallocAsync(&mut ptr, size, cudaStreamPerThread) }).map_err(\n78\t                |e| {\n79\t                    tracing::error!(\"cudaMallocAsync failed: size={}: {:?}\", size, e);\n80\t                    MemoryError::from(e)\n81\t                },\n82\t            )?;\n83\t            self.allocated_ptrs.insert(\n84\t                NonNull::new(ptr).expect(\"BUG: cudaMallocAsync returned null\"),\n85\t                size,\n86\t            );\n87\t            ptr\n88\t        } else {\n89\t            tracked_size = size.next_multiple_of(self.pool.page_size);\n90\t            let stream_id = current_stream_id()?;\n91\t            self.pool.malloc_internal(tracked_size, stream_id)?\n92\t        };\n93\t\n94\t        self.current_size += tracked_size;\n95\t        if self.current_size > self.max_used_size {\n96\t            self.max_used_size = self.current_size;\n97\t        }\n98\t        Ok(ptr)\n99\t    }\n100\t\n101\t    /// # Safety\n102\t    /// The pointer `ptr` must be a valid, previously allocated device pointer.\n103\t    /// The caller must ensure that `ptr` is not used after this function is called.\n104\t    unsafe fn d_free(&mut self, ptr: *mut c_void) -> Result<(), MemoryError> {\n105\t        let nn = NonNull::new(ptr).ok_or(MemoryError::NullPointer)?;\n106\t\n107\t        if let Some(size) = self.allocated_ptrs.remove(&nn) {\n108\t            self.current_size -= size;\n109\t            check(unsafe { cudaFreeAsync(ptr, cudaStreamPerThread) }).map_err(|e| {\n110\t                tracing::error!(\"cudaFreeAsync failed: ptr={:p}: {:?}\", ptr, e);\n111\t                MemoryError::from(e)\n112\t            })?;\n113\t        } else {\n114\t            let stream_id = current_stream_id()?;\n115\t            let freed_size = self.pool.free_internal(ptr, stream_id)?;\n116\t            self.current_size -= freed_size;\n117\t        }\n118\t\n119\t        Ok(())\n120\t    }\n121\t}\n122\t\n123\timpl Drop for MemoryManager {\n124\t    fn drop(&mut self) {\n125\t        device_synchronize().unwrap();\n126\t        let ptrs: Vec<*mut c_void> = self.allocated_ptrs.keys().map(|nn| nn.as_ptr()).collect();\n127\t        for &ptr in &ptrs {\n128\t            if let Err(e) = unsafe { self.d_free(ptr) } {\n129\t                tracing::error!(\"MemoryManager drop: failed to free {:p}: {:?}\", ptr, e);\n130\t            }\n131\t        }\n132\t    }\n133\t}\n134\t\n135\timpl Default for MemoryManager {\n136\t    fn default() -> Self {\n137\t        Self::new()\n138\t    }\n139\t}\n140\t\n141\tpub fn d_malloc(size: usize) -> Result<*mut c_void, MemoryError> {\n142\t    let manager = MEMORY_MANAGER.get().unwrap();\n143\t    let mut manager = manager.lock().map_err(|_| MemoryError::LockError)?;\n144\t    manager.d_malloc(size)\n145\t}\n146\t\n147\t/// # Safety\n148\t/// The pointer `ptr` must be a valid, previously allocated device pointer.\n149\t/// The caller must ensure that `ptr` is not used after this function is called.\n150\tpub unsafe fn d_free(ptr: *mut c_void) -> Result<(), MemoryError> {\n151\t    let manager = MEMORY_MANAGER.get().unwrap();\n152\t    let mut manager = manager.lock().map_err(|_| MemoryError::LockError)?;\n153\t    manager.d_free(ptr)\n154\t}\n155\t\n156\t#[derive(Debug, Clone)]\n157\tpub struct MemTracker {\n158\t    current: usize,\n159\t    label: &'static str,\n160\t}\n161\t\n162\timpl MemTracker {\n163\t    pub fn start(label: &'static str) -> Self {\n164\t        let current = MEMORY_MANAGER\n165\t            .get()\n166\t            .and_then(|m| m.lock().ok())\n167\t            .map(|m| m.current_size)\n168\t            .unwrap_or_default();\n169\t\n170\t        Self { current, label }\n171\t    }\n172\t\n173\t    pub fn start_and_reset_peak(label: &'static str) -> Self {\n174\t        let mut mem = Self::start(label);\n175\t        mem.reset_peak();\n176\t        mem\n177\t    }\n178\t\n179\t    pub fn emit_metrics(&self) {\n180\t        self.emit_metrics_with_label(self.label);\n181\t    }\n182\t\n183\t    pub fn emit_metrics_with_label(&self, label: &'static str) {\n184\t        let Some(manager) = MEMORY_MANAGER.get().and_then(|m| m.lock().ok()) else {\n185\t            return;\n186\t        };\n187\t\n188\t        let ts = SystemTime::now()\n189\t            .duration_since(UNIX_EPOCH)\n190\t            .unwrap()\n191\t            .as_secs_f64()\n192\t            * 1000.0;\n193\t        let current = manager.current_size;\n194\t        // local_peak is local maximum memory size, as observed by the manager, since the last\n195\t        // reset_peak call\n196\t        let local_peak = manager.max_used_size;\n197\t        let reserved = manager.pool.memory_usage();\n198\t        metrics::gauge!(\"gpu_mem.timestamp_ms\", \"module\" => label).set(ts);\n199\t        metrics::gauge!(\"gpu_mem.current_bytes\", \"module\" => label).set(current as f64);\n200\t        metrics::gauge!(\"gpu_mem.local_peak_bytes\", \"module\" => label).set(local_peak as f64);\n201\t        metrics::gauge!(\"gpu_mem.reserved_bytes\", \"module\" => label).set(reserved as f64);\n202\t    }\n203\t\n204\t    #[inline]\n205\t    pub fn tracing_info(&self, msg: impl Into<Option<&'static str>>) {\n206\t        let Some(manager) = MEMORY_MANAGER.get().and_then(|m| m.lock().ok()) else {\n207\t            tracing::error!(\"Memory manager not available\");\n208\t            return;\n209\t        };\n210\t        let current = manager.current_size;\n211\t        let peak = manager.max_used_size;\n212\t        let used = current as isize - self.current as isize;\n213\t        let sign = if used >= 0 { \"+\" } else { \"-\" };\n214\t        let pool_usage = manager.pool.memory_usage();\n215\t        tracing::info!(\n216\t            \"GPU mem: used={}{}, current={}, peak={}, in pool={} ({})\",\n217\t            sign,\n218\t            ByteSize::b(used.unsigned_abs() as u64),\n219\t            ByteSize::b(current as u64),\n220\t            ByteSize::b(peak as u64),\n221\t            ByteSize::b(pool_usage as u64),\n222\t            msg.into()\n223\t                .map_or(self.label.to_string(), |m| format!(\"{}:{}\", self.label, m))\n224\t        );\n225\t    }\n226\t\n227\t    pub fn reset_peak(&mut self) {\n228\t        if let Some(mut manager) = MEMORY_MANAGER.get().and_then(|m| m.lock().ok()) {\n229\t            manager.max_used_size = manager.current_size;\n230\t        }\n231\t    }\n232\t}\n233\t\n234\timpl Drop for MemTracker {\n235\t    fn drop(&mut self) {\n236\t        self.tracing_info(None);\n237\t    }\n238\t}\n239\t"}]},"parent_tool_use_id":"toolu_01MQN4oFS5GMuCCr8dLJfzyH","session_id":"bf8cf1a6-3d58-4ca0-8a0c-442b3fb4c97c","uuid":"68daf4b4-ef4d-416e-98cf-37e4e4bb03c6","timestamp":"2026-04-12T22:39:11.371Z"}
