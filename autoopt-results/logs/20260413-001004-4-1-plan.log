q_r0 = eval_eq_uni(l_skip, self.xi[0], r_0);\n991\t        let eq_sharp_r0 = eval_eq_sharp_uni(&self.omega_skip_pows, &self.xi[..l_skip], r_0);\n992\t        self.eq_ns.push(eq_r0);\n993\t        self.eq_sharp_ns.push(eq_sharp_r0);\n994\t        for tree in self.eq_xis.values_mut() {\n995\t            // trim the back (which corresponds to r_{j-1}) because we don't need it anymore\n996\t            if tree.layers.len() > 1 {\n997\t                tree.layers.pop();\n998\t            }\n999\t        }\n1000\t\n1001\t        self.mem\n1002\t            .emit_metrics_with_label(\"prover.batch_constraints.fold_ple_evals\");\n1003\t        Ok(())\n1004\t    }\n1005\t\n1006\t    #[instrument(\n1007\t        name = \"LogupZerocheck::sumcheck_polys_batch_eval\",\n1008\t        level = \"info\",\n1009\t        skip_all,\n1010\t        fields(round = round)\n1011\t    )]\n1012\t    fn sumcheck_polys_batch_eval(\n1013\t        &mut self,\n1014\t        round: usize,\n1015\t        r_prev: EF,\n1016\t    ) -> Result<Vec<Vec<EF>>, LogupZerocheckError> {\n1017\t        let sp_deg = self.constraint_degree;\n1018\t\n1019\t        // Per-trace outputs (filled as we go)\n1020\t        let mut zc_out: Vec<Vec<EF>> = vec![vec![EF::ZERO; sp_deg]; self.n_per_trace.len()];\n1021\t        let mut logup_out: Vec<[Vec<EF>; 2]> =\n1022\t            vec![[vec![EF::ZERO; sp_deg], vec![EF::ZERO; sp_deg]]; self.n_per_trace.len()];\n1023\t\n1024\t        // Keep early interpolations alive for duration of kernels\n1025\t        let mut _keepalive_interpolated: Vec<DeviceMatrix<EF>> = Vec::new();\n1026\t\n1027\t        let mut late_eval: Vec<TraceCtx> = Vec::new(); // round == n_lift + 1\n1028\t        let mut early_eval: Vec<TraceCtx> = Vec::new(); // round <= n_lift\n1029\t\n1030\t        // First, handle traces in original order and split into cases\n1031\t        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n1032\t            self.n_per_trace.iter(),\n1033\t        