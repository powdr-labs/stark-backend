   pub use_count: usize,\n63\t    /// Last dag_idx (inclusive) that uses this expr\n64\t    pub last_use: usize,\n65\t    /// Index within intermediate buffer to store, usize::MAX if not stored\n66\t    pub buffer_idx: usize,\n67\t}\n68\t\n69\timpl LiveExpressionInfo {\n70\t    pub fn update(&mut self, dag_idx: usize) {\n71\t        self.last_use = self.last_use.max(dag_idx);\n72\t        self.use_count += 1;\n73\t    }\n74\t}\n75\t\n76\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n77\tstruct BufferEntry {\n78\t    buffer_idx: usize,\n79\t    last_use: usize,\n80\t}\n81\t\n82\timpl Ord for BufferEntry {\n83\t    fn cmp(&self, other: &Self) -> Ordering {\n84\t        other\n85\t            .last_use\n86\t            .cmp(&self.last_use)\n87\t            .then_with(|| other.buffer_idx.cmp(&self.buffer_idx))\n88\t    }\n89\t}\n90\t\n91\timpl PartialOrd for BufferEntry {\n92\t    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n93\t        Some(self.cmp(other))\n94\t    }\n95\t}\n96\t\n97\t#[derive(Debug, Clone)]\n98\tpub struct SymbolicRulesGpu<F> {\n99\t    /// Vector consisting of rules to be sequentially evaluated in a single GPU thread.\n100\t    pub rules: Vec<RuleWithFlag<F>>,\n101\t    /// Number of `F` elements in the intermediate buffer required for rule evaluation.\n102\t    pub buffer_size: usize,\n103\t    /// Map from dag_idx to rule_idx for accumulated nodes. Unlike `used_nodes`, this has no\n104\t    /// duplicates.\n105\t    pub dag_idx_to_rule_idx: FxHashMap<usize, usize>,\n106\t}\n107\t\n108\t/// Stateful rule builder that schedules buffer allocation and reuse using a priority queue.\n109\t///\n110\t/// At any given time, the builder will determine the buffer scheduling for a contiguous range of\n111\t/// nodes in a global DAG, where the DAG is already topologically sorted.\n112\t#[derive(Getters)]\n113\tpub struct SymbolicRulesBuilder<'a, F> {\n114\t    /// Global dag that all symbolic expressions will be referenced with respect to.\n115\t