{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B9LexNTSyN3Z7kKg23S5gU","type":"tool_result","content":"120\t\n121\t/// All read-only references needed to process one AIR in Round 0.\n122\tstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n123\t    trace_idx: usize,\n124\t    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n125\t    n: isize,\n126\t    selectors_cube: &'a DeviceMatrix<F>,\n127\t    public_values: &'a DeviceBuffer<F>,\n128\t    eq_3bs: &'a [EF],\n129\t    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n130\t    common_main: &'a DeviceMatrix<F>,\n131\t    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n132\t    d_lambda_pows: &'a DeviceBuffer<EF>,\n133\t    beta_pows: &'a [EF],\n134\t    l_skip: usize,\n135\t    constraint_degree: usize,\n136\t    xi: &'a [EF],\n137\t    max_temp_bytes: usize,\n138\t}\n139\t\n140\tfn process_air_round0<HS: GpuHashScheme>(\n141\t    w: &Round0AirWorkItem<HS>,\n142\t) -> Result<Round0AirResult, LogupZerocheckError> {\n143\t    let single_pk = w.single_pk;\n144\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n145\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n146\t    assert!(\n147\t        local_constraint_deg <= w.constraint_degree,\n148\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n149\t        w.constraint_degree\n150\t    );\n151\t\n152\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n153\t    let omega_root = F::two_adic_generator(log_large_domain);\n154\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n155\t\n156\t    let height = w.common_main.height();\n157\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n158\t    for committed in w.cached_mains {\n159\t        main_parts.push(committed.trace.buffer().as_ptr());\n160\t    }\n161\t    main_parts.push(w.common_main.buffer().as_ptr());\n162\t    let d_main_parts = main_parts.to_device()?;\n163\t\n164\t    let n_lift = w.n.max(0) as usize;\n165\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n166\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n167\t\n168\t    let sum_buffer = evaluate_round0_constraints_gpu(\n169\t        single_pk,\n170\t        w.selectors_cube.buffer(),\n171\t        &d_main_parts,\n172\t        w.public_values,\n173\t        eq_xi_tree.get_ptr(n_lift),\n174\t        w.d_lambda_pows,\n175\t        1 << w.l_skip,\n176\t        1 << n_lift,\n177\t        height as u32,\n178\t        num_cosets_zc as u32,\n179\t        omega_root,\n180\t        w.max_temp_bytes,\n181\t    )?;\n182\t\n183\t    let zerocheck_poly = if !sum_buffer.is_empty() {\n184\t        let q_evals = sum_buffer.to_host_on_current_stream()?;\n185\t        let q = {\n186\t            let mut values = EF::zero_vec(num_cosets_zc << w.l_skip);\n187\t            for coset_idx in 0..num_cosets_zc {\n188\t                for i in 0..1 << w.l_skip {\n189\t                    values[i * num_cosets_zc + coset_idx] = q_evals[(coset_idx << w.l_skip) + i];\n190\t                }\n191\t            }\n192\t            UnivariatePoly::from_geometric_cosets_evals_idft(\n193\t                RowMajorMatrix::new(values, num_cosets_zc),\n194\t                omega_root,\n195\t                omega_root,\n196\t            )\n197\t        };\n198\t        let sp_0_deg = sumcheck_round0_deg(w.l_skip, local_constraint_deg);\n199\t        let coeffs = (0..=sp_0_deg)\n200\t            .map(|i| {\n201\t                let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n202\t                if i >= 1 << w.l_skip {\n203\t                    c += q.coeffs()[i - (1 << w.l_skip)];\n204\t                }\n205\t                c\n206\t            })\n207\t            .collect_vec();\n208\t        Some(UnivariatePoly::new(coeffs))\n209\t    } else {\n210\t        None\n211\t    };\n212\t\n213\t    let num_cosets_logup = local_constraint_deg;\n214\t    let sum = evaluate_round0_interactions_gpu(\n215\t        single_pk,\n216\t        &single_air_constraints,\n217\t        w.selectors_cube.buffer(),\n218\t        &d_main_parts,\n219\t        w.public_values,\n220\t        eq_xi_tree.get_ptr(n_lift),\n221\t        w.beta_pows,\n222\t        w.eq_3bs,\n223\t        1 << w.l_skip,\n224\t        1 << n_lift,\n225\t        height as u32,\n226\t        num_cosets_logup as u32,\n227\t        omega_root,\n228\t        w.max_temp_bytes,\n229\t    )?;\n230\t\n231\t    let (logup_numer_poly, logup_denom_poly) = if !sum.is_empty() {\n232\t        let evals = sum.to_host_on_current_stream()?;\n233\t        let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n234\t            evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n235\t        if w.n.is_negative() {\n236\t            let norm_factor = F::from_u32(1 << w.n.unsigned_abs()).inverse();\n237\t            for s in &mut numer {\n238\t                *s *= norm_factor;\n239\t            }\n240\t        }\n241\t        let mut numer_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n242\t        let mut denom_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n243\t        for coset_idx in 0..num_cosets_logup {\n244\t            for i in 0..1 << w.l_skip {\n245\t                let src = (coset_idx << w.l_skip) + i;\n246\t                let dst = i * num_cosets_logup + coset_idx;\n247\t                numer_values[dst] = numer[src];\n248\t                denom_values[dst] = denom[src];\n249\t            }\n250\t        }\n251\t        let numer_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n252\t            RowMajorMatrix::new(numer_values, num_cosets_logup),\n253\t            omega_root,\n254\t            F::ONE,\n255\t        );\n256\t        let denom_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n257\t            RowMajorMatrix::new(denom_values, num_cosets_logup),\n258\t            omega_root,\n259\t            F::ONE,\n260\t        );\n261\t        (Some(numer_poly), Some(denom_poly))\n262\t    } else {\n263\t        (None, None)\n264\t    };\n265\t\n266\t    Ok(Round0AirResult {\n267\t        trace_idx: w.trace_idx,\n268\t        zerocheck_poly,\n269\t        logup_numer_poly,\n270\t        logup_denom_poly,\n271\t    })\n272\t}\n273\t\n274\t#[allow(clippy::type_complexity)]"}]},"parent_tool_use_id":null,"session_id":"e7b52780-6e9b-4892-943d-0d0679c1a1bd","uuid":"4e33f649-346e-46f2-b334-5931f5f05e33","timestamp":"2026-04-13T20:33:19.413Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/mod.rs","content":"\n/// All read-only references needed to process one AIR in Round 0.\nstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n    trace_idx: usize,\n    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n    n: isize,\n    selectors_cube: &'a DeviceMatrix<F>,\n    public_values: &'a DeviceBuffer<F>,\n    eq_3bs: &'a [EF],\n    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n    common_main: &'a DeviceMatrix<F>,\n    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n    d_lambda_pows: &'a DeviceBuffer<EF>,\n    beta_pows: &'a [EF],\n    l_skip: usize,\n    constraint_degree: usize,\n    xi: &'a [EF],\n    max_temp_bytes: usize,\n}\n\nfn process_air_round0<HS: GpuHashScheme>(\n    w: &Round0AirWorkItem<HS>,\n) -> Result<Round0AirResult, LogupZerocheckError> {\n    let single_pk = w.single_pk;\n    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n    assert!(\n        local_constraint_deg <= w.constraint_degree,\n        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n        w.constraint_degree\n    );\n\n    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n    let omega_root = F::two_adic_generator(log_large_domain);\n    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n\n    let height = w.common_main.height();\n    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n    for committed in w.cached_mains {\n        main_parts.push(committed.trace.buffer().as_ptr());\n    }\n    main_parts.push(w.common_main.buffer().as_ptr());\n    let d_main_parts = main_parts.to_device()?;\n\n    let n_lift = w.n.max(0) as usize;\n    let eq_xi_tree = &w.eq_xis[&n_lift];\n    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n\n    let sum_buffer = evaluate_round0_constraints_gpu(\n        single_pk,\n        w.selectors_cube.buffer(),\n        &d_main_parts,\n        w.public_values,\n        eq_xi_tree.get_ptr(n_lift),\n        w.d_lambda_pows,\n        1 << w.l_skip,\n        1 << n_lift,\n        height as u32,\n        num_cosets_zc as u32,\n        omega_root,\n        w.max_temp_bytes,\n    )?;\n\n    let zerocheck_poly = if !sum_buffer.is_empty() {\n        let q_evals = sum_buffer.to_host_on_current_stream()?;\n        let q = {\n            let mut values = EF::zero_vec(num_cosets_zc << w.l_skip);\n            for coset_idx in 0..num_cosets_zc {\n                for i in 0..1 << w.l_skip {\n                    values[i * num_cosets_zc + coset_idx] = q_evals[(coset_idx << w.l_skip) + i];\n                }\n            }\n            UnivariatePoly::from_geometric_cosets_evals_idft(\n                RowMajorMatrix::new(values, num_cosets_zc),\n                omega_root,\n                omega_root,\n            )\n        };\n        let sp_0_deg = sumcheck_round0_deg(w.l_skip, local_constraint_deg);\n        let coeffs = (0..=sp_0_deg)\n            .map(|i| {\n                let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n                if i >= 1 << w.l_skip {\n                    c += q.coeffs()[i - (1 << w.l_skip)];\n                }\n                c\n            })\n            .collect_vec();\n        Some(UnivariatePoly::new(coeffs))\n    } else {\n        None\n    };\n\n    let num_cosets_logup = local_constraint_deg;\n    let sum = evaluate_round0_interactions_gpu(\n        single_pk,\n        &single_air_constraints,\n        w.selectors_cube.buffer(),\n        &d_main_parts,\n        w.public_values,\n        eq_xi_tree.get_ptr(n_lift),\n        w.beta_pows,\n        w.eq_3bs,\n        1 << w.l_skip,\n        1 << n_lift,\n        height as u32,\n        num_cosets_logup as u32,\n        omega_root,\n        w.max_temp_bytes,\n    )?;\n\n    let (logup_numer_poly, logup_denom_poly) = if !sum.is_empty() {\n        let evals = sum.to_host_on_current_stream()?;\n        let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n            evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n        if w.n.is_negative() {\n            let norm_factor = F::from_u32(1 << w.n.unsigned_abs()).inverse();\n            for s in &mut numer {\n                *s *= norm_factor;\n            }\n        }\n        let mut numer_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n        let mut denom_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n        for coset_idx in 0..num_cosets_logup {\n            for i in 0..1 << w.l_skip {\n                let src = (coset_idx << w.l_skip) + i;\n                let dst = i * num_cosets_logup + coset_idx;\n                numer_values[dst] = numer[src];\n                denom_values[dst] = denom[src];\n            }\n        }\n        let numer_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n            RowMajorMatrix::new(numer_values, num_cosets_logup),\n            omega_root,\n            F::ONE,\n        );\n        let denom_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n            RowMajorMatrix::new(denom_values, num_cosets_logup),\n            omega_root,\n            F::ONE,\n        );\n        (Some(numer_poly), Some(denom_poly))\n    } else {\n        (None, None)\n    };\n\n    Ok(Round0AirResult {\n        trace_idx: w.trace_idx,\n        zerocheck_poly,\n        logup_numer_poly,\n        logup_denom_poly,\n    })\n}\n\n#[allow(clippy::type_complexity)]","numLines":155,"startLine":120,"totalLines":1792}}}
