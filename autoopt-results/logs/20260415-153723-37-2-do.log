om_sum_init = EF::ZERO;\n74\t    for (interaction_idx, interaction) in symbolic.interactions.iter().enumerate() {\n75\t        let count_dag_idx =\n76\t            dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];\n77\t        let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n78\t        numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n79\t        denom_sum_init += eq_3bs[interaction_idx]\n80\t            * beta_pows[interaction.message.len()]\n81\t            * F::from_u32(interaction.bus_index as u32 + 1);\n82\t\n83\t        for (message_idx, message) in interaction.message.iter().enumerate() {\n84\t            let message_dag_idx =\n85\t                dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n86\t            let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n87\t            denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];\n88\t        }\n89\t    }\n90\t    let d_numer_weights = numer_weights.to_device()?;\n91\t    let d_denom_weights = denom_weights.to_device()?;\n92\t\n93\t    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n94\t    let d_rules = encoded_rules.to_device()?;\n95\t    let buffer_size: u32 = rules.buffer_size.try_into().unwrap();\n96\t\n97\t    Ok(LogupRulesOnDevice {\n98\t        d_rules,\n99\t        buffer_size,\n100\t        d_numer_weights,\n101\t        d_denom_weights,\n102\t        denom_sum_init,\n103\t    })\n104\t}\n105\t\n106\t/// Evaluate plain AIR constraints (not interactions) for a single AIR, given prepared trace input.\n107\t///\n108\t/// `num_cosets` should equal `constraint_degree - 1` because we evaluate the quotient polynomial.\n109\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n110\t#[allow(clippy::too_many_arguments)]\n111\tpub fn evaluate_round0_constraints_gpu<HS: GpuHashScheme>(\n112\t    pk: &DeviceStarkProvingKey<Generic