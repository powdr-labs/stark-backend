toopt-results/2026-04-13-1500-batch-stacking-scatter-kernel/report.md","autoopt-results/2026-04-13-1830-increase-multistream-thread-count/report.md","autoopt-results/2026-04-13-2100-prealloc-gkr-input-buffers/report.md","autoopt-results/2026-04-13-2300-batch-mle-round-kernels/report.md","autoopt-results/2026-04-13-prealloc-round0-buffers/report.md","autoopt-results/2026-04-13-1100-batch-mle-interpolation/report.md","autoopt-results/2026-04-13-1430-batch-mle-main-ptrs-upload/report.md","autoopt-results/2026-04-13-1600-batch-round0-descriptor-arrays/report.md","autoopt-results/2026-04-13-1700-batch-round0-caller-routing/report.md","autoopt-results/2026-04-13-1930-round0-interleaved-work-balance/report.md","autoopt-results/2026-04-13-2035-gkr-input-round-robin/report.md","autoopt-results/2026-04-13-2200-prealloc-round0-threshold-buffers/report.md","autoopt-results/2026-04-14-0030-rightsize-gkr-input-kernel-grid/report.md"],"durationMs":14,"numFiles":18,"truncated":false}}
