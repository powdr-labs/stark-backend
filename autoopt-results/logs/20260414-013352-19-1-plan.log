WARP_SIZE;\n286\t    dim3 grid = dim3(div_ceil(matrix_width, WARP_SIZE), row_indices_len);\n287\t    matrix_get_rows_fp_kernel<<<grid, block>>>(\n288\t        output, input, row_indices, matrix_width, matrix_height\n289\t    );\n290\t    return CHECK_KERNEL();\n291\t}\n292\t\n293\textern \"C\" int _split_ext_to_base_col_major_matrix(\n294\t    Fp *d_matrix,\n295\t    FpExt *d_poly,\n296\t    uint64_t poly_len,\n297\t    uint32_t matrix_height\n298\t) {\n299\t    auto [grid, block] = kernel_launch_params(matrix_height);\n300\t    split_ext_to_base_col_major_matrix_kernel<<<grid, block>>>(\n301\t        d_matrix, d_poly, poly_len, matrix_height\n302\t    );\n303\t    return CHECK_KERNEL();\n304\t}\n305\t\n306\textern \"C\" int _batch_rotate_pad(\n307\t    Fp *out,\n308\t    const Fp *in,\n309\t    uint32_t width,\n310\t    uint32_t num_x, // = (in.height() / domain_size)\n311\t    uint32_t domain_size,\n312\t    uint32_t padded_size\n313\t) {\n314\t    auto [grid, block] = kernel_launch_params(padded_size);\n315\t    auto num_poly = width * num_x;\n316\t    grid.y = std::min(num_poly, MAX_GRID_DIM);\n317\t    grid.z = (num_poly + grid.y - 1) / grid.y;\n318\t    batch_rotate_pad_kernel<<<grid, block>>>(out, in, width, num_x, domain_size, padded_size);\n319\t    return CHECK_KERNEL();\n320\t}\n321\t\n322\textern \"C\" int _lift_padded_matrix_evals(\n323\t    Fp *matrix,\n324\t    uint32_t width,\n325\t    uint32_t height,\n326\t    uint32_t lifted_height,\n327\t    uint32_t padded_height\n328\t) {\n329\t    auto [grid, block] = kernel_launch_2d_params(lifted_height, width);\n330\t    lift_padded_matrix_evals_kernel<<<grid, block>>>(\n331\t        matrix, width, height, lifted_height, padded_height\n332\t    );\n333\t    return CHECK_KERNEL();\n334\t}\n335\t\n336\textern \"C\" int _collapse_strided_matrix(\n337\t    Fp *out,\n338\t    const Fp *in,\n339\t    uint32_t width,\n340\t    uint32_t height,\n341\t    uint32_t stride\n342\t) {\n343\t    auto lifted_height = height * stride;\n344\t    auto [grid, block] = kernel_launch_2d_params(height, width);\n345\t    collapse_strided_matrix_kernel<<<grid, block>>>(out, in, width, lifted_height, height, stride);\n346\t    return CHECK_KERNEL();\n347\t}\n348\t\n349\textern \"C\" int _batch_expand_pad(\n350\t    Fp *out,\n351\t    const Fp *in,\n352\t    const uint32_t polyCount,\n353\t    const uint32_t outSize,\n354\t    const uint32_t inSize\n355\t) {\n356\t    auto [grid, block] = kernel_launch_params(outSize);\n357\t    batch_expand_pad_kernel<<<grid, block>>>(out, in, polyCount, outSize, inSize);\n358\t    return CHECK_KERNEL();\n359\t}\n360\t\n361\textern \"C\" int _batch_expand_pad_wide(\n362\t    Fp *out,\n363\t    const Fp *in,\n364\t    const uint32_t width,\n365\t    const uint32_t padded_height,\n366\t    const uint32_t height\n367\t) {\n368\t    auto [grid, block] = kernel_launch_params(padded_height);\n369\t    grid.y = std::min(width, MAX_GRID_DIM);\n370\t    grid.z = (width + grid.y - 1) / grid.y;\n371\t    assert(grid.z <= MAX_GRID_DIM);\n372\t    batch_expand_pad_wide_kernel<<<grid, block>>>(out, in, width, padded_height, height);\n373\t    return CHECK_KERNEL();\n374\t}\n375\t\n376\textern \"C\" int _stack_columns(\n377\t    const StackColDesc* descs,\n378\t    uint32_t num_descs\n379\t) {\n380\t    if (num_descs == 0) return 0;\n381\t    dim3 grid(num_descs);\n382\t    dim3 block(256);\n383\t    stack_columns_kernel<<<grid, block>>>(descs, num_descs);\n384\t    return CHECK_KERNEL();\n385\t}\n386\t"}]},"parent_tool_use_id":"toolu_01WhKcxCrSnULdJfiDTd4PUj","session_id":"c275100b-138e-43b1-b6e9-07f6d601a462","uuid":"77836cdd-6335-4c32-82f6-065d457d628d","timestamp":"2026-04-13T23:41:36.693Z"}
