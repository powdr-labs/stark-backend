{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uyfjka1GZYpS5BJ58XQMpk","type":"tool_result","content":"515\t__global__ void precompute_m_build_partial_kernel(\n516\t    const FracExt *__restrict__ pq,\n517\t    uint32_t rem_n,          // number of variables AFTER fold (folded rem_n)\n518\t    FpExt lambda,\n519\t    FpExt r_prev,            // challenge for the inline fold (only used when inline_fold=true)\n520\t    const FpExt *__restrict__ eq_tail_low,\n521\t    const FpExt *__restrict__ eq_tail_high,\n522\t    uint32_t log_eq_tail_low_cap,\n523\t    uint32_t tail_tile,\n524\t    FpExt *__restrict__ partial_out\n525\t) {\n526\t    constexpr uint32_t m = 1u << W;\n527\t    uint32_t u = threadIdx.y;\n528\t    uint32_t v = threadIdx.x;\n529\t    if (u >= m || v >= m) {\n530\t        return;\n531\t    }\n532\t\n533\t    uint32_t tail_n = rem_n - W;\n534\t    uint32_t k = 1u << tail_n;\n535\t    // When inline_fold: buffer has rem_n+1 variables (unfolded).\n536\t    // Otherwise: buffer has rem_n variables (already folded).\n537\t    uint32_t fold_half = inline_fold ? (1u << rem_n) : 0;\n538\t    uint32_t poly_stride = inline_fold ? (1u << (rem_n + 1)) : (1u << rem_n);\n539\t\n540\t    uint32_t b_start = blockIdx.x * tail_tile;\n541\t    uint32_t b_end = min(b_start + tail_tile, k);\n542\t\n543\t    // +1 padding avoids bank conflicts for power-of-2 m (m=8 → stride 9).\n544\t    constexpr uint32_t sh_stride = m + 1;\n545\t    extern __shared__ FpExt shmem[];\n546\t    FpExt *sh_left0 = shmem;\n547\t    FpExt *sh_left1 = sh_left0 + sh_stride * PRECOMPUTE_M_TAIL_BATCH;\n548\t    FpExt *sh_right0 = sh_left1 + sh_stride * PRECOMPUTE_M_TAIL_BATCH;\n549\t    FpExt *sh_right1 = sh_right0 + sh_stride * PRECOMPUTE_M_TAIL_BATCH;\n550\t    FpExt *sh_weight = sh_right1 + sh_stride * PRECOMPUTE_M_TAIL_BATCH;\n551\t\n552\t    FpExt zero(Fp::zero());\n553\t    FpExt acc = zero;\n554\t\n555\t    uint32_t lane = threadIdx.y * blockDim.x + threadIdx.x;\n556\t    uint32_t threads = blockDim.x * blockDim.y;\n557\t\n558\t    for (uint32_t b0 = b_start; b0 < b_end; b0 += PRECOMPUTE_M_TAIL_BATCH) {\n559\t        uint32_t batch = min(PRECOMPUTE_M_TAIL_BATCH, b_end - b0);\n560\t        uint32_t elems = batch * m;\n561\t\n562\t        // Phase 1: Load weights into shared memory.\n563\t        for (uint32_t bi = lane; bi < batch; bi += threads) {\n564\t            uint32_t b = b0 + bi;\n565\t            sh_weight[bi] = sqrt_buffer_get(\n566\t                eq_tail_low, eq_tail_high, log_eq_tail_low_cap, b\n567\t            );\n568\t        }\n569\t        __syncthreads();\n570\t\n571\t        // Phase 2: Load pq data, optionally fold inline by r_prev, and premultiply left0/left1 by weight.\n572\t        for (uint32_t idx = lane; idx < elems; idx += threads) {\n573\t            uint32_t beta = idx / batch;\n574\t            uint32_t bi = idx - beta * batch;\n575\t            uint32_t b = b0 + bi;\n576\t            uint32_t src = beta * k + b;\n577\t            FpExt p0, q0, p1, q1;\n578\t            if constexpr (inline_fold) {\n579\t                // Inline fold: val = lo + r_prev * (hi - lo) for each of {p0, q0, p1, q1}.\n580\t                FracExt const &f0_lo = pq[src];\n581\t                FracExt const &f0_hi = pq[src + fold_half];\n582\t                FracExt const &f1_lo = pq[poly_stride + src];\n583\t                FracExt const &f1_hi = pq[poly_stride + src + fold_half];\n584\t                p0 = f0_lo.p + r_prev * (f0_hi.p - f0_lo.p);\n585\t                q0 = f0_lo.q + r_prev * (f0_hi.q - f0_lo.q);\n586\t                p1 = f1_lo.p + r_prev * (f1_hi.p - f1_lo.p);\n587\t                q1 = f1_lo.q + r_prev * (f1_hi.q - f1_lo.q);\n588\t            } else {\n589\t                // Buffer already folded: read directly.\n590\t                FracExt const &f0 = pq[src];\n591\t                FracExt const &f1 = pq[poly_stride + src];\n592\t                p0 = f0.p; q0 = f0.q;\n593\t                p1 = f1.p; q1 = f1.q;\n594\t            }\n595\t            uint32_t sh_idx = bi * sh_stride + beta;\n596\t            FpExt wt = sh_weight[bi];\n597\t            sh_left0[sh_idx] = wt * (p0 + lambda * q0);\n598\t            sh_left1[sh_idx] = wt * p1;\n599\t            sh_right0[sh_idx] = q0;\n600\t            sh_right1[sh_idx] = q1;\n601\t        }\n602\t        __syncthreads();\n603\t\n604\t        // Phase 3: Accumulate with 2 muls per iteration (weight already folded in).\n605\t        for (uint32_t bi = 0; bi < batch; ++bi) {\n606\t            uint32_t row = bi * sh_stride;\n607\t            acc += sh_left0[row + u] * sh_right1[row + v]\n608\t                 + sh_left1[row + u] * sh_right0[row + v];\n609\t        }\n610\t\n611\t        __syncthreads();\n612\t    }\n613\t\n614\t    partial_out[blockIdx.x * (m * m) + u * m + v] = acc;\n615\t}\n616\t\n617\ttemplate <bool inline_fold, uint32_t W>\n618\tinline void launch_precompute_m_build_partial_kernel(\n619\t    dim3 grid,\n620\t    const FracExt *pq,\n621\t    uint32_t rem_n,\n622\t    FpExt lambda,\n623\t    FpExt r_prev,\n624\t    const FpExt *eq_tail_low,\n625\t    const FpExt *eq_tail_high,\n626\t    uint32_t log_eq_tail_low_cap,\n627\t    uint32_t tail_tile,\n628\t    FpExt *partial_out\n629\t) {\n630\t    constexpr uint32_t m = 1u << W;\n631\t    dim3 block(m, m);\n632\t    constexpr uint32_t sh_stride = m + 1;  // +1 padding to match kernel\n633\t    size_t shmem_bytes =\n634\t        (4 * sh_stride * PRECOMPUTE_M_TAIL_BATCH + PRECOMPUTE_M_TAIL_BATCH) * sizeof(FpExt);\n635\t    precompute_m_build_partial_kernel<inline_fold, W><<<grid, block, shmem_bytes>>>(\n636\t        pq,\n637\t        rem_n,\n638\t        lambda,\n639\t        r_prev,\n640\t        eq_tail_low,\n641\t        eq_tail_high,\n642\t        log_eq_tail_low_cap,\n643\t        tail_tile,\n644\t        partial_out\n645\t    );\n646\t}\n647\t\n648\ttemplate <bool inline_fold>\n649\tinline int launch_precompute_m_build_partial_dispatch(\n650\t    uint3