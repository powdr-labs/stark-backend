   air_offsets.push(0);\n300\t\n301\t        for (local_air, t) in traces.iter().enumerate() {\n302\t            let nb = t.num_y.div_ceil(threads_per_block);\n303\t            for b in 0..nb {\n304\t                block_ctxs_h.push(BlockCtx {\n305\t                    local_block_idx_x: b,\n306\t                    air_idx: local_air as u32,\n307\t                });\n308\t            }\n309\t            air_offsets.push(block_ctxs_h.len() as u32);\n310\t        }\n311\t\n312\t        // Build LogupCtx for each trace\n313\t        let mut intermediates_keepalive: Vec<DeviceBuffer<EF>> = Vec::new();\n314\t        let mut logup_ctxs_h: Vec<LogupCtx> = Vec::with_capacity(traces.len());\n315\t\n316\t        for t in traces.iter() {\n317\t            let air_pk = &pk.per_air[t.air_idx];\n318\t            let buffer_size = air_pk.other_data.interaction_rules.inner.buffer_size;\n319\t\n320\t            let d_intermediates = if buffer_size > 0 {\n321\t                let intermediates_len = unsafe {\n322\t                    _logup_batch_mle_intermediates_buffer_size(buffer_size, num_x, t.num_y)\n323\t                };\n324\t                let buf = DeviceBuffer::<EF>::with_capacity(intermediates_len);\n325\t                let ptr = buf.as_mut_ptr();\n326\t                intermediates_keepalive.push(buf);\n327\t                ptr\n328\t            } else {\n329\t                std::ptr::null_mut()\n330\t            };\n331\t\n332\t            let eval_ctx = EvalCoreCtx {\n333\t                d_selectors: t.sels_ptr,\n334\t                d_preprocessed: t.prep_ptr,\n335\t                d_main: t.main_ptrs_dev.as_ptr(),\n336\t                d_public: t.public_ptr,\n337\t            };\n338\t\n339\t            logup_ctxs_h.push(LogupCtx {\n340\t                eval_ctx,\n341\t                d_intermediates,\n342\t                num_y: t.num_y,\n343\t                d_eq_xi: t.eq_xi_ptr,\n344\t                d_challenges: d_challenges_ptr,\n345\t                d