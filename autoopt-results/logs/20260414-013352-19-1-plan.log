{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KYbYoFyWvchrgPbzpbFVGd","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    sync::Arc,\n15\t};\n16\t\n17\tuse itertools::{izip, Itertools};\n18\tuse openvm_cuda_common::{\n19\t    copy::{MemCopyD2H, MemCopyD2HStreamSync, MemCopyH2D},\n20\t    d_buffer::DeviceBuffer,\n21\t    error::MemCopyError,\n22\t    memory_manager::MemTracker,\n23\t    stream::current_stream_sync,\n24\t};\n25\tuse openvm_stark_backend::{\n26\t    air_builders::symbolic::SymbolicConstraints,\n27\t    calculate_n_logup,\n28\t    dft::Radix2BowersSerial,\n29\t    p3_matrix::dense::RowMajorMatrix,\n30\t    poly_common::{\n31\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n32\t        UnivariatePoly,\n33\t    },\n34\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n35\t    prover::{\n36\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n37\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n38\t        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n39\t    },\n40\t};\n41\tuse p3_dft::TwoAdicSubgroupDft;\n42\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n43\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n44\tuse rustc_hash::FxHashMap;\n45\tuse tracing::{debug, info, info_span, instrument};\n46\t\n47\tuse crate::{\n48\t    base::DeviceMatrix,\n49\t    cuda::{\n50\t        logup_zerocheck::{\n51\t            batched_interpolate_columns_gpu, fold_selectors_round0, InterpColDesc, MainMatrixPtrs,\n52\t        },\n53\t        sumcheck::batch_fold_mle,\n54\t    },\n55\t    data_transporter::transport_matrix_d2h_col_major,\n56\t    error::LogupZerocheckError,\n57\t    gpu_backend::GenericGpuBackend,\n58\t    hash_scheme::GpuHashScheme,\n59\t    cuda::logup_zerocheck::{\n60\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n61\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n62\t    },\n63\t    logup_zerocheck::{\n64\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n65\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n66\t    },\n67\t    poly::EqEvalLayers,\n68\t    prelude::{EF, F},\n69\t    sponge::GpuFiatShamirTranscript,\n70\t    utils::compute_barycentric_inv_lagrange_denoms,\n71\t};\n72\t\n73\tpub(crate) mod batch_mle;\n74\tpub(crate) mod batch_mle_monomial;\n75\tmod errors;\n76\tpub(crate) mod fold_ple;\n77\t/// Fraction sumcheck via GKR\n78\tmod fractional;\n79\t/// Logup interaction evaluations for GKR input\n80\tmod gkr_input;\n81\tmod mle_round;\n82\tmod round0;\n83\tpub(crate) mod rules;\n84\t\n85\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n86\tuse batch_mle_monomial::{\n87\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n88\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n89\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n90\t};\n91\tpub use errors::*;\n92\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n93\tuse gkr_input::{collect_trace_inte