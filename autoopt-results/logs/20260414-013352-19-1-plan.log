{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011FVjYJzXVsskiHLVQbWwg2","type":"tool_result","content":"1\t// GKR fractional sumcheck CUDA kernels. See docs/cuda-backend/gkr-prover.md (repo root)\n2\t// for the protocol and implementation details.\n3\t\n4\t#include \"fp.h\"\n5\t#include \"fpext.h\"\n6\t#include \"frac_ext.cuh\"\n7\t#include \"launcher.cuh\"\n8\t#include \"sumcheck.cuh\"\n9\t#include \"utils.cuh\"\n10\t#include <algorithm>\n11\t#include <cassert>\n12\t#include <cstddef>\n13\t#include <cstdint>\n14\t#include <cuda_runtime_api.h>\n15\t#include <driver_types.h>\n16\t#include <utility>\n17\t#include <vector_types.h>\n18\t\n19\t// Includes GKR for fractional sumcheck\n20\t// The LogUp specific input to GKR is calculated in interactions.cu\n21\tnamespace fractional_sumcheck_gkr {\n22\t// Degree of s' polynomial (factored out the first eq term)\n23\tconstexpr int GKR_SP_DEG = 2;\n24\t// ============================================================================\n25\t// KERNELS\n26\t// ============================================================================\n27\ttemplate <bool revert, bool apply_alpha = false>\n28\t__global__ void frac_build_tree_layer_kernel(\n29\t    FracExt *__restrict__ layer,\n30\t    uint32_t half,\n31\t    FpExt alpha = FpExt(Fp(0))\n32\t) {\n33\t    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;\n34\t    if (idx >= half) {\n35\t        return;\n36\t    }\n37\t\n38\t    if constexpr (apply_alpha) {\n39\t        // When applying alpha, we need to modify both operands before combining\n40\t        // Read both values, apply alpha to denominators, then combine\n41\t        FracExt lhs_val = layer[idx];\n42\t        FracExt rhs_val = layer[idx | half];\n43\t        lhs_val.q = lhs_val.q + alpha;\n44\t        rhs_val.q = rhs_val.q + alpha;\n45\t\n46\t        if constexpr (revert) {\n47\t            frac_unadd_inplace(lhs_val, rhs_val);\n48\t        } else {\n49\t            frac_add_inplace(lhs_val, rhs_val);\n50\t        }\n51\t\n52\t        layer[idx] = lhs_val;\n53\t    } else {\n54\t        // Original fast path: use references for in-place modification\n55\t        FracExt &lhs = layer[idx];\n56\t        FracExt const &rhs = layer[idx | half];\n57\t\n58\t        if constexpr (revert) {\n59\t            frac_unadd_inplace(lhs, rhs);\n60\t        } else {\n61\t            frac_add_inplace(lhs, rhs);\n62\t        }\n63\t    }\n64\t}\n65\t\n66\t// Reconstruct eq weight from sqrt-decomposed buffers.\n67\t// See docs/cuda-backend/gkr-prover.md § \"Eq buffer sqrt decomposition\".\n68\t__device__ __forceinline__ FpExt sqrt_buffer_get(\n69\t    const FpExt *__restrict__ eq_xi_low,\n70\t    const FpExt *__restrict__ eq_xi_high,\n71\t    uint32_t const log_eq_low_cap,\n72\t    uint32_t const idx\n73\t) {\n74\t    return eq_xi_low[idx & ((1u << log_eq_low_cap) - 1)] * eq_xi_high[idx >> log_eq_low_cap];\n75\t}\n76\t\n77\t// Accumulate GKR sumcheck contributions for s'_t(1) and s'_t(2).\n78\t// See docs/cuda-backend/gkr-prover.md § \"Sumcheck round implementation\".\n79\t__device__ __forceinline__ void accumulate_compute_contributions(\n80\t    const FpExt *__restrict__ eq_xi_low,\n81\t    const FpExt *__restrict__ eq_xi_high,\n82\t    uint32_t idx,\n83\t    uint32_t log_eq_low_cap,\n84\t    FpExt lambda,\n85\t    FpExt p0_even, FpExt q0_even, FpExt p0_odd, FpExt q0_odd,\n86\t    FpExt p1_even, FpExt q1_even, FpExt p1_odd, FpExt q1_odd,\n87\t    FpExt &local0, FpExt &local1\n88\t) {\n89\t    FpExt eq_val = sqrt_buffer_get(eq_xi_low, eq_xi_high, log_eq_low_cap, idx);\n90\t\n91\t    FpExt p0_diff = p0_odd - p0_even;\n92\t    FpExt q0_diff = q0_odd - q0_even;\n93\t    FpExt p1_diff = p1_odd - p1_even;\n94\t    FpExt q1_diff = q1_odd - q1_even;\n95\t\n96\t    FpExt p_j0 = p0_even + lambda * q0_even;\n97\t    FpExt q_j0 = q0_even;\n98\t    FpExt p_j1 = p1_even;\n99\t    FpExt q_j1 = q1_even;\n100\t"}]},"parent_tool_use_id":"toolu_01HAx7vVRMbJF73Vj4LHxEnc","session_id":"c275100b-138e-43b1-b6e9-07f6d601a462","uuid":"537a33f4-ac73-49ae-964d-bb2ee5ac6a9d","timestamp":"2026-04-13T23:41:21.266Z"}
