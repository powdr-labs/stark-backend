let src_pq_size = pq_size;\n1029\t                        prev_r = do_fused_sumcheck_round_inplace(\n1030\t                            &mut eq_buffer,\n1031\t                            active_pq,\n1032\t                            src_pq_size,\n1033\t                            lambda,\n1034\t                            prev_r,\n1035\t                            transcript,\n1036\t                            &mut d_sum_evals,\n1037\t                            &mut tmp_block_sums,\n1038\t                            &mut round_polys_eval,\n1039\t                            &mut r_vec,\n1040\t                            &mut prev_s_eval,\n1041\t                            xi_j,\n1042\t                            &mut eq_r_acc,\n1043\t                        )?;\n1044\t                        pq_size >>= 1;\n1045\t                    }\n1046\t                }\n1047\t\n1048\t                unsafe {\n1049\t                    fold_ef_frac_columns_inplace(active_pq, pq_size, prev_r)\n1050\t                        .map_err(FractionalSumcheckError::FoldColumns)?;\n1051\t                }\n1052\t                active = active_pq;\n1053\t                pq_size >>= 1;\n1054\t            }\n1055\t        }\n1056\t\n1057\t        let pq_host = [\n1058\t            copy_from_device(active, 0, &mut copy_scratch)?,\n1059\t            copy_from_device(active, pq_size / 2, &mut copy_scratch)?,\n1060\t        ];\n1061\t\n1062\t        claims_per_layer.push(GkrLayerClaims {\n1063\t            p_xi_0: pq_host[0].p,\n1064\t            q_xi_0: pq_host[0].q,\n1065\t            p_xi_1: pq_host[1].p,\n1066\t            q_xi_1: pq_host[1].q,\n1067\t        });\n1068\t\n1069\t        transcript.observe_ext(claims_per_layer[round].p_xi_0);\n1070\t        transcript.observe_ext(claims_per_layer[round].q_xi_0);\n1071\t        transcript.observe_ext(claims_per_layer[round].p_xi_1);\n1072\t        transcript.observe_ext(claims_per_layer[round].q_xi_1);\n1073\t\n1074\t        let mu = transcript.sample_ext();\n1075\t        xi_prev = [vec![mu], r_vec].concat();\n1076\t\n1077\t        sumcheck_polys.push(round_polys_eval);\n1078\t        gkr_round_span.exit();\n1079\t    }\n1080\t    mem.emit_metrics_with_label(\"frac_sumcheck.gkr_rounds\");\n1081\t    mem.tracing_info(\"after_fractional_sumcheck_gkr\");\n1082\t\n1083\t    Ok((\n1084\t        FracSumcheckProof {\n1085\t            fractional_sum: (root.p, root.q),\n1086\t            claims_per_layer,\n1087\t            sumcheck_polys,\n1088\t        },\n1089\t        xi_prev,\n1090\t    ))\n1091\t}\n1092\t\n1093\tfn copy_from_device<T: Copy>(\n1094\t    buf: &DeviceBuffer<T>,\n1095\t    index: usize,\n1096\t    scratch: &mut DeviceBuffer<T>,\n1097\t) -> Result<T, FractionalSumcheckError> {\n1098\t    debug_assert!(!scratch.is_empty());\n1099\t    unsafe {\n1100\t        cuda_memcpy::<true, true>(\n1101\t            scratch.as_mut_raw_ptr(),\n1102\t            buf.as_ptr().add(index) as *const std::ffi::c_void,\n1103\t            std::mem::size_of::<T>(),\n1104\t        )?;\n1105\t    }\n1106\t    let host = scratch.to_host()?;\n1107\t    Ok(host[0])\n1108\t}\n1109\t\n1110\t/// Reduces claims to a single evaluation point using linear interpolation.\n1111\tfn reduce_to_single_evaluation<SC: StarkProtocolConfig<EF = EF>>(\n1112\t    claims: &GkrLayerClaims<SC>,\n1113\t    mu: EF,\n1114\t) -> (EF, EF) {\n1115\t    let numer = interpolate_linear_at_01(&[claims.p_xi_0, claims.p_xi_1], mu);\n1116\t    let denom = interpolate_linear_at_01(&[claims.q_xi_0, claims.q_xi_1], mu);\n1117\t    (numer, denom)\n1118\t}\n1119\t\n1120\t/// Reconstructs the full s(1,2,3) evaluations from s'(1,2) evaluations returned by GPU.\n1121\t///\n1122\t/// Goal: compute s({1,2,3}) from s(X) = eq(xi_j, X) * s'(X).\n1123\t/// Reconstruct the full round polynomial s_t from GPU-computed s'_t(1), s'_t(2).\n1124\t///\n1125\t/// See `docs/cuda-backend/gkr-prover.md` § \"Sumcheck round implementation\" for the derivation.\n1126\tfn reconstruct_s_evals(\n1127\t    d_sum_evals: &DeviceBuffer<EF>,\n1128\t    prev_s_eval: EF,\n1129\t    xi_j: EF,\n1130\t    eq_r_acc: EF,\n1131\t) -> Result<([EF; GKR_S_DEG], [EF; GKR_S_DEG]), FractionalSumcheckError> {\n1132\t    let sp_vec = d_sum_evals.to_host()?;\n1133\t    debug_assert_eq!(sp_vec.len(), GKR_S_DEG - 1);\n1134\t\n1135\t    // sp_evals holds evaluations of degree 2 poly `eq(xi_{j+1..}, r_{j+1..}) * s'(X)` at {0,1,2}\n1136\t    let mut sp_evals = [EF::ZERO; GKR_S_DEG];\n1137\t    sp_evals[1] = sp_vec[0] * eq_r_acc;\n1138\t    sp_evals[2] = sp_vec[1] * eq_r_acc;\n1139\t\n1140\t    // We use that s_j(0) + s_j(1) = s_{j-1}(r_{j-1})\n1141\t    // s_j(X) = eq(xi_j, X) * sp_j(X)\n1142\t    // s_j(0) = (1 - xi_j) * sp_j(0)\n1143\t    // s_j(1) = xi_j * sp_j(1)\n1144\t    // So: (1 - xi_j) * sp_j(0) + xi_j * sp_j(1) = prev_s_eval\n1145\t    // xi_j is randomly sampled so 1 - xi_j should be invertible\n1146\t    let eq_xi_0 = EF::ONE - xi_j;\n1147\t    debug_assert_ne!(eq_xi_0, EF::ZERO);\n1148\t    let eq_xi_1 = xi_j;\n1149\t    sp_evals[0] = (prev_s_eval - eq_xi_1 * sp_evals[1]) * eq_xi_0.inverse();\n1150\t\n1151\t    let s_evals: [EF; GKR_S_DEG] = from_fn(|i| {\n1152\t        // evaluate s at X = i + 1 (skip 0 evaluation)\n1153\t        let x = EF::from_usize(i + 1);\n1154\t        let sp_eval = if i < GKR_S_DEG - 1 {\n1155\t            sp_evals[i + 1]\n1156\t        } else {\n1157\t            interpolate_quadratic_at_012(&sp_evals, x)\n1158\t        };\n1159\t        eval_eq_mle(&[xi_j], &[x]) * sp_eval\n1160\t    });\n1161\t\n1162\t    Ok((s_evals, sp_evals))\n1163\t}\n1164\t\n1165\t/// Generate random fractional leaves on device for benchmarking.\n1166\tpub fn make_synthetic_leaves(n: usize) -> Result<DeviceBuffer<Frac<EF>>, FractionalSumcheckError> {\n1167\t    use openvm_cuda_common::copy::cuda_memcpy;\n1168\t    use rand::{rngs::StdRng, Rng, SeedableRng};\n1169\t\n1170\t    let size = 1usize << n;\n1171\t    let mut rng = StdRng::seed_from_u64(42);\n1172\t    let host: Vec<(EF, EF)> = (0..size)\n1173\t        .map(|_| (rng.random::<EF>(), rng.random::<EF>()))\n1174\t        .collect();\n1175\t    let d_leaves = DeviceBuffer::<Frac<EF>>::with_capacity(size);\n1176\t    unsafe {\n1177\t        cuda_memcpy::<false, true>(\n1178\t            d_leaves.as_mut_raw_ptr(),\n1179\t            host.as_ptr() as *const std::ffi::c_void,\n1180\t            std::mem::size_of_val(host.as_slice()),\n1181\t        )?;\n1182\t    }\n1183\t    Ok(d_leaves)\n1184\t}\n1185\t\n1186\t#[cfg(test)]\n1187\tmod tests {"}]},"parent_tool_use_id":"toolu_01HAx7vVRMbJF73Vj4LHxEnc","session_id":"c275100b-138e-43b1-b6e9-07f6d601a462","uuid":"d340cc3d-9329-4448-bf13-2aeeec77a345","timestamp":"2026-04-13T23:41:18.820Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S4Ej4PGQ794igCF7wuTiPt","type":"tool_result","content":"1\t#include \"fp.h\"\n2\t#include \"fpext.h\"\n3\t#include \"launcher.cuh\"\n4\t#include \"sumcheck.cuh\"\n5\t#include <algorithm>\n6\t#include <cstddef>\n7\t#include <cstdint>\n8\t#include <utility>\n9\t#include <vector_types.h>\n10\t\n11\tnamespace {\n12\tconstexpr int S_DEG = 2;\n13\t}\n14\t\n15\tstruct BatchingTracePacket {\n16\t    const Fp *__restrict__ ptr;\n17\t    uint32_t height;\n18\t    uint32_t width;\n19\t    uint32_t stacked_row_start;\n20\t    uint32_t mu_idx;\n21\t};\n22\t\n23\t/// Algebraically batch _unstacked_ traces to get equivalent behavior to stacking traces and then algebraically batching stacked columns.\n24\t__global__ void whir_algebraic_batch_traces_kernel(\n25\t    Fp *__restrict__ output,                         // Length is stacked_height\n26\t    const BatchingTracePacket *__restrict__ packets, // packets, one per unstacked trace\n27\t    const FpExt *mu_powers,                          // Len is sum of widths of all matrices\n28\t    size_t stacked_height,\n29\t    size_t num_packets,\n30\t    uint32_t skip_domain\n31\t) {\n32\t\n33\t    size_t row = blockIdx.x * blockDim.x + threadIdx.x;\n34\t    if (row >= stacked_height) {\n35\t        return;\n36\t    }\n37\t\n38\t    // NOTE(perf): Depending on the number of columns, we may want to use shared memory to reduce this sum.\n39\t    FpExt res(Fp::zero());\n40\t    for (int idx = 0; idx < num_packets; idx++) {\n41\t        auto packet = packets[idx];\n42\t        auto trace = packet.ptr;\n43\t        uint32_t height = packet.height;\n44\t        uint32_t lifted_height = std::max(height, skip_domain);\n45\t        uint32_t width = packet.width;\n46\t        uint32_t row_start = packet.stacked_row_start;\n47\t        uint32_t mu_idx_start = packet.mu_idx;\n48\t        uint32_t stride = std::max(skip_domain / height, 1u);\n49\t        // Determine if there are entries between `row_start..row_start + lifted_height * width (mod stacked_height)` that equal `row`\n50\t        // This is the same as all `offset` satisfying\n51\t        // row_start <= offset * stacked_height + row < row_start + lifted_height * width\n52\t        auto stacked_end = row_start + lifted_height * width;\n53\t        if (row >= stacked_end)\n54\t            continue;\n55\t        uint32_t offset_start = row_start <= row ? 0 : 1;\n56\t        for (uint32_t row_offset = offset_start * stacked_height + row; row_offset < stacked_end;\n57\t             row_offset += stacked_height) {\n58\t            auto offset = (row_offset - row) / stacked_height;\n59\t            uint32_t tmp = row_offset - row_start; // < lifted_height * width\n60\t            uint32_t trace_col = tmp / lifted_height;\n61\t            uint32_t strided_trace_row = tmp % lifted_height;\n62\t            // match the striding that happens in stacking matrix\n63\t            auto trace_val = strided_trace_row % stride == 0\n64\t                                 ? trace[trace_col * height + (strided_trace_row / stride)]\n65\t                                 : Fp::zero();\n66\t            auto mu_pow = mu_powers[mu_idx_start + offset];\n67\t            res += mu_pow * trace_val;\n68\t        }\n69\t    }\n70\t#pragma unroll\n71\t    for (int i = 0; i < 4; i++) {\n72\t        output[i * stacked_height + row] = res.elems[i];\n73\t    }\n74\t}\n75\t\n76\t// Computes one WHIR sumcheck round using:\n77\t// - `f` in MLE coefficient form\n78\t// - `w` in moment form: m[T] = sum_{x superset T} w(x)\n79\t//\n80\t// For X in {1,2}, this evaluates\n81\t// s(X) = sum_y f(X,y) * w(X,y)\n82\t// with pairwise formulas derived from coefficient/moment slices.\n83\t__global__ void whir_sumcheck_coeff_moments_round_kernel(\n84\t    const FpExt *f_coeffs,\n85\t    const FpExt *w_moments,\n86\t    FpExt *block_sums,\n87\t    const uint32_t height\n88\t) {\n89\t    extern __shared__ char smem[];\n90\t    FpExt *shared = (FpExt *)smem;\n91\t\n92\t    int half_height = height >> 1;\n93\t\n94\t    FpExt local_sums[S_DEG];\n95\t\n96\t#pragma unroll\n97\t    for (int i = 0; i < S_DEG; i++) {\n98\t        local_sums[i] = FpExt(0);\n99\t    }\n100\t\n101\t    for (int y = blockIdx.x * blockDim.x + threadIdx.x; y < half_height;\n102\t         y += gridDim.x * blockDim.x) {\n103\t        int idx0 = y << 1;\n104\t        int idx1 = idx0 + 1;\n105\t\n106\t        FpExt c0 = f_coeffs[idx0];\n107\t        FpExt c1 = f_coeffs[idx1];\n108\t        FpExt m0 = w_moments[idx0];\n109\t        FpExt m1 = w_moments[idx1];\n110\t\n111\t        // X = 1:\n112\t        // f_1 = c0 + c1\n113\t        // w_1 moments reduce to m1\n114\t        FpExt f_1 = c0 + c1;\n115\t        FpExt term_1 = f_1 * m1;\n116\t\n117\t        // X = 2:\n118\t        // f_2 = c0 + 2*c1\n119\t        // w_2 moments: -m0 + 3*m1\n120\t        FpExt f_2 = c0 + c1 + c1;\n121\t        FpExt m_2 = m1 * Fp(3) - m0;\n122\t        FpExt term_2 = f_2 * m_2;\n123\t\n124\t        local_sums[0] += term_1;\n125\t        local_sums[1] += term_2;\n126\t    }\n127\t\n128\t#pragma unroll\n129\t    for (int idx = 0; idx < S_DEG; idx++) {\n130\t        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n131\t        if (threadIdx.x == 0) {\n132\t            block_sums[blockIdx.x * S_DEG + idx] = reduced;\n133\t        }\n134\t        __syncthreads();\n135\t    }\n136\t}\n137\t\n138\t// Folds both:\n139\t// - `f` in MLE coefficient form\n140\t// - `w` in moment form m[T] = sum_{x superset T} w(x)\n141\t__global__ void whir_fold_coeffs_and_moments_kernel(\n142\t    const FpExt *f_coeffs,\n143\t    const FpExt *w_moments,\n144\t    FpExt *f_folded_coeffs,\n145\t    FpExt *w_folded_moments,\n146\t    FpExt alpha,\n147\t    uint32_t half_height\n148\t) {\n149\t    uint32_t y = blockIdx.x * blockDim.x + threadIdx.x;\n150\t    if (y >= half_height) {\n151\t        return;\n152\t    }\n153\t\n154\t    uint32_t idx0 = y << 1;\n155\t    uint32_t idx1 = idx0 + 1;\n156\t\n157\t    FpExt c0 = f_coeffs[idx0];\n158\t    FpExt c1 = f_coeffs[idx1];\n159\t    f_folded_coeffs[y] = c0 + alpha * c1;\n160\t\n161\t    FpExt m0 = w_moments[idx0];\n162\t    FpExt m1 = w_moments[idx1];\n163\t    FpExt one_minus_alpha = FpExt(Fp(1)) - alpha;\n164\t    FpExt two_alpha_minus_one = alpha + alpha - FpExt(Fp(1));\n165\t    w_folded_moments[y] = one_minus_alpha * m0 + two_alpha_minus_one * m1;\n166\t}\n167\t\n168\t__device__ __forceinline__ FpExt whir_pow_from_pows2_ext(\n169\t    const FpExt *pows2,\n170\t    uint32_t log_height,\n171\t    uint32_t exponent\n172\t) {\n173\t    FpExt acc = FpExt(Fp(1));\n174\t    for (uint32_t bit = 0; bit < log_height; bit++) {\n175\t        if (exponent & (1u << bit)) {\n176\t            acc *= pows2[bit];\n177\t        }\n178\t    }\n179\t    return acc;\n180\t}\n181\t\n182\t__device__ __forceinline__ Fp whir_pow_from_pows2_base(\n183\t    const Fp *pows2,\n184\t    uint32_t log_height,\n185\t    uint32_t exponent\n186\t) {\n187\t    Fp acc = Fp(1);\n188\t    for (uint32_t bit = 0; bit < log_height; bit++) {\n189\t        if (exponent & (1u << bit)) {\n190\t            acc *= pows2[bit];\n191\t        }\n192\t    }\n193\t    return acc;\n194\t}\n195\t\n196\t__global__ void w_moments_accumulate_kernel(\n197\t    FpExt *w_moments,\n198\t    const FpExt *z0_pows2, // [log_height], where z0_pows2[i] = z0^(2^i)\n199\t    const Fp *z_pows2,     // [num_queries][log_height], row-major\n200\t    FpExt gamma,\n201\t    uint32_t num_queries,\n202\t    uint32_t log_height,\n203\t    uint32_t height\n204\t) {\n205\t    size_t row = blockIdx.x * blockDim.x + threadIdx.x;\n206\t    if (row >= height) {\n207\t        return;\n208\t    }\n209\t\n210\t    uint32_t exponent = static_cast<uint32_t>(row);\n211\t\n212\t    FpExt acc = gamma * whir_pow_from_pows2_ext(z0_pows2, log_height, exponent);\n213\t    FpExt gamma_pow = gamma;\n214\t    for (uint32_t i = 0; i < num_queries; i++) {\n215\t        gamma_pow *= gamma;\n216\t        const Fp *query_pows2 = z_pows2 + i * log_height;\n217\t        Fp z_i_pow = whir_pow_from_pows2_base(query_pows2, log_height, exponent);\n218\t        acc += gamma_pow * z_i_pow;\n219\t    }\n220\t    w_moments[row] += acc;\n221\t}\n222\t\n223\t// ============================================================================\n224\t// LAUNCHERS\n225\t// ============================================================================\n226\t\n227\textern \"C\" int _whir_algebraic_batch_traces(\n228\t    Fp *output, // Length is stacked_height\n229\t    const BatchingTracePacket *packets,\n230\t    const FpExt *mu_powers, // Len is sum of widths of all matrices\n231\t    size_t stacked_height,\n232\t    size_t num_packets,\n233\t    uint32_t skip_domain\n234\t) {\n235\t    auto [grid, block] = kernel_launch_params(stacked_height);\n236\t    whir_algebraic_batch_traces_kernel<<<grid, block>>>(\n237\t        output, packets, mu_powers, stacked_height, num_packets, skip_domain\n238\t    );\n239\t    return CHECK_KERNEL();\n240\t}\n241\t\n242\tinline std::pair<dim3, dim3> whir_sumcheck_coeff_moments_launch_params(uint32_t height) {\n243\t    return kernel_launch_params(height >> 1, 256);\n244\t}\n245\t\n246\textern \"C\" uint32_t _whir_sumcheck_coeff_moments_required_temp_buffer_size(uint32_t height) {\n247\t    auto [grid, block] = whir_sumcheck_coeff_moments_launch_params(height);\n248\t    return grid.x * S_DEG;\n249\t}\n250\t\n251\textern \"C\" int _whir_sumcheck_coeff_moments_round(\n252\t    const FpExt *f_coeffs,\n253\t    const FpExt *w_moments,\n254\t    FpExt *output,         // Output: [d=2] final results\n255\t    FpExt *tmp_block_sums, // Temporary buffer: [num_blocks * d]\n256\t    const uint32_t height\n257\t) {\n258\t    auto [grid, block] = whir_sumcheck_coeff_moments_launch_params(height);\n259\t    unsigned int num_warps = (block.x + WARP_SIZE - 1) / WARP_SIZE;\n260\t    size_t shmem_bytes = std::max(1u, num_warps) * sizeof(FpExt);\n261\t\n262\t    whir_sumcheck_coeff_moments_round_kernel<<<grid, block, shmem_bytes>>>(\n263\t        f_coeffs, w_moments, tmp_block_sums, height\n264\t    );\n265\t\n266\t    int err = CHECK_KERNEL();\n267\t    if (err != 0)\n268\t        return err;\n269\t\n270\t    auto num_blocks = grid.x;\n271\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n272\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n273\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n274\t    sumcheck::static_final_reduce_block_sums<S_DEG>\n275\t        <<<S_DEG, reduce_block, reduce_shmem>>>(tmp_block_sums, output, num_blocks);\n276\t\n277\t    return CHECK_KERNEL();\n278\t}\n279\t\n280\textern \"C\" int _whir_fold_coeffs_and_moments(\n281\t    const FpExt *f_coeffs,\n282\t    const FpExt *w_moments,\n283\t    FpExt *f_folded_coeffs,\n284\t    FpExt *w_folded_moments,\n285\t    FpExt alpha,\n286\t    uint32_t height\n287\t) {\n288\t    auto [grid, block] = kernel_launch_params(height >> 1);\n289\t    whir_fold_coeffs_and_moments_kernel<<<grid, block>>>(\n290\t        f_coeffs, w_moments, f_folded_coeffs, w_folded_moments, alpha, height >> 1\n291\t    );\n292\t    return CHECK_KERNEL();\n293\t}\n294\t\n295\textern \"C\" int _w_moments_accumulate(\n296\t    FpExt *w_moments,\n297\t    const FpExt *z0_pows2,\n298\t    const Fp *z_pows2,\n299\t    FpExt gamma,\n300\t    uint32_t num_queries,\n301\t    uint32_t log_height,\n302\t    uint32_t height\n303\t) {\n304\t    auto [grid, block] = kernel_launch_params(height, 256);\n305\t    w_moments_accumulate_kernel<<<grid, block>>>(\n306\t        w_moments, z0_pows2, z_pows2, gamma, num_queries, log_height, height\n307\t    );\n308\t    return CHECK_KERNEL();\n309\t}\n310\t"}]},"parent_tool_use_id":"toolu_01U7QTyK5hhwcd8zioYW3qDA","session_id":"c275100b-138e-43b1-b6e9-07f6d601a462","uuid":"a5cf47ed-0e4e-43cf-9650-f5620cca3f64","timestamp":"2026-04-13T23:41:18.417Z"}
