{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Exay3N5mj4cRTMR4RteBLE","type":"tool_result","content":"1\tuse openvm_cuda_common::{\n2\t    d_buffer::DeviceBuffer,\n3\t    error::{check, CudaError},\n4\t};\n5\t\n6\tuse crate::{\n7\t    poly::EqEvalSegments,\n8\t    prelude::{D_EF, EF, F},\n9\t    stacked_reduction::{UnstackedSlice, STACKED_REDUCTION_S_DEG},\n10\t};\n11\t\n12\t/// Number of G outputs per z in round 0: G0, G1, G2\n13\tpub const NUM_G: usize = 3;\n14\t\n15\textern \"C\" {\n16\t    pub fn _stacked_reduction_r0_required_temp_buffer_size(\n17\t        trace_height: u32,\n18\t        trace_width: u32,\n19\t        l_skip: u32,\n20\t    ) -> u32;\n21\t\n22\t    // SP_DEG=1: no z_packets needed, outputs [NUM_G * skip_domain] to be ADDed\n23\t    fn _stacked_reduction_sumcheck_round0(\n24\t        eq_r_ns: *const EF,\n25\t        trace_ptr: *const F,\n26\t        lambda_pows: *const EF,\n27\t        block_sums: *mut EF,\n28\t        output: *mut EF,\n29\t        trace_height: u32,\n30\t        trace_width: u32,\n31\t        l_skip: u32,\n32\t        num_x: u32,\n33\t    ) -> i32;\n34\t\n35\t    fn _stacked_reduction_fold_ple(\n36\t        src: *const F,\n37\t        dst: *mut EF,\n38\t        omega_skip_pows: *const F,\n39\t        inv_lagrange_denoms: *const EF,\n40\t        trace_height: u32,\n41\t        trace_width: u32,\n42\t        l_skip: u32,\n43\t    ) -> i32;\n44\t\n45\t    fn _initialize_k_rot_from_eq_segments(\n46\t        eq_r_ns: *const EF,\n47\t        k_rot_ns: *mut EF,\n48\t        k_rot_uni_0: EF,\n49\t        k_rot_uni_1: EF,\n50\t        max_n: u32,\n51\t    ) -> i32;\n52\t\n53\t    fn _stacked_reduction_sumcheck_mle_round(\n54\t        q_evals: *const *const EF,\n55\t        eq_r_ns: *const EF,\n56\t        k_rot_ns: *const EF,\n57\t        unstacked_cols: *const UnstackedSlice,\n58\t        lambda_pows: *const EF,\n59\t        output: *mut u64, // atomic accumulator [S_DEG * D_EF]\n60\t        q_height: u32,\n61\t        window_len: u32,\n62\t        num_y: u32,\n63\t        sm_count: u32,\n64\t    ) -> i32;\n65\t\n66\t    fn _stacked_reduction_sumcheck_mle_round_degenerate(\n67\t        q_evals: *const *const EF,\n68\t        eq_ub_ptr: *const EF,\n69\t        eq_r: EF,\n70\t        k_rot_r: EF,\n71\t        unstacked_cols: *const UnstackedSlice,\n72\t        lambda_pows: *const EF,\n73\t        output: *mut u64, // atomic accumulator [S_DEG * D_EF]\n74\t        q_height: u32,\n75\t        window_len: u32,\n76\t        l_skip: u32,\n77\t        round: u32,\n78\t    ) -> i32;\n79\t}\n80\t\n81\t/// SP_DEG=1 round 0 kernel: computes G0, G1, G2 partial sums on identity coset only.\n82\t///\n83\t/// This kernel computes three partial sums per z-coordinate:\n84\t/// - G0(Z) = Σ_{col,x} coeff_eq[col] * eq_cube(x) * q_{col,x}(Z)\n85\t/// - G1(Z) = Σ_{col,x} coeff_rot[col] * eq_cube(x) * q_{col,x}(Z)\n86\t/// - G2(Z) = Σ_{col,x} coeff_rot[col] * (eq_cube(rot_prev(x)) - eq_cube(x)) * q_{col,x}(Z)\n87\t///\n88\t/// The reconstruction s₀(Z) = E0(Z)*G0(Z) + E1(Z)*G1(Z) + E2(Z)*G2(Z) happens on CPU.\n89\t///\n90\t/// The reduction is done in two stages:\n91\t/// 1. Block-level reduction to `block_sums` (shared memory within block)\n92\t/// 2. Final reduction kernel that ADDs block sums into `output` (for bucket accumulation)\n93\t///\n94\t/// # Safety\n95\t/// - `trace_ptr` must be a pointer to a device buffer valid for `height * width` elements.\n96\t/// - `lambda_pows` should be pointer to DeviceBuffer<EF>, at an offset.\n97\t///   - `lambda_pows` must be initialized for at least `2 * window_len` elements (for rotations).\n98\t/// - `block_sums` should have length `>= _stacked_reduction_r0_required_temp_buffer_size(...)`.\n99\t/// - `output` should have length `>= NUM_G * 2^l_skip` and be zero-initialized before first call.\n100\t///   Values are ADDED to output for bucket-based accumulation.\n101\t#[allow(clippy::too_many_arguments)]\n102\tpub unsafe fn stacked_reduction_sumcheck_round0(\n103\t    eq_r_ns: &EqEvalSegments<EF>,\n104\t    trace_ptr: *const F,\n105\t    lambda_pows: *const EF,\n106\t    block_sums: &mut DeviceBuffer<EF>,\n107\t    output: &mut DeviceBuffer<EF>,\n108\t    height: usize,\n109\t    width: usize,\n110\t    l_skip: usize,\n111\t) -> Result<(), CudaError> {\n112\t    let output_size = NUM_G << l_skip;\n113\t    let num_x = (height >> l_skip).max(1) as u32;\n114\t    debug_assert!(output.len() >= output_size);\n115\t\n116\t    check(_stacked_reduction_sumcheck_round0(\n117\t        eq_r_ns.buffer().as_ptr(),\n118\t        trace_ptr,\n119\t        lambda_pows,\n120\t        block_sums.as_mut_ptr(),\n121\t        output.as_mut_ptr(),\n122\t        height as u32,\n123\t        width as u32,\n124\t        l_skip as u32,\n125\t        num_x,\n126\t    ))\n127\t}\n128\t\n129\t/// Parallelizes barycentric interpolation across `2^l_skip` threads per cell.\n130\t///\n131\t/// Each kernel launch handles one trace. The caller should loop over traces and call this for each.\n132\t///\n133\t/// # Safety\n134\t/// - `src` must be a device pointer valid for `trace_height * trace_width` Fp elements.\n135\t/// - `dst` must be a device pointer valid for `new_height * trace_width` FpExt elements, where\n136\t///   `new_height = max(trace_height, 2^l_skip) / 2^l_skip`.\n137\t/// - `src` and `dst` memory regions must not overlap.\n138\t/// - `omega_skip_pows` must have length `>= 2^l_skip`.\n139\t/// - `inv_lagrange_denoms` must have length `>= 2^l_skip`.\n140\t/// - `l_skip` must be in range [0, 10] (skip_domain = 2^l_skip must be in [1, 1024]).\n141\t#[allow(clippy::too_many_arguments)]\n142\tpub unsafe fn stacked_reduction_fold_ple(\n143\t    src: *const F,\n144\t    dst: *mut EF,\n145\t    omega_skip_pows: &DeviceBuffer<F>,\n146\t    inv_lagrange_denoms: &DeviceBuffer<EF>,\n147\t    trace_height: usize,\n148\t    trace_width: usize,\n149\t    l_skip: usize,\n150\t) -> Result<(), CudaError> {\n151\t    let skip_domain = 1 << l_skip;\n152\t    debug_assert!(omega_skip_pows.len() >= skip_domain);\n153\t    debug_assert!(inv_lagrange_denoms.len() >= skip_domain);\n154\t    check(_stacked_reduction_fold_ple(\n155\t        src,\n156\t        dst,\n157\t        omega_skip_pows.as_ptr(),\n158\t        inv_lagrange_denoms.as_ptr(),\n159\t        trace_height as u32,\n160\t        trace_width as u32,\n161\t        l_skip as u32,\n162\t    ))\n163\t}\n164\t\n165\t/// Initializes the `k_rot` evaluations after round 0 for `n = 0..=max_n`.\n166\t///\n167\t/// # Safety\n168\t/// - `eq_r_ns` and `k_rot_ns` should both have length `2 * 2^max_n` and be arranged in segments.\n169\t/// - This function will not initialize `k_rot_ns[0]`. This entry should never be used, and it is\n170\t///   the caller's responsibility to initialize it if needed.\n171\tpub unsafe fn initialize_k_rot_from_eq_segments(\n172\t    eq_r_ns: &EqEvalSegments<EF>,\n173\t    k_rot_ns: &mut DeviceBuffer<EF>,\n174\t    k_rot_uni_0: EF,\n175\t    k_rot_uni_1: EF,\n176\t    max_n: u32,\n177\t) -> Result<(), CudaError> {\n178\t    debug_assert_eq!(eq_r_ns.buffer.len(), 2 << max_n);\n179\t    debug_assert_eq!(k_rot_ns.len(), eq_r_ns.buffer.len());\n180\t\n181\t    check(_initialize_k_rot_from_eq_segments(\n182\t        eq_r_ns.buffer.as_ptr(),\n183\t        k_rot_ns.as_mut_ptr(),\n184\t        k_rot_uni_0,\n185\t        k_rot_uni_1,\n186\t        max_n,\n187\t    ))\n188\t}\n189\t\n190\t/// Analog of [stacked_reduction_sumcheck_round0] for MLE sumcheck rounds.\n191\t/// One important distinction is that `k_rot_ns` needs to be provided separately from `eq_r_ns`, but\n192\t/// in the same segmented memory layout.\n193\t///\n194\t/// Uses warp-aggregated atomics for reduction into u64 accumulators. The caller is responsible for\n195\t/// zero-initializing `output` before calling and reducing modulo P after kernel completion.\n196\t///\n197\t/// # Safety\n198\t/// - `q_evals` must be pointers to DeviceBuffer<EF> matrices all of the same height `q_height`.\n199\t/// - `unstacked_cols` should be pointer to DeviceBuffer<UnstackedSlice>, at an offset.\n200\t///   - `unstacked_cols` must be initialized for at least `window_len` elements.\n201\t///   - for each `UnstackedSlice` in the `window_len` elements starting at `unstacked_cols`, the\n202\t///     `log_height` must all be the same and the `stacked_row_idx` must be a multiple of\n203\t///     `2^l_skip`.\n204\t/// - `lambda_pows` should be pointer to DeviceBuffer<EF>, at an offset.\n205\t///   - `lambda_pows` must be initialized for at least `2 * window_len` elements (for rotations).\n206\t/// - `unstacked_cols` pointers must be within bounds of `q_evals`.\n207\t/// - `output` must have length at least `S_DEG * D_EF = 8` and be zero-initialized.\n208\t#[allow(clippy::too_many_arguments)]\n209\tpub unsafe fn stacked_reduction_sumcheck_mle_round(\n210\t    q_evals: &DeviceBuffer<*const EF>,\n211\t    eq_r_ns: &EqEvalSegments<EF>,\n212\t    k_rot_ns: &EqEvalSegments<EF>,\n213\t    unstacked_cols: *const UnstackedSlice,\n214\t    lambda_pows: *const EF,\n215\t    output: &mut DeviceBuffer<u64>,\n216\t    q_height: usize,\n217\t    window_len: usize,\n218\t    num_y: usize,\n219\t    sm_count: u32,\n220\t) -> Result<(), CudaError> {\n221\t    debug_assert!(output.len() >= STACKED_REDUCTION_S_DEG * D_EF);\n222\t\n223\t    check(_stacked_reduction_sumcheck_mle_round(\n224\t        q_evals.as_ptr(),\n225\t        eq_r_ns.buffer.as_ptr(),\n226\t        k_rot_ns.buffer.as_ptr(),\n227\t        unstacked_cols,\n228\t        lambda_pows,\n229\t        output.as_mut_ptr(),\n230\t        q_height as u32,\n231\t        window_len as u32,\n232\t        num_y as u32,\n233\t        sm_count,\n234\t    ))\n235\t}\n236\t\n237\t/// Degenerate case for MLE sumcheck rounds.\n238\t///\n239\t/// Uses warp-aggregated atomics for reduction into u64 accumulators. The caller is responsible for\n240\t/// zero-initializing `output` before calling and reducing modulo P after kernel completion.\n241\t///\n242\t/// # Safety\n243\t/// - `output` must have length at least `S_DEG * D_EF = 8` and be zero-initialized.\n244\t#[allow(clippy::too_many_arguments)]\n245\tpub unsafe fn stacked_reduction_sumcheck_mle_round_degenerate(\n246\t    q_evals: &DeviceBuffer<*const EF>,\n247\t    eq_ub_ptr: &DeviceBuffer<EF>,\n248\t    eq_r: EF,\n249\t    k_rot_r: EF,\n250\t    unstacked_cols: *const UnstackedSlice,\n251\t    lambda_pows: *const EF,\n252\t    output: &mut DeviceBuffer<u64>,\n253\t    q_height: usize,\n254\t    window_len: usize,\n255\t    l_skip: usize,\n256\t    round: usize,\n257\t) -> Result<(), CudaError> {\n258\t    debug_assert!(output.len() >= STACKED_REDUCTION_S_DEG * D_EF);\n259\t\n260\t    check(_stacked_reduction_sumcheck_mle_round_degenerate(\n261\t        q_evals.as_ptr(),\n262\t        eq_ub_ptr.as_ptr(),\n263\t        eq_r,\n264\t        k_rot_r,\n265\t        unstacked_cols,\n266\t        lambda_pows,\n267\t        output.as_mut_ptr(),\n268\t        q_height as u32,\n269\t        window_len as u32,\n270\t        l_skip as u32,\n271\t        round as u32,\n272\t    ))\n273\t}\n274\t"}]},"parent_tool_use_id":"toolu_01SeTLnTpTP2utWGdF6zBvEU","session_id":"f75a9bb0-08dc-4cc2-8653-93cb45f6f821","uuid":"70f3ca2f-e798-4b47-b349-570b96ea3cfe","timestamp":"2026-04-10T18:17:00.485Z"}
