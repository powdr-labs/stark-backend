{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FWLhR5eNZmTkpPaQDhhNvh","type":"tool_result","content":"1\tuse std::{array::from_fn, cmp::max, ffi::c_void, iter::zip, mem, sync::Arc};\n2\t\n3\tuse itertools::{zip_eq, Itertools};\n4\tuse openvm_cuda_common::{\n5\t    copy::{cuda_memcpy, MemCopyD2H, MemCopyH2D},\n6\t    d_buffer::DeviceBuffer,\n7\t    memory_manager::MemTracker,\n8\t};\n9\tuse openvm_stark_backend::{\n10\t    dft::Radix2BowersSerial,\n11\t    p3_matrix::dense::RowMajorMatrix,\n12\t    poly_common::{\n13\t        eq_uni_poly, eval_eq_mle, eval_eq_uni, eval_eq_uni_at_one, eval_in_uni, Squarable,\n14\t        UnivariatePoly,\n15\t    },\n16\t    proof::StackingProof,\n17\t    prover::{\n18\t        stacked_pcs::StackedLayout, sumcheck::sumcheck_round0_deg, DeviceMultiStarkProvingKey,\n19\t        MatrixDimensions, ProvingContext,\n20\t    },\n21\t};\n22\tuse p3_dft::TwoAdicSubgroupDft;\n23\tuse p3_field::{PrimeCharacteristicRing, TwoAdicField};\n24\tuse tracing::{debug, info_span, instrument};\n25\t\n26\tuse crate::{\n27\t    base::DeviceMatrix,\n28\t    cuda::{\n29\t        batch_ntt_small::ensure_device_ntt_twiddles_initialized,\n30\t        poly::vector_scalar_multiply_ext,\n31\t        stacked_reduction::{\n32\t            _stacked_reduction_r0_required_temp_buffer_size,\n33\t            batched_stacked_reduction_sumcheck_mle_round,\n34\t            batched_stacked_reduction_sumcheck_mle_round_degenerate,\n35\t            compute_mle_launch_params, initialize_k_rot_from_eq_segments,\n36\t            stacked_reduction_fold_ple, stacked_reduction_sumcheck_round0, DegenMleDesc,\n37\t            NonDegenMleDesc, NUM_G,\n38\t        },\n39\t        sumcheck::{fold_mle, triangular_fold_mle},\n40\t    },\n41\t    gpu_backend::GenericGpuBackend,\n42\t    hash_scheme::GpuHashScheme,\n43\t    poly::EqEvalSegments,\n44\t    prelude::{Digest, D_EF, EF, F},\n45\t    sponge::GpuFiatShamirTranscript,\n46\t    stacked_pcs::StackedPcsDataGpu,\n47\t    utils::{compute_barycentric_inv_lagrange_denoms, reduce_raw_u64_to_ef},\n48\t    GpuDevice, StackedReductionError,\n49\t};\n50\t\n51\t/// Degree of the sumcheck polynomial for stacked reduction.\n52\tpub const STACKED_REDUCTION_S_DEG: usize = 2;\n53\t\n54\tpub struct StackedReductionGpu<D = Digest> {\n55\t    sm_count: u32,\n56\t\n57\t    l_skip: usize,\n58\t    n_stack: usize,\n59\t\n60\t    omega_skip: F,\n61\t    omega_skip_pows: Vec<F>,\n62\t    d_omega_skip_pows: DeviceBuffer<F>,\n63\t\n64\t    r_0: EF,\n65\t    d_lambda_pows: DeviceBuffer<EF>,\n66\t    eq_const: EF,\n67\t\n68\t    pub(crate) stacked_per_commit: Vec<StackedPcsData2<D>>,\n69\t    d_q_widths: DeviceBuffer<u32>,\n70\t    q_width_max: u32,\n71\t    d_q_eval_ptrs: DeviceBuffer<*const EF>,\n72\t\n73\t    trace_ptrs: Vec<(\n74\t        *const F, /* trace_ptr */\n75\t        usize,    /* height */\n76\t        usize,    /* width */\n77\t    )>,\n78\t    unstacked_cols: Vec<UnstackedSlice>,\n79\t    d_unstacked_cols: DeviceBuffer<UnstackedSlice>,\n80\t    // boundary indices where heights change. all columns between two boundaries must have the same\n81\t    // height. We can have multiple chunks of the same height if that is needed to reduce peak GPU\n82\t    // memory.\n83\t    ht_diff_idxs: Vec<usize>,\n84\t    n_max: usize,\n85\t\n86\t    // Initially holds eq(r[1..=n], H_n) for n=0..=n_max but gets updated after each sumcheck round\n87\t    // by some custom folding\n88\t    eq_r_ns: EqEvalSegments<EF>,\n89\t\n90\t    // == After round 0 ==\n91\t    q_evals: Vec<DeviceBuffer<EF>>, // get width from stacked_per_commit\n92\t    // Stores folded eq values that won't change anymore (no more folding)\n93\t    // Corresponds to log_height in 0..l_skip+round-1 _before_ round `round`. Gets updated with one\n94\t    // new element after each round.\n95\t    eq_stable: Vec<EF>,\n96\t    k_rot_stable: Vec<EF>,\n97\t\n98\t    /// Stores the folded k_rot evaluations for `\\kappa_\\rot(x, r) = eq_n(rot^{-1}(x), r)` for each\n99\t    /// `n` after each round. We use the [EqEvalSegments] type to guard the segment-based\n100\t    /// memory layout.\n101\t    k_rot_ns: EqEvalSegments<EF>,\n102\t    /// Stores eq(u[1+n_T..round-1], b_{T,j}[..round-n_T-1])\n103\t    eq_ub_per_trace: Vec<EF>,\n104\t    d_eq_ub_all: DeviceBuffer<EF>,\n105\t\n106\t    d_block_sums: DeviceBuffer<EF>,\n107\t    d_accum: DeviceBuffer<u64>,\n108\t    d_input_ptrs: DeviceBuffer<*const EF>,\n109\t    d_output_ptrs: DeviceBuffer<*mut EF>,\n110\t\n111\t    mem: MemTracker,\n112\t}\n113\t\n114\t/// A struct for holding stacked pcs data. We only need the `MerkleTreeGpu` from `StackedPcsDataGpu`\n115\t/// but we wrap the latter in an `Arc` to provide uniformity in dealing with common main and\n116\t/// preprocessed/cached traces. This struct stores the unstacked `traces`, in prismalinear\n117\t/// evaluation form, corresponding to the stacked pcs data.\n118\t///\n119\t/// Generic over the Merkle digest type `D`.  The default `D = Digest` preserves the existing\n120\t/// BabyBear-Poseidon2 behaviour.\n121\tpub struct StackedPcsData2<D = Digest> {\n122\t    pub(crate) inner: Arc<StackedPcsDataGpu<F, D>>,\n123\t    /// The unstacked traces corresponding to `inner`'s commitment.\n124\t    pub(crate) traces: Vec<DeviceMatrix<F>>,\n125\t}\n126\t\n127\timpl<D> StackedPcsData2<D> {\n128\t    /// # Safety\n129\t    /// `traces` must be the traces that were committed to in `pcs_data`.\n130\t    pub unsafe fn from_raw(\n131\t        pcs_data: Arc<StackedPcsDataGpu<F, D>>,\n132\t        traces: Vec<DeviceMatrix<F>>,\n133\t    ) -> Self {\n134\t        Self {\n135\t            inner: pcs_data,\n136\t            traces,\n137\t        }\n138\t    }\n139\t\n140\t    pub fn layout(&self) -> &StackedLayout {\n141\t        &self.inner.layout\n142\t    }\n143\t}\n144\t\n145\t/// Pointer with length to location in a big device buffer. The device buffer is identified by\n146\t/// `commit_idx`. Due to pecuarlities with `l_skip`, the length of the slice is defined as\n147\t/// `max(2^log_height, 2^l_skip)`. In other words, this is a pointer to the slice\n148\t/// `q[commit_idx].column(stacked_col_idx)[stacked_row_idx..stacked_row_idx + len]`.\n149\t///\n150\t/// # Safety\n151\t/// - this type is `repr(C)` as it will cross FFI boundaries for CUDA usage.\n152\t#[repr(C)]\n153\t#[derive(Clone, Copy, Debug)]\n154\tpub(crate) struct UnstackedSlice {\n155\t    commit_idx: u32,\n156\t    log_height: u32,\n157\t    stacked_row_idx: u32,\n158\t    stacked_col_idx: u32,\n159\t}\n160\t\n161\timpl<D> StackedReductionGpu<D> {\n162\t    fn log_stacked_height(&self, round: usize) -> usize {\n163\t        self.n_stack - (round - 1)\n164\t    }\n165\t\n166\t    fn stacked_height(&self, round: usize) -> usize {\n167\t        1 << self.log_stacked_height(round)\n168\t    }\n169\t\n170\t    /// Current maximum `n` supported by eq_r_ns\n171\t    fn cur_max_n(&self, round: usize) -> usize {\n172\t        self.n_max - (round - 1)\n173\t    }\n174\t}\n175\t\n176\t/// Batch sumcheck to reduce trace openings, including rotations, to stacked matrix opening.\n177\t///\n178\t/// The `stacked_matrix, stacked_layout` should be the result of stacking the `traces` with\n179\t/// parameters `l_skip` and `n_stack`.\n180\t#[allow(clippy::type_complexity)]\n181\t#[instrument(\n182\t    name = \"prover.openings.stacked_reduction\",\n183\t    level = \"info\",\n184\t    skip_all,\n185\t    fields(phase = \"prover\")\n186\t)]\n187\tpub fn prove_stacked_opening_reduction_gpu<HS, TS>(\n188\t    device: &GpuDevice,\n189\t    transcript: &mut TS,\n190\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n191\t    ctx: ProvingContext<GenericGpuBackend<HS>>,\n192\t    common_main_pcs_data: StackedPcsDataGpu<F, HS::Digest>,\n193\t    r: &[EF],\n194\t) -> Result<\n195\t    (\n196\t        StackingProof<HS::SC>,\n197\t        Vec<EF>,\n198\t        Vec<StackedPcsData2<HS::Digest>>,\n199\t    ),\n200\t    StackedReductionError,\n201\t>\n202\twhere\n203\t    HS: GpuHashScheme,\n204\t    TS: GpuFiatShamirTranscript<HS::SC>,\n205\t{\n206\t    let n_stack = device.config.n_stack;\n207\t    // Batching randomness\n208\t    let lambda = transcript.sample_ext();\n209\t\n210\t    let _round0_span =\n211\t        info_span!(\"prover.openings.stacked_reduction.round0\", phase = \"prover\").entered();\n212\t    let mut prover = StackedReductionGpu::new::<HS>(\n213\t        mpk,\n214\t        ctx,\n215\t        common_main_pcs_data,\n216\t        r,\n217\t        lambda,\n218\t        device.sm_count(),\n219\t    )?;\n220\t\n221\t    // Round 0: univariate sumcheck\n222\t    let s_0 = prover.batch_sumcheck_uni_round0_poly()?;\n223\t    for &coeff in s_0.coeffs() {\n224\t        transcript.observe_ext(coeff);\n225\t    }\n226\t\n227\t    let mut u_vec = Vec::with_capacity(n_stack + 1);\n228\t    let u_0 = transcript.sample_ext();\n229\t    u_vec.push(u_0);\n230\t    debug!(round = 0, u_round = %u_0);\n231\t\n232\t    prover.fold_ple_evals(u_0)?;\n233\t    drop(_round0_span);\n234\t    // end round 0\n235\t\n236\t    let mut sumcheck_round_polys = Vec::with_capacity(n_stack);\n237\t\n238\t    // Rounds 1..=n_stack: MLE sumcheck\n239\t    let _mle_rounds_span = info_span!(\n240\t        \"prover.openings.stacked_reduction.mle_rounds\",\n241\t        phase = \"prover\"\n242\t    )\n243\t    .entered();\n244\t    #[allow(clippy::needless_range_loop)]\n245\t    for round in 1..=n_stack {\n246\t        let batch_s_evals = prover.batch_sumcheck_poly_eval(round, u_vec[round - 1])?;\n247\t\n248\t        for &eval in &batch_s_evals {\n249\t            transcript.observe_ext(eval);\n250\t        }\n251\t        sumcheck_round_polys.push(batch_s_evals);\n252\t\n253\t        let u_round = transcript.sample_ext();\n254\t        u_vec.push(u_round);\n255\t        debug!(%round, %u_round);\n256\t\n257\t        prover.fold_mle_evals(round, u_round)?;\n258\t    }\n259\t    let stacking_openings = prover.get_stacked_openings()?;\n260\t    for claims_for_com in &stacking_openings {\n261\t        for &claim in claims_for_com {\n262\t            transcript.observe_ext(claim);\n263\t        }\n264\t    }\n265\t    drop(_mle_rounds_span);\n266\t    let proof = StackingProof {\n267\t        univariate_round_coeffs: s_0.into_coeffs(),\n268\t        sumcheck_round_polys,\n269\t        stacking_openings,\n270\t    };\n271\t    Ok((proof, u_vec, prover.stacked_per_commit))\n272\t}\n273\t\n274\timpl<D: Copy + Clone + Send + Sync + 'static> StackedReductionGpu<D> {\n275\t    #[instrument(\"stacked_reduction_new\", level = \"debug\", skip_all)]\n276\t    fn new<HS: GpuHashScheme<Digest = D>>(\n277\t        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n278\t        ctx: ProvingContext<GenericGpuBackend<HS>>,\n279\t        common_main_pcs_data: StackedPcsDataGpu<F, D>,\n280\t        r: &[EF],\n281\t        lambda: EF,\n282\t        sm_count: u32,\n283\t    ) -> Result<Self, StackedReductionError> {\n284\t        ensure_device_ntt_twiddles_initialized();\n285\t        let mem = MemTracker::start(\"prover.stacked_reduction_new\");\n286\t        let l_skip = mpk.params.l_skip;\n287\t        let n_stack = mpk.params.n_stack;\n288\t\n289\t        let omega_skip = F::two_adic_generator(l_skip);\n290\t        let omega_skip_pows = omega_skip.powers().take(1 << l_skip).collect_vec();\n291\t        let d_omega_skip_pows = omega_skip_pows.to_device()?;\n292\t\n293\t        // NOTE: DeviceMatrix contains an Arc, so clone is lightweight [for now].\n294\t        // PERF[jpw]: stack the traces all at once. To save memory, we could either stack and drop\n295\t        // traces as we go or even at commit time only store the stacked matrix and drop the traces\n296\t        // much earlier.\n297\t        let common_main_traces = ctx\n298\t            .per_trace\n299\t            .iter()\n300\t            .map(|(_, air_ctx)| air_ctx.common_main.clone())\n301\t            .collect_vec();\n302\t        // SAFETY: common_main_traces commits to common_main_pcs_data\n303\t        let common_main_stacked = unsafe {\n304\t            StackedPcsData2::from_raw(Arc::new(common_main_pcs_data), common_main_traces)\n305\t        };\n306\t        let mut stacked_per_commit = vec![common_main_stacked];\n307\t        for (air_idx, air_ctx) in ctx.per_trace.iter() {\n308\t            for committed in mpk.per_air[*air_idx]\n309\t                .preprocessed_data\n310\t                .iter()\n311\t                .chain(air_ctx.cached_mains.iter())\n312\t            {\n313\t                // SAFETY: committed.trace commits to committed.data\n314\t                let stacked = unsafe {\n315\t                    StackedPcsData2::from_raw(committed.data.clone(), vec![committed.trace.clone()])\n316\t                };\n317\t                stacked_per_commit.push(stacked);\n318\t            }\n319\t        }\n320\t\n321\t        debug_assert!(stacked_per_commit\n322\t            .iter()\n323\t            .all(|d| d.layout().height() == 1 << (l_skip + n_stack)));\n324\t\n325\t        let need_rot_per_trace = ctx\n326\t            .per_trace\n327\t            .iter()\n328\t            .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n329\t            .collect_vec();\n330\t        let mut need_rot_per_commit = vec![need_rot_per_trace];\n331\t        for (air_idx, air_ctx) in ctx.per_trace.iter() {\n332\t            let need_rot = mpk.per_air[*air_idx].vk.params.need_rot;\n333\t            if mpk.per_air[*air_idx].preprocessed_data.is_some() {\n334\t                need_rot_per_commit.push(vec![need_rot]);\n335\t            }\n336\t            for _ in &air_ctx.cached_mains {\n337\t                need_rot_per_commit.push(vec![need_rot]);\n338\t            }\n339\t        }\n340\t        let q_widths = stacked_per_commit\n341\t            .iter()\n342\t            .map(|d| d.layout().width() as u32)\n343\t            .collect_vec();\n344\t        let q_width_max = *q_widths.iter().max().unwrap();\n345\t        let d_q_widths = q_widths.to_device()?;\n346\t\n347\t        let total_num_cols: usize = stacked_per_commit\n348\t            .iter()\n349\t            .map(|d| d.layout().sorted_cols.len())\n350\t            .sum();\n351\t        let mut unstacked_cols = Vec::with_capacity(total_num_cols);\n352\t        let mut need_rot_per_col = Vec::with_capacity(total_num_cols);\n353\t        let mut ht_diff_idxs = Vec::new();\n354\t        let mut trace_ptrs = Vec::new();\n355\t        for (commit_idx, stacked) in stacked_per_commit.iter().enumerate() {\n356\t            let layout = stacked.layout();\n357\t            let need_rot_for_commit = &need_rot_per_commit[commit_idx];\n358\t            debug_assert_eq!(need_rot_for_commit.len(), layout.mat_starts.len());\n359\t            for (mat_idx, (trace, &idx)) in zip_eq(&stacked.traces, &layout.mat_starts).enumerate()\n360\t            {\n361\t                debug_assert_ne!(trace.width(), 0);\n362\t                debug_assert_ne!(trace.height(), 0);\n363\t                ht_diff_idxs.push(unstacked_cols.len());\n364\t                trace_ptrs.push((trace.buffer().as_ptr(), trace.height(), trace.width()));\n365\t                let need_rot = need_rot_for_commit[mat_idx];\n366\t                for j in 0..trace.width() {\n367\t                    let (_, _j, s) = layout.sorted_cols[idx + j];\n368\t                    debug_assert_eq!(_j, j);\n369\t                    debug_assert_eq!(1 << s.log_height(), trace.height());\n370\t                    unstacked_cols.push(UnstackedSlice {\n371\t                        commit_idx: commit_idx as u32,\n372\t                        log_height: s.log_height() as u32,\n373\t                        stacked_row_idx: s.row_idx as u32,\n374\t                        stacked_col_idx: s.col_idx as u32,\n375\t                    });\n376\t                    need_rot_per_col.push(need_rot);\n377\t                }\n378\t            }\n379\t        }\n380\t        debug_assert_eq!(unstacked_cols.len(), total_num_cols);\n381\t        ht_diff_idxs.push(unstacked_cols.len());\n382\t\n383\t        let lambda_pows_used = lambda.powers().take(total_num_cols * 2).collect_vec();\n384\t        let mut lambda_pows = vec![EF::ZERO; total_num_cols * 2];\n385\t        for (col_idx, need_rot) in need_rot_per_col.into_iter().enumerate() {\n386\t            let lambda_eq_idx = 2 * col_idx;\n387\t            let lambda_rot_idx = 2 * col_idx + 1;\n388\t            lambda_pows[lambda_eq_idx] = lambda_pows_used[lambda_eq_idx];\n389\t            if need_rot {\n390\t                lambda_pows[lambda_rot_idx] = lambda_pows_used[lambda_rot_idx];\n391\t            }\n392\t        }\n393\t        let d_lambda_pows = lambda_pows.to_device()?;\n394\t\n395\t        let d_unstacked_cols = unstacked_cols.to_device()?;\n396\t\n397\t        // layout per commit is sorted, first height is largest\n398\t        let n_max = r.len() - 1;\n399\t        debug_assert_eq!(\n400\t            n_max,\n401\t            stacked_per_commit\n402\t                .iter()\n403\t                .map(|d| d.layout().sorted_cols[0].2.log_height())\n404\t                .max()\n405\t                .unwrap_or(0)\n406\t                .saturating_sub(l_skip)\n407\t        );\n408\t        let eq_r_ns =\n409\t            EqEvalSegments::new(&r[1..]).map_err(StackedReductionError::EqEvalSegments)?;\n410\t\n411\t        let eq_const = eval_eq_uni_at_one(l_skip, r[0] * omega_skip);\n412\t        let eq_ub_per_trace = vec![EF::ONE; unstacked_cols.len()];\n413\t        let d_q_eval_ptrs = if stacked_per_commit.is_empty() {\n414\t            DeviceBuffer::new()\n415\t        } else {\n416\t            DeviceBuffer::with_capacity(stacked_per_commit.len())\n417\t        };\n418\t        let d_input_ptrs = if stacked_per_commit.is_empty() {\n419\t            DeviceBuffer::new()\n420\t        } else {\n421\t            DeviceBuffer::with_capacity(stacked_per_commit.len())\n422\t        };\n423\t        let d_output_ptrs = if stacked_per_commit.is_empty() {\n424\t            DeviceBuffer::new()\n425\t        } else {\n426\t            DeviceBuffer::with_capacity(stacked_per_commit.len())\n427\t        };\n428\t        let d_accum = DeviceBuffer::<u64>::with_capacity(STACKED_REDUCTION_S_DEG * D_EF);\n429\t        let d_eq_ub_all = if unstacked_cols.is_empty() {\n430\t            DeviceBuffer::new()\n431\t        } else {\n432\t            DeviceBuffer::with_capacity(unstacked_cols.len())\n433\t        };\n434\t\n435\t        Ok(Self {\n436\t            sm_count,\n437\t            l_skip,\n438\t            n_stack,\n439\t            omega_skip,\n440\t            omega_skip_pows,\n441\t            d_omega_skip_pows,\n442\t            r_0: r[0],\n443\t            d_lambda_pows,\n444\t            eq_const,\n445\t            stacked_per_commit,\n446\t            d_q_widths,\n447\t            q_width_max,\n448\t            d_q_eval_ptrs,\n449\t            trace_ptrs,\n450\t            unstacked_cols,\n451\t            d_unstacked_cols,\n452\t            ht_diff_idxs,\n453\t            n_max,\n454\t            eq_r_ns,\n455\t            q_evals: vec![],\n456\t            eq_stable: vec![],\n457\t            k_rot_stable: vec![],\n458\t            // SAFETY: This is unused in round 0 and will be initialized properly after round 0.\n459\t            k_rot_ns: unsafe { EqEvalSegments::from_raw_parts(DeviceBuffer::new(), 0) },\n460\t            eq_ub_per_trace,\n461\t            d_eq_ub_all,\n462\t            d_block_sums: DeviceBuffer::new(),\n463\t            d_accum,\n464\t            d_input_ptrs,\n465\t            d_output_ptrs,\n466\t            mem,\n467\t        })\n468\t    }\n469\t\n470\t    /// SP_DEG=1 round 0: computes G0, G1, G2 on identity coset, then reconstructs s_0 on CPU.\n471\t    ///\n472\t    /// Key insight: Instead of computing s₀(Z) directly on 2 cosets with in-kernel NTT,\n473\t    /// we compute three partial sums G0, G1, G2 on the identity coset only, then\n474\t    /// reconstruct s₀ via CPU-side NTT-based polynomial multiplication.\n475\t    #[instrument(\n476\t        \"stacked_reduction_sumcheck\",\n477\t        level = \"debug\",\n478\t        skip_all,\n479\t        fields(round = 0)\n480\t    )]\n481\t    fn batch_sumcheck_uni_round0_poly(\n482\t        &mut self,\n483\t    ) -> Result<UnivariatePoly<EF>, StackedReductionError> {\n484\t        let l_skip = self.l_skip;\n485\t        let skip_domain = 1 << l_skip;\n486\t        let s_0_deg = sumcheck_round0_deg(l_skip, STACKED_REDUCTION_S_DEG);\n487\t\n488\t        // Accumulation buffers for G0, G1, G2 (on identity coset)\n489\t        // d_g_pos: for n >= 0 traces\n490\t        let mut d_g_pos = DeviceBuffer::<EF>::with_capacity(NUM_G * skip_domain);\n491\t        d_g_pos\n492\t            .fill_zero()\n493\t            .map_err(StackedReductionError::FillZero)?;\n494\t\n495\t        // d_g_neg[k]: for traces with |n| = k+1, where n < 0 and k in 0..l_skip\n496\t        let mut d_g_neg: Vec<DeviceBuffer<EF>> = (0..l_skip)\n497\t            .map(|_| {\n498\t                let b = DeviceBuffer::with_capacity(NUM_G * skip_domain);\n499\t                b.fill_zero().map_err(StackedReductionError::FillZero)?;\n500\t                Ok(b)\n501\t            })\n502\t            .collect::<Result<Vec<_>, StackedReductionError>>()?;\n503\t\n504\t        // Process each trace - call kernel for each, accumulating into appropriate bucket\n505\t        for ((trace_ptr, trace_height, trace_width), window) in zip(\n506\t            mem::take(&mut self.trace_ptrs),\n507\t            self.ht_diff_idxs.windows(2),\n508\t        ) {\n509\t            debug_assert_eq!(window[1] - window[0], trace_width);\n510\t            let log_height = trace_height.ilog2();\n511\t            let n = log_height as isize - l_skip as isize;\n512\t\n513\t            // Select output bucket based on n\n514\t            let d_g_output = if n >= 0 {\n515\t                &mut d_g_pos\n516\t            } else {\n517\t                &mut d_g_neg[(-n - 1) as usize]\n518\t            };\n519\t\n520\t            // Allocate block_sums buffer for intermediate reduction\n521\t            let block_sums_len = unsafe {\n522\t                _stacked_reduction_r0_required_temp_buffer_size(\n523\t                    trace_height as u32,\n524\t                    trace_width as u32,\n525\t                    l_skip as u32,\n526\t                )\n527\t            } as usize;\n528\t\n529\t            if block_sums_len > self.d_block_sums.len() {\n530\t                self.d_block_sums = DeviceBuffer::<EF>::with_capacity(block_sums_len);\n531\t            }\n532\t\n533\t            unsafe {\n534\t                // 2 per column for (eq, k_rot) - coeff_eq and coeff_rot\n535\t                let lambda_pows_ptr = self.d_lambda_pows.as_ptr().add(2 * window[0]);\n536\t\n537\t                stacked_reduction_sumcheck_round0(\n538\t                    &self.eq_r_ns,\n539\t                    trace_ptr,\n540\t                    lambda_pows_ptr,\n541\t                    &mut self.d_block_sums,\n542\t                    d_g_output,\n543\t                    trace_height,\n544\t                    trace_width,\n545\t                    l_skip,\n546\t                )\n547\t                .map_err(StackedReductionError::SumcheckRound0)?;\n548\t            };\n549\t        }\n550\t\n551\t        // CPU reconstruction: s₀(Z) = E0(Z)*G0(Z) + E1(Z)*G1(Z) + E2(Z)*G2(Z)\n552\t        let s_0 = self.reconstruct_s0_from_g(d_g_pos, d_g_neg, s_0_deg)?;\n553\t        self.mem.tracing_info(\"stacked_reduction_sumcheck round 0\");\n554\t\n555\t        Ok(s_0)\n556\t    }\n557\t\n558\t    /// Reconstructs s_0 from G0, G1, G2 using NTT-based polynomial multiplication.\n559\t    ///\n560\t    /// For n >= 0:\n561\t    /// - E0(Z) = eq_uni(l_skip, Z, r0)\n562\t    /// - E1(Z) = eq_uni(l_skip, Z, r0*ω_skip)\n563\t    /// - E2(Z) = eq_const * eq_uni_at_one(l_skip, Z)\n564\t    ///\n565\t    /// For n < 0: multiply each E by ind(Z) = eval_in_uni(l_skip, n, Z)\n566\t    fn reconstruct_s0_from_g(\n567\t        &self,\n568\t        d_g_pos: DeviceBuffer<EF>,\n569\t        d_g_neg: Vec<DeviceBuffer<EF>>,\n570\t        s_0_deg: usize,\n571\t    ) -> Result<UnivariatePoly<EF>, StackedReductionError> {\n572\t        let l_skip = self.l_skip;\n573\t        let skip_domain = 1 << l_skip;\n574\t        let large_uni_domain = (s_0_deg + 1).next_power_of_two(); // 2 * skip_domain\n575\t        let dft = Radix2BowersSerial;\n576\t\n577\t        // Accumulate s_0 coefficients across all buckets\n578\t        let mut s_0_coeffs = vec![EF::ZERO; large_uni_domain];\n579\t\n580\t        // --- Process n >= 0 bucket ---\n581\t        let g_pos = d_g_pos.to_host()?;\n582\t        if !g_pos.iter().all(|&x| x == EF::ZERO) {\n583\t            // Build E polynomials for n >= 0\n584\t            let e0 = eq_uni_poly::<F, EF>(l_skip, self.r_0);\n585\t            let e1 = eq_uni_poly::<F, EF>(l_skip, self.r_0 * self.omega_skip);\n586\t            let e2 = eq_uni_at_one_poly(l_skip, self.eq_const);\n587\t\n588\t            // NTT-based multiplication: s_0 += E0*G0 + E1*G1 + E2*G2\n589\t            Self::ntt_multiply_and_add(\n590\t                &dft,\n591\t                large_uni_domain,\n592\t                [e0.coeffs(), e1.coeffs(), e2.coeffs()],\n593\t                [\n594\t                    &g_pos[0..skip_domain],\n595\t                    &g_pos[skip_domain..2 * skip_domain],\n596\t                    &g_pos[2 * skip_domain..3 * skip_domain],\n597\t                ],\n598\t                &mut s_0_coeffs,\n599\t            );\n600\t        }\n601\t\n602\t        // --- Process n < 0 buckets ---\n603\t        for (bucket_idx, d_g_neg_bucket) in d_g_neg.into_iter().enumerate() {\n604\t            let n_abs = bucket_idx + 1;\n605\t            let g_neg = d_g_neg_bucket.to_host()?;\n606\t            if g_neg.iter().all(|&x| x == EF::ZERO) {\n607\t                continue;\n608\t            }\n609\t\n610\t            // Adjusted parameters for n < 0\n611\t            let l = l_skip - n_abs;\n612\t            let omega_l = self.omega_skip.exp_power_of_2(n_abs);\n613\t            let r_uni = self.r_0.exp_power_of_2(n_abs);\n614\t\n615\t            // Build E polynomials with indicator factor\n616\t            let ind = build_indicator_poly(l_skip, -(n_abs as isize));\n617\t            let e0_base = eq_uni_poly::<F, EF>(l, r_uni);\n618\t            let e1_base = eq_uni_poly::<F, EF>(l, r_uni * omega_l);\n619\t            let e2_base = eq_uni_at_one_poly(l, self.eq_const);\n620\t\n621\t            // E_neg = E_base * ind (polynomial multiplication)\n622\t            let e0_neg = poly_multiply_ntt(&dft, e0_base.coeffs(), ind.coeffs(), skip_domain);\n623\t            let e1_neg = poly_multiply_ntt(&dft, e1_base.coeffs(), ind.coeffs(), skip_domain);\n624\t            let e2_neg = poly_multiply_ntt(&dft, e2_base.coeffs(), ind.coeffs(), skip_domain);\n625\t\n626\t            Self::ntt_multiply_and_add(\n627\t                &dft,\n628\t                large_uni_domain,\n629\t                [&e0_neg, &e1_neg, &e2_neg],\n630\t                [\n631\t                    &g_neg[0..skip_domain],\n632\t                    &g_neg[skip_domain..2 * skip_domain],\n633\t                    &g_neg[2 * skip_domain..3 * skip_domain],\n634\t                ],\n635\t                &mut s_0_coeffs,\n636\t            );\n637\t        }\n638\t\n639\t        s_0_coeffs.truncate(s_0_deg + 1);\n640\t        Ok(UnivariatePoly::new(s_0_coeffs))\n641\t    }\n642\t\n643\t    /// NTT-based polynomial multiplication following logup pattern.\n644\t    /// Computes: out += sum_i E[i] * G[i]\n645\t    fn ntt_multiply_and_add(\n646\t        dft: &Radix2BowersSerial,\n647\t        domain_size: usize,\n648\t        e_coeffs: [&[EF]; 3],\n649\t        g_evals: [&[EF]; 3], // G evaluations on identity coset\n650\t        out: &mut [EF],\n651\t    ) {\n652\t        // 1. iDFT G evaluations to get G coefficients\n653\t        let g_coeffs: [Vec<EF>; 3] = std::array::from_fn(|i| dft.idft(g_evals[i].to_vec()));\n654\t\n655\t        // 2. Prepare coefficient matrices, resize to domain_size\n656\t        let mut e_padded = vec![EF::ZERO; domain_size * 3];\n657\t        let mut g_padded = vec![EF::ZERO; domain_size * 3];\n658\t        for i in 0..3 {\n659\t            for (j, &c) in e_coeffs[i].iter().enumerate() {\n660\t                e_padded[j * 3 + i] = c;\n661\t            }\n662\t            for (j, &c) in g_coeffs[i].iter().enumerate() {\n663\t                g_padded[j * 3 + i] = c;\n664\t            }\n665\t        }\n666\t\n667\t        // 3. DFT batch to evaluation domain\n668\t        let e_evals_mat = dft.dft_batch(RowMajorMatrix::new(e_padded, 3));\n669\t        let g_evals_mat = dft.dft_batch(RowMajorMatrix::new(g_padded, 3));\n670\t\n671\t        // 4. Pointwise multiply and sum: s[j] = sum_i e[j][i] * g[j][i]\n672\t        let mut s_evals = vec![EF::ZERO; domain_size];\n673\t        for (j, s_j) in s_evals.iter_mut().enumerate() {\n674\t            for i in 0..3 {\n675\t                *s_j += e_evals_mat.values[j * 3 + i] * g_evals_mat.values[j * 3 + i];\n676\t            }\n677\t        }\n678\t\n679\t        // 5. iDFT to get product coefficients\n680\t        let s_coeffs = dft.idft(s_evals);\n681\t\n682\t        // 6. Add to output\n683\t        for (o, c) in out.iter_mut().zip(s_coeffs) {\n684\t            *o += c;\n685\t        }\n686\t    }\n687\t\n688\t    #[instrument(\"stacked_reduction_fold_ple\", level = \"debug\", skip_all)]\n689\t    fn fold_ple_evals(&mut self, u_0: EF) -> Result<(), StackedReductionError> {\n690\t        let l_skip = self.l_skip;\n691\t        let n_stack = self.n_stack;\n692\t        let r_0 = self.r_0;\n693\t        let omega_skip = self.omega_skip;\n694\t        let n_max = self.n_max;\n695\t        self.q_evals.clear();\n696\t\n697\t        // Precompute Lagrange denominators once (shared across all traces)\n698\t        let skip_domain = 1 << l_skip;\n699\t        let inv_lagrange_denoms =\n700\t            compute_barycentric_inv_lagrange_denoms(l_skip, &self.omega_skip_pows, u_0);\n701\t        let d_inv_lagrange_denoms = inv_lagrange_denoms.to_device()?;\n702\t\n703\t        for stacked in &self.stacked_per_commit {\n704\t            let layout = stacked.layout();\n705\t            let num_x = 1 << n_stack;\n706\t            let stacked_width = layout.width();\n707\t            debug_assert_eq!(layout.height(), 1 << (l_skip + n_stack));\n708\t            let folded_evals = DeviceBuffer::<EF>::with_capacity(num_x * stacked_width);\n709\t            // We must fill with zeros because some parts will be left empty due to stacking\n710\t            folded_evals\n711\t                .fill_zero()\n712\t                .map_err(StackedReductionError::FillZero)?;\n713\t            let mut dst_offset = 0;\n714\t            for trace in &stacked.traces {\n715\t                if trace.width() == 0 || trace.height() == 0 {\n716\t                    continue;\n717\t                }\n718\t                let new_height = max(trace.height(), skip_domain) / skip_domain;\n719\t\n720\t                // Launch single-trace kernel for this trace\n721\t                // SAFETY:\n722\t                // - `trace.buffer()` is a valid device pointer for `trace.height() * trace.width()`\n723\t                //   elements\n724\t                // - `folded_evals` at `dst_offset` is valid for `new_height * trace.width()`\n725\t                //   elements since we allocated `num_x * stacked_width` and traces fill\n726\t                //   contiguously\n727\t                // - `d_omega_skip_pows` and `d_inv_lagrange_denoms` have length `>= skip_domain`\n728\t                unsafe {\n729\t                    let dst = folded_evals.as_mut_ptr().add(dst_offset);\n730\t                    stacked_reduction_fold_ple(\n731\t                        trace.buffer().as_ptr(),\n732\t                        dst,\n733\t                        &self.d_omega_skip_pows,\n734\t                        &d_inv_lagrange_denoms,\n735\t                        trace.height(),\n736\t                        trace.width(),\n737\t                        l_skip,\n738\t                    )\n739\t                    .map_err(StackedReductionError::FoldPle)?;\n740\t                }\n741\t\n742\t                dst_offset += new_height * trace.width();\n743\t            }\n744\t            self.q_evals.push(folded_evals);\n745\t        }\n746\t\n747\t        // fold PLEs into MLEs for \\eq and \\kappa_\\rot, using u_0\n748\t        let eq_uni_u0r0 = eval_eq_uni(l_skip, u_0, r_0);\n749\t        let eq_uni_u0r0_rot = eval_eq_uni(l_skip, u_0, r_0 * omega_skip);\n750\t        let eq_uni_u01 = eval_eq_uni_at_one(l_skip, u_0);\n751\t        debug_assert_eq!(self.eq_r_ns.buffer.len(), 2 << n_max);\n752\t        self.k_rot_ns.buffer = DeviceBuffer::with_capacity(2 << n_max);\n753\t        [EF::ZERO].copy_to(&mut self.k_rot_ns.buffer)?;\n754\t        unsafe {\n755\t            // SAFETY:\n756\t            // - We allocated `k_rot_ns` with same capacity as `eq_r_ns` above.\n757\t            initialize_k_rot_from_eq_segments(\n758\t                &self.eq_r_ns,\n759\t                &mut self.k_rot_ns.buffer,\n760\t                eq_uni_u0r0_rot,\n761\t                self.eq_const * eq_uni_u01,\n762\t                n_max as u32,\n763\t            )\n764\t            .map_err(StackedReductionError::InitKRot)?;\n765\t        }\n766\t        vector_scalar_multiply_ext(&mut self.eq_r_ns.buffer, eq_uni_u0r0)\n767\t            .map_err(StackedReductionError::VectorScalarMul)?;\n768\t\n769\t        // Compute the special eq values for n = -l_skip..0\n770\t        // First in order -n = 1..=l_skip, then reverse to order n = -l_skip..0 corresponding to\n771\t        // log_height = 0..l_skip\n772\t        (self.eq_stable, self.k_rot_stable) =\n773\t            zip(r_0.exp_powers_of_2(), omega_skip.exp_powers_of_2())\n774\t                .enumerate()\n775\t                .skip(1)\n776\t                .take(l_skip)\n777\t                .map(|(n_abs, (r, omega_l))| {\n778\t                    let l = l_skip - n_abs;\n779\t                    let eq_uni = eval_eq_uni(l, u_0, r);\n780\t                    let eq_uni_rot = eval_eq_uni(l, u_0, r * omega_l);\n781\t                    let ind = eval_in_uni(l_skip, -(n_abs as isize), u_0);\n782\t                    (ind * eq_uni, ind * eq_uni_rot)\n783\t                })\n784\t                .unzip();\n785\t        self.eq_stable.reverse();\n786\t        self.k_rot_stable.reverse();\n787\t        Ok(())\n788\t    }\n789\t\n790\t    #[instrument(\"stacked_reduction_sumcheck\", level = \"debug\", skip_all, fields(round = round))]\n791\t    fn batch_sumcheck_poly_eval(\n792\t        &mut self,\n793\t        round: usize,\n794\t        _u_prev: EF,\n795\t    ) -> Result<[EF; STACKED_REDUCTION_S_DEG], StackedReductionError> {\n796\t        let l_skip = self.l_skip;\n797\t\n798\t        let q_eval_ptrs = self.q_evals.iter().map(|q| q.as_ptr()).collect_vec();\n799\t        q_eval_ptrs.copy_to(&mut self.d_q_eval_ptrs)?;\n800\t\n801\t        if self.n_max >= (round - 1) {\n802\t            // Move stable eq, k_rot to stable vectors\n803\t            let mut tmp = [EF::ZERO];\n804\t            debug_assert_eq!(self.eq_stable.len(), l_skip + round - 1);\n805\t            debug_assert_eq!(self.k_rot_stable.len(), l_skip + round - 1);\n806\t            debug_assert!(self.eq_r_ns.buffer.len() > 1);\n807\t            debug_assert!(self.k_rot_ns.buffer.len() > 1);\n808\t            // SAFETY: size of eq_r_ns, k_rot_ns is currently 2 * 2^{n_max - round + 1}\n809\t            unsafe {\n810\t                // D2H copy of single EF element\n811\t                cuda_memcpy::<true, false>(\n812\t                    tmp.as_mut_ptr() as *mut c_void,\n813\t                    self.eq_r_ns.get_ptr(0) as *const c_void,\n814\t                    size_of::<EF>(),\n815\t                )?;\n816\t\n817\t                self.eq_stable.push(tmp[0]);\n818\t\n819\t                // D2H copy of single EF element\n820\t                cuda_memcpy::<true, false>(\n821\t                    tmp.as_mut_ptr() as *mut c_void,\n822\t                    self.k_rot_ns.get_ptr(0) as *const c_void,\n823\t                    size_of::<EF>(),\n824\t                )?;\n825\t\n826\t                self.k_rot_stable.push(tmp[0]);\n827\t            }\n828\t        }\n829\t        // Upload full eq_ub_per_trace to device once per round\n830\t        self.eq_ub_per_trace.copy_to(&mut self.d_eq_ub_all)?;\n831\t\n832\t        // Single fill_zero for the entire round — all windows accumulate atomically\n833\t        self.d_accum\n834\t            .fill_zero()\n835\t            .map_err(StackedReductionError::FillZero)?;\n836\t\n837\t        // Phase A: Build descriptors (CPU-only, no CUDA calls)\n838\t        let mut degen_descs: Vec<DegenMleDesc> = Vec::new();\n839\t        let mut nondegen_descs: Vec<NonDegenMleDesc> = Vec::new();\n840\t        let mut nondegen_prefix_sums: Vec<u32> = Vec::new();\n841\t        let mut total_nondegen_blocks: u32 = 0;\n842\t\n843\t        for window in self.ht_diff_idxs.windows(2) {\n844\t            let col_offset = window[0] as u32;\n845\t            let window_len = (window[1] - window[0]) as u32;\n846\t            let log_height = self.unstacked_cols[window[0]].log_height as usize;\n847\t\n848\t            if log_height < l_skip + round {\n849\t                degen_descs.push(DegenMleDesc {\n850\t                    col_offset,\n851\t                    window_len,\n852\t                    eq_r: self.eq_stable[log_height],\n853\t                    k_rot_r: self.k_rot_stable[log_height],\n854\t                });\n855\t            } else {\n856\t                let hypercube_dim = log_height - l_skip - round;\n857\t                let num_y = 1u32 << hypercube_dim;\n858\t                let (blocks_x, stride) =\n859\t                    compute_mle_launch_params(num_y, window_len, self.sm_count);\n860\t                nondegen_prefix_sums.push(total_nondegen_blocks);\n861\t                total_nondegen_blocks += blocks_x * stride;\n862\t                nondegen_descs.push(NonDegenMleDesc {\n863\t                    col_offset,\n864\t                    window_len,\n865\t                    num_y,\n866\t                    stride,\n867\t                    blocks_x,\n868\t                });\n869\t            }\n870\t        }\n871\t\n872\t        // Phase B: Upload descriptors and launch batched kernels\n873\t        let stacked_height = self.stacked_height(round);\n874\t        let shift_factor = (l_skip + round) as u32;\n875\t\n876\t        if !degen_descs.is_empty() {\n877\t            let d_degen_descs = degen_descs\n878\t                .to_device()\n879\t                .map_err(StackedReductionError::MemCopy)?;\n880\t            unsafe {\n881\t                batched_stacked_reduction_sumcheck_mle_round_degenerate(\n882\t                    &d_degen_descs,\n883\t                    &self.d_q_eval_ptrs,\n884\t                    self.d_eq_ub_all.as_ptr(),\n885\t                    self.d_unstacked_cols.as_ptr(),\n886\t                    self.d_lambda_pows.as_ptr(),\n887\t                    &mut self.d_accum,\n888\t                    stacked_height,\n889\t                    shift_factor,\n890\t                )\n891\t                .map_err(StackedReductionError::SumcheckMleRoundDegenerate)?;\n892\t            }\n893\t        }\n894\t\n895\t        if !nondegen_descs.is_empty() {\n896\t            let d_nondegen_descs = nondegen_descs\n897\t                .to_device()\n898\t                .map_err(StackedReductionError::MemCopy)?;\n899\t            let d_block_offsets = nondegen_prefix_sums\n900\t                .to_device()\n901\t                .map_err(StackedReductionError::M