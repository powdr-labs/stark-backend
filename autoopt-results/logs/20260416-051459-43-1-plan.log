      let mut eq_r_acc = EF::ONE;\n694\t\n695\t        // Round 0: compute + revert fused. The pq_buffer fold will be fused into next round's\n696\t        // compute. This fuses frac_build_tree_layer(revert=true) with the first inner round\n697\t        // compute.\n698\t        let r0 = do_sumcheck_round_and_revert(\n699\t            &mut eq_buffer,\n700\t            &mut layer,\n701\t            pq_size,\n702\t            lambda,\n703\t            transcript,\n704\t            &mut d_sum_evals,"}]},"parent_tool_use_id":"toolu_01S3UPJ3vWYHw3TBLcB4xTbi","session_id":"80cd739d-0408-463a-95a7-972cb66aaf37","uuid":"b63bdd6d-3f1e-49e1-8741-3aa73dfbd44a","timestamp":"2026-04-16T04:01:54.965Z"}
