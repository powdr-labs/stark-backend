p = self.l_skip;\n2050\t        // With eq(xi,r) contributions\n2051\t        let mut sp_head_evals = vec![EF::ZERO; s_deg];\n2052\t        for i in 0..constraint_degree {\n2053\t            sp_head_evals[i + 1] = self.eq_ns[round - 1] * sp_head_zc[i]\n2054\t                + self.eq_sharp_ns[round - 1] * sp_head_logup[i];\n2055\t        }\n2056\t        // We need to derive s'(0).\n2057\t        // We use that s_j(0) + s_j(1) = s_{j-1}(r_{j-1})\n2058\t        let xi_cur = self.xi[l_skip + round - 1];\n2059\t        {\n2060\t            let eq_xi_0 = EF::ONE - xi_cur;\n2061\t            let eq_xi_1 = xi_cur;\n2062\t            sp_head_evals[0] =\n2063\t                (self.prev_s_eval - eq_xi_1 * sp_head_evals[1] - sp_tail) * eq_xi_0.inverse();\n2064\t        }\n2065\t        // s' has degree s_deg - 1\n2066\t        let sp_head = UnivariatePoly::lagrange_interpolate(\n2067\t            &(0..s_deg).map(F::from_usize).collect_vec(),\n2068\t            &sp_head_evals,\n2069\t        );\n2070\t        // eq(xi, X) = (2 * xi - 1) * X + (1 - xi)\n2071\t        // Compute s(X) = eq(xi, X) * s'_head(X) + s'_tail * X (s'_head now contains eq(..,r))\n2072\t        // s(X) has degree s_deg\n2073\t        let mut coeffs = sp_head.into_coeffs();\n2074\t        coeffs.push(EF::ZERO);\n2075\t        let b = EF::ONE - xi_cur;\n2076\t        let a = xi_cur - b;\n2077\t        for i in (0..s_deg).rev() {\n2078\t            coeffs[i + 1] = a * coeffs[i] + b * coeffs[i + 1];\n2079\t        }\n2080\t        coeffs[0] *= b;\n2081\t        coeffs[1] += sp_tail;\n2082\t        UnivariatePoly::new(coeffs)\n2083\t    }\n2084\t\n2085\t    #[instrument(name = \"LogupZerocheck::fold_mle_evals\", level = \"debug\", skip_all, fields(round = round))]\n2086\t    fn fold_mle_evals(&mut self, round: usize, r_round: EF) -> Result<(), LogupZerocheckError> {\n2087\t        // Fold a set of matrices using ping-pong buffers: read from current locations, write\n2088\t        // foldable output to buf_b, swap. Non-foldable (height=1) matrices keep their existing\n2089\t        // views (pointing to whichever buffer they last landed in) since both buffers stay alive.\n2090\t        // This avoids per-round D2D copies for non-foldable matrices.\n2091\t        // Assumes input_mats are sorted by height descending.\n2092\t        fn fold_pingpong(\n2093\t            input_mats: Vec<DeviceMatrix<EF>>,\n2094\t            buf_a: &mut DeviceBuffer<EF>,\n2095\t            buf_b: &mut DeviceBuffer<EF>,\n2096\t            r_round: EF,\n2097\t        ) -> Result<Vec<DeviceMatrix<EF>>, LogupZerocheckError> {\n2098\t            let num_foldable = input_mats.partition_point(|mat| mat.height() > 1);\n2099\t            if num_foldable == 0 {\n2100\t                return Ok(input_mats);\n2101\t            }\n2102\t\n2103\t            let input_ptrs: Vec<_> = input_mats\n2104\t                .iter()\n2105\t                .take(num_foldable)\n2106\t                .map(|mat| mat.buffer().as_ptr())\n2107\t                .collect();\n2108\t            let log_heights: Vec<u8> = input_mats\n2109\t                .iter()\n2110\t                .take(num_foldable)\n2111\t                .map(|mat| (mat.height() >> 1).ilog2() as u8)\n2112\t                .collect();\n2113\t            let widths: Vec<u32> = input_mats\n2114\t                .iter()\n2115\t                .take(num_foldable)\n2116\t                .map(|mat| mat.width() as u32)\n2117\t                .collect();\n2118\t\n2119\t            let mut max_output_cells = 0usize;\n2120\t            let mut out_off = 0usize;\n2121\t            let output_ptrs: Vec<_> = input_mats\n2122\t                .iter()\n2123\t                .take(num_foldable)\n2124\t                .map(|mat| {\n2125\t                    let ptr = unsafe { buf_b.as_mut_ptr().add(out_off) };\n2126\t                    let out_cells = (mat.height() >> 1) * mat.width();\n2127\t                    max_output_cells = max(max_output_cells, out_cells);\n2128\t                    out_off += out_cells;\n2129\t                    ptr\n2130\t                })\n2131\t                .collect();\n2132\t\n2133\t            let d_input_ptrs = input_ptrs.to_device()?;\n2134\t            let d_output_ptrs = output_ptrs.to_device()?;\n2135\t            let d_log_heights = log_heights.to_device()?;\n2136\t            let d_widths = widths.to_device()?;\n2137\t\n2138\t            unsafe {\n2139\t                batch_fold_mle(\n2140\t                    &d_input_ptrs,\n2141\t                    &d_output_ptrs,\n2142\t                    &d_widths,\n2143\t                    num_foldable.try_into().unwrap(),\n2144\t                    &d_log_heights,\n2145\t                    max_output_cells.try_into().unwrap(),"}]},"parent_tool_use_id":"toolu_01CZbypuZFoQhevcZ1PvJyhx","session_id":"80cd739d-0408-463a-95a7-972cb66aaf37","uuid":"a7f47502-2409-409c-a398-9fdded324a4f","timestamp":"2026-04-16T03:41:58.177Z"}
