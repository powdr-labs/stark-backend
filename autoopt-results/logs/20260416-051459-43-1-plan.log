{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rm7jCAZdawNPkyQG4jTcx7","type":"tool_result","content":"1\t#![allow(non_camel_case_types, non_upper_case_globals, non_snake_case)]\n2\t\n3\tuse std::{\n4\t    collections::{BTreeMap, HashMap},\n5\t    ffi::c_void,\n6\t    sync::Arc,\n7\t};\n8\t\n9\tuse bytesize::ByteSize;\n10\t\n11\tuse super::cuda::*;\n12\tuse crate::{\n13\t    common::set_device,\n14\t    error::MemoryError,\n15\t    stream::{\n16\t        current_stream_id, current_stream_sync, default_stream_wait, CudaEvent, CudaStreamId,\n17\t    },\n18\t};\n19\t\n20\t#[link(name = \"cudart\")]\n21\textern \"C\" {\n22\t    fn cudaMemGetInfo(free_bytes: *mut usize, total_bytes: *mut usize) -> i32;\n23\t}\n24\t\n25\t// ============================================================================\n26\t// Configuration\n27\t// ============================================================================\n28\t\n29\tconst DEFAULT_VA_SIZE: usize = 8 << 40; // 8 TB\n30\t\n31\t/// Configuration for the Virtual Memory Pool.\n32\t///\n33\t/// Use `VpmmConfig::from_env()` to load from environment variables,\n34\t/// or construct directly for testing.\n35\t#[derive(Debug, Clone)]\n36\tpub(super) struct VpmmConfig {\n37\t    /// Page size override. If `None`, uses CUDA's minimum granularity for the device.\n38\t    pub page_size: Option<usize>,\n39\t    /// Virtual address space size per reserved chunk (default: 8 TB).\n40\t    pub va_size: usize,\n41\t    /// Number of pages to preallocate at startup (default: 0).\n42\t    pub initial_pages: usize,\n43\t}\n44\t\n45\timpl Default for VpmmConfig {\n46\t    fn default() -> Self {\n47\t        Self {\n48\t            page_size: None,\n49\t            va_size: DEFAULT_VA_SIZE,\n50\t            initial_pages: 0,\n51\t        }\n52\t    }\n53\t}\n54\t\n55\timpl VpmmConfig {\n56\t    /// Load configuration from environment variables:\n57\t    /// - `VPMM_PAGE_SIZE`: Page size in bytes (must be multiple of CUDA granularity)\n58\t    /// - `VPMM_VA_SIZE`: Virtual address space size per chunk (default: 8 TB)\n59\t    /// - `VPMM_PAGES`: Number of pages to preallocate (default: 0)\n60\t    pub fn from_env() -> Self {\n61\t        let page_size = std::env::var(\"VPMM_PAGE_SIZE\").ok().map(|val| {\n62\t            let size: usize = val.parse().expect(\"VPMM_PAGE_SIZE must be a valid number\");\n63\t            assert!(size > 0, \"VPMM_PAGE_SIZE must be > 0\");\n64\t            size\n65\t        });\n66\t\n67\t        let va_size = match std::env::var(\"VPMM_VA_SIZE\") {\n68\t            Ok(val) => {\n69\t                let size: usize = val.parse().expect(\"VPMM_VA_SIZE must be a valid number\");\n70\t                assert!(size > 0, \"VPMM_VA_SIZE must be > 0\");\n71\t                size\n72\t            }\n73\t            Err(_) => DEFAULT_VA_SIZE,\n74\t        };\n75\t\n76\t        let initial_pages = match std::env::var(\"VPMM_PAGES\") {\n77\t            Ok(val) => val.parse().expect(\"VPMM_PAGES must be a valid number\"),\n78\t            Err(_) => 0,\n79\t        };\n80\t\n81\t        Self {\n82\t            page_size,\n83\t            va_size,\n84\t            initial_pages,\n85\t        }\n86\t    }\n87\t}\n88\t\n89\t// ============================================================================\n90\t// Pool Implementation\n91\t// ============================================================================\n92\t\n93\t/// Metadata for a free region in the virtual address space.\n94\t#[derive(Debug, Clone)]\n95\tstruct FreeRegionMeta {\n96\t    size: usize,\n97\t    event: Arc<CudaEvent>,\n98\t    stream_id: CudaStreamId,\n99\t    id: usize,\n100\t}"}]},"parent_tool_use_id":"toolu_01VsFWvH1ZUbtcR8rKDCrN4x","session_id":"80cd739d-0408-463a-95a7-972cb66aaf37","uuid":"e6f36063-d10c-4cbb-9474-05a832f21d2c","timestamp":"2026-04-16T03:20:32.001Z"}
