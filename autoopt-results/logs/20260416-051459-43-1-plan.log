{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SRfbroXUazzHHJKFKoH5Ms","type":"tool_result","content":"100\t}\n101\t\n102\t/// Remapped region that will be unmapped when the event completes.\n103\t#[derive(Debug)]\n104\tstruct ZombieRegion {\n105\t    ptr: CUdeviceptr,\n106\t    size: usize,\n107\t    event: Arc<CudaEvent>,\n108\t}\n109\t\n110\t/// Virtual memory pool implementation.\n111\tpub(super) struct VirtualMemoryPool {\n112\t    // Virtual address space roots\n113\t    pub(super) roots: Vec<CUdeviceptr>,\n114\t\n115\t    // Map for all active pages\n116\t    active_pages: HashMap<CUdeviceptr, CUmemGenericAllocationHandle>,\n117\t\n118\t    // Free regions in virtual space (sorted by address)\n119\t    free_regions: BTreeMap<CUdeviceptr, FreeRegionMeta>,\n120\t\n121\t    // Active allocations: (ptr, size)\n122\t    malloc_regions: HashMap<CUdeviceptr, usize>,\n123\t\n124\t    // Unmapped regions: (ptr, size)\n125\t    unmapped_regions: BTreeMap<CUdeviceptr, usize>,\n126\t\n127\t    // Zombie regions: (remapped, but not unmapped yet)\n128\t    zombie_regions: Vec<ZombieRegion>,\n129\t\n130\t    // Number of free calls (used to assign ids to free regions)\n131\t    free_num: usize,\n132\t\n133\t    // Granularity size: (page % 2MB must be 0)\n134\t    pub(super) page_size: usize,\n135\t\n136\t    // Reserved virtual address span in bytes\n137\t    va_size: usize,\n138\t\n139\t    // Device ordinal\n140\t    pub(super) device_id: i32,\n141\t}\n142\t\n143\t/// # Safety\n144\t/// `VirtualMemoryPool` is not internally synchronized. These impls are safe because\n145\t/// all access goes through `Mutex<MemoryManager>` in the parent module.\n146\tunsafe impl Send for VirtualMemoryPool {}\n147\tunsafe impl Sync for VirtualMemoryPool {}\n148\t\n149\timpl VirtualMemoryPool {\n150\t    pub(super) fn new(config: VpmmConfig) -> Self {\n151\t        let device_id = set_device().unwrap();\n152\t\n153\t        // Check VPMM support and resolve page_size\n154\t        let (root, page_size, va_size) = unsafe {\n155\t            match vpmm_check_support(device_id) {\n156\t                Ok(_) => {\n157\t                    let granularity = vpmm_min_granularity(device_id).unwrap();\n158\t\n159\t                    // Resolve page_size: use config override or device granularity\n160\t                    let page_size = match config.page_size {\n161\t                        Some(size) => {\n162\t                            assert!(\n163\t                                size > 0 && size % granularity == 0,\n164\t                                \"VPMM_PAGE_SIZE must be > 0 and multiple of {}\",\n165\t                                granularity\n166\t                            );\n167\t                            size\n168\t                        }\n169\t                        None => {\n170\t                            // Use 8x the minimum granularity (typically 16 MiB) to reduce\n171\t                            // the number of cuMemCreate calls for large allocations.\n172\t                            // Each cuMemCreate has ~0.4ms driver overhead; with 2 MiB pages\n173\t                            // a 256 MiB allocation requires 128 calls (~51ms). With 16 MiB\n174\t                            // pages it requires only 16 calls (~6ms).\n175\t                            // Allocations smaller than the page size use cudaMallocAsync.\n176\t                            8 * granularity\n177\t                        }\n178\t                    };\n179\t\n180\t                    // Validate va_size\n181\t                    let va_size = config.va_size;\n182\t                    assert!(\n183\t                        va_size > 0 && va_size.is_multiple_of(page_size),\n184\t                        \"VPMM_VA_SIZE must be > 0 and multiple of page size ({})\",\n185\t                        page_size\n186\t                    );\n187\t\n188\t                    // Reserve initial VA chunk\n189\t                    let va_base = vpmm_reserve(va_size, page_size).unwrap();\n190\t                    tracing::debug!(\n191\t                        \"VPMM: Reserved virtual address space {} with page size {}\",\n192\t                        ByteSize::b(va_size as u64),\n193\t                        ByteSize::b(page_size as u64)\n194\t                    );\n195\t                    (va_base, page_size, va_size)\n196\t                }\n197\t                Err(_) => {\n198\t                    tracing::warn!(\"VPMM not supported, falling back to cudaMallocAsync\");\n199\t                    (0, usize::MAX, 0)\n200\t                }\n201\t            }\n202\t        };\n203\t\n204\t        let mut pool = Self {\n205\t            roots: vec![root],\n206\t            active_pages: HashMap::new(),\n207\t            free_regions: BTreeMap::new(),\n208\t            malloc_regions: HashMap::new(),\n209\t            unmapped_regions: if va_size > 0 {\n210\t                BTreeMap::from_iter([(root, va_size)])\n211\t            } else {\n212\t                BTreeMap::new()\n213\t            },\n214\t            zombie_regions: Vec::new(),\n215\t            free_num: 0,\n216\t            page_size,\n217\t            va_size,\n218\t            device_id,\n219\t        };\n220\t\n221\t        // Preallocate pages if requested (skip if VPMM not supported)\n222\t        if config.initial_pages > 0 && page_size != usize::MAX {\n223\t            let alloc_size = config.initial_pages * page_size;\n224\t            if let Err(e) =\n225\t                pool.defragment_or_create_new_pages(alloc_size, current_stream_id().unwrap())\n226\t            {\n227\t                let mut free_mem = 0usize;\n228\t                let mut total_mem = 0usize;\n229\t                unsafe {\n230\t                    cudaMemGetInfo(&mut free_mem, &mut total_mem);\n231\t                }\n232\t                panic!(\n233\t                    \"VPMM preallocation failed: {:?}\\n\\\n234\t                     Config: pages={}, page_size={}\\n\\\n235\t                     GPU Memory: free={}, total={}\",\n236\t                    e,\n237\t                    config.initial_pages,\n238\t                    ByteSize::b(page_size as u64),\n239\t                    ByteSize::b(free_mem as u64),\n240\t                    ByteSize::b(total_mem as u64)\n241\t                );\n242\t            }\n243\t        }\n244\t\n245\t        pool\n246\t    }\n247\t\n248\t    /// Allocates memory from the pool's free regions.\n249\t    /// Attempts defragmentation if no suitable free region exists."}]},"parent_tool_use_id":"toolu_01VsFWvH1ZUbtcR8rKDCrN4x","session_id":"80cd739d-0408-463a-95a7-972cb66aaf37","uuid":"a3c011da-3079-4111-879f-80604a974006","timestamp":"2026-04-16T03:20:34.056Z"}
