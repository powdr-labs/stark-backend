            }\n721\t        }\n722\t    }\n723\t    drop(mle_rounds_span);\n724\t\n725\t    let batch_constraint_proof = BatchConstraintProof {\n726\t        numerator_term_per_air,\n727\t        denominator_term_per_air,\n728\t        univariate_round_coeffs: s_0_poly.into_coeffs(),\n729\t        sumcheck_round_polys,\n730\t        column_openings,\n731\t    };\n732\t    let gkr_proof = GkrProof {\n733\t        logup_pow_witness,\n734\t        q0_claim: frac_sum_proof.fractional_sum.1,\n735\t        claims_per_layer: frac_sum_proof.claims_per_layer,\n736\t        sumcheck_polys: frac_sum_proof.sumcheck_polys,\n737\t    };\n738\t    Ok((gkr_proof, batch_constraint_proof, r))\n739\t}\n740\t\n741\tpub struct LogupZerocheckGpu<'a, HS: GpuHashScheme> {\n742\t    pub alpha_logup: EF,\n743\t    pub beta_pows: Vec<EF>,\n744\t    // [alpha, beta^0, beta^1, .., beta^max_interaction_len]\n745\t    pub d_challenges: DeviceBuffer<EF>,\n746\t\n747\t    pub l_skip: usize,\n748\t    n_logup: usize,\n749\t    n_global: usize,\n750\t\n751\t    pub omega_skip: F,\n752\t    pub omega_skip_pows: Vec<F>,\n753\t    d_omega_skip_pows: DeviceBuffer<F>,\n754\t\n755\t    pub interactions_layout: StackedLayout,\n756\t    pub constraint_degree: usize,\n757\t    n_per_trace: Vec<isize>,\n758\t    max_num_constraints: usize,\n759\t    pub monomial_num_y_threshold: u32,\n760\t    sm_count: u32,\n761\t    // Available after GKR:\n762\t    pub xi: Vec<EF>,\n763\t    pub lambda_pows: Option<DeviceBuffer<EF>>,\n764\t    /// Precomputed lambda combinations per AIR (indexed by air_idx). Set when lambda is sampled.\n765\t    lambda_combinations: Vec<Option<DeviceBuffer<EF>>>,\n766\t    /// Beta powers on device for logup MLE rounds.\n767\t    d_beta_pows: DeviceBuffer<EF>,\n768\t    /// Precomputed logup combinations per trace (indexed by trace_idx). Set when xi is sampled.\n769\t    logup_combinations: Vec<Option<LogupCombinations>>,\n770\t\n771\t    // n_T => segment tree of eq(xi[j..1+n_T]) for j=1..