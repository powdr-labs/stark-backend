{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014xnmeMCSEXo2CdSE1p6HPw","type":"tool_result","content":"1\textern crate alloc;\n2\t\n3\tuse alloc::vec::Vec;\n4\tuse std::{cmp::Ordering, collections::BinaryHeap};\n5\t\n6\tuse getset::Getters;\n7\tuse itertools::Itertools;\n8\tuse openvm_stark_backend::air_builders::symbolic::{\n9\t    symbolic_variable::SymbolicVariable, SymbolicExpressionDag, SymbolicExpressionNode,\n10\t};\n11\tuse p3_field::{Field, PrimeField32};\n12\tuse rustc_hash::FxHashMap;\n13\t\n14\tpub mod codec;\n15\t\n16\t#[derive(Clone, Debug, Eq, PartialEq)]\n17\tpub enum Source<F> {\n18\t    Intermediate(usize),\n19\t    TerminalIntermediate,\n20\t    Var(SymbolicVariable<F>),\n21\t    IsFirst,\n22\t    IsLast,\n23\t    IsTransition,\n24\t    Constant(F),\n25\t}\n26\t\n27\t/// Rule representing a single operation for the GPU kernel to interpret.\n28\t#[derive(Clone, Debug, PartialEq)]\n29\tpub enum Rule<F> {\n30\t    // three-address code\n31\t    // (x, y, z) => z = x op y\n32\t    Add(Source<F>, Source<F>, Source<F>),\n33\t    Sub(Source<F>, Source<F>, Source<F>),\n34\t    Mul(Source<F>, Source<F>, Source<F>),\n35\t    // (x, z) => z = -x\n36\t    Neg(Source<F>, Source<F>),\n37\t    Variable(Source<F>),\n38\t    // (x, z) => z = x\n39\t    BufferVar(Source<F>, Source<F>),\n40\t}\n41\t\n42\t#[derive(derive_new::new, Clone, Debug, PartialEq)]\n43\tpub struct RuleWithFlag<F> {\n44\t    /// Raw rule\n45\t    pub inner: Rule<F>,\n46\t    /// Flag for whether the rule represents a constraint node that should be included in the\n47\t    /// accumulator.\n48\t    pub need_accumulate: bool,\n49\t}\n50\t\n51\t#[derive(Debug, Copy, Clone)]\n52\tstruct StaticExpressionInfo {\n53\t    // smallest dag_idx of a descendant\n54\t    pub first_descendant: usize,\n55\t    pub accumulate: bool,\n56\t    pub intermediate: bool,\n57\t    pub buffer_var: bool,\n58\t}\n59\t\n60\t#[derive(Debug, Copy, Clone)]\n61\tstruct LiveExpressionInfo {\n62\t    pub use_count: usize,\n63\t    /// Last dag_idx (inclusive) that uses this expr\n64\t    pub last_use: usize,\n65\t    /// Index within intermediate buffer to store, usize::MAX if not stored\n66\t    pub buffer_idx: usize,\n67\t}\n68\t\n69\timpl LiveExpressionInfo {\n70\t    pub fn update(&mut self, dag_idx: usize) {\n71\t        self.last_use = self.last_use.max(dag_idx);\n72\t        self.use_count += 1;\n73\t    }\n74\t}\n75\t\n76\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n77\tstruct BufferEntry {\n78\t    buffer_idx: usize,\n79\t    last_use: usize,\n80\t}\n81\t\n82\timpl Ord for BufferEntry {\n83\t    fn cmp(&self, other: &Self) -> Ordering {\n84\t        other\n85\t            .last_use\n86\t            .cmp(&self.last_use)\n87\t            .then_with(|| other.buffer_idx.cmp(&self.buffer_idx))\n88\t    }\n89\t}\n90\t\n91\timpl PartialOrd for BufferEntry {\n92\t    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n93\t        Some(self.cmp(other))\n94\t    }\n95\t}\n96\t\n97\t#[derive(Debug, Clone)]\n98\tpub struct SymbolicRulesGpu<F> {\n99\t    /// Vector consisting of rules to be sequentially evaluated in a single GPU thread.\n100\t    pub rules: Vec<RuleWithFlag<F>>,\n101\t    /// Number of `F` elements in the intermediate buffer required for rule evaluation.\n102\t    pub buffer_size: usize,\n103\t    /// Map from dag_idx to rule_idx for accumulated nodes. Unlike `used_nodes`, this has no\n104\t    /// duplicates.\n105\t    pub dag_idx_to_rule_idx: FxHashMap<usize, usize>,\n106\t}\n107\t\n108\t/// Stateful rule builder that schedules buffer allocation and reuse using a priority queue.\n109\t///\n110\t/// At any given time, the builder will determine the buffer scheduling for a contiguous range of\n111\t/// nodes in a global DAG, where the DAG is already topologically sorted.\n112\t#[derive(Getters)]\n113\tpub struct SymbolicRulesBuilder<'a, F> {\n114\t    /// Global dag that all symbolic expressions will be referenced with respect to.\n115\t    dag_nodes: &'a [SymbolicExpressionNode<F>],\n116\t\n117\t    // Contains every node in the DAG.\n118\t    // dag_idx => StaticExpressionInfo\n119\t    static_expr_info: Vec<StaticExpressionInfo>,\n120\t\n121\t    // Stateful info about node with respect to buffer usage. Changes if nodes are added or removed\n122\t    // from what the intermediate buffer needs to account for. dag_idx => LiveExpressionInfo\n123\t    live_expr_info: FxHashMap<usize, LiveExpressionInfo>,\n124\t    buffer: BinaryHeap<BufferEntry>,\n125\t\n126\t    // Effective range after set_range (inclusive start, exclusive end)\n127\t    effective_start: usize,\n128\t    effective_end: usize,\n129\t}\n130\t\n131\timpl<'a, F: Field> SymbolicRulesBuilder<'a, F> {\n132\t    /// The `dag.constraint_idx` must be topologically sorted.\n133\t    pub fn new(dag: &'a SymbolicExpressionDag<F>, buffer_vars: bool) -> Self {\n134\t        debug_assert!(dag.constraint_idx.iter().is_sorted());\n135\t        let mut expr_info = vec![\n136\t            StaticExpressionInfo {\n137\t                first_descendant: usize::MAX,\n138\t                accumulate: false,\n139\t                intermediate: false,\n140\t                buffer_var: false,\n141\t            };\n142\t            dag.nodes.len()\n143\t        ];\n144\t        for &idx in &dag.constraint_idx {\n145\t            expr_info[idx].accumulate = true;\n146\t        }\n147\t\n148\t        for (i, node) in dag.nodes.iter().enumerate() {\n149\t            expr_info[i].first_descendant = expr_info[i].first_descendant.min(i);\n150\t            match node {\n151\t                SymbolicExpressionNode::Add {\n152\t                    left_idx,\n153\t                    right_idx,\n154\t                    ..\n155\t                }\n156\t                | SymbolicExpressionNode::Sub {\n157\t                    left_idx,\n158\t                    right_idx,\n159\t                    ..\n160\t                }\n161\t                | SymbolicExpressionNode::Mul {\n162\t                    left_idx,\n163\t                    right_idx,\n164\t                    ..\n165\t                } => {\n166\t                    expr_info[i].intermediate = true;\n167\t                    expr_info[i].first_descendant = expr_info[i]\n168\t                        .first_descendant\n169\t                        .min(expr_info[*left_idx].first_descendant)\n170\t                        .min(expr_info[*right_idx].first_descendant);\n171\t                }\n172\t                SymbolicExpressionNode::Neg { idx, .. } => {\n173\t                    expr_info[i].intermediate = true;\n174\t                    expr_info[i].first_descendant = expr_info[i]\n175\t                        .first_descendant\n176\t                        .min(expr_info[*idx].first_descendant);\n177\t                }\n178\t                SymbolicExpressionNode::Variable(_) => {\n179\t                    if buffer_vars {\n180\t                        expr_info[i].buffer_var = true;\n181\t                    }\n182\t                }\n183\t                _ => {}\n184\t            }\n185\t        }\n186\t        Self {\n187\t            dag_nodes: &dag.nodes,\n188\t            static_expr_info: expr_info,\n189\t            live_expr_info: FxHashMap::default(),\n190\t            buffer: BinaryHeap::new(),\n191\t            effective_start: 0,\n192\t            effective_end: 0,\n193\t        }\n194\t    }\n195\t\n196\t    /// Schedules buffer usage for nodes in `[start_dag_idx, end_dag_idx)` (non-inclusive end). Any\n197\t    /// previous range is cleared. Any nodes that are needed prior to the start of the range are\n198\t    /// also scheduled.\n199\t    pub fn set_range(&mut self, mut start_dag_idx: usize, end_dag_idx: usize) {\n200\t        debug_assert!(start_dag_idx < end_dag_idx);\n201\t        debug_assert!(end_dag_idx <= self.dag_nodes.len());\n202\t        self.live_expr_info.clear();\n203\t        let _start = start_dag_idx;\n204\t        for i in _start..end_dag_idx {\n205\t            start_dag_idx = start_dag_idx.min(self.static_expr_info[i].first_descendant);\n206\t        }\n207\t        // Store effective range for to_rules()\n208\t        self.effective_start = start_dag_idx;\n209\t        self.effective_end = end_dag_idx;\n210\t\n211\t        // We add to live_expr_info if the node is used (even if not buffered)\n212\t        // Add in reverse order so last used is first\n213\t        for (dag_idx, (node, info)) in self\n214\t            .dag_nodes\n215\t            .iter()\n216\t            .zip(self.static_expr_info.iter())\n217\t            .enumerate()\n218\t            .take(end_dag_idx)\n219\t            .skip(start_dag_idx)\n220\t            .rev()\n221\t        {\n222\t            if !self.live_expr_info.contains_key(&dag_idx) && !info.accumulate {\n223\t                // Not a descendant and not accumulated, so we can skip\n224\t                continue;\n225\t            }\n226\t            let unit_info = LiveExpressionInfo {\n227\t                use_count: 1,\n228\t                last_use: dag_idx,\n229\t                buffer_idx: usize::MAX,\n230\t            };\n231\t            self.live_expr_info\n232\t                .entry(dag_idx)\n233\t                .and_modify(|e| {\n234\t                    e.use_count += 1;\n235\t                })\n236\t                .or_insert(unit_info);\n237\t\n238\t            match node {\n239\t                SymbolicExpressionNode::Add {\n240\t                    left_idx,\n241\t                    right_idx,\n242\t                    ..\n243\t                }\n244\t                | SymbolicExpressionNode::Sub {\n245\t                    left_idx,\n246\t                    right_idx,\n247\t                    ..\n248\t                }\n249\t                | SymbolicExpressionNode::Mul {\n250\t                    left_idx,\n251\t                    right_idx,\n252\t                    ..\n253\t                } => {\n254\t                    self.live_expr_info\n255\t                        .entry(*left_idx)\n256\t                        .and_modify(|e| e.update(dag_idx))\n257\t                        .or_insert(unit_info);\n258\t                    self.live_expr_info\n259\t                        .entry(*right_idx)\n260\t                        .and_modify(|e| e.update(dag_idx))\n261\t                        .or_insert(unit_info);\n262\t                }\n263\t                SymbolicExpressionNode::Neg { idx, .. } => {\n264\t                    self.live_expr_info\n265\t                        .entry(*idx)\n266\t                        .and_modify(|e| e.update(dag_idx))\n267\t                        .or_insert(unit_info);\n268\t                }\n269\t                _ => {}\n270\t            }\n271\t        }\n272\t\n273\t        // Collects all the expressions that need to be buffered. We then use a classic\n274\t        // priority-queue scheduling algorithm to minimally assign buffer indices to\n275\t        // each expression. Iterate by index to maintain topological order.\n276\t        let buffer_dag_idxs = (start_dag_idx..end_dag_idx)\n277\t            .filter(|&dag_idx| {\n278\t                if let Some(live_info) = self.live_expr_info.get(&dag_idx) {\n279\t                    debug_assert!(live_info.use_count > 0);\n280\t                    let static_info = &self.static_expr_info[dag_idx];\n281\t                    static_info.intermediate || (static_info.buffer_var && live_info.use_count > 1)\n282\t                } else {\n283\t                    false\n284\t                }\n285\t            })\n286\t            .collect_vec();\n287\t\n288\t        let buffer = &mut self.buffer;\n289\t        buffer.clear();\n290\t\n291\t        for dag_idx in buffer_dag_idxs {\n292\t            if buffer.is_empty() || buffer.peek().unwrap().last_use > dag_idx {\n293\t                let buffer_idx = buffer.len();\n294\t                let info = self.live_expr_info.get_mut(&dag_idx).unwrap();\n295\t                let last_use = info.last_use;\n296\t                info.buffer_idx = buffer_idx;\n297\t                buffer.push(BufferEntry {\n298\t                    buffer_idx,\n299\t                    last_use,\n300\t                });\n301\t            } else {\n302\t                let buffer_entry = buffer.pop().unwrap();\n303\t                let buffer_idx = buffer_entry.buffer_idx;\n304\t                let info = self.live_expr_info.get_mut(&dag_idx).unwrap();\n305\t                let last_use = info.last_use;\n306\t                info.buffer_idx = buffer_idx;\n307\t                buffer.push(BufferEntry {\n308\t                    buffer_idx,\n309\t                    last_use,\n310\t                });\n311\t            }\n312\t        }\n313\t    }\n314\t\n315\t    pub fn to_rules(&self) -> SymbolicRulesGpu<F> {\n316\t        let dag_idx_to_source = |idx: usize, use_idx: usize| {\n317\t            match &self.dag_nodes[idx] {\n318\t                // Leaf nodes don't need buffer_idx lookup\n319\t                SymbolicExpressionNode::IsFirstRow => Source::IsFirst,\n320\t                SymbolicExpressionNode::IsLastRow => Source::IsLast,\n321\t                SymbolicExpressionNode::IsTransition => Source::IsTransition,\n322\t                SymbolicExpressionNode::Constant(c) => Source::Constant(*c),\n323\t                SymbolicExpressionNode::Variable(var) => {\n324\t                    if self.static_expr_info[idx].buffer_var {\n325\t                        // Only use buffer if it was actually assigned (use_count > 1)\n326\t                        let buffer_idx = self.live_expr_info[&idx].buffer_idx;\n327\t                        if buffer_idx != usize::MAX && idx != use_idx {\n328\t                            Source::Intermediate(buffer_idx)\n329\t                        } else {\n330\t                            Source::Var(*var)\n331\t                        }\n332\t                    } else {\n333\t                        Source::Var(*var)\n334\t                    }\n335\t                }\n336\t                SymbolicExpressionNode::Add { .. }\n337\t                | SymbolicExpressionNode::Sub { .. }\n338\t                | SymbolicExpressionNode::Mul { .. }\n339\t                | SymbolicExpressionNode::Neg { .. } => {\n340\t                    // Only access live_expr_info when we need buffer_idx\n341\t                    let buffer_idx = self\n342\t                        .live_expr_info\n343\t                        .get(&idx)\n344\t                        .map(|info| info.buffer_idx)\n345\t                        .unwrap_or(usize::MAX);\n346\t                    if buffer_idx == usize::MAX {\n347\t                        Source::TerminalIntermediate\n348\t                    } else {\n349\t                        Source::Intermediate(buffer_idx)\n350\t                    }\n351\t                }\n352\t            }\n353\t        };\n354\t\n355\t        // Build dag_idx -> rule_idx map (no duplicates, uses earliest rule_idx)\n356\t        // Iterate by index to maintain topological order (FxHashMap has no ordering)\n357\t        let mut dag_idx_to_rule_idx = FxHashMap::default();\n358\t        let rules = (self.effective_start..self.effective_end)\n359\t            .filter(|dag_idx| self.live_expr_info.contains_key(dag_idx))\n360\t            .enumerate()\n361\t            .map(|(rule_idx, dag_idx)| {\n362\t                let current_node = &self.dag_nodes[dag_idx];\n363\t                let constraint = match current_node {\n364\t                    SymbolicExpressionNode::Add {\n365\t                        left_idx,\n366\t                        right_idx,\n367\t                        ..\n368\t                    } => Rule::Add(\n369\t                        dag_idx_to_source(*left_idx, dag_idx),\n370\t                        dag_idx_to_source(*right_idx, dag_idx),\n371\t                        dag_idx_to_source(dag_idx, dag_idx),\n372\t                    ),\n373\t                    SymbolicExpressionNode::Sub {\n374\t                        left_idx,\n375\t                        right_idx,\n376\t                        ..\n377\t                    } => Rule::Sub(\n378\t                        dag_idx_to_source(*left_idx, dag_idx),\n379\t                        dag_idx_to_source(*right_idx, dag_idx),\n380\t                        dag_idx_to_source(dag_idx, dag_idx),\n381\t                    ),\n382\t                    SymbolicExpressionNode::Mul {\n383\t                        left_idx,\n384\t                        right_idx,\n385\t                        ..\n386\t                    } => Rule::Mul(\n387\t                        dag_idx_to_source(*left_idx, dag_idx),\n388\t                        dag_idx_to_source(*right_idx, dag_idx),\n389\t                        dag_idx_to_source(dag_idx, dag_idx),\n390\t                    ),\n391\t                    SymbolicExpressionNode::Neg { idx, .. } => Rule::Neg(\n392\t                        dag_idx_to_source(*idx, dag_idx),\n393\t                        dag_idx_to_source(dag_idx, dag_idx),\n394\t                    ),\n395\t                    SymbolicExpressionNode::Variable(_) => {\n396\t                        let var = dag_idx_to_source(dag_idx, dag_idx);\n397\t                        let buffer_idx = self.live_expr_info[&dag_idx].buffer_idx;\n398\t                        // Only use BufferVar if variable actually needs buffering\n399\t                        // (buffer_var=true AND use_count > 1, which means buffer_idx was set)\n400\t                        if self.static_expr_info[dag_idx].buffer_var && buffer_idx != usize::MAX {\n401\t                            Rule::BufferVar(var, Source::Intermediate(buffer_idx))\n402\t                        } else {\n403\t                            Rule::Variable(var)\n404\t                        }\n405\t                    }\n406\t                    _ => Rule::Variable(dag_idx_to_source(dag_idx, dag_idx)),\n407\t                };\n408\t                let accumulate = self.static_expr_info[dag_idx].accumulate;\n409\t                if accumulate {\n410\t                    // Use or_insert to keep the earliest rule_idx\n411\t                    dag_idx_to_rule_idx.entry(dag_idx).or_insert(rule_idx);\n412\t                }\n413\t                RuleWithFlag::new(constraint, accumulate)\n414\t            })\n415\t            .collect::<Vec<_>>();\n416\t\n417\t        SymbolicRulesGpu {\n418\t            rules,\n419\t            buffer_size: self.buffer.len(),\n420\t            dag_idx_to_rule_idx,\n421\t        }\n422\t    }\n423\t}\n424\t\n425\timpl<F: Field + PrimeField32> SymbolicRulesGpu<F> {\n426\t    pub fn new(dag: &SymbolicExpressionDag<F>, buffer_vars: bool) -> Self {\n427\t        let mut builder = SymbolicRulesBuilder::new(dag, buffer_vars);\n428\t        builder.set_range(0, dag.nodes.len());\n429\t        builder.to_rules()\n430\t    }\n431\t}\n432\t"}]},"parent_tool_use_id":"toolu_016kCvratRQRgkxgGjPu12YA","session_id":"d2e39847-b30b-4a34-8468-d493bf69eac0","uuid":"365d219c-671e-4ed0-a074-5417415d64b2","timestamp":"2026-04-14T01:03:11.972Z"}
