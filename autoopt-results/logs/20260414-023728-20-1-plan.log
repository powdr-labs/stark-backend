{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X871iXxoPt55JFUXkjy7x2","type":"tool_result","content":"491\tpub fn fractional_sumcheck_gpu<SC, TS>(\n492\t    transcript: &mut TS,\n493\t    leaves: DeviceBuffer<Frac<EF>>,\n494\t    alpha: EF,\n495\t    assert_zero: bool,\n496\t    mem: &mut MemTracker,\n497\t) -> Result<(FracSumcheckProof<SC>, Vec<EF>), FractionalSumcheckError>\n498\twhere\n499\t    SC: StarkProtocolConfig<EF = EF>,\n500\t    TS: FiatShamirTranscript<SC>,\n501\t{\n502\t    let mut layer = leaves;\n503\t    if layer.is_empty() {\n504\t        return Ok((\n505\t            FracSumcheckProof {\n506\t                fractional_sum: (EF::ZERO, EF::ONE),\n507\t                claims_per_layer: vec![],\n508\t                sumcheck_polys: vec![],\n509\t            },\n510\t            vec![],\n511\t        ));\n512\t    };\n513\t    let total_leaves = layer.len();\n514\t    // total_rounds = l_skip + n_logup\n515\t    let total_rounds = log2_strict_usize(total_leaves);\n516\t    assert!(total_rounds > 0, \"n_logup > 0 when there are interactions\");\n517\t    // Build segment tree.\n518\t    // - We only maintain the current layer\n519\t    // - Input layer uses separate F and EF buffers to save memory\n520\t    // - First tree layer converts (F, EF) to FracExt (EF, EF)\n521\t\n522\t    // We store it in bit-reversal order for coalesced memory accesses.\n523\t    // For large N (> 1024), fuse bitrev + tree layers 0 and 1 into a single kernel pass,\n524\t    // eliminating ~1.5N global memory reads. For small N, fall back to separate operations.\n525\t    let start_layer_i = if total_leaves > 1024 {\n526\t        unsafe {\n527\t            // SAFETY: Frac<EF> has exact same memory layout and alignment as (EF, EF).\n528\t            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n529\t            bit_rev_frac_ext_build_k2(buf, total_rounds as u32, alpha)\n530\t                .map_err(FractionalSumcheckError::BitReversal)?;\n531\t        }\n532\t        2 // layers 0+1 already done\n533\t    } else {\n534\t        // Fallback: separate bitrev + layer 0.\n535\t        unsafe {\n536\t            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n537\t            bit_rev_frac_ext(\n538\t                buf,\n539\t                buf,\n540\t                total_rounds as u32,\n541\t                total_leaves.try_into().unwrap(),\n542\t                1,\n543\t            )\n544\t            .map_err(FractionalSumcheckError::BitReversal)?;\n545\t            frac_build_tree_layer(&mut layer, total_leaves, false, alpha, true)\n546\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n547\t            use crate::cuda::logup_zerocheck::frac_add_alpha;\n548\t            let half = total_leaves / 2;\n549\t            let second_half_ptr = layer.as_mut_raw_ptr() as *mut Frac<EF>;\n550\t            let second_half_buf =\n551\t                DeviceBuffer::<Frac<EF>>::from_raw_parts(second_half_ptr.add(half), half);\n552\t            frac_add_alpha(&second_half_buf, alpha)\n553\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n554\t            std::mem::forget(second_half_buf);\n555\t        }\n556\t        1 // layer 0 done; continue from layer 1\n557\t    };\n558\t\n559\t    // Remaining layers: fuse consecutive pairs via two-layer kernel (~33% traffic savings).\n560\t    let mut i = start_layer_i;\n561\t    while i + 1 < total_rounds {\n562\t        let half_i1 = total_leaves >> (i + 2);\n563\t        unsafe {\n564\t            frac_build_tree_two_layers(&mut layer, half_i1)\n565\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n566\t        }\n567\t        i += 2;\n568\t    }\n569\t    // Remaining single layer (if odd number of layers left).\n570\t    if i < total_rounds {\n571\t        unsafe {\n572\t            frac_build_tree_layer(&mut layer, total_leaves >> i, false, EF::ZERO, false)\n573\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n574\t        }\n575\t    }\n576\t    mem.emit_metrics_with_label(\"frac_sumcheck.segment_tree\");\n577\t    mem.tracing_info(\"fractional_sumcheck_gkr: after building segment tree\");\n578\t    let mut copy_scratch = DeviceBuffer::<Frac<EF>>::with_capacity(1);\n579\t    let root = copy_from_device(&layer, 0, &mut copy_scratch)?;\n580\t    unsafe {\n581\t        frac_build_tree_layer(&mut layer, 2, true, EF::ZERO, false)\n582\t            .map_err(FractionalSumcheckError::SegmentTree)?;\n583\t    }\n584\t    if assert_zero {\n585\t        if root.p != EF::ZERO {\n586\t            return Err(FractionalSumcheckError::NonzeroRootSum {\n587\t                p: root.p,\n588\t                q: root.q,\n589\t            });\n590\t        }\n591\t    } else {\n592\t        transcript.observe_ext(root.p);\n593\t    }\n594\t    transcript.observe_ext(root.q);\n595\t\n596\t    let mut claims_per_layer = Vec::with_capacity(total_rounds);\n597\t    let mut sumcheck_polys = Vec::with_capacity(total_rounds);\n598\t\n599\t    let first_left = copy_from_device(&layer, 0, &mut copy_scratch)?;\n600\t    let first_right = copy_from_device(&layer, 1, &mut copy_scratch)?;\n601\t    claims_per_layer.push(GkrLayerClaims {\n602\t        p_xi_0: first_left.p,\n603\t        q_xi_0: first_left.q,\n604\t        p_xi_1: first_right.p,\n605\t        q_xi_1: first_right.q,\n606\t    });\n607\t    for value in [\n608\t        claims_per_layer[0].p_xi_0,\n609\t        claims_per_layer[0].q_xi_0,\n610\t        claims_per_layer[0].p_xi_1,\n611\t        claims_per_layer[0].q_xi_1,\n612\t    ] {\n613\t        transcript.observe_ext(value);\n614\t    }\n615\t    let mu_1 = transcript.sample_ext();\n616\t    let mut xi_prev = vec![mu_1];\n617\t    let mut d_sum_evals = DeviceBuffer::<EF>::with_capacity(2);\n618\t\n619\t    let precompute_m_env = precompute_m_enabled();\n620\t\n621\t    // Work buffer to avoid revert operations on layer. Only needed for non-last rounds.\n622\t    // For the last round (round == total_rounds - 1), we fold in-place on layer.\n623\t    // When precompute-M is active, the first multifold folds w+1 variables at once\n624\t    // (pending r_prev + w window challenges), so the output is total_leaves >> (2 + w).\n625\t    // Fold-eval fallback rounds (rem_n < min_n) need at most 2^min_n elements.\n626\t    let max_work_size = if total_rounds > 2 {\n627\t        if precompute_m_env {\n628\t            (total_leaves >> (2 + GKR_WINDOW_SIZE)).max(1 << GKR_WINDOW_DEFAULT_MIN_N)\n629\t        } else {\n630\t            total_leaves >> 2\n631\t        }\n632\t    } else {\n633\t        0\n634\t    };\n635\t    let mut work_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(max_work_size);\n636\t    let max_tmp_buffer_capacity = if total_rounds > 1 {\n637\t        (unsafe { _frac_compute_round_temp_buffer_size((1 << (total_rounds - 1)) as u32) }) as usize\n638\t    } else {\n639\t        0\n640\t    };\n641\t    let mut tmp_block_sums = if max_tmp_buffer_capacity > 0 {\n642\t        DeviceBuffer::<EF>::with_capacity(max_tmp_buffer_capacity)\n643\t    } else {\n644\t        DeviceBuffer::new()\n645\t    };\n646\t    let precompute_m_min_blocks_threshold = precompute_m_min_blocks_threshold();\n647\t    let precompute_m_target_blocks = precompute_m_target_blocks();\n648\t    let precompute_m_tail_tile_override = precompute_m_tail_tile_override();\n649\t    let precompute_m_min_n = precompute_m_min_n();\n650\t    let mut m_buffer = DeviceBuffer::<EF>::new();\n651\t    let mut m_partial_buffer = DeviceBuffer::<EF>::new();\n652\t    let mut eq_r_prefix_buffer = DeviceBuffer::<EF>::new();\n653\t    let mut eq_suffix_buffer = DeviceBuffer::<EF>::new();\n654\t\n655\t    for round in 1..total_rounds {\n656\t        let gkr_round_span = debug_span!(\"GKR\", round).entered();\n657\t\n658\t        // Note: frac_build_tree_layer revert is now fused into do_sumcheck_round_and_revert below.\n659\t\n660\t        debug_assert_eq!(xi_prev.len(), round);\n661\t        // eq_buffer stores eq(xi_prev[j..], x) for x in H_{xi_prev.len()-j} for\n662\t        // j=1,...,xi_prev.len()-1.\n663\t        let mut eq_buffer = SqrtEqLayers::from_xi(&xi_prev[1..])\n664\t            .map_err(FractionalSumcheckError::EvalEqHypercube)?;\n665\t\n666\t        let mut round_polys_eval = Vec::with_capacity(round);\n667\t        let mut r_vec = Vec::with_capacity(round);\n668\t        let mut pq_size = 2 << round;\n669\t\n670\t        let lambda = transcript.sample_ext();\n671\t\n672\t        let tmp_buffer_capacity =\n673\t            unsafe { _frac_compute_round_temp_buffer_size((1 << round) as u32) } as usize;\n674\t        if tmp_buffer_capacity > tmp_block_sums.len() {\n675\t            tmp_block_sums = DeviceBuffer::<EF>::with_capacity(tmp_buffer_capacity);\n676\t        }\n677\t\n678\t        let last_outer_round = round == total_rounds - 1;\n679\t        debug_assert!(round > 0);\n680\t        let backend = choose_round_strategy(\n681\t            round,\n682\t            precompute_m_env,\n683\t            precompute_m_min_blocks_threshold,\n684\t            precompute_m_target_blocks,\n685\t            precompute_m_tail_tile_override,\n686\t            precompute_m_min_n,\n687\t        );\n688\t\n689\t        // In round `j`, contains `s_{j-1}(r_{j-1})`. Starts with the sumcheck's sum claim.\n690\t        let (numer_claim, denom_claim) =\n691\t            reduce_to_single_evaluation(claims_per_layer.last().unwrap(), /* mu */ xi_prev[0]);\n692\t        let mut prev_s_eval = numer_claim + lambda * denom_claim;\n693\t        let mut eq_r_acc = EF::ONE;\n694\t\n695\t        // Round 0: compute + revert fused. The pq_buffer fold will be fused into next round's\n696\t        // compute. This fuses frac_build_tree_layer(revert=true) with the first inner round\n697\t        // compute.\n698\t        let r0 = do_sumcheck_round_and_revert(\n699\t            &mut eq_buffer,\n700\t            &mut layer,\n701\t            pq_size,\n702\t            lambda,\n703\t            transcript,\n704\t            &mut d_sum_evals,\n705\t            &mut tmp_block_sums,\n706\t            &mut round_polys_eval,\n707\t            &mut r_vec,\n708\t            &mut prev_s_eval,\n709\t            xi_prev[0],\n710\t            &mut eq_r_acc,\n711\t        )?;\n712\t\n713\t        // Fused rounds 1..(round-1): compute + fold using prev_r.\n714\t        let mut prev_r = r0;\n715\t        let active: &mut DeviceBuffer<Frac<EF>>;\n716\t\n717\t        match backend {\n718\t            GkrRoundStrategy::FoldEval => {\n719\t                // Existing fused path.\n720\t                let mut scheduler = BufferScheduler::new(max_work_size);\n721\t                for &xi_j in xi_prev.iter().skip(1) {\n722\t                    let src_pq_size = pq_size;\n723\t                    let post_fold_size = pq_size >> 1;\n724\t\n725\t                    let r = match scheduler.next_target(post_fold_size, last_outer_round) {\n726\t                        BufferTarget::LayerToWork => do_fused_sumcheck_round(\n727\t                            &mut eq_buffer,\n728\t                            &layer,\n729\t                            &mut work_buffer,\n730\t                            src_pq_size,\n731\t                            lambda,\n732\t                            prev_r,\n733\t                            transcript,\n734\t                            &mut d_sum_evals,\n735\t                            &mut tmp_block_sums,\n736\t                            &mut round_polys_eval,\n737\t                            &mut r_vec,\n738\t                            &mut prev_s_eval,\n739\t                            xi_j,\n740\t                            &mut eq_r_acc,\n741\t                        )?,\n742\t                        BufferTarget::WorkToLayer => do_fused_sumcheck_round(\n743\t                            &mut eq_buffer,\n744\t                            &work_buffe