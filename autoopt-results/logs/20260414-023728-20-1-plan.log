{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018eEUPwNAfoCcy1pqjNtC1C","type":"tool_result","content":"1\t#include \"device_ntt.cuh\"\n2\t#include \"fp.h\"\n3\t#include \"fpext.h\"\n4\t#include \"frac_ext.cuh\"\n5\t#include \"launcher.cuh\"\n6\t#include \"sumcheck.cuh\"\n7\t#include \"utils.cuh\"\n8\t#include <algorithm>\n9\t#include <cassert>\n10\t#include <cmath>\n11\t#include <cstddef>\n12\t#include <cstdint>\n13\t#include <cuda_runtime.h>\n14\t#include <utility>\n15\t#include <vector_types.h>\n16\t\n17\tusing namespace device_ntt;\n18\t\n19\tnamespace {\n20\t\n21\tconstexpr uint32_t MAX_GRID_DIM = 65535u;\n22\t// S_DEG=2 for MLE sumcheck rounds (kept for backward compatibility)\n23\tconstexpr int S_DEG = 2;\n24\t// Number of G outputs per z in round 0 (SP_DEG=1): G0, G1, G2\n25\tconstexpr int NUM_G = 3;\n26\t\n27\t} // namespace\n28\t\n29\tstruct UnstackedSlice {\n30\t    uint32_t commit_idx;\n31\t    uint32_t log_height;\n32\t    uint32_t stacked_row_idx;\n33\t    uint32_t stacked_col_idx;\n34\t};\n35\t\n36\tstruct UnstackedPleFoldPacket {\n37\t    const Fp *__restrict__ src;\n38\t    FpExt *__restrict__ dst;\n39\t    uint32_t height;\n40\t    uint32_t width;\n41\t};\n42\t\n43\t// Descriptor for batched degenerate MLE round kernel\n44\tstruct DegenMleDesc {\n45\t    uint32_t col_offset;    // = window[0], indexes into unstacked_cols, eq_ub, lambda_pows\n46\t    uint32_t window_len;    // = window[1] - window[0]\n47\t    FpExt eq_r;             // from eq_stable[log_height]\n48\t    FpExt k_rot_r;          // from k_rot_stable[log_height]\n49\t};\n50\t\n51\t// Descriptor for batched non-degenerate MLE round kernel\n52\tstruct NonDegenMleDesc {\n53\t    uint32_t col_offset;    // = window[0]\n54\t    uint32_t window_len;    // = window[1] - window[0]\n55\t    uint32_t num_y;         // = 1 << (log_height - l_skip - round)\n56\t    uint32_t stride;        // auto-tuned grid.y from existing heuristic\n57\t    uint32_t blocks_x;      // = ceil(num_y / 256)\n58\t};\n59\t\n60\t__device__ __forceinline__ FpExt get_eq_cube(const FpExt *eq_r_ns, uint32_t cube_size, uint32_t x) {\n61\t    return eq_r_ns[cube_size + x];\n62\t}\n63\t\n64\t__device__ __forceinline__ uint32_t rot_prev(uint32_t x_int, uint32_t cube_size) {\n65\t    return x_int == 0 ? cube_size - 1 : x_int - 1;\n66\t}\n67\t\n68\t__device__ __forceinline__ Fp eq1(Fp x, Fp y) { return Fp::one() - x - y + Fp(2) * x * y; }\n69\t\n70\t__device__ __forceinline__ Fp barycentric_interpolate_strided(\n71\t    const Fp *evals,\n72\t    uint32_t evals_len,\n73\t    uint32_t z,\n74\t    uint32_t expansion_factor,     // large_domain / skip_domain\n75\t    const Fp *inv_lagrange_denoms, // denoms specifically for z\n76\t    const Fp *omega_skip_pows,\n77\t    uint32_t skip_domain\n78\t) {\n79\t    Fp q = Fp::zero();\n80\t    uint32_t stride = evals_len >= skip_domain ? 1 : skip_domain / evals_len;\n81\t    if (z % expansion_factor == 0) {\n82\t        auto i = z / expansion_factor;\n83\t        if (i % stride == 0)\n84\t            q = evals[i / stride];\n85\t    } else {\n86\t        for (int idx = 0; idx < (skip_domain / stride); idx++) {\n87\t            q += evals[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n88\t        }\n89\t    }\n90\t    return q;\n91\t}\n92\t\n93\t// SP_DEG=1 kernel: compute 3 partial sums G0, G1, G2 on identity coset only.\n94\t// No iNTT/NTT operations - reconstruction happens on CPU via NTT-based polynomial multiplication.\n95\t//\n96\t// Each block covers a tile of z-values (threadIdx.x) and collaborates across threads\n97\t// to sum over x for a single column. Blocks stride over columns via gridDim.y.\n98\t//\n99\t// G0(Z) = Σ_{col,x} coeff_eq[col] * eq_cube(x) * q_{col,x}(Z)\n100\t// G1(Z) = Σ_{col,x} coeff_rot[col] * eq_cube(x) * q_{col,x}(Z)\n101\t// G2(Z) = Σ_{col,x} coeff_rot[col] * (eq_cube(rot_prev(x)) - eq_cube(x)) * q_{col,x}(Z)\n102\t//\n103\t// where coeff_eq[col] = lambda_pows[2*col], coeff_rot[col] = lambda_pows[2*col+1]\n104\t__global__ void stacked_reduction_round0_block_sum_kernel(\n105\t    const FpExt *__restrict__ eq_r_ns, // pointer to EqEvalSegments\n106\t    const Fp *__restrict__ trace_ptr,\n107\t    const FpExt *__restrict__ lambda_pows, // pointer to lambda_pows at window start\n108\t    FpExt *__restrict__ block_sums, // [gridDim.x * gridDim.y][NUM_G * skip_domain]\n109\t    uint32_t height,                // trace height\n110\t    uint32_t width,                 // trace width\n111\t    uint32_t l_skip,\n112\t    uint32_t skip_mask, // 2^l_skip - 1\n113\t    uint32_t num_x,     // 1 << n_lift\n114\t    uint32_t log_stride\n115\t) {\n116\t    extern __shared__ char smem[];\n117\t    // Use blockDim.x + 1 stride to avoid shared memory bank conflicts\n118\t    const uint32_t PADDED_X = blockDim.x + 1;\n119\t    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem); // FpExt[NUM_G][PADDED_X]\n120\t\n121\t    uint32_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n122\t    uint32_t z_idx = tidx & skip_mask;\n123\t    uint32_t x_int = tidx >> l_skip;\n124\t    uint32_t col_idx = blockIdx.y;\n125\t\n126\t    // Compute G weights (no z-dependent packets needed)\n127\t    FpExt eq_cube = get_eq_cube(eq_r_ns, num_x, x_int);\n128\t    FpExt eq_cube_rot_prev = get_eq_cube(eq_r_ns, num_x, rot_prev(x_int, num_x));\n129\t    FpExt k_rot_diff = eq_cube_rot_prev - eq_cube;\n130\t\n131\t    FpExt coeff_eq = lambda_pows[2 * col_idx];      // for G0\n132\t    FpExt coeff_rot = lambda_pows[2 * col_idx + 1]; // for G1, G2\n133\t\n134\t    FpExt w0 = coeff_eq * eq_cube;      // weight for G0\n135\t    FpExt w1 = coeff_rot * eq_cube;     // weight for G1\n136\t    FpExt w2 = coeff_rot * k_rot_diff;  // weight for G2\n137\t\n138\t    // Load trace value (identity coset only, no NTT needed)\n139\t    auto evals = trace_ptr + col_idx * height + (x_int << (l_skip - log_stride));\n140\t    auto stride_mask = (1u << log_stride) - 1;\n141\t    Fp q = (z_idx & stride_mask) == 0 ? evals[z_idx >> log_stride] : Fp::zero();\n142\t\n143\t    // Store 3 partial sums to shared memory\n144\t    shared_sum[0 * PADDED_X + threadIdx.x] = w0 * q;\n145\t    shared_sum[1 * PADDED_X + threadIdx.x] = w1 * q;\n146\t    shared_sum[2 * PADDED_X + threadIdx.x] = w2 * q;\n147\t\n148\t    __syncthreads();\n149\t\n150\t    // Reduction: only threads in first x-slice participate\n151\t    if ((threadIdx.x >> l_skip) == 0) {\n152\t        FpExt g0 = shared_sum[0 * PADDED_X + z_idx];\n153\t        FpExt g1 = shared_sum[1 * PADDED_X + z_idx];\n154\t        FpExt g2 = shared_sum[2 * PADDED_X + z_idx];\n155\t\n156\t        for (int lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n157\t            g0 += shared_sum[0 * PADDED_X + (lane << l_skip) + z_idx];\n158\t            g1 += shared_sum[1 * PADDED_X + (lane << l_skip) + z_idx];\n159\t            g2 += shared_sum[2 * PADDED_X + (lane << l_skip) + z_idx];\n160\t        }\n161\t\n162\t        // Output: 3 values per z_idx, stored contiguously\n163\t        uint32_t skip_domain = 1u << l_skip;\n164\t        FpExt *out_ptr =\n165\t            block_sums + (col_idx * gridDim.x + blockIdx.x) * (NUM_G * skip_domain);\n166\t        out_ptr[0 * skip_domain + z_idx] = g0;\n167\t        out_ptr[1 * skip_domain + z_idx] = g1;\n168\t        out_ptr[2 * skip_domain + z_idx] = g2;\n169\t    }\n170\t}\n171\t\n172\t// Single-trace kernel: each chunk of skip_domain threads handles one output cell\n173\t// Parallelizes barycentric interpolation across threads for better performance\n174\t// Grid: (num_row_blocks, trace_width) where blockIdx.y selects the column\n175\t__global__ void stacked_reduction_fold_ple_kernel(\n176\t    const Fp *__restrict__ src,\n177\t    FpExt *__restrict__ dst,\n178\t    const Fp *__restrict__ omega_skip_pows,\n179\t    const FpExt *__restrict__ inv_lagrange_denoms,\n180\t    uint32_t trace_height,\n181\t    uint32_t new_height,\n182\t    uint32_t skip_domain\n183\t) {\n184\t    extern __shared__ char smem_raw[];\n185\t    FpExt *smem = reinterpret_cast<FpExt *>(smem_raw);\n186\t\n187\t    uint32_t col_idx = blockIdx.y;\n188\t    uint32_t chunks_per_block = blockDim.x / skip_domain;\n189\t    uint32_t chunk_in_block = threadIdx.x / skip_domain;\n190\t    uint32_t tid_in_chunk = threadIdx.x % skip_domain;\n191\t    uint32_t row_idx = blockIdx.x * chunks_per_block + chunk_in_block;\n192\t\n193\t    // Cannot early-return: all threads must participate in chunk_reduce_sum (uses __syncthreads)\n194\t    bool const active_chunk = (row_idx < new_height);\n195\t\n196\t    // Barycentric interpolation: each thread handles exactly ONE term\n197\t    // (since src_len <= skip_domain, each thread contributes at most one term)\n198\t    FpExt local_val(Fp::zero());\n199\t    if (active_chunk) {\n200\t        uint32_t src_len = std::min(trace_height, skip_domain);"}]},"parent_tool_use_id":"toolu_011EnkkyqKPywMtC8DLs1b6h","session_id":"d2e39847-b30b-4a34-8468-d493bf69eac0","uuid":"248065ce-89b5-4283-9e68-6da1c5b2cfff","timestamp":"2026-04-14T00:44:43.263Z"}
