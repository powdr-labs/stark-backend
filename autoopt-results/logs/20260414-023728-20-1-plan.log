{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E3sqy64qTaTyEr1BdP53LD","type":"tool_result","content":"790\t    #[instrument(\"stacked_reduction_sumcheck\", level = \"debug\", skip_all, fields(round = round))]\n791\t    fn batch_sumcheck_poly_eval(\n792\t        &mut self,\n793\t        round: usize,\n794\t        _u_prev: EF,\n795\t    ) -> Result<[EF; STACKED_REDUCTION_S_DEG], StackedReductionError> {\n796\t        let l_skip = self.l_skip;\n797\t\n798\t        let q_eval_ptrs = self.q_evals.iter().map(|q| q.as_ptr()).collect_vec();\n799\t        q_eval_ptrs.copy_to(&mut self.d_q_eval_ptrs)?;\n800\t\n801\t        if self.n_max >= (round - 1) {\n802\t            // Move stable eq, k_rot to stable vectors\n803\t            let mut tmp = [EF::ZERO];\n804\t            debug_assert_eq!(self.eq_stable.len(), l_skip + round - 1);\n805\t            debug_assert_eq!(self.k_rot_stable.len(), l_skip + round - 1);\n806\t            debug_assert!(self.eq_r_ns.buffer.len() > 1);\n807\t            debug_assert!(self.k_rot_ns.buffer.len() > 1);\n808\t            // SAFETY: size of eq_r_ns, k_rot_ns is currently 2 * 2^{n_max - round + 1}\n809\t            unsafe {\n810\t                // D2H copy of single EF element\n811\t                cuda_memcpy::<true, false>(\n812\t                    tmp.as_mut_ptr() as *mut c_void,\n813\t                    self.eq_r_ns.get_ptr(0) as *const c_void,\n814\t                    size_of::<EF>(),\n815\t                )?;\n816\t\n817\t                self.eq_stable.push(tmp[0]);\n818\t\n819\t                // D2H copy of single EF element\n820\t                cuda_memcpy::<true, false>(\n821\t                    tmp.as_mut_ptr() as *mut c_void,\n822\t                    self.k_rot_ns.get_ptr(0) as *const c_void,\n823\t                    size_of::<EF>(),\n824\t                )?;\n825\t\n826\t                self.k_rot_stable.push(tmp[0]);\n827\t            }\n828\t        }\n829\t        // Upload full eq_ub_per_trace to device once per round\n830\t        self.eq_ub_per_trace.copy_to(&mut self.d_eq_ub_all)?;\n831\t\n832\t        // Single fill_zero for the entire round — all windows accumulate atomically\n833\t        self.d_accum\n834\t            .fill_zero()\n835\t            .map_err(StackedReductionError::FillZero)?;\n836\t\n837\t        // Phase A: Build descriptors (CPU-only, no CUDA calls)\n838\t        let mut degen_descs: Vec<DegenMleDesc> = Vec::new();\n839\t        let mut nondegen_descs: Vec<NonDegenMleDesc> = Vec::new();\n840\t        let mut nondegen_prefix_sums: Vec<u32> = Vec::new();\n841\t        let mut total_nondegen_blocks: u32 = 0;\n842\t\n843\t        for window in self.ht_diff_idxs.windows(2) {\n844\t            let col_offset = window[0] as u32;\n845\t            let window_len = (window[1] - window[0]) as u32;\n846\t            let log_height = self.unstacked_cols[window[0]].log_height as usize;\n847\t\n848\t            if log_height < l_skip + round {\n849\t                degen_descs.push(DegenMleDesc {\n850\t                    col_offset,\n851\t                    window_len,\n852\t                    eq_r: self.eq_stable[log_height],\n853\t                    k_rot_r: self.k_rot_stable[log_height],\n854\t                });\n855\t            } else {\n856\t                let hypercube_dim = log_height - l_skip - round;\n857\t                let num_y = 1u32 << hypercube_dim;\n858\t                let (blocks_x, stride) =\n859\t                    compute_mle_launch_params(num_y, window_len, self.sm_count);\n860\t                nondegen_prefix_sums.push(total_nondegen_blocks);\n861\t                total_nondegen_blocks += blocks_x * stride;\n862\t                nondegen_descs.push(NonDegenMleDesc {\n863\t                    col_offset,\n864\t                    window_len,\n865\t                    num_y,\n866\t                    stride,\n867\t                    blocks_x,\n868\t                });\n869\t            }\n870\t        }\n871\t\n872\t        // Phase B: Upload descriptors and launch batched kernels\n873\t        let stacked_height = self.stacked_height(round);\n874\t        let shift_factor = (l_skip + round) as u32;\n875\t\n876\t        if !degen_descs.is_empty() {\n877\t            let d_degen_descs = degen_descs\n878\t                .to_device()\n879\t                .map_err(StackedReductionError::MemCopy)?;\n880\t            unsafe {\n881\t                batched_stacked_reduction_sumcheck_mle_round_degenerate(\n882\t                    &d_degen_descs,\n883\t                    &self.d_q_eval_ptrs,\n884\t                    self.d_eq_ub_all.as_ptr(),\n885\t                    self.d_unstacked_cols.as_ptr(),\n886\t                    self.d_lambda_pows.as_ptr(),\n887\t                    &mut self.d_accum,\n888\t                    stacked_height,\n889\t                    shift_factor,\n890\t                )\n891\t                .map_err(StackedReductionError::SumcheckMleRoundDegenerate)?;\n892\t            }\n893\t        }\n894\t\n895\t        if !nondegen_descs.is_empty() {\n896\t            let d_nondegen_descs = nondegen_descs\n897\t                .to_device()\n898\t                .map_err(StackedReductionError::MemCopy)?;\n899\t            let d_block_offsets = nondegen_prefix_sums\n900\t                .to_device()\n901\t                .map_err(StackedReductionError::MemCopy)?;\n902\t            unsafe {\n903\t                batched_stacked_reduction_sumcheck_mle_round(\n904\t                    &d_nondegen_descs,\n905\t                    &d_block_offsets,\n906\t                    total_nondegen_blocks,\n907\t                    &self.d_q_eval_ptrs,\n908\t                    &self.eq_r_ns,\n909\t                    &self.k_rot_ns,"}]},"parent_tool_use_id":"toolu_01WFWjUeJtR4i6PboGBx31jh","session_id":"d2e39847-b30b-4a34-8468-d493bf69eac0","uuid":"566ae4b4-0b06-46f1-832d-d6fa3ddd23a1","timestamp":"2026-04-14T00:44:35.366Z"}
