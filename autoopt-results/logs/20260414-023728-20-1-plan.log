{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WutnzDSJGXs2gKofkWG1k8","type":"tool_result","content":"100\t\n101\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n102\t/// instead of the monomial kernel for high num_y traces.\n103\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n104\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n105\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n106\t\n107\t#[inline]\n108\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n109\t    if need_rot {\n110\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n111\t        (mat_width / 2) as u32\n112\t    } else {\n113\t        mat_width as u32\n114\t    }\n115\t}\n116\t\n117\t/// Result of processing one AIR in Round 0.\n118\tstruct Round0AirResult {\n119\t    trace_idx: usize,\n120\t    zerocheck_poly: Option<UnivariatePoly<EF>>,\n121\t    logup_numer_poly: Option<UnivariatePoly<EF>>,\n122\t    logup_denom_poly: Option<UnivariatePoly<EF>>,\n123\t}\n124\t\n125\t/// All read-only references needed to process one AIR in Round 0.\n126\tstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n127\t    trace_idx: usize,\n128\t    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n129\t    n: isize,\n130\t    selectors_cube: &'a DeviceMatrix<F>,\n131\t    public_values: &'a DeviceBuffer<F>,\n132\t    eq_3bs: &'a [EF],\n133\t    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n134\t    common_main: &'a DeviceMatrix<F>,\n135\t    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n136\t    d_lambda_pows: &'a DeviceBuffer<EF>,\n137\t    beta_pows: &'a [EF],\n138\t    l_skip: usize,\n139\t    constraint_degree: usize,\n140\t    xi: &'a [EF],\n141\t    max_temp_bytes: usize,\n142\t    /// Pre-computed zerocheck intermediates buffer capacity needed\n143\t    zc_intermed_cap: usize,\n144\t    /// Pre-computed zerocheck temp sums buffer capacity needed\n145\t    zc_temp_sums_cap: usize,\n146\t    /// Pre-computed logup intermediates buffer capacity needed\n147\t    logup_intermed_cap: usize,\n148\t    /// Pre-computed logup temp sums buffer capacity needed\n149\t    logup_temp_sums_cap: usize,\n150\t}\n151\t\n152\tfn process_air_round0<HS: GpuHashScheme>(\n153\t    w: &Round0AirWorkItem<HS>,\n154\t    bufs: &mut round0::Round0ThreadBuffers,\n155\t) -> Result<Round0AirResult, LogupZerocheckError> {\n156\t    let single_pk = w.single_pk;\n157\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n158\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n159\t    assert!(\n160\t        local_constraint_deg <= w.constraint_degree,\n161\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n162\t        w.constraint_degree\n163\t    );\n164\t\n165\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n166\t    let omega_root = F::two_adic_generator(log_large_domain);\n167\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n168\t\n169\t    let height = w.common_main.height();\n170\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n171\t    for committed in w.cached_mains {\n172\t        main_parts.push(committed.trace.buffer().as_ptr());\n173\t    }\n174\t    main_parts.push(w.common_main.buffer().as_ptr());\n175\t    let d_main_parts = main_parts.to_device()?;\n176\t\n177\t    let n_lift = w.n.max(0) as usize;\n178\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n179\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n180\t\n181\t    // Check if pre-allocated zerocheck buffers are large enough for this AIR\n182\t    let zc_prealloc_inter = if w.zc_intermed_cap > 0\n183\t        && bufs.zc_intermediates.len() >= w.zc_intermed_cap\n184\t    {\n185\t        Some(&mut bufs.zc_intermediates)\n186\t    } else {\n187\t        None\n188\t    };\n189\t    let zc_prealloc_temp = if w.zc_temp_sums_cap > 0"}]},"parent_tool_use_id":null,"session_id":"d2e39847-b30b-4a34-8468-d493bf69eac0","uuid":"ef4e2c41-725f-4395-8602-3ae65eee3827","timestamp":"2026-04-14T00:57:02.393Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/mod.rs","content":"\n/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n/// instead of the monomial kernel for high num_y traces.\n/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\nconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n\n#[inline]\npub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n    if need_rot {\n        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n        (mat_width / 2) as u32\n    } else {\n        mat_width as u32\n    }\n}\n\n/// Result of processing one AIR in Round 0.\nstruct Round0AirResult {\n    trace_idx: usize,\n    zerocheck_poly: Option<UnivariatePoly<EF>>,\n    logup_numer_poly: Option<UnivariatePoly<EF>>,\n    logup_denom_poly: Option<UnivariatePoly<EF>>,\n}\n\n/// All read-only references needed to process one AIR in Round 0.\nstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n    trace_idx: usize,\n    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n    n: isize,\n    selectors_cube: &'a DeviceMatrix<F>,\n    public_values: &'a DeviceBuffer<F>,\n    eq_3bs: &'a [EF],\n    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n    common_main: &'a DeviceMatrix<F>,\n    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n    d_lambda_pows: &'a DeviceBuffer<EF>,\n    beta_pows: &'a [EF],\n    l_skip: usize,\n    constraint_degree: usize,\n    xi: &'a [EF],\n    max_temp_bytes: usize,\n    /// Pre-computed zerocheck intermediates buffer capacity needed\n    zc_intermed_cap: usize,\n    /// Pre-computed zerocheck temp sums buffer capacity needed\n    zc_temp_sums_cap: usize,\n    /// Pre-computed logup intermediates buffer capacity needed\n    logup_intermed_cap: usize,\n    /// Pre-computed logup temp sums buffer capacity needed\n    logup_temp_sums_cap: usize,\n}\n\nfn process_air_round0<HS: GpuHashScheme>(\n    w: &Round0AirWorkItem<HS>,\n    bufs: &mut round0::Round0ThreadBuffers,\n) -> Result<Round0AirResult, LogupZerocheckError> {\n    let single_pk = w.single_pk;\n    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n    assert!(\n        local_constraint_deg <= w.constraint_degree,\n        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n        w.constraint_degree\n    );\n\n    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n    let omega_root = F::two_adic_generator(log_large_domain);\n    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n\n    let height = w.common_main.height();\n    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n    for committed in w.cached_mains {\n        main_parts.push(committed.trace.buffer().as_ptr());\n    }\n    main_parts.push(w.common_main.buffer().as_ptr());\n    let d_main_parts = main_parts.to_device()?;\n\n    let n_lift = w.n.max(0) as usize;\n    let eq_xi_tree = &w.eq_xis[&n_lift];\n    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n\n    // Check if pre-allocated zerocheck buffers are large enough for this AIR\n    let zc_prealloc_inter = if w.zc_intermed_cap > 0\n        && bufs.zc_intermediates.len() >= w.zc_intermed_cap\n    {\n        Some(&mut bufs.zc_intermediates)\n    } else {\n        None\n    };\n    let zc_prealloc_temp = if w.zc_temp_sums_cap > 0","numLines":90,"startLine":100,"totalLines":1983}}}
