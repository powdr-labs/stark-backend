().\n320\t__device__ void bn254_sponge_duplex(DeviceBn254SpongeState& s) {\n321\t    // Pack input_buffer into sponge_state in chunks of BN254_GRIND_NUM_F_ELMS=3\n322\t    for (int i = 0; (uint32_t)(i * BN254_GRIND_NUM_F_ELMS) < s.input_len; i++) {\n323\t        int start = i * BN254_GRIND_NUM_F_ELMS;\n324\t        int cnt   = (int)s.input_len - start;\n325\t        if (cnt > BN254_GRIND_NUM_F_ELMS) cnt = BN254_GRIND_NUM_F_ELMS;\n326\t        s.sponge_state[i] = bn254_reduce_32(s.input_buffer + start, cnt);\n327\t    }\n328\t    s.input_len = 0;\n329\t\n330\t    bn254_poseidon2_permute(s.sponge_state);\n331\t\n332\t    // Split each Bn254Fr into BN254_GRIND_NUM_F_ELMS=3 BabyBear values\n333\t    s.output_len = 0;\n334\t    for (int i = 0; i < BN254_GRIND_WIDTH; i++) {\n335\t        uint32_t bb[3];\n336\t        bn254_split_32_3(bb, s.sponge_state[i]);\n337\t        for (int j = 0; j < BN254_GRIND_NUM_F_ELMS; j++) {\n338\t            s.output_buffer[s.output_len++] = bb[j];\n339\t        }\n340\t    }\n341\t    // output_len == 9 after full duplexing\n342\t}\n343\t\n344\t/// Observe a canonical BabyBear u32 value into the sponge.\n345\t/// Matches MultiField32Challenger::observe().\n346\t__device__ void bn254_sponge_observe(DeviceBn254SpongeState& s, uint32_t value) {\n347\t    s.output_len = 0; // invalidate buffered output\n348\t    s.input_buffer[s.input_len++] = value;\n349\t    if (s.input_len == BN254_GRIND_MAX_INPUT) {\n350\t        bn254_sponge_duplex(s);\n351\t    }\n352\t}\n353\t\n354\t/// Sample a canonical BabyBear u32 value from the sponge.\n355\t/// Matches MultiField32Challenger::sample() (uses Vec::pop, i.e. last element).\n356\t__device__ uint32_t bn254_sponge_sample(DeviceBn254SpongeState& s) {\n357\t    if (s.input_len > 0 || s.output_len == 0) {\n358\t        bn254_sponge_duplex(s);\n359\t    }\n360\t    return s.output_buffer[--s.output_len]; // pop from end\n361\t}\n362\t\n363\t/// Returns true if check_witness(bits, witness) passes.\n364\t__device__ bool bn254_sponge_check_witness(DeviceBn254SpongeState& s,\n365\t                                           uint32_t bits, uint32_t witness) {\n366\t    bn254_sponge_observe(s, witness);\n367\t    uint32_t sample = bn254_sponge_sample(s);\n368\t    return (sample & ((1u << bits) - 1)) == 0;\n369\t}\n370\t\n371\tstatic const uint32_t BN254_GRIND_BLOCK_SIZE = 32;\n372\t\n373\t/// Grinding kernel: find any w in [min_witness, max_witness] with check_witness(bits,w)==true.\n374\t__launch_bounds__(BN254_GRIND_BLOCK_SIZE) __global__ void bn254_grind_kernel(\n375\t    const DeviceBn254SpongeState* init_state,\n376\t    uint32_t bits,\n377\t    uint32_t min_witness,\n378\t    uint32_t max_witness,\n379\t    uint32_t* result\n380\t) {\n381\t    const uint32_t tid = blockIdx.x * blockDim.x + threadIdx.x;\n382\t    const uint32_t stride = gridDim.x * blockDim.x;\n383\t    uint32_t w = min_witness + tid;\n384\t\n385\t    if (w > max_witness || *result != UINT32_MAX) return;\n386\t\n387\t    while (w <= max_witness) {\n388\t        if (*result != UINT32_MAX) return;\n389\t\n390\t        DeviceBn254SpongeState local_state = *init_state;\n391\t        if (bn254_sponge_check_witness(local_state, bits, w)) {\n392\t            atomicCAS(result, UINT32_MAX, w);\n393\t            return;\n394\t        }\n395\t\n396\t        if (max_witness - w < stride) return;\n397\t        w += stride;\n398\t    }\n399\t}\n400\t\n401\t// ---------------------------------------------------------------------------\n402\t// Extern \"C\" launchers\n403\t// ---------------------------------------------------------------------------\n404\t\n405\t/// Upload BN254 Poseidon2 round constants (in Montgomery form) to device constant memory.\n406\t///\n407\t/// @param initial_rc   Flat array of 4*3*4 = 48 uint64s  (initial external rounds)\n408\t/// @param partial_rc   Flat array of 56*4 = 224 uint64s  (internal/partial rounds)\n409\t/// @param terminal_rc  Flat array of 4*3*4 = 48 uint64s  (terminal externa