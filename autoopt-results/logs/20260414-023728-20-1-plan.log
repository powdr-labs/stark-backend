{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016XajB5eT6H9hwYkWayeejd","type":"tool_result","content":"1\t/**\n2\t * GPU-accelerated Poseidon2 duplex sponge grinding kernel.\n3\t * \n4\t * This implements proof-of-work grinding on GPU for the Fiat-Shamir transcript.\n5\t */\n6\t\n7\t#include \"fp.h\"\n8\t#include \"launcher.cuh\"\n9\t#include \"poseidon2.cuh\"\n10\t#include <cstdint>\n11\t\n12\t// Must match the Rust DeviceSpongeState struct layout\n13\tstruct DeviceSpongeState {\n14\t    Fp state[CELLS];      // WIDTH = 16\n15\t    uint32_t absorb_idx;\n16\t    uint32_t sample_idx;\n17\t};\n18\t\n19\tstatic_assert(sizeof(DeviceSpongeState) == CELLS * sizeof(Fp) + 2 * sizeof(uint32_t),\n20\t              \"DeviceSpongeState size mismatch with Rust\");\n21\t\n22\t// Sponge operations matching DuplexSponge behavior\n23\t\n24\t__device__ void sponge_observe(DeviceSpongeState& sponge, Fp value) {\n25\t    sponge.state[sponge.absorb_idx] = value;\n26\t    sponge.absorb_idx += 1;\n27\t    if (sponge.absorb_idx == CELLS_RATE) {\n28\t        poseidon2::poseidon2_mix(sponge.state);\n29\t        sponge.absorb_idx = 0;\n30\t        sponge.sample_idx = CELLS_RATE;\n31\t    }\n32\t}\n33\t\n34\t__device__ Fp sponge_sample(DeviceSpongeState& sponge) {\n35\t    if (sponge.absorb_idx != 0 || sponge.sample_idx == 0) {\n36\t        poseidon2::poseidon2_mix(sponge.state);\n37\t        sponge.absorb_idx = 0;\n38\t        sponge.sample_idx = CELLS_RATE;\n39\t    }\n40\t    sponge.sample_idx -= 1;\n41\t    return sponge.state[sponge.sample_idx];\n42\t}\n43\t\n44\t__device__ uint32_t sponge_sample_bits(DeviceSpongeState& sponge, uint32_t bits) {\n45\t    Fp rand_f = sponge_sample(sponge);\n46\t    uint32_t rand_u32 = rand_f.asUInt32();\n47\t    return rand_u32 & ((1u << bits) - 1);\n48\t}\n49\t\n50\t__device__ bool sponge_check_witness(DeviceSpongeState& sponge, uint32_t bits, Fp witness) {\n51\t    sponge_observe(sponge, witness);\n52\t    return sponge_sample_bits(sponge, bits) == 0;\n53\t}\n54\t\n55\t/**\n56\t * Grinding kernel - finds a witness value such that check_witness(bits, witness) returns true.\n57\t * \n58\t * Each thread checks one witness candidate in the current chunk.\n59\t * When a valid witness is found, the first discovered witness is stored.\n60\t * \n61\t * @param init_state Initial sponge state (before observing the witness)\n62\t * @param bits Number of bits that must be zero in the sampled value\n63\t * @param max_witness Maximum witness value to try (usually F::ORDER - 1)\n64\t */\n65\t__global__ void grind_kernel(\n66\t    const DeviceSpongeState* init_state,\n67\t    uint32_t bits,\n68\t    uint32_t min_witness,\n69\t    uint32_t max_witness,\n70\t    uint32_t* result\n71\t) {\n72\t    uint32_t w = min_witness + blockIdx.x * blockDim.x + threadIdx.x;\n73\t    if (w > max_witness || *result != UINT32_MAX) {\n74\t        return;\n75\t    }\n76\t\n77\t    // Clone the initial state to local registers\n78\t    DeviceSpongeState local_state = *init_state;\n79\t\n80\t    // Check if this witness value works\n81\t    Fp witness = Fp(w);\n82\t    if (sponge_check_witness(local_state, bits, witness)) {\n83\t        // Found a valid witness - keep the first one discovered.\n84\t        atomicCAS(result, UINT32_MAX, w);\n85\t        return;\n86\t    }\n87\t}\n88\t\n89\t// Launcher function callable from Rust\n90\t\n91\textern \"C\" int _sponge_grind(\n92\t    const DeviceSpongeState* init_state,\n93\t    uint32_t bits,\n94\t    uint32_t min_witness,\n95\t    uint32_t max_witness,\n96\t    uint32_t* result  // Output: device pointer where the found witness value will be written.\n97\t    // Must be set to `UINT32_MAX` before this function call\n98\t) {\n99\t    auto const [grid, block] = kernel_launch_params(1 << bits);\n100\t    grind_kernel<<<grid, block>>>(init_state, bits, min_witness, max_witness, result);\n101\t\n102\t    cudaError_t err = cudaGetLastError();\n103\t    if (err != cudaSuccess) {\n104\t        return err;\n105\t    }\n106\t\n107\t    // Synchronize and copy result back\n108\t    err = cudaDeviceSynchronize();\n109\t    if (err != cudaSuccess) {\n110\t        return err;\n111\t    }\n112\t\n113\t    return CHECK_KERNEL();\n114\t}\n115\t"}]},"parent_tool_use_id":"toolu_011EnkkyqKPywMtC8DLs1b6h","session_id":"d2e39847-b30b-4a34-8468-d493bf69eac0","uuid":"f0b81e8b-ea58-423f-a9e6-f1ce3bccc86e","timestamp":"2026-04-14T00:44:08.952Z"}
