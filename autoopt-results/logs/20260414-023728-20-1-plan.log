coset_idx;\n297\t                numer_values[dst] = numer[src];\n298\t                denom_values[dst] = denom[src];\n299\t            }\n300\t        }\n301\t        let numer_poly = UnivariatePoly::from_geometric_cosets_evals_idft("}]},"parent_tool_use_id":"toolu_011sPSHiLjfXLysWWKc4dhP9","session_id":"d2e39847-b30b-4a34-8468-d493bf69eac0","uuid":"edd2165b-3ef3-4b8f-96d3-4b0a6fbcf802","timestamp":"2026-04-14T00:44:18.634Z"}
