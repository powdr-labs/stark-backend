{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016fTzc9bkSWBTtipicgrpBq","type":"tool_result","content":"1\tuse std::{ffi::c_void, sync::Arc};\n2\t\n3\tuse getset::Getters;\n4\tuse itertools::Itertools;\n5\tuse openvm_cuda_common::{copy::cuda_memcpy, d_buffer::DeviceBuffer, memory_manager::MemTracker};\n6\tuse openvm_stark_backend::{\n7\t    p3_util::log2_strict_usize,\n8\t    prover::{stacked_pcs::StackedLayout, MatrixDimensions},\n9\t};\n10\tuse tracing::instrument;\n11\t\n12\tuse crate::{\n13\t    base::{DeviceMatrix, DeviceMatrixView},\n14\t    cuda::{\n15\t        batch_ntt_small::batch_ntt_small,\n16\t        matrix::{batch_expand_pad, batch_expand_pad_wide},\n17\t        ntt::bit_rev,\n18\t    },\n19\t    hash_scheme::GpuMerkleHash,\n20\t    merkle_tree::{MerkleTreeConstructor, MerkleTreeGpu},\n21\t    ntt::batch_ntt,\n22\t    poly::{mle_interpolate_stages, PleMatrix},\n23\t    prelude::F,\n24\t    GpuProverConfig, ProverError, RsCodeMatrixError, StackTracesError,\n25\t};\n26\t\n27\t#[derive(Getters)]\n28\tpub struct StackedPcsDataGpu<F, Digest> {\n29\t    /// Layout of the unstacked collection of matrices within the stacked matrix.\n30\t    #[getset(get = \"pub\")]\n31\t    pub(crate) layout: StackedLayout,\n32\t    /// The stacked matrix with height `2^{l_skip + n_stack}`.\n33\t    /// This is optionally cached depending on the prover configuration:\n34\t    /// - Caching increases the peak GPU memory but avoids a recomputation during stacked\n35\t    ///   reduction.\n36\t    /// - Not caching means the stacked matrix computation is recomputed during stacked reduction,\n37\t    ///   but lowers the peak GPU memory.\n38\t    #[getset(get = \"pub\")]\n39\t    pub(crate) matrix: Option<PleMatrix<F>>,\n40\t    /// Merkle tree of the Reed-Solomon codewords of the stacked matrix.\n41\t    /// Depends on `k_whir` parameter.\n42\t    #[getset(get = \"pub\")]\n43\t    pub(crate) tree: MerkleTreeGpu<F, Digest>,\n44\t}\n45\t\n46\t#[allow(clippy::type_complexity)]\n47\t#[instrument(level = \"info\", skip_all)]\n48\tpub fn stacked_commit<MH: GpuMerkleHash + MerkleTreeConstructor>(\n49\t    l_skip: usize,\n50\t    n_stack: usize,\n51\t    log_blowup: usize,\n52\t    k_whir: usize,\n53\t    traces: &[&DeviceMatrix<F>],\n54\t    prover_config: GpuProverConfig,\n55\t) -> Result<(MH::Digest, StackedPcsDataGpu<F, MH::Digest>), ProverError> {\n56\t    let mut mem = MemTracker::start(\"prover.stacked_commit\");\n57\t    mem.tracing_info(\"before stacked_commit\");\n58\t    mem.reset_peak();\n59\t    let layout = get_stacked_layout(l_skip, n_stack, traces);\n60\t    tracing::info!(\n61\t        height = layout.height(),\n62\t        width = layout.width(),\n63\t        \"stacked_matrix_dimensions\"\n64\t    );\n65\t    let opt_stacked_matrix = if prover_config.cache_stacked_matrix {\n66\t        Some(stack_traces(&layout, traces)?)\n67\t    } else {\n68\t        None\n69\t    };\n70\t    let rs_matrix = rs_code_matrix(log_blowup, &layout, traces, &opt_stacked_matrix)?;\n71\t    let tree = MerkleTreeGpu::<F, MH::Digest>::new_with_hash::<MH>(\n72\t        rs_matrix,\n73\t        1 << k_whir,\n74\t        prover_config.cache_rs_code_matrix,\n75\t    )?;\n76\t    let root = tree.root();\n77\t    let data = StackedPcsDataGpu {\n78\t        layout,\n79\t        matrix: opt_stacked_matrix,\n80\t        tree,\n81\t    };\n82\t    mem.emit_metrics();\n83\t    Ok((root, data))\n84\t}\n85\t\n86\t/// The `traces` **must** already be in height-sorted order.\n87\t///\n88\t/// This function is generic in `F` and only relies on CUDA memory operations.\n89\t#[instrument(skip_all)]\n90\tpub fn stacked_matrix(\n91\t    l_skip: usize,\n92\t    n_stack: usize,\n93\t    traces: &[&DeviceMatrix<F>],\n94\t) -> Result<(PleMatrix<F>, StackedLayout), ProverError> {\n95\t    let layout = get_stacked_layout(l_skip, n_stack, traces);\n96\t    let matrix = stack_traces(&layout, traces)?;\n97\t    Ok((matrix, layout))\n98\t}\n99\t\n100\tpub(crate) fn get_stacked_layout(\n101\t    l_skip: usize,\n102\t    n_stack: usize,\n103\t    traces: &[&DeviceMatrix<F>],\n104\t) -> StackedLayout {\n105\t    let sorted_meta = traces\n106\t        .iter()\n107\t        .map(|trace| {\n108\t            // height cannot be zero:\n109\t            let log_height = log2_strict_usize(trace.height());\n110\t            (trace.width(), log_height)\n111\t        })\n112\t        .collect_vec();\n113\t    debug_assert!(sorted_meta.is_sorted_by(|a, b| a.1 >= b.1));\n114\t    StackedLayout::new(l_skip, l_skip + n_stack, sorted_meta).unwrap()\n115\t}\n116\t\n117\tpub(crate) fn stack_traces(\n118\t    layout: &StackedLayout,\n119\t    traces: &[&DeviceMatrix<F>],\n120\t) -> Result<PleMatrix<F>, StackTracesError> {\n121\t    let mem = MemTracker::start(\"prover.stack_traces\");\n122\t    let l_skip = layout.l_skip();\n123\t    let height = layout.height();\n124\t    let width = layout.width();\n125\t    let mut q_evals = DeviceBuffer::<F>::with_capacity(width.checked_mul(height).unwrap());\n126\t    stack_traces_into_expanded(layout, traces, &mut q_evals, height)?;\n127\t    mem.emit_metrics();\n128\t    Ok(PleMatrix::from_evals(l_skip, q_evals, height, width))\n129\t}\n130\t\n131\t/// `buffer` should be the buffer to write the stacked traces into.\n132\t/// `buffer` should be a matrix with dimensions `padded_height x width` where `width` is the stacked\n133\t/// width and `padded_height` must be a multiple of the stacked height.\n134\tpub(crate) fn stack_traces_into_expanded(\n135\t    layout: &StackedLayout,\n136\t    traces: &[&DeviceMatrix<F>],\n137\t    buffer: &mut DeviceBuffer<F>,\n138\t    padded_height: usize,\n139\t) -> Result<(), StackTracesError> {\n140\t    let l_skip = layout.l_skip();\n141\t    debug_assert_eq!(padded_height % layout.height(), 0);\n142\t    debug_assert_eq!(buffer.len() % padded_height, 0);\n143\t    debug_assert_eq!(buffer.len() / padded_height, layout.width());\n144\t    buffer.fill_zero().map_err(StackTracesError::FillZero)?;\n145\t    for (mat_idx, j, s) in &layout.sorted_cols {\n146\t        let start = s.col_idx * padded_height + s.row_idx;\n147\t        let trace = traces[*mat_idx];\n148\t        let s_len = s.len(l_skip);\n149\t        debug_assert_eq!(trace.height(), 1 << s.log_height());\n150\t        if s.log_height() >= l_skip {\n151\t            debug_assert_eq!(trace.height(), s_len);\n152\t            // SAFETY: matrix buffers are allocated correctly with respect to dimensions\n153\t            // - `trace.height() = s_len` since `log_height >= l_skip`\n154\t            // - `q_buf` has enough capacity by definition of stacked `layout`\n155\t            unsafe {\n156\t                let src = trace.buffer().as_ptr().add(*j * s_len);\n157\t                let dst = buffer.as_mut_ptr().add(start);\n158\t                // D2D memcpy\n159\t                cuda_memcpy::<true, true>(\n160\t                    dst as *mut c_void,\n161\t                    src as *const c_void,\n162\t                    s_len * size_of::<F>(),\n163\t                )?;\n164\t            }\n165\t        } else {\n166\t            let stride = s.stride(l_skip);\n167\t            debug_assert_eq!(stride * trace.height(), s_len);\n168\t            // SAFETY: matrix buffers are allocated correctly\n169\t            // - `q_buf` has enough capacity by definition of stacked `layout`\n170\t            // - we abuse `batch_expand_pad` with `poly_count = trace.height()` to create a strided\n171\t            //   column of length `s_len = stride * trace.height()`\n172\t            unsafe {\n173\t                let src = trace.buffer().as_ptr().add(*j * trace.height());\n174\t                let dst = buffer.as_mut_ptr().add(start);\n175\t                batch_expand_pad_wide(dst, src, trace.height() as u32, stride as u32, 1)\n176\t                    .map_err(StackTracesError::BatchExpandPadWide)?;\n177\t            }\n178\t        }\n179\t    }\n180\t    Ok(())\n181\t}\n182\t\n183\t/// Computes the Reed-Solomon codeword of each column vector of `eval_matrix` where the rate is\n184\t/// `2^{-log_blowup}`. The column vectors are treated as evaluations of a prismalinear extension on\n185\t/// a hyperprism.\n186\t///\n187\t/// Uses `stacked_matrix` if available, or else stacks `traces` directly into final codeword matrix\n188\t/// buffer.\n189\t#[instrument(skip_all)]\n190\tpub fn rs_code_matrix(\n191\t    log_blowup: usize,\n192\t    layout: &StackedLayout,\n193\t    traces: &[&DeviceMatrix<F>],\n194\t    stacked_matrix: &Option<PleMatrix<F>>,\n195\t) -> Result<DeviceMatrix<F>, RsCodeMatrixError> {\n196\t    let mem = MemTracker::start_and_reset_peak(\"prover.rs_code_matrix\");\n197\t    let l_skip = layout.l_skip();\n198\t    let height = layout.height();\n199\t    let width = layout.width();\n200\t    debug_assert!(height >= (1 << l_skip));\n201\t    let codeword_height = height.checked_shl(log_blowup as u32).unwrap();\n202\t    let mut codewords = DeviceBuffer::<F>::with_capacity(codeword_height * width);\n203\t    // The following kernels together perform MLE interpolation followed by coset NTT for\n204\t    // `width` polys from `height -> codeword_height` size domains.\n205\t    if let Some(stacked_matrix) = stacked_matrix.as_ref() {\n206\t        // SAFETY: `codewords` is allocated for `width` polys of `codeword_height` each, and we\n207\t        // expand from `matrix.mixed` which is `width` polys of `height` each.\n208\t        unsafe {\n209\t            batch_expand_pad(\n210\t                codewords.as_mut_ptr(),\n211\t                stacked_matrix.mixed.as_ptr(),\n212\t                width as u32,\n213\t                codeword_height as u32,\n214\t                height as u32,\n215\t            )\n216\t            .map_err(RsCodeMatrixError::BatchExpandPad)?;\n217\t        }\n218\t    } else {\n219\t        stack_traces_into_expanded(layout, traces, &mut codewords, codeword_height)\n220\t            .map_err(RsCodeMatrixError::StackTraces)?;\n221\t        // Currently codewords has the stacked matrix, batch expanded, in evaluation form on\n222\t        // hyperprism. We convert it to mixed form, i.e., unroll `PleMatrix::from_evals`.\n223\t        // PERF[jpw]: We do some wasted work on the padded zero part. A more specialized kernel\n224\t        // could be written to avoid this.\n225\t        if l_skip > 0 {\n226\t            // For univariate coordinate, perform inverse NTT for each 2^l_skip chunk per column:\n227\t            // (width cols) * (codeword_height / 2^l_skip chunks per col). Use natural ordering.\n228\t            let num_uni_poly = width * (codeword_height >> l_skip);\n229\t            unsafe {\n230\t                batch_ntt_small(&mut codewords, l_skip, num_uni_poly, true)\n231\t                    .map_err(RsCodeMatrixError::CustomBatchIntt)?;\n232\t            }\n233\t        }\n234\t    }\n235\t    // Eval-to-coeff RS encoding: Instead of full n-stage MLE evals→coeffs interpolation\n236\t    // (where n = log_height - l_skip), we only need l_skip stages of coeffs→evals\n237\t    // (subset-zeta transform) within each 2^l_skip chunk. This is a major optimization:\n238\t    // e.g. for log_height=17, l_skip=2: 2 stages instead of 15.\n239\t    let log_codeword_height = log2_strict_usize(codeword_height);\n240\t\n241\t    // Apply l_skip stages of coeffs_to_evals within each 2^l_skip chunk.\n242\t    // After iNTT, each chunk holds Z-monomial coefficients. We apply the subset-zeta\n243\t    // transform to convert to hypercube evaluations over the Z-bit variables.\n244\t    if l_skip > 0 {\n245\t        // SAFETY: `codewords` is properly initialized and parameters are valid.\n246\t        // Steps 2^0, 2^1, ..., 2^(l_skip-1) stay within chunk boundaries.\n247\t        unsafe {\n248\t            mle_interpolate_stages(\n249\t                codewords.as_mut_ptr(),\n250\t                width as u16,\n251\t                codeword_height as u32,\n252\t                log_blowup as u32,\n253\t                0,                 // start_log_step\n254\t                l_skip as u32 - 1, // end_log_step (inclusive)\n255\t                false,             // coeffs to evals (NOT eval to coeff)\n256\t                false,             // natural order\n257\t            )\n258\t            .map_err(|error| RsCodeMatrixError::MleInterpolateStage2d { error, step: 1 })?;\n259\t        }\n260\t    }\n261\t\n262\t    // Bit-reverse the entire buffer in-place (required for NTT)\n263\t    unsafe {\n264\t        bit_rev(\n265\t            &codewords,\n266\t            &codewords,\n267\t            log_codeword_height as u32,\n268\t            codeword_height as u32,\n269\t            width as u32,\n270\t        )\n271\t        .map_err(RsCodeMatrixError::BitRev)?;\n272\t    }\n273\t\n274\t    // Compute RS codeword via DFT on the smoothly-embedded domain.\n275\t    batch_ntt(\n276\t        &codewords,\n277\t        log_codeword_height as u32,\n278\t        0u32,\n279\t        width as u32,\n280\t        false, // bit-reversal already done\n281\t        false,\n282\t    );\n283\t    let code_matrix = DeviceMatrix::new(Arc::new(codewords), codeword_height, width);\n284\t    mem.emit_metrics();\n285\t\n286\t    Ok(code_matrix)\n287\t}\n288\t\n289\timpl<F, Digest> StackedPcsDataGpu<F, Digest> {\n290\t    /// Returns a view of the specified unstacked matrix in mixed form.\n291\t    ///\n292\t    /// # Notes\n293\t    /// - `width` must be the width of the unstacked matrix.\n294\t    /// - The unstacked matrix may be strided - this must be handled by the caller.\n295\t    pub fn mixed_view<'a>(\n296\t        &'a self,\n297\t        mat_idx: usize,\n298\t        width: usize,\n299\t    ) -> Option<DeviceMatrixView<'a, F>> {\n300\t        if let Some(matrix) = self.matrix.as_ref() {\n301\t            debug_assert_eq!(self.layout.width_of(mat_idx), width);\n302\t            let s = self\n303\t                .layout\n304\t                .get(mat_idx, 0)\n305\t                .unwrap_or_else(|| panic!(\"Invalid matrix index: {mat_idx}\"));\n306\t            let l_skip = self.layout.l_skip();\n307\t            let lifted_height = s.len(l_skip);\n308\t            let offset = s.col_idx * matrix.height() + s.row_idx;\n309\t            // SAFETY:\n310\t            // - by definition of stacked layout and stacked matrix, `ptr` is valid and allocated\n311\t            //   for `lifted_height * width` elements.\n312\t            unsafe {\n313\t                let ptr = matrix.mixed.as_ptr().add(offset);\n314\t                Some(DeviceMatrixView::from_raw_parts(ptr, lifted_height, width))\n315\t            }\n316\t        } else {\n317\t            None\n318\t        }\n319\t    }\n320\t}\n321\t\n322\t#[cfg(test)]\n323\tmod tests {\n324\t    use itertools::Itertools;\n325\t    use openvm_stark_backend::{\n326\t        prover::ColMajorMatrix,\n327\t        test_utils::{InteractionsFixture11, TestFixture},\n328\t    };\n329\t    use p3_field::PrimeCharacteristicRing;\n330\t\n331\t    use super::*;\n332\t    use crate::{\n333\t        data_transporter::{transport_matrix_d2h_col_major, transport_matrix_h2d_col_major},\n334\t        prelude::{F, SC},\n335\t    };\n336\t\n337\t    #[test]\n338\t    fn test_stacked_matrix_manual_0() {\n339\t        let columns = [vec![1, 2, 3, 4], vec![5, 6], vec![7]]\n340\t            .map(|v| v.into_iter().map(F::from_u32).collect_vec());\n341\t        let mats = columns\n342\t            .into_iter()\n343\t            .map(|c| transport_matrix_h2d_col_major(&ColMajorMatrix::new(c, 1)).unwrap())\n344\t            .collect_vec();\n345\t        let mat_refs = mats.iter().collect_vec();\n346\t        let l_skip = 0;\n347\t        let (stacked_mat, _layout) = stacked_matrix(0, 2, &mat_refs).unwrap();\n348\t        assert_eq!(stacked_mat.height(), 4);\n349\t        assert_eq!(stacked_mat.width(), 2);\n350\t        let stacked_h_mat =\n351\t            transport_matrix_d2h_col_major(&stacked_mat.to_evals(l_skip).unwrap()).unwrap();\n352\t        assert_eq!(\n353\t            stacked_h_mat.values,\n354\t            [1, 2, 3, 4, 5, 6, 7, 0].map(F::from_u32).to_vec()\n355\t        );\n356\t    }\n357\t\n358\t    #[test]\n359\t    fn test_stacked_matrix_manual_1() {\n360\t        let ctx = TestFixture::<SC>::generate_proving_ctx(&InteractionsFixture11);\n361\t        let [send_trace, rcv_trace] = [0, 1]\n362\t            .map(|i| transport_matrix_h2d_col_major(&ctx.per_trace[i].1.common_main).unwrap());\n363\t        let l_skip = 2;\n364\t        let n_stack = 8;\n365\t        let (stacked_mat, _layout) =\n366\t            stacked_matrix(l_skip, n_stack, &[&rcv_trace, &send_trace]).unwrap();\n367\t        assert_eq!(stacked_mat.height(), 1 << (l_skip + n_stack));\n368\t        assert_eq!(stacked_mat.width(), 1);\n369\t        let stacked_h_mat =\n370\t            transport_matrix_d2h_col_major(&stacked_mat.to_evals(l_skip).unwrap()).unwrap();\n371\t        let mut expected = vec![F::ZERO; 1 << (l_skip + n_stack)];\n372\t        expected[..24].copy_from_slice(\n373\t            &[\n374\t                1, 3, 4, 2, 0, 545, 1, 0, 5, 4, 4, 5, 123, 889, 889, 456, 0, 3, 7, 546, 1, 5, 4,\n375\t                889,\n376\t            ]\n377\t            .map(F::from_u32),\n378\t        );\n379\t        assert_eq!(stacked_h_mat.values, expected);\n380\t    }\n381\t\n382\t    #[test]\n383\t    fn test_stacked_matrix_manual_strided_0() {\n384\t        let columns = [vec![1, 2, 3, 4], vec![5, 6], vec![7]]\n385\t            .map(|v| v.into_iter().map(F::from_u32).collect_vec());\n386\t        let mats = columns\n387\t            .into_iter()\n388\t            .map(|c| transport_matrix_h2d_col_major(&ColMajorMatrix::new(c, 1)).unwrap())\n389\t            .collect_vec();\n390\t        let mat_refs = mats.iter().collect_vec();\n391\t        let l_skip = 2;\n392\t        let (stacked_mat, _layout) = stacked_matrix(l_skip, 0, &mat_refs).unwrap();\n393\t        assert_eq!(stacked_mat.height(), 4);\n394\t        assert_eq!(stacked_mat.width(), 3);\n395\t        let stacked_h_mat =\n396\t            transport_matrix_d2h_col_major(&stacked_mat.to_evals(l_skip).unwrap()).unwrap();\n397\t        assert_eq!(\n398\t            stacked_h_mat.values,\n399\t            [1, 2, 3, 4, 5, 0, 6, 0, 7, 0, 0, 0]\n400\t                .map(F::from_u32)\n401\t                .to_vec()\n402\t        );\n403\t    }\n404\t\n405\t    #[test]\n406\t    fn test_stacked_matrix_manual_strided_1() {\n407\t        let columns = [vec![1, 2, 3, 4], vec![5, 6], vec![7]]\n408\t            .map(|v| v.into_iter().map(F::from_u32).collect_vec());\n409\t        let mats = columns\n410\t            .into_iter()\n411\t            .map(|c| transport_matrix_h2d_col_major(&ColMajorMatrix::new(c, 1)).unwrap())\n412\t            .collect_vec();\n413\t        let mat_refs = mats.iter().collect_vec();\n414\t        let l_skip = 3;\n415\t        let (stacked_mat, _layout) = stacked_matrix(l_skip, 0, &mat_refs).unwrap();\n416\t        assert_eq!(stacked_mat.height(), 8);\n417\t        assert_eq!(stacked_mat.width(), 3);\n418\t        let stacked_h_mat =\n419\t            transport_matrix_d2h_col_major(&stacked_mat.to_evals(l_skip).unwrap()).unwrap();\n420\t        assert_eq!(\n421\t            stacked_h_mat.values,\n422\t            [\n423\t                [1, 0, 2, 0, 3, 0, 4, 0],\n424\t                [5, 0, 0, 0, 6, 0, 0, 0],\n425\t                [7, 0, 0, 0, 0, 0, 0, 0]\n426\t            ]\n427\t            .into_iter()\n428\t            .flatten()\n429\t            .map(F::from_u32)\n430\t            .collect_vec()\n431\t        );\n432\t    }\n433\t}\n434\t"}]},"parent_tool_use_id":"toolu_01WiLXaV8GgdZUJoWcqyrJni","session_id":"f8b3f9a5-d318-4292-b8d9-cc11d3b0ac84","uuid":"80fffe0e-1a3e-4aa9-bc48-d18a1ec32b7a","timestamp":"2026-04-10T18:03:58.009Z"}
