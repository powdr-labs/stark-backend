\t        self.q_evals = folded_q_evals;\n949\t\n950\t        if self.n_max >= (round - 1) {\n951\t            let input_max_n = self.cur_max_n(round);\n952\t            let output_max_n = input_max_n.saturating_sub(1);\n953\t            let output_len = 1 << input_max_n;\n954\t\n955\t            let mut buffer = DeviceBuffer::<EF>::with_capacity(output_len);\n956\t            [EF::ZERO].copy_to(&mut buffer)?;\n957\t            // SAFETY:\n958\t            // - eq_r_ns has max_n equal to input_max_n\n959\t            // - we allocate output for half the size of eq_r_ns\n960\t            unsafe {\n961\t                let mut output = EqEvalSegments::from_raw_parts(buffer, output_max_n);\n962\t                if input_max_n != 0 {\n963\t                    triangular_fold_mle(&mut output, &self.eq_r_ns, u_round, output_max_n)\n964\t                        .map_err(StackedReductionError::TriangularFoldMle)?;\n965\t                }\n966\t                self.eq_r_ns = output;\n967\t            }\n968\t\n969\t            let mut buffer = DeviceBuffer::<EF>::with_capacity(output_len);\n970\t            [EF::ZERO].copy_to(&mut buffer)?;\n971\t            // SAFETY:\n972\t            // - k_rot_ns has max_n equal to input_max_n\n973\t            // - we allocate output for half the size of eq_r_ns\n974\t            unsafe {\n975\t                let mut output = EqEvalSegments::from_raw_parts(buffer, output_max_n);\n976\t                if input_max_n != 0 {\n977\t                    triangular_fold_mle(&mut output, &self.k_rot_ns, u_round, output_max_n)\n978\t                        .map_err(StackedReductionError::TriangularFoldMle)?;\n979\t                }\n980\t                self.k_rot_ns = output;\n981\t            }\n982\t        } else {\n983\t            assert_eq!(self.eq_r_ns.buffer.len(), 1);\n984\t            assert_eq!(self.k_rot_ns.buffer.len(), 1);\n985\t        }\n986\t        for (s, eq_ub) in zip(&self.unstacked_cols, &mut self.eq_ub_per_trace) {\n987\