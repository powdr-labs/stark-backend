unction to pairs of digest elements from `prev_layer`. The pairs to compress\n101\t/// are selected with a `stride` between them.\n102\t///\n103\t/// # Safety\n104\t/// - `output` must have length `>= output_size` in `Digest` elements.\n105\t/// - `prev_layer` must have length `>= output_size * 2` in `Digest` elements.\n106\t/// - `output` and `prev_layer` must be non-overlapping.\n107\t/// - `stride` must be a power of two and `stride <= output_size`.\n108\tpub unsafe fn poseidon2_strided_compress_layer(\n109\t    output: &mut DeviceBuffer<Digest>,\n110\t    prev_layer: &DeviceBuffer<Digest>,\n111\t    output_size: usize,\n112\t    stride: usize,\n113\t) -> Result<(), CudaError> {\n114\t    debug_assert!(stride > 0 && stride <= output_size);\n115\t    debug_assert!(output.len() >= output_size);\n116\t    debug_assert!(prev_layer.len() >= output_size * 2);\n117\t    CudaError::from_result(_poseidon2_strided_compress_layer(\n118\t        output.as_mut_ptr(),\n119\t        prev_layer.as_ptr(),\n120\t        output_size,\n121\t        stride,\n122\t    ))\n123\t}\n124\t\n125\t/// Writes a new digest layer of `output_size` elements of type `Digest` to `output` by apply\n126\t/// poseidon2 compress function to adjacent pairs of digest elements from `prev_layer`.\n127\t///\n128\t/// # Safety\n129\t/// - `output` must have length `>= output_size` in `Digest` elements.\n130\t/// - `prev_layer` must have length `>= output_size * 2` in `Digest` elements.\n131\t/// - `output` and `prev_layer` must be non-overlapping.\n132\tpub unsafe fn poseidon2_adjacent_compress_layer(\n133\t    output: &mut DeviceBuffer<Digest>,\n134\t    prev_layer: &DeviceBuffer<Digest>,\n135\t    output_size: usize,\n136\t) -> Result<(), CudaError> {\n137\t    debug_assert!(output.len() >= output_size);\n138\t    debug_assert!(prev_layer.len() >= output_size * 2);\n139\t    CudaError::from_result(_poseidon2_adjacent_compress_layer(\n140\t        output.as_mut_ptr(),\n141\t        prev_layer.as_ptr(),\n14