    let (batch_count, batch_memory) = find_batch_end(\n572\t            &logup_traces_with_size[batch_start..],\n573\t            |(_, mem)| *mem,\n574\t            memory_limit_bytes,\n575\t        );\n576\t        let batch: Vec<&TraceCtx> = logup_traces_with_size[batch_start..batch_start + batch_count]\n577\t            .iter()\n578\t            .map(|(t, _)| *t)\n579\t            .collect();\n580\t\n581\t        if batch.len() == 1 && batch_memory > memory_limit_bytes {\n582\t            // Single oversized trace: use non-batch kernel\n583\t            let t = batch[0];\n584\t            tracing::warn!(\n585\t                air_idx = t.air_idx,\n586\t                intermediate_buffer_bytes = batch_memory,\n587\t                memory_limit_bytes,\n588\t                \"logup: trace exceeds memory limit, using non-batch kernel\"\n589\t            );\n590\t            evaluate_single_logup(\n591\t                t,\n592\t                pk,\n593\t                d_challenges_ptr,\n594\t                num_x,\n595\t                &mut logup_out[t.trace_idx],\n596\t                &mut logup_tilde_evals[t.trace_idx],\n597\t            )?;\n598\t        } else {\n599\t            // Normal batch using LogupMleBatchBuilder\n600\t            tracing::debug!(\n601\t                batch_size = batch.len(),\n602\t                batch_memory,\n603\t                memory_limit_bytes,\n604\t                \"logup: batching traces\"\n605\t            );\n606\t            let builder =\n607\t                LogupMleBatchBuilder::new(batch.iter().copied(), pk, d_challenges_ptr, num_x)?;\n608\t            let out = builder.evaluate(num_x)?;\n609\t            let host = out.to_host()?;\n610\t\n611\t            for (i, (trace_idx, norm_factor)) in builder.trace_info().enumerate() {\n612\t                let fracs = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n613\t                if num_x == 1 {\n614\t                    logup_tilde_evals[trace_idx][0] = fracs[0].p