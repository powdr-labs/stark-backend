\t            norm_factor: F,\n1608\t        }\n1609\t        let mut case_b_traces: Vec<CaseBMeta> = Vec::new();\n1610\t        let mut all_matrices: Vec<InterpMatrixInfo> = Vec::new();\n1611\t        let mut total_interp_elems: usize = 0;\n1612\t\n1613\t        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n1614\t            self.n_per_trace.iter(),\n1615\t            self.mat_evals_per_trace.iter(),\n1616\t            self.sels_per_trace.iter(),\n1617\t            self.d_eq_3b_per_trace.iter(),\n1618\t            self.public_values_per_trace.iter(),\n1619\t            self.air_indices_per_trace.iter()\n1620\t        )\n1621\t        .enumerate()\n1622\t        {\n1623\t            let pk = &self.pk.per_air[air_idx];\n1624\t            let dag = &pk.vk.symbolic_constraints;\n1625\t            let has_constraints = dag.constraints.num_constraints() > 0;\n1626\t            let has_interactions = !dag.interactions.is_empty();\n1627\t            if !has_constraints && !has_interactions {\n1628\t                continue;\n1629\t            }\n1630\t\n1631\t            let n_lift = n.max(0) as usize;\n1632\t            let norm_factor_denom = 1 << (-n).max(0);\n1633\t            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n1634\t            let has_preprocessed = pk.preprocessed_data.is_some();\n1635\t            let need_rot = pk.vk.params.need_rot;\n1636\t            let first_main_idx = usize::from(has_preprocessed);\n1637\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n1638\t\n1639\t            if round > n_lift {\n1640\t                // Case A\n1641\t                if round == n_lift + 1 {\n1642\t                    // A.1: evaluate directly at (num_x=1, num_y=1)\n1643\t                    let prep_ptr = if has_preprocessed {\n1644\t                        MainMatrixPtrs {\n1645\t                            data: mats[0].buffer().as_ptr(),\n1646\t                            air_width: air_width_for_mat(need_rot, mats[0].width()),\n1647\t                        }\n1648\t                    } else {\n1649\t                        MainMatrixPtrs {\n1650\t                            data: std::ptr::null(),\n1651\t                            air_width: 0,\n1652\t                        }\n1653\t                    };\n1654\t                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1655\t                        .iter()\n1656\t                        .map(|m| MainMatrixPtrs {\n1657\t                            data: m.buffer().as_ptr(),\n1658\t                            air_width: air_width_for_mat(need_rot, m.width()),\n1659\t                        })\n1660\t                        .collect_vec();\n1661\t                    let main_ptrs_dev = main_ptrs.to_device()?;\n1662\t\n1663\t                    late_eval.push(TraceCtx {\n1664\t                        trace_idx,\n1665\t                        air_idx,\n1666\t                        n_lift,\n1667\t                        num_y: 1,\n1668\t                        has_constraints,\n1669\t                        has_interactions,\n1670\t                        norm_factor,\n1671\t                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n1672\t                        sels_ptr: sels.buffer().as_ptr(),\n1673\t                        prep_ptr,\n1674\t                        main_ptrs_dev,\n1675\t                        public_ptr: public_vals.as_ptr(),\n1676\t                        eq_3bs_ptr: eq_3bs.as_ptr(),\n1677\t                    });\n1678\t                } else {\n1679\t                    // A.2: scale tilde evals only\n1680\t                    if has_constraints {\n1681\t                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n1682\t                        *tilde_eval *= r_prev;\n1683\t                    }\n1684\t                    if has_interactions {\n1685\t                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n1686\t                            *x *= r_prev;\n1687\t                        }\n1688\t                    }\n1689\t                }\n1690\t            } else {\n1691\t                // Case B: collect metadata for batched interpolation\n1692\t                let log_num_y = n_lift - round;\n1693\t                let num_y = 1 << log_num_y;\n1694\t                let height = 2 * num_y;\n1695\t                debug_assert_eq!(height, mats[0].height());\n1696\t\n1697\t                let matrix_offset = all_matrices.len();\n1698\t                // Collect per-matrix base pointers: selectors + all matrices (preprocessed + mains)\n1699\t                debug_assert_eq!(sels.height(), height);\n1700\t                all_matrices.push(InterpMatrixInfo {\n1701\t                    base: sels.buffer().as_ptr(),\n1702\t                    width: sels.width() as u32,\n1703\t                });\n1704\t                for m in mats.iter() {\n1705\t                    debug_assert_eq!(m.height(), height);\n1706\t                    all_matrices.push(InterpMatrixInfo {\n1707\t                        base: m.buffer().as_ptr(),\n1708\t                        width: m.width() as u32,\n1709\t                    });\n1710\t                }\n1711\t                let num_matrices = 1 + mats.len();\n1712\t                let num_columns = sels.width() + mats.iter().map(|m| m.width()).sum::<usize>();\n1713\t                let interp_size = sp_deg * num_y * num_columns;\n1714\t\n1715\t                case_b_traces.push(CaseBMeta {\n1716\t                    trace_idx,\n1717\t                    air_idx,\n1718\t                    n_lift,\n1719\t                    num_y,"}]},"parent_tool_use_id":"toolu_014SmLqaeaw8qnXqK5mhniYm","session_id":"5c4196e5-21f2-4e88-ab6f-fb2d2870d4db","uuid":"740645b4-4e5e-4087-827a-b673c02ffc98","timestamp":"2026-04-14T22:52:27.369Z"}
