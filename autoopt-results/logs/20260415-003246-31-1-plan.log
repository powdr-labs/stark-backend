{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JbWD8VYWgZqYgXFq76c6ov","type":"tool_result","content":"1\t#include \"codec.cuh\"\n2\t#include \"eval_ctx.cuh\"\n3\t#include \"frac_ext.cuh\"\n4\t#include \"launcher.cuh\"\n5\t#include \"sumcheck.cuh\"\n6\t\n7\t#include <algorithm>\n8\t#include <cassert>\n9\t#include <cstdint>\n10\t#include <stdio.h>\n11\t#include <vector_types.h>\n12\t\n13\tnamespace logup_zerocheck_mle {\n14\t\n15\tstruct ZerocheckCtx {\n16\t    EvalCoreCtx eval_ctx;\n17\t    FpExt *__restrict__ d_intermediates;\n18\t    uint32_t num_y;\n19\t    const FpExt *__restrict__ d_eq_xi;\n20\t    const Rule *__restrict__ d_rules;\n21\t    size_t rules_len;\n22\t    const size_t *__restrict__ d_used_nodes;\n23\t    size_t used_nodes_len;\n24\t    uint32_t buffer_size;\n25\t};\n26\t\n27\tstruct LogupCtx {\n28\t    EvalCoreCtx eval_ctx;\n29\t    FpExt *__restrict__ d_intermediates;\n30\t    uint32_t num_y;\n31\t    const FpExt *__restrict__ d_eq_xi;\n32\t    const FpExt *__restrict__ d_challenges;\n33\t    const FpExt *__restrict__ d_eq_3bs;\n34\t    const Rule *__restrict__ d_rules;\n35\t    size_t rules_len;\n36\t    const size_t *__restrict__ d_used_nodes;\n37\t    const uint32_t *__restrict__ d_pair_idxs;\n38\t    size_t used_nodes_len;\n39\t    uint32_t buffer_size;\n40\t};\n41\t\n42\t// Local context for device use only\n43\tstruct EvalCtx {\n44\t    const FpExt *__restrict__ d_selectors;\n45\t    const MainMatrixPtrs<FpExt> d_preprocessed;\n46\t    const MainMatrixPtrs<FpExt> *__restrict__ d_main;\n47\t    const Fp *__restrict__ d_public;\n48\t    FpExt *__restrict__ d_intermediates;\n49\t    uint32_t height;\n50\t};\n51\t\n52\t__device__ __forceinline__ FpExt evaluate_mle_entry(\n53\t    const SourceInfo &src,\n54\t    uint32_t row,\n55\t    const EvalCtx &ctx,\n56\t    uint32_t buffer_stride,\n57\t    const FpExt *__restrict__ d_challenges = nullptr\n58\t) {\n59\t    switch (src.type) {\n60\t    case ENTRY_PREPROCESSED: {\n61\t#ifdef CUDA_DEBUG\n62\t        assert(ctx.d_preprocessed.data);\n63\t#endif\n64\t        const auto stride = ctx.height * ctx.d_preprocessed.air_width;\n65\t        const FpExt *__restrict__ matrix = ctx.d_preprocessed.data + stride * src.offset;\n66\t        const FpExt *__restrict__ column = matrix + ctx.height * src.index;\n67\t        return column[row];\n68\t    }\n69\t    case ENTRY_MAIN: {\n70\t        auto main_ptr = ctx.d_main[src.part];\n71\t        const auto stride = ctx.height * main_ptr.air_width;\n72\t        const FpExt *__restrict__ matrix = main_ptr.data + stride * src.offset;\n73\t        const FpExt *__restrict__ column = matrix + ctx.height * src.index;\n74\t        return column[row];\n75\t    }\n76\t    case SRC_INTERMEDIATE:\n77\t        return ctx.d_intermediates[src.index * buffer_stride];\n78\t    case SRC_IS_FIRST: {\n79\t        const FpExt *__restrict__ column = ctx.d_selectors;\n80\t        return FpExt(column[row]);\n81\t    }\n82\t    case SRC_IS_LAST: {\n83\t        const FpExt *__restrict__ column = ctx.d_selectors + 2 * ctx.height;\n84\t        return FpExt(column[row]);\n85\t    }\n86\t    case SRC_IS_TRANSITION: {\n87\t        const FpExt *__restrict__ column = ctx.d_selectors + ctx.height;\n88\t        return FpExt(column[row]);\n89\t    }\n90\t    case ENTRY_CHALLENGE:\n91\t#ifdef CUDA_DEBUG\n92\t        assert(d_challenges);\n93\t#endif\n94\t        return d_challenges[src.index];\n95\t    case ENTRY_PUBLIC:\n96\t        return FpExt(ctx.d_public[src.index]);\n97\t    case SRC_CONSTANT:\n98\t        return FpExt(Fp(src.index));\n99\t    default:\n100\t        assert(false);\n101\t    }\n102\t    return FpExt(Fp::zero());\n103\t}\n104\t\n105\t// ============================================================================\n106\t// KERNELS\n107\t// ============================================================================\n108\t\n109\t__global__ void zerocheck_batch_mle_kernel(\n110\t    FpExt *__restrict__ tmp_sums_buffer,\n111\t    const BlockCtx *__restrict__ d_block_ctxs,\n112\t    const ZerocheckCtx *__restrict__ d_zc_ctxs,\n113\t    const FpExt *__restrict__ d_lambda_pows,\n114\t    size_t lambda_len\n115\t) {\n116\t    extern __shared__ char smem[];\n117\t    FpExt *shared = (FpExt *)smem;\n118\t\n119\t    BlockCtx block_ctx = d_block_ctxs[blockIdx.x];\n120\t    ZerocheckCtx zc_ctx = d_zc_ctxs[block_ctx.air_idx];\n121\t\n122\t    uint32_t num_x = gridDim.y;\n123\t    uint32_t x_int = blockIdx.y;\n124\t    uint32_t y_int = threadIdx.x + block_ctx.local_block_idx_x * blockDim.x;\n125\t    bool const active_thread = (y_int < zc_ctx.num_y);\n126\t\n127\t    FpExt sum(Fp::zero());\n128\t\n129\t    if (active_thread) {\n130\t        uint32_t height = num_x * zc_ctx.num_y;\n131\t        uint32_t row = x_int * zc_ctx.num_y + y_int;\n132\t        // No tiling: task_offset = row, task_stride = height\n133\t        uint32_t buffer_stride = 0;\n134\t        FpExt *__restrict__ intermediates = nullptr;\n135\t        if (zc_ctx.buffer_size > 0) {\n136\t#ifdef CUDA_DEBUG\n137\t            assert(zc_ctx.d_intermediates != nullptr);\n138\t#endif\n139\t            intermediates = zc_ctx.d_intermediates + row;\n140\t            buffer_stride = height;\n141\t        }\n142\t        EvalCtx eval_ctx{\n143\t            zc_ctx.eval_ctx.d_selectors,\n144\t            zc_ctx.eval_ctx.d_preprocessed,\n145\t            zc_ctx.eval_ctx.d_main,\n146\t            zc_ctx.eval_ctx.d_public,\n147\t            intermediates,\n148\t            height\n149\t        };\n150\t        uint32_t lambda_idx = 0;\n151\t\n152\t        for (size_t node = 0; node < zc_ctx.rules_len; ++node) {\n153\t            Rule rule = zc_ctx.d_rules[node];\n154\t            DecodedRule decoded = decode_rule(rule);\n155\t\n156\t            FpExt x_val = evaluate_mle_entry(decoded.x, row, eval_ctx, buffer_stride);\n157\t            FpExt result;\n158\t            switch (decoded.op) {\n159\t            case OP_ADD: {\n160\t                FpExt y_val = evaluate_mle_entry(decoded.y, row, eval_ctx, buffer_stride);\n161\t                result = x_val + y_val;\n162\t                break;\n163\t            }\n164\t            case OP_SUB: {\n165\t                FpExt y_val = evaluate_mle_entry(decoded.y, row, eval_ctx, buffer_stride);\n166\t                result = x_val - y_val;\n167\t                break;\n168\t            }\n169\t            case OP_MUL: {\n170\t                FpExt y_val = evaluate_mle_entry(decoded.y, row, eval_ctx, buffer_stride);\n171\t                result = x_val * y_val;\n172\t                break;\n173\t            }\n174\t            case OP_NEG:\n175\t                result = -x_val;\n176\t                break;\n177\t            case OP_VAR:\n178\t                result = x_val;\n179\t                break;\n180\t            default:\n181\t                assert(false);\n182\t            }\n183\t\n184\t            if (decoded.buffer_result && zc_ctx.buffer_size > 0) {\n185\t                eval_ctx.d_intermediates[decoded.z_index * buffer_stride] = result;\n186\t            }\n187\t\n188\t            if (decoded.is_constraint) {\n189\t                while (lambda_idx < lambda_len && lambda_idx < zc_ctx.used_nodes_len &&\n190\t                       zc_ctx.d_used_nodes[lambda_idx] == node) {\n191\t                    FpExt lambda = d_lambda_pows[lambda_idx];\n192\t                    lambda_idx++;\n193\t                    sum += lambda * result;\n194\t                }\n195\t            }\n196\t        }\n197\t        sum *= zc_ctx.d_eq_xi[y_int];\n198\t    }\n199\t\n200\t    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n201\t    if (threadIdx.x == 0) {\n202\t        tmp_sums_buffer[blockIdx.x * num_x + x_int] = reduced;\n203\t    }\n204\t}\n205\t\n206\t__global__ void logup_batch_mle_kernel(\n207\t    FracExt *__restrict__ tmp_sums_buffer,\n208\t    const BlockCtx *__restrict__ d_block_ctxs,\n209\t    const LogupCtx *__restrict__ d_logup_ctxs\n210\t) {\n211\t    extern __shared__ char smem[];\n212\t    FpExt *shared = reinterpret_cast<FpExt *>(smem);\n213\t\n214\t    BlockCtx block_ctx = d_block_ctxs[blockIdx.x];\n215\t    LogupCtx logup_ctx = d_logup_ctxs[block_ctx.air_idx];\n216\t\n217\t    uint32_t num_x = gridDim.y;\n218\t    uint32_t x_int = blockIdx.y;\n219\t    uint32_t y_int = threadIdx.x + block_ctx.local_block_idx_x * blockDim.x;\n220\t    bool const active_thread = (y_int < logup_ctx.num_y);\n221\t\n222\t    FpExt numer_sum = FpExt(Fp::zero());\n223\t    FpExt denom_sum = FpExt(Fp::zero());\n224\t\n225\t    if (active_thread) {\n226\t        uint32_t height = num_x * logup_ctx.num_y;\n227\t        uint32_t row = x_int * logup_ctx.num_y + y_int;\n228\t        // No tiling: task_offset = row, task_stride = height\n229\t        uint32_t buffer_stride = 0;\n230\t        FpExt *intermediates = nullptr;\n231\t        if (logup_ctx.buffer_size > 0) {\n232\t            assert(logup_ctx.d_intermediates != nullptr);\n233\t            intermediates = logup_ctx.d_intermediates + row;\n234\t            buffer_stride = height;\n235\t        }\n236\t\n237\t        // Build local EvalCtx with correct intermediates backing.\n238\t        // NOTE: `eval_ctx.d_intermediates` points at the current task's base, so indexing uses\n239\t        // `decoded.z_index * buffer_stride`.\n240\t        EvalCtx eval_ctx{\n241\t            logup_ctx.eval_ctx.d_selectors,\n242\t            logup_ctx.eval_ctx.d_preprocessed,\n243\t            logup_ctx.eval_ctx.d_main,\n244\t            logup_ctx.eval_ctx.d_public,\n245\t            intermediates,\n246\t            height\n247\t        };\n248\t        size_t rules_evaluated = 0;\n249\t\n250\t        // Iterate through used_nodes (alternates: numer, denom, numer, denom, ...)\n251\t        for (size_t used_idx = 0; used_idx < logup_ctx.used_nodes_len; ++used_idx) {\n252\t            size_t node_idx = logup_ctx.d_used_nodes[used_idx];\n253\t            FpExt result(Fp::zero());\n254\t\n255\t            if (node_idx < rules_evaluated) {\n256\t                // Node already evaluated, get from buffer\n257\t                Rule rule = logup_ctx.d_rules[node_idx];\n258\t                DecodedRule decoded = decode_rule(rule);\n259\t                if (decoded.op == OP_VAR) {\n260\t                    result = evaluate_mle_entry(\n261\t                        decoded.x, row, eval_ctx, buffer_stride, logup_ctx.d_challenges\n262\t                    );\n263\t                } else if (logup_ctx.buffer_size > 0 && decoded.buffer_result) {\n264\t                    result = eval_ctx.d_intermediates[decoded.z_index * buffer_stride];\n265\t                }\n266\t            } else {\n267\t                // Need to evaluate this node (and all nodes up to it)\n268\t                for (; rules_evaluated <= node_idx; ++rules_evaluated) {\n269\t                    Rule rule = logup_ctx.d_rules[rules_evaluated];\n270\t                    DecodedRule decoded = decode_rule(rule);\n271\t\n272\t                    FpExt x_val = evaluate_mle_entry(\n273\t                        decoded.x, row, eval_ctx, buffer_stride, logup_ctx.d_challenges\n274\t                    );\n275\t                    FpExt node_result;\n276\t                    switch (decoded.op) {\n277\t                    case OP_ADD: {\n278\t                        FpExt y_val = evaluate_mle_entry(\n279\t                            decoded.y, row, eval_ctx, buffer_stride, logup_ctx.d_challenges\n280\t                        );\n281\t                        node_result = x_val + y_val;\n282\t                        break;\n283\t                    }\n284\t                    case OP_SUB: {\n285\t                        FpExt y_val = evaluate_mle_entry(\n286\t                            decoded.y, row, eval_ctx, buffer_stride, logup_ctx.d_challenges\n287\t                        );\n288\t                        node_result = x_val - y_val;\n289\t                        break;\n290\t                    }\n291\t                    case OP_MUL: {\n292\t                        FpExt y_val = evaluate_mle_entry(\n293\t                            decoded.y, row, eval_ctx, buffer_stride, logup_ctx.d_challenges\n294\t                        );\n295\t                        node_result = x_val * y_val;\n296\t                        break;\n297\t                    }\n298\t                    case OP_NEG:\n299\t                        node_result = -x_val;\n300\t                        break;\n301\t                    case OP_VAR:\n302\t                        node_result = x_val;\n303\t                        break;\n304\t                    default:\n305\t                        assert(false);\n306\t                    }\n307\t\n308\t                    if (decoded.buffer_result && logup_ctx.buffer_size > 0) {\n309\t                        eval_ctx.d_intermediates[decoded.z_index * buffer_stride] = node_result;\n310\t                    }\n311\t\n312\t                    // If this is the node we're looking for, use it\n313\t                    if (rules_evaluated == node_idx) {\n314\t                        result = node_result;\n315\t                    }\n316\t                }\n317\t            }\n318\t\n319\t            // Use pair_idxs to get the actual pair index for this used node\n320\t            // pair_idx = 2 * interaction_idx + is_denom\n321\t            uint32_t pair_idx = logup_ctx.d_pair_idxs[used_idx];\n322\t            result *= logup_ctx.d_eq_3bs[pair_idx >> 1];\n323\t\n324\t            if (pair_idx & 1) {\n325\t                denom_sum += result;\n326\t            } else {\n327\t                numer_sum += result;\n328\t            }\n329\t        }\n330\t\n331\t        FpExt eq_val = logup_ctx.d_eq_xi[y_int];\n332\t        numer_sum *= eq_val;\n333\t        denom_sum *= eq_val;\n334\t    }\n335\t\n336\t    FpExt numer_reduced = sumcheck::block_reduce_sum(numer_sum, shared);\n337\t    __syncthreads(); // Ensure first reduction completes before reusing shared memory\n338\t    FpExt denom_reduced = sumcheck::block_reduce_sum(denom_sum, shared);\n339\t    if (threadIdx.x == 0) {\n340\t        tmp_sums_buffer[blockIdx.x * num_x + x_int] = {numer_reduced, denom_reduced};\n341\t    }\n342\t}\n343\t\n344\t// ============================================================================\n345\t// LAUNCHERS\n346\t// ============================================================================\n347\t\n348\t// ============================================================================\n349\t// SIZE HELPERS (batch kernels)\n350\t// ============================================================================\n351\t//\n352\t// Batch kernels always use global intermediates when buffer_size > 0 (no local-threshold path),\n353\t// so we need dedicated sizing helpers instead of `_zerocheck_mle_intermediates_buffer_size` /\n354\t// `_logup_mle_intermediates_buffer_size` from `mle.cu`, which return 0 under local thresholds.\n355\t\n356\t// In FpExt elements.\n357\textern \"C\" size_t _zerocheck_batch_mle_intermediates_buffer_size(\n358\t    uint32_t buffer_size,\n359\t    uint32_t num_x,\n360\t    uint32_t num_y\n361\t) {\n362\t    size_t height = static_cast<size_t>(num_x) * num_y;\n363\t    return height * buffer_size;\n364\t}\n365\t\n366\t// In FpExt elements.\n367\textern \"C\" size_t _logup_batch_mle_intermediates_buffer_size(\n368\t    uint32_t buffer_size,\n369\t    uint32_t num_x,\n370\t    uint32_t num_y\n371\t) {\n372\t    size_t height = static_cast<size_t>(num_x) * num_y;\n373\t    return height * buffer_size;\n374\t}\n375\t\n376\textern \"C\" int _zerocheck_batch_eval_mle(\n377\t    FpExt *tmp_sums_buffer,\n378\t    FpExt *output,\n379\t    const BlockCtx *block_ctxs,\n380\t    const ZerocheckCtx *zc_ctxs,\n381\t    const uint32_t *air_block_offsets, // size = num_airs + 1, grouped by air_idx\n382\t    const FpExt *lambda_pows,\n383\t    size_t lambda_len,\n384\t    uint32_t num_blocks,\n385\t    uint32_t num_x,\n386\t    uint32_t num_airs,\n387\t    uint32_t threads_per_block\n388\t) {\n389\t    dim3 grid(num_blocks, num_x);\n390\t    dim3 block(threads_per_block);\n391\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n392\t\n393\t    zerocheck_batch_mle_kernel<<<grid, block, shmem_bytes>>>(\n394\t        tmp_sums_buffer, block_ctxs, zc_ctxs, lambda_pows, lambda_len\n395\t    );\n396\t    int err = CHECK_KERNEL();\n397\t    if (err != 0)\n398\t        return err;\n399\t\n400\t    // Batched reduction for all AIRs in single launch\n401\t    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n402\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n403\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n404\t\n405\t    dim3 reduce_grid(num_airs, num_x);\n406\t    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n407\t        tmp_sums_buffer, output, air_block_offsets, num_x\n408\t    );\n409\t\n410\t    return CHECK_KERNEL();\n411\t}\n412\t\n413\textern \"C\" int _logup_batch_eval_mle(\n414\t    FracExt *tmp_sums_buffer,\n415\t    FracExt *output,\n416\t    const BlockCtx *block_ctxs,\n417\t    const LogupCtx *logup_ctxs,\n418\t    const uint32_t *air_block_offsets, // size = num_airs + 1, grouped by air_idx\n419\t    uint32_t num_blocks,\n420\t    uint32_t num_x,\n421\t    uint32_t num_airs,\n422\t    uint32_t threads_per_block\n423\t) {\n424\t    dim3 grid(num_blocks, num_x);\n425\t    dim3 block(threads_per_block);\n426\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n427\t\n428\t    logup_batch_mle_kernel<<<grid, block, shmem_bytes>>>(tmp_sums_buffer, block_ctxs, logup_ctxs);\n429\t    int err = CHECK_KERNEL();\n430\t    if (err != 0)\n431\t        return err;\n432\t\n433\t    // Batched reduction for all AIRs in single launch\n434\t    // FracExt = (FpExt, FpExt) so d = 2 * num_x\n435\t    auto [_, reduce_block] = kernel_launc