ect_vec();\n1823\t            debug_assert_eq!(widths_so_far, meta.num_columns);\n1824\t            let main_ptrs_dev = main_ptrs.to_device()?;\n1825\t\n1826\t            early_eval.push(TraceCtx {\n1827\t                trace_idx: meta.trace_idx,\n1828\t                air_idx: meta.air_idx,\n1829\t                n_lift: meta.n_lift,\n1830\t                num_y: meta.num_y as u32,\n1831\t                has_constraints: meta.has_constraints,\n1832\t                has_interactions: meta.has_interactions,\n1833\t                norm_factor: meta.norm_factor,\n1834\t                eq_xi_ptr: eq_xi_tree.get_ptr(log_num_y),\n1835\t                sels_ptr,\n1836\t                prep_ptr,\n1837\t                main_ptrs_dev,\n1838\t                public_ptr: self.public_values_per_trace[meta.trace_idx].as_ptr(),\n1839\t                eq_3bs_ptr: self.d_eq_3b_per_trace[meta.trace_idx].as_ptr(),\n1840\t            });\n1841\t        }\n1842\t\n1843\t        let d_challenges_ptr = self.d_challenges.as_ptr();\n1844\t\n1845\t        // Late traces (num_y=1): always use monomial\n1846\t        let late_logup_traces: Vec<_> = late_eval.iter().filter(|t| t.has_interactions).collect();\n1847\t        if !late_logup_traces.is_empty() {\n1848\t            let logup_combs: Vec<_> = late_logup_traces\n1849\t                .iter()\n1850\t                .map(|t| {\n1851\t                    self.logup_combinations[t.trace_idx]\n1852\t                        .as_ref()\n1853\t                        .expect(\"missing logup monomial combinations for late trace\")\n1854\t                })\n1855\t                .collect();\n1856\t            let batch =\n1857\t                LogupMonomialBatch::new(late_logup_traces.iter().copied(), self.pk, &logup_combs)?;\n1858\t            let out = batch\n1859\t                .evaluate(1)\n1860\t                .map_err(LogupZerocheckError::MleInteractionEval)?;\n1861\t            let host = out.to_host()?;\n1862\t            for (i, trace