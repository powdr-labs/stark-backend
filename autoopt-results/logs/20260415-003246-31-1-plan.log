{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KYTG1VwhSKLpmJaMDM8387","type":"tool_result","content":"1\tuse std::cmp::max;\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::{\n5\t    copy::MemCopyH2D,\n6\t    d_buffer::DeviceBuffer,\n7\t    stream::current_stream_sync,\n8\t};\n9\tuse openvm_stark_backend::prover::{\n10\t    fractional_sumcheck_gkr::Frac,\n11\t    stacked_pcs::{StackedLayout, StackedSlice},\n12\t    DeviceMultiStarkProvingKey, MatrixDimensions, ProvingContext,\n13\t};\n14\tuse p3_field::{Field, PrimeCharacteristicRing};\n15\tuse tracing::instrument;\n16\t\n17\tuse super::errors::InteractionGpuError;\n18\tuse crate::{\n19\t    cuda::logup_zerocheck::{\n20\t        frac_matrix_vertically_repeat, frac_vector_scalar_multiply_ext_fp, logup_gkr_input_eval,\n21\t    },\n22\t    gpu_backend::GenericGpuBackend,\n23\t    hash_scheme::GpuHashScheme,\n24\t    prelude::{EF, F},\n25\t};\n26\t\n27\tconst TASK_SIZE: u32 = 65536;\n28\t\n29\t/// Number of OS threads (and thus CUDA streams) for parallel GKR input evaluation.\n30\tconst NUM_GKR_INPUT_STREAMS: usize = 8;\n31\t\n32\tstruct SendPtr<T>(*mut T);\n33\tunsafe impl<T> Send for SendPtr<T> {}\n34\tunsafe impl<T> Sync for SendPtr<T> {}\n35\t\n36\tstruct GkrThreadBuffers {\n37\t    intermediates: DeviceBuffer<EF>,\n38\t    public_values: DeviceBuffer<F>,\n39\t    partition_ptrs: DeviceBuffer<u64>,\n40\t    tmp: DeviceBuffer<Frac<EF>>,\n41\t}\n42\t\n43\tstruct GkrInputWorkItem<'a, HS: GpuHashScheme> {\n44\t    air_ctx: &'a openvm_stark_backend::prover::AirProvingContext<GenericGpuBackend<HS>>,\n45\t    pk_air: &'a openvm_stark_backend::prover::DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n46\t    l_skip: usize,\n47\t    d_challenges: &'a DeviceBuffer<EF>,\n48\t    leaves_ptr: SendPtr<Frac<EF>>,\n49\t}\n50\t\n51\t#[allow(dead_code)]\n52\t#[derive(Clone)]\n53\tpub struct TraceInteractionMeta {\n54\t    pub trace_idx: usize,\n55\t    pub air_idx: usize,\n56\t    pub layout_slices: Vec<StackedSlice>,\n57\t}\n58\t\n59\t// TODO[jpw]: revisit if this function is needed\n60\tpub fn collect_trace_interactions<HS: GpuHashScheme>(\n61\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n62\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n63\t    layout: &StackedLayout,\n64\t) -> Vec<Option<TraceInteractionMeta>> {\n65\t    // Pre-group layout slices by trace to avoid repeated scans later.\n66\t    let mut slices_by_trace: Vec<Vec<(usize, StackedSlice)>> =\n67\t        vec![Vec::new(); ctx.per_trace.len()];\n68\t    for &(trace_idx, interaction_idx, ref slice) in &layout.sorted_cols {\n69\t        if let Some(entries) = slices_by_trace.get_mut(trace_idx) {\n70\t            entries.push((interaction_idx, *slice));\n71\t        }\n72\t    }\n73\t\n74\t    ctx.per_trace\n75\t        .iter()\n76\t        .enumerate()\n77\t        .map(|(trace_idx, (air_idx, _))| {\n78\t            let vk = &pk.per_air[*air_idx].vk;\n79\t            if !vk.has_interaction() {\n80\t                return None;\n81\t            }\n82\t\n83\t            let mut layout_entries = vec![None; vk.num_interactions()];\n84\t            for (interaction_idx, slice) in &slices_by_trace[trace_idx] {\n85\t                if let Some(slot) = layout_entries.get_mut(*interaction_idx) {\n86\t                    *slot = Some(*slice);\n87\t                }\n88\t            }\n89\t\n90\t            let layout_slices = layout_entries\n91\t                .into_iter()\n92\t                .enumerate()\n93\t                .map(|(idx, maybe_slice)| {\n94\t                    maybe_slice.unwrap_or_else(|| {\n95\t                        panic!(\n96\t                            \"missing stacked slice for interaction {} of trace {}\",\n97\t                            idx, trace_idx\n98\t                        )\n99\t                    })\n100\t                })\n101\t                .collect_vec();\n102\t\n103\t            Some(TraceInteractionMeta {\n104\t                trace_idx,\n105\t                air_idx: *air_idx,\n106\t                layout_slices,\n107\t            })\n108\t        })\n109\t        .collect()\n110\t}\n111\t\n112\tfn process_gkr_input_air<HS: GpuHashScheme>(\n113\t    w: &GkrInputWorkItem<HS>,\n114\t    buffers: &mut GkrThreadBuffers,\n115\t) -> Result<(), InteractionGpuError> {\n116\t    let null_preprocessed = DeviceBuffer::<F>::new();\n117\t    let air_ctx = w.air_ctx;\n118\t    let pk_air = w.pk_air;\n119\t\n120\t    let preprocessed_matrix = pk_air\n121\t        .preprocessed_data\n122\t        .as_ref()\n123\t        .map(|committed| &committed.trace);\n124\t\n125\t    let mut partitioned_main = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n126\t    for committed in &air_ctx.cached_mains {\n127\t        partitioned_main.push(&committed.trace);\n128\t    }\n129\t    partitioned_main.push(&air_ctx.common_main);\n130\t\n131\t    let rules = &pk_air.other_data.interaction_rules;\n132\t    let num_interactions = pk_air.vk.symbolic_constraints.interactions.len();\n133\t\n134\t    let d_preprocessed = preprocessed_matrix\n135\t        .as_ref()\n136\t        .map(|m| m.buffer())\n137\t        .unwrap_or(&null_preprocessed);\n138\t\n139\t    let null_pv = DeviceBuffer::<F>::new();\n140\t    let has_public_values = !air_ctx.public_values.is_empty();\n141\t    if has_public_values {\n142\t        air_ctx.public_values.copy_to(&mut buffers.public_values)?;\n143\t    }\n144\t    let d_public_values = if has_public_values {\n145\t        &buffers.public_values\n146\t    } else {\n147\t        &null_pv\n148\t    };\n149\t\n150\t    let height = air_ctx.height();\n151\t    debug_assert_eq!(height, partitioned_main[0].height());\n152\t    let partition_ptrs = partitioned_main\n153\t        .iter()\n154\t        .map(|m| m.buffer().as_ptr() as u64)\n155\t        .collect_vec();\n156\t    partition_ptrs.copy_to(&mut buffers.partition_ptrs)?;\n157\t\n158\t    let buffer_size = rules.inner.buffer_size;\n159\t    // TODO[jpw]: remove magic 10\n160\t    let is_global = buffer_size > 10;\n161\t\n162\t    let num_rows_per_tile = height.div_ceil(TASK_SIZE as usize).max(1);\n163\t\n164\t    let leaves_ptr = w.leaves_ptr.0;\n165\t    let l_skip = w.l_skip;\n166\t    let lifted_height = max(height, 1 << l_skip);\n167\t\n168\t    let trace_output = if height != lifted_height {\n169\t        buffers.tmp.as_mut_ptr()\n170\t    } else {\n171\t        leaves_ptr\n172\t    };\n173\t    unsafe {\n174\t        logup_gkr_input_eval(\n175\t            is_global,\n176\t            trace_output,\n177\t            d_preprocessed,\n178\t            &buffers.partition_ptrs,\n179\t            d_public_values,\n180\t            w.d_challenges,\n181\t            &buffers.intermediates,\n182\t            &rules.inner.d_rules,\n183\t            &rules.inner.d_used_nodes,\n184\t            &rules.d_pair_idxs,\n185\t            height as u32,\n186\t            num_rows_per_tile as u32,\n187\t        )?;\n188\t    }\n189\t    if height != lifted_height {\n190\t        debug_assert_eq!(lifted_height % height, 0);\n191\t        debug_assert!(!buffers.tmp.is_empty());\n192\t        let norm_factor_denom = lifted_height / height;\n193\t        let norm_factor = F::from_usize(norm_factor_denom).inverse();\n194\t        unsafe {\n195\t            frac_vector_scalar_multiply_ext_fp(\n196\t                buffers.tmp.as_mut_ptr(),\n197\t                norm_factor,\n198\t                (height * num_interactions) as u32,\n199\t            )?;\n200\t            frac_matrix_vertically_repeat(\n201\t                leaves_ptr,\n202\t                buffers.tmp.as_ptr(),\n203\t                num_interactions as u32,\n204\t                lifted_height as u32,\n205\t                height as u32,\n206\t            )?;\n207\t        }\n208\t    }\n209\t    Ok(())\n210\t}\n211\t\n212\t/// Evaluate interactions from trace evaluation matrices to get (p, q) fractional sumcheck input.\n213\t/// Returns leaves buffer (WITHOUT alpha applied) and alpha value to be applied in first tree layer.\n214\t#[instrument(name = \"prover.rap_constraints.logup_gkr.input_evals\", skip_all)]\n215\tpub fn log_gkr_input_evals<HS: GpuHashScheme>(\n216\t    trace_interactions: &[Option<TraceInteractionMeta>],\n217\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n218\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n219\t    l_skip: usize,\n220\t    alpha_logup: EF,\n221\t    d_challenges: &DeviceBuffer<EF>,\n222\t    total_leaves: usize,\n223\t) -> Result<(DeviceBuffer<Frac<EF>>, EF), InteractionGpuError> {\n224\t    if trace_interactions.iter().all(|meta| meta.is_none()) {\n225\t        return Ok((DeviceBuffer::new(), alpha_logup));\n226\t    }\n227\t\n228\t    let leaves = DeviceBuffer::<Frac<EF>>::with_capacity(total_leaves);\n229\t    leaves.fill_zero()?;\n230\t\n231\t    // Phase 1: Build work items and sort by descending height for load balance.\n232\t    let mut work_items: Vec<GkrInputWorkItem<HS>> = trace_interactions\n233\t        .iter()\n234\t        .flatten()\n235\t        .map(|meta| {\n236\t            let air_ctx = &ctx.per_trace[meta.trace_idx].1;\n237\t            let pk_air = &pk.per_air[meta.air_idx];\n238\t            let slice = meta.layout_slices.first().unwrap();\n239\t            assert_eq!(slice.col_idx, 0);\n240\t            let dst_offset = slice.row_idx;\n241\t            let leaves_ptr = unsafe { leaves.as_mut_ptr().add(dst_offset) };\n242\t            GkrInputWorkItem {\n243\t                air_ctx,\n244\t                pk_air,\n245\t                l_skip,\n246\t                d_challenges,\n247\t                leaves_ptr: SendPtr(leaves_ptr),\n248\t            }\n249\t        })\n250\t        .collect();\n251\t\n252\t    work_items.sort_by(|a, b| b.air_ctx.height().cmp(&a.air_ctx.height()));\n253\t\n254\t    // Pre-compute max buffer sizes across all work items.\n255\t    let mut max_intermediates_len: usize = 1;\n256\t    let mut max_public_values_len: usize = 0;\n257\t    let mut max_partition_ptrs_len: usize = 0;\n258\t    let mut max_tmp_len: usize = 0;\n259\t\n260\t    for w in &work_items {\n261\t        let rules = &w.pk_air.other_data.interaction_rules;\n262\t        let buffer_size = rules.inner.buffer_size as usize;\n263\t        let is_global = buffer_size > 10;\n264\t        if is_global {\n265\t            max_intermediates_len = max_intermediates_len.max(TASK_SIZE as usize * buffer_size);\n266\t        }\n267\t\n268\t        max_public_values_len = max_public_values_len.max(w.air_ctx.public_values.len());\n269\t\n270\t        let num_partitions = w.air_ctx.cached_mains.len() + 1;\n271\t        max_partition_ptrs_len = max_partition_ptrs_len.max(num_partitions);\n272\t\n273\t        let height = w.air_ctx.height();\n274\t        let lifted_height = height.max(1 << w.l_skip);\n275\t        if height != lifted_height {\n276\t            let num_interactions = w.pk_air.vk.symbolic_constraints.interactions.len();\n277\t            max_tmp_len = max_tmp_len.max(height * num_interactions);\n278\t        }\n279\t    }\n280\t\n281\t    // Barrier: ensure fill_zero() and all prior GPU work is visible to worker thread streams.\n282\t    current_stream_sync().map_err(InteractionGpuError::from)?;\n283\t\n284\t    // Phase 2: Process AIRs in parallel across N OS threads.\n285\t    let mut num_threads = if work_items.len() >= 100 {\n286\t        NUM_GKR_INPUT_STREAMS.min(work_items.len())\n287\t    } else {\n288\t        1\n289\t    };\n290\t\n291\t    // Memory budget check: reduce num_threads if pre-allocation would exceed 2 GB.\n292\t    let per_thread_bytes = max_intermediates_len * std::mem::size_of::<EF>()\n293\t        + max_public_values_len * std::mem::size_of::<F>()\n294\t        + max_partition_ptrs_len * std::mem::size_of::<u64>()\n295\t        + max_tmp_len * std::mem::size_of::<Frac<EF>>();\n296\t    while num_threads > 1 && num_threads * per_thread_bytes > 2_000_000_000 {\n297\t        num_threads /= 2;\n298\t        tracing::warn!(\n299\t            \"Reducing GKR input eval thread count to {} due to memory budget ({}MB per thread)\",\n300\t            num_threads,\n301\t            per_thread_bytes / (1024 * 1024)\n302\t        );\n303\t    }\n304\t\n305\t    // Pre-allocate per-thread buffer pools to avoid per-AIR mutex contention.\n306\t    let thread_buffers: Vec<GkrThreadBuffers> = (0..num_threads)\n307\t        .map(|_| GkrThreadBuffers {\n308\t            intermediates: DeviceBuffer::with_capacity(max_intermediates_len),\n309\t            public_values: if max_public_values_len > 0 {\n310\t                DeviceBuffer::with_capacity(max_public_values_len)\n311\t            } else {\n312\t                DeviceBuffer::new()\n313\t            },\n314\t            partition_ptrs: DeviceBuffer::with_capacity(max_partition_ptrs_len),\n315\t            tmp: if max_tmp_len > 0 {\n316\t                DeviceBuffer::with_capacity(max_tmp_len)\n317\t            } else {\n318\t                DeviceBuffer::new()\n319\t            },\n320\t        })\n321\t        .collect();\n322\t\n323\t    if num_threads <= 1 {\n324\t        let mut bufs = thread_buffers.into_iter().next().unwrap();\n325\t        for w in &work_items {\n326\t            process_gkr_input_air(w, &mut bufs)?;\n327\t        }\n328\t    } else {\n329\t        let chunk_size = work_items.len().div_ceil(num_threads);\n330\t        std::thread::scope(|s| {\n331\t            let handles: Vec<_> = thread_buffers\n332\t                .into_iter()\n333\t                .zip(work_items.chunks(chunk_size))\n334\t                .map(|(mut bufs, chunk)| {\n335\t                    s.spawn(move || -> Result<(), InteractionGpuError> {\n336\t                        for w in chunk {\n337\t                            process_gkr_input_air(w, &mut bufs)?;\n338\t                        }\n339\t                        current_stream_sync().map_err(InteractionGpuError::from)?;\n340\t                        Ok(())\n341\t                    })\n342\t                })\n343\t                .collect();\n344\t            for handle in handles {\n345\t                handle.join().unwrap()?;\n346\t            }\n347\t            Ok::<_, InteractionGpuError>(())\n348\t        })?;\n349\t    }\n350\t\n351\t    // NOTE: alpha is NO LONGER applied here - it will be fused into the first tree layer\n352\t    // in fractional_sumcheck_gpu for better performance (eliminates one memory pass)\n353\t    Ok((leaves, alpha_logup))\n354\t}\n355\t"}]},"parent_tool_use_id":"toolu_01NCF6c8mAruzi4vGafUmVoS","session_id":"5c4196e5-21f2-4e88-ab6f-fb2d2870d4db","uuid":"0369d34a-1ef2-422e-8291-9a83b1a9be62","timestamp":"2026-04-14T23:02:02.664Z"}
