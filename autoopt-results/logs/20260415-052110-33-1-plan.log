{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T25RKgzN7mmThSovgjvpZU","type":"tool_result","content":"1\tuse openvm_cuda_common::{d_buffer::DeviceBuffer, error::CudaError};\n2\tuse openvm_stark_backend::{StarkProtocolConfig, SystemParams};\n3\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n4\tuse openvm_stark_sdk::config::baby_bear_bn254_poseidon2::{\n5\t    BabyBearBn254Poseidon2Config, Digest as Bn254Digest,\n6\t};\n7\tuse openvm_stark_sdk::config::baby_bear_poseidon2::{\n8\t    BabyBearPoseidon2Config, Digest as BabyBearPoseidon2Digest,\n9\t};\n10\tuse serde::{de::DeserializeOwned, Serialize};\n11\t\n12\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n13\tuse crate::{\n14\t    bn254_sponge::MultiField32ChallengerGpu,\n15\t    cuda::bn254_merkle_tree::{\n16\t        bn254_poseidon2_adjacent_compress_layer, bn254_poseidon2_compressing_row_hashes,\n17\t        bn254_poseidon2_compressing_row_hashes_ext,\n18\t    },\n19\t};\n20\tuse crate::{\n21\t    cuda::merkle_tree::{\n22\t        poseidon2_adjacent_compress_layer, poseidon2_compressing_row_hashes,\n23\t        poseidon2_compressing_row_hashes_ext,\n24\t    },\n25\t    merkle_tree::BatchQueryMerkle,\n26\t    sponge::{DuplexSpongeGpu, GpuFiatShamirTranscript},\n27\t    types::{EF, F},\n28\t};\n29\t\n30\t/// Dispatch trait for GPU Merkle hash kernels.\n31\t///\n32\t/// Each implementation routes the three kernel entry points\n33\t/// (`compress_rows`, `compress_rows_ext`, `compress_layer`) to the\n34\t/// appropriate CUDA FFI wrappers, and declares the concrete `Digest` type\n35\t/// those kernels produce.\n36\tpub trait GpuMerkleHash: Copy + Clone + Send + Sync + 'static {\n37\t    type Digest: Copy\n38\t        + Clone\n39\t        + PartialEq\n40\t        + Send\n41\t        + Sync\n42\t        + Serialize\n43\t        + DeserializeOwned\n44\t        + BatchQueryMerkle\n45\t        + 'static;\n46\t\n47\t    /// Compress rows of a base-field matrix into digest leaves.\n48\t    ///\n49\t    /// # Safety\n50\t    ///\n51\t    /// `out` must be allocated with capacity `query_stride` and `matrix` must\n52\t    /// contain `width * query_stride * (1 << log_rows_per_query)` valid elements.\n53\t    unsafe fn compress_rows(\n54\t        out: &mut DeviceBuffer<Self::Digest>,\n55\t        matrix: &DeviceBuffer<F>,\n56\t        width: usize,\n57\t        query_stride: usize,\n58\t        log_rows_per_query: usize,\n59\t    ) -> Result<(), CudaError>;\n60\t\n61\t    /// Compress rows of an extension-field matrix into digest leaves.\n62\t    ///\n63\t    /// # Safety\n64\t    ///\n65\t    /// `out` must be allocated with capacity `query_stride` and `matrix` must\n66\t    /// contain `width * query_stride * (1 << log_rows_per_query)` valid elements.\n67\t    unsafe fn compress_rows_ext(\n68\t        out: &mut DeviceBuffer<Self::Digest>,\n69\t        matrix: &DeviceBuffer<EF>,\n70\t        width: usize,\n71\t        query_stride: usize,\n72\t        log_rows_per_query: usize,\n73\t    ) -> Result<(), CudaError>;\n74\t\n75\t    /// Compress adjacent pairs of digests to build an inner Merkle layer.\n76\t    ///\n77\t    /// # Safety\n78\t    ///\n79\t    /// `output` must be allocated with capacity `output_size`, `prev_layer` must\n80\t    /// contain at least `output_size * 2` valid elements, and the two buffers\n81\t    /// must not overlap.\n82\t    unsafe fn compress_layer(\n83\t        output: &mut DeviceBuffer<Self::Digest>,\n84\t        prev_layer: &DeviceBuffer<Self::Digest>,\n85\t        output_size: usize,\n86\t    ) -> Result<(), CudaError>;\n87\t}\n88\t\n89\t/// Binding trait that couples a `StarkProtocolConfig`, a Merkle hash scheme,\n90\t/// and a transcript type into a single coherent GPU proving configuration.\n91\tpub trait GpuHashScheme: Copy + Clone + Send + Sync + 'static {\n92\t    type SC: StarkProtocolConfig<F = F, EF = EF, Digest = Self::Digest>;\n93\t    type Digest: Copy\n94\t        + Clone\n95\t        + PartialEq\n96\t        + Send\n97\t        + Sync\n98\t        + Serialize\n99\t        + DeserializeOwned\n100\t        + BatchQueryMerkle\n101\t        + 'static;\n102\t    type Transcript: GpuFiatShamirTranscript<Self::SC> + Default + Clone + Send + Sync + 'static;\n103\t    type MerkleHash: GpuMerkleHash<Digest = Self::Digest>;\n104\t\n105\t    fn default_config(params: SystemParams) -> Self::SC;\n106\t\n107\t    fn default_transcript() -> Self::Transcript;\n108\t}\n109\t\n110\t// ---------------------------------------------------------------------------\n111\t// Poseidon2 / BabyBear concrete implementations\n112\t// ---------------------------------------------------------------------------\n113\t\n114\t/// Poseidon2 Merkle hash over BabyBear — delegates to the existing CUDA FFI.\n115\t#[derive(Clone, Copy, Debug, Default)]\n116\tpub struct Poseidon2MerkleHash;\n117\t\n118\timpl GpuMerkleHash for Poseidon2MerkleHash {\n119\t    type Digest = BabyBearPoseidon2Digest;\n120\t\n121\t    unsafe fn compress_rows(\n122\t        out: &mut DeviceBuffer<Self::Digest>,\n123\t        matrix: &DeviceBuffer<F>,\n124\t        width: usize,\n125\t        query_stride: usize,\n126\t        log_rows_per_query: usize,\n127\t    ) -> Result<(), CudaError> {\n128\t        poseidon2_compressing_row_hashes(out, matrix, width, query_stride, log_rows_per_query)\n129\t    }\n130\t\n131\t    unsafe fn compress_rows_ext(\n132\t        out: &mut DeviceBuffer<Self::Digest>,\n133\t        matrix: &DeviceBuffer<EF>,\n134\t        width: usize,\n135\t        query_stride: usize,\n136\t        log_rows_per_query: usize,\n137\t    ) -> Result<(), CudaError> {\n138\t        poseidon2_compressing_row_hashes_ext(out, matrix, width, query_stride, log_rows_per_query)\n139\t    }\n140\t\n141\t    unsafe fn compress_layer(\n142\t        output: &mut DeviceBuffer<Self::Digest>,\n143\t        prev_layer: &DeviceBuffer<Self::Digest>,\n144\t        output_size: usize,\n145\t    ) -> Result<(), CudaError> {\n146\t        poseidon2_adjacent_compress_layer(output, prev_layer, output_size)\n147\t    }\n148\t}\n149\t\n150\t/// BabyBear Poseidon2 hash scheme — the only scheme implemented in this crate.\n151\t#[derive(Clone, Copy, Debug, Default)]\n152\tpub struct BabyBearPoseidon2HashScheme;\n153\t\n154\timpl GpuHashScheme for BabyBearPoseidon2HashScheme {\n155\t    type SC = BabyBearPoseidon2Config;\n156\t    type Digest = BabyBearPoseidon2Digest;\n157\t    type Transcript = DuplexSpongeGpu;\n158\t    type MerkleHash = Poseidon2MerkleHash;\n159\t\n160\t    fn default_config(params: SystemParams) -> Self::SC {\n161\t        Self::SC::default_from_params(params)\n162\t    }\n163\t\n164\t    fn default_transcript() -> Self::Transcript {\n165\t        Self::Transcript::default()\n166\t    }\n167\t}\n168\t\n169\tpub type DefaultHashScheme = BabyBearPoseidon2HashScheme;\n170\t\n171\t// ---------------------------------------------------------------------------\n172\t// BN254 Poseidon2 concrete implementations\n173\t// ---------------------------------------------------------------------------\n174\t\n175\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n176\t/// BN254 Poseidon2 Merkle hash — delegates to the BN254 CUDA FFI.\n177\t#[derive(Clone, Copy, Debug, Default)]\n178\tpub struct Bn254Poseidon2MerkleHash;\n179\t\n180\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n181\timpl GpuMerkleHash for Bn254Poseidon2MerkleHash {\n182\t    // `Bn254Digest` from stark-sdk = `[Bn254Scalar; 1]`, which is the same concrete type as\n183\t    // `Bn254Digest` in `cuda::bn254_merkle_tree` — both are type aliases for `[p3_bn254::Bn254;\n184\t    // 1]`.\n185\t    type Digest = Bn254Digest;\n186\t\n187\t    unsafe fn compress_rows(\n188\t        out: &mut DeviceBuffer<Self::Digest>,\n189\t        matrix: &DeviceBuffer<F>,\n190\t        width: usize,\n191\t        query_stride: usize,\n192\t        log_rows_per_query: usize,\n193\t    ) -> Result<(), CudaError> {\n194\t        bn254_poseidon2_compressing_row_hashes(out, matrix, width, query_stride, log_rows_per_query)\n195\t    }\n196\t\n197\t    unsafe fn compress_rows_ext(\n198\t        out: &mut DeviceBuffer<Self::Digest>,\n199\t        matrix: &DeviceBuffer<EF>,\n200\t        width: usize,"}]},"parent_tool_use_id":"toolu_01QWd8vcARNFuceexMLfptRB","session_id":"f4b22a1a-5187-493b-801a-a22317879818","uuid":"a32247e7-617f-47bd-9f59-d8a6b0b691d3","timestamp":"2026-04-15T03:28:44.442Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BNB8cXbXZ5Y66p8KmZ4eAi","type":"tool_result","content":"1\tuse std::sync::Once;\n2\t\n3\tuse openvm_cuda_common::d_buffer::DeviceBuffer;\n4\t\n5\tuse crate::{cuda::ntt, prelude::F};\n6\t\n7\tconst MAX_LG_DOMAIN_SIZE: usize = 27;\n8\tconst LG_WINDOW_SIZE: usize = MAX_LG_DOMAIN_SIZE.div_ceil(5);\n9\tconst WINDOW_SIZE: usize = 1 << LG_WINDOW_SIZE;\n10\tconst WINDOW_NUM: usize = MAX_LG_DOMAIN_SIZE.div_ceil(LG_WINDOW_SIZE);\n11\t\n12\tstatic INIT_FORWARD: Once = Once::new();\n13\tstatic INIT_INVERSE: Once = Once::new();\n14\t\n15\tfn ensure_initialized(inverse: bool) {\n16\t    let once = if inverse {\n17\t        &INIT_INVERSE\n18\t    } else {\n19\t        &INIT_FORWARD\n20\t    };\n21\t\n22\t    once.call_once(|| {\n23\t        let partial_twiddles = DeviceBuffer::<[F; WINDOW_SIZE]>::with_capacity(WINDOW_NUM);\n24\t        let twiddles = DeviceBuffer::<F>::with_capacity(32 + 64 + 128 + 256 + 512);\n25\t        unsafe {\n26\t            ntt::generate_all_twiddles(&twiddles, inverse).unwrap();\n27\t            ntt::generate_partial_twiddles(&partial_twiddles, inverse).unwrap();\n28\t        }\n29\t    });\n30\t}\n31\t\n32\tstruct NttImpl<'a> {\n33\t    buffer: &'a DeviceBuffer<F>,\n34\t    lg_domain_size: u32,\n35\t    padded_poly_size: u32,\n36\t    poly_count: u32,\n37\t    is_intt: bool,\n38\t    stage: u32,\n39\t}\n40\t\n41\timpl<'a> NttImpl<'a> {\n42\t    fn new(\n43\t        buffer: &'a DeviceBuffer<F>,\n44\t        lg_domain_size: u32,\n45\t        padded_poly_size: u32,\n46\t        poly_count: u32,\n47\t        is_intt: bool,\n48\t    ) -> Self {\n49\t        ensure_initialized(is_intt);\n50\t        Self {\n51\t            buffer,\n52\t            lg_domain_size,\n53\t            padded_poly_size,\n54\t            poly_count,\n55\t            is_intt,\n56\t            stage: 0,\n57\t        }\n58\t    }\n59\t\n60\t    fn step(&mut self, iterations: u32) {\n61\t        assert!(iterations <= 10);\n62\t        let radix = if iterations < 6 { 6 } else { iterations };\n63\t        unsafe {\n64\t            ntt::ct_mixed_radix_narrow(\n65\t                self.buffer,\n66\t                radix,\n67\t                self.lg_domain_size,\n68\t                self.stage,\n69\t                iterations,\n70\t                self.padded_poly_size,\n71\t                self.poly_count,\n72\t                self.is_intt,\n73\t            )\n74\t            .unwrap();\n75\t        }\n76\t        self.stage += iterations;\n77\t    }\n78\t}\n79\t\n80\t/// Performs column-wise batch NTT on `buffer`, where `buffer` is assumed to be column-major with\n81\t/// columns of height `2^(log_trace_height + log_blowup)`. The NTT are performed on the first\n82\t/// `2^log_trace_height` elements of each column. If `bit_reverse` is true, then the input columns\n83\t/// are assumed to be ordered in **natural** ordering, and a bit-reversal permutation is applied for\n84\t/// the internal algorithm of the NTT. If `bit_reverse` is false, then the input columns are assumed\n85\t/// to be in bit-reverse ordering. If `is_intt` is true, the inverse NTT is performed; otherwise,\n86\t/// the forward NTT is performed.\n87\tpub fn batch_ntt(\n88\t    buffer: &DeviceBuffer<F>,\n89\t    log_trace_height: u32,\n90\t    log_blowup: u32,\n91\t    width: u32,\n92\t    bit_reverse: bool,\n93\t    is_intt: bool,\n94\t) {\n95\t    if log_trace_height == 0 {\n96\t        return;\n97\t    }\n98\t\n99\t    let padded_poly_size = 1 << (log_trace_height + log_blowup);\n100\t\n101\t    if bit_reverse {\n102\t        unsafe {\n103\t            ntt::bit_rev(buffer, buffer, log_trace_height, padded_poly_size, width).unwrap();\n104\t        }\n105\t    }\n106\t\n107\t    let mut _impl = NttImpl::new(buffer, log_trace_height, padded_poly_size, width, is_intt);\n108\t    if log_trace_height <= 10 {\n109\t        _impl.step(log_trace_height);\n110\t    } else if log_trace_height <= 17 {\n111\t        let step = log_trace_height / 2;\n112\t        _impl.step(step + log_trace_height % 2);\n113\t        _impl.step(step);\n114\t    } else if log_trace_height <= 30 {\n115\t        let step = log_trace_height / 3;\n116\t        let rem = log_trace_height % 3;\n117\t        _impl.step(step);\n118\t        _impl.step(step + (if log_trace_height == 29 { 1 } else { 0 }));\n119\t        _impl.step(step + (if log_trace_height == 29 { 1 } else { rem }));\n120\t    } else if log_trace_height <= 40 {\n121\t        let step = log_trace_height / 4;\n122\t        let rem = log_trace_height % 4;\n123\t        _impl.step(step);\n124\t        _impl.step(step + (if rem > 2 { 1 } else { 0 }));\n125\t        _impl.step(step + (if rem > 1 { 1 } else { 0 }));\n126\t        _impl.step(step + (if rem > 0 { 1 } else { 0 }));\n127\t    } else {\n128\t        panic!(\"log_trace_height > 40 not supported\");\n129\t    }\n130\t}\n131\t"}]},"parent_tool_use_id":"toolu_01MpNT3i9YS79ZYEb3U2xcBe","session_id":"f4b22a1a-5187-493b-801a-a22317879818","uuid":"1b1d6c63-9a89-4e0f-b3a5-152e6a1b6ba7","timestamp":"2026-04-15T03:28:44.197Z"}
