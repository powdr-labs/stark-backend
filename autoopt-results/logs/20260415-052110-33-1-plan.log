{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012cJt2epxM86vusRpoFE9YF","type":"tool_result","content":"1\tuse openvm_cuda_common::{d_buffer::DeviceBuffer, error::CudaError};\n2\t\n3\tuse crate::prelude::{EF, F};\n4\t\n5\t#[repr(C)]\n6\t#[derive(Clone, Copy)]\n7\tpub struct StackColDesc {\n8\t    pub src: *const F,\n9\t    pub dst: *mut F,\n10\t    pub height: u32,\n11\t    pub stride: u32,\n12\t}\n13\t\n14\t// SAFETY: StackColDesc contains device pointers that are only dereferenced on GPU\n15\tunsafe impl Send for StackColDesc {}\n16\tunsafe impl Sync for StackColDesc {}\n17\t\n18\textern \"C\" {\n19\t    fn _matrix_transpose_fp(\n20\t        output: *mut F,\n21\t        input: *const F,\n22\t        col_size: usize,\n23\t        row_size: usize,\n24\t    ) -> i32;\n25\t\n26\t    fn _matrix_transpose_fpext(\n27\t        output: *mut EF,\n28\t        input: *const EF,\n29\t        col_size: usize,\n30\t        row_size: usize,\n31\t    ) -> i32;\n32\t\n33\t    fn _matrix_get_rows_fp(\n34\t        output: *mut F,\n35\t        input: *const F,\n36\t        row_indices: *const u32,\n37\t        matrix_width: u64,\n38\t        matrix_height: u64,\n39\t        row_indices_len: u32,\n40\t    ) -> i32;\n41\t\n42\t    fn _split_ext_to_base_col_major_matrix(\n43\t        d_matrix: *mut F,\n44\t        d_poly: *const EF,\n45\t        poly_len: u64,\n46\t        matrix_height: u32,\n47\t    ) -> i32;\n48\t\n49\t    fn _batch_rotate_pad(\n50\t        out: *mut F,\n51\t        input: *const F,\n52\t        width: u32,\n53\t        num_x: u32,\n54\t        domain_size: u32,\n55\t        padded_size: u32,\n56\t    ) -> i32;\n57\t\n58\t    fn _lift_padded_matrix_evals(\n59\t        matrix: *mut F,\n60\t        width: u32,\n61\t        height: u32,\n62\t        lifted_height: u32,\n63\t        padded_height: u32,\n64\t    ) -> i32;\n65\t\n66\t    fn _collapse_strided_matrix(\n67\t        out: *mut F,\n68\t        input: *const F,\n69\t        width: u32,\n70\t        height: u32,\n71\t        stride: u32,\n72\t    ) -> i32;\n73\t\n74\t    fn _batch_expand_pad(\n75\t        output: *mut F,\n76\t        input: *const F,\n77\t        poly_count: u32,\n78\t        out_size: u32,\n79\t        in_size: u32,\n80\t    ) -> i32;\n81\t\n82\t    fn _batch_expand_pad_wide(\n83\t        out: *mut F,\n84\t        input: *const F,\n85\t        width: u32,\n86\t        padded_height: u32,\n87\t        height: u32,\n88\t    ) -> i32;\n89\t\n90\t    fn _stack_columns(descs: *const StackColDesc, num_descs: u32) -> i32;\n91\t}\n92\t\n93\t/// Safety:\n94\t/// - `input` and `output` must not overlap.\n95\t/// - `input` and `output` must each have capacity at least `width * height`.\n96\tpub unsafe fn matrix_transpose_fp(\n97\t    output: &DeviceBuffer<F>,\n98\t    input: &DeviceBuffer<F>,\n99\t    width: usize,\n100\t    height: usize,\n101\t) -> Result<(), CudaError> {\n102\t    CudaError::from_result(_matrix_transpose_fp(\n103\t        output.as_mut_ptr(),\n104\t        input.as_ptr(),\n105\t        width,\n106\t        height,\n107\t    ))\n108\t}\n109\t\n110\t/// Safety:\n111\t/// - `input` and `output` must not overlap.\n112\t/// - `input` and `output` must each have capacity at least `width * height`.\n113\tpub unsafe fn matrix_transpose_fpext(\n114\t    output: &DeviceBuffer<EF>,\n115\t    input: &DeviceBuffer<EF>,\n116\t    width: usize,\n117\t    height: usize,\n118\t) -> Result<(), CudaError> {\n119\t    CudaError::from_result(_matrix_transpose_fpext(\n120\t        output.as_mut_ptr(),\n121\t        input.as_ptr(),\n122\t        width,\n123\t        height,\n124\t    ))\n125\t}\n126\t\n127\tpub unsafe fn matrix_get_rows_fp_kernel(\n128\t    output: &DeviceBuffer<F>,\n129\t    input: &DeviceBuffer<F>,\n130\t    row_indices: &DeviceBuffer<u32>,\n131\t    matrix_width: u64,\n132\t    matrix_height: u64,\n133\t    row_indices_len: u32,\n134\t) -> Result<(), CudaError> {\n135\t    CudaError::from_result(_matrix_get_rows_fp(\n136\t        output.as_mut_ptr(),\n137\t        input.as_ptr(),\n138\t        row_indices.as_ptr(),\n139\t        matrix_width,\n140\t        matrix_height,\n141\t        row_indices_len,\n142\t    ))\n143\t}\n144\t\n145\tpub unsafe fn split_ext_to_base_col_major_matrix(\n146\t    d_matrix: &mut DeviceBuffer<F>,\n147\t    d_poly: &DeviceBuffer<EF>,\n148\t    poly_len: u64,\n149\t    matrix_height: u32,\n150\t) -> Result<(), CudaError> {\n151\t    CudaError::from_result(_split_ext_to_base_col_major_matrix(\n152\t        d_matrix.as_mut_ptr(),\n153\t        d_poly.as_ptr(),\n154\t        poly_len,\n155\t        matrix_height,\n156\t    ))\n157\t}\n158\t\n159\t/// This kernel has the effect of rotating `input` column-wise as a `height x width` matrix, where\n160\t/// `height = domain_size * num_x` **and then** batch expanding it as `width * num_x` vectors of\n161\t/// length `domain_size` by zero padding to vectors of length `padded_size`. The output is written\n162\t/// to `output`. This kernel zeros all padding entries.\n163\t///\n164\t/// # Safety\n165\t/// - `output` must be a pointer to DeviceBuffer with capacity for `padded_size * width * num_x`\n166\t///   elements.\n167\t/// - `input` must be a pointer to DeviceBuffer with at least `domain_size * width * num_x`\n168\t///   elements.\n169\t/// - Must have `width * num_x < (u16::MAX)^2` due to grid dimension restrictions.\n170\tpub unsafe fn batch_rotate_pad(\n171\t    output: *mut F,\n172\t    input: *const F,\n173\t    width: u32,\n174\t    num_x: u32,\n175\t    domain_size: u32,\n176\t    padded_size: u32,\n177\t) -> Result<(), CudaError> {\n178\t    debug_assert!(domain_size <= padded_size);\n179\t    debug_assert!(width.checked_mul(num_x).unwrap() < u16::MAX as u32 * u16::MAX as u32);\n180\t    CudaError::from_result(_batch_rotate_pad(\n181\t        output,\n182\t        input,\n183\t        width,\n184\t        num_x,\n185\t        domain_size,\n186\t        padded_size,\n187\t    ))\n188\t}\n189\t\n190\t/// This lifts `matrix` inplace, where `matrix` is already vertically padded.\n191\t/// - `matrix` is a `padded_height x width` matrix.\n192\t///\n193\t/// This kernel cyclically repeats the first `height` rows of the matrix vertically for\n194\t/// `lifted_height` rows. The rows `lifted_height..padded_height` are left untouched.\n195\t///\n196\t/// # Safety\n197\t/// - `matrix` is a pointer to a device buffer with length at least `width * padded_height`.\n198\t/// - `height <= lifted_height <= padded_height`\n199\tpub unsafe fn lift_padded_matrix_evals(\n200\t    matrix: *mut F,\n201\t    width: u32,\n202\t    height: u32,\n203\t    lifted_height: u32,\n204\t    padded_height: u32,\n205\t) -> Result<(), CudaError> {\n206\t    debug_assert!(height <= lifted_height && lifted_height <= padded_height);\n207\t    CudaError::from_result(_lift_padded_matrix_evals(\n208\t        matrix,\n209\t        width,\n210\t        height,\n211\t        lifted_height,\n212\t        padded_height,\n213\t    ))\n214\t}\n215\t\n216\t/// Let `lifted_height = height * stride`. Collapses a `lifted_height × width` matrix to a `height x\n217\t/// width` by taking vertical row `stride`.\n218\t///\n219\t/// # Safety\n220\t/// - `output` must be a pointer to `DeviceBuffer<F>` with length at least `height * width`.\n221\t/// - `input` must be a pointer to `DeviceBuffer<F>` with length at least `lifted_height * width`.\n222\tpub unsafe fn collapse_strided_matrix(\n223\t    output: *mut F,\n224\t    input: *const F,\n225\t    width: u32,\n226\t    height: u32,\n227\t    stride: u32,\n228\t) -> Result<(), CudaError> {\n229\t    CudaError::from_result(_collapse_strided_matrix(\n230\t        output, input, width, height, stride,\n231\t    ))\n232\t}\n233\t\n234\tpub unsafe fn batch_expand_pad(\n235\t    output: *mut F,\n236\t    input: *const F,\n237\t    poly_count: u32,\n238\t    out_size: u32,\n239\t    in_size: u32,\n240\t) -> Result<(), CudaError> {\n241\t    CudaError::from_result(_batch_expand_pad(\n242\t        output, input, poly_count, out_size, in_size,\n243\t    ))\n244\t}\n245\t\n246\t/// Expands a `height × width` column-major matrix to a `padded_height × width` column-major matrix\n247\t/// by padding with zeros. This kernel is intended for use when `width` is large (~2^20), so each\n248\t/// column is handled by a different block.\n249\t///\n250\t/// # Safety\n251\t/// - `out` must be a pointer to `DeviceBuffer<F>` with length at least `padded_height * width`.\n252\t/// - `input` must be a pointer to `DeviceBuffer<F>` with length at least `height * width`.\n253\tpub unsafe fn batch_expand_pad_wide(\n254\t    out: *mut F,\n255\t    input: *const F,\n256\t    width: u32,\n257\t    padded_height: u32,\n258\t    height: u32,\n259\t) -> Result<(), CudaError> {\n260\t    debug_assert!(padded_height > height);\n261\t    CudaError::from_result(_batch_expand_pad_wide(\n262\t        out,\n263\t        input,\n264\t        width,\n265\t        padded_height,\n266\t        height,\n267\t    ))\n268\t}\n269\t\n270\t/// Launches a single batched scatter kernel that copies all column data described by `descs`\n271\t/// into the stacked buffer. Each descriptor specifies a source pointer, destination pointer,\n272\t/// number of elements, and stride.\n273\t///\n274\t/// # Safety\n275\t/// - All `src` and `dst` pointers in the descriptors must be valid device memory.\n276\t/// - Destination regions must not overlap.\n277\tpub unsafe fn stack_columns(descs: &DeviceBuffer<StackColDesc>) -> Result<(), CudaError> {\n278\t    CudaError::from_result(_stack_columns(descs.as_ptr() as *const StackColDesc, descs.len() as u32))\n279\t}\n280\t"}]},"parent_tool_use_id":"toolu_01MpNT3i9YS79ZYEb3U2xcBe","session_id":"f4b22a1a-5187-493b-801a-a22317879818","uuid":"34dd79e9-5ac5-4b8c-9aa4-25b8ce045be0","timestamp":"2026-04-15T03:28:42.316Z"}
