{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NSZFWJhCxvPZokbfYAXK2t","type":"tool_result","content":"1\tuse std::{\n2\t    collections::HashMap,\n3\t    ffi::c_void,\n4\t    ptr::NonNull,\n5\t    sync::{Mutex, OnceLock},\n6\t    time::{SystemTime, UNIX_EPOCH},\n7\t};\n8\t\n9\tuse bytesize::ByteSize;\n10\t\n11\tuse crate::{\n12\t    error::{check, MemoryError},\n13\t    stream::{cudaStreamPerThread, cudaStream_t, current_stream_id, device_synchronize},\n14\t};\n15\t\n16\tmod cuda;\n17\tmod vm_pool;\n18\tuse vm_pool::VirtualMemoryPool;\n19\t\n20\t#[cfg(test)]\n21\tmod tests;\n22\t\n23\t#[link(name = \"cudart\")]\n24\textern \"C\" {\n25\t    fn cudaMallocAsync(dev_ptr: *mut *mut c_void, size: usize, stream: cudaStream_t) -> i32;\n26\t    fn cudaFreeAsync(dev_ptr: *mut c_void, stream: cudaStream_t) -> i32;\n27\t    fn cudaMemGetInfo(free: *mut usize, total: *mut usize) -> i32;\n28\t}\n29\t\n30\tstatic MEMORY_MANAGER: OnceLock<Mutex<MemoryManager>> = OnceLock::new();\n31\t\n32\tpub fn device_memory_used() -> usize {\n33\t    let mut free = 0usize;\n34\t    let mut total = 0usize;\n35\t    unsafe { cudaMemGetInfo(&mut free, &mut total) };\n36\t    total - free\n37\t}\n38\t\n39\t#[ctor::ctor]\n40\tfn init() {\n41\t    let _ = MEMORY_MANAGER.set(Mutex::new(MemoryManager::new()));\n42\t    tracing::info!(\"Memory manager initialized at program start\");\n43\t}\n44\t\n45\tpub struct MemoryManager {\n46\t    pool: VirtualMemoryPool,\n47\t    allocated_ptrs: HashMap<NonNull<c_void>, usize>,\n48\t    current_size: usize,\n49\t    max_used_size: usize,\n50\t}\n51\t\n52\t/// # Safety\n53\t/// `MemoryManager` is not internally synchronized. These impls are safe because\n54\t/// the singleton instance is wrapped in `Mutex` via `MEMORY_MANAGER`.\n55\tunsafe impl Send for MemoryManager {}\n56\tunsafe impl Sync for MemoryManager {}\n57\t\n58\timpl MemoryManager {\n59\t    pub fn new() -> Self {\n60\t        // Create virtual memory pool\n61\t        let pool = VirtualMemoryPool::default();\n62\t\n63\t        Self {\n64\t            pool,\n65\t            allocated_ptrs: HashMap::new(),\n66\t            current_size: 0,\n67\t            max_used_size: 0,\n68\t        }\n69\t    }\n70\t\n71\t    fn d_malloc(&mut self, size: usize) -> Result<*mut c_void, MemoryError> {\n72\t        assert!(size != 0, \"Requested size must be non-zero\");\n73\t\n74\t        let mut tracked_size = size;\n75\t        let ptr = if size < self.pool.page_size {\n76\t            let mut ptr: *mut c_void = std::ptr::null_mut();\n77\t            check(unsafe { cudaMallocAsync(&mut ptr, size, cudaStreamPerThread) }).map_err(\n78\t                |e| {\n79\t                    tracing::error!(\"cudaMallocAsync failed: size={}: {:?}\", size, e);\n80\t                    MemoryError::from(e)\n81\t                },\n82\t            )?;\n83\t            self.allocated_ptrs.insert(\n84\t                NonNull::new(ptr).expect(\"BUG: cudaMallocAsync returned null\"),\n85\t                size,\n86\t            );\n87\t            ptr\n88\t        } else {\n89\t            tracked_size = size.next_multiple_of(self.pool.page_size);\n90\t            let stream_id = current_stream_id()?;\n91\t            self.pool.malloc_internal(tracked_size, stream_id)?\n92\t        };\n93\t\n94\t        self.current_size += tracked_size;\n95\t        if self.current_size > self.max_used_size {\n96\t            self.max_used_size = self.current_size;\n97\t        }\n98\t        Ok(ptr)\n99\t    }\n100\t\n101\t    /// # Safety\n102\t    /// The pointer `ptr` must be a valid, previously allocated device pointer.\n103\t    /// The caller must ensure that `ptr` is not used after this function is called.\n104\t    unsafe fn d_free(&mut self, ptr: *mut c_void) -> Result<(), MemoryError> {\n105\t        let nn = NonNull::new(ptr).ok_or(MemoryError::NullPointer)?;\n106\t\n107\t        if let Some(size) = self.allocated_ptrs.remove(&nn) {\n108\t            self.current_size -= size;\n109\t            check(unsafe { cudaFreeAsync(ptr, cudaStreamPerThread) }).map_err(|e| {\n110\t                tracing::error!(\"cudaFreeAsync failed: ptr={:p}: {:?}\", ptr, e);\n111\t                MemoryError::from(e)\n112\t            })?;\n113\t        } else {\n114\t            let stream_id = current_stream_id()?;\n115\t            let freed_size = self.pool.free_internal(ptr, stream_id)?;\n116\t            self.current_size -= freed_size;\n117\t        }\n118\t\n119\t        Ok(())\n120\t    }\n121\t}\n122\t\n123\timpl Drop for MemoryManager {\n124\t    fn drop(&mut self) {\n125\t        device_synchronize().unwrap();\n126\t        let ptrs: Vec<*mut c_void> = self.allocated_ptrs.keys().map(|nn| nn.as_ptr()).collect();\n127\t        for &ptr in &ptrs {\n128\t            if let Err(e) = unsafe { self.d_free(ptr) } {\n129\t                tracing::error!(\"MemoryManager drop: failed to free {:p}: {:?}\", ptr, e);\n130\t            }\n131\t        }\n132\t    }\n133\t}\n134\t\n135\timpl Default for MemoryManager {\n136\t    fn default() -> Self {\n137\t        Self::new()\n138\t    }\n139\t}\n140\t\n141\tpub fn d_malloc(size: usize) -> Result<*mut c_void, MemoryError> {\n142\t    let manager = MEMORY_MANAGER.get().unwrap();\n143\t    let mut manager = manager.lock().map_err(|_| MemoryError::LockError)?;\n144\t    manager.d_malloc(size)\n145\t}\n146\t\n147\t/// # Safety\n148\t/// The pointer `ptr` must be a valid, previously allocated device pointer.\n149\t/// The caller must ensure that `ptr` is not used after this function is called.\n150\tpub unsafe fn d_free(ptr: *mut c_void) -> Result<(), MemoryError> {"}]},"parent_tool_use_id":"toolu_01WVbdLZJeweczgbWQ8Htego","session_id":"f4b22a1a-5187-493b-801a-a22317879818","uuid":"59ff234e-0dbf-4dd4-8ae9-db8d96cd0476","timestamp":"2026-04-15T04:14:18.287Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HRkf9htuBxFi2GoKeUwzqJ","type":"tool_result","content":"1\tuse std::sync::Arc;\n2\t\n3\tuse getset::Getters;\n4\tuse itertools::Itertools;\n5\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer, memory_manager::MemTracker};\n6\tuse openvm_stark_backend::{\n7\t    p3_util::log2_strict_usize,\n8\t    prover::{stacked_pcs::StackedLayout, MatrixDimensions},\n9\t};\n10\tuse tracing::instrument;\n11\t\n12\tuse crate::{\n13\t    base::{DeviceMatrix, DeviceMatrixView},\n14\t    cuda::{\n15\t        batch_ntt_small::batch_ntt_small,\n16\t        matrix::{batch_expand_pad, stack_columns, StackColDesc},\n17\t        ntt::bit_rev,\n18\t    },\n19\t    hash_scheme::GpuMerkleHash,\n20\t    merkle_tree::{MerkleTreeConstructor, MerkleTreeGpu},\n21\t    ntt::batch_ntt,\n22\t    poly::{mle_interpolate_stages, PleMatrix},\n23\t    prelude::F,\n24\t    GpuProverConfig, ProverError, RsCodeMatrixError, StackTracesError,\n25\t};\n26\t\n27\t#[derive(Getters)]\n28\tpub struct StackedPcsDataGpu<F, Digest> {\n29\t    /// Layout of the unstacked collection of matrices within the stacked matrix.\n30\t    #[getset(get = \"pub\")]\n31\t    pub(crate) layout: StackedLayout,\n32\t    /// The stacked matrix with height `2^{l_skip + n_stack}`.\n33\t    /// This is optionally cached depending on the prover configuration:\n34\t    /// - Caching increases the peak GPU memory but avoids a recomputation during stacked\n35\t    ///   reduction.\n36\t    /// - Not caching means the stacked matrix computation is recomputed during stacked reduction,\n37\t    ///   but lowers the peak GPU memory.\n38\t    #[getset(get = \"pub\")]\n39\t    pub(crate) matrix: Option<PleMatrix<F>>,\n40\t    /// Merkle tree of the Reed-Solomon codewords of the stacked matrix.\n41\t    /// Depends on `k_whir` parameter.\n42\t    #[getset(get = \"pub\")]\n43\t    pub(crate) tree: MerkleTreeGpu<F, Digest>,\n44\t}\n45\t\n46\t#[allow(clippy::type_complexity)]\n47\t#[instrument(level = \"info\", skip_all)]\n48\tpub fn stacked_commit<MH: GpuMerkleHash + MerkleTreeConstructor>(\n49\t    l_skip: usize,\n50\t    n_stack: usize,\n51\t    log_blowup: usize,\n52\t    k_whir: usize,\n53\t    traces: &[&DeviceMatrix<F>],\n54\t    prover_config: GpuProverConfig,\n55\t) -> Result<(MH::Digest, StackedPcsDataGpu<F, MH::Digest>), ProverError> {\n56\t    let mut mem = MemTracker::start(\"prover.stacked_commit\");\n57\t    mem.tracing_info(\"before stacked_commit\");\n58\t    mem.reset_peak();\n59\t    let layout = get_stacked_layout(l_skip, n_stack, traces);\n60\t    tracing::info!(\n61\t        height = layout.height(),\n62\t        width = layout.width(),\n63\t        \"stacked_matrix_dimensions\"\n64\t    );\n65\t    let opt_stacked_matrix = if prover_config.cache_stacked_matrix {\n66\t        Some(stack_traces(&layout, traces)?)\n67\t    } else {\n68\t        None\n69\t    };\n70\t    let rs_matrix = rs_code_matrix(log_blowup, &layout, traces, &opt_stacked_matrix)?;\n71\t    let tree = MerkleTreeGpu::<F, MH::Digest>::new_with_hash::<MH>(\n72\t        rs_matrix,\n73\t        1 << k_whir,\n74\t        prover_config.cache_rs_code_matrix,\n75\t    )?;\n76\t    let root = tree.root();\n77\t    let data = StackedPcsDataGpu {\n78\t        layout,\n79\t        matrix: opt_stacked_matrix,\n80\t        tree,\n81\t    };\n82\t    mem.emit_metrics();\n83\t    Ok((root, data))\n84\t}\n85\t\n86\t/// The `traces` **must** already be in height-sorted order.\n87\t///\n88\t/// This function is generic in `F` and only relies on CUDA memory operations.\n89\t#[instrument(skip_all)]\n90\tpub fn stacked_matrix(\n91\t    l_skip: usize,\n92\t    n_stack: usize,\n93\t    traces: &[&DeviceMatrix<F>],\n94\t) -> Result<(PleMatrix<F>, StackedLayout), ProverError> {\n95\t    let layout = get_stacked_layout(l_skip, n_stack, traces);\n96\t    let matrix = stack_traces(&layout, traces)?;\n97\t    Ok((matrix, layout))\n98\t}\n99\t\n100\tpub(crate) fn get_stacked_layout(\n101\t    l_skip: usize,\n102\t    n_stack: usize,\n103\t    traces: &[&DeviceMatrix<F>],\n104\t) -> StackedLayout {\n105\t    let sorted_meta = traces\n106\t        .iter()\n107\t        .map(|trace| {\n108\t            // height cannot be zero:\n109\t            let log_height = log2_strict_usize(trace.height());\n110\t            (trace.width(), log_height)\n111\t        })\n112\t        .collect_vec();\n113\t    debug_assert!(sorted_meta.is_sorted_by(|a, b| a.1 >= b.1));\n114\t    StackedLayout::new(l_skip, l_skip + n_stack, sorted_meta).unwrap()\n115\t}\n116\t\n117\tpub(crate) fn stack_traces(\n118\t    layout: &StackedLayout,\n119\t    traces: &[&DeviceMatrix<F>],\n120\t) -> Result<PleMatrix<F>, StackTracesError> {\n121\t    let mem = MemTracker::start(\"prover.stack_traces\");\n122\t    let l_skip = layout.l_skip();\n123\t    let height = layout.height();\n124\t    let width = layout.width();\n125\t    let mut q_evals = DeviceBuffer::<F>::with_capacity(width.checked_mul(height).unwrap());\n126\t    stack_traces_into_expanded(layout, traces, &mut q_evals, height)?;\n127\t    mem.emit_metrics();\n128\t    Ok(PleMatrix::from_evals(l_skip, q_evals, height, width))\n129\t}\n130\t\n131\t/// `buffer` should be the buffer to write the stacked traces into.\n132\t/// `buffer` should be a matrix with dimensions `padded_height x width` where `width` is the stacked\n133\t/// width and `padded_height` must be a multiple of the stacked height.\n134\tpub(crate) fn stack_traces_into_expanded(\n135\t    layout: &StackedLayout,\n136\t    traces: &[&DeviceMatrix<F>],\n137\t    buffer: &mut DeviceBuffer<F>,\n138\t    padded_height: usize,\n139\t) -> Result<(), StackTracesError> {\n140\t    let l_skip = layout.l_skip();\n141\t    debug_assert_eq!(padded_height % layout.height(), 0);\n142\t    debug_assert_eq!(buffer.len() % padded_height, 0);\n143\t    debug_assert_eq!(buffer.len() / padded_height, layout.width());\n144\t    buffer.fill_zero().map_err(StackTracesError::FillZero)?;\n145\t\n146\t    // Phase 1: Build descriptor array on host (CPU-only, no CUDA API calls)\n147\t    let mut descs: Vec<StackColDesc> = Vec::with_capacity(layout.sorted_cols.len());\n148\t    for (mat_idx, j, s) in &layout.sorted_cols {\n149\t        let start = s.col_idx * padded_height + s.row_idx;\n150\t        let trace = traces[*mat_idx];\n151\t        let s_len = s.len(l_skip);\n152\t        debug_assert_eq!(trace.height(), 1 << s.log_height());\n153\t        let (src, height, stride) = if s.log_height() >= l_skip {\n154\t            debug_assert_eq!(trace.height(), s_len);\n155\t            let src = unsafe { trace.buffer().as_ptr().add(*j * s_len) };\n156\t            (src, s_len as u32, 1u32)\n157\t        } else {\n158\t            let stride = s.stride(l_skip);\n159\t            debug_assert_eq!(stride * trace.height(), s_len);\n160\t            let src = unsafe { trace.buffer().as_ptr().add(*j * trace.height()) };\n161\t            (src, trace.height() as u32, stride as u32)\n162\t        };\n163\t        let dst = unsafe { buffer.as_mut_ptr().add(start) };\n164\t        descs.push(StackColDesc { src, dst, height, stride });\n165\t    }\n166\t\n167\t    // Phase 2: Upload descriptors to GPU and launch single scatter kernel\n168\t    if !descs.is_empty() {\n169\t        let d_descs = descs.to_device().map_err(StackTracesError::DescriptorUpload)?;\n170\t        unsafe { stack_columns(&d_descs).map_err(StackTracesError::StackColumns)? };\n171\t    }\n172\t    Ok(())\n173\t}\n174\t\n175\t/// Computes the Reed-Solomon codeword of each column vector of `eval_matrix` where the rate is\n176\t/// `2^{-log_blowup}`. The column vectors are treated as evaluations of a prismalinear extension on\n177\t/// a hyperprism.\n178\t///\n179\t/// Uses `stacked_matrix` if available, or else stacks `traces` directly into final codeword matrix\n180\t/// buffer.\n181\t#[instrument(skip_all)]\n182\tpub fn rs_code_matrix(\n183\t    log_blowup: usize,\n184\t    layout: &StackedLayout,\n185\t    traces: &[&DeviceMatrix<F>],\n186\t    stacked_matrix: &Option<PleMatrix<F>>,\n187\t) -> Result<DeviceMatrix<F>, RsCodeMatrixError> {\n188\t    let mem = MemTracker::start_and_reset_peak(\"prover.rs_code_matrix\");\n189\t    let l_skip = layout.l_skip();\n190\t    let height = layout.height();\n191\t    let width = layout.width();\n192\t    debug_assert!(height >= (1 << l_skip));\n193\t    let codeword_height = height.checked_shl(log_blowup as u32).unwrap();\n194\t    let mut codewords = DeviceBuffer::<F>::with_capacity(codeword_height * width);\n195\t    // The following kernels together perform MLE interpolation followed by coset NTT for\n196\t    // `width` polys from `height -> codeword_height` size domains.\n197\t    if let Some(stacked_matrix) = stacked_matrix.as_ref() {\n198\t        // SAFETY: `codewords` is allocated for `width` polys of `codeword_height` each, and we\n199\t        // expand from `matrix.mixed` which is `width` polys of `height` each.\n200\t        unsafe {\n201\t            batch_expand_pad(\n202\t                codewords.as_mut_ptr(),\n203\t                stacked_matrix.mixed.as_ptr(),\n204\t                width as u32,\n205\t                codeword_height as u32,\n206\t                height as u32,\n207\t            )\n208\t            .map_err(RsCodeMatrixError::BatchExpandPad)?;\n209\t        }\n210\t    } else {\n211\t        stack_traces_into_expanded(layout, traces, &mut codewords, codeword_height)\n212\t            .map_err(RsCodeMatrixError::StackTraces)?;\n213\t        // Currently codewords has the stacked matrix, batch expanded, in evaluation form on\n214\t        // hyperprism. We convert it to mixed form, i.e., unroll `PleMatrix::from_evals`.\n215\t        // PERF[jpw]: We do some wasted work on the padded zero part. A more specialized kernel\n216\t        // could be written to avoid this.\n217\t        if l_skip > 0 {\n218\t            // For univariate coordinate, perform inverse NTT for each 2^l_skip chunk per column:\n219\t            // (width cols) * (codeword_height / 2^l_skip chunks per col). Use natural ordering.\n220\t            let num_uni_poly = width * (codeword_height >> l_skip);\n221\t            unsafe {\n222\t                batch_ntt_small(&mut codewords, l_skip, num_uni_poly, true)\n223\t                    .map_err(RsCodeMatrixError::CustomBatchIntt)?;\n224\t            }\n225\t        }\n226\t    }\n227\t    // Eval-to-coeff RS encoding: Instead of full n-stage MLE evals→coeffs interpolation\n228\t    // (where n = log_height - l_skip), we only need l_skip stages of coeffs→evals\n229\t    // (subset-zeta transform) within each 2^l_skip chunk. This is a major optimization:\n230\t    // e.g. for log_height=17, l_skip=2: 2 stages instead of 15.\n231\t    let log_codeword_height = log2_strict_usize(codeword_height);\n232\t\n233\t    // Apply l_skip stages of coeffs_to_evals within each 2^l_skip chunk.\n234\t    // After iNTT, each chunk holds Z-monomial coefficients. We apply the subset-zeta\n235\t    // transform to convert to hypercube evaluations over the Z-bit variables.\n236\t    if l_skip > 0 {\n237\t        // SAFETY: `codewords` is properly initialized and parameters are valid.\n238\t        // Steps 2^0, 2^1, ..., 2^(l_skip-1) stay within chunk boundaries.\n239\t        unsafe {\n240\t            mle_interpolate_stages(\n241\t                codewords.as_mut_ptr(),\n242\t                width as u16,\n243\t                codeword_height as u32,\n244\t                log_blowup as u32,\n245\t                0,                 // start_log_step\n246\t                l_skip as u32 - 1, // end_log_step (inclusive)\n247\t                false,             // coeffs to evals (NOT eval to coeff)\n248\t                false,             // natural order\n249\t            )\n250\t            .map_err(|error| RsCodeMatrixError::MleInterpolateStage2d { error, step: 1 })?;\n251\t        }\n252\t    }\n253\t\n254\t    // Bit-reverse the entire buffer in-place (required for NTT)\n255\t    unsafe {\n256\t        bit_rev(\n257\t            &codewords,\n258\t            &codewords,\n259\t            log_codeword_height as u32,\n260\t            codeword_height as u32,\n261\t            width as u32,\n262\t        )\n263\t        .map_err(RsCodeMatrixError::BitRev)?;\n264\t    }\n265\t\n266\t    // Compute RS codeword via DFT on the smoothly-embedded domain.\n267\t    batch_ntt(\n268\t        &codewords,\n269\t        log_codeword_height as u32,\n270\t        0u32,\n271\t        width as u32,\n272\t        false, // bit-reversal already done\n273\t        false,\n274\t    );\n275\t    let code_matrix = DeviceMatrix::new(Arc::new(codewords), codeword_height, width);\n276\t    mem.emit_metrics();\n277\t\n278\t    Ok(code_matrix)\n279\t}\n280\t\n281\timpl<F, Digest> StackedPcsDataGpu<F, Digest> {\n282\t    /// Returns a view of the specified unstacked matrix in mixed form.\n283\t    ///\n284\t    /// # Notes\n285\t    /// - `width` must be the width of the unstacked matrix.\n286\t    /// - The unstacked matrix may be strided - this must be handled by the caller.\n287\t    pub fn mixed_view<'a>(\n288\t        &'a self,\n289\t        mat_idx: usize,\n290\t        width: usize,\n291\t    ) -> Option<DeviceMatrixView<'a, F>> {\n292\t        if let Some(matrix) = self.matrix.as_ref() {\n293\t            debug_assert_eq!(self.layout.width_of(mat_idx), width);\n294\t            let s = self\n295\t                .layout\n296\t                .get(mat_idx, 0)\n297\t                .unwrap_or_else(|| panic!(\"Invalid matrix index: {mat_idx}\"));\n298\t            let l_skip = self.layout.l_skip();\n299\t            let lifted_height = s.len(l_skip);\n300\t            let offset = s.col_idx * matrix.height() + s.row_idx;"}]},"parent_tool_use_id":"toolu_01WVbdLZJeweczgbWQ8Htego","session_id":"f4b22a1a-5187-493b-801a-a22317879818","uuid":"0d734575-c052-4b52-ae37-3a05bd90a235","timestamp":"2026-04-15T04:14:18.387Z"}
