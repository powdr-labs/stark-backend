{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0162vXBLv9FX2K52rjMK2WM9","type":"tool_result","content":"1\t// NOTE[jpw]: copied from stark-backend but renamed for , now generic in SC\n2\t\n3\t// Keygen API for STARK backend\n4\t// Changes:\n5\t// - All AIRs can be optional\n6\tuse std::sync::Arc;\n7\t\n8\tuse derivative::Derivative;\n9\tuse serde::{Deserialize, Serialize};\n10\tuse thiserror::Error;\n11\t\n12\tuse crate::{\n13\t    air_builders::symbolic::{symbolic_variable::SymbolicVariable, SymbolicConstraintsDag},\n14\t    prover::stacked_pcs::StackedPcsData,\n15\t    StarkProtocolConfig, SystemParams,\n16\t};\n17\t\n18\t/// Widths of different parts of trace matrix\n19\t#[derive(Clone, Debug, Serialize, Deserialize)]\n20\tpub struct TraceWidth {\n21\t    pub preprocessed: Option<usize>,\n22\t    pub cached_mains: Vec<usize>,\n23\t    pub common_main: usize,\n24\t    /// Width counted by extension field elements, _not_ base field elements\n25\t    pub after_challenge: Vec<usize>,\n26\t}\n27\t\n28\timpl TraceWidth {\n29\t    /// Returns the widths of all main traces, including the common main trace if it exists.\n30\t    pub fn main_widths(&self) -> Vec<usize> {\n31\t        let mut ret = self.cached_mains.clone();\n32\t        if self.common_main != 0 {\n33\t            ret.push(self.common_main);\n34\t        }\n35\t        ret\n36\t    }\n37\t\n38\t    /// Returns the width of the main trace, i.e., the sum of all cached main widths and the common\n39\t    /// main width.\n40\t    pub fn main_width(&self) -> usize {\n41\t        self.cached_mains.iter().sum::<usize>() + self.common_main\n42\t    }\n43\t\n44\t    /// Total width of the trace matrix, including the preprocessed width, main width, and\n45\t    /// after-challenge widths.\n46\t    pub fn total_width(&self, ext_degree: usize) -> usize {\n47\t        self.preprocessed.unwrap_or(0)\n48\t            + self.main_width()\n49\t            + self.after_challenge.iter().sum::<usize>() * ext_degree\n50\t    }\n51\t}\n52\t\n53\t#[derive(Serialize, Deserialize, Clone, Debug, PartialEq, Eq)]\n54\tpub struct LinearConstraint {\n55\t    pub coefficients: Vec<u32>,\n56\t    pub threshold: u32,\n57\t}\n58\t\n59\timpl LinearConstraint {\n60\t    /// Returns true if `self` is logically implied by `other`, i.e.,\n61\t    /// whenever `other` is satisfied, `self` is also satisfied.\n62\t    pub fn is_implied_by(&self, other: &LinearConstraint) -> bool {\n63\t        self.threshold >= other.threshold\n64\t            && self\n65\t                .coefficients\n66\t                .iter()\n67\t                .zip(&other.coefficients)\n68\t                .all(|(a, b)| a <= b)\n69\t    }\n70\t}\n71\t\n72\t#[derive(Error, Debug)]\n73\tpub enum KeygenError {\n74\t    #[error(\"Max constraint degree exceeded for AIR {name}: {degree} > {max_degree}\")]\n75\t    MaxConstraintDegreeExceeded {\n76\t        name: String,\n77\t        degree: usize,\n78\t        max_degree: usize,\n79\t    },\n80\t}\n81\t\n82\t#[derive(Clone, Debug, Serialize, Deserialize)]\n83\t#[repr(C)]\n84\tpub struct StarkVerifyingParams {\n85\t    /// Trace sub-matrix widths\n86\t    pub width: TraceWidth,\n87\t    /// Number of public values for this STARK only\n88\t    pub num_public_values: usize,\n89\t    /// A flag indicating whether at least one rotated variable is used in any\n90\t    /// of the constraints and/or interactions across all trace parts (common,\n91\t    /// preprocessed if there is one, all cached).\n92\t    pub need_rot: bool,\n93\t}\n94\t\n95\t/// Verifier data for preprocessed trace for a single AIR.\n96\t///\n97\t/// Currently assumes each AIR has it's own preprocessed commitment\n98\t#[derive(Clone, Debug, Serialize, Deserialize)]\n99\tpub struct VerifierSinglePreprocessedData<Digest> {\n100\t    /// Commitment to the preprocessed trace.\n101\t    pub commit: Digest,\n102\t    /// The hypercube dimension of the preprocessed data _before stacking_ (log_height -\n103\t    /// vk.l_skip).\n104\t    pub hypercube_dim: isize,\n105\t    /// The width of the data after stacking.\n106\t    pub stacking_width: usize,\n107\t}\n108\t\n109\t/// Verifying key for a single STARK (corresponding to single AIR matrix)\n110\t#[derive(Clone, Debug, Serialize, Deserialize)]\n111\t#[repr(C)]\n112\tpub struct StarkVerifyingKey<F, Digest> {\n113\t    /// Preprocessed trace data, if any\n114\t    pub preprocessed_data: Option<VerifierSinglePreprocessedData<Digest>>,\n115\t    /// Parameters of the STARK\n116\t    pub params: StarkVerifyingParams,\n117\t    /// Symbolic constraints of the AIR in all challenge phases. This is\n118\t    /// a serialization of the constraints in the AIR.\n119\t    pub symbolic_constraints: SymbolicConstraintsDag<F>,\n120\t    /// The maximum degree of any polynomial (constraint or interaction) for this AIR.\n121\t    pub max_constraint_degree: u8,\n122\t    /// True means this AIR must have non-empty trace.\n123\t    pub is_required: bool,\n124\t    /// Symbolic variables referenced unreferenced by the AIR.\n125\t    pub unused_variables: Vec<SymbolicVariable<F>>,\n126\t}\n127\t\n128\t/// Common verifying key for multiple AIRs.\n129\t///\n130\t/// This struct contains the necessary data for the verifier to verify proofs generated for\n131\t/// multiple AIRs using a single verifying key.\n132\t#[derive(Derivative, Serialize, Deserialize)]\n133\t#[derivative(Clone(bound = \"\"), Debug(bound = \"\"))]\n134\t#[serde(bound = \"\")]\n135\tpub struct MultiStarkVerifyingKey<SC: StarkProtocolConfig> {\n136\t    /// All parts of the verifying key needed by the verifier, except\n137\t    /// the `pre_hash` used to initialize the Fiat-Shamir transcript.\n138\t    pub inner: MultiStarkVerifyingKey0<SC>,\n139\t    /// The hash of all other parts of the verifying key. The Fiat-Shamir hasher will\n140\t    /// initialize by observing this hash.\n141\t    pub pre_hash: SC::Digest,\n142\t}\n143\t\n144\t/// Everything in [MultiStarkVerifyingKey] except the `pre_hash` used to initialize the Fiat-Shamir\n145\t/// transcript.\n146\t#[derive(Derivative, Serialize, Deserialize)]\n147\t#[derivative(Clone(bound = \"\"), Debug(bound = \"\"))]\n148\t#[serde(bound = \"\")]\n149\tpub struct MultiStarkVerifyingKey0<SC: StarkProtocolConfig> {\n150\t    pub params: SystemParams,\n151\t    pub per_air: Vec<StarkVerifyingKey<SC::F, SC::Digest>>,\n152\t    pub trace_height_constraints: Vec<LinearConstraint>,\n153\t}\n154\t\n155\t/// Proving key for a single STARK (corresponding to single AIR matrix)\n156\t#[derive(Derivative, Serialize, Deserialize)]\n157\t#[derivative(Clone(bound = \"\"))]\n158\t#[serde(bound = \"\")]\n159\tpub struct StarkProvingKey<SC: StarkProtocolConfig> {\n160\t    /// Type name of the AIR, for display purposes only\n161\t    pub air_name: String,\n162\t    /// Verifying key\n163\t    pub vk: StarkVerifyingKey<SC::F, SC::Digest>,\n164\t    /// Prover only data for preprocessed trace\n165\t    pub preprocessed_data: Option<Arc<StackedPcsData<SC::F, SC::Digest>>>,\n166\t}\n167\t\n168\t/// Common proving key for multiple AIRs.\n169\t///\n170\t/// This struct contains the necessary data for the prover to generate proofs for multiple AIRs\n171\t/// using a single proving key.\n172\t#[derive(Derivative, Serialize, Deserialize)]\n173\t#[derivative(Clone(bound = \"\"))]\n174\t#[serde(bound = \"\")]\n175\tpub struct MultiStarkProvingKey<SC: StarkProtocolConfig> {\n176\t    pub per_air: Vec<StarkProvingKey<SC>>,\n177\t    pub trace_height_constraints: Vec<LinearConstraint>,\n178\t    /// Maximum degree of constraints across all AIRs\n179\t    pub max_constraint_degree: usize,\n180\t    pub params: SystemParams,\n181\t    /// See [MultiStarkVerifyingKey]\n182\t    pub vk_pre_hash: SC::Digest,\n183\t}\n184\t\n185\timpl<Val, Com> StarkVerifyingKey<Val, Com> {\n186\t    pub fn num_cached_mains(&self) -> usize {\n187\t        self.params.width.cached_mains.len()\n188\t    }\n189\t\n190\t    pub fn num_parts(&self) -> usize {\n191\t        1 + self.num_cached_mains() + (self.preprocessed_data.is_some() as usize)\n192\t    }\n193\t\n194\t    pub fn has_interaction(&self) -> bool {\n195\t        !self.symbolic_constraints.interactions.is_empty()\n196\t    }\n197\t\n198\t    pub fn num_interactions(&self) -> usize {\n199\t        self.symbolic_constraints.interactions.len()\n200\t    }"}]},"parent_tool_use_id":"toolu_01QWd8vcARNFuceexMLfptRB","session_id":"f4b22a1a-5187-493b-801a-a22317879818","uuid":"48564e52-8e60-4cf9-a6b2-2c0c1de43345","timestamp":"2026-04-15T03:29:20.810Z"}
