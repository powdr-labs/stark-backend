{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KGZzhdTgABn9tzo8WqHXC5","type":"tool_result","content":"300\t        }\n301\t        let numer_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n302\t            RowMajorMatrix::new(numer_values, num_cosets_logup),\n303\t            omega_root,\n304\t            F::ONE,\n305\t        );\n306\t        let denom_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n307\t            RowMajorMatrix::new(denom_values, num_cosets_logup),\n308\t            omega_root,\n309\t            F::ONE,\n310\t        );\n311\t        (Some(numer_poly), Some(denom_poly))\n312\t    } else {\n313\t        (None, None)\n314\t    };\n315\t\n316\t    Ok(Round0AirResult {\n317\t        trace_idx: w.trace_idx,\n318\t        zerocheck_poly,\n319\t        logup_numer_poly,\n320\t        logup_denom_poly,\n321\t    })\n322\t}\n323\t\n324\t#[allow(clippy::type_complexity)]\n325\t#[instrument(level = \"info\", skip_all)]\n326\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n327\t    transcript: &mut TS,\n328\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n329\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n330\t    save_memory: bool,\n331\t    monomial_num_y_threshold: u32,\n332\t    sm_count: u32,\n333\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n334\twhere\n335\t    HS: GpuHashScheme,\n336\t    TS: GpuFiatShamirTranscript<HS::SC>,\n337\t{\n338\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n339\t    let l_skip = mpk.params.l_skip;\n340\t    let constraint_degree = mpk.max_constraint_degree;\n341\t    let num_traces = ctx.per_trace.len();\n342\t\n343\t    // Traces are sorted\n344\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n345\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n346\t    // heights\n347\t    let mut total_interactions = 0u64;\n348\t    let interactions_meta: Vec<_> = ctx\n349\t        .per_trace\n350\t        .iter()\n351\t        .map(|(air_idx, air_ctx)| {\n352\t            let pk = &mpk.per_air[*air_idx];\n353\t\n354\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n355\t            let height = air_ctx.common_main.height();\n356\t            let log_height = log2_strict_usize(height);\n357\t            let log_lifted_height = log_height.max(l_skip);\n358\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n359\t            (num_interactions, log_lifted_height)\n360\t        })\n361\t        .collect();\n362\t    // Implicitly, the width of this stacking should be 1\n363\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n364\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n365\t    // GKR\n366\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n367\t\n368\t    // Grind to increase soundness of random sampling for LogUp\n369\t    let logup_pow_witness = transcript\n370\t        .grind_gpu(mpk.params.logup.pow_bits)\n371\t        .map_err(LogupZerocheckError::Grind)?;\n372\t    let alpha_logup = transcript.sample_ext();\n373\t    let beta_logup = transcript.sample_ext();\n374\t    debug!(%alpha_logup, %beta_logup);\n375\t\n376\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n377\t    let mut prover = LogupZerocheckGpu::new(\n378\t        mpk,\n379\t        ctx,\n380\t        n_logup,\n381\t        interactions_layout,\n382\t        alpha_logup,\n383\t        beta_logup,\n384\t        save_memory,\n385\t        monomial_num_y_threshold,\n386\t        sm_count,\n387\t    )?;\n388\t    let n_global = prover.n_global;\n389\t\n390\t    let total_leaves = 1 << (l_skip + n_logup);\n391\t    prover\n392\t        .mem\n393\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n394\t    prover.mem.reset_peak();\n395\t    let (inputs, alpha) = if has_interactions {\n396\t        log_gkr_input_evals(\n397\t            &prover.trace_interactions,\n398\t            mpk,\n399\t            ctx,\n400\t            l_skip,\n401\t            alpha_logup,\n402\t            &prover.d_challenges,\n403\t            total_leaves,\n404\t        )?\n405\t    } else {\n406\t        (DeviceBuffer::new(), EF::ZERO)\n407\t    };\n408\t    // Set memory limit for batch MLE based on inputs buffer size\n409\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n410\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n411\t    if !prover.save_memory {\n412\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n413\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n414\t            tracing::warn!(\n415\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n416\t                prover.memory_limit_bytes\n417\t            );\n418\t        }\n419\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n420\t    }\n421\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n422\t\n423\t    let (frac_sum_proof, mut xi) =\n424\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n425\t    while xi.len() != l_skip + n_global {\n426\t        xi.push(transcript.sample_ext());\n427\t    }\n428\t    debug!(?xi);\n429\t    prover.xi = xi;\n430\t\n431\t    logup_gkr_span.exit();\n432\t\n433\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does\n434\t    // not include the kernel times for the actual folding\n435\t    let round0_span = info_span!(\"prover.rap_constraints.round0\", phase = \"prover\").entered();\n436\t    // begin batch sumcheck\n437\t    let mut sumcheck_round_polys = Vec::with_capacity(n_max);\n438\t    let mut r = Vec::with_capacity(n_max + 1);\n439\t    // batching randomness\n440\t    let lambda = transcript.sample_ext();\n441\t    debug!(%lambda);\n442\t\n443\t    let sp_0_polys = prover.sumcheck_uni_round0_polys(ctx, lambda)?;\n444\t    let s_0_cpu_span = info_span!(\"s'_0 -> s_0 cpu interpolations\").entered();\n445\t    let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_degree);\n446\t    let s_deg = constraint_degree + 1;\n447\t    let s_0_deg = sumcheck_round0_deg(l_skip, s_deg);\n448\t    let large_uni_domain = (s_0_deg + 1).next_power_of_two();\n449\t    let dft = Radix2BowersSerial;\n450\t    let s_0_logup_polys = {\n451\t        let eq_sharp_uni = eq_sharp_uni_poly(&prover.xi[..l_skip]);\n452\t        let mut eq_coeffs = eq_sharp_uni.into_coeffs();\n453\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n454\t        let eq_evals = dft.dft(eq_coeffs);\n455\t\n456\t        let width = 2 * num_traces;\n457\t        let mut sp_coeffs_mat = EF::zero_vec(width * large_uni_domain);\n458\t        for (i, coeffs) in sp_0_polys[..2 * num_traces].iter().enumerate() {\n459\t            for (j, &c_j) in coeffs.coeffs().iter().enumerate().take(sp_0_deg + 1) {\n460\t                // SAFETY:\n461\t                // - coeffs length is <= sp_0_deg + 1 <= s_0_deg < large_uni_domain\n462\t                // - sp_coeffs_mat allocated for width\n463\t                unsafe {\n464\t                    *sp_coeffs_mat.get_unchecked_mut(j * width + i) = c_j;\n465\t                }\n466\t            }\n467\t        }\n468\t        let mut s_evals = dft.dft_batch(RowMajorMatrix::new(sp_coeffs_mat, width));\n469\t        for (eq, row) in zip(eq_evals, s_evals.values.chunks_mut(width)) {\n470\t            for x in row {\n471\t                *x *= eq;\n472\t            }\n473\t        }\n474\t        dft.idft_batch(s_evals)\n475\t    };\n476\t    let skip_domain_size = F::from_usize(1 << l_skip);\n477\t    // logup sum claims (sum_{\\hat p}, sum_{\\hat q}) per present AIR\n478\t    let (numerator_term_per_air, denominator_term_per_air): (Vec<_>, Vec<_>) = (0..num_traces)\n479\t        .map(|trace_idx| {\n480\t            let [sum_claim_p, sum_claim_q] = [0, 1].map(|is_denom| {\n481\t                // Compute sum over D of s_0(Z) to get the sum claim\n482\t                (0..=s_0_deg)\n483\t                    .step_by(1 << l_skip)\n484\t                    .map(|j| unsafe {\n485\t                        // SAFETY: matrix is 2 * num_trace x large_uni_domain, s_0_deg <\n486\t                        // large_uni_domain\n487\t                        *s_0_logup_polys\n488\t                            .values\n489\t                            .get_unchecked(j * 2 * num_traces + 2 * trace_idx + is_denom)\n490\t                    })\n491\t                    .sum::<EF>()\n492\t                    * skip_domain_size\n493\t            });\n494\t            transcript.observe_ext(sum_claim_p);\n495\t            transcript.observe_ext(sum_claim_q);\n496\t\n497\t            (sum_claim_p, sum_claim_q)\n498\t        })\n499\t        .unzip();\n500\t\n501\t    let mu = transcript.sample_ext();\n502\t    debug!(%mu);\n503\t    let mu_pows = mu.powers().take(3 * num_traces).collect_vec();\n504\t\n505\t    let s_0_zc_poly = {\n506\t        let eq_uni = eq_uni_poly::<F, _>(l_skip, prover.xi[0]);\n507\t        let mut eq_coeffs = eq_uni.into_coeffs();\n508\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n509\t        let eq_evals = dft.dft(eq_coeffs);\n510\t\n511\t        // Algebraically batch\n512\t        let mut sp_coeffs = EF::zero_vec(large_uni_domain);\n513\t        let mus = &mu_pows[2 * num_traces..];\n514\t        let polys = &sp_0_polys[2 * num_traces..];\n515\t        for (j, batch_coeff) in sp_coeffs.iter_mut().enumerate().take(sp_0_deg + 1) {\n516\t            for (&mu, poly) in zip(mus, polys) {\n517\t                *batch_coeff += mu * *poly.coeffs().get(j).unwrap_or(&EF::ZERO);\n518\t            }\n519\t        }\n520\t        let mut s_evals = dft.dft(sp_coeffs);\n521\t        for (eq, x) in zip(eq_evals, &mut s_evals) {\n522\t            *x *= eq;\n523\t        }\n524\t        dft.idft(s_evals)\n525\t    };\n526\t\n527\t    // Algebraically batch\n528\t    let s_0_poly = UnivariatePoly::new(\n529\t        zip(\n530\t            s_0_logup_polys.values.chunks_exact(2 * num_traces),\n531\t            s_0_zc_poly,\n532\t        )\n533\t        .take(s_0_deg + 1)\n534\t        .map(|(logup_row, batched_zc)| {\n535\t            let coeff = batched_zc\n536\t                + zip(&mu_pows, logup_row)\n537\t                    .map(|(&mu_j, &x)| mu_j * x)\n538\t                    .sum::<EF>();\n539\t            transcript.observe_ext(coeff);\n540\t            coeff\n541\t        })\n542\t        .collect(),\n543\t    );\n544\t    drop(s_0_cpu_span);\n545\t\n546\t    let r_0 = transcript.sample_ext();\n547\t    r.push(r_0);\n548\t    debug!(round = 0, r_round = %r_0);\n549\t    prover.prev_s_eval = s_0_poly.eval_at_point(r_0);\n550\t    debug!(\"s_0(r_0) = {}\", prover.prev_s_eval);\n551\t\n552\t    prover.fold_ple_evals(ctx, r_0)?;\n553\t    drop(round0_span);\n554\t\n555\t    // Sumcheck rounds:\n556\t    // - each round the prover needs to compute univariate polynomial `s_round`. This poly is linear\n557\t    //   since we are taking MLE of `evals`.\n558\t    // - at end of each round, sample random `r_round` in `EF`\n559\t    //\n560\t    // `s_round` is degree `s_deg` so we evaluate it at `0, ..., =s_deg`. The prover skips\n561\t    // evaluation at `0` because the verifier can infer it from the previous round's\n562\t    // `s_{round-1}(r)` claim. The degree is constraint_degree + 1, where + 1 is from eq term\n563\t    let mle_rounds_span =\n564\t        info_span!(\"prover.rap_constraints.mle_rounds\", phase = \"prover\").entered();\n565\t    debug!(%s_deg);\n566\t    for round in 1..=n_max {\n567\t        let sp_round_evals = prover.sumcheck_polys_batch_eval(round, r[round - 1])?;\n568\t        let batch_s = prover.compute_batch_s_poly(sp_round_evals, num_traces, round, &mu_pows);\n569\t        let batch_s_evals = (1..=s_deg)\n570\t            .map(|i| batch_s.eval_at_point(EF::from_usize(i)))\n571\t            .collect_vec();\n572\t        for &eval in &batch_s_evals {\n573\t            transcript.observe_ext(eval);\n574\t        }\n575\t        sumcheck_round_polys.push(batch_s_evals);\n576\t\n577\t        let r_round = transcript.sample_ext();\n578\t        debug!(%round, %r_round);\n579\t        r.push(r_round);\n580\t        prover.prev_s_eval = batch_s.eval_at_point(r_round);\n581\t\n582\t        prover.fold_mle_evals(round, r_round)?;\n583\t    }\n584\t    assert_eq!(r.len(), n_max + 1);\n585\t\n586\t    let column_openings = prover.into_column_openings()?;\n587\t\n588\t    let need_rot_per_trace = ctx\n589\t        .per_trace\n590\t        .iter()\n591\t        .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n592\t        .collect::<Vec<_>>();\n593\t    // Observe common main openings first, and then preprocessed/cached\n594\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n595\t        for (claim, claim_rot) in column_openings_by_rot(&openings[0], *need_rot) {\n596\t            transcript.observe_ext(claim);\n597\t            transcript.observe_ext(claim_rot);\n598\t        }\n599\t    }\n600\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n601\t        for part in openings.iter().skip(1) {\n602\t            for (claim, claim_rot) in column_openings_by_rot(part, *need_rot) {\n603\t                transcript.observe_ext(claim);\n604\t                transcript.observe_ext(claim_rot);\n605\t            }\n606\t        }\n607\t    }\n608\t    drop(mle_rounds_span);\n609\t\n610\t    let batch_constraint_proof = BatchConstraintProof {\n611\t        numerator_term_per_air,\n612\t        denominator_term_per_air,\n613\t        univariate_round_coeffs: s_0_poly.into_coeffs(),\n614\t        sumcheck_round_polys,\n615\t        column_openings,\n616\t    };\n617\t    let gkr_proof = GkrProof {\n618\t        logup_pow_witness,\n619\t        q0_claim: frac_sum_proof.fractional_sum.1,\n620\t        claims_per_layer: frac_sum_proof.claims_per_layer,\n621\t        sumcheck_polys: frac_sum_proof.sumcheck_polys,\n622\t    };\n623\t    Ok((gkr_proof, batch_constraint_proof, r))\n624\t}\n625\t\n626\tpub struct LogupZerocheckGpu<'a, HS: GpuHashScheme> {\n627\t    pub alpha_logup: EF,\n628\t    pub beta_pows: Vec<EF>,\n629\t    // [alpha, beta^0, beta^1, .., beta^max_interaction_len]\n630\t    pub d_challenges: DeviceBuffer<EF>,\n631\t\n632\t    pub l_skip: usize,\n633\t    n_logup: usize,\n634\t    n_global: usize,\n635\t\n636\t    pub omega_skip: F,\n637\t    pub omega_skip_pows: Vec<F>,\n638\t    d_omega_skip_pows: DeviceBuffer<F>,\n639\t\n640\t    pub interactions_layout: StackedLayout,\n641\t    pub constraint_degree: usize,\n642\t    n_per_trace: Vec<isize>,\n643\t    max_num_constraints: usize,\n644\t    pub monomial_num_y_threshold: u32,\n645\t    sm_count: u32,\n646\t    // Available after GKR:\n647\t    pub xi: Vec<EF>,\n648\t    pub lambda_pows: Option<DeviceBuffer<EF>>,\n649\t    /// Precomputed lambda combinations per AIR (indexed by air_idx). Set when lambda is sampled.\n650\t    lambda_combinations: Vec<Option<DeviceBuffer<EF>>>,\n651\t    /// Beta powers on device for logup MLE rounds.\n652\t    d_beta_pows: DeviceBuffer<EF>,\n653\t    /// Precomputed logup combinations per trace (indexed by trace_idx). Set when xi is sampled.\n654\t    logup_combinations: Vec<Option<LogupCombinations>>,\n655\t\n656\t    // n_T => segment tree of eq(xi[j..1+n_T]) for j=1..={n_T-round+1} in _reverse_ layout\n657\t    eq_xis: FxHashMap<usize, EqEvalLayers<EF>>,\n658\t    eq_3b_per_trace: Vec<Vec<EF>>,\n659\t    d_eq_3b_per_trace: Vec<DeviceBuffer<EF>>,\n660\t    // Evaluations on hypercube only, for round 0\n661\t    sels_per_trace_base: Vec<DeviceMatrix<F>>,\n662\t    // After univariate round 0:\n663\t    mat_evals_per_trace: Vec<Vec<DeviceMatrix<EF>>>,\n664\t    sels_per_trace: Vec<DeviceMatrix<EF>>,\n665\t    // Store public_values per trace (similar to CPU's EvalHelper)\n666\t    public_values_per_trace: Vec<DeviceBuffer<F>>,\n667\t    air_indices_per_trace: Vec<usize>,\n668\t    zerocheck_tilde_evals: Vec<EF>,\n669\t    logup_tilde_evals: Vec<[EF; 2]>,\n670\t    needs_next_per_trace: Vec<bool>,\n671\t\n672\t    trace_interactions: Vec<Option<TraceInteractionMeta>>,\n673\t    // round0: Round0Buffers,\n674\t    pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n675\t\n676\t    // In round `j`, contains `s_{j-1}(r_{j-1})`\n677\t    pub(crate) prev_s_eval: EF,\n678\t    pub(crate) eq_ns: Vec<EF>,\n679\t    pub(crate) eq_sharp_ns: Vec<EF>,\n680\t\n681\t    mem: MemTracker,\n682\t    save_memory: bool,\n683\t\n684\t    gkr_mem_contribution: usize,\n685\t    /// Memory limit for batch MLE intermediate buffers (set after GKR input eval)\n686\t    memory_limit_bytes: usize,\n687\t}\n688\t\n689\timpl<'a, HS: GpuHashScheme> LogupZerocheckGpu<'a, HS> {\n690\t    #[allow(clippy::too_many_arguments)]\n691\t    fn new(\n692\t        pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n693\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n694\t        n_logup: usize,\n695\t        interactions_layout: StackedLayout,\n696\t        alpha_logup: EF,\n697\t        beta_logup: EF,\n698\t        save_memory: bool,\n699\t        monomial_num_y_threshold: u32,"}]},"parent_tool_use_id":"toolu_01KdYu8bXzQcWH4psQE7aXcU","session_id":"cb8ef42e-0257-49b2-9589-b530fe7ebc91","uuid":"b14644dc-0b2f-4326-9bef-4dc38b0d0231","timestamp":"2026-04-14T00:14:36.763Z"}
