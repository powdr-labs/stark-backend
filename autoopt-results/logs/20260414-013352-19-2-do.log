) * scale; 1 << l])\n}\n\n/// NTT-based polynomial multiplication\nfn poly_multiply_ntt(dft: &Radix2BowersSerial, a: &[EF], b: &[EF], min_size: usize) -> Vec<EF> {\n    let size = (a.len() + b.len() - 1).max(min_size).next_power_of_two();\n    let mut a_pad = a.to_vec();\n    a_pad.resize(size, EF::ZERO);\n    let mut b_pad = b.to_vec();\n    b_pad.resize(size, EF::ZERO);\n    let a_evals = dft.dft(a_pad);\n    let b_evals = dft.dft(b_pad);\n    let c_evals: Vec<EF> = a_evals\n        .into_iter()\n        .zip(b_evals)\n        .map(|(a, b)| a * b)\n        .collect();\n    dft.idft(c_evals)\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":7,"lines":[" use std::{array::from_fn, cmp::max, ffi::c_void, iter::zip, mem, sync::Arc};"," ","+use openvm_cuda_common::stream::current_stream_sync;","+"," use itertools::{zip_eq, Itertools};"," use openvm_cuda_common::{","     copy::{cuda_memcpy, MemCopyD2H, MemCopyH2D},"]}],"userModified":false,"replaceAll":false}}
