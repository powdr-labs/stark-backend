  FpExt *dst,\n635\t    const Fp *omega_skip_pows,\n636\t    const FpExt *inv_lagrange_denoms,\n637\t    uint32_t trace_height,\n638\t    uint32_t trace_width,\n639\t    uint32_t l_skip\n640\t) {\n641\t    uint32_t skip_domain = 1u << l_skip;\n642\t    uint32_t new_height = std::max(trace_height, skip_domain) / skip_domain;\n643\t\n644\t    // Block size: at least skip_domain, prefer 256 for occupancy\n645\t    uint32_t block_size = std::max(256u, skip_domain);\n646\t    uint32_t chunks_per_block = block_size / skip_domain;\n647\t\n648\t    // 2D grid: x-dim for rows, y-dim for columns\n649\t    dim3 grid(div_ceil(new_height, chunks_per_block), trace_width);\n650\t    dim3 block(block_size);\n651\t\n652\t    // Shared memory for cross-warp reduction (needed when skip_domain > 32)\n653\t    // Each warp in the block needs one FpExt slot for cross-warp reduction\n654\t    uint32_t total_warps_in_block = block_size / WARP_SIZE;\n655\t    size_t smem_bytes = (skip_domain > WARP_SIZE) ? total_warps_in_block * sizeof(FpExt) : 0;\n656\t\n657\t    stacked_reduction_fold_ple_kernel<<<grid, block, smem_bytes>>>(\n658\t        src, dst, omega_skip_pows, inv_lagrange_denoms, trace_height, new_height, skip_domain\n659\t    );\n660\t\n661\t    return CHECK_KERNEL();\n662\t}\n663\t\n664\textern \"C\" int _initialize_k_rot_from_eq_segments(\n665\t    const FpExt *eq_r_ns,\n666\t    FpExt *k_rot_ns,\n667\t    FpExt k_rot_uni_0,\n668\t    FpExt k_rot_uni_1,\n669\t    uint32_t max_n\n670\t) {\n671\t    auto [grid, block] = kernel_launch_params(1 << max_n);\n672\t    grid.y = max_n + 1;\n673\t\n674\t    initialize_k_rot_from_eq_segments_kernel<<<grid, block>>>(\n675\t        eq_r_ns, k_rot_ns, k_rot_uni_0, k_rot_uni_1\n676\t    );\n677\t\n678\t    return CHECK_KERNEL();\n679\t}\n680\t\n681\textern \"C\" int _stacked_reduction_sumcheck_mle_round(\n682\t    const FpExt *const *q_evals,\n683\t    const FpExt *eq_r_ns,\n684\t    const FpExt *k_rot_ns,\n685\t    const UnstackedSlice *unstac