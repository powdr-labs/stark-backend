{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017t8NDLohvCkxmMFXgto1qM","type":"tool_result","content":"550\t        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n551\t        if (threadIdx.x == 0) {\n552\t            sumcheck::atomic_add_fpext_to_u64(output + idx * 4, reduced);\n553\t        }\n554\t        __syncthreads();\n555\t    }\n556\t}\n557\t\n558\t// ============================================================================\n559\t// LAUNCHERS\n560\t// ============================================================================\n561\t\n562\tinline std::pair<dim3, dim3> stacked_reduction_round0_launch_params(\n563\t    uint32_t trace_height,\n564\t    uint32_t trace_width,\n565\t    uint32_t l_skip\n566\t) {\n567\t    uint32_t skip_domain = 1u << l_skip;\n568\t    auto lifted_height = std::max(trace_height, skip_domain);\n569\t    // Entire skip domain must fit within a block\n570\t    auto max_threads = std::max(skip_domain, 256u);\n571\t    auto [grid, block] = kernel_launch_params(lifted_height, max_threads);\n572\t    // NOTE: lifted_height = skip_domain * num_x will always be divisible by block.x since num_x is a power of 2. Therefore all threads in a block will be active.\n573\t    grid.y = trace_width;\n574\t    return {grid, block};\n575\t}\n576\t\n577\t// (Not a launcher) Utility function to calculate required size of temp buffer.\n578\t// Required length of *block_sums in FpExt elements\n579\t// SP_DEG=1: outputs NUM_G=3 values per z (G0, G1, G2)\n580\textern \"C\" uint32_t _stacked_reduction_r0_required_temp_buffer_size(\n581\t    uint32_t trace_height,\n582\t    uint32_t trace_width,\n583\t    uint32_t l_skip\n584\t) {\n585\t    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n586\t    return ((grid.x * grid.y) << l_skip) * NUM_G;\n587\t}\n588\t\n589\t// SP_DEG=1: No z_packets needed, outputs G0, G1, G2 on identity coset only.\n590\t// Uses ADD_TO