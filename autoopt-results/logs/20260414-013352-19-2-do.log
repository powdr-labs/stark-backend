{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ly6vQ23yorDLPWkaJmZkR5","type":"tool_result","content":"1\tuse std::{borrow::Cow, cell::Cell, ffi::c_void};\n2\t\n3\tuse crate::error::{check, CudaError};\n4\t\n5\t#[link(name = \"cudart\")]\n6\textern \"C\" {\n7\t    fn cudaDeviceSynchronize() -> i32;\n8\t    fn cudaStreamGetId(stream: cudaStream_t, id: *mut CudaStreamId) -> i32;\n9\t    fn cudaStreamCreate(stream: *mut cudaStream_t) -> i32;\n10\t    fn cudaStreamDestroy(stream: cudaStream_t) -> i32;\n11\t    fn cudaStreamSynchronize(stream: cudaStream_t) -> i32;\n12\t    fn cudaStreamWaitEvent(stream: cudaStream_t, event: cudaEvent_t, flags: u32) -> i32;\n13\t    fn cudaEventCreate(event: *mut cudaEvent_t) -> i32;\n14\t    fn cudaEventRecord(event: cudaEvent_t, stream: cudaStream_t) -> i32;\n15\t    fn cudaEventSynchronize(event: cudaEvent_t) -> i32;\n16\t    fn cudaEventQuery(event: cudaEvent_t) -> i32;\n17\t    fn cudaEventDestroy(event: cudaEvent_t) -> i32;\n18\t    fn cudaEventElapsedTime(ms: *mut f32, start: cudaEvent_t, end: cudaEvent_t) -> i32;\n19\t}\n20\t\n21\tpub fn device_synchronize() -> Result<(), CudaError> {\n22\t    check(unsafe { cudaDeviceSynchronize() })\n23\t}\n24\t\n25\t#[allow(non_camel_case_types)]\n26\tpub type cudaStream_t = *mut c_void;\n27\t\n28\tpub struct CudaStream {\n29\t    stream: cudaStream_t,\n30\t}\n31\t\n32\tunsafe impl Send for CudaStream {}\n33\tunsafe impl Sync for CudaStream {}\n34\t\n35\timpl CudaStream {\n36\t    /// Creates a new non-blocking CUDA stream.\n37\t    pub fn new() -> Result<Self, CudaError> {\n38\t        let mut stream: cudaStream_t = std::ptr::null_mut();\n39\t        check(unsafe { cudaStreamCreate(&mut stream) })?;\n40\t        Ok(Self { stream })\n41\t    }\n42\t\n43\t    /// Get the raw CUDA stream handle.\n44\t    #[inline]\n45\t    pub fn as_raw(&self) -> cudaStream_t {\n46\t        self.stream\n47\t    }\n48\t\n49\t    /// Synchronize this stream.\n50\t    pub fn synchronize(&self) -> Result<(), CudaError> {\n51\t        check(unsafe { cudaStreamSynchronize(self.stream) })\n52\t    }\n53\t\n54\t    /// Wait for the given event.\n55\t    pub fn wait(&self, event: &CudaEvent) -> Result<(), CudaError> {\n56\t        check(unsafe { cudaStreamWaitEvent(self.stream, event.event, 0) })\n57\t    }\n58\t}\n59\t\n60\timpl Drop for CudaStream {\n61\t    fn drop(&mut self) {\n62\t        if !self.stream.is_null() {\n63\t            self.synchronize().unwrap();\n64\t            let _ = unsafe { cudaStreamDestroy(self.stream) };\n65\t            self.stream = std::ptr::null_mut();\n66\t        }\n67\t    }\n68\t}\n69\t\n70\t#[allow(non_upper_case_globals)]\n71\tpub const cudaStreamPerThread: cudaStream_t = 0x02 as cudaStream_t;\n72\t\n73\tpub type CudaStreamId = u64;\n74\t\n75\tpub fn current_stream_id() -> Result<CudaStreamId, CudaError> {\n76\t    let mut id = 0;\n77\t    check(unsafe { cudaStreamGetId(cudaStreamPerThread, &mut id) })?;\n78\t    Ok(id)\n79\t}\n80\t\n81\tpub fn current_stream_sync() -> Result<(), CudaError> {\n82\t    check(unsafe { cudaStreamSynchronize(cudaStreamPerThread) })\n83\t}\n84\t\n85\tstruct CudaThreadCleanup {\n86\t    touched_cuda: Cell<bool>,\n87\t}\n88\t\n89\timpl CudaThreadCleanup {\n90\t    const fn new() -> Self {\n91\t        Self {\n92\t            touched_cuda: Cell::new(false),\n93\t        }\n94\t    }\n95\t\n96\t    fn mark_used(&self) {\n97\t        self.touched_cuda.set(true);\n98\t    }\n99\t}\n100\t\n101\timpl Drop for CudaThreadCleanup {\n102\t    fn drop(&mut self) {\n103\t        if self.touched_cuda.get() {\n104\t            // Best-effort drain of this thread's default stream before CUDA TLS teardown.\n105\t            // Avoid calling `check` here to prevent re-entering TLS tracking during drop.\n106\t            let _ = unsafe { cudaStreamSynchronize(cudaStreamPerThread) };\n107\t        }\n108\t    }\n109\t}\n110\t\n111\tthread_local! {\n112\t    static CUDA_THREAD_CLEANUP: CudaThreadCleanup = const { CudaThreadCleanup::new() };\n113\t}\n114\t\n115\tpub(crate) fn mark_cuda_thread_used() {\n116\t    CUDA_THREAD_CLEANUP.with(|cleanup| cleanup.mark_used());\n117\t}\n118\t\n119\t#[allow(non_camel_case_types)]\n120\tpub type cudaEvent_t = *mut c_void;\n121\t\n122\t#[derive(Debug)]\n123\tpub enum CudaEventStatus {\n124\t    Completed,\n125\t    NotReady,\n126\t    Error(CudaError),\n127\t}\n128\t\n129\timpl PartialEq for CudaEventStatus {\n130\t    fn eq(&self, other: &Self) -> bool {\n131\t        use CudaEventStatus::*;\n132\t        matches!((self, other), (Completed, Completed) | (NotReady, NotReady))\n133\t    }\n134\t}\n135\t\n136\timpl Eq for CudaEventStatus {}\n137\t\n138\timpl PartialOrd for CudaEventStatus {\n139\t    fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {\n140\t        Some(self.cmp(other))\n141\t    }\n142\t}\n143\t\n144\t// Completed < NotReady < Error\n145\timpl Ord for CudaEventStatus {\n146\t    fn cmp(&self, other: &Self) -> std::cmp::Ordering {\n147\t        use std::cmp::Ordering;\n148\t\n149\t        use CudaEventStatus::*;\n150\t\n151\t        match (self, other) {\n152\t            (Completed, Completed) => Ordering::Equal,\n153\t            (Completed, _) => Ordering::Less,\n154\t            (_, Completed) => Ordering::Greater,\n155\t            (NotReady, NotReady) => Ordering::Equal,\n156\t            (NotReady, Error(_)) => Ordering::Less,\n157\t            (Error(_), NotReady) => Ordering::Greater,\n158\t            (Error(_), Error(_)) => Ordering::Equal,\n159\t        }\n160\t    }\n161\t}\n162\t\n163\t#[derive(Debug, Clone)]\n164\tpub struct CudaEvent {\n165\t    event: cudaEvent_t,\n166\t}\n167\t\n168\tpub fn default_stream_wait(event: &CudaEvent) -> Result<(), CudaError> {\n169\t    check(unsafe { cudaStreamWaitEvent(cudaStreamPerThread, event.event, 0) })\n170\t}\n171\t\n172\tunsafe impl Send for CudaEvent {}\n173\tunsafe impl Sync for CudaEvent {}\n174\t\n175\timpl CudaEvent {\n176\t    pub fn new() -> Result<Self, CudaError> {\n177\t        let mut event: cudaEvent_t = std::ptr::null_mut();\n178\t        check(unsafe { cudaEventCreate(&mut event) })?;\n179\t        Ok(Self { event })\n180\t    }\n181\t\n182\t    /// # Safety\n183\t    /// The caller must ensure that `stream` is a valid stream.\n184\t    pub unsafe fn record(&self, stream: cudaStream_t) -> Result<(), CudaError> {\n185\t        check(cudaEventRecord(self.event, stream))\n186\t    }\n187\t\n188\t    pub fn record_on_this(&self) -> Result<(), CudaError> {\n189\t        check(unsafe { cudaEventRecord(self.event, cudaStreamPerThread) })\n190\t    }\n191\t\n192\t    pub fn synchronize(&self) -> Result<(), CudaError> {\n193\t        check(unsafe { cudaEventSynchronize(self.event) })\n194\t    }\n195\t\n196\t    /// # Safety\n197\t    /// The caller must ensure that `stream` is a valid stream.\n198\t    pub unsafe fn record_and_wait(&self, stream: cudaStream_t) -> Result<(), CudaError> {\n199\t        self.record(stream)?;\n200\t        check(cudaEventSynchronize(self.event))\n201\t    }\n202\t\n203\t    pub fn status(&self) -> CudaEventStatus {\n204\t        let status = unsafe { cudaEventQuery(self.event) };\n205\t        match status {\n206\t            0 => CudaEventStatus::Completed,  // CUDA_SUCCESS\n207\t            600 => CudaEventStatus::NotReady, // CUDA_ERROR_NOT_READY\n208\t            _ => CudaEventStatus::Error(CudaError::new(status)),\n209\t        }\n210\t    }\n211\t\n212\t    pub fn completed(&self) -> bool {\n213\t        self.status() == CudaEventStatus::Completed\n214\t    }\n215\t}\n216\t\n217\timpl Drop for CudaEvent {\n218\t    fn drop(&mut self) {\n219\t        unsafe { cudaEventDestroy(self.event) };\n220\t    }\n221\t}\n222\t\n223\t/// A GPU-aware span that collects a gauge metric using CUDA events.\n224\tpub fn gpu_metrics_span<R, F: FnOnce() -> R>(\n225\t    name: impl Into<Cow<'static, str>>,\n226\t    f: F,\n227\t) -> Result<R, CudaError> {\n228\t    let start = CudaEvent::new()?;\n229\t    let stop = CudaEvent::new()?;\n230\t    unsafe {\n231\t        check(cudaEventRecord(start.event, cudaStreamPerThread))?;\n232\t    }\n233\t    let res = f();\n234\t    unsafe { stop.record_and_wait(cudaStreamPerThread)? };\n235\t\n236\t    let mut elapsed_ms = 0f32;\n237\t    unsafe {\n238\t        check(cudaEventElapsedTime(\n239\t            &mut elapsed_ms,\n240\t            start.event,\n241\t            stop.event,\n242\t        ))?\n243\t    };\n244\t\n245\t    metrics::gauge!(name.into()).set(elapsed_ms as f64);\n246\t    Ok(res)\n247\t}\n248\t"}]},"parent_tool_use_id":"toolu_01KdYu8bXzQcWH4psQE7aXcU","session_id":"cb8ef42e-0257-49b2-9589-b530fe7ebc91","uuid":"f388942b-b20f-4afc-a724-4e4ba59b0e73","timestamp":"2026-04-14T00:14:34.302Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0144NbLstxqShqdREChdfW4K","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    sync::Arc,\n15\t};\n16\t\n17\tuse itertools::{izip, Itertools};\n18\tuse openvm_cuda_common::{\n19\t    copy::{MemCopyD2H, MemCopyD2HStreamSync, MemCopyH2D},\n20\t    d_buffer::DeviceBuffer,\n21\t    error::MemCopyError,\n22\t    memory_manager::MemTracker,\n23\t    stream::current_stream_sync,\n24\t};\n25\tuse openvm_stark_backend::{\n26\t    air_builders::symbolic::SymbolicConstraints,\n27\t    calculate_n_logup,\n28\t    dft::Radix2BowersSerial,\n29\t    p3_matrix::dense::RowMajorMatrix,\n30\t    poly_common::{\n31\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n32\t        UnivariatePoly,\n33\t    },\n34\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n35\t    prover::{\n36\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n37\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n38\t        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n39\t    },\n40\t};\n41\tuse p3_dft::TwoAdicSubgroupDft;\n42\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n43\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n44\tuse rustc_hash::FxHashMap;\n45\tuse tracing::{debug, info, info_span, instrument};\n46\t\n47\tuse crate::{\n48\t    base::DeviceMatrix,\n49\t    cuda::{\n50\t        logup_zerocheck::{\n51\t            batched_interpolate_columns_gpu, fold_selectors_round0, InterpColDesc, MainMatrixPtrs,\n52\t        },\n53\t        sumcheck::batch_fold_mle,\n54\t    },\n55\t    data_transporter::transport_matrix_d2h_col_major,\n56\t    error::LogupZerocheckError,\n57\t    gpu_backend::GenericGpuBackend,\n58\t    hash_scheme::GpuHashScheme,\n59\t    cuda::logup_zerocheck::{\n60\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n61\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n62\t    },\n63\t    logup_zerocheck::{\n64\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n65\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n66\t    },\n67\t    poly::EqEvalLayers,\n68\t    prelude::{EF, F},\n69\t    sponge::GpuFiatShamirTranscript,\n70\t    utils::compute_barycentric_inv_lagrange_denoms,\n71\t};\n72\t\n73\tpub(crate) mod batch_mle;\n74\tpub(crate) mod batch_mle_monomial;\n75\tmod errors;\n76\tpub(crate) mod fold_ple;\n77\t/// Fraction sumcheck via GKR\n78\tmod fractional;\n79\t/// Logup interaction evaluations for GKR input\n80\tmod gkr_input;\n81\tmod mle_round;\n82\tmod round0;\n83\tpub(crate) mod rules;\n84\t\n85\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n86\tuse batch_mle_monomial::{\n87\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n88\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n89\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n90\t};\n91\tpub use errors::*;\n92\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n93\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n94\tuse round0::evaluate_round0_constraints_gpu;\n95\t\n96\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n97\t/// More threads = more concurrent kernels but more peak GPU memory and more\n98\t/// MemoryManager mutex contention. 8 provides good SM utilization on the RTX 4090.\n99\tconst NUM_ROUND0_STREAMS: usize = 8;\n100\t\n101\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n102\t/// instead of the monomial kernel for high num_y traces.\n103\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n104\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n105\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n106\t\n107\t#[inline]\n108\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n109\t    if need_rot {\n110\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n111\t        (mat_width / 2) as u32\n112\t    } else {\n113\t        mat_width as u32\n114\t    }\n115\t}\n116\t\n117\t/// Result of processing one AIR in Round 0.\n118\tstruct Round0AirResult {\n119\t    trace_idx: usize,\n120\t    zerocheck_poly: Option<UnivariatePoly<EF>>,\n121\t    logup_numer_poly: Option<UnivariatePoly<EF>>,\n122\t    logup_denom_poly: Option<UnivariatePoly<EF>>,\n123\t}\n124\t\n125\t/// All read-only references needed to process one AIR in Round 0.\n126\tstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n127\t    trace_idx: usize,\n128\t    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n129\t    n: isize,\n130\t    selectors_cube: &'a DeviceMatrix<F>,\n131\t    public_values: &'a DeviceBuffer<F>,\n132\t    eq_3bs: &'a [EF],\n133\t    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n134\t    common_main: &'a DeviceMatrix<F>,\n135\t    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n136\t    d_lambda_pows: &'a DeviceBuffer<EF>,\n137\t    beta_pows: &'a [EF],\n138\t    l_skip: usize,\n139\t    constraint_degree: usize,\n140\t    xi: &'a [EF],\n141\t    max_temp_bytes: usize,\n142\t    /// Pre-computed zerocheck intermediates buffer capacity needed\n143\t    zc_intermed_cap: usize,\n144\t    /// Pre-computed zerocheck temp sums buffer capacity needed\n145\t    zc_temp_sums_cap: usize,\n146\t    /// Pre-computed logup intermediates buffer capacity needed\n147\t    logup_intermed_cap: usize,\n148\t    /// Pre-computed logup temp sums buffer capacity needed\n149\t    logup_temp_sums_cap: usize,\n150\t}\n151\t\n152\tfn process_air_round0<HS: GpuHashScheme>(\n153\t    w: &Round0AirWorkItem<HS>,\n154\t    bufs: &mut round0::Round0ThreadBuffers,\n155\t) -> Result<Round0AirResult, LogupZerocheckError> {\n156\t    let single_pk = w.single_pk;\n157\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n158\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n159\t    assert!(\n160\t        local_constraint_deg <= w.constraint_degree,\n161\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n162\t        w.constraint_degree\n163\t    );\n164\t\n165\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n166\t    let omega_root = F::two_adic_generator(log_large_domain);\n167\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n168\t\n169\t    let height = w.common_main.height();\n170\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n171\t    for committed in w.cached_mains {\n172\t        main_parts.push(committed.trace.buffer().as_ptr());\n173\t    }\n174\t    main_parts.push(w.common_main.buffer().as_ptr());\n175\t    let d_main_parts = main_parts.to_device()?;\n176\t\n177\t    let n_lift = w.n.max(0) as usize;\n178\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n179\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n180\t\n181\t    // Check if pre-allocated zerocheck buffers are large enough for this AIR\n182\t    let zc_prealloc_inter = if w.zc_intermed_cap > 0\n183\t        && bufs.zc_intermediates.len() >= w.zc_intermed_cap\n184\t    {\n185\t        Some(&mut bufs.zc_intermediates)\n186\t    } else {\n187\t        None\n188\t    };\n189\t    let zc_prealloc_temp = if w.zc_temp_sums_cap > 0\n190\t        && bufs.zc_temp_sums.len() >= w.zc_temp_sums_cap\n191\t    {\n192\t        Some(&mut bufs.zc_temp_sums)\n193\t    } else {\n194\t        None\n195\t    };\n196\t\n197\t    let sum_buffer = evaluate_round0_constraints_gpu(\n198\t        single_pk,\n199\t        w.selectors_cube.buffer(),\n200\t        &d_main_parts,\n201\t        w.public_values,\n202\t        eq_xi_tree.get_ptr(n_lift),\n203\t        w.d_lambda_pows,\n204\t        1 << w.l_skip,\n205\t        1 << n_lift,\n206\t        height as u32,\n207\t        num_cosets_zc as u32,\n208\t        omega_root,\n209\t        w.max_temp_bytes,\n210\t        zc_prealloc_inter,\n211\t        zc_prealloc_temp,\n212\t    )?;\n213\t\n214\t    let zerocheck_poly = if !sum_buffer.is_empty() {\n215\t        let q_evals = sum_buffer.to_host_on_current_stream()?;\n216\t        let q = {\n217\t            let mut values = EF::zero_vec(num_cosets_zc << w.l_skip);\n218\t            for coset_idx in 0..num_cosets_zc {\n219\t                for i in 0..1 << w.l_skip {\n220\t                    values[i * num_cosets_zc + coset_idx] = q_evals[(coset_idx << w.l_skip) + i];\n221\t                }\n222\t            }\n223\t            UnivariatePoly::from_geometric_cosets_evals_idft(\n224\t                RowMajorMatrix::new(values, num_cosets_zc),\n225\t                omega_root,\n226\t                omega_root,\n227\t            )\n228\t        };\n229\t        let sp_0_deg = sumcheck_round0_deg(w.l_skip, local_constraint_deg);\n230\t        let coeffs = (0..=sp_0_deg)\n231\t            .map(|i| {\n232\t                let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n233\t                if i >= 1 << w.l_skip {\n234\t                    c += q.coeffs()[i - (1 << w.l_skip)];\n235\t                }\n236\t                c\n237\t            })\n238\t            .collect_vec();\n239\t        Some(UnivariatePoly::new(coeffs))\n240\t    } else {\n241\t        None\n242\t    };\n243\t\n244\t    let num_cosets_logup = local_constraint_deg;\n245\t\n246\t    // Check if pre-allocated logup buffers are large enough for this AIR\n247\t    let logup_prealloc_inter = if w.logup_intermed_cap > 0\n248\t        && bufs.logup_intermediates.len() >= w.logup_intermed_cap\n249\t    {\n250\t        Some(&mut bufs.logup_intermediates)\n251\t    } else {\n252\t        None\n253\t    };\n254\t    let logup_prealloc_temp = if w.logup_temp_sums_cap > 0\n255\t        && bufs.logup_temp_sums.len() >= w.logup_temp_sums_cap\n256\t    {\n257\t        Some(&mut bufs.logup_temp_sums)\n258\t    } else {\n259\t        None\n260\t    };\n261\t\n262\t    let sum = evaluate_round0_interactions_gpu(\n263\t        single_pk,\n264\t        &single_air_constraints,\n265\t        w.selectors_cube.buffer(),\n266\t        &d_main_parts,\n267\t        w.public_values,\n268\t        eq_xi_tree.get_ptr(n_lift),\n269\t        w.beta_pows,\n270\t        w.eq_3bs,\n271\t        1 << w.l_skip,\n272\t        1 << n_lift,\n273\t        height as u32,\n274\t        num_cosets_logup as u32,\n275\t        omega_root,\n276\t        w.max_temp_bytes,\n277\t        logup_prealloc_inter,\n278\t        logup_prealloc_temp,\n279\t    )?;\n280\t\n281\t    let (logup_numer_poly, logup_denom_poly) = if !sum.is_empty() {\n282\t        let evals = sum.to_host_on_current_stream()?;\n283\t        let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n284\t            evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n285\t        if w.n.is_negative() {\n286\t            let norm_factor = F::from_u32(1 << w.n.unsigned_abs()).inverse();\n287\t            for s