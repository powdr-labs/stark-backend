{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RsVp2RukakTH5skqtdhh74","type":"tool_result","content":"1\tuse openvm_cuda_common::{\n2\t    d_buffer::DeviceBuffer,\n3\t    error::{check, CudaError},\n4\t};\n5\t\n6\tuse crate::{\n7\t    poly::EqEvalSegments,\n8\t    prelude::{D_EF, EF, F},\n9\t    stacked_reduction::{UnstackedSlice, STACKED_REDUCTION_S_DEG},\n10\t};\n11\t\n12\t/// Descriptor for batched degenerate MLE round kernel. Layout must match CUDA `DegenMleDesc`.\n13\t#[repr(C)]\n14\t#[derive(Clone, Copy)]\n15\tpub(crate) struct DegenMleDesc {\n16\t    pub col_offset: u32,\n17\t    pub window_len: u32,\n18\t    pub eq_r: EF,\n19\t    pub k_rot_r: EF,\n20\t}\n21\t\n22\t/// Descriptor for batched non-degenerate MLE round kernel. Layout must match CUDA `NonDegenMleDesc`.\n23\t#[repr(C)]\n24\t#[derive(Clone, Copy)]\n25\tpub(crate) struct NonDegenMleDesc {\n26\t    pub col_offset: u32,\n27\t    pub window_len: u32,\n28\t    pub num_y: u32,\n29\t    pub stride: u32,\n30\t    pub blocks_x: u32,\n31\t}\n32\t\n33\t/// Number of G outputs per z in round 0: G0, G1, G2\n34\tpub const NUM_G: usize = 3;\n35\t\n36\textern \"C\" {\n37\t    pub fn _stacked_reduction_r0_required_temp_buffer_size(\n38\t        trace_height: u32,\n39\t        trace_width: u32,\n40\t        l_skip: u32,\n41\t    ) -> u32;\n42\t\n43\t    // SP_DEG=1: no z_packets needed, outputs [NUM_G * skip_domain] to be ADDed\n44\t    fn _stacked_reduction_sumcheck_round0(\n45\t        eq_r_ns: *const EF,\n46\t        trace_ptr: *const F,\n47\t        lambda_pows: *const EF,\n48\t        block_sums: *mut EF,\n49\t        output: *mut EF,\n50\t        trace_height: u32,\n51\t        trace_width: u32,\n52\t        l_skip: u32,\n53\t        num_x: u32,\n54\t    ) -> i32;\n55\t\n56\t    fn _stacked_reduction_fold_ple(\n57\t        src: *const F,\n58\t        dst: *mut EF,\n59\t        omega_skip_pows: *const F,\n60\t        inv_lagrange_denoms: *const EF,\n61\t        trace_height: u32,\n62\t        trace_width: u32,\n63\t        l_skip: u32,\n64\t    ) -> i32;\n65\t\n66\t    fn _initialize_k_rot_from_eq_segments(\n67\t        eq_r_ns: *const EF,\n68\t        k_rot_ns: *mut EF,\n69\t        k_rot_uni_0: EF,\n70\t        k_rot_uni_1: EF,\n71\t        max_n: u32,\n72\t    ) -> i32;\n73\t\n74\t    fn _stacked_reduction_sumcheck_mle_round(\n75\t        q_evals: *const *const EF,\n76\t        eq_r_ns: *const EF,\n77\t        k_rot_ns: *const EF,\n78\t        unstacked_cols: *const UnstackedSlice,\n79\t        lambda_pows: *const EF,\n80\t        output: *mut u64, // atomic accumulator [S_DEG * D_EF]\n81\t        q_height: u32,\n82\t        window_len: u32,\n83\t        num_y: u32,\n84\t        sm_count: u32,\n85\t    ) -> i32;\n86\t\n87\t    fn _stacked_reduction_sumcheck_mle_round_degenerate(\n88\t        q_evals: *const *const EF,\n89\t        eq_ub_ptr: *const EF,\n90\t        eq_r: EF,\n91\t        k_rot_r: EF,\n92\t        unstacked_cols: *const UnstackedSlice,\n93\t        lambda_pows: *const EF,\n94\t        output: *mut u64, // atomic accumulator [S_DEG * D_EF]\n95\t        q_height: u32,\n96\t        window_len: u32,\n97\t        l_skip: u32,\n98\t        round: u32,\n99\t    ) -> i32;\n100\t\n101\t    fn _batched_stacked_reduction_sumcheck_mle_round_degenerate(\n102\t        descs: *const DegenMleDesc,\n103\t        num_descs: u32,\n104\t        q_evals: *const *const EF,\n105\t        eq_ub_base: *const EF,\n106\t        unstacked_cols_base: *const UnstackedSlice,\n107\t        lambda_pows_base: *const EF,\n108\t        output: *mut u64,\n109\t        q_height: u32,\n110\t        shift_factor: u32,\n111\t    ) -> i32;\n112\t\n113\t    fn _batched_stacked_reduction_sumcheck_mle_round(\n114\t        descs: *const NonDegenMleDesc,\n115\t        block_prefix_sums: *const u32,\n116\t        num_descs: u32,\n117\t        total_blocks: u32,\n118\t        q_evals: *const *const EF,\n119\t        eq_r_ns: *const EF,\n120\t        k_rot_ns: *const EF,\n121\t        unstacked_cols_base: *const UnstackedSlice,\n122\t        lambda_pows_base: *const EF,\n123\t        output: *mut u64,\n124\t        q_height: u32,\n125\t    ) -> i32;\n126\t}\n127\t\n128\t/// SP_DEG=1 round 0 kernel: computes G0, G1, G2 partial sums on identity coset only.\n129\t///\n130\t/// This kernel computes three partial sums per z-coordinate:\n131\t/// - G0(Z) = Σ_{col,x} coeff_eq[col] * eq_cube(x) * q_{col,x}(Z)\n132\t/// - G1(Z) = Σ_{col,x} coeff_rot[col] * eq_cube(x) * q_{col,x}(Z)\n133\t/// - G2(Z) = Σ_{col,x} coeff_rot[col] * (eq_cube(rot_prev(x)) - eq_cube(x)) * q_{col,x}(Z)\n134\t///\n135\t/// The reconstruction s₀(Z) = E0(Z)*G0(Z) + E1(Z)*G1(Z) + E2(Z)*G2(Z) happens on CPU.\n136\t///\n137\t/// The reduction is done in two stages:\n138\t/// 1. Block-level reduction to `block_sums` (shared memory within block)\n139\t/// 2. Final reduction kernel that ADDs block sums into `output` (for bucket accumulation)\n140\t///\n141\t/// # Safety\n142\t/// - `trace_ptr` must be a pointer to a device buffer valid for `height * width` elements.\n143\t/// - `lambda_pows` should be pointer to DeviceBuffer<EF>, at an offset.\n144\t///   - `lambda_pows` must be initialized for at least `2 * window_len` elements (for rotations).\n145\t/// - `block_sums` should have length `>= _stacked_reduction_r0_required_temp_buffer_size(...)`.\n146\t/// - `output` should have length `>= NUM_G * 2^l_skip` and be zero-initialized before first call.\n147\t///   Values are ADDED to output for bucket-based accumulation.\n148\t#[allow(clippy::too_many_arguments)]\n149\tpub unsafe fn stacked_reduction_sumcheck_round0(\n150\t    eq_r_ns: &EqEvalSegments<EF>,\n151\t    trace_ptr: *const F,\n152\t    lambda_pows: *const EF,\n153\t    block_sums: &mut DeviceBuffer<EF>,\n154\t    output: &mut DeviceBuffer<EF>,\n155\t    height: usize,\n156\t    width: usize,\n157\t    l_skip: usize,\n158\t) -> Result<(), CudaError> {\n159\t    let output_size = NUM_G << l_skip;\n160\t    let num_x = (height >> l_skip).max(1) as u32;\n161\t    debug_assert!(output.len() >= output_size);\n162\t\n163\t    check(_stacked_reduction_sumcheck_round0(\n164\t        eq_r_ns.buffer().as_ptr(),\n165\t        trace_ptr,\n166\t        lambda_pows,\n167\t        block_sums.as_mut_ptr(),\n168\t        output.as_mut_ptr(),\n169\t        height as u32,\n170\t        width as u32,\n171\t        l_skip as u32,\n172\t        num_x,\n173\t    ))\n174\t}\n175\t\n176\t/// Parallelizes barycentric interpolation across `2^l_skip` threads per cell.\n177\t///\n178\t/// Each kernel launch handles one trace. The caller should loop over traces and call this for each.\n179\t///\n180\t/// # Safety\n181\t/// - `src` must be a device pointer valid for `trace_height * trace_width` Fp elements.\n182\t/// - `dst` must be a device pointer valid for `new_height * trace_width` FpExt elements, where\n183\t///   `new_height = max(trace_height, 2^l_skip) / 2^l_skip`.\n184\t/// - `src` and `dst` memory regions must not overlap.\n185\t/// - `omega_skip_pows` must have length `>= 2^l_skip`.\n186\t/// - `inv_lagrange_denoms` must have length `>= 2^l_skip`.\n187\t/// - `l_skip` must be in range [0, 10] (skip_domain = 2^l_skip must be in [1, 1024]).\n188\t#[allow(clippy::too_many_arguments)]\n189\tpub unsafe fn stacked_reduction_fold_ple(\n190\t    src: *const F,\n191\t    dst: *mut EF,\n192\t    omega_skip_pows: &DeviceBuffer<F>,\n193\t    inv_lagrange_denoms: &DeviceBuffer<EF>,\n194\t    trace_height: usize,\n195\t    trace_width: usize,\n196\t    l_skip: usize,\n197\t) -> Result<(), CudaError> {\n198\t    let skip_domain = 1 << l_skip;\n199\t    debug_assert!(omega_skip_pows.len() >= skip_domain);\n200\t    debug_assert!(inv_lagrange_denoms.len() >= skip_domain);\n201\t    check(_stacked_reduction_fold_ple(\n202\t        src,\n203\t        dst,\n204\t        omega_skip_pows.as_ptr(),\n205\t        inv_lagrange_denoms.as_ptr(),\n206\t        trace_height as u32,\n207\t        trace_width as u32,\n208\t        l_skip as u32,\n209\t    ))\n210\t}\n211\t\n212\t/// Initializes the `k_rot` evaluations after round 0 for `n = 0..=max_n`.\n213\t///\n214\t/// # Safety\n215\t/// - `eq_r_ns` and `k_rot_ns` should both have length `2 * 2^max_n` and be arranged in segments.\n216\t/// - This function will not initialize `k_rot_ns[0]`. This entry should never be used, and it is\n217\t///   the caller's responsibility to initialize it if needed.\n218\tpub unsafe fn initialize_k_rot_from_eq_segments(\n219\t    eq_r_ns: &EqEvalSegments<EF>,\n220\t    k_rot_ns: &mut DeviceBuffer<EF>,\n221\t    k_rot_uni_0: EF,\n222\t    k_rot_uni_1: EF,\n223\t    max_n: u32,\n224\t) -> Result<(), CudaError> {\n225\t    debug_assert_eq!(eq_r_ns.buffer.len(), 2 << max_n);\n226\t    debug_assert_eq!(k_rot_ns.len(), eq_r_ns.buffer.len());\n227\t\n228\t    check(_initialize_k_rot_from_eq_segments(\n229\t        eq_r_ns.buffer.as_ptr(),\n230\t        k_rot_ns.as_mut_ptr(),\n231\t        k_rot_uni_0,\n232\t        k_rot_uni_1,\n233\t        max_n,\n234\t    ))\n235\t}\n236\t\n237\t/// Analog of [stacked_reduction_sumcheck_round0] for MLE sumcheck rounds.\n238\t/// One important distinction is that `k_rot_ns` needs to be provided separately from `eq_r_ns`, but\n239\t/// in the same segmented memory layout.\n240\t///\n241\t/// Uses warp-aggregated atomics for reduction into u64 accumulators. The caller is responsible for\n242\t/// zero-initializing `output` before calling and reducing modulo P after kernel completion.\n243\t///\n244\t/// # Safety\n245\t/// - `q_evals` must be pointers to DeviceBuffer<EF> matrices all of the same height `q_height`.\n246\t/// - `unstacked_cols` should be pointer to DeviceBuffer<UnstackedSlice>, at an offset.\n247\t///   - `unstacked_cols` must be initialized for at least `window_len` elements.\n248\t///   - for each `UnstackedSlice` in the `window_len` elements starting at `unstacked_cols`, the\n249\t///     `log_height` must all be the same and the `stacked_row_idx` must be a multiple of\n250\t///     `2^l_skip`.\n251\t/// - `lambda_pows` should be pointer to DeviceBuffer<EF>, at an offset.\n252\t///   - `lambda_pows` must be initialized for at least `2 * window_len` elements (for rotations).\n253\t/// - `unstacked_cols` pointers must be within bounds of `q_evals`.\n254\t/// - `output` must have length at least `S_DEG * D_EF = 8` and be zero-initialized.\n255\t#[allow(clippy::too_many_arguments)]\n256\tpub unsafe fn stacked_reduction_sumcheck_mle_round(\n257\t    q_evals: &DeviceBuffer<*const EF>,\n258\t    eq_r_ns: &EqEvalSegments<EF>,\n259\t    k_rot_ns: &EqEvalSegments<EF>,\n260\t    unstacked_cols: *const UnstackedSlice,\n261\t    lambda_pows: *const EF,\n262\t    output: &mut DeviceBuffer<u64>,\n263\t    q_height: usize,\n264\t    window_len: usize,\n265\t    num_y: usize,\n266\t    sm_count: u32,\n267\t) -> Result<(), CudaError> {\n268\t    debug_assert!(output.len() >= STACKED_REDUCTION_S_DEG * D_EF);\n269\t\n270\t    check(_stacked_reduction_sumcheck_mle_round(\n271\t        q_evals.as_ptr(),\n272\t        eq_r_ns.buffer.as_ptr(),\n273\t        k_rot_ns.buffer.as_ptr(),\n274\t        unstacked_cols,\n275\t        lambda_pows,\n276\t        output.as_mut_ptr(),\n277\t        q_height as u32,\n278\t        window_len as u32,\n279\t        num_y as u32,\n280\t        sm_count,\n281\t    ))\n282\t}\n283\t\n284\t/// Degenerate case for MLE sumcheck rounds.\n285\t///\n286\t/// Uses warp-aggregated atomics for reduction into u64 accumulators. The caller is responsible for\n287\t/// zero-initializing `output` before calling and reducing modulo P after kernel completion.\n288\t///\n289\t/// # Safety\n290\t/// - `output` must have length at least `S_DEG * D_EF = 8` and be zero-initialized.\n291\t#[allow(clippy::too_many_arguments)]\n292\tpub unsafe fn stacked_reduction_sumcheck_mle_round_degenerate(\n293\t    q_evals: &DeviceBuffer<*const EF>,\n294\t    eq_ub_ptr: *const EF,\n295\t    eq_r: EF,\n296\t    k_rot_r: EF,\n297\t    unstacked_cols: *const UnstackedSlice,\n298\t    lambda_pows: *const EF,\n299\t    output: &mut DeviceBuffer<u64>,\n300\t    q_height: usize,\n301\t    window_len: usize,\n302\t    l_skip: usize,\n303\t    round: usize,\n304\t) -> Result<(), CudaError> {\n305\t    debug_assert!(output.len() >= STACKED_REDUCTION_S_DEG * D_EF);\n306\t\n307\t    check(_stacked_reduction_sumcheck_mle_round_degenerate(\n308\t        q_evals.as_ptr(),\n309\t        eq_ub_ptr,\n310\t        eq_r,\n311\t        k_rot_r,\n312\t        unstacked_cols,\n313\t        lambda_pows,\n314\t        output.as_mut_ptr(),\n315\t        q_height as u32,\n316\t        window_len as u32,\n317\t        l_skip as u32,\n318\t        round as u32,\n319\t    ))\n320\t}\n321\t\n322\t/// Batched degenerate MLE round: launches one block per descriptor.\n323\t///\n324\t/// # Safety\n325\t/// - `d_descs` must contain valid descriptors with col_offsets within bounds of the shared arrays.\n326\t/// - `output` must have length at least `S_DEG * D_EF = 8` and be zero-initialized.\n327\t#[allow(clippy::too_many_arguments)]\n328\tpub unsafe fn batched_stacked_reduction_sumcheck_mle_round_degenerate(\n329\t    d_descs: &DeviceBuffer<DegenMleDesc>,\n330\t    q_evals: &DeviceBuffer<*const EF>,\n331\t    eq_ub_base: *const EF,\n332\t    unstacked_cols_base: *const UnstackedSlice,\n333\t    lambda_pows_base: *const EF,\n334\t    output: &mut DeviceBuffer<u64>,\n335\t    q_height: usize,\n336\t    shift_factor: u32,\n337\t) -> Result<(), CudaError> {\n338\t    debug_assert!(output.len() >= STACKED_REDUCTION_S_DEG * D_EF);\n339\t\n340\t    check(_batched_stacked_reduction_sumcheck_mle_round_degenerate(\n341\t        d_descs.as_ptr(),\n342\t        d_descs.len() as u32,\n343\t        q_evals.as_ptr(),\n344\t        eq_ub_base,\n345\t        unstacked_cols_base,\n346\t        lambda_pows_base,\n347\t        output.as_mut_ptr(),\n348\t        q_height as u32,\n349\t        shift_factor,\n350\t    ))\n351\t}\n352\t\n353\t/// Batched non-degenerate MLE round: maps blocks to AIRs via prefix sums.\n354\t///\n355\t/// # Safety\n356\t/// - `d_descs` and `d_block_offsets` must contain valid descriptor/prefix sum data.\n357\t/// - `output` must have length at least `S_DEG * D_EF = 8` and be zero-initialized.\n358\t#[allow(clippy::too_many_arguments)]\n359\tpub unsafe fn batched_stacked_reduction_sumcheck_mle_round(\n360\t    d_descs: &DeviceBuffer<NonDegenMleDesc>,\n361\t    d_block_offsets: &DeviceBuffer<u32>,\n362\t    total_blocks: u32,\n363\t    q_evals: &DeviceBuffer<*const EF>,\n364\t    eq_r_ns: &EqEvalSegments<EF>,\n365\t    k_rot_ns: &EqEvalSegments<EF>,\n366\t    unstacked_cols_base: *const UnstackedSlice,\n367\t    lambda_pows_base: *const EF,\n368\t    output: &mut DeviceBuffer<u64>,\n369\t    q_height: usize,\n370\t) -> Result<(), CudaError> {\n371\t    debug_assert!(output.len() >= STACKED_REDUCTION_S_DEG * D_EF);\n372\t\n373\t    check(_batched_stacked_reduction_sumcheck_mle_round(\n374\t        d_descs.as_ptr(),\n375\t        d_block_offsets.as_ptr(),\n376\t        d_descs.len() as u32,\n377\t        total_blocks,\n378\t        q_evals.as_ptr(),\n379\t        eq_r_ns.buffer.as_ptr(),\n380\t        k_rot_ns.buffer.as_ptr(),\n381\t        unstacked_cols_base,\n382\t        lambda_pows_base,\n383\t        output.as_mut_ptr(),\n384\t        q_height as u32,\n385\t    ))\n386\t}\n387\t\n388\tconst MAX_GRID_DIM: u32 = 65535;\n389\tconst WAVES_TARGET: u32 = 4;\n390\tconst ITERS_MIN: u32 = 4;\n391\tconst ITERS_MAX: u32 = 16;\n392\t\n393\t/// Replicates the stride auto-tuning from `_stacked_reduction_sumcheck_mle_round`.\n394\t/// Returns `(blocks_x, stride)` matching the CUDA-side grid dimensions.\n395\tpub(crate) fn compute_mle_launch_params(num_y: u32, window_len: u32, sm_count: u32) -> (u32, u32) {\n396\t    let blocks_x = num_y.div_ceil(256);\n397\t\n398\t    let stride_occ = (sm_count * WAVES_TARGET).div_ceil(blocks_x);\n399\t    let stride_loop_lo = window_len.div_ceil(ITERS_MAX);\n400\t    let stride_loop_hi = window_len.div_ceil(ITERS_MIN);\n401\t\n402\t    let lo = 1.max(stride_occ.max(stride_loop_lo));\n403\t    let hi = window_len.min(MAX_GRID_DIM).min(stride_loop_hi);\n404\t\n405\t    let stride = if lo <= hi {\n406\t        lo\n407\t    } else {\n408\t        lo.min(window_len.min(MAX_GRID_DIM))\n409\t    };\n410\t\n411\t    (blocks_x, stride)\n412\t}\n413\t"}]},"parent_tool_use_id":null,"session_id":"cb8ef42e-0257-49b2-9589-b530fe7ebc91","uuid":"adac7f80-4e34-433d-8464-e6d6c9393f26","timestamp":"2026-04-14T00:15:31.906Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/cuda/stacked_reduction.rs","content":"use openvm_cuda_common::{\n    d_buffer::DeviceBuffer,\n    error::{check, CudaError},\n};\n\nuse crate::{\n    poly::EqEvalSegments,\n    prelude::{D_EF, EF, F},\n    stacked_reduction::{UnstackedSlice, STACKED_REDUCTION_S_DEG},\n};\n\n/// Descriptor for batched degenerate MLE round kernel. Layout must match CUDA `DegenMleDesc`.\n#[repr(C)]\n#[derive(Clone, Copy)]\npub(crate) struct DegenMleDesc {\n    pub col_offset: u32,\n    pub window_len: u32,\n    pub eq_r: EF,\n    pub k_rot_r: EF,\n}\n\n/// Descriptor for batched non-degenerate MLE round kernel. Layout must match CUDA `NonDegenMleDesc`.\n#[repr(C)]\n#[derive(Clone, Copy)]\npub(crate) struct NonDegenMleDesc {\n    pub col_offset: u32,\n    pub window_len: u32,\n    pub num_y: u32,\n    pub stride: u32,\n    pub blocks_x: u32,\n}\n\n/// Number of G outputs per z in round 0: G0, G1, G2\npub const NUM_G: usize = 3;\n\nextern \"C\" {\n    pub fn _stacked_reduction_r0_required_temp_buffer_size(\n        trace_height: u32,\n        trace_width: u32,\n        l_skip: u32,\n    ) -> u32;\n\n    // SP_DEG=1: no z_packets needed, outputs [NUM_G * skip_domain] to be ADDed\n    fn _stacked_reduction_sumcheck_round0(\n        eq_r_ns: *const EF,\n        trace_ptr: *const F,\n        lambda_pows: *const EF,\n        block_sums: *mut EF,\n        output: *mut EF,\n        trace_height: u32,\n        trace_width: u32,\n        l_skip: u32,\n        num_x: u32,\n    ) -> i32;\n\n    fn _stacked_reduction_fold_ple(\n        src: *const F,\n        dst: *mut EF,\n        omega_skip_pows: *const F,\n        inv_lagrange_denoms: *const EF,\n        trace_height: u32,\n        trace_width: u32,\n        l_skip: u32,\n    ) -> i32;\n\n    fn _initialize_k_rot_from_eq_segments(\n        eq_r_ns: *const EF,\n        k_rot_ns: *mut EF,\n        k_rot_uni_0: EF,\n        k_rot_uni_1: EF,\n        max_n: u32,\n    ) -> i32;\n\n    fn _stacked_reduction_sumcheck_mle_round(\n        q_evals: *const *const EF,\n        eq_r_ns: *const EF,\n        k_rot_ns: *const EF,\n        unstacked_cols: *const UnstackedSlice,\n        lambda_pows: *const EF,\n        output: *mut u64, // atomic accumulator [S_DEG * D_EF]\n        q_height: u32,\n        window_len: u32,\n        num_y: u32,\n        sm_count: u32,\n    ) -> i32;\n\n    fn _stacked_reduction_sumcheck_mle_round_degenerate(\n        q_evals: *const *const EF,\n        eq_ub_ptr: *const EF,\n        eq_r: EF,\n        k_rot_r: EF,\n        unstacked_cols: *const UnstackedSlice,\n        lambda_pows: *const EF,\n        output: *mut u64, // atomic accumulator [S_DEG * D_EF]\n        q_height: u32,\n        window_len: u32,\n        l_skip: u32,\n        round: u32,\n    ) -> i32;\n\n    fn _batched_stacked_reduction_sumcheck_mle_round_degenerate(\n        descs: *const DegenMleDesc,\n        num_descs: u32,\n        q_evals: *const *const EF,\n        eq_ub_base: *const EF,\n        unstacked_cols_base: *const UnstackedSlice,\n        lambda_pows_base: *const EF,\n        output: *mut u64,\n        q_height: u32,\n        shift_factor: u32,\n    ) -> i32;\n\n    fn _batched_stacked_reduction_sumcheck_mle_round(\n        descs: *const NonDegenMleDesc,\n        block_prefix_sums: *const u32,\n        num_descs: u32,\n        total_blocks: u32,\n        q_evals: *const *const EF,\n        eq_r_ns: *const EF,\n        k_rot_ns: *const EF,\n        unstacked_cols_base: *const UnstackedSlice,\n        lambda_pows_base: *const EF,\n        output: *mut u64,\n        q_height: u32,\n    ) -> i32;\n}\n\n/// SP_DEG=1 round 0 kernel: computes G0, G1, G2 partial sums on identity coset only.\n///\n/// This kernel computes three partial sums per z-coordinate:\n/// - G0(Z) = Σ_{col,x} coeff_eq[col] * eq_cube(x) * q_{col,x}(Z)\n/// - G1(Z) = Σ_{col,x} coeff_rot[col] * eq_cube(x) * q_{col,x}(Z)\n/// - G2(Z) = Σ_{col,x} coeff_rot[col] * (eq_cube(rot_prev(x)) - eq_cube(x)) * q_{col,x}(Z)\n///\n/// The reconstruction s₀(Z) = E0(Z)*G0(Z) + E1(Z)*G1(Z) + E2(Z)*G2(Z) happens on CPU.\n///\n/// The reduction is done in two stages:\n/// 1. Block-level reduction to `block_sums` (shared memory within block)\n/// 2. Final reduction kernel that ADDs block sums into `output` (for bucket accumulation)\n///\n/// # Safety\n/// - `trace_ptr` must be a pointer to a device buffer valid for `height * width` elements.\n/// - `lambda_pows` should be pointer to DeviceBuffer<EF>, at an offset.\n///   - `lambda_pows` must be initialized for at least `2 * window_len` elements (for rotations).\n/// - `block_sums` should have length `>= _stacked_reduction_r0_required_temp_buffer_size(...)`.\n/// - `output` should have length `>= NUM_G * 2^l_skip` and be zero-initialized before first call.\n///   Values are ADDED to output for bucket-based accumulation.\n#[allow(clippy::too_many_arguments)]\npub unsafe fn stacked_reduction_sumcheck_round0(\n    eq_r_ns: &EqEvalSegments<EF>,\n    trace_ptr: *const F,\n    lambda_pows: *const EF,\n    block_sums: &mut DeviceBuffer<EF>,\n    output: &mut DeviceBuffer<EF>,\n    height: usize,\n    width: usize,\n    l_skip: usize,\n) -> Result<(), CudaError> {\n    let output_size = NUM_G << l_skip;\n    let num_x = (height >> l_skip).max(1) as u32;\n    debug_assert!(output.len() >= output_size);\n\n    check(_stacked_reduction_sumcheck_round0(\n        eq_r_ns.buffer().as_ptr(),\n        trace_ptr,\n        lambda_pows,\n        block_sums.as_mut_ptr(),\n        output.as_mut_ptr(),\n        height as u32,\n        width as u32,\n        l_skip as u32,\n        num_x,\n    ))\n}\n\n/// Parallelizes barycentric interpolation across `2^l_skip` threads per cell.\n///\n/// Each kernel launch handles one trace. The caller should loop over traces and call this for each.\n///\n/// # Safety\n/// - `src` must be a device pointer valid for `trace_height * trace_width` Fp elements.\n/// - `dst` must be a device pointer valid for `new_height * trace_width` FpExt elements, where\n///   `new_height = max(trace_height, 2^l_skip) / 2^l_skip`.\n/// - `src` and `dst` memory regions must not overlap.\n/// - `omega_skip_pows` must have length `>= 2^l_skip`.\n/// - `inv_lagrange_denoms` must have length `>= 2^l_skip`.\n/// - `l_skip` must be in range [0, 10] (skip_domain = 2^l_skip must be in [1, 1024]).\n#[allow(clippy::too_many_arguments)]\npub unsafe fn stacked_reduction_fold_ple(\n    src: *const F,\n    dst: *mut EF,\n    omega_skip_pows: &DeviceBuffer<F>,\n    inv_lagrange_denoms: &DeviceBuffer<EF>,\n    trace_height: usize,\n    trace_width: usize,\n    l_skip: usize,\n) -> Result<(), CudaError> {\n    let skip_domain = 1 << l_skip;\n    debug_assert!(omega_skip_pows.len() >= skip_domain);\n    debug_assert!(inv_lagrange_denoms.len() >= skip_domain);\n    check(_stacked_reduction_fold_ple(\n        src,\n        dst,\n        omega_skip_pows.as_ptr(),\n        inv_lagrange_denoms.as_ptr(),\n        trace_height as u32,\n        trace_width as u32,\n        l_skip as u32,\n    ))\n}\n\n/// Initializes the `k_rot` evaluations after round 0 for `n = 0..=max_n`.\n///\n/// # Safety\n/// - `eq_r_ns` and `k_rot_ns` should both have length `2 * 2^max_n` and be arranged in segments.\n/// - This function will not initialize `k_rot_ns[0]`. This entry should never be used, and it is\n///   the caller's responsibility to initialize it if needed.\npub unsafe fn initialize_k_rot_from_eq_segments(\n    eq_r_ns: &EqEvalSegments<EF>,\n    k_rot_ns: &mut DeviceBuffer<EF>,\n    k_rot_uni_0: EF,\n    k_rot_uni_1: EF,\n    max_n: u32,\n) -> Result<(), CudaError> {\n    debug_assert_eq!(eq_r_ns.buffer.len(), 2 << max_n);\n    debug_assert_eq!(k_rot_ns.len(), eq_r_ns.buffer.len());\n\n    check(_initialize_k_rot_from_eq_segments(\n        eq_r_ns.buffer.as_ptr(),\n        k_rot_ns.as_mut_ptr(),\n        k_rot_uni_0,\n        k_rot_uni_1,\n        max_n,\n    ))\n}\n\n/// Analog of [stacked_reduction_sumcheck_round0] for MLE sumcheck rounds.\n/// One important distinction is that `k_rot_ns` needs to be provided separately from `eq_r_ns`, but\n/// in the same segmented memory layout.\n///\n/// Uses warp-aggregated atomics for reduction into u64 accumulators. The caller is responsible for\n/// zero-initializing `output` before calling and reducing modulo P after kernel completion.\n///\n/// # Safety\n/// - `q_evals` must be pointers to DeviceBuffer<EF> matrices all of the same height `q_height`.\n/// - `unstacked_cols` should be pointer to DeviceBuffer<UnstackedSlice>, at an offset.\n///   - `unstacked_cols` must be initialized for at least `window_len` elements.\n///   - for each `UnstackedSlice` in the `window_len` elements starting at `unstacked_cols`, the\n///     `log_height` must all be the same and the `stacked_row_idx` must be a multiple of\n///     `2^l_skip`.\n/// - `lambda_pows` should be pointer to DeviceBuffer<EF>, at an offset.\n///   - `lambda_pows` must be initialized for at least `2 * window_len` elements (for rotations).\n/// - `unstacked_cols` pointers must be within bounds of `q_evals`.\n/// - `output` must have length at least `S_DEG * D_EF = 8` and be zero-initialized.\n#[allow(clippy::too_many_arguments)]\npub unsafe fn stacked_reduction_sumcheck_mle_round(\n    q_evals: &DeviceBuffer<*const EF>,\n    eq_r_ns: &EqEvalSegments<EF>,\n    k_rot_ns: &EqEvalSegments<EF>,\n    unstacked_cols: *const UnstackedSlice,\n    lambda_pows: *const EF,\n    output: &mut DeviceBuffer<u64>,\n    q_height: usize,\n    window_len: usize,\n    num_y: usize,\n    sm_count: u32,\n) -> Result<(), CudaError> {\n    debug_assert!(output.len() >= STACKED_REDUCTION_S_DEG * D_EF);\n\n    check(_stacked_reduction_sumcheck_mle_round(\n        q_evals.as_ptr(),\n        eq_r_ns.buffer.as_ptr(),\n        k_rot_ns.buffer.as_ptr(),\n        unstacked_cols,\n        lambda_pows,\n        output.as_mut_ptr(),\n        q_height as u32,\n        window_len as u32,\n        num_y as u32,\n        sm_count,\n    ))\n}\n\n/// Degenerate case for MLE sumcheck rounds.\n///\n/// Uses warp-aggregated atomics for reduction into u64 accumulators. The caller is responsible for\n/// zero-initializing `output` before calling and reducing modulo P after kernel completion.\n///\n/// # Safety\n/// - `output` must have length at least `S_DEG * D_EF = 8` and be zero-initialized.\n#[allow(clippy::too_many_arguments)]\npub unsafe fn stacked_reduction_sumcheck_mle_round_degenerate(\n    q_evals: &DeviceBuffer<*const EF>,\n    eq_ub_ptr: *const EF,\n    eq_r: EF,\n    k_rot_r: EF,\n    unstacked_cols: *const UnstackedSlice,\n    lambda_pows: *const EF,\n    output: &mut DeviceBuffer<u64>,\n    q_height: usize,\n    window_len: usize,\n    l_skip: usize,\n    round: usize,\n) -> Result<(), CudaError> {\n    debug_assert!(output.len() >= STACKED_REDUCTION_S_DEG * D_EF);\n\n    check(_stacked_reduction_sumcheck_mle_round_degenerate(\n        q_evals.as_ptr(),\n        eq_ub_ptr,\n        eq_r,\n        k_rot_r,\n        unstacked_cols,\n        lambda_pows,\n        output.as_mut_ptr(),\n        q_height as u32,\n        window_len as u32,\n        l_skip as u32,\n        round as u32,\n    ))\n}\n\n/// Batched degenerate MLE round: launches one block per descriptor.\n///\n/// # Safety\n/// - `d_descs` must contain valid descriptors with col_offsets within bounds of the shared arrays.\n/// - `output` must have length at least `S_DEG * D_EF = 8` and be zero-initialized.\n#[allow(clippy::too_many_arguments)]\npub unsafe fn batched_stacked_reduction_sumcheck_mle_round_degenerate(\n    d_descs: &DeviceBuffer<DegenMleDesc>,\n    q_evals: &DeviceBuffer<*const EF>,\n    eq_ub_base: *const EF,\n    unstacked_cols_base: *const UnstackedSlice,\n    lambda_pows_base: *const EF,\n    output: &mut DeviceBuffer<u64>,\n    q_height: usize,\n    shift_factor: u32,\n) -> Result<(), CudaError> {\n    debug_assert!(output.len() >= STACKED_REDUCTION_S_DEG * D_EF);\n\n    check(_batched_stacked_reduction_sumcheck_mle_round_degenerate(\n        d_descs.as_ptr(),\n        d_descs.len() as u32,\n        q_evals.as_ptr(),\n        eq_ub_base,\n        unstacked_cols_base,\n        lambda_pows_base,\n        output.as_mut_ptr(),\n        q_height as u32,\n        shift_factor,\n    ))\n}\n\n/// Batched non-degenerate MLE round: maps blocks to AIRs via prefix sums.\n///\n/// # Safety\n/// - `d_descs` and `d_block_offsets` must contain valid descriptor/prefix sum data.\n/// - `output` must have length at least `S_DEG * D_EF = 8` and be zero-initialized.\n#[allow(clippy::too_many_arguments)]\npub unsafe fn batched_stacked_reduction_sumcheck_mle_round(\n    d_descs: &DeviceBuffer<NonDegenMleDesc>,\n    d_block_offsets: &DeviceBuffer<u32>,\n    total_blocks: u32,\n    q_evals: &DeviceBuffer<*const EF>,\n    eq_r_ns: &EqEvalSegments<EF>,\n    k_rot_ns: &EqEvalSegments<EF>,\n    unstacked_cols_base: *const UnstackedSlice,\n    lambda_pows_base: *const EF,\n    output: &mut DeviceBuffer<u64>,\n    q_height: usize,\n) -> Result<(), CudaError> {\n    debug_assert!(output.len() >= STACKED_REDUCTION_S_DEG * D_EF);\n\n    check(_batched_stacked_reduction_sumcheck_mle_round(\n        d_descs.as_ptr(),\n        d_block_offsets.as_ptr(),\n        d_descs.len() as u32,\n        total_blocks,\n        q_evals.as_ptr(),\n        eq_r_ns.buffer.as_ptr(),\n        k_rot_ns.buffer.as_ptr(),\n        unstacked_cols_base,\n        lambda_pows_base,\n        output.as_mut_ptr(),\n        q_height as u32,\n    ))\n}\n\nconst MAX_GRID_DIM: u32 = 65535;\nconst WAVES_TARGET: u32 = 4;\nconst ITERS_MIN: u32 = 4;\nconst ITERS_MAX: u32 = 16;\n\n/// Replicates the stride auto-tuning from `_stacked_reduction_sumcheck_mle_round`.\n/// Returns `(blocks_x, stride)` matching the CUDA-side grid dimensions.\npub(crate) fn compute_mle_launch_params(num_y: u32, window_len: u32, sm_count: u32) -> (u32, u32) {\n    let blocks_x = num_y.div_ceil(256);\n\n    let stride_occ = (sm_count * WAVES_TARGET).div_ceil(blocks_x);\n    let stride_loop_lo = window_len.div_ceil(ITERS_MAX);\n    let stride_loop_hi = window_len.div_ceil(ITERS_MIN);\n\n    let lo = 1.max(stride_occ.max(stride_loop_lo));\n    let hi = window_len.min(MAX_GRID_DIM).min(stride_loop_hi);\n\n    let stride = if lo <= hi {\n        lo\n    } else {\n        lo.min(window_len.min(MAX_GRID_DIM))\n    };\n\n    (blocks_x, stride)\n}\n","numLines":413,"startLine":1,"totalLines":413}}}
