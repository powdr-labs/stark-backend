ceStarkProvingKey<GenericGpuBackend<HS>>,\n42\t    selectors_cube: &DeviceBuffer<F>,\n43\t    main_parts: &DeviceBuffer<*const F>,\n44\t    public_values: &DeviceBuffer<F>,\n45\t    eq_cube: *const EF,\n46\t    lambda_pows: &DeviceBuffer<EF>,\n47\t    skip_domain: u32,\n48\t    num_x: u32,\n49\t    height: u32,\n50\t    num_cosets: u32,\n51\t    g_shift: F,\n52\t    max_temp_bytes: usize,\n53\t    prealloc_intermediates: Option<&mut DeviceBuffer<F>>,\n54\t    prealloc_temp_sums: Option<&mut DeviceBuffer<EF>>,\n55\t) -> Result<DeviceBuffer<EF>, Round0EvalError> {\n56\t    let constraints_dag = &pk.vk.symbolic_constraints;\n57\t    if constraints_dag.constraints.constraint_idx.is_empty() || num_cosets == 0 {\n58\t        // No plain AIR constraints, return empty buffer\n59\t        return Ok(DeviceBuffer::new());\n60\t    }\n61\t\n62\t    let rules = &pk.other_data.zerocheck_round0;\n63\t\n64\t    let buffer_size: u32 = rules.inner.buffer_size;\n65\t    let intermed_capacity = unsafe {\n66\t        _zerocheck_r0_intermediates_buffer_size(\n67\t            buffer_size,\n68\t            skip_domain,\n69\t            num_x,\n70\t            num_cosets,\n71\t            max_temp_bytes,\n72\t        )\n73\t    };\n74\t\n75\t    let use_prealloc_inter = prealloc_intermediates\n76\t        .as_ref()\n77\t        .map_or(false, |p| intermed_capacity > 0 && p.len() >= intermed_capacity);\n78\t    let mut fallback_intermediates;\n79\t    let intermediates = if use_prealloc_inter {\n80\t        prealloc_intermediates.unwrap()\n81\t    } else {\n82\t        fallback_intermediates = if intermed_capacity > 0 {\n83\t            debug!(\"zerocheck:intermediates_capacity={intermed_capacity}\");\n84\t            DeviceBuffer::<F>::with_capacity(intermed_capacity)\n85\t        } else {\n86\t            DeviceBuffer::<F>::new()\n87\t        };\n88\t        &mut fallback_intermediates\n89\t    };\n90\t\n91\t    let temp_sums_buffer_capacity = unsafe {\n92\t        _zerocheck_r0_temp_sums_buffer_size(\n93\t            buffer_size,\n94\t            skip_domain,\n95\t            num_x,\n96\t            num_cosets,\n97\t            max_temp_bytes,\n98\t        )\n99\t    };\n100\t\n101\t    let use_prealloc_temp = prealloc_temp_sums\n102\t        .as_ref()\n103\t        .map_or(false, |p| p.len() >= temp_sums_buffer_capacity);\n104\t    let mut fallback_temp_sums;\n105\t    let temp_sums_buffer = if use_prealloc_temp {\n106\t        prealloc_temp_sums.unwrap()\n107\t    } else {\n108\t        debug!(\"zerocheck:temp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n109\t        fallback_temp_sums = DeviceBuffer::<EF>::with_capacity(temp_sums_buffer_capacity);\n110\t        &mut fallback_temp_sums\n111\t    };\n112\t\n113\t    let used_temp_bytes =\n114\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<EF>();\n115\t    if used_temp_bytes > max_temp_bytes {\n116\t        warn!(\"zerocheck used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\");\n117\t    }\n118\t\n119\t    let preprocessed_ptr = pk\n120\t        .preprocessed_data\n121\t        .as_ref()\n122\t        .map(|cd| cd.trace.buffer().as_ptr())\n123\t        .unwrap_or(std::ptr::null());\n124\t\n125\t    let mut sp_evals =\n126\t        DeviceBuffer::<EF>::with_capacity(num_cosets as usize * skip_domain as usize);\n127\t    // SAFETY:\n128\t    // - No bounds checks are done in this kernel. It fully assumes that the Rules are trusted and\n129\t    //   all nodes are valid.\n130\t    unsafe {\n131\t        zerocheck_ntt_eval_constraints(\n132\t            temp_sums_buffer,\n133\t            &mut sp_evals,\n134\t            selectors_cube,\n135\t            preprocessed_ptr,\n136\t            main_parts,\n137\t            eq_cube,\n138\t            lambda_pows,\n139\t            public_values,\n140\t            &rules.inner.d_rules,\n141\t            &rules.inner.d_used_nodes,\n142\t            buffer_size,\n143\t            intermediates,\n144\t            skip_domain,\n145\t            num_x,\n146\t            height,\n147\t            num_cosets,\n148\t            g_shift,\n149\t            max_temp_bytes,\n150\t        )?;\n151\t    }\n152\t\n153\t    Ok(sp_evals)\n154\t}\n155\t\n156\t/// Evaluate interaction constraints (excluding plain AIR constraints) for a single AIR, given\n157\t/// prepared trace input.\n158\t///\n159\t/// `constraints` includes interaction expressions for the AIR.\n160\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n161\t#[allow(clippy::too_many_arguments)]\n162\tpub fn evaluate_round0_interactions_gpu<HS: GpuHashScheme>(\n163\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n164\t    symbolic: &SymbolicConstraints<F>,\n165\t    selectors_cube: &DeviceBuffer<F>,\n166\t    main_parts: &DeviceBuffer<*const F>,\n167\t    public_values: &DeviceBuffer<F>,\n168\t    eq_cube: *const EF,\n169\t    beta_pows: &[EF],\n170\t    eq_3bs: &[EF],\n171\t    skip_domain: u32,\n172\t    num_x: u32,\n173\t    height: u32,\n174\t    num_cosets: u32,\n175\t    g_shift: F,\n176\t    max_temp_bytes: usize,\n177\t    prealloc_intermediates: Option<&mut DeviceBuffer<F>>,\n178\t    prealloc_temp_sums: Option<&mut DeviceBuffer<Frac<EF>>>,\n179\t) -> Result<DeviceBuffer<Frac<EF>>, Round0EvalError> {\n180\t    // Check if this trace has interactions\n181\t    if eq_3bs.is_empty() {\n182\t        return Ok(DeviceBuffer::new());\n183\t    }\n184\t    let large_domain = num_cosets * skip_domain;\n185\t\n186\t    // We create a new \"interactions DAG\" where the new .constraints are the interaction [count,\n187\t    // message_0, message_1, ..] expressions themselves, while the .interactions are empty\n188\t    // We track the indices with InteractionNode\n189\t\n190\t    // Copied from build_symbolic_constraints_dag to handle sorting of constraints\n191\t    // NOTE: For logup round0, the kernel uses weights indexed by rule_idx, not constraint_idx.\n192\t    // So we deduplicate constraint_idx and use dag_idx_to_rule_idx for weight mapping.\n193\t    let (rules, d_numer_weights, d_denom_weights, denom_sum_init) = {\n194\t        let mut dag_builder = SymbolicDagBuilder::new();\n195\t        let mut sorted_used_dag_idxs = Vec::new();\n196\t        for interaction in &symbolic.interactions {\n197\t            let count = dag_builder.add_expr(&interaction.count);\n198\t            sorted_used_dag_idxs.push(count);\n199\t            sorted_used_dag_idxs.extend(\n200\t                interaction\n201\t                    .message\n202\t                    .iter()\n203\t                    .map(|field_expr| dag_builder.add_expr(field_expr)),\n204\t            );\n205\t        }\n206\t        sorted_used_dag_idxs.sort();\n207\t        // Deduplicate for the dag since logup round0 kernel doesn't use used_nodes\n208\t        sorted_used_dag_idxs.dedup();\n209\t        let dag = SymbolicExpressionDag {\n210\t            nodes: dag_builder.nodes,\n211\t            constraint_idx: sorted_used_dag_idxs,\n212\t        };\n213\t        let rules = SymbolicRulesGpu::new(&dag, true);\n214\t        let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n215\t        let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n216\t        let mut denom_sum_init = EF::ZERO;\n217\t        for (interaction_idx, interaction) in symbolic.interactions.iter().enumerate() {\n218\t            // CAUTION: an expression node could be used in multiple interactions, and might even be\n219\t            // used as `count` in one, but message field in another. We only care about their\n220\t            // weighted sum with eq_3b, so we compute the weights ahead of time.\n221\t            let count_dag_idx =\n222\t                dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];\n223\t            let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n224\t            numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n225\t            denom_sum_init += eq_3bs[interaction_idx]\n226\t                * beta_pows[interaction.message.len()]\n227\t                * F::from_u32(interaction.bus_index as u32 + 1);\n228\t\n229\t            for (message_idx, message) in interaction.message.iter().enumerate() {\n230\t                let message_dag_idx =\n231\t                    dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n232\t                let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n233\t                denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];\n234\t            }\n235\t        }\n236\t        let d_numer_weights = numer_weights.to_device()?;\n237\t        let d_denom_weights = denom_weights.to_device()?;\n238\t        (rules, d_numer_weights, d_denom_weights, denom_sum_init)\n239\t    };\n240\t\n241\t    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n242\t    let d_rules = encoded_rules.to_device()?;\n243\t\n244\t    let buffer_size: u32 = rules.buffer_size.try_into().unwrap();\n245\t    let intermed_capacity = unsafe {\n246\t        _logup_r0_intermediates_buffer_size(\n247\t            buffer_size,\n248\t            skip_domain,\n249\t            num_x,\n250\t            num_cosets,\n251\t            max_temp_bytes,\n252\t        )\n253\t    };\n254\t\n255\t    let use_prealloc_inter = prealloc_intermediates\n256\t        .as_ref()\n257\t        .map_or(false, |p| intermed_capacity > 0 && p.len() >= intermed_capacity);\n258\t    let mut fallback_intermediates;\n259\t    let intermediates = if use_prealloc_inter {\n260\t        prealloc_intermediates.unwrap()\n261\t    } else {\n262\t        fallback_intermediates = if intermed_capacity > 0 {\n263\t            debug!(\"logup_r0:intermediates_capacity={intermed_capacity}\");\n264\t            DeviceBuffer::<F>::with_capacity(intermed_capacity)\n265\t        } else {\n266\t            DeviceBuffer::<F>::new()\n267\t        };\n268\t        &mut fallback_intermediates\n269\t    };\n270\t\n271\t    let temp_sums_buffer_capacity = unsafe {\n272\t        _logup_r0_temp_sums_buffer_size(buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes)\n273\t    };\n274\t\n275\t    let use_prealloc_temp = prealloc_temp_sums\n276\t        .as_ref()\n277\t        .map_or(false, |p| p.len() >= temp_sums_buffer_capacity);\n278\t    let mut fallback_temp_sums;\n279\t    let temp_sums_buffer = if use_prealloc_temp {\n280\t        prealloc_temp_sums.unwrap()\n281\t    } else {\n282\t        debug!(\"logup_r0:tmp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n283\t        fallback_temp_sums = DeviceBuffer::<Frac<EF>>::with_capacity(temp_sums_buffer_capacity);\n284\t        &mut fallback_temp_sums\n285\t    };\n286\t\n287\t    let used_temp_bytes =\n288\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<Frac<EF>>();\n289\t    if used_temp_bytes > max_temp_bytes {\n290\t        warn!(\n291\t            \"logup_round0 used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\"\n292\t        );\n293\t    }\n294\t\n295\t    let preprocessed_ptr = pk\n296\t        .preprocessed_data\n297\t        .as_ref()\n298\t        .map(|cd| cd.trace.buffer().as_ptr())\n299\t        .unwrap_or(std::ptr::null());\n300\t\n301\t    let mut s_evals = DeviceBuffer::<Frac<EF>>::with_capacity(large_domain as usize);\n302\t\n303\t    unsafe {\n304\t        logup_bary_eval_interactions_round0(\n305\t            temp_sums_buffer,\n306\t            &mut s_evals,\n307\t            selectors_cube,\n308\t            preprocessed_ptr,\n309\t            main_parts,\n310\t            eq_cube,\n311\t            public_values,\n312\t            &d_numer_weights,\n313\t            &d_denom_weights,\n314\t            denom_sum_init,\n315\t            &d_rules,\n316\t            buffer_size,\n317\t            intermediates,\n318\t            skip_domain,\n319\t           