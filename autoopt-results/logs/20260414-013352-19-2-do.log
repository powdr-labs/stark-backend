_poly(l_skip: usize, n: isize) -> UnivariatePoly<EF> {\n    let n_abs = (-n) as usize;\n    let l = l_skip - n_abs;\n    let scale = EF::ONE.halve().exp_u64(n_abs as u64);\n    let mut coeffs = vec![EF::ZERO; 1 << l_skip];\n    for k in 0..(1 << n_abs) {\n        coeffs[k * (1 << l)] = scale;\n    }\n    UnivariatePoly::new(coeffs)\n}\n\n/// eq_uni_at_one polynomial: eq_D(Z, 1) as a polynomial in Z\n///\n/// All coefficients are n_inv * scale where n_inv = 1 / 2^l\nfn eq_uni_at_one_poly(l: usize, scale: EF) -> UnivariatePoly<EF> {\n    let n_inv = F::ONE.halve().exp_u64(l as u64);\n    UnivariatePoly::new(vec![EF::from(n_inv) * scale; 1 << l])\n}\n\n/// NTT-based polynomial multiplication\nfn poly_multiply_ntt(dft: &Radix2BowersSerial, a: &[EF], b: &[EF], min_size: usize) -> Vec<EF> {\n    let size = (a.len() + b.len() - 1).max(min_size).next_power_of_two();\n    let mut a_pad = a.to_vec();\n    a_pad.resize(size, EF::ZERO);\n    let mut b_pad = b.to_vec();\n    b_pad.resize(size, EF::ZERO);\n    let a_evals = dft.dft(a_pad);\n    let b_evals = dft.dft(b_pad);\n    let c_evals: Vec<EF> = a_evals\n        .into_iter()\n        .zip(b_evals)\n        .map(|(a, b)| a * b)\n        .collect();\n    dft.idft(c_evals)\n}\n","structuredPatch":[{"oldStart":935,"oldLines":10,"newStart":935,"newLines":10,"lines":["                     thread_indices[i % num_threads].push(i);","                 }"," ","-                // Extract raw pointers for thread-safe access","-                let folded_evals_ptr = folded_evals.as_mut_ptr();","-                let omega_skip_pows_ptr = self.d_omega_skip_pows.as_ptr();","-                let inv_lagrange_denoms_ptr = d_inv_lagrange_denoms.as_ptr();","+                // Extract raw pointers for thread-safe access (wrapped for Send)","+                let folded_evals_ptr = SendPtr(folded_evals.as_mut_ptr());","+                let omega_skip_pows_ptr = SendPtr(self.d_omega_skip_pows.as_ptr());","+                let inv_lagrange_denoms_