{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J175mncgRDRBrFiXt3jkTS","type":"tool_result","content":"641\tpub unsafe fn frac_compute_round_and_revert(\n642\t    eq_xi: &SqrtEqLayers,\n643\t    layer: &mut DeviceBuffer<Frac<EF>>,\n644\t    num_x: usize,\n645\t    lambda: EF,\n646\t    out_device: &mut DeviceBuffer<EF>,\n647\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n648\t) -> Result<(), CudaError> {\n649\t    let low_n = eq_xi.low_n();\n650\t    let high_n = eq_xi.high_n();\n651\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n652\t    #[cfg(debug_assertions)]\n653\t    {\n654\t        let len = tmp_block_sums.len();\n655\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n656\t        assert!(\n657\t            len >= required as usize,\n658\t            \"tmp_block_sums len={len} < required={required}\"\n659\t        );\n660\t        assert!(layer.len() >= 2 * num_x, \"layer too small for pq_size\");\n661\t    }\n662\t    CudaError::from_result(_frac_compute_round_and_revert(\n663\t        eq_xi.low.get_ptr(low_n),\n664\t        eq_xi.high.get_ptr(high_n),\n665\t        layer.as_mut_ptr(),\n666\t        num_x,\n667\t        1 << low_n,\n668\t        lambda,\n669\t        out_device.as_mut_ptr(),\n670\t        tmp_block_sums.as_mut_ptr(),\n671\t    ))\n672\t}\n673\t\n674\t/// Folds `Frac<EF>` buffer. Pairs (idx, idx+quarter) and (idx+half, idx+3*quarter),\n675\t/// writes results to dst[idx] and dst[idx+quarter]. Output size is `size / 2`.\n676\t/// Safe for src == dst (in-place) because each thread handles disjoint indices.\n677\tpub unsafe fn fold_ef_frac_columns(\n678\t    src: &DeviceBuffer<Frac<EF>>,\n679\t    dst: &mut DeviceBuffer<Frac<EF>>,\n680\t    size: usize,\n681\t    r: EF,\n682\t) -> Result<(), CudaError> {\n683\t    debug_assert!(src.len() >= size);\n684\t    debug_assert!(dst.len() >= size / 2);\n685\t    CudaError::from_result(_frac_fold_fpext_columns(\n686\t        src.as_ptr(),\n687\t        dst.as_mut_ptr(),\n688\t        size,\n689\t        r,\n690\t    ))\n691\t}\n692\t\n693\t/// In-place fold. See [`fold_ef_frac_columns`] for details.\n694\tpub unsafe fn fold_ef_frac_columns_inplace(\n695\t    buffer: &mut DeviceBuffer<Frac<EF>>,\n696\t    size: usize,\n697\t    r: EF,\n698\t) -> Result<(), CudaError> {\n699\t    debug_assert!(buffer.len() >= size);\n700\t    let ptr = buffer.as_mut_ptr();\n701\t    CudaError::from_result(_frac_fold_fpext_columns(ptr, ptr, size, r))\n702\t}\n703\t\n704\t/// Fused compute round + fold kernel.\n705\t///\n706\t/// Reads from pre-fold `src_pq_buffer` (size `src_pq_size`), performs fold-on-the-fly using\n707\t/// `r_prev`, computes s' polynomial evaluations (degree 2), and writes folded output to\n708\t/// `dst_pq_buffer` (size `src_pq_size/2`).\n709\t///\n710\t/// This fuses the fold operation into the next round's compute, eliminating one kernel launch per\n711\t/// inner round and reducing memory traffic.\n712\t///\n713\t/// The eq_xi layers should have max_n = log2(src_pq_size / 4) = log2(post-fold num_x).\n714\t#[allow(clippy::too_many_arguments)]\n715\tpub unsafe fn frac_compute_round_and_fold(\n716\t    eq_xi: &SqrtEqLayers,\n717\t    src_pq_buffer: &DeviceBuffer<Frac<EF>>,\n718\t    dst_pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n719\t    src_pq_size: usize,\n720\t    lambda: EF,\n721\t    r_prev: EF,\n722\t    out_device: &mut DeviceBuffer<EF>,\n723\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n724\t) -> Result<(), CudaError> {\n725\t    let low_n = eq_xi.low_n();\n726\t    let high_n = eq_xi.high_n();\n727\t    // Post-fold: num_x = src_pq_size / 4\n728\t    let num_x = src_pq_size >> 2;\n729\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n730\t    #[cfg(debug_assertions)]\n731\t    {\n732\t        assert!(src_pq_size > 2, \"src_pq_size must be > 2\");\n733\t        let pq_size = src_pq_size >> 1;\n734\t        assert!(num_x > 0, \"num_x must be > 0\");\n735\t        assert!(\n736\t            src_pq_buffer.len() >= src_pq_size,\n737\t            \"src_pq_buffer too small: {} < {}\",\n738\t            src_pq_buffer.len(),\n739\t            src_pq_size\n740\t        );\n741\t        assert!(\n742\t            dst_pq_buffer.len() >= pq_size,\n743\t            \"dst_pq_buffer too small: {} < {}\",\n744\t            dst_pq_buffer.len(),\n745\t            pq_size\n746\t        );\n747\t        let len = tmp_block_sums.len();\n748\t        let required = _frac_compute_round_temp_buffer_size(num_x as u32);\n749\t        assert!(\n750\t            len >= required as usize,\n751\t            \"tmp_block_sums len={len} < required={required}\"\n752\t        );\n753\t    }\n754\t    CudaError::from_result(_frac_compute_round_and_fold(\n755\t        eq_xi.low.get_ptr(low_n),\n756\t        eq_xi.high.get_ptr(high_n),\n757\t        src_pq_buffer.as_ptr(),\n758\t        dst_pq_buffer.as_mut_ptr(),\n759\t        src_pq_size,\n760\t        1 << low_n,\n761\t        lambda,\n762\t        r_prev,\n763\t        out_device.as_mut_ptr(),\n764\t        tmp_block_sums.as_mut_ptr(),\n765\t    ))\n766\t}\n767\t\n768\t/// In-place fused compute round + fold kernel. See [`frac_compute_round_and_fold`] for details.\n769\t///\n770\t/// Uses a dedicated in-place kernel that doesn't have `__restrict__` on the pq pointer,\n771\t/// avoiding undefined behavior from aliased restrict pointers.\n772\t///\n773\t/// **IN-PLACE SAFETY:** Each thread writes only to indices it reads from in the first half of the\n774\t/// buffer, so there are no cross-thread conflicts. The second half is read-only.\n775\t#[allow(clippy::too_many_arguments)]\n776\tpub unsafe fn frac_compute_round_and_fold_inplace(\n777\t    eq_xi: &SqrtEqLayers,\n778\t    pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n779\t    src_pq_size: usize,\n780\t    lambda: EF,\n781\t    r_prev: EF,\n782\t    out_device: &mut DeviceBuffer<EF>,\n783\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n784\t) -> Result<(), CudaError> {\n785\t    let low_n = eq_xi.low_n();\n786\t    let high_n = eq_xi.high_n();\n787\t    // Post-fold: num_x = src_pq_size / 4\n788\t    let num_x = src_pq_size >> 2;\n789\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n790\t    #[cfg(debug_assertions)]"}]},"parent_tool_use_id":"toolu_01P9fnKp3GdQkVYR3EaJtCJF","session_id":"50386b42-eb75-4189-9b73-2a1359832805","uuid":"2999429c-624c-4d9e-8374-1abb6a105f06","timestamp":"2026-04-13T09:35:49.018Z"}
