{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WqeoX8J2j8EvcCrQeHd7DJ","type":"tool_result","content":"856\t__global__ void frac_build_tree_two_layers_kernel(\n857\t    FracExt *__restrict__ layer,\n858\t    uint32_t half_i1   // = N >> (i+2), where i is the first of the two layers\n859\t) {\n860\t    uint32_t j = blockIdx.x * blockDim.x + threadIdx.x;\n861\t    if (j >= half_i1) return;\n862\t\n863\t    uint32_t half_i = half_i1 << 1;   // = N >> (i+1)\n864\t\n865\t    FracExt A = layer[j];\n866\t    FracExt B = layer[j + half_i1];\n867\t    FracExt C = layer[j + half_i];\n868\t    FracExt D = layer[j + half_i + half_i1];\n869\t\n870\t    // Layer i: combine A with C and B with D (kept in registers)\n871\t    FracExt lhs = frac_add(A, C);\n872\t    FracExt rhs = frac_add(B, D);\n873\t    // Layer i+1: combine the two layer-i results\n874\t    FracExt result = frac_add(lhs, rhs);\n875\t\n876\t    layer[j]         = result;\n877\t    layer[j + half_i1] = rhs;   // Needed for revert of layer i+1\n878\t    // layer[j + half_i] = C  (unchanged, needed for revert of layer i)\n879\t    // layer[j + half_i + half_i1] = D  (unchanged, needed for revert of layer i)\n880\t}\n881\t\n882\t// ============================================================================\n883\t// LAUNCHERS\n884\t// ============================================================================\n885\ttemplate <bool revert, bool apply_alpha>\n886\tint launch_frac_build_tree_layer(FracExt *layer, size_t layer_size, FpExt alpha) {\n887\t    auto [grid, block] = kernel_launch_params(layer_size);\n888\t    frac_build_tree_layer_kernel<revert, apply_alpha><<<grid, block>>>(layer, layer_size, alpha);\n889\t    return CHECK_KERNEL();\n890\t}\n891\t\n892\textern \"C\" int _frac_build_tree_layer(\n893\t    FracExt *layer,\n894\t    size_t layer_size,\n895\t    bool revert,\n896\t    FpExt alpha,\n897\t    bool apply_alpha\n898\t) {\n899\t    if (layer_size == 0) {\n900\t        return 0;\n901\t    }\n902\t    assert(layer_size % 2 == 0);\n903\t    layer_size /= 2;\n904\t\n905\t    return DISPATCH_BOOL_PAIR(\n906\t        launch_frac_build_tree_layer, revert, apply_alpha, layer, layer_size, alpha\n907\t    );\n908\t}\n909\t\n910\t// Launcher for fused two-layer tree build.\n911\t// half_i1 = N >> (i+2), where i is the index of the first layer to fuse.\n912\t// Requires half_i1 >= 1 and half_i1 * 4 <= total array size.\n913\textern \"C\" int _frac_build_tree_two_layers(FracExt *layer, size_t half_i1) {\n914\t    if (half_i1 == 0) return 0;\n915\t    // Use 256 threads/block (not 1024) to give the compiler more register headroom.\n916\t    // frac_build_tree_two_layers_kernel does 4 FracExt loads + 3 frac_add ops,\n917\t    // which has higher register pressure than the single-layer build kernel.\n918\t    auto [grid, block] = kernel_launch_params(half_i1, 256);\n919\t    frac_build_tree_two_layers_kernel<<<grid, block>>>(layer, (uint32_t)half_i1);\n920\t    return CHECK_KERNEL();\n921\t}\n922\t\n923\tinline uint32_t min_blocks_target_for_device(uint32_t blocks_per_sm, uint32_t fallback_blocks) {\n924\t    int device = 0;\n925\t    if (cudaGetDevice(&device) == cudaSuccess) {\n926\t        int sm_count = 0;\n927\t        if (cudaDeviceGetAttribute(&sm_count, cudaDevAttrMultiProcessorCount, device) ==\n928\t                cudaSuccess &&\n929\t            sm_count > 0) {\n930\t            return static_cast<uint32_t>(sm_count) * blocks_per_sm;\n931\t        }\n932\t    }\n933\t    return fallback_blocks;\n934\t}\n935\t"}]},"parent_tool_use_id":"toolu_01P9fnKp3GdQkVYR3EaJtCJF","session_id":"50386b42-eb75-4189-9b73-2a1359832805","uuid":"748380db-5dbb-450b-a616-104a01998387","timestamp":"2026-04-13T09:35:37.651Z"}
