         .map_err(LogupZerocheckError::MleInteractionEval)?;\n1424\t        }\n1425\t\n1426\t        // Early traces (num_y>1): partition by threshold for zerocheck path\n1427\t        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n1428\t            .iter()\n1429\t            .filter(|t| t.has_constraints)\n1430\t            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n1431\t\n1432\t        // Partition high num_y traces by monomial-to-rules ratio\n1433\t        // (traces without monomials are skipped - they contribute zero)\n1434\t        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n1435\t            high_early.iter().partition(|t| {\n1436\t                let num_monomials = get_num_monomials(t, self.pk);\n1437\t                let rules_len = get_zerocheck_rules_len(t, self.pk);\n1438\t                // Use DAG when monomial expansion significantly increased the term count\n1439\t                num_monomials as usize >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len\n1440\t            });\n1441\t\n1442\t        // DAG evaluation for high num_y traces with high monomial-to-rules ratio\n1443\t        if !high_dag_traces.is_empty() {\n1444\t            let lambda_pows = self.lambda_pows.as_ref().unwrap();\n1445\t            evaluate_zerocheck_batched(\n1446\t                high_dag_traces,\n1447\t                self.pk,\n1448\t                lambda_pows,\n1449\t                sp_deg as u32,\n1450\t                &mut zc_out,\n1451\t                self.memory_limit_bytes,\n1452\t            )\n1453\t            .map_err(LogupZerocheckError::MleConstraintEval)?;\n1454\t        }\n1455\t\n1456\t        // Par-Y monomial kernel for high num_y traces\n1457\t        if !high_mono_traces.is_empty() {\n1458\t            let lambda_combs: Vec<_> = high_mono_traces\n1459\t                .iter()\n1460\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1461\t            