{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01646SU4XgHRkYShyBPGRqYw","type":"tool_result","content":"1\t//! Batch MLE evaluation for zerocheck and logup.\n2\t//!\n3\t//! This module provides builders for batching MLE evaluations across multiple AIRs,\n4\t//! enabling efficient GPU kernel launches that process multiple traces in parallel.\n5\t\n6\tuse openvm_cuda_common::{\n7\t    copy::{MemCopyD2H, MemCopyH2D},\n8\t    d_buffer::DeviceBuffer,\n9\t    error::MemCopyError,\n10\t};\n11\tuse openvm_stark_backend::prover::{fractional_sumcheck_gkr::Frac, DeviceMultiStarkProvingKey};\n12\t\n13\tuse crate::{\n14\t    cuda::logup_zerocheck::{\n15\t        _logup_batch_mle_intermediates_buffer_size, _zerocheck_batch_mle_intermediates_buffer_size,\n16\t        logup_batch_eval_mle, zerocheck_batch_eval_mle, BlockCtx, EvalCoreCtx, LogupCtx,\n17\t        MainMatrixPtrs, ZerocheckCtx,\n18\t    },\n19\t    error::KernelError,\n20\t    gpu_backend::GenericGpuBackend,\n21\t    hash_scheme::GpuHashScheme,\n22\t    logup_zerocheck::{\n23\t        batch_mle_monomial::{LogupCombinations, LogupMonomialBatch},\n24\t        mle_round::{evaluate_mle_constraints_gpu, evaluate_mle_interactions_gpu},\n25\t    },\n26\t    prelude::{EF, F},\n27\t};\n28\t\n29\tconst MAX_THREADS_PER_BLOCK: u32 = 128;\n30\t\n31\t// ============================================================================\n32\t// Memory calculation helpers\n33\t// ============================================================================\n34\t\n35\t/// Computes zerocheck intermediate buffer memory in bytes for a trace.\n36\tfn zerocheck_batch_mle_intermediates_buffer_bytes(\n37\t    buffer_size: u32,\n38\t    num_x: u32,\n39\t    num_y: u32,\n40\t) -> usize {\n41\t    unsafe {\n42\t        _zerocheck_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n43\t            * std::mem::size_of::<EF>()\n44\t    }\n45\t}\n46\t\n47\t/// Computes logup intermediate buffer memory in bytes for a trace.\n48\tfn logup_batch_mle_intermediates_buffer_bytes(buffer_size: u32, num_x: u32, num_y: u32) -> usize {\n49\t    unsafe {\n50\t        _logup_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n51\t            * std::mem::size_of::<EF>()\n52\t    }\n53\t}\n54\t\n55\t// ============================================================================\n56\t// Batching helpers\n57\t// ============================================================================\n58\t\n59\t/// Find how many traces fit in the memory budget.\n60\t/// Returns (count, total_memory_of_batch).\n61\tfn find_batch_end<T, M>(traces: &[T], memory_fn: M, memory_limit_bytes: usize) -> (usize, usize)\n62\twhere\n63\t    M: Fn(&T) -> usize,\n64\t{\n65\t    let mut batch_end = 0;\n66\t    let mut batch_memory = 0usize;\n67\t\n68\t    while batch_end < traces.len() {\n69\t        let trace_memory = memory_fn(&traces[batch_end]);\n70\t\n71\t        if batch_end == 0 {\n72\t            // First trace always included (even if oversized)\n73\t            batch_memory = trace_memory;\n74\t            batch_end = 1;\n75\t            if trace_memory > memory_limit_bytes {\n76\t                break; // Single oversized trace\n77\t            }\n78\t        } else if batch_memory + trace_memory <= memory_limit_bytes {\n79\t            batch_memory += trace_memory;\n80\t            batch_end += 1;\n81\t        } else {\n82\t            break; // Would exceed limit\n83\t        }\n84\t    }\n85\t    (batch_end, batch_memory)\n86\t}\n87\t\n88\t/// Context for a single trace used in batch MLE evaluation.\n89\tpub(crate) struct TraceCtx {\n90\t    pub trace_idx: usize,\n91\t    pub air_idx: usize,\n92\t    #[allow(dead_code)]\n93\t    pub n_lift: usize,\n94\t    pub num_y: u32,\n95\t    pub has_constraints: bool,\n96\t    pub has_interactions: bool,\n97\t    pub norm_factor: F,\n98\t    // shared eval pointers (same for zerocheck + logup)\n99\t    pub eq_xi_ptr: *const EF,\n100\t    pub sels_ptr: *const EF,\n101\t    pub prep_ptr: MainMatrixPtrs<EF>,\n102\t    pub main_ptrs_dev: DeviceBuffer<MainMatrixPtrs<EF>>,\n103\t    pub public_ptr: *const F,\n104\t    pub eq_3bs_ptr: *const EF,\n105\t}\n106\t\n107\t// NOTE[jpw]: we do not expect to use this since most of the time zerocheck will use monomial_par_y.\n108\t// We use DAG evaluation primarily for Poseidon2Air. Consider deleting either the non-batch or batch\n109\t// dag version to reduce code duplication.\n110\t/// Builder for batched zerocheck MLE evaluation.\n111\t///\n112\t/// Collects traces and pre-builds all GPU contexts, then evaluates in a single kernel launch.\n113\tpub(crate) struct ZerocheckMleBatchBuilder<'a> {\n114\t    traces: Vec<&'a TraceCtx>,\n115\t    d_block_ctxs: DeviceBuffer<BlockCtx>,\n116\t    d_zc_ctxs: DeviceBuffer<ZerocheckCtx>,\n117\t    air_offsets: DeviceBuffer<u32>,\n118\t    threads_per_block: u32,\n119\t    _intermediates_keepalive: Vec<DeviceBuffer<EF>>,\n120\t}\n121\t\n122\timpl<'a> ZerocheckMleBatchBuilder<'a> {\n123\t    /// Creates a new builder from an iterator of traces.\n124\t    ///\n125\t    /// This constructor filters traces with constraints, computes thread configuration,\n126\t    /// builds all block and zerocheck contexts, and uploads them to the device.\n127\t    pub fn new<HS: GpuHashScheme>(\n128\t        traces: impl Iterator<Item = &'a TraceCtx>,\n129\t        pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n130\t        num_x: u32,\n131\t    ) -> Result<Self, MemCopyError> {\n132\t        let traces: Vec<&TraceCtx> = traces.filter(|t| t.has_constraints).collect();\n133\t\n134\t        if traces.is_empty() {\n135\t            return Ok(Self {\n136\t                traces: vec![],\n137\t                d_block_ctxs: DeviceBuffer::new(),\n138\t                d_zc_ctxs: DeviceBuffer::new(),\n139\t                air_offsets: DeviceBuffer::new(),\n140\t                threads_per_block: 0,\n141\t                _intermediates_keepalive: vec![],\n142\t            });\n143\t        }\n144\t\n145\t        // Compute threads_per_block from max_num_y\n146\t        let max_num_y = traces.iter().map(|t| t.num_y).max().unwrap_or(0);\n147\t        let threads_per_block = max_num_y.min(MAX_THREADS_PER_BLOCK);\n148\t\n149\t        // Build block_ctxs and air_offsets\n150\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();\n151\t        let mut air_offsets: Vec<u32> = Vec::with_capacity(traces.len() + 1);\n152\t        air_offsets.push(0);\n153\t\n154\t        for (local_air, t) in traces.iter().enumerate() {\n155\t            let nb = t.num_y.div_ceil(threads_per_block);\n156\t            for b in 0..nb {\n157\t                block_ctxs_h.push(BlockCtx {\n158\t                    local_block_idx_x: b,\n159\t                    air_idx: local_air as u32,\n160\t                });\n161\t            }\n162\t            air_offsets.push(block_ctxs_h.len() as u32);\n163\t        }\n164\t\n165\t        // Build ZerocheckCtx for each trace\n166\t        let mut intermediates_keepalive: Vec<DeviceBuffer<EF>> = Vec::new();\n167\t        let mut zc_ctxs_h: Vec<ZerocheckCtx> = Vec::with_capacity(traces.len());\n168\t\n169\t        for t in traces.iter() {\n170\t            let air_pk = &pk.per_air[t.air_idx];\n171\t            let buffer_size = air_pk.other_data.zerocheck_mle.inner.buffer_size;\n172\t\n173\t            let d_intermediates = if buffer_size > 0 {\n174\t                let intermediates_len = unsafe {\n175\t                    _zerocheck_batch_mle_intermediates_buffer_size(buffer_size, num_x, t.num_y)\n176\t                };\n177\t                let buf = DeviceBuffer::<EF>::with_capacity(intermediates_len);\n178\t                let ptr = buf.as_mut_ptr();\n179\t                intermediates_keepalive.push(buf);\n180\t                ptr\n181\t            } else {\n182\t                std::ptr::null_mut()\n183\t            };\n184\t\n185\t            let eval_ctx = EvalCoreCtx {\n186\t                d_selectors: t.sels_ptr,\n187\t                d_preprocessed: t.prep_ptr,\n188\t                d_main: t.main_ptrs_dev.as_ptr(),\n189\t                d_public: t.public_ptr,\n190\t            };\n191\t\n192\t            zc_ctxs_h.push(ZerocheckCtx {\n193\t                eval_ctx,\n194\t                d_intermediates,\n195\t                num_y: t.num_y,\n196\t                d_eq_xi: t.eq_xi_ptr,\n197\t                d_rules: air_pk.other_data.zerocheck_mle.inner.d_rules.as_raw_ptr(),\n198\t                rules_len: air_pk.other_data.zerocheck_mle.inner.d_rules.len(),\n199\t                d_used_nodes: air_pk.other_data.zerocheck_mle.inner.d_used_nodes.as_ptr(),\n200\t                used_nodes_len: air_pk.other_data.zerocheck_mle.inner.d_used_nodes.len(),\n201\t                buffer_size,\n202\t            });\n203\t        }\n204\t\n205\t        // Upload to device\n206\t        let d_block_ctxs = block_ctxs_h.to_device()?;\n207\t        let d_zc_ctxs = zc_ctxs_h.to_device()?;\n208\t        let air_offsets = air_offsets.to_device()?;\n209\t\n210\t        Ok(Self {\n211\t            traces,\n212\t            d_block_ctxs,\n213\t            d_zc_ctxs,\n214\t            air_offsets,\n215\t            threads_per_block,\n216\t            _intermediates_keepalive: intermediates_keepalive,\n217\t        })\n218\t    }\n219\t\n220\t    /// Returns true if there are no traces to evaluate.\n221\t    #[allow(dead_code)]\n222\t    pub fn is_empty(&self) -> bool {\n223\t        self.traces.is_empty()\n224\t    }\n225\t\n226\t    /// Returns the trace indices in order.\n227\t    pub fn trace_indices(&self) -> impl Iterator<Item = usize> + '_ {\n228\t        self.traces.iter().map(|t| t.trace_idx)\n229\t    }\n230\t\n231\t    /// Evaluates the batch and returns the output device buffer.\n232\t    ///\n233\t    /// The buffer contains `num_airs * num_x` elements, laid out as\n234\t    /// `[air0_x0, air0_x1, ..., air1_x0, air1_x1, ...]`.\n235\t    pub fn evaluate(\n236\t        &self,\n237\t        lambda_pows: &DeviceBuffer<EF>,\n238\t        num_x: u32,\n239\t    ) -> Result<DeviceBuffer<EF>, KernelError> {\n240\t        if self.traces.is_empty() {\n241\t            return Ok(DeviceBuffer::new());\n242\t        }\n243\t\n244\t        evaluate_mle_constraints_gpu_batch(\n245\t            &self.d_block_ctxs,\n246\t            &self.d_zc_ctxs,\n247\t            &self.air_offsets,\n248\t            lambda_pows,\n249\t            lambda_pows.len(),\n250\t            num_x,\n251\t            self.threads_per_block,\n252\t        )\n253\t    }\n254\t}\n255\t\n256\t/// Builder for batched logup MLE evaluation.\n257\t///\n258\t/// Collects traces and pre-builds all GPU contexts, then evaluates in a single kernel launch.\n259\tpub(crate) struct LogupMleBatchBuilder<'a> {\n260\t    traces: Vec<&'a TraceCtx>,\n261\t    d_block_ctxs: DeviceBuffer<BlockCtx>,\n262\t    d_logup_ctxs: DeviceBuffer<LogupCtx>,\n263\t    air_offsets: DeviceBuffer<u32>,\n264\t    threads_per_block: u32,\n265\t    _intermediates_keepalive: Vec<DeviceBuffer<EF>>,\n266\t}\n267\t\n268\timpl<'a> LogupMleBatchBuilder<'a> {\n269\t    /// Creates a new builder from an iterator of traces.\n270\t    ///\n271\t    /// This constructor filters traces with interactions, computes thread configuration,\n272\t    /// builds all block and logup contexts, and uploads them to the device.\n273\t    pub fn new<HS: GpuHashScheme>(\n274\t        traces: impl Iterator<Item = &'a TraceCtx>,\n275\t        pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n276\t        d_challenges_ptr: *const EF,\n277\t        num_x: u32,\n278\t    ) -> Result<Self, MemCopyError> {\n279\t        let traces: Vec<&TraceCtx> = traces.filter(|t| t.has_interactions).collect();\n280\t\n281\t        if traces.is_empty() {\n282\t            return Ok(Self {\n283\t                traces: vec![],\n284\t                d_block_ctxs: DeviceBuffer::new(),\n285\t                d_logup_ctxs: DeviceBuffer::new(),\n286\t                air_offsets: DeviceBuffer::new(),\n287\t                threads_per_block: 0,\n288\t                _intermediates_keepalive: vec![],\n289\t            });\n290\t        }\n291\t\n292\t        // Compute threads_per_block from max_num_y\n293\t        let max_num_y = traces.iter().map(|t| t.num_y).max().unwrap_or(0);\n294\t        let threads_per_block = max_num_y.min(MAX_THREADS_PER_BLOCK);\n295\t\n296\t        // Build block_ctxs and air_offsets\n297\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();\n298\t        let mut air_offsets: Vec<u32> = Vec::with_capacity(traces.len() + 1);\n299\t        air_offsets.push(0);\n300\t\n301\t        for (local_air, t) in traces.iter().enumerate() {\n302\t            let nb = t.num_y.div_ceil(threads_per_block);\n303\t            for b in 0..nb {\n304\t                block_ctxs_h.push(BlockCtx {\n305\t                    local_block_idx_x: b,\n306\t                    air_idx: local_air as u32,\n307\t                });\n308\t            }\n309\t            air_offsets.push(block_ctxs_h.len() as u32);\n310\t        }\n311\t\n312\t        // Build LogupCtx for each trace\n313\t        let mut intermediates_keepalive: Vec<DeviceBuffer<EF>> = Vec::new();\n314\t        let mut logup_ctxs_h: Vec<LogupCtx> = Vec::with_capacity(traces.len());\n315\t\n316\t        for t in traces.iter() {\n317\t            let air_pk = &pk.per_air[t.air_idx];\n318\t            let buffer_size = air_pk.other_data.interaction_rules.inner.buffer_size;\n319\t\n320\t            let d_intermediates = if buffer_size > 0 {\n321\t                let intermediates_len = unsafe {\n322\t                    _logup_batch_mle_intermediates_buffer_size(buffer_size, num_x, t.num_y)\n323\t                };\n324\t                let buf = DeviceBuffer::<EF>::with_capacity(intermediates_len);\n325\t                let ptr = buf.as_mut_ptr();\n326\t                intermediates_keepalive.push(buf);\n327\t                ptr\n328\t            } else {\n329\t                std::ptr::null_mut()\n330\t            };\n331\t\n332\t            let eval_ctx = EvalCoreCtx {\n333\t                d_selectors: t.sels_ptr,\n334\t                d_preprocessed: t.prep_ptr,\n335\t                d_main: t.main_ptrs_dev.as_ptr(),\n336\t                d_public: t.public_ptr,\n337\t            };\n338\t\n339\t            logup_ctxs_h.push(LogupCtx {\n340\t                eval_ctx,\n341\t                d_intermediates,\n342\t                num_y: t.num_y,\n343\t                d_eq_xi: t.eq_xi_ptr,\n344\t                d_challenges: d_challenges_ptr,\n345\t                d_eq_3bs: t.eq_3bs_ptr,\n346\t                d_rules: air_pk\n347\t                    .other_data\n348\t                    .interaction_rules\n349\t                    .inner\n350\t                    .d_rules\n351\t                    .as_raw_ptr(),\n352\t                rules_len: air_pk.other_data.interaction_rules.inner.d_rules.len(),\n353\t                d_used_nodes: air_pk\n354\t                    .other_data\n355\t                    .interaction_rules\n356\t                    .inner\n357\t                    .d_used_nodes\n358\t                    .as_ptr(),\n359\t                d_pair_idxs: air_pk.other_data.interaction_rules.d_pair_idxs.as_ptr(),\n360\t                used_nodes_len: air_pk.other_data.interaction_rules.inner.d_used_nodes.len(),\n361\t                buffer_size,\n362\t            });\n363\t        }\n364\t\n365\t        // Upload to device\n366\t        let d_block_ctxs = block_ctxs_h.to_device()?;\n367\t        let d_logup_ctxs = logup_ctxs_h.to_device()?;\n368\t        let air_offsets = air_offsets.to_device()?;\n369\t\n370\t        Ok(Self {\n371\t            traces,\n372\t            d_block_ctxs,\n373\t            d_logup_ctxs,\n374\t            air_offsets,\n375\t            threads_per_block,\n376\t            _intermediates_keepalive: intermediates_keepalive,\n377\t        })\n378\t    }\n379\t\n380\t    /// Returns true if there are no traces to evaluate.\n381\t    #[allow(dead_code)]\n382\t    pub fn is_empty(&self) -> bool {\n383\t        self.traces.is_empty()\n384\t    }\n385\t\n386\t    /// Returns the trace indices and norm factors in order.\n387\t    pub fn trace_info(&self) -> impl Iterator<Item = (usize, F)> + '_ {\n388\t        self.traces.iter().map(|t| (t.trace_idx, t.norm_factor))\n389\t    }\n390\t\n391\t    /// Evaluates the batch and returns the output device buffer.\n392\t    ///\n393\t    /// The buffer contains `num_airs * num_x` elements, laid out as\n394\t    /// `[air0_x0, air0_x1, ..., air1_x0, air1_x1, ...]`.\n395\t    pub fn evaluate(&self, num_x: u32) -> Result<DeviceBuffer<Frac<EF>>, KernelError> {\n396\t        if self.traces.is_empty() {\n397\t            return Ok(DeviceBuffer::new());\n398\t        }\n399\t\n400\t        evaluate_mle_interactions_gpu_batch(\n401\t            &self.d_block_ctxs,\n402\t            &self.d_logup_ctxs,\n403\t            &self.air_offsets,\n404\t            num_x,\n405\t            self.threads_per_block,\n406\t        )\n407\t    }\n408\t}\n409\t\n410\t// ============================================================================\n411\t// Memory-aware batched evaluation\n412\t// ============================================================================\n413\t\n414\tpub(crate) fn evaluate_zerocheck_batched<'a, HS: GpuHashScheme>(\n415\t    traces: impl IntoIterator<Item = &'a TraceCtx>,\n416\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n417\t    lambda_pows: &DeviceBuffer<EF>,\n418\t    num_x: u32,\n419\t    zc_out: &mut [Vec<EF>],\n420\t    memory_limit_bytes: usize,\n421\t) -> Result<(), KernelError> {\n422\t    // Collect traces with constraints and their buffer sizes\n423\t    let mut zc_traces_with_size: Vec<(&TraceCtx, usize)> = traces\n424\t        .into_iter()\n425\t        .filter(|t| t.has_constraints)\n426\t        .map(|t| {\n427\t            let buffer_size = pk.per_air[t.air_idx]\n428\t                .other_data\n429\t                .zerocheck_mle\n430\t                .inner\n431\t                .buffer_size;\n432\t            let mem = zerocheck_batch_mle_intermediates_buffer_bytes(buffer_size, num_x, t.num_y);\n433\t            (t, mem)\n434\t        })\n435\t        .collect();\n436\t    if zc_traces_with_size.is_empty() {\n437\t        return Ok(());\n438\t    }\n439\t\n440\t    // Sort by buffer size descending for better bin packing (First Fit Decreasing)\n441\t    zc_traces_with_size.sort_by(|a, b| b.1.cmp(&a.1));\n442\t\n443\t    let num_x_usize = num_x as usize;\n444\t    let mut batch_start = 0;\n445\t\n446\t    while batch_start < zc_traces_with_size.len() {\n447\t        let (batch_count, batch_memory) = find_batch_end(\n448\t            &zc_traces_with_size[batch_start..],\n449\t            |(_, mem)| *mem,\n450\t            memory_limit_bytes,\n451\t        );\n452\t        let batch: Vec<&TraceCtx> = zc_traces_with_size[batch_start..batch_start + batch_count]\n453\t            .iter()\n454\t            .map(|(t, _)| *t)\n455\t            .collect();\n456\t\n457\t        if batch.len() == 1 {\n458\t            // Single trace: use non-batch kernel\n459\t            let t = batch[0];\n460\t            if batch_memory > memory_limit_bytes {\n461\t                tracing::warn!(\n462\t                    air_idx = t.air_idx,\n463\t                    intermediate_buffer_bytes = batch_memory,\n464\t                    memory_limit_bytes,\n465\t                    \"zerocheck: trace exceeds memory limit, using non-batch kernel\"\n466\t                );\n467\t            }\n468\t            let rules = &pk.per_air[t.air_idx].other_data.zerocheck_mle;\n469\t            let out = evaluate_mle_constraints_gpu(\n470\t                t.eq_xi_ptr,\n471\t                t.sels_ptr,\n472\t                t.prep_ptr,\n473\t                &t.main_ptrs_dev,\n474\t                t.public_ptr,\n475\t                lambda_pows,\n476\t                rules,\n477\t                t.num_y,\n478\t                num_x,\n479\t            )?;\n480\t            let out_host = out.to_host()?;\n481\t            zc_out[t.trace_idx].copy_from_slice(&out_host);\n482\t        } else {\n483\t            // Normal batch using ZerocheckMleBatchBuilder\n484\t            tracing::debug!(\n485\t                batch_size = batch.len(),\n486\t                batch_memory,\n487\t                memory_limit_bytes,\n488\t                \"zerocheck: batching traces\"\n489\t            );\n490\t            let builder = ZerocheckMleBatchBuilder::new(batch.iter().copied(), pk, num_x)?;\n491\t            let out = builder.evaluate(lambda_pows, num_x)?;\n492\t            let host = out.to_host()?;\n493\t\n494\t            for (i, trace_idx) in builder.trace_indices().enumerate() {\n495\t                let evals = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n496\t                zc_out[trace_idx].copy_from_slice(evals);\n497\t            }\n498\t        }\n499\t        batch_start += batch_count;\n500\t    }\n501\t    Ok(())\n502\t}\n503\t\n504\t#[allow(clippy::too_many_arguments)]\n505\tpub(crate) fn evaluate_logup_batched<HS: GpuHashScheme>(\n506\t    traces: &[TraceCtx],\n507\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n508\t    d_challenges_ptr: *const EF,\n509\t    num_x: u32,\n510\t    monomial_num_y_threshold: u32,\n511\t    logup_combinations: &[Option<LogupCombinations>],\n512\t    logup_out: &mut [[Vec<EF>; 2]],\n513\t    logup_tilde_evals: &mut [[EF; 2]],\n514\t    memory_limit_bytes: usize,\n515\t) -> Result<(), KernelError> {\n516\t    let (low_traces, high_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) = traces\n517\t        .iter()\n518\t        .filter(|t| t.has_interactions)\n519\t        .partition(|t| t.num_y <= monomial_num_y_threshold);\n520\t\n521\t    if !low_traces.is_empty() {\n522\t        let logup_combs: Vec<_> = low_traces\n523\t            .iter()\n524\t            .map(|t| logup_combinations[t.trace_idx].as_ref().unwrap())\n525\t            .collect();\n526\t        let batch = LogupMonomialBatch::new(low_traces.iter().copied(), pk, &logup_combs)?;\n527\t        let out = batch.evaluate(num_x)?;\n528\t        let host = out.to_host()?;\n529\t        let num_x_usize = num_x as usize;\n530\t        for (i, trace_idx) in batch.trace_indices().enumerate() {\n531\t            let fracs = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n532\t            let norm = low_traces[i].norm_factor;\n533\t            if num_x == 1 {\n534\t                logup_tilde_evals[trace_idx][0] = fracs[0].p * norm;\n535\t                logup_tilde_evals[trace_idx][1] = fracs[0].q;\n536\t            } else {\n537\t                for (j, frac) in fracs.iter().enumerate() {\n538\t                    logup_out[trace_idx][0][j] = frac.p * norm;\n539\t                    logup_out[trace_idx][1][j] = frac.q;\n540\t                }\n541\t            }\n542\t        }\n543\t    }\n544\t\n545\t    if high_traces.is_empty() {\n546\t        return Ok(());\n547\t    }\n548\t\n549\t    // Collect high traces with interactions and their buffer sizes\n550\t    let mut logup_traces_with_size: Vec<(&TraceCtx, usize)> = high_traces\n551\t        .iter()\n552\t        .copied()\n553\t        .map(|t| {\n554\t            let buffer_size = pk.per_air[t.air_idx]\n555\t                .other_data\n556\t                .interaction_rules\n557\t                .inner\n558\t                .buffer_size;\n559\t            let mem = logup_batch_mle_intermediates_buffer_bytes(buffer_size, num_x, t.num_y);\n560\t            (t, mem)\n561\t        })\n562\t        .collect();\n563\t\n564\t    // Sort by buffer size descending for better bin packing (First Fit Decreasing)\n565\t    logup_traces_with_size.sort_by(|a, b| b.1.cmp(&a.1));\n566\t\n567\t    let num_x_usize = num_x as usize;\n568\t    let mut batch_start = 0;\n569\t\n570\t    while batch_start < logup_traces_with_size.len() {\n571\t        let (batch_count, batch_memory) = find_batch_end(\n572\t            &logup_traces_with_size[batch_start..],\n573\t            |(_, mem)| *mem,\n574\t            memory_limit_bytes,\n575\t        );\n576\t        let batch: Vec<&TraceCtx> = logup_traces_with_size[batch_start..batch_start + batch_count]\n577\t            .iter()\n578\t            .map(|(t, _)| *t)\n579\t            .collect();\n580\t\n581\t        if batch.len() == 1 && batch_memory > memory_limit_bytes {\n582\t            // Single oversized trace: use non-batch kernel\n583\t            let t = batch[0];\n584\t            tracing::warn!(\n585\t                air_idx = t.air_idx,\n586\t                intermediate_buffer_bytes = batch_memory,\n587\t                memory_limit_bytes,\n588\t                \"logup: trace exceeds memory limit, using non-batch kernel\"\n589\t            );\n590\t            evaluate_single_logup(\n591\t                t,\n592\t                pk,\n593\t                d_challenges_ptr,\n594\t                num_x,\n595\t                &mut logup_out[t.trace_idx],\n596\t                &mut logup_tilde_evals[t.trace_idx],\n597\t            )?;\n598\t        } else {\n599\t            // Normal batch using LogupMleBatchBuilder\n600\t            tracing::debug!(\n601\t                batch_size = batch.len(),\n602\t                batch_memory,\n603\t                memory_limit_bytes,\n604\t                \"logup: batching traces\"\n605\t            );\n606\t            let builder =\n607\t                LogupMleBatchBuilder::new(batch.iter().copied(), pk, d_challenges_ptr, num_x)?;\n608\t            let out = builder.evaluate(num_x)?;\n609\t            let host = out.to_host()?;\n610\t\n611\t            for (i, (trace_idx, norm_factor)) in builder.trace_info().enumerate() {\n612\t                let fracs = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n613\t                if num_x == 1 {\n614\t                    logup_tilde_evals[trace_idx][0] = fracs[0].p * norm_factor;\n615\t                    logup_tilde_evals[trace_idx][1] = fracs[0].q;\n616\t                } else {\n617\t                    let numer: Vec<EF> = fracs.iter().map(|f| f.p * norm_factor).collect();\n618\t                    let denom: Vec<EF> = fracs.iter().map(|f| f.q).collect();\n619\t                    logup_out[trace_idx] = [numer, denom];\n620\t                }\n621\t            }\n622\t        }\n623\t        batch_start += batch_count;\n624\t    }\n625\t    Ok(())\n626\t}\n627\t\n628\t/// Evaluate logup for a single trace using non-batch kernel.\n629\tfn evaluate_single_logup<HS: GpuHashScheme>(\n630\t    t: &TraceCtx,\n631\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n632\t    d_challenges_ptr: *const EF,\n633\t    num_x: u32,\n634\t    logup_out: &mut [Vec<EF>; 2],\n635\t    logup_tilde_eval: &mut [EF; 2],\n636\t) -> Result<(), KernelError> {\n637\t    let air_pk = &pk.per_air[t.air_idx];\n638\t    let out = evaluate_mle_interactions_gpu(\n639\t        t.eq_xi_ptr,\n640\t        t.sels_ptr,\n641\t        t.prep_ptr,\n642\t        &t.main_ptrs_dev,\n643\t        t.public_ptr,\n644\t        d_challenges_ptr,\n645\t        t.eq_3bs_ptr,\n646\t        &air_pk.other_data.interaction_rules,\n647\t        t.num_y,\n648\t        num_x,\n649\t    )?;\n650\t    let fracs = out.to_host()?;\n651\t\n652\t    if num_x == 1 {\n653\t        logup_tilde_eval[0] = fracs[0].p * t.norm_factor;\n654\t        logup_tilde_eval[1] = fracs[0].q;\n655\t        // logup_out not set, will be handled directly from tilde eval in compute_batch_s\n656\t    } else {\n657\t        let numer: Vec<EF> = fracs.iter().map(|f| f.p * t.norm_factor).collect();\n658\t        let denom: Vec<EF> = fracs.iter().map(|f| f.q).collect();\n659\t        *logup_out = [numer, denom];\n660\t    }\n661\t    Ok(())\n662\t}\n663\t\n664\t// ============================================================================\n665\t// FFI wrappers\n666\t// ============================================================================\n667\t\n668\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n669\tfn evaluate_mle_constraints_gpu_batch(\n670\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n671\t    zc_ctxs: &DeviceBuffer<ZerocheckCtx>,\n672\t    air_block_offsets: &DeviceBuffer<u32>,\n673\t    lambda_pows: &DeviceBuffer<EF>,\n674\t    lambda_len: usize,\n675\t    num_x: u32,\n676\t    threads_per_block: u32,\n677\t) -> Result<DeviceBuffer<EF>, KernelError> {\n678\t    let num_blocks = block_ctxs.len();\n679\t    let num_airs = zc_ctxs.len();\n680\t    tracing::debug!(\n681\t        %num_blocks,\n682\t        %num_x,\n683\t        %threads_per_block,\n684\t        %num_airs,\n685\t        \"zerocheck_batch_eval_mle\"\n686\t    );\n687\t    // Need one buffer slot per block\n688\t    let mut tmp_sums_buffer = DeviceBuffer::<EF>::with_capacity(num_blocks * num_x as usize);\n689\t    let mut output = DeviceBuffer::<EF>::with_capacity(num_airs * num_x as usize);\n690\t    unsafe {\n691\t        zerocheck_batch_eval_mle(\n692\t            &mut tmp_sums_buffer,\n693\t            &mut output,\n694\t            block_ctxs,\n695\t            zc_ctxs,\n696\t            air_block_offsets,\n697\t            lambda_pows,\n698\t            lambda_len,\n699\t            num_blocks as u32,\n700\t            num_x,\n701\t            num_airs as u32,\n702\t            threads_per_block,\n703\t        )?;\n704\t    }\n705\t    Ok(output)\n706\t}\n707\t\n708\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n709\tfn evaluate_mle_interactions_gpu_batch(\n710\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n711\t    logup_ctxs: &DeviceBuffer<LogupCtx>,\n712\t    air_block_offsets: &DeviceBuffer<u32>,\n713\t    num_x: u32,\n714\t    threads_per_block: u32,\n715\t) -> Result<DeviceBuffer<Frac<EF>>, KernelError> {\n716\t    let num_blocks = block_ctxs.len();\n717\t    let num_airs = logup_ctxs.len();\n718\t    // Ne