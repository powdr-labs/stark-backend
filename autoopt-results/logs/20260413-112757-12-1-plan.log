{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YLEWZfB7L2FPn2VWihwLm7","type":"tool_result","content":"1\t#include \"device_ntt.cuh\"\n2\t#include \"fp.h\"\n3\t#include \"fpext.h\"\n4\t#include \"frac_ext.cuh\"\n5\t#include \"launcher.cuh\"\n6\t#include \"sumcheck.cuh\"\n7\t#include \"utils.cuh\"\n8\t#include <algorithm>\n9\t#include <cassert>\n10\t#include <cmath>\n11\t#include <cstddef>\n12\t#include <cstdint>\n13\t#include <cuda_runtime.h>\n14\t#include <utility>\n15\t#include <vector_types.h>\n16\t\n17\tusing namespace device_ntt;\n18\t\n19\tnamespace {\n20\t\n21\tconstexpr uint32_t MAX_GRID_DIM = 65535u;\n22\t// S_DEG=2 for MLE sumcheck rounds (kept for backward compatibility)\n23\tconstexpr int S_DEG = 2;\n24\t// Number of G outputs per z in round 0 (SP_DEG=1): G0, G1, G2\n25\tconstexpr int NUM_G = 3;\n26\t\n27\t} // namespace\n28\t\n29\tstruct UnstackedSlice {\n30\t    uint32_t commit_idx;\n31\t    uint32_t log_height;\n32\t    uint32_t stacked_row_idx;\n33\t    uint32_t stacked_col_idx;\n34\t};\n35\t\n36\tstruct UnstackedPleFoldPacket {\n37\t    const Fp *__restrict__ src;\n38\t    FpExt *__restrict__ dst;\n39\t    uint32_t height;\n40\t    uint32_t width;\n41\t};\n42\t\n43\t// Descriptor for batched degenerate MLE round kernel\n44\tstruct DegenMleDesc {\n45\t    uint32_t col_offset;    // = window[0], indexes into unstacked_cols, eq_ub, lambda_pows\n46\t    uint32_t window_len;    // = window[1] - window[0]\n47\t    FpExt eq_r;             // from eq_stable[log_height]\n48\t    FpExt k_rot_r;          // from k_rot_stable[log_height]\n49\t};\n50\t\n51\t// Descriptor for batched non-degenerate MLE round kernel\n52\tstruct NonDegenMleDesc {\n53\t    uint32_t col_offset;    // = window[0]\n54\t    uint32_t window_len;    // = window[1] - window[0]\n55\t    uint32_t num_y;         // = 1 << (log_height - l_skip - round)\n56\t    uint32_t stride;        // auto-tuned grid.y from existing heuristic\n57\t    uint32_t blocks_x;      // = ceil(num_y / 256)\n58\t};\n59\t\n60\t__device__ __forceinline__ FpExt get_eq_cube(const FpExt *eq_r_ns, uint32_t cube_size, uint32_t x) {\n61\t    return eq_r_ns[cube_size + x];\n62\t}\n63\t\n64\t__device__ __forceinline__ uint32_t rot_prev(uint32_t x_int, uint32_t cube_size) {\n65\t    return x_int == 0 ? cube_size - 1 : x_int - 1;\n66\t}\n67\t\n68\t__device__ __forceinline__ Fp eq1(Fp x, Fp y) { return Fp::one() - x - y + Fp(2) * x * y; }\n69\t\n70\t__device__ __forceinline__ Fp barycentric_interpolate_strided(\n71\t    const Fp *evals,\n72\t    uint32_t evals_len,\n73\t    uint32_t z,\n74\t    uint32_t expansion_factor,     // large_domain / skip_domain\n75\t    const Fp *inv_lagrange_denoms, // denoms specifically for z\n76\t    const Fp *omega_skip_pows,\n77\t    uint32_t skip_domain\n78\t) {\n79\t    Fp q = Fp::zero();\n80\t    uint32_t stride = evals_len >= skip_domain ? 1 : skip_domain / evals_len;\n81\t    if (z % expansion_factor == 0) {\n82\t        auto i = z / expansion_factor;\n83\t        if (i % stride == 0)\n84\t            q = evals[i / stride];\n85\t    } else {\n86\t        for (int idx = 0; idx < (skip_domain / stride); idx++) {\n87\t            q += evals[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n88\t        }\n89\t    }\n90\t    return q;\n91\t}\n92\t\n93\t// SP_DEG=1 kernel: compute 3 partial sums G0, G1, G2 on identity coset only.\n94\t// No iNTT/NTT operations - reconstruction happens on CPU via NTT-based polynomial multiplication.\n95\t//\n96\t// Each block covers a tile of z-values (threadIdx.x) and collaborates across threads\n97\t// to sum over x for a single column. Blocks stride over columns via gridDim.y.\n98\t//\n99\t// G0(Z) = Σ_{col,x} coeff_eq[col] * eq_cube(x) * q_{col,x}(Z)\n100\t// G1(Z) = Σ_{col,x} coeff_rot[col] * eq_cube(x) * q_{col,x}(Z)"}]},"parent_tool_use_id":"toolu_01Mbp87kmfeYJrs74YMzD239","session_id":"50386b42-eb75-4189-9b73-2a1359832805","uuid":"5a9f1eec-7475-4292-879e-a01d454eee90","timestamp":"2026-04-13T09:35:41.117Z"}
