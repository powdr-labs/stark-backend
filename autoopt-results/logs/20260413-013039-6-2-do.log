{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S6ydX61agkoaKAWbC5xheQ","type":"tool_result","content":"1\t/*\n2\t * Source: https://github.com/scroll-tech/plonky3-gpu (private repo)\n3\t * Status: BASED ON plonky3-gpu/gpu-backend/src/cuda/kernels/matrix.cu\n4\t * Imported: 2025-01-25 by @gaxiom\n5\t */\n6\t\n7\t#include \"fp.h\"\n8\t#include \"fpext.h\"\n9\t#include \"launcher.cuh\"\n10\t#include <algorithm>\n11\t#include <cassert>\n12\t#include <cstdint>\n13\t#include <utility>\n14\t\n15\tconst size_t TILE_SIZE = 32; // do not change,\n16\t// const uint64_t GROUP_SIZE = 32; // do not change,\n17\t\n18\ttemplate <typename T>\n19\t__global__ void __launch_bounds__(\n20\t    TILE_SIZE\n21\t) matrix_transpose_kernel(T *output, const T *input, size_t col_size, size_t row_size) {\n22\t\n23\t    // NOTE: This is what builds, we need to use this for clang-tidy to work\n24\t    // __shared__ T s_mem[TILE_SIZE][TILE_SIZE + 1];\n25\t    __shared__ __align__(\n26\t        alignof(T)\n27\t    ) unsigned char s_mem_raw[TILE_SIZE * (TILE_SIZE + 1) * sizeof(T)];\n28\t    T(*s_mem)[TILE_SIZE + 1] = reinterpret_cast<T(*)[TILE_SIZE + 1]>(s_mem_raw);\n29\t\n30\t    size_t dim_x = (col_size + TILE_SIZE - 1) / TILE_SIZE;\n31\t    size_t bid = blockIdx.x; // (x, 1, 1)\n32\t    size_t bid_y = bid / dim_x;\n33\t    size_t bid_x = bid % dim_x; // (bid_x, bid_y, 1)\n34\t\n35\t    size_t tid = threadIdx.x;\n36\t    size_t index_i = bid_y * TILE_SIZE * col_size + bid_x * TILE_SIZE + tid;\n37\t    size_t index_o = bid_x * TILE_SIZE * row_size + bid_y * TILE_SIZE + tid;\n38\t\n39\t    // input\n40\t    bool boundray_column = bid_x * TILE_SIZE + tid < col_size;\n41\t    size_t row_offset = bid_y * TILE_SIZE + 0;\n42\t    for (auto i = 0; i < TILE_SIZE; ++i) {\n43\t        bool boundray = boundray_column && (row_offset + i < row_size);\n44\t        s_mem[i][tid] = (boundray) ? input[index_i + i * col_size] : T(0);\n45\t    }\n46\t    __syncthreads();\n47\t\n48\t    // output\n49\t    boundray_column = bid_y * TILE_SIZE + tid < row_size;\n50\t    row_offset = bid_x * TILE_SIZE + 0;\n51\t    for (auto i = 0; i < TILE_SIZE; ++i) {\n52\t        bool boundray = boundray_column && (row_offset + i < col_size);\n53\t        if (boundray)\n54\t            output[index_o + i * row_size] = s_mem[tid][i];\n55\t    }\n56\t}\n57\t\n58\t// Explicit instantiations\n59\ttemplate __global__ void matrix_transpose_kernel<Fp>(Fp *, const Fp *, size_t, size_t);\n60\ttemplate __global__ void matrix_transpose_kernel<FpExt>(FpExt *, const FpExt *, size_t, size_t);\n61\t\n62\t__global__ void matrix_get_rows_fp_kernel(\n63\t    Fp *__restrict__ output,\n64\t    const Fp *__restrict__ input,\n65\t    uint32_t *__restrict__ row_indices,\n66\t    uint64_t matrix_width,\n67\t    uint64_t matrix_height\n68\t) {\n69\t    uint32_t col_idx = blockIdx.x * blockDim.x + threadIdx.x;\n70\t    if (col_idx >= matrix_width) {\n71\t        return;\n72\t    }\n73\t    // Note: blockIdx.y may >= matrix_height, do not assert\n74\t\n75\t    uint64_t input_row = row_indices[blockIdx.y];\n76\t    uint64_t output_row = blockIdx.y;\n77\t    uint64_t input_idx = col_idx * matrix_height + input_row;  // col-major matrix\n78\t    uint64_t output_idx = output_row * matrix_width + col_idx; // row-major matrix\n79\t    output[output_idx] = input[input_idx];\n80\t}\n81\t\n82\t__global__ void split_ext_to_base_col_major_matrix_kernel(\n83\t    Fp *__restrict__ d_matrix,\n84\t    const FpExt *__restrict__ d_poly,\n85\t    uint64_t poly_len,\n86\t    uint32_t matrix_height\n87\t) {\n88\t    uint32_t row_idx = blockIdx.x * blockDim.x + threadIdx.x;\n89\t    if (row_idx >= matrix_height) {\n90\t        return;\n91\t    }\n92\t\n93\t    uint32_t col_num = (poly_len / matrix_height); // SPLIT_FACTOR = 2\n94\t    for (uint32_t col_idx = 0; col_idx < col_num; col_idx++) {\n95\t        FpExt ext_val = d_poly[col_idx * matrix_height + row_idx];\n96\t        d_matrix[(col_idx * 4 + 0) * matrix_height + row_idx] = ext_val.elems[0];\n97\t        d_matrix[(col_idx * 4 + 1) * matrix_height + row_idx] = ext_val.elems[1];\n98\t        d_matrix[(col_idx * 4 + 2) * matrix_height + row_idx] = ext_val.elems[2];\n99\t        d_matrix[(col_idx * 4 + 3) * matrix_height + row_idx] = ext_val.elems[3];\n100\t    }\n101\t}\n102\t\n103\t// `in` has width equal to `width` and height `domain_size * num_x`.\n104\t// `out` has width equal to `width` and height `padded_size * num_x`.\n105\t//\n106\t// CAUTION: rotation is with respect to `domain_size * num_x`, but padding is with respect to `domain_size` to `padded_size`.\n107\t__global__ void batch_rotate_pad_kernel(\n108\t    Fp *__restrict__ out,\n109\t    const Fp *__restrict__ in,\n110\t    uint32_t width,\n111\t    uint32_t num_x,\n112\t    uint32_t domain_size,\n113\t    uint32_t padded_size\n114\t) {\n115\t    auto tidx = threadIdx.x + blockIdx.x * blockDim.x;\n116\t    auto pidx = blockIdx.y + blockIdx.z * gridDim.y;\n117\t\n118\t    if (pidx >= width * num_x) {\n119\t        return;\n120\t    }\n121\t    if (tidx < domain_size) {\n122\t        auto tidx_rot = tidx + 1;\n123\t        auto pidx_rot = pidx;\n124\t        if (tidx_rot == domain_size) {\n125\t            tidx_rot = 0;\n126\t            pidx_rot += 1;\n127\t            // NOTE: rotation is over `domain_size * num_x`\n128\t            if (pidx_rot % num_x == 0) {\n129\t                pidx_rot -= num_x;\n130\t            }\n131\t        }\n132\t        out[padded_size * pidx + tidx] = in[domain_size * pidx_rot + tidx_rot];\n133\t    } else if (tidx < padded_size) {\n134\t        out[padded_size * pidx + tidx] = Fp(0);\n135\t    }\n136\t}\n137\t\n138\t// `matrix` is `padded_height x width` matrix.\n139\t// This kernel cyclically repeats the first `height` rows of the matrix vertically for `lifted_height` rows.\n140\t// The rows `lifted_height..padded_height` are left untouched.\n141\t__global__ void lift_padded_matrix_evals_kernel(\n142\t    Fp *__restrict__ matrix,\n143\t    uint32_t width,\n144\t    uint32_t height,\n145\t    uint32_t lifted_height,\n146\t    uint32_t padded_height\n147\t) {\n148\t    auto tidx = threadIdx.x + blockIdx.x * blockDim.x;\n149\t    auto col = threadIdx.y + blockIdx.y * blockDim.y;\n150\t    if (tidx >= lifted_height || col >= width) {\n151\t        return;\n152\t    }\n153\t    // lhs = rhs when tidx < height\n154\t    matrix[col * padded_height + tidx] = matrix[col * padded_height + (tidx % height)];\n155\t}\n156\t\n157\t// Required: lifted_height = height * stride\n158\t__global__ void collapse_strided_matrix_kernel(\n159\t    Fp *__restrict__ out,\n160\t    const Fp *__restrict__ in,\n161\t    const uint32_t width,\n162\t    const uint32_t lifted_height,\n163\t    const uint32_t height,\n164\t    const uint32_t stride\n165\t) {\n166\t    auto row = threadIdx.x + blockIdx.x * blockDim.x;\n167\t    auto col = threadIdx.y + blockIdx.y * blockDim.y;\n168\t    if (row >= height || col >= width) {\n169\t        return;\n170\t    }\n171\t\n172\t    out[col * height + row] = in[col * lifted_height + row * stride];\n173\t}\n174\t\n175\t// memory layout of in: column-major\n176\t// if polyCount = 4, then the layout of in is expected to be\n177\t// in:  |  poly0  |  poly1  |  poly2  |  poly3  |\n178\t//\n179\t// if outSize / inSize = 2, then the layout of out is expected to be\n180\t// out: |  poly0  |    0    |  poly1  |    0    |   poly2  |    0    |  poly3  |    0    |\n181\t__global__ void batch_expand_pad_kernel(\n182\t    Fp *out,\n183\t    const Fp *in,\n184\t    const uint32_t polyCount,\n185\t    const uint32_t outSize,\n186\t    const uint32_t inSize\n187\t) {\n188\t    uint idx = blockIdx.x * blockDim.x + threadIdx.x;\n189\t    if (idx < outSize) {\n190\t        for (uint32_t i = 0; i < polyCount; i++) {\n191\t            Fp res = Fp(0);\n192\t            if (idx < inSize) {\n193\t                res = in[i * inSize + idx];\n194\t            }\n195\t            out[i * outSize + idx] = res;\n196\t        }\n197\t    }\n198\t}\n199\t\n200\t// `out` is `padded_height x width` column-major matrix.\n201\t// `in` is `height x width` column-major matrix.\n202\t//\n203\t// This kernel is for use when `width` is large (~2^20) while `height` is small (<2^10)\n204\t__global__ void batch_expand_pad_wide_kernel(\n205\t    Fp *__restrict__ out,\n206\t    const Fp *__restrict__ in,\n207\t    const uint32_t width,\n208\t    const uint32_t padded_height,\n209\t    const uint32_t height\n210\t) {\n211\t    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;\n212\t    uint32_t col = blockIdx.y + blockIdx.z * gridDim.y;\n213\t    if (col >= width) {\n214\t        return;\n215\t    }\n216\t    if (row < height) {\n217\t        out[col * padded_height + row] = in[col * height + row];\n218\t    } else if (row < padded_height) {\n219\t        out[col * padded_height + row] = Fp(0);\n220\t    }\n221\t}\n222\t\n223\t// ============================================================================\n224\t// LAUNCHERS\n225\t// ============================================================================\n226\t\n227\tconstexpr uint32_t MAX_GRID_DIM = 65535u;\n228\t\n229\ttemplate <typename T>\n230\tint matrix_transpose_impl(T *output, const T *input, size_t col_size, size_t row_size) {\n231\t    uint32_t grid_x = (col_size + TILE_SIZE - 1) / TILE_SIZE;\n232\t    uint32_t grid_y = (row_size + TILE_SIZE - 1) / TILE_SIZE;\n233\t\n234\t    dim3 grid(grid_x * grid_y);\n235\t    dim3 block(TILE_SIZE);\n236\t\n237\t    matrix_transpose_kernel<T><<<grid, block>>>(output, input, col_size, row_size);\n238\t\n239\t    return CHECK_KERNEL();\n240\t}\n241\t\n242\textern \"C\" int _matrix_transpose_fp(Fp *output, const Fp *input, size_t col_size, size_t row_size) {\n243\t    return matrix_transpose_impl(output, input, col_size, row_size);\n244\t}\n245\t\n246\textern \"C\" int _matrix_transpose_fpext(\n247\t    FpExt *output,\n248\t    const FpExt *input,\n249\t    size_t col_size,\n250\t    size_t row_size\n251\t) {\n252\t    return matrix_transpose_impl(output, input, col_size, row_size);\n253\t}\n254\t\n255\textern \"C\" int _matrix_get_rows_fp(\n256\t    Fp *output,\n257\t    const Fp *input,\n258\t    uint32_t *row_indices,\n259\t    uint64_t matrix_width,\n260\t    uint64_t matrix_height,\n261\t    uint32_t row_indices_len\n262\t) {\n263\t    auto block = WARP_SIZE;\n264\t    dim3 grid = dim3(div_ceil(matrix_width, WARP_SIZE), row_indices_len);\n265\t    matrix_get_rows_fp_kernel<<<grid, block>>>(\n266\t        output, input, row_indices, matrix_width, matrix_height\n267\t    );\n268\t    return CHECK_KERNEL();\n269\t}\n270\t\n271\textern \"C\" int _split_ext_to_base_col_major_matrix(\n272\t    Fp *d_matrix,\n273\t    FpExt *d_poly,\n274\t    uint64_t poly_len,\n275\t    uint32_t matrix_height\n276\t) {\n277\t    auto [grid, block] = kernel_launch_params(matrix_height);\n278\t    split_ext_to_base_col_major_matrix_kernel<<<grid, block>>>(\n279\t        d_matrix, d_poly, poly_len, matrix_height\n280\t    );\n281\t    return CHECK_KERNEL();\n282\t}\n283\t\n284\textern \"C\" int _batch_rotate_pad(\n285\t    Fp *out,\n286\t    const Fp *in,\n287\t    uint32_t width,\n288\t    uint32_t num_x, // = (in.height() / domain_size)\n289\t    uint32_t domain_size,\n290\t    uint32_t padded_size\n291\t) {\n292\t    auto [grid, block] = kernel_launch_params(padded_size);\n293\t    auto num_poly = width * num_x;\n294\t    grid.y = std::min(num_poly, MAX_GRID_DIM);\n295\t    grid.z = (num_poly + grid.y - 1) / grid.y;\n296\t    batch_rotate_pad_kernel<<<grid, block>>>(out, in, width, num_x, domain_size, padded_size);\n297\t    return CHECK_KERNEL();\n298\t}\n299\t\n300\textern \"C\" int _lift_padded_matrix_evals(\n301\t    Fp *matrix,\n302\t    uint32_t width,\n303\t    uint32_t height,\n304\t    uint32_t lifted_height,\n305\t    uint32_t padded_height\n306\t) {\n307\t    auto [grid, block] = kernel_launch_2d_params(lifted_height, width);\n308\t    lift_padded_matrix_evals_kernel<<<grid, block>>>(\n309\t        matrix, width, height, lifted_height, padded_height\n310\t    );\n311\t    return CHECK_KERNEL();\n312\t}\n313\t\n314\textern \"C\" int _collapse_strided_matrix(\n315\t    Fp *out,\n316\t    const Fp *in,\n317\t    uint32_t width,\n318\t    uint32_t height,\n319\t    uint32_t stride\n320\t) {\n321\t    auto lifted_height = height * stride;\n322\t    auto [grid, block] = kernel_launch_2d_params(height, width);\n323\t    collapse_strided_matrix_kernel<<<grid, block>>>(out, in, width, lifted_height, height, stride);\n324\t    return CHECK_KERNEL();\n325\t}\n326\t\n327\textern \"C\" int _batch_expand_pad(\n328\t    Fp *out,\n329\t    const Fp *in,\n330\t    const uint32_t polyCount,\n331\t    const uint32_t outSize,\n332\t    const uint32_t inSize\n333\t) {\n334\t    auto [grid, block] = kernel_launch_params(outSize);\n335\t    batch_expand_pad_kernel<<<grid, block>>>(out, in, polyCount, outSize, inSize);\n336\t    return CHECK_KERNEL();\n337\t}\n338\t\n339\textern \"C\" int _batch_expand_pad_wide(\n340\t    Fp *out,\n341\t    const Fp *in,\n342\t    const uint32_t width,\n343\t    const uint32_t padded_height,\n344\t    const uint32_t height\n345\t) {\n346\t    auto [grid, block] = kernel_launch_params(padded_height);\n347\t    grid.y = std::min(width, MAX_GRID_DIM);\n348\t    grid.z = (width + grid.y - 1) / grid.y;\n349\t    assert(grid.z <= MAX_GRID_DIM);\n350\t    batch_expand_pad_wide_kernel<<<grid, block>>>(out, in, width, padded_height, height);\n351\t    return CHECK_KERNEL();\n352\t}\n353\t"}]},"parent_tool_use_id":null,"session_id":"109f4277-ba9b-4e1c-bdb7-77d4d7ca6555","uuid":"4f5c7ee4-b381-4fc2-8031-225e5eb16906","timestamp":"2026-04-13T00:05:22.508Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/cuda/src/matrix.cu","content":"/*\n * Source: https://github.com/scroll-tech/plonky3-gpu (private repo)\n * Status: BASED ON plonky3-gpu/gpu-backend/src/cuda/kernels/matrix.cu\n * Imported: 2025-01-25 by @gaxiom\n */\n\n#include \"fp.h\"\n#include \"fpext.h\"\n#include \"launcher.cuh\"\n#include <algorithm>\n#include <cassert>\n#include <cstdint>\n#include <utility>\n\nconst size_t TILE_SIZE = 32; // do not change,\n// const uint64_t GROUP_SIZE = 32; // do not change,\n\ntemplate <typename T>\n__global__ void __launch_bounds__(\n    TILE_SIZE\n) matrix_transpose_kernel(T *output, const T *input, size_t col_size, size_t row_size) {\n\n    // NOTE: This is what builds, we need to use this for clang-tidy to work\n    // __shared__ T s_mem[TILE_SIZE][TILE_SIZE + 1];\n    __shared__ __align__(\n        alignof(T)\n    ) unsigned char s_mem_raw[TILE_SIZE * (TILE_SIZE + 1) * sizeof(T)];\n    T(*s_mem)[TILE_SIZE + 1] = reinterpret_cast<T(*)[TILE_SIZE + 1]>(s_mem_raw);\n\n    size_t dim_x = (col_size + TILE_SIZE - 1) / TILE_SIZE;\n    size_t bid = blockIdx.x; // (x, 1, 1)\n    size_t bid_y = bid / dim_x;\n    size_t bid_x = bid % dim_x; // (bid_x, bid_y, 1)\n\n    size_t tid = threadIdx.x;\n    size_t index_i = bid_y * TILE_SIZE * col_size + bid_x * TILE_SIZE + tid;\n    size_t index_o = bid_x * TILE_SIZE * row_size + bid_y * TILE_SIZE + tid;\n\n    // input\n    bool boundray_column = bid_x * TILE_SIZE + tid < col_size;\n    size_t row_offset = bid_y * TILE_SIZE + 0;\n    for (auto i = 0; i < TILE_SIZE; ++i) {\n        bool boundray = boundray_column && (row_offset + i < row_size);\n        s_mem[i][tid] = (boundray) ? input[index_i + i * col_size] : T(0);\n    }\n    __syncthreads();\n\n    // output\n    boundray_column = bid_y * TILE_SIZE + tid < row_size;\n    row_offset = bid_x * TILE_SIZE + 0;\n    for (auto i = 0; i < TILE_SIZE; ++i) {\n        bool boundray = boundray_column && (row_offset + i < col_size);\n        if (boundray)\n            output[index_o + i * row_size] = s_mem[tid][i];\n    }\n}\n\n// Explicit instantiations\ntemplate __global__ void matrix_transpose_kernel<Fp>(Fp *, const Fp *, size_t, size_t);\ntemplate __global__ void matrix_transpose_kernel<FpExt>(FpExt *, const FpExt *, size_t, size_t);\n\n__global__ void matrix_get_rows_fp_kernel(\n    Fp *__restrict__ output,\n    const Fp *__restrict__ input,\n    uint32_t *__restrict__ row_indices,\n    uint64_t matrix_width,\n    uint64_t matrix_height\n) {\n    uint32_t col_idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (col_idx >= matrix_width) {\n        return;\n    }\n    // Note: blockIdx.y may >= matrix_height, do not assert\n\n    uint64_t input_row = row_indices[blockIdx.y];\n    uint64_t output_row = blockIdx.y;\n    uint64_t input_idx = col_idx * matrix_height + input_row;  // col-major matrix\n    uint64_t output_idx = output_row * matrix_width + col_idx; // row-major matrix\n    output[output_idx] = input[input_idx];\n}\n\n__global__ void split_ext_to_base_col_major_matrix_kernel(\n    Fp *__restrict__ d_matrix,\n    const FpExt *__restrict__ d_poly,\n    uint64_t poly_len,\n    uint32_t matrix_height\n) {\n    uint32_t row_idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (row_idx >= matrix_height) {\n        return;\n    }\n\n    uint32_t col_num = (poly_len / matrix_height); // SPLIT_FACTOR = 2\n    for (uint32_t col_idx = 0; col_idx < col_num; col_idx++) {\n        FpExt ext_val = d_poly[col_idx * matrix_height + row_idx];\n        d_matrix[(col_idx * 4 + 0) * matrix_height + row_idx] = ext_val.elems[0];\n        d_matrix[(col_idx * 4 + 1) * matrix_height + row_idx] = ext_val.elems[1];\n        d_matrix[(col_idx * 4 + 2) * matrix_height + row_idx] = ext_val.elems[2];\n        d_matrix[(col_idx * 4 + 3) * matrix_height + row_idx] = ext_val.elems[3];\n    }\n}\n\n// `in` has width equal to `width` and height `domain_size * num_x`.\n// `out` has width equal to `width` and height `padded_size * num_x`.\n//\n// CAUTION: rotation is with respect to `domain_size * num_x`, but padding is with respect to `domain_size` to `padded_size`.\n__global__ void batch_rotate_pad_kernel(\n    Fp *__restrict__ out,\n    const Fp *__restrict__ in,\n    uint32_t width,\n    uint32_t num_x,\n    uint32_t domain_size,\n    uint32_t padded_size\n) {\n    auto tidx = threadIdx.x + blockIdx.x * blockDim.x;\n    auto pidx = blockIdx.y + blockIdx.z * gridDim.y;\n\n    if (pidx >= width * num_x) {\n        return;\n    }\n    if (tidx < domain_size) {\n        auto tidx_rot = tidx + 1;\n        auto pidx_rot = pidx;\n        if (tidx_rot == domain_size) {\n            tidx_rot = 0;\n            pidx_rot += 1;\n            // NOTE: rotation is over `domain_size * num_x`\n            if (pidx_rot % num_x == 0) {\n                pidx_rot -= num_x;\n            }\n        }\n        out[padded_size * pidx + tidx] = in[domain_size * pidx_rot + tidx_rot];\n    } else if (tidx < padded_size) {\n        out[padded_size * pidx + tidx] = Fp(0);\n    }\n}\n\n// `matrix` is `padded_height x width` matrix.\n// This kernel cyclically repeats the first `height` rows of the matrix vertically for `lifted_height` rows.\n// The rows `lifted_height..padded_height` are left untouched.\n__global__ void lift_padded_matrix_evals_kernel(\n    Fp *__restrict__ matrix,\n    uint32_t width,\n    uint32_t height,\n    uint32_t lifted_height,\n    uint32_t padded_height\n) {\n    auto tidx = threadIdx.x + blockIdx.x * blockDim.x;\n    auto col = threadIdx.y + blockIdx.y * blockDim.y;\n    if (tidx >= lifted_height || col >= width) {\n        return;\n    }\n    // lhs = rhs when tidx < height\n    matrix[col * padded_height + tidx] = matrix[col * padded_height + (tidx % height)];\n}\n\n// Required: lifted_height = height * stride\n__global__ void collapse_strided_matrix_kernel(\n    Fp *__restrict__ out,\n    const Fp *__restrict__ in,\n    const uint32_t width,\n    const uint32_t lifted_height,\n    const uint32_t height,\n    const uint32_t stride\n) {\n    auto row = threadIdx.x + blockIdx.x * blockDim.x;\n    auto col = threadIdx.y + blockIdx.y * blockDim.y;\n    if (row >= height || col >= width) {\n        return;\n    }\n\n    out[col * height + row] = in[col * lifted_height + row * stride];\n}\n\n// memory layout of in: column-major\n// if polyCount = 4, then the layout of in is expected to be\n// in:  |  poly0  |  poly1  |  poly2  |  poly3  |\n//\n// if outSize / inSize = 2, then the layout of out is expected to be\n// out: |  poly0  |    0    |  poly1  |    0    |   poly2  |    0    |  poly3  |    0    |\n__global__ void batch_expand_pad_kernel(\n    Fp *out,\n    const Fp *in,\n    const uint32_t polyCount,\n    const uint32_t outSize,\n    const uint32_t inSize\n) {\n    uint idx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (idx < outSize) {\n        for (uint32_t i = 0; i < polyCount; i++) {\n            Fp res = Fp(0);\n            if (idx < inSize) {\n                res = in[i * inSize + idx];\n            }\n            out[i * outSize + idx] = res;\n        }\n    }\n}\n\n// `out` is `padded_height x width` column-major matrix.\n// `in` is `height x width` column-major matrix.\n//\n// This kernel is for use when `width` is large (~2^20) while `height` is small (<2^10)\n__global__ void batch_expand_pad_wide_kernel(\n    Fp *__restrict__ out,\n    const Fp *__restrict__ in,\n    const uint32_t width,\n    const uint32_t padded_height,\n    const uint32_t height\n) {\n    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;\n    uint32_t col = blockIdx.y + blockIdx.z * gridDim.y;\n    if (col >= width) {\n        return;\n    }\n    if (row < height) {\n        out[col * padded_height + row] = in[col * height + row];\n    } else if (row < padded_height) {\n        out[col * padded_height + row] = Fp(0);\n    }\n}\n\n// ============================================================================\n// LAUNCHERS\n// ============================================================================\n\nconstexpr uint32_t MAX_GRID_DIM = 65535u;\n\ntemplate <typename T>\nint matrix_transpose_impl(T *output, const T *input, size_t col_size, size_t row_size) {\n    uint32_t grid_x = (col_size + TILE_SIZE - 1) / TILE_SIZE;\n    uint32_t grid_y = (row_size + TILE_SIZE - 1) / TILE_SIZE;\n\n    dim3 grid(grid_x * grid_y);\n    dim3 block(TILE_SIZE);\n\n    matrix_transpose_kernel<T><<<grid, block>>>(output, input, col_size, row_size);\n\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _matrix_transpose_fp(Fp *output, const Fp *input, size_t col_size, size_t row_size) {\n    return matrix_transpose_impl(output, input, col_size, row_size);\n}\n\nextern \"C\" int _matrix_transpose_fpext(\n    FpExt *output,\n    const FpExt *input,\n    size_t col_size,\n    size_t row_size\n) {\n    return matrix_transpose_impl(output, input, col_size, row_size);\n}\n\nextern \"C\" int _matrix_get_rows_fp(\n    Fp *output,\n    const Fp *input,\n    uint32_t *row_indices,\n    uint64_t matrix_width,\n    uint64_t matrix_height,\n    uint32_t row_indices_len\n) {\n    auto block = WARP_SIZE;\n    dim3 grid = dim3(div_ceil(matrix_width, WARP_SIZE), row_indices_len);\n    matrix_get_rows_fp_kernel<<<grid, block>>>(\n        output, input, row_indices, matrix_width, matrix_height\n    );\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _split_ext_to_base_col_major_matrix(\n    Fp *d_matrix,\n    FpExt *d_poly,\n    uint64_t poly_len,\n    uint32_t matrix_height\n) {\n    auto [grid, block] = kernel_launch_params(matrix_height);\n    split_ext_to_base_col_major_matrix_kernel<<<grid, block>>>(\n        d_matrix, d_poly, poly_len, matrix_height\n    );\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _batch_rotate_pad(\n    Fp *out,\n    const Fp *in,\n    uint32_t width,\n    uint32_t num_x, // = (in.height() / domain_size)\n    uint32_t domain_size,\n    uint32_t padded_size\n) {\n    auto [grid, block] = kernel_launch_params(padded_size);\n    auto num_poly = width * num_x;\n    grid.y = std::min(num_poly, MAX_GRID_DIM);\n    grid.z = (num_poly + grid.y - 1) / grid.y;\n    batch_rotate_pad_kernel<<<grid, block>>>(out, in, width, num_x, domain_size, padded_size);\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _lift_padded_matrix_evals(\n    Fp *matrix,\n    uint32_t width,\n    uint32_t height,\n    uint32_t lifted_height,\n    uint32_t padded_height\n) {\n    auto [grid, block] = kernel_launch_2d_params(lifted_height, width);\n    lift_padded_matrix_evals_kernel<<<grid, block>>>(\n        matrix, width, height, lifted_height, padded_height\n    );\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _collapse_strided_matrix(\n    Fp *out,\n    const Fp *in,\n    uint32_t width,\n    uint32_t height,\n    uint32_t stride\n) {\n    auto lifted_height = height * stride;\n    auto [grid, block] = kernel_launch_2d_params(height, width);\n    collapse_strided_matrix_kernel<<<grid, block>>>(out, in, width, lifted_height, height, stride);\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _batch_expand_pad(\n    Fp *out,\n    const Fp *in,\n    const uint32_t polyCount,\n    const uint32_t outSize,\n    const uint32_t inSize\n) {\n    auto [grid, block] = kernel_launch_params(outSize);\n    batch_expand_pad_kernel<<<grid, block>>>(out, in, polyCount, outSize, inSize);\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _batch_expand_pad_wide(\n    Fp *out,\n    const Fp *in,\n    const uint32_t width,\n    const uint32_t padded_height,\n    const uint32_t height\n) {\n    auto [grid, block] = kernel_launch_params(padded_height);\n    grid.y = std::min(width, MAX_GRID_DIM);\n    grid.z = (width + grid.y - 1) / grid.y;\n    assert(grid.z <= MAX_GRID_DIM);\n    batch_expand_pad_wide_kernel<<<grid, block>>>(out, in, width, padded_height, height);\n    return CHECK_KERNEL();\n}\n","numLines":353,"startLine":1,"totalLines":353}}}
