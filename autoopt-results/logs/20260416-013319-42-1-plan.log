{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MeAsLUuREZK6GDrA34FZXT","type":"tool_result","content":"1\t/// BN254 Poseidon2 CUDA kernels.\n2\t///\n3\t/// All BN254 code lives in this single translation unit to avoid device-side\n4\t/// linkage issues with `static __device__` variables.\n5\t///\n6\t/// Entry points (called from Rust via FFI):\n7\t///   _init_bn254_poseidon2_rc         - Upload round constants from Rust\n8\t///   _bn254_poseidon2_compressing_row_hashes     - Merkle leaf hashes (F matrix)\n9\t///   _bn254_poseidon2_compressing_row_hashes_ext - Merkle leaf hashes (EF matrix)\n10\t///   _bn254_poseidon2_adjacent_compress_layer    - Merkle internal compress\n11\t///   _bn254_sponge_grind              - PoW grinding for BN254 transcript\n12\t\n13\t#include \"poseidon2_bn254.cuh\"\n14\t#include \"fp.h\"\n15\t#include \"fpext.h\"\n16\t#include \"launcher.cuh\"\n17\t#include <cstdint>\n18\t\n19\t// ---------------------------------------------------------------------------\n20\t// Round constant device memory (filled by _init_bn254_poseidon2_rc)\n21\t// ---------------------------------------------------------------------------\n22\t\n23\t/// External initial round constants: 4 rounds × 3 elements\n24\t__device__ __constant__ Bn254Fr g_initial_rc[4][3];\n25\t\n26\t/// Internal (partial) round constants: 56 rounds × 1 element (for state[0] only)\n27\t__device__ __constant__ Bn254Fr g_partial_rc[56];\n28\t\n29\t/// External terminal round constants: 4 rounds × 3 elements\n30\t__device__ __constant__ Bn254Fr g_terminal_rc[4][3];\n31\t\n32\t// ---------------------------------------------------------------------------\n33\t// BN254 Poseidon2 permutation (WIDTH=3, 4 + 56 + 4 rounds)\n34\t//\n35\t// Matches p3-bn254's Poseidon2Bn254<3> permutation exactly:\n36\t//   external_initial_permute_state:  MDS first, then 4×(add_RC + sbox_all + MDS)\n37\t//   internal_permute_state:          56×(add_RC[0] + sbox[0] + matmul_internal)\n38\t//   external_terminal_permute_state: 4×(add_RC + sbox_all + MDS)\n39\t// ---------------------------------------------------------------------------\n40\t\n41\tstatic __device__ __forceinline__\n42\tvoid bn254_poseidon2_permute(Bn254Fr state[3]) {\n43\t    // --- Initial external layer ---\n44\t    bn254_mds_external(state); // MDS without round constants\n45\t    for (int r = 0; r < 4; r++) {\n46\t        for (int i = 0; i < 3; i++) {\n47\t            state[i] = bn254_add(state[i], g_initial_rc[r][i]);\n48\t            state[i] = bn254_sbox(state[i]);\n49\t        }\n50\t        bn254_mds_external(state);\n51\t    }\n52\t\n53\t    // --- Internal (partial) layer ---\n54\t    for (int r = 0; r < 56; r++) {\n55\t        state[0] = bn254_add(state[0], g_partial_rc[r]);\n56\t        state[0] = bn254_sbox(state[0]);\n57\t        bn254_mds_internal(state);\n58\t    }\n59\t\n60\t    // --- Terminal external layer ---\n61\t    for (int r = 0; r < 4; r++) {\n62\t        for (int i = 0; i < 3; i++) {\n63\t            state[i] = bn254_add(state[i], g_terminal_rc[r][i]);\n64\t            state[i] = bn254_sbox(state[i]);\n65\t        }\n66\t        bn254_mds_external(state);\n67\t    }\n68\t}\n69\t\n70\t// ---------------------------------------------------------------------------\n71\t// BN254 Merkle digest: a single Bn254Fr element (32 bytes)\n72\t// Matches Digest = [Bn254Scalar; 1] on the Rust side.\n73\t// ---------------------------------------------------------------------------\n74\t\n75\tstruct bn254_digest_t {\n76\t    Bn254Fr elem;\n77\t};\n78\t\n79\t// ---------------------------------------------------------------------------\n80\t// Helper: zero-initialize a Bn254Fr\n81\t// ---------------------------------------------------------------------------\n82\t\n83\tstatic __device__ __forceinline__\n84\tBn254Fr bn254_zero_init() {\n85\t    Bn254Fr z;\n86\t    for (int i = 0; i < 4; i++) z.limbs[i] = 0;\n87\t    return z;\n88\t}\n89\t\n90\t// ---------------------------------------------------------------------------\n91\t// Sponge constants for Merkle hashing\n92\t//\n93\t// Matches MultiField32PaddingFreeSponge<BabyBear, Bn254Scalar, Perm, 3, 16, 1>:\n94\t//   BABY_BEAR_RATE = 16  BabyBear values absorbed per permutation\n95\t//   NUM_F_ELMS = 8       BabyBear values packed per Bn254Fr (floor(254/31) = 8)\n96\t// ---------------------------------------------------------------------------\n97\t\n98\tstatic const int BN254_BABY_BEAR_RATE = 16;\n99\tstatic const int BN254_NUM_F_ELMS    = 8;\n100\t\n101\t// ---------------------------------------------------------------------------\n102\t// Row hash helpers\n103\t// ---------------------------------------------------------------------------\n104\t\n105\t/// Row hash for a base-field (Fp / BabyBear) matrix row.\n106\tstatic __device__ __forceinline__\n107\tBn254Fr bn254_row_hash(const Fp* matrix, int width, int height, int row) {\n108\t    Bn254Fr state[3];\n109\t    state[0] = bn254_zero_init();\n110\t    state[1] = bn254_zero_init();\n111\t    state[2] = bn254_zero_init();\n112\t\n113\t    uint32_t buf[BN254_BABY_BEAR_RATE];\n114\t    int cnt = 0;\n115\t\n116\t    for (int col = 0; col < width; col++) {\n117\t        buf[cnt++] = matrix[col * height + row].asUInt32();\n118\t        if (cnt == BN254_BABY_BEAR_RATE) {\n119\t            state[0] = bn254_reduce_32(buf, BN254_NUM_F_ELMS);\n120\t            state[1] = bn254_reduce_32(buf + BN254_NUM_F_ELMS, BN254_NUM_F_ELMS);\n121\t            bn254_poseidon2_permute(state);\n122\t            cnt = 0;\n123\t        }\n124\t    }\n125\t    if (cnt > 0) {\n126\t        state[0] = bn254_reduce_32(buf, min(BN254_NUM_F_ELMS, cnt));\n127\t        if (cnt > BN254_NUM_F_ELMS)\n128\t            state[1] = bn254_reduce_32(buf + BN254_NUM_F_ELMS,\n129\t                                       min(BN254_NUM_F_ELMS, cnt - BN254_NUM_F_ELMS));\n130\t        bn254_poseidon2_permute(state);\n131\t    }\n132\t    return state[0];\n133\t}\n134\t\n135\t/// Row hash for an extension-field (FpExt / BinomialExtensionField<BabyBear,4>) matrix row.\n136\tstatic __device__ __forceinline__\n137\tBn254Fr bn254_row_hash_ext(const FpExt* matrix, int width, int height, int row) {\n138\t    Bn254Fr state[3];\n139\t    state[0] = bn254_zero_init();\n140\t    state[1] = bn254_zero_init();\n141\t    state[2] = bn254_zero_init();\n142\t\n143\t    uint32_t buf[BN254_BABY_BEAR_RATE];\n144\t    int cnt = 0;\n145\t\n146\t    for (int col = 0; col < width; col++) {\n147\t        FpExt elem = matrix[col * height + row];\n148\t        for (int d = 0; d < 4; d++) {\n149\t            buf[cnt++] = elem.elems[d].asUInt32();\n150\t            if (cnt == BN254_BABY_BEAR_RATE) {\n151\t                state[0] = bn254_reduce_32(buf, BN254_NUM_F_ELMS);\n152\t                state[1] = bn254_reduce_32(buf + BN254_NUM_F_ELMS, BN254_NUM_F_ELMS);\n153\t                bn254_poseidon2_permute(state);\n154\t                cnt = 0;\n155\t            }\n156\t        }\n157\t    }\n158\t    if (cnt > 0) {\n159\t        state[0] = bn254_reduce_32(buf, min(BN254_NUM_F_ELMS, cnt));\n160\t        if (cnt > BN254_NUM_F_ELMS)\n161\t            state[1] = bn254_reduce_32(buf + BN254_NUM_F_ELMS,\n162\t                                       min(BN254_NUM_F_ELMS, cnt - BN254_NUM_F_ELMS));\n163\t        bn254_poseidon2_permute(state);\n164\t    }\n165\t    return state[0];\n166\t}\n167\t\n168\t/// TruncatedPermutation compress: (left, right) → permute([left, right, 0])[0].\n169\tstatic __device__ __forceinline__\n170\tBn254Fr bn254_compress(Bn254Fr left, Bn254Fr right) {\n171\t    Bn254Fr state[3];\n172\t    state[0] = left;\n173\t    state[1] = right;\n174\t    state[2] = bn254_zero_init();\n175\t    bn254_poseidon2_permute(state);\n176\t    return state[0];\n177\t}\n178\t\n179\t// ---------------------------------------------------------------------------\n180\t// Merkle row-hash kernel (F / BabyBear matrix)\n181\t// ---------------------------------------------------------------------------\n182\t\n183\t__global__ void bn254_compressing_row_hashes_kernel(\n184\t    bn254_digest_t* out,\n185\t    const Fp*       matrix,\n186\t    size_t          width,\n187\t    size_t          height,\n188\t    size_t          query_stride,\n189\t    size_t          log_rows_per_query\n190\t) {\n191\t    extern __shared__ char smem[]; // Bn254Fr[blockDim.x * (blockDim.y/2)]\n192\t    Bn254Fr* shared = reinterpret_cast<Bn254Fr*>(smem);\n193\t\n194\t    const uint32_t stride_idx = blockDim.x * blockIdx.x + threadIdx.x;\n195\t    uint32_t       leaf_idx   = threadIdx.y;\n196\t    const uint32_t row        = leaf_idx * query_stride + stride_idx;\n197\t\n198\t    Bn254Fr digest = bn254_zero_init();\n199\t\n200\t    if (stride_idx < query_stride) {"}]},"parent_tool_use_id":"toolu_01XwckXzVr5pepv3Y4B3hPft","session_id":"97df75af-c1b3-4850-8566-f6b18608e3d5","uuid":"28f39c0a-0695-49fa-8156-a9fcb0063ea8","timestamp":"2026-04-15T23:40:07.538Z"}
