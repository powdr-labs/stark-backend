{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EGDAVmdX4M72vjs5VpNz1E","type":"tool_result","content":"235\t// LAUNCHERS\n236\t// ============================================================================\n237\t\n238\tconstexpr uint32_t MAX_GRID_DIM = 65535u;\n239\t\n240\textern \"C\" int _fold_ple_from_evals(\n241\t    const Fp *input_matrix,\n242\t    FpExt *output_matrix,\n243\t    const Fp *omega_skip_pows,\n244\t    const FpExt *inv_lagrange_denoms,\n245\t    uint32_t height,\n246\t    uint32_t width,\n247\t    uint32_t l_skip,\n248\t    uint32_t new_height,\n249\t    bool rotate\n250\t) {\n251\t    uint32_t skip_domain = 1u << l_skip;\n252\t\n253\t    // Block size: at least skip_domain, prefer 256 for occupancy\n254\t    uint32_t block_size = std::max(256u, skip_domain);\n255\t    uint32_t chunks_per_block = block_size / skip_domain;\n256\t\n257\t    // 2D grid: x-dim for rows, y-dim for columns\n258\t    dim3 grid(div_ceil(new_height, chunks_per_block), width);\n259\t    dim3 block(block_size);\n260\t\n261\t    // Shared memory for cross-warp reduction (needed when skip_domain > 32)\n262\t    // Each warp in the block needs one FpExt slot for cross-warp reduction\n263\t    uint32_t total_warps_in_block = block_size / WARP_SIZE;\n264\t    size_t smem_bytes = (skip_domain > WARP_SIZE) ? total_warps_in_block * sizeof(FpExt) : 0;\n265\t\n266\t    if (rotate) {\n267\t        fold_ple_from_evals_kernel<true><<<grid, block, smem_bytes>>>(\n268\t            input_matrix,\n269\t            output_matrix,\n270\t            omega_skip_pows,\n271\t            inv_lagrange_denoms,\n272\t            height,\n273\t            skip_domain,\n274\t            l_skip,\n275\t            new_height\n276\t        );\n277\t    } else {\n278\t        fold_ple_from_evals_kernel<false><<<grid, block, smem_bytes>>>(\n279\t            input_matrix,\n280\t            output_matrix,\n281\t            omega_skip_pows,\n282\t            inv_lagrange_denoms,\n283\t            height,\n284\t            skip_domain,\n285\t            l_skip,\n286\t            new_height\n287\t        );\n288\t    }\n289\t    return CHECK_KERNEL();\n290\t}\n291\t\n292\textern \"C\" int _interpolate_columns(\n293\t    FpExt *interpolated,\n294\t    const FpExt *const *columns,\n295\t    size_t s_deg,\n296\t    size_t num_y,\n297\t    size_t num_columns\n298\t) {\n299\t    auto [grid, block] = kernel_launch_params(num_y * num_columns, 512);\n300\t\n301\t    interpolate_columns_kernel<<<grid, block>>>(interpolated, columns, s_deg, num_y, num_columns);\n302\t    return CHECK_KERNEL();\n303\t}\n304\t\n305\textern \"C\" int _batched_interpolate_columns(\n306\t    const InterpColDesc* descs,\n307\t    const FpExt *const * all_columns,\n308\t    size_t s_deg,\n309\t    size_t num_descs,\n310\t    size_t total_blocks\n311\t) {\n312\t    if (num_descs == 0) return 0;\n313\t    dim3 grid(total_blocks);\n314\t    dim3 block(512);\n315\t    batched_interpolate_columns_kernel<<<grid, block>>>(\n316\t        descs, all_columns, s_deg, num_descs\n317\t    );\n318\t    return CHECK_KERNEL();\n319\t}\n320\t\n321\textern \"C\" int _batched_interpolate_columns_matrix(\n322\t    const InterpTraceDescM* descs,\n323\t    const InterpMatrixInfo* matrices,\n324\t    size_t s_deg,\n325\t    size_t num_descs,\n326\t    size_t total_blocks\n327\t) {\n328\t    if (num_descs == 0) return 0;\n329\t    dim3 grid(total_blocks);\n330\t    dim3 block(512);\n331\t    batched_interpolate_columns_matrix_kernel<<<grid, block>>>(\n332\t        descs, matrices, s_deg, num_descs\n333\t    );\n334\t    return CHECK_KERNEL();\n335\t}\n336\t\n337\textern \"C\" int _frac_matrix_vertically_repeat(\n338\t    std::pair<FpExt, FpExt> *out,\n339\t    const std::pair<FpExt, FpExt> *in,\n340\t    const uint32_t width,\n341\t    const uint32_t lifted_height,\n342\t    const uint32_t height\n343\t) {\n344\t    auto [grid, block] = kernel_launch_params(lifted_height);\n345\t    grid.y = std::min(width, MAX_GRID_DIM);\n346\t    grid.z = (width + grid.y - 1) / grid.y;\n347\t    assert(grid.z <= MAX_GRID_DIM);\n348\t    frac_matrix_vertically_repeat_kernel<<<grid, block>>>(out, in, width, lifted_height, height);\n349\t    return CHECK_KERNEL();\n350\t}\n351\t\n352\textern \"C\" int _frac_matrix_vertically_repeat_ext(\n353\t    FpExt *out_numerators,\n354\t    FpExt *out_denominators,\n355\t    const FpExt *in_numerators,\n356\t    const FpExt *in_denominators,\n357\t    const uint32_t width,\n358\t    const uint32_t lifted_height,\n359\t    const uint32_t height\n360\t) {\n361\t    auto [grid, block] = kernel_launch_params(lifted_height);\n362\t    grid.y = std::min(width, MAX_GRID_DIM);\n363\t    grid.z = (width + grid.y - 1) / grid.y;\n364\t    assert(grid.z <= MAX_GRID_DIM);\n365\t    frac_matrix_vertically_repeat_mixed_kernel<<<grid, block>>>(\n366\t        out_numerators,\n367\t        out_denominators,\n368\t        in_numerators,\n369\t        in_denominators,\n370\t        width,\n371\t        lifted_height,\n372\t        height\n373\t    );\n374\t    return CHECK_KERNEL();\n375\t}\n376\t\n377\t} // namespace\n378\t"}]},"parent_tool_use_id":"toolu_01FarCk3BdP3QtjwEW43MdxV","session_id":"97df75af-c1b3-4850-8566-f6b18608e3d5","uuid":"92420642-a36e-467b-9733-dc46d136daf4","timestamp":"2026-04-16T00:20:51.909Z"}
