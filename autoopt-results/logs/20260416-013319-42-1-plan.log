{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BDRNAysGyu7ubkvKy2jGy4","type":"tool_result","content":"1\t// GKR fractional sumcheck CUDA kernels. See docs/cuda-backend/gkr-prover.md (repo root)\n2\t// for the protocol and implementation details.\n3\t\n4\t#include \"fp.h\"\n5\t#include \"fpext.h\"\n6\t#include \"frac_ext.cuh\"\n7\t#include \"launcher.cuh\"\n8\t#include \"sumcheck.cuh\"\n9\t#include \"utils.cuh\"\n10\t#include <algorithm>\n11\t#include <cassert>\n12\t#include <cstddef>\n13\t#include <cstdint>\n14\t#include <cuda_runtime_api.h>\n15\t#include <driver_types.h>\n16\t#include <utility>\n17\t#include <vector_types.h>\n18\t\n19\t// Includes GKR for fractional sumcheck\n20\t// The LogUp specific input to GKR is calculated in interactions.cu\n21\tnamespace fractional_sumcheck_gkr {\n22\t// Degree of s' polynomial (factored out the first eq term)\n23\tconstexpr int GKR_SP_DEG = 2;\n24\t// ============================================================================\n25\t// KERNELS\n26\t// ============================================================================\n27\ttemplate <bool revert, bool apply_alpha = false>\n28\t__global__ void frac_build_tree_layer_kernel(\n29\t    FracExt *__restrict__ layer,\n30\t    uint32_t half,\n31\t    FpExt alpha = FpExt(Fp(0))\n32\t) {\n33\t    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;\n34\t    if (idx >= half) {\n35\t        return;\n36\t    }\n37\t\n38\t    if constexpr (apply_alpha) {\n39\t        // When applying alpha, we need to modify both operands before combining\n40\t        // Read both values, apply alpha to denominators, then combine\n41\t        FracExt lhs_val = layer[idx];\n42\t        FracExt rhs_val = layer[idx | half];\n43\t        lhs_val.q = lhs_val.q + alpha;\n44\t        rhs_val.q = rhs_val.q + alpha;\n45\t\n46\t        if constexpr (revert) {\n47\t            frac_unadd_inplace(lhs_val, rhs_val);\n48\t        } else {\n49\t            frac_add_inplace(lhs_val, rhs_val);\n50\t        }\n51\t\n52\t        layer[idx] = lhs_val;\n53\t    } else {\n54\t        // Original fast path: use references for in-place modification\n55\t        FracExt &lhs = layer[idx];\n56\t        FracExt const &rhs = layer[idx | half];\n57\t\n58\t        if constexpr (revert) {\n59\t            frac_unadd_inplace(lhs, rhs);\n60\t        } else {\n61\t            frac_add_inplace(lhs, rhs);\n62\t        }\n63\t    }\n64\t}\n65\t\n66\t// Reconstruct eq weight from sqrt-decomposed buffers.\n67\t// See docs/cuda-backend/gkr-prover.md § \"Eq buffer sqrt decomposition\".\n68\t__device__ __forceinline__ FpExt sqrt_buffer_get(\n69\t    const FpExt *__restrict__ eq_xi_low,\n70\t    const FpExt *__restrict__ eq_xi_high,\n71\t    uint32_t const log_eq_low_cap,\n72\t    uint32_t const idx\n73\t) {\n74\t    return eq_xi_low[idx & ((1u << log_eq_low_cap) - 1)] * eq_xi_high[idx >> log_eq_low_cap];\n75\t}\n76\t\n77\t// Accumulate GKR sumcheck contributions for s'_t(1) and s'_t(2).\n78\t// See docs/cuda-backend/gkr-prover.md § \"Sumcheck round implementation\".\n79\t__device__ __forceinline__ void accumulate_compute_contributions(\n80\t    const FpExt *__restrict__ eq_xi_low,\n81\t    const FpExt *__restrict__ eq_xi_high,\n82\t    uint32_t idx,\n83\t    uint32_t log_eq_low_cap,\n84\t    FpExt lambda,\n85\t    FpExt p0_even, FpExt q0_even, FpExt p0_odd, FpExt q0_odd,\n86\t    FpExt p1_even, FpExt q1_even, FpExt p1_odd, FpExt q1_odd,\n87\t    FpExt &local0, FpExt &local1\n88\t) {\n89\t    FpExt eq_val = sqrt_buffer_get(eq_xi_low, eq_xi_high, log_eq_low_cap, idx);\n90\t\n91\t    FpExt p0_diff = p0_odd - p0_even;\n92\t    FpExt q0_diff = q0_odd - q0_even;\n93\t    FpExt p1_diff = p1_odd - p1_even;\n94\t    FpExt q1_diff = q1_odd - q1_even;\n95\t\n96\t    FpExt p_j0 = p0_even + lambda * q0_even;\n97\t    FpExt q_j0 = q0_even;\n98\t    FpExt p_j1 = p1_even;\n99\t    FpExt q_j1 = q1_even;\n100\t\n101\t    auto const lambda_times_q0_diff = lambda * q0_diff;\n102\t\n103\t#pragma unroll\n104\t    for (int i = 0; i < GKR_SP_DEG; ++i) {\n105\t        p_j0 += p0_diff;\n106\t        p_j0 += lambda_times_q0_diff;\n107\t        q_j0 += q0_diff;\n108\t        p_j1 += p1_diff;\n109\t        q_j1 += q1_diff;\n110\t\n111\t        FpExt contrib = eq_val * (p_j0 * q_j1 + p_j1 * q_j0);\n112\t        if (i == 0) local0 += contrib;\n113\t        else local1 += contrib;\n114\t    }\n115\t}\n116\t\n117\t// Helper: Perform block reduction on two accumulators and write to block_sums.\n118\t__device__ __forceinline__ void reduce_block_sums(\n119\t    FpExt *shared,\n120\t    FpExt local0, FpExt local1,\n121\t    FpExt *__restrict__ block_sums\n122\t) {\n123\t    {\n124\t        FpExt reduced = sumcheck::block_reduce_sum(local0, shared);\n125\t        if (threadIdx.x == 0) block_sums[blockIdx.x * GKR_SP_DEG + 0] = reduced;\n126\t    }\n127\t    __syncthreads();\n128\t    {\n129\t        FpExt reduced = sumcheck::block_reduce_sum(local1, shared);\n130\t        if (threadIdx.x == 0) block_sums[blockIdx.x * GKR_SP_DEG + 1] = reduced;\n131\t    }\n132\t}\n133\t\n134\t// shared memory size requirement: max(num_warps,1) * sizeof(FpExt)\n135\t// Computes s' polynomial evaluations at 1 and 2 (first eq term factored out).\n136\t__global__ void compute_round_block_sum_kernel(\n137\t    const FpExt *__restrict__ eq_xi_low,\n138\t    const FpExt *__restrict__ eq_xi_high,\n139\t    const FracExt *__restrict__ pq_buffer,\n140\t    uint32_t num_x,\n141\t    uint32_t log_eq_low_cap,\n142\t    FpExt lambda,\n143\t    FpExt *__restrict__ block_sums // Output: [gridDim.x][2]\n144\t) {\n145\t    extern __shared__ FpExt shared[];\n146\t    const uint32_t pq_size = 2 * num_x;\n147\t\n148\t    const FpExt zero(Fp::zero());\n149\t    FpExt local[GKR_SP_DEG] = {zero, zero};\n150\t    uint32_t idx_base = threadIdx.x + blockIdx.x * blockDim.x;\n151\t    // Map phase: compute local sum by striding over grid\n152\t    for (uint32_t idx = idx_base; idx < num_x / 2; idx += blockDim.x * gridDim.x) {\n153\t        FpExt eq_val = sqrt_buffer_get(eq_xi_low, eq_xi_high, log_eq_low_cap, idx);\n154\t\n155\t        // \\hat p_j({0 or 1}, {even or odd}, ..y)\n156\t        // The {even=0, odd=1} evaluations are used to interpolate at 1, 2\n157\t        auto const &[p0_even, q0_even] = pq_buffer[idx];\n158\t        auto const &[p1_even, q1_even] = pq_buffer[with_rev_bits(idx, pq_size, 1, 0)];\n159\t        auto const &[p0_odd, q0_odd] = pq_buffer[with_rev_bits(idx, pq_size, 0, 1)];\n160\t        auto const &[p1_odd, q1_odd] = pq_buffer[with_rev_bits(idx, pq_size, 1, 1)];\n161\t\n162\t        FpExt p0_diff = p0_odd - p0_even;\n163\t        FpExt q0_diff = q0_odd - q0_even;\n164\t        FpExt p1_diff = p1_odd - p1_even;\n165\t        FpExt q1_diff = q1_odd - q1_even;\n166\t\n167\t        FpExt p_j0 = p0_even + lambda * q0_even;\n168\t        FpExt q_j0 = q0_even;\n169\t        FpExt p_j1 = p1_even;\n170\t        FpExt q_j1 = q1_even;\n171\t\n172\t        auto const lambda_times_q0_diff = lambda * q0_diff;\n173\t\n174\t#pragma unroll\n175\t        for (int i = 0; i < GKR_SP_DEG; ++i) {\n176\t            p_j0 += p0_diff;\n177\t            p_j0 += lambda_times_q0_diff;\n178\t            q_j0 += q0_diff;\n179\t            p_j1 += p1_diff;\n180\t            q_j1 += q1_diff;\n181\t\n182\t            local[i] += eq_val * (p_j0 * q_j1 + p_j1 * q_j0);\n183\t        }\n184\t    }\n185\t// Reduce phase: reduce all threadIdx.x in the same block, keeping 1,2 independent\n186\t#pragma unroll\n187\t    for (int i = 0; i < GKR_SP_DEG; ++i) {\n188\t        FpExt reduced = sumcheck::block_reduce_sum(local[i], shared);\n189\t\n190\t        if (threadIdx.x == 0) {\n191\t            block_sums[blockIdx.x * GKR_SP_DEG + i] = reduced;\n192\t        }\n193\t        __syncthreads();\n194\t    }\n195\t}\n196\t\n197\t// Fold kernel operating on FpExt* view of FracExt buffer.\n198\t// Since FracExt = {p, q} has p and q folded independently with the same formula,\n199\t// we can treat the buffer as FpExt* with 2x the elements.\n200\t//\n201\t// Pairs (idx, idx+quarter) and (idx+half, idx+3*quarter),\n202\t// writes results to dst[idx] and dst[idx+quarter].\n203\t// Safe for src == dst (in-place) because each thread reads before writing to the same index.\n204\t__global__ void fold_ef_columns_kernel(const FpExt *src, FpExt *dst, uint32_t quarter, FpExt r) {\n205\t    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;\n206\t    if (idx >= quarter) {\n207\t        return;\n208\t    }\n209\t\n210\t    FpExt v0 = src[idx];\n211\t    FpExt v1 = src[idx | quarter];\n212\t    dst[idx] = v0 + r * (v1 - v0);\n213\t\n214\t    uint32_t half = quarter << 1;\n215\t\n216\t    FpExt v2 = src[idx | half];\n217\t    FpExt v3 = src[idx | half | quarter];\n218\t    dst[idx | quarter] = v2 + r * (v3 - v2);\n219\t}\n220\t\n221\t// Fused compute round + fold kernel (OUT-OF-PLACE version).\n222\t// Reads from pre-fold src_pq buffer (size 2*pq_size), computes s' polynomial at 1 and 2,\n223\t// and writes folded output to dst_pq buffer (size pq_size).\n224\t//\n225\t// This kernel fuses the fold operation into the next round's compute, eliminating\n226\t// one kernel launch per inner round and reducing memory traffic.\n227\t//\n228\t// IMPORTANT: src_pq and dst_pq must NOT alias. Use compute_round_and_fold_inplace_kernel\n229\t// when src == dst.\n230\t//\n231\t// Register-optimized: uses tight scopes for pair loads and writes folded values\n232\t// immediately to reduce live register ranges.\n233\t//\n234\t// shared memory size requirement: max(num_warps,1) * sizeof(FpExt)\n235\t__global__ void compute_round_and_fold_kernel(\n236\t    const FpExt *__restrict__ eq_xi_low,\n237\t    const FpExt *__restrict__ eq_xi_high,\n238\t    const FracExt *__restrict__ src_pq,  // Pre-fold buffer (2*pq_size FracExt)\n239\t    uint32_t num_x,                      // post-fold num_x (= pq_size / 2)\n240\t    uint32_t log_eq_low_cap,\n241\t    FpExt lambda,\n242\t    FpExt r_prev,                        // Previous round's challenge for folding\n243\t    FpExt *__restrict__ block_sums,      // Output: [gridDim.x * 2]\n244\t    FracExt *__restrict__ dst_pq         // Post-fold buffer (pq_size FracExt)\n245\t) {\n246\t    extern __shared__ FpExt shared[];\n247\t    const uint32_t pq_size = 2 * num_x;\n248\t\n249\t    // Index offsets for fold pattern (see detailed comments in inplace kernel)\n250\t    const uint32_t half = pq_size;              // src_pq_size / 2\n251\t    const uint32_t quarter = pq_size >> 1;      // pq_size / 2\n252\t    const uint32_t eighth = pq_size >> 2;       // pq_size / 4\n253\t    const uint32_t three_eighths = eighth * 3;  // 3 * pq_size / 4\n254\t\n255\t    // Use scalar accumulators instead of array to help register allocation\n256\t    const FpExt zero(Fp::zero());\n257\t    FpExt local0 = zero, local1 = zero;\n258\t    uint32_t idx_base = threadIdx.x + blockIdx.x * blockDim.x;\n259\t\n260\t    // Map phase: compute local sum by striding over grid\n261\t    for (uint32_t idx = idx_base; idx < num_x / 2; idx += blockDim.x * gridDim.x) {\n262\t        // Scalars for folded values used in compute\n263\t        FpExt p0_even, q0_even, p1_even, q1_even;\n264\t        FpExt p0_odd, q0_odd, p1_odd, q1_odd;\n265\t\n266\t        // Load pairs in tight scopes, fold, write immediately to reduce register pressure\n267\t        // f00 at post-fold idx\n268\t        {\n269\t            FracExt a = src_pq[idx];\n270\t            FracExt b = src_pq[idx + quarter];\n271\t            p0_even = a.p + r_prev * (b.p - a.p);\n272\t            q0_even = a.q + r_prev * (b.q - a.q);\n273\t            dst_pq[idx] = {p0_even, q0_even};\n274\t        }\n275\t        // f10 at post-fold idx + quarter\n276\t        {\n277\t            FracExt a = src_pq[idx + half];\n278\t            FracExt b = src_pq[idx + half + quarter];\n279\t            p1_even = a.p + r_prev * (b.p - a.p);\n280\t            q1_even = a.q + r_prev * (b.q - a.q);\n281\t            dst_pq[idx + quarter] = {p1_even, q1_even};\n282\t        }\n283\t        // f01 at post-fold idx + eighth\n284\t        {\n285\t            FracExt a = src_pq[idx + eighth];\n286\t            FracExt b = src_pq[idx + three_eighths];\n287\t            p0_odd = a.p + r_prev * (b.p - a.p);\n288\t            q0_odd = a.q + r_prev * (b.q - a.q);\n289\t            dst_pq[idx + eighth] = {p0_odd, q0_odd};\n290\t        }\n291\t        // f11 at post-fold idx + three_eighths\n292\t        {\n293\t            FracExt a = src_pq[idx + half + eighth];\n294\t            FracExt b = src_pq[idx + half + three_eighths];\n295\t            p1_odd = a.p + r_prev * (b.p - a.p);\n296\t            q1_odd = a.q + r_prev * (b.q - a.q);\n297\t            dst_pq[idx + three_eighths] = {p1_odd, q1_odd};\n298\t        }\n299\t\n300\t        accumulate_compute_contributions(\n301\t            eq_xi_low, eq_xi_high, idx, log_eq_low_cap, lambda,\n302\t            p0_even, q0_even, p0_odd, q0_odd,\n303\t            p1_even, q1_even, p1_odd, q1_odd,\n304\t            local0, local1\n305\t        );\n306\t    }\n307\t\n308\t    reduce_block_sums(shared, local0, local1, block_sums);\n309\t}\n310\t\n311\t// Fused compute round + fold kernel (IN-PLACE version).\n312\t// Reads from pre-fold pq buffer (size 2*pq_size), computes s' polynomial at 1 and 2,\n313\t// and writes folded output back to the same buffer (first pq_size elements).\n314\t//\n315\t// IN-PLACE SAFETY: Each thread writes only to indices it reads from in the first\n316\t// half of the buffer {idx, idx+quarter, idx+eighth, idx+three_eighths}. No cross-thread\n317\t// conflicts because different threads have disjoint idx values. Reads from the second\n318\t// half [pq_size, 2*pq_size) are never written to.\n319\t//\n320\t// NOTE: No __restrict__ on pq pointer since we read and write to the same buffer.\n321\t//\n322\t// shared memory size requirement: max(num_warps,1) * sizeof(FpExt)\n323\t__global__ void compute_round_and_fold_inplace_kernel(\n324\t    const FpExt *__restrict__ eq_xi_low,\n325\t    const FpExt *__restrict__ eq_xi_high,\n326\t    FracExt *pq,                         // In-place buffer: reads 2*pq_size, writes pq_size\n327\t    uint32_t num_x,                      // post-fold num_x (= pq_size / 2)\n328\t    uint32_t log_eq_low_cap,\n329\t    FpExt lambda,\n330\t    FpExt r_prev,                        // Previous round's challenge for folding\n331\t    FpExt *__restrict__ block_sums       // Output: [gridDim.x * 2]\n332\t) {\n333\t    extern __shared__ FpExt shared[];\n334\t    const uint32_t pq_size = 2 * num_x;\n335\t\n336\t    // Fold pattern analysis:\n337\t    // The fold kernel operates on FpExt* view where FracExt[i] = (FpExt[2i], FpExt[2i+1]).\n338\t    // For pre-fold size N = 2*pq_size FracExt = 4*pq_size FpExt, the fold kernel uses:\n339\t    //   quarter = 2*pq_size / 2 = pq_size (in FpExt)\n340\t    //   half = 2 * quarter = 2*pq_size (in FpExt)\n341\t    //\n342\t    // The fold produces output FracExt with this mapping:\n343\t    //   For j in [0, pq_size/2): output[j] = fold(input[j], input[j + pq_size/2])\n344\t    //   For j in [pq_size/2, pq_size): output[j] = fold(input[j + pq_size/2], input[j + pq_size])\n345\t    //\n346\t    // Post-fold indices for compute: idx, idx+quarter, idx+eighth, idx+three_eighths\n347\t    // where quarter = pq_size/2, eighth = pq_size/4\n348\t    const uint32_t half = pq_size;              // src_pq_size / 2\n349\t    const uint32_t quarter = pq_size >> 1;      // pq_size / 2\n350\t    const uint32_t eighth = pq_size >> 2;       // pq_size / 4\n351\t    const uint32_t three_eighths = eighth * 3;  // 3 * pq_size / 4\n352\t\n353\t    // Use scalar accumulators instead of array to help register allocation\n354\t    const FpExt zero(Fp::zero());\n355\t    FpExt local0 = zero, local1 = zero;\n356\t    uint32_t idx_base = threadIdx.x + blockIdx.x * blockDim.x;\n357\t\n358\t    // Map phase: compute local sum by striding over grid\n359\t    for (uint32_t idx = idx_base; idx < num_x / 2; idx += blockDim.x * gridDim.x) {\n360\t        // OPTIMIZATION: Staged load-fold pattern to reduce register pressure.\n361\t        // For in-place operation, we must read all 8 source values before writing.\n362\t        // BUT we fold and write immediately after each pair to minimize live register count.\n363\t        // This reduces peak register usage from ~107 to ~60-70 regs/thread.\n364\t\n365\t        // Declare output scalars for folded values\n366\t        FpExt p0_even, q0_even, p1_even, q1_even;\n367\t        FpExt p0_odd, q0_odd, p1_odd, q1_odd;\n368\t\n369\t        // Pair 1: f00 (idx -> p0_even, q0_even)\n370\t        {\n371\t            FracExt a = pq[idx];\n372\t            FracExt b = pq[idx + quarter];\n373\t            p0_even = a.p + r_prev * (b.p - a.p);\n374\t            q0_even = a.q + r_prev * (b.q - a.q);\n375\t        }\n376\t\n377\t        // Pair 2: f10 (idx + half -> p1_even, q1_even)\n378\t        {\n379\t            FracExt a = pq[idx + half];\n380\t            FracExt b = pq[idx + half + quarter];\n381\t            p1_even = a.p + r_prev * (b.p - a.p);\n382\t            q1_even = a.q + r_prev * (b.q - a.q);\n383\t        }\n384\t\n385\t        // Pair 3: f01 (idx + eighth -> p0_odd, q0_odd)\n386\t        {\n387\t            FracExt a = pq[idx + eighth];\n388\t            FracExt b = pq[idx + three_eighths];\n389\t            p0_odd = a.p + r_prev * (b.p - a.p);\n390\t            q0_odd = a.q + r_prev * (b.q - a.q);\n391\t        }\n392\t\n393\t        // Pair 4: f11 (idx + half + eighth -> p1_odd, q1_odd)\n394\t        {\n395\t            FracExt a = pq[idx + half + eighth];\n396\t            FracExt b = pq[idx + half + three_eighths];\n397\t            p1_odd = a.p + r_prev * (b.p - a.p);\n398\t            q1_odd = a.q + r_prev * (b.q - a.q);\n399\t        }\n400\t\n401\t        // Write all folded values (safe: writes to first half, reads from both halves completed)\n402\t        pq[idx] = {p0_even, q0_even};\n403\t        pq[idx + quarter] = {p1_even, q1_even};\n404\t        pq[idx + eighth] = {p0_odd, q0_odd};\n405\t        pq[idx + three_eighths] = {p1_odd, q1_odd};\n406\t\n407\t        accumulate_compute_contributions(\n408\t            eq_xi_low, eq_xi_high, idx, log_eq_low_cap, lambda,\n409\t            p0_even, q0_even, p0_odd, q0_odd,\n410\t            p1_even, q1_even, p1_odd, q1_odd,\n411\t            local0, local1\n412\t        );\n413\t    }\n414\t\n415\t    reduce_block_sums(shared, local0, local1, block_sums);\n416\t}\n417\t\n418\t// Fused compute round + tree layer revert kernel.\n419\t// Combines frac_build_tree_layer_kernel<true> (revert) with compute_round_block_sum_kernel.\n420\t//\n421\t// This is used for the FIRST inner round only, where we need to revert the tree layer\n422\t// before computing. Equivalent to fractional subtraction:\n423\t//   layer[i] = frac_unadd(layer[i], layer[i + half])\n424\t// where rhs = layer[i + half] is kept unchanged.\n425\t//\n426\t// For round 0, the 4 PQ indices accessed per thread are:\n427\t//   - idx: in first half, needs revert\n428\t//   - idx | quarter: in first half, needs revert\n429\t//   - idx | half: in second half, no revert\n430\t//   - idx | half | quarter: in second half, no revert\n431\t//\n432\t// Each index in the first half is written by exactly one thread:\n433\t//   - Thread idx writes to indices {idx, idx + quarter}\n434\t//   - For idx in [0, num_x/2), these cover [0, half) completely\n435\t//\n436\t// shared memory size requirement: max(num_warps,1) * sizeof(FpExt)\n437\t__global__ void compute_round_and_revert_kernel(\n438\t    const FpExt *__restrict__ eq_xi_low,\n439\t    const FpExt *__restrict__ eq_xi_high,\n440\t    FracExt *__restrict__ layer,         // Tree layer buffer (modified in-place for revert)\n441\t    uint32_t num_x,\n442\t    uint32_t log_eq_low_cap,\n443\t    FpExt lambda,\n444\t    FpExt *__restrict__ block_sums       // Output: [gridDim.x * 2]\n445\t) {\n446\t    extern __shared__ FpExt shared[];\n447\t    const uint32_t pq_size = 2 * num_x;\n448\t    const uint32_t half = pq_size >> 1;     // pq_size / 2\n449\t    const uint32_t quarter = pq_size >> 2;  // pq_size / 4\n450\t\n451\t    // Use scalar accumulators instead of array to help register allocation\n452\t    const FpExt zero(Fp::zero());\n453\t    FpExt local0 = zero, local1 = zero;\n454\t    uint32_t idx_base = threadIdx.x + blockIdx.x * blockDim.x;\n455\t\n456\t    // Map phase: compute local sum by striding over grid\n457\t    for (uint32_t idx = idx_base; idx < num_x / 2; idx += blockDim.x * gridDim.x) {\n458\t        // OPTIMIZATION: Extract components immediately, don't keep FracExt structures live.\n459\t        // This reduces register pressure by avoiding 4x FracExt (8 FpExt) intermediate storage.\n460\t\n461\t        // Declare output scalars upfront\n462\t        FpExt p0_even, q0_even, p1_even, q1_even;\n463\t        FpExt p0_odd, q0_odd, p1_odd, q1_odd;\n464\t\n465\t        // Compute p0_even by reverting with p1_even (frac_unadd)\n466\t        {\n467\t            FracExt lhs = layer[idx];\n468\t            FracExt rhs = layer[idx + half];\n469\t            FpExt rhs_q_inv = inv(rhs.q);\n470\t            q0_even = lhs.q * rhs_q_inv;\n471\t            p0_even = (lhs.p - q0_even * rhs.p) * rhs_q_inv;\n472\t            p1_even = rhs.p;\n473\t            q1_even = rhs.q;\n474\t            layer[idx] = {p0_even, q0_even};\n475\t        }\n476\t\n477\t        // Compute p0_odd by reverting with p1_odd (frac_unadd)\n478\t        {\n479\t            FracExt lhs = layer[idx + quarter];\n480\t            FracExt rhs = layer[idx + half + quarter];\n481\t            FpExt rhs_q_inv = inv(rhs.q);\n482\t            q0_odd = lhs.q * rhs_q_inv;\n483\t            p0_odd = (lhs.p - q0_odd * rhs.p) * rhs_q_inv;\n484\t            p1_odd = rhs.p;\n485\t            q1_odd = rhs.q;\n486\t            layer[idx + quarter] = {p0_odd, q0_odd};\n487\t        }\n488\t\n489\t        accumulate_compute_contributions(\n490\t            eq_xi_low, eq_xi_high, idx, log_eq_low_cap, lambda,\n491\t            p0_even, q0_even, p0_odd, q0_odd,\n492\t            p1_even, q1_even, p1_odd, q1_odd,\n493\t            local0, local1\n494\t        );\n495\t    }\n496\t\n497\t    reduce_block_sums(shared, local0, local1, block_sums);\n498\t}\n499\t\n500\t// Number of tail elements loaded into shared memory per loop iteration in\n501\t// precompute_m_build_partial_kernel. Each batch allocates:\n502\t//   (4 * (2^w + 1) * BATCH + BATCH) * sizeof(FpExt)\n503\t// of shared memory (4 data arrays + 1 weight array, with +1 stride for bank\n504\t// conflict avoidance). With w=3 (2^3=8) and BATCH=16 this is ~9.25 KB.\n505\t// Increasing BATCH improves amortization of __syncthreads() barriers but\n506\t// increases shared memory pressure, which can reduce occupancy or prevent launch.\n507\tconstexpr uint32_t PRECOMPUTE_M_TAIL_BATCH = 16;\n508\t\n509\t// Build partial M blocks by parallelizing over tail points.\n510\t// See docs/cuda-backend/gkr-prover.md § \"Precompute M strategy\".\n511\t// Each block covers a range of tail points [b_start, b_end) and computes a full M block.\n512\t// Uses 2D blocks (m,m) where each thread owns one (u,v) M-matrix entry.\n513\t// Shared memory uses +1 padding on the m-dimension stride to avoid bank conflicts.\n514\ttemplate <bool inline_fold, uint32_t W>\n515\t__global__ void precompute_m_build_partial_kernel(\n516\t    const FracExt *__restrict__ pq,\n517\t    uint32_t rem_n,          // number of variables AFTER fold (folded rem_n)\n518\t    FpExt lambda,\n519\t    FpExt r_prev,            // challenge for the inline fold (only used when inline_fold=true)\n520\t    const FpExt *__restrict__ eq_tail_low,\n521\t    const FpExt *__restrict__ eq_tail_high,\n522\t    uint32_t log_eq_tail_low_cap,\n523\t    uint32_t tail_tile,\n524\t    FpExt *__restrict__ partial_out\n525\t) {\n526\t    constexpr uint32_t m = 1u << W;\n527\t    uint32_t u = threadIdx.y;\n528\t    uint32_t v = threadIdx.x;\n529\t    if (u >= m || v >= m) {\n530\t        return;\n531\t    }\n532\t\n533\t    uint32_t tail_n = rem_n - W;\n534\t    uint32_t k = 1u << tail_n;\n535\t    // When inline_fold: buffer has rem_n+1 variables (unfolded).\n536\t    // Otherwise: buffer has rem_n variables (already folded).\n537\t    uint32_t fold_half = inline_fold ? (1u << rem_n) : 0;\n538\t    uint32_t poly_stride = inline_fold ? (1u << (rem_n + 1)) : (1u << rem_n);\n539\t\n540\t    uint32_t b_start = blockIdx.x * tail_tile;\n541\t    uint32_t b_end = min(b_start + tail_tile, k);\n542\t\n543\t    // +1 padding avoids bank conflicts for power-of-2 m (m=8 → stride 9).\n544\t    constexpr uint32_t sh_stride = m + 1;\n545\t    extern __shared__ FpExt shmem[];\n546\t    FpExt *sh_left0 = shmem;\n547\t    FpExt *sh_left1 = sh_left0 + sh_stride * PRECOMPUTE_M_TAIL_BATCH;\n548\t    FpExt *sh_right0 = sh_left1 + sh_stride * PRECOMPUTE_M_TAIL_BATCH;\n549\t    FpExt *sh_right1 = sh_right0 + sh_stride * PRECOMPUTE_M_TAIL_BATCH;\n550\t    FpExt *sh_weight = sh_right1 + sh_stride * PRECOMPUTE_M_TAIL_BATCH;\n551\t\n552\t    FpExt zero(Fp::zero());\n553\t    FpExt acc = zero;\n554\t\n555\t    uint32_t lane = threadIdx.y * blockDim.x + threadIdx.x;\n556\t    uint32_t threads = blockDim.x * blockDim.y;\n557\t\n558\t    for (uint32_t b0 = b_start; b0 < b_end; b0 += PRECOMPUTE_M_TAIL_BATCH) {\n559\t        uint32_t batch = min(PRECOMPUTE_M_TAIL_BATCH, b_end - b0);\n560\t        uint32_t elems = batch * m;\n561\t\n562\t        // Phase 1: Load weights into shared memory.\n563\t        for (uint32_t bi = lane; bi < batch; bi += threads) {\n564\t            uint32_t b = b0 + bi;\n565\t            sh_weight[bi] = sqrt_buffer_get(\n566\t                eq_tail_low, eq_tail_high, log_eq_tail_low_cap, b\n567\t            );\n568\t        }\n569\t        __syncthreads();\n570\t\n571\t        // Phase 2: Load pq data, optionally fold inline by r_prev, and premultiply left0/left1 by weight.\n572\t        for (uint32_t idx = lane; idx < elems; idx += threads) {\n573\t            uint32_t beta = idx / batch;\n574\t            uint32_t bi = idx - beta * batch;\n575\t            uint32_t b = b0 + bi;\n576\t            uint32_t src = beta * k + b;\n577\t            FpExt p0, q0, p1, q1;\n578\t            if constexpr (inline_fold) {\n579\t                // Inline fold: val = lo + r_prev * (hi - lo) for each of {p0, q0, p1, q1}.\n580\t                FracExt const &f0_lo = pq[src];\n581\t                FracExt const &f0_hi = pq[src + fold_half];\n582\t                FracExt const &f1_lo = pq[poly_stride + src];\n583\t                FracExt const &f1_hi = pq[poly_stride + src + fold_half];\n584\t                p0 = f0_lo.p + r_prev * (f0_hi.p - f0_lo.p);\n585\t                q0 = f0_lo.q + r_prev * (f0_hi.q - f0_lo.q);\n586\t                p1 = f1_lo.p + r_prev * (f1_hi.p - f1_lo.p);\n587\t                q1 = f1_lo.q + r_prev * (f1_hi.q - f1_lo.q);\n588\t            } else {\n589\t                // Buffer already folded: read directly.\n590\t                FracExt const &f0 = pq[src];\n591\t                FracExt const &f1 = pq[poly_stride + src];\n592\t                p0 = f0.p; q0 = f0.q;\n593\t                p1 = f1.p; q1 = f1.q;\n594\t            }\n595\t            uint32_t sh_idx = bi * sh_stride + beta;\n596\t            FpExt wt = sh_weight[bi];\n597\t            sh_left0[sh_idx] = wt * (p0 + lambda * q0);\n598\t            sh_left1[sh_idx] = wt * p1;\n599\t            sh_right0[sh_idx] = q0;\n600\t            sh_right1[sh_idx] = q1;\n601\t        }\n602\t        __syncthreads();\n603\t\n604\t        // Phase 3: Accumulate with 2 muls per iteration (weight already folded in).\n605\t        for (uint32_t bi = 0; bi < batch; ++bi) {\n606\t            uint32_t row = bi * sh_stride;\n607\t            acc += sh_left0[row + u] * sh_right1[row + v]\n608\t                 + sh_left1[row + u] * sh_right0[row + v];\n609\t        }\n610\t\n611\t        __syncthreads();\n612\t    }\n613\t\n614\t    partial_out[blockIdx.x * (m * m) + u * m + v] = acc;\n615\t}\n616\t\n617\ttemplate <bool inline_fold, uint32_t W>\n618\tinline void launch_precompute_m_build_partial_kernel(\n619\t    dim3 grid,\n620\t    const FracExt *pq,\n621\t    uint32_t rem_n,\n622\t    FpExt lambda,\n623\t    FpExt r_prev,\n624\t    const FpExt *eq_tail_low,\n625\t    const FpExt *eq_tail_high,\n626\t    uint32_t log_eq_tail_low_cap,\n627\t    uint32_t tail_tile,\n628\t    FpExt *partial_out\n629\t) {\n630\t    constexpr uint32_t m = 1u << W;\n631\t    dim3 block(m, m);\n632\t    constexpr uint32_t sh_stride = m + 1;  // +1 padding to match kernel\n633\t    size_t shmem_bytes =\n634\t        (4 * sh_stride * PRECOMPUTE_M_TAIL_BATCH + PRECOMPUTE_M_TAIL_BATCH) * sizeof(FpExt);\n635\t    precompute_m_build_partial_kernel<inline_fold, W><<<grid, block, shmem_bytes>>>(\n636\t        pq,\n637\t        rem_n,\n638\t        lambda,\n639\t        r_prev,\n640\t        eq_tail_low,\n641\t        eq_tail_high,\n642\t        log_eq_tail_low_cap,\n643\t        tail_tile,\n644\t        partial_out\n645\t    );\n646\t}\n647\t\n648\ttemplate <bool inline_fold>\n649\tinline int launch_precompute_m_build_partial_dispatch(\n650\t    uint32_t w,\n651\t    dim3 grid,\n652\t    const FracExt *pq,\n653\t    uint32_t rem_n,\n654\t    FpExt lambda,\n655\t    FpExt r_prev,\n656\t    const FpExt *eq_tail_low,\n657\t    const FpExt *eq_tail_high,\n658\t    uint32_t log_eq_tail_low_cap,\n659\t    uint32_t tail_tile,\n660\t    FpExt *partial_out\n661\t) {\n662\t    using LauncherFn = void (*)(\n663\t        dim3, const FracExt *, uint32_t, FpExt, FpExt, const FpExt *, const FpExt *, uint32_t,\n664\t        uint32_t, FpExt *\n665\t    );\n666\t    static constexpr LauncherFn launchers[] = {\n667\t        &launch_precompute_m_build_partial_kernel<inline_fold, 1>,\n668\t        &launch_precompute_m_build_partial_kernel<inline_fold, 2>,\n669\t        &launch_precompute_m_build_partial_kernel<inline_fold, 3>,\n670\t        &launch_precompute_m_build_partial_kernel<inline_fold, 4>,\n671\t        &launch_precompute_m_build_partial_kernel<inline_fold, 5>,\n672\t    };\n673\t\n674\t    constexpr uint32_t min_w = 1;\n675\t    constexpr uint32_t max_w = static_cast<uint32_t>(sizeof(launchers) / sizeof(launchers[0]));\n676\t    if (w < min_w || w > max_w) {\n677\t        // 2D launch uses (2^w, 2^w) threads, so w > 5 exceeds 1024 threads per block.\n678\t        return cudaErrorInvalidValue;\n679\t    }\n680\t\n681\t    launchers[w - min_w](\n682\t        grid,\n683\t        pq,\n684\t        rem_n,\n685\t        lambda,\n686\t        r_prev,\n687\t        eq_tail_low,\n688\t        eq_tail_high,\n689\t        log_eq_tail_low_cap,\n690\t        tail_tile,\n691\t        partial_out\n692\t    );\n693\t    return 0;\n694\t}\n695\t\n696\t// Reduce partial M blocks into a final M matrix.\n697\t__global__ void precompute_m_reduce_partials_kernel(\n698\t    const FpExt *__restrict__ partial,\n699\t    uint32_t num_blocks,\n700\t    uint32_t total_entries,\n701\t    FpExt *__restrict__ m_total\n702\t) {\n703\t    uint32_t entry = blockIdx.x * blockDim.x + threadIdx.x;\n704\t    if (entry >= total_entries) {\n705\t        return;\n706\t    }\n707\t\n708\t    FpExt zero(Fp::zero());\n709\t    FpExt acc = zero;\n710\t    // Iterate over partial blocks with coalesced loads:\n711\t    // for fixed b, neighboring threads read neighboring entries.\n712\t    for (uint32_t b = 0; b < num_blocks; ++b) {\n713\t        acc += partial[(size_t)b * total_entries + entry];\n714\t    }\n715\t    m_total[entry] = acc;\n716\t}\n717\t\n718\t// Evaluate one round polynomial inside a precompute-M window from precomputed M.\n719\t// See docs/cuda-backend/gkr-prover.md § \"Precompute M strategy\".\n720\t// Output: out[0] = s'(1), out[1] = s'(2).\n721\t__global__ void precompute_m_eval_round_kernel(\n722\t    const FpExt *__restrict__ m_total,\n723\t    uint32_t w,\n724\t    uint32_t t,\n725\t    const FpExt *__restrict__ eq_r_prefix,\n726\t    const FpExt *__restrict__ eq_suffix,\n727\t    FpExt *__restrict__ out\n728\t) {\n729\t    extern __shared__ FpExt shared[];\n730\t\n731\t    uint32_t m = 1u << w;\n732\t    uint32_t prefix_bits = t;\n733\t    uint32_t suffix_bits = w - t - 1;\n734\t    uint32_t prefix_size = 1u << prefix_bits;\n735\t    uint32_t suffix_size = 1u << suffix_bits;\n736\t\n737\t    uint64_t total = (uint64_t)prefix_size * prefix_size * suffix_size;\n738\t    uint32_t cur_bit = 1u << suffix_bits;\n739\t    FpExt zero(Fp::zero());\n740\t    FpExt one(Fp::one());\n741\t    FpExt two = one + one;\n742\t\n743\t    FpExt local_s1 = zero;\n744\t    FpExt local_s2 = zero;\n745\t\n746\t    for (uint64_t idx = threadIdx.x; idx < total; idx += blockDim.x) {\n747\t        uint32_t suffix = (uint32_t)(idx % suffix_size);\n748\t        uint64_t tmp = idx / suffix_size;\n749\t        uint32_t b2 = (uint32_t)(tmp % prefix_size);\n750\t        uint32_t b1 = (uint32_t)(tmp / prefix_size);\n751\t\n752\t        FpExt weight = eq_r_prefix[b1] * eq_r_prefix[b2] * eq_suffix[suffix];\n753\t\n754\t        uint32_t prefix_shift = suffix_bits + 1;\n755\t        uint32_t beta1_0 = (b1 << prefix_shift) | suffix;\n756\t        uint32_t beta1_1 = beta1_0 | cur_bit;\n757\t        uint32_t beta2_0 = (b2 << prefix_shift) | suffix;\n758\t        uint32_t beta2_1 = beta2_0 | cur_bit;\n759\t\n760\t        FpExt m00 = m_total[beta1_0 * m + beta2_0];\n761\t        FpExt m01 = m_total[beta1_0 * m + beta2_1];\n762\t        FpExt m10 = m_total[beta1_1 * m + beta2_0];\n763\t        FpExt m11 = m_total[beta1_1 * m + beta2_1];\n764\t\n765\t        local_s1 += weight * m11;\n766\t        local_s2 += weight * (m00 - two * (m01 + m10 - m11 - m11));\n767\t    }\n768\t\n769\t    {\n770\t        FpExt reduced = sumcheck::block_reduce_sum(local_s1, shared);\n771\t        if (threadIdx.x == 0) out[0] = reduced;\n772\t    }\n773\t    __syncthreads();\n774\t    {\n775\t        FpExt reduced = sumcheck::block_reduce_sum(local_s2, shared);\n776\t        if (threadIdx.x == 0) out[1] = reduced;\n777\t    }\n778\t}\n779\t\n780\t// Fold w rounds at once using precomputed eq_r_window.\n781\t// One thread computes both poly outputs for a single tail index.\n782\ttemplate <uint32_t W>\n783\t__global__ void multifold_kernel(\n784\t    const FracExt *src,\n785\t    FracExt *dst,\n786\t    uint32_t tail_size,\n787\t    const FpExt *__restrict__ eq_r_window\n788\t) {\n789\t    constexpr uint32_t beta_size = 1u << W;\n790\t    uint32_t out_idx = blockIdx.x * blockDim.x + threadIdx.x;\n791\t    if (out_idx >= tail_size) {\n792\t        return;\n793\t    }\n794\t\n795\t    FpExt zero(Fp::zero());\n796\t    FpExt acc0_p = zero;\n797\t    FpExt acc0_q = zero;\n798\t    FpExt acc1_p = zero;\n799\t    FpExt acc1_q = zero;\n800\t    const FracExt *src_1 = src + ((size_t)tail_size << W);\n801\t    for (uint32_t beta = 0; beta < beta_size; ++beta) {\n802\t        uint32_t idx = beta * tail_size + out_idx;\n803\t        FracExt v0 = src[idx];\n804\t        FracExt v1 = src_1[idx];\n805\t        FpExt eq_r = eq_r_window[beta];\n806\t        acc0_p += eq_r * v0.p;\n807\t        acc0_q += eq_r * v0.q;\n808\t        acc1_p += eq_r * v1.p;\n809\t        acc1_q += eq_r * v1.q;\n810\t    }\n811\t    dst[out_idx] = {acc0_p, acc0_q};\n812\t    dst[tail_size + out_idx] = {acc1_p, acc1_q};\n813\t}\n814\t\n815\t__global__ void add_alpha_kernel(FracExt *data, size_t len, FpExt alpha) {\n816\t    size_t idx = blockIdx.x * blockDim.x + threadIdx.x;\n817\t    if (idx < len) {\n818\t        data[idx].q = data[idx].q + alpha;\n819\t    }\n820\t}\n821\t\n822\ttemplate <typename F, typename EF>\n823\t__global__ void frac_vector_scalar_multiply_kernel(\n824\t    std::pair<EF, EF> *frac_vec,\n825\t    F scalar,\n826\t    uint32_t length\n827\t) {\n828\t    size_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n829\t    if (tidx >= length)\n830\t        return;\n831\t\n832\t    frac_vec[tidx].first *= scalar;\n833\t}\n834\t\n835\t// Fused two-layer tree build kernel.\n836\t// Applies two consecutive frac_add tree layers in one pass, keeping intermediate\n837\t// right-half nodes for later revert operations.\n838\t//\n839\t// For fused layers i and i+1 with half_i = N >> (i+1) and half_i1 = N >> (i+2):\n840\t//   Thread j in [0, half_i1) reads:\n841\t//     A = layer[j],                  B = layer[j + half_i1],\n842\t//     C = layer[j + half_i],         D = layer[j + half_i + half_i1]\n843\t//   Computes:\n844\t//     lhs = frac_add(A, C)            (layer i result at j, kept in register)\n845\t//     rhs = frac_add(B, D)            (layer i result at j + half_i1)\n846\t//     result = frac_add(lhs, rhs)     (layer i+1 result at j)\n847\t//   Writes:\n848\t//     layer[j]         = result        (layer i+1 output)\n849\t//     layer[j+half_i1] = rhs           (layer i intermediate, needed for revert of layer i+1)\n850\t//   C and D remain untouched (already in correct place for revert of layer i).\n851\t//\n852\t// Memory traffic vs two separate frac_build_tree_layer calls:\n853\t//   Non-fused: 4 reads + 2 writes (layer i) + 2 reads + 1 write (layer i+1) = 6R+3W per group\n854\t//   Fused:     4 reads + 2 writes per group\n855\t//   Savings:   2 reads + 1 write = ~33% reduction in global memory traffic.\n856\t__global__ void frac_build_tree_two_layers_kernel(\n857\t    FracExt *__restrict__ layer,\n858\t    uint32_t half_i1   // = N >> (i+2), where i is the first of the two layers\n859\t) {\n860\t    uint32_t j = blockIdx.x * blockDim.x + threadIdx.x;\n861\t    if (j >= half_i1) return;\n862\t\n863\t    uint32_t half_i = half_i1 << 1;   // = N >> (i+1)\n864\t\n865\t    FracExt A = layer[j];\n866\t    FracExt B = layer[j + half_i1];\n867\t    FracExt C = layer[j + half_i];\n868\t    FracExt D = layer[j + half_i + half_i1];\n869\t\n870\t    // Layer i: combine A with C and B with D (kept in registers)\n871\t    FracExt lhs = frac_add(A, C);\n872\t    FracExt rhs = frac_add(B, D);\n873\t    // Layer i+1: combine the two layer-i results\n874\t    FracExt result = frac_add(lhs, rhs);\n875\t\n876\t    layer[j]         = result;\n877\t    layer[j + half_i1] = rhs;   // Needed for revert of layer i+1\n878\t    // layer[j + half_i] = C  (unchanged, needed for revert of layer i)\n879\t    // layer[j + half_i + half_i1] = D  (unchanged, needed for revert of layer i)\n880\t}\n881\t\n882\t// ============================================================================\n883\t// LAUNCHERS\n884\t// ============================================================================\n885\ttemplate <bool revert, bool apply_alpha>\n886\tint launch_frac_build_tree_layer(FracExt *layer, size_t layer_size, FpExt alpha) {\n887\t    auto [grid, block] = kernel_launch_params(layer_size);\n888\t    frac_build_tree_layer_kernel<revert, apply_alpha><<<grid, block>>>(layer, layer_size, alpha);\n889\t    return CHECK_KERNEL();\n890\t}\n891\t\n892\textern \"C\" int _frac_build_tree_layer(\n893\t    FracExt *layer,\n894\t    size_t layer_size,\n895\t    bool revert,\n896\t    FpExt alpha,\n897\t    bool apply_alpha\n898\t) {\n899\t    if (layer_size == 0) {\n900\t        return 0;\n901\t    }\n902\t    assert(layer_size % 2 == 0);\n903\t    layer_size /= 2;\n904\t\n905\t    return DISPATCH_BOOL_PAIR(\n906\t        launch_frac_build_tree_layer, revert, apply_alpha, layer, layer_size, alpha\n907\t    );\n908\t}\n909\t\n910\t// Launcher for fused two-layer tree build.\n911\t// half_i1 = N >> (i+2), where i is the index of the first layer to fuse.\n912\t// Requires half_i1 >= 1 and half_i1 * 4 <= total array size.\n913\textern \"C\" int _frac_build_tree_two_layers(FracExt *layer, size_t half_i1) {\n914\t    if (half_i1 == 0) return 0;\n915\t    // Use 256 threads/block (not 1024) to give the compiler more register headroom.\n916\t    // frac_build_tree_two_layers_kernel does 4 FracExt loads + 3 frac_add ops,\n917\t    // which has higher register pressure than the single-layer build kernel.\n918\t    auto [grid, block] = kernel_launch_params(half_i1, 256);\n919\t    frac_build_tree_two_layers_kernel<<<grid, block>>>(layer, (uint32_t)half_i1);\n920\t    return CHECK_KERNEL();\n921\t}\n922\t\n923\tinline uint32_t min_blocks_target_for_device(uint32_t blocks_per_sm, uint32_t fallback_blocks) {\n924\t    int device = 0;\n925\t    if (cudaGetDevice(&device) == cudaSuccess) {\n926\t        int sm_count = 0;\n927\t        if (cudaDeviceGetAttribute(&sm_count, cudaDevAttrMultiProcessorCount, device) ==\n928\t                cudaSuccess &&\n929\t            sm_count > 0) {\n930\t            return static_cast<uint32_t>(sm_count) * blocks_per_sm;\n931\t        }\n932\t    }\n933\t    return fallback_blocks;\n934\t}\n935\t\n936\tinline std::pair<dim3, dim3> frac_compute_round_launch_params(uint32_t num_x) {\n937\t    // OPTIMIZATION: Adaptive grid sizing to improve GPU utilization for small workloads.\n938\t    // For small num_x, the default sizing creates too few blocks.\n939\t    // We reduce block size to create more blocks, ensuring better SM coverage.\n940\t\n941\t    uint32_t elements = num_x >> 1;\n942\t\n943\t    // Target: at least 2 blocks per SM for round-compute kernels. This is a simple default that helps\n944\t    // hide latency on memory-heavy kernels without over-fragmenting blocks.\n945\t    // For small workloads, we reduce threads/block to increase block count.\n946\t    constexpr uint32_t ROUND_COMPUTE_BLOCKS_PER_SM_TARGET = 2;\n947\t    constexpr uint32_t ROUND_COMPUTE_FALLBACK_BLOCKS_TARGET = 228;\n948\t    uint32_t min_blocks_target =\n949\t        min_blocks_target_for_device(\n950\t            ROUND_COMPUTE_BLOCKS_PER_SM_TARGET, ROUND_COMPUTE_FALLBACK_BLOCKS_TARGET\n951\t        );\n952\t    constexpr uint32_t DEFAULT_BLOCK_SIZE = 256;\n953\t    constexpr uint32_t MIN_BLOCK_SIZE = 64;      // Minimum for occupancy\n954\t\n955\t    uint32_t block_size = DEFAULT_BLOCK_SIZE;\n956\t    uint32_t blocks_needed = (elements + block_size - 1) / block_size;\n957\t\n958\t    // If we'd get too few blocks with default size, try reducing block size\n959\t    if (blocks_needed < min_blocks_target && elements >= MIN_BLOCK_SIZE) {\n960\t        // Calculate block size needed to reach target\n961\t        block_size = (elements + min_blocks_target - 1) / min_blocks_target;\n962\t        // Round up to next multiple of 32 (warp size)\n963\t        block_size = std::max(MIN_BLOCK_SIZE, ((block_size + 31) / 32) * 32);\n964\t        // Recalculate blocks with new size\n965\t        blocks_needed = (elements + block_size - 1) / block_size;\n966\t    }\n967\t\n968\t    return {dim3(blocks_needed), dim3(block_size)};\n969\t}\n970\t\n971\textern \"C\" uint32_t _frac_compute_round_temp_buffer_size(uint32_t num_x) {\n972\t    auto [grid, block] = frac_compute_round_launch_params(num_x);\n973\t    return grid.x * GKR_SP_DEG;\n974\t}\n975\t\n976\tinline int final_reduce_block_sums(FpExt *tmp_block_sums, FpExt *out, uint32_t num_blocks) {\n977\t    auto [unused_grid, reduce_block] = kernel_launch_params(num_blocks);\n978\t    (void)unused_grid;\n979\t    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n980\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n981\t    sumcheck::static_final_reduce_block_sums<GKR_SP_DEG>\n982\t        <<<GKR_SP_DEG, reduce_block, reduce_shmem>>>(tmp_block_sums, out, num_blocks);\n983\t    return CHECK_KERNEL();\n984\t}\n985\t\n986\textern \"C\" int _frac_compute_round(\n987\t    const FpExt *eq_xi_low,\n988\t    const FpExt *eq_xi_high,\n989\t    const FracExt *pq_buffer,\n990\t    size_t num_x,\n991\t    size_t eq_low_cap,\n992\t    FpExt lambda,\n993\t    FpExt *out,           // Output: [d=2] final results\n994\t    FpExt *tmp_block_sums // Temporary buffer: [gridDim.x * d]\n995\t) {\n996\t    assert(num_x > 1);\n997\t\n998\t    auto [grid, block] = frac_compute_round_launch_params(num_x);\n999\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n1000\t\n1001\t    // Launch main kernel - writes to tmp_block_sums\n1002\t    compute_round_block_sum_kernel<<<grid, block, shmem_bytes>>>(\n1003\t        eq_xi_low,\n1004\t        eq_xi_high,\n1005\t        pq_buffer,\n1006\t        (uint32_t)num_x,\n1007\t        __builtin_ctz((uint32_t)eq_low_cap),\n1008\t        lambda,\n1009\t        tmp_block_sums\n1010\t    );\n1011\t    int err = CHECK_KERNEL();\n1012\t    if (err != 0)\n1013\t        return err;\n1014\t\n1015\t    // Launch final reduction kernel - reads from tmp_block_sums, writes to output.\n1016\t    return final_reduce_block_sums(tmp_block_sums, out, grid.x);\n1017\t}\n1018\t\n1019\t// Fused compute round + tree layer revert launcher.\n1020\t// Combines frac_build_tree_layer(revert=true) with compute_round for the first inner round.\n1021\textern \"C\" int _frac_compute_round_and_revert(\n1022\t    const FpExt *eq_xi_low,\n1023\t    const FpExt *eq_xi_high,\n1024\t    FracExt *layer,           // Tree layer buffer (modified in-place for revert)\n1025\t    size_t num_x,\n1026\t    size_t eq_low_cap,\n1027\t    FpExt lambda,\n1028\t    FpExt *out,               // Output: [d=2] final results\n1029\t    FpExt *tmp_block_sums     // Temporary buffer: [gridDim.x * d]\n1030\t) {\n1031\t    assert(num_x > 1);\n1032\t\n1033\t    auto [grid, block] = frac_compute_round_launch_params(num_x);\n1034\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n1035\t\n1036\t    // Launch fused revert + compute kernel\n1037\t    compute_round_and_revert_kernel<<<grid, block, shmem_bytes>>>(\n1038\t        eq_xi_low,\n1039\t        eq_xi_high,\n1040\t        layer,\n1041\t        (uint32_t)num_x,\n1042\t        __builtin_ctz((uint32_t)eq_low_cap),\n1043\t        lambda,\n1044\t        tmp_block_sums\n1045\t    );\n1046\t    int err = CHECK_KERNEL();\n1047\t    if (err != 0)\n1048\t        return err;\n1049\t\n1050\t    // Launch final reduction kernel.\n1051\t    return final_reduce_block_sums(tmp_block_sums, out, grid.x);\n1052\t}\n1053\t\n1054\t// Fused compute round + fold launcher.\n1055\t// src_pq_size is the pre-fold buffer size (2*pq_size).\n1056\t// Post-fold: num_x = pq_size / 2 = src_pq_size / 4.\n1057\textern \"C\" int _frac_compute_round_and_fold(\n1058\t    const FpExt *eq_xi_low,\n1059\t    const FpExt *eq_xi_high,\n1060\t    const FracExt *src_pq_buffer,\n1061\t    FracExt *dst_pq_buffer,\n1062\t    size_t src_pq_size,           // Pre-fold size in FracExt\n1063\t    size_t eq_low_cap,\n1064\t    FpExt lambda,\n1065\t    FpExt r_prev,\n1066\t    FpExt *out,                   // Output: [d=2] final results\n1067\t    FpExt *tmp_block_sums         // Temporary buffer: [gridDim.x * d]\n1068\t) {\n1069\t    assert(src_pq_size > 2);\n1070\t    // Post-fold sizes\n1071\t    size_t pq_size = src_pq_size >> 1;\n1072\t    size_t num_x = pq_size >> 1;\n1073\t    assert(num_x > 0);\n1074\t\n1075\t    auto [grid, block] = frac_compute_round_launch_params(num_x);\n1076\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n1077\t\n1078\t    // Launch fused kernel - writes to tmp_block_sums and dst_pq_buffer\n1079\t    compute_round_and_fold_kernel<<<grid, block, shmem_bytes>>>(\n1080\t        eq_xi_low,\n1081\t        eq_xi_high,\n1082\t        src_pq_buffer,\n1083\t        (uint32_t)num_x,\n1084\t        __builtin_ctz((uint32_t)eq_low_cap),\n1085\t        lambda,\n1086\t        r_prev,\n1087\t        tmp_block_sums,\n1088\t        dst_pq_buffer\n1089\t    );\n1090\t    int err = CHECK_KERNEL();\n1091\t    if (err != 0)\n1092\t        return err;\n1093\t\n1094\t    // Launch final reduction kernel - reads from tmp_block_sums, writes to output.\n1095\t    return final_reduce_block_sums(tmp_block_sums, out, grid.x);\n1096\t}\n1097\t\n1098\t// Fused compute round + fold launcher (IN-PLACE version).\n1099\t// src_pq_size is the pre-fold buffer size (2*pq_size).\n1100\t// Post-fold: num_x = pq_size / 2 = src_pq_size / 4.\n1101\textern \"C\" int _frac_compute_round_and_fold_inplace(\n1102\t    const FpExt *eq_xi_low,\n1103\t    const FpExt *eq_xi_high,\n1104\t    FracExt *pq_buffer,           // In-place: reads src_pq_size, writes pq_size\n1105\t    size_t src_pq_size,           // Pre-fold size in FracExt\n1106\t    size_t eq_low_cap,\n1107\t    FpExt lambda,\n1108\t    FpExt r_prev,\n1109\t    FpExt *out,                   // Output: [d=2] final results\n1110\t    FpExt *tmp_block_sums         // Temporary buffer: [gridDim.x * d]\n1111\t) {\n1112\t    assert(src_pq_size > 2);\n1113\t    // Post-fold sizes\n1114\t    size_t pq_size = src_pq_size >> 1;\n1115\t    size_t num_x = pq_size >> 1;\n1116\t    assert(num_x > 0);\n1117\t\n1118\t    auto [grid, block] = frac_compute_round_launch_params(num_x);\n1119\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n1120\t\n1121\t    // Launch fused in-place kernel - writes to tmp_block_sums and pq_buffer (first half)\n1122\t    compute_round_and_fold_inplace_kernel<<<grid, block, shmem_bytes>>>(\n1123\t        eq_xi_low,\n1124\t        eq_xi_high,\n1125\t        pq_buffer,\n1126\t        (uint32_t)num_x,\n1127\t        __builtin_ctz((uint32_t)eq_low_cap),\n1128\t        lambda,\n1129\t        r_prev,\n1130\t        tmp_block_sums\n1131\t    );\n1132\t    int err = CHECK_KERNEL();\n1133\t    if (err != 0)\n1134\t        return err;\n1135\t\n1136\t    // Launch final reduction kernel - reads from tmp_block_sums, writes to output.\n1137\t    return final_reduce_block_sums(tmp_block_sums, out, grid.x);\n1138\t}\n1139\t\n1140\textern \"C\" int _frac_precompute_m_build(\n1141\t    const FracExt *pq,\n1142\t    size_t rem_n,             // folded rem_n\n1143\t    size_t w,\n1144\t    FpExt lambda,\n1145\t    FpExt r_prev,             // challenge for the inline fold (only used when inline_fold=true)\n1146\t    bool inline_fold,         // true: pq is unfolded (rem_n+1 vars), false: pq is already folded\n1147\t    const FpExt *eq_tail_low,\n1148\t    const FpExt *eq_tail_high,\n1149\t    size_t eq_tail_low_cap,\n1150\t    size_t tail_tile,\n1151\t    FpExt *partial_out,\n1152\t    size_t partial_len,\n1153\t    FpExt *m_total\n1154\t) {\n1155\t    assert(rem_n > 0);\n1156\t    assert(w > 0 && w <= rem_n);\n1157\t    assert(tail_tile > 0);\n1158\t\n1159\t    uint32_t w_u32 = (uint32_t)w;\n1160\t    uint32_t rem_n_u32 = (uint32_t)rem_n;\n1161\t    uint32_t m = 1u << w_u32;\n1162\t    uint32_t tail_n = (uint32_t)rem_n - (uint32_t)w;\n1163\t    uint32_t k = 1u << tail_n;\n1164\t    uint32_t tail_tile_u32 = (uint32_t)tail_tile;\n1165\t    uint32_t num_blocks = div_ceil(k, tail_tile_u32);\n1166\t    size_t total_entries = (size_t)m * (size_t)m;\n1167\t    assert(partial_len >= (size_t)num_blocks * total_entries);\n1168\t\n1169\t    dim3 grid(num_blocks);\n1170\t    uint32_t log_eq_tail_low_cap = __builtin_ctz((uint32_t)eq_tail_low_cap);\n1171\t    int launch_err = 0;\n1172\t    if (inline_fold) {\n1173\t        launch_err = launch_precompute_m_build_partial_dispatch<true>(\n1174\t            w_u32,\n1175\t            grid,\n1176\t            pq,\n1177\t            rem_n_u32,\n1178\t            lambda,\n1179\t            r_prev,\n1180\t            eq_tail_low,\n1181\t            eq_tail_high,\n1182\t            log_eq_tail_low_cap,\n1183\t            tail_tile_u32,\n1184\t            partial_out\n1185\t        );\n1186\t    } else {\n1187\t        launch_err = launch_precompute_m_build_partial_dispatch<false>(\n1188\t            w_u32,\n1189\t            grid,\n1190\t            pq,\n1191\t            rem_n_u32,\n1192\t            lambda,\n1193\t            r_prev,\n1194\t            eq_tail_low,\n1195\t            eq_tail_high,\n1196\t            log_eq_tail_low_cap,\n1197\t            tail_tile_u32,\n1198\t            partial_out\n1199\t        );\n1200\t    }\n1201\t    if (launch_err != 0) {\n1202\t        return launch_err;\n1203\t    }\n1204\t    int err = CHECK_KERNEL();\n1205\t    if (err != 0) {\n1206\t        return err;\n1207\t    }\n1208\t\n1209\t    dim3 reduce_block(128);\n1210\t    dim3 reduce_grid(div_ceil((uint32_t)total_entries, reduce_block.x));\n1211\t    precompute_m_reduce_partials_kernel<<<reduce_grid, reduce_block>>>(\n1212\t        partial_out,\n1213\t        num_blocks,\n1214\t        (uint32_t)total_entries,\n1215\t        m_total\n1216\t    );\n1217\t    return CHECK_KERNEL();\n1218\t}\n1219\t\n1220\textern \"C\" int _frac_precompute_m_eval_round(\n1221\t    const FpExt *m_total,\n1222\t    size_t w,\n1223\t    size_t t,\n1224\t    const FpExt *eq_r_prefix,\n1225\t    const FpExt *eq_suffix,\n1226\t    FpExt *out\n1227\t) {\n1228\t    assert(w > 0);\n1229\t    assert(t < w);\n1230\t\n1231\t    dim3 block(256);\n1232\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n1233\t    precompute_m_eval_round_kernel<<<1, block, shmem_bytes>>>(\n1234\t        m_total,\n1235\t        (uint32_t)w,\n1236\t        (uint32_t)t,\n1237\t        eq_r_prefix,\n1238\t        eq_suffix,\n1239\t        out\n1240\t    );\n1241\t    return CHECK_KERNEL();\n1242\t}\n1243\t\n1244\textern \"C\" int _frac_multifold(\n1245\t    const FracExt *src,\n1246\t    FracExt *dst,\n1247\t    size_t rem_n,\n1248\t    size_t w,\n1249\t    const FpExt *eq_r_window\n1250\t) {\n1251\t    assert(rem_n > 0);\n1252\t    assert(w > 0 && w <= rem_n);\n1253\t\n1254\t    size_t out_len = 1u << (rem_n - w);\n1255\t    auto [grid, block] = kernel_launch_params(out_len, 256);\n1256\t\n1257\t#define DISPATCH_MULTIFOLD(W) \\\n1258\t    multifold_kernel<W><<<grid, block>>>(src, dst, (uint32_t)out_len, eq_r_window); \\\n1259\t    return CHECK_KERNEL();\n1260\t\n1261\t    switch (w) {\n1262\t        case 2: { DISPATCH_MULTIFOLD(2) }\n1263\t        case 3: { DISPATCH_MULTIFOLD(3) }\n1264\t        case 4: { DISPATCH_MULTIFOLD(4) }\n1265\t        case 5: { DISPATCH_MULTIFOLD(5) }\n1266\t        default: assert(false && \"unsupported w for multifold\"); return -1;\n1267\t    }\n1268\t#undef DISPATCH_MULTIFOLD\n1269\t}\n1270\t\n1271\textern \"C\" int _frac_fold_fpext_columns(const FracExt *src, FracExt *dst, size_t size, FpExt r) {\n1272\t    if (size <= 2) {\n1273\t        return 0;\n1274\t    }\n1275\t    // FracExt = {p, q} = 2 FpExt elements.\n1276\t    // size is in FracExt; quarter_fpext is in FpExt.\n1277\t    // quarter_fpext = (size / 4) * 2 = size / 2\n1278\t    uint32_t quarter_fpext = size >> 1;\n1279\t    auto [grid, block] = kernel_launch_params(quarter_fpext);\n1280\t    fold_ef_columns_kernel<<<grid, block>>>(\n1281\t        reinterpret_cast<const FpExt *>(src), reinterpret_cast<FpExt *>(dst), quarter_fpext, r\n1282\t    );\n1283\t    return CHECK_KERNEL();\n1284\t}\n1285\t\n1286\textern \"C\" int _frac_add_alpha(FracExt *data, size_t len, FpExt alpha) {\n1287\t    auto [grid, block] = kernel_launch_params(len);\n1288\t    add_alpha_kernel<<<grid, block>>>(data, len, alpha);\n1289\t    return CHECK_KERNEL();\n1290\t}\n1291\t\n1292\textern \"C\" int _frac_vector_scalar_multiply_ext_fp(FracExt *frac_vec, Fp scalar, uint32_t length) {\n1293\t    auto [grid, block] = kernel_launch_params(length);\n1294\t    frac_vector_scalar_multiply_kernel<Fp, FpExt>\n1295\t        <<<grid, block>>>(reinterpret_cast<std::pair<FpExt, FpExt> *>(frac_vec), scalar, length);\n1296\t    return CHECK_KERNEL();\n1297\t}\n1298\t\n1299\t\n1300\t// ============================================================================\n1301\t// Fused bit-reversal + K=2 GKR tree-build\n1302\t// ============================================================================\n1303\t\n1304\t// bit_rev() and index_t redeclared from supra/include/ntt/{ntt.cuh,parameters.cuh}\n1305\t// because the supra include path is not on the cuda-backend build search path.\n1306\ttypedef unsigned int index_t;\n1307\ttemplate<typename T>\n1308\t__device__ __forceinline__\n1309\tT bit_rev(T i, unsigned int nbits)\n1310\t{\n1311\t    return __brev(i) >> (8 * sizeof(unsigned int) - nbits);\n1312\t}\n1313\t\n1314\t// Fused bit-reversal + K=2 GKR tree-build kernel for FracExt.\n1315\t//\n1316\t// DERIVED FROM: bit_rev_permutation_z<T, Z_COUNT> in supra/ntt_bitrev.cu.\n1317\t// Diff vs the original template kernel:\n1318\t//   - Z_COUNT = 8 hardcoded (not a template param)\n1319\t//   - In-place: single `inout` pointer (original has separate `out`/`in`)\n1320\t//   - No poly_count / no 2-D grid: operates on one poly only\n1321\t//   - Extra `alpha` parameter: adds alpha to every denominator after bit-reversing\n1322\t//   - Two GKR tree layers (K=2) are computed inside shmem before writing to global mem,\n1323\t//     eliminating two separate kernel passes\n1324\t//   - __syncwarp() is used unconditionally (original conditionally uses __syncthreads()\n1325\t//     when Z_COUNT > WARP_SIZE, which is never true for Z_COUNT=8)\n1326\t//\n1327\t// Output layout for each Z-tile written at base_rev (i*step + base_rev, i=0..7):\n1328\t//   [0,1]  : layer-1 results  (tree level 2)\n1329\t//   [2,3]  : layer-0 results preserved (tree level 1 right half, for revert of layer 1)\n1330\t//   [4..7] : original+alpha preserved (leaves, for revert of layer 0)\n1331\t//\n1332\t// __launch_bounds__(256): not a correctness constraint — __syncwarp() is safe for any\n1333\t// multiple-of-32 bsize because each gid group is Z_COUNT=8 threads (always within one\n1334\t// warp) and different warps operate on independent shmem tiles. bsize=256 was chosen after\n1335\t// benchmarking: 2× faster than bsize=32 in isolation (1525 vs 754 GB/s at lg=24 on RTX\n1336\t// 5090). It requires 64KB dynamic shmem per block, so cudaFuncSetAttribute is used in the\n1337\t// launcher — but only once (static local), paid on the first call and never again.\n1338\t__launch_bounds__(256) __global__\n1339\tvoid bit_rev_frac_build_k2_kernel(\n1340\t    FracExt* inout, uint32_t lg_domain_size, FpExt alpha)\n1341\t{\n1342\t    constexpr uint32_t Z_COUNT = 8;\n1343\t    constexpr uint32_t LG_Z_COUNT = 3;\n1344\t\n1345\t    extern __shared__ unsigned char xchg_raw[];\n1346\t    FracExt (*xchg)[Z_COUNT][Z_COUNT] =\n1347\t        reinterpret_cast<FracExt (*)[Z_COUNT][Z_COUNT]>(xchg_raw);\n1348\t\n1349\t    uint32_t gid = threadIdx.x / Z_COUNT;\n1350\t    uint32_t idx = threadIdx.x % Z_COUNT;\n1351\t    uint32_t rev = bit_rev(idx, LG_Z_COUNT);\n1352\t\n1353\t    index_t step = (index_t)1 << (lg_domain_size - LG_Z_COUNT);\n1354\t    index_t tid = threadIdx.x + blockDim.x * (index_t)blockIdx.x;\n1355\t\n1356\t    #pragma unroll 1\n1357\t    do {\n1358\t        index_t group_idx = tid >> LG_Z_COUNT;\n1359\t        index_t group_rev = bit_rev(group_idx, lg_domain_size - 2*LG_Z_COUNT);\n1360\t\n1361\t        if (group_idx > group_rev)\n1362\t            continue;\n1363\t\n1364\t        index_t base_idx = group_idx * Z_COUNT + idx;\n1365\t        index_t base_rev = group_rev * Z_COUNT + idx;\n1366\t\n1367\t        FracExt regs[Z_COUNT];\n1368\t\n1369\t        #pragma unroll\n1370\t        for (uint32_t i = 0; i < Z_COUNT; i++) {\n1371\t            xchg[gid][i][rev] = (regs[i] = inout[i * step + base_idx]);\n1372\t            if (group_idx != group_rev)\n1373\t                regs[i] = inout[i * step + base_rev];\n1374\t        }\n1375\t\n1376\t        __syncwarp();\n1377\t\n1378\t        // Apply alpha + tree layers 0 and 1 to transposed tile, then write to base_rev\n1379\t        {\n1380\t            FracExt* row = xchg[gid][rev];\n1381\t            #pragma unroll\n1382\t            for (uint32_t i = 0; i < Z_COUNT; i++)\n1383\t                row[i].q = row[i].q + alpha;\n1384\t            #pragma unroll\n1385\t            for (uint32_t i = 0; i < 4; i++)  // tree layer 0: pairs (0,4),(1,5),(2,6),(3,7)\n1386\t                frac_add_inplace(row[i], row[i + 4]);\n1387\t            #pragma unroll\n1388\t            for (uint32_t i = 0; i < 2; i++)  // tree layer 1: pairs (0,2),(1,3)\n1389\t                frac_add_inplace(row[i], row[i + 2]);\n1390\t        }\n1391\t        #pragma unroll\n1392\t        for (uint32_t i = 0; i < Z_COUNT; i++)\n1393\t            inout[i * step + base_rev] = xchg[gid][rev][i];\n1394\t\n1395\t        if (group_idx == group_rev)\n1396\t            continue;\n1397\t\n1398\t        __syncwarp();\n1399\t\n1400\t        #pragma unroll\n1401\t        for (uint32_t i = 0; i < Z_COUNT; i++)\n1402\t            xchg[gid][i][rev] = regs[i];\n1403\t\n1404\t        __syncwarp();\n1405\t\n1406\t        // Apply alpha + tree layers 0 and 1 to transposed tile, then write to base_idx\n1407\t        {\n1408\t            FracExt* row = xchg[gid][rev];\n1409\t            #pragma unroll\n1410\t            for (uint32_t i = 0; i < Z_COUNT; i++)\n1411\t                row[i].q = row[i].q + alpha;\n1412\t            #pragma unroll\n1413\t            for (uint32_t i = 0; i < 4; i++)\n1414\t                frac_add_inplace(row[i], row[i + 4]);\n1415\t            #pragma unroll\n1416\t            for (uint32_t i = 0; i < 2; i++)\n1417\t                frac_add_inplace(row[i], row[i + 2]);\n1418\t        }\n1419\t        #pragma unroll\n1420\t        for (uint32_t i = 0; i < Z_COUNT; i++)\n1421\t            inout[i * step + base_idx] = xchg[gid][rev][i];\n1422\t\n1423\t    } while ((tid += blockDim.x*gridDim.x) < step);\n1424\t    // Note: the original bit_rev_permutation_z guards this with \"Z_COUNT <= WARP_SIZE &&\"\n1425\t    // to prevent register spills when Z_COUNT > WARP_SIZE. Z_COUNT=8 is always <= 32.\n1426\t}\n1427\t\n1428\t// Fused bitrev + K=2 tree build for a single FracExt buffer.\n1429\t// Requires domain_size >= 256 (uses Z-tile shmem kernel).\n1430\t// Applies alpha to denominators and fuses tree layers 0 and 1 in shmem.\n1431\textern \"C\" int _bit_rev_frac_ext_build_k2(\n1432\t    FracExt* inout, uint32_t lg_domain_size, FpExt alpha)\n1433\t{\n1434\t    constexpr uint32_t Z_COUNT = 8;\n1435\t    constexpr uint32_t bsize = 256;\n1436\t    constexpr size_t shmem_bytes = (size_t)bsize * Z_COUNT * sizeof(FracExt);  // 64 KB\n1437\t    // Raise the per-block dynamic shmem limit once (static → paid on first call only).\n1438\t    static const cudaError_t shmem_err = cudaFuncSetAttribute(\n1439\t        bit_rev_frac_build_k2_kernel,\n1440\t        cudaFuncAttributeMaxDynamicSharedMemorySize,\n1441\t        (int)shmem_bytes);\n1442\t    if (shmem_err != cudaSuccess) return shmem_err;\n1443\t    size_t domain_size = (size_t)1 << lg_domain_size;\n1444\t    if (domain_size < (size_t)(bsize * Z_COUNT))\n1445\t        return cudaErrorInvalidValue;\n1446\t    uint32_t grid_x = (uint32_t)(domain_size / Z_COUNT / bsize);\n1447\t    bit_rev_frac_build_k2_kernel<<<dim3(grid_x), bsize, shmem_bytes>>>(\n1448\t        inout, lg_domain_size, alpha);\n1449\t    return CHECK_KERNEL();\n1450\t}\n1451\t\n1452\t} // namespace fractional_sumcheck_gkr\n1453\t"}]},"parent_tool_use_id":"toolu_01YKGWc6EpDAHBzhuTC5oo8y","session_id":"97df75af-c1b3-4850-8566-f6b18608e3d5","uuid":"bba4b15c-082d-46ad-9ede-c203779e5272","timestamp":"2026-04-15T23:39:34.594Z"}
