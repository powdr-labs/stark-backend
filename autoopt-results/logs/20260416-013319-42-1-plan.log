{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YFAe3YFw64vE54w1BgceGe","type":"tool_result","content":"680\t\n681\textern \"C\" int _stacked_reduction_sumcheck_mle_round(\n682\t    const FpExt *const *q_evals,\n683\t    const FpExt *eq_r_ns,\n684\t    const FpExt *k_rot_ns,\n685\t    const UnstackedSlice *unstacked_cols,\n686\t    const FpExt *lambda_pows,\n687\t    uint64_t *output, // [S_DEG * D_EF] - atomic accumulator, reduced on CPU\n688\t    uint32_t q_height,\n689\t    uint32_t window_len,\n690\t    uint32_t num_y,\n691\t    uint32_t sm_count\n692\t) {\n693\t    // Smaller block size for more eligible warps to hide latency\n694\t    auto [grid, block] = kernel_launch_params(num_y, 256);\n695\t    assert(sm_count);\n696\t\n697\t    // Heuristic auto-tuning for window-stride (grid.y):\n698\t    // - Increase work per thread (reduce atomics) by targeting multiple window iterations/thread\n699\t    // - Ensure enough total blocks to keep SMs busy when num_y is small\n700\t    constexpr uint32_t WAVES_TARGET = 4; // blocks/SM target\n701\t    constexpr uint32_t ITERS_MIN = 4;    // prefer >= this many window iterations/thread\n702\t    constexpr uint32_t ITERS_MAX = 16;   // prefer <= this many window iterations/thread\n703\t\n704\t    uint32_t stride_occ = div_ceil(sm_count * WAVES_TARGET, grid.x);\n705\t    uint32_t stride_loop_lo = div_ceil(window_len, ITERS_MAX);\n706\t    uint32_t stride_loop_hi = div_ceil(window_len, ITERS_MIN);\n707\t\n708\t    uint32_t lo = std::max(1u, std::max(stride_occ, stride_loop_lo));\n709\t    uint32_t hi = std::min(std::min(window_len, MAX_GRID_DIM), stride_loop_hi);\n710\t\n711\t    uint32_t tuned_stride = (lo <= hi) ? lo : std::min(lo, std::min(window_len, MAX_GRID_DIM));\n712\t    grid.y = tuned_stride;\n713\t\n714\t    // Ensure that atomic add does not overflow u64\n715\t    assert((size_t)num_y * grid.y < (size_t)1u << 32);\n716\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n717\t\n718\t    stacked_reduction_sumcheck_mle_round_kernel<<<grid, block, shmem_bytes>>>(\n719\t        q_evals, eq_r_ns, k_rot_ns, unstacked_cols, lambda_pows, output, q_height, window_len, num_y\n720\t    );\n721\t\n722\t    return CHECK_KERNEL();\n723\t}\n724\t\n725\textern \"C\" int _stacked_reduction_sumcheck_mle_round_degenerate(\n726\t    const FpExt *const *q_evals,\n727\t    const FpExt *eq_ub_ptr,\n728\t    FpExt eq_r,\n729\t    FpExt k_rot_r,\n730\t    const UnstackedSlice *unstacked_cols,\n731\t    const FpExt *lambda_pows,\n732\t    uint64_t *output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n733\t    uint32_t q_height,\n734\t    uint32_t window_len,\n735\t    uint32_t l_skip,\n736\t    uint32_t round\n737\t) {\n738\t    auto shift_factor = l_skip + round;\n739\t    dim3 block(std::min(window_len, 256u));\n740\t    dim3 grid(1);\n741\t    // block.x <= 512 < 2^32 so atomic u64 will not overflow\n742\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n743\t\n744\t    stacked_reduction_sumcheck_mle_round_degenerate_kernel<<<grid, block, shmem_bytes>>>(\n745\t        q_evals,\n746\t        eq_ub_ptr,\n747\t        eq_r,\n748\t        k_rot_r,\n749\t        unstacked_cols,\n750\t        lambda_pows,\n751\t        output,\n752\t        q_height,\n753\t        window_len,\n754\t        shift_factor\n755\t    );\n756\t\n757\t    return CHECK_KERNEL();\n758\t}\n759\t\n760\textern \"C\" int _batched_stacked_reduction_sumcheck_mle_round_degenerate(\n761\t    const DegenMleDesc *descs,\n762\t    uint32_t num_descs,\n763\t    const FpExt *const *q_evals,\n764\t    const FpExt *eq_ub_base,\n765\t    const UnstackedSlice *unstacked_cols_base,\n766\t    const FpExt *lambda_pows_base,\n767\t    uint64_t *output,\n768\t    uint32_t q_height,\n769\t    uint32_t shift_factor\n770\t) {\n771\t    if (num_descs == 0) return 0;\n772\t    dim3 grid(num_descs);\n773\t    dim3 block(256);\n774\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n775\t\n776\t    batched_degenerate_mle_round_kernel<<<grid, block, shmem_bytes>>>(\n777\t        descs, q_evals, eq_ub_base, unstacked_cols_base, lambda_pows_base,\n778\t        output, q_height, shift_factor\n779\t    );\n780\t\n781\t    return CHECK_KERNEL();\n782\t}\n783\t\n784\textern \"C\" int _batched_stacked_reduction_sumcheck_mle_round(\n785\t    const NonDegenMleDesc *descs,\n786\t    const uint32_t *block_prefix_sums,\n787\t    uint32_t num_descs,\n788\t    uint32_t total_blocks,\n789\t    const FpExt *const *q_evals,\n790\t    const FpExt *eq_r_ns,\n791\t    const FpExt *k_rot_ns,\n792\t    const UnstackedSlice *unstacked_cols_base,\n793\t    const FpExt *lambda_pows_base,\n794\t    uint64_t *output,\n795\t    uint32_t q_height\n796\t) {\n797\t    if (total_blocks == 0) return 0;\n798\t    dim3 grid(total_blocks);\n799\t    dim3 block(256);\n800\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n801\t\n802\t    batched_nondegen_mle_round_kernel<<<grid, block, shmem_bytes>>>(\n803\t        descs, block_prefix_sums, num_descs,\n804\t        q_evals, eq_r_ns, k_rot_ns, unstacked_cols_base, lambda_pows_base,\n805\t        output, q_height\n806\t    );\n807\t\n808\t    return CHECK_KERNEL();\n809\t}\n810\t"}]},"parent_tool_use_id":"toolu_0192Qvd465i9XpeWnmukTiDV","session_id":"97df75af-c1b3-4850-8566-f6b18608e3d5","uuid":"66b201ed-0df7-4ee1-8292-2af6adb038af","timestamp":"2026-04-16T00:13:31.511Z"}
