t *k_rot_ns,\n667-    FpExt k_rot_uni_0,\n668-    FpExt k_rot_uni_1,\n669-    uint32_t max_n\n670-) {\n671-    auto [grid, block] = kernel_launch_params(1 << max_n);\n672-    grid.y = max_n + 1;\n673-\n674-    initialize_k_rot_from_eq_segments_kernel<<<grid, block>>>(\n675-        eq_r_ns, k_rot_ns, k_rot_uni_0, k_rot_uni_1\n676-    );\n677-\n678-    return CHECK_KERNEL();\n679-}\n680-\n681-extern \"C\" int _stacked_reduction_sumcheck_mle_round(\n682-    const FpExt *const *q_evals,\n683-    const FpExt *eq_r_ns,\n684-    const FpExt *k_rot_ns,\n685-    const UnstackedSlice *unstacked_cols,\n686-    const FpExt *lambda_pows,\n687-    uint64_t *output, // [S_DEG * D_EF] - atomic accumulator, reduced on CPU","numLines":123}}
