ing_add(meta.interp_offset);\n1823\t\n1824\t            let mut widths_so_far = 0usize;\n1825\t            let sels_ptr = base_ptr.wrapping_add(widths_so_far * interpolated_height);\n1826\t            widths_so_far += 3; // selector width is always 3\n1827\t\n1828\t            let prep_ptr = if meta.has_preprocessed {\n1829\t                MainMatrixPtrs {\n1830\t                    data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1831\t                    air_width: air_width_for_mat(meta.need_rot, mats[0].width()),\n1832\t                }\n1833\t            } else {\n1834\t                MainMatrixPtrs {\n1835\t                    data: std::ptr::null(),\n1836\t                    air_width: 0,\n1837\t                }\n1838\t            };\n1839\t            if meta.has_preprocessed {\n1840\t                widths_so_far += mats[0].width();\n1841\t            }\n1842\t            let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1843\t                .iter()\n1844\t                .map(|m| {\n1845\t                    let main_ptr = MainMatrixPtrs {\n1846\t                        data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1847\t                        air_width: air_width_for_mat(meta.need_rot, m.width()),\n1848\t                    };\n1849\t                    widths_so_far += m.width();\n1850\t                    main_ptr\n1851\t                })\n1852\t                .collect_vec();\n1853\t            debug_assert_eq!(widths_so_far, meta.num_columns);\n1854\t            let pool_buf = &mut self.d_main_ptrs_pool[meta.trace_idx];\n1855\t            main_ptrs.copy_to(pool_buf)?;\n1856\t            let main_ptrs_dev = unsafe {\n1857\t                DeviceBuffer::non_owning(pool_buf.as_mut_ptr(), main_ptrs.len())\n1858\t            };\n1859\t\n1860\t            early_eval.push(TraceCtx {\n1861\t                trace_idx: meta.trace_idx,\n1862\t                air_idx: meta.air_idx,\n1863\t                n_lift: meta.n_lift,\n1864\t                num_y: meta.num_y as u32,\n1865\t                has_constraints: meta.has_constraints,\n1866\t                has_interactions: meta.has_interactions,\n1867\t                norm_factor: meta.norm_factor,\n1868\t                eq_xi_ptr: eq_xi_tree.get_ptr(log_num_y),\n1869\t                sels_ptr,\n1870\t                prep_ptr,\n1871\t                main_ptrs_dev,\n1872\t                public_ptr: self.public_values_per_trace[meta.trace_idx].as_ptr(),\n1873\t                eq_3bs_ptr: self.d_eq_3b_per_trace[meta.trace_idx].as_ptr(),\n1874\t            });\n1875\t        }\n1876\t\n1877\t        let d_challenges_ptr = self.d_challenges.as_ptr();\n1878\t\n1879\t        // Late traces (num_y=1): always use monomial\n1880\t        let late_logup_traces: Vec<_> = late_eval.iter().filter(|t| t.has_interactions).collect();\n1881\t        if !late_logup_traces.is_empty() {\n1882\t            let logup_combs: Vec<_> = late_logup_traces\n1883\t                .iter()\n1884\t                .map(|t| {\n1885\t                    self.logup_combinations[t.trace_idx]\n1886\t                        .as_ref()\n1887\t                        .expect(\"missing logup monomial combinations for late trace\")\n1888\t                })\n1889\t                .collect();\n1890\t            let batch =\n1891\t                LogupMonomialBatch::new(late_logup_traces.iter().copied(), self.pk, &logup_combs)?;\n1892\t            let out = batch\n1893\t                .evaluate(1)\n1894\t                .map_err(LogupZerocheckError::MleInteractionEval)?;\n1895\t            let host = out.to_host()?;\n1896\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1897\t                self.logup_tilde_evals[trace_idx][0] = host[i].p * late_logup_traces[i].norm_factor;\n1898\t                self.logup_tilde_evals[trace_idx][1] = host[i].q;\n1899\t            }\n1900\t        }\n1901\t        let late_mono_traces: Vec<_> = late