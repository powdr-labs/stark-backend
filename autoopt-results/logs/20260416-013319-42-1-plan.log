43\t    index_t tid = threadIdx.x + blockDim.x * (index_t)blockIdx.x;\n44\t    const uint32_t poly_idx = blockIdx.y + blockIdx.z * gridDim.y; // [DIFF]: use gridDim.y to calculate poly_idx\n45\t    if (poly_idx >= poly_count)\n46\t        return;\n47\t    d_inout += static_cast<size_t>(poly_idx) * padded_poly_size;   // [DIFF]: move in/out ptr to another row\n48\t\n49\t    const index_t diff_mask = (1 << (iterations - 1)) - 1;\n50\t    const index_t inp_mask = ((index_t)1 << stage) - 1;\n51\t    const index_t out_mask = ((index_t)1 << (stage + iterations - 1)) - 1;\n52\t\n53\t    const index_t tiz = (tid & ~diff_mask) * z_count + (tid & diff_mask);\n54\t    const index_t thread_ntt_pos = (tiz >> (iterations - 1)) & inp_mask;\n55\t\n56\t    // rearrange |tiz|'s bits\n57\t    index_t idx0 = (tiz & ~out_mask) | ((tiz << stage) & out_mask);\n58\t    idx0 = idx0 * 2 + thread_ntt_pos;\n59\t    index_t idx1 = idx0 + ((index_t)1 << stage);\n60\t\n61\t    fr_t r[2][z_count];\n62\t\n63\t    if (coalesced) {\n64\t        coalesced_load<z_count>(r[0], d_inout, idx0, stage + 1);\n65\t        coalesced_load<z_count>(r[1], d_inout, idx1, stage + 1);\n66\t        transpose<z_count>(r[0]);\n67\t        __syncwarp();\n68\t        transpose<z_count>(r[1]);\n69\t    } else {\n70\t        unsigned int z_shift = inp_mask==0 ? iterations : 0;\n71\t        #pragma unroll\n72\t        for (int z = 0; z < z_count; z++) {\n73\t            r[0][z] = d_inout[idx0 + (z << z_shift)];\n74\t            r[1][z] = d_inout[idx1 + (z << z_shift)];\n75\t        }\n76\t    }\n77\t\n78\t    if (stage != 0) {\n79\t        unsigned int thread_ntt_idx = (tiz & diff_mask) * 2;\n80\t        unsigned int nbits = MAX_LG_DOMAIN_SIZE - stage;\n81\t        index_t idx0 = bit_rev(thread_ntt_idx, nbits);\n82\t        index_t root_idx0 = idx0 * thread_ntt_pos;\n83\t        index_t root_idx1 = root_idx0 + (thread_ntt_pos << (nbits - 1));\n84\t\n85\t        fr_t first_root, second_root;\n86\t        get_intermediate_roots(first_root, second_root,\n87\t                               root_idx0, root_idx1, d_partial_twiddles);\n88\t        r[0][0] = r[0][0] * first_root;\n89\t        r[1][0] = r[1][0] * second_root;\n90\t\n91\t        if (z_count > 1) {\n92\t            fr_t first_root_z = get_intermediate_root(idx0, d_partial_twiddles);\n93\t            unsigned int off = (nbits - 1) / LG_WINDOW_SIZE;\n94\t            unsigned int win = off * LG_WINDOW_SIZE;\n95\t            fr_t second_root_z = d_partial_twiddles[off][1 << (nbits - 1 - win)];\n96\t\n97\t            second_root_z *= first_root_z;\n98\t            #pragma unroll\n99\t            for (int z = 1; z < z_count; z++) {\n100\t                first_root *= first_root_z;\n101\t                second_root *= second_root_z;\n102\t                r[0][z] = r[0][z] * first_root;\n103\t                r[1][z] = r[1][z] * second_root;\n104\t            }\n105\t        }\n106\t    }\n107\t\n108\t    #pragma unroll\n109\t    for (int z = 0; z < z_count; z++) {\n110\t        fr_t t = r[1][z];\n111\t        r[1][z] = r[0][z] - t;\n112\t        r[0][z] = r[0][z] + t;\n113\t    }\n114\t\n115\t    #pragma unroll 1\n116\t    for (unsigned int s = 1; s < min(iterations, 6u); s++) {\n117\t        unsigned int laneMask = 1 << (s - 1);\n118\t        unsigned int thrdMask = (1 << s) - 1;\n119\t        unsigned int rank = threadIdx.x & thrdMask;\n120\t        bool pos = rank < laneMask;\n121\t\n122\t        fr_t root = d_radix6_twiddles[rank << (6 - (s + 1))];\n123\t\n124\t        #pragma unroll\n125\t        for (int z = 0; z < z_count; z++) {\n126\t            fr_t t = fr_t::csel(r[1][z], r[0][z], pos);\n127\t\n128\t            t.shfl_bfly(laneMask);\n129\t\n130\t            r[0][z] = fr_t::csel(r[0][z], t, pos);\n131\t            r[1][z] = fr_t::csel(t, r[1][z], pos);\n132\t\n133\t            t = root * r[1][z];\n134\t            r[1][z] = r[0][z] - t;\n135\t            r[0][z] = r[0][z] + t;\n136\t        }\n137\t    }\n138\t\n139\t    #pragma unroll 1\n140\t    for (unsigned int s = 6; s < iterations; s++) {\n141\t        unsigned int laneMask = 1 << (s - 1);\n142\t        unsigned int thrdMask = (1 << s) - 1;\n143\t        unsigned int rank = threadIdx.x & thrdMask;\n144\t        bool pos = rank < laneMask;\n145\t\n146\t        fr_t root = d_radixX_twiddles[rank << (radix - (s + 1))];\n147\t\n148\t        fr_t (*xchg)[z_count] = reinterpret_cast<decltype(xchg)>(shared_exchange);\n149\t\n150\t        #pragma unroll\n151\t        for (int z = 0; z < z_count; z++) {\n152\t            fr_t t = fr_t::csel(r[1][z], r[0][z], pos);\n153\t            xchg[threadIdx.x][z] = t;\n154\t        }\n155\t\n156\t        __syncthreads();\n157\t\n158\t        #pragma unroll\n159\t        for (int z = 0; z < z_count; z++) {\n160\t            fr_t t = xchg[threadIdx.x ^ laneMask][z];\n161\t\n162\t            r[0][z] = fr_t::csel(r[0][z], t, pos);\n163\t            r[1][z] = fr_t::csel(t, r[1][z], pos);\n164\t\n165\t            t = root * r[1][z];\n166\t            r[1][z] = r[0][z] - t;\n167\t            r[0][z] = t + r[0][z];\n168\t        }\n169\t\n170\t        __syncthreads();\n171\t    }\n172\t\n173\t    if (is_intt && (stage + iterations) == lg_domain_size) {\n174\t        #pragma unroll\n175\t        for (int z = 0; z < z_count; z++) {\n176\t            r[0][z] = r[0][z] * d_domain_size_inverse;\n177\t            r[1][z] = r[1][z] * d_domain_size_inverse;\n178\t        }\n179\t    }\n180\t\n181\t    // rotate \"iterations\" bits in indices\n182\t    index_t mask = (index_t)((1 << iterations) - 1) << stage;\n183\t    index_t rotw = idx0 & mask;\n184\t    rotw = (rotw >> 1) | (rotw << (iterations - 1));\n185\t    idx0 = (idx0 & ~mask) | (rotw & mask);\n186\t    rotw = idx1 & mask;\n187\t    rotw = (rotw >> 1) | (rotw << (iterations - 1));\n188\t    idx1 = (idx1 & ~mask) | (rotw & mask);\n189\t\n190\t    if (coalesced) {\n191\t        transpose<z_count>(r[0]);\n192\t        __syncwarp();\n193\t        transpose<z_cou