mputeM if:\n    // - rem_n >= precompute_m_min_n (default 22)\n    // - rounds_left >= GKR_WINDOW_SIZE (3)\n    // - tail blocks >= min_blocks_threshold\n}\n```\n\n**PrecomputeM Window Loop:**\n```rust\n// For each 3-variable window:\nfor t in 0..w {  // w = GKR_WINDOW_SIZE = 3\n    // Evaluate M matrix round by round\n    unsafe {\n        frac_precompute_m_eval_round_raw(\n            m_ptr,\n            w,\n            t,\n            eq_r_prefix_buffer.as_ptr(),\n            eq_suffix_buffer.as_ptr(),\n            d_sum_evals.as_mut_ptr(),\n        )\n        .map_err(FractionalSumcheckError::ComputeRound)?;\n    }\n    \n    // Observe/update like normal round\n    prev_r = observe_and_update(...)?;\n    window_rs.push(r);\n}\n```\n\n**M-Building (lines 909-925):**\n```rust\nunsafe {\n    frac_precompute_m_build_raw(\n        build_src,           // Input: layer or active_pq\n        rem_n,               // Remaining variables\n        w,                   // Window size (3)\n        lambda,\n        r_fold,              // Previous round challenge\n        pending_fold,        // inline fold flag\n        eq_tail_low,\n        eq_tail_high,\n        eq_low_cap,\n        tail_tile,           // Tiling for parallelization\n        m_partial_buffer.as_mut_ptr(),\n        partial_len,\n        m_ptr,               // Output M matrix\n    )\n    .map_err(FractionalSumcheckError::ComputeRound)?;\n}\n```\n\n**Multifold (lines 987-995):**\n```rust\nunsafe {\n    frac_multifold_raw(\n        multifold_src,\n        active_pq.as_mut_ptr(),\n        buf_vars,            // rem_n or rem_n+1\n        w_fold,              // w or w+1 (if pending_fold)\n        d_eq_r_window,\n    )\n    .map_err(FractionalSumcheckError::FoldColumns)?;\n}\n```\n\n### **6. Reconstruct S Evaluations (lines 1126-1163)**\n\n```rust\nfn reconstruct_s_evals(\n    d_sum_evals: &DeviceBuffer<EF>,\n    prev_s_eval: EF,\n    xi_j: EF,\n    eq_r_acc: EF,\n) -> Result<([EF; GKR_S_DEG], [EF; GKR_S_DEG]),