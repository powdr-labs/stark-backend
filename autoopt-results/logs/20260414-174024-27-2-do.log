{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JeEQVGZptTHLnHQhZ4iVGA","type":"tool_result","content":"150\t\n151\tfn precompute_m_min_blocks_threshold() -> usize {\n152\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_BLOCKS\")\n153\t        .ok()\n154\t        .and_then(|val| val.parse::<usize>().ok())\n155\t        .unwrap_or(PRECOMPUTE_M_DEFAULT_MIN_BLOCKS)\n156\t        .max(1)\n157\t}\n158\t\n159\tfn precompute_m_num_tail_blocks(rem_n: usize, w: usize, tail_tile: usize) -> usize {\n160\t    let tail_n = rem_n - w;\n161\t    (1usize << tail_n).div_ceil(tail_tile)\n162\t}\n163\t\n164\tfn precompute_m_target_blocks() -> usize {\n165\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_TARGET_BLOCKS\")\n166\t        .ok()\n167\t        .and_then(|val| val.parse::<usize>().ok())\n168\t        .unwrap_or(PRECOMPUTE_M_DEFAULT_TARGET_BLOCKS)\n169\t        .max(1)\n170\t}\n171\t\n172\tfn precompute_m_tail_tile_override() -> Option<usize> {\n173\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_TAIL_TILE\")\n174\t        .ok()\n175\t        .and_then(|val| val.parse::<usize>().ok())\n176\t        .map(|v| v.clamp(PRECOMPUTE_M_MIN_TAIL_TILE, PRECOMPUTE_M_TAIL_TILE))\n177\t}\n178\t\n179\tfn precompute_m_min_n() -> usize {\n180\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_N\")\n181\t        .ok()\n182\t        .and_then(|val| val.parse::<usize>().ok())\n183\t        .unwrap_or(GKR_WINDOW_DEFAULT_MIN_N)\n184\t}\n185\t\n186\tfn precompute_m_build_tail_tile(\n187\t    rem_n: usize,\n188\t    w: usize,\n189\t    min_blocks_threshold: usize,\n190\t    target_blocks: usize,\n191\t    tail_tile_override: Option<usize>,\n192\t) -> usize {\n193\t    if let Some(tile) = tail_tile_override {\n194\t        return tile;\n195\t    }\n196\t    let tail_n = rem_n - w;\n197\t    let k = 1usize << tail_n;\n198\t    let target_blocks = target_blocks.max(min_blocks_threshold).max(1);\n199\t    let desired_tile = k.div_ceil(target_blocks).max(1);\n200\t    desired_tile.clamp(PRECOMPUTE_M_MIN_TAIL_TILE, PRECOMPUTE_M_TAIL_TILE)\n201\t}\n202\t\n203\tfn choose_precompute_m_window_w(\n204\t    rem_n: usize,\n205\t    rounds_left: usize,\n206\t    min_blocks_threshold: usize,\n207\t    target_blocks: usize,\n208\t    tail_tile_override: Option<usize>,\n209\t    min_n: usize,\n210\t) -> Option<usize> {\n211\t    if rem_n < min_n || rounds_left < GKR_WINDOW_SIZE {\n212\t        return None;\n213\t    }\n214\t    let w = GKR_WINDOW_SIZE;\n215\t    let tail_tile = precompute_m_build_tail_tile(\n216\t        rem_n,\n217\t        w,\n218\t        min_blocks_threshold,\n219\t        target_blocks,\n220\t        tail_tile_override,\n221\t    );\n222\t    (precompute_m_num_tail_blocks(rem_n, w, tail_tile) >= min_blocks_threshold).then_some(w)\n223\t}\n224\t\n225\tfn choose_round_strategy(\n226\t    round: usize,\n227\t    precompute_m_env: bool,\n228\t    precompute_m_min_blocks_threshold: usize,\n229\t    precompute_m_target_blocks: usize,\n230\t    precompute_m_tail_tile_override: Option<usize>,\n231\t    precompute_m_min_n: usize,\n232\t) -> GkrRoundStrategy {\n233\t    if !precompute_m_env {\n234\t        return GkrRoundStrategy::FoldEval;\n235\t    }\n236\t    let start_base = 1usize;\n237\t    let stop = round.div_ceil(2);\n238\t    let rem_n = round - start_base;\n239\t    let rounds_left = stop - start_base;\n240\t    if choose_precompute_m_window_w(\n241\t        rem_n,\n242\t        rounds_left,\n243\t        precompute_m_min_blocks_threshold,\n244\t        precompute_m_target_blocks,\n245\t        precompute_m_tail_tile_override,\n246\t        precompute_m_min_n,\n247\t    )\n248\t    .is_none()\n249\t    {\n250\t        return GkrRoundStrategy::FoldEval;\n251\t    }\n252\t\n253\t    GkrRoundStrategy::PrecomputeM\n254\t}\n255\t\n256\tfn eval_mle_table(points: &[EF], out: &mut [EF]) {\n257\t    // w <= 5 so CPU builds are trivial; avoid GPU kernel/alloc overhead for tiny tables.\n258\t    let n = points.len();\n259\t    let size = 1usize << n;\n260\t    debug_assert!(out.len() >= size);\n261\t    for (bits, dst) in out.iter_mut().enumerate().take(size) {\n262\t        let mut acc = EF::ONE;\n263\t        for (i, &x) in points.iter().enumerate() {\n264\t            let bit = ((bits >> (n - 1 - i)) & 1) == 1;\n265\t            acc *= if bit { x } else { EF::ONE - x };\n266\t        }\n267\t        *dst = acc;\n268\t    }\n269\t}\n270\t\n271\t/// Get low/high eq pointers for the tail portion of the eq buffer, skipping `drop_count` layers.\n272\t/// See `docs/cuda-backend/gkr-prover.md` § \"Eq buffer sqrt decomposition\".\n273\tfn eq_tail_ptrs(\n274\t    eq_buffer: &SqrtEqLayers,\n275\t    drop_count: usize,\n276\t) -> (*const EF, *const EF, usize, usize) {\n277\t    let mut high_n = eq_buffer.high_n();\n278\t    let mut low_n = eq_buffer.low_n();\n279\t    let total_n = high_n + low_n;\n280\t    if drop_count >= total_n {\n281\t        return (std::ptr::null(), std::ptr::null(), 1, 0);\n282\t    }\n283\t    if drop_count <= high_n {\n284\t        high_n -= drop_count;\n285\t    } else {\n286\t        low_n -= drop_count - high_n;\n287\t        high_n = 0;\n288\t    }\n289\t    let tail_n = low_n + high_n;\n290\t    if tail_n == 0 {\n291\t        (std::ptr::null(), std::ptr::null(), 1, 0)\n292\t    } else {\n293\t        (\n294\t            eq_buffer.low.get_ptr(low_n),\n295\t            eq_buffer.high.get_ptr(high_n),\n296\t            1 << low_n,\n297\t            tail_n,\n298\t        )\n299\t    }"}]},"parent_tool_use_id":"toolu_018EAFmb1kYYsAgJQ1wuDZsR","session_id":"3d1d6996-d207-40ca-9042-54ec7bd5b430","uuid":"51a8750c-e6c4-418c-bafb-e573d0e19460","timestamp":"2026-04-14T16:46:48.656Z"}
