pacity and whether last round\n\n### **5. PrecomputeM Path (lines 821-1050)**\n\n**Strategy Selection:**\n```rust\nfn choose_round_strategy(...) -> GkrRoundStrategy {\n    if !precompute_m_env { return GkrRoundStrategy::FoldEval; }\n    // Only use PrecomputeM if:\n    // - rem_n >= precompute_m_min_n (default 22)\n    // - rounds_left >= GKR_WINDOW_SIZE (3)\n    // - tail blocks >= min_blocks_threshold\n}\n```\n\n**PrecomputeM Window Loop:**\n```rust\n// For each 3-variable window:\nfor t in 0..w {  // w = GKR_WINDOW_SIZE = 3\n    // Evaluate M matrix round by round\n    unsafe {\n        frac_precompute_m_eval_round_raw(\n            m_ptr,\n            w,\n            t,\n            eq_r_prefix_buffer.as_ptr(),\n            eq_suffix_buffer.as_ptr(),\n            d_sum_evals.as_mut_ptr(),\n        )\n        .map_err(FractionalSumcheckError::ComputeRound)?;\n    }\n    \n    // Observe/update like normal round\n    prev_r = observe_and_update(...)?;\n    window_rs.push(r);\n}\n```\n\n**M-Building (lines 909-925):**\n```rust\nunsafe {\n    frac_precompute_m_build_raw(\n        build_src,           // Input: layer or active_pq\n        rem_n,               // Remaining variables\n        w,                   // Window size (3)\n        lambda,\n        r_fold,              // Previous round challenge\n        pending_fold,        // inline fold flag\n        eq_tail_low,\n        eq_tail_high,\n        eq_low_cap,\n        tail_tile,           // Tiling for parallelization\n        m_partial_buffer.as_mut_ptr(),\n        partial_len,\n        m_ptr,               // Output M matrix\n    )\n    .map_err(FractionalSumcheckError::ComputeRound)?;\n}\n```\n\n**Multifold (lines 987-995):**\n```rust\nunsafe {\n    frac_multifold_raw(\n        multifold_src,\n        active_pq.as_mut_ptr(),\n        buf_vars,            // rem_n or rem_n+1\n        w_fold,              // w or w+1 (if pending_fold)\n        d_eq_r_window,\n    )\n    .map_err(FractionalSumcheckError::FoldColumns)?;\n}\n```\n\n### **6. Reconstruct S Evaluations (lines 1126-1163)**\n\n```rust\nfn reconstruct_s_evals(\n    d_sum_evals: &DeviceBuffer<EF>,\n    prev_s_eval: EF,\n    xi_j: EF,\n    eq_r_acc: EF,\n) -> Result<([EF; GKR_S_DEG], [EF; GKR_S_DEG]), FractionalSumcheckError>\n```\n\n**Process:**\n1. Copy `s'(1), s'(2)` from GPU: `sp_vec = d_sum_evals.to_host()?`\n2. Build intermediate polynomials:\n   ```rust\n   // sp_evals is the degree-2 poly: eq(xi_j, X) * s'(X)\n   sp_evals[1] = sp_vec[0] * eq_r_acc;\n   sp_evals[2] = sp_vec[1] * eq_r_acc;\n   ```\n3. Recover `sp_evals[0]` using constraint: `s_j(0) + s_j(1) = prev_s_eval`\n   ```rust\n   eq_xi_0 = EF::ONE - xi_j;  // eq(xi_j, 0)\n   eq_xi_1 = xi_j;             // eq(xi_j, 1)\n   sp_evals[0] = (prev_s_eval - eq_xi_1 * sp_evals[1]) * eq_xi_0.inverse();\n   ```\n4. Construct full evaluations at {1,2,3}:\n   ```rust\n   s_evals[i] = eval_eq_mle(&[xi_j], &[x]) * sp_eval\n   // where x = i+1, sp_eval interpolated from sp_evals\n   ```\n\nReturns: `([EF; 3], [EF; 3])` = `(full s evals, intermediate sp evals)`\n\n### **7. CUDA FFI Bindings (cuda/logup_zerocheck.rs)**\n\n#### Compute Round Kernels (lines 131-176):\n```c\nfn _frac_compute_round(\n    eq_xi_low: *const EF,\n    eq_xi_high: *const EF,\n    pq_buffer: *const Frac<EF>,\n    num_x: usize,\n    eq_low_cap: usize,\n    lambda: EF,\n    out_device: *mut EF,\n    tmp_block_sums: *mut EF,\n) -> i32;\n\nfn _frac_compute_round_and_fold(\n    eq_xi_low: *const EF,\n    eq_xi_high: *const EF,\n    src_pq_buffer: *const Frac<EF>,\n    dst_pq_buffer: *mut Frac<EF>,\n    src_pq_size: usize,\n    eq_low_cap: usize,\n    lambda: EF,\n    r_prev: EF,\n    out_device: *mut EF,\n    tmp_block_sums: *mut EF,\n) -> i32;\n\nfn _frac_compute_round_and_fold_inplace(\n    eq_xi_low: *const EF,\n    eq_xi_high: *const EF,\n    pq_buffer: *mut Frac<EF>,\n    src_pq_size: usize,\n    eq_low_cap: usize,\n    lambda: EF,\n    r_prev: EF,\n    out_device: *mut EF,\n    tmp_block_sums: *mut EF,\n) -> i32;\n```\n\n#### Fold Columns (line 155-160):\n```c\nfn _frac_fold_fpext_columns(\n    src: *const Frac<EF>,\n    dst: *mut Frac<EF>,\n    size: usize,\n    r: EF,\n) -> i32;\n```\n\n#### PrecomputeM Kernels (lines 193-224):\n```c\nfn _frac_precompute_m_build(\n    pq: *const Frac<EF>,\n    rem_n: usize,\n    w: usize,\n    lambda: EF,\n    r_prev: EF,\n    inline_fold: bool,\n    eq_tail_low: *const EF,\n    eq_tail_high: *const EF,\n    eq_tail_low_cap: usize,\n    tail_tile: usize,\n    partial_out: *mut EF,\n    partial_len: usize,\n    m_total: *mut EF,\n) -> i32;\n\nfn _frac_precompute_m_eval_round(\n    m_total: *const EF,\n    w: usize,\n    t: usize,\n    eq_r_prefix: *const EF,\n    eq_suffix: *const EF,\n    out: *mut EF,\n) -> i32;\n\nfn _frac_multifold(\n    src: *const Frac<EF>,\n    dst: *mut Frac<EF>,\n    rem_n: usize,\n    w: usize,\n    eq_r_window: *const EF,\n) -> i32;\n```\n\n#### Tree Building (lines 116-127):\n```c\nfn _frac_build_tree_layer(\n    layer: *mut Frac<EF>,\n    layer_size: usize,\n    revert: bool,\n    alpha: EF,\n    apply_alpha: bool,\n) -> i32;\n\nfn _frac_build_tree_two_layers(\n    layer: *mut Frac<EF>,\n    half_i1: usize,\n) -> i32;\n```\n\n### **8. CUDA Kernel Signatures (gkr.cu)**\n\n#### Build Tree Layer (lines 28-64)\n```cuda\ntemplate <bool revert, bool apply_alpha = false>\n__global__ void frac_build_tree_layer_kernel(\n    FracExt *__restrict__ layer,\n    uint32_t half,\n    FpExt alpha = FpExt(Fp(0))\n)\n```\n- **revert=false**: `layer[i] = frac_add(layer[i], layer[i|half])`\n- **revert=true**: `layer[i] = frac_unadd(layer[i], layer[i|half])`\n\n#### Compute Round (lines 136-195)\n```cuda\n__global__ void compute_round_block_sum_kernel(\n    const FpExt *__restrict__ eq_xi_low,\n    const FpExt *__restrict__ eq_xi_high,\n    const FracExt *__restrict__ pq_buffer,\n    uint32_t num_x,\n    uint32_t log_eq_low_cap,\n    FpExt lambda,\n    FpExt *__restrict__ block_sums  // [gridDim.x][2]\n)\n```\n- Computes s'(1) and s'(2) from pq_buffer using eq weights\n- Output: block_sums with 2 FpExt per block (degree 2)\n- Uses sqrt-decomposed eq weights: `eq_val = eq_low[idx & mask] * eq_high[idx >> log_cap]`\n\n#### Compute + Fold Out-of-Place (lines 235-309)\n```cuda\n__global__ void compute_round_and_fold_kernel(\n    const FpExt *__restrict__ eq_xi_low,\n    const FpExt *__restrict__ eq_xi_high,\n    const FracExt *__restrict__ src_pq,\n    uint32_t num_x,\n    uint32_t log_eq_low_cap,\n    FpExt lambda,\n    FpExt r_prev,\n    FpExt *__restrict__ block_sums,\n    FracExt *__restrict__ dst_pq\n)\n```\n- Reads: 2*pq_size FracExt\n- Writes: pq_size FracExt\n- Computes + folds in single pass\n\n#### Compute + Fold In-Place (lines 323-416)\n```cuda\n__global__ void compute_round_and_fold_inplace_kernel(\n    const FpExt *__restrict__ eq_xi_low,\n    const FpExt *__restrict__ eq_xi_high,\n    FracExt *pq,\n    uint32_t num_x,\n    uint32_t log_eq_low_cap,\n    FpExt lambda,\n    FpExt r_prev,\n    FpExt *__restrict__ block_sums\n)\n```\n- **Safety:** Reads both halves, writes only first half (indices idx, idx+quarter, idx+eighth, idx+three_eighths)\n\n#### Compute + Revert (lines 437-498)\n```cuda\n__global__ void compute_round_and_revert_kernel(\n    const FpExt *__restrict__ eq_xi_low,\n    const FpExt *__restrict__ eq_xi_high,\n    FracExt *__restrict__ layer,\n    uint32_t num_x,\n    uint32_t log_eq_low_cap,\n    FpExt lambda,\n    FpExt *__restrict__ block_sums\n)\n```\n- Fuses tree revert with compute\n- Uses `frac_unadd` for fractional subtraction\n\n#### PrecomputeM Build (lines 515-615)\n```cuda\ntemplate <bool inline_fold, uint32_t W>\n__global__ void precompute_m_build_partial_kernel(\n    const FracExt *__restrict__ pq,\n    uint32_t rem_n,\n    FpExt lambda,\n    FpExt r_prev,\n    const FpExt *__restrict__ eq_tail_low,\n    const FpExt *__restrict__ eq_tail_high,\n    uint32_t log_eq_tail_low_cap,\n    uint32_t tail_tile,\n    FpExt *__restrict__ partial_out\n)\n```\n- 2D block: `dim3(2^w, 2^w)` threads (w <= 5)\n- Each thread (u,v) computes M[u,v]\n- Parallelizes tail dimensions with tail_tile\n- Inline fold: Reads rem_n+1 variable buffer, folds r_prev\n- Output: m_len = 2^(2w) per block, partial_len = num_blocks * m_len\n\n#### PrecomputeM Eval Round (lines 721-778)\n```cuda\n__global__ void precompute_m_eval_round_kernel(\n    const FpExt *__restrict__ m_total,\n    uint32_t w,\n    uint32_t t,\n    const FpExt *__restrict__ eq_r_prefix,\n    const FpExt *__restrict__ eq_suffix,\n    FpExt *__restrict__ out\n)\n```\n- Evaluates one round in the w-window\n- Output: out[0]=s'(1), out[1]=s'(2)\n- Uses M matrix lookups with eq weights\n\n#### Multifold (lines 783-813)\n```cuda\ntemplate <uint32_t W>\n__global__ void multifold_kernel(\n    const FracExt *src,\n    FracExt *dst,\n    uint32_t tail_size,\n    const FpExt *__restrict__ eq_r_window\n)\n```\n- Folds w rounds at once\n- Computes linear combination over 2^w inputs per output\n\n### **9. SqrtEqLayers Type (from poly.rs)**\n\nStructure for sqrt-decomposed eq evaluation buffer:\n- **Method:** `from_xi(&[EF])` → builds sqrt-decomposed layers\n- **Access:** `eq_tail_ptrs()` returns (low_ptr, high_ptr, low_cap, tail_n)\n- **Reconstruction:** `eq_val = eq_low[idx & ((1 << log_cap) - 1)] * eq_high[idx >> log_cap]`\n\n### **10. Sponge Integration (sponge.rs)**\n\n#### DeviceSpongeState\n```rust\n#[repr(C)]\npub struct DeviceSpongeState {\n    pub state: [F; WIDTH],  // WIDTH = 16\n    pub absorb_idx: u32,\n    pub sample_idx: u32,\n}\n```\n\n#### DuplexSpongeGpu\n```rust\npub struct DuplexSpongeGpu {\n    host: Challenger,           // DuplexChallenger<F, ...>\n    device: DeviceBuffer<DeviceSpongeState>,\n}\n```\n\n**Key Methods:**\n- `sync_h2d()`: Copy host state to device (converts buffered input to state indices)\n- `device_ptr()` / `device_ptr_mut()`: Get raw pointers for CUDA kernels\n\n**CUDA sponge.cu:**\n```cuda\nstruct DeviceSpongeState {\n    Fp state[CELLS];      // CELLS = 16\n    uint32_t absorb_idx;\n    uint32_t sample_idx;\n};\n\n__device__ void sponge_observe(DeviceSpongeState& sponge, Fp value);\n__device__ Fp sponge_sample(DeviceSpongeState& sponge);\n```\n\n### **11. Constants & Environment Variables**\n\n```rust\nconst GKR_S_DEG: usize = 3;                           // Degree of s polynomial\nconst GKR_WINDOW_SIZE: usize = 3;                     // PrecomputeM window size\nconst GKR_WINDOW_DEFAULT_MIN_N: usize = 22;           // Fallback minimum log(n)\nconst PRECOMPUTE_M_DEFAULT_MIN_BLOCKS: usize = 64;\nconst PRECOMPUTE_M_DEFAULT_TARGET_BLOCKS: usize = 1024;\nconst PRECOMPUTE_M_TAIL_TILE: usize = 4096;\nconst PRECOMPUTE_M_MIN_TAIL_TILE: usize = 256;\n\n// Environment variables:\nSWIRL_CUDA_GKR_PRECOMPUTE_M                 // Enable PrecomputeM\nSWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_BLOCKS\nSWIRL_CUDA_GKR_PRECOMPUTE_M_TARGET_BLOCKS\nSWIRL_CUDA_GKR_PRECOMPUTE_M_TAIL_TILE\nSWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_N\n```\n\n### **12. Helper Functions**\n\n**Memory copies:**\n```rust\nfn copy_to_device_ptr<T: Copy>(dst: *mut T, src: &[T]) \nfn copy_from_device<T>(buf: &DeviceBuffer<T>, index: usize, scratch: &mut DeviceBuffer<T>) -> Result<T>\n```\n\n**MLE evaluation tables:**\n```rust\nfn eval_mle_table(points: &[EF], out: &mut [EF])  // CPU-side MLE evaluation\n```\n\n**Eq buffer helpers:**\n```rust\nfn eq_tail_ptrs(eq_buffer: &SqrtEqLayers, drop_count: usize) \n    -> (*const EF, *const EF, usize, usize)  // (low_ptr, high_ptr, low_cap, tail_n)\n```\n\n**Claims reduction:**\n```rust\nfn reduce_to_single_evaluation<SC>(\n    claims: &GkrLayerClaims<SC>,\n    mu: EF,\n) -> (EF, EF)  // Linear interpolation at mu\n```\n\n### **13. Error Handling**\n\nAll functions return `i32` in CUDA (error code) wrapped as:\n```rust\n.map_err(FractionalSumcheckError::ComputeRound)?\n.map_err(FractionalSumcheckError::SegmentTree)?\n.map_err(FractionalSumcheckError::BitReversal)?\n.map_err(FractionalSumcheckError::FoldColumns)?\n```\n\n---\n\n## Key Implementation Notes\n\n1. **Transmute Safety:** `Frac<EF>` ↔ `(EF, EF)` are binary-compatible and transmuted for NTT operations\n\n2. **Memory Layout:** All structures use `#[repr(C)]` for FFI compatibility (DeviceSpongeState, FracExt, FpExt)\n\n3. **Sqrt-Decomposed EQ:** Buffers split log-space evaluation into high/low parts to reduce memory\n\n4. **Inline Fold Optimization:** PrecomputeM folds pending challenges into buffer on first iteration only\n\n5. **Block Reduction:** All output aggregations use warp-reduce + inter-warp reduction pattern in shared memory\n\n6. **Register Pressure:** Tight scopes for intermediate FracExt values to minimize live registers (~60-70/thread)\n\nThis implementation is highly optimized with fused operations, careful memory access patterns, and environment-tunable parameters for different problem sizes."}],"totalDurationMs":103094,"totalTokens":93128,"totalToolUseCount":43,"usage":{"input_tokens":4,"cache_creation_input_tokens":6772,"cache_read_input_tokens":79369,"output_tokens":6983,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":6772},"inference_geo":"","iterations":[{"input_tokens":4,"output_tokens":6983,"cache_read_input_tokens":79369,"cache_creation_input_tokens":6772,"cache_creation":{"ephemeral_5m_input_tokens":6772,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"toolStats":{"readCount":29,"searchCount":3,"bashCount":11,"editFileCount":0,"linesAdded":0,"linesRemoved":0,"otherToolCount":0}}}
