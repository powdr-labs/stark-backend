{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ACNMeMEyeE6KYepr9G4cnq","type":"tool_result","content":"600\t            sh_right1[sh_idx] = q1;\n601\t        }\n602\t        __syncthreads();\n603\t\n604\t        // Phase 3: Accumulate with 2 muls per iteration (weight already folded in).\n605\t        for (uint32_t bi = 0; bi < batch; ++bi) {\n606\t            uint32_t row = bi * sh_stride;\n607\t            acc += sh_left0[row + u] * sh_right1[row + v]\n608\t                 + sh_left1[row + u] * sh_right0[row + v];\n609\t        }\n610\t\n611\t        __syncthreads();\n612\t    }\n613\t\n614\t    partial_out[blockIdx.x * (m * m) + u * m + v] = acc;\n615\t}\n616\t\n617\ttemplate <bool inline_fold, uint32_t W>\n618\tinline void launch_precompute_m_build_partial_kernel(\n619\t    dim3 grid,\n620\t    const FracExt *pq,\n621\t    uint32_t rem_n,\n622\t    FpExt lambda,\n623\t    FpExt r_prev,\n624\t    const FpExt *eq_tail_low,\n625\t    const FpExt *eq_tail_high,\n626\t    uint32_t log_eq_tail_low_cap,\n627\t    uint32_t tail_tile,\n628\t    FpExt *partial_out\n629\t) {\n630\t    constexpr uint32_t m = 1u << W;\n631\t    dim3 block(m, m);\n632\t    constexpr uint32_t sh_stride = m + 1;  // +1 padding to match kernel\n633\t    size_t shmem_bytes =\n634\t        (4 * sh_stride * PRECOMPUTE_M_TAIL_BATCH + PRECOMPUTE_M_TAIL_BATCH) * sizeof(FpExt);\n635\t    precompute_m_build_partial_kernel<inline_fold, W><<<grid, block, shmem_bytes>>>(\n636\t        pq,\n637\t        rem_n,\n638\t        lambda,\n639\t        r_prev,\n640\t        eq_tail_low,\n641\t        eq_tail_high,\n642\t        log_eq_tail_low_cap,\n643\t        tail_tile,\n644\t        partial_out\n645\t    );\n646\t}\n647\t\n648\ttemplate <bool inline_fold>\n649\tinline int launch_precompute_m_build_partial_dispatch(\n650\t    uint32_t w,\n651\t    dim3 grid,\n652\t    const FracExt *pq,\n653\t    uint32_t rem_n,\n654\t    FpExt lambda,\n655\t    FpExt r_prev,\n656\t    const FpExt *eq_tail_low,\n657\t    const FpExt *eq_tail_high,\n658\t    uint32_t log_eq_tail_low_cap,\n659\t    uint32_t tail_tile,\n660\t    FpExt *partial_out\n661\t) {\n662\t    using LauncherFn = void (*)(\n663\t        dim3, const FracExt *, uint32_t, FpExt, FpExt, const FpExt *, const FpExt *, uint32_t,\n664\t        uint32_t, FpExt *\n665\t    );\n666\t    static constexpr LauncherFn launchers[] = {\n667\t        &launch_precompute_m_build_partial_kernel<inline_fold, 1>,\n668\t        &launch_precompute_m_build_partial_kernel<inline_fold, 2>,\n669\t        &launch_precompute_m_build_partial_kernel<inline_fold, 3>,\n670\t        &launch_precompute_m_build_partial_kernel<inline_fold, 4>,\n671\t        &launch_precompute_m_build_partial_kernel<inline_fold, 5>,\n672\t    };\n673\t\n674\t    constexpr uint32_t min_w = 1;\n675\t    constexpr uint32_t max_w = static_cast<uint32_t>(sizeof(launchers) / sizeof(launchers[0]));\n676\t    if (w < min_w || w > max_w) {\n677\t        // 2D launch uses (2^w, 2^w) threads, so w > 5 exceeds 1024 threads per block.\n678\t        return cudaErrorInvalidValue;\n679\t    }\n680\t\n681\t    launchers[w - min_w](\n682\t        grid,\n683\t        pq,\n684\t        rem_n,\n685\t        lambda,\n686\t        r_prev,\n687\t        eq_tail_low,\n688\t        eq_tail_high,\n689\t        log_eq_tail_low_cap,\n690\t        tail_tile,\n691\t        partial_out\n692\t    );\n693\t    return 0;\n694\t}\n695\t\n696\t// Reduce partial M blocks into a final M matrix.\n697\t__global__ void precompute_m_reduce_partials_kernel(\n698\t    const FpExt *__restrict__ partial,\n699\t    uint32_t num_blocks,\n700\t    uint32_t total_entries,\n701\t    FpExt *__restrict__ m_total\n702\t) {\n703\t    uint32_t entry = blockIdx.x * blockDim.x + threadIdx.x;\n704\t    if (entry >= total_entries) {\n705\t        return;\n706\t    }\n707\t\n708\t    FpExt zero(Fp::zero());\n709\t    FpExt acc = zero;\n710\t    // Iterate over partial blocks with coalesced loads:\n711\t    // for fixed b, neighboring threads read neighboring entries.\n712\t    for (uint32_t b = 0; b < num_blocks; ++b) {\n713\t        acc += partial[(size_t)b * total_entries + entry];\n714\t    }\n715\t    m_total[entry] = acc;\n716\t}\n717\t\n718\t// Evaluate one round polynomial inside a precompute-M window from precomputed M.\n719\t// See docs/cuda-backend/gkr-prover.md § \"Precompute M strategy\".\n720\t// Output: out[0] = s'(1), out[1] = s'(2).\n721\t__global__ void precompute_m_eval_round_kernel(\n722\t    const FpExt *__restrict__ m_total,\n723\t    uint32_t w,\n724\t    uint32_t t,\n725\t    const FpExt *__restrict__ eq_r_prefix,\n726\t    const FpExt *__restrict__ eq_suffix,\n727\t    FpExt *__restrict__ out\n728\t) {\n729\t    extern __shared__ FpExt shared[];\n730\t\n731\t    uint32_t m = 1u << w;\n732\t    uint32_t prefix_bits = t;\n733\t    uint32_t suffix_bits = w - t - 1;\n734\t    uint32_t prefix_size = 1u << prefix_bits;\n735\t    uint32_t suffix_size = 1u << suffix_bits;\n736\t\n737\t    uint64_t total = (uint64_t)prefix_size * prefix_size * suffix_size;\n738\t    uint32_t cur_bit = 1u << suffix_bits;\n739\t    FpExt zero(Fp::zero());\n740\t    FpExt one(Fp::one());\n741\t    FpExt two = one + one;\n742\t\n743\t    FpExt local_s1 = zero;\n744\t    FpExt local_s2 = zero;\n745\t\n746\t    for (uint64_t idx = threadIdx.x; idx < total; idx += blockDim.x) {\n747\t        uint32_t suffix = (uint32_t)(idx % suffix_size);\n748\t        uint64_t tmp = idx / suffix_size;\n749\t        uint32_t b2 = (uint32_t)(tmp % prefix_size);\n750\t        uint32_t b1 = (uint32_t)(tmp / prefix_size);\n751\t\n752\t        FpExt weight = eq_r_prefix[b1] * eq_r_prefix[b2] * eq_suffix[suffix];\n753\t\n754\t        uint32_t prefix_shift = suffix_bits + 1;\n755\t        uint32_t beta1_0 = (b1 << prefix_shift) | suffix;\n756\t        uint32_t beta1_1 = beta1_0 | cur_bit;\n757\t        uint32_t beta2_0 = (b2 << prefix_shift) | suffix;\n758\t        uint32_t beta2_1 = beta2_0 | cur_bit;\n759\t\n760\t        FpExt m00 = m_total[beta1_0 * m + beta2_0];\n761\t        FpExt m01 = m_total[beta1_0 * m + beta2_1];\n762\t        FpExt m10 = m_total[beta1_1 * m + beta2_0];\n763\t        FpExt m11 = m_total[beta1_1 * m + beta2_1];\n764\t\n765\t        local_s1 += weight * m11;\n766\t        local_s2 += weight * (m00 - two * (m01 + m10 - m11 - m11));\n767\t    }\n768\t\n769\t    {\n770\t        FpExt reduced = sumcheck::block_reduce_sum(local_s1, shared);\n771\t        if (threadIdx.x == 0) out[0] = reduced;\n772\t    }\n773\t    __syncthreads();\n774\t    {\n775\t        FpExt reduced = sumcheck::block_reduce_sum(local_s2, shared);\n776\t        if (threadIdx.x == 0) out[1] = reduced;\n777\t    }\n778\t}\n779\t\n780\t// Fold w rounds at once using precomputed eq_r_window.\n781\t// One thread computes both poly outputs for a single tail index.\n782\ttemplate <uint32_t W>\n783\t__global__ void multifold_kernel(\n784\t    const FracExt *src,\n785\t    FracExt *dst,\n786\t    uint32_t tail_size,\n787\t    const FpExt *__restrict__ eq_r_window\n788\t) {\n789\t    constexpr uint32_t beta_size = 1u << W;\n790\t    uint32_t out_idx = blockIdx.x * blockDim.x + threadIdx.x;\n791\t    if (out_idx >= tail_size) {\n792\t        return;\n793\t    }\n794\t\n795\t    FpExt zero(Fp::zero());\n796\t    FpExt acc0_p = zero;\n797\t    FpExt acc0_q = zero;\n798\t    FpExt acc1_p = zero;\n799\t    FpExt acc1_q = zero;\n800\t    const FracExt *src_1 = src + ((size_t)tail_size << W);\n801\t    for (uint32_t beta = 0; beta < beta_size; ++beta) {\n802\t        uint32_t idx = beta * tail_size + out_idx;\n803\t        FracExt v0 = src[idx];\n804\t        FracExt v1 = src_1[idx];\n805\t        FpExt eq_r = eq_r_window[beta];\n806\t        acc0_p += eq_r * v0.p;\n807\t        acc0_q += eq_r * v0.q;\n808\t        acc1_p += eq_r * v1.p;\n809\t        acc1_q += eq_r * v1.q;\n810\t    }\n811\t    dst[out_idx] = {acc0_p, acc0_q};\n812\t    dst[tail_size + out_idx] = {acc1_p, acc1_q};\n813\t}\n814\t\n815\t__global__ void add_alpha_kernel(FracExt *data, size_t len, FpExt alpha) {\n816\t    size_t idx = blockIdx.x * blockDim.x + threadIdx.x;\n817\t    if (idx < len) {\n818\t        data[idx].q = data[idx].q + alpha;\n819\t    }\n820\t}\n821\t\n822\ttemplate <typename F, typename EF>\n823\t__global__ void frac_vector_scalar_multiply_kernel(\n824\t    std::pair<EF, EF> *frac_vec,\n825\t    F scalar,\n826\t    uint32_t length\n827\t) {\n828\t    size_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n829\t    if (tidx >= length)\n830\t        return;\n831\t\n832\t    frac_vec[tidx].first *= scalar;\n833\t}\n834\t\n835\t// Fused two-layer tree build kernel.\n836\t// Applies two consecutive frac_add tree layers in one pass, keeping intermediate\n837\t// right-half nodes for later revert operations.\n838\t//\n839\t// For fused layers i and i+1 with half_i = N >> (i+1) and half_i1 = N >> (i+2):\n840\t//   Thread j in [0, half_i1) reads:\n841\t//     A = layer[j],                  B = layer[j + half_i1],\n842\t//     C = layer[j + half_i],         D = layer[j + half_i + half_i1]\n843\t//   Computes:\n844\t//     lhs = frac_add(A, C)            (layer i result at j, kept in register)\n845\t//     rhs = frac_add(B, D)            (layer i result at j + half_i1)\n846\t//     result = frac_add(lhs, rhs)     (layer i+1 result at j)\n847\t//   Writes:\n848\t//     layer[j]         = result        (layer i+1 output)\n849\t//     layer[j+half_i1] = rhs           (layer i intermediate, needed for revert of layer i+1)\n850\t//   C and D remain untouched (already in correct place for revert of layer i).\n851\t//\n852\t// Memory traffic vs two separate frac_build_tree_layer calls:\n853\t//   Non-fused: 4 reads + 2 writes (layer i) + 2 reads + 1 write (layer i+1) = 6R+3W per group\n854\t//   Fused:     4 reads + 2 writes per group\n855\t//   Savings:   2 reads + 1 write = ~33% reduction in global memory traffic.\n856\t__global__ void frac_build_tree_two_layers_kernel(\n857\t    FracExt *__restrict__ layer,\n858\t    uint32_t half_i1   // = N >> (i+2), where i is the first of the two layers\n859\t) {\n860\t    uint32_t j = blockIdx.x * blockDim.x + threadIdx.x;\n861\t    if (j >= half_i1) return;\n862\t\n863\t    uint32_t half_i = half_i1 << 1;   // = N >> (i+1)\n864\t\n865\t    FracExt A = layer[j];\n866\t    FracExt B = layer[j + half_i1];\n867\t    FracExt C = layer[j + half_i];\n868\t    FracExt D = layer[j + half_i + half_i1];\n869\t\n870\t    // Layer i: combine A with C and B with D (kept in registers)\n871\t    FracExt lhs = frac_add(A, C);\n872\t    FracExt rhs = frac_add(B, D);\n873\t    // Layer i+1: combine the two layer-i results\n874\t    FracExt result = frac_add(lhs, rhs);\n875\t\n876\t    layer[j]         = result;\n877\t    layer[j + half_i1] = rhs;   // Needed for revert of layer i+1\n878\t    // layer[j + half_i] = C  (unchanged, needed for revert of layer i)\n879\t    // layer[j + half_i + half_i1] = D  (unchanged, needed for revert of layer i)\n880\t}\n881\t\n882\t// ============================================================================\n883\t// LAUNCHERS\n884\t// ============================================================================\n885\ttemplate <bool revert, bool apply_alpha>\n886\tint launch_frac_build_tree_layer(FracExt *layer, size_t layer_size, FpExt alpha) {\n887\t    auto [grid, block] = kernel_launch_params(layer_size);\n888\t    frac_build_tree_layer_kernel<revert, apply_alpha><<<grid, block>>>(layer, layer_size, alpha);\n889\t    return CHECK_KERNEL();\n890\t}\n891\t\n892\textern \"C\" int _frac_build_tree_layer(\n893\t    FracExt *layer,\n894\t    size_t layer_size,\n895\t    bool revert,\n896\t    FpExt alpha,\n897\t    bool apply_alpha\n898\t) {\n899\t    if (layer_size == 0) {"}]},"parent_tool_use_id":"toolu_018EAFmb1kYYsAgJQ1wuDZsR","session_id":"3d1d6996-d207-40ca-9042-54ec7bd5b430","uuid":"cee28f1d-ea04-477e-b8c6-5c6f191377fc","timestamp":"2026-04-14T16:47:25.660Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0156Vau8rLyqcZzhwqgGTZR2","type":"tool_result","content":"300\t        accumulate_compute_contributions(\n301\t            eq_xi_low, eq_xi_high, idx, log_eq_low_cap, lambda,\n302\t            p0_even, q0_even, p0_odd, q0_odd,\n303\t            p1_even, q1_even, p1_odd, q1_odd,\n304\t            local0, local1\n305\t        );\n306\t    }\n307\t\n308\t    reduce_block_sums(shared, local0, local1, block_sums);\n309\t}\n310\t\n311\t// Fused compute round + fold kernel (IN-PLACE version).\n312\t// Reads from pre-fold pq buffer (size 2*pq_size), computes s' polynomial at 1 and 2,\n313\t// and writes folded output back to the same buffer (first pq_size elements).\n314\t//\n315\t// IN-PLACE SAFETY: Each thread writes only to indices it reads from in the first\n316\t// half of the buffer {idx, idx+quarter, idx+eighth, idx+three_eighths}. No cross-thread\n317\t// conflicts because different threads have disjoint idx values. Reads from the second\n318\t// half [pq_size, 2*pq_size) are never written to.\n319\t//\n320\t// NOTE: No __restrict__ on pq pointer since we read and write to the same buffer.\n321\t//\n322\t// shared memory size requirement: max(num_warps,1) * sizeof(FpExt)\n323\t__global__ void compute_round_and_fold_inplace_kernel(\n324\t    const FpExt *__restrict__ eq_xi_low,\n325\t    const FpExt *__restrict__ eq_xi_high,\n326\t    FracExt *pq,                         // In-place buffer: reads 2*pq_size, writes pq_size\n327\t    uint32_t num_x,                      // post-fold num_x (= pq_size / 2)\n328\t    uint32_t log_eq_low_cap,\n329\t    FpExt lambda,\n330\t    FpExt r_prev,                        // Previous round's challenge for folding\n331\t    FpExt *__restrict__ block_sums       // Output: [gridDim.x * 2]\n332\t) {\n333\t    extern __shared__ FpExt shared[];\n334\t    const uint32_t pq_size = 2 * num_x;\n335\t\n336\t    // Fold pattern analysis:\n337\t    // The fold kernel operates on FpExt* view where FracExt[i] = (FpExt[2i], FpExt[2i+1]).\n338\t    // For pre-fold size N = 2*pq_size FracExt = 4*pq_size FpExt, the fold kernel uses:\n339\t    //   quarter = 2*pq_size / 2 = pq_size (in FpExt)\n340\t    //   half = 2 * quarter = 2*pq_size (in FpExt)\n341\t    //\n342\t    // The fold produces output FracExt with this mapping:\n343\t    //   For j in [0, pq_size/2): output[j] = fold(input[j], input[j + pq_size/2])\n344\t    //   For j in [pq_size/2, pq_size): output[j] = fold(input[j + pq_size/2], input[j + pq_size])\n345\t    //\n346\t    // Post-fold indices for compute: idx, idx+quarter, idx+eighth, idx+three_eighths\n347\t    // where quarter = pq_size/2, eighth = pq_size/4\n348\t    const uint32_t half = pq_size;              // src_pq_size / 2\n349\t    const uint32_t quarter = pq_size >> 1;      // pq_size / 2\n350\t    const uint32_t eighth = pq_size >> 2;       // pq_size / 4\n351\t    const uint32_t three_eighths = eighth * 3;  // 3 * pq_size / 4\n352\t\n353\t    // Use scalar accumulators instead of array to help register allocation\n354\t    const FpExt zero(Fp::zero());\n355\t    FpExt local0 = zero, local1 = zero;\n356\t    uint32_t idx_base = threadIdx.x + blockIdx.x * blockDim.x;\n357\t\n358\t    // Map phase: compute local sum by striding over grid\n359\t    for (uint32_t idx = idx_base; idx < num_x / 2; idx += blockDim.x * gridDim.x) {\n360\t        // OPTIMIZATION: Staged load-fold pattern to reduce register pressure.\n361\t        // For in-place operation, we must read all 8 source values before writing.\n362\t        // BUT we fold and write immediately after each pair to minimize live register count.\n363\t        // This reduces peak register usage from ~107 to ~60-70 regs/thread.\n364\t\n365\t        // Declare output scalars for folded values\n366\t        FpExt p0_even, q0_even, p1_even, q1_even;\n367\t        FpExt p0_odd, q0_odd, p1_odd, q1_odd;\n368\t\n369\t        // Pair 1: f00 (idx -> p0_even, q0_even)\n370\t        {\n371\t            FracExt a = pq[idx];\n372\t            FracExt b = pq[idx + quarter];\n373\t            p0_even = a.p + r_prev * (b.p - a.p);\n374\t            q0_even = a.q + r_prev * (b.q - a.q);\n375\t        }\n376\t\n377\t        // Pair 2: f10 (idx + half -> p1_even, q1_even)\n378\t        {\n379\t            FracExt a = pq[idx + half];\n380\t            FracExt b = pq[idx + half + quarter];\n381\t            p1_even = a.p + r_prev * (b.p - a.p);\n382\t            q1_even = a.q + r_prev * (b.q - a.q);\n383\t        }\n384\t\n385\t        // Pair 3: f01 (idx + eighth -> p0_odd, q0_odd)\n386\t        {\n387\t            FracExt a = pq[idx + eighth];\n388\t            FracExt b = pq[idx + three_eighths];\n389\t            p0_odd = a.p + r_prev * (b.p - a.p);\n390\t            q0_odd = a.q + r_prev * (b.q - a.q);\n391\t        }\n392\t\n393\t        // Pair 4: f11 (idx + half + eighth -> p1_odd, q1_odd)\n394\t        {\n395\t            FracExt a = pq[idx + half + eighth];\n396\t            FracExt b = pq[idx + half + three_eighths];\n397\t            p1_odd = a.p + r_prev * (b.p - a.p);\n398\t            q1_odd = a.q + r_prev * (b.q - a.q);\n399\t        }\n400\t\n401\t        // Write all folded values (safe: writes to first half, reads from both halves completed)\n402\t        pq[idx] = {p0_even, q0_even};\n403\t        pq[idx + quarter] = {p1_even, q1_even};\n404\t        pq[idx + eighth] = {p0_odd, q0_odd};\n405\t        pq[idx + three_eighths] = {p1_odd, q1_odd};\n406\t\n407\t        accumulate_compute_contributions(\n408\t            eq_xi_low, eq_xi_high, idx, log_eq_low_cap, lambda,\n409\t            p0_even, q0_even, p0_odd, q0_odd,\n410\t            p1_even, q1_even, p1_odd, q1_odd,\n411\t            local0, local1\n412\t        );\n413\t    }\n414\t\n415\t    reduce_block_sums(shared, local0, local1, block_sums);\n416\t}\n417\t\n418\t// Fused compute round + tree layer revert kernel.\n419\t// Combines frac_build_tree_layer_kernel<true> (revert) with compute_round_block_sum_kernel.\n420\t//\n421\t// This is used for the FIRST inner round only, where we need to revert the tree layer\n422\t// before computing. Equivalent to fractional subtraction:\n423\t//   layer[i] = frac_unadd(layer[i], layer[i + half])\n424\t// where rhs = layer[i + half] is kept unchanged.\n425\t//\n426\t// For round 0, the 4 PQ indices accessed per thread are:\n427\t//   - idx: in first half, needs revert\n428\t//   - idx | quarter: in first half, needs revert\n429\t//   - idx | half: in second half, no revert\n430\t//   - idx | half | quarter: in second half, no revert\n431\t//\n432\t// Each index in the first half is written by exactly one thread:\n433\t//   - Thread idx writes to indices {idx, idx + quarter}\n434\t//   - For idx in [0, num_x/2), these cover [0, half) completely\n435\t//\n436\t// shared memory size requirement: max(num_warps,1) * sizeof(FpExt)\n437\t__global__ void compute_round_and_revert_kernel(\n438\t    const FpExt *__restrict__ eq_xi_low,\n439\t    const FpExt *__restrict__ eq_xi_high,\n440\t    FracExt *__restrict__ layer,         // Tree layer buffer (modified in-place for revert)\n441\t    uint32_t num_x,\n442\t    uint32_t log_eq_low_cap,\n443\t    FpExt lambda,\n444\t    FpExt *__restrict__ block_sums       // Output: [gridDim.x * 2]\n445\t) {\n446\t    extern __shared__ FpExt shared[];\n447\t    const uint32_t pq_size = 2 * num_x;\n448\t    const uint32_t half = pq_size >> 1;     // pq_size / 2\n449\t    const uint32_t quarter = pq_size >> 2;  // pq_size / 4\n450\t\n451\t    // Use scalar accumulators instead of array to help register allocation\n452\t    const FpExt zero(Fp::zero());\n453\t    FpExt local0 = zero, local1 = zero;\n454\t    uint32_t idx_base = threadIdx.x + blockIdx.x * blockDim.x;\n455\t\n456\t    // Map phase: compute local sum by striding over grid\n457\t    for (uint32_t idx = idx_base; idx < num_x / 2; idx += blockDim.x * gridDim.x) {\n458\t        // OPTIMIZATION: Extract components immediately, don't keep FracExt structures live.\n459\t        // This reduces register pressure by avoiding 4x FracExt (8 FpExt) intermediate storage.\n460\t\n461\t        // Declare output scalars upfront\n462\t        FpExt p0_even, q0_even, p1_even, q1_even;\n463\t        FpExt p0_odd, q0_odd, p1_odd, q1_odd;\n464\t\n465\t        // Compute p0_even by reverting with p1_even (frac_unadd)\n466\t        {\n467\t            FracExt lhs = layer[idx];\n468\t            FracExt rhs = layer[idx + half];\n469\t            FpExt rhs_q_inv = inv(rhs.q);\n470\t            q0_even = lhs.q * rhs_q_inv;\n471\t            p0_even = (lhs.p - q0_even * rhs.p) * rhs_q_inv;\n472\t            p1_even = rhs.p;\n473\t            q1_even = rhs.q;\n474\t            layer[idx] = {p0_even, q0_even};\n475\t        }\n476\t\n477\t        // Compute p0_odd by reverting with p1_odd (frac_unadd)\n478\t        {\n479\t            FracExt lhs = layer[idx + quarter];\n480\t            FracExt rhs = layer[idx + half + quarter];\n481\t            FpExt rhs_q_inv = inv(rhs.q);\n482\t            q0_odd = lhs.q * rhs_q_inv;\n483\t            p0_odd = (lhs.p - q0_odd * rhs.p) * rhs_q_inv;\n484\t            p1_odd = rhs.p;\n485\t            q1_odd = rhs.q;\n486\t            layer[idx + quarter] = {p0_odd, q0_odd};\n487\t        }\n488\t\n489\t        accumulate_compute_contributions(\n490\t            eq_xi_low, eq_xi_high, idx, log_eq_low_cap, lambda,\n491\t            p0_even, q0_even, p0_odd, q0_odd,\n492\t            p1_even, q1_even, p1_odd, q1_odd,\n493\t            local0, local1\n494\t        );\n495\t    }\n496\t\n497\t    reduce_block_sums(shared, local0, local1, block_sums);\n498\t}\n499\t\n500\t// Number of tail elements loaded into shared memory per loop iteration in\n501\t// precompute_m_build_partial_kernel. Each batch allocates:\n502\t//   (4 * (2^w + 1) * BATCH + BATCH) * sizeof(FpExt)\n503\t// of shared memory (4 data arrays + 1 weight array, with +1 stride for bank\n504\t// conflict avoidance). With w=3 (2^3=8) and BATCH=16 this is ~9.25 KB.\n505\t// Increasing BATCH improves amortization of __syncthreads() barriers but\n506\t// increases shared memory pressure, which can reduce occupancy or prevent launch.\n507\tconstexpr uint32_t PRECOMPUTE_M_TAIL_BATCH = 16;\n508\t\n509\t// Build partial M blocks by parallelizing over tail points.\n510\t// See docs/cuda-backend/gkr-prover.md § \"Precompute M strategy\".\n511\t// Each block covers a range of tail points [b_start, b_end) and computes a full M block.\n512\t// Uses 2D blocks (m,m) where each thread owns one (u,v) M-matrix entry.\n513\t// Shared memory uses +1 padding on the m-dimension stride to avoid bank conflicts.\n514\ttemplate <bool inline_fold, uint32_t W>\n515\t__global__ void precompute_m_build_partial_kernel(\n516\t    const FracExt *__restrict__ pq,\n517\t    uint32_t rem_n,          // number of variables AFTER fold (folded rem_n)\n518\t    FpExt lambda,\n519\t    FpExt r_prev,            // challenge for the inline fold (only used when inline_fold=true)\n520\t    const FpExt *__restrict__ eq_tail_low,\n521\t    const FpExt *__restrict__ eq_tail_high,\n522\t    uint32_t log_eq_tail_low_cap,\n523\t    uint32_t tail_tile,\n524\t    FpExt *__restrict__ partial_out\n525\t) {\n526\t    constexpr uint32_t m = 1u << W;\n527\t    uint32_t u = threadIdx.y;\n528\t    uint32_t v = threadIdx.x;\n529\t    if (u >= m || v >= m) {\n530\t        return;\n531\t    }\n532\t\n533\t    uint32_t tail_n = rem_n - W;\n534\t    uint32_t k = 1u << tail_n;\n535\t    // When inline_fold: buffer has rem_n+1 variables (unfolded).\n536\t    // Otherwise: buffer has rem_n variables (already folded).\n537\t    uint32_t fold_half = inline_fold ? (1u << rem_n) : 0;\n538\t    uint32_t poly_stride = inline_fold ? (1u << (rem_n + 1)) : (1u << rem_n);\n539\t\n540\t    uint32_t b_start = blockIdx.x * tail_tile;\n541\t    uint32_t b_end = min(b_start + tail_tile, k);\n542\t\n543\t    // +1 padding avoids bank conflicts for power-of-2 m (m=8 → stride 9).\n544\t    constexpr uint32_t sh_stride = m + 1;\n545\t    extern __shared__ FpExt shmem[];\n546\t    FpExt *sh_left0 = shmem;\n547\t    FpExt *sh_left1 = sh_left0 + sh_stride * PRECOMPUTE_M_TAIL_BATCH;\n548\t    FpExt *sh_right0 = sh_left1 + sh_stride * PRECOMPUTE_M_TAIL_BATCH;\n549\t    FpExt *sh_right1 = sh_right0 + sh_stride * PRECOMPUTE_M_TAIL_BATCH;\n550\t    FpExt *sh_weight = sh_right1 + sh_stride * PRECOMPUTE_M_TAIL_BATCH;\n551\t\n552\t    FpExt zero(Fp::zero());\n553\t    FpExt acc = zero;\n554\t\n555\t    uint32_t lane = threadIdx.y * blockDim.x + threadIdx.x;\n556\t    uint32_t threads = blockDim.x * blockDim.y;\n557\t\n558\t    for (uint32_t b0 = b_start; b0 < b_end; b0 += PRECOMPUTE_M_TAIL_BATCH) {\n559\t        uint32_t batch = min(PRECOMPUTE_M_TAIL_BATCH, b_end - b0);\n560\t        uint32_t elems = batch * m;\n561\t\n562\t        // Phase 1: Load weights into shared memory.\n563\t        for (uint32_t bi = lane; bi < batch; bi += threads) {\n564\t            uint32_t b = b0 + bi;\n565\t            sh_weight[bi] = sqrt_buffer_get(\n566\t                eq_tail_low, eq_tail_high, log_eq_tail_low_cap, b\n567\t            );\n568\t        }\n569\t        __syncthreads();\n570\t\n571\t        // Phase 2: Load pq data, optionally fold inline by r_prev, and premultiply left0/left1 by weight.\n572\t        for (uint32_t idx = lane; idx < elems; idx += threads) {\n573\t            uint32_t beta = idx / batch;\n574\t            uint32_t bi = idx - beta * batch;\n575\t            uint32_t b = b0 + bi;\n576\t            uint32_t src = beta * k + b;\n577\t            FpExt p0, q0, p1, q1;\n578\t            if constexpr (inline_fold) {\n579\t                // Inline fold: val = lo + r_prev * (hi - lo) for each of {p0, q0, p1, q1}.\n580\t                FracExt const &f0_lo = pq[src];\n581\t                FracExt const &f0_hi = pq[src + fold_half];\n582\t                FracExt const &f1_lo = pq[poly_stride + src];\n583\t                FracExt const &f1_hi = pq[poly_stride + src + fold_half];\n584\t                p0 = f0_lo.p + r_prev * (f0_hi.p - f0_lo.p);\n585\t                q0 = f0_lo.q + r_prev * (f0_hi.q - f0_lo.q);\n586\t                p1 = f1_lo.p + r_prev * (f1_hi.p - f1_lo.p);\n587\t                q1 = f1_lo.q + r_prev * (f1_hi.q - f1_lo.q);\n588\t            } else {\n589\t                // Buffer already folded: read directly.\n590\t                FracExt const &f0 = pq[src];\n591\t                FracExt const &f1 = pq[poly_stride + src];\n592\t                p0 = f0.p; q0 = f0.q;\n593\t                p1 = f1.p; q1 = f1.q;\n594\t            }\n595\t            uint32_t sh_idx = bi * sh_stride + beta;\n596\t            FpExt wt = sh_weight[bi];\n597\t            sh_left0[sh_idx] = wt * (p0 + lambda * q0);\n598\t            sh_left1[sh_idx] = wt * p1;\n599\t            sh_right0[sh_idx] = q0;"}]},"parent_tool_use_id":"toolu_018EAFmb1kYYsAgJQ1wuDZsR","session_id":"3d1d6996-d207-40ca-9042-54ec7bd5b430","uuid":"527fc04b-8947-45f6-b18f-a44b4c92e80e","timestamp":"2026-04-14T16:47:25.670Z"}
