{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WRVbjke5xqveTXZYN8VNqz","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    mem::size_of,\n15\t    sync::Arc,\n16\t};\n17\t\n18\tuse itertools::{izip, Itertools};\n19\tuse openvm_cuda_common::{\n20\t    copy::{MemCopyD2H, MemCopyH2D},\n21\t    d_buffer::DeviceBuffer,\n22\t    error::{CudaError, MemCopyError},\n23\t    memory_manager::MemTracker,\n24\t    stream::current_stream_sync,\n25\t};\n26\tuse openvm_stark_backend::{\n27\t    air_builders::symbolic::SymbolicConstraints,\n28\t    calculate_n_logup,\n29\t    dft::Radix2BowersSerial,\n30\t    p3_matrix::dense::RowMajorMatrix,\n31\t    poly_common::{\n32\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n33\t        UnivariatePoly,\n34\t    },\n35\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n36\t    prover::{\n37\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n38\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n39\t        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n40\t    },\n41\t};\n42\tuse p3_dft::TwoAdicSubgroupDft;\n43\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n44\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n45\tuse rustc_hash::FxHashMap;\n46\tuse tracing::{debug, info, info_span, instrument};\n47\t\n48\tuse crate::{\n49\t    base::DeviceMatrix,\n50\t    cuda::{\n51\t        logup_zerocheck::{\n52\t            batched_interpolate_columns_gpu, fold_selectors_round0, InterpColDesc, MainMatrixPtrs,\n53\t        },\n54\t        sumcheck::batch_fold_mle,\n55\t    },\n56\t    data_transporter::transport_matrix_d2h_col_major,\n57\t    error::LogupZerocheckError,\n58\t    gpu_backend::GenericGpuBackend,\n59\t    hash_scheme::GpuHashScheme,\n60\t    cuda::logup_zerocheck::{\n61\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n62\t        _round0_extract_logup_polys, _round0_extract_zerocheck_poly,\n63\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n64\t    },\n65\t    logup_zerocheck::{\n66\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n67\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n68\t    },\n69\t    poly::EqEvalLayers,\n70\t    prelude::{EF, F},\n71\t    sponge::GpuFiatShamirTranscript,\n72\t    utils::compute_barycentric_inv_lagrange_denoms,\n73\t};\n74\t\n75\tpub(crate) mod batch_mle;\n76\tpub(crate) mod batch_mle_monomial;\n77\tmod errors;\n78\tpub(crate) mod fold_ple;\n79\t/// Fraction sumcheck via GKR\n80\tmod fractional;\n81\t/// Logup interaction evaluations for GKR input\n82\tmod gkr_input;\n83\tmod mle_round;\n84\tmod round0;\n85\tpub(crate) mod rules;\n86\t\n87\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n88\tuse batch_mle_monomial::{\n89\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n90\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n91\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n92\t};\n93\tpub use errors::*;\n94\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n95\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n96\tuse round0::evaluate_round0_constraints_gpu;\n97\t\n98\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n99\t/// More threads = more concurrent kernels but more peak GPU memory and more\n100\t/// MemoryManager mutex contention. 8 provides good SM utilization on the RTX 4090.\n101\tconst NUM_ROUND0_STREAMS: usize = 8;\n102\t\n103\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n104\t/// instead of the monomial kernel for high num_y traces.\n105\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n106\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n107\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n108\t\n109\t#[inline]\n110\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n111\t    if need_rot {\n112\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n113\t        (mat_width / 2) as u32\n114\t    } else {\n115\t        mat_width as u32\n116\t    }\n117\t}\n118\t\n119\t/// Pre-computed transformation matrices for GPU-side polynomial extraction in Round 0.\n120\t/// Captures the entire pipeline: transpose + iDFT + unshift + Lagrange interpolation\n121\t/// + coefficient adjustment (for zerocheck only).\n122\tstruct Round0ExtractTables {\n123\t    /// Zerocheck: maps eval values to final poly coefficients (with adjustment).\n124\t    /// Row-major [output_size × input_size].\n125\t    zc_transform: DeviceBuffer<EF>,\n126\t    zc_input_size: u32,\n127\t    zc_output_size: u32,\n128\t    /// Logup: maps eval values to poly coefficients (no adjustment).\n129\t    /// Row-major [size × size].\n130\t    logup_transform: DeviceBuffer<EF>,\n131\t    logup_size: u32,\n132\t}\n133\t\n134\t/// Compute transform matrices for a given constraint degree `d` and `l_skip`.\n135\t/// These are pre-computed on the CPU by running the polynomial extraction pipeline\n136\t/// on unit vectors, then uploaded to the GPU.\n137\tfn compute_round0_extract_tables(d: usize, l_skip: usize) -> Result<Round0ExtractTables, MemCopyError> {\n138\t    let skip_domain = 1usize << l_skip;\n139\t    let omega_root = F::two_adic_generator(log2_ceil_usize(d << l_skip));\n140\t\n141\t    // Zerocheck transform: input is (d-1)*skip_domain evals, output is sp_0_deg+1 coefficients\n142\t    let (zc_host, zc_in, zc_out) = {\n143\t        let w = d.saturating_sub(1); // num_cosets_zc\n144\t        if w == 0 {\n145\t            (vec![], 0u32, 0u32)\n146\t        } else {\n147\t            let input_size = w * skip_domain;\n148\t            let output_size = sumcheck_round0_deg(l_skip, d) + 1;\n149\t            let mut transform = vec![EF::ZERO; output_size * input_size];\n150\t            for j in 0..input_size {"}]},"parent_tool_use_id":"toolu_018EAFmb1kYYsAgJQ1wuDZsR","session_id":"3d1d6996-d207-40ca-9042-54ec7bd5b430","uuid":"5f899e84-4e36-415e-aa70-78b904b2c7d3","timestamp":"2026-04-14T16:46:52.377Z"}
