{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01172Jt9UqQJTGsbZ64HkPXj","type":"tool_result","content":"187\tpub fn prove_stacked_opening_reduction_gpu<HS, TS>(\n188\t    device: &GpuDevice,\n189\t    transcript: &mut TS,\n190\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n191\t    ctx: ProvingContext<GenericGpuBackend<HS>>,\n192\t    common_main_pcs_data: StackedPcsDataGpu<F, HS::Digest>,\n193\t    r: &[EF],\n194\t) -> Result<\n195\t    (\n196\t        StackingProof<HS::SC>,\n197\t        Vec<EF>,\n198\t        Vec<StackedPcsData2<HS::Digest>>,\n199\t    ),\n200\t    StackedReductionError,\n201\t>\n202\twhere\n203\t    HS: GpuHashScheme,\n204\t    TS: GpuFiatShamirTranscript<HS::SC>,\n205\t{\n206\t    let n_stack = device.config.n_stack;\n207\t    // Batching randomness\n208\t    let lambda = transcript.sample_ext();\n209\t\n210\t    let _round0_span =\n211\t        info_span!(\"prover.openings.stacked_reduction.round0\", phase = \"prover\").entered();\n212\t    let mut prover = StackedReductionGpu::new::<HS>(\n213\t        mpk,\n214\t        ctx,\n215\t        common_main_pcs_data,\n216\t        r,\n217\t        lambda,\n218\t        device.sm_count(),\n219\t    )?;\n220\t\n221\t    // Round 0: univariate sumcheck\n222\t    let s_0 = prover.batch_sumcheck_uni_round0_poly()?;\n223\t    for &coeff in s_0.coeffs() {\n224\t        transcript.observe_ext(coeff);\n225\t    }\n226\t\n227\t    let mut u_vec = Vec::with_capacity(n_stack + 1);\n228\t    let u_0 = transcript.sample_ext();\n229\t    u_vec.push(u_0);\n230\t    debug!(round = 0, u_round = %u_0);\n231\t\n232\t    prover.fold_ple_evals(u_0)?;\n233\t    drop(_round0_span);\n234\t    // end round 0\n235\t\n236\t    let mut sumcheck_round_polys = Vec::with_capacity(n_stack);\n237\t\n238\t    // Rounds 1..=n_stack: MLE sumcheck\n239\t    let _mle_rounds_span = info_span!(\n240\t        \"prover.openings.stacked_reduction.mle_rounds\",\n241\t        phase = \"prover\"\n242\t    )\n243\t    .entered();\n244\t    #[allow(clippy::needless_range_loop)]\n245\t    for round in 1..=n_stack {\n246\t        let batch_s_evals = prover.batch_sumcheck_poly_eval(round, u_vec[round - 1])?;\n247\t\n248\t        for &eval in &batch_s_evals {\n249\t            transcript.observe_ext(eval);\n250\t        }\n251\t        sumcheck_round_polys.push(batch_s_evals);\n252\t\n253\t        let u_round = transcript.sample_ext();\n254\t        u_vec.push(u_round);\n255\t        debug!(%round, %u_round);\n256\t\n257\t        prover.fold_mle_evals(round, u_round)?;\n258\t    }\n259\t    let stacking_openings = prover.get_stacked_openings()?;\n260\t    for claims_for_com in &stacking_openings {\n261\t        for &claim in claims_for_com {\n262\t            transcript.observe_ext(claim);\n263\t        }\n264\t    }\n265\t    drop(_mle_rounds_span);\n266\t    let proof = StackingProof {\n267\t        univariate_round_coeffs: s_0.into_coeffs(),\n268\t        sumcheck_round_polys,\n269\t        stacking_openings,\n270\t    };\n271\t    Ok((proof, u_vec, prover.stacked_per_commit))\n272\t}\n273\t\n274\timpl<D: Copy + Clone + Send + Sync + 'static> StackedReductionGpu<D> {\n275\t    #[instrument(\"stacked_reduction_new\", level = \"debug\", skip_all)]\n276\t    fn new<HS: GpuHashScheme<Digest = D>>(\n277\t        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n278\t        ctx: ProvingContext<GenericGpuBackend<HS>>,\n279\t        common_main_pcs_data: StackedPcsDataGpu<F, D>,\n280\t        r: &[EF],\n281\t        lambda: EF,\n282\t        sm_count: u32,\n283\t    ) -> Result<Self, StackedReductionError> {\n284\t        ensure_device_ntt_twiddles_initialized();\n285\t        let mem = MemTracker::start(\"prover.stacked_reduction_new\");\n286\t        let l_skip = mpk.params.l_skip;\n287\t        let n_stack = mpk.params.n_stack;\n288\t\n289\t        let omega_skip = F::two_adic_generator(l_skip);\n290\t        let omega_skip_pows = omega_skip.powers().take(1 << l_skip).collect_vec();\n291\t        let d_omega_skip_pows = omega_skip_pows.to_device()?;\n292\t\n293\t        // NOTE: DeviceMatrix contains an Arc, so clone is lightweight [for now].\n294\t        // PERF[jpw]: stack the traces all at once. To save memory, we could either stack and drop\n295\t        // traces as we go or even at commit time only store the stacked matrix and drop the traces\n296\t        // much earlier.\n297\t        let common_main_traces = ctx\n298\t            .per_trace\n299\t            .iter()\n300\t            .map(|(_, air_ctx)| air_ctx.common_main.clone())\n301\t            .collect_vec();\n302\t        // SAFETY: common_main_traces commits to common_main_pcs_data\n303\t        let common_main_stacked = unsafe {\n304\t            StackedPcsData2::from_raw(Arc::new(common_main_pcs_data), common_main_traces)\n305\t        };\n306\t        let mut stacked_per_commit = vec![common_main_stacked];\n307\t        for (air_idx, air_ctx) in ctx.per_trace.iter() {\n308\t            for committed in mpk.per_air[*air_idx]\n309\t                .preprocessed_data\n310\t                .iter()\n311\t                .chain(air_ctx.cached_mains.iter())\n312\t            {\n313\t                // SAFETY: committed.trace commits to committed.data\n314\t                let stacked = unsafe {\n315\t                    StackedPcsData2::from_raw(committed.data.clone(), vec![committed.trace.clone()])\n316\t                };\n317\t                stacked_per_commit.push(stacked);\n318\t            }\n319\t        }\n320\t\n321\t        debug_assert!(stacked_per_commit\n322\t            .iter()\n323\t            .all(|d| d.layout().height() == 1 << (l_skip + n_stack)));\n324\t\n325\t        let need_rot_per_trace = ctx\n326\t            .per_trace\n327\t            .iter()\n328\t            .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n329\t            .collect_vec();\n330\t        let mut need_rot_per_commit = vec![need_rot_per_trace];\n331\t        for (air_idx, air_ctx) in ctx.per_trace.iter() {\n332\t            let need_rot = mpk.per_air[*air_idx].vk.params.need_rot;\n333\t            if mpk.per_air[*air_idx].preprocessed_data.is_some() {\n334\t                need_rot_per_commit.push(vec![need_rot]);\n335\t            }\n336\t            for _ in &air_ctx.cached_mains {\n337\t                need_rot_per_commit.push(vec![need_rot]);\n338\t            }\n339\t        }\n340\t        let q_widths = stacked_per_commit\n341\t            .iter()\n342\t            .map(|d| d.layout().width() as u32)\n343\t            .collect_vec();\n344\t        let q_width_max = *q_widths.iter().max().unwrap();\n345\t        let d_q_widths = q_widths.to_device()?;\n346\t\n347\t        let total_num_cols: usize = stacked_per_commit\n348\t            .iter()\n349\t            .map(|d| d.layout().sorted_cols.len())\n350\t            .sum();\n351\t        let mut unstacked_cols = Vec::with_capacity(total_num_cols);\n352\t        let mut need_rot_per_col = Vec::with_capacity(total_num_cols);\n353\t        let mut ht_diff_idxs = Vec::new();\n354\t        let mut trace_ptrs = Vec::new();\n355\t        for (commit_idx, stacked) in stacked_per_commit.iter().enumerate() {\n356\t            let layout = stacked.layout();\n357\t            let need_rot_for_commit = &need_rot_per_commit[commit_idx];\n358\t            debug_assert_eq!(need_rot_for_commit.len(), layout.mat_starts.len());\n359\t            for (mat_idx, (trace, &idx)) in zip_eq(&stacked.traces, &layout.mat_starts).enumerate()\n360\t            {\n361\t                debug_assert_ne!(trace.width(), 0);\n362\t                debug_assert_ne!(trace.height(), 0);\n363\t                ht_diff_idxs.push(unstacked_cols.len());\n364\t                trace_ptrs.push((trace.buffer().as_ptr(), trace.height(), trace.width()));\n365\t                let need_rot = need_rot_for_commit[mat_idx];\n366\t                for j in 0..trace.width() {\n367\t                    let (_, _j, s) = layout.sorted_cols[idx + j];\n368\t                    debug_assert_eq!(_j, j);\n369\t                    debug_assert_eq!(1 << s.log_height(), trace.height());\n370\t                    unstacked_cols.push(UnstackedSlice {\n371\t                        commit_idx: commit_idx as u32,\n372\t                        log_height: s.log_height() as u32,\n373\t                        stacked_row_idx: s.row_idx as u32,\n374\t                        stacked_col_idx: s.col_idx as u32,\n375\t                    });\n376\t                    need_rot_per_col.push(need_rot);\n377\t                }\n378\t            }\n379\t        }\n380\t        debug_assert_eq!(unstacked_cols.len(), total_num_cols);\n381\t        ht_diff_idxs.push(unstacked_cols.len());\n382\t\n383\t        let lambda_pows_used = lambda.powers().take(total_num_cols * 2).collect_vec();\n384\t        let mut lambda_pows = vec![EF::ZERO; total_num_cols * 2];\n385\t        for (col_idx, need_rot) in need_rot_per_col.into_iter().enumerate() {\n386\t            let lambda_eq_idx = 2 * col_idx;\n387\t            let lambda_rot_idx = 2 * col_idx + 1;\n388\t            lambda_pows[lambda_eq_idx] = lambda_pows_used[lambda_eq_idx];\n389\t            if need_rot {\n390\t                lambda_pows[lambda_rot_idx] = lambda_pows_used[lambda_rot_idx];\n391\t            }\n392\t        }\n393\t        let d_lambda_pows = lambda_pows.to_device()?;\n394\t\n395\t        let d_unstacked_cols = unstacked_cols.to_device()?;\n396\t\n397\t        // layout per commit is sorted, first height is largest\n398\t        let n_max = r.len() - 1;\n399\t        debug_assert_eq!(\n400\t            n_max,\n401\t            stacked_per_commit\n402\t                .iter()\n403\t                .map(|d| d.layout().sorted_cols[0].2.log_height())\n404\t                .max()\n405\t                .unwrap_or(0)\n406\t                .saturating_sub(l_skip)\n407\t        );\n408\t        let eq_r_ns =\n409\t            EqEvalSegments::new(&r[1..]).map_err(StackedReductionError::EqEvalSegments)?;\n410\t\n411\t        let eq_const = eval_eq_uni_at_one(l_skip, r[0] * omega_skip);\n412\t        let eq_ub_per_trace = vec![EF::ONE; unstacked_cols.len()];\n413\t        let d_q_eval_ptrs = if stacked_per_commit.is_empty() {\n414\t            DeviceBuffer::new()\n415\t        } else {\n416\t            DeviceBuffer::with_capacity(stacked_per_commit.len())\n417\t        };\n418\t        let d_input_ptrs = if stacked_per_commit.is_empty() {\n419\t            DeviceBuffer::new()\n420\t        } else {\n421\t            DeviceBuffer::with_capacity(stacked_per_commit.len())\n422\t        };\n423\t        let d_output_ptrs = if stacked_per_commit.is_empty() {\n424\t            DeviceBuffer::new()\n425\t        } else {\n426\t            DeviceBuffer::with_capacity(stacked_per_commit.len())\n427\t        };\n428\t        let d_accum = DeviceBuffer::<u64>::with_capacity(STACKED_REDUCTION_S_DEG * D_EF);\n429\t        let d_eq_ub_all = if unstacked_cols.is_empty() {\n430\t            DeviceBuffer::new()\n431\t        } else {\n432\t            DeviceBuffer::with_capacity(unstacked_cols.len())\n433\t        };\n434\t\n435\t        Ok(Self {\n436\t            sm_count,\n437\t            l_skip,\n438\t            n_stack,\n439\t            omega_skip,\n440\t            omega_skip_pows,\n441\t            d_omega_skip_pows,\n442\t            r_0: r[0],\n443\t            d_lambda_pows,\n444\t            eq_const,\n445\t            stacked_per_commit,\n446\t            d_q_widths,\n447\t            q_width_max,\n448\t            d_q_eval_ptrs,\n449\t            trace_ptrs,\n450\t            unstacked_cols,\n451\t            d_unstacked_cols,\n452\t            ht_diff_idxs,\n453\t            n_max,\n454\t            eq_r_ns,\n455\t            q_evals: vec![],\n456\t            eq_stable: vec![],\n457\t            k_rot_stable: vec![],\n458\t            // SAFETY: This is unused in round 0 and will be initialized properly after round 0.\n459\t            k_rot_ns: unsafe { EqEvalSegments::from_raw_parts(DeviceBuffer::new(), 0) },\n460\t            eq_ub_per_trace,\n461\t            d_eq_ub_all,\n462\t            d_block_sums: DeviceBuffer::new(),\n463\t            d_accum,\n464\t            d_input_ptrs,\n465\t            d_output_ptrs,\n466\t            mem,\n467\t        })\n468\t    }\n469\t\n470\t    /// SP_DEG=1 round 0: computes G0, G1, G2 on identity coset, then reconstructs s_0 on CPU.\n471\t    ///\n472\t    /// Key insight: Instead of computing s₀(Z) directly on 2 cosets with in-kernel NTT,\n473\t    /// we compute three partial sums G0, G1, G2 on the identity coset only, then\n474\t    /// reconstruct s₀ via CPU-side NTT-based polynomial multiplication.\n475\t    #[instrument(\n476\t        \"stacked_reduction_sumcheck\",\n477\t        level = \"debug\",\n478\t        skip_all,\n479\t        fields(round = 0)\n480\t    )]\n481\t    fn batch_sumcheck_uni_round0_poly(\n482\t        &mut self,\n483\t    ) -> Result<UnivariatePoly<EF>, StackedReductionError> {\n484\t        let l_skip = self.l_skip;\n485\t        let skip_domain = 1 << l_skip;\n486\t        let s_0_deg = sumcheck_round0_deg(l_skip, STACKED_REDUCTION_S_DEG);\n487\t\n488\t        // Accumulation buffers for G0, G1, G2 (on identity coset)\n489\t        // d_g_pos: for n >= 0 traces\n490\t        let mut d_g_pos = DeviceBuffer::<EF>::with_capacity(NUM_G * skip_domain);\n491\t        d_g_pos\n492\t            .fill_zero()\n493\t            .map_err(StackedReductionError::FillZero)?;\n494\t\n495\t        // d_g_neg[k]: for traces with |n| = k+1, where n < 0 and k in 0..l_skip\n496\t        let mut d_g_neg: Vec<DeviceBuffer<EF>> = (0..l_skip)\n497\t            .map(|_| {\n498\t                let b = DeviceBuffer::with_capacity(NUM_G * skip_domain);\n499\t                b.fill_zero().map_err(StackedReductionError::FillZero)?;\n500\t                Ok(b)\n501\t            })\n502\t            .collect::<Result<Vec<_>, StackedReductionError>>()?;\n503\t\n504\t        // Process each trace - call kernel for each, accumulating into appropriate bucket\n505\t        for ((trace_ptr, trace_height, trace_width), window) in zip(\n506\t            mem::take(&mut self.trace_ptrs),\n507\t            self.ht_diff_idxs.windows(2),\n508\t        ) {\n509\t            debug_assert_eq!(window[1] - window[0], trace_width);\n510\t            let log_height = trace_height.ilog2();\n511\t            let n = log_height as isize - l_skip as isize;\n512\t\n513\t            // Select output bucket based on n\n514\t            let d_g_output = if n >= 0 {\n515\t                &mut d_g_pos\n516\t            } else {\n517\t                &mut d_g_neg[(-n - 1) as usize]\n518\t            };\n519\t\n520\t            // Allocate block_sums buffer for intermediate reduction\n521\t            let block_sums_len = unsafe {\n522\t                _stacked_reduction_r0_required_temp_buffer_size(\n523\t                    trace_height as u32,\n524\t                    trace_width as u32,\n525\t                    l_skip as u32,\n526\t                )\n527\t            } as usize;\n528\t\n529\t            if block_sums_len > self.d_block_sums.len() {\n530\t                self.d_block_sums = DeviceBuffer::<EF>::with_capacity(block_sums_len);\n531\t            }\n532\t\n533\t            unsafe {\n534\t                // 2 per column for (eq, k_rot) - coeff_eq and coeff_rot\n535\t                let lambda_pows_ptr = self.d_lambda_pows.as_ptr().add(2 * window[0]);\n536\t\n537\t                stacked_reduction_sumcheck_round0(\n538\t                    &self.eq_r_ns,\n539\t                    trace_ptr,\n540\t                    lambda_pows_ptr,\n541\t                    &mut self.d_block_sums,\n542\t                    d_g_output,\n543\t                    trace_height,\n544\t                    trace_width,\n545\t                    l_skip,\n546\t                )\n547\t                .map_err(StackedReductionError::SumcheckRound0)?;\n548\t            };\n549\t        }\n550\t\n551\t        // CPU reconstruction: s₀(Z) = E0(Z)*G0(Z) + E1(Z)*G1(Z) + E2(Z)*G2(Z)\n552\t        let s_0 = self.reconstruct_s0_from_g(d_g_pos, d_g_neg, s_0_deg)?;\n553\t        self.mem.tracing_info(\"stacked_reduction_sumcheck round 0\");\n554\t\n555\t        Ok(s_0)\n556\t    }\n557\t\n558\t    /// Reconstructs s_0 from G0, G1, G2 using NTT-based polynomial multiplication.\n559\t    ///\n560\t    /// For n >= 0:\n561\t    /// - E0(Z) = eq_uni(l_skip, Z, r0)\n562\t    /// - E1(Z) = eq_uni(l_skip, Z, r0*ω_skip)\n563\t    /// - E2(Z) = eq_const * eq_uni_at_one(l_skip, Z)\n564\t    ///\n565\t    /// For n < 0: multiply each E by ind(Z) = eval_in_uni(l_skip, n, Z)\n566\t    fn reconstruct_s0_from_g(\n567\t        &self,\n568\t        d_g_pos: DeviceBuffer<EF>,\n569\t        d_g_neg: Vec<DeviceBuffer<EF>>,\n570\t        s_0_deg: usize,\n571\t    ) -> Result<UnivariatePoly<EF>, StackedReductionError> {\n572\t        let l_skip = self.l_skip;\n573\t        let skip_domain = 1 << l_skip;\n574\t        let large_uni_domain = (s_0_deg + 1).next_power_of_two(); // 2 * skip_domain\n575\t        let dft = Radix2BowersSerial;\n576\t\n577\t        // Accumulate s_0 coefficients across all buckets\n578\t        let mut s_0_coeffs = vec![EF::ZERO; large_uni_domain];\n579\t\n580\t        // --- Process n >= 0 bucket ---\n581\t        let g_pos = d_g_pos.to_host()?;\n582\t        if !g_pos.iter().all(|&x| x == EF::ZERO) {\n583\t            // Build E polynomials for n >= 0\n584\t            let e0 = eq_uni_poly::<F, EF>(l_skip, self.r_0);\n585\t            let e1 = eq_uni_poly::<F, EF>(l_skip, self.r_0 * self.omega_skip);\n586\t            let e2 = eq_uni_at_one_poly(l_skip, self.eq_const);"}]},"parent_tool_use_id":"toolu_01KnvCQXX57zD2c2S7ZT7TQj","session_id":"d4314f39-e91d-47fe-87bd-a8908ed81e1e","uuid":"4c5564d7-7cd7-4f42-82dc-c3e155aefe83","timestamp":"2026-04-14T05:51:20.451Z"}
