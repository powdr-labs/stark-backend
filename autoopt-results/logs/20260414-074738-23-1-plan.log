c const int BN254_BABY_BEAR_RATE = 16;\n99\tstatic const int BN254_NUM_F_ELMS    = 8;\n100\t\n101\t// ---------------------------------------------------------------------------\n102\t// Row hash helpers\n103\t// ---------------------------------------------------------------------------\n104\t\n105\t/// Row hash for a base-field (Fp / BabyBear) matrix row.\n106\tstatic __device__ __forceinline__\n107\tBn254Fr bn254_row_hash(const Fp* matrix, int width, int height, int row) {\n108\t    Bn254Fr state[3];\n109\t    state[0] = bn254_zero_init();\n110\t    state[1] = bn254_zero_init();\n111\t    state[2] = bn254_zero_init();\n112\t\n113\t    uint32_t buf[BN254_BABY_BEAR_RATE];\n114\t    int cnt = 0;\n115\t\n116\t    for (int col = 0; col < width; col++) {\n117\t        buf[cnt++] = matrix[col * height + row].asUInt32();\n118\t        if (cnt == BN254_BABY_BEAR_RATE) {\n119\t            state[0] = bn254_reduce_32(buf, BN254_NUM_F_ELMS);\n120\t            state[1] = bn254_reduce_32(buf + BN254_NUM_F_ELMS, BN254_NUM_F_ELMS);\n121\t            bn254_poseidon2_permute(state);\n122\t            cnt = 0;\n123\t        }\n124\t    }\n125\t    if (cnt > 0) {\n126\t        state[0] = bn254_reduce_32(buf, min(BN254_NUM_F_ELMS, cnt));\n127\t        if (cnt > BN254_NUM_F_ELMS)\n128\t            state[1] = bn254_reduce_32(buf + BN254_NUM_F_ELMS,\n129\t                                       min(BN254_NUM_F_ELMS, cnt - BN254_NUM_F_ELMS));\n130\t        bn254_poseidon2_permute(state);\n131\t    }\n132\t    return state[0];\n133\t}\n134\t\n135\t/// Row hash for an extension-field (FpExt / BinomialExtensionField<BabyBear,4>) matrix row.\n136\tstatic __device__ __forceinline__\n137\tBn254Fr bn254_row_hash_ext(const FpExt* matrix, int width, int height, int row) {\n138\t    Bn254Fr state[3];\n139\t    state[0] = bn254_zero_init();\n140\t    state[1] = bn254_zero_init();\n141\t    state[2] = bn254_zero_init();\n142\t\n143\t    uint32_t buf[BN254_BABY_BEAR_RATE];\n144\t    int cnt = 0;\n145\t\n146\t    for (int col = 0; col < width; col++) {\n147\t        FpExt elem = matrix[col * height + row];\n148\t        for (int d = 0; d < 4; d++) {\n149\t            buf[cnt++] = elem.elems[d].asUInt32();\n150\t            if (cnt == BN254_BABY_BEAR_RATE) {\n151\t                state[0] = bn254_reduce_32(buf, BN254_NUM_F_ELMS);\n152\t                state[1] = bn254_reduce_32(buf + BN254_NUM_F_ELMS, BN254_NUM_F_ELMS);\n153\t                bn254_poseidon2_permute(state);\n154\t                cnt = 0;\n155\t            }\n156\t        }\n157\t    }\n158\t    if (cnt > 0) {\n159\t        state[0] = bn254_reduce_32(buf, min(BN254_NUM_F_ELMS, cnt));\n160\t        if (cnt > BN254_NUM_F_ELMS)\n161\t            state[1] = bn254_reduce_32(buf + BN254_NUM_F_ELMS,\n162\t                                       min(BN254_NUM_F_ELMS, cnt - BN254_NUM_F_ELMS));\n163\t        bn254_poseidon2_permute(state);\n164\t    }\n165\t    return state[0];\n166\t}\n167\t\n168\t/// TruncatedPermutation compress: (left, right) → permute([left, right, 0])[0].\n169\tstatic __device__ __forceinline__\n170\tBn254Fr bn254_compress(Bn254Fr left, Bn254Fr right) {\n171\t    Bn254Fr state[3];\n172\t    state[0] = left;\n173\t    state[1] = right;\n174\t    state[2] = bn254_zero_init();\n175\t    bn254_poseidon2_permute(state);\n176\t    return state[0];\n177\t}\n178\t\n179\t// ---------------------------------------------------------------------------\n180\t// Merkle row-hash kernel (F / BabyBear matrix)\n181\t// ---------------------------------------------------------------------------\n182\t\n183\t__global__ void bn254_compressing_row_hashes_kernel(\n184\t    bn254_digest_t* out,\n185\t    const Fp*       matrix,\n186\t    size_t          width,\n187\t    size_t          height,\n188\t    size_t          query_stride,\n189\t    size_t          log_rows_per_query\n190\t) {\n191\t    extern __shared__ char smem[]; // Bn254Fr[blockDim.x * (blockDim.y/2)]\n192\t    Bn254Fr* shared = reinterpret_cast<Bn254Fr*>(smem);\n193\t\n194\t    const uint32_t stride_idx = blockDim.x * blockIdx.x + threadIdx.x;\n195\t    uint32_t       leaf_idx   = threadIdx.y;\n196\t    const uint32_t row        = leaf_idx * query_stride + stride_idx;\n197\t\n198\t    Bn254Fr digest = bn254_zero_init();\n199\t"}]},"parent_tool_use_id":"toolu_01KD73Nuz5EBNWN5PvaqiPnA","session_id":"d4314f39-e91d-47fe-87bd-a8908ed81e1e","uuid":"36eb990f-47b9-4886-8997-b5d8512ee228","timestamp":"2026-04-14T05:51:12.394Z"}
