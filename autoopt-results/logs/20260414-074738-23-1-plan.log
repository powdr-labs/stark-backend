pq,  // Pre-fold buffer (2*pq_size FracExt)\n239\t    uint32_t num_x,                      // post-fold num_x (= pq_size / 2)\n240\t    uint32_t log_eq_low_cap,\n241\t    FpExt lambda,\n242\t    FpExt r_prev,                        // Previous round's challenge for folding\n243\t    FpExt *__restrict__ block_sums,      // Output: [gridDim.x * 2]\n244\t    FracExt *__restrict__ dst_pq         // Post-fold buffer (pq_size FracExt)\n245\t) {\n246\t    extern __shared__ FpExt shared[];\n247\t    const uint32_t pq_size = 2 * num_x;\n248\t\n249\t    // Index offsets for fold pattern (see detailed comments in inplace kernel)"}]},"parent_tool_use_id":"toolu_01PQNC9m7tCBbo3HCMTn8R8c","session_id":"d4314f39-e91d-47fe-87bd-a8908ed81e1e","uuid":"c6bff18f-5243-40e5-a4d1-4fa2b2b2e8b4","timestamp":"2026-04-14T05:51:08.168Z"}
