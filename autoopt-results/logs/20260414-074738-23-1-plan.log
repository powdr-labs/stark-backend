rc_pq_size: usize,\n186\t        eq_low_cap: usize,\n187\t        lambda: EF,\n188\t        r_prev: EF,\n189\t        out_device: *mut EF,\n190\t        tmp_block_sums: *mut EF,\n191\t    ) -> i32;\n192\t\n193\t    fn _frac_precompute_m_build(\n194\t        pq: *const Frac<EF>,\n195\t        rem_n: usize,\n196\t        w: usize,\n197\t        lambda: EF,\n198\t        r_prev: EF,\n199\t        inline_fold: bool,\n200\t        eq_tail_low: *const EF,\n201\t        eq_tail_high: *const EF,\n202\t        eq_tail_low_cap: usize,\n203\t        tail_tile: usize,\n204\t        partial_out: *mut EF,\n205\t        partial_len: usize,\n206\t        m_total: *mut EF,\n207\t    ) -> i32;\n208\t\n209\t    fn _frac_precompute_m_eval_round(\n210\t        m_total: *const EF,\n211\t        w: usize,\n212\t        t: usize,\n213\t        eq_r_prefix: *const EF,\n214\t        eq_suffix: *const EF,\n215\t        out: *mut EF,\n216\t    ) -> i32;\n217\t\n218\t    fn _frac_multifold(\n219\t        src: *const Frac<EF>,\n220\t        dst: *mut Frac<EF>,\n221\t        rem_n: usize,\n222\t        w: usize,\n223\t        eq_r_window: *const EF,\n224\t    ) -> i32;\n225\t\n226\t    fn _frac_add_alpha(data: *mut std::ffi::c_void, len: usize, alpha: EF) -> i32;\n227\t\n228\t    fn _frac_vector_scalar_multiply_ext_fp(frac_vec: *mut Frac<EF>, scalar: F, length: u32) -> i32;\n229\t\n230\t    // utils.cu\n231\t    fn _fold_ple_from_evals(\n232\t        input_matrix: *const F,\n233\t        output_matrix: *mut EF,\n234\t        omega_skip_pows: *const F,\n235\t        inv_lagrange_denoms: *const EF,\n236\t        height: u32,\n237\t        width: u32,\n238\t        l_skip: u32,\n239\t        new_height: u32,"}]},"parent_tool_use_id":"toolu_012z6xRskUmg2JG9ZwsEYam4","session_id":"d4314f39-e91d-47fe-87bd-a8908ed81e1e","uuid":"67fb399e-5573-4305-b72d-5ebe9b96d73b","timestamp":"2026-04-14T09:06:31.157Z"}
