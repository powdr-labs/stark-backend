7\t\n838\t                // w+1 to accommodate r_prev prepended to window challenges\n839\t                // on the first iteration (inline fold on last outer round).\n840\t                let mut eq_r_window_host = vec![EF::ZERO; 1 << (GKR_WINDOW_SIZE + 1)];\n841\t                let mut eq_r_prefix_host = vec![EF::ZERO; 1 << GKR_WINDOW_SIZE];\n842\t                let mut eq_suffix_host = vec![EF::ZERO; 1 << GKR_WINDOW_SIZE];\n843\t\n844\t                if eq_r_prefix_buffer.is_empty() {\n845\t                    eq_r_prefix_buffer =\n846\t                        DeviceBuffer::<EF>::with_capacity(1usize << GKR_WINDOW_SIZE);\n847\t                }\n848\t                if eq_suffix_buffer.is_empty() {\n849\t                    eq_suffix_buffer = DeviceBuffer::<EF>::with_capacity(1usize << GKR_WINDOW_SIZE);\n850\t                }\n851\t\n852\t                let mut base = base;\n853\t                while base < stop {\n854\t                    let rem_n = round - base;\n855\t                    let rounds_left = stop - base;\n856\t                    let Some(w) = choose_precompute_m_window_w(\n857\t                        rem_n,\n858\t                        rounds_left,\n859\t                        precompute_m_min_blocks_threshold,\n860\t                        precompute_m_target_blocks,\n861\t                        precompute_m_tail_tile_override,\n862\t                        precompute_m_min_n,\n863\t                    ) else {\n864\t                        break;\n865\t                    };\n866\t                    if m_buffer.is_empty() {\n867\t                        let max_m_len = 1usize << (2 * GKR_WINDOW_SIZE);\n868\t                        m_buffer = DeviceBuffer::<EF>::with_capacity(max_m_len);\n869\t                    }\n870\t                    let m_ptr = m_buffer.as_mut_ptr();\n871\t                    // Reuse tmp_block_sums for eq_r_window upload.\n872\t                    // Safe: M eval rounds finish before multifold needs eq_r_window,\n873\t                    // and tmp_block_sums is not needed until next fold-eval round.\n874\t                    let max_eq_r_window_len = 1usize << (GKR_WINDOW_SIZE + 1);\n875\t                    debug_assert!(\n876\t                        tmp_block_sums.len() >= max_eq_r_window_len,\n877\t                        \"tmp_block_sums too small for eq_r_window: {} < {}\",\n878\t                        tmp_block_sums.len(),\n879\t                        max_eq_r_window_len,\n880\t                    );\n881\t                    let d_eq_r_window = tmp_block_sums.as_mut_ptr();\n882\t\n883\t                    // When pending_fold is true, the buffer has rem_n+1 variables\n884\t                    // and the kernel folds inline. The effective tail dimension\n885\t                    // for tiling is the same either way (rem_n - w).\n886\t                    let tail_tile = precompute_m_build_tail_tile(\n887\t                        rem_n,\n888\t                        w,\n889\t                        precompute_m_min_blocks_threshold,\n890\t                        precompute_m_target_blocks,\n891\t                        precompute_m_tail_tile_override,\n892\t                    );\n893\t                    let num_blocks = precompute_m_num_tail_blocks(rem_n, w, tail_tile);\n894\t                    let m_len = (1usize << w) * (1usize << w);\n895\t                    let partial_len = num_blocks * m_len;\n896\t                    if partial_len > m_partial_buffer.len() {\n897\t                        m_partial_buffer = DeviceBuffer::<EF>::with_capacity(partial_len);\n898\t                    }\n899\t\n900\t                    let (eq_tail_low, eq_tail_high, eq_low_cap, _) =\n901\t                        eq_tail_ptrs(&eq_buffer, w - 1);\n902\t\n903\t                    let r_fold = prev_r; // save before eval loop overwrites prev_r\n904\t                    let build_src = if pending_fold {\n905\t                        layer_read_ptr\n906\t                    }