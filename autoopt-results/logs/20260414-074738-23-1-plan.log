{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W1zpznVshrwq2mosSZjPBq","type":"tool_result","content":"1\tuse std::cmp::max;\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::{\n5\t    copy::MemCopyH2D,\n6\t    d_buffer::DeviceBuffer,\n7\t    stream::current_stream_sync,\n8\t};\n9\tuse openvm_stark_backend::prover::{\n10\t    fractional_sumcheck_gkr::Frac,\n11\t    stacked_pcs::{StackedLayout, StackedSlice},\n12\t    DeviceMultiStarkProvingKey, MatrixDimensions, ProvingContext,\n13\t};\n14\tuse p3_field::{Field, PrimeCharacteristicRing};\n15\tuse tracing::instrument;\n16\t\n17\tuse super::errors::InteractionGpuError;\n18\tuse crate::{\n19\t    cuda::logup_zerocheck::{\n20\t        frac_matrix_vertically_repeat, frac_vector_scalar_multiply_ext_fp, logup_gkr_input_eval,\n21\t    },\n22\t    gpu_backend::GenericGpuBackend,\n23\t    hash_scheme::GpuHashScheme,\n24\t    prelude::{EF, F},\n25\t};\n26\t\n27\tconst TASK_SIZE: u32 = 65536;\n28\t\n29\t/// Number of OS threads (and thus CUDA streams) for parallel GKR input evaluation.\n30\tconst NUM_GKR_INPUT_STREAMS: usize = 8;\n31\t\n32\tstruct SendPtr<T>(*mut T);\n33\tunsafe impl<T> Send for SendPtr<T> {}\n34\tunsafe impl<T> Sync for SendPtr<T> {}\n35\t\n36\tstruct GkrThreadBuffers {\n37\t    intermediates: DeviceBuffer<EF>,\n38\t    public_values: DeviceBuffer<F>,\n39\t    partition_ptrs: DeviceBuffer<u64>,\n40\t    tmp: DeviceBuffer<Frac<EF>>,\n41\t}\n42\t\n43\tstruct GkrInputWorkItem<'a, HS: GpuHashScheme> {\n44\t    air_ctx: &'a openvm_stark_backend::prover::AirProvingContext<GenericGpuBackend<HS>>,\n45\t    pk_air: &'a openvm_stark_backend::prover::DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n46\t    l_skip: usize,\n47\t    d_challenges: &'a DeviceBuffer<EF>,\n48\t    leaves_ptr: SendPtr<Frac<EF>>,\n49\t}\n50\t\n51\t#[allow(dead_code)]\n52\t#[derive(Clone)]\n53\tpub struct TraceInteractionMeta {\n54\t    pub trace_idx: usize,\n55\t    pub air_idx: usize,\n56\t    pub layout_slices: Vec<StackedSlice>,\n57\t}\n58\t\n59\t// TODO[jpw]: revisit if this function is needed\n60\tpub fn collect_trace_interactions<HS: GpuHashScheme>(\n61\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n62\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n63\t    layout: &StackedLayout,\n64\t) -> Vec<Option<TraceInteractionMeta>> {\n65\t    // Pre-group layout slices by trace to avoid repeated scans later.\n66\t    let mut slices_by_trace: Vec<Vec<(usize, StackedSlice)>> =\n67\t        vec![Vec::new(); ctx.per_trace.len()];\n68\t    for &(trace_idx, interaction_idx, ref slice) in &layout.sorted_cols {\n69\t        if let Some(entries) = slices_by_trace.get_mut(trace_idx) {\n70\t            entries.push((interaction_idx, *slice));\n71\t        }\n72\t    }\n73\t\n74\t    ctx.per_trace\n75\t        .iter()\n76\t        .enumerate()\n77\t        .map(|(trace_idx, (air_idx, _))| {\n78\t            let vk = &pk.per_air[*air_idx].vk;\n79\t            if !vk.has_interaction() {\n80\t                return None;\n81\t            }\n82\t\n83\t            let mut layout_entries = vec![None; vk.num_interactions()];\n84\t            for (interaction_idx, slice) in &slices_by_trace[trace_idx] {\n85\t                if let Some(slot) = layout_entries.get_mut(*interaction_idx) {\n86\t                    *slot = Some(*slice);\n87\t                }\n88\t            }\n89\t\n90\t            let layout_slices = layout_entries\n91\t                .into_iter()\n92\t                .enumerate()\n93\t                .map(|(idx, maybe_slice)| {\n94\t                    maybe_slice.unwrap_or_else(|| {\n95\t                        panic!(\n96\t                            \"missing stacked slice for interaction {} of trace {}\",\n97\t                            idx, trace_idx\n98\t                        )\n99\t                    })\n100\t                })\n101\t                .collect_vec();\n102\t\n103\t            Some(TraceInteractionMeta {\n104\t                trace_idx,\n105\t                air_idx: *air_idx,\n106\t                layout_slices,\n107\t            })\n108\t        })\n109\t        .collect()\n110\t}\n111\t\n112\tfn process_gkr_input_air<HS: GpuHashScheme>(\n113\t    w: &GkrInputWorkItem<HS>,\n114\t    buffers: &mut GkrThreadBuffers,\n115\t) -> Result<(), InteractionGpuError> {\n116\t    let null_preprocessed = DeviceBuffer::<F>::new();\n117\t    let air_ctx = w.air_ctx;\n118\t    let pk_air = w.pk_air;\n119\t\n120\t    let preprocessed_matrix = pk_air\n121\t        .preprocessed_data\n122\t        .as_ref()\n123\t        .map(|committed| &committed.trace);\n124\t\n125\t    let mut partitioned_main = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n126\t    for committed in &air_ctx.cached_mains {\n127\t        partitioned_main.push(&committed.trace);\n128\t    }\n129\t    partitioned_main.push(&air_ctx.common_main);\n130\t\n131\t    let rules = &pk_air.other_data.interaction_rules;\n132\t    let num_interactions = pk_air.vk.symbolic_constraints.interactions.len();\n133\t\n134\t    let d_preprocessed = preprocessed_matrix\n135\t        .as_ref()\n136\t        .map(|m| m.buffer())\n137\t        .unwrap_or(&null_preprocessed);\n138\t\n139\t    let null_pv = DeviceBuffer::<F>::new();\n140\t    let has_public_values = !air_ctx.public_values.is_empty();\n141\t    if has_public_values {\n142\t        air_ctx.public_values.copy_to(&mut buffers.public_values)?;\n143\t    }\n144\t    let d_public_values = if has_public_values {\n145\t        &buffers.public_values\n146\t    } else {\n147\t        &null_pv\n148\t    };\n149\t\n150\t    let height = air_ctx.height();\n151\t    debug_assert_eq!(height, partitioned_main[0].height());\n152\t    let partition_ptrs = partitioned_main\n153\t        .iter()\n154\t        .map(|m| m.buffer().as_ptr() as u64)\n155\t        .collect_vec();\n156\t    partition_ptrs.copy_to(&mut buffers.partition_ptrs)?;\n157\t\n158\t    let buffer_size = rules.inner.buffer_size;\n159\t    // TODO[jpw]: remove magic 10\n160\t    let is_global = buffer_size > 10;\n161\t\n162\t    let num_rows_per_tile = height.div_ceil(TASK_SIZE as usize).max(1);\n163\t\n164\t    let leaves_ptr = w.leaves_ptr.0;\n165\t    let l_skip = w.l_skip;\n166\t    let lifted_height = max(height, 1 << l_skip);\n167\t\n168\t    let trace_output = if height != lifted_height {\n169\t        buffers.tmp.as_mut_ptr()\n170\t    } else {\n171\t        leaves_ptr\n172\t    };\n173\t    unsafe {\n174\t        logup_gkr_input_eval(\n175\t            is_global,\n176\t            trace_output,\n177\t            d_preprocessed,\n178\t            &buffers.partition_ptrs,\n179\t            d_public_values,\n180\t            w.d_challenges,\n181\t            &buffers.intermediates,\n182\t            &rules.inner.d_rules,\n183\t            &rules.inner.d_used_nodes,\n184\t            &rules.d_pair_idxs,\n185\t            height as u32,\n186\t            num_rows_per_tile as u32,\n187\t        )?;\n188\t    }\n189\t    if height != lifted_height {\n190\t        debug_assert_eq!(lifted_height % height, 0);\n191\t        debug_assert!(!buffers.tmp.is_empty());\n192\t        let norm_factor_denom = lifted_height / height;\n193\t        let norm_factor = F::from_usize(norm_factor_denom).inverse();\n194\t        unsafe {\n195\t            frac_vector_scalar_multiply_ext_fp(\n196\t                buffers.tmp.as_mut_ptr(),\n197\t                norm_factor,\n198\t                (height * num_interactions) as u32,\n199\t            )?;\n200\t            frac_matrix_vertically_repeat("}]},"parent_tool_use_id":"toolu_012z6xRskUmg2JG9ZwsEYam4","session_id":"d4314f39-e91d-47fe-87bd-a8908ed81e1e","uuid":"aead6283-a3e4-42bc-81d5-83d10d8cdffe","timestamp":"2026-04-14T09:06:17.002Z"}
