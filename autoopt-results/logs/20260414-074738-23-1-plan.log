{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R9vSMAwU1j3TkzxtHktVp7","type":"tool_result","content":"1\t/*\n2\t * Source: https://github.com/scroll-tech/plonky3-gpu (private repo)\n3\t * Status: BASED ON plonky3-gpu/gpu-backend/src/cuda/kernels/codec.h\n4\t * Imported: 2025-01-25 by @gaxiom\n5\t */\n6\t\n7\t// A very simple custom codec for constraints wroten in the AIR/RAP frontend language.\n8\t#pragma once\n9\t\n10\t#include <cstdint>\n11\t\n12\ttypedef struct {\n13\t    uint64_t low;\n14\t    uint64_t high;\n15\t} Rule;\n16\t\n17\ttypedef enum { OP_ADD, OP_SUB, OP_MUL, OP_NEG, OP_VAR, OP_INV } OperationType;\n18\t\n19\ttypedef enum {\n20\t    ENTRY_PREPROCESSED,\n21\t    ENTRY_MAIN,\n22\t    ENTRY_PERMUTATION,\n23\t    ENTRY_PUBLIC,\n24\t    ENTRY_CHALLENGE,\n25\t    ENTRY_EXPOSED,\n26\t    SRC_INTERMEDIATE,\n27\t    SRC_CONSTANT,\n28\t    SRC_IS_FIRST,\n29\t    SRC_IS_LAST,\n30\t    SRC_IS_TRANSITION\n31\t} EntryType;\n32\t\n33\ttypedef struct {\n34\t    EntryType type;\n35\t    uint8_t part;\n36\t    uint8_t offset;\n37\t    uint32_t index;\n38\t} SourceInfo;\n39\t\n40\ttypedef struct {\n41\t    bool is_constraint;\n42\t    bool buffer_result;\n43\t    OperationType op;\n44\t    SourceInfo x;\n45\t    SourceInfo y;\n46\t    uint32_t z_index;\n47\t} DecodedRule;\n48\t\n49\t// Lightweight header: only op, flags, and x (always needed).\n50\t// Use this for lazy decoding to reduce register pressure.\n51\ttypedef struct {\n52\t    bool is_constraint;\n53\t    bool buffer_result;\n54\t    OperationType op;\n55\t    SourceInfo x;\n56\t} RuleHeader;\n57\t\n58\t__host__ __device__ __forceinline__ SourceInfo decode_source(uint64_t encoded);\n59\t__host__ __device__ __forceinline__ DecodedRule decode_rule(Rule encoded);\n60\t\n61\t// Lazy decoding functions - decode only what's needed\n62\t__host__ __device__ __forceinline__ RuleHeader decode_rule_header(Rule encoded);\n63\t__host__ __device__ __forceinline__ SourceInfo decode_y(Rule encoded);\n64\t__host__ __device__ __forceinline__ uint32_t decode_z_index(Rule encoded);\n65\t\n66\tstatic const uint64_t ENTRY_SRC_MASK = 0xF;\n67\tstatic const uint64_t ENTRY_PART_SHIFT = 4;\n68\tstatic const uint64_t ENTRY_PART_MASK = 0xFF;\n69\tstatic const uint64_t ENTRY_OFFSET_SHIFT = 12;\n70\tstatic const uint64_t ENTRY_OFFSET_MASK = 0xF;\n71\tstatic const uint64_t ENTRY_INDEX_SHIFT = 16;\n72\tstatic const uint64_t ENTRY_INDEX_MASK = 0xFFFFFFFF;\n73\tstatic const uint64_t SOURCE_INTERMEDIATE_SHIFT = 4;\n74\tstatic const uint64_t SOURCE_INTERMEDIATE_MASK = 0xFFFFF;\n75\tstatic const uint64_t SOURCE_CONSTANT_SHIFT = 16;\n76\tstatic const uint64_t SOURCE_CONSTANT_MASK = 0xFFFFFFFF;\n77\tstatic const uint64_t LOW_48_BITS_MASK = 0xFFFFFFFFFFFF;\n78\tstatic const int Y_HIGH_SHIFT = 16;\n79\tstatic const uint64_t Y_HIGH_MASK = 0xFFFFFFFF;\n80\tstatic const int Z_LOW_SHIFT = 32;\n81\tstatic const uint64_t Z_LOW_MASK = 0xFFFFFF;\n82\tstatic const uint64_t OP_MASK = 0x3F;\n83\tstatic const int OP_SHIFT = 56;\n84\tstatic const uint64_t BUFFER_RESULT_MASK = 0x4000000000000000;\n85\tstatic const uint64_t IS_CONSTRAINT_MASK = 0x8000000000000000;\n86\t\n87\tconst uint64_t one = 1;\n88\tstatic_assert(LOW_48_BITS_MASK == (one << 48) - 1, \"LOW_48_BITS_MASK must be (1 << 48) - 1\");\n89\tstatic_assert(Y_HIGH_MASK == (one << 32) - 1, \"Y_HIGH_MASK must be (1 << 32) - 1\");\n90\tstatic_assert(Z_LOW_MASK == (one << 24) - 1, \"Z_LOW_MASK must be (1 << 24) - 1\");\n91\tstatic_assert(OP_MASK == (one << 6) - 1, \"OP_MASK must be (1 << 6) - 1\");\n92\tstatic_assert(BUFFER_RESULT_MASK == one << 62, \"BUFFER_RESULT_MASK must be (1 << 62)\");\n93\tstatic_assert(IS_CONSTRAINT_MASK == one << 63, \"IS_CONSTRAINT_MASK must be (1 << 63)\");\n94\t\n95\t__host__ __device__ __forceinline__ SourceInfo decode_source(uint64_t encoded) {\n96\t    SourceInfo src;\n97\t    src.type = (EntryType)(encoded & ENTRY_SRC_MASK);\n98\t    src.part = (encoded >> ENTRY_PART_SHIFT) & ENTRY_PART_MASK;\n99\t    src.offset = (encoded >> ENTRY_OFFSET_SHIFT) & ENTRY_OFFSET_MASK;\n100\t    src.index = (encoded >> ENTRY_INDEX_SHIFT) & ENTRY_INDEX_MASK;\n101\t\n102\t    if (src.type == SRC_INTERMEDIATE) {\n103\t        src.part = 0;\n104\t        src.offset = 0;\n105\t        src.index = (encoded >> SOURCE_INTERMEDIATE_SHIFT) & SOURCE_INTERMEDIATE_MASK;\n106\t    } else if (src.type == SRC_CONSTANT) {\n107\t        src.index = (encoded >> SOURCE_CONSTANT_SHIFT) & SOURCE_CONSTANT_MASK;\n108\t    }\n109\t    return src;\n110\t}\n111\t\n112\t__host__ __device__ __forceinline__ DecodedRule decode_rule(Rule encoded) {\n113\t    DecodedRule rule;\n114\t\n115\t    uint64_t x_encoded = (encoded.low & LOW_48_BITS_MASK);\n116\t    rule.x = decode_source(x_encoded);\n117\t\n118\t    uint64_t y_encoded = ((encoded.low >> 48) | ((encoded.high & Y_HIGH_MASK) << Y_HIGH_SHIFT));\n119\t    rule.y = decode_source(y_encoded);\n120\t\n121\t    uint64_t z_encoded = (encoded.high >> Z_LOW_SHIFT) & Z_LOW_MASK;\n122\t    rule.z_index = (z_encoded >> SOURCE_INTERMEDIATE_SHIFT) & SOURCE_INTERMEDIATE_MASK;\n123\t\n124\t    rule.op = (OperationType)((encoded.high >> OP_SHIFT) & OP_MASK);\n125\t\n126\t    rule.buffer_result = (encoded.high & BUFFER_RESULT_MASK) != 0;\n127\t    rule.is_constraint = (encoded.high & IS_CONSTRAINT_MASK) != 0;\n128\t\n129\t    return rule;\n130\t}\n131\t\n132\t// Decode only header (op, flags, x) - for lazy decoding pattern\n133\t__host__ __device__ __forceinline__ RuleHeader decode_rule_header(Rule encoded) {\n134\t    RuleHeader header;\n135\t\n136\t    uint64_t x_encoded = (encoded.low & LOW_48_BITS_MASK);\n137\t    header.x = decode_source(x_encoded);\n138\t\n139\t    header.op = (OperationType)((encoded.high >> OP_SHIFT) & OP_MASK);\n140\t    header.buffer_result = (encoded.high & BUFFER_RESULT_MASK) != 0;\n141\t    header.is_constraint = (encoded.high & IS_CONSTRAINT_MASK) != 0;\n142\t\n143\t    return header;\n144\t}\n145\t\n146\t// Decode y operand on demand (only needed for binary ops: ADD, SUB, MUL)\n147\t__host__ __device__ __forceinline__ SourceInfo decode_y(Rule encoded) {\n148\t    uint64_t y_encoded = ((encoded.low >> 48) | ((encoded.high & Y_HIGH_MASK) << Y_HIGH_SHIFT));\n149\t    return decode_source(y_encoded);\n150\t}\n151\t\n152\t// Decode z_index on demand (only needed when buffer_result is true)\n153\t__host__ __device__ __forceinline__ uint32_t decode_z_index(Rule encoded) {\n154\t    uint64_t z_encoded = (encoded.high >> Z_LOW_SHIFT) & Z_LOW_MASK;\n155\t    return (z_encoded >> SOURCE_INTERMEDIATE_SHIFT) & SOURCE_INTERMEDIATE_MASK;\n156\t}\n157\t"}]},"parent_tool_use_id":"toolu_012z6xRskUmg2JG9ZwsEYam4","session_id":"d4314f39-e91d-47fe-87bd-a8908ed81e1e","uuid":"84c4a6a6-d91d-46a5-b7c9-31392c3cb9d8","timestamp":"2026-04-14T09:06:26.505Z"}
