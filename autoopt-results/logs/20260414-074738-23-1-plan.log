{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F7PDXGHDTmkqvjxfRchkLN","type":"tool_result","content":"391\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n392\t    transcript: &mut TS,\n393\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n394\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n395\t    save_memory: bool,\n396\t    monomial_num_y_threshold: u32,\n397\t    sm_count: u32,\n398\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n399\twhere\n400\t    HS: GpuHashScheme,\n401\t    TS: GpuFiatShamirTranscript<HS::SC>,\n402\t{\n403\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n404\t    let l_skip = mpk.params.l_skip;\n405\t    let constraint_degree = mpk.max_constraint_degree;\n406\t    let num_traces = ctx.per_trace.len();\n407\t\n408\t    // Traces are sorted\n409\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n410\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n411\t    // heights\n412\t    let mut total_interactions = 0u64;\n413\t    let interactions_meta: Vec<_> = ctx\n414\t        .per_trace\n415\t        .iter()\n416\t        .map(|(air_idx, air_ctx)| {\n417\t            let pk = &mpk.per_air[*air_idx];\n418\t\n419\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n420\t            let height = air_ctx.common_main.height();\n421\t            let log_height = log2_strict_usize(height);\n422\t            let log_lifted_height = log_height.max(l_skip);\n423\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n424\t            (num_interactions, log_lifted_height)\n425\t        })\n426\t        .collect();\n427\t    // Implicitly, the width of this stacking should be 1\n428\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n429\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n430\t    // GKR\n431\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n432\t\n433\t    // Grind to increase soundness of random sampling for LogUp\n434\t    let logup_pow_witness = transcript\n435\t        .grind_gpu(mpk.params.logup.pow_bits)\n436\t        .map_err(LogupZerocheckError::Grind)?;\n437\t    let alpha_logup = transcript.sample_ext();\n438\t    let beta_logup = transcript.sample_ext();\n439\t    debug!(%alpha_logup, %beta_logup);\n440\t\n441\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n442\t    let mut prover = LogupZerocheckGpu::new(\n443\t        mpk,\n444\t        ctx,\n445\t        n_logup,\n446\t        interactions_layout,\n447\t        alpha_logup,\n448\t        beta_logup,\n449\t        save_memory,\n450\t        monomial_num_y_threshold,\n451\t        sm_count,\n452\t    )?;\n453\t    let n_global = prover.n_global;\n454\t\n455\t    let total_leaves = 1 << (l_skip + n_logup);\n456\t    prover\n457\t        .mem\n458\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n459\t    prover.mem.reset_peak();\n460\t    let (inputs, alpha) = if has_interactions {\n461\t        log_gkr_input_evals(\n462\t            &prover.trace_interactions,\n463\t            mpk,\n464\t            ctx,\n465\t            l_skip,\n466\t            alpha_logup,\n467\t            &prover.d_challenges,\n468\t            total_leaves,\n469\t        )?\n470\t    } else {\n471\t        (DeviceBuffer::new(), EF::ZERO)\n472\t    };\n473\t    // Set memory limit for batch MLE based on inputs buffer size\n474\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n475\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n476\t    if !prover.save_memory {\n477\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n478\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n479\t            tracing::warn!(\n480\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n481\t                prover.memory_limit_bytes\n482\t            );\n483\t        }\n484\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n485\t    }\n486\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n487\t\n488\t    let (frac_sum_proof, mut xi) =\n489\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n490\t    while xi.len() != l_skip + n_global {\n491\t        xi.push(transcript.sample_ext());\n492\t    }\n493\t    debug!(?xi);\n494\t    prover.xi = xi;\n495\t\n496\t    logup_gkr_span.exit();\n497\t\n498\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does\n499\t    // not include the kernel times for the actual folding\n500\t    let round0_span = info_span!(\"prover.rap_constraints.round0\", phase = \"prover\").entered();\n501\t    // begin batch sumcheck\n502\t    let mut sumcheck_round_polys = Vec::with_capacity(n_max);\n503\t    let mut r = Vec::with_capacity(n_max + 1);\n504\t    // batching randomness\n505\t    let lambda = transcript.sample_ext();\n506\t    debug!(%lambda);\n507\t\n508\t    let sp_0_polys = prover.sumcheck_uni_round0_polys(ctx, lambda)?;\n509\t    let s_0_cpu_span = info_span!(\"s'_0 -> s_0 cpu interpolations\").entered();\n510\t    let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_degree);\n511\t    let s_deg = constraint_degree + 1;\n512\t    let s_0_deg = sumcheck_round0_deg(l_skip, s_deg);\n513\t    let large_uni_domain = (s_0_deg + 1).next_power_of_two();\n514\t    let dft = Radix2BowersSerial;\n515\t    let s_0_logup_polys = {\n516\t        let eq_sharp_uni = eq_sharp_uni_poly(&prover.xi[..l_skip]);\n517\t        let mut eq_coeffs = eq_sharp_uni.into_coeffs();\n518\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n519\t        let eq_evals = dft.dft(eq_coeffs);\n520\t\n521\t        let width = 2 * num_traces;\n522\t        let mut sp_coeffs_mat = EF::zero_vec(width * large_uni_domain);\n523\t        for (i, coeffs) in sp_0_polys[..2 * num_traces].iter().enumerate() {\n524\t            for (j, &c_j) in coeffs.coeffs().iter().enumerate().take(sp_0_deg + 1) {\n525\t                // SAFETY:\n526\t                // - coeffs length is <= sp_0_deg + 1 <= s_0_deg < large_uni_domain\n527\t                // - sp_coeffs_mat allocated for width\n528\t                unsafe {\n529\t                    *sp_coeffs_mat.get_unchecked_mut(j * width + i) = c_j;\n530\t                }\n531\t            }\n532\t        }\n533\t        let mut s_evals = dft.dft_batch(RowMajorMatrix::new(sp_coeffs_mat, width));\n534\t        for (eq, row) in zip(eq_evals, s_evals.values.chunks_mut(width)) {\n535\t            for x in row {\n536\t                *x *= eq;\n537\t            }\n538\t        }\n539\t        dft.idft_batch(s_evals)\n540\t    };\n541\t    let skip_domain_size = F::from_usize(1 << l_skip);\n542\t    // logup sum claims (sum_{\\hat p}, sum_{\\hat q}) per present AIR\n543\t    let (numerator_term_per_air, denominator_term_per_air): (Vec<_>, Vec<_>) = (0..num_traces)\n544\t        .map(|trace_idx| {\n545\t            let [sum_claim_p, sum_claim_q] = [0, 1].map(|is_denom| {\n546\t                // Compute sum over D of s_0(Z) to get the sum claim\n547\t                (0..=s_0_deg)\n548\t                    .step_by(1 << l_skip)\n549\t                    .map(|j| unsafe {\n550\t                        // SAFETY: matrix is 2 * num_trace x large_uni_domain, s_0_deg <\n551\t                        // large_uni_domain\n552\t                        *s_0_logup_polys\n553\t                            .values\n554\t                            .get_unchecked(j * 2 * num_traces + 2 * trace_idx + is_denom)\n555\t                    })\n556\t                    .sum::<EF>()\n557\t                    * skip_domain_size\n558\t            });\n559\t            transcript.observe_ext(sum_claim_p);\n560\t            transcript.observe_ext(sum_claim_q);\n561\t\n562\t            (sum_claim_p, sum_claim_q)\n563\t        })\n564\t        .unzip();\n565\t\n566\t    let mu = transcript.sample_ext();\n567\t    debug!(%mu);\n568\t    let mu_pows = mu.powers().take(3 * num_traces).collect_vec();\n569\t\n570\t    let s_0_zc_poly = {\n571\t        let eq_uni = eq_uni_poly::<F, _>(l_skip, prover.xi[0]);\n572\t        let mut eq_coeffs = eq_uni.into_coeffs();\n573\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n574\t        let eq_evals = dft.dft(eq_coeffs);\n575\t\n576\t        // Algebraically batch\n577\t        let mut sp_coeffs = EF::zero_vec(large_uni_domain);\n578\t        let mus = &mu_pows[2 * num_traces..];\n579\t        let polys = &sp_0_polys[2 * num_traces..];\n580\t        for (j, batch_coeff) in sp_coeffs.iter_mut().enumerate().take(sp_0_deg + 1) {\n581\t            for (&mu, poly) in zip(mus, polys) {\n582\t                *batch_coeff += mu * *poly.coeffs().get(j).unwrap_or(&EF::ZERO);\n583\t            }\n584\t        }\n585\t        let mut s_evals = dft.dft(sp_coeffs);\n586\t        for (eq, x) in zip(eq_evals, &mut s_evals) {\n587\t            *x *= eq;\n588\t        }\n589\t        dft.idft(s_evals)\n590\t    };\n591\t\n592\t    // Algebraically batch\n593\t    let s_0_poly = UnivariatePoly::new(\n594\t        zip(\n595\t            s_0_logup_polys.values.chunks_exact(2 * num_traces),\n596\t            s_0_zc_poly,\n597\t        )\n598\t        .take(s_0_deg + 1)\n599\t        .map(|(logup_row, batched_zc)| {\n600\t            let coeff = batched_zc\n601\t                + zip(&mu_pows, logup_row)\n602\t                    .map(|(&mu_j, &x)| mu_j * x)\n603\t                    .sum::<EF>();\n604\t            transcript.observe_ext(coeff);\n605\t            coeff\n606\t        })\n607\t        .collect(),\n608\t    );\n609\t    drop(s_0_cpu_span);\n610\t\n611\t    let r_0 = transcript.sample_ext();\n612\t    r.push(r_0);\n613\t    debug!(round = 0, r_round = %r_0);\n614\t    prover.prev_s_eval = s_0_poly.eval_at_point(r_0);\n615\t    debug!(\"s_0(r_0) = {}\", prover.prev_s_eval);\n616\t\n617\t    prover.fold_ple_evals(ctx, r_0)?;\n618\t    drop(round0_span);\n619\t\n620\t    // Sumcheck rounds:\n621\t    // - each round the prover needs to compute univariate polynomial `s_round`. This poly is linear\n622\t    //   since we are taking MLE of `evals`.\n623\t    // - at end of each round, sample random `r_round` in `EF`\n624\t    //\n625\t    // `s_round` is degree `s_deg` so we evaluate it at `0, ..., =s_deg`. The prover skips\n626\t    // evaluation at `0` because the verifier can infer it from the previous round's\n627\t    // `s_{round-1}(r)` claim. The degree is constraint_degree + 1, where + 1 is from eq term\n628\t    let mle_rounds_span =\n629\t        info_span!(\"prover.rap_constraints.mle_rounds\", phase = \"prover\").entered();\n630\t    debug!(%s_deg);\n631\t    for round in 1..=n_max {\n632\t        let sp_round_evals = prover.sumcheck_polys_batch_eval(round, r[round - 1])?;\n633\t        let batch_s = prover.compute_batch_s_poly(sp_round_evals, num_traces, round, &mu_pows);\n634\t        let batch_s_evals = (1..=s_deg)\n635\t            .map(|i| batch_s.eval_at_point(EF::from_usize(i)))\n636\t            .collect_vec();\n637\t        for &eval in &batch_s_evals {\n638\t            transcript.observe_ext(eval);\n639\t        }\n640\t        sumcheck_round_polys.push(batch_s_evals);\n641\t\n642\t        let r_round = transcript.sample_ext();\n643\t        debug!(%round, %r_round);\n644\t        r.push(r_round);\n645\t        prover.prev_s_eval = batch_s.eval_at_point(r_round);\n646\t\n647\t        prover.fold_mle_evals(round, r_round)?;\n648\t    }\n649\t    assert_eq!(r.len(), n_max + 1);\n650\t\n651\t    let column_openings = prover.into_column_openings()?;\n652\t\n653\t    let need_rot_per_trace = ctx\n654\t        .per_trace\n655\t        .iter()\n656\t        .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n657\t        .collect::<Vec<_>>();\n658\t    // Observe common main openings first, and then preprocessed/cached\n659\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n660\t        for (claim, claim_rot) in column_openings_by_rot(&openings[0], *need_rot) {\n661\t            transcript.observe_ext(claim);\n662\t            transcript.observe_ext(claim_rot);\n663\t        }\n664\t    }\n665\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n666\t        for part in openings.iter().skip(1) {\n667\t            for (claim, claim_rot) in column_openings_by_rot(part, *need_rot) {\n668\t                transcript.observe_ext(claim);\n669\t                transcript.observe_ext(claim_rot);\n670\t            }\n671\t        }\n672\t    }\n673\t    drop(mle_rounds_span);\n674\t\n675\t    let batch_constraint_proof = BatchConstraintProof {\n676\t        numerator_term_per_air,\n677\t        denominator_term_per_air,\n678\t        univariate_round_coeffs: s_0_poly.into_coeffs(),\n679\t        sumcheck_round_polys,\n680\t        column_openings,\n681\t    };\n682\t    let gkr_proof = GkrProof {\n683\t        logup_pow_witness,\n684\t        q0_claim: frac_sum_proof.fractional_sum.1,\n685\t        claims_per_layer: frac_sum_proof.claims_per_layer,\n686\t        sumcheck_polys: frac_sum_proof.sumcheck_polys,\n687\t    };\n688\t    Ok((gkr_proof, batch_constraint_proof, r))\n689\t}\n690\t\n691\tpub struct LogupZerocheckGpu<'a, HS: GpuHashScheme> {\n692\t    pub alpha_logup: EF,\n693\t    pub beta_pows: Vec<EF>,\n694\t    // [alpha, beta^0, beta^1, .., beta^max_interaction_len]\n695\t    pub d_challenges: DeviceBuffer<EF>,\n696\t\n697\t    pub l_skip: usize,\n698\t    n_logup: usize,\n699\t    n_global: usize,\n700\t\n701\t    pub omega_skip: F,\n702\t    pub omega_skip_pows: Vec<F>,\n703\t    d_omega_skip_pows: DeviceBuffer<F>,\n704\t\n705\t    pub interactions_layout: StackedLayout,\n706\t    pub constraint_degree: usize,\n707\t    n_per_trace: Vec<isize>,\n708\t    max_num_constraints: usize,\n709\t    pub monomial_num_y_threshold: u32,\n710\t    sm_count: u32,\n711\t    // Available after GKR:\n712\t    pub xi: Vec<EF>,\n713\t    pub lambda_pows: Option<DeviceBuffer<EF>>,\n714\t    /// Precomputed lambda combinations per AIR (indexed by air_idx). Set when lambda is sampled.\n715\t    lambda_combinations: Vec<Option<DeviceBuffer<EF>>>,\n716\t    /// Beta powers on device for logup MLE rounds.\n717\t    d_beta_pows: DeviceBuffer<EF>,\n718\t    /// Precomputed logup combinations per trace (indexed by trace_idx). Set when xi is sampled.\n719\t    logup_combinations: Vec<Option<LogupCombinations>>,\n720\t\n721\t    // n_T => segment tree of eq(xi[j..1+n_T]) for j=1..={n_T-round+1} in _reverse_ layout\n722\t    eq_xis: FxHashMap<usize, EqEvalLayers<EF>>,\n723\t    eq_3b_per_trace: Vec<Vec<EF>>,\n724\t    d_eq_3b_per_trace: Vec<DeviceBuffer<EF>>,\n725\t    // Evaluations on hypercube only, for round 0\n726\t    sels_per_trace_base: Vec<DeviceMatrix<F>>,\n727\t    // After univariate round 0:\n728\t    mat_evals_per_trace: Vec<Vec<DeviceMatrix<EF>>>,\n729\t    sels_per_trace: Vec<DeviceMatrix<EF>>,\n730\t    // Store public_values per trace (similar to CPU's EvalHelper)\n731\t    public_values_per_trace: Vec<DeviceBuffer<F>>,\n732\t    air_indices_per_trace: Vec<usize>,\n733\t    zerocheck_tilde_evals: Vec<EF>,\n734\t    logup_tilde_evals: Vec<[EF; 2]>,\n735\t    needs_next_per_trace: Vec<bool>,\n736\t\n737\t    trace_interactions: Vec<Option<TraceInteractionMeta>>,\n738\t    // round0: Round0Buffers,\n739\t    pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n740\t\n741\t    // In round `j`, contains `s_{j-1}(r_{j-1})`\n742\t    pub(crate) prev_s_eval: EF,\n743\t    pub(crate) eq_ns: Vec<EF>,\n744\t    pub(crate) eq_sharp_ns: Vec<EF>,\n745\t\n746\t    mem: MemTracker,\n747\t    save_memory: bool,\n748\t\n749\t    gkr_mem_contribution: usize,\n750\t    /// Memory limit for batch MLE intermediate buffers (set after GKR input eval)\n751\t    memory_limit_bytes: usize,\n752\t}\n753\t\n754\timpl<'a, HS: GpuHashScheme> LogupZerocheckGpu<'a, HS> {\n755\t    #[allow(clippy::too_many_arguments)]\n756\t    fn new(\n757\t        pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n758\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n759\t        n_logup: usize,\n760\t        interactions_layout: StackedLayout,\n761\t        alpha_logup: EF,\n762\t        beta_logup: EF,\n763\t        save_memory: bool,\n764\t        monomial_num_y_threshold: u32,\n765\t        sm_count: u32,\n766\t    ) -> Result<Self, LogupZerocheckError> {\n767\t        let mem = MemTracker::start(\"prover.logup_zerocheck_prover\");\n768\t        let l_skip = pk.params.l_skip;\n769\t        let omega_skip = F::two_adic_generator(l_skip);\n770\t        let omega_skip_pows = omega_skip.powers().take(1 << l_skip).collect_vec();\n771\t        let d_omega_skip_pows = omega_skip_pows.to_device()?;\n772\t        let num_airs_present = ctx.per_trace.len();\n773\t\n774\t        let constraint_degree = pk.max_constraint_degree;\n775\t\n776\t        let max_interaction_length = pk\n777\t            .per_air\n778\t            .iter()\n779\t            .map(|air_pk| air_pk.other_data.interaction_rules.max_fields_len)\n780\t            .max()\n781\t            .unwrap_or(0);\n782\t        let beta_pows = beta_logup\n783\t            .powers()\n784\t            .take(max_interaction_length + 1)\n785\t            .collect_vec();\n786\t        let challenges = [&[alpha_logup], &beta_pows[..]].concat();\n787\t        let d_challenges = challenges.to_device()?;\n788\t        let d_beta_pows = beta_pows.to_device()?;\n789\t\n790\t        let n_per_trace: Vec<isize> = ctx\n791\t            .common_main_traces()\n792\t            .map(|(_, t)| log2_strict_usize(t.height()) as isize - l_skip as isize)\n793\t            .collect();\n794\t        let n_max = n_per_trace[0].max(0) as usize;\n795\t        let n_global = max(n_max, n_logup);\n796\t        info!(%n_global, %n_logup);\n797\t\n798\t        let max_num_constraints = pk\n799\t            .per_air\n800\t            .iter()\n801\t            .map(|air_pk| {\n802\t                air_pk\n803\t                    .vk\n804\t                    .symbolic_constraints\n805\t                    .constraints\n806\t                    .constraint_idx\n807\t                    .len()\n808\t            })\n809\t            .max()\n810\t            .unwrap_or(0);\n811\t\n812\t        // Collect interaction metadata for GPU execution (evaluations still run on CPU for now).\n813\t        let trace_interactions = collect_trace_interactions(pk, ctx, &interactions_layout);\n814\t\n815\t        let needs_next_per_trace = ctx\n816\t            .per_trace\n817\t            .iter()\n818\t            .map(|(air_idx, _)| pk.per_air[*air_idx].vk.params.need_rot)\n819\t            .collect::<Vec<_>>();\n820\t\n821\t        Ok(Self {\n822\t            alpha_logup,\n823\t            beta_pows,\n824\t            d_challenges,\n825\t            l_skip,\n826\t            n_logup,\n827\t            n_global,\n828\t            omega_skip,\n829\t            omega_skip_pows,\n830\t            d_omega_skip_pows,\n831\t            interactions_layout,\n832\t            constraint_degree,\n833\t            n_per_trace,\n834\t            max_num_constraints,\n835\t            sm_count,\n836\t            xi: vec![],\n837\t            lambda_pows: None,\n838\t            lambda_combinations: (0..pk.per_air.len()).map(|_| None).collect(),\n839\t            d_beta_pows,\n840\t            logup_combinations: (0..num_airs_present).map(|_| None).collect(),\n841\t            eq_xis: FxHashMap::default(),\n842\t            eq_3b_per_trace: vec![],\n843\t            d_eq_3b_per_trace: vec![],\n844\t            sels_per_trace_base: vec![],\n845\t            mat_evals_per_trace: vec![],\n846\t            sels_per_trace: vec![],\n847\t            public_values_per_trace: ctx\n848\t                .per_trace\n849\t                .iter()\n850\t                .map(|(_, air_ctx)| {\n851\t                    if air_ctx.public_values.is_empty() {\n852\t                        Ok(DeviceBuffer::new())\n853\t                    } else {\n854\t                        air_ctx.public_values.to_device()\n855\t                    }\n856\t                })\n857\t                .collect::<Result<Vec<_>, _>>()?,\n858\t            air_indices_per_trace: ctx\n859\t                .per_trace\n860\t                .iter()\n861\t                .map(|(air_idx, _)| *air_idx)\n862\t                .collect_vec(),\n863\t            zerocheck_tilde_evals: vec![EF::ZERO; num_airs_present],\n864\t            logup_tilde_evals: vec![[EF::ZERO; 2]; num_airs_present],\n865\t            needs_next_per_trace,\n866\t            trace_interactions,\n867\t            pk,\n868\t            prev_s_eval: EF::ZERO,\n869\t            eq_ns: Vec::with_capacity(n_max + 1),\n870\t            eq_sharp_ns: Vec::with_capacity(n_max + 1),\n871\t            mem,\n872\t            save_memory,\n873\t            gkr_mem_contribution: 0,\n874\t            memory_limit_bytes: 0, // Set after GKR input eval\n875\t            monomial_num_y_threshold,\n876\t        })\n877\t    }\n878\t\n879\t    // PERF[jpw]: we could return evals and batch zerocheck poly by degree before interpolating.\n880\t    // Cannot do it for logup because we need to calculate the sum claims.\n881\t    #[instrument(name = \"prover.rap_constraints.ple_round0\", level = \"info\", skip_all)]\n882\t    fn sumcheck_uni_round0_polys(\n883\t        &mut self,\n884\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n885\t        lambda: EF,\n886\t    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n887\t        self.mem\n888\t            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n889\t        self.mem.reset_peak();\n890\t        let n_logup = self.n_logup;"}]},"parent_tool_use_id":"toolu_01KnvCQXX57zD2c2S7ZT7TQj","session_id":"d4314f39-e91d-47fe-87bd-a8908ed81e1e","uuid":"23351578-593c-4a04-afa9-182cfa516741","timestamp":"2026-04-14T05:51:14.738Z"}
