ert(\n372\t            eq_buffer,\n373\t            layer,\n374\t            pq_size / 2,\n375\t            lambda,\n376\t            d_sum_evals,\n377\t            tmp_block_sums,\n378\t        )\n379\t        .map_err(FractionalSumcheckError::ComputeRound)?;\n380\t    }\n381\t    eq_buffer.drop_layer();\n382\t    observe_and_update(\n383\t        d_sum_evals,\n384\t        transcript,\n385\t        round_polys_eval,\n386\t        r_vec,\n387\t        prev_s_eval,\n388\t        xi_j,\n389\t        eq_r_acc,\n390\t    )\n391\t}\n392\t\n393\t/// Fused compute round: computes s' polynomial AND folds the pq_buffer for next round.\n394\t///\n395\t/// This kernel fuses the fold operation (using `r_prev` from the previous round) into the current\n396\t/// round's compute, eliminating one kernel launch and reducing memory traffic.\n397\t#[allow(clippy::too_many_arguments)]"}]},"parent_tool_use_id":"toolu_01PQNC9m7tCBbo3HCMTn8R8c","session_id":"d4314f39-e91d-47fe-87bd-a8908ed81e1e","uuid":"6279991e-edc8-4b03-b376-3c66f14c2407","timestamp":"2026-04-14T05:51:13.763Z"}
