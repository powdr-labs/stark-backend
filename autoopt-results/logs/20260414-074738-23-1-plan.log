ent(\n57\t    name = \"prover.openings.whir\",\n58\t    level = \"info\",\n59\t    skip_all,\n60\t    fields(phase = \"prover\")\n61\t)]\n62\tpub fn prove_whir_opening_gpu<HS, TS>(\n63\t    params: &SystemParams,\n64\t    transcript: &mut TS,\n65\t    mut stacked_per_commit: Vec<StackedPcsData2<HS::Digest>>,\n66\t    u: &[EF],\n67\t) -> Result<WhirProof<HS::SC>, WhirProverError>\n68\twhere\n69\t    HS: GpuHashScheme,\n70\t    TS: GpuFiatShamirTranscript<HS::SC>,\n71\t    HS::MerkleHash: MerkleTreeConstructor,\n72\t    HS::Digest: MerkleProofQueryDigest,\n73\t{\n74\t    let mem = MemTracker::start(\"prover.prove_whir_opening\");\n75\t    let l_skip = params.l_skip;\n76\t    let log_blowup = params.log_blowup;\n77\t    let k_whir = params.k_whir();\n78\t    let whir_params = params.whir();\n79\t    let log_final_poly_len = params.log_final_poly_len();\n80\t\n81\t    let height = stacked_per_commit[0].layout().height();\n82\t    debug_assert!(stacked_per_commit\n83\t        .iter()\n84\t        .all(|d| d.layout().height() == height));\n85\t    let mut m = log2_strict_usize(height);\n86\t    assert_eq!(m, u.len());\n87\t    debug_assert!(m >= l_skip);\n88\t\n89\t    // Proof-of-work grinding before μ batching challenge.\n90\t    // This amplifies soundness of the initial batching step.\n91\t    let mu_pow_witness = transcript\n92\t        .grind_gpu(whir_params.mu_pow_bits)\n93\t        .map_err(WhirProverError::MuGrind)?;\n94\t    // Sample randomness for algebraic batching.\n95\t    // We batch the codewords for \\hat{q}_j together _before_ applying WHIR.\n96\t    let mu = transcript.sample_ext();\n97\t    let num_commits = stacked_per_commit.len();\n98\t\n99\t    // The coefficient table of `\\hat{f}` in the current WHIR round (MLE coefficient form).\n100\t    let mut f_ple_evals = DeviceBuffer::<F>::with_capacity(height * D_EF);\n101\t    // We algebraically batch all matrices together so we only need to interpolate one column vector\n102\t    {\n103\t        let mut packets = Vec::new();\n104\t        let mut total_stacked_width = 0u32;\n105\t        for stacked in &stacked_per_commit {\n106\t            let layout = stacked.layout();\n107\t            for (trace, &idx) in zip(&stacked.traces, &layout.mat_starts) {\n108\t                let (_, _, s) = layout.sorted_cols[idx];\n109\t                let packet = BatchingTracePacket {\n110\t                    ptr: trace.buffer().as_ptr(),\n111\t                    height: trace.height() as u32,\n112\t                    width: trace.width() as u32,\n113\t                    stacked_row_start: s.row_idx as u32,\n114\t                    mu_idx: total_stacked_width + s.col_idx as u32,\n115\t                };\n116\t                packets.push(packet);\n117\t            }\n118\t            total_stacked_width += layout.width() as u32;\n119\t        }\n120\t        let mu_powers = mu.powers().take(total_stacked_width as usize).collect_vec();\n121\t        let d_mu_powers = mu_powers.to_device()?;\n122\t        let d_packets = packets.to_device()?;\n123\t        // SAFETY:\n124\t        // - `mu_powers` has length `total_width`.\n125\t        // - `f_ple_evals` has capacity `height * D_EF` (stacked height in base coordinates).\n126\t        // - `d_packets` contain valid pointers and stacked row indices by construction.\n127\t        unsafe {\n128\t            whir_algebraic_batch_traces(&mut f_ple_evals, &d_packets, &d_mu_powers, 1 << l_skip)\n129\t                .map_err(WhirProverError::AlgebraicBatch)?;\n130\t        }\n131\t        for stacked in &mut stacked_per_commit {\n132\t            // drop traces to free device memory if RS codewords matrix exists\n133\t            if stacked.inner.tree.backing_matrix.is_some() {\n134\t                stacked.traces.clear();\n135\t            }\n136\t        }\n137\t    } // common_main_pcs_data.matrix has now been freed\n138\t\n139\t    // Compute \\hat{f} coefficients:\n140\t    //\n141\t    // Step 1: iDFT per chunk of size 2^l_skip. After this, each chunk holds univariate\n142\t    // coefficients c_z(x) of f(Z, x) for a fixed boolean assignment x in H_{m - l_skip}.\n143\t    unsafe {\n144\t        let num_poly = f_ple_evals.len() >> l_skip;\n145\t        batch_ntt_small(&mut f_ple_evals, l_skip, num_poly, true)\n146\t            .map_err(WhirProverError::CustomBatchIntt)?;\n147\t    }\n148\t    let mut f_coeffs = DeviceBuffer::<EF>::with_capacity(height);\n149\t    // SAFETY: `f_ple_evals` is constructed with length `height * D_EF`.\n150\t    unsafe {\n151\t        transpose_fp_to_fpext_vec(&mut f_coeffs, &f_ple_evals)\n152\t            .map_err(WhirProverError::Transpose)?;\n153\t    }\n154\t    drop(f_ple_evals);\n155\t    // Step 2: Within-chunk zeta (stages 0..l_skip). Applies the subset-zeta transform\n156\t    // over the Z-index bits, converting univariate coefficients (root-of-unity basis)\n157\t    // into hypercube evaluations over H_{l_skip}. Together with step 1, this computes\n158\t    // eval_to_coeff_rs_message, i.e. the MLE coefficient table of \\hat{f}.\n159\t    for i in 0..l_skip {\n160\t        let step = 1u32 << i;\n161\t        // SAFETY: `f_coeffs` has length `2^m` with `m >= l_skip`.\n162\t        unsafe {\n163\t            mle_interpolate_stage_ext(&mut f_coeffs, step, false)\n164\t                .map_err(|error| WhirProverError::MleInterpolate { error, step })?;\n165\t        }\n166\t    }\n167\t\n168\t    debug_assert_eq!((m - log_final_poly_len) % k_whir, 0);\n169\t    let num_whir_rounds = (m - log_final_poly_len) / k_whir;\n170\t    assert!(num_whir_rounds > 0);\n171\t\n172\t    // We maintain moments of \\hat{w}:\n173\t    // M[T] = sum_{x superset T} \\hat{w}(x).\n174\t    // For initial \\hat{w} = mobius_eq(u, -), these moments are exactly eq(u, -).\n175\t    let mut w_moments = DeviceBuffer::<EF>::with_capacity(1 << m);\n176\t    unsafe {\n177\t        evals_eq_hypercube(&mut w_moments, u).map_err(WhirProverError::EvalEq)?;\n178\t    }\n179\t\n180\t    let mut whir_sumcheck_polys: Vec<[EF; 2]> = vec![];\n181\t    let mut codeword_commits = vec![];\n182\t    let mut ood_values = vec![];\n183\t    // per commitment, per whir query, per column\n184\t    let mut initial_round_opened_rows: Vec<Vec<Vec<Vec<F>>>> = vec![vec![]; num_commits];\n185\t    let mut initial_round_merkle_proofs: Vec<Vec<MerkleProof<HS::Digest>>> = vec![];\n186\t    let mut codeword_opened_values: Vec<Vec<Vec<EF>>> = vec![];\n187\t    let mut codeword_merkle_proofs: Vec<Vec<MerkleProof<HS::Digest>>> = vec![];\n188\t    let mut folding_pow_witnesses = vec![];\n189\t    let mut query_phase_pow_witnesses = vec![];\n190\t    let mut rs_tree = None;\n191\t    let mut log_rs_domain_size = m + log_blowup;\n192\t    let mut final_poly = None;\n193\t\n194\t    let mut d_s_evals = DeviceBuffer::<EF>::with_capacity(2);\n195\t    let mut d_sumcheck_tmp = DeviceBuffer::<EF>::new();\n196\t\n197\t    mem.tracing_info(\"before_whir_rounds\");\n198\t    // We will drop `stacked_per_commit` and hence `common_main_pcs_data` after whir round 0.\n199\t    for (whir_round, round_params) in whir_params.rounds.iter().enumerate() {\n200\t        let is_last_round = whir_round == num_whir_rounds - 1;"}]},"parent_tool_use_id":"toolu_01KnvCQXX57zD2c2S7ZT7TQj","session_id":"d4314f39-e91d-47fe-87bd-a8908ed81e1e","uuid":"6f2e8b3e-2a2a-41c1-89be-afb1eb3267ce","timestamp":"2026-04-14T05:51:16.835Z"}
