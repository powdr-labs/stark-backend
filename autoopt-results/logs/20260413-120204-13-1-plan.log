(\n506\t    traces: &[TraceCtx],\n507\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n508\t    d_challenges_ptr: *const EF,\n509\t    num_x: u32,\n510\t    monomial_num_y_threshold: u32,\n511\t    logup_combinations: &[Option<LogupCombinations>],\n512\t    logup_out: &mut [[Vec<EF>; 2]],\n513\t    logup_tilde_evals: &mut [[EF; 2]],\n514\t    memory_limit_bytes: usize,\n515\t) -> Result<(), KernelError> {\n516\t    let (low_traces, high_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) = traces\n517\t        .iter()\n518\t        .filter(|t| t.has_interactions)\n519\t        .partition(|t| t.num_y <= monomial_num_y_threshold);\n520\t\n521\t    if !low_traces.is_empty() {\n522\t        let logup_combs: Vec<_> = low_traces\n523\t            .iter()\n524\t            .map(|t| logup_combinations[t.trace_idx].as_ref().unwrap())\n525\t            .collect();\n526\t        let batch = LogupMonomialBatch::new(low_traces.iter().copied(), pk, &logup_combs)?;\n527\t        let out = batch.evaluate(num_x)?;\n528\t        let host = out.to_host()?;\n529\t        let num_x_usize = num_x as usize;\n530\t        for (i, trace_idx) in batch.trace_indices().enumerate() {\n531\t            let fracs = &host[(i * num_x_usize)..((i + 1) * num_x_usize)];\n532\t            let norm = low_traces[i].norm_factor;\n533\t            if num_x == 1 {\n534\t                logup_tilde_evals[trace_idx][0] = fracs[0].p * norm;\n535\t                logup_tilde_evals[trace_idx][1] = fracs[0].q;\n536\t            } else {\n537\t                for (j, frac) in fracs.iter().enumerate() {\n538\t                    logup_out[trace_idx][0][j] = frac.p * norm;\n539\t                    logup_out[trace_idx][1][j] = frac.q;\n540\t                }\n541\t            }\n542\t        }\n543\t    }\n544\t\n545\t    if high_traces.is_empty() {\n546\t        return Ok(());\n547\t    }\n548\t\n549\t    // Collect high traces with interactions and their buffer sizes\n550\t    let mut logup_traces_with_size: Ve