{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016GwZ4WdeWDQz7AyqQEFgPk","type":"tool_result","content":"1\t#pragma once\n2\t\n3\t#include \"fp.h\"\n4\t#include \"fpext.h\"\n5\t#include \"launcher.cuh\"\n6\t#include <cstdint>\n7\t#include <device_atomic_functions.h>\n8\t\n9\tnamespace sumcheck {\n10\t\n11\ttemplate <typename Field>\n12\t__device__ __forceinline__ Field\n13\tmle_interpolate_single(const Field *__restrict__ column, Fp x, uint32_t y_int) {\n14\t    auto t0 = column[y_int << 1];\n15\t    auto t1 = column[(y_int << 1) | 1];\n16\t    return t0 + (t1 - t0) * x;\n17\t}\n18\t\n19\t// Warp-level reduction: sums FpExt values across threads in a warp (32 threads)\n20\t// Uses shuffle instructions for efficient communication within a warp\n21\tstatic __device__ inline FpExt warp_reduce_sum(FpExt val) {\n22\t    unsigned mask = __activemask();\n23\t\n24\t#pragma unroll\n25\t    for (int offset = 16; offset > 0; offset /= 2) {\n26\t        FpExt other;\n27\t        other.elems[0] = Fp::fromRaw(__shfl_down_sync(mask, val.elems[0].asRaw(), offset));\n28\t        other.elems[1] = Fp::fromRaw(__shfl_down_sync(mask, val.elems[1].asRaw(), offset));\n29\t        other.elems[2] = Fp::fromRaw(__shfl_down_sync(mask, val.elems[2].asRaw(), offset));\n30\t        other.elems[3] = Fp::fromRaw(__shfl_down_sync(mask, val.elems[3].asRaw(), offset));\n31\t        val = val + other;\n32\t    }\n33\t    return val;\n34\t}\n35\t\n36\t// Reduce FpExt across n threads using warp shuffles (butterfly pattern)\n37\t// n must be a power of 2, 1 <= n <= 32\n38\t// All participating threads must call this function\n39\t__device__ __forceinline__ FpExt warp_reduce_sum_n(FpExt val, uint32_t n) {\n40\t    for (uint32_t offset = n >> 1; offset > 0; offset >>= 1) {\n41\t        FpExt other;\n42\t#pragma unroll\n43\t        for (int i = 0; i < 4; i++) {\n44\t            other.elems[i] =\n45\t                Fp::fromRaw(__shfl_xor_sync(0xffffffff, val.elems[i].asRaw(), offset));\n46\t        }\n47\t        val = val + other;\n48\t    }\n49\t    return val;\n50\t}\n51\t\n52\t// Reduce FpExt across chunk_size threads within a block\n53\t// chunk_size must be a power of 2\n54\t// tid_in_chunk: thread's index within its chunk [0, chunk_size)\n55\t// chunk_in_block: which chunk this thread belongs to\n56\t// smem: shared memory for cross-warp reduction (size >= total_warps_in_block)\n57\t//\n58\t// Note: When chunk_size > 32, writes to chunk_smem[warp_in_chunk] from different chunks\n59\t// may hit the same bank (FpExt = 16 bytes = 4 words). This is a minor inefficiency in the\n60\t// reduction phase, not a correctness issue.\n61\t__device__ inline FpExt chunk_reduce_sum(\n62\t    FpExt val,\n63\t    FpExt *smem,\n64\t    uint32_t tid_in_chunk,\n65\t    uint32_t chunk_size,\n66\t    uint32_t chunk_in_block\n67\t) {\n68\t    if (chunk_size <= 32) {\n69\t        return warp_reduce_sum_n(val, chunk_size);\n70\t    }\n71\t\n72\t    // Cross-warp case (chunk_size > 32)\n73\t    uint32_t warps_per_chunk = chunk_size >> 5;\n74\t    uint32_t warp_in_chunk = tid_in_chunk >> 5;\n75\t    uint32_t lane_id = tid_in_chunk & 31;\n76\t\n77\t    // Step 1: Warp-level reduction\n78\t    val = warp_reduce_sum(val);\n79\t\n80\t    // Step 2: Store warp result to shared memory\n81\t    FpExt *chunk_smem = smem + chunk_in_block * warps_per_chunk;\n82\t    if (lane_id == 0) {\n83\t        chunk_smem[warp_in_chunk] = val;\n84\t    }\n85\t    __syncthreads();\n86\t\n87\t    // Step 3: First warp of chunk reads and reduces warp results\n88\t    if (warp_in_chunk == 0) {\n89\t        FpExt zero = {0, 0, 0, 0};\n90\t        FpExt warp_val = (lane_id < warps_per_chunk) ? chunk_smem[lane_id] : zero;\n91\t        val = warp_reduce_sum(warp_val);\n92\t    }\n93\t\n94\t    return val;\n95\t}\n96\t\n97\t// ============================================================================\n98\t// ATOMIC U64 ACCUMULATION (delayed modular reduction to CPU)\n99\t// ============================================================================\n100\t//\n101\t// BabyBear elements in Montgomery form are < 2^31. Summing N elements in uint64_t\n102\t// overflows when N * 2^31 > 2^64, i.e., N > 2^33. Safe for typical GPU workloads.\n103\t// Final modular reduction is done on CPU after kernel completion.\n104\t\n105\t// Atomically add Fp raw value to uint64_t accumulator\n106\t__device__ __forceinline__ void atomic_add_fp_to_u64(uint64_t *output, Fp val) {\n107\t    atomicAdd((unsigned long long *)output, static_cast<uint64_t>(val.asRaw()));\n108\t}\n109\t\n110\t// Atomically add FpExt to uint64_t[4] accumulator\n111\t// Layout: output[0..3] correspond to elems[0..3]\n112\t__device__ __forceinline__ void atomic_add_fpext_to_u64(uint64_t *output, FpExt val) {\n113\t#pragma unroll\n114\t    for (int i = 0; i < 4; ++i) {\n115\t        atomic_add_fp_to_u64(output + i, val.elems[i]);\n116\t    }\n117\t}\n118\t\n119\t// ============================================================================\n120\t// WARP-AGGREGATED ATOMIC REDUCTION\n121\t// ============================================================================\n122\t//\n123\t// Modern best practice for block-wide sums on Volta+ architectures:\n124\t// 1. Warp-level reduction via __shfl_down_sync (zero memory latency)\n125\t// 2. Lane 0 of each warp does one atomicAdd to global memory\n126\t// 3. No __syncthreads() or shared memory required\n127\t//\n128\t// Trade-off: More atomics than full block reduction (num_warps vs 1), but\n129\t// eliminates barrier latency and shared memory bank conflicts. Modern L2\n130\t// caches handle concurrent atomics efficiently.\n131\t\n132\t// Warp-aggregated atomic: reduce within warp, lane 0 does single atomic add\n133\t__device__ __forceinline__ void warp_aggregated_atomic_add_fpext(\n134\t    uint64_t *output, // Global memory, uint64_t[4] for one FpExt\n135\t    FpExt val\n136\t) {\n137\t    // Step 1: Warp-level reduction via shuffles\n138\t    val = warp_reduce_sum(val);\n139\t\n140\t    // Step 2: Lane 0 does the atomic add\n141\t    int lane_id = threadIdx.x % WARP_SIZE;\n142\t    if (lane_id == 0) {\n143\t        atomic_add_fpext_to_u64(output, val);\n144\t    }\n145\t}\n146\t\n147\t// Indexed version for arrays of FpExt outputs\n148\t// Layout: output[idx * 4 .. idx * 4 + 3]\n149\t__device__ __forceinline__ void warp_aggregated_atomic_add_fpext_indexed(\n150\t    uint64_t *output, // Global memory, uint64_t[d * 4]\n151\t    uint32_t idx,\n152\t    FpExt val\n153\t) {\n154\t    warp_aggregated_atomic_add_fpext(output + idx * 4, val);\n155\t}\n156\t\n157\t// Block-level reduction: sums FpExt values across all threads in a block\n158\t// Two-stage process: warp-level reduction, then inter-warp reduction\n159\t// Returns result in all threads of first warp (typically only thread 0 uses it)\n160\tstatic __device__ inline FpExt block_reduce_sum(FpExt val, FpExt *shared) {\n161\t    int tid = threadIdx.x;\n162\t    int warp_id = tid / 32;\n163\t    int lane_id = tid % 32;\n164\t    int num_warps = (blockDim.x + 31) / 32; // Round up for blocks < 32 threads\n165\t\n166\t    // Stage 1: Each warp reduces its values\n167\t    val = warp_reduce_sum(val);\n168\t\n169\t    // Lane 0 of each warp writes result to shared memory\n170\t    if (lane_id == 0) {\n171\t        shared[warp_id] = val;\n172\t    }\n173\t    __syncthreads();\n174\t\n175\t    // Stage 2: First warp reduces the per-warp results\n176\t    FpExt zero = {0, 0, 0, 0};\n177\t    if (warp_id == 0) {\n178\t        // Only the first warp participates in the second reduction. Within that warp we\n179\t        // reuse the lane id to index the number of warps stored in shared memory.\n180\t        FpExt warp_val = (lane_id < num_warps) ? shared[lane_id] : zero;\n181\t        val = warp_reduce_sum(warp_val);\n182\t    }\n183\t\n184\t    return val;\n185\t}\n186\t\n187\t// Final reduction: combines partial block sums into final result\n188\t// Grid dimension: D blocks (one per output value)\n189\t// Each block reduces num_blocks partial sums for its assigned output\n190\t//\n191\t// The number of blocks is constant and determined by template parameter D.\n192\ttemplate <int D>\n193\tstatic __global__ void static_final_reduce_block_sums(\n194\t    const FpExt *block_sums, // [num_blocks][D]\n195\t    FpExt *output,           // [D]\n196\t    uint32_t num_blocks\n197\t) {\n198\t    extern __shared__ char smem[];\n199\t    FpExt *shared = (FpExt *)smem;\n200\t\n201\t    int tid = threadIdx.x;\n202\t\n203\t    // blockIdx.x selects which of the D outputs we're computing\n204\t    int out_idx = blockIdx.x;\n205\t    if (out_idx >= D)\n206\t        return;\n207\t\n208\t    FpExt sum = {0, 0, 0, 0};\n209\t\n210\t    // Each thread accumulates subset of blocks\n211\t    for (int block_id = tid; block_id < num_blocks; block_id += blockDim.x) {\n212\t        sum += block_sums[block_id * D + out_idx];\n213\t    }\n214\t\n215\t    // Block-level reduction\n216\t    sum = block_reduce_sum(sum, shared);\n217\t\n218\t    if (tid == 0) {\n219\t        output[out_idx] = sum;\n220\t    }\n221\t}\n222\t\n223\t// gridDim.x must be set to equal `d`\n224\ttemplate <bool ADD_TO_OUTPUT = false>\n225\tstatic __global__ void final_reduce_block_sums(\n226\t    const FpExt *block_sums, // [num_blocks][d]\n227\t    FpExt *output,           // [d]\n228\t    uint32_t num_blocks\n229\t) {\n230\t    extern __shared__ char smem[];\n231\t    FpExt *shared = (FpExt *)smem;\n232\t\n233\t    int tid = threadIdx.x;\n234\t\n235\t    // blockIdx.x selects which of the D outputs we're computing\n236\t    int out_idx = blockIdx.x;\n237\t    int d = gridDim.x;\n238\t\n239\t    FpExt sum = {0, 0, 0, 0};\n240\t\n241\t    // Each thread accumulates subset of blocks\n242\t    for (int block_id = tid; block_id < num_blocks; block_id += blockDim.x) {\n243\t        sum += block_sums[block_id * d + out_idx];\n244\t    }\n245\t\n246\t    // Block-level reduction\n247\t    sum = block_reduce_sum(sum, shared);\n248\t\n249\t    if (tid == 0) {\n250\t        if constexpr (ADD_TO_OUTPUT) {\n251\t            output[out_idx] += sum;\n252\t        } else {\n253\t            output[out_idx] = sum;\n254\t        }\n255\t    }\n256\t}\n257\t\n258\t// Batched version: reduces partial sums for multiple segments (e.g., AIRs) in a single launch.\n259\t// Grid: (num_segments, d) where each block (seg, x) reduces blocks for segment `seg` at output index `x`.\n260\t// segment_offsets[seg] gives the start block index; segment_offsets[seg+1] gives the end.\n261\tstatic __global__ void batched_final_reduce_block_sums(\n262\t    const FpExt *block_sums,           // [total_blocks][d]\n263\t    FpExt *output,                     // [num_segments][d]\n264\t    const uint32_t *segment_offsets,   // [num_segments + 1], device memory\n265\t    uint32_t d\n266\t) {\n267\t    extern __shared__ char smem[];\n268\t    FpExt *shared = (FpExt *)smem;\n269\t\n270\t    uint32_t seg_idx = blockIdx.x;\n271\t    uint32_t out_idx = blockIdx.y;\n272\t    int tid = threadIdx.x;\n273\t\n274\t    uint32_t start = segment_offsets[seg_idx];\n275\t    uint32_t end = segment_offsets[seg_idx + 1];\n276\t    uint32_t num_blocks = end - start;\n277\t\n278\t    FpExt sum = {0, 0, 0, 0};\n279\t\n280\t    // Each thread accumulates a strided subset of this segment's blocks\n281\t    for (uint32_t i = tid; i < num_blocks; i += blockDim.x) {\n282\t        sum += block_sums[(start + i) * d + out_idx];\n283\t    }\n284\t\n285\t    // Block-level reduction\n286\t    sum = block_reduce_sum(sum, shared);\n287\t\n288\t    if (tid == 0) {\n289\t        output[seg_idx * d + out_idx] = sum;\n290\t    }\n291\t}\n292\t\n293\t// Folds MLE evaluations using challenge r: output[y] = input[2*y] + r*(input[2*y+1] - input[2*y])\n294\t__device__ __forceinline__ void fold_mle(\n295\t    const FpExt *__restrict__ const *__restrict__ input_matrices,\n296\t    FpExt *__restrict__ const *__restrict__ output_matrices,\n297\t    const uint32_t *widths, // Width of each matrix\n298\t    const uint8_t log_output_height,\n299\t    const FpExt &r_val,\n300\t    uint32_t tidx,\n301\t    uint32_t mat_idx\n302\t) {\n303\t    uint32_t width = widths[mat_idx];\n304\t    uint32_t output_height = 1 << log_output_height;\n305\t    if (tidx >= output_height * width)\n306\t        return;\n307\t    uint32_t row_idx = tidx & (output_height - 1);\n308\t    uint32_t col_idx = tidx >> log_output_height;\n309\t\n310\t    const FpExt *input = input_matrices[mat_idx];\n311\t    FpExt *output = output_matrices[mat_idx];\n312\t\n313\t    auto col_offset_out = col_idx * output_height;\n314\t    auto col_offset_in = col_offset_out << 1;\n315\t\n316\t    auto idx_0 = col_offset_in + (row_idx << 1);\n317\t    auto idx_1 = col_offset_in + (row_idx << 1) + 1;\n318\t    auto out_idx = col_offset_out + row_idx;\n319\t\n320\t    FpExt t0 = input[idx_0];\n321\t    FpExt t1 = input[idx_1];\n322\t\n323\t    output[out_idx] = t0 + r_val * (t1 - t0);\n324\t}\n325\t\n326\t} // namespace sumcheck\n327\t"}]},"parent_tool_use_id":"toolu_012iXBoiGLntjUndbWKRicBY","session_id":"f2fb024d-582e-4612-82c1-d7c12af7ab35","uuid":"75dd8923-7ef2-4292-8563-287d366e8fa4","timestamp":"2026-04-13T10:24:03.479Z"}
