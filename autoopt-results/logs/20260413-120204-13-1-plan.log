{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015CMZztaRky8kk7MEyz94ps","type":"tool_result","content":"1\t#include \"fp.h\"\n2\t#include \"fpext.h\"\n3\t#include \"launcher.cuh\"\n4\t#include \"sumcheck.cuh\"\n5\t#include <algorithm>\n6\t#include <cstddef>\n7\t#include <cstdint>\n8\t#include <utility>\n9\t#include <vector_types.h>\n10\t\n11\tnamespace plain_sumcheck {\n12\t\n13\t// Reduces evaluations over x and column dimensions for PLE round 0\n14\t// Input:  [num_x * num_cols * large_domain_size] - evaluations on large domain\n15\t// Output: [large_domain_size] - summed evaluations\n16\t// Each thread handles one z value, summing over all (x, col) pairs\n17\t// Memory: Column-major layout where each (x,col) is a column of size large_domain_size\n18\t__global__ void reduce_over_x_and_cols_kernel(\n19\t    const Fp *input, // [num_x * num_cols * large_domain_size]\n20\t    Fp *output,      // [large_domain_size]\n21\t    uint32_t num_x,\n22\t    uint32_t num_cols,\n23\t    uint32_t large_domain_size\n24\t) {\n25\t    // Each thread handles one z value\n26\t    int z = blockIdx.x * blockDim.x + threadIdx.x;\n27\t    if (z >= large_domain_size)\n28\t        return;\n29\t\n30\t    Fp sum = Fp::zero();\n31\t\n32\t    // Sum input[(x * num_cols + col) * large_domain_size + z] over all (x, col)\n33\t    for (uint32_t x = 0; x < num_x; x++) {\n34\t        for (uint32_t col = 0; col < num_cols; col++) {\n35\t            // Column-major layout: [x * num_cols + col][z]\n36\t            uint32_t offset = (x * num_cols + col) * large_domain_size;\n37\t            sum = sum + input[offset + z];\n38\t        }\n39\t    }\n40\t\n41\t    output[z] = sum;\n42\t}\n43\t\n44\t// Computes univariate polynomial evaluations for MLE sumcheck round\n45\t// For each X ∈ {1, ..., d}, computes: s(X) = Σ_{y ∈ H_{n-1}} f̂(X, y)\n46\t// where f̂(X, y) is obtained by linear interpolation: f(0,y) + X*(f(1,y) - f(0,y))\n47\t//\n48\t// Memory layout: Column-major matrices with height = 2^n\n49\t// - For each y: reads indices [2*y, 2*y+1] (even/odd pairs)\n50\t// - Outputs partial sums per block, final reduction done in separate kernel\n51\t//\n52\t// Template parameter WD: Number of output polynomials (typically 1)\n53\t// NOTE: This implements identity W function. For custom W, modify accumulation section.\n54\ttemplate <int WD>\n55\t__global__ void sumcheck_mle_round_kernel(\n56\t    const uintptr_t *input_matrices,\n57\t    FpExt *block_sums, // Output: [gridDim.x][d][WD] partial sums\n58\t    const uint32_t *widths,\n59\t    const uint32_t num_matrices,\n60\t    const uint32_t height, // = 2^n\n61\t    const uint32_t d       // degree (runtime parameter)\n62\t) {\n63\t    extern __shared__ char smem[];\n64\t    FpExt *shared = (FpExt *)smem;\n65\t\n66\t    int half_height = height >> 1;\n67\t\n68\t    // Local accumulators for all (d, WD) pairs\n69\t    constexpr int MAX_D = 5; // [TODO] Mark this in doc that it's max degree 4 + 1\n70\t    FpExt local_sums[WD * MAX_D];\n71\t\n72\t    // Initialize accumulators\n73\t    for (int i = 0; i < d * WD; i++) {\n74\t        local_sums[i] = {0, 0, 0, 0};\n75\t    }\n76\t\n77\t    // Map phase: each thread processes multiple y values\n78\t    for (int y = blockIdx.x * blockDim.x + threadIdx.x; y < half_height;\n79\t         y += gridDim.x * blockDim.x) {\n80\t\n81\t        // For each evaluation point X in {1, 2, ..., d}\n82\t        for (uint32_t x_int = 1; x_int <= d; x_int++) {\n83\t            FpExt X = FpExt(Fp(x_int));\n84\t\n85\t            // For identity W: we simply sum all matrix column evaluations\n86\t            // For each matrix\n87\t            for (int mat_idx = 0; mat_idx < num_matrices; mat_idx++) {\n88\t                const FpExt *input = reinterpret_cast<const FpExt *>(input_matrices[mat_idx]);\n89\t                int width = widths[mat_idx];\n90\t\n91\t                // For each column\n92\t                for (int col = 0; col < width; col++) {\n93\t                    int col_offset = col * height;\n94\t                    int idx_0 = col_offset + (y << 1);\n95\t                    int idx_1 = col_offset + (y << 1) + 1;\n96\t\n97\t                    FpExt eval_0 = input[idx_0];\n98\t                    FpExt eval_1 = input[idx_1];\n99\t\n100\t                    FpExt eval_X = eval_0 + X * (eval_1 - eval_0);\n101\t\n102\t                    // For identity W and WD=1: accumulate directly\n103\t                    // TODO: When implementing custom W, replace this section\n104\t                    local_sums[(x_int - 1) * WD + 0] += eval_X;\n105\t                }\n106\t            }\n107\t        }\n108\t    }\n109\t\n110\t    // Reduce phase: for each (x_int, wd) pair\n111\t    for (int x_int = 0; x_int < d; x_int++) {\n112\t        for (int wd = 0; wd < WD; wd++) {\n113\t            int idx = x_int * WD + wd;\n114\t            FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n115\t\n116\t            if (threadIdx.x == 0) {\n117\t                block_sums[blockIdx.x * d * WD + idx] = reduced;\n118\t            }\n119\t            __syncthreads(); // Needed before reusing shared memory\n120\t        }\n121\t    }\n122\t}\n123\t\n124\t// Final reduction: combines partial block sums into final result\n125\t// Grid dimension: d * WD blocks (one per output value)\n126\t// Each block reduces num_blocks partial sums for its assigned output\n127\ttemplate <int WD>\n128\t__global__ void reduce_blocks_sumcheck(\n129\t    const FpExt *block_sums, // [num_blocks][d * WD]\n130\t    FpExt *output,           // [d * WD]\n131\t    uint32_t num_blocks,\n132\t    uint32_t d\n133\t) {\n134\t    extern __shared__ char smem[];\n135\t    FpExt *shared = (FpExt *)smem;\n136\t\n137\t    int tid = threadIdx.x;\n138\t\n139\t    // blockIdx.x selects which of the (d * WD) outputs we're computing\n140\t    int out_idx = blockIdx.x;\n141\t    if (out_idx >= d * WD)\n142\t        return;\n143\t\n144\t    FpExt sum = {0, 0, 0, 0};\n145\t\n146\t    // Each thread accumulates subset of blocks\n147\t    for (int block_id = tid; block_id < num_blocks; block_id += blockDim.x) {\n148\t        sum += block_sums[block_id * d * WD + out_idx];\n149\t    }\n150\t\n151\t    // Block-level reduction\n152\t    sum = sumcheck::block_reduce_sum(sum, shared);\n153\t\n154\t    if (tid == 0) {\n155\t        output[out_idx] = sum;\n156\t    }\n157\t}\n158\t\n159\t// Folds MLE evaluations using challenge r: output[y] = input[2*y] + r*(input[2*y+1] - input[2*y])\n160\t// Memory: Column-major layout, each column folded independently\n161\t// - Input:  height = 2^n per column\n162\t// - Output: height = 2^(n-1) per column\n163\t// Grid: (blocks for height/2, num_matrices) to parallelize over both dimensions\n164\t__global__ void fold_mle_kernel(\n165\t    const FpExt *__restrict__ const *__restrict__ input_matrices, // Array of input matrix pointers\n166\t    FpExt *__restrict__ const *__restrict__ output_matrices,      // Array of output matrix pointers\n167\t    const uint32_t *widths,                                       // Width of each matrix\n168\t    const uint8_t log_output_height,\n169\t    const FpExt r_val\n170\t) {\n171\t    uint32_t mat_idx = blockIdx.y * blockDim.y + threadIdx.y;\n172\t    uint32_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n173\t\n174\t    // blockIdx.y selects which matrix we're working on\n175\t    sumcheck::fold_mle(\n176\t        input_matrices, output_matrices, widths, log_output_height, r_val, tidx, mat_idx\n177\t    );\n178\t}\n179\t\n180\t__global__ void fold_mle_column_kernel(FpExt *buffer, size_t half, FpExt r) {\n181\t    size_t idx = blockIdx.x * blockDim.x + threadIdx.x;\n182\t    if (idx >= half) {\n183\t        return;\n184\t    }\n185\t\n186\t    FpExt &t0 = buffer[idx];\n187\t    FpExt const &t1 = buffer[idx | half];\n188\t    t0 += r * (t1 - t0);\n189\t}\n190\t\n191\t// Folds MLE evaluations as in fold_mle_kernel above, but supports matrices of different heights\n192\t__global__ void batch_fold_mle_kernel(\n193\t    const FpExt *__restrict__ const *__restrict__ input_matrices, // Array of input matrix pointers\n194\t    FpExt *__restrict__ const *__restrict__ output_matrices,      // Array of output matrix pointers\n195\t    const uint32_t *widths,                                       // Width of each matrix\n196\t    const uint8_t *log_output_heights,\n197\t    const FpExt r_val\n198\t) {\n199\t    uint32_t mat_idx = blockIdx.y * blockDim.y + threadIdx.y;\n200\t    uint32_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n201\t\n202\t    uint8_t log_output_height = log_output_heights[mat_idx];\n203\t\n204\t    sumcheck::fold_mle(\n205\t        input_matrices, output_matrices, widths, log_output_height, r_val, tidx, mat_idx\n206\t    );\n207\t}\n208\t\n209\t// Evaluates univariate polynomials at challenge point r using Horner's method\n210\t// Input: Polynomial coefficients (from iDFT in round 0) in natural order\n211\t// Output: Evaluations in extension field\n212\t//\n213\t// Memory layout: Column-major with domain_size coefficients per polynomial\n214\t// - input_coeffs[(x * width + col) * domain_size + i] = coefficient c_i for polynomial (x, col)\n215\t// - Evaluates: c_0 + c_1*r + c_2*r^2 + ... using Horner's method\n216\t//\n217\t// Why this works: During PLE round 0, we performed iDFT with bit_reverse=true,\n218\t// converting evaluations to coefficients in natural order. We reuse those\n219\t// coefficients here instead of re-interpolating from evaluations (more efficient).\n220\t__global__ void fold_ple_from_coeffs_kernel(\n221\t    const Fp *__restrict__ input_coeffs, // [num_x * width * domain_size] after iDFT\n222\t    FpExt *__restrict__ output,          // [num_x * width]\n223\t    uint32_t num_x,\n224\t    uint32_t width,\n225\t    uint32_t domain_size, // 2^l_skip\n226\t    FpExt r_val\n227\t) {\n228\t    int idx = blockIdx.x * blockDim.x + threadIdx.x;\n229\t    int total_polys = num_x * width;\n230\t\n231\t    if (idx >= total_polys)\n232\t        return;\n233\t\n234\t    // Coefficients for this (x, col) are at offset idx * domain_size\n235\t    const Fp *coeffs = input_coeffs + idx * domain_size;\n236\t\n237\t    // Horner's method: evaluate polynomial at r\n238\t    FpExt result = FpExt(Fp(coeffs[domain_size - 1]));\n239\t    for (int i = domain_size - 2; i >= 0; i--) {\n240\t        result = result * r_val + FpExt(Fp(coeffs[i]));\n241\t    }\n242\t\n243\t    output[idx] = result;\n244\t}\n245\t\n246\t// output should be segment tree of size 2 * 2^{output_max_n},\n247\t// input should be segment tree of size 2 * 2^{output_max_n + 1}\n248\t// We fold each segment of input and write to corresponding segment of output\n249\t// The input[1] is ignored.\n250\t__global__ void triangular_fold_mle_kernel(FpExt *output, const FpExt *input, FpExt r) {\n251\t    uint32_t x = blockIdx.x * blockDim.x + threadIdx.x;\n252\t    uint32_t n = blockIdx.y;\n253\t    uint32_t out_num_x = 1 << n;\n254\t    uint32_t in_num_x = 2 * out_num_x;\n255\t\n256\t    if (x >= out_num_x)\n257\t        return;\n258\t    FpExt t0 = input[in_num_x + (x << 1)];\n259\t    FpExt t1 = input[in_num_x + (x << 1) + 1];\n260\t    output[out_num_x + x] = t0 + (t1 - t0) * r;\n261\t}\n262\t\n263\t// ============================================================================\n264\t// LAUNCHERS\n265\t// ============================================================================\n266\t\n267\tstd::pair<dim3, dim3> fold_mle_launch_params(uint32_t max_output_cells, uint32_t num_matrices) {\n268\t    if (max_output_cells <= WARP_SIZE) {\n269\t        return kernel_launch_2d_params(max_output_cells, num_matrices);\n270\t    } else {\n271\t        auto [grid, block] = kernel_launch_params(max_output_cells);\n272\t        grid.y = num_matrices;\n273\t        return {grid, block};\n274\t    }\n275\t}\n276\t\n277\textern \"C\" int _fold_mle(\n278\t    const FpExt *const *input_matrices,\n279\t    FpExt *const *output_matrices,\n280\t    const uint32_t *widths,\n281\t    const uint16_t num_matrices,\n282\t    const uint32_t output_height,\n283\t    const uint32_t max_output_cells,\n284\t    const FpExt r_val\n285\t) {\n286\t    auto [grid, block] = fold_mle_launch_params(max_output_cells, num_matrices);\n287\t    uint8_t log_output_height = static_cast<uint8_t>(31 - __builtin_clz(output_height));\n288\t    fold_mle_kernel<<<grid, block>>>(\n289\t        input_matrices, output_matrices, widths, log_output_height, r_val\n290\t    );\n291\t    return CHECK_KERNEL();\n292\t}\n293\t\n294\textern \"C\" int _fold_mle_column(FpExt *buffer, size_t size, FpExt r) {\n295\t    if (size <= 1) {\n296\t        return 0;\n297\t    }\n298\t    size_t half = size >> 1;\n299\t    auto [grid, block] = kernel_launch_params(half);\n300\t    fold_mle_column_kernel<<<grid, block>>>(buffer, half, r);\n301\t    return CHECK_KERNEL();\n302\t}\n303\t\n304\textern \"C\" int _batch_fold_mle(\n305\t    const FpExt *const *input_matrices,\n306\t    FpExt *const *output_matrices,\n307\t    const uint32_t *widths,\n308\t    const uint16_t num_matrices,\n309\t    const uint8_t *log_output_heights,\n310\t    const uint32_t max_output_cells, // max(height * width)\n311\t    const FpExt r_val\n312\t) {\n313\t    auto [grid, block] = fold_mle_launch_params(max_output_cells, num_matrices);\n314\t    batch_fold_mle_kernel<<<grid, block>>>(\n315\t        input_matrices, output_matrices, widths, log_output_heights, r_val\n316\t    );\n317\t    return CHECK_KERNEL();\n318\t}\n319\t\n320\textern \"C\" int _fold_ple_from_coeffs(\n321\t    const Fp *input_coeffs,\n322\t    FpExt *output,\n323\t    const uint32_t num_x,\n324\t    const uint32_t width,\n325\t    const uint32_t domain_size,\n326\t    const FpExt r_val\n327\t) {\n328\t    int total_polys = num_x * width;\n329\t    auto [grid, block] = kernel_launch_params(total_polys);\n330\t\n331\t    fold_ple_from_coeffs_kernel<<<grid, block>>>(\n332\t        input_coeffs, output, num_x, width, domain_size, r_val\n333\t    );\n334\t\n335\t    return CHECK_KERNEL();\n336\t}\n337\t\n338\textern \"C\" int _reduce_over_x_and_cols(\n339\t    const Fp *input,\n340\t    Fp *output,\n341\t    uint32_t num_x,\n342\t    uint32_t num_cols,\n343\t    uint32_t large_domain_size\n344\t) {\n345\t    auto [grid, block] = kernel_launch_params(large_domain_size);\n346\t    reduce_over_x_and_cols_kernel<<<grid, block>>>(\n347\t        input, output, num_x, num_cols, large_domain_size\n348\t    );\n349\t    return CHECK_KERNEL();\n350\t}\n351\t\n352\t// WD = 1\n353\textern \"C\" int _sumcheck_mle_round(\n354\t    const uintptr_t *input_matrices,\n355\t    FpExt *output,         // Output: [d * WD] final results\n356\t    FpExt *tmp_block_sums, // Temporary buffer: [num_blocks * d * WD]\n357\t    const uint32_t *widths,\n358\t    const uint32_t num_matrices,\n359\t    const uint32_t height,\n360\t    const uint32_t d\n361\t) {\n362\t    int half_height = height >> 1;\n363\t    auto [grid, block] = kernel_launch_params(half_height);\n364\t    unsigned int num_warps = (block.x + WARP_SIZE - 1) / WARP_SIZE;\n365\t    size_t shmem_bytes = std::max(1u, num_warps) * sizeof(FpExt);\n366\t\n367\t    // Launch main kernel - writes to tmp_block_sums\n368\t    sumcheck_mle_round_kernel<1><<<grid, block, shmem_bytes>>>(\n369\t        input_matrices, tmp_block_sums, widths, num_matrices, height, d\n370\t    );\n371\t\n372\t    int err = CHECK_KERNEL();\n373\t    if (err != 0)\n374\t        return err;\n375\t\n376\t    // Launch final reduction kernel - reads from tmp_block_sums, writes to output\n377\t    auto num_blocks = grid.x;\n378\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n379\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n380\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n381\t    reduce_blocks_sumcheck<1>\n382\t        <<<d, reduce_block, reduce_shmem>>>(tmp_block_sums, output, num_blocks, d);\n383\t\n384\t    return CHECK_KERNEL();\n385\t}\n386\t\n387\textern \"C\" int _triangular_fold_mle(\n388\t    FpExt *output,\n389\t    const FpExt *input,\n390\t    FpExt r,\n391\t    uint32_t output_max_n\n392\t) {\n393\t    auto [grid, block] = kernel_launch_params(1 << output_max_n);\n394\t    grid.y = output_max_n + 1;\n395\t\n396\t    triangular_fold_mle_kernel<<<grid, block>>>(output, input, r);\n397\t\n398\t    return CHECK_KERNEL();\n399\t}\n400\t\n401\t} // namespace plain_sumcheck\n402\t"}]},"parent_tool_use_id":"toolu_012iXBoiGLntjUndbWKRicBY","session_id":"f2fb024d-582e-4612-82c1-d7c12af7ab35","uuid":"1b984a0d-e15e-4a3d-9276-da449b07e0a6","timestamp":"2026-04-13T10:23:56.045Z"}
