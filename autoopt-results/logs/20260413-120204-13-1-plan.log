{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017YARaqV6Y37TXoPDTCjymC","type":"tool_result","content":"1\t//! Batch MLE evaluation for zerocheck and logup.\n2\t//!\n3\t//! This module provides builders for batching MLE evaluations across multiple AIRs,\n4\t//! enabling efficient GPU kernel launches that process multiple traces in parallel.\n5\t\n6\tuse openvm_cuda_common::{\n7\t    copy::{MemCopyD2H, MemCopyH2D},\n8\t    d_buffer::DeviceBuffer,\n9\t    error::MemCopyError,\n10\t};\n11\tuse openvm_stark_backend::prover::{fractional_sumcheck_gkr::Frac, DeviceMultiStarkProvingKey};\n12\t\n13\tuse crate::{\n14\t    cuda::logup_zerocheck::{\n15\t        _logup_batch_mle_intermediates_buffer_size, _zerocheck_batch_mle_intermediates_buffer_size,\n16\t        logup_batch_eval_mle, zerocheck_batch_eval_mle, BlockCtx, EvalCoreCtx, LogupCtx,\n17\t        MainMatrixPtrs, ZerocheckCtx,\n18\t    },\n19\t    error::KernelError,\n20\t    gpu_backend::GenericGpuBackend,\n21\t    hash_scheme::GpuHashScheme,\n22\t    logup_zerocheck::{\n23\t        batch_mle_monomial::{LogupCombinations, LogupMonomialBatch},\n24\t        mle_round::{evaluate_mle_constraints_gpu, evaluate_mle_interactions_gpu},\n25\t    },\n26\t    prelude::{EF, F},\n27\t};\n28\t\n29\tconst MAX_THREADS_PER_BLOCK: u32 = 128;\n30\t\n31\t// ============================================================================\n32\t// Memory calculation helpers\n33\t// ============================================================================\n34\t\n35\t/// Computes zerocheck intermediate buffer memory in bytes for a trace.\n36\tfn zerocheck_batch_mle_intermediates_buffer_bytes(\n37\t    buffer_size: u32,\n38\t    num_x: u32,\n39\t    num_y: u32,\n40\t) -> usize {\n41\t    unsafe {\n42\t        _zerocheck_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n43\t            * std::mem::size_of::<EF>()\n44\t    }\n45\t}\n46\t\n47\t/// Computes logup intermediate buffer memory in bytes for a trace.\n48\tfn logup_batch_mle_intermediates_buffer_bytes(buffer_size: u32, num_x: u32, num_y: u32) -> usize {\n49\t    unsafe {\n50\t        _logup_batch_mle_intermediates_buffer_size(buffer_size, num_x, num_y)\n51\t            * std::mem::size_of::<EF>()\n52\t    }\n53\t}\n54\t\n55\t// ============================================================================\n56\t// Batching helpers\n57\t// ============================================================================\n58\t\n59\t/// Find how many traces fit in the memory budget.\n60\t/// Returns (count, total_memory_of_batch).\n61\tfn find_batch_end<T, M>(traces: &[T], memory_fn: M, memory_limit_bytes: usize) -> (usize, usize)\n62\twhere\n63\t    M: Fn(&T) -> usize,\n64\t{\n65\t    let mut batch_end = 0;\n66\t    let mut batch_memory = 0usize;\n67\t\n68\t    while batch_end < traces.len() {\n69\t        let trace_memory = memory_fn(&traces[batch_end]);\n70\t\n71\t        if batch_end == 0 {\n72\t            // First trace always included (even if oversized)\n73\t            batch_memory = trace_memory;\n74\t            batch_end = 1;\n75\t            if trace_memory > memory_limit_bytes {\n76\t                break; // Single oversized trace\n77\t            }\n78\t        } else if batch_memory + trace_memory <= memory_limit_bytes {\n79\t            batch_memory += trace_memory;\n80\t            batch_end += 1;\n81\t        } else {\n82\t            break; // Would exceed limit\n83\t        }\n84\t    }\n85\t    (batch_end, batch_memory)\n86\t}\n87\t\n88\t/// Context for a single trace used in batch MLE evaluation.\n89\tpub(crate) struct TraceCtx {\n90\t    pub trace_idx: usize,\n91\t    pub air_idx: usize,\n92\t    #[allow(dead_code)]\n93\t    pub n_lift: usize,\n94\t    pub num_y: u32,\n95\t    pub has_constraints: bool,\n96\t    pub has_interactions: bool,\n97\t    pub norm_factor: F,\n98\t    // shared eval pointers (same for zerocheck + logup)\n99\t    pub eq_xi_ptr: *const EF,\n100\t    pub sels_ptr: *const EF,\n101\t    pub prep_ptr: MainMatrixPtrs<EF>,\n102\t    pub main_ptrs_dev: DeviceBuffer<MainMatrixPtrs<EF>>,\n103\t    pub public_ptr: *const F,\n104\t    pub eq_3bs_ptr: *const EF,\n105\t}\n106\t\n107\t// NOTE[jpw]: we do not expect to use this since most of the time zerocheck will use monomial_par_y.\n108\t// We use DAG evaluation primarily for Poseidon2Air. Consider deleting either the non-batch or batch\n109\t// dag version to reduce code duplication.\n110\t/// Builder for batched zerocheck MLE evaluation.\n111\t///\n112\t/// Collects traces and pre-builds all GPU contexts, then evaluates in a single kernel launch.\n113\tpub(crate) struct ZerocheckMleBatchBuilder<'a> {\n114\t    traces: Vec<&'a TraceCtx>,\n115\t    d_block_ctxs: DeviceBuffer<BlockCtx>,\n116\t    d_zc_ctxs: DeviceBuffer<ZerocheckCtx>,\n117\t    air_offsets: DeviceBuffer<u32>,\n118\t    threads_per_block: u32,\n119\t    _intermediates_keepalive: Vec<DeviceBuffer<EF>>,\n120\t}\n121\t\n122\timpl<'a> ZerocheckMleBatchBuilder<'a> {\n123\t    /// Creates a new builder from an iterator of traces.\n124\t    ///\n125\t    /// This constructor filters traces with constraints, computes thread configuration,\n126\t    /// builds all block and zerocheck contexts, and uploads them to the device.\n127\t    pub fn new<HS: GpuHashScheme>(\n128\t        traces: impl Iterator<Item = &'a TraceCtx>,\n129\t        pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n130\t        num_x: u32,\n131\t    ) -> Result<Self, MemCopyError> {\n132\t        let traces: Vec<&TraceCtx> = traces.filter(|t| t.has_constraints).collect();\n133\t\n134\t        if traces.is_empty() {\n135\t            return Ok(Self {\n136\t                traces: vec![],\n137\t                d_block_ctxs: DeviceBuffer::new(),\n138\t                d_zc_ctxs: DeviceBuffer::new(),\n139\t                air_offsets: DeviceBuffer::new(),\n140\t                threads_per_block: 0,\n141\t                _intermediates_keepalive: vec![],\n142\t            });\n143\t        }\n144\t\n145\t        // Compute threads_per_block from max_num_y\n146\t        let max_num_y = traces.iter().map(|t| t.num_y).max().unwrap_or(0);\n147\t        let threads_per_block = max_num_y.min(MAX_THREADS_PER_BLOCK);\n148\t\n149\t        // Build block_ctxs and air_offsets\n150\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();\n151\t        let mut air_offsets: Vec<u32> = Vec::with_capacity(traces.len() + 1);\n152\t        air_offsets.push(0);\n153\t\n154\t        for (local_air, t) in traces.iter().enumerate() {\n155\t            let nb = t.num_y.div_ceil(threads_per_block);\n156\t            for b in 0..nb {\n157\t                block_ctxs_h.push(BlockCtx {\n158\t                    local_block_idx_x: b,\n159\t                    air_idx: local_air as u32,\n160\t                });\n161\t            }\n162\t            air_offsets.push(block_ctxs_h.len() as u32);\n163\t        }\n164\t\n165\t        // Build ZerocheckCtx for each trace\n166\t        let mut intermediates_keepalive: Vec<DeviceBuffer<EF>> = Vec::new();\n167\t        let mut zc_ctxs_h: Vec<ZerocheckCtx> = Vec::with_capacity(traces.len());\n168\t\n169\t        for t in traces.iter() {\n170\t            let air_pk = &pk.per_air[t.air_idx];\n171\t            let buffer_size = air_pk.other_data.zerocheck_mle.inner.buffer_size;\n172\t\n173\t            let d_intermediates = if buffer_size > 0 {\n174\t                let intermediates_len = unsafe {\n175\t                    _zerocheck_batch_mle_intermediates_buffer_size(buffer_size, num_x, t.num_y)\n176\t                };\n177\t                let buf = DeviceBuffer::<EF>::with_capacity(intermediates_len);\n178\t                let ptr = buf.as_mut_ptr();\n179\t                intermediates_keepalive.push(buf);\n180\t                ptr\n181\t            } else {\n182\t                std::ptr::null_mut()\n183\t            };\n184\t\n185\t            let eval_ctx = EvalCoreCtx {\n186\t                d_selectors: t.sels_ptr,\n187\t                d_preprocessed: t.prep_ptr,\n188\t                d_main: t.main_ptrs_dev.as_ptr(),\n189\t                d_public: t.public_ptr,\n190\t            };\n191\t\n192\t            zc_ctxs_h.push(ZerocheckCtx {\n193\t                eval_ctx,\n194\t                d_intermediates,\n195\t                num_y: t.num_y,\n196\t                d_eq_xi: t.eq_xi_ptr,\n197\t                d_rules: air_pk.other_data.zerocheck_mle.inner.d_rules.as_raw_ptr(),\n198\t                rules_len: air_pk.other_data.zerocheck_mle.inner.d_rules.len(),\n199\t                d_used_nodes: air_pk.other_data.zerocheck_mle.inner.d_used_nodes.as_ptr(),\n200\t                used_nodes_len: air_pk.other_data.zerocheck_mle.inner.d_used_nodes.len(),\n201\t                buffer_size,\n202\t            });\n203\t        }\n204\t\n205\t        // Upload to device\n206\t        let d_block_ctxs = block_ctxs_h.to_device()?;\n207\t        let d_zc_ctxs = zc_ctxs_h.to_device()?;\n208\t        let air_offsets = air_offsets.to_device()?;\n209\t\n210\t        Ok(Self {\n211\t            traces,\n212\t            d_block_ctxs,\n213\t            d_zc_ctxs,\n214\t            air_offsets,\n215\t            threads_per_block,\n216\t            _intermediates_keepalive: intermediates_keepalive,\n217\t        })\n218\t    }\n219\t\n220\t    /// Returns true if there are no traces to evaluate.\n221\t    #[allow(dead_code)]\n222\t    pub fn is_empty(&self) -> bool {\n223\t        self.traces.is_empty()\n224\t    }\n225\t\n226\t    /// Returns the trace indices in order.\n227\t    pub fn trace_indices(&self) -> impl Iterator<Item = usize> + '_ {\n228\t        self.traces.iter().map(|t| t.trace_idx)\n229\t    }\n230\t\n231\t    /// Evaluates the batch and returns the output device buffer.\n232\t    ///\n233\t    /// The buffer contains `num_airs * num_x` elements, laid out as\n234\t    /// `[air0_x0, air0_x1, ..., air1_x0, air1_x1, ...]`.\n235\t    pub fn evaluate(\n236\t        &self,\n237\t        lambda_pows: &DeviceBuffer<EF>,\n238\t        num_x: u32,\n239\t    ) -> Result<DeviceBuffer<EF>, KernelError> {\n240\t        if self.traces.is_empty() {\n241\t            return Ok(DeviceBuffer::new());\n242\t        }\n243\t\n244\t        evaluate_mle_constraints_gpu_batch(\n245\t            &self.d_block_ctxs,\n246\t            &self.d_zc_ctxs,\n247\t            &self.air_offsets,\n248\t            lambda_pows,\n249\t            lambda_pows.len(),\n250\t            num_x,\n251\t            self.threads_per_block,\n252\t        )\n253\t    }\n254\t}\n255\t\n256\t/// Builder for batched logup MLE evaluation.\n257\t///\n258\t/// Collects traces and pre-builds all GPU contexts, then evaluates in a single kernel launch.\n259\tpub(crate) struct LogupMleBatchBuilder<'a> {\n260\t    traces: Vec<&'a TraceCtx>,\n261\t    d_block_ctxs: DeviceBuffer<BlockCtx>,\n262\t    d_logup_ctxs: DeviceBuffer<LogupCtx>,\n263\t    air_offsets: DeviceBuffer<u32>,\n264\t    threads_per_block: u32,\n265\t    _intermediates_keepalive: Vec<DeviceBuffer<EF>>,\n266\t}\n267\t\n268\timpl<'a> LogupMleBatchBuilder<'a> {\n269\t    /// Creates a new builder from an iterator of traces.\n270\t    ///\n271\t    /// This constructor filters traces with interactions, computes thread configuration,\n272\t    /// builds all block and logup contexts, and uploads them to the device.\n273\t    pub fn new<HS: GpuHashScheme>(\n274\t        traces: impl Iterator<Item = &'a TraceCtx>,\n275\t        pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n276\t        d_challenges_ptr: *const EF,\n277\t        num_x: u32,\n278\t    ) -> Result<Self, MemCopyError> {\n279\t        let traces: Vec<&TraceCtx> = traces.filter(|t| t.has_interactions).collect();\n280\t\n281\t        if traces.is_empty() {\n282\t            return Ok(Self {\n283\t                traces: vec![],\n284\t                d_block_ctxs: DeviceBuffer::new(),\n285\t                d_logup_ctxs: DeviceBuffer::new(),\n286\t                air_offsets: DeviceBuffer::new(),\n287\t                threads_per_block: 0,\n288\t                _intermediates_keepalive: vec![],\n289\t            });\n290\t        }\n291\t\n292\t        // Compute threads_per_block from max_num_y\n293\t        let max_num_y = traces.iter().map(|t| t.num_y).max().unwrap_or(0);\n294\t        let threads_per_block = max_num_y.min(MAX_THREADS_PER_BLOCK);\n295\t\n296\t        // Build block_ctxs and air_offsets\n297\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();\n298\t        let mut air_offsets: Vec<u32> = Vec::with_capacity(traces.len() + 1);\n299\t        air_offsets.push(0);\n300\t"}]},"parent_tool_use_id":"toolu_01QqWhsz9DHqFxuan99aQmii","session_id":"f2fb024d-582e-4612-82c1-d7c12af7ab35","uuid":"c254b013-6852-4c40-adee-d5adb077319a","timestamp":"2026-04-13T10:09:19.140Z"}
