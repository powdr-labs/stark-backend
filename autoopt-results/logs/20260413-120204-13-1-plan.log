{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RjpRyLrp7V6ZtWiqScy9T7","type":"tool_result","content":"1\tuse itertools::Itertools;\n2\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer};\n3\tuse openvm_stark_backend::{\n4\t    air_builders::symbolic::{\n5\t        symbolic_expression::SymbolicExpression, SymbolicConstraints, SymbolicDagBuilder,\n6\t        SymbolicExpressionDag,\n7\t    },\n8\t    prover::{fractional_sumcheck_gkr::Frac, DeviceStarkProvingKey},\n9\t};\n10\tuse p3_field::PrimeCharacteristicRing;\n11\tuse tracing::{debug, warn};\n12\t\n13\tuse super::errors::Round0EvalError;\n14\tuse crate::{\n15\t    cuda::logup_zerocheck::{\n16\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n17\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n18\t        logup_bary_eval_interactions_round0, zerocheck_ntt_eval_constraints,\n19\t    },\n20\t    gpu_backend::GenericGpuBackend,\n21\t    hash_scheme::GpuHashScheme,\n22\t    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n23\t    prelude::{EF, F},\n24\t};\n25\t\n26\t/// Evaluate plain AIR constraints (not interactions) for a single AIR, given prepared trace input.\n27\t///\n28\t/// `num_cosets` should equal `constraint_degree - 1` because we evaluate the quotient polynomial.\n29\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n30\t#[allow(clippy::too_many_arguments)]\n31\tpub fn evaluate_round0_constraints_gpu<HS: GpuHashScheme>(\n32\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n33\t    selectors_cube: &DeviceBuffer<F>,\n34\t    main_parts: &DeviceBuffer<*const F>,\n35\t    public_values: &DeviceBuffer<F>,\n36\t    eq_cube: *const EF,\n37\t    lambda_pows: &DeviceBuffer<EF>,\n38\t    skip_domain: u32,\n39\t    num_x: u32,\n40\t    height: u32,\n41\t    num_cosets: u32,\n42\t    g_shift: F,\n43\t    max_temp_bytes: usize,\n44\t) -> Result<DeviceBuffer<EF>, Round0EvalError> {\n45\t    let constraints_dag = &pk.vk.symbolic_constraints;\n46\t    if constraints_dag.constraints.constraint_idx.is_empty() || num_cosets == 0 {\n47\t        // No plain AIR constraints, return empty buffer\n48\t        return Ok(DeviceBuffer::new());\n49\t    }\n50\t\n51\t    let rules = &pk.other_data.zerocheck_round0;\n52\t\n53\t    let buffer_size: u32 = rules.inner.buffer_size;\n54\t    let intermed_capacity = unsafe {\n55\t        _zerocheck_r0_intermediates_buffer_size(\n56\t            buffer_size,\n57\t            skip_domain,\n58\t            num_x,\n59\t            num_cosets,\n60\t            max_temp_bytes,\n61\t        )\n62\t    };\n63\t    let mut intermediates = if intermed_capacity > 0 {\n64\t        debug!(\"zerocheck:intermediates_capacity={intermed_capacity}\");\n65\t        DeviceBuffer::<F>::with_capacity(intermed_capacity)\n66\t    } else {\n67\t        DeviceBuffer::<F>::new()\n68\t    };\n69\t\n70\t    let temp_sums_buffer_capacity = unsafe {\n71\t        _zerocheck_r0_temp_sums_buffer_size(\n72\t            buffer_size,\n73\t            skip_domain,\n74\t            num_x,\n75\t            num_cosets,\n76\t            max_temp_bytes,\n77\t        )\n78\t    };\n79\t    debug!(\"zerocheck:temp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n80\t    let mut temp_sums_buffer = DeviceBuffer::<EF>::with_capacity(temp_sums_buffer_capacity);\n81\t    let used_temp_bytes =\n82\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<EF>();\n83\t    if used_temp_bytes > max_temp_bytes {\n84\t        // We do not error if the required bytes is greater than the requested max, but this may\n85\t        // lead to unexpected peak memory usage.\n86\t        warn!(\"zerocheck used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\");\n87\t    }\n88\t\n89\t    let preprocessed_ptr = pk\n90\t        .preprocessed_data\n91\t        .as_ref()\n92\t        .map(|cd| cd.trace.buffer().as_ptr())\n93\t        .unwrap_or(std::ptr::null());\n94\t\n95\t    let mut sp_evals =\n96\t        DeviceBuffer::<EF>::with_capacity(num_cosets as usize * skip_domain as usize);\n97\t    // SAFETY:\n98\t    // - No bounds checks are done in this kernel. It fully assumes that the Rules are trusted and\n99\t    //   all nodes are valid.\n100\t    unsafe {\n101\t        zerocheck_ntt_eval_constraints(\n102\t            &mut temp_sums_buffer,\n103\t            &mut sp_evals,\n104\t            selectors_cube,\n105\t            preprocessed_ptr,\n106\t            main_parts,\n107\t            eq_cube,\n108\t            lambda_pows,\n109\t            public_values,\n110\t            &rules.inner.d_rules,\n111\t            &rules.inner.d_used_nodes,\n112\t            buffer_size,\n113\t            &mut intermediates,\n114\t            skip_domain,\n115\t            num_x,\n116\t            height,\n117\t            num_cosets,\n118\t            g_shift,\n119\t            max_temp_bytes,\n120\t        )?;\n121\t    }\n122\t\n123\t    Ok(sp_evals)\n124\t}\n125\t\n126\t/// Evaluate interaction constraints (excluding plain AIR constraints) for a single AIR, given\n127\t/// prepared trace input.\n128\t///\n129\t/// `constraints` includes interaction expressions for the AIR.\n130\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n131\t#[allow(clippy::too_many_arguments)]\n132\tpub fn evaluate_round0_interactions_gpu<HS: GpuHashScheme>(\n133\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n134\t    symbolic: &SymbolicConstraints<F>,\n135\t    selectors_cube: &DeviceBuffer<F>,\n136\t    main_parts: &DeviceBuffer<*const F>,\n137\t    public_values: &DeviceBuffer<F>,\n138\t    eq_cube: *const EF,\n139\t    beta_pows: &[EF],\n140\t    eq_3bs: &[EF],\n141\t    skip_domain: u32,\n142\t    num_x: u32,\n143\t    height: u32,\n144\t    num_cosets: u32,\n145\t    g_shift: F,\n146\t    max_temp_bytes: usize,\n147\t) -> Result<DeviceBuffer<Frac<EF>>, Round0EvalError> {\n148\t    // Check if this trace has interactions\n149\t    if eq_3bs.is_empty() {\n150\t        return Ok(DeviceBuffer::new());\n151\t    }\n152\t    let large_domain = num_cosets * skip_domain;\n153\t\n154\t    // We create a new \"interactions DAG\" where the new .constraints are the interaction [count,\n155\t    // message_0, message_1, ..] expressions themselves, while the .interactions are empty\n156\t    // We track the indices with InteractionNode\n157\t\n158\t    // Copied from build_symbolic_constraints_dag to handle sorting of constraints\n159\t    // NOTE: For logup round0, the kernel uses weights indexed by rule_idx, not constraint_idx.\n160\t    // So we deduplicate constraint_idx and use dag_idx_to_rule_idx for weight mapping.\n161\t    let (rules, d_numer_weights, d_denom_weights, denom_sum_init) = {\n162\t        let mut dag_builder = SymbolicDagBuilder::new();\n163\t        let mut sorted_used_dag_idxs = Vec::new();\n164\t        for interaction in &symbolic.interactions {\n165\t            let count = dag_builder.add_expr(&interaction.count);\n166\t            sorted_used_dag_idxs.push(count);\n167\t            sorted_used_dag_idxs.extend(\n168\t                interaction\n169\t                    .message\n170\t                    .iter()\n171\t                    .map(|field_expr| dag_builder.add_expr(field_expr)),\n172\t            );\n173\t        }\n174\t        sorted_used_dag_idxs.sort();\n175\t        // Deduplicate for the dag since logup round0 kernel doesn't use used_nodes\n176\t        sorted_used_dag_idxs.dedup();\n177\t        let dag = SymbolicExpressionDag {\n178\t            nodes: dag_builder.nodes,\n179\t            constraint_idx: sorted_used_dag_idxs,\n180\t        };\n181\t        let rules = SymbolicRulesGpu::new(&dag, true);\n182\t        let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n183\t        let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n184\t        let mut denom_sum_init = EF::ZERO;\n185\t        for (interaction_idx, interaction) in symbolic.interactions.iter().enumerate() {\n186\t            // CAUTION: an expression node could be used in multiple interactions, and might even be\n187\t            // used as `count` in one, but message field in another. We only care about their\n188\t            // weighted sum with eq_3b, so we compute the weights ahead of time.\n189\t            let count_dag_idx =\n190\t                dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];\n191\t            let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n192\t            numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n193\t            denom_sum_init += eq_3bs[interaction_idx]\n194\t                * beta_pows[interaction.message.len()]\n195\t                * F::from_u32(interaction.bus_index as u32 + 1);\n196\t\n197\t            for (message_idx, message) in interaction.message.iter().enumerate() {\n198\t                let message_dag_idx =\n199\t                    dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n200\t                let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n201\t                denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];\n202\t            }\n203\t        }\n204\t        let d_numer_weights = numer_weights.to_device()?;\n205\t        let d_denom_weights = denom_weights.to_device()?;\n206\t        (rules, d_numer_weights, d_denom_weights, denom_sum_init)\n207\t    };\n208\t\n209\t    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n210\t    let d_rules = encoded_rules.to_device()?;\n211\t\n212\t    let buffer_size: u32 = rules.buffer_size.try_into().unwrap();\n213\t    let intermed_capacity = unsafe {\n214\t        _logup_r0_intermediates_buffer_size(\n215\t            buffer_size,\n216\t            skip_domain,\n217\t            num_x,\n218\t            num_cosets,\n219\t            max_temp_bytes,\n220\t        )\n221\t    };\n222\t    let mut intermediates = if intermed_capacity > 0 {\n223\t        debug!(\"logup_r0:intermediates_capacity={intermed_capacity}\");\n224\t        DeviceBuffer::<F>::with_capacity(intermed_capacity)\n225\t    } else {\n226\t        DeviceBuffer::<F>::new()\n227\t    };\n228\t\n229\t    let temp_sums_buffer_capacity = unsafe {\n230\t        _logup_r0_temp_sums_buffer_size(buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes)\n231\t    };\n232\t    debug!(\"logup_r0:tmp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n233\t    let mut temp_sums_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(temp_sums_buffer_capacity);\n234\t    let used_temp_bytes =\n235\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<Frac<EF>>();\n236\t    if used_temp_bytes > max_temp_bytes {\n237\t        warn!(\n238\t            \"logup_round0 used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\"\n239\t        );\n240\t    }\n241\t\n242\t    let preprocessed_ptr = pk\n243\t        .preprocessed_data\n244\t        .as_ref()\n245\t        .map(|cd| cd.trace.buffer().as_ptr())\n246\t        .unwrap_or(std::ptr::null());\n247\t\n248\t    let mut s_evals = DeviceBuffer::<Frac<EF>>::with_capacity(large_domain as usize);\n249\t\n250\t    unsafe {\n251\t        logup_bary_eval_interactions_round0(\n252\t            &mut temp_sums_buffer,\n253\t            &mut s_evals,\n254\t            selectors_cube,\n255\t            preprocessed_ptr,\n256\t            main_parts,\n257\t            eq_cube,\n258\t            public_values,\n259\t            &d_numer_weights,\n260\t            &d_denom_weights,\n261\t            denom_sum_init,\n262\t            &d_rules,\n263\t            buffer_size,\n264\t            &mut intermediates,\n265\t            skip_domain,\n266\t            num_x,\n267\t            height,\n268\t            num_cosets,\n269\t            g_shift,\n270\t            max_temp_bytes,\n271\t        )?;\n272\t    }\n273\t\n274\t    Ok(s_evals)\n275\t}\n276\t"}]},"parent_tool_use_id":"toolu_012iXBoiGLntjUndbWKRicBY","session_id":"f2fb024d-582e-4612-82c1-d7c12af7ab35","uuid":"6b6399a1-1eb8-4e01-92ae-b3b64c2ce775","timestamp":"2026-04-13T10:23:28.053Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TPArZRGZzngA9bedDvLTHg","type":"tool_result","content":"1\t//! Defines the symbolic rule data to precompute and store in the GPU proving key\n2\tuse itertools::Itertools;\n3\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer, error::MemCopyError};\n4\tuse openvm_stark_backend::{\n5\t    air_builders::symbolic::{\n6\t        symbolic_expression::SymbolicExpression,\n7\t        symbolic_variable::{Entry, SymbolicVariable},\n8\t        SymbolicConstraints, SymbolicDagBuilder, SymbolicExpressionDag,\n9\t    },\n10\t    keygen::types::StarkProvingKey,\n11\t    StarkProtocolConfig,\n12\t};\n13\tuse p3_field::PrimeCharacteristicRing;\n14\t\n15\tuse crate::{\n16\t    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n17\t    monomial::{\n18\t        ExpandedInteractionMonomials, ExpandedMonomials, InteractionMonomialTerm, LambdaTerm,\n19\t        MonomialHeader, PackedVar,\n20\t    },\n21\t    prelude::F,\n22\t};\n23\t\n24\tpub struct AirDataGpu {\n25\t    pub interaction_rules: InteractionEvalRules,\n26\t    /// Whether to buffer vars depends on the performance and memory access patterns of the kernel.\n27\t    /// This may be tuned.\n28\t    pub zerocheck_round0: ConstraintOnlyRules<true>,\n29\t    pub zerocheck_mle: ConstraintOnlyRules<false>,\n30\t    pub zerocheck_monomials: Option<ZerocheckMonomials>,\n31\t    pub interaction_monomials: Option<InteractionMonomials>,\n32\t}\n33\t\n34\t/// Used for GKR input evaluation and logup MLE sumcheck rounds.\n35\tpub struct InteractionEvalRules {\n36\t    pub(crate) inner: EvalRules,\n37\t    /// Constraints consist of all `(numer, denom)` pairs **topologically sorted**. We map the\n38\t    /// constraint idx back to unsorted order. ```text\n39\t    /// constraint_idx => 2 * interaction_idx + is_denom\n40\t    /// ```\n41\t    pub(crate) d_pair_idxs: DeviceBuffer<u32>,\n42\t    pub(crate) max_fields_len: usize,\n43\t}\n44\t\n45\t/// Constraints only, no interactions\n46\tpub struct ConstraintOnlyRules<const BUFFER_VARS: bool> {\n47\t    pub(crate) inner: EvalRules,\n48\t}\n49\t\n50\tpub struct EvalRules {\n51\t    /// Encoded rules\n52\t    pub d_rules: DeviceBuffer<u128>,\n53\t    pub d_used_nodes: DeviceBuffer<usize>,\n54\t    pub buffer_size: u32,\n55\t}\n56\t\n57\tpub struct ZerocheckMonomials {\n58\t    pub d_headers: DeviceBuffer<MonomialHeader>,\n59\t    pub d_variables: DeviceBuffer<PackedVar>,\n60\t    pub d_lambda_terms: DeviceBuffer<LambdaTerm<F>>,\n61\t    pub num_monomials: u32,\n62\t}\n63\t\n64\tpub struct InteractionMonomials {\n65\t    pub d_numer_headers: DeviceBuffer<MonomialHeader>,\n66\t    pub d_numer_variables: DeviceBuffer<PackedVar>,\n67\t    pub d_numer_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n68\t    pub num_numer_monomials: u32,\n69\t    pub d_denom_headers: DeviceBuffer<MonomialHeader>,\n70\t    pub d_denom_variables: DeviceBuffer<PackedVar>,\n71\t    pub d_denom_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n72\t    pub num_denom_monomials: u32,\n73\t    pub max_fields_len: usize,\n74\t    pub num_interactions: u32,\n75\t}\n76\t\n77\tfn to_device_or_empty<T>(data: &[T]) -> Result<DeviceBuffer<T>, MemCopyError> {\n78\t    if data.is_empty() {\n79\t        Ok(DeviceBuffer::new())\n80\t    } else {\n81\t        data.to_device()\n82\t    }\n83\t}\n84\t\n85\timpl AirDataGpu {\n86\t    pub fn new<S: StarkProtocolConfig<F = F>>(\n87\t        pk: &StarkProvingKey<S>,\n88\t    ) -> Result<Self, MemCopyError> {\n89\t        let dag = &pk.vk.symbolic_constraints;\n90\t        let symbolic_constraints = SymbolicConstraints::from(dag);\n91\t        let interaction_rules = InteractionEvalRules::new(&symbolic_constraints)?;\n92\t        let zerocheck_round0 = ConstraintOnlyRules::<true>::new(&dag.constraints)?;\n93\t        let zerocheck_mle = ConstraintOnlyRules::<false>::new(&dag.constraints)?;\n94\t\n95\t        let zerocheck_monomials = if dag.constraints.num_constraints() > 0 {\n96\t            let expanded = ExpandedMonomials::from_dag(&dag.constraints);\n97\t            Some(ZerocheckMonomials::from_expanded(&expanded)?)\n98\t        } else {\n99\t            None\n100\t        };\n101\t        let interaction_monomials = if !symbolic_constraints.interactions.is_empty() {\n102\t            let expanded =\n103\t                ExpandedInteractionMonomials::from_symbolic_constraints(&symbolic_constraints);\n104\t            Some(InteractionMonomials::from_expanded(&expanded)?)\n105\t        } else {\n106\t            None\n107\t        };\n108\t        Ok(Self {\n109\t            interaction_rules,\n110\t            zerocheck_round0,\n111\t            zerocheck_mle,\n112\t            zerocheck_monomials,\n113\t            interaction_monomials,\n114\t        })\n115\t    }\n116\t}\n117\t\n118\timpl ZerocheckMonomials {\n119\t    pub fn from_expanded(expanded: &ExpandedMonomials<F>) -> Result<Self, MemCopyError> {\n120\t        // Validate bounds for all monomial headers to prevent out-of-bounds access in CUDA kernel\n121\t        let num_variables = expanded.variables.len();\n122\t        let num_lambda_terms = expanded.lambda_terms.len();\n123\t        for (i, hdr) in expanded.headers.iter().enumerate() {\n124\t            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n125\t            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n126\t            assert!(\n127\t                var_end <= num_variables,\n128\t                \"Monomial {i}: var_offset ({}) + num_vars ({}) = {var_end} exceeds variables.len() ({num_variables})\",\n129\t                hdr.var_offset,\n130\t                hdr.num_vars\n131\t            );\n132\t            assert!(\n133\t                term_end <= num_lambda_terms,\n134\t                \"Monomial {i}: term_offset ({}) + num_terms ({}) = {term_end} exceeds lambda_terms.len() ({num_lambda_terms})\",\n135\t                hdr.term_offset,\n136\t                hdr.num_terms\n137\t            );\n138\t        }\n139\t\n140\t        Ok(Self {\n141\t            d_headers: expanded.headers.to_device()?,\n142\t            d_variables: expanded.variables.to_device()?,\n143\t            d_lambda_terms: expanded.lambda_terms.to_device()?,\n144\t            num_monomials: expanded.headers.len() as u32,\n145\t        })\n146\t    }\n147\t}\n148\t\n149\timpl InteractionMonomials {\n150\t    pub fn from_expanded(expanded: &ExpandedInteractionMonomials<F>) -> Result<Self, MemCopyError> {\n151\t        // Validate numerator monomial headers\n152\t        let num_numer_vars = expanded.numer_variables.len();\n153\t        let num_numer_terms = expanded.numer_terms.len();\n154\t        for (i, hdr) in expanded.numer_headers.iter().enumerate() {\n155\t            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n156\t            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n157\t            assert!(\n158\t                var_end <= num_numer_vars,\n159\t                \"Numer monomial {i}: var_offset + num_vars exceeds bounds\"\n160\t            );\n161\t            assert!(\n162\t                term_end <= num_numer_terms,\n163\t                \"Numer monomial {i}: term_offset + num_terms exceeds bounds\"\n164\t            );\n165\t        }\n166\t\n167\t        // Validate denominator monomial headers\n168\t        let num_denom_vars = expanded.denom_variables.len();\n169\t        let num_denom_terms = expanded.denom_terms.len();\n170\t        for (i, hdr) in expanded.denom_headers.iter().enumerate() {\n171\t            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n172\t            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n173\t            assert!(\n174\t                var_end <= num_denom_vars,\n175\t                \"Denom monomial {i}: var_offset + num_vars exceeds bounds\"\n176\t            );\n177\t            assert!(\n178\t                term_end <= num_denom_terms,\n179\t                \"Denom monomial {i}: term_offset + num_terms exceeds bounds\"\n180\t            );\n181\t        }\n182\t\n183\t        Ok(Self {\n184\t            d_numer_headers: to_device_or_empty(&expanded.numer_headers)?,\n185\t            d_numer_variables: to_device_or_empty(&expanded.numer_variables)?,\n186\t            d_numer_terms: to_device_or_empty(&expanded.numer_terms)?,\n187\t            num_numer_monomials: expanded.numer_headers.len() as u32,\n188\t            d_denom_headers: to_device_or_empty(&expanded.denom_headers)?,\n189\t            d_denom_variables: to_device_or_empty(&expanded.denom_variables)?,\n190\t            d_denom_terms: to_device_or_empty(&expanded.denom_terms)?,\n191\t            num_denom_monomials: expanded.denom_headers.len() as u32,\n192\t            max_fields_len: expanded.max_fields_len,\n193\t            num_interactions: expanded.num_interactions,\n194\t        })\n195\t    }\n196\t}\n197\t\n198\timpl InteractionEvalRules {\n199\t    pub fn new(symbolic_constraints: &SymbolicConstraints<F>) -> Result<Self, MemCopyError> {\n200\t        let interactions = &symbolic_constraints.interactions;\n201\t        let num_interactions = interactions.len();\n202\t        if num_interactions == 0 {\n203\t            return Ok(Self {\n204\t                inner: EvalRules::dummy(),\n205\t\n206\t                max_fields_len: 0,\n207\t                d_pair_idxs: DeviceBuffer::new(),\n208\t            });\n209\t        }\n210\t        let max_fields_len = interactions\n211\t            .iter()\n212\t            .map(|interaction| interaction.message.len())\n213\t            .max()\n214\t            .unwrap_or(0);\n215\t        // [alpha, beta^0, ..., beta^max_fields_len]\n216\t        let symbolic_challenges: Vec<SymbolicExpression<F>> = (0..max_fields_len + 2)\n217\t            .map(|index| SymbolicVariable::<F>::new(Entry::Challenge, index).into())\n218\t            .collect();\n219\t\n220\t        let mut frac_pairs = Vec::with_capacity(num_interactions * 2);\n221\t        for interaction in interactions.iter() {\n222\t            let numer = interaction.count.clone();\n223\t            let b = SymbolicExpression::from_u32(interaction.bus_index as u32 + 1);\n224\t            let betas = symbolic_challenges[1..].to_vec();\n225\t            let mut denom = SymbolicExpression::from_u32(0);\n226\t            for (j, expr) in interaction.message.iter().enumerate() {\n227\t                denom += betas[j].clone() * expr.clone();\n228\t            }\n229\t            denom += betas[interaction.message.len()].clone() * b;\n230\t            frac_pairs.push(numer);\n231\t            frac_pairs.push(denom);\n232\t        }\n233\t        // build DAG without sorting constraint idxs:\n234\t        let (dag, pair_idxs) = {\n235\t            let mut dag_builder = SymbolicDagBuilder::new();\n236\t            let mut dag_pair_idxs: Vec<(usize, u32)> = frac_pairs\n237\t                .iter()\n238\t                .enumerate()\n239\t                .map(|(pair_idx, expr)| {\n240\t                    let dag_idx = dag_builder.add_expr(expr);\n241\t                    (dag_idx, pair_idx.try_into().unwrap())\n242\t                })\n243\t                .collect_vec();\n244\t            dag_pair_idxs.sort();\n245\t            let (constraint_idx, pair_idxs): (Vec<_>, Vec<_>) = dag_pair_idxs.into_iter().unzip();\n246\t            // NOTE: do not sort pair_idxs since we need to keep them in pairs\n247\t            let dag = SymbolicExpressionDag {\n248\t                nodes: dag_builder.nodes,\n249\t                constraint_idx,\n250\t            };\n251\t            (dag, pair_idxs)\n252\t        };\n253\t        let rules = SymbolicRulesGpu::new(&dag, false);\n254\t        // Build used_nodes with duplicates, preserving order from constraint_idx\n255\t        let used_nodes = dag\n256\t            .constraint_idx\n257\t            .iter()\n258\t            .map(|&dag_idx| rules.dag_idx_to_rule_idx[&dag_idx])\n259\t            .collect_vec();\n260\t        let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n261\t        let d_rules = encoded_rules.to_device()?;\n262\t        let d_used_nodes = used_nodes.to_device()?;\n263\t        let d_pair_idxs = pair_idxs.to_device()?;\n264\t        assert_eq!(\n265\t            used_nodes.len(),\n266\t            2 * num_interactions,\n267\t            \"Rules come in (numer, denom) pairs\"\n268\t        );\n269\t\n270\t        let inner = EvalRules {\n271\t            d_rules,\n272\t            d_used_nodes,\n273\t            buffer_size: rules\n274\t                .buffer_size\n275\t                .try_into()\n276\t                .expect(\"buffer_size exceeds u32\"),\n277\t        };\n278\t\n279\t        Ok(Self {\n280\t            inner,\n281\t            d_pair_idxs,\n282\t            max_fields_len,\n283\t        })\n284\t    }\n285\t}\n286\t\n287\timpl<const BUFFER_VARS: bool> ConstraintOnlyRules<BUFFER_VARS> {\n288\t    pub fn new(dag: &SymbolicExpressionDag<F>) -> Result<Self, MemCopyError> {\n289\t        if dag.num_constraints() == 0 {\n290\t            return Ok(Self {\n291\t                inner: EvalRules::dummy(),\n292\t            });\n293\t        }\n294\t\n295\t        let rules = SymbolicRulesGpu::new(dag, BUFFER_VARS);\n296\t        // Build used_nodes with duplicates, preserving order from constraint_idx\n297\t        let used_nodes = dag\n298\t            .constraint_idx\n299\t            .iter()\n300\t            .map(|&dag_idx| rules.dag_idx_to_rule_idx[&dag_idx])\n301\t            .collect_vec();\n302\t\n303\t        let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n304\t        let d_rules = encoded_rules.to_device()?;\n305\t        let d_used_nodes = used_nodes.to_device()?;\n306\t\n307\t        let inner = EvalRules {\n308\t            d_rules,\n309\t            d_used_nodes,\n310\t            buffer_size: rules\n311\t                .buffer_size\n312\t                .try_into()\n313\t                .expect(\"buffer_size exceeds u32\"),\n314\t        };\n315\t        Ok(Self { inner })\n316\t    }\n317\t}\n318\t\n319\timpl EvalRules {\n320\t    pub fn dummy() -> Self {\n321\t        Self {\n322\t            d_rules: DeviceBuffer::new(),\n323\t            d_used_nodes: DeviceBuffer::new(),\n324\t            buffer_size: 0,\n325\t        }\n326\t    }\n327\t}\n328\t"}]},"parent_tool_use_id":"toolu_012iXBoiGLntjUndbWKRicBY","session_id":"f2fb024d-582e-4612-82c1-d7c12af7ab35","uuid":"8b95afb8-32e3-4e6d-b5ce-732a2bedf5a4","timestamp":"2026-04-13T10:23:28.281Z"}
