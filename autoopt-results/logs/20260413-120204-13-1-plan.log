{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gh21BeeZRVmxXX7YyzkUGD","type":"tool_result","content":"1\t#include \"codec.cuh\"\n2\t#include \"dag_entry.cuh\"\n3\t#include \"eval_config.cuh\"\n4\t#include \"fp.h\"\n5\t#include \"fpext.h\"\n6\t#include \"frac_ext.cuh\"\n7\t#include \"launcher.cuh\"\n8\t#include \"sumcheck.cuh\"\n9\t#include \"utils.cuh\"\n10\t#include <algorithm>\n11\t#include <cmath>\n12\t#include <cstddef>\n13\t#include <cstdint>\n14\t#include <utility>\n15\t#include <vector_types.h>\n16\t\n17\tusing namespace symbolic_dag;\n18\t\n19\tnamespace logup_round0 {\n20\t\n21\t// NOTE[jpw]: keeping separate from zerocheck so it can be tuned separately\n22\tconstexpr uint32_t BUFFER_THRESHOLD = 16;\n23\t// Threshold for switching between coset-parallel and lockstep modes.\n24\t// When num_x * skip_domain < threshold, use coset-parallel (grid.y = num_cosets) for better GPU utilization.\n25\t// When >= threshold, use lockstep (single thread handles all cosets) to avoid redundant iNTT.\n26\tconstexpr uint32_t COSET_PARALLEL_THRESHOLD = 32768; // 2^15\n27\t\n28\t// Device function to evaluate interactions for all cosets in lockstep with DAG traversal.\n29\t// Computes numerator and denominator sums for each coset.\n30\t// NOTE: Using __inline__ instead of __forceinline__ to let compiler decide based on register pressure.\n31\t//\n32\t// Template params:\n33\t// - FIRST_COSET_IS_IDENTITY: compile-time flag for lockstep kernel when coset 0 has shift=1\n34\t// Runtime params:\n35\t// - skip_ntt: runtime flag for coset-parallel kernel when processing identity coset\n36\ttemplate <uint32_t NUM_COSETS, bool NEEDS_SHMEM, bool FIRST_COSET_IS_IDENTITY = false>\n37\t__device__ __inline__ void acc_interactions(\n38\t    const NttEvalContext<NUM_COSETS> &eval_ctx,\n39\t    const Fp *is_first, // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n40\t    const Fp *is_last,  // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n41\t    uint32_t x_int,\n42\t    const FpExt *__restrict__ numer_weights,\n43\t    const FpExt *__restrict__ denom_weights,\n44\t    const Rule *__restrict__ d_rules,\n45\t    size_t rules_len,\n46\t    FpExt *__restrict__ numer_sums, // output [NUM_COSETS]\n47\t    FpExt *__restrict__ denom_sums, // output [NUM_COSETS]\n48\t    bool skip_ntt = false           // Runtime flag for identity coset\n49\t) {\n50\t    // Initialize sums to zero\n51\t#pragma unroll\n52\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n53\t        numer_sums[c] = FpExt(Fp::zero());\n54\t        denom_sums[c] = FpExt(Fp::zero());\n55\t    }\n56\t\n57\t    for (size_t node = 0; node < rules_len; ++node) {\n58\t        Rule rule = d_rules[node];\n59\t        // Lazy decoding: only decode header (op, flags, x) upfront\n60\t        RuleHeader header = decode_rule_header(rule);\n61\t\n62\t        // Evaluate x operand for all cosets\n63\t        Fp x_vals[NUM_COSETS];\n64\t        ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n65\t            x_vals, header.x, eval_ctx, is_first, is_last, x_int, skip_ntt\n66\t        );\n67\t\n68\t        Fp results[NUM_COSETS];\n69\t\n70\t        switch (header.op) {\n71\t        case OP_ADD: {\n72\t            // Decode y only for binary ops\n73\t            SourceInfo y_src = decode_y(rule);\n74\t            Fp y_vals[NUM_COSETS];\n75\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n76\t                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n77\t            );\n78\t#pragma unroll\n79\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n80\t                results[c] = x_vals[c] + y_vals[c];\n81\t            }\n82\t            break;\n83\t        }\n84\t        case OP_SUB: {\n85\t            SourceInfo y_src = decode_y(rule);\n86\t            Fp y_vals[NUM_COSETS];\n87\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n88\t                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n89\t            );\n90\t#pragma unroll\n91\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n92\t                results[c] = x_vals[c] - y_vals[c];\n93\t            }\n94\t            break;\n95\t        }\n96\t        case OP_MUL: {\n97\t            SourceInfo y_src = decode_y(rule);\n98\t            Fp y_vals[NUM_COSETS];\n99\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM, FIRST_COSET_IS_IDENTITY>(\n100\t                y_vals, y_src, eval_ctx, is_first, is_last, x_int, skip_ntt\n101\t            );\n102\t#pragma unroll\n103\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n104\t                results[c] = x_vals[c] * y_vals[c];\n105\t            }\n106\t            break;\n107\t        }\n108\t        case OP_NEG:\n109\t#pragma unroll\n110\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n111\t                results[c] = -x_vals[c];\n112\t            }\n113\t            break;\n114\t        case OP_VAR:\n115\t#pragma unroll\n116\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n117\t                results[c] = x_vals[c];\n118\t            }\n119\t            break;\n120\t        case OP_INV:\n121\t#pragma unroll\n122\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n123\t                results[c] = inv(x_vals[c]);\n124\t            }\n125\t            break;\n126\t        }\n127\t\n128\t        // Store intermediate results for all cosets\n129\t        // Decode z_index only when buffering\n130\t        if (header.buffer_result && eval_ctx.buffer_size > 0) {\n131\t            uint32_t z_index = decode_z_index(rule);\n132\t#ifdef CUDA_DEBUG\n133\t            assert(z_index < eval_ctx.buffer_size);\n134\t#endif\n135\t            // Intermediate buffer layout: [buffer_size][NUM_COSETS] per thread\n136\t#pragma unroll\n137\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n138\t                eval_ctx.inter_buffer[z_index * eval_ctx.buffer_stride + c] = results[c];\n139\t            }\n140\t        }\n141\t\n142\t        // Accumulate interaction sums\n143\t        if (header.is_constraint) {\n144\t            FpExt numer_w = numer_weights[node];\n145\t            FpExt denom_w = denom_weights[node];\n146\t#pragma unroll\n147\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n148\t                numer_sums[c] += numer_w * results[c];\n149\t                denom_sums[c] += denom_w * results[c];\n150\t            }\n151\t        }\n152\t    }\n153\t}\n154\t\n155\t// ============================================================================\n156\t// KERNELS\n157\t// ============================================================================\n158\t\n159\t// Round0 phase interactions kernel - each thread handles ALL cosets in lockstep\n160\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n161\t__global__ void logup_r0_ntt_eval_interactions_kernel(\n162\t    FracExt *__restrict__ tmp_sums_buffer, // [NUM_COSETS][gridDim.x][skip_domain]\n163\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n164\t    const Fp *__restrict__ preprocessed,\n165\t    const Fp *const *__restrict__ main_parts,\n166\t    const FpExt *__restrict__ eq_cube, // [num_x]\n167\t    const Fp *__restrict__ public_values,\n168\t    const FpExt *__restrict__ numer_weights,\n169\t    const FpExt *__restrict__ denom_weights,\n170\t    FpExt denom_sum_init,\n171\t    const Rule *__restrict__ d_rules,\n172\t    size_t rules_len,\n173\t    uint32_t buffer_size,\n174\t    Fp *__restrict__ d_intermediates,\n175\t    uint32_t skip_domain,\n176\t    uint32_t num_x,\n177\t    uint32_t height,\n178\t    Fp g_shift\n179\t) {\n180\t    extern __shared__ char smem[];\n181\t    // Shared memory layout:\n182\t    // - FracExt[blockDim.x]: shared_sum for reduction (reused per coset)\n183\t    // - Fp[blockDim.x]: ntt_buffers (one skip_domain-sized buffer per x_int group, only when NEEDS_SHMEM)\n184\t    FracExt *shared_sum = reinterpret_cast<FracExt *>(smem);\n185\t    Fp *ntt_buffers_base =\n186\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FracExt)) : nullptr;\n187\t\n188\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n189\t\n190\t    // Each x_int group within the block gets its own ntt_buffer slice\n191\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n192\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n193\t\n194\t    // Thread layout: ntt_idx varies fastest, then x_int\n195\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n196\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n197\t    uint32_t const x_int_base = tidx >> l_skip;\n198\t\n199\t    // Precompute values needed for all cosets\n200\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);"}]},"parent_tool_use_id":"toolu_01AE632a5Wp2Z56rx9eKSbLF","session_id":"f2fb024d-582e-4612-82c1-d7c12af7ab35","uuid":"ce0e74c3-c58b-4c61-ab67-0032c5abdf85","timestamp":"2026-04-13T10:09:26.086Z"}
