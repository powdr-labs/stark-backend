\t    const FpExt *eq_cube,\n605\t    const FpExt *d_lambda_pows,\n606\t    const Fp *public_values,\n607\t    const Rule *d_rules,\n608\t    size_t rules_len,\n609\t    const size_t *d_used_nodes,\n610\t    size_t used_nodes_len,\n611\t    size_t lambda_len,\n612\t    uint32_t buffer_size,\n613\t    Fp *d_intermediates,\n614\t    uint32_t skip_domain,\n615\t    uint32_t num_x,\n616\t    uint32_t height,\n617\t    uint32_t num_cosets,\n618\t    Fp g_shift,\n619\t    size_t max_temp_bytes\n620\t) {\n621\t    auto [grid, block] = coset_parallel_round0_config::eval_constraints_launch_params(\n622\t        buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n623\t    );\n624\t\n625\t    size_t shared_sum_size = sizeof(FpExt) * block.x;\n626\t    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n627\t    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n628\t\n629\t    zerocheck_ntt_evaluate_constraints_coset_parallel_kernel<GLOBAL, NEEDS_SHMEM>\n630\t        <<<grid, block, shmem_bytes>>>(\n631\t            tmp_sums_buffer,\n632\t            selectors_cube,\n633\t            preprocessed,\n634\t            main_parts,\n635\t            eq_cube,\n636\t            d_lambda_pows,\n637\t            public_values,\n638\t            d_rules,\n639\t            rules_len,\n640\t            d_used_nodes,\n641\t            used_nodes_len,\n642\t            lambda_len,\n643\t            buffer_size,\n644\t            d_intermediates,\n645\t            skip_domain,\n646\t            num_x,\n647\t            height,\n648\t            g_shift\n649\t        );"}]},"parent_tool_use_id":"toolu_01AE632a5Wp2Z56rx9eKSbLF","session_id":"f2fb024d-582e-4612-82c1-d7c12af7ab35","uuid":"a96d6177-d282-4026-8c07-cfaa3a63aa20","timestamp":"2026-04-13T10:09:22.334Z"}
