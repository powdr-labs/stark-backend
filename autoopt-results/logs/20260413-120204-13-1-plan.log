{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014X42dNqJSMAhv1S3RToGfx","type":"tool_result","content":"414\tpub(crate) fn evaluate_zerocheck_batched<'a, HS: GpuHashScheme>(\n415\t    traces: impl IntoIterator<Item = &'a TraceCtx>,\n416\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n417\t    lambda_pows: &DeviceBuffer<EF>,\n418\t    num_x: u32,\n419\t    zc_out: &mut [Vec<EF>],\n420\t    memory_limit_bytes: usize,\n421\t) -> Result<(), KernelError> {\n422\t    // Collect traces with constraints and their buffer sizes\n423\t    let mut zc_traces_with_size: Vec<(&TraceCtx, usize)> = traces\n424\t        .into_iter()\n425\t        .filter(|t| t.has_constraints)\n426\t        .map(|t| {\n427\t            let buffer_size = pk.per_air[t.air_idx]\n428\t                .other_data\n429\t                .zerocheck_mle\n430\t                .inner\n431\t                .buffer_size;\n432\t            let mem = zerocheck_batch_mle_intermediates_buffer_bytes(buffer_size, num_x, t.num_y);\n433\t            (t, mem)\n434\t        })\n435\t        .collect();\n436\t    if zc_traces_with_size.is_empty() {\n437\t        return Ok(());\n438\t    }\n439\t\n440\t    // Sort by buffer size descending for better bin packing (First Fit Decreasing)\n441\t    zc_traces_with_size.sort_by(|a, b| b.1.cmp(&a.1));\n442\t\n443\t    let num_x_usize = num_x as usize;\n444\t    let mut batch_start = 0;\n445\t\n446\t    while batch_start < zc_traces_with_size.len() {\n447\t        let (batch_count, batch_memory) = find_batch_end(\n448\t            &zc_traces_with_size[batch_start..],\n449\t            |(_, mem)| *mem,\n450\t            memory_limit_bytes,\n451\t        );\n452\t        let batch: Vec<&TraceCtx> = zc_traces_with_size[batch_start..batch_start + batch_count]\n453\t            .iter()\n454\t            .map(|(t, _)| *t)\n455\t            .collect();\n456\t\n457\t        if batch.len() == 1 {\n458\t            // Single trace: use non-batch kernel