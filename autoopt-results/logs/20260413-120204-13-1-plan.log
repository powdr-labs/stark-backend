l\n291\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n292\t            sums[c].p += eq * numer_results[c];\n293\t            sums[c].q += eq * (denom_results[c] + denom_sum_init);\n294\t        }\n295\t    }\n296\t\n297\t    // Reduction: one coset at a time to minimize shared memory\n298\t#pragma unroll\n299\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n300\t        shared_sum[threadIdx.x] = sums[c];\n301\t        __syncthreads();\n302\t\n303\t        if (threadIdx.x < skip_domain) {\n304\t            FracExt tile_sum = shared_sum[threadIdx.x];\n305\t            for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n306\t                auto lane_offset = (lane << l_skip) + threadIdx.x;\n307\t                tile_sum.p += shared_sum[lane_offset].p;\n308\t                tile_sum.q += shared_sum[lane_offset].q;\n309\t            }\n310\t            // Output layout: [num_blocks][NUM_COSETS * skip_domain]\n311\t            // This matches final_reduce_block_sums expected [num_blocks][d] layout\n312\t            tmp_sums_buffer[blockIdx.x * NUM_COSETS * skip_domain + c * skip_domain + ntt_idx] =\n313\t                tile_sum;\n314\t        }\n315\t        __syncthreads();\n316\t    }\n317\t}\n318\t\n319\t// Coset-parallel kernel: grid.y = num_cosets, each block handles ONE coset.\n320\t// Uses acc_interactions<1, NEEDS_SHMEM> with explicit parameter passing.\n321\t// Use when num_x * skip_domain is small for better GPU utilization.\n322\ttemplate <bool GLOBAL, bool NEEDS_SHMEM>\n323\t__global__ void logup_r0_ntt_eval_interactions_coset_parallel_kernel(\n324\t    FracExt *__restrict__ tmp_sums_buffer, // [num_blocks][num_cosets * skip_domain]\n325\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n326\t    const Fp *__restrict__ preprocessed,\n327\t    const Fp *const *__restrict__ main_parts,\n328\t    const FpExt *__restrict__ eq_cube, // [num_x]\n329\t    const Fp *__restrict__ public_values,\n330\t    const FpExt *__restrict__ numer_weights,\n331\t    const FpExt *__restrict__ denom_weights,\n332\t    FpExt denom_sum_init,\n333\t    const Rule *__restrict__ d_rules,\n334\t    size_t rules_len,\n335\t    uint32_t buffer_size,\n336\t    Fp *__restrict__ d_intermediates,\n337\t    uint32_t skip_domain,\n338\t    uint32_t num_x,\n339\t    uint32_t height,\n340\t    Fp g_shift\n341\t) {\n342\t    extern __shared__ char smem[];\n343\t    FracExt *shared_sum = reinterpret_cast<FracExt *>(smem);\n344\t    Fp *ntt_buffers_base =\n345\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FracExt)) : nullptr;\n346\t\n347\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n348\t    uint32_t const num_cosets = gridDim.y;\n349\t\n350\t    // Each x_int group within the block gets its own ntt_buffer slice\n351\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n352\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n353\t\n354\t    // Thread layout: ntt_idx varies fastest, then x_int\n355\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n356\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n357\t    uint32_t const x_int_base = tidx >> l_skip;\n358\t\n359\t    // KEY DIFFERENCE: coset_idx from blockIdx.y\n360\t    uint32_t const coset_idx = blockIdx.y;\n361\t    bool const is_identity_coset = (coset_idx == 0);\n362\t\n363\t    // Precompute values for this single coset\n364\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n365\t    Fp const omega_skip = TWO_ADIC_GENERATORS[l_skip];\n366\t\n367\t    uint32_t const log_height_total = __ffs(height) - 1;\n368\t    uint32_t const log_segment = min(l_skip, log_height_total);\n369\t    uint32_t const segment_size = 1u << log_segment;\n370\t    uint32_t const log_stride = l_skip - log_segment;\n371\t\n372\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n373\t    Fp const omega_skip_ntt = pow(omega_skip, ntt_idx);\n374\t\n375\t    // Compute for single coset: coset 0 has shift=1, rest have shift=g^coset_idx\n376\t    Fp const g_coset = is_identity_coset ? Fp::one() : pow(g_shift, coset_idx);\n377\t    Fp const eval_point = is_identity_coset ? omega_skip_ntt : (g_coset * omega_skip_ntt);\n378\t    Fp const omega = exp_power_of_2(eval_point, log_stride);\n379\t    Fp const is_first_mult = avg_gp(omega, segment_size);\n380\t    Fp const is_last_mult = avg_gp(omega * eta, segment_size);\n381\t    Fp const omega_shift = is_identity_coset ? Fp::one() : pow(g_coset, ntt_idx_rev);\n382\t\n383\t    // Intermediate buffer setup (single coset, no NUM_COSETS multiplier)\n384\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD];\n385\t    Fp *inter_buffer;\n386\t    uint32_t buffer_stride;\n387\t    if constexpr (GLOBAL) {\n388\t        // Layout: [buffer_size][num_cosets * num_threads_per_coset]\n389\t        uint32_t global_tidx = coset_idx * gridDim.x * blockDim.x + tidx;\n390\t        inter_buffer = d_intermediates + global_tidx;\n391\t        buffer_stride = gridDim.x * gridDim.y * blockDim.x;\n392\t    } else {\n393\t        inter_buffer = local_buffer;\n394\t        buffer_stride = 1;\n395\t    }\n396\t\n397\t    FracExt sum = {FpExt(Fp::zero()), FpExt(Fp::zero())};\n398\t\n399\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;"}]},"parent_tool_use_id":"toolu_01AE632a5Wp2Z56rx9eKSbLF","session_id":"f2fb024d-582e-4612-82c1-d7c12af7ab35","uuid":"0a5a7d59-696b-461e-829e-d682710e2ac0","timestamp":"2026-04-13T10:09:29.393Z"}
