{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ldc21su5McdEqhCjixrNKf","type":"tool_result","content":"200\t        (l_skip == 0) ? Fp::one() : device_ntt::get_twiddle(l_skip, ntt_idx);\n201\t\n202\t    Fp g_coset = g_shift; // g^1, will iterate g^2, g^3, ...\n203\t#pragma unroll\n204\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n205\t        Fp eval_point = g_coset * omega_skip_ntt;\n206\t        Fp omega = exp_power_of_2(eval_point, log_stride);\n207\t        is_first_mult[c] = avg_gp(omega, segment_size);\n208\t        is_last_mult[c] = avg_gp(omega * eta, segment_size);\n209\t        g_coset *= g_shift; // g^(c+2) for next iteration\n210\t    }\n211\t\n212\t    // Intermediate buffer setup\n213\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD * NUM_COSETS];\n214\t    Fp *inter_buffer;\n215\t    uint32_t buffer_stride;\n216\t    if constexpr (GLOBAL) {\n217\t        // Layout: [buffer_size][num_threads][NUM_COSETS]\n218\t        inter_buffer = d_intermediates + tidx * NUM_COSETS;\n219\t        buffer_stride = gridDim.x * blockDim.x * NUM_COSETS;\n220\t    } else {\n221\t        inter_buffer = local_buffer;\n222\t        buffer_stride = NUM_COSETS;\n223\t    }\n224\t\n225\t    // Accumulate sums for all cosets\n226\t    FpExt sums[NUM_COSETS] = {};\n227\t\n228\t    // blockDim.x is guaranteed to be a multiple of 2^l_skip\n229\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n230\t\n231\t    // Initialize eval_ctx once with loop-invariant fields\n232\t    NttEvalContext<NUM_COSETS> eval_ctx{\n233\t        preprocessed,\n234\t        main_parts,\n235\t        public_values,\n236\t        inter_buffer,\n237\t        ntt_buffer,\n238\t        {}, // omega_shifts - set once below\n239\t        skip_domain,\n240\t        height,\n241\t        buffer_stride,\n242\t        buffer_size,\n243\t        ntt_idx,\n244\t    };\n245\t    // Compute omega_shifts directly into context using iterative multiplication\n246\t    Fp const omega_shift_base = pow(g_shift, ntt_idx_rev);\n247\t    Fp omega_shift = omega_shift_base;\n248\t#pragma unroll\n249\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n250\t        eval_ctx.omega_shifts[c] = omega_shift;\n251\t        omega_shift *= omega_shift_base;\n252\t    }\n253\t\n254\t    // Tile across x_int to save intermediate buffer size\n255\t    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n256\t        // Compute per-iteration selectors as fresh local values\n257\t        Fp is_first[NUM_COSETS];\n258\t        Fp is_last[NUM_COSETS];\n259\t#pragma unroll\n260\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n261\t            is_first[c] = is_first_mult[c] * selectors_cube[x_int];\n262\t            is_last[c] = is_last_mult[c] * selectors_cube[2 * num_x + x_int];\n263\t        }\n264\t\n265\t        FpExt constraint_sums[NUM_COSETS];\n266\t        acc_constraints<NUM_COSETS, NEEDS_SHMEM>(\n267\t            constraint_sums,\n268\t            eval_ctx,\n269\t            is_first,\n270\t            is_last,\n271\t            x_int,\n272\t            d_lambda_pows,\n273\t            d_rules,\n274\t            rules_len,\n275\t            d_used_nodes,\n276\t            used_nodes_len,\n277\t            lambda_len\n278\t        );\n279\t\n280\t        FpExt eq = eq_cube[x_int];\n281\t#pragma unroll\n282\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n283\t            sums[c] += constraint_sums[c] * eq;\n284\t        }\n285\t    }\n286\t\n287\t    // Reduction: one coset at a time to minimize shared memory\n288\t    // Recompute eval_point and zerofier on demand (saves registers during main loop)\n289\t    g_coset = g_shift; // reset to g^1\n290\t#pragma unroll\n291\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n292\t        Fp eval_point = g_coset * omega_skip_ntt;\n293\t        Fp zerofier = exp_power_of_2(eval_point, l_skip) - Fp::one();\n294\t\n295\t        // We assume g_shift is not in skip domain and since we use (c+1) power,\n296\t        // eval_point is never in skip domain. Hence zerofier is never zero.\n297\t        shared_sum[threadIdx.x] = sums[c] * inv(zerofier);\n298\t        __syncthreads();\n299\t\n300\t        if (threadIdx.x < skip_domain) {\n301\t            FpExt tile_sum = shared_sum[threadIdx.x];\n302\t            for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n303\t                tile_sum += shared_sum[(lane << l_skip) + threadIdx.x];\n304\t            }\n305\t            // Output layout: [num_blocks][NUM_COSETS * skip_domain]\n306\t            // This matches final_reduce_block_sums expected layout [num_blocks][d]\n307\t            tmp_sums_buffer[blockIdx.x * NUM_COSETS * skip_domain + c * skip_domain + ntt_idx] =\n308\t                tile_sum;\n309\t        }\n310\t        __syncthreads();\n311\t        g_coset *= g_shift;\n312\t    }\n313\t}\n314\t\n315\t__global__ void fold_selectors_round0_kernel(\n316\t    FpExt *out,\n317\t    const Fp *in,\n318\t    FpExt is_first,\n319\t    FpExt is_last,\n320\t    uint32_t num_x\n321\t) {\n322\t    size_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n323\t    if (tidx >= num_x)\n324\t        return;\n325\t\n326\t    out[tidx] = is_first * in[tidx];                              // is_first\n327\t    out[2 * num_x + tidx] = is_last * in[2 * num_x + tidx];       // is_last\n328\t    out[num_x + tidx] = FpExt(Fp::one()) - out[2 * num_x + tidx]; // is_transition\n329\t}\n330\t\n331\t// Coset-parallel kernel: grid.y = num_cosets, each block handles ONE coset.\n332\t// Uses acc_constraints<1, NEEDS_SHMEM> with explicit parameter passing.\n333\t// Use when num_x * skip_domain is small for better GPU utilization.\n334\ttemplate <bool GLOBAL, bool NEEDS_SHMEM>\n335\t__global__ void zerocheck_ntt_evaluate_constraints_coset_parallel_kernel(\n336\t    FpExt *__restrict__ tmp_sums_buffer,   // [num_blocks][num_cosets * skip_domain]\n337\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n338\t    const Fp *__restrict__ preprocessed,\n339\t    const Fp *const *__restrict__ main_parts,\n340\t    const FpExt *__restrict__ eq_cube, // [num_x]\n341\t    const FpExt *__restrict__ d_lambda_pows,\n342\t    const Fp *__restrict__ public_values,\n343\t    const Rule *__restrict__ d_rules,\n344\t    size_t rules_len,\n345\t    const size_t *__restrict__ d_used_nodes,\n346\t    size_t used_nodes_len,\n347\t    size_t lambda_len,\n348\t    uint32_t buffer_size,\n349\t    Fp *__restrict__ d_intermediates,"}]},"parent_tool_use_id":"toolu_01AE632a5Wp2Z56rx9eKSbLF","session_id":"f2fb024d-582e-4612-82c1-d7c12af7ab35","uuid":"17399091-2dc3-4f75-974f-f828a70e33ff","timestamp":"2026-04-13T10:09:19.236Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016ZCt15Hm7TN6WzUXVPRJYj","type":"tool_result","content":"1\t//! Batched monomial-based MLE evaluation for zerocheck and logup.\n2\t//!\n3\t//! This module provides batch evaluators for monomial evaluations across multiple AIRs,\n4\t//! enabling efficient GPU kernel launches that process multiple traces in a single launch.\n5\t\n6\tuse openvm_cuda_common::{\n7\t    copy::MemCopyH2D,\n8\t    d_buffer::DeviceBuffer,\n9\t    error::{CudaError, MemCopyError},\n10\t};\n11\tuse openvm_stark_backend::prover::{fractional_sumcheck_gkr::Frac, DeviceMultiStarkProvingKey};\n12\tuse p3_field::PrimeCharacteristicRing;\n13\tuse tracing::debug;\n14\t\n15\tuse crate::{\n16\t    cuda::logup_zerocheck::{\n17\t        logup_monomial_batched, precompute_lambda_combinations,\n18\t        precompute_logup_denom_combinations, precompute_logup_numer_combinations,\n19\t        zerocheck_monomial_batched, zerocheck_monomial_par_y_batched, BlockCtx, EvalCoreCtx,\n20\t        LogupMonomialCommonCtx, LogupMonomialCtx, MonomialAirCtx,\n21\t    },\n22\t    error::KernelError,\n23\t    gpu_backend::GenericGpuBackend,\n24\t    hash_scheme::GpuHashScheme,\n25\t    logup_zerocheck::batch_mle::TraceCtx,\n26\t    prelude::EF,\n27\t};\n28\t\n29\tconst THREADS_PER_BLOCK: u32 = 256;\n30\t\n31\t/// Returns true if the trace can use the monomial evaluation path.\n32\t///\n33\t/// A trace is eligible if it has constraints and the AIR has expanded monomials.\n34\tpub(crate) fn trace_has_monomials<HS: GpuHashScheme>(\n35\t    trace: &TraceCtx,\n36\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n37\t) -> bool {\n38\t    trace.has_constraints\n39\t        && pk.per_air[trace.air_idx]\n40\t            .other_data\n41\t            .zerocheck_monomials\n42\t            .as_ref()\n43\t            .map(|m| m.num_monomials > 0)\n44\t            .unwrap_or(false)\n45\t}\n46\t\n47\t/// Get the number of monomials for a trace. Returns 0 if the trace has no monomials.\n48\tpub(crate) fn get_num_monomials<HS: GpuHashScheme>(\n49\t    trace: &TraceCtx,\n50\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n51\t) -> u32 {\n52\t    pk.per_air[trace.air_idx]\n53\t        .other_data\n54\t        .zerocheck_monomials\n55\t        .as_ref()\n56\t        .map(|m| m.num_monomials)\n57\t        .unwrap_or(0)\n58\t}\n59\t\n60\t/// Get the rules_len for a trace's zerocheck DAG.\n61\tpub(crate) fn get_zerocheck_rules_len<HS: GpuHashScheme>(\n62\t    trace: &TraceCtx,\n63\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n64\t) -> usize {\n65\t    pk.per_air[trace.air_idx]\n66\t        .other_data\n67\t        .zerocheck_mle\n68\t        .inner\n69\t        .d_rules\n70\t        .len()\n71\t}\n72\t\n73\t/// Precompute lambda combinations for a single AIR's monomials.\n74\t///\n75\t/// Returns a buffer of length `num_monomials` where each element is\n76\t/// `sum_l(coefficient_l * lambda_pows[constraint_idx_l])` for that monomial.\n77\t///\n78\t/// The AIR must have nonempty monomials.\n79\tpub(crate) fn compute_lambda_combinations<HS: GpuHashScheme>(\n80\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n81\t    air_idx: usize,\n82\t    lambda_pows: &DeviceBuffer<EF>,\n83\t) -> Result<DeviceBuffer<EF>, CudaError> {\n84\t    let monomials = pk.per_air[air_idx]\n85\t        .other_data\n86\t        .zerocheck_monomials\n87\t        .as_ref()\n88\t        .expect(\"AIR must have monomials\");\n89\t    let mut buf = DeviceBuffer::<EF>::with_capacity(monomials.num_monomials as usize);\n90\t    unsafe {\n91\t        precompute_lambda_combinations(\n92\t            &mut buf,\n93\t            monomials.d_headers.as_ptr(),\n94\t            monomials.d_lambda_terms.as_ptr(),\n95\t            lambda_pows,\n96\t            monomials.num_monomials,\n97\t        )?;\n98\t    }\n99\t    Ok(buf)\n100\t}\n101\t\n102\t/// Batch evaluator for monomial-based zerocheck MLE evaluation.\n103\t///\n104\t/// Pre-builds GPU contexts for all traces, then evaluates in a single kernel launch.\n105\t///\n106\t/// The caller must filter traces using [`trace_has_monomials`] before constructing.\n107\t/// The batch must contain at least one trace.\n108\t///\n109\t/// The struct holds references to `TraceCtx` which guarantees the underlying\n110\t/// device buffers (including `main_ptrs_dev`) remain valid for the struct's lifetime.\n111\tpub(crate) struct ZerocheckMonomialBatch<'a> {\n112\t    traces: Vec<&'a TraceCtx>,\n113\t    block_ctxs: DeviceBuffer<BlockCtx>,\n114\t    air_ctxs: DeviceBuffer<MonomialAirCtx>,\n115\t    air_offsets: DeviceBuffer<u32>,\n116\t}\n117\t\n118\timpl<'a> ZerocheckMonomialBatch<'a> {\n119\t    /// Creates a new batch from an iterator of traces.\n120\t    ///\n121\t    /// `lambda_combinations` must contain one buffer per trace (in iteration order),\n122\t    /// each precomputed via [`compute_lambda_combinations`].\n123\t    ///\n124\t    /// # Panics\n125\t    ///\n126\t    /// Panics if `traces` is empty or if `lambda_combinations` length doesn't match.\n127\t    pub fn new<HS: GpuHashScheme>(\n128\t        traces: impl IntoIterator<Item = &'a TraceCtx>,\n129\t        pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n130\t        lambda_combinations: &[&DeviceBuffer<EF>],\n131\t    ) -> Result<Self, MemCopyError> {\n132\t        let traces: Vec<_> = traces.into_iter().collect();\n133\t        assert!(\n134\t            !traces.is_empty(),\n135\t            \"ZerocheckMonomialBatch requires at least one trace\"\n136\t        );\n137\t        assert_eq!(\n138\t            traces.len(),\n139\t            lambda_combinations.len(),\n140\t            \"lambda_combinations must have one buffer per trace\"\n141\t        );\n142\t\n143\t        let threads_per_block = THREADS_PER_BLOCK;\n144\t\n145\t        // Build block_ctxs and air_offsets\n146\t        // For each AIR: total_blocks = ceil(num_monomials / tpb) * num_y\n147\t        // local_block_idx_x encodes (y_int * mono_blocks + mono_block_idx)\n148\t        let mut block_ctxs_h: Vec<BlockCtx> = Vec::new();\n149\t        let mut air_offsets: Vec<u32> = Vec::with_capacity(traces.len() + 1);\n150\t        air_offsets.push(0);\n151\t\n152\t        for (local_air, t) in traces.iter().enumerate() {\n153\t            let monomials = pk.per_air[t.air_idx]\n154\t                .other_data\n155\t                .zerocheck_monomials\n156\t                .as_ref()\n157\t                .unwrap();\n158\t            let mono_blocks = monomials.num_monomials.div_ceil(threads_per_block);\n159\t            let total_blocks = mono_blocks * t.num_y;\n160\t\n161\t            for local_idx in 0..total_blocks {\n162\t                block_ctxs_h.push(BlockCtx {\n163\t                    local_block_idx_x: local_idx,\n164\t                    air_idx: local_air as u32,\n165\t                });\n166\t            }\n167\t            air_offsets.push(block_ctxs_h.len() as u32);\n168\t        }\n169\t\n170\t        // Build MonomialAirCtx for each trace\n171\t        let air_ctxs_h: Vec<MonomialAirCtx> = traces\n172\t            .iter()\n173\t            .zip(lambda_combinations)\n174\t            .map(|(t, lc)| {\n175\t                let monomials = pk.per_air[t.air_idx]\n176\t                    .other_data\n177\t                    .zerocheck_monomials\n178\t                    .as_ref()\n179\t                    .unwrap();\n180\t\n181\t                let eval_ctx = EvalCoreCtx {\n182\t                    d_selectors: t.sels_ptr,\n183\t                    d_preprocessed: t.prep_ptr,\n184\t                    d_main: t.main_ptrs_dev.as_ptr(),\n185\t                    d_public: t.public_ptr,\n186\t                };\n187\t\n188\t                MonomialAirCtx {\n189\t                    d_headers: monomials.d_headers.as_ptr(),\n190\t                    d_variables: monomials.d_variables.as_ptr(),\n191\t                    d_lambda_combinations: lc.as_ptr(),\n192\t                    num_monomials: monomials.num_monomials,\n193\t                    eval_ctx,\n194\t                    d_eq_xi: t.eq_xi_ptr,\n195\t                    num_y: t.num_y,\n196\t                }\n197\t            })\n198\t            .collect();\n199\t\n200\t        // Upload to device\n201\t        let block_ctxs = block_ctxs_h.to_device()?;\n202\t        let air_ctxs = air_ctxs_h.to_device()?;\n203\t        let air_offsets = air_offsets.to_device()?;\n204\t\n205\t        debug!(\n206\t            num_airs = traces.len(),\n207\t            num_blocks = block_ctxs.len(),\n208\t            \"ZerocheckMonomialBatch created\"\n209\t        );\n210\t\n211\t        Ok(Self {\n212\t            traces,\n213\t            block_ctxs,\n214\t            air_ctxs,\n215\t            air_offsets,\n216\t        })\n217\t    }\n218\t\n219\t    /// Returns the trace indices in order.\n220\t    pub fn trace_indices(&self) -> impl Iterator<Item = usize> + '_ {\n221\t        self.traces.iter().map(|t| t.trace_idx)\n222\t    }\n223\t\n224\t    /// Evaluates the batch and returns the output device buffer.\n225\t    ///\n226\t    /// The buffer contains `num_airs * num_x` elements, laid out as\n227\t    /// `[air0_x0, air0_x1, ..., air1_x0, air1_x1, ...]`.\n228\t    /// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n229\t    pub fn evaluate(&self, num_x: u32) -> Result<DeviceBuffer<EF>, KernelError> {\n230\t        let num_blocks = self.block_ctxs.len();\n231\t        let num_airs = self.air_ctxs.len();\n232\t\n233\t        debug!(\n234\t            %num_blocks,\n235\t            %num_x,\n236\t            %num_airs,\n237\t            \"zerocheck_monomial_batched\"\n238\t        );\n239\t\n240\t        let mut tmp_sums = DeviceBuffer::<EF>::with_capacity(num_blocks * num_x as usize);\n241\t        let mut output = DeviceBuffer::<EF>::with_capacity(num_airs * num_x as usize);\n242\t\n243\t        debug_assert_eq!(\n244\t            self.air_offsets.len(),\n245\t            num_airs + 1,\n246\t            \"air_offsets must have num_airs + 1 elements\"\n247\t        );\n248\t        // SAFETY: All device pointers in block_ctxs and air_ctxs were constructed from\n249\t        // valid DeviceBuffers that outlive this call (TraceCtx references, pk monomial data,\n250\t        // lambda_combinations). The air_offsets buffer has length num_airs + 1 as required.\n251\t        unsafe {\n252\t            zerocheck_monomial_batched(\n253\t                &mut tmp_sums,\n254\t                &mut output,\n255\t                &self.block_ctxs,\n256\t                &self.air_ctxs,\n257\t                &self.air_offsets,\n258\t                num_blocks as u32,\n259\t                num_x,\n260\t                num_airs as u32,\n261\t                THREADS_PER_BLOCK,\n262\t            )?;\n263\t        }\n264\t\n265\t        Ok(output)\n266\t    }\n267\t}\n268\t\n269\t// Constants for par-y kernel\n270\tconst THREADS_PER_BLOCK_PAR_Y: u32 = 128;\n271\tconst DEFAULT_MAX_MONOMIALS_PER_THREAD: u32 = 64;\n272\tconst WAVES_TARGET: u32 = 4;\n273\t\n274\t/// Batch evaluator for monomial-based zerocheck MLE evaluation, parallelizing over y_int.\n275\t///\n276\t/// This variant is optimized for traces with high `num_y`: each thread handles one y_int\n277\t/// and loops over a chunk of monomials. The chunk size is auto-tuned based on SM count.\n278\t///\n279\t/// The caller must filter traces using [`trace_has_monomials`] before constructing.\n280\t/// The batch must contain at least one trace.\n281\tpub(crate) struct ZerocheckMonomialParYBatch<'a> {\n282\t    traces: Vec<&'a TraceCtx>,\n283\t    block_ctxs: DeviceBuffer<BlockCtx>,\n284\t    air_ctxs: DeviceBuffer<MonomialAirCtx>,\n285\t    air_offsets: DeviceBuffer<u32>,\n286\t    num_blocks: u32,\n287\t    chunk_size: u32,\n288\t}\n289\t\n290\timpl<'a> ZerocheckMonomialParYBatch<'a> {\n291\t    /// Creates a new batch from an iterator of traces.\n292\t    ///\n293\t    /// `lambda_combinations` must contain one buffer per trace (in iteration order),\n294\t    /// each precomputed via [`compute_lambda_combinations`].\n295\t    ///\n296\t    /// The `sm_count` and `num_x` parameters are used to auto-tune the chunk size\n297\t    /// for optimal SM utilization.\n298\t    ///\n299\t    /// # Panics\n300\t    ///"}]},"parent_tool_use_id":"toolu_01QqWhsz9DHqFxuan99aQmii","session_id":"f2fb024d-582e-4612-82c1-d7c12af7ab35","uuid":"5d98a985-fb59-4d04-be81-81bd594572ca","timestamp":"2026-04-13T10:09:19.484Z"}
