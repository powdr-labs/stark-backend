{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018oNc1DUBYBzY5fofF7T6jK","type":"tool_result","content":"87\tpub use errors::*;\n88\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n89\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n90\tuse round0::evaluate_round0_constraints_gpu;\n91\t\n92\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n93\t/// More threads = more concurrent kernels but more peak GPU memory and more\n94\t/// MemoryManager mutex contention. 8 provides good SM utilization on the RTX 4090.\n95\tconst NUM_ROUND0_STREAMS: usize = 8;\n96\t\n97\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n98\t/// instead of the monomial kernel for high num_y traces.\n99\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n100\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n101\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n102\t\n103\t#[inline]\n104\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n105\t    if need_rot {\n106\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n107\t        (mat_width / 2) as u32\n108\t    } else {\n109\t        mat_width as u32\n110\t    }\n111\t}\n112\t\n113\t/// Result of processing one AIR in Round 0.\n114\tstruct Round0AirResult {\n115\t    trace_idx: usize,\n116\t    zerocheck_poly: Option<UnivariatePoly<EF>>,\n117\t    logup_numer_poly: Option<UnivariatePoly<EF>>,\n118\t    logup_denom_poly: Option<UnivariatePoly<EF>>,\n119\t}\n120\t\n121\t/// All read-only references needed to process one AIR in Round 0.\n122\tstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n123\t    trace_idx: usize,\n124\t    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n125\t    n: isize,\n126\t    selectors_cube: &'a DeviceMatrix<F>,\n127\t    public_values: &'a DeviceBuffer<F>,\n128\t    eq_3bs: &'a [EF],\n129\t    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n130\t    common_main: &'a DeviceMatrix<F>,\n131\t    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n132\t    d_lambda_pows: &'a DeviceBuffer<EF>,\n133\t    beta_pows: &'a [EF],\n134\t    l_skip: usize,\n135\t    constraint_degree: usize,\n136\t    xi: &'a [EF],\n137\t    max_temp_bytes: usize,\n138\t}\n139\t\n140\tfn process_air_round0<HS: GpuHashScheme>(\n141\t    w: &Round0AirWorkItem<HS>,\n142\t) -> Result<Round0AirResult, LogupZerocheckError> {\n143\t    let single_pk = w.single_pk;\n144\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n145\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n146\t    assert!(\n147\t        local_constraint_deg <= w.constraint_degree,\n148\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n149\t        w.constraint_degree\n150\t    );\n151\t\n152\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n153\t    let omega_root = F::two_adic_generator(log_large_domain);\n154\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n155\t\n156\t    let height = w.common_main.height();\n157\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n158\t    for committed in w.cached_mains {\n159\t        main_parts.push(committed.trace.buffer().as_ptr());\n160\t    }\n161\t    main_parts.push(w.common_main.buffer().as_ptr());\n162\t    let d_main_parts = main_parts.to_device()?;\n163\t\n164\t    let n_lift = w.n.max(0) as usize;\n165\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n166\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n167\t\n168\t    let sum_buffer = evaluate_round0_constraints_gpu(\n169\t        single_pk,\n170\t        w.selectors_cube.buffer(),\n171\t        &d_main_parts,\n172\t        w.public_values,\n173\t        eq_xi_tree.get_ptr(n_lift),\n174\t        w.d_lambda_pows,\n175\t        1 << w.l_skip,\n176\t        1 << n_lift,\n177\t        height as u32,\n178\t        num_cosets_zc as u32,\n179\t        omega_root,\n180\t        w.max_temp_bytes,\n181\t    )?;\n182\t\n183\t    let zerocheck_poly = if !sum_buffer.is_empty() {\n184\t        let q_evals = sum_buffer.to_host_on_current_stream()?;\n185\t        let q = {\n186\t            let mut values = EF::zero_vec(num_cosets_zc << w.l_skip);"}]},"parent_tool_use_id":"toolu_01AE632a5Wp2Z56rx9eKSbLF","session_id":"f2fb024d-582e-4612-82c1-d7c12af7ab35","uuid":"8df3e53a-a0b8-41f4-86e0-3111ffda4d29","timestamp":"2026-04-13T10:09:02.208Z"}
