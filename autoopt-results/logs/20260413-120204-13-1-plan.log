{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VwmVgU4xwwhowtDQGfhwGN","type":"tool_result","content":"276\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n277\t    transcript: &mut TS,\n278\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n279\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n280\t    save_memory: bool,\n281\t    monomial_num_y_threshold: u32,\n282\t    sm_count: u32,\n283\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n284\twhere\n285\t    HS: GpuHashScheme,\n286\t    TS: GpuFiatShamirTranscript<HS::SC>,\n287\t{\n288\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n289\t    let l_skip = mpk.params.l_skip;\n290\t    let constraint_degree = mpk.max_constraint_degree;\n291\t    let num_traces = ctx.per_trace.len();\n292\t\n293\t    // Traces are sorted\n294\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n295\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n296\t    // heights\n297\t    let mut total_interactions = 0u64;\n298\t    let interactions_meta: Vec<_> = ctx\n299\t        .per_trace\n300\t        .iter()\n301\t        .map(|(air_idx, air_ctx)| {\n302\t            let pk = &mpk.per_air[*air_idx];\n303\t\n304\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n305\t            let height = air_ctx.common_main.height();\n306\t            let log_height = log2_strict_usize(height);\n307\t            let log_lifted_height = log_height.max(l_skip);\n308\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n309\t            (num_interactions, log_lifted_height)\n310\t        })\n311\t        .collect();\n312\t    // Implicitly, the width of this stacking should be 1\n313\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n314\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n315\t    // GKR\n316\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n317\t\n318\t    // Grind to increase soundness of random sampling for LogUp\n319\t    let logup_pow_witness = transcript\n320\t        .grind_gpu(mpk.params.logup.pow_bits)\n321\t        .map_err(LogupZerocheckError::Grind)?;\n322\t    let alpha_logup = transcript.sample_ext();\n323\t    let beta_logup = transcript.sample_ext();\n324\t    debug!(%alpha_logup, %beta_logup);\n325\t\n326\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n327\t    let mut prover = LogupZerocheckGpu::new(\n328\t        mpk,\n329\t        ctx,\n330\t        n_logup,\n331\t        interactions_layout,\n332\t        alpha_logup,\n333\t        beta_logup,\n334\t        save_memory,\n335\t        monomial_num_y_threshold,\n336\t        sm_count,\n337\t    )?;\n338\t    let n_global = prover.n_global;\n339\t\n340\t    let total_leaves = 1 << (l_skip + n_logup);\n341\t    prover\n342\t        .mem\n343\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n344\t    prover.mem.reset_peak();\n345\t    let (inputs, alpha) = if has_interactions {\n346\t        log_gkr_input_evals(\n347\t            &prover.trace_interactions,\n348\t            mpk,\n349\t            ctx,\n350\t            l_skip,\n351\t            alpha_logup,\n352\t            &prover.d_challenges,\n353\t            total_leaves,\n354\t        )?\n355\t    } else {\n356\t        (DeviceBuffer::new(), EF::ZERO)\n357\t    };\n358\t    // Set memory limit for batch MLE based on inputs buffer size\n359\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n360\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n361\t    if !prover.save_memory {\n362\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n363\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n364\t            tracing::warn!(\n365\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n366\t                prover.memory_limit_bytes\n367\t            );\n368\t        }\n369\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n370\t    }\n371\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n372\t\n373\t    let (frac_sum_proof, mut xi) =\n374\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n375\t    while xi.len() != l_skip + n_global {\n376\t        xi.push(transcript.sample_ext());\n377\t    }\n378\t    debug!(?xi);\n379\t    prover.xi = xi;\n380\t\n381\t    logup_gkr_span.exit();\n382\t\n383\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does\n384\t    // not include the kernel times for the actual folding\n385\t    let round0_span = info_span!(\"prover.rap_constraints.round0\", phase = \"prover\").entered();\n386\t    // begin batch sumcheck\n387\t    let mut sumcheck_round_polys = Vec::with_capacity(n_max);\n388\t    let mut r = Vec::with_capacity(n_max + 1);\n389\t    // batching randomness\n390\t    let lambda = transcript.sample_ext();\n391\t    debug!(%lambda);\n392\t\n393\t    let sp_0_polys = prover.sumcheck_uni_round0_polys(ctx, lambda)?;\n394\t    let s_0_cpu_span = info_span!(\"s'_0 -> s_0 cpu interpolations\").entered();\n395\t    let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_degree);\n396\t    let s_deg = constraint_degree + 1;\n397\t    let s_0_deg = sumcheck_round0_deg(l_skip, s_deg);\n398\t    let large_uni_domain = (s_0_deg + 1).next_power_of_two();\n399\t    let dft = Radix2BowersSerial;\n400\t    let s_0_logup_polys = {\n401\t        let eq_sharp_uni = eq_sharp_uni_poly(&prover.xi[..l_skip]);\n402\t        let mut eq_coeffs = eq_sharp_uni.into_coeffs();\n403\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n404\t        let eq_evals = dft.dft(eq_coeffs);\n405\t\n406\t        let width = 2 * num_traces;\n407\t        let mut sp_coeffs_mat = EF::zero_vec(width * large_uni_domain);\n408\t        for (i, coeffs) in sp_0_polys[..2 * num_traces].iter().enumerate() {\n409\t            for (j, &c_j) in coeffs.coeffs().iter().enumerate().take(sp_0_deg + 1) {\n410\t                // SAFETY:\n411\t                // - coeffs length is <= sp_0_deg + 1 <= s_0_deg < large_uni_domain\n412\t                // - sp_coeffs_mat allocated for width\n413\t                unsafe {\n414\t                    *sp_coeffs_mat.get_unchecked_mut(j * width + i) = c_j;\n415\t                }\n416\t            }\n417\t        }\n418\t        let mut s_evals = dft.dft_batch(RowMajorMatrix::new(sp_coeffs_mat, width));\n419\t        for (eq, row) in zip(eq_evals, s_evals.values.chunks_mut(width)) {\n420\t            for x in row {\n421\t                *x *= eq;\n422\t            }\n423\t        }\n424\t        dft.idft_batch(s_evals)\n425\t    };\n426\t    let skip_domain_size = F::from_usize(1 << l_skip);\n427\t    // logup sum claims (sum_{\\hat p}, sum_{\\hat q}) per present AIR\n428\t    let (numerator_term_per_air, denominator_term_per_air): (Vec<_>, Vec<_>) = (0..num_traces)\n429\t        .map(|trace_idx| {\n430\t            let [sum_claim_p, sum_claim_q] = [0, 1].map(|is_denom| {\n431\t                // Compute sum over D of s_0(Z) to get the sum claim\n432\t                (0..=s_0_deg)\n433\t                    .step_by(1 << l_skip)\n434\t                    .map(|j| unsafe {\n435\t                        // SAFETY: matrix is 2 * num_trace x large_uni_domain, s_0_deg <\n436\t                        // large_uni_domain\n437\t                        *s_0_logup_polys\n438\t                            .values\n439\t                            .get_unchecked(j * 2 * num_traces + 2 * trace_idx + is_denom)\n440\t                    })\n441\t                    .sum::<EF>()\n442\t                    * skip_domain_size\n443\t            });\n444\t            transcript.observe_ext(sum_claim_p);\n445\t            transcript.observe_ext(sum_claim_q);\n446\t\n447\t            (sum_claim_p, sum_claim_q)\n448\t        })\n449\t        .unzip();\n450\t\n451\t    let mu = transcript.sample_ext();\n452\t    debug!(%mu);\n453\t    let mu_pows = mu.powers().take(3 * num_traces).collect_vec();\n454\t\n455\t    let s_0_zc_poly = {\n456\t        let eq_uni = eq_uni_poly::<F, _>(l_skip, prover.xi[0]);\n457\t        let mut eq_coeffs = eq_uni.into_coeffs();\n458\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n459\t        let eq_evals = dft.dft(eq_coeffs);\n460\t\n461\t        // Algebraically batch\n462\t        let mut sp_coeffs = EF::zero_vec(large_uni_domain);\n463\t        let mus = &mu_pows[2 * num_traces..];\n464\t        let polys = &sp_0_polys[2 * num_traces..];\n465\t        for (j, batch_coeff) in sp_coeffs.iter_mut().enumerate().take(sp_0_deg + 1) {\n466\t            for (&mu, poly) in zip(mus, polys) {\n467\t                *batch_coeff += mu * *poly.coeffs().get(j).unwrap_or(&EF::ZERO);\n468\t            }\n469\t        }\n470\t        let mut s_evals = dft.dft(sp_coeffs);\n471\t        for (eq, x) in zip(eq_evals, &mut s_evals) {\n472\t            *x *= eq;\n473\t        }\n474\t        dft.idft(s_evals)\n475\t    };\n476\t\n477\t    // Algebraically batch\n478\t    let s_0_poly = UnivariatePoly::new(\n479\t        zip(\n480\t            s_0_logup_polys.values.chunks_exact(2 * num_traces),\n481\t            s_0_zc_poly,\n482\t        )\n483\t        .take(s_0_deg + 1)\n484\t        .map(|(logup_row, batched_zc)| {\n485\t            let coeff = batched_zc\n486\t                + zip(&mu_pows, logup_row)\n487\t                    .map(|(&mu_j, &x)| mu_j * x)\n488\t                    .sum::<EF>();\n489\t            transcript.observe_ext(coeff);\n490\t            coeff\n491\t        })\n492\t        .collect(),\n493\t    );\n494\t    drop(s_0_cpu_span);\n495\t\n496\t    let r_0 = transcript.sample_ext();\n497\t    r.push(r_0);\n498\t    debug!(round = 0, r_round = %r_0);\n499\t    prover.prev_s_eval = s_0_poly.eval_at_point(r_0);\n500\t    debug!(\"s_0(r_0) = {}\", prover.prev_s_eval);\n501\t\n502\t    prover.fold_ple_evals(ctx, r_0)?;\n503\t    drop(round0_span);\n504\t\n505\t    // Sumcheck rounds:\n506\t    // - each round the prover needs to compute univariate polynomial `s_round`. This poly is linear\n507\t    //   since we are taking MLE of `evals`.\n508\t    // - at end of each round, sample random `r_round` in `EF`\n509\t    //\n510\t    // `s_round` is degree `s_deg` so we evaluate it at `0, ..., =s_deg`. The prover skips\n511\t    // evaluation at `0` because the verifier can infer it from the previous round's\n512\t    // `s_{round-1}(r)` claim. The degree is constraint_degree + 1, where + 1 is from eq term\n513\t    let mle_rounds_span =\n514\t        info_span!(\"prover.rap_constraints.mle_rounds\", phase = \"prover\").entered();\n515\t    debug!(%s_deg);\n516\t    for round in 1..=n_max {\n517\t        let sp_round_evals = prover.sumcheck_polys_batch_eval(round, r[round - 1])?;\n518\t        let batch_s = prover.compute_batch_s_poly(sp_round_evals, num_traces, round, &mu_pows);\n519\t        let batch_s_evals = (1..=s_deg)\n520\t            .map(|i| batch_s.eval_at_point(EF::from_usize(i)))\n521\t            .collect_vec();\n522\t        for &eval in &batch_s_evals {\n523\t            transcript.observe_ext(eval);\n524\t        }\n525\t        sumcheck_round_polys.push(batch_s_evals);"}]},"parent_tool_use_id":"toolu_01QqWhsz9DHqFxuan99aQmii","session_id":"f2fb024d-582e-4612-82c1-d7c12af7ab35","uuid":"57920d73-2de2-4922-b23f-2cbf82247f10","timestamp":"2026-04-13T10:09:16.223Z"}
