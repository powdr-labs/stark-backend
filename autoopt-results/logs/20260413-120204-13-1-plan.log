    bus_term_sum: lc.bus_term_sum,\n680\t                    num_y: t.num_y,\n681\t                    mono_blocks,\n682\t                }\n683\t            })\n684\t            .collect();\n685\t        let numer_ctxs_h: Vec<LogupMonomialCtx> = traces\n686\t            .iter()\n687\t            .zip(logup_combinations)\n688\t            .map(|(t, lc)| {\n689\t                let monomials = pk.per_air[t.air_idx]\n690\t                    .other_data\n691\t                    .interaction_monomials\n692\t                    .as_ref()\n693\t                    .unwrap();\n694\t                LogupMonomialCtx {\n695\t                    d_headers: monomials.d_numer_headers.as_ptr(),\n696\t                    d_variables: monomials.d_numer_variables.as_ptr(),\n697\t                    d_combinations: lc.d_numer_combinations.as_ptr(),\n698\t                    num_monomials: monomials.num_numer_monomials,\n699\t                }\n700\t            })\n701\t            .collect();\n702\t        let denom_ctxs_h: Vec<LogupMonomialCtx> = traces\n703\t            .iter()\n704\t            .zip(logup_combinations)\n705\t            .map(|(t, lc)| {\n706\t                let monomials = pk.per_air[t.air_idx]\n707\t                    .other_data\n708\t                    .interaction_monomials\n709\t                    .as_ref()\n710\t                    .unwrap();\n711\t                LogupMonomialCtx {\n712\t                    d_headers: monomials.d_denom_headers.as_ptr(),\n713\t                    d_variables: monomials.d_denom_variables.as_ptr(),\n714\t                    d_combinations: lc.d_denom_combinations.as_ptr(),\n715\t                    num_monomials: monomials.num_denom_monomials,\n716\t                }\n717\t            })\n718\t            .collect();\n719\t\n720\t        // Upload to device\n721\t        let block_ctxs = block_ctxs_h.to_device()?;\n722\t        let common_ctxs = common_ctxs_h.to_device()?;\n723\t        let numer_ctxs = numer_ctxs_h.to_d