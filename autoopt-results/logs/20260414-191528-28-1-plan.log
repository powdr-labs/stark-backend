{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011dTR15zEBXRvhUJWihmDEP","type":"tool_result","content":"1\t#include \"fp.h\"\n2\t#include \"fpext.h\"\n3\t#include \"launcher.cuh\"\n4\t#include \"sumcheck.cuh\"\n5\t#include <algorithm>\n6\t#include <cassert>\n7\t#include <cstddef>\n8\t#include <cstdint>\n9\t#include <utility>\n10\t\n11\tnamespace {\n12\t\n13\t// ============================================================================\n14\t// KERNELS\n15\t// ============================================================================\n16\t\n17\t// Folds PLE evaluations by interpolating univariate polynomials on coset D and evaluating at r_0\n18\t// Input: column-major matrix [height * width] of evaluations\n19\t// Output: column-major matrix [new_height * width] of folded evaluations (original OR rotated)\n20\t// For each (x, col), collects 2^l_skip evaluations on coset D and interpolates\n21\t// Parallelizes barycentric interpolation: each chunk of skip_domain threads handles one output cell\n22\t// Grid: (num_row_blocks, width) where blockIdx.y selects the column\n23\ttemplate <bool ROTATE>\n24\t__global__ void fold_ple_from_evals_kernel(\n25\t    const Fp *__restrict__ input_matrix, // [height * width] column-major\n26\t    FpExt *__restrict__ output_matrix,   // [new_height * width] column-major\n27\t    const Fp *__restrict__ omega_skip_pows, // [skip_domain]\n28\t    const FpExt *inv_lagrange_denoms,       // [skip_domain]\n29\t    uint32_t height,\n30\t    uint32_t skip_domain, // 2^l_skip\n31\t    uint32_t l_skip,      // log2(domain_size)\n32\t    uint32_t new_height   // lifted_height >> l_skip\n33\t) {\n34\t    extern __shared__ char smem_raw[];\n35\t    FpExt *smem = reinterpret_cast<FpExt *>(smem_raw);\n36\t\n37\t    uint32_t col = blockIdx.y;\n38\t    uint32_t chunks_per_block = blockDim.x / skip_domain;\n39\t    uint32_t chunk_in_block = threadIdx.x / skip_domain;\n40\t    uint32_t tid_in_chunk = threadIdx.x % skip_domain;\n41\t    uint32_t x = blockIdx.x * chunks_per_block + chunk_in_block; // row index in output\n42\t\n43\t    // Cannot early-return: all threads must participate in chunk_reduce_sum (uses __syncthreads)\n44\t    bool const active_chunk = (x < new_height);\n45\t\n46\t    // Each thread handles exactly ONE term of the barycentric interpolation\n47\t    FpExt local_val(Fp::zero());\n48\t    if (active_chunk) {\n49\t        uint32_t z = tid_in_chunk;\n50\t        uint32_t offset = ROTATE ? 1 : 0;\n51\t        uint32_t row_idx = ((x << l_skip) + z + offset) % height;\n52\t        uint32_t input_idx = col * height + row_idx;\n53\t        Fp eval = input_matrix[input_idx];\n54\t\n55\t        // Lagrange interpolation: eval * omega_skip_pows[z] * inv_lagrange_denoms[z]\n56\t        local_val = inv_lagrange_denoms[z] * omega_skip_pows[z] * eval;\n57\t    }\n58\t\n59\t    // Reduce within chunk\n60\t    // All threads must participate; inactive chunks contribute zero\n61\t    FpExt result =\n62\t        sumcheck::chunk_reduce_sum(local_val, smem, tid_in_chunk, skip_domain, chunk_in_block);\n63\t\n64\t    // No __syncthreads() needed: each chunk writes to a distinct output location\n65\t    // and kernel exits immediately after this write\n66\t    if (active_chunk && tid_in_chunk == 0) {\n67\t        output_matrix[col * new_height + x] = result;\n68\t    }\n69\t}\n70\t\n71\tstruct InterpColDesc {\n72\t    FpExt* output;              // Base pointer for this trace's interpolated output\n73\t    uint32_t columns_offset;    // Offset into the flattened columns array\n74\t    uint32_t num_y;             // Number of y-values for this trace\n75\t    uint32_t num_columns;       // Number of columns for this trace\n76\t    uint32_t total_threads;     // = num_y * num_columns (precomputed for efficiency)\n77\t    uint32_t block_start;       // First block index assigned to this descriptor\n78\t};\n79\t\n80\t__global__ void interpolate_columns_kernel(\n81\t    FpExt *__restrict__ interpolated,\n82\t    const FpExt *__restrict__ const *__restrict__ columns,\n83\t    uint32_t s_deg,\n84\t    uint32_t num_y,\n85\t    uint32_t num_columns\n86\t) {\n87\t    uint32_t tidx = threadIdx.x + blockIdx.x * blockDim.x;\n88\t    uint32_t y = tidx % num_y;\n89\t    uint32_t col_idx = tidx / num_y;\n90\t    if (col_idx >= num_columns)\n91\t        return;\n92\t\n93\t    const FpExt *__restrict__ column = columns[col_idx];\n94\t    auto t0 = column[y << 1];\n95\t    auto t1 = column[(y << 1) | 1];\n96\t    FpExt *__restrict__ this_interpolated = interpolated + col_idx * s_deg * num_y;\n97\t\n98\t    for (int x = 0; x < s_deg; x++) {\n99\t        this_interpolated[x * num_y + y] = t0 + (t1 - t0) * Fp(x + 1u);\n100\t    }\n101\t}\n102\t\n103\t__global__ void batched_interpolate_columns_kernel(\n104\t    const InterpColDesc* descs,\n105\t    const FpExt *const * all_columns,\n106\t    uint32_t s_deg,\n107\t    uint32_t num_descs\n108\t) {\n109\t    // Binary search: find the descriptor that owns this block\n110\t    uint32_t block_idx = blockIdx.x;\n111\t    uint32_t lo = 0, hi = num_descs;\n112\t    while (lo + 1 < hi) {\n113\t        uint32_t mid = (lo + hi) / 2;\n114\t        if (descs[mid].block_start <= block_idx) lo = mid;\n115\t        else hi = mid;\n116\t    }\n117\t\n118\t    const InterpColDesc& d = descs[lo];\n119\t    uint32_t local_block = block_idx - d.block_start;\n120\t    uint32_t tidx = local_block * blockDim.x + threadIdx.x;\n121\t    if (tidx >= d.total_threads) return;\n122\t\n123\t    uint32_t y = tidx % d.num_y;\n124\t    uint32_t col_local = tidx / d.num_y;\n125\t\n126\t    const FpExt *column = all_columns[d.columns_offset + col_local];\n127\t    auto t0 = column[y << 1];\n128\t    auto t1 = column[(y << 1) | 1];\n129\t    FpExt *this_out = d.output + col_local * s_deg * d.num_y;\n130\t\n131\t    for (int x = 0; x < s_deg; x++) {\n132\t        this_out[x * d.num_y + y] = t0 + (t1 - t0) * Fp(x + 1u);\n133\t    }\n134\t}\n135\t\n136\t__global__ void frac_matrix_vertically_repeat_kernel(\n137\t    std::pair<FpExt, FpExt> *__restrict__ out,\n138\t    const std::pair<FpExt, FpExt> *__restrict__ in,\n139\t    const uint32_t width,\n140\t    const uint32_t lifted_height,\n141\t    const uint32_t height\n142\t) {\n143\t    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;\n144\t    uint32_t col = blockIdx.y + blockIdx.z * gridDim.y;\n145\t    if (col >= width) {\n146\t        return;\n147\t    }\n148\t    out[col * lifted_height + row].first = in[col * height + (row % height)].first;\n149\t    out[col * lifted_height + row].second = in[col * height + (row % height)].second;\n150\t}\n151\t\n152\t// Vertically repeat separate (F, EF) buffers (for GKR input optimization)\n153\t__global__ void frac_matrix_vertically_repeat_mixed_kernel(\n154\t    FpExt *__restrict__ out_numerators,\n155\t    FpExt *__restrict__ out_denominators,\n156\t    const FpExt *__restrict__ in_numerators,\n157\t    const FpExt *__restrict__ in_denominators,\n158\t    const uint32_t width,\n159\t    const uint32_t lifted_height,\n160\t    const uint32_t height\n161\t) {\n162\t    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;\n163\t    uint32_t col = blockIdx.y + blockIdx.z * gridDim.y;\n164\t    if (col >= width) {\n165\t        return;\n166\t    }\n167\t    uint32_t src_row = row % height;\n168\t    size_t src_idx = col * height + src_row;\n169\t    size_t dst_idx = col * lifted_height + row;\n170\t    out_numerators[dst_idx] = in_numerators[src_idx];\n171\t    out_denominators[dst_idx] = in_denominators[src_idx];\n172\t}\n173\t\n174\t// ============================================================================\n175\t// LAUNCHERS\n176\t// ============================================================================\n177\t\n178\tconstexpr uint32_t MAX_GRID_DIM = 65535u;\n179\t\n180\textern \"C\" int _fold_ple_from_evals(\n181\t    const Fp *input_matrix,\n182\t    FpExt *output_matrix,\n183\t    const Fp *omega_skip_pows,\n184\t    const FpExt *inv_lagrange_denoms,\n185\t    uint32_t height,\n186\t    uint32_t width,\n187\t    uint32_t l_skip,\n188\t    uint32_t new_height,\n189\t    bool rotate\n190\t) {\n191\t    uint32_t skip_domain = 1u << l_skip;\n192\t\n193\t    // Block size: at least skip_domain, prefer 256 for occupancy\n194\t    uint32_t block_size = std::max(256u, skip_domain);\n195\t    uint32_t chunks_per_block = block_size / skip_domain;\n196\t\n197\t    // 2D grid: x-dim for rows, y-dim for columns\n198\t    dim3 grid(div_ceil(new_height, chunks_per_block), width);\n199\t    dim3 block(block_size);\n200\t\n201\t    // Shared memory for cross-warp reduction (needed when skip_domain > 32)\n202\t    // Each warp in the block needs one FpExt slot for cross-warp reduction\n203\t    uint32_t total_warps_in_block = block_size / WARP_SIZE;\n204\t    size_t smem_bytes = (skip_domain > WARP_SIZE) ? total_warps_in_block * sizeof(FpExt) : 0;\n205\t\n206\t    if (rotate) {\n207\t        fold_ple_from_evals_kernel<true><<<grid, block, smem_bytes>>>(\n208\t            input_matrix,\n209\t            output_matrix,\n210\t            omega_skip_pows,\n211\t            inv_lagrange_denoms,\n212\t            height,\n213\t            skip_domain,\n214\t            l_skip,\n215\t            new_height\n216\t        );\n217\t    } else {\n218\t        fold_ple_from_evals_kernel<false><<<grid, block, smem_bytes>>>(\n219\t            input_matrix,\n220\t            output_matrix,\n221\t            omega_skip_pows,\n222\t            inv_lagrange_denoms,\n223\t            height,\n224\t            skip_domain,\n225\t            l_skip,\n226\t            new_height\n227\t        );\n228\t    }\n229\t    return CHECK_KERNEL();\n230\t}\n231\t\n232\textern \"C\" int _interpolate_columns(\n233\t    FpExt *interpolated,\n234\t    const FpExt *const *columns,\n235\t    size_t s_deg,\n236\t    size_t num_y,\n237\t    size_t num_columns\n238\t) {\n239\t    auto [grid, block] = kernel_launch_params(num_y * num_columns, 512);\n240\t\n241\t    interpolate_columns_kernel<<<grid, block>>>(interpolated, columns, s_deg, num_y, num_columns);\n242\t    return CHECK_KERNEL();\n243\t}\n244\t\n245\textern \"C\" int _batched_interpolate_columns(\n246\t    const InterpColDesc* descs,\n247\t    const FpExt *const * all_columns,\n248\t    size_t s_deg,\n249\t    size_t num_descs,\n250\t    size_t total_blocks\n251\t) {\n252\t    if (num_descs == 0) return 0;\n253\t    dim3 grid(total_blocks);\n254\t    dim3 block(512);\n255\t    batched_interpolate_columns_kernel<<<grid, block>>>(\n256\t        descs, all_columns, s_deg, num_descs\n257\t    );\n258\t    return CHECK_KERNEL();\n259\t}\n260\t\n261\textern \"C\" int _frac_matrix_vertically_repeat(\n262\t    std::pair<FpExt, FpExt> *out,\n263\t    const std::pair<FpExt, FpExt> *in,\n264\t    const uint32_t width,\n265\t    const uint32_t lifted_height,\n266\t    const uint32_t height\n267\t) {\n268\t    auto [grid, block] = kernel_launch_params(lifted_height);\n269\t    grid.y = std::min(width, MAX_GRID_DIM);\n270\t    grid.z = (width + grid.y - 1) / grid.y;\n271\t    assert(grid.z <= MAX_GRID_DIM);\n272\t    frac_matrix_vertically_repeat_kernel<<<grid, block>>>(out, in, width, lifted_height, height);\n273\t    return CHECK_KERNEL();\n274\t}\n275\t\n276\textern \"C\" int _frac_matrix_vertically_repeat_ext(\n277\t    FpExt *out_numerators,\n278\t    FpExt *out_denominators,\n279\t    const FpExt *in_numerators,\n280\t    const FpExt *in_denominators,\n281\t    const uint32_t width,\n282\t    const uint32_t lifted_height,\n283\t    const uint32_t height\n284\t) {\n285\t    auto [grid, block] = kernel_launch_params(lifted_height);\n286\t    grid.y = std::min(width, MAX_GRID_DIM);\n287\t    grid.z = (width + grid.y - 1) / grid.y;\n288\t    assert(grid.z <= MAX_GRID_DIM);\n289\t    frac_matrix_vertically_repeat_mixed_kernel<<<grid, block>>>(\n290\t        out_numerators,\n291\t        out_denominators,\n292\t        in_numerators,\n293\t        in_denominators,\n294\t        width,\n295\t        lifted_height,\n296\t        height\n297\t    );\n298\t    return CHECK_KERNEL();\n299\t}\n300\t\n301\t} // namespace\n302\t"}]},"parent_tool_use_id":"toolu_01GhHDCLk9hM9HWVHiyBLmiC","session_id":"ae9b2456-7a6a-41ad-a41d-1e3f4310411a","uuid":"9abd68d2-8de5-419f-ac37-10d2d891ecea","timestamp":"2026-04-14T17:39:44.279Z"}
