{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YMtwEWX49LxftufjsfXhon","type":"tool_result","content":"100\t/// MemoryManager mutex contention. 8 provides good SM utilization on the RTX 4090.\n101\tconst NUM_ROUND0_STREAMS: usize = 8;\n102\t\n103\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n104\t/// instead of the monomial kernel for high num_y traces.\n105\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n106\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n107\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n108\t\n109\t#[inline]\n110\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n111\t    if need_rot {\n112\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n113\t        (mat_width / 2) as u32\n114\t    } else {\n115\t        mat_width as u32\n116\t    }\n117\t}\n118\t\n119\t/// Pre-computed transformation matrices for GPU-side polynomial extraction in Round 0.\n120\t/// Captures the entire pipeline: transpose + iDFT + unshift + Lagrange interpolation\n121\t/// + coefficient adjustment (for zerocheck only).\n122\tstruct Round0ExtractTables {\n123\t    /// Zerocheck: maps eval values to final poly coefficients (with adjustment).\n124\t    /// Row-major [output_size × input_size].\n125\t    zc_transform: DeviceBuffer<EF>,\n126\t    zc_input_size: u32,\n127\t    zc_output_size: u32,\n128\t    /// Logup: maps eval values to poly coefficients (no adjustment).\n129\t    /// Row-major [size × size].\n130\t    logup_transform: DeviceBuffer<EF>,\n131\t    logup_size: u32,\n132\t}\n133\t\n134\t/// Compute transform matrices for a given constraint degree `d` and `l_skip`.\n135\t/// These are pre-computed on the CPU by running the polynomial extraction pipeline\n136\t/// on unit vectors, then uploaded to the GPU.\n137\tfn compute_round0_extract_tables(d: usize, l_skip: usize) -> Result<Round0ExtractTables, MemCopyError> {\n138\t    let skip_domain = 1usize << l_skip;\n139\t    let omega_root = F::two_adic_generator(log2_ceil_usize(d << l_skip));\n140\t\n141\t    // Zerocheck transform: input is (d-1)*skip_domain evals, output is sp_0_deg+1 coefficients\n142\t    let (zc_host, zc_in, zc_out) = {\n143\t        let w = d.saturating_sub(1); // num_cosets_zc\n144\t        if w == 0 {\n145\t            (vec![], 0u32, 0u32)\n146\t        } else {\n147\t            let input_size = w * skip_domain;\n148\t            let output_size = sumcheck_round0_deg(l_skip, d) + 1;\n149\t            let mut transform = vec![EF::ZERO; output_size * input_size];\n150\t            for j in 0..input_size {\n151\t                let src_c = j / skip_domain;\n152\t                let src_i = j % skip_domain;\n153\t                let mut values = EF::zero_vec(input_size);\n154\t                values[src_i * w + src_c] = EF::ONE; // transpose baked in\n155\t                let q = UnivariatePoly::<EF>::from_geometric_cosets_evals_idft(\n156\t                    RowMajorMatrix::new(values, w),\n157\t                    omega_root,\n158\t                    omega_root,\n159\t                );\n160\t                for i in 0..output_size {\n161\t                    let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n162\t                    if i >= skip_domain {\n163\t                        c += q.coeffs()[i - skip_domain];\n164\t                    }\n165\t                    transform[i * input_size + j] = c;\n166\t                }\n167\t            }\n168\t            (transform, input_size as u32, output_size as u32)\n169\t        }\n170\t    };\n171\t\n172\t    // Logup transform: input and output are both d*skip_domain\n173\t    let (logup_host, logup_sz) = {\n174\t        let w = d; // num_cosets_logup\n175\t        let size = w * skip_domain;\n176\t        let mut transform = vec![EF::ZERO; size * size];\n177\t        for j in 0..size {\n178\t            let src_c = j / skip_domain;\n179\t            let src_i = j % skip_domain;\n180\t            let mut values = EF::zero_vec(size);\n181\t            values[src_i * w + src_c] = EF::ONE;\n182\t            let poly = UnivariatePoly::<EF>::from_geometric_cosets_evals_idft(\n183\t                RowMajorMatrix::new(values, w),\n184\t                omega_root,\n185\t                F::ONE,\n186\t            );\n187\t            for i in 0..size {\n188\t                transform[i * size + j] = *poly.coeffs().get(i).unwrap_or(&EF::ZERO);\n189\t            }\n190\t        }\n191\t        (transform, size as u32)\n192\t    };\n193\t\n194\t    let d_zc = if zc_host.is_empty() {\n195\t        DeviceBuffer::new()\n196\t    } else {\n197\t        zc_host.to_device()?\n198\t    };\n199\t    let d_logup = logup_host.to_device()?;\n200\t\n201\t    Ok(Round0ExtractTables {\n202\t        zc_transform: d_zc,\n203\t        zc_input_size: zc_in,\n204\t        zc_output_size: zc_out,\n205\t        logup_transform: d_logup,\n206\t        logup_size: logup_sz,\n207\t    })\n208\t}\n209\t\n210\t/// All read-only references needed to process one AIR in Round 0.\n211\tstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n212\t    trace_idx: usize,\n213\t    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n214\t    n: isize,\n215\t    selectors_cube: &'a DeviceMatrix<F>,\n216\t    public_values: &'a DeviceBuffer<F>,\n217\t    eq_3bs: &'a [EF],\n218\t    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n219\t    common_main: &'a DeviceMatrix<F>,\n220\t    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n221\t    d_lambda_pows: &'a DeviceBuffer<EF>,\n222\t    beta_pows: &'a [EF],\n223\t    l_skip: usize,\n224\t    constraint_degree: usize,\n225\t    xi: &'a [EF],\n226\t    max_temp_bytes: usize,\n227\t    /// Pre-computed zerocheck intermediates buffer capacity needed\n228\t    zc_intermed_cap: usize,\n229\t    /// Pre-computed zerocheck temp sums buffer capacity needed\n230\t    zc_temp_sums_cap: usize,\n231\t    /// Pre-computed logup intermediates buffer capacity needed\n232\t    logup_intermed_cap: usize,\n233\t    /// Pre-computed logup temp sums buffer capacity needed\n234\t    logup_temp_sums_cap: usize,\n235\t    /// Offset into the device batch array for this AIR's zerocheck poly\n236\t    zc_batch_offset: usize,\n237\t    /// Offset for logup numerator poly\n238\t    numer_batch_offset: usize,\n239\t    /// Offset for logup denominator poly\n240\t    denom_batch_offset: usize,\n241\t}\n242\t\n243\tfn process_air_round0<HS: GpuHashScheme>(\n244\t    w: &Round0AirWorkItem<HS>,\n245\t    bufs: &mut round0::Round0ThreadBuffers,\n246\t    d_batch_ptr: *mut EF,\n247\t    extract_tables: &FxHashMap<usize, Round0ExtractTables>,\n248\t) -> Result<(), LogupZerocheckError> {\n249\t    let single_pk = w.single_pk;\n250\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n251\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n252\t    assert!(\n253\t        local_constraint_deg <= w.constraint_degree,\n254\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n255\t        w.constraint_degree\n256\t    );\n257\t\n258\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n259\t    let omega_root = F::two_adic_generator(log_large_domain);\n260\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n261\t\n262\t    let height = w.common_main.height();\n263\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n264\t    for committed in w.cached_mains {\n265\t        main_parts.push(committed.trace.buffer().as_ptr());\n266\t    }\n267\t    main_parts.push(w.common_main.buffer().as_ptr());\n268\t    let d_main_parts = main_parts.to_device()?;\n269\t\n270\t    let n_lift = w.n.max(0) as usize;\n271\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n272\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n273\t\n274\t    // Check if pre-allocated zerocheck buffers are large enough for this AIR\n275\t    let zc_prealloc_inter = if w.zc_intermed_cap > 0\n276\t        && bufs.zc_intermediates.len() >= w.zc_intermed_cap\n277\t    {\n278\t        Some(&mut bufs.zc_intermediates)\n279\t    } else {\n280\t        None\n281\t    };\n282\t    let zc_prealloc_temp = if w.zc_temp_sums_cap > 0\n283\t        && bufs.zc_temp_sums.len() >= w.zc_temp_sums_cap\n284\t    {\n285\t        Some(&mut bufs.zc_temp_sums)\n286\t    } else {\n287\t        None\n288\t    };\n289\t\n290\t    let sum_buffer = evaluate_round0_constraints_gpu(\n291\t        single_pk,\n292\t        w.selectors_cube.buffer(),\n293\t        &d_main_parts,\n294\t        w.public_values,\n295\t        eq_xi_tree.get_ptr(n_lift),\n296\t        w.d_lambda_pows,\n297\t        1 << w.l_skip,\n298\t        1 << n_lift,\n299\t        height as u32,\n300\t        num_cosets_zc as u32,\n301\t        omega_root,\n302\t        w.max_temp_bytes,\n303\t        zc_prealloc_inter,\n304\t        zc_prealloc_temp,\n305\t    )?;\n306\t\n307\t    // GPU-side polynomial extraction: launch a small kernel to compute\n308\t    // iDFT + Lagrange interpolation + coefficient adjustment on-device,\n309\t    // writing directly into the batch array. No D2H sync needed.\n310\t    if !sum_buffer.is_empty() {\n311\t        let tables = &extract_tables[&local_constraint_deg];\n312\t        let err = unsafe {\n313\t            _round0_extract_zerocheck_poly(\n314\t                d_batch_ptr.add(w.zc_batch_offset),\n315\t                sum_buffer.as_ptr(),\n316\t                tables.zc_transform.as_ptr(),\n317\t                tables.zc_input_size,\n318\t                tables.zc_output_size,\n319\t            )\n320\t        };\n321\t        if err != 0 {\n322\t            return Err(Round0EvalError::Cuda(CudaError::new(err)).into());\n323\t        }\n324\t    }\n325\t    // sum_buffer dropped here; cudaFreeAsync is ordered after the kernel on the same stream\n326\t\n327\t    let num_cosets_logup = local_constraint_deg;\n328\t\n329\t    // Check if pre-allocated logup buffers are large enough for this AIR\n330\t    let logup_prealloc_inter = if w.logup_intermed_cap > 0\n331\t        && bufs.logup_intermediates.len() >= w.logup_intermed_cap\n332\t    {\n333\t        Some(&mut bufs.logup_intermediates)\n334\t    } else {\n335\t        None\n336\t    };\n337\t    let logup_prealloc_temp = if w.logup_temp_sums_cap > 0\n338\t        && bufs.logup_temp_sums.len() >= w.logup_temp_sums_cap\n339\t    {\n340\t        Some(&mut bufs.logup_temp_sums)\n341\t    } else {\n342\t        None\n343\t    };\n344\t\n345\t    let sum = evaluate_round0_interactions_gpu(\n346\t        single_pk,\n347\t        &single_air_constraints,\n348\t        w.selectors_cube.buffer(),\n349\t        &d_main_parts,\n350\t        w.public_values,\n351\t        eq_xi_tree.get_ptr(n_lift),\n352\t        w.beta_pows,\n353\t        w.eq_3bs,\n354\t        1 << w.l_skip,\n355\t        1 << n_lift,\n356\t        height as u32,\n357\t        num_cosets_logup as u32,\n358\t        omega_root,\n359\t        w.max_temp_bytes,\n360\t        logup_prealloc_inter,\n361\t        logup_prealloc_temp,\n362\t    )?;\n363\t\n364\t    if !sum.is_empty() {\n365\t        let tables = &extract_tables[&local_constraint_deg];\n366\t        let norm_factor: EF = if w.n.is_negative() {\n367\t            EF::from(F::from_u32(1 << w.n.unsigned_abs()).inverse())\n368\t        } else {\n369\t            EF::ONE\n370\t        };\n371\t        let err = unsafe {\n372\t            _round0_extract_logup_polys(\n373\t                d_batch_ptr.add(w.numer_batch_offset),\n374\t                d_batch_ptr.add(w.denom_batch_offset),\n375\t                sum.as_ptr(),\n376\t                tables.logup_transform.as_ptr(),\n377\t                tables.logup_size,\n378\t                tables.logup_size,\n379\t                norm_factor,\n380\t            )\n381\t        };\n382\t        if err != 0 {\n383\t            return Err(Round0EvalError::Cuda(CudaError::new(err)).into());\n384\t        }\n385\t    }\n386\t\n387\t    Ok(())\n388\t}\n389\t\n390\t#[allow(clippy::type_complexity)]\n391\t#[instrument(level = \"info\", skip_all)]\n392\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n393\t    transcript: &mut TS,\n394\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n395\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n396\t    save_memory: bool,\n397\t    monomial_num_y_threshold: u32,\n398\t    sm_count: u32,\n399\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n400\twhere\n401\t    HS: GpuHashScheme,\n402\t    TS: GpuFiatShamirTranscript<HS::SC>,\n403\t{\n404\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n405\t    let l_skip = mpk.params.l_skip;\n406\t    let constraint_degree = mpk.max_constraint_degree;\n407\t    let num_traces = ctx.per_trace.len();\n408\t\n409\t    // Traces are sorted\n410\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n411\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n412\t    // heights\n413\t    let mut total_interactions = 0u64;\n414\t    let interactions_meta: Vec<_> = ctx\n415\t        .per_trace\n416\t        .iter()\n417\t        .map(|(air_idx, air_ctx)| {\n418\t            let pk = &mpk.per_air[*air_idx];\n419\t\n420\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n421\t            let height = air_ctx.common_main.height();\n422\t            let log_height = log2_strict_usize(height);\n423\t            let log_lifted_height = log_height.max(l_skip);\n424\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n425\t            (num_interactions, log_lifted_height)\n426\t        })\n427\t        .collect();\n428\t    // Implicitly, the width of this stacking should be 1\n429\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n430\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n431\t    // GKR\n432\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n433\t\n434\t    // Grind to increase soundness of random sampling for LogUp\n435\t    let logup_pow_witness = transcript\n436\t        .grind_gpu(mpk.params.logup.pow_bits)\n437\t        .map_err(LogupZerocheckError::Grind)?;\n438\t    let alpha_logup = transcript.sample_ext();\n439\t    let beta_logup = transcript.sample_ext();\n440\t    debug!(%alpha_logup, %beta_logup);\n441\t\n442\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n443\t    let mut prover = LogupZerocheckGpu::new(\n444\t        mpk,\n445\t        ctx,\n446\t        n_logup,\n447\t        interactions_layout,\n448\t        alpha_logup,\n449\t        beta_logup,\n450\t        save_memory,\n451\t        monomial_num_y_threshold,\n452\t        sm_count,\n453\t    )?;\n454\t    let n_global = prover.n_global;\n455\t\n456\t    let total_leaves = 1 << (l_skip + n_logup);\n457\t    prover\n458\t        .mem\n459\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n460\t    prover.mem.reset_peak();\n461\t    let (inputs, alpha) = if has_interactions {\n462\t        log_gkr_input_evals(\n463\t            &prover.trace_interactions,\n464\t            mpk,\n465\t            ctx,\n466\t            l_skip,\n467\t            alpha_logup,\n468\t            &prover.d_challenges,\n469\t            total_leaves,\n470\t        )?\n471\t    } else {\n472\t        (DeviceBuffer::new(), EF::ZERO)\n473\t    };\n474\t    // Set memory limit for batch MLE based on inputs buffer size\n475\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n476\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n477\t    if !prover.save_memory {\n478\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n479\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n480\t            tracing::warn!(\n481\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n482\t                prover.memory_limit_bytes\n483\t            );\n484\t        }\n485\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n486\t    }\n487\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n488\t\n489\t    let (frac_sum_proof, mut xi) =\n490\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n491\t    while xi.len() != l_skip + n_global {\n492\t        xi.push(transcript.sample_ext());\n493\t    }\n494\t    debug!(?xi);\n495\t    prover.xi = xi;\n496\t\n497\t    logup_gkr_span.exit();\n498\t\n499\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does"}]},"parent_tool_use_id":"toolu_01MkhYY1U9QnfpzAQ7htKZsZ","session_id":"ae9b2456-7a6a-41ad-a41d-1e3f4310411a","uuid":"22b60ca4-feca-4c4e-b1fe-2fa96ecc3666","timestamp":"2026-04-14T17:23:51.221Z"}
