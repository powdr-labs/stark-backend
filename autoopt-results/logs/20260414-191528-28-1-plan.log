{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K9qEKwNaecPPrEhwSBHxdM","type":"tool_result","content":"1570\t        name = \"LogupZerocheck::sumcheck_polys_batch_eval\",\n1571\t        level = \"info\",\n1572\t        skip_all,\n1573\t        fields(round = round)\n1574\t    )]\n1575\t    fn sumcheck_polys_batch_eval(\n1576\t        &mut self,\n1577\t        round: usize,\n1578\t        r_prev: EF,\n1579\t    ) -> Result<Vec<Vec<EF>>, LogupZerocheckError> {\n1580\t        let sp_deg = self.constraint_degree;\n1581\t\n1582\t        // Per-trace outputs (filled as we go)\n1583\t        let mut zc_out: Vec<Vec<EF>> = vec![vec![EF::ZERO; sp_deg]; self.n_per_trace.len()];\n1584\t        let mut logup_out: Vec<[Vec<EF>; 2]> =\n1585\t            vec![[vec![EF::ZERO; sp_deg], vec![EF::ZERO; sp_deg]]; self.n_per_trace.len()];\n1586\t\n1587\t        let mut late_eval: Vec<TraceCtx> = Vec::new(); // round == n_lift + 1\n1588\t        let mut early_eval: Vec<TraceCtx> = Vec::new(); // round <= n_lift\n1589\t\n1590\t        // ── Phase 1: Collect metadata, split into Case A / Case B (no CUDA calls) ──\n1591\t        // For Case B traces, we collect column pointers and sizing info to batch the\n1592\t        // interpolation into a single kernel launch.\n1593\t        struct CaseBMeta {\n1594\t            trace_idx: usize,\n1595\t            air_idx: usize,\n1596\t            n_lift: usize,\n1597\t            num_y: usize,\n1598\t            num_columns: usize, // total columns (selectors + preprocessed + mains)\n1599\t            interp_offset: usize, // element offset within the big interpolated buffer\n1600\t            col_start: usize,   // start index in the flat all_columns array\n1601\t            has_preprocessed: bool,\n1602\t            need_rot: bool,\n1603\t            has_constraints: bool,\n1604\t            has_interactions: bool,\n1605\t            norm_factor: F,\n1606\t        }\n1607\t        let mut case_b_traces: Vec<CaseBMeta> = Vec::new();\n1608\t        let mut all_columns: Vec<*const EF> = Vec::new();\n1609\t        let mut total_interp_elems: usize = 0;\n1610\t\n1611\t        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n1612\t            self.n_per_trace.iter(),\n1613\t            self.mat_evals_per_trace.iter(),\n1614\t            self.sels_per_trace.iter(),\n1615\t            self.d_eq_3b_per_trace.iter(),\n1616\t            self.public_values_per_trace.iter(),\n1617\t            self.air_indices_per_trace.iter()\n1618\t        )\n1619\t        .enumerate()\n1620\t        {\n1621\t            let pk = &self.pk.per_air[air_idx];\n1622\t            let dag = &pk.vk.symbolic_constraints;\n1623\t            let has_constraints = dag.constraints.num_constraints() > 0;\n1624\t            let has_interactions = !dag.interactions.is_empty();\n1625\t            if !has_constraints && !has_interactions {\n1626\t                continue;\n1627\t            }\n1628\t\n1629\t            let n_lift = n.max(0) as usize;\n1630\t            let norm_factor_denom = 1 << (-n).max(0);\n1631\t            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n1632\t            let has_preprocessed = pk.preprocessed_data.is_some();\n1633\t            let need_rot = pk.vk.params.need_rot;\n1634\t            let first_main_idx = usize::from(has_preprocessed);\n1635\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n1636\t\n1637\t            if round > n_lift {\n1638\t                // Case A\n1639\t                if round == n_lift + 1 {\n1640\t                    // A.1: evaluate directly at (num_x=1, num_y=1)\n1641\t                    let prep_ptr = if has_preprocessed {\n1642\t                        MainMatrixPtrs {\n1643\t                            data: mats[0].buffer().as_ptr(),\n1644\t                            air_width: air_width_for_mat(need_rot, mats[0].width()),\n1645\t                        }\n1646\t                    } else {\n1647\t                        MainMatrixPtrs {\n1648\t                            data: std::ptr::null(),\n1649\t                            air_width: 0,\n1650\t                        }\n1651\t                    };\n1652\t                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1653\t                        .iter()\n1654\t                        .map(|m| MainMatrixPtrs {\n1655\t                            data: m.buffer().as_ptr(),\n1656\t                            air_width: air_width_for_mat(need_rot, m.width()),\n1657\t                        })\n1658\t                        .collect_vec();\n1659\t                    let main_ptrs_dev = main_ptrs.to_device()?;\n1660\t\n1661\t                    late_eval.push(TraceCtx {\n1662\t                        trace_idx,\n1663\t                        air_idx,\n1664\t                        n_lift,\n1665\t                        num_y: 1,\n1666\t                        has_constraints,\n1667\t                        has_interactions,\n1668\t                        norm_factor,\n1669\t                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n1670\t                        sels_ptr: sels.buffer().as_ptr(),\n1671\t                        prep_ptr,\n1672\t                        main_ptrs_dev,\n1673\t                        public_ptr: public_vals.as_ptr(),\n1674\t                        eq_3bs_ptr: eq_3bs.as_ptr(),\n1675\t                    });\n1676\t                } else {\n1677\t                    // A.2: scale tilde evals only\n1678\t                    if has_constraints {\n1679\t                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n1680\t                        *tilde_eval *= r_prev;\n1681\t                    }\n1682\t                    if has_interactions {\n1683\t                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n1684\t                            *x *= r_prev;\n1685\t                        }\n1686\t                    }\n1687\t                }\n1688\t            } else {\n1689\t                // Case B: collect metadata for batched interpolation\n1690\t                let log_num_y = n_lift - round;\n1691\t                let num_y = 1 << log_num_y;\n1692\t                let height = 2 * num_y;\n1693\t                debug_assert_eq!(height, mats[0].height());\n1694\t\n1695\t                let col_start = all_columns.len();\n1696\t                // Collect all column pointers: selectors + all matrices (preprocessed + mains)\n1697\t                all_columns.extend(\n1698\t                    iter::once(sels)\n1699\t                        .chain(mats.iter())\n1700\t                        .flat_map(|m| {\n1701\t                            assert_eq!(m.height(), height);\n1702\t                            (0..m.width())\n1703\t                                .map(|col| m.buffer().as_ptr().wrapping_add(col * m.height()))\n1704\t                        }),\n1705\t                );\n1706\t                let num_columns = all_columns.len() - col_start;\n1707\t                let interp_size = sp_deg * num_y * num_columns;\n1708\t\n1709\t                case_b_traces.push(CaseBMeta {\n1710\t                    trace_idx,\n1711\t                    air_idx,\n1712\t                    n_lift,\n1713\t                    num_y,\n1714\t                    num_columns,\n1715\t                    interp_offset: total_interp_elems,\n1716\t                    col_start,\n1717\t                    has_preprocessed,\n1718\t                    need_rot,\n1719\t                    has_constraints,\n1720\t                    has_interactions,\n1721\t                    norm_factor,\n1722\t                });\n1723\t                total_interp_elems += interp_size;\n1724\t            }\n1725\t        }\n1726\t\n1727\t        // ── Phase 2: Batch allocate + single kernel launch ──\n1728\t        // One big buffer for all interpolated data, one kernel launch for all Case B traces.\n1729\t        let _keepalive_interpolated = if !case_b_traces.is_empty() {\n1730\t            let big_buf = DeviceBuffer::<EF>::with_capacity(total_interp_elems);\n1731\t            let big_ptr = big_buf.as_mut_ptr();\n1732\t\n1733\t            // Build descriptors with multi-block-per-trace assignment\n1734\t            const THREADS_PER_BLOCK: u32 = 512;\n1735\t            let mut block_offset: u32 = 0;\n1736\t            let descs: Vec<InterpColDesc> = case_b_traces\n1737\t                .iter()\n1738\t                .map(|meta| {\n1739\t                    let total_threads = (meta.num_y * meta.num_columns) as u32;\n1740\t                    let blocks = total_threads.div_ceil(THREADS_PER_BLOCK);\n1741\t                    let desc = InterpColDesc {\n1742\t                        output: unsafe { big_ptr.add(meta.interp_offset) },\n1743\t                        columns_offset: meta.col_start as u32,\n1744\t                        num_y: meta.num_y as u32,\n1745\t                        num_columns: meta.num_columns as u32,\n1746\t                        total_threads,\n1747\t                        block_start: block_offset,\n1748\t                    };\n1749\t                    block_offset += blocks;\n1750\t                    desc\n1751\t                })\n1752\t                .collect();\n1753\t            let total_blocks = block_offset as usize;\n1754\t\n1755\t            let d_descs = descs.to_device()?;\n1756\t            let d_all_columns = all_columns.to_device()?;\n1757\t            unsafe {\n1758\t                batched_interpolate_columns_gpu(&d_descs, &d_all_columns, sp_deg, total_blocks)\n1759\t                    .map_err(|e| LogupZerocheckError::InterpolateColumns(e.into()))?;\n1760\t            }\n1761\t\n1762\t            Some(big_buf)\n1763\t        } else {\n1764\t            None\n1765\t        };\n1766\t\n1767\t        // ── Phase 3: Build TraceCtx for each Case B trace ──\n1768\t        for meta in &case_b_traces {\n1769\t            let mats = &self.mat_evals_per_trace[meta.trace_idx];"}]},"parent_tool_use_id":"toolu_01MkhYY1U9QnfpzAQ7htKZsZ","session_id":"ae9b2456-7a6a-41ad-a41d-1e3f4310411a","uuid":"266777fe-b9f2-4518-97bc-8120cd99c833","timestamp":"2026-04-14T17:24:01.571Z"}
