-results/logs/20260413-104653-11-2-do.log-244-[Omitted long context line]\n/home/georg/stark-backend/autoopt-results/logs/20260413-104653-11-2-do.log-245-[Omitted long context line]\n/home/georg/stark-backend/autoopt-results/logs/20260413-104653-11-2-do.log-246-[Omitted long context line]\nautoopt-results/logs/20260413-104653-11-2-do.log:247:[Omitted long matching line]\nautoopt-results/logs/20260413-104653-11-2-do.log:248:[Omitted long matching line]\n/home/georg/stark-backend/autoopt-results/logs/20260413-104653-11-2-do.log-249-[Omitted long context line]\n/home/georg/stark-backend/autoopt-results/logs/20260413-104653-11-2-do.log-250-[Omitted long context line]\n/home/georg/stark-backend/autoopt-results/logs/20260413-104653-11-2-do.log-251-[Omitted long context line]","numLines":250,"appliedLimit":250}}
