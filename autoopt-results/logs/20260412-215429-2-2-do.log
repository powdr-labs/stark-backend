r_ctx.cached_mains {\n766\t                main_parts.push(committed.trace.buffer().as_ptr());\n767\t            }\n768\t            main_parts.push(air_ctx.common_main.buffer().as_ptr());\n769\t            let d_main_parts = main_parts.to_device()?;\n770\t\n771\t            let n_lift = n.max(0) as usize;\n772\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n773\t            let max_temp_bytes = self.memory_limit_bytes;\n774\t            // local_constraint_deg = 0 means no constraints. The only way that linear constraints\n775\t            // on trace polynomials could vanish on 2^l_skip points is if the constraint polynomial\n776\t            // is identically zero. Thus for local_constraint_deg = 0 or 1, we must have `s'_0 = 0`.\n777\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n778\t            let sum_buffer = evaluate_round0_constraints_gpu(\n779\t                single_pk,\n780\t                selectors_cube.buffer(),\n781\t                &d_main_parts,\n782\t                public_values,\n783\t                eq_xi_tree.get_ptr(n_lift),\n784\t                d_lambda_pows,\n785\t                1 << l_skip,\n786\t                1 << n_lift,\n787\t                height as u32,\n788\t                num_cosets_zc as u32,\n789\t                omega_root,\n790\t                max_temp_bytes,\n791\t            )?;\n792\t            if !sum_buffer.is_empty() {\n793\t                let q_evals = sum_buffer.to_host()?;\n794\t                let q = {\n795\t                    // Make q_evals row-major, with columns <> cosets\n796\t                    let mut values = EF::zero_vec(num_cosets_zc << l_skip);\n797\t                    for coset_idx in 0..num_cosets_zc {\n798\t                        for i in 0..1 << l_skip {\n799\t                            values[i * num_cosets_zc + coset_idx] =\n800\t                                q_evals[(coset_idx << l_skip) + i];\n801\t                        }\n802\t                    }\n803\t                    UnivariatePoly::from_geometric_cosets_evals_idft(\n804\t                        RowMajorMatrix::new(values, num_cosets_zc),\n805\t                        omega_root,\n806\t                        omega_root,\n807\t                    )\n808\t                };\n809\t                // sp_0 = (Z^{2^l_skip} - 1) * q\n810\t                let sp_0_deg = sumcheck_round0_deg(l_skip, local_constraint_deg);\n811\t                let coeffs = (0..=sp_0_deg)\n812\t                    .map(|i| {\n813\t                        let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n814\t                        if i >= 1 << l_skip {\n815\t                            c += q.coeffs()[i - (1 << l_skip)];\n816\t                        }\n817\t                        c\n818\t                    })\n819\t                    .collect_vec();\n820\t                debug_assert_eq!(\n821\t                    coeffs.iter().step_by(1 << l_skip).copied().sum::<EF>(),\n822\t                    EF::ZERO,\n823\t                    \"Zerocheck sum is not zero for air_id: {}\",\n824\t                    ctx.per_trace[trace_idx].0\n825\t                );\n826\t\n827\t                batch_sp_poly[2 * num_present_airs + trace_idx] = UnivariatePoly::new(coeffs);\n828\t            }\n829\t\n830\t            // PERF: we could use an interaction-specific constraint degree here\n831\t            let num_cosets_logup = local_constraint_deg;\n832\t            let sum = evaluate_round0_interactions_gpu(\n833\t                single_pk,\n834\t                &single_air_constraints,\n835\t                selectors_cube.buffer(),\n836\t                &d_main_parts,\n837\t                public_values,\n838\t                eq_xi_tree.get_ptr(n_lift),\n839\t                &self.beta_pows,\n840\t                eq_3bs,\n841\t                1 << l_skip,\n842\t                1 << n_lift,\n843\t                height as u32,\n844\t                num_cosets_logup as u32,\n845\t     