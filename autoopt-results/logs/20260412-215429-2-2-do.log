{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012uuSRLBpk5ffh8z3Rgd9ZF","type":"tool_result","content":"580\t            logup_tilde_evals: vec![[EF::ZERO; 2]; num_airs_present],\n581\t            needs_next_per_trace,\n582\t            trace_interactions,\n583\t            pk,\n584\t            prev_s_eval: EF::ZERO,\n585\t            eq_ns: Vec::with_capacity(n_max + 1),\n586\t            eq_sharp_ns: Vec::with_capacity(n_max + 1),\n587\t            mem,\n588\t            save_memory,\n589\t            gkr_mem_contribution: 0,\n590\t            memory_limit_bytes: 0, // Set after GKR input eval\n591\t            monomial_num_y_threshold,\n592\t        })\n593\t    }\n594\t\n595\t    // PERF[jpw]: we could return evals and batch zerocheck poly by degree before interpolating.\n596\t    // Cannot do it for logup because we need to calculate the sum claims.\n597\t    #[instrument(name = \"prover.rap_constraints.ple_round0\", level = \"info\", skip_all)]\n598\t    fn sumcheck_uni_round0_polys(\n599\t        &mut self,\n600\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n601\t        lambda: EF,\n602\t    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n603\t        self.mem\n604\t            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n605\t        self.mem.reset_peak();\n606\t        let n_logup = self.n_logup;\n607\t        let l_skip = self.l_skip;\n608\t        let xi = &self.xi;\n609\t        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n610\t        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n611\t            h_lambda_pows.to_device()?\n612\t        } else {\n613\t            DeviceBuffer::new()\n614\t        });\n615\t        // Precompute lambda combinations for all AIRs with monomials\n616\t        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n617\t        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n618\t            if air_pk.other_data.zerocheck_monomials.is_some() {\n619\t                self.lambda_combinations[air_idx] = Some(\n620\t                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n621\t                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n622\t                );\n623\t            }\n624\t        }\n625\t        let num_present_airs = ctx.per_trace.len();\n626\t        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n627\t\n628\t        self.eq_3b_per_trace = ctx\n629\t            .per_trace\n630\t            .iter()\n631\t            .enumerate()\n632\t            .map(|(trace_idx, (air_idx, _))| {\n633\t                let vk = &self.pk.per_air[*air_idx].vk;\n634\t                let num_interactions = vk.num_interactions();\n635\t                if num_interactions > 0 {\n636\t                    let n = self.n_per_trace[trace_idx];\n637\t                    let n_lift = n.max(0) as usize;\n638\t                    let mut b_vec = vec![F::ZERO; n_logup - n_lift];\n639\t                    let mut weights = Vec::with_capacity(num_interactions);\n640\t                    for interaction_idx in 0..num_interactions {\n641\t                        let stacked_idx = self\n642\t                            .interactions_layout\n643\t                            .get(trace_idx, interaction_idx)\n644\t                            .unwrap()\n645\t                            .row_idx;\n646\t                        let mut b_int = stacked_idx >> (l_skip + n_lift);\n647\t                        for bit in &mut b_vec {\n648\t                            *bit = F::from_bool(b_int & 1 == 1);\n649\t                            b_int >>= 1;\n650\t                        }\n651\t                        let weight =\n652\t                            eval_eq_mle(&self.xi[l_skip + n_lift..l_skip + n_logup], &b_vec);\n653\t                        weights.push(weight);\n654\t                    }\n655\t                    weights\n656\t                } else {\n657\t                    vec![]\n658\t                }\n659\t            })\n660\t            .collect_vec();\n661\t        self.d_eq_3b_per_trace = self\n662\t            .eq_3b_per_trace\n663\t            .iter()\n664\t            .map(|eq_3bs| {\n665\t                if eq_3bs.is_empty() {\n666\t                    Ok(DeviceBuffer::new())\n667\t                } else {\n668\t                    eq_3bs.to_device()\n669\t                }\n670\t            })\n671\t            .collect::<Result<Vec<_>, _>>()?;\n672\t\n673\t        // Precompute logup combinations for all traces with interaction monomials\n674\t        for (trace_idx, (air_idx, _)) in ctx.per_trace.iter().enumerate() {\n675\t            let air_pk = &self.pk.per_air[*air_idx];\n676\t            if air_pk.other_data.interaction_monomials.is_some()\n677\t                && !self.eq_3b_per_trace[trace_idx].is_empty()\n678\t            {\n679\t                self.logup_combinations[trace_idx] = Some(\n680\t                    compute_logup_combinations(\n681\t                        self.pk,\n682\t                        *air_idx,\n683\t                        &self.d_beta_pows,\n684\t                        &self.d_eq_3b_per_trace[trace_idx],\n685\t                        &self.eq_3b_per_trace[trace_idx],\n686\t                        &self.beta_pows,\n687\t                    )\n688\t                    .map_err(LogupZerocheckError::LogupCombinations)?,\n689\t                );\n690\t            }\n691\t        }\n692\t\n693\t        // PERF[jpw]: we could also build the layers for different n in a transposed way using\n694\t        // eq_nonoverlapping_stage_ext, which is more memory efficient\n695\t        for &n in &self.n_per_trace {\n696\t            let n_lift = n.max(0) as usize;\n697\t            if let Entry::Vacant(entry) = self.eq_xis.entry(n_lift) {\n698\t                let layers =\n699\t                    EqEvalLayers::new_rev(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n700\t                        .map_err(LogupZerocheckError::EqEvalLayers)?;\n701\t                entry.insert(layers);\n702\t            }\n703\t        }\n704\t\n705\t        self.sels_per_trace_base = self\n706\t            .n_per_trace\n707\t            .iter()\n708\t            .map(|&n| {\n709\t                let n_lift = n.max(0) as usize;\n710\t                let height = 1 << n_lift;\n711\t                let mut cols = F::zero_vec(3 * height);\n712\t                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n713\t                cols[0] = F::ONE; // is_first\n714\t                cols[2 * height + height - 1] = F::ONE; // is_last\n715\t                let d_cols = cols.to_device()?;\n716\t                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n717\t            })\n718\t            .collect::<Result<Vec<_>, MemCopyError>>()?;\n719\t\n720\t        let selectors_base = self.sels_per_trace_base.clone();\n721\t\n722\t        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n723\t        // present AIR\n724\t        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n725\t        let d_lambda_pows = self\n726\t            .lambda_pows\n727\t            .as_ref()\n728\t            .expect(\"lambda powers must be set before round-0 evaluation\");\n729\t\n730\t        // Loop through one AIR at a time; it is more efficient to do everything for one AIR\n731\t        // together\n732\t        for (trace_idx, ((air_idx, air_ctx), &n, selectors_cube, public_values, eq_3bs)) in izip!(\n733\t            &ctx.per_trace,\n734\t            &self.n_per_trace,\n735\t            &selectors_base,\n736\t            &self.public_values_per_trace,\n737\t            &self.eq_3b_per_trace,\n738\t        )\n739\t        .enumerate()\n740\t        {\n741\t            debug!(\"starting batch constraints for air_idx={air_idx} (trace_idx={trace_idx})\");\n742\t            let single_pk = &self.pk.per_air[*air_idx];\n743\t            // Includes both plain AIR constraints and symbolic interactions\n744\t            let single_air_constraints =\n745\t                SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n746\t            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n747\t            debug_assert_eq!(\n748\t                single_air_constraints.max_constraint_degree(),\n749\t                local_constraint_deg\n750\t            );\n751\t            assert!(\n752\t                local_constraint_deg <= self.constraint_degree,\n753\t                \"Max constraint degree ({local_constraint_deg}) of AIR {air_idx} exceeds the global maximum {}\",\n754\t                self.constraint_degree\n755\t            );\n756\t\n757\t            let log_large_domain = log2_ceil_usize(local_constraint_deg << l_skip);\n758\t            let omega_root = F::two_adic_generator(log_large_domain);\n759\t\n760\t            assert!(!xi.is_empty(), \"xi vector must not be empty\");\n761\t\n762\t            let height = air_ctx.common_main.height();\n763\t            let mut main_parts = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n764\t            for committed in &air_ctx.cached_mains {\n765\t                main_parts.push(committed.trace.buffer().as_ptr());\n766\t            }\n767\t            main_parts.push(air_ctx.common_main.buffer().as_ptr());\n768\t            let d_main_parts = main_parts.to_device()?;\n769\t\n770\t            let n_lift = n.max(0) as usize;\n771\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n772\t            let max_temp_bytes = self.memory_limit_bytes;\n773\t            // local_constraint_deg = 0 means no constraints. The only way that linear constraints\n774\t            // on trace polynomials could vanish on 2^l_skip points is if the constraint polynomial\n775\t            // is identically zero. Thus for local_constraint_deg = 0 or 1, we must have `s'_0 = 0`.\n776\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n777\t            let sum_buffer = evaluate_round0_constraints_gpu(\n778\t                single_pk,\n779\t                selectors_cube.buffer(),\n780\t                &d_main_parts,\n781\t                public_values,\n782\t                eq_xi_tree.get_ptr(n_lift),\n783\t                d_lambda_pows,\n784\t                1 << l_skip,\n785\t                1 << n_lift,\n786\t                height as u32,\n787\t                num_cosets_zc as u32,\n788\t                omega_root,\n789\t                max_temp_bytes,\n790\t            )?;\n791\t            if !sum_buffer.is_empty() {\n792\t                let q_evals = sum_buffer.to_host()?;\n793\t                let q = {\n794\t                    // Make q_evals row-major, with columns <> cosets\n795\t                    let mut values = EF::zero_vec(num_cosets_zc << l_skip);\n796\t                    for coset_idx in 0..num_cosets_zc {\n797\t                        for i in 0..1 << l_skip {\n798\t                            values[i * num_cosets_zc + coset_idx] =\n799\t                                q_evals[(coset_idx << l_skip) + i];\n800\t                        }\n801\t                    }\n802\t                    UnivariatePoly::from_geometric_cosets_evals_idft(\n803\t                        RowMajorMatrix::new(values, num_cosets_zc),\n804\t                        omega_root,\n805\t                        omega_root,\n806\t                    )\n807\t                };\n808\t                // sp_0 = (Z^{2^l_skip} - 1) * q\n809\t                let sp_0_deg = sumcheck_round0_deg(l_skip, local_constraint_deg);\n810\t                let coeffs = (0..=sp_0_deg)\n811\t                    .map(|i| {\n812\t                        let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n813\t                        if i >= 1 << l_skip {\n814\t                            c += q.coeffs()[i - (1 << l_skip)];\n815\t                        }\n816\t                        c\n817\t                    })\n818\t                    .collect_vec();\n819\t                debug_assert_eq!(\n820\t                    coeffs.iter().step_by(1 << l_skip).copied().sum::<EF>(),\n821\t                    EF::ZERO,\n822\t                    \"Zerocheck sum is not zero for air_id: {}\",\n823\t                    ctx.per_trace[trace_idx].0\n824\t                );\n825\t\n826\t                batch_sp_poly[2 * num_present_airs + trace_idx] = UnivariatePoly::new(coeffs);\n827\t            }\n828\t\n829\t            // PERF: we could use an interaction-specific constraint degree here\n830\t            let num_cosets_logup = local_constraint_deg;\n831\t            let sum = evaluate_round0_interactions_gpu(\n832\t                single_pk,\n833\t                &single_air_constraints,\n834\t                selectors_cube.buffer(),\n835\t                &d_main_parts,\n836\t                public_values,\n837\t                eq_xi_tree.get_ptr(n_lift),\n838\t                &self.beta_pows,\n839\t                eq_3bs,\n840\t                1 << l_skip,\n841\t                1 << n_lift,\n842\t                height as u32,\n843\t                num_cosets_logup as u32,\n844\t                omega_root,\n845\t                max_temp_bytes,\n846\t            )?;\n847\t            if !sum.is_empty() {\n848\t                let evals = sum.to_host()?;\n849\t                let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n850\t                    evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n851\t                if n.is_negative() {\n852\t                    // normalize for lifting\n853\t                    let norm_factor = F::from_u32(1 << n.unsigned_abs()).inverse();\n854\t                    for s in &mut numer {\n855\t                        *s *= norm_factor;\n856\t                    }\n857\t                }\n858\t                let mut numer_values = EF::zero_vec(num_cosets_logup << l_skip);\n859\t                let mut denom_values = EF::zero_vec(num_cosets_logup << l_skip);\n860\t                for coset_idx in 0..num_cosets_logup {\n861\t                    for i in 0..1 << l_skip {\n862\t                        let src = (coset_idx << l_skip) + i;\n863\t                        let dst = i * num_cosets_logup + coset_idx;\n864\t                        numer_values[dst] = numer[src];\n865\t                        denom_values[dst] = denom[src];\n866\t                    }\n867\t                }\n868\t                // Logup uses cosets 1, g^1, g^2, ... (init = 1, shift = omega_root)\n869\t                batch_sp_poly[2 * trace_idx] = UnivariatePoly::from_geometric_cosets_evals_idft(\n870\t                    RowMajorMatrix::new(numer_values, num_cosets_logup),\n871\t                    omega_root,\n872\t                    F::ONE, // init = 1 for identity coset\n873\t                );\n874\t                batch_sp_poly[2 * trace_idx + 1] = UnivariatePoly::from_geometric_cosets_evals_idft(\n875\t                    RowMajorMatrix::new(denom_values, num_cosets_logup),\n876\t                    omega_root,\n877\t                    F::ONE, // init = 1 for identity coset\n878\t                );\n879\t            }\n880\t        }\n881\t        self.mem\n882\t            .emit_metrics_with_label(\"prover.batch_constraints.round0\");\n883\t        Ok(batch_sp_poly)\n884\t    }\n885\t\n886\t    // Note: there are no gpu sync points in this function, so span does not indicate kernel times\n887\t    #[instrument(name = \"LogupZerocheck::fold_ple_evals\", level = \"debug\", skip_all)]\n888\t    fn fold_ple_evals(\n889\t        &mut self,\n890\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n891\t        r_0: EF,\n892\t    ) -> Result<(), LogupZerocheckError> {\n893\t        let l_skip = self.l_skip;\n894\t        let inv_lagrange_denoms_r0 =\n895\t            compute_barycentric_inv_lagrange_denoms(l_skip, &self.omega_skip_pows, r_0);\n896\t        let d_inv_lagrange_denoms_r0 = inv_lagrange_denoms_r0.to_device()?;\n897\t\n898\t        let mut mem_limit = self.gkr_mem_contribution;\n899\t        // GPU folding for mat_evals_per_trace"}]},"parent_tool_use_id":null,"session_id":"24111524-5945-406a-b911-d18148cb28ce","uuid":"595b2c16-f07f-4715-b396-0b68434c5b4e","timestamp":"2026-04-12T20:14:36.554Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/mod.rs","content":"            logup_tilde_evals: vec![[EF::ZERO; 2]; num_airs_present],\n            needs_next_per_trace,\n            trace_interactions,\n            pk,\n            prev_s_eval: EF::ZERO,\n            eq_ns: Vec::with_capacity(n_max + 1),\n            eq_sharp_ns: Vec::with_capacity(n_max + 1),\n            mem,\n            save_memory,\n            gkr_mem_contribution: 0,\n            memory_limit_bytes: 0, // Set after GKR input eval\n            monomial_num_y_threshold,\n        })\n    }\n\n    // PERF[jpw]: we could return evals and batch zerocheck poly by degree before interpolating.\n    // Cannot do it for logup because we need to calculate the sum claims.\n    #[instrument(name = \"prover.rap_constraints.ple_round0\", level = \"info\", skip_all)]\n    fn sumcheck_uni_round0_polys(\n        &mut self,\n        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n        lambda: EF,\n    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n        self.mem\n            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n        self.mem.reset_peak();\n        let n_logup = self.n_logup;\n        let l_skip = self.l_skip;\n        let xi = &self.xi;\n        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n            h_lambda_pows.to_device()?\n        } else {\n            DeviceBuffer::new()\n        });\n        // Precompute lambda combinations for all AIRs with monomials\n        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n            if air_pk.other_data.zerocheck_monomials.is_some() {\n                self.lambda_combinations[air_idx] = Some(\n                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n                );\n            }\n        }\n        let num_present_airs = ctx.per_trace.len();\n        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n\n        self.eq_3b_per_trace = ctx\n            .per_trace\n            .iter()\n            .enumerate()\n            .map(|(trace_idx, (air_idx, _))| {\n                let vk = &self.pk.per_air[*air_idx].vk;\n                let num_interactions = vk.num_interactions();\n                if num_interactions > 0 {\n                    let n = self.n_per_trace[trace_idx];\n                    let n_lift = n.max(0) as usize;\n                    let mut b_vec = vec![F::ZERO; n_logup - n_lift];\n                    let mut weights = Vec::with_capacity(num_interactions);\n                    for interaction_idx in 0..num_interactions {\n                        let stacked_idx = self\n                            .interactions_layout\n                            .get(trace_idx, interaction_idx)\n                            .unwrap()\n                            .row_idx;\n                        let mut b_int = stacked_idx >> (l_skip + n_lift);\n                        for bit in &mut b_vec {\n                            *bit = F::from_bool(b_int & 1 == 1);\n                            b_int >>= 1;\n                        }\n                        let weight =\n                            eval_eq_mle(&self.xi[l_skip + n_lift..l_skip + n_logup], &b_vec);\n                        weights.push(weight);\n                    }\n                    weights\n                } else {\n                    vec![]\n                }\n            })\n            .collect_vec();\n        self.d_eq_3b_per_trace = self\n            .eq_3b_per_trace\n            .iter()\n            .map(|eq_3bs| {\n                if eq_3bs.is_empty() {\n                    Ok(DeviceBuffer::new())\n                } else {\n                    eq_3bs.to_device()\n                }\n            })\n            .collect::<Result<Vec<_>, _>>()?;\n\n        // Precompute logup combinations for all traces with interaction monomials\n        for (trace_idx, (air_idx, _)) in ctx.per_trace.iter().enumerate() {\n            let air_pk = &self.pk.per_air[*air_idx];\n            if air_pk.other_data.interaction_monomials.is_some()\n                && !self.eq_3b_per_trace[trace_idx].is_empty()\n            {\n                self.logup_combinations[trace_idx] = Some(\n                    compute_logup_combinations(\n                        self.pk,\n                        *air_idx,\n                        &self.d_beta_pows,\n                        &self.d_eq_3b_per_trace[trace_idx],\n                        &self.eq_3b_per_trace[trace_idx],\n                        &self.beta_pows,\n                    )\n                    .map_err(LogupZerocheckError::LogupCombinations)?,\n                );\n            }\n        }\n\n        // PERF[jpw]: we could also build the layers for different n in a transposed way using\n        // eq_nonoverlapping_stage_ext, which is more memory efficient\n        for &n in &self.n_per_trace {\n            let n_lift = n.max(0) as usize;\n            if let Entry::Vacant(entry) = self.eq_xis.entry(n_lift) {\n                let layers =\n                    EqEvalLayers::new_rev(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n                        .map_err(LogupZerocheckError::EqEvalLayers)?;\n                entry.insert(layers);\n            }\n        }\n\n        self.sels_per_trace_base = self\n            .n_per_trace\n            .iter()\n            .map(|&n| {\n                let n_lift = n.max(0) as usize;\n                let height = 1 << n_lift;\n                let mut cols = F::zero_vec(3 * height);\n                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n                cols[0] = F::ONE; // is_first\n                cols[2 * height + height - 1] = F::ONE; // is_last\n                let d_cols = cols.to_device()?;\n                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n            })\n            .collect::<Result<Vec<_>, MemCopyError>>()?;\n\n        let selectors_base = self.sels_per_trace_base.clone();\n\n        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n        // present AIR\n        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n        let d_lambda_pows = self\n            .lambda_pows\n            .as_ref()\n            .expect(\"lambda powers must be set before round-0 evaluation\");\n\n        // Loop through one AIR at a time; it is more efficient to do everything for one AIR\n        // together\n        for (trace_idx, ((air_idx, air_ctx), &n, selectors_cube, public_values, eq_3bs)) in izip!(\n            &ctx.per_trace,\n            &self.n_per_trace,\n            &selectors_base,\n            &self.public_values_per_trace,\n            &self.eq_3b_per_trace,\n        )\n        .enumerate()\n        {\n            debug!(\"starting batch constraints for air_idx={air_idx} (trace_idx={trace_idx})\");\n            let single_pk = &self.pk.per_air[*air_idx];\n            // Includes both plain AIR constraints and symbolic interactions\n            let single_air_constraints =\n                SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n            debug_assert_eq!(\n                single_air_constraints.max_constraint_degree(),\n                local_constraint_deg\n            );\n            assert!(\n                local_constraint_deg <= self.constraint_degree,\n                \"Max constraint degree ({local_constraint_deg}) of AIR {air_idx} exceeds the global maximum {}\",\n                self.constraint_degree\n            );\n\n            let log_large_domain = log2_ceil_usize(local_constraint_deg << l_skip);\n            let omega_root = F::two_adic_generator(log_large_domain);\n\n            assert!(!xi.is_empty(), \"xi vector must not be empty\");\n\n            let height = air_ctx.common_main.height();\n            let mut main_parts = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n            for committed in &air_ctx.cached_mains {\n                main_parts.push(committed.trace.buffer().as_ptr());\n            }\n            main_parts.push(air_ctx.common_main.buffer().as_ptr());\n            let d_main_parts = main_parts.to_device()?;\n\n            let n_lift = n.max(0) as usize;\n            let eq_xi_tree = &self.eq_xis[&n_lift];\n            let max_temp_bytes = self.memory_limit_bytes;\n            // local_constraint_deg = 0 means no constraints. The only way that linear constraints\n            // on trace polynomials could vanish on 2^l_skip points is if the constraint polynomial\n            // is identically zero. Thus for local_constraint_deg = 0 or 1, we must have `s'_0 = 0`.\n            let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n            let sum_buffer = evaluate_round0_constraints_gpu(\n                single_pk,\n                selectors_cube.buffer(),\n                &d_main_parts,\n                public_values,\n                eq_xi_tree.get_ptr(n_lift),\n                d_lambda_pows,\n                1 << l_skip,\n                1 << n_lift,\n                height as u32,\n                num_cosets_zc as u32,\n                omega_root,\n                max_temp_bytes,\n            )?;\n            if !sum_buffer.is_empty() {\n                let q_evals = sum_buffer.to_host()?;\n                let q = {\n                    // Make q_evals row-major, with columns <> cosets\n                    let mut values = EF::zero_vec(num_cosets_zc << l_skip);\n                    for coset_idx in 0..num_cosets_zc {\n                        for i in 0..1 << l_skip {\n                            values[i * num_cosets_zc + coset_idx] =\n                                q_evals[(coset_idx << l_skip) + i];\n                        }\n                    }\n                    UnivariatePoly::from_geometric_cosets_evals_idft(\n                        RowMajorMatrix::new(values, num_cosets_zc),\n                        omega_root,\n                        omega_root,\n                    )\n                };\n                // sp_0 = (Z^{2^l_skip} - 1) * q\n                let sp_0_deg = sumcheck_round0_deg(l_skip, local_constraint_deg);\n                let coeffs = (0..=sp_0_deg)\n                    .map(|i| {\n                        let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n                        if i >= 1 << l_skip {\n                            c += q.coeffs()[i - (1 << l_skip)];\n                        }\n                        c\n                    })\n                    .collect_vec();\n                debug_assert_eq!(\n                    coeffs.iter().step_by(1 << l_skip).copied().sum::<EF>(),\n                    EF::ZERO,\n                    \"Zerocheck sum is not zero for air_id: {}\",\n                    ctx.per_trace[trace_idx].0\n                );\n\n                batch_sp_poly[2 * num_present_airs + trace_idx] = UnivariatePoly::new(coeffs);\n            }\n\n            // PERF: we could use an interaction-specific constraint degree here\n            let num_cosets_logup = local_constraint_deg;\n            let sum = evaluate_round0_interactions_gpu(\n                single_pk,\n                &single_air_constraints,\n                selectors_cube.buffer(),\n                &d_main_parts,\n                public_values,\n                eq_xi_tree.get_ptr(n_lift),\n                &self.beta_pows,\n                eq_3bs,\n                1 << l_skip,\n                1 << n_lift,\n                height as u32,\n                num_cosets_logup as u32,\n                omega_root,\n                max_temp_bytes,\n            )?;\n            if !sum.is_empty() {\n                let evals = sum.to_host()?;\n                let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n                    evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n                if n.is_negative() {\n                    // normalize for lifting\n                    let norm_factor = F::from_u32(1 << n.unsigned_abs()).inverse();\n                    for s in &mut numer {\n                        *s *= norm_factor;\n                    }\n                }\n                let mut numer_values = EF::zero_vec(num_cosets_logup << l_skip);\n                let mut denom_values = EF::zero_vec(num_cosets_logup << l_skip);\n                for coset_idx in 0..num_cosets_logup {\n                    for i in 0..1 << l_skip {\n                        let src = (coset_idx << l_skip) + i;\n                        let dst = i * num_cosets_logup + coset_idx;\n                        numer_values[dst] = numer[src];\n                        denom_values[dst] = denom[src];\n                    }\n                }\n                // Logup uses cosets 1, g^1, g^2, ... (init = 1, shift = omega_root)\n                batch_sp_poly[2 * trace_idx] = UnivariatePoly::from_geometric_cosets_evals_idft(\n                    RowMajorMatrix::new(numer_values, num_cosets_logup),\n                    omega_root,\n                    F::ONE, // init = 1 for identity coset\n                );\n                batch_sp_poly[2 * trace_idx + 1] = UnivariatePoly::from_geometric_cosets_evals_idft(\n                    RowMajorMatrix::new(denom_values, num_cosets_logup),\n                    omega_root,\n                    F::ONE, // init = 1 for identity coset\n                );\n            }\n        }\n        self.mem\n            .emit_metrics_with_label(\"prover.batch_constraints.round0\");\n        Ok(batch_sp_poly)\n    }\n\n    // Note: there are no gpu sync points in this function, so span does not indicate kernel times\n    #[instrument(name = \"LogupZerocheck::fold_ple_evals\", level = \"debug\", skip_all)]\n    fn fold_ple_evals(\n        &mut self,\n        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n        r_0: EF,\n    ) -> Result<(), LogupZerocheckError> {\n        let l_skip = self.l_skip;\n        let inv_lagrange_denoms_r0 =\n            compute_barycentric_inv_lagrange_denoms(l_skip, &self.omega_skip_pows, r_0);\n        let d_inv_lagrange_denoms_r0 = inv_lagrange_denoms_r0.to_device()?;\n\n        let mut mem_limit = self.gkr_mem_contribution;\n        // GPU folding for mat_evals_per_trace","numLines":320,"startLine":580,"totalLines":1605}}}
