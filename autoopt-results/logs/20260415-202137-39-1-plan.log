{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LFnhP8grnpAPpiuhdcu7AC","type":"tool_result","content":"200\t    /// Unique decoding regime in the initial `list_start_round` WHIR rounds. Then list decoding\n201\t    /// regime with the same proximity radius derived from `m` (see `ListDecoding`) for all\n202\t    /// subsequent WHIR rounds (0-indices `>= list_start_round`). Note that a WHIR round\n203\t    /// consists of codewords of different degrees with the same rate. The WHIR round changes\n204\t    /// when the rate changes.\n205\t    SplitUniqueList { m: usize, list_start_round: usize },\n206\t    /// List decoding regime in every WHIR round, with the same proximity radius derived from `m`,\n207\t    /// where `m = ceil(sqrt(\\rho) / 2 \\eta), \\eta = 1 - sqrt(\\rho) - \\delta, where \\delta is the\n208\t    /// proximity radius.\n209\t    ListDecoding { m: usize },\n210\t}\n211\t\n212\timpl WhirProximityStrategy {\n213\t    pub fn initial_round(&self) -> ProximityRegime {\n214\t        self.in_round(0)\n215\t    }\n216\t\n217\t    pub fn in_round(&self, whir_round: usize) -> ProximityRegime {\n218\t        match *self {\n219\t            Self::UniqueDecoding => ProximityRegime::UniqueDecoding,\n220\t            Self::SplitUniqueList {\n221\t                m,\n222\t                list_start_round,\n223\t            } => {\n224\t                if whir_round < list_start_round {\n225\t                    ProximityRegime::UniqueDecoding\n226\t                } else {\n227\t                    ProximityRegime::ListDecoding { m }\n228\t                }\n229\t            }\n230\t            Self::ListDecoding { m } => ProximityRegime::ListDecoding { m },\n231\t        }\n232\t    }\n233\t}\n234\t\n235\t/// Defines the proximity regime for the proof system.\n236\t#[derive(Clone, Copy, Debug, Serialize, Deserialize, PartialEq, Eq)]\n237\tpub enum ProximityRegime {\n238\t    /// Unique decoding guarantees a single valid witness.\n239\t    UniqueDecoding,\n240\t    /// List decoding bounded by multiplicity `m`.\n241\t    ListDecoding { m: usize },\n242\t}\n243\t\n244\timpl ProximityRegime {\n245\t    /// Returns total security bits for `num_queries` WHIR queries.\n246\t    ///\n247\t    /// This treats the per-query error as an upper bound on the maximum agreement.\n248\t    ///\n249\t    /// - `UniqueDecoding`: max agreement is `(1 + ρ) / 2`.\n250\t    /// - `ListDecoding { m }`: finite-multiplicity Guruswami-Sudan threshold, `sqrt(ρ(1 + 1/m)) +\n251\t    ///   ε` for a tiny `ε`, to keep the proximity threshold strict.\n252\t    pub fn whir_query_security_bits(&self, num_queries: usize, log_inv_rate: usize) -> f64 {\n253\t        let rho = 2.0_f64.powf(-(log_inv_rate as f64));\n254\t        let max_agreement = match *self {\n255\t            ProximityRegime::UniqueDecoding => (1.0 + rho) / 2.0,\n256\t            ProximityRegime::ListDecoding { m } => {\n257\t                let m = m.max(1) as f64;\n258\t                // Johnson bound with a tiny epsilon to ensure strict proximity.\n259\t                (rho * (1.0 + 1.0 / m)).sqrt() + 1e-6\n260\t            }\n261\t        };\n262\t\n263\t        // Keep the `log2` well-defined.\n264\t        let max_agreement = max_agreement.clamp(f64::MIN_POSITIVE, 1.0);\n265\t        -(num_queries as f64) * max_agreement.log2()\n266\t    }\n267\t\n268\t    /// Returns the per-query security bits for WHIR query sampling.\n269\t    pub fn whir_per_query_security_bits(&self, log_inv_rate: usize) -> f64 {\n270\t        self.whir_query_security_bits(1, log_inv_rate)\n271\t    }\n272\t}\n273\t\n274\timpl WhirConfig {\n275\t    /// Sets parameters targeting `security_bits` of provable security (including grinding), using\n276\t    /// the given proximity regime.\n277\t    pub fn new(\n278\t        log_blowup: usize,\n279\t        log_stacked_height: usize,\n280\t        whir_params: WhirParams,\n281\t        security_bits: usize,\n282\t    ) -> Self {\n283\t        let query_phase_pow_bits = whir_params.query_phase_pow_bits;\n284\t        let protocol_security_level = security_bits.saturating_sub(query_phase_pow_bits);\n285\t        let k_whir = whir_params.k;\n286\t        let num_rounds = log_stacked_height\n287\t            .saturating_sub(whir_params.log_final_poly_len)\n288\t            .div_ceil(k_whir);\n289\t        let mut log_inv_rate = log_blowup;\n290\t        let proximity = whir_params.proximity;\n291\t\n292\t        let mut round_parameters = Vec::with_capacity(num_rounds);\n293\t        for round in 0..num_rounds {\n294\t            // Queries are set w.r.t. to old rate, while the rest to the new rate\n295\t            let next_rate = log_inv_rate + (k_whir - 1);\n296\t\n297\t            let num_queries = Self::queries(\n298\t                proximity.in_round(round),\n299\t                protocol_security_level,\n300\t                log_inv_rate,\n301\t            );\n302\t            round_parameters.push(WhirRoundConfig { num_queries });\n303\t\n304\t            log_inv_rate = next_rate;\n305\t        }\n306\t\n307\t        Self {\n308\t            k: k_whir,\n309\t            rounds: round_parameters,\n310\t            mu_pow_bits: whir_params.mu_pow_bits,\n311\t            query_phase_pow_bits,\n312\t            folding_pow_bits: whir_params.folding_pow_bits,\n313\t            proximity,\n314\t        }\n315\t    }\n316\t\n317\t    #[inline]\n318\t    pub fn log_final_poly_len(&self, log_stacked_height: usize) -> usize {\n319\t        log_stacked_height - self.num_whir_rounds() * self.k\n320\t    }\n321\t\n322\t    pub fn num_whir_rounds(&self) -> usize {\n323\t        self.rounds.len()\n324\t    }\n325\t\n326\t    #[inline]\n327\t    pub fn num_sumcheck_rounds(&self) -> usize {\n328\t        self.num_whir_rounds() * self.k\n329\t    }\n330\t\n331\t    /// Pure function to calculate the number of queries necessary for a given WHIR round.\n332\t    /// - `protocol_security_level` refers to the target bits of security without grinding.\n333\t    /// - `log_inv_rate` is the log blowup for the WHIR round we want to calculate the number of\n334\t    ///   queries for.\n335\t    // Source: https://github.com/WizardOfMenlo/whir/blob/cf1599b56ff50e09142ebe6d2e2fbd86875c9986/src/whir/parameters.rs#L457\n336\t    pub fn queries(\n337\t        proximity_regime: ProximityRegime,\n338\t        protocol_security_level: usize,\n339\t        log_inv_rate: usize,\n340\t    ) -> usize {\n341\t        let per_query_bits = proximity_regime.whir_per_query_security_bits(log_inv_rate);\n342\t        let num_queries_f = (protocol_security_level as f64) / per_query_bits;\n343\t        num_queries_f.ceil() as usize\n344\t    }\n345\t}\n346\t\n347\t#[cfg(test)]\n348\tmod tests {\n349\t    use super::*;\n350\t\n351\t    #[test]\n352\t    fn test_whir_list_decoding_query_bits_monotone_in_num_queries() {\n353\t        let regime = ProximityRegime::ListDecoding { m: 2 };\n354\t        let sec_10 = regime.whir_query_security_bits(10, 1);\n355\t        let sec_20 = regime.whir_query_security_bits(20, 1);\n356\t        assert!(sec_20 > sec_10);\n357\t        assert!(sec_10 > 0.0);\n358\t    }\n359\t}\n360\t"}]},"parent_tool_use_id":"toolu_01K9cn6kwGpcg9KH6DUW4563","session_id":"56bc24eb-d9a0-4ad2-8690-031f38c3d9d4","uuid":"bacffc8a-73d0-4f97-9859-b2600f6b916e","timestamp":"2026-04-15T18:46:50.056Z"}
