{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TTjBgc8LsZfoZHBkL3KTNB","type":"tool_result","content":"1\tuse getset::MutGetters;\n2\tuse openvm_stark_backend::{prover::Coordinator, StarkEngine, SystemParams};\n3\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n4\tuse openvm_stark_sdk::config::baby_bear_bn254_poseidon2::BabyBearBn254Poseidon2Config;\n5\t\n6\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n7\tuse crate::{\n8\t    bn254_sponge::MultiField32ChallengerGpu, gpu_backend::GenericGpuBackend,\n9\t    hash_scheme::BabyBearBn254Poseidon2HashScheme,\n10\t};\n11\tuse crate::{\n12\t    hash_scheme::{DefaultHashScheme, GpuHashScheme},\n13\t    prelude::SC,\n14\t    sponge::DuplexSpongeGpu,\n15\t    GpuBackend, GpuDevice,\n16\t};\n17\t\n18\t/// Generic GPU proving engine parameterised by a hash scheme.\n19\t///\n20\t/// Use the [`BabyBearPoseidon2GpuEngine`] type alias for the default Poseidon2 engine.\n21\t#[derive(MutGetters)]\n22\tpub struct GpuEngine<HS: GpuHashScheme> {\n23\t    #[getset(get_mut = \"pub\")]\n24\t    device: GpuDevice,\n25\t    #[getset(get_mut = \"pub\")]\n26\t    config: HS::SC,\n27\t}\n28\t\n29\t/// Concrete GPU engine using the default BabyBear-Poseidon2 hash scheme.\n30\tpub type BabyBearPoseidon2GpuEngine = GpuEngine<DefaultHashScheme>;\n31\t\n32\t/// GPU engine using the BabyBear + BN254 Poseidon2 hash scheme (Groth16-friendly).\n33\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n34\tpub type BabyBearBn254Poseidon2GpuEngine = GpuEngine<BabyBearBn254Poseidon2HashScheme>;\n35\t\n36\timpl<HS: GpuHashScheme> GpuEngine<HS> {\n37\t    pub fn new(params: SystemParams) -> Self {\n38\t        let config = HS::default_config(params.clone());\n39\t        Self {\n40\t            device: GpuDevice::new(params),\n41\t            config,\n42\t        }\n43\t    }\n44\t}\n45\t\n46\timpl StarkEngine for GpuEngine<DefaultHashScheme> {\n47\t    type SC = SC;\n48\t    type PB = GpuBackend;\n49\t    type PD = GpuDevice;\n50\t    type TS = DuplexSpongeGpu;\n51\t\n52\t    fn new(params: SystemParams) -> Self {\n53\t        GpuEngine::new(params)\n54\t    }\n55\t\n56\t    fn config(&self) -> &Self::SC {\n57\t        &self.config\n58\t    }\n59\t\n60\t    fn device(&self) -> &Self::PD {\n61\t        &self.device\n62\t    }\n63\t\n64\t    fn initial_transcript(&self) -> Self::TS {\n65\t        DuplexSpongeGpu::default()\n66\t    }\n67\t\n68\t    fn prover_from_transcript(\n69\t        &self,\n70\t        transcript: DuplexSpongeGpu,\n71\t    ) -> Coordinator<SC, Self::PB, Self::PD, Self::TS> {\n72\t        Coordinator::new(GpuBackend::default(), self.device.clone(), transcript)\n73\t    }\n74\t}\n75\t\n76\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n77\timpl StarkEngine for GpuEngine<BabyBearBn254Poseidon2HashScheme> {\n78\t    type SC = BabyBearBn254Poseidon2Config;\n79\t    type PB = GenericGpuBackend<BabyBearBn254Poseidon2HashScheme>;\n80\t    type PD = GpuDevice;\n81\t    type TS = MultiField32ChallengerGpu;\n82\t\n83\t    fn new(params: SystemParams) -> Self {\n84\t        GpuEngine::new(params)\n85\t    }\n86\t\n87\t    fn config(&self) -> &Self::SC {\n88\t        &self.config\n89\t    }\n90\t\n91\t    fn device(&self) -> &Self::PD {\n92\t        &self.device\n93\t    }\n94\t\n95\t    fn initial_transcript(&self) -> Self::TS {\n96\t        MultiField32ChallengerGpu::default()\n97\t    }\n98\t\n99\t    fn prover_from_transcript(\n100\t        &self,\n101\t        transcript: MultiField32ChallengerGpu,\n102\t    ) -> Coordinator<BabyBearBn254Poseidon2Config, Self::PB, Self::PD, Self::TS> {\n103\t        Coordinator::new(\n104\t            GenericGpuBackend::default(),\n105\t            self.device.clone(),\n106\t            transcript,\n107\t        )\n108\t    }\n109\t}\n110\t"}]},"parent_tool_use_id":"toolu_01FtRsDbk6MPwU34birWQ8J3","session_id":"56bc24eb-d9a0-4ad2-8690-031f38c3d9d4","uuid":"66fa75c6-a738-4d7a-b9eb-1c20408b99ea","timestamp":"2026-04-15T18:34:29.528Z"}
