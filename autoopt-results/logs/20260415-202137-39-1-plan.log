{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018JvNePTbpUc8vnD5chVikT","type":"tool_result","content":"1\t#pragma once\n2\t\n3\t#include \"fp.h\"\n4\t#include \"fpext.h\"\n5\t#include \"launcher.cuh\"\n6\t#include <cstdint>\n7\t#include <device_atomic_functions.h>\n8\t\n9\tnamespace sumcheck {\n10\t\n11\ttemplate <typename Field>\n12\t__device__ __forceinline__ Field\n13\tmle_interpolate_single(const Field *__restrict__ column, Fp x, uint32_t y_int) {\n14\t    auto t0 = column[y_int << 1];\n15\t    auto t1 = column[(y_int << 1) | 1];\n16\t    return t0 + (t1 - t0) * x;\n17\t}\n18\t\n19\t// Warp-level reduction: sums FpExt values across threads in a warp (32 threads)\n20\t// Uses shuffle instructions for efficient communication within a warp\n21\tstatic __device__ inline FpExt warp_reduce_sum(FpExt val) {\n22\t    unsigned mask = __activemask();\n23\t\n24\t#pragma unroll\n25\t    for (int offset = 16; offset > 0; offset /= 2) {\n26\t        FpExt other;\n27\t        other.elems[0] = Fp::fromRaw(__shfl_down_sync(mask, val.elems[0].asRaw(), offset));\n28\t        other.elems[1] = Fp::fromRaw(__shfl_down_sync(mask, val.elems[1].asRaw(), offset));\n29\t        other.elems[2] = Fp::fromRaw(__shfl_down_sync(mask, val.elems[2].asRaw(), offset));\n30\t        other.elems[3] = Fp::fromRaw(__shfl_down_sync(mask, val.elems[3].asRaw(), offset));\n31\t        val = val + other;\n32\t    }\n33\t    return val;\n34\t}\n35\t\n36\t// Reduce FpExt across n threads using warp shuffles (butterfly pattern)\n37\t// n must be a power of 2, 1 <= n <= 32\n38\t// All participating threads must call this function\n39\t__device__ __forceinline__ FpExt warp_reduce_sum_n(FpExt val, uint32_t n) {\n40\t    for (uint32_t offset = n >> 1; offset > 0; offset >>= 1) {\n41\t        FpExt other;\n42\t#pragma unroll\n43\t        for (int i = 0; i < 4; i++) {\n44\t            other.elems[i] =\n45\t                Fp::fromRaw(__shfl_xor_sync(0xffffffff, val.elems[i].asRaw(), offset));\n46\t        }\n47\t        val = val + other;\n48\t    }\n49\t    return val;\n50\t}\n51\t\n52\t// Reduce FpExt across chunk_size threads within a block\n53\t// chunk_size must be a power of 2\n54\t// tid_in_chunk: thread's index within its chunk [0, chunk_size)\n55\t// chunk_in_block: which chunk this thread belongs to\n56\t// smem: shared memory for cross-warp reduction (size >= total_warps_in_block)\n57\t//\n58\t// Note: When chunk_size > 32, writes to chunk_smem[warp_in_chunk] from different chunks\n59\t// may hit the same bank (FpExt = 16 bytes = 4 words). This is a minor inefficiency in the\n60\t// reduction phase, not a correctness issue.\n61\t__device__ inline FpExt chunk_reduce_sum(\n62\t    FpExt val,\n63\t    FpExt *smem,\n64\t    uint32_t tid_in_chunk,\n65\t    uint32_t chunk_size,\n66\t    uint32_t chunk_in_block\n67\t) {\n68\t    if (chunk_size <= 32) {\n69\t        return warp_reduce_sum_n(val, chunk_size);\n70\t    }\n71\t\n72\t    // Cross-warp case (chunk_size > 32)\n73\t    uint32_t warps_per_chunk = chunk_size >> 5;\n74\t    uint32_t warp_in_chunk = tid_in_chunk >> 5;\n75\t    uint32_t lane_id = tid_in_chunk & 31;\n76\t\n77\t    // Step 1: Warp-level reduction\n78\t    val = warp_reduce_sum(val);\n79\t\n80\t    // Step 2: Store warp result to shared memory\n81\t    FpExt *chunk_smem = smem + chunk_in_block * warps_per_chunk;\n82\t    if (lane_id == 0) {\n83\t        chunk_smem[warp_in_chunk] = val;\n84\t    }\n85\t    __syncthreads();\n86\t\n87\t    // Step 3: First warp of chunk reads and reduces warp results\n88\t    if (warp_in_chunk == 0) {\n89\t        FpExt zero = {0, 0, 0, 0};\n90\t        FpExt warp_val = (lane_id < warps_per_chunk) ? chunk_smem[lane_id] : zero;\n91\t        val = warp_reduce_sum(warp_val);\n92\t    }\n93\t\n94\t    return val;\n95\t}\n96\t\n97\t// ============================================================================\n98\t// ATOMIC U64 ACCUMULATION (delayed modular reduction to CPU)\n99\t// ============================================================================\n100\t//\n101\t// BabyBear elements in Montgomery form are < 2^31. Summing N elements in uint64_t\n102\t// overflows when N * 2^31 > 2^64, i.e., N > 2^33. Safe for typical GPU workloads.\n103\t// Final modular reduction is done on CPU after kernel completion.\n104\t\n105\t// Atomically add Fp raw value to uint64_t accumulator\n106\t__device__ __forceinline__ void atomic_add_fp_to_u64(uint64_t *output, Fp val) {\n107\t    atomicAdd((unsigned long long *)output, static_cast<uint64_t>(val.asRaw()));\n108\t}\n109\t\n110\t// Atomically add FpExt to uint64_t[4] accumulator\n111\t// Layout: output[0..3] correspond to elems[0..3]\n112\t__device__ __forceinline__ void atomic_add_fpext_to_u64(uint64_t *output, FpExt val) {\n113\t#pragma unroll\n114\t    for (int i = 0; i < 4; ++i) {\n115\t        atomic_add_fp_to_u64(output + i, val.elems[i]);\n116\t    }\n117\t}\n118\t\n119\t// ============================================================================\n120\t// WARP-AGGREGATED ATOMIC REDUCTION\n121\t// ============================================================================\n122\t//\n123\t// Modern best practice for block-wide sums on Volta+ architectures:\n124\t// 1. Warp-level reduction via __shfl_down_sync (zero memory latency)\n125\t// 2. Lane 0 of each warp does one atomicAdd to global memory\n126\t// 3. No __syncthreads() or shared memory required\n127\t//\n128\t// Trade-off: More atomics than full block reduction (num_warps vs 1), but\n129\t// eliminates barrier latency and shared memory bank conflicts. Modern L2\n130\t// caches handle concurrent atomics efficiently.\n131\t\n132\t// Warp-aggregated atomic: reduce within warp, lane 0 does single atomic add\n133\t__device__ __forceinline__ void warp_aggregated_atomic_add_fpext(\n134\t    uint64_t *output, // Global memory, uint64_t[4] for one FpExt\n135\t    FpExt val\n136\t) {\n137\t    // Step 1: Warp-level reduction via shuffles\n138\t    val = warp_red