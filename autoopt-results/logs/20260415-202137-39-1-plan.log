erlying type alignment must divide the former one\"\n175\t        );\n176\t        let res = DeviceBuffer {\n177\t            ptr: self.ptr as *mut U,\n178\t            len: self.len * (size_of::<T>() / size_of::<U>()),\n179\t            owns_memory: self.owns_memory,\n180\t        };\n181\t        self.ptr = ptr::null_mut(); // for safe drop\n182\t        self.len = 0;\n183\t        res\n184\t    }\n185\t\n186\t    pub fn view(&self) -> DeviceBufferView {\n187\t        DeviceBufferView {\n188\t            ptr: self.ptr as *const c_void,\n189\t            size: self.len * size_of::<T>(),\n190\t        }\n191\t    }\n192\t}\n193\t\n194\timpl<T> Drop for DeviceBuffer<T> {\n195\t    fn drop(&mut self) {\n196\t        if self.owns_memory && !self.ptr.is_null() {\n197\t            tracing::debug!(\n198\t                \"Freeing device buffer of size {} (sizeof type = {})\",\n199\t                self.len,\n200\t                size_of::<T>()\n201\t            );"}]},"parent_tool_use_id":"toolu_0195TSfhzKAqubPTtiSKo625","session_id":"56bc24eb-d9a0-4ad2-8690-031f38c3d9d4","uuid":"9b50a16a-bfad-4643-832a-1ac6f0cfec95","timestamp":"2026-04-15T19:15:06.141Z"}
