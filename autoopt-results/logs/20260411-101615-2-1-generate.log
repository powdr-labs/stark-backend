.unwrap()\n47\t                });\n48\t                let other_data = AirDataGpu::new(pk).unwrap();\n49\t                let num_monomials = other_data\n50\t                    .zerocheck_monomials\n51\t                    .as_ref()\n52\t                    .map(|m| m.num_monomials)\n53\t                    .unwrap_or(0);\n54\t                debug!(air = %pk.air_name, num_monomials, \"monomial expansion\");\n55\t\n56\t                DeviceStarkProvingKey {\n57\t                    air_name: pk.air_name.clone(),\n58\t                    vk: pk.vk.clone(),\n59\t                    preprocessed_data,\n60\t                    other_data,\n61\t                }\n62\t            })\n63\t            .collect();\n64\t        // Synchronize in case the proving key is shared between threads/streams\n65\t        current_stream_sync().unwrap();\n66\t\n67\t        DeviceMultiStarkProvingKey::new(\n68\t            per_air,\n69\t            mpk.trace_height_constraints.clone(),\n70\t            mpk.max_constraint_degree,\n71\t            mpk.params.clone(),\n72\t            mpk.vk_pre_hash,\n73\t        )\n74\t    }\n75\t\n76\t    fn transport_matrix_to_device(&self, matrix: &ColMajorMatrix<F>) -> DeviceMatrix<F> {\n77\t        transport_matrix_h2d_col_major(matrix).unwrap()\n78\t    }\n79\t\n80\t    fn transport_pcs_data_to_device(\n81\t        &self,\n82\t        pcs_data: &StackedPcsData<F, HS::Digest>,\n83\t    ) -> StackedPcsDataGpu<F, HS::Digest> {\n84\t        transport_pcs_data_h2d::<HS::Digest>(pcs_data, &self.prover_config).unwrap()\n85\t    }\n86\t\n87\t    fn transport_matrix_from_device_to_host(&self, matrix: &DeviceMatrix<F>) -> ColMajorMatrix<F> {\n88\t        transport_matrix_d2h_col_major(matrix).unwrap()\n89\t    }\n90\t}\n91\t\n92\tpub fn transport_matrix_h2d_col_major<T>(\n93\t    matrix: &ColMajorMatrix<T>,\n94\t) -> Result<DeviceMatrix<T>, MemCopyError> {\n95\t    // matrix is already col-major, so this is just H2D buffer transfer\n96\t    let buffer = m