{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GDuv3MGeEthqy4n1SgivDr","type":"tool_result","content":"1\tuse itertools::Itertools;\n2\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer};\n3\tuse openvm_stark_backend::{\n4\t    air_builders::symbolic::{\n5\t        symbolic_expression::SymbolicExpression, SymbolicConstraints, SymbolicDagBuilder,\n6\t        SymbolicExpressionDag,\n7\t    },\n8\t    prover::{fractional_sumcheck_gkr::Frac, DeviceStarkProvingKey},\n9\t};\n10\tuse p3_field::PrimeCharacteristicRing;\n11\tuse tracing::{debug, warn};\n12\t\n13\tuse super::errors::Round0EvalError;\n14\tuse crate::{\n15\t    cuda::logup_zerocheck::{\n16\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n17\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n18\t        logup_bary_eval_interactions_round0, zerocheck_ntt_eval_constraints,\n19\t    },\n20\t    gpu_backend::GenericGpuBackend,\n21\t    hash_scheme::GpuHashScheme,\n22\t    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n23\t    prelude::{EF, F},\n24\t};\n25\t\n26\t/// Evaluate plain AIR constraints (not interactions) for a single AIR, given prepared trace input.\n27\t///\n28\t/// `num_cosets` should equal `constraint_degree - 1` because we evaluate the quotient polynomial.\n29\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n30\t#[allow(clippy::too_many_arguments)]\n31\tpub fn evaluate_round0_constraints_gpu<HS: GpuHashScheme>(\n32\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n33\t    selectors_cube: &DeviceBuffer<F>,\n34\t    main_parts: &DeviceBuffer<*const F>,\n35\t    public_values: &DeviceBuffer<F>,\n36\t    eq_cube: *const EF,\n37\t    lambda_pows: &DeviceBuffer<EF>,\n38\t    skip_domain: u32,\n39\t    num_x: u32,\n40\t    height: u32,\n41\t    num_cosets: u32,\n42\t    g_shift: F,\n43\t    max_temp_bytes: usize,\n44\t) -> Result<DeviceBuffer<EF>, Round0EvalError> {\n45\t    let constraints_dag = &pk.vk.symbolic_constraints;\n46\t    if constraints_dag.constraints.constraint_idx.is_empty() || num_cosets == 0 {\n47\t        // No plain AIR constraints, return empty buffer\n48\t        return Ok(DeviceBuffer::new());\n49\t    }\n50\t\n51\t    let rules = &pk.other_data.zerocheck_round0;\n52\t\n53\t    let buffer_size: u32 = rules.inner.buffer_size;\n54\t    let intermed_capacity = unsafe {\n55\t        _zerocheck_r0_intermediates_buffer_size(\n56\t            buffer_size,\n57\t            skip_domain,\n58\t            num_x,\n59\t            num_cosets,\n60\t            max_temp_bytes,\n61\t        )\n62\t    };\n63\t    let mut intermediates = if intermed_capacity > 0 {\n64\t        debug!(\"zerocheck:intermediates_capacity={intermed_capacity}\");\n65\t        DeviceBuffer::<F>::with_capacity(intermed_capacity)\n66\t    } else {\n67\t        DeviceBuffer::<F>::new()\n68\t    };\n69\t\n70\t    let temp_sums_buffer_capacity = unsafe {\n71\t        _zerocheck_r0_temp_sums_buffer_size(\n72\t            buffer_size,\n73\t            skip_domain,\n74\t            num_x,\n75\t            num_cosets,\n76\t            max_temp_bytes,\n77\t        )\n78\t    };\n79\t    debug!(\"zerocheck:temp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n80\t    let mut temp_sums_buffer = DeviceBuffer::<EF>::with_capacity(temp_sums_buffer_capacity);\n81\t    let used_temp_bytes =\n82\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<EF>();\n83\t    if used_temp_bytes > max_temp_bytes {\n84\t        // We do not error if the required bytes is greater than the requested max, but this may\n85\t        // lead to unexpected peak memory usage.\n86\t        warn!(\"zerocheck used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\");\n87\t    }\n88\t\n89\t    let preprocessed_ptr = pk\n90\t        .preprocessed_data\n91\t        .as_ref()\n92\t        .map(|cd| cd.trace.buffer().as_ptr())\n93\t        .unwrap_or(std::ptr::null());\n94\t\n95\t    let mut sp_evals =\n96\t        DeviceBuffer::<EF>::with_capacity(num_cosets as usize * skip_domain as usize);\n97\t    // SAFETY:\n98\t    // - No bounds checks are done in this kernel. It fully assumes that the Rules are trusted and\n99\t    //   all nodes are valid.\n100\t    unsafe {\n101\t        zerocheck_ntt_eval_constraints(\n102\t            &mut temp_sums_buffer,\n103\t            &mut sp_evals,\n104\t            selectors_cube,\n105\t            preprocessed_ptr,\n106\t            main_parts,\n107\t            eq_cube,\n108\t            lambda_pows,\n109\t            public_values,\n110\t            &rules.inner.d_rules,\n111\t            &rules.inner.d_used_nodes,\n112\t            buffer_size,\n113\t            &mut intermediates,\n114\t            skip_domain,\n115\t            num_x,\n116\t            height,\n117\t            num_cosets,\n118\t            g_shift,\n119\t            max_temp_bytes,\n120\t        )?;\n121\t    }\n122\t\n123\t    Ok(sp_evals)\n124\t}\n125\t\n126\t/// Evaluate interaction constraints (excluding plain AIR constraints) for a single AIR, given\n127\t/// prepared trace input.\n128\t///\n129\t/// `constraints` includes interaction expressions for the AIR.\n130\t/// See [`crate::logup_zerocheck`] module docs for async-free/peak memory behavior.\n131\t#[allow(clippy::too_many_arguments)]\n132\tpub fn evaluate_round0_interactions_gpu<HS: GpuHashScheme>(\n133\t    pk: &DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n134\t    symbolic: &SymbolicConstraints<F>,\n135\t    selectors_cube: &DeviceBuffer<F>,\n136\t    main_parts: &DeviceBuffer<*const F>,\n137\t    public_values: &DeviceBuffer<F>,\n138\t    eq_cube: *const EF,\n139\t    beta_pows: &[EF],\n140\t    eq_3bs: &[EF],\n141\t    skip_domain: u32,\n142\t    num_x: u32,\n143\t    height: u32,\n144\t    num_cosets: u32,\n145\t    g_shift: F,\n146\t    max_temp_bytes: usize,\n147\t) -> Result<DeviceBuffer<Frac<EF>>, Round0EvalError> {\n148\t    // Check if this trace has interactions\n149\t    if eq_3bs.is_empty() {\n150\t        return Ok(DeviceBuffer::new());\n151\t    }\n152\t    let large_domain = num_cosets * skip_domain;\n153\t\n154\t    // We create a new \"interactions DAG\" where the new .constraints are the interaction [count,\n155\t    // message_0, message_1, ..] expressions themselves, while the .interactions are empty\n156\t    // We track the indices with InteractionNode\n157\t\n158\t    // Copied from build_symbolic_constraints_dag to handle sorting of constraints\n159\t    // NOTE: For logup round0, the kernel uses weights indexed by rule_idx, not constraint_idx.\n160\t    // So we deduplicate constraint_idx and use dag_idx_to_rule_idx for weight mapping.\n161\t    let (rules, d_numer_weights, d_denom_weights, denom_sum_init) = {\n162\t        let mut dag_builder = SymbolicDagBuilder::new();\n163\t        let mut sorted_used_dag_idxs = Vec::new();\n164\t        for interaction in &symbolic.interactions {\n165\t            let count = dag_builder.add_expr(&interaction.count);\n166\t            sorted_used_dag_idxs.push(count);\n167\t            sorted_used_dag_idxs.extend(\n168\t                interaction\n169\t                    .message\n170\t                    .iter()\n171\t                    .map(|field_expr| dag_builder.add_expr(field_expr)),\n172\t            );\n173\t        }\n174\t        sorted_used_dag_idxs.sort();\n175\t        // Deduplicate for the dag since logup round0 kernel doesn't use used_nodes\n176\t        sorted_used_dag_idxs.dedup();\n177\t        let dag = SymbolicExpressionDag {\n178\t            nodes: dag_builder.nodes,\n179\t            constraint_idx: sorted_used_dag_idxs,\n180\t        };\n181\t        let rules = SymbolicRulesGpu::new(&dag, true);\n182\t        let mut numer_weights = vec![EF::ZERO; rules.rules.len()];\n183\t        let mut denom_weights = vec![EF::ZERO; rules.rules.len()];\n184\t        let mut denom_sum_init = EF::ZERO;\n185\t        for (interaction_idx, interaction) in symbolic.interactions.iter().enumerate() {\n186\t            // CAUTION: an expression node could be used in multiple interactions, and might even be\n187\t            // used as `count` in one, but message field in another. We only care about their\n188\t            // weighted sum with eq_3b, so we compute the weights ahead of time.\n189\t            let count_dag_idx =\n190\t                dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];\n191\t            let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n192\t            numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n193\t            denom_sum_init += eq_3bs[interaction_idx]\n194\t                * beta_pows[interaction.message.len()]\n195\t                * F::from_u32(interaction.bus_index as u32 + 1);\n196\t\n197\t            for (message_idx, message) in interaction.message.iter().enumerate() {\n198\t                let message_dag_idx =\n199\t                    dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n200\t                let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n201\t                denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];\n202\t            }\n203\t        }\n204\t        let d_numer_weights = numer_weights.to_device()?;\n205\t        let d_denom_weights = denom_weights.to_device()?;\n206\t        (rules, d_numer_weights, d_denom_weights, denom_sum_init)\n207\t    };\n208\t\n209\t    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n210\t    let d_rules = encoded_rules.to_device()?;\n211\t\n212\t    let buffer_size: u32 = rules.buffer_size.try_into().unwrap();\n213\t    let intermed_capacity = unsafe {\n214\t        _logup_r0_intermediates_buffer_size(\n215\t            buffer_size,\n216\t            skip_domain,\n217\t            num_x,\n218\t            num_cosets,\n219\t            max_temp_bytes,\n220\t        )\n221\t    };\n222\t    let mut intermediates = if intermed_capacity > 0 {\n223\t        debug!(\"logup_r0:intermediates_capacity={intermed_capacity}\");\n224\t        DeviceBuffer::<F>::with_capacity(intermed_capacity)\n225\t    } else {\n226\t        DeviceBuffer::<F>::new()\n227\t    };\n228\t\n229\t    let temp_sums_buffer_capacity = unsafe {\n230\t        _logup_r0_temp_sums_buffer_size(buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes)\n231\t    };\n232\t    debug!(\"logup_r0:tmp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n233\t    let mut temp_sums_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(temp_sums_buffer_capacity);\n234\t    let used_temp_bytes =\n235\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<Frac<EF>>();\n236\t    if used_temp_bytes > max_temp_bytes {\n237\t        warn!(\n238\t            \"logup_round0 used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\"\n239\t        );\n240\t    }\n241\t\n242\t    let preprocessed_ptr = pk\n243\t        .preprocessed_data\n244\t        .as_ref()\n245\t        .map(|cd| cd.trace.buffer().as_ptr())\n246\t        .unwrap_or(std::ptr::null());\n247\t\n248\t    let mut s_evals = DeviceBuffer::<Frac<EF>>::with_capacity(large_domain as usize);\n249\t\n250\t    unsafe {\n251\t        logup_bary_eval_interactions_round0(\n252\t            &mut temp_sums_buffer,\n253\t            &mut s_evals,\n254\t            selectors_cube,\n255\t            preprocessed_ptr,\n256\t            main_parts,\n257\t            eq_cube,\n258\t            public_values,\n259\t            &d_numer_weights,\n260\t            &d_denom_weights,\n261\t            denom_sum_init,\n262\t            &d_rules,\n263\t            buffer_size,\n264\t            &mut intermediates,\n265\t            skip_domain,\n266\t            num_x,\n267\t            height,\n268\t            num_cosets,\n269\t            g_shift,\n270\t            max_temp_bytes,\n271\t        )?;\n272\t    }\n273\t\n274\t    Ok(s_evals)\n275\t}\n276\t"}]},"parent_tool_use_id":"toolu_01MoKjNPjZzBpXRYCAwLziTS","session_id":"1de075eb-7395-4d25-b825-c548ab1430ba","uuid":"cd4f6cb2-999d-4928-9ccd-21ff7468eddb","timestamp":"2026-04-11T08:24:27.125Z"}
