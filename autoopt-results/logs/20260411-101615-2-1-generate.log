{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CN4PHiMCn9TYWboNkhdAwT","type":"tool_result","content":"748\t        let mut d_main_parts_vec: Vec<DeviceBuffer<*const F>> = Vec::with_capacity(num_present_airs);\n749\t\n750\t        for (trace_idx, ((air_idx, air_ctx), &n, selectors_cube, public_values, eq_3bs)) in izip!(\n751\t            &ctx.per_trace,\n752\t            &self.n_per_trace,\n753\t            &selectors_base,\n754\t            &self.public_values_per_trace,\n755\t            &self.eq_3b_per_trace,\n756\t        )\n757\t        .enumerate()\n758\t        {\n759\t            debug!(\"starting batch constraints for air_idx={air_idx} (trace_idx={trace_idx})\");\n760\t            let single_pk = &self.pk.per_air[*air_idx];\n761\t            // Includes both plain AIR constraints and symbolic interactions\n762\t            let single_air_constraints =\n763\t                SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n764\t            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n765\t            debug_assert_eq!(\n766\t                single_air_constraints.max_constraint_degree(),\n767\t                local_constraint_deg\n768\t            );\n769\t            assert!(\n770\t                local_constraint_deg <= self.constraint_degree,\n771\t                \"Max constraint degree ({local_constraint_deg}) of AIR {air_idx} exceeds the global maximum {}\",\n772\t                self.constraint_degree\n773\t            );\n774\t\n775\t            let log_large_domain = log2_ceil_usize(local_constraint_deg << l_skip);\n776\t            let omega_root = F::two_adic_generator(log_large_domain);\n777\t\n778\t            assert!(!xi.is_empty(), \"xi vector must not be empty\");\n779\t\n780\t            let height = air_ctx.common_main.height();\n781\t            let mut main_parts = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n782\t            for committed in &air_ctx.cached_mains {\n783\t                main_parts.push(committed.trace.buffer().as_ptr());\n784\t            }\n785\t            main_parts.push(air_ctx.common_main.buffer().as_ptr());\n786\t            let d_main_parts = main_parts.to_device()?;\n787\t\n788\t            let n_lift = n.max(0) as usize;\n789\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n790\t            let max_temp_bytes = self.memory_limit_bytes;\n791\t            // local_constraint_deg = 0 means no constraints. The only way that linear constraints\n792\t            // on trace polynomials could vanish on 2^l_skip points is if the constraint polynomial\n793\t            // is identically zero. Thus for local_constraint_deg = 0 or 1, we must have `s'_0 = 0`.\n794\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n795\t            let zc_result = evaluate_round0_constraints_gpu(\n796\t                single_pk,\n797\t                selectors_cube.buffer(),\n798\t                &d_main_parts,\n799\t                public_values,\n800\t                eq_xi_tree.get_ptr(n_lift),\n801\t                d_lambda_pows,\n802\t                1 << l_skip,\n803\t                1 << n_lift,\n804\t                height as u32,\n805\t                num_cosets_zc as u32,\n806\t                omega_root,\n807\t                max_temp_bytes,\n808\t            )?;\n809\t\n810\t            // PERF: we could use an interaction-specific constraint degree here\n811\t            let num_cosets_logup = local_constraint_deg;\n812\t            let logup_result = evaluate_round0_interactions_gpu(\n813\t                single_pk,\n814\t                &single_air_constraints,\n815\t                selectors_cube.buffer(),\n816\t                &d_main_parts,\n817\t                public_values,\n818\t                eq_xi_tree.get_ptr(n_lift),\n819\t                &self.beta_pows,\n820\t                eq_3bs,\n821\t                1 << l_skip,\n822\t                1 << n_lift,\n823\t                height as u32,\n824\t                num_cosets_logup as u32,\n825\t                omega_root,\n826\t                max_temp_bytes,\n827\t            )?;\n828\t\n829\t            d_main_parts_vec.push(d_main_parts);\n830\t            pending.push(Round0Pending {\n831\t                trace_idx,\n832\t                air_idx: *air_idx,\n833\t                num_cosets_zc,\n834\t                num_cosets_logup,\n835\t                local_constraint_deg,\n836\t                omega_root,\n837\t                n,\n838\t                zc_result,\n839\t                logup_result,\n840\t            });\n841\t        }\n842\t\n843\t        // Phase 2: Explicit stream sync, then D2H transfers + CPU polynomial construction.\n844\t        current_stream_sync().map_err(|e| LogupZerocheckError::from(MemCopyError::from(e)))?;\n845\t\n846\t        // Release d_main_parts now that all kernels have completed\n847\t        drop(d_main_parts_vec);\n848\t\n849\t        for entry in pending {\n850\t            if !entry.zc_result.is_empty() {\n851\t                let q_evals = entry.zc_result.to_host()?;\n852\t                let q = {\n853\t                    // Make q_evals row-major, with columns <> cosets\n854\t                    let mut values = EF::zero_vec(entry.num_cosets_zc << l_skip);\n855\t                    for coset_idx in 0..entry.num_cosets_zc {\n856\t                        for i in 0..1 << l_skip {\n857\t                            values[i * entry.num_cosets_zc + coset_idx] =\n858\t                                q_evals[(coset_idx << l_skip) + i];\n859\t                        }\n860\t                    }\n861\t                    UnivariatePoly::from_geometric_cosets_evals_idft(\n862\t                        RowMajorMatrix::new(values, entry.num_cosets_zc),\n863\t                        entry.omega_root,\n864\t                        entry.omega_root,\n865\t                    )\n866\t                };\n867\t                // sp_0 = (Z^{2^l_skip} - 1) * q\n868\t                let sp_0_deg = sumcheck_round0_deg(l_skip, entry.local_constraint_deg);\n869\t                let coeffs = (0..=sp_0_deg)\n870\t                    .map(|i| {\n871\t                        let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n872\t                        if i >= 1 << l_skip {\n873\t                            c += q.coeffs()[i - (1 << l_skip)];\n874\t                        }\n875\t                        c\n876\t                    })\n877\t                    .collect_vec();\n878\t                debug_assert_eq!(\n879\t                    coeffs.iter().step_by(1 << l_skip).copied().sum::<EF>(),\n880\t                    EF::ZERO,\n881\t                    \"Zerocheck sum is not zero for air_id: {}\",\n882\t                    entry.air_idx\n883\t                );\n884\t\n885\t                batch_sp_poly[2 * num_present_airs + entry.trace_idx] =\n886\t                    UnivariatePoly::new(coeffs);\n887\t            }\n888\t\n889\t            if !entry.logup_result.is_empty() {\n890\t                let evals = entry.logup_result.to_host()?;\n891\t                let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n892\t                    evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n893\t                if entry.n.is_negative() {\n894\t                    // normalize for lifting\n895\t                    let norm_factor = F::from_u32(1 << entry.n.unsigned_abs()).inverse();\n896\t                    for s in &mut numer {\n897\t                        *s *= norm_factor;\n898\t                    }\n899\t                }\n900\t                let mut numer_values = EF::zero_vec(entry.num_cosets_logup << l_skip);\n901\t                let mut denom_values = EF::zero_vec(entry.num_cosets_logup << l_skip);\n902\t                for coset_idx in 0..entry.num_cosets_logup {\n903\t                    for i in 0..1 << l_skip {\n904\t                        let src = (coset_idx << l_skip) + i;\n905\t                        let dst = i * entry.num_cosets_logup + coset_idx;\n906\t                        numer_values[dst] = numer[src];\n907\t                        denom_values[dst] = denom[src];\n908\t                    }\n909\t                }\n910\t                // Logup uses cosets 1, g^1, g^2, ... (init = 1, shift = omega_root)\n911\t                batch_sp_poly[2 * entry.trace_idx] =\n912\t                    UnivariatePoly::from_geometric_cosets_evals_idft(\n913\t                        RowMajorMatrix::new(numer_values, entry.num_cosets_logup),\n914\t                        entry.omega_root,\n915\t                        F::ONE, // init = 1 for identity coset\n916\t                    );\n917\t                batch_sp_poly[2 * entry.trace_idx + 1] =\n918\t                    UnivariatePoly::from_geometric_cosets_evals_idft(\n919\t                        RowMajorMatrix::new(denom_values, entry.num_cosets_logup),\n920\t                        entry.omega_root,\n921\t                        F::ONE, // init = 1 for identity coset\n922\t                    );\n923\t            }\n924\t        }\n925\t        self.mem\n926\t            .emit_metrics_with_label(\"prover.batch_constraints.round0\");\n927\t        Ok(batch_sp_poly)\n928\t    }\n929\t\n930\t    // Note: there are no gpu sync points in this function, so span does not indicate kernel times\n931\t    #[instrument(name = \"LogupZerocheck::fold_ple_evals\", level = \"debug\", skip_all)]\n932\t    fn fold_ple_evals(\n933\t        &mut self,\n934\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n935\t        r_0: EF,\n936\t    ) -> Result<(), LogupZerocheckError> {\n937\t        let l_skip = self.l_skip;\n938\t        let inv_lagrange_denoms_r0 =\n939\t            compute_barycentric_inv_lagrange_denoms(l_skip, &self.omega_skip_pows, r_0);\n940\t        let d_inv_lagrange_denoms_r0 = inv_lagrange_denoms_r0.to_device()?;\n941\t\n942\t        let mut mem_limit = self.gkr_mem_contribution;\n943\t        // GPU folding for mat_evals_per_trace\n944\t        self.mat_evals_per_trace = ctx\n945\t            .per_trace\n946\t            .iter()\n947\t            .map(|(air_idx, air_ctx)| {"}]},"parent_tool_use_id":"toolu_01MoKjNPjZzBpXRYCAwLziTS","session_id":"1de075eb-7395-4d25-b825-c548ab1430ba","uuid":"4651a8ce-b10a-481d-a8ea-42b7e0d7a933","timestamp":"2026-04-11T08:24:23.406Z"}
