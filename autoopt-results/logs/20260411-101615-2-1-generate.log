{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ht3vXTRKS2SzVJznfwopac","type":"tool_result","content":"1\tuse getset::{CopyGetters, Getters, MutGetters};\n2\tuse openvm_cuda_common::common::get_device;\n3\tuse openvm_stark_backend::SystemParams;\n4\t\n5\tuse crate::cuda::{\n6\t    batch_ntt_small::ensure_device_ntt_twiddles_initialized, device_info::get_sm_count,\n7\t};\n8\t\n9\t#[derive(Clone, Getters, CopyGetters, MutGetters)]\n10\tpub struct GpuDevice {\n11\t    #[getset(get = \"pub\")]\n12\t    pub(crate) config: SystemParams,\n13\t    #[getset(get = \"pub\", get_mut = \"pub\")]\n14\t    pub(crate) prover_config: GpuProverConfig,\n15\t    pub id: u32,\n16\t    #[getset(get_copy = \"pub\")]\n17\t    pub sm_count: u32,\n18\t}\n19\t\n20\t#[derive(Clone, Copy)]\n21\tpub struct GpuProverConfig {\n22\t    pub cache_stacked_matrix: bool,\n23\t    pub cache_rs_code_matrix: bool,\n24\t    pub zerocheck_save_memory: bool,\n25\t}\n26\t\n27\timpl GpuDevice {\n28\t    pub fn new(config: SystemParams) -> Self {\n29\t        ensure_device_ntt_twiddles_initialized();\n30\t\n31\t        let prover_config = GpuProverConfig {\n32\t            zerocheck_save_memory: config.log_blowup == 1,\n33\t            ..Default::default()\n34\t        };\n35\t        let id = get_device().unwrap() as u32;\n36\t        let sm_count = get_sm_count(id).expect(\"failed to get SM count\");\n37\t        Self {\n38\t            config,\n39\t            prover_config,\n40\t            id,\n41\t            sm_count,\n42\t        }\n43\t    }\n44\t\n45\t    pub fn with_cache_rs_code_matrix(mut self, cache_rs_code_matrix: bool) -> Self {\n46\t        self.prover_config.cache_rs_code_matrix = cache_rs_code_matrix;\n47\t        self\n48\t    }\n49\t\n50\t    pub fn set_cache_rs_code_matrix(&mut self, cache_rs_code_matrix: bool) {\n51\t        self.prover_config.cache_rs_code_matrix = cache_rs_code_matrix;\n52\t    }\n53\t}\n54\t\n55\t/// Default configuration is to reduce peak memory usage when there is not a significant performance\n56\t/// trade-off. The Reed-Solomon code computation does incur a performance penalty, so we cache it.\n57\timpl Default for GpuProverConfig {\n58\t    fn default() -> Self {\n59\t        Self {\n60\t            cache_stacked_matrix: false,\n61\t            cache_rs_code_matrix: true,\n62\t            zerocheck_save_memory: true,\n63\t        }\n64\t    }\n65\t}\n66\t"}]},"parent_tool_use_id":"toolu_01MoKjNPjZzBpXRYCAwLziTS","session_id":"1de075eb-7395-4d25-b825-c548ab1430ba","uuid":"62ae5d91-678e-401c-9748-22bc5fc89ad8","timestamp":"2026-04-11T08:25:06.303Z"}
