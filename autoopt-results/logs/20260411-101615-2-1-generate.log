{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KAjMHrCXspThLYVbYFrSed","type":"tool_result","content":"1\t#![allow(non_camel_case_types, non_upper_case_globals, non_snake_case)]\n2\t\n3\tuse std::{\n4\t    collections::{BTreeMap, HashMap},\n5\t    ffi::c_void,\n6\t    sync::Arc,\n7\t};\n8\t\n9\tuse bytesize::ByteSize;\n10\t\n11\tuse super::cuda::*;\n12\tuse crate::{\n13\t    common::set_device,\n14\t    error::MemoryError,\n15\t    stream::{\n16\t        current_stream_id, current_stream_sync, default_stream_wait, CudaEvent, CudaStreamId,\n17\t    },\n18\t};\n19\t\n20\t#[link(name = \"cudart\")]\n21\textern \"C\" {\n22\t    fn cudaMemGetInfo(free_bytes: *mut usize, total_bytes: *mut usize) -> i32;\n23\t}\n24\t\n25\t// ============================================================================\n26\t// Configuration\n27\t// ============================================================================\n28\t\n29\tconst DEFAULT_VA_SIZE: usize = 8 << 40; // 8 TB\n30\t\n31\t/// Configuration for the Virtual Memory Pool.\n32\t///\n33\t/// Use `VpmmConfig::from_env()` to load from environment variables,\n34\t/// or construct directly for testing.\n35\t#[derive(Debug, Clone)]\n36\tpub(super) struct VpmmConfig {\n37\t    /// Page size override. If `None`, uses CUDA's minimum granularity for the device.\n38\t    pub page_size: Option<usize>,\n39\t    /// Virtual address space size per reserved chunk (default: 8 TB).\n40\t    pub va_size: usize,\n41\t    /// Number of pages to preallocate at startup (default: 0).\n42\t    pub initial_pages: usize,\n43\t}\n44\t\n45\timpl Default for VpmmConfig {\n46\t    fn default() -> Self {\n47\t        Self {\n48\t            page_size: None,\n49\t            va_size: DEFAULT_VA_SIZE,\n50\t            initial_pages: 0,\n51\t        }\n52\t    }\n53\t}\n54\t\n55\timpl VpmmConfig {\n56\t    /// Load configuration from environment variables:\n57\t    /// - `VPMM_PAGE_SIZE`: Page size in bytes (must be multiple of CUDA granularity)\n58\t    /// - `VPMM_VA_SIZE`: Virtual address space size per chunk (default: 8 TB)\n59\t    /// - `VPMM_PAGES`: Number of pages to preallocate (default: 0)\n60\t    pub fn from_env() -> Self {\n61\t        let page_size = std::env::var(\"VPMM_PAGE_SIZE\").ok().map(|val| {\n62\t            let size: usize = val.parse().expect(\"VPMM_PAGE_SIZE must be a valid number\");\n63\t            assert!(size > 0, \"VPMM_PAGE_SIZE must be > 0\");\n64\t            size\n65\t        });\n66\t\n67\t        let va_size = match std::env::var(\"VPMM_VA_SIZE\") {\n68\t            Ok(val) => {\n69\t                let size: usize = val.parse().expect(\"VPMM_VA_SIZE must be a valid number\");\n70\t                assert!(size > 0, \"VPMM_VA_SIZE must be > 0\");\n71\t                size\n72\t            }\n73\t            Err(_) => DEFAULT_VA_SIZE,\n74\t        };\n75\t\n76\t        let initial_pages = match std::env::var(\"VPMM_PAGES\") {\n77\t            Ok(val) => val.parse().expect(\"VPMM_PAGES must be a valid number\"),\n78\t            Err(_) => 0,\n79\t        };\n80\t\n81\t        Self {\n82\t            page_size,\n83\t            va_size,\n84\t            initial_pages,\n85\t        }\n86\t    }\n87\t}\n88\t\n89\t// ============================================================================\n90\t// Pool Implementation\n91\t// ============================================================================\n92\t\n93\t/// Metadata for a free region in the virtual address space.\n94\t#[derive(Debug, Clone)]\n95\tstruct FreeRegionMeta {\n96\t    size: usize,\n97\t    event: Arc<CudaEvent>,\n98\t    stream_id: CudaStreamId,\n99\t    id: usize,\n100\t}\n101\t\n102\t/// Remapped region that will be unmapped when the event completes.\n103\t#[derive(Debug)]\n104\tstruct ZombieRegion {\n105\t    ptr: CUdeviceptr,\n106\t    size: usize,\n107\t    event: Arc<CudaEvent>,\n108\t}\n109\t\n110\t/// Virtual memory pool implementation.\n111\tpub(super) struct VirtualMemoryPool {\n112\t    // Virtual address space roots\n113\t    pub(super) roots: Vec<CUdeviceptr>,\n114\t\n115\t    // Map for all active pages\n116\t    active_pages: HashMap<CUdeviceptr, CUmemGenericAllocationHandle>,\n117\t\n118\t    // Free regions in virtual space (sorted by address)\n119\t    free_regions: BTreeMap<CUdeviceptr, FreeRegionMeta>,\n120\t\n121\t    // Active allocations: (ptr, size)\n122\t    malloc_regions: HashMap<CUdeviceptr, usize>,\n123\t\n124\t    // Unmapped regions: (ptr, size)\n125\t    unmapped_regions: BTreeMap<CUdeviceptr, usize>,\n126\t\n127\t    // Zombie regions: (remapped, but not unmapped yet)\n128\t    zombie_regions: Vec<ZombieRegion>,\n129\t\n130\t    // Number of free calls (used to assign ids to free regions)\n131\t    free_num: usize,\n132\t\n133\t    // Granularity size: (page % 2MB must be 0)\n134\t    pub(super) page_size: usize,\n135\t\n136\t    // Reserved virtual address span in bytes\n137\t    va_size: usize,\n138\t\n139\t    // Device ordinal\n140\t    pub(super) device_id: i32,\n141\t}\n142\t\n143\t/// # Safety\n144\t/// `VirtualMemoryPool` is not internally synchronized. These impls are safe because\n145\t/// all access goes through `Mutex<MemoryManager>` in the parent module.\n146\tunsafe impl Send for VirtualMemoryPool {}\n147\tunsafe impl Sync for VirtualMemoryPool {}\n148\t\n149\timpl VirtualMemoryPool {\n150\t    pub(super) fn new(config: VpmmConfig) -> Self {"}]},"parent_tool_use_id":"toolu_01MoKjNPjZzBpXRYCAwLziTS","session_id":"1de075eb-7395-4d25-b825-c548ab1430ba","uuid":"07578bef-af5f-484a-8041-32daff8e899c","timestamp":"2026-04-11T08:24:37.155Z"}
