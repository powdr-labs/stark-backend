{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0119pJdXwqeDGGBxcCTLdZ6o","type":"tool_result","content":"1\t//! Defines the symbolic rule data to precompute and store in the GPU proving key\n2\tuse itertools::Itertools;\n3\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer, error::MemCopyError};\n4\tuse openvm_stark_backend::{\n5\t    air_builders::symbolic::{\n6\t        symbolic_expression::SymbolicExpression,\n7\t        symbolic_variable::{Entry, SymbolicVariable},\n8\t        SymbolicConstraints, SymbolicDagBuilder, SymbolicExpressionDag,\n9\t    },\n10\t    keygen::types::StarkProvingKey,\n11\t    StarkProtocolConfig,\n12\t};\n13\tuse p3_field::PrimeCharacteristicRing;\n14\t\n15\tuse crate::{\n16\t    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n17\t    monomial::{\n18\t        ExpandedInteractionMonomials, ExpandedMonomials, InteractionMonomialTerm, LambdaTerm,\n19\t        MonomialHeader, PackedVar,\n20\t    },\n21\t    prelude::F,\n22\t};\n23\t\n24\tpub struct AirDataGpu {\n25\t    pub interaction_rules: InteractionEvalRules,\n26\t    /// Whether to buffer vars depends on the performance and memory access patterns of the kernel.\n27\t    /// This may be tuned.\n28\t    pub zerocheck_round0: ConstraintOnlyRules<true>,\n29\t    pub zerocheck_mle: ConstraintOnlyRules<false>,\n30\t    pub zerocheck_monomials: Option<ZerocheckMonomials>,\n31\t    pub interaction_monomials: Option<InteractionMonomials>,\n32\t    /// Buffer size for the logup round0 interaction evaluation DAG.\n33\t    /// Pre-computed at keygen time so Round 0 work item preparation can\n34\t    /// determine per-AIR buffer sizes without rebuilding the DAG.\n35\t    pub logup_round0_buffer_size: u32,\n36\t}\n37\t\n38\t/// Used for GKR input evaluation and logup MLE sumcheck rounds.\n39\tpub struct InteractionEvalRules {\n40\t    pub(crate) inner: EvalRules,\n41\t    /// Constraints consist of all `(numer, denom)` pairs **topologically sorted**. We map the\n42\t    /// constraint idx back to unsorted order. ```text\n43\t    /// constraint_idx => 2 * interaction_idx + is_denom\n44\t    /// ```\n45\t    pub(crate) d_pair_idxs: DeviceBuffer<u32>,\n46\t    pub(crate) max_fields_len: usize,\n47\t}\n48\t\n49\t/// Constraints only, no interactions\n50\tpub struct ConstraintOnlyRules<const BUFFER_VARS: bool> {\n51\t    pub(crate) inner: EvalRules,\n52\t}\n53\t\n54\tpub struct EvalRules {\n55\t    /// Encoded rules\n56\t    pub d_rules: DeviceBuffer<u128>,\n57\t    pub d_used_nodes: DeviceBuffer<usize>,\n58\t    pub buffer_size: u32,\n59\t}\n60\t\n61\tpub struct ZerocheckMonomials {\n62\t    pub d_headers: DeviceBuffer<MonomialHeader>,\n63\t    pub d_variables: DeviceBuffer<PackedVar>,\n64\t    pub d_lambda_terms: DeviceBuffer<LambdaTerm<F>>,\n65\t    pub num_monomials: u32,\n66\t}\n67\t\n68\tpub struct InteractionMonomials {\n69\t    pub d_numer_headers: DeviceBuffer<MonomialHeader>,\n70\t    pub d_numer_variables: DeviceBuffer<PackedVar>,\n71\t    pub d_numer_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n72\t    pub num_numer_monomials: u32,\n73\t    pub d_denom_headers: DeviceBuffer<MonomialHeader>,\n74\t    pub d_denom_variables: DeviceBuffer<PackedVar>,\n75\t    pub d_denom_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n76\t    pub num_denom_monomials: u32,\n77\t    pub max_fields_len: usize,\n78\t    pub num_interactions: u32,\n79\t}\n80\t\n81\tfn to_device_or_empty<T>(data: &[T]) -> Result<DeviceBuffer<T>, MemCopyError> {\n82\t    if data.is_empty() {\n83\t        Ok(DeviceBuffer::new())\n84\t    } else {\n85\t        data.to_device()\n86\t    }\n87\t}\n88\t\n89\timpl AirDataGpu {\n90\t    pub fn new<S: StarkProtocolConfig<F = F>>(\n91\t        pk: &StarkProvingKey<S>,\n92\t    ) -> Result<Self, MemCopyError> {\n93\t        let dag = &pk.vk.symbolic_constraints;\n94\t        let symbolic_constraints = SymbolicConstraints::from(dag);\n95\t        let interaction_rules = InteractionEvalRules::new(&symbolic_constraints)?;\n96\t        let zerocheck_round0 = ConstraintOnlyRules::<true>::new(&dag.constraints)?;\n97\t        let zerocheck_mle = ConstraintOnlyRules::<false>::new(&dag.constraints)?;\n98\t\n99\t        let zerocheck_monomials = if dag.constraints.num_constraints() > 0 {\n100\t            let expanded = ExpandedMonomials::from_dag(&dag.constraints);\n101\t            Some(ZerocheckMonomials::from_expanded(&expanded)?)\n102\t        } else {\n103\t            None\n104\t        };\n105\t        let interaction_monomials = if !symbolic_constraints.interactions.is_empty() {\n106\t            let expanded =\n107\t                ExpandedInteractionMonomials::from_symbolic_constraints(&symbolic_constraints);\n108\t            Some(InteractionMonomials::from_expanded(&expanded)?)\n109\t        } else {\n110\t            None\n111\t        };\n112\t\n113\t        // Pre-compute the logup round0 buffer_size from the interaction DAG.\n114\t        // This mirrors the DAG construction in evaluate_round0_interactions_gpu\n115\t        // but only extracts the buffer_size (no weights or device uploads needed).\n116\t        let logup_round0_buffer_size = if !symbolic_constraints.interactions.is_empty() {\n117\t            let mut dag_builder = SymbolicDagBuilder::new();\n118\t            let mut sorted_used_dag_idxs = Vec::new();\n119\t            for interaction in &symbolic_constraints.interactions {\n120\t                let count = dag_builder.add_expr(&interaction.count);\n121\t                sorted_used_dag_idxs.push(count);\n122\t                sorted_used_dag_idxs.extend(\n123\t                    interaction\n124\t                        .message\n125\t                        .iter()\n126\t                        .map(|field_expr| dag_builder.add_expr(field_expr)),\n127\t                );\n128\t            }\n129\t            sorted_used_dag_idxs.sort();\n130\t            sorted_used_dag_idxs.dedup();\n131\t            let dag = SymbolicExpressionDag {\n132\t                nodes: dag_builder.nodes,\n133\t                constraint_idx: sorted_used_dag_idxs,\n134\t            };\n135\t            let rules = SymbolicRulesGpu::new(&dag, true);\n136\t            rules\n137\t                .buffer_size\n138\t                .try_into()\n139\t                .expect(\"logup round0 buffer_size exceeds u32\")\n140\t        } else {\n141\t            0\n142\t        };\n143\t\n144\t        Ok(Self {\n145\t            interaction_rules,\n146\t            zerocheck_round0,\n147\t            zerocheck_mle,\n148\t            zerocheck_monomials,\n149\t            interaction_monomials,\n150\t            logup_round0_buffer_size,\n151\t        })\n152\t    }\n153\t}\n154\t\n155\timpl ZerocheckMonomials {\n156\t    pub fn from_expanded(expanded: &ExpandedMonomials<F>) -> Result<Self, MemCopyError> {\n157\t        // Validate bounds for all monomial headers to prevent out-of-bounds access in CUDA kernel\n158\t        let num_variables = expanded.variables.len();\n159\t        let num_lambda_terms = expanded.lambda_terms.len();\n160\t        for (i, hdr) in expanded.headers.iter().enumerate() {\n161\t            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n162\t            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n163\t            assert!(\n164\t                var_end <= num_variables,\n165\t                \"Monomial {i}: var_offset ({}) + num_vars ({}) = {var_end} exceeds variables.len() ({num_variables})\",\n166\t                hdr.var_offset,\n167\t                hdr.num_vars\n168\t            );\n169\t            assert!(\n170\t                term_end <= num_lambda_terms,\n171\t                \"Monomial {i}: term_offset ({}) + num_terms ({}) = {term_end} exceeds lambda_terms.len() ({num_lambda_terms})\",\n172\t                hdr.term_offset,\n173\t                hdr.num_terms\n174\t            );\n175\t        }\n176\t\n177\t        Ok(Self {\n178\t            d_headers: expanded.headers.to_device()?,\n179\t            d_variables: expanded.variables.to_device()?,\n180\t            d_lambda_terms: expanded.lambda_terms.to_device()?,\n181\t            num_monomials: expanded.headers.len() as u32,\n182\t        })\n183\t    }\n184\t}\n185\t\n186\timpl InteractionMonomials {\n187\t    pub fn from_expanded(expanded: &ExpandedInteractionMonomials<F>) -> Result<Self, MemCopyError> {\n188\t        // Validate numerator monomial headers\n189\t        let num_numer_vars = expanded.numer_variables.len();\n190\t        let num_numer_terms = expanded.numer_terms.len();\n191\t        for (i, hdr) in expanded.numer_headers.iter().enumerate() {\n192\t            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n193\t            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n194\t            assert!(\n195\t                var_end <= num_numer_vars,\n196\t                \"Numer monomial {i}: var_offset + num_vars exceeds bounds\"\n197\t            );\n198\t            assert!(\n199\t                term_end <= num_numer_terms,\n200\t                \"Numer monomial {i}: term_offset + num_terms exceeds bounds\"\n201\t            );\n202\t        }\n203\t\n204\t        // Validate denominator monomial headers\n205\t        let num_denom_vars = expanded.denom_variables.len();\n206\t        let num_denom_terms = expanded.denom_terms.len();\n207\t        for (i, hdr) in expanded.denom_headers.iter().enumerate() {\n208\t            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n209\t            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n210\t            assert!(\n211\t                var_end <= num_denom_vars,\n212\t                \"Denom monomial {i}: var_offset + num_vars exceeds bounds\"\n213\t            );\n214\t            assert!(\n215\t                term_end <= num_denom_terms,\n216\t                \"Denom monomial {i}: term_offset + num_terms exceeds bounds\"\n217\t            );\n218\t        }\n219\t\n220\t        Ok(Self {\n221\t            d_numer_headers: to_device_or_empty(&expanded.numer_headers)?,\n222\t            d_numer_variables: to_device_or_empty(&expanded.numer_variables)?,\n223\t            d_numer_terms: to_device_or_empty(&expanded.numer_terms)?,\n224\t            num_numer_monomials: expanded.numer_headers.len() as u32,\n225\t            d_denom_headers: to_device_or_empty(&expanded.denom_headers)?,\n226\t            d_denom_variables: to_device_or_empty(&expanded.denom_variables)?,\n227\t            d_denom_terms: to_device_or_empty(&expanded.denom_terms)?,\n228\t            num_denom_monomials: expanded.denom_headers.len() as u32,\n229\t            max_fields_len: expanded.max_fields_len,\n230\t            num_interactions: expanded.num_interactions,\n231\t        })\n232\t    }\n233\t}\n234\t\n235\timpl InteractionEvalRules {\n236\t    pub fn new(symbolic_constraints: &SymbolicConstraints<F>) -> Result<Self, MemCopyError> {\n237\t        let interactions = &symbolic_constraints.interactions;\n238\t        let num_interactions = interactions.len();\n239\t        if num_interactions == 0 {\n240\t            return Ok(Self {\n241\t                inner: EvalRules::dummy(),\n242\t\n243\t                max_fields_len: 0,\n244\t                d_pair_idxs: DeviceBuffer::new(),\n245\t            });\n246\t        }\n247\t        let max_fields_len = interactions\n248\t            .iter()\n249\t            .map(|interaction| interaction.message.len())\n250\t            .max()\n251\t            .unwrap_or(0);\n252\t        // [alpha, beta^0, ..., beta^max_fields_len]\n253\t        let symbolic_challenges: Vec<SymbolicExpression<F>> = (0..max_fields_len + 2)\n254\t            .map(|index| SymbolicVariable::<F>::new(Entry::Challenge, index).into())\n255\t            .collect();\n256\t\n257\t        let mut frac_pairs = Vec::with_capacity(num_interactions * 2);\n258\t        for interaction in interactions.iter() {\n259\t            let numer = interaction.count.clone();\n260\t            let b = SymbolicExpression::from_u32(interaction.bus_index as u32 + 1);\n261\t            let betas = symbolic_challenges[1..].to_vec();\n262\t            let mut denom = SymbolicExpression::from_u32(0);\n263\t            for (j, expr) in interaction.message.iter().enumerate() {\n264\t                denom += betas[j].clone() * expr.clone();\n265\t            }\n266\t            denom += betas[interaction.message.len()].clone() * b;\n267\t            frac_pairs.push(numer);\n268\t            frac_pairs.push(denom);\n269\t        }\n270\t        // build DAG without sorting constraint idxs:\n271\t        let (dag, pair_idxs) = {\n272\t            let mut dag_builder = SymbolicDagBuilder::new();\n273\t            let mut dag_pair_idxs: Vec<(usize, u32)> = frac_pairs\n274\t                .iter()\n275\t                .enumerate()\n276\t                .map(|(pair_idx, expr)| {\n277\t                    let dag_idx = dag_builder.add_expr(expr);\n278\t                    (dag_idx, pair_idx.try_into().unwrap())\n279\t                })\n280\t                .collect_vec();\n281\t            dag_pair_idxs.sort();\n282\t            let (constraint_idx, pair_idxs): (Vec<_>, Vec<_>) = dag_pair_idxs.into_iter().unzip();\n283\t            // NOTE: do not sort pair_idxs since we need to keep them in pairs\n284\t            let dag = SymbolicExpressionDag {\n285\t                nodes: dag_builder.nodes,\n286\t                constraint_idx,\n287\t            };\n288\t            (dag, pair_idxs)\n289\t        };\n290\t        let rules = SymbolicRulesGpu::new(&dag, false);\n291\t        // Build used_nodes with duplicates, preserving order from constraint_idx\n292\t        let used_nodes = dag\n293\t            .constraint_idx\n294\t            .iter()\n295\t            .map(|&dag_idx| rules.dag_idx_to_rule_idx[&dag_idx])\n296\t            .collect_vec();\n297\t        let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n298\t        let d_rules = encoded_rules.to_device()?;\n299\t        let d_used_nodes = used_nodes.to_device()?;\n300\t        let d_pair_idxs = pair_idxs.to_device()?;\n301\t        assert_eq!(\n302\t            used_nodes.len(),\n303\t            2 * num_interactions,\n304\t            \"Rules come in (numer, denom) pairs\"\n305\t        );\n306\t\n307\t        let inner = EvalRules {\n308\t            d_rules,\n309\t            d_used_nodes,\n310\t            buffer_size: rules\n311\t                .buffer_size\n312\t                .try_into()\n313\t                .expect(\"buffer_size exceeds u32\"),\n314\t        };\n315\t\n316\t        Ok(Self {\n317\t            inner,\n318\t            d_pair_idxs,\n319\t            max_fields_len,\n320\t        })\n321\t    }\n322\t}\n323\t\n324\timpl<const BUFFER_VARS: bool> ConstraintOnlyRules<BUFFER_VARS> {\n325\t    pub fn new(dag: &SymbolicExpressionDag<F>) -> Result<Self, MemCopyError> {\n326\t        if dag.num_constraints() == 0 {\n327\t            return Ok(Self {\n328\t                inner: EvalRules::dummy(),\n329\t            });\n330\t        }\n331\t\n332\t        let rules = SymbolicRulesGpu::new(dag, BUFFER_VARS);\n333\t        // Build used_nodes with duplicates, preserving order from constraint_idx\n334\t        let used_nodes = dag\n335\t            .constraint_idx\n336\t            .iter()\n337\t            .map(|&dag_idx| rules.dag_idx_to_rule_idx[&dag_idx])\n338\t            .collect_vec();\n339\t\n340\t        let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n341\t        let d_rules = encoded_rules.to_device()?;\n342\t        let d_used_nodes = used_nodes.to_device()?;\n343\t\n344\t        let inner = EvalRules {\n345\t            d_rules,\n346\t            d_used_nodes,\n347\t            buffer_size: rules\n348\t                .buffer_size\n349\t                .try_into()\n350\t                .expect(\"buffer_size exceeds u32\"),\n351\t        };\n352\t        Ok(Self { inner })\n353\t    }\n354\t}\n355\t\n356\timpl EvalRules {\n357\t    pub fn dummy() -> Self {\n358\t        Self {\n359\t            d_rules: DeviceBuffer::new(),\n360\t            d_used_nodes: DeviceBuffer::new(),\n361\t            buffer_size: 0,\n362\t        }\n363\t    }\n364\t}\n365\t"}]},"parent_tool_use_id":null,"session_id":"018e8f69-7b84-4852-bca6-584bcc77e171","uuid":"b80b6aca-7272-4e29-8d53-f8b9472a5afa","timestamp":"2026-04-14T01:09:42.177Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/pkey.rs","content":"//! Defines the symbolic rule data to precompute and store in the GPU proving key\nuse itertools::Itertools;\nuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer, error::MemCopyError};\nuse openvm_stark_backend::{\n    air_builders::symbolic::{\n        symbolic_expression::SymbolicExpression,\n        symbolic_variable::{Entry, SymbolicVariable},\n        SymbolicConstraints, SymbolicDagBuilder, SymbolicExpressionDag,\n    },\n    keygen::types::StarkProvingKey,\n    StarkProtocolConfig,\n};\nuse p3_field::PrimeCharacteristicRing;\n\nuse crate::{\n    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n    monomial::{\n        ExpandedInteractionMonomials, ExpandedMonomials, InteractionMonomialTerm, LambdaTerm,\n        MonomialHeader, PackedVar,\n    },\n    prelude::F,\n};\n\npub struct AirDataGpu {\n    pub interaction_rules: InteractionEvalRules,\n    /// Whether to buffer vars depends on the performance and memory access patterns of the kernel.\n    /// This may be tuned.\n    pub zerocheck_round0: ConstraintOnlyRules<true>,\n    pub zerocheck_mle: ConstraintOnlyRules<false>,\n    pub zerocheck_monomials: Option<ZerocheckMonomials>,\n    pub interaction_monomials: Option<InteractionMonomials>,\n    /// Buffer size for the logup round0 interaction evaluation DAG.\n    /// Pre-computed at keygen time so Round 0 work item preparation can\n    /// determine per-AIR buffer sizes without rebuilding the DAG.\n    pub logup_round0_buffer_size: u32,\n}\n\n/// Used for GKR input evaluation and logup MLE sumcheck rounds.\npub struct InteractionEvalRules {\n    pub(crate) inner: EvalRules,\n    /// Constraints consist of all `(numer, denom)` pairs **topologically sorted**. We map the\n    /// constraint idx back to unsorted order. ```text\n    /// constraint_idx => 2 * interaction_idx + is_denom\n    /// ```\n    pub(crate) d_pair_idxs: DeviceBuffer<u32>,\n    pub(crate) max_fields_len: usize,\n}\n\n/// Constraints only, no interactions\npub struct ConstraintOnlyRules<const BUFFER_VARS: bool> {\n    pub(crate) inner: EvalRules,\n}\n\npub struct EvalRules {\n    /// Encoded rules\n    pub d_rules: DeviceBuffer<u128>,\n    pub d_used_nodes: DeviceBuffer<usize>,\n    pub buffer_size: u32,\n}\n\npub struct ZerocheckMonomials {\n    pub d_headers: DeviceBuffer<MonomialHeader>,\n    pub d_variables: DeviceBuffer<PackedVar>,\n    pub d_lambda_terms: DeviceBuffer<LambdaTerm<F>>,\n    pub num_monomials: u32,\n}\n\npub struct InteractionMonomials {\n    pub d_numer_headers: DeviceBuffer<MonomialHeader>,\n    pub d_numer_variables: DeviceBuffer<PackedVar>,\n    pub d_numer_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n    pub num_numer_monomials: u32,\n    pub d_denom_headers: DeviceBuffer<MonomialHeader>,\n    pub d_denom_variables: DeviceBuffer<PackedVar>,\n    pub d_denom_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n    pub num_denom_monomials: u32,\n    pub max_fields_len: usize,\n    pub num_interactions: u32,\n}\n\nfn to_device_or_empty<T>(data: &[T]) -> Result<DeviceBuffer<T>, MemCopyError> {\n    if data.is_empty() {\n        Ok(DeviceBuffer::new())\n    } else {\n        data.to_device()\n    }\n}\n\nimpl AirDataGpu {\n    pub fn new<S: StarkProtocolConfig<F = F>>(\n        pk: &StarkProvingKey<S>,\n    ) -> Result<Self, MemCopyError> {\n        let dag = &pk.vk.symbolic_constraints;\n        let symbolic_constraints = SymbolicConstraints::from(dag);\n        let interaction_rules = InteractionEvalRules::new(&symbolic_constraints)?;\n        let zerocheck_round0 = ConstraintOnlyRules::<true>::new(&dag.constraints)?;\n        let zerocheck_mle = ConstraintOnlyRules::<false>::new(&dag.constraints)?;\n\n        let zerocheck_monomials = if dag.constraints.num_constraints() > 0 {\n            let expanded = ExpandedMonomials::from_dag(&dag.constraints);\n            Some(ZerocheckMonomials::from_expanded(&expanded)?)\n        } else {\n            None\n        };\n        let interaction_monomials = if !symbolic_constraints.interactions.is_empty() {\n            let expanded =\n                ExpandedInteractionMonomials::from_symbolic_constraints(&symbolic_constraints);\n            Some(InteractionMonomials::from_expanded(&expanded)?)\n        } else {\n            None\n        };\n\n        // Pre-compute the logup round0 buffer_size from the interaction DAG.\n        // This mirrors the DAG construction in evaluate_round0_interactions_gpu\n        // but only extracts the buffer_size (no weights or device uploads needed).\n        let logup_round0_buffer_size = if !symbolic_constraints.interactions.is_empty() {\n            let mut dag_builder = SymbolicDagBuilder::new();\n            let mut sorted_used_dag_idxs = Vec::new();\n            for interaction in &symbolic_constraints.interactions {\n                let count = dag_builder.add_expr(&interaction.count);\n                sorted_used_dag_idxs.push(count);\n                sorted_used_dag_idxs.extend(\n                    interaction\n                        .message\n                        .iter()\n                        .map(|field_expr| dag_builder.add_expr(field_expr)),\n                );\n            }\n            sorted_used_dag_idxs.sort();\n            sorted_used_dag_idxs.dedup();\n            let dag = SymbolicExpressionDag {\n                nodes: dag_builder.nodes,\n                constraint_idx: sorted_used_dag_idxs,\n            };\n            let rules = SymbolicRulesGpu::new(&dag, true);\n            rules\n                .buffer_size\n                .try_into()\n                .expect(\"logup round0 buffer_size exceeds u32\")\n        } else {\n            0\n        };\n\n        Ok(Self {\n            interaction_rules,\n            zerocheck_round0,\n            zerocheck_mle,\n            zerocheck_monomials,\n            interaction_monomials,\n            logup_round0_buffer_size,\n        })\n    }\n}\n\nimpl ZerocheckMonomials {\n    pub fn from_expanded(expanded: &ExpandedMonomials<F>) -> Result<Self, MemCopyError> {\n        // Validate bounds for all monomial headers to prevent out-of-bounds access in CUDA kernel\n        let num_variables = expanded.variables.len();\n        let num_lambda_terms = expanded.lambda_terms.len();\n        for (i, hdr) in expanded.headers.iter().enumerate() {\n            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n            assert!(\n                var_end <= num_variables,\n                \"Monomial {i}: var_offset ({}) + num_vars ({}) = {var_end} exceeds variables.len() ({num_variables})\",\n                hdr.var_offset,\n                hdr.num_vars\n            );\n            assert!(\n                term_end <= num_lambda_terms,\n                \"Monomial {i}: term_offset ({}) + num_terms ({}) = {term_end} exceeds lambda_terms.len() ({num_lambda_terms})\",\n                hdr.term_offset,\n                hdr.num_terms\n            );\n        }\n\n        Ok(Self {\n            d_headers: expanded.headers.to_device()?,\n            d_variables: expanded.variables.to_device()?,\n            d_lambda_terms: expanded.lambda_terms.to_device()?,\n            num_monomials: expanded.headers.len() as u32,\n        })\n    }\n}\n\nimpl InteractionMonomials {\n    pub fn from_expanded(expanded: &ExpandedInteractionMonomials<F>) -> Result<Self, MemCopyError> {\n        // Validate numerator monomial headers\n        let num_numer_vars = expanded.numer_variables.len();\n        let num_numer_terms = expanded.numer_terms.len();\n        for (i, hdr) in expanded.numer_headers.iter().enumerate() {\n            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n            assert!(\n                var_end <= num_numer_vars,\n                \"Numer monomial {i}: var_offset + num_vars exceeds bounds\"\n            );\n            assert!(\n                term_end <= num_numer_terms,\n                \"Numer monomial {i}: term_offset + num_terms exceeds bounds\"\n            );\n        }\n\n        // Validate denominator monomial headers\n        let num_denom_vars = expanded.denom_variables.len();\n        let num_denom_terms = expanded.denom_terms.len();\n        for (i, hdr) in expanded.denom_headers.iter().enumerate() {\n            let var_end = hdr.var_offset as usize + hdr.num_vars as usize;\n            let term_end = hdr.term_offset as usize + hdr.num_terms as usize;\n            assert!(\n                var_end <= num_denom_vars,\n                \"Denom monomial {i}: var_offset + num_vars exceeds bounds\"\n            );\n            assert!(\n                term_end <= num_denom_terms,\n                \"Denom monomial {i}: term_offset + num_terms exceeds bounds\"\n            );\n        }\n\n        Ok(Self {\n            d_numer_headers: to_device_or_empty(&expanded.numer_headers)?,\n            d_numer_variables: to_device_or_empty(&expanded.numer_variables)?,\n            d_numer_terms: to_device_or_empty(&expanded.numer_terms)?,\n            num_numer_monomials: expanded.numer_headers.len() as u32,\n            d_denom_headers: to_device_or_empty(&expanded.denom_headers)?,\n            d_denom_variables: to_device_or_empty(&expanded.denom_variables)?,\n            d_denom_terms: to_device_or_empty(&expanded.denom_terms)?,\n            num_denom_monomials: expanded.denom_headers.len() as u32,\n            max_fields_len: expanded.max_fields_len,\n            num_interactions: expanded.num_interactions,\n        })\n    }\n}\n\nimpl InteractionEvalRules {\n    pub fn new(symbolic_constraints: &SymbolicConstraints<F>) -> Result<Self, MemCopyError> {\n        let interactions = &symbolic_constraints.interactions;\n        let num_interactions = interactions.len();\n        if num_interactions == 0 {\n            return Ok(Self {\n                inner: EvalRules::dummy(),\n\n                max_fields_len: 0,\n                d_pair_idxs: DeviceBuffer::new(),\n            });\n        }\n        let max_fields_len = interactions\n            .iter()\n            .map(|interaction| interaction.message.len())\n            .max()\n            .unwrap_or(0);\n        // [alpha, beta^0, ..., beta^max_fields_len]\n        let symbolic_challenges: Vec<SymbolicExpression<F>> = (0..max_fields_len + 2)\n            .map(|index| SymbolicVariable::<F>::new(Entry::Challenge, index).into())\n            .collect();\n\n        let mut frac_pairs = Vec::with_capacity(num_interactions * 2);\n        for interaction in interactions.iter() {\n            let numer = interaction.count.clone();\n            let b = SymbolicExpression::from_u32(interaction.bus_index as u32 + 1);\n            let betas = symbolic_challenges[1..].to_vec();\n            let mut denom = SymbolicExpression::from_u32(0);\n            for (j, expr) in interaction.message.iter().enumerate() {\n                denom += betas[j].clone() * expr.clone();\n            }\n            denom += betas[interaction.message.len()].clone() * b;\n            frac_pairs.push(numer);\n            frac_pairs.push(denom);\n        }\n        // build DAG without sorting constraint idxs:\n        let (dag, pair_idxs) = {\n            let mut dag_builder = SymbolicDagBuilder::new();\n            let mut dag_pair_idxs: Vec<(usize, u32)> = frac_pairs\n                .iter()\n                .enumerate()\n                .map(|(pair_idx, expr)| {\n                    let dag_idx = dag_builder.add_expr(expr);\n                    (dag_idx, pair_idx.try_into().unwrap())\n                })\n                .collect_vec();\n            dag_pair_idxs.sort();\n            let (constraint_idx, pair_idxs): (Vec<_>, Vec<_>) = dag_pair_idxs.into_iter().unzip();\n            // NOTE: do not sort pair_idxs since we need to keep them in pairs\n            let dag = SymbolicExpressionDag {\n                nodes: dag_builder.nodes,\n                constraint_idx,\n            };\n            (dag, pair_idxs)\n        };\n        let rules = SymbolicRulesGpu::new(&dag, false);\n        // Build used_nodes with duplicates, preserving order from constraint_idx\n        let used_nodes = dag\n            .constraint_idx\n            .iter()\n            .map(|&dag_idx| rules.dag_idx_to_rule_idx[&dag_idx])\n            .collect_vec();\n        let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n        let d_rules = encoded_rules.to_device()?;\n        let d_used_nodes = used_nodes.to_device()?;\n        let d_pair_idxs = pair_idxs.to_device()?;\n        assert_eq!(\n            used_nodes.len(),\n            2 * num_interactions,\n            \"Rules come in (numer, denom) pairs\"\n        );\n\n        let inner = EvalRules {\n            d_rules,\n            d_used_nodes,\n            buffer_size: rules\n                .buffer_size\n                .try_into()\n                .expect(\"buffer_size exceeds u32\"),\n        };\n\n        Ok(Self {\n            inner,\n            d_pair_idxs,\n            max_fields_len,\n        })\n    }\n}\n\nimpl<const BUFFER_VARS: bool> ConstraintOnlyRules<BUFFER_VARS> {\n    pub fn new(dag: &SymbolicExpressionDag<F>) -> Result<Self, MemCopyError> {\n        if dag.num_constraints() == 0 {\n            return Ok(Self {\n                inner: EvalRules::dummy(),\n            });\n        }\n\n        let rules = SymbolicRulesGpu::new(dag, BUFFER_VARS);\n        // Build used_nodes with duplicates, preserving order from constraint_idx\n        let used_nodes = dag\n            .constraint_idx\n            .iter()\n            .map(|&dag_idx| rules.dag_idx_to_rule_idx[&dag_idx])\n            .collect_vec();\n\n        let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n        let d_rules = encoded_rules.to_device()?;\n        let d_used_nodes = used_nodes.to_device()?;\n\n        let inner = EvalRules {\n            d_rules,\n            d_used_nodes,\n            buffer_size: rules\n                .buffer_size\n                .try_into()\n                .expect(\"buffer_size exceeds u32\"),\n        };\n        Ok(Self { inner })\n    }\n}\n\nimpl EvalRules {\n    pub fn dummy() -> Self {\n        Self {\n            d_rules: DeviceBuffer::new(),\n            d_used_nodes: DeviceBuffer::new(),\n            buffer_size: 0,\n        }\n    }\n}\n","numLines":365,"startLine":1,"totalLines":365}}}
