{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FVKHwZmS7v9Q7qNtKzzYiY","type":"tool_result","content":"150\t}\n151\t\n152\tfn process_air_round0<HS: GpuHashScheme>(\n153\t    w: &Round0AirWorkItem<HS>,\n154\t    bufs: &mut round0::Round0ThreadBuffers,\n155\t) -> Result<Round0AirResult, LogupZerocheckError> {\n156\t    let single_pk = w.single_pk;\n157\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n158\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n159\t    assert!(\n160\t        local_constraint_deg <= w.constraint_degree,\n161\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n162\t        w.constraint_degree\n163\t    );\n164\t\n165\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n166\t    let omega_root = F::two_adic_generator(log_large_domain);\n167\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n168\t\n169\t    let height = w.common_main.height();\n170\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n171\t    for committed in w.cached_mains {\n172\t        main_parts.push(committed.trace.buffer().as_ptr());\n173\t    }\n174\t    main_parts.push(w.common_main.buffer().as_ptr());\n175\t    let d_main_parts = main_parts.to_device()?;\n176\t\n177\t    let n_lift = w.n.max(0) as usize;\n178\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n179\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n180\t\n181\t    // Check if pre-allocated zerocheck buffers are large enough for this AIR\n182\t    let zc_prealloc_inter = if w.zc_intermed_cap > 0\n183\t        && bufs.zc_intermediates.len() >= w.zc_intermed_cap\n184\t    {\n185\t        Some(&mut bufs.zc_intermediates)\n186\t    } else {\n187\t        None\n188\t    };\n189\t    let zc_prealloc_temp = if w.zc_temp_sums_cap > 0\n190\t        && bufs.zc_temp_sums.len() >= w.zc_temp_sums_cap