kedReductionError,\n47\t};\n48\t\n49\t/// Degree of the sumcheck polynomial for stacked reduction.\n50\tpub const STACKED_REDUCTION_S_DEG: usize = 2;\n51\t\n52\tpub struct StackedReductionGpu<D = Digest> {\n53\t    sm_count: u32,\n54\t\n55\t    l_skip: usize,\n56\t    n_stack: usize,\n57\t\n58\t    omega_skip: F,\n59\t    omega_skip_pows: Vec<F>,\n60\t    d_omega_skip_pows: DeviceBuffer<F>,\n61\t\n62\t    r_0: EF,\n63\t    d_lambda_pows: DeviceBuffer<EF>,\n64\t    eq_const: EF,\n65\t\n66\t    pub(crate) stacked_per_commit: Vec<StackedPcsData2<D>>,\n67\t    d_q_widths: DeviceBuffer<u32>,\n68\t    q_width_max: u32,\n69\t    d_q_eval_ptrs: DeviceBuffer<*const EF>,\n70\t\n71\t    trace_ptrs: Vec<(\n72\t        *const F, /* trace_ptr */\n73\t        usize,    /* height */\n74\t        usize,    /* width */\n75\t    )>,\n76\t    unstacked_cols: Vec<UnstackedSlice>,\n77\t    d_unstacked_cols: DeviceBuffer<UnstackedSlice>,\n78\t    // boundary indices where heights change. all columns between two boundaries must have the same\n79\t    // height. We can have multiple chunks of the same height if that is needed to reduce peak GPU\n80\t    // memory.\n81\t    ht_diff_idxs: Vec<usize>,\n82\t    n_max: usize,\n83\t\n84\t    // Initially holds eq(r[1..=n], H_n) for n=0..=n_max but gets updated after each sumcheck round\n85\t    // by some custom folding\n86\t    eq_r_ns: EqEvalSegments<EF>,\n87\t\n88\t    // == After round 0 ==\n89\t    q_evals: Vec<DeviceBuffer<EF>>, // get width from stacked_per_commit\n90\t    // Stores folded eq values that won't change anymore (no more folding)\n91\t    // Corresponds to log_height in 0..l_skip+round-1 _before_ round `round`. Gets updated with one\n92\t    // new element after each round.\n93\t    eq_stable: Vec<EF>,\n94\t    k_rot_stable: Vec<EF>,\n95\t\n96\t    /// Stores the folded k_rot evaluations for `\\kappa_\\rot(x, r) = eq_n(rot^{-1}(x), r)` for each\n97\t    /// `n` after each round. We use the [EqEvalSegments] type to guard the se