{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016PffggAuuywMHvA8cj7fLc","type":"tool_result","content":"1\t//! Batched monomial-based MLE evaluation for zerocheck and logup.\n2\t//!\n3\t//! This module provides batch evaluators for monomial evaluations across multiple AIRs,\n4\t//! enabling efficient GPU kernel launches that process multiple traces in a single launch.\n5\t\n6\tuse openvm_cuda_common::{\n7\t    copy::MemCopyH2D,\n8\t    d_buffer::DeviceBuffer,\n9\t    error::{CudaError, MemCopyError},\n10\t};\n11\tuse openvm_stark_backend::prover::{fractional_sumcheck_gkr::Frac, DeviceMultiStarkProvingKey};\n12\tuse p3_field::PrimeCharacteristicRing;\n13\tuse tracing::debug;\n14\t\n15\tuse crate::{\n16\t    cuda::logup_zerocheck::{\n17\t        logup_monomial_batched, precompute_lambda_combinations,\n18\t        precompute_logup_denom_combinations, precompute_logup_numer_combinations,\n19\t        zerocheck_monomial_batched, zerocheck_monomial_par_y_batched, BlockCtx, EvalCoreCtx,\n20\t        LogupMonomialCommonCtx, LogupMonomialCtx, MonomialAirCtx,\n21\t    },\n22\t    error::KernelError,\n23\t    gpu_backend::GenericGpuBackend,\n24\t    hash_scheme::GpuHashScheme,\n25\t    logup_zerocheck::batch_mle::TraceCtx,\n26\t    prelude::EF,\n27\t};\n28\t\n29\tconst THREADS_PER_BLOCK: u32 = 256;\n30\t\n31\t/// Returns true if the trace can use the monomial evaluation path.\n32\t///\n33\t/// A trace is eligible if it has constraints and the AIR has expanded monomials.\n34\tpub(crate) fn trace_has_monomials<HS: GpuHashScheme>(\n35\t    trace: &TraceCtx,\n36\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n37\t) -> bool {\n38\t    trace.has_constraints\n39\t        && pk.per_air[trace.air_idx]\n40\t            .other_data\n41\t            .zerocheck_monomials\n42\t            .as_ref()\n43\t            .map(|m| m.num_monomials > 0)\n44\t            .unwrap_or(false)\n45\t}\n46\t\n47\t/// Get the number of monomials for a trace. Returns 0 if the trace has no monomials.\n48\tpub(crate) fn get_num_monomials<HS: GpuHashScheme>(\n49\t    trace: &TraceCtx,\n50\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n51\t) -> u32 {\n52\t    pk.per_air[trace.air_idx]\n53\t        .other_data\n54\t        .zerocheck_monomials\n55\t        .as_ref()\n56\t        .map(|m| m.num_monomials)\n57\t        .unwrap_or(0)\n58\t}\n59\t\n60\t/// Get the rules_len for a trace's zerocheck DAG.\n61\tpub(crate) fn get_zerocheck_rules_len<HS: GpuHashScheme>(\n62\t    trace: &TraceCtx,\n63\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n64\t) -> usize {\n65\t    pk.per_air[trace.air_idx]\n66\t        .other_data\n67\t        .zerocheck_mle\n68\t        .inner\n69\t        .d_rules\n70\t        .len()\n71\t}\n72\t\n73\t/// Precompute lambda combinations for a single AIR's monomials.\n74\t///\n75\t/// Returns a buffer of length `num_monomials` where each element is\n76\t/// `sum_l(coefficient_l * lambda_pows[constraint_idx_l])` for that monomial.\n77\t///\n78\t/// The AIR must have nonempty monomials.\n79\tpub(crate) fn compute_lambda_combinations<HS: GpuHashScheme>(\n80\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n81\t    air_idx: usize,\n82\t    lambda_pows: &DeviceBuffer<EF>,\n83\t) -> Result<DeviceBuffer<EF>, CudaError> {\n84\t    let monomials = pk.per_air[air_idx]\n85\t        .other_data\n86\t        .zerocheck_monomials\n87\t        .as_ref()\n88\t        .expect(\"AIR must have monomials\");\n89\t    let mut buf = DeviceBuffer::<EF>::with_capacity(monomials.num_monomials as usize);\n90\t    unsafe {\n91\t        precompute_lambda_combinations(\n92\t            &mut buf,\n93\t            monomials.d_headers.as_ptr(),\n94\t            monomials.d_lambda_terms.as_ptr(),\n95\t            lambda_pows,\n96\t            monomials.num_monomials,\n97\t        )?;\n98\t    }\n99\t    Ok(buf)\n100\t}\n101\t\n102\t/// Batch evaluator for monomial-based zerocheck MLE evaluation.\n103\t///\n104\t/// Pre-builds GPU contexts for all traces, then evaluates in a single kernel launch.\n105\t///\n106\t/// The caller must filter traces using [`trace_has_monomials`] before constructing.\n107\t/// The batch must contain at least one trace.\n108\t///\n109\t/// The struct holds references to `TraceCtx` which guarantees the underlying\n110\t/// device buffers (including `main_ptrs_dev`) remain valid for the struct's lifetime.\n111\tpub(crate) struct ZerocheckMonomialBatch<'a> {\n112\t    traces: Vec<&'a TraceCtx>,\n113\t    block_ctxs: DeviceBuffer<BlockCtx>,\n114\t    air_ctxs: DeviceBuffer<MonomialAirCtx>,\n115\t    air_offsets: DeviceBuffer<u32>,\n116\t}\n117\t\n118\timpl<'a> ZerocheckMonomialBatch<'a> {\n119\t    /// Creates a new batch from an iterator of traces.\n120\t    ///"}]},"parent_tool_use_id":"toolu_01VghRCr2EXtMJrRTAJkKrms","session_id":"7b26f810-a2da-49ad-94ae-b745d8ecf3f5","uuid":"0bf70dd0-082e-4b48-8ef3-207dfc400774","timestamp":"2026-04-12T23:38:18.469Z"}
