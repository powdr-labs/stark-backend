{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BRy3h9UFdW4aHHTufE42aW","type":"tool_result","content":"180\t///\n181\t/// # Safety\n182\t/// - `matrix` is a pointer to a device buffer with length at least `width * padded_height`.\n183\t/// - `height <= lifted_height <= padded_height`\n184\tpub unsafe fn lift_padded_matrix_evals(\n185\t    matrix: *mut F,\n186\t    width: u32,\n187\t    height: u32,\n188\t    lifted_height: u32,\n189\t    padded_height: u32,\n190\t) -> Result<(), CudaError> {\n191\t    debug_assert!(height <= lifted_height && lifted_height <= padded_height);\n192\t    CudaError::from_result(_lift_padded_matrix_evals(\n193\t        matrix,\n194\t        width,\n195\t        height,\n196\t        lifted_height,\n197\t        padded_height,\n198\t    ))\n199\t}\n200\t\n201\t/// Let `lifted_height = height * stride`. Collapses a `lifted_height × width` matrix to a `height x\n202\t/// width` by taking vertical row `stride`.\n203\t///\n204\t/// # Safety\n205\t/// - `output` must be a pointer to `DeviceBuffer<F>` with length at least `height * width`.\n206\t/// - `input` must be a pointer to `DeviceBuffer<F>` with length at least `lifted_height * width`.\n207\tpub unsafe fn collapse_strided_matrix(\n208\t    output: *mut F,\n209\t    input: *const F,\n210\t    width: u32,\n211\t    height: u32,\n212\t    stride: u32,\n213\t) -> Result<(), CudaError> {\n214\t    CudaError::from_result(_collapse_strided_matrix(\n215\t        output, input, width, height, stride,\n216\t    ))\n217\t}\n218\t\n219\tpub unsafe fn batch_expand_pad(\n220\t    output: *mut F,\n221\t    input: *const F,\n222\t    poly_count: u32,\n223\t    out_size: u32,\n224\t    in_size: u32,\n225\t) -> Result<(), CudaError> {\n226\t    CudaError::from_result(_batch_expand_pad(\n227\t        output, input, poly_count, out_size, in_size,\n228\t    ))\n229\t}\n230\t\n231\t/// Expands a `height × width` column-major matrix to a `padded_height × width` column-major matrix\n232\t/// by padding with zeros. This kernel is intended for use when `width` is large (~2^20), so each\n233\t/// column is handled by a different block.\n234\t///\n235\t/// # Safety\n236\t/// - `out` must be a pointer to `DeviceBuffer<F>` with length at least `padded_height * width`.\n237\t/// - `input` must be a pointer to `DeviceBuffer<F>` with length at least `height * width`.\n238\tpub unsafe fn batch_expand_pad_wide(\n239\t    out: *mut F,\n240\t    input: *const F,\n241\t    width: u32,\n242\t    padded_height: u32,\n243\t    height: u32,\n244\t) -> Result<(), CudaError> {\n245\t    debug_assert!(padded_height > height);\n246\t    CudaError::from_result(_batch_expand_pad_wide(\n247\t        out,\n248\t        input,\n249\t        width,\n250\t        padded_height,\n251\t        height,\n252\t    ))\n253\t}\n254\t"}]},"parent_tool_use_id":"toolu_011cVGJYxsFhcbEPdAFJ8jJc","session_id":"7b26f810-a2da-49ad-94ae-b745d8ecf3f5","uuid":"59a13779-ace5-4976-9b4c-c66e5c5ec395","timestamp":"2026-04-12T23:57:32.168Z"}
