{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xqs4jLTndQtzWGYQeWUHgF","type":"tool_result","content":"1\tuse openvm_cuda_common::{d_buffer::DeviceBuffer, error::CudaError};\n2\t\n3\tuse crate::prelude::{EF, F};\n4\t\n5\textern \"C\" {\n6\t    fn _matrix_transpose_fp(\n7\t        output: *mut F,\n8\t        input: *const F,\n9\t        col_size: usize,\n10\t        row_size: usize,\n11\t    ) -> i32;\n12\t\n13\t    fn _matrix_transpose_fpext(\n14\t        output: *mut EF,\n15\t        input: *const EF,\n16\t        col_size: usize,\n17\t        row_size: usize,\n18\t    ) -> i32;\n19\t\n20\t    fn _matrix_get_rows_fp(\n21\t        output: *mut F,\n22\t        input: *const F,\n23\t        row_indices: *const u32,\n24\t        matrix_width: u64,\n25\t        matrix_height: u64,\n26\t        row_indices_len: u32,\n27\t    ) -> i32;\n28\t\n29\t    fn _split_ext_to_base_col_major_matrix(\n30\t        d_matrix: *mut F,\n31\t        d_poly: *const EF,\n32\t        poly_len: u64,\n33\t        matrix_height: u32,\n34\t    ) -> i32;\n35\t\n36\t    fn _batch_rotate_pad(\n37\t        out: *mut F,\n38\t        input: *const F,\n39\t        width: u32,\n40\t        num_x: u32,\n41\t        domain_size: u32,\n42\t        padded_size: u32,\n43\t    ) -> i32;\n44\t\n45\t    fn _lift_padded_matrix_evals(\n46\t        matrix: *mut F,\n47\t        width: u32,\n48\t        height: u32,\n49\t        lifted_height: u32,\n50\t        padded_height: u32,\n51\t    ) -> i32;\n52\t\n53\t    fn _collapse_strided_matrix(\n54\t        out: *mut F,\n55\t        input: *const F,\n56\t        width: u32,\n57\t        height: u32,\n58\t        stride: u32,\n59\t    ) -> i32;\n60\t\n61\t    fn _batch_expand_pad(\n62\t        output: *mut F,\n63\t        input: *const F,\n64\t        poly_count: u32,\n65\t        out_size: u32,\n66\t        in_size: u32,\n67\t    ) -> i32;\n68\t\n69\t    fn _batch_expand_pad_wide(\n70\t        out: *mut F,\n71\t        input: *const F,\n72\t        width: u32,\n73\t        padded_height: u32,\n74\t        height: u32,\n75\t    ) -> i32;\n76\t}\n77\t\n78\t/// Safety:\n79\t/// - `input` and `output` must not overlap.\n80\t/// - `input` and `output` must each have capacity at least `width * height`.\n81\tpub unsafe fn matrix_transpose_fp(\n82\t    output: &DeviceBuffer<F>,\n83\t    input: &DeviceBuffer<F>,\n84\t    width: usize,\n85\t    height: usize,\n86\t) -> Result<(), CudaError> {\n87\t    CudaError::from_result(_matrix_transpose_fp(\n88\t        output.as_mut_ptr(),\n89\t        input.as_ptr(),\n90\t        width,\n91\t        height,\n92\t    ))\n93\t}\n94\t\n95\t/// Safety:\n96\t/// - `input` and `output` must not overlap.\n97\t/// - `input` and `output` must each have capacity at least `width * height`.\n98\tpub unsafe fn matrix_transpose_fpext(\n99\t    output: &DeviceBuffer<EF>,\n100\t    input: &DeviceBuffer<EF>,\n101\t    width: usize,\n102\t    height: usize,\n103\t) -> Result<(), CudaError> {\n104\t    CudaError::from_result(_matrix_transpose_fpext(\n105\t        output.as_mut_ptr(),\n106\t        input.as_ptr(),\n107\t        width,\n108\t        height,\n109\t    ))\n110\t}\n111\t\n112\tpub unsafe fn matrix_get_rows_fp_kernel(\n113\t    output: &DeviceBuffer<F>,\n114\t    input: &DeviceBuffer<F>,\n115\t    row_indices: &DeviceBuffer<u32>,\n116\t    matrix_width: u64,\n117\t    matrix_height: u64,\n118\t    row_indices_len: u32,\n119\t) -> Result<(), CudaError> {\n120\t    CudaError::from_result(_matrix_get_rows_fp(\n121\t        output.as_mut_ptr(),\n122\t        input.as_ptr(),\n123\t        row_indices.as_ptr(),\n124\t        matrix_width,\n125\t        matrix_height,\n126\t        row_indices_len,\n127\t    ))\n128\t}\n129\t\n130\tpub unsafe fn split_ext_to_base_col_major_matrix(\n131\t    d_matrix: &mut DeviceBuffer<F>,\n132\t    d_poly: &DeviceBuffer<EF>,\n133\t    poly_len: u64,\n134\t    matrix_height: u32,\n135\t) -> Result<(), CudaError> {\n136\t    CudaError::from_result(_split_ext_to_base_col_major_matrix(\n137\t        d_matrix.as_mut_ptr(),\n138\t        d_poly.as_ptr(),\n139\t        poly_len,\n140\t        matrix_height,\n141\t    ))\n142\t}\n143\t\n144\t/// This kernel has the effect of rotating `input` column-wise as a `height x width` matrix, where\n145\t/// `height = domain_size * num_x` **and then** batch expanding it as `width * num_x` vectors of\n146\t/// length `domain_size` by zero padding to vectors of length `padded_size`. The output is written\n147\t/// to `output`. This kernel zeros all padding entries.\n148\t///\n149\t/// # Safety\n150\t/// - `output` must be a pointer to DeviceBuffer with capacity for `padded_size * width * num_x`\n151\t///   elements.\n152\t/// - `input` must be a pointer to DeviceBuffer with at least `domain_size * width * num_x`\n153\t///   elements.\n154\t/// - Must have `width * num_x < (u16::MAX)^2` due to grid dimension restrictions.\n155\tpub unsafe fn batch_rotate_pad(\n156\t    output: *mut F,\n157\t    input: *const F,\n158\t    width: u32,\n159\t    num_x: u32,\n160\t    domain_size: u32,\n161\t    padded_size: u32,\n162\t) -> Result<(), CudaError> {\n163\t    debug_assert!(domain_size <= padded_size);\n164\t    debug_assert!(width.checked_mul(num_x).unwrap() < u16::MAX as u32 * u16::MAX as u32);\n165\t    CudaError::from_result(_batch_rotate_pad(\n166\t        output,\n167\t        input,\n168\t        width,\n169\t        num_x,\n170\t        domain_size,\n171\t        padded_size,\n172\t    ))\n173\t}\n174\t\n175\t/// This lifts `matrix` inplace, where `matrix` is already vertically padded.\n176\t/// - `matrix` is a `padded_height x width` matrix.\n177\t///\n178\t/// This kernel cyclically repeats the first `height` rows of the matrix vertically for\n179\t/// `lifted_height` rows. The rows `lifted_height..padded_height` are left untouched.\n180\t///\n181\t/// # Safety\n182\t/// - `matrix` is a pointer to a device buffer with length at least `width * padded_height`.\n183\t/// - `height <= lifted_height <= padded_height`\n184\tpub unsafe fn lift_padded_matrix_evals(\n185\t    matrix: *mut F,\n186\t    width: u32,\n187\t    height: u32,\n188\t    lifted_height: u32,\n189\t    padded_height: u32,\n190\t) -> Result<(), CudaError> {\n191\t    debug_assert!(height <= lifted_height && lifted_height <= padded_height);\n192\t    CudaError::from_result(_lift_padded_matrix_evals(\n193\t        matrix,\n194\t        width,\n195\t        height,\n196\t        lifted_height,\n197\t        padded_height,\n198\t    ))\n199\t}\n200\t\n201\t/// Let `lifted_height = height * stride`. Collapses a `lifted_height × width` matrix to a `height x\n202\t/// width` by taking vertical row `stride`.\n203\t///\n204\t/// # Safety\n205\t/// - `output` must be a pointer to `DeviceBuffer<F>` with length at least `height * width`.\n206\t/// - `input` must be a pointer to `DeviceBuffer<F>` with length at least `lifted_height * width`.\n207\tpub unsafe fn collapse_strided_matrix(\n208\t    output: *mut F,\n209\t    input: *const F,\n210\t    width: u32,\n211\t    height: u32,\n212\t    stride: u32,\n213\t) -> Result<(), CudaError> {\n214\t    CudaError::from_result(_collapse_strided_matrix(\n215\t        output, input, width, height, stride,\n216\t    ))\n217\t}\n218\t\n219\tpub unsafe fn batch_expand_pad(\n220\t    output: *mut F,\n221\t    input: *const F,\n222\t    poly_count: u32,\n223\t    out_size: u32,\n224\t    in_size: u32,\n225\t) -> Result<(), CudaError> {\n226\t    CudaError::from_result(_batch_expand_pad(\n227\t        output, input, poly_count, out_size, in_size,\n228\t    ))\n229\t}\n230\t\n231\t/// Expands a `height × width` column-major matrix to a `padded_height × width` column-major matrix\n232\t/// by padding with zeros. This kernel is intended for use when `width` is large (~2^20), so each\n233\t/// column is handled by a different block.\n234\t///\n235\t/// # Safety\n236\t/// - `out` must be a pointer to `DeviceBuffer<F>` with length at least `padded_height * width`.\n237\t/// - `input` must be a pointer to `DeviceBuffer<F>` with length at least `height * width`.\n238\tpub unsafe fn batch_expand_pad_wide(\n239\t    out: *mut F,\n240\t    input: *const F,\n241\t    width: u32,\n242\t    padded_height: u32,\n243\t    height: u32,\n244\t) -> Result<(), CudaError> {\n245\t    debug_assert!(padded_height > height);\n246\t    CudaError::from_result(_batch_expand_pad_wide(\n247\t        out,\n248\t        input,\n249\t        width,\n250\t        padded_height,\n251\t        height,\n252\t    ))\n253\t}\n254\t"}]},"parent_tool_use_id":"toolu_01XVrvupcMHZGasj5E377JPx","session_id":"7b26f810-a2da-49ad-94ae-b745d8ecf3f5","uuid":"2f4066dc-5883-45ba-90c3-8768d19a89f0","timestamp":"2026-04-13T00:02:34.012Z"}
