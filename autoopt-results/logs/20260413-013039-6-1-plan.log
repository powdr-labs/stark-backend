{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YSYUTsoBJs8B3RcvpSLzo4","type":"tool_result","content":"1\t//! Rust bindings for CUDA sponge grinding kernel.\n2\t\n3\tuse openvm_cuda_common::{\n4\t    copy::{MemCopyD2H, MemCopyH2D},\n5\t    d_buffer::DeviceBuffer,\n6\t    error::CudaError,\n7\t};\n8\t\n9\tuse crate::sponge::{DeviceSpongeState, GrindError};\n10\t\n11\textern \"C\" {\n12\t    fn _sponge_grind(\n13\t        init_state: *const DeviceSpongeState,\n14\t        bits: u32,\n15\t        min_witness: u32,\n16\t        max_witness: u32,\n17\t        result: *mut u32,\n18\t    ) -> i32;\n19\t}\n20\t\n21\t/// Launch the GPU grinding kernel to find a PoW witness.\n22\t///\n23\t/// # Arguments\n24\t/// * `init_state` - Pointer to the initial sponge state on device\n25\t/// * `bits` - Number of bits that must be zero in the sampled value\n26\t/// * `max_witness` - Maximum witness value to search (typically F::ORDER - 1)\n27\t///\n28\t/// # Returns\n29\t/// The witness value that satisfies the PoW requirement, or an error.\n30\t///\n31\t/// # Safety\n32\t/// - `init_state` must point to valid device memory containing a `DeviceSpongeState`\n33\tpub unsafe fn sponge_grind(\n34\t    init_state: *const DeviceSpongeState,\n35\t    bits: u32,\n36\t    max_witness: u32,\n37\t) -> Result<u32, GrindError> {\n38\t    let mut d_result = DeviceBuffer::with_capacity(1);\n39\t    [u32::MAX].copy_to(&mut d_result)?;\n40\t    for start in (0..=max_witness).step_by(1 << bits) {\n41\t        CudaError::from_result(_sponge_grind(\n42\t            init_state,\n43\t            bits,\n44\t            start,\n45\t            max_witness,\n46\t            d_result.as_mut_ptr(),\n47\t        ))?;\n48\t\n49\t        let result = d_result.to_host()?[0];\n50\t        if result < u32::MAX {\n51\t            return Ok(result);\n52\t        }\n53\t    }\n54\t    Err(GrindError::WitnessNotFound)\n55\t}\n56\t"}]},"parent_tool_use_id":"toolu_01Gs6peMrtkv6NENMBwS8t1L","session_id":"7b26f810-a2da-49ad-94ae-b745d8ecf3f5","uuid":"888a1136-dbc9-4850-8890-a58eb162e523","timestamp":"2026-04-12T23:38:06.176Z"}
