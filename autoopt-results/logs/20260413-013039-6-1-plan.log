inverse NTT for each 2^l_skip chunk per column:\n57\t            // (width cols) * (height / 2^l_skip chunks per col). Use natural ordering.\n58\t            let num_uni_poly = width * (height >> l_skip);\n59\t            unsafe {\n60\t                batch_ntt_small(&mut mixed, l_skip, num_uni_poly, true).unwrap();\n61\t            }\n62\t        }\n63\t        Self {\n64\t            mixed,\n65\t            height,\n66\t            width,\n67\t        }\n68\t    }\n69\t\n70\t    pub fn to_evals(&self, l_skip: usize) -> Result<DeviceMatrix<F>, KernelError> {\n71\t        let width = self.width();\n72\t        let height = self.height();\n73\t        // D2D copy so we can do in-place NTT\n74\t        let mut evals = self.mixed.device_copy()?;\n75\t        if l_skip > 0 {\n76\t            // For univariate coordinate, perform NTT for each 2^l_skip chunk per column: (width\n77\t            // cols) * (height / 2^l_skip chunks per col). Use natural ordering.\n78\t            let num_uni_poly = width * (height >> l_skip);\n79\t            unsafe {\n80\t                batch_ntt_small(&mut evals, l_skip, num_uni_poly, false).unwrap();\n81\t            }\n82\t        }\n83\t        Ok(DeviceMatrix::new(Arc::new(evals), height, width))\n84\t    }\n85\t}\n86\t\n87\t/// Assumes that `evals` is column-major matrix of evaluations on a hypercube `H_n`.\n88\t/// In-place interpolates `evals` from evaluations to coefficient form.\n89\tpub fn mle_evals_to_coeffs_inplace(evals: &mut DeviceBuffer<F>, n: usize) -> Result<(), CudaError> {\n90\t    if n == 0 {\n91\t        return Ok(());\n92\t    }\n93\t    debug_assert!(evals.len().is_multiple_of(1 << n));\n94\t    let width = evals.len() >> n;\n95\t    // SAFETY:\n96\t    // - `evals` is valid buffer, representing a single column vector, so width = 1\n97\t    // - we only use forward direction with bit_reversed = false\n98\t    unsafe {\n99\t        mle_interpolate_stages(\n100\t            evals.as_mut_ptr(),"}]},"parent_tool_use_id