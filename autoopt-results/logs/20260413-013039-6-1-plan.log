{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019td4Kwr4Xe5eUoywU1EPe7","type":"tool_result","content":"38\t/// FFI binding for the `cudaMemcpyAsync` function on the default cuda stream.\n39\t///\n40\t/// # Safety\n41\t/// Must follow the rules of the `cudaMemcpyAsync` function from the CUDA runtime API.\n42\tpub unsafe fn cuda_memcpy<const SRC_DEVICE: bool, const DST_DEVICE: bool>(\n43\t    dst: *mut c_void,\n44\t    src: *const c_void,\n45\t    size_bytes: usize,\n46\t) -> Result<(), MemCopyError> {\n47\t    check(unsafe {\n48\t        cudaMemcpyAsync(\n49\t            dst,\n50\t            src,\n51\t            size_bytes,\n52\t            std::mem::transmute::<i32, cudaMemcpyKind>(\n53\t                if DST_DEVICE { 1 } else { 0 } + if SRC_DEVICE { 2 } else { 0 },\n54\t            ),\n55\t            cudaStreamPerThread,\n56\t        )\n57\t    })\n58\t    .map_err(MemCopyError::from)\n59\t}\n60\t\n61\t// Host -> Device\n62\tpub trait MemCopyH2D<T> {\n63\t    fn copy_to(&self, dst: &mut DeviceBuffer<T>) -> Result<(), MemCopyError>;\n64\t    fn to_device(&self) -> Result<DeviceBuffer<T>, MemCopyError>;\n65\t}\n66\t\n67\timpl<T> MemCopyH2D<T> for [T] {"}]},"parent_tool_use_id":null,"session_id":"7b26f810-a2da-49ad-94ae-b745d8ecf3f5","uuid":"96d6949a-bedc-435e-9bd9-c3aaaeb67edf","timestamp":"2026-04-12T23:49:45.666Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-common/src/copy.rs","content":"/// FFI binding for the `cudaMemcpyAsync` function on the default cuda stream.\n///\n/// # Safety\n/// Must follow the rules of the `cudaMemcpyAsync` function from the CUDA runtime API.\npub unsafe fn cuda_memcpy<const SRC_DEVICE: bool, const DST_DEVICE: bool>(\n    dst: *mut c_void,\n    src: *const c_void,\n    size_bytes: usize,\n) -> Result<(), MemCopyError> {\n    check(unsafe {\n        cudaMemcpyAsync(\n            dst,\n            src,\n            size_bytes,\n            std::mem::transmute::<i32, cudaMemcpyKind>(\n                if DST_DEVICE { 1 } else { 0 } + if SRC_DEVICE { 2 } else { 0 },\n            ),\n            cudaStreamPerThread,\n        )\n    })\n    .map_err(MemCopyError::from)\n}\n\n// Host -> Device\npub trait MemCopyH2D<T> {\n    fn copy_to(&self, dst: &mut DeviceBuffer<T>) -> Result<(), MemCopyError>;\n    fn to_device(&self) -> Result<DeviceBuffer<T>, MemCopyError>;\n}\n\nimpl<T> MemCopyH2D<T> for [T] {","numLines":30,"startLine":38,"totalLines":210}}}
