n1141\t            let has_interactions = !dag.interactions.is_empty();\n1142\t            if !has_constraints && !has_interactions {\n1143\t                continue;\n1144\t            }\n1145\t\n1146\t            let n_lift = n.max(0) as usize;\n1147\t            let norm_factor_denom = 1 << (-n).max(0);\n1148\t            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n1149\t            let has_preprocessed = pk.preprocessed_data.is_some();\n1150\t            let need_rot = pk.vk.params.need_rot;\n1151\t            let first_main_idx = usize::from(has_preprocessed);\n1152\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n1153\t\n1154\t            if round > n_lift {\n1155\t                // Case A\n1156\t                if round == n_lift + 1 {\n1157\t                    // A.1: evaluate directly at (num_x=1, num_y=1)\n1158\t                    let prep_ptr = if has_preprocessed {\n1159\t                        MainMatrixPtrs {\n1160\t                            data: mats[0].buffer().as_ptr(),\n1161\t                            air_width: air_width_for_mat(need_rot, mats[0].width()),\n1162\t                        }\n1163\t                    } else {\n1164\t                        MainMatrixPtrs {\n1165\t                            data: std::ptr::null(),\n1166\t                            air_width: 0,\n1167\t                        }\n1168\t                    };\n1169\t                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1170\t                        .iter()\n1171\t                        .map(|m| MainMatrixPtrs {\n1172\t                            data: m.buffer().as_ptr(),\n1173\t                            air_width: air_width_for_mat(need_rot, m.width()),\n1174\t                        })\n1175\t                        .collect_vec();\n1176\t                    let main_ptrs_dev = main_ptrs.to_device()?;\n1177\t\n1178\t                    late_eval.push(TraceCtx {\n1179\t                        trace_idx,\n1180\t                        air_idx,\n1181\t                        n_lift,\n1182\t                        num_y: 1,\n1183\t                        has_constraints,\n1184\t                        has_interactions,\n1185\t                        norm_factor,\n1186\t                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n1187\t                        sels_ptr: sels.buffer().as_ptr(),\n1188\t                        prep_ptr,\n1189\t                        main_ptrs_dev,\n1190\t                        public_ptr: public_vals.as_ptr(),\n1191\t                        eq_3bs_ptr: eq_3bs.as_ptr(),\n1192\t                    });\n1193\t                } else {\n1194\t                    // A.2: scale tilde evals only\n1195\t                    if has_constraints {\n1196\t                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n1197\t                        *tilde_eval *= r_prev;\n1198\t                        // zc_out not set, will be handled directly from tilde eval in\n1199\t                        // compute_batch_s\n1200\t                    }\n1201\t                    if has_interactions {\n1202\t                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n1203\t                            *x *= r_prev;\n1204\t                        }\n1205\t                        // logup_out not set, will be handled directly from tilde eval in\n1206\t                        // compute_batch_s\n1207\t                    }\n1208\t                }\n1209\t            } else {\n1210\t                // Case B: interpolate columns and evaluate (num_x = s_deg, num_y = height/2)\n1211\t                let log_num_y = n_lift - round;\n1212\t                let num_y = 1 << log_num_y;\n1213\t                let height = 2 * num_y;\n1214\t                debug_assert_eq!(height, mats[0].height());\n1215\t\n1216\t                let mut columns: Vec<*const EF> = Vec::new();\n1217\t                columns.extend(\n1218\t               