{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0138TUetErJ39JjfAdXhUQGj","type":"tool_result","content":"1\tuse super::*;\n2\tuse crate::{\n3\t    monomial::{InteractionMonomialTerm, LambdaTerm, MonomialHeader, PackedVar},\n4\t    poly::SqrtEqLayers,\n5\t};\n6\t\n7\t#[repr(C)]\n8\t#[derive(Clone, Copy, Debug)]\n9\tpub struct MainMatrixPtrs<T> {\n10\t    pub data: *const T,\n11\t    pub air_width: u32,\n12\t}\n13\t\n14\t// Types for batch MLE:\n15\t#[repr(C)]\n16\t#[derive(Clone, Copy, Debug)]\n17\tpub struct BlockCtx {\n18\t    pub local_block_idx_x: u32,\n19\t    /// Caution: this refers to the index within buffer of `ZerocheckCtx` or `LogupCtx`. It is\n20\t    /// hence a \"local\" AIR index and not the global AIR index within the proving key.\n21\t    pub air_idx: u32,\n22\t}\n23\t\n24\t/// Per-AIR context for batched monomial evaluation.\n25\t#[repr(C)]\n26\t#[derive(Clone, Copy, Debug)]\n27\tpub struct MonomialAirCtx {\n28\t    pub d_headers: *const MonomialHeader,\n29\t    pub d_variables: *const PackedVar,\n30\t    pub d_lambda_combinations: *const EF, // Precomputed per-monomial\n31\t    pub num_monomials: u32,\n32\t    pub eval_ctx: EvalCoreCtx,\n33\t    pub d_eq_xi: *const EF,\n34\t    pub num_y: u32,\n35\t}\n36\t\n37\t#[repr(C)]\n38\t#[derive(Clone, Copy, Debug)]\n39\tpub struct EvalCoreCtx {\n40\t    pub d_selectors: *const EF,\n41\t    pub d_preprocessed: MainMatrixPtrs<EF>,\n42\t    pub d_main: *const MainMatrixPtrs<EF>,\n43\t    pub d_public: *const F,\n44\t}\n45\t\n46\t#[repr(C)]\n47\t#[derive(Clone, Copy, Debug)]\n48\tpub struct ZerocheckCtx {\n49\t    pub eval_ctx: EvalCoreCtx,\n50\t    pub d_intermediates: *mut EF,\n51\t    pub num_y: u32,\n52\t    pub d_eq_xi: *const EF,\n53\t    pub d_rules: *const std::ffi::c_void,\n54\t    pub rules_len: usize,\n55\t    pub d_used_nodes: *const usize,\n56\t    pub used_nodes_len: usize,\n57\t    pub buffer_size: u32,\n58\t}\n59\t\n60\t#[repr(C)]\n61\t#[derive(Clone, Copy, Debug)]\n62\tpub struct LogupCtx {\n63\t    pub eval_ctx: EvalCoreCtx,\n64\t    pub d_intermediates: *mut EF,\n65\t    pub num_y: u32,\n66\t    pub d_eq_xi: *const EF,\n67\t    pub d_challenges: *const EF,\n68\t    pub d_eq_3bs: *const EF,\n69\t    pub d_rules: *const std::ffi::c_void,\n70\t    pub rules_len: usize,\n71\t    pub d_used_nodes: *const usize,\n72\t    pub d_pair_idxs: *const u32,\n73\t    pub used_nodes_len: usize,\n74\t    pub buffer_size: u32,\n75\t}\n76\t\n77\t/// Common per-AIR context for batched logup monomial evaluation.\n78\t#[repr(C)]\n79\t#[derive(Clone, Copy, Debug)]\n80\tpub struct LogupMonomialCommonCtx {\n81\t    pub eval_ctx: EvalCoreCtx,\n82\t    pub d_eq_xi: *const EF,\n83\t    pub bus_term_sum: EF, // Precomputed sum_i(beta[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n84\t    pub num_y: u32,\n85\t    pub mono_blocks: u32,\n86\t}\n87\t\n88\t/// Per-AIR context for batched logup monomial evaluation (numerator or denominator).\n89\t#[repr(C)]\n90\t#[derive(Clone, Copy, Debug)]\n91\tpub struct LogupMonomialCtx {\n92\t    pub d_headers: *const MonomialHeader,\n93\t    pub d_variables: *const PackedVar,\n94\t    pub d_combinations: *const EF,\n95\t    pub num_monomials: u32,\n96\t}\n97\t// end of types for batch MLE\n98\t\n99\textern \"C\" {\n100\t    // gkr.cu"}]},"parent_tool_use_id":"toolu_015ooFuXo7vznHmWRj2aF1CR","session_id":"7b26f810-a2da-49ad-94ae-b745d8ecf3f5","uuid":"dca589f1-6520-4e35-9b1f-fc6fa8f5693d","timestamp":"2026-04-12T23:44:06.716Z"}
