{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UTwXLFytuhURhKS9NoXh4X","type":"tool_result","content":"200\t    desired_tile.clamp(PRECOMPUTE_M_MIN_TAIL_TILE, PRECOMPUTE_M_TAIL_TILE)\n201\t}\n202\t\n203\tfn choose_precompute_m_window_w(\n204\t    rem_n: usize,\n205\t    rounds_left: usize,\n206\t    min_blocks_threshold: usize,\n207\t    target_blocks: usize,\n208\t    tail_tile_override: Option<usize>,\n209\t    min_n: usize,\n210\t) -> Option<usize> {\n211\t    if rem_n < min_n || rounds_left < GKR_WINDOW_SIZE {\n212\t        return None;\n213\t    }\n214\t    let w = GKR_WINDOW_SIZE;\n215\t    let tail_tile = precompute_m_build_tail_tile(\n216\t        rem_n,\n217\t        w,\n218\t        min_blocks_threshold,\n219\t        target_blocks,\n220\t        tail_tile_override,\n221\t    );\n222\t    (precompute_m_num_tail_blocks(rem_n, w, tail_tile) >= min_blocks_threshold).then_some(w)\n223\t}\n224\t\n225\tfn choose_round_strategy(\n226\t    round: usize,\n227\t    precompute_m_env: bool,\n228\t    precompute_m_min_blocks_threshold: usize,\n229\t    precompute_m_target_blocks: usize,\n230\t    precompute_m_tail_tile_override: Option<usize>,\n231\t    precompute_m_min_n: usize,\n232\t) -> GkrRoundStrategy {\n233\t    if !precompute_m_env {\n234\t        return GkrRoundStrategy::FoldEval;\n235\t    }\n236\t    let start_base = 1usize;\n237\t    let stop = round.div_ceil(2);\n238\t    let rem_n = round - start_base;\n239\t    let rounds_left = stop - start_base;\n240\t    if choose_precompute_m_window_w(\n241\t        rem_n,\n242\t        rounds_left,\n243\t        precompute_m_min_blocks_threshold,\n244\t        precompute_m_target_blocks,\n245\t        precompute_m_tail_tile_override,\n246\t        precompute_m_min_n,\n247\t    )\n248\t    .is_none()\n249\t    {\n250\t        return GkrRoundStrategy::FoldEval;\n251\t    }\n252\t\n253\t    GkrRoundStrategy::PrecomputeM\n254\t}\n255\t\n256\tfn eval_mle_table(points: &[EF], out: &mut [EF]) {\n257\t    // w <= 5 so CPU builds are trivial; avoid GPU kernel/alloc overhead for tiny tables.\n258\t    let n = points.len();\n259\t    let size = 1usize << n;\n260\t    debug_assert!(out.len() >= size);\n261\t    for (bits, dst) in out.iter_mut().enumerate().take(size) {\n262\t        let mut acc = EF::ONE;\n263\t        for (i, &x) in points.iter().enumerate() {\n264\t            let bit = ((bits >> (n - 1 - i)) & 1) == 1;\n265\t            acc *= if bit { x } else { EF::ONE - x };\n266\t        }\n267\t        *dst = acc;\n268\t    }\n269\t}\n270\t\n271\t/// Get low/high eq pointers for the tail portion of the eq buffer, skipping `drop_count` layers.\n272\t/// See `docs/cuda-backend/gkr-prover.md` § \"Eq buffer sqrt decomposition\".\n273\tfn eq_tail_ptrs(\n274\t    eq_buffer: &SqrtEqLayers,\n275\t    drop_count: usize,\n276\t) -> (*const EF, *const EF, usize, usize) {\n277\t    let mut high_n = eq_buffer.high_n();\n278\t    let mut low_n = eq_buffer.low_n();\n279\t    let total_n = high_n + low_n;\n280\t    if drop_count >= total_n {\n281\t        return (std::ptr::null(), std::ptr::null(), 1, 0);\n282\t    }\n283\t    if drop_count <= high_n {\n284\t        high_n -= drop_count;\n285\t    } else {\n286\t        low_n -= drop_count - high_n;\n287\t        high_n = 0;\n288\t    }\n289\t    let tail_n = low_n + high_n;\n290\t    if tail_n == 0 {\n291\t        (std::ptr::null(), std::ptr::null(), 1, 0)\n292\t    } else {\n293\t        (\n294\t            eq_buffer.low.get_ptr(low_n),\n295\t            eq_buffer.high.get_ptr(high_n),\n296\t            1 << low_n,\n297\t            tail_n,\n298\t        )\n299\t    }\n300\t}\n301\t\n302\tfn copy_to_device_ptr<T: Copy>(dst: *mut T, src: &[T]) -> Result<(), FractionalSumcheckError> {\n303\t    if src.is_empty() {\n304\t        return Ok(());\n305\t    }\n306\t    unsafe {\n307\t        cuda_memcpy::<false, true>(\n308\t            dst as *mut c_void,\n309\t            src.as_ptr() as *const c_void,\n310\t            std::mem::size_of_val(src),\n311\t        )?;\n312\t    }\n313\t    Ok(())\n314\t}\n315\t\n316\t/// Observes s_evals in transcript, updates accumulators, and returns the sampled challenge.\n317\t#[allow(clippy::too_many_arguments)]\n318\tfn observe_and_update<SC, TS>(\n319\t    d_sum_evals: &DeviceBuffer<EF>,\n320\t    transcript: &mut TS,\n321\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n322\t    r_vec: &mut Vec<EF>,\n323\t    prev_s_eval: &mut EF,\n324\t    xi_j: EF,\n325\t    eq_r_acc: &mut EF,\n326\t) -> Result<EF, FractionalSumcheckError>\n327\twhere\n328\t    SC: StarkProtocolConfig<EF = EF>,\n329\t    TS: FiatShamirTranscript<SC>,\n330\t{\n331\t    let (s_evals, sp_evals) = reconstruct_s_evals(d_sum_evals, *prev_s_eval, xi_j, *eq_r_acc)?;\n332\t\n333\t    for &eval in &s_evals {\n334\t        transcript.observe_ext(eval);\n335\t    }\n336\t    round_polys_eval.push(s_evals);\n337\t\n338\t    let r = transcript.sample_ext();\n339\t    r_vec.push(r);\n340\t\n341\t    let eq_r = eval_eq_mle(&[xi_j], &[r]);\n342\t    *eq_r_acc *= eq_r;\n343\t    *prev_s_eval = eq_r * interpolate_quadratic_at_012(&sp_evals, r);\n344\t\n345\t    Ok(r)\n346\t}\n347\t\n348\t/// Fused revert + compute round: reverts the tree layer and computes s'_0(1) and s'_0(2).\n349\t///\n350\t/// See `docs/cuda-backend/gkr-prover.md` § \"Sumcheck round strategies\" for context.\n351\t#[allow(clippy::too_many_arguments)]\n352\tfn do_sumcheck_round_and_revert<SC, TS>(\n353\t    eq_buffer: &mut SqrtEqLayers,\n354\t    layer: &mut DeviceBuffer<Frac<EF>>,\n355\t    pq_size: usize,\n356\t    lambda: EF,\n357\t    transcript: &mut TS,\n358\t    d_sum_evals: &mut DeviceBuffer<EF>,\n359\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n360\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n361\t    r_vec: &mut Vec<EF>,\n362\t    prev_s_eval: &mut EF,\n363\t    xi_j: EF,\n364\t    eq_r_acc: &mut EF,\n365\t) -> Result<EF, FractionalSumcheckError>\n366\twhere\n367\t    SC: StarkProtocolConfig<EF = EF>,\n368\t