{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FFLR1exN22w73n7T6PYKWo","type":"tool_result","content":"1\t#![allow(clippy::missing_safety_doc)]\n2\t#![allow(clippy::too_many_arguments)]\n3\t\n4\tuse openvm_cuda_common::{d_buffer::DeviceBuffer, error::CudaError};\n5\t\n6\tuse crate::prelude::{EF, F};\n7\t\n8\t// relate to supra/ntt_params.cu\n9\textern \"C\" {\n10\t    fn _generate_all_twiddles(twiddles: *mut std::ffi::c_void, inverse: bool) -> i32;\n11\t    fn _generate_partial_twiddles(partial_twiddles: *mut std::ffi::c_void, inverse: bool) -> i32;\n12\t}\n13\t\n14\tpub unsafe fn generate_all_twiddles<F>(\n15\t    twiddles: &DeviceBuffer<F>,\n16\t    inverse: bool,\n17\t) -> Result<(), CudaError> {\n18\t    CudaError::from_result(_generate_all_twiddles(twiddles.as_mut_raw_ptr(), inverse))\n19\t}\n20\t\n21\tpub unsafe fn generate_partial_twiddles<F>(\n22\t    partial_twiddles: &DeviceBuffer<F>,\n23\t    inverse: bool,\n24\t) -> Result<(), CudaError> {\n25\t    CudaError::from_result(_generate_partial_twiddles(\n26\t        partial_twiddles.as_mut_raw_ptr(),\n27\t        inverse,\n28\t    ))\n29\t}\n30\t\n31\t// relate to supra/ntt_bitrev.cu\n32\textern \"C\" {\n33\t    fn _bit_rev(\n34\t        d_out: *mut std::ffi::c_void,\n35\t        d_inp: *const std::ffi::c_void,\n36\t        lg_domain_size: u32,\n37\t        padded_poly_size: u32,\n38\t        poly_count: u32,\n39\t    ) -> i32;\n40\t\n41\t    fn _bit_rev_ext(\n42\t        d_out: *mut std::ffi::c_void,\n43\t        d_inp: *const std::ffi::c_void,\n44\t        lg_domain_size: u32,\n45\t        padded_poly_size: u32,\n46\t        poly_count: u32,\n47\t    ) -> i32;\n48\t\n49\t    fn _bit_rev_frac_ext(\n50\t        d_out: *mut std::ffi::c_void,\n51\t        d_inp: *const std::ffi::c_void,\n52\t        lg_domain_size: u32,\n53\t        padded_poly_size: u32,\n54\t        poly_count: u32,\n55\t    ) -> i32;\n56\t\n57\t    /// Fused bitrev + K=2 tree build for a single frac_fpext_t buffer.\n58\t    /// Applies alpha to denominators and fuses tree layers 0 and 1 in shmem.\n59\t    /// Requires domain_size >= 256.\n60\t    fn _bit_rev_frac_ext_build_k2(\n61\t        inout: *mut std::ffi::c_void,\n62\t        lg_domain_size: u32,\n63\t        alpha: EF,\n64\t    ) -> i32;\n65\t}\n66\t\n67\tpub unsafe fn bit_rev(\n68\t    d_out: &DeviceBuffer<F>,\n69\t    d_inp: &DeviceBuffer<F>,\n70\t    lg_domain_size: u32,\n71\t    padded_poly_size: u32,\n72\t    poly_count: u32,\n73\t) -> Result<(), CudaError> {\n74\t    CudaError::from_result(_bit_rev(\n75\t        d_out.as_mut_raw_ptr(),\n76\t        d_inp.as_raw_ptr(),\n77\t        lg_domain_size,\n78\t        padded_poly_size,\n79\t        poly_count,\n80\t    ))\n81\t}\n82\t\n83\tpub unsafe fn bit_rev_ext(\n84\t    d_out: &DeviceBuffer<EF>,\n85\t    d_inp: &DeviceBuffer<EF>,\n86\t    lg_domain_size: u32,\n87\t    padded_poly_size: u32,\n88\t    poly_count: u32,\n89\t) -> Result<(), CudaError> {\n90\t    CudaError::from_result(_bit_rev_ext(\n91\t        d_out.as_mut_raw_ptr(),\n92\t        d_inp.as_raw_ptr(),\n93\t        lg_domain_size,\n94\t        padded_poly_size,\n95\t        poly_count,\n96\t    ))\n97\t}\n98\t\n99\tpub unsafe fn bit_rev_frac_ext(\n100\t    d_out: &DeviceBuffer<(EF, EF)>,\n101\t    d_inp: &DeviceBuffer<(EF, EF)>,\n102\t    lg_domain_size: u32,\n103\t    padded_poly_size: u32,\n104\t    poly_count: u32,\n105\t) -> Result<(), CudaError> {\n106\t    CudaError::from_result(_bit_rev_frac_ext(\n107\t        d_out.as_mut_raw_ptr(),\n108\t        d_inp.as_raw_ptr(),\n109\t        lg_domain_size,\n110\t        padded_poly_size,\n111\t        poly_count,\n112\t    ))\n113\t}\n114\t\n115\tpub unsafe fn bit_rev_frac_ext_build_k2(\n116\t    inout: &DeviceBuffer<(EF, EF)>,\n117\t    lg_domain_size: u32,\n118\t    alpha: EF,\n119\t) -> Result<(), CudaError> {\n120\t    CudaError::from_result(_bit_rev_frac_ext_build_k2(\n121\t        inout.as_mut_raw_ptr(),\n122\t        lg_domain_size,\n123\t        alpha,\n124\t    ))\n125\t}\n126\t\n127\t// relate to supra/ntt.cu\n128\textern \"C\" {\n129\t    fn _ct_mixed_radix_narrow(\n130\t        d_inout: *mut std::ffi::c_void,\n131\t        radix: u32,\n132\t        lg_domain_size: u32,\n133\t        stage: u32,\n134\t        iterations: u32,\n135\t        padded_poly_size: u32,\n136\t        poly_count: u32,\n137\t        is_intt: bool,\n138\t    ) -> i32;\n139\t}\n140\t\n141\tpub unsafe fn ct_mixed_radix_narrow(\n142\t    d_inout: &DeviceBuffer<F>,\n143\t    radix: u32,\n144\t    lg_domain_size: u32,\n145\t    stage: u32,\n146\t    iterations: u32,\n147\t    padded_poly_size: u32,\n148\t    poly_count: u32,\n149\t    is_intt: bool,\n150\t) -> Result<(), CudaError> {\n151\t    CudaError::from_result(_ct_mixed_radix_narrow(\n152\t        d_inout.as_mut_raw_ptr(),\n153\t        radix,\n154\t        lg_domain_size,\n155\t        stage,\n156\t        iterations,\n157\t        padded_poly_size,\n158\t        poly_count,\n159\t        is_intt,\n160\t    ))\n161\t}\n162\t"}]},"parent_tool_use_id":"toolu_01Gs6peMrtkv6NENMBwS8t1L","session_id":"7b26f810-a2da-49ad-94ae-b745d8ecf3f5","uuid":"c46b79d9-d148-4ed1-91a7-3e54cf300695","timestamp":"2026-04-12T23:38:07.991Z"}
