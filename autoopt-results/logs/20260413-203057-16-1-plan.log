{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AiGGpmrVDd3YxspnyYpZmr","type":"tool_result","content":"1020\t// Combines frac_build_tree_layer(revert=true) with compute_round for the first inner round.\n1021\textern \"C\" int _frac_compute_round_and_revert(\n1022\t    const FpExt *eq_xi_low,\n1023\t    const FpExt *eq_xi_high,\n1024\t    FracExt *layer,           // Tree layer buffer (modified in-place for revert)\n1025\t    size_t num_x,\n1026\t    size_t eq_low_cap,\n1027\t    FpExt lambda,\n1028\t    FpExt *out,               // Output: [d=2] final results\n1029\t    FpExt *tmp_block_sums     // Temporary buffer: [gridDim.x * d]\n1030\t) {\n1031\t    assert(num_x > 1);\n1032\t\n1033\t    auto [grid, block] = frac_compute_round_launch_params(num_x);\n1034\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n1035\t\n1036\t    // Launch fused revert + compute kernel\n1037\t    compute_round_and_revert_kernel<<<grid, block, shmem_bytes>>>(\n1038\t        eq_xi_low,\n1039\t        eq_xi_high,\n1040\t        layer,\n1041\t        (uint32_t)num_x,\n1042\t        __builtin_ctz((uint32_t)eq_low_cap),\n1043\t        lambda,\n1044\t        tmp_block_sums\n1045\t    );\n1046\t    int err = CHECK_KERNEL();\n1047\t    if (err != 0)\n1048\t        return err;\n1049\t\n1050\t    // Launch final reduction kernel.\n1051\t    return final_reduce_block_sums(tmp_block_sums, out, grid.x);\n1052\t}\n1053\t\n1054\t// Fused compute round + fold launcher.\n1055\t// src_pq_size is the pre-fold buffer size (2*pq_size).\n1056\t// Post-fold: num_x = pq_size / 2 = src_pq_size / 4.\n1057\textern \"C\" int _frac_compute_round_and_fold(\n1058\t    const FpExt *eq_xi_low,\n1059\t    const FpExt *eq_xi_high,\n1060\t    const FracExt *src_pq_buffer,\n1061\t    FracExt *dst_pq_buffer,\n1062\t    size_t src_pq_size,           // Pre-fold size in FracExt\n1063\t    size_t eq_low_cap,\n1064\t    FpExt lambda,\n1065\t    FpExt r_prev,\n1066\t    FpExt *out,                   // Output: [d=2] final results\n1067\t    FpExt *tmp_block_sums         // Temporary buffer: [gridDim.x * d]\n1068\t) {\n1069\t    assert(src_pq_size > 2);\n1070\t    // Post-fold sizes\n1071\t    size_t pq_size = src_pq_size >> 1;\n1072\t    size_t num_x = pq_size >> 1;\n1073\t    assert(num_x > 0);\n1074\t\n1075\t    auto [grid, block] = frac_compute_round_launch_params(num_x);\n1076\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n1077\t\n1078\t    // Launch fused kernel - writes to tmp_block_sums and dst_pq_buffer\n1079\t    compute_round_and_fold_kernel<<<grid, block, shmem_bytes>>>(\n1080\t        eq_xi_low,\n1081\t        eq_xi_high,\n1082\t        src_pq_buffer,\n1083\t        (uint32_t)num_x,\n1084\t        __builtin_ctz((uint32_t)eq_low_cap),\n1085\t        lambda,\n1086\t        r_prev,\n1087\t        tmp_block_sums,\n1088\t        dst_pq_buffer\n1089\t    );\n1090\t    int err = CHECK_KERNEL();\n1091\t    if (err != 0)\n1092\t        return err;\n1093\t\n1094\t    // Launch final reduction kernel - reads from tmp_block_sums, writes to output.\n1095\t    return final_reduce_block_sums(tmp_block_sums, out, grid.x);\n1096\t}\n1097\t\n1098\t// Fused compute round + fold launcher (IN-PLACE version).\n1099\t// src_pq_size is the pre-fold buffer size (2*pq_size).\n1100\t// Post-fold: num_x = pq_size / 2 = src_pq_size / 4.\n1101\textern \"C\" int _frac_compute_round_and_fold_inplace(\n1102\t    const FpExt *eq_xi_low,\n1103\t    const FpExt *eq_xi_high,\n1104\t    FracExt *pq_buffer,           // In-place: reads src_pq_size, writes pq_size\n1105\t    size_t src_pq_size,           // Pre-fold size in FracExt\n1106\t    size_t eq_low_cap,\n1107\t    FpExt lambda,\n1108\t    FpExt r_prev,\n1109\t    FpExt *out,                   // Output: [d=2] final results\n1110\t    FpExt *tmp_block_sums         // Temporary buffer: [gridDim.x * d]\n1111\t) {\n1112\t    assert(src_pq_size > 2);\n1113\t    // Post-fold sizes\n1114\t    