{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T4ExWAc4vLbCnma1dBJaPQ","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    sync::Arc,\n15\t};\n16\t\n17\tuse itertools::{izip, Itertools};\n18\tuse openvm_cuda_common::{\n19\t    copy::{MemCopyD2H, MemCopyD2HStreamSync, MemCopyH2D},\n20\t    d_buffer::DeviceBuffer,\n21\t    error::MemCopyError,\n22\t    memory_manager::MemTracker,\n23\t    stream::current_stream_sync,\n24\t};\n25\tuse openvm_stark_backend::{\n26\t    air_builders::symbolic::SymbolicConstraints,\n27\t    calculate_n_logup,\n28\t    dft::Radix2BowersSerial,\n29\t    p3_matrix::dense::RowMajorMatrix,\n30\t    poly_common::{\n31\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n32\t        UnivariatePoly,\n33\t    },\n34\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n35\t    prover::{\n36\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n37\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n38\t        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n39\t    },\n40\t};\n41\tuse p3_dft::TwoAdicSubgroupDft;\n42\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n43\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n44\tuse rustc_hash::FxHashMap;\n45\tuse tracing::{debug, info, info_span, instrument};\n46\t\n47\tuse crate::{\n48\t    base::DeviceMatrix,\n49\t    cuda::{\n50\t        logup_zerocheck::{\n51\t            batched_interpolate_columns_gpu, fold_selectors_round0, InterpColDesc, MainMatrixPtrs,\n52\t        },\n53\t        sumcheck::batch_fold_mle,\n54\t    },\n55\t    data_transporter::transport_matrix_d2h_col_major,\n56\t    error::LogupZerocheckError,\n57\t    gpu_backend::GenericGpuBackend,\n58\t    hash_scheme::GpuHashScheme,\n59\t    logup_zerocheck::{\n60\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n61\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n62\t    },\n63\t    poly::EqEvalLayers,\n64\t    prelude::{EF, F},\n65\t    sponge::GpuFiatShamirTranscript,\n66\t    utils::compute_barycentric_inv_lagrange_denoms,\n67\t};\n68\t\n69\tpub(crate) mod batch_mle;\n70\tpub(crate) mod batch_mle_monomial;\n71\tmod errors;\n72\tpub(crate) mod fold_ple;\n73\t/// Fraction sumcheck via GKR\n74\tmod fractional;\n75\t/// Logup interaction evaluations for GKR input\n76\tmod gkr_input;\n77\tmod mle_round;\n78\tmod round0;\n79\tpub(crate) mod rules;\n80\t\n81\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n82\tuse batch_mle_monomial::{\n83\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n84\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n85\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n86\t};\n87\tpub use errors::*;\n88\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n89\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n90\tuse round0::evaluate_round0_constraints_gpu;\n91\t\n92\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n93\t/// More threads = more concurrent kernels but more peak GPU memory and more\n94\t/// MemoryManager mutex contention. 8 provides good SM utilization on the RTX 4090.\n95\tconst NUM_ROUND0_STREAMS: usize = 8;\n96\t\n97\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n98\t/// instead of the monomial kernel for high num_y traces.\n99\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n100\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n101\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n102\t\n103\t#[inline]\n104\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n105\t    if need_rot {\n106\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n107\t        (mat_width / 2) as u32\n108\t    } else {\n109\t        mat_width as u32\n110\t    }\n111\t}\n112\t\n113\t/// Result of processing one AIR in Round 0.\n114\tstruct Round0AirResult {\n115\t    trace_idx: usize,\n116\t    zerocheck_poly: Option<UnivariatePoly<EF>>,\n117\t    logup_numer_poly: Option<UnivariatePoly<EF>>,\n118\t    logup_denom_poly: Option<UnivariatePoly<EF>>,\n119\t}\n120\t\n121\t/// All read-only references needed to process one AIR in Round 0.\n122\tstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n123\t    trace_idx: usize,\n124\t    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n125\t    n: isize,\n126\t    selectors_cube: &'a DeviceMatrix<F>,\n127\t    public_values: &'a DeviceBuffer<F>,\n128\t    eq_3bs: &'a [EF],\n129\t    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n130\t    common_main: &'a DeviceMatrix<F>,\n131\t    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n132\t    d_lambda_pows: &'a DeviceBuffer<EF>,\n133\t    beta_pows: &'a [EF],\n134\t    l_skip: usize,\n135\t    constraint_degree: usize,\n136\t    xi: &'a [EF],\n137\t    max_temp_bytes: usize,\n138\t}\n139\t\n140\tfn process_air_round0<HS: GpuHashScheme>(\n141\t    w: &Round0AirWorkItem<HS>,\n142\t) -> Result<Round0AirResult, LogupZerocheckError> {\n143\t    let single_pk = w.single_pk;\n144\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n145\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n146\t    assert!(\n147\t        local_constraint_deg <= w.constraint_degree,\n148\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n149\t        w.constraint_degree\n150\t    );\n151\t\n152\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n153\t    let omega_root = F::two_adic_generator(log_large_domain);\n154\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n155\t\n156\t    let height = w.common_main.height();\n157\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n158\t    for committed in w.cached_mains {\n159\t        main_parts.push(committed.trace.buffer().as_ptr());\n160\t    }\n161\t    main_parts.push(w.common_main.buffer().as_ptr());\n162\t    let d_main_parts = main_parts.to_device()?;\n163\t\n164\t    let n_lift = w.n.max(0) as usize;\n165\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n166\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n167\t\n168\t    let sum_buffer = evaluate_round0_constraints_gpu(\n169\t        single_pk,\n170\t        w.selectors_cube.buffer(),\n171\t        &d_main_parts,\n172\t        w.public_values,\n173\t        eq_xi_tree.get_ptr(n_lift),\n174\t        w.d_lambda_pows,\n175\t        1 << w.l_skip,\n176\t        1 << n_lift,\n177\t        height as u32,\n178\t        num_cosets_zc as u32,\n179\t        omega_root,\n180\t        w.max_temp_bytes,\n181\t    )?;\n182\t\n183\t    let zerocheck_poly = if !sum_buffer.is_empty() {\n184\t        let q_evals = sum_buffer.to_host_on_current_stream()?;\n185\t        let q = {\n186\t            let mut values = EF::zero_vec(num_cosets_zc << w.l_skip);\n187\t            for coset_idx in 0..num_cosets_zc {\n188\t                for i in 0..1 << w.l_skip {\n189\t                    values[i * num_cosets_zc + coset_idx] = q_evals[(coset_idx << w.l_skip) + i];\n190\t                }\n191\t            }\n192\t            UnivariatePoly::from_geometric_cosets_evals_idft(\n193\t                RowMajorMatrix::new(values, num_cosets_zc),\n194\t                omega_root,\n195\t                omega_root,\n196\t            )\n197\t        };\n198\t        let sp_0_deg = sumcheck_round0_deg(w.l_skip, local_constraint_deg);\n199\t        let coeffs = (0..=sp_0_deg)\n200\t            .map(|i| {\n201\t                let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n202\t                if i >= 1 << w.l_skip {\n203\t                    c += q.coeffs()[i - (1 << w.l_skip)];\n204\t                }\n205\t                c\n206\t            })\n207\t            .collect_vec();\n208\t        Some(UnivariatePoly::new(coeffs))\n209\t    } else {\n210\t        None\n211\t    };\n212\t\n213\t    let num_cosets_logup = local_constraint_deg;\n214\t    let sum = evaluate_round0_interactions_gpu(\n215\t        single_pk,\n216\t        &single_air_constraints,\n217\t        w.selectors_cube.buffer(),\n218\t        &d_main_parts,\n219\t        w.public_values,\n220\t        eq_xi_tree.get_ptr(n_lift),\n221\t        w.beta_pows,\n222\t        w.eq_3bs,\n223\t        1 << w.l_skip,\n224\t        1 << n_lift,\n225\t        height as u32,\n226\t        num_cosets_logup as u32,\n227\t        omega_root,\n228\t        w.max_temp_bytes,\n229\t    )?;\n230\t\n231\t    let (logup_numer_poly, logup_denom_poly) = if !sum.is_empty() {\n232\t        let evals = sum.to_host_on_current_stream()?;\n233\t        let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n234\t            evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n235\t        if w.n.is_negative() {\n236\t            let norm_factor = F::from_u32(1 << w.n.unsigned_abs()).inverse();\n237\t            for s in &mut numer {\n238\t                *s *= norm_factor;\n239\t            }\n240\t        }\n241\t        let mut numer_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n242\t        let mut denom_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n243\t        for coset_idx in 0..num_cosets_logup {\n244\t            for i in 0..1 << w.l_skip {\n245\t                let src = (coset_idx << w.l_skip) + i;\n246\t                let dst = i * num_cosets_logup + coset_idx;\n247\t                numer_values[dst] = numer[src];\n248\t                denom_values[dst] = denom[src];\n249\t            }\n250\t        }\n251\t        let numer_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n252\t            RowMajorMatrix::new(numer_values, num_cosets_logup),\n253\t            omega_root,\n254\t            F::ONE,\n255\t        );\n256\t        let denom_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n257\t            RowMajorMatrix::new(denom_values, num_cosets_logup),\n258\t            omega_root,\n259\t            F::ONE,\n260\t        );\n261\t        (Some(numer_poly), Some(denom_poly))\n262\t    } else {\n263\t        (None, None)\n264\t    };\n265\t\n266\t    Ok(Round0AirResult {\n267\t        trace_idx: w.trace_idx,\n268\t        zerocheck_poly,\n269\t        logup_numer_poly,\n270\t        logup_denom_poly,\n271\t    })\n272\t}\n273\t\n274\t#[allow(clippy::type_complexity)]\n275\t#[instrument(level = \"info\", skip_all)]\n276\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n277\t    transcript: &mut TS,\n278\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n279\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n280\t    save_memory: bool,\n281\t    monomial_num_y_threshold: u32,\n282\t    sm_count: u32,\n283\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n284\twhere\n285\t    HS: GpuHashScheme,\n286\t    TS: GpuFiatShamirTranscript<HS::SC>,\n287\t{\n288\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n289\t    let l_skip = mpk.params.l_skip;\n290\t    let constraint_degree = mpk.max_constraint_degree;\n291\t    let num_traces = ctx.per_trace.len();\n292\t\n293\t    // Traces are sorted\n294\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n295\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n296\t    // heights\n297\t    let mut total_interactions = 0u64;\n298\t    let interactions_meta: Vec<_> = ctx\n299\t        .per_trace\n300\t        .iter()\n301\t        .map(|(air_idx, air_ctx)| {\n302\t            let pk = &mpk.per_air[*air_idx];\n303\t\n304\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n305\t            let height = air_ctx.common_main.height();\n306\t            let log_height = log2_strict_usize(height);\n307\t            let log_lifted_height = log_height.max(l_skip);\n308\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n309\t            (num_interactions, log_lifted_height)\n310\t        })\n311\t        .collect();\n312\t    // Implicitly, the width of this stacking should be 1\n313\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n314\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n315\t    // GKR\n316\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n317\t\n318\t    // Grind to increase soundness of random sampling for LogUp\n319\t    let logup_pow_witness = transcript\n320\t        .grind_gpu(mpk.params.logup.pow_bits)\n321\t        .map_err(LogupZerocheckError::Grind)?;\n322\t    let alpha_logup = transcript.sample_ext();\n323\t    let beta_logup = transcript.sample_ext();\n324\t    debug!(%alpha_logup, %beta_logup);\n325\t\n326\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();\n327\t    let mut prover = LogupZerocheckGpu::new(\n328\t        mpk,\n329\t        ctx,\n330\t        n_logup,\n331\t        interactions_layout,\n332\t        alpha_logup,\n333\t        beta_logup,\n334\t        save_memory,\n335\t        monomial_num_y_threshold,\n336\t        sm_count,\n337\t    )?;\n338\t    let n_global = prover.n_global;\n339\t\n340\t    let total_leaves = 1 << (l_skip + n_logup);\n341\t    prover\n342\t        .mem\n343\t        .emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n344\t    prover.mem.reset_peak();\n345\t    let (inputs, alpha) = if has_interactions {\n346\t        log_gkr_input_evals(\n347\t            &prover.trace_interactions,\n348\t            mpk,\n349\t            ctx,\n350\t            l_skip,\n351\t            alpha_logup,\n352\t            &prover.d_challenges,\n353\t            total_leaves,\n354\t        )?\n355\t    } else {\n356\t        (DeviceBuffer::new(), EF::ZERO)\n357\t    };\n358\t    // Set memory limit for batch MLE based on inputs buffer size\n359\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n360\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n361\t    if !prover.save_memory {\n362\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n363\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n364\t            tracing::warn!(\n365\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n366\t                prover.memory_limit_bytes\n367\t            );\n368\t        }\n369\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n370\t    }\n371\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n372\t\n373\t    let (frac_sum_proof, mut xi) =\n374\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n375\t    while xi.len() != l_skip + n_global {\n376\t        xi.push(transcript.sample_ext());\n377\t    }\n378\t    debug!(?xi);\n379\t    prover.xi = xi;\n380\t\n381\t    logup_gkr_span.exit();\n382\t\n383\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does\n384\t    // not include the kernel times for the actual folding\n385\t    let round0_span = info_span!(\"prover.rap_constraints.round0\", phase = \"prover\").entered();\n386\t    // begin batch sumcheck\n387\t    let mut sumcheck_round_polys = Vec::with_capacity(n_max);\n388\t    let mut r = Vec::with_capacity(n_max + 1);\n389\t    // batching randomness\n390\t    let lambda = transcript.sample_ext();\n391\t    debug!(%lambda);\n392\t\n393\t    let sp_0_polys = prover.sumcheck_uni_round0_polys(ctx, lambda)?;\n394\t    let s_0_cpu_span = info_span!(\"s'_0 -> s_0 cpu interpolations\").entered();\n395\t    let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_degree);\n396\t    let s_deg = constraint_degree + 1;\n397\t    let s_0_deg = sumcheck_round0_deg(l_skip, s_deg);\n398\t    let large_uni_domain = (s_0_deg + 1).next_power_of_two();\n399\t    let dft = Radix2BowersSerial;\n400\t    let s_0_logup_polys = {\n401\t        let eq_sharp_uni = eq_sharp_uni_poly(&prover.xi[..l_skip]);\n402\t        let mut eq_coeffs = eq_sharp_uni.into_coeffs();\n403\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n404\t        let eq_evals = dft.dft(eq_coeffs);\n405\t\n406\t        let width = 2 * num_traces;\n407\t        let mut sp_coeffs_mat = EF::zero_vec(width * large_uni_domain);\n408\t        for (i, coeffs) in sp_0_polys[..2 * num_traces].iter().enumerate() {\n409\t            for (j, &c_j) in coeffs.coeffs().iter().enumerate().take(sp_0_deg + 1) {\n410\t                // SAFETY:\n411\t                // - coeffs length is <= sp_0_deg + 1 <= s_0_deg < large_uni_domain\n412\t                // - sp_coeffs_mat allocated for width\n413\t                unsafe {\n414\t                    *sp_coeffs_mat.get_unchecked_mut(j * width + i) = c_j;\n415\t                }\n416\t            }\n417\t        }\n418\t        let mut s_evals = dft.dft_batch(RowMajorMatrix::new(sp_coeffs_mat, width));\n419\t        for (eq, row) in zip(eq_evals, s_evals.values.chunks_mut(width)) {\n420\t            for x in row {\n421\t                *x *= eq;\n422\t            }\n423\t        }\n424\t        dft.idft_batch(s_evals)\n425\t    };\n426\t    let skip_domain_size = F::from_usize(1 << l_skip);\n427\t    // logup sum claims (sum_{\\hat p}, sum_{\\hat q}) per present AIR\n428\t    let (numerator_term_per_air, denominator_term_per_air): (Vec<_>, Vec<_>) = (0..num_traces)\n429\t        .map(|trace_idx| {\n430\t            let [sum_claim_p, sum_claim_q] = [0, 1].map(|is_denom| {\n431\t                // Compute sum over D of s_0(Z) to get the sum claim\n432\t                (0..=s_0_deg)\n433\t                    .step_by(1 << l_skip)\n434\t                    .map(|j| unsafe {\n435\t                        // SAFETY: matrix is 2 * num_trace x large_uni_domain, s_0_deg <\n436\t                        // large_uni_domain\n437\t                        *s_0_logup_polys\n438\t                            .values\n439\t                            .get_unchecked(j * 2 * num_traces + 2 * trace_idx + is_denom)\n440\t                    })\n441\t                    .sum::<EF>()\n442\t                    * skip_domain_size\n443\t            });\n444\t            transcript.observe_ext(sum_claim_p);\n445\t            transcript.observe_ext(sum_claim_q);\n446\t\n447\t            (sum_claim_p, sum_claim_q)\n448\t        })\n449\t        .unzip();\n450\t\n451\t    let mu = transcript.sample_ext();\n452\t    debug!(%mu);\n453\t    let mu_pows = mu.powers().take(3 * num_traces).collect_vec();\n454\t\n455\t    let s_0_zc_poly = {\n456\t        let eq_uni = eq_uni_poly::<F, _>(l_skip, prover.xi[0]);\n457\t        let mut eq_coeffs = eq_uni.into_coeffs();\n458\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n459\t        let eq_evals = dft.dft(eq_coeffs);\n460\t\n461\t        // Algebraically batch\n462\t        let mut sp_coeffs = EF::zero_vec(large_uni_domain);\n463\t        let mus = &mu_pows[2 * num_traces..];\n464\t        let polys = &sp_0_polys[2 * num_traces..];\n465\t        for (j, batch_coeff) in sp_coeffs.iter_mut().enumerate().take(sp_0_deg + 1) {\n466\t            for (&mu, poly) in zip(mus, polys) {\n467\t                *batch_coeff += mu * *poly.coeffs().get(j).unwrap_or(&EF::ZERO);\n468\t            }\n469\t        }\n470\t        let mut s_evals = dft.dft(sp_coeffs);\n471\t        for (eq, x) in zip(eq_evals, &mut s_evals) {\n472\t            *x *= eq;\n473\t        }\n474\t        dft.idft(s_evals)\n475\t    };\n476\t\n477\t    // Algebraically batch\n478\t    let s_0_poly = UnivariatePoly::new(\n479\t        zip(\n480\t            s_0_logup_polys.values.chunks_exact(2 * num_traces),\n481\t            s_0_zc_poly,\n482\t        )\n483\t        .take(s_0_deg + 1)\n484\t        .map(|(logup_row, batched_zc)| {\n485\t            let coeff = batched_zc\n486\t                + zip(&mu_pows, logup_row)\n487\t                    .map(|(&mu_j, &x)| mu_j * x)\n488\t                    .sum::<EF>();\n489\t            transcript.observe_ext(coeff);\n490\t            coeff\n491\t        })\n492\t        .collect(),\n493\t    );\n494\t    drop(s_0_cpu_span);\n495\t\n496\t    let r_0 = transcript.sample_ext();\n497\t    r.push(r_0);\n498\t    debug!(round = 0, r_round = %r_0);\n499\t    prover.prev_s_eval = s_0_poly.eval_at_point(r_0);\n500\t    debug!(\"s_0(r_0) = {}\", prover.prev_s_eval);"}]},"parent_tool_use_id":"toolu_01Dow5kdnwTUnFPtgNBsBTfw","session_id":"8752a685-980c-4a43-bd75-41a76d7996d5","uuid":"3b4d2bfe-d8e5-4113-bd12-ebcfe840713c","timestamp":"2026-04-13T18:37:11.638Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011ckFsJ4Sv3viHj2g2K5qQ6","type":"tool_result","content":"500\t    debug!(\"s_0(r_0) = {}\", prover.prev_s_eval);\n501\t\n502\t    prover.fold_ple_evals(ctx, r_0)?;\n503\t    drop(round0_span);\n504\t\n505\t    // Sumcheck rounds:\n506\t    // - each round the prover needs to compute univariate polynomial `s_round`. This poly is linear\n507\t    //   since we are taking MLE of `evals`.\n508\t    // - at end of each round, sample random `r_round` in `EF`\n509\t    //\n510\t    // `s_round` is degree `s_deg` so we evaluate it at `0, ..., =s_deg`. The prover skips\n511\t    // evaluation at `0` because the verifier can infer it from the previous round's\n512\t    // `s_{round-1}(r)` claim. The degree is constraint_degree + 1, where + 1 is from eq term\n513\t    let mle_rounds_span =\n514\t        info_span!(\"prover.rap_constraints.mle_rounds\", phase = \"prover\").entered();\n515\t    debug!(%s_deg);\n516\t    for round in 1..=n_max {\n517\t        let sp_round_evals = prover.sumcheck_polys_batch_eval(round, r[round - 1])?;\n518\t        let batch_s = prover.compute_batch_s_poly(sp_round_evals, num_traces, round, &mu_pows);\n519\t        let batch_s_evals = (1..=s_deg)\n520\t            .map(|i| batch_s.eval_at_point(EF::from_usize(i)))\n521\t            .collect_vec();\n522\t        for &eval in &batch_s_evals {\n523\t            transcript.observe_ext(eval);\n524\t        }\n525\t        sumcheck_round_polys.push(batch_s_evals);\n526\t\n527\t        let r_round = transcript.sample_ext();\n528\t        debug!(%round, %r_round);\n529\t        r.push(r_round);\n530\t        prover.prev_s_eval = batch_s.eval_at_point(r_round);\n531\t\n532\t        prover.fold_mle_evals(round, r_round)?;\n533\t    }\n534\t    assert_eq!(r.len(), n_max + 1);\n535\t\n536\t    let column_openings = prover.into_column_openings()?;\n537\t\n538\t    let need_rot_per_trace = ctx\n539\t        .per_trace\n540\t        .iter()\n541\t        .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n542\t        .collect::<Vec<_>>();\n543\t    // Observe common main openings first, and then preprocessed/cached\n544\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n545\t        for (claim, claim_rot) in column_openings_by_rot(&openings[0], *need_rot) {\n546\t            transcript.observe_ext(claim);\n547\t            transcript.observe_ext(claim_rot);\n548\t        }\n549\t    }\n550\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n551\t        for part in openings.iter().skip(1) {\n552\t            for (claim, claim_rot) in column_openings_by_rot(part, *need_rot) {\n553\t                transcript.observe_ext(claim);\n554\t                transcript.observe_ext(claim_rot);\n555\t            }\n556\t        }\n557\t    }\n558\t    drop(mle_rounds_span);\n559\t\n560\t    let batch_constraint_proof = BatchConstraintProof {\n561\t        numerator_term_per_air,\n562\t        denominator_term_per_air,\n563\t        univariate_round_coeffs: s_0_poly.into_coeffs(),\n564\t        sumcheck_round_polys,\n565\t        column_openings,\n566\t    };\n567\t    let gkr_proof = GkrProof {\n568\t        logup_pow_witness,\n569\t        q0_claim: frac_sum_proof.fractional_sum.1,\n570\t        claims_per_layer: frac_sum_proof.claims_per_layer,\n571\t        sumcheck_polys: frac_sum_proof.sumcheck_polys,\n572\t    };\n573\t    Ok((gkr_proof, batch_constraint_proof, r))\n574\t}\n575\t\n576\tpub struct LogupZerocheckGpu<'a, HS: GpuHashScheme> {\n577\t    pub alpha_logup: EF,\n578\t    pub beta_pows: Vec<EF>,\n579\t    // [alpha, beta^0, beta^1, .., beta^max_interaction_len]\n580\t    pub d_challenges: DeviceBuffer<EF>,\n581\t\n582\t    pub l_skip: usize,\n583\t    n_logup: usize,\n584\t    n_global: usize,\n585\t\n586\t    pub omega_skip: F,\n587\t    pub omega_skip_pows: Vec<F>,\n588\t    d_omega_skip_pows: DeviceBuffer<F>,\n589\t\n590\t    pub interactions_layout: StackedLayout,\n591\t    pub constraint_degree: usize,\n592\t    n_per_trace: Vec<isize>,\n593\t    max_num_constraints: usize,\n594\t    pub monomial_num_y_threshold: u32,\n595\t    sm_count: u32,\n596\t    // Available after GKR:\n597\t    pub xi: Vec<EF>,\n598\t    pub lambda_pows: Option<DeviceBuffer<EF>>,\n599\t    /// Precomputed lambda combinations per AIR (indexed by air_idx). Set when lambda is sampled.\n600\t    lambda_combinations: Vec<Option<DeviceBuffer<EF>>>,\n601\t    /// Beta powers on device for logup MLE rounds.\n602\t    d_beta_pows: DeviceBuffer<EF>,\n603\t    /// Precomputed logup combinations per trace (indexed by trace_idx). Set when xi is sampled.\n604\t    logup_combinations: Vec<Option<LogupCombinations>>,\n605\t\n606\t    // n_T => segment tree of eq(xi[j..1+n_T]) for j=1..={n_T-round+1} in _reverse_ layout\n607\t    eq_xis: FxHashMap<usize, EqEvalLayers<EF>>,\n608\t    eq_3b_per_trace: Vec<Vec<EF>>,\n609\t    d_eq_3b_per_trace: Vec<DeviceBuffer<EF>>,\n610\t    // Evaluations on hypercube only, for round 0\n611\t    sels_per_trace_base: Vec<DeviceMatrix<F>>,\n612\t    // After univariate round 0:\n613\t    mat_evals_per_trace: Vec<Vec<DeviceMatrix<EF>>>,\n614\t    sels_per_trace: Vec<DeviceMatrix<EF>>,\n615\t    // Store public_values per trace (similar to CPU's EvalHelper)\n616\t    public_values_per_trace: Vec<DeviceBuffer<F>>,\n617\t    air_indices_per_trace: Vec<usize>,\n618\t    zerocheck_tilde_evals: Vec<EF>,\n619\t    logup_tilde_evals: Vec<[EF; 2]>,\n620\t    needs_next_per_trace: Vec<bool>,\n621\t\n622\t    trace_interactions: Vec<Option<TraceInteractionMeta>>,\n623\t    // round0: Round0Buffers,\n624\t    pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n625\t\n626\t    // In round `j`, contains `s_{j-1}(r_{j-1})`\n627\t    pub(crate) prev_s_eval: EF,\n628\t    pub(crate) eq_ns: Vec<EF>,\n629\t    pub(crate) eq_sharp_ns: Vec<EF>,\n630\t\n631\t    mem: MemTracker,\n632\t    save_memory: bool,\n633\t\n634\t    gkr_mem_contribution: usize,\n635\t    /// Memory limit for batch MLE intermediate buffers (set after GKR input eval)\n636\t    memory_limit_bytes: usize,\n637\t}\n638\t\n639\timpl<'a, HS: GpuHashScheme> LogupZerocheckGpu<'a, HS> {\n640\t    #[allow(clippy::too_many_arguments)]\n641\t    fn new(\n642\t        pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n643\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n644\t        n_logup: usize,\n645\t        interactions_layout: StackedLayout,\n646\t        alpha_logup: EF,\n647\t        beta_logup: EF,\n648\t        save_memory: bool,\n649\t        monomial_num_y_threshold: u32,\n650\t        sm_count: u32,\n651\t    ) -> Result<Self, LogupZerocheckError> {\n652\t        let mem = MemTracker::start(\"prover.logup_zerocheck_prover\");\n653\t        let l_skip = pk.params.l_skip;\n654\t        let omega_skip = F::two_adic_generator(l_skip);\n655\t        let omega_skip_pows = omega_skip.powers().take(1 << l_skip).collect_vec();\n656\t        let d_omega_skip_pows = omega_skip_pows.to_device()?;\n657\t        let num_airs_present = ctx.per_trace.len();\n658\t\n659\t        let constraint_degree = pk.max_constraint_degree;\n660\t\n661\t        let max_interaction_length = pk\n662\t            .per_air\n663\t            .iter()\n664\t            .map(|air_pk| air_pk.other_data.interaction_rules.max_fields_len)\n665\t            .max()\n666\t            .unwrap_or(0);\n667\t        let beta_pows = beta_logup\n668\t            .powers()\n669\t            .take(max_interaction_length + 1)\n670\t            .collect_vec();\n671\t        let challenges = [&[alpha_logup], &beta_pows[..]].concat();\n672\t        let d_challenges = challenges.to_device()?;\n673\t        let d_beta_pows = beta_pows.to_device()?;\n674\t\n675\t        let n_per_trace: Vec<isize> = ctx\n676\t            .common_main_traces()\n677\t            .map(|(_, t)| log2_strict_usize(t.height()) as isize - l_skip as isize)\n678\t            .collect();\n679\t        let n_max = n_per_trace[0].max(0) as usize;\n680\t        let n_global = max(n_max, n_logup);\n681\t        info!(%n_global, %n_logup);\n682\t\n683\t        let max_num_constraints = pk\n684\t            .per_air\n685\t            .iter()\n686\t            .map(|air_pk| {\n687\t                air_pk\n688\t                    .vk\n689\t                    .symbolic_constraints\n690\t                    .constraints\n691\t                    .constraint_idx\n692\t                    .len()\n693\t            })\n694\t            .max()\n695\t            .unwrap_or(0);\n696\t\n697\t        // Collect interaction metadata for GPU execution (evaluations still run on CPU for now).\n698\t        let trace_interactions = collect_trace_interactions(pk, ctx, &interactions_layout);\n699\t\n700\t        let needs_next_per_trace = ctx\n701\t            .per_trace\n702\t            .iter()\n703\t            .map(|(air_idx, _)| pk.per_air[*air_idx].vk.params.need_rot)\n704\t            .collect::<Vec<_>>();\n705\t\n706\t        Ok(Self {\n707\t            alpha_logup,\n708\t            beta_pows,\n709\t            d_challenges,\n710\t            l_skip,\n711\t            n_logup,\n712\t            n_global,\n713\t            omega_skip,\n714\t            omega_skip_pows,\n715\t            d_omega_skip_pows,\n716\t            interactions_layout,\n717\t            constraint_degree,\n718\t            n_per_trace,\n719\t            max_num_constraints,\n720\t            sm_count,\n721\t            xi: vec![],\n722\t            lambda_pows: None,\n723\t            lambda_combinations: (0..pk.per_air.len()).map(|_| None).collect(),\n724\t            d_beta_pows,\n725\t            logup_combinations: (0..num_airs_present).map(|_| None).collect(),\n726\t            eq_xis: FxHashMap::default(),\n727\t            eq_3b_per_trace: vec![],\n728\t            d_eq_3b_per_trace: vec![],\n729\t            sels_per_trace_base: vec![],\n730\t            mat_evals_per_trace: vec![],\n731\t            sels_per_trace: vec![],\n732\t            public_values_per_trace: ctx\n733\t                .per_trace\n734\t                .iter()\n735\t                .map(|(_, air_ctx)| {\n736\t                    if air_ctx.public_values.is_empty() {\n737\t                        Ok(DeviceBuffer::new())\n738\t                    } else {\n739\t                        air_ctx.public_values.to_device()\n740\t                    }\n741\t                })\n742\t                .collect::<Result<Vec<_>, _>>()?,\n743\t            air_indices_per_trace: ctx\n744\t                .per_trace\n745\t                .iter()\n746\t                .map(|(air_idx, _)| *air_idx)\n747\t                .collect_vec(),\n748\t            zerocheck_tilde_evals: vec![EF::ZERO; num_airs_present],\n749\t            logup_tilde_evals: vec![[EF::ZERO; 2]; num_airs_present],\n750\t            needs_next_per_trace,\n751\t            trace_interactions,\n752\t            pk,\n753\t            prev_s_eval: EF::ZERO,\n754\t            eq_ns: Vec::with_capacity(n_max + 1),\n755\t            eq_sharp_ns: Vec::with_capacity(n_max + 1),\n756\t            mem,\n757\t            save_memory,\n758\t            gkr_mem_contribution: 0,\n759\t            memory_limit_bytes: 0, // Set after GKR input eval\n760\t            monomial_num_y_threshold,\n761\t        })\n762\t    }\n763\t\n764\t    // PERF[jpw]: we could return evals and batch zerocheck poly by degree before interpolating.\n765\t    // Cannot do it for logup because we need to calculate the sum claims.\n766\t    #[instrument(name = \"prover.rap_constraints.ple_round0\", level = \"info\", skip_all)]\n767\t    fn sumcheck_uni_round0_polys(\n768\t        &mut self,\n769\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n770\t        lambda: EF,\n771\t    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n772\t        self.mem\n773\t            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n774\t        self.mem.reset_peak();\n775\t        let n_logup = self.n_logup;\n776\t        let l_skip = self.l_skip;\n777\t        let xi = &self.xi;\n778\t        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n779\t        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n780\t            h_lambda_pows.to_device()?\n781\t        } else {\n782\t            DeviceBuffer::new()\n783\t        });\n784\t        // Precompute lambda combinations for all AIRs with monomials\n785\t        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n786\t        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n787\t            if air_pk.other_data.zerocheck_monomials.is_some() {\n788\t                self.lambda_combinations[air_idx] = Some(\n789\t                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n790\t                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n791\t                );\n792\t            }\n793\t        }\n794\t        let num_present_airs = ctx.per_trace.len();\n795\t        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n796\t\n797\t        self.eq_3b_per_trace = ctx\n798\t            .per_trace\n799\t            .iter()\n800\t            .enumerate()\n801\t            .map(|(trace_idx, (air_idx, _))| {\n802\t                let vk = &self.pk.per_air[*air_idx].vk;\n803\t                let num_interactions = vk.num_interactions();\n804\t                if num_interactions > 0 {\n805\t                    let n = self.n_per_trace[trace_idx];\n806\t                    let n_lift = n.max(0) as usize;\n807\t                    let mut b_vec = vec![F::ZERO; n_logup - n_lift];\n808\t                    let mut weights = Vec::with_capacity(num_interactions);\n809\t                    for interaction_idx in 0..num_interactions {\n810\t                        let stacked_idx = self\n811\t                            .interactions_layout\n812\t                            .get(trace_idx, interaction_idx)\n813\t                            .unwrap()\n814\t                            .row_idx;\n815\t                        let mut b_int = stacked_idx >> (l_skip + n_lift);\n816\t                        for bit in &mut b_vec {\n817\t                            *bit = F::from_bool(b_int & 1 == 1);\n818\t                            b_int >>= 1;\n819\t                        }\n820\t                        let weight =\n821\t                            eval_eq_mle(&self.xi[l_skip + n_lift..l_skip + n_logup], &b_vec);\n822\t                        weights.push(weight);\n823\t                    }\n824\t                    weights\n825\t                } else {\n826\t                    vec![]\n827\t                }\n828\t            })\n829\t            .collect_vec();\n830\t        self.d_eq_3b_per_trace = self\n831\t            .eq_3b_per_trace\n832\t            .iter()\n833\t            .map(|eq_3bs| {\n834\t                if eq_3bs.is_empty() {\n835\t                    Ok(DeviceBuffer::new())\n836\t                } else {\n837\t                    eq_3bs.to_device()\n838\t                }\n839\t            })\n840\t            .collect::<Result<Vec<_>, _>>()?;\n841\t\n842\t        // Precompute logup combinations for all traces with interaction monomials\n843\t        for (trace_idx, (air_idx, _)) in ctx.per_trace.iter().enumerate() {\n844\t            let air_pk = &self.pk.per_air[*air_idx];\n845\t            if air_pk.other_data.interaction_monomials.is_some()\n846\t                && !self.eq_3b_per_trace[trace_idx].is_empty()\n847\t            {\n848\t                self.logup_combinations[trace_idx] = Some(\n849\t                    compute_logup_combinations(\n850\t                        self.pk,\n851\t                        *air_idx,\n852\t                        &self.d_beta_pows,\n853\t                        &self.d_eq_3b_per_trace[trace_idx],\n854\t                        &self.eq_3b_per_trace[trace_idx],\n855\t                        &self.beta_pows,\n856\t                    )\n857\t                    .map_err(LogupZerocheckError::LogupCombinations)?,\n858\t                );\n859\t            }\n860\t        }\n861\t\n862\t        // PERF[jpw]: we could also build the layers for different n in a transposed way using\n863\t        // eq_nonoverlapping_stage_ext, which is more memory efficient\n864\t        for &n in &self.n_per_trace {\n865\t            let n_lift = n.max(0) as usize;\n866\t            if let Entry::Vacant(entry) = self.eq_xis.entry(n_lift) {\n867\t                let layers =\n868\t                    EqEvalLayers::new_rev(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n869\t                        .map_err(LogupZerocheckError::EqEvalLayers)?;\n870\t                entry.insert(layers);\n871\t            }\n872\t        }\n873\t\n874\t        self.sels_per_trace_base = self\n875\t            .n_per_trace\n876\t            .iter()\n877\t            .map(|&n| {\n878\t                let n_lift = n.max(0) as usize;\n879\t                let height = 1 << n_lift;\n880\t                let mut cols = F::zero_vec(3 * height);\n881\t                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n882\t                cols[0] = F::ONE; // is_first\n883\t                cols[2 * height + height - 1] = F::ONE; // is_last\n884\t                let d_cols = cols.to_device()?;\n885\t                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n886\t            })\n887\t            .collect::<Result<Vec<_>, MemCopyError>>()?;\n888\t\n889\t        let selectors_base = self.sels_per_trace_base.clone();\n890\t\n891\t        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n892\t        // present AIR\n893\t        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n894\t        let d_lambda_pows = self\n895\t            .lambda_pows\n896\t            .as_ref()\n897\t            .expect(\"lambda powers must be set before round-0 evaluation\");\n898\t\n899\t        // Phase 1: Build work items (main thread, pure CPU)\n900\t        let per_thread_temp_bytes = self.memory_limit_bytes / NUM_ROUND0_STREAMS.max(1);\n901\t        let mut work_items: Vec<Round0AirWorkItem<HS>> = izip!(\n902\t            &ctx.per_trace,\n903\t            &self.n_per_trace,\n904\t            &selectors_base,\n905\t            &self.public_values_per_trace,\n906\t            &self.eq_3b_per_trace,\n907\t        )\n908\t        .enumerate()\n909\t        .map(|(trace_idx, ((air_idx, air_ctx), &n, sel, pv, eq3b))| Round0AirWorkItem {\n910\t            trace_idx,\n911\t            single_pk: &self.pk.per_air[*air_idx],\n912\t            n,\n913\t            selectors_cube: sel,\n914\t            public_values: pv,\n915\t            eq_3bs: eq3b,\n916\t            cached_mains: &air_ctx.cached_mains,\n917\t            common_main: &air_ctx.common_main,\n918\t            eq_xis: &self.eq_xis,\n919\t            d_lambda_pows,\n920\t            beta_pows: &self.beta_pows,\n921\t            l_skip,\n922\t            constraint_degree: self.constraint_degree,\n923\t            xi: &self.xi,\n924\t            max_temp_bytes: per_thread_temp_bytes,\n925\t        })\n926\t        .collect();\n927\t\n928\t        // Sort by descending height for better load balance across thread chunks.\n929\t        work_items.sort_by(|a, b| b.common_main.height().cmp(&a.common_main.height()));\n930\t\n931\t        // Barrier: ensure all prior GPU work (trace uploads, pk data, selectors)\n932\t        // is visible to worker thread streams.\n933\t        current_stream_sync().map_err(MemCopyError::from)?;\n934\t\n935\t        // Phase 2: Process AIRs in parallel across N OS threads.\n936\t        // Only use multi-threading when there are enough AIRs to benefit from concurrent\n937\t        // kernel execution. With few large AIRs (e.g., APC 0 has ~20 per segment), each\n938\t        // kernel already saturates the GPU and multi-threading adds memory pool overhead.\n939\t        let num_threads = if work_items.len() >= 100 {\n940\t            NUM_ROUND0_STREAMS.min(work_items.len())\n941\t        } else {\n942\t            1\n943\t        };\n944\t        let results: Vec<Round0AirResult> = if num_threads <= 1 {\n945\t            work_items\n946\t                .iter()\n947\t                .map(|w| process_air_round0(w))\n948\t                .collect::<Result<Vec<_>, _>>()?\n949\t        } else {\n950\t            // Interleaved (round-robin) assignment on the height-sorted list.\n951\t            // Work items are already sorted by descending height. Round-robin\n952\t            // distributes them so each thread gets a balanced mix of large and\n953\t            // small AIRs (thread 0 gets items 0, N, 2N, ...; thread 1 gets\n954\t            // items 1, N+1, 2N+1, ...). This balances both per-AIR fixed\n955\t            // overhead (kernel launches, D2H copies) and height-proportional\n956\t            // GPU kernel time without needing a calibrated cost model.\n957\t            let mut thread_items: Vec<Vec<usize>> =\n958\t                (0..num_threads).map(|_| Vec::new()).collect();\n959\t            for (item_idx, _) in work_items.iter().enumerate() {\n960\t                thread_items[item_idx % num_threads].push(item_idx);\n961\t            }\n962\t\n963\t            std::thread::scope(|s| {\n964\t                let handles: Vec<_> = thread_items\n965\t                    .into_iter()\n966\t                    .enumerate()\n967\t                    .map(|(thread_id, indices)| {\n968\t                        let items = &work_items;\n969\t                        s.spawn(move || -> Result<Vec<Round0AirResult>, LogupZerocheckError> {\n970\t                            let t0 = std::time::Instant::now();\n971\t                            let results: Vec<_> = indices\n972\t                                .iter