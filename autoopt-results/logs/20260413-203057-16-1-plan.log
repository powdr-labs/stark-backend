d","autoopt-results/2026-04-13-2300-batch-mle-round-kernels/report.md","autoopt-results/2026-04-13-prealloc-round0-buffers/report.md","autoopt-results/2026-04-13-1100-batch-mle-interpolation/report.md","autoopt-results/2026-04-13-1430-batch-mle-main-ptrs-upload/report.md","autoopt-results/2026-04-13-1600-batch-round0-descriptor-arrays/report.md","autoopt-results/2026-04-13-1700-batch-round0-caller-routing/report.md","autoopt-results/2026-04-13-1930-round0-interleaved-work-balance/report.md"],"durationMs":13,"numFiles":15,"truncated":false}}
