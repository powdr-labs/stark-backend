{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EHWFUx5Mhg1n8dpZxeEukc","type":"tool_result","content":"780\t// Fold w rounds at once using precomputed eq_r_window.\n781\t// One thread computes both poly outputs for a single tail index.\n782\ttemplate <uint32_t W>\n783\t__global__ void multifold_kernel(\n784\t    const FracExt *src,\n785\t    FracExt *dst,\n786\t    uint32_t tail_size,\n787\t    const FpExt *__restrict__ eq_r_window\n788\t) {\n789\t    constexpr uint32_t beta_size = 1u << W;\n790\t    uint32_t out_idx = blockIdx.x * blockDim.x + threadIdx.x;\n791\t    if (out_idx >= tail_size) {\n792\t        return;\n793\t    }\n794\t\n795\t    FpExt zero(Fp::zero());\n796\t    FpExt acc0_p = zero;\n797\t    FpExt acc0_q = zero;\n798\t    FpExt acc1_p = zero;\n799\t    FpExt acc1_q = zero;\n800\t    const FracExt *src_1 = src + ((size_t)tail_size << W);\n801\t    for (uint32_t beta = 0; beta < beta_size; ++beta) {\n802\t        uint32_t idx = beta * tail_size + out_idx;\n803\t        FracExt v0 = src[idx];\n804\t        FracExt v1 = src_1[idx];\n805\t        FpExt eq_r = eq_r_window[beta];\n806\t        acc0_p += eq_r * v0.p;\n807\t        acc0_q += eq_r * v0.q;\n808\t        acc1_p += eq_r * v1.p;\n809\t        acc1_q += eq_r * v1.q;\n810\t    }\n811\t    dst[out_idx] = {acc0_p, acc0_q};\n812\t    dst[tail_size + out_idx] = {acc1_p, acc1_q};\n813\t}\n814\t\n815\t__global__ void add_alpha_kernel(FracExt *data, size_t len, FpExt alpha) {\n816\t    size_t idx = blockIdx.x * blockDim.x + threadIdx.x;\n817\t    if (idx < len) {\n818\t        data[idx].q = data[idx].q + alpha;\n819\t    }\n820\t}\n821\t\n822\ttemplate <typename F, typename EF>\n823\t__global__ void frac_vector_scalar_multiply_kernel(\n824\t    std::pair<EF, EF> *frac_vec,\n825\t    F scalar,\n826\t    uint32_t length\n827\t) {\n828\t    size_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n829\t    if (tidx >= length)\n830\t        return;\n831\t\n832\t    frac_vec[tidx].first *= scalar;\n833\t}\n834\t\n835\t// Fused two-layer tree build kernel.\n836\t// Applies two consecutive frac_add tree layers in one pass, keeping intermediate\n837\t// right-half nodes for later revert operations.\n838\t//\n839\t// For fused layers i and i+1 with half_i = N >> (i+1) and half_i1 = N >> (i+2):\n840\t//   Thread j in [0, half_i1) reads:\n841\t//     A = layer[j],                  B = layer[j + half_i1],\n842\t//     C = layer[j + half_i],         D = layer[j + half_i + half_i1]\n843\t//   Computes:\n844\t//     lhs = frac_add(A, C)            (layer i result at j, kept in register)\n845\t//     rhs = frac_add(B, D)            (layer i result at j + half_i1)\n846\t//     result = frac_add(lhs, rhs)     (layer i+1 result at j)\n847\t//   Writes:\n848\t//     layer[j]         = result        (layer i+1 output)\n849\t//     layer[j+half_i1] = rhs           (layer i intermediate, needed for revert of layer i+1)\n850\t//   C and D remain untouched (already in correct place for revert of layer i).\n851\t//\n852\t// Memory traffic vs two separate frac_build_tree_layer calls:\n853\t//   Non-fused: 4 reads + 2 writes (layer i) + 2 reads + 1 write (layer i+1) = 6R+3W per group\n854\t//   Fused:     4 reads + 2 writes per group\n855\t//   Savings:   2 reads + 1 write = ~33% reduction in global memory traffic.\n856\t__global__ void frac_build_tree_two_layers_kernel(\n857\t    FracExt *__restrict__ layer,\n858\t    uint32_t half_i1   // = N >> (i+2), where i is the first of the two layers\n859\t) {\n860\t    uint32_t j = blockIdx.x * blockDim.x + threadIdx.x;\n861\t    if (j >= half_i1) return;\n862\t\n863\t    uint32_t half_i = half_i1 << 1;   // = N >> (i+1)\n864\t\n865\t    FracExt A = layer[j];\n866\t    FracExt B = layer[j + half_i1];\n867\t    FracExt C = layer[j + half_i];\n868\t    FracExt D = layer[j + half_i + half_i1];\n869\t\n870\t    // Layer i: combine A with C and B with D (kept in registers)\n871\t    FracExt lhs = frac_add(A, C);\n872\t    FracExt rhs = frac_add(B, D);\n873\t    // Layer i+1: combine the two layer-i results\n874\t    FracExt result = frac_add(lhs, rhs);\n875\t\n876\t    layer[j]         = result;\n877\t    layer[j + half_i1] = rhs;   // Needed for revert of layer i+1\n878\t    // layer[j + half_i] = C  (unchanged, needed for revert of layer i)\n879\t    // layer[j + half_i + half_i1] = D  (unchanged, needed for revert of layer i)\n880\t}\n881\t\n882\t// ============================================================================\n883\t// LAUNCHERS\n884\t// ============================================================================\n885\ttemplate <bool revert, bool apply_alpha>\n886\tint launch_frac_build_tree_layer(FracExt *layer, size_t layer_size, FpExt alpha) {\n887\t    auto [grid, block] = kernel_launch_params(layer_size);\n888\t    frac_build_tree_layer_kernel<revert, apply_alpha><<<grid, block>>>(layer, layer_size, alpha);\n889\t    return CHECK_KERNEL();\n890\t}\n891\t\n892\textern \"C\" int _frac_build_tree_layer(\n893\t    FracExt *layer,\n894\t    size_t layer_size,\n895\t    bool revert,\n896\t    FpExt alpha,\n897\t    bool apply_alpha\n898\t) {\n899\t    if (layer_size == 0) {\n900\t        return 0;\n901\t    }\n902\t    assert(layer_size % 2 == 0);\n903\t    layer_size /= 2;\n904\t\n905\t    return DISPATCH_BOOL_PAIR(\n906\t        launch_frac_build_tree_layer, revert, apply_alpha, layer, layer_size, alpha\n907\t    );\n908\t}\n909\t\n910\t// Launcher for fused two-layer tree build.\n911\t// half_i1 = N >> (i+2), where i is the index of the first layer to fuse.\n912\t// Requires half_i1 >= 1 and half_i1 * 4 <= total array size.\n913\textern \"C\" int _frac_build_tree_two_layers(FracExt *layer, size_t half_i1) {\n914\t    if (half_i1 == 0) return 0;\n915\t    // Use 256 threads/block (not 1024) to give the compiler more register headroom.\n916\t    // frac_build_tree_two_layers_kernel does 4 FracExt loads + 3 frac_add ops,\n917\t    // which has higher register pressure than the single-layer build kernel.\n918\t    auto [grid, block] = kernel_launch_params(half_i1, 256);\n919\t    frac_build_tree_two_layers_kernel<<<grid, block>>>(layer, (uint32_t)half_i1);\n920\t    return CHECK_KERNEL();\n921\t}\n922\t\n923\tinline uint32_t min_blocks_target_for_device(uint32_t blocks_per_sm, uint32_t fallback_blocks) {\n924\t    int device = 0;\n925\t    if (cudaGetDevice(&device) == cudaSuccess) {\n926\t        int sm_count = 0;\n927\t        if (cudaDeviceGetAttribute(&sm_count, cudaDevAttrMultiProcessorCount, device) ==\n928\t                cudaSuccess &&\n929\t            sm_count > 0) {"}]},"parent_tool_use_id":"toolu_01PghPvmUt3KNf6ZWoFxogHs","session_id":"8752a685-980c-4a43-bd75-41a76d7996d5","uuid":"8038bfc6-ec70-4348-aa5a-c1b5eab033f4","timestamp":"2026-04-13T18:37:27.077Z"}
