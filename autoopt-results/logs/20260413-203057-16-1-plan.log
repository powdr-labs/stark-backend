i < 2; i++)\n1417\t                frac_add_inplace(row[i], row[i + 2]);\n1418\t        }\n1419\t        #pragma unroll\n1420\t        for (uint32_t i = 0; i < Z_COUNT; i++)\n1421\t            inout[i * step + base_idx] = xchg[gid][rev][i];\n1422\t\n1423\t    } while ((tid += blockDim.x*gridDim.x) < step);\n1424\t    // Note: the original bit_rev_permutation_z guards this with \"Z_COUNT <= WARP_SIZE &&\"\n1425\t    // to prevent register spills when Z_COUNT > WARP_SIZE. Z_COUNT=8 is always <= 32.\n1426\t}\n1427\t\n1428\t// Fused bitrev + K=2 tree build for a single FracExt buffer.\n1429\t// Requires domain_size >= 256 (uses Z-tile shmem kernel).\n1430\t// Applies alpha to denominators and fuses tree layers 0 and 1 in shmem.\n1431\textern \"C\" int _bit_rev_frac_ext_build_k2(\n1432\t    FracExt* inout, uint32_t lg_domain_size, FpExt alpha)\n1433\t{\n1434\t    constexpr uint32_t Z_COUNT = 8;\n1435\t    constexpr uint32_t bsize = 256;\n1436\t    constexpr size_t shmem_bytes = (size_t)bsize * Z_COUNT * sizeof(FracExt);  // 64 KB\n1437\t    // Raise the per-block dynamic shmem limit once (static → paid on first call only).\n1438\t    static const cudaError_t shmem_err = cudaFuncSetAttribute(\n1439\t        bit_rev_frac_build_k2_kernel,\n1440\t        cudaFuncAttributeMaxDynamicSharedMemorySize,\n1441\t        (int)shmem_bytes);\n1442\t    if (shmem_err != cudaSuccess) return shmem_err;\n1443\t    size_t domain_size = (size_t)1 << lg_domain_size;\n1444\t    if (domain_size < (size_t)(bsize * Z_COUNT))\n1445\t        return cudaErrorInvalidValue;\n1446\t    uint32_t grid_x = (uint32_t)(domain_size / Z_COUNT / bsize);\n1447\t    bit_rev_frac_build_k2_kernel<<<dim3(grid_x), bsize, shmem_bytes>>>(\n1448\t        inout, lg_domain_size, alpha);\n1449\t    return CHECK_KERNEL();\n1450\t}\n1451\t\n1452\t} // namespace fractional_sumcheck_gkr\n1453\t"}]},"parent_tool_use_id":"toolu_01PghPvmUt3KNf6ZWoFxogHs","session_id":"8752a685-980c-4a43-bd75-41a76d7996d5","uuid":"abf01cb5-c068-