\t\n666\t        let mut round_polys_eval = Vec::with_capacity(round);\n667\t        let mut r_vec = Vec::with_capacity(round);\n668\t        let mut pq_size = 2 << round;\n669\t\n670\t        let lambda = transcript.sample_ext();\n671\t\n672\t        let tmp_buffer_capacity =\n673\t            unsafe { _frac_compute_round_temp_buffer_size((1 << round) as u32) } as usize;\n674\t        if tmp_buffer_capacity > tmp_block_sums.len() {\n675\t            tmp_block_sums = DeviceBuffer::<EF>::with_capacity(tmp_buffer_capacity);\n676\t        }\n677\t\n678\t        let last_outer_round = round == total_rounds - 1;\n679\t        debug_assert!(round > 0);\n680\t        let backend = choose_round_strategy(\n681\t            round,\n682\t            precompute_m_env,\n683\t            precompute_m_min_blocks_threshold,\n684\t            precompute_m_target_blocks,\n685\t            precompute_m_tail_tile_override,\n686\t            precompute_m_min_n,\n687\t        );\n688\t\n689\t        // In round `j`, contains `s_{j-1}(r_{j-1})`. Starts with the sumcheck's sum claim.\n690\t        let (numer_claim, denom_claim) =\n691\t            reduce_to_single_evaluation(claims_per_layer.last().unwrap(), /* mu */ xi_prev[0]);\n692\t        let mut prev_s_eval = numer_claim + lambda * denom_claim;\n693\t        let mut eq_r_acc = EF::ONE;\n694\t\n695\t        // Round 0: compute + revert fused. The pq_buffer fold will be fused into next round's\n696\t        // compute. This fuses frac_build_tree_layer(revert=true) with the first inner round\n697\t        // compute.\n698\t        let r0 = do_sumcheck_round_and_revert(\n699\t            &mut eq_buffer,\n700\t            &mut layer,\n701\t            pq_size,\n702\t            lambda,\n703\t            transcript,\n704\t            &mut d_sum_evals,\n705\t            &mut tmp_block_sums,\n706\t            &mut round_polys_eval,\n707\t            &mut r_vec,\n708\t            &mut prev_s_eval,\n709\t            xi_prev[0],\n710\t            &mut eq_r_acc,\n711\t        )?;\n712\t\n713\t        // Fused rounds 1..(round-1): compute + fold using prev_r.\n714\t        let mut prev_r = r0;\n715\t        let active: &mut DeviceBuffer<Frac<EF>>;\n716\t\n717\t        match backend {\n718\t            GkrRoundStrategy::FoldEval => {\n719\t                // Existing fused path.\n720\t                let mut scheduler = BufferScheduler::new(max_work_size);\n721\t                for &xi_j in xi_prev.iter().skip(1) {\n722\t                    let src_pq_size = pq_size;\n723\t                    let post_fold_size = pq_size >> 1;\n724\t\n725\t                    let r = match scheduler.next_target(post_fold_size, last_outer_round) {\n726\t                        BufferTarget::LayerToWork => do_fused_sumcheck_round(\n727\t                            &mut eq_buffer,\n728\t                            &layer,\n729\t                            &mut work_buffer,\n730\t                            src_pq_size,\n731\t                            lambda,\n732\t                            prev_r,\n733\t                            transcript,\n734\t                            &mut d_sum_evals,\n735\t                            &mut tmp_block_sums,\n736\t                            &mut round_polys_eval,\n737\t                            &mut r_vec,\n738\t                            &mut prev_s_eval,\n739\t                            xi_j,\n740\t                            &mut eq_r_acc,\n741\t                        )?,\n742\t                        BufferTarget::WorkToLayer => do_fused_sumcheck_round(\n743\t                            &mut eq_buffer,\n744\t                            &work_buffer,\n745\t                            &mut layer,\n746\t                            src_pq_size,\n747\t                            lambda,\n748\t                            prev_r,\n749\t                            transcript,\n750\t                            &mut d_sum_evals,\n751\t                            &mut tmp_block_sums,\n752\t                            &mut round_polys_eval,\n753\t                            &mut r_vec,\n754\t                            &mut prev_s_eval,\n755\t                            xi_j,\n756\t                            &mut eq_r_acc,\n757\t                        )?,\n758\t                        BufferTarget::InPlaceLayer => do_fused_sumcheck_round_inplace(\n759\t                            &mut eq_buffer,\n760\t                            &mut layer,\n761\t                            src_pq_size,\n762\t                            lambda,\n763\t                            prev_r,\n764\t                            transcript,\n765\t                            &mut d_sum_evals,\n766\t                            &mut tmp_block_sums,\n767\t                            &mut round_polys_eval,\n768\t                            &mut r_vec,\n769\t                            &mut prev_s_eval,\n770\t                            xi_j,\n771\t                            &mut eq_r_acc,\n772\t                        )?,\n773\t                        BufferTarget::InPlaceWork => do_fused_sumcheck_round_inplace(\n774\t                            &mut eq_buffer,\n775\t                            &mut work_buffer,\n776\t                            src_pq_size,\n777\t                            lambda,\n778\t                            prev_r,\n779\t                            transcript,\n780\t                            &mut d_sum_evals,\n781\t                            &mut tmp_block_sums,\n782\t                            &mut round_polys_eval,\n783\t                            &mut r_vec,\n784\t                            &mut prev_s_eval,\n785\t                            xi_j,\n786\t                            &mut eq_r_acc,\n787\t                        )?,\n788\t                    };\n789\t\n790\t                    pq_size >>= 1;\n791\t                    prev_r = r;\n792\t                }\n793\t\n794\t                // Final fold after last r (no next compute to fuse with).\n795\t                active = match scheduler.final_fold_target(last_outer_round) {\n796\t                    BufferTarget::InPlaceWork => {\n797\t                        unsafe {\n798\t                            fold_ef_frac_columns_inplace(&mut work_buffer, pq_size, prev_r)\n799\t                                .map_err(FractionalSumcheckError::FoldColumns)?;\n800\t                        }\n801\t                        &mut work_buffer\n802\t                    }\n803\t                    BufferTarget::InPlaceLayer => {\n804\t                        unsafe {\n805\t                            fold_ef_frac_columns_inplace(&mut layer, pq_size, prev_r)\n806\t                                .map_err(FractionalSumcheckError::FoldColumns)?;\n807\t                        }\n808\t                        &mut layer\n809\t                    }\n810\t                    BufferTarget::LayerToWork => {\n811\t                        unsafe {\n812\t                            fold_ef_frac_columns(&layer, &mut work_buffer, pq_size, prev_r)\n813\t                                .map_err(FractionalSumcheckError::FoldColumns)?;\n814\t                        }\n815\t                        &mut work_buffer\n816\t                    }\n817\t                    BufferTarget::WorkToLayer => unreachable!(),\n818\t                };\n819\t                pq_size >>= 1;\n820\t            }\n821\t            GkrRoundStrategy::PrecomputeM => {\n822\t                let base = 1usize;\n823\t                let stop = round.div_ceil(2);\n824\t\n825\t                // First window reads from `layer` with pending_fold=true\n826\t                // (M-build folds prev_r inline). Multifold writes to\n827\t                // `active_pq` (work_buffer for non-last rounds, layer for\n828\t                // last). After the first window, subsequent windows\n829\t                // read/write active_pq with pending_fold=false.\n830\t                let mut pending_fold = true;\n831\t                let layer_read_ptr = layer.as_ptr();\n832\t                let active_pq = if last_outer_round {\n833\t                    &mut layer\n834\t                } else {\n835\t                    &mut work_buffer\n836\t                };\n837\t\n838\t                // w+1 to accommodate r_prev prepended to window challenges\n839\t                // on the first iteration (inline fold on last outer round).\n840\t                let mut eq_r_window_host = vec![EF::ZERO; 1 << (GKR_WINDOW_SIZE + 1)];\n841\t                let mut eq_r_prefix_host = vec![EF::ZERO; 1 << GKR_WINDOW_SIZE];\n842\t                let mut eq_suffix_host = vec![EF::ZERO; 1 << GKR_WINDOW_SIZE];\n843\t\n844\t                if eq_r_prefix_buffer.is_empty() {\n845\t                    eq_r_prefix_buffer =\n846\t                        DeviceBuffer::<EF>::with_capacity(1usize << GKR_WINDOW_SIZE);\n847\t                }\n848\t                if eq_suffix_buffer.is_empty() {\n849\t                    eq_suffix_buffer = DeviceBuffer::<EF>::with_capacity(1usize << GKR_WINDOW_SIZE);\n850\t                }\n851\t\n852\t                let mut base = base;\n853\t                while base < stop {\n854\t                    let rem_n = round - base;\n855\t                    let rounds_left = stop - base;\n856\t                    let Some(w) = choose_precompute_m_window_w(\n857\t                        rem_n,\n858\t                        rounds_left,\n859\t                        precompute_m_min_blocks_threshold,\n860\t                        precompute_m_target_blocks,\n861\t                        precompute_m_tail_tile_override,\n862\t                        precompute_m_min_n,\n863\t                    ) else {\n864\t                        break;\n865\t                    };\n866\t                    if m_buffer.is_empty() {\n867\t                        let max_m_len = 1usize << (2 * GKR_WINDOW_SIZE);\n868\t                        m_buffer = DeviceBuffer::<EF>::with_capacity(max_m_len);\n869\t                    }\n870\t                    let m_ptr = m_buffer.as_mut_ptr();\n871\t                    // Reuse tmp_block_sums for eq_r_window upload.\n872\t                    // Safe: M eval rounds finish before multifold needs eq_r_window,\n873\t                    // and tmp_block_sums is not needed until next fold-eval round.\n874\t                    let max_eq_r_window_len = 1usize << (GKR_WINDOW_SIZE + 1);\n875\t                    debug_assert!(\n876\t                        tmp_block_sums.len() >= max_eq_r_window_len,\n877\t                        \"tmp_block_sums too small for eq_r_window: {} < {}\",\n878\t                        tmp_block_sums.len(),\n879\t                        max_eq_r_window_len,\n880\t                    );\n881\t                    let d_eq_r_window = tmp_block_sums.as_mut_ptr();\n882\t\n883\t                    // When pending_fold is true, the buffer has rem_n+1 variables\n884\t                    // and the kernel folds inline. The effective tail dimension\n885\t                    // for tiling is the same either way (rem_n - w).\n886\t                    let tail_tile = precompute_m_build_tail_tile(\n887\t                        rem_n,\n888\t                        w,\n889\t                        precompute_m_min_blocks_threshold,\n890\t                        precompute_m_target_blocks,\n891\t                        precompute_m_tail_tile_override,\n892\t                    );\n893\t                    let num_blocks = precompute_m_num_tail_blocks(rem_n, w, tail_tile);\n894\t                    let m_len = (1usize << w) * (1usize << w);\n895\t                    let partial_len = num_blocks * m_len;\n896\t                    if partial_len > m_partial_buffer.len() {\n897\t                        m_partial_buffer = DeviceBuffer::<EF>::with_capacity(partial_len);\n898\t                    }\n899\t"}]},"parent_tool_use_id":"toolu_01PghPvmUt3KNf6ZWoFxogHs","session_id":"8752a685-980c-4a43-bd75-41a76d7996d5","uuid":"36bb0d44-c32a-4b8a-91e4-e9cc7e97e794","timestamp":"2026-04-13T18:37:11.155Z"}
