{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NAwEE2eFvG4ZWGvfUZPyXZ","type":"tool_result","content":"590\tpub unsafe fn frac_build_tree_two_layers(\n591\t    layer: &mut DeviceBuffer<Frac<EF>>,\n592\t    half_i1: usize,\n593\t) -> Result<(), CudaError> {\n594\t    CudaError::from_result(_frac_build_tree_two_layers(layer.as_mut_ptr(), half_i1))\n595\t}\n596\t\n597\t// `eq_xi` will not store evaluations for the first hypercube coordinate because the prover factors\n598\t// out the first eq term.\n599\t#[allow(clippy::too_many_arguments)]\n600\tpub unsafe fn frac_compute_round(\n601\t    eq_xi: &SqrtEqLayers,\n602\t    pq_buffer: &DeviceBuffer<Frac<EF>>,\n603\t    num_x: usize,\n604\t    lambda: EF,\n605\t    out_device: &mut DeviceBuffer<EF>,\n606\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n607\t) -> Result<(), CudaError> {\n608\t    let low_n = eq_xi.low_n();\n609\t    let high_n = eq_xi.high_n();\n610\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n611\t    debug_assert!(pq_buffer.len() >= 2 * num_x);\n612\t    #[cfg(debug_assertions)]\n613\t    {\n614\t        let len = tmp_block_sums.len();\n615\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n616\t        assert!(\n617\t            len >= required as usize,\n618\t            \"tmp_block_sums len={len} < required={required}\"\n619\t        );\n620\t    }\n621\t    CudaError::from_result(_frac_compute_round(\n622\t        eq_xi.low.get_ptr(low_n),\n623\t        eq_xi.high.get_ptr(high_n),\n624\t        pq_buffer.as_ptr(),\n625\t        num_x,\n626\t        1 << low_n,\n627\t        lambda,\n628\t        out_device.as_mut_ptr(),\n629\t        tmp_block_sums.as_mut_ptr(),\n630\t    ))\n631\t}\n632\t\n633\t/// Fused compute round + tree layer revert kernel.\n634\t///\n635\t/// Combines `frac_build_tree_layer(revert=true)` with `compute_round` for the first inner round.\n636\t/// The revert operation modifies `layer` in-place: `layer[i] = layer[i] - layer[i + half]` for `i <\n637\t/// half`.\n638\t///\n639\t/// This eliminates one kernel launch per outer round.\n640\t#[allow(clippy::too_many_arguments)]\n641\tpub unsafe fn frac_compute_round_and_revert(\n642\t    eq_xi: &SqrtEqLayers,\n643\t    layer: &mut DeviceBuffer<Frac<EF>>,\n644\t    num_x: usize,\n645\t    lambda: EF,\n646\t    out_device: &mut DeviceBuffer<EF>,\n647\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n648\t) -> Result<(), CudaError> {\n649\t    let low_n = eq_xi.low_n();\n650\t    let high_n = eq_xi.high_n();\n651\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n652\t    #[cfg(debug_assertions)]\n653\t    {\n654\t        let len = tmp_block_sums.len();\n655\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n656\t        assert!(\n657\t            len >= required as usize,\n658\t            \"tmp_block_sums len={len} < required={required}\"\n659\t        );\n660\t        assert!(layer.len() >= 2 * num_x, \"layer too small for pq_size\");\n661\t    }\n662\t    CudaError::from_result(_frac_compute_round_and_revert(\n663\t        eq_xi.low.get_ptr(low_n),\n664\t        eq_xi.high.get_ptr(high_n),\n665\t        layer.as_mut_ptr(),\n666\t        num_x,\n667\t        1 << low_n,\n668\t        lambda,\n669\t        out_device.as_mut_ptr(),\n670\t        tmp_block_sums.as_mut_ptr(),\n671\t    ))\n672\t}\n673\t\n674\t/// Folds `Frac<EF>` buffer. Pairs (idx, idx+quarter) and (idx+half, idx+3*quarter),\n675\t/// writes results to dst[idx] and dst[idx+quarter]. Output size is `size / 2`.\n676\t/// Safe for src == dst (in-place) because each thread handles disjoint indices.\n677\tpub unsafe fn fold_ef_frac_columns(\n678\t    src: &DeviceBuffer<Frac<EF>>,\n679\t    dst: &mut DeviceBuffer<Frac<EF>>,\n680\t    size: usize,\n681\t    r: EF,\n682\t) -> Result<(), CudaError> {\n683\t    debug_assert!(src.len() >= size);\n684\t    debug_assert!(dst.len() >= size / 2);\n685\t    CudaError::from_result(_frac_fold_fp