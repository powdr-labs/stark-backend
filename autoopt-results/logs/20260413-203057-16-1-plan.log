{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SRqTLh8UP9gerStAS5GmXK","type":"tool_result","content":"1131\t    fn sumcheck_polys_batch_eval(\n1132\t        &mut self,\n1133\t        round: usize,\n1134\t        r_prev: EF,\n1135\t    ) -> Result<Vec<Vec<EF>>, LogupZerocheckError> {\n1136\t        let sp_deg = self.constraint_degree;\n1137\t\n1138\t        // Per-trace outputs (filled as we go)\n1139\t        let mut zc_out: Vec<Vec<EF>> = vec![vec![EF::ZERO; sp_deg]; self.n_per_trace.len()];\n1140\t        let mut logup_out: Vec<[Vec<EF>; 2]> =\n1141\t            vec![[vec![EF::ZERO; sp_deg], vec![EF::ZERO; sp_deg]]; self.n_per_trace.len()];\n1142\t\n1143\t        let mut late_eval: Vec<TraceCtx> = Vec::new(); // round == n_lift + 1\n1144\t        let mut early_eval: Vec<TraceCtx> = Vec::new(); // round <= n_lift\n1145\t\n1146\t        // ── Phase 1: Collect metadata, split into Case A / Case B (no CUDA calls) ──\n1147\t        // For Case B traces, we collect column pointers and sizing info to batch the\n1148\t        // interpolation into a single kernel launch.\n1149\t        struct CaseBMeta {\n1150\t            trace_idx: usize,\n1151\t            air_idx: usize,\n1152\t            n_lift: usize,\n1153\t            num_y: usize,\n1154\t            num_columns: usize, // total columns (selectors + preprocessed + mains)\n1155\t            interp_offset: usize, // element offset within the big interpolated buffer\n1156\t            col_start: usize,   // start index in the flat all_columns array\n1157\t            has_preprocessed: bool,\n1158\t            need_rot: bool,\n1159\t            has_constraints: bool,\n1160\t            has_interactions: bool,\n1161\t            norm_factor: F,\n1162\t        }\n1163\t        let mut case_b_traces: Vec<CaseBMeta> = Vec::new();\n1164\t        let mut all_columns: Vec<*const EF> = Vec::new();\n1165\t        let mut total_interp_elems: usize = 0;\n1166\t\n1167\t        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n1168\t            self.n_per_trace.iter(),\n1169\t            self.mat_evals_per_trace.iter(),\n1170\t            self.sels_per_trace.iter(),\n1171\t            self.d_eq_3b_per_trace.iter(),\n1172\t            self.public_values_per_trace.iter(),\n1173\t            self.air_indices_per_trace.iter()\n1174\t        )\n1175\t        .enumerate()\n1176\t        {\n1177\t            let pk = &self.pk.per_air[air_idx];\n1178\t            let dag = &pk.vk.symbolic_constraints;\n1179\t            let has_constraints = dag.constraints.num_constraints() > 0;\n1180\t            let has_interactions = !dag.interactions.is_empty();\n1181\t            if !has_constraints && !has_interactions {\n1182\t                continue;\n1183\t            }\n1184\t\n1185\t            let n_lift = n.max(0) as usize;\n1186\t            let norm_factor_denom = 1 << (-n).max(0);\n1187\t            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n1188\t            let has_preprocessed = pk.preprocessed_data.is_some();\n1189\t            let need_rot = pk.vk.params.need_rot;\n1190\t            let first_main_idx = usize::from(has_preprocessed);\n1191\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n1192\t\n1193\t            if round > n_lift {\n1194\t                // Case A\n1195\t                if round == n_lift + 1 {\n1196\t                    // A.1: evaluate directly at (num_x=1, num_y=1)\n1197\t                    let prep_ptr = if has_preprocessed {\n1198\t                        MainMatrixPtrs {\n1199\t                            data: mats[0].buffer().as_ptr(),\n1200\t                            air_width: air_width_for_mat(need_rot, mats[0].width()),\n1201\t                        }\n1202\t                    } else {\n1203\t                        MainMatrixPtrs {\n1204\t                            data: std::ptr::null(),\n1205\t                            air_width: 0,\n1206\t                        }\n1207\t                    };\n1208\t                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1209\t                        .iter()\n1210\t                        .map(|m| MainMatrixPtrs {\n1211\t                            data: m.buffer().as_ptr(),\n1212\t                            air_width: air_width_for_mat(need_rot, m.width()),\n1213\t                        })\n1214\t                        .collect_vec();\n1215\t                    let main_ptrs_dev = main_ptrs.to_device()?;\n1216\t\n1217\t                    late_eval.push(TraceCtx {\n1218\t                        trace_idx,\n1219\t                        air_idx,\n1220\t                        n_lift,\n1221\t                        num_y: 1,\n1222\t                        has_constraints,\n1223\t                        has_interactions,\n1224\t                        norm_factor,\n1225\t                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n1226\t                        sels_ptr: sels.buffer().as_ptr(),\n1227\t                        prep_ptr,\n1228\t                        main_ptrs_dev,\n1229\t                        public_ptr: public_vals.as_ptr(),\n1230\t                        eq_3bs_ptr: eq_3bs.as_ptr(),\n1231\t                    });\n1232\t                } else {\n1233\t                    // A.2: scale tilde evals only\n1234\t                    if has_constraints {\n1235\t                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n1236\t                        *tilde_eval *= r_prev;\n1237\t                    }\n1238\t                    if has_interactions {\n1239\t                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n1240\t                            *x *= r_prev;\n1241\t                        }\n1242\t                    }\n1243\t                }\n1244\t            } else {\n1245\t                // Case B: collect metadata for batched interpolation\n1246\t                let log_num_y = n_lift - round;\n1247\t                let num_y = 1 << log_num_y;\n1248\t                let height = 2 * num_y;\n1249\t                debug_assert_eq!(height, mats[0].height());\n1250\t\n1251\t                let col_start = all_columns.len();\n1252\t                // Collect all column pointers: selectors + all matrices (preprocessed + mains)\n1253\t                all_columns.extend(\n1254\t                    iter::once(sels)\n1255\t                        .chain(mats.iter())\n1256\t                        .flat_map(|m| {\n1257\t                            assert_eq!(m.height(), height);\n1258\t                            (0..m.width())\n1259\t                                .map(|col| m.buffer().as_ptr().wrapping_add(col * m.height()))\n1260\t                        }),\n1261\t                );\n1262\t                let num_columns = all_columns.len() - col_start;\n1263\t                let interp_size = sp_deg * num_y * num_columns;\n1264\t\n1265\t                case_b_traces.push(CaseBMeta {\n1266\t                    trace_idx,\n1267\t                    air_idx,\n1268\t                    n_lift,\n1269\t                    num_y,\n1270\t                    num_columns,\n1271\t                    interp_offset: total_interp_elems,\n1272\t                    col_start,\n1273\t                    has_preprocessed,\n1274\t                    need_rot,\n1275\t                    has_constraints,\n1276\t                    has_interactions,\n1277\t                    norm_factor,\n1278\t                });\n1279\t                total_interp_elems += interp_size;\n1280\t            }\n1281\t        }\n1282\t\n1283\t        // ── Phase 2: Batch allocate + single kernel launch ──\n1284\t        // One big buffer for all interpolated data, one kernel launch for all Case B traces.\n1285\t        let _keepalive_interpolated = if !case_b_traces.is_empty() {\n1286\t            let big_buf = DeviceBuffer::<EF>::with_capacity(total_interp_elems);\n1287\t            let big_ptr = big_buf.as_mut_ptr();\n1288\t\n1289\t            // Build descriptors with multi-block-per-trace assignment\n1290\t            const THREADS_PER_BLOCK: u32 = 512;\n1291\t            let mut block_offset: u32 = 0;\n1292\t            let descs: Vec<InterpColDesc> = case_b_traces\n1293\t                .iter()\n1294\t                .map(|meta| {\n1295\t                    let total_threads = (meta.num_y * meta.num_columns) as u32;\n1296\t                    let blocks = total_threads.div_ceil(THREADS_PER_BLOCK);\n1297\t                    let desc = InterpColDesc {\n1298\t                        output: unsafe { big_ptr.add(meta.interp_offset) },\n1299\t                        columns_offset: meta.col_start as u32,\n1300\t                        num_y: meta.num_y as u32,\n1301\t                        num_columns: meta.num_columns as u32,\n1302\t                        total_threads,\n1303\t                        block_start: block_offset,\n1304\t                    };\n1305\t                    block_offset += blocks;\n1306\t                    desc\n1307\t                })\n1308\t                .collect();\n1309\t            let total_blocks = block_offset as usize;\n1310\t\n1311\t            let d_descs = descs.to_device()?;\n1312\t            let d_all_columns = all_columns.to_device()?;\n1313\t            unsafe {\n1314\t                batched_interpolate_columns_gpu(&d_descs, &d_all_columns, sp_deg, total_blocks)\n1315\t                    .map_err(|e| LogupZerocheckError::InterpolateColumns(e.into()))?;\n1316\t            }\n1317\t\n1318\t            Some(big_buf)\n1319\t        } else {\n1320\t            None\n1321\t        };\n1322\t\n1323\t        // ── Phase 3: Build TraceCtx for each Case B trace ──\n1324\t        for meta in &case_b_traces {\n1325\t            let mats = &self.mat_evals_per_trace[meta.trace_idx];\n1326\t            let first_main_idx = usize::from(meta.has_preprocessed);\n1327\t            let eq_xi_tree = &self.eq_xis[&meta.n_lift];\n1328\t            let log_num_y = meta.n_lift - round;\n1329\t            let interpolated_height = sp_deg * meta.num_y;\n1330\t\n1331\t            let base_ptr = _keepalive_interpolated\n1332\t                .as_ref()\n1333\t                .unwrap()\n1334\t                .as_ptr()\n1335\t                .wrapping_add(meta.interp_offset);\n1336\t\n1337\t            let mut widths_so_far = 0usize;\n1338\t            let sels_ptr = base_ptr.wrapping_add(widths_so_far * interpolated_height);\n1339\t            widths_so_far += 3; // selector width is always 3\n1340\t\n1341\t            let prep_ptr = if meta.has_preprocessed {\n1342\t                MainMatrixPtrs {\n1343\t                    data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1344\t                    air_width: air_width_for_mat(meta.need_rot, mats[0].width()),\n1345\t                }\n1346\t            } else {\n1347\t                MainMatrixPtrs {\n1348\t                    data: std::ptr::null(),\n1349\t                    air_width: 0,\n1350\t                }\n1351\t            };\n1352\t            if meta.has_preprocessed {\n1353\t                widths_so_far += mats[0].width();\n1354\t            }\n1355\t            let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1356\t                .iter()\n1357\t                .map(|m| {\n1358\t                    let main_ptr = MainMatrixPtrs {\n1359\t                        data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1360\t                        air_width: air_width_for_mat(meta.need_rot, m.width()),\n1361\t                    };\n1362\t                    widths_so_far += m.width();\n1363\t                    main_ptr\n1364\t                })\n1365\t                .collect_vec();\n1366\t            debug_assert_eq!(widths_so_far, meta.num_columns);\n1367\t            let main_ptrs_dev = main_ptrs.to_device()?;\n1368\t\n1369\t            early_eval.push(TraceCtx {\n1370\t                trace_idx: meta.trace_idx,\n1371\t                air_idx: meta.air_idx,\n1372\t                n_lift: meta.n_lift,\n1373\t                num_y: meta.num_y as u32,\n1374\t                has_constraints: meta.has_constraints,\n1375\t                has_interactions: meta.has_interactions,\n1376\t                norm_factor: meta.norm_factor,\n1377\t                eq_xi_ptr: eq_xi_tree.get_ptr(log_num_y),\n1378\t                sels_ptr,\n1379\t                prep_ptr,\n1380\t                main_ptrs_dev,\n1381\t                public_ptr: self.public_values_per_trace[meta.trace_idx].as_ptr(),\n1382\t                eq_3bs_ptr: self.d_eq_3b_per_trace[meta.trace_idx].as_ptr(),\n1383\t            });\n1384\t        }\n1385\t\n1386\t        let d_challenges_ptr = self.d_challenges.as_ptr();\n1387\t\n1388\t        // Late traces (num_y=1): always use monomial\n1389\t        let late_logup_traces: Vec<_> = late_eval.iter().filter(|t| t.has_interactions).collect();\n1390\t        if !late_logup_traces.is_empty() {\n1391\t            let logup_combs: Vec<_> = late_logup_traces\n1392\t                .iter()\n1393\t                .map(|t| {\n1394\t                    self.logup_combinations[t.trace_idx]\n1395\t                        .as_ref()\n1396\t                        .expect(\"missing logup monomial combinations for late trace\")\n1397\t                })\n1398\t                .collect();\n1399\t            let batch =\n1400\t                LogupMonomialBatch::new(late_logup_traces.iter().copied(), self.pk, &logup_combs)?;\n1401\t            let out = batch\n1402\t                .evaluate(1)\n1403\t                .map_err(LogupZerocheckError::MleInteractionEval)?;\n1404\t            let host = out.to_host()?;\n1405\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1406\t                self.logup_tilde_evals[trace_idx][0] = host[i].p * late_logup_traces[i].norm_factor;\n1407\t                self.logup_tilde_evals[trace_idx][1] = host[i].q;\n1408\t            }\n1409\t        }\n1410\t        let late_mono_traces: Vec<_> = late_eval\n1411\t            .iter()\n1412\t            .filter(|t| trace_has_monomials(t, self.pk))\n1413\t            .collect();\n1414\t        if !late_mono_traces.is_empty() {\n1415\t            let lambda_combs: Vec<_> = late_mono_traces\n1416\t                .iter()\n1417\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1418\t                .collect();\n1419\t            let batch = ZerocheckMonomialBatch::new(late_mono_traces, self.pk, &lambda_combs)?;\n1420\t            let out = batch\n1421\t                .evaluate(1)\n1422\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1423\t            let host = out.to_host()?;\n1424\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1425\t                self.zerocheck_tilde_evals[trace_idx] = host[i];\n1426\t                // zc_out not set for num_x=1, handled from tilde_eval in compute_batch_s\n1427\t            }\n1428\t        }\n1429\t\n1430\t        // Logup for early traces: partition by num_y threshold\n1431\t        if !early_eval.is_empty() {\n1432\t            evaluate_logup_batched(\n1433\t                &early_eval,\n1434\t                self.pk,\n1435\t                d_challenges_ptr,\n1436\t                sp_deg as u32,\n1437\t                self.monomial_num_y_threshold,\n1438\t                &self.logup_combinations,\n1439\t                &mut logup_out,\n1440\t                &mut self.logup_tilde_evals,\n1441\t                self.memory_limit_bytes,\n1442\t            )\n1443\t            .map_err(LogupZerocheckError::MleInteractionEval)?;\n1444\t        }\n1445\t\n1446\t        // Early traces (num_y>1): partition by threshold for zerocheck path\n1447\t        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n1448\t            .iter()\n1449\t            .filter(|t| t.has_constraints)\n1450\t            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n1451\t\n1452\t        // Partition high num_y traces by monomial-to-rules ratio\n1453\t        // (traces without monomials are skipped - they contribute zero)\n1454\t        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n1455\t            high_early.iter().partition(|t| {\n1456\t                let num_monomials = get_num_monomials(t, self.pk);\n1457\t                let rules_len = get_zerocheck_rules_len(t, self.pk);\n1458\t                // Use DAG when monomial expansion significantly increased the term count\n1459\t                num_monomials as usize >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len\n1460\t            });\n1461\t\n1462\t        // DAG evaluation for high num_y traces with high monomial-to-rules ratio\n1463\t        if !high_dag_traces.is_empty() {\n1464\t            let lambda_pows = self.lambda_pows.as_ref().unwrap();\n1465\t            evaluate_zerocheck_batched(\n1466\t                high_dag_traces,\n1467\t                self.pk,\n1468\t                lambda_pows,\n1469\t                sp_deg as u32,\n1470\t                &mut zc_out,\n1471\t                self.memory_limit_bytes,\n1472\t            )\n1473\t            .map_err(LogupZerocheckError::MleConstraintEval)?;\n1474\t        }\n1475\t\n1476\t        // Par-Y monomial kernel for high num_y traces\n1477\t        if !high_mono_traces.is_empty() {\n1478\t            let lambda_combs: Vec<_> = high_mono_traces\n1479\t                .iter()\n1480\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1481\t                .collect();\n1482\t            let batch = ZerocheckMonomialParYBatch::new(\n1483\t                high_mono_traces,\n1484\t                self.pk,\n1485\t                &lambda_combs,\n1486\t                self.sm_count,\n1487\t                sp_deg as u32,\n1488\t                None,\n1489\t            )?;\n1490\t            let out = batch\n1491\t                .evaluate(sp_deg as u32)\n1492\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1493\t            let host = out.to_host()?;\n1494\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1495\t                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n1496\t            }\n1497\t        }\n1498\t\n1499\t        // Monomial zerocheck for low num_y traces\n1500\t        let low_mono_traces = low_early;\n1501\t        if !low_mono_traces.is_empty() {\n1502\t            let lambda_combs: Vec<_> = low_mono_traces\n1503\t                .iter()\n1504\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1505\t                .collect();\n1506\t            let batch = ZerocheckMonomialBatch::new(low_mono_traces, self.pk, &lambda_combs)?;\n1507\t            let out = batch\n1508\t                .evaluate(sp_deg as u32)\n1509\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1510\t            let host = out.to_host()?;\n1511\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1512\t                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n1513\t            }\n1514\t        }\n1515\t\n1516\t        Ok(logup_out.into_iter().flatten().chain(zc_out).collect())\n1517\t    }\n1518\t\n1519\t    #[instrument(level = \"debug\", skip_all, fields(round = round))]\n1520\t    fn compute_batch_s_poly(\n1521\t        &mut self,\n1522\t        sp_round_evals: Vec<Vec<EF>>,\n1523\t        num_traces: usize,\n1524\t        round: usize,\n1525\t        mu_pows: &[EF],\n1526\t    ) -> UnivariatePoly<EF> {\n1527\t        debug_assert_eq!(sp_round_evals.len(), 3 * num_traces);\n1528\t        debug_assert_eq!(sp_round_evals.len(), mu_pows.len());\n1529\t        let constraint_degree = self.constraint_degree;\n1530\t        let mut sp_head_zc = vec![EF::ZERO; constraint_degree];"}]},"parent_tool_use_id":null,"session_id":"8752a685-980c-4a43-bd75-41a76d7996d5","uuid":"de3778e0-4946-4b43-a32a-5b23132da028","timestamp":"2026-04-13T18:43:25.796Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/mod.rs","content":"    fn sumcheck_polys_batch_eval(\n        &mut self,\n        round: usize,\n        r_prev: EF,\n    ) -> Result<Vec<Vec<EF>>, LogupZerocheckError> {\n        let sp_deg = self.constraint_degree;\n\n        // Per-trace outputs (filled as we go)\n        let mut zc_out: Vec<Vec<EF>> = vec![vec![EF::ZERO; sp_deg]; self.n_per_trace.len()];\n        let mut logup_out: Vec<[Vec<EF>; 2]> =\n            vec![[vec![EF::ZERO; sp_deg], vec![EF::ZERO; sp_deg]]; self.n_per_trace.len()];\n\n        let mut late_eval: Vec<TraceCtx> = Vec::new(); // round == n_lift + 1\n        let mut early_eval: Vec<TraceCtx> = Vec::new(); // round <= n_lift\n\n        // ── Phase 1: Collect metadata, split into Case A / Case B (no CUDA calls) ──\n        // For Case B traces, we collect column pointers and sizing info to batch the\n        // interpolation into a single kernel launch.\n        struct CaseBMeta {\n            trace_idx: usize,\n            air_idx: usize,\n            n_lift: usize,\n            num_y: usize,\n            num_columns: usize, // total columns (selectors + preprocessed + mains)\n            interp_offset: usize, // element offset within the big interpolated buffer\n            col_start: usize,   // start index in the flat all_columns array\n            has_preprocessed: bool,\n            need_rot: bool,\n            has_constraints: bool,\n            has_interactions: bool,\n            norm_factor: F,\n        }\n        let mut case_b_traces: Vec<CaseBMeta> = Vec::new();\n        let mut all_columns: Vec<*const EF> = Vec::new();\n        let mut total_interp_elems: usize = 0;\n\n        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n            self.n_per_trace.iter(),\n            self.mat_evals_per_trace.iter(),\n            self.sels_per_trace.iter(),\n            self.d_eq_3b_per_trace.iter(),\n            self.public_values_per_trace.iter(),\n            self.air_indices_per_trace.iter()\n        )\n        .enumerate()\n        {\n            let pk = &self.pk.per_air[air_idx];\n            let dag = &pk.vk.symbolic_constraints;\n            let has_constraints = dag.constraints.num_constraints() > 0;\n            let has_interactions = !dag.interactions.is_empty();\n            if !has_constraints && !has_interactions {\n                continue;\n            }\n\n            let n_lift = n.max(0) as usize;\n            let norm_factor_denom = 1 << (-n).max(0);\n            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n            let has_preprocessed = pk.preprocessed_data.is_some();\n            let need_rot = pk.vk.params.need_rot;\n            let first_main_idx = usize::from(has_preprocessed);\n            let eq_xi_tree = &self.eq_xis[&n_lift];\n\n            if round > n_lift {\n                // Case A\n                if round == n_lift + 1 {\n                    // A.1: evaluate directly at (num_x=1, num_y=1)\n                    let prep_ptr = if has_preprocessed {\n                        MainMatrixPtrs {\n                            data: mats[0].buffer().as_ptr(),\n                            air_width: air_width_for_mat(need_rot, mats[0].width()),\n                        }\n                    } else {\n                        MainMatrixPtrs {\n                            data: std::ptr::null(),\n                            air_width: 0,\n                        }\n                    };\n                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n                        .iter()\n                        .map(|m| MainMatrixPtrs {\n                            data: m.buffer().as_ptr(),\n                            air_width: air_width_for_mat(need_rot, m.width()),\n                        })\n                        .collect_vec();\n                    let main_ptrs_dev = main_ptrs.to_device()?;\n\n                    late_eval.push(TraceCtx {\n                        trace_idx,\n                        air_idx,\n                        n_lift,\n                        num_y: 1,\n                        has_constraints,\n                        has_interactions,\n                        norm_factor,\n                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n                        sels_ptr: sels.buffer().as_ptr(),\n                        prep_ptr,\n                        main_ptrs_dev,\n                        public_ptr: public_vals.as_ptr(),\n                        eq_3bs_ptr: eq_3bs.as_ptr(),\n                    });\n                } else {\n                    // A.2: scale tilde evals only\n                    if has_constraints {\n                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n                        *tilde_eval *= r_prev;\n                    }\n                    if has_interactions {\n                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n                            *x *= r_prev;\n                        }\n                    }\n                }\n            } else {\n                // Case B: collect metadata for batched interpolation\n                let log_num_y = n_lift - round;\n                let num_y = 1 << log_num_y;\n                let height = 2 * num_y;\n                debug_assert_eq!(height, mats[0].height());\n\n                let col_start = all_columns.len();\n                // Collect all column pointers: selectors + all matrices (preprocessed + mains)\n                all_columns.extend(\n                    iter::once(sels)\n                        .chain(mats.iter())\n                        .flat_map(|m| {\n                            assert_eq!(m.height(), height);\n                            (0..m.width())\n                                .map(|col| m.buffer().as_ptr().wrapping_add(col * m.height()))\n                        }),\n                );\n                let num_columns = all_columns.len() - col_start;\n                let interp_size = sp_deg * num_y * num_columns;\n\n                case_b_traces.push(CaseBMeta {\n                    trace_idx,\n                    air_idx,\n                    n_lift,\n                    num_y,\n                    num_columns,\n                    interp_offset: total_interp_elems,\n                    col_start,\n                    has_preprocessed,\n                    need_rot,\n                    has_constraints,\n                    has_interactions,\n                    norm_factor,\n                });\n                total_interp_elems += interp_size;\n            }\n        }\n\n        // ── Phase 2: Batch allocate + single kernel launch ──\n        // One big buffer for all interpolated data, one kernel launch for all Case B traces.\n        let _keepalive_interpolated = if !case_b_traces.is_empty() {\n            let big_buf = DeviceBuffer::<EF>::with_capacity(total_interp_elems);\n            let big_ptr = big_buf.as_mut_ptr();\n\n            // Build descriptors with multi-block-per-trace assignment\n            const THREADS_PER_BLOCK: u32 = 512;\n            let mut block_offset: u32 = 0;\n            let descs: Vec<InterpColDesc> = case_b_traces\n                .iter()\n                .map(|meta| {\n                    let total_threads = (meta.num_y * meta.num_columns) as u32;\n                    let blocks = total_threads.div_ceil(THREADS_PER_BLOCK);\n                    let desc = InterpColDesc {\n                        output: unsafe { big_ptr.add(meta.interp_offset) },\n                        columns_offset: meta.col_start as u32,\n                        num_y: meta.num_y as u32,\n                        num_columns: meta.num_columns as u32,\n                        total_threads,\n                        block_start: block_offset,\n                    };\n                    block_offset += blocks;\n                    desc\n                })\n                .collect();\n            let total_blocks = block_offset as usize;\n\n            let d_descs = descs.to_device()?;\n            let d_all_columns = all_columns.to_device()?;\n            unsafe {\n                batched_interpolate_columns_gpu(&d_descs, &d_all_columns, sp_deg, total_blocks)\n                    .map_err(|e| LogupZerocheckError::InterpolateColumns(e.into()))?;\n            }\n\n            Some(big_buf)\n        } else {\n            None\n        };\n\n        // ── Phase 3: Build TraceCtx for each Case B trace ──\n        for meta in &case_b_traces {\n            let mats = &self.mat_evals_per_trace[meta.trace_idx];\n            let first_main_idx = usize::from(meta.has_preprocessed);\n            let eq_xi_tree = &self.eq_xis[&meta.n_lift];\n            let log_num_y = meta.n_lift - round;\n            let interpolated_height = sp_deg * meta.num_y;\n\n            let base_ptr = _keepalive_interpolated\n                .as_ref()\n                .unwrap()\n                .as_ptr()\n                .wrapping_add(meta.interp_offset);\n\n            let mut widths_so_far = 0usize;\n            let sels_ptr = base_ptr.wrapping_add(widths_so_far * interpolated_height);\n            widths_so_far += 3; // selector width is always 3\n\n            let prep_ptr = if meta.has_preprocessed {\n                MainMatrixPtrs {\n                    data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n                    air_width: air_width_for_mat(meta.need_rot, mats[0].width()),\n                }\n            } else {\n                MainMatrixPtrs {\n                    data: std::ptr::null(),\n                    air_width: 0,\n                }\n            };\n            if meta.has_preprocessed {\n                widths_so_far += mats[0].width();\n            }\n            let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n                .iter()\n                .map(|m| {\n                    let main_ptr = MainMatrixPtrs {\n                        data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n                        air_width: air_width_for_mat(meta.need_rot, m.width()),\n                    };\n                    widths_so_far += m.width();\n                    main_ptr\n                })\n                .collect_vec();\n            debug_assert_eq!(widths_so_far, meta.num_columns);\n            let main_ptrs_dev = main_ptrs.to_device()?;\n\n            early_eval.push(TraceCtx {\n                trace_idx: meta.trace_idx,\n                air_idx: meta.air_idx,\n                n_lift: meta.n_lift,\n                num_y: meta.num_y as u32,\n                has_constraints: meta.has_constraints,\n                has_interactions: meta.has_interactions,\n                norm_factor: meta.norm_factor,\n                eq_xi_ptr: eq_xi_tree.get_ptr(log_num_y),\n                sels_ptr,\n                prep_ptr,\n                main_ptrs_dev,\n                public_ptr: self.public_values_per_trace[meta.trace_idx].as_ptr(),\n                eq_3bs_ptr: self.d_eq_3b_per_trace[meta.trace_idx].as_ptr(),\n            });\n        }\n\n        let d_challenges_ptr = self.d_challenges.as_ptr();\n\n        // Late traces (num_y=1): always use monomial\n        let late_logup_traces: Vec<_> = late_eval.iter().filter(|t| t.has_interactions).collect();\n        if !late_logup_traces.is_empty() {\n            let logup_combs: Vec<_> = late_logup_traces\n                .iter()\n                .map(|t| {\n                    self.logup_combinations[t.trace_idx]\n                        .as_ref()\n                        .expect(\"missing logup monomial combinations for late trace\")\n                })\n                .collect();\n            let batch =\n                LogupMonomialBatch::new(late_logup_traces.iter().copied(), self.pk, &logup_combs)?;\n            let out = batch\n                .evaluate(1)\n                .map_err(LogupZerocheckError::MleInteractionEval)?;\n            let host = out.to_host()?;\n            for (i, trace_idx) in batch.trace_indices().enumerate() {\n                self.logup_tilde_evals[trace_idx][0] = host[i].p * late_logup_traces[i].norm_factor;\n                self.logup_tilde_evals[trace_idx][1] = host[i].q;\n            }\n        }\n        let late_mono_traces: Vec<_> = late_eval\n            .iter()\n            .filter(|t| trace_has_monomials(t, self.pk))\n            .collect();\n        if !late_mono_traces.is_empty() {\n            let lambda_combs: Vec<_> = late_mono_traces\n                .iter()\n                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n                .collect();\n            let batch = ZerocheckMonomialBatch::new(late_mono_traces, self.pk, &lambda_combs)?;\n            let out = batch\n                .evaluate(1)\n                .map_err(LogupZerocheckError::MleConstraintEval)?;\n            let host = out.to_host()?;\n            for (i, trace_idx) in batch.trace_indices().enumerate() {\n                self.zerocheck_tilde_evals[trace_idx] = host[i];\n                // zc_out not set for num_x=1, handled from tilde_eval in compute_batch_s\n            }\n        }\n\n        // Logup for early traces: partition by num_y threshold\n        if !early_eval.is_empty() {\n            evaluate_logup_batched(\n                &early_eval,\n                self.pk,\n                d_challenges_ptr,\n                sp_deg as u32,\n                self.monomial_num_y_threshold,\n                &self.logup_combinations,\n                &mut logup_out,\n                &mut self.logup_tilde_evals,\n                self.memory_limit_bytes,\n            )\n            .map_err(LogupZerocheckError::MleInteractionEval)?;\n        }\n\n        // Early traces (num_y>1): partition by threshold for zerocheck path\n        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n            .iter()\n            .filter(|t| t.has_constraints)\n            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n\n        // Partition high num_y traces by monomial-to-rules ratio\n        // (traces without monomials are skipped - they contribute zero)\n        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n            high_early.iter().partition(|t| {\n                let num_monomials = get_num_monomials(t, self.pk);\n                let rules_len = get_zerocheck_rules_len(t, self.pk);\n                // Use DAG when monomial expansion significantly increased the term count\n                num_monomials as usize >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len\n            });\n\n        // DAG evaluation for high num_y traces with high monomial-to-rules ratio\n        if !high_dag_traces.is_empty() {\n            let lambda_pows = self.lambda_pows.as_ref().unwrap();\n            evaluate_zerocheck_batched(\n                high_dag_traces,\n                self.pk,\n                lambda_pows,\n                sp_deg as u32,\n                &mut zc_out,\n                self.memory_limit_bytes,\n            )\n            .map_err(LogupZerocheckError::MleConstraintEval)?;\n        }\n\n        // Par-Y monomial kernel for high num_y traces\n        if !high_mono_traces.is_empty() {\n            let lambda_combs: Vec<_> = high_mono_traces\n                .iter()\n                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n                .collect();\n            let batch = ZerocheckMonomialParYBatch::new(\n                high_mono_traces,\n                self.pk,\n                &lambda_combs,\n                self.sm_count,\n                sp_deg as u32,\n                None,\n            )?;\n            let out = batch\n                .evaluate(sp_deg as u32)\n                .map_err(LogupZerocheckError::MleConstraintEval)?;\n            let host = out.to_host()?;\n            for (i, trace_idx) in batch.trace_indices().enumerate() {\n                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n            }\n        }\n\n        // Monomial zerocheck for low num_y traces\n        let low_mono_traces = low_early;\n        if !low_mono_traces.is_empty() {\n            let lambda_combs: Vec<_> = low_mono_traces\n                .iter()\n                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n                .collect();\n            let batch = ZerocheckMonomialBatch::new(low_mono_traces, self.pk, &lambda_combs)?;\n            let out = batch\n                .evaluate(sp_deg as u32)\n                .map_err(LogupZerocheckError::MleConstraintEval)?;\n            let host = out.to_host()?;\n            for (i, trace_idx) in batch.trace_indices().enumerate() {\n                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n            }\n        }\n\n        Ok(logup_out.into_iter().flatten().chain(zc_out).collect())\n    }\n\n    #[instrument(level = \"debug\", skip_all, fields(round = round))]\n    fn compute_batch_s_poly(\n        &mut self,\n        sp_round_evals: Vec<Vec<EF>>,\n        num_traces: usize,\n        round: usize,\n        mu_pows: &[EF],\n    ) -> UnivariatePoly<EF> {\n        debug_assert_eq!(sp_round_evals.len(), 3 * num_traces);\n        debug_assert_eq!(sp_round_evals.len(), mu_pows.len());\n        let constraint_degree = self.constraint_degree;\n        let mut sp_head_zc = vec![EF::ZERO; constraint_degree];","numLines":400,"startLine":1131,"totalLines":1792}}}
