{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EZQKHTjAHh9MWPZhp8Da6F","type":"tool_result","content":"1\tuse std::{array::from_fn, convert::TryInto, env, ffi::c_void, mem::transmute};\n2\t\n3\tuse openvm_cuda_common::{\n4\t    copy::{cuda_memcpy, MemCopyD2H},\n5\t    d_buffer::DeviceBuffer,\n6\t    memory_manager::MemTracker,\n7\t};\n8\tuse openvm_stark_backend::{\n9\t    poly_common::{eval_eq_mle, interpolate_linear_at_01, interpolate_quadratic_at_012},\n10\t    proof::GkrLayerClaims,\n11\t    prover::fractional_sumcheck_gkr::{Frac, FracSumcheckProof},\n12\t    FiatShamirTranscript, StarkProtocolConfig,\n13\t};\n14\tuse p3_field::{Field, PrimeCharacteristicRing};\n15\tuse p3_util::log2_strict_usize;\n16\tuse tracing::{debug_span, instrument};\n17\t\n18\tuse super::errors::FractionalSumcheckError;\n19\tuse crate::{\n20\t    cuda::{\n21\t        logup_zerocheck::{\n22\t            _frac_compute_round_temp_buffer_size, fold_ef_frac_columns,\n23\t            fold_ef_frac_columns_inplace, frac_build_tree_layer, frac_build_tree_two_layers,\n24\t            frac_compute_round, frac_compute_round_and_fold, frac_compute_round_and_fold_inplace,\n25\t            frac_compute_round_and_revert, frac_multifold_raw, frac_precompute_m_build_raw,\n26\t            frac_precompute_m_eval_round_raw,\n27\t        },\n28\t        ntt::{bit_rev_frac_ext, bit_rev_frac_ext_build_k2},\n29\t    },\n30\t    poly::SqrtEqLayers,\n31\t    prelude::EF,\n32\t};\n33\t\n34\tconst GKR_S_DEG: usize = 3;\n35\tconst GKR_WINDOW_SIZE: usize = 3;\n36\tconst GKR_WINDOW_DEFAULT_MIN_N: usize = 22;\n37\t\n38\t/// Describes which buffer operation to use for the next fused compute+fold round.\n39\t#[derive(Debug, Clone, Copy)]\n40\tenum BufferTarget {\n41\t    /// Out-of-place: layer → work_buffer\n42\t    LayerToWork,\n43\t    /// Out-of-place: work_buffer → layer\n44\t    WorkToLayer,\n45\t    /// In-place on layer buffer\n46\t    InPlaceLayer,\n47\t    /// In-place on work_buffer\n48\t    InPlaceWork,\n49\t}\n50\t\n51\t/// Encapsulates ping-pong buffer scheduling state for GKR inner rounds.\n52\t///\n53\t/// This struct manages the decision of whether to use in-place or out-of-place\n54\t/// (ping-pong) kernel variants based on buffer capacities and current data location.\n55\tstruct BufferScheduler {\n56\t    /// True if data currently resides in work_buffer, false if in layer.\n57\t    data_in_work_buffer: bool,\n58\t    /// Maximum capacity of work_buffer in elements.\n59\t    work_buffer_cap: usize,\n60\t}\n61\t\n62\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n63\tenum GkrRoundStrategy {\n64\t    FoldEval,\n65\t    PrecomputeM,\n66\t}\n67\t\n68\tconst PRECOMPUTE_M_TAIL_TILE: usize = 4096;\n69\tconst PRECOMPUTE_M_MIN_TAIL_TILE: usize = 256;\n70\tconst PRECOMPUTE_M_DEFAULT_MIN_BLOCKS: usize = 64;\n71\tconst PRECOMPUTE_M_DEFAULT_TARGET_BLOCKS: usize = 1024;\n72\t\n73\timpl BufferScheduler {\n74\t    /// Creates a new scheduler with data initially in layer buffer.\n75\t    fn new(work_buffer_cap: usize) -> Self {\n76\t        Self {\n77\t            data_in_work_buffer: false,\n78\t            work_buffer_cap,\n79\t        }\n80\t    }\n81\t\n82\t    /// Returns true if we can use ping-pong (out-of-place) for the given post-fold size.\n83\t    fn can_pingpong(&self, post_fold_size: usize) -> bool {\n84\t        post_fold_size <= self.work_buffer_cap\n85\t    }\n86\t\n87\t    /// Determines the next buffer target for a fused compute+fold operation.\n88\t    ///\n89\t    /// For last outer round: uses ping-pong when possible for __restrict__ optimization.\n90\t    /// For non-last outer rounds: preserves layer for tree revert operations.\n91\t    fn next_target(&mut self, post_fold_size: usize, last_outer_round: bool) -> BufferTarget {\n92\t        let can_pingpong = self.can_pingpong(post_fold_size);\n93\t\n94\t        if last_outer_round {\n95\t            if can_pingpong {\n96\t                // Ping-pong to other buffer\n97\t                if self.data_in_work_buffer {\n98\t                    self.data_in_work_buffer = false;\n99\t                    BufferTarget::WorkToLayer\n100\t                } else {\n101\t                    self.data_in_work_buffer = true;\n102\t                    BufferTarget::LayerToWork\n103\t                }\n104\t            } else {\n105\t                // In-place on layer (data must be in layer for early rounds of last outer round)\n106\t                debug_assert!(\n107\t                    !self.data_in_work_buffer,\n108\t                    \"in-place path requires data in layer\"\n109\t                );\n110\t                BufferTarget::InPlaceLayer\n111\t            }\n112\t        } else {\n113\t            // Non-last outer round: preserve layer for tree revert\n114\t            if self.data_in_work_buffer {\n115\t                // Already in work_buffer, stay there in-place\n116\t                BufferTarget::InPlaceWork\n117\t            } else {\n118\t                // Data in layer, move to work_buffer (out-of-place)\n119\t                self.data_in_work_buffer = true;\n120\t                BufferTarget::LayerToWork\n121\t            }\n122\t        }\n123\t    }\n124\t\n125\t    /// Returns the buffer target for the final fold (no fused compute).\n126\t    fn final_fold_target(&self, last_outer_round: bool) -> BufferTarget {\n127\t        if last_outer_round {\n128\t            if self.data_in_work_buffer {\n129\t                BufferTarget::InPlaceWork\n130\t            } else {\n131\t                BufferTarget::InPlaceLayer\n132\t            }\n133\t        } else {\n134\t            // Non-last outer round: fold into work_buffer to preserve layer\n135\t            if self.data_in_work_buffer {\n136\t                BufferTarget::InPlaceWork\n137\t            } else {\n138\t                BufferTarget::LayerToWork\n139\t            }\n140\t        }\n141\t    }\n142\t}\n143\t\n144\tfn precompute_m_enabled() -> bool {\n145\t    !matches!(\n146\t        env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M\"),\n147\t        Ok(val) if matches!(val.as_str(), \"0\" | \"false\" | \"FALSE\" | \"no\" | \"NO\")\n148\t    )\n149\t}\n150\t\n151\tfn precompute_m_min_blocks_threshold() -> usize {\n152\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_BLOCKS\")\n153\t        .ok()\n154\t        .and_then(|val| val.parse::<usize>().ok())\n155\t        .unwrap_or(PRECOMPUTE_M_DEFAULT_MIN_BLOCKS)\n156\t        .max(1)\n157\t}\n158\t\n159\tfn precompute_m_num_tail_blocks(rem_n: usize, w: usize, tail_tile: usize) -> usize {\n160\t    let tail_n = rem_n - w;\n161\t    (1usize << tail_n).div_ceil(tail_tile)\n162\t}\n163\t\n164\tfn precompute_m_target_blocks() -> usize {\n165\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_TARGET_BLOCKS\")\n166\t        .ok()\n167\t        .and_then(|val| val.parse::<usize>().ok())\n168\t        .unwrap_or(PRECOMPUTE_M_DEFAULT_TARGET_BLOCKS)\n169\t        .max(1)\n170\t}\n171\t\n172\tfn precompute_m_tail_tile_override() -> Option<usize> {\n173\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_TAIL_TILE\")\n174\t        .ok()\n175\t        .and_then(|val| val.parse::<usize>().ok())\n176\t        .map(|v| v.clamp(PRECOMPUTE_M_MIN_TAIL_TILE, PRECOMPUTE_M_TAIL_TILE))\n177\t}\n178\t\n179\tfn precompute_m_min_n() -> usize {\n180\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_N\")\n181\t        .ok()\n182\t        .and_then(|val| val.parse::<usize>().ok())\n183\t        .unwrap_or(GKR_WINDOW_DEFAULT_MIN_N)\n184\t}\n185\t\n186\tfn precompute_m_build_tail_tile(\n187\t    rem_n: usize,\n188\t    w: usize,\n189\t    min_blocks_threshold: usize,\n190\t    target_blocks: usize,\n191\t    tail_tile_override: Option<usize>,\n192\t) -> usize {\n193\t    if let Some(tile) = tail_tile_override {\n194\t        return tile;\n195\t    }\n196\t    let tail_n = rem_n - w;\n197\t    let k = 1usize << tail_n;\n198\t    let target_blocks = target_blocks.max(min_blocks_threshold).max(1);\n199\t    let desired_tile = k.div_ceil(target_blocks).max(1);\n200\t    desired_tile.clamp(PRECOMPUTE_M_MIN_TAIL_TILE, PRECOMPUTE_M_TAIL_TILE)"}]},"parent_tool_use_id":"toolu_01PghPvmUt3KNf6ZWoFxogHs","session_id":"8752a685-980c-4a43-bd75-41a76d7996d5","uuid":"e383b05c-c860-4276-843f-d4ef60a6b5f5","timestamp":"2026-04-13T18:37:07.282Z"}
