{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011MxsjxXcnMTXTxgRYSasZd","type":"tool_result","content":"1\tuse super::*;\n2\tuse crate::{\n3\t    monomial::{InteractionMonomialTerm, LambdaTerm, MonomialHeader, PackedVar},\n4\t    poly::SqrtEqLayers,\n5\t};\n6\t\n7\t#[repr(C)]\n8\t#[derive(Clone, Copy, Debug)]\n9\tpub struct MainMatrixPtrs<T> {\n10\t    pub data: *const T,\n11\t    pub air_width: u32,\n12\t}\n13\t\n14\t// Types for batch MLE:\n15\t#[repr(C)]\n16\t#[derive(Clone, Copy, Debug)]\n17\tpub struct BlockCtx {\n18\t    pub local_block_idx_x: u32,\n19\t    /// Caution: this refers to the index within buffer of `ZerocheckCtx` or `LogupCtx`. It is\n20\t    /// hence a \"local\" AIR index and not the global AIR index within the proving key.\n21\t    pub air_idx: u32,\n22\t}\n23\t\n24\t/// Per-AIR context for batched monomial evaluation.\n25\t#[repr(C)]\n26\t#[derive(Clone, Copy, Debug)]\n27\tpub struct MonomialAirCtx {\n28\t    pub d_headers: *const MonomialHeader,\n29\t    pub d_variables: *const PackedVar,\n30\t    pub d_lambda_combinations: *const EF, // Precomputed per-monomial\n31\t    pub num_monomials: u32,\n32\t    pub eval_ctx: EvalCoreCtx,\n33\t    pub d_eq_xi: *const EF,\n34\t    pub num_y: u32,\n35\t}\n36\t\n37\t#[repr(C)]\n38\t#[derive(Clone, Copy, Debug)]\n39\tpub struct EvalCoreCtx {\n40\t    pub d_selectors: *const EF,\n41\t    pub d_preprocessed: MainMatrixPtrs<EF>,\n42\t    pub d_main: *const MainMatrixPtrs<EF>,\n43\t    pub d_public: *const F,\n44\t}\n45\t\n46\t#[repr(C)]\n47\t#[derive(Clone, Copy, Debug)]\n48\tpub struct ZerocheckCtx {\n49\t    pub eval_ctx: EvalCoreCtx,\n50\t    pub d_intermediates: *mut EF,\n51\t    pub num_y: u32,\n52\t    pub d_eq_xi: *const EF,\n53\t    pub d_rules: *const std::ffi::c_void,\n54\t    pub rules_len: usize,\n55\t    pub d_used_nodes: *const usize,\n56\t    pub used_nodes_len: usize,\n57\t    pub buffer_size: u32,\n58\t}\n59\t\n60\t#[repr(C)]\n61\t#[derive(Clone, Copy, Debug)]\n62\tpub struct LogupCtx {\n63\t    pub eval_ctx: EvalCoreCtx,\n64\t    pub d_intermediates: *mut EF,\n65\t    pub num_y: u32,\n66\t    pub d_eq_xi: *const EF,\n67\t    pub d_challenges: *const EF,\n68\t    pub d_eq_3bs: *const EF,\n69\t    pub d_rules: *const std::ffi::c_void,\n70\t    pub rules_len: usize,\n71\t    pub d_used_nodes: *const usize,\n72\t    pub d_pair_idxs: *const u32,\n73\t    pub used_nodes_len: usize,\n74\t    pub buffer_size: u32,\n75\t}\n76\t\n77\t/// Common per-AIR context for batched logup monomial evaluation.\n78\t#[repr(C)]\n79\t#[derive(Clone, Copy, Debug)]\n80\tpub struct LogupMonomialCommonCtx {\n81\t    pub eval_ctx: EvalCoreCtx,\n82\t    pub d_eq_xi: *const EF,\n83\t    pub bus_term_sum: EF, // Precomputed sum_i(beta[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n84\t    pub num_y: u32,\n85\t    pub mono_blocks: u32,\n86\t}\n87\t\n88\t/// Per-AIR context for batched logup monomial evaluation (numerator or denominator).\n89\t#[repr(C)]\n90\t#[derive(Clone, Copy, Debug)]\n91\tpub struct LogupMonomialCtx {\n92\t    pub d_headers: *const MonomialHeader,\n93\t    pub d_variables: *const PackedVar,\n94\t    pub d_combinations: *const EF,\n95\t    pub num_monomials: u32,\n96\t}\n97\t/// Descriptor for batched interpolation of columns across multiple traces.\n98\t#[repr(C)]\n99\t#[derive(Clone, Copy, Debug)]\n100\tpub struct InterpColDesc {\n101\t    pub output: *mut EF,\n102\t    pub columns_offset: u32,\n103\t    pub num_y: u32,\n104\t    pub num_columns: u32,\n105\t    pub total_threads: u32,\n106\t    pub block_start: u32,\n107\t}\n108\t\n109\tunsafe impl Send for InterpColDesc {}\n110\tunsafe impl Sync for InterpColDesc {}\n111\t\n112\t// end of types for batch MLE\n113\t\n114\textern \"C\" {\n115\t    // gkr.cu\n116\t    fn _frac_build_tree_layer(\n117\t        layer: *mut Frac<EF>,\n118\t        layer_size: usize,\n119\t        revert: bool,\n120\t        alpha: EF,\n121\t        apply_alpha: bool,\n122\t    ) -> i32;\n123\t\n124\t    /// Fused two-layer tree build. Applies layers i and i+1 in one kernel pass,\n125\t    /// keeping intermediate right-half nodes for revert operations.\n126\t    /// `half_i1` = N >> (i+2), where i is the first of the two layers.\n127\t    fn _frac_build_tree_two_layers(layer: *mut Frac<EF>, half_i1: usize) -> i32;\n128\t\n129\t    pub fn _frac_compute_round_temp_buffer_size(stride: u32) -> u32;\n130\t\n131\t    fn _frac_compute_round(\n132\t        eq_xi_low: *const EF,\n133\t        eq_xi_high: *const EF,\n134\t        pq_buffer: *const Frac<EF>,\n135\t        num_x: usize,\n136\t        eq_low_cap: usize,\n137\t        lambda: EF,\n138\t        out_device: *mut EF,\n139\t        tmp_block_sums: *mut EF,\n140\t    ) -> i32;\n141\t\n142\t    /// Fused compute round + tree layer revert. Combines frac_build_tree_layer(revert=true)\n143\t    /// with compute_round for the first inner round. Modifies layer in-place for revert.\n144\t    fn _frac_compute_round_and_revert(\n145\t        eq_xi_low: *const EF,\n146\t        eq_xi_high: *const EF,\n147\t        layer: *mut Frac<EF>,\n148\t        num_x: usize,\n149\t        eq_low_cap: usize,\n150\t        lambda: EF,\n151\t        out_device: *mut EF,\n152\t        tmp_block_sums: *mut EF,\n153\t    ) -> i32;\n154\t\n155\t    fn _frac_fold_fpext_columns(\n156\t        src: *const Frac<EF>,\n157\t        dst: *mut Frac<EF>,\n158\t        size: usize,\n159\t        r: EF,\n160\t    ) -> i32;\n161\t\n162\t    /// Fused compute round + fold (out-of-place). Reads from pre-fold src_pq_buffer (size\n163\t    /// src_pq_size), computes sumcheck sums, and writes folded output to dst_pq_buffer (size\n164\t    /// src_pq_size/2). IMPORTANT: src_pq_buffer and dst_pq_buffer must NOT alias.\n165\t    fn _frac_compute_round_and_fold(\n166\t        eq_xi_low: *const EF,\n167\t        eq_xi_high: *const EF,\n168\t        src_pq_buffer: *const Frac<EF>,\n169\t        dst_pq_buffer: *mut Frac<EF>,\n170\t        src_pq_size: usize,\n171\t        eq_low_cap: usize,\n172\t        lambda: EF,\n173\t        r_prev: EF,\n174\t        out_device: *mut EF,\n175\t        tmp_block_sums: *mut EF,\n176\t    ) -> i32;\n177\t\n178\t    /// Fused compute round + fold (in-place). Reads from pre-fold pq_buffer (size src_pq_size),\n179\t    /// computes sumcheck sums, and writes folded output to the same buffer (first src_pq_size/2\n180\t    /// elements).\n181\t    fn _frac_compute_round_and_fold_inplace(\n182\t        eq_xi_low: *const EF,\n183\t        eq_xi_high: *const EF,\n184\t        pq_buffer: *mut Frac<EF>,\n185\t        src_pq_size: usize,\n186\t        eq_low_cap: usize,\n187\t        lambda: EF,\n188\t        r_prev: EF,\n189\t        out_device: *mut EF,\n190\t        tmp_block_sums: *mut EF,\n191\t    ) -> i32;\n192\t\n193\t    fn _frac_precompute_m_build(\n194\t        pq: *const Frac<EF>,\n195\t        rem_n: usize,\n196\t        w: usize,\n197\t        lambda: EF,\n198\t        r_prev: EF,\n199\t        inline_fold: bool,\n200\t        eq_tail_low: *const EF,\n201\t        eq_tail_high: *const EF,\n202\t        eq_tail_low_cap: usize,\n203\t        tail_tile: usize,\n204\t        partial_out: *mut EF,\n205\t        partial_len: usize,\n206\t        m_total: *mut EF,\n207\t    ) -> i32;\n208\t\n209\t    fn _frac_precompute_m_eval_round(\n210\t        m_total: *const EF,\n211\t        w: usize,\n212\t        t: usize,\n213\t        eq_r_prefix: *const EF,\n214\t        eq_suffix: *const EF,\n215\t        out: *mut EF,\n216\t    ) -> i32;\n217\t\n218\t    fn _frac_multifold(\n219\t        src: *const Frac<EF>,\n220\t        dst: *mut Frac<EF>,\n221\t        rem_n: usize,\n222\t        w: usize,\n223\t        eq_r_window: *const EF,\n224\t    ) -> i32;\n225\t\n226\t    fn _frac_add_alpha(data: *mut std::ffi::c_void, len: usize, alpha: EF) -> i32;\n227\t\n228\t    fn _frac_vector_scalar_multiply_ext_fp(frac_vec: *mut Frac<EF>, scalar: F, length: u32) -> i32;\n229\t\n230\t    // utils.cu\n231\t    fn _fold_ple_from_evals(\n232\t        input_matrix: *const F,\n233\t        output_matrix: *mut EF,\n234\t        omega_skip_pows: *const F,\n235\t        inv_lagrange_denoms: *const EF,\n236\t        height: u32,\n237\t        width: u32,\n238\t        l_skip: u32,\n239\t        new_height: u32,\n240\t        rotate: bool,\n241\t    ) -> i32;\n242\t\n243\t    fn _interpolate_columns(\n244\t        interpolated: *mut EF,\n245\t        columns: *const *const EF,\n246\t        s_deg: usize,\n247\t        num_y: usize,\n248\t        num_columns: usize,\n249\t    ) -> i32;\n250\t\n251\t    fn _batched_interpolate_columns(\n252\t        descs: *const InterpColDesc,\n253\t        all_columns: *const *const EF,\n254\t        s_deg: usize,\n255\t        num_descs: usize,\n256\t        total_blocks: usize,\n257\t    ) -> i32;\n258\t\n259\t    fn _frac_matrix_vertically_repeat(\n260\t        out: *mut Frac<EF>,\n261\t        input: *const Frac<EF>,\n262\t        width: u32,\n263\t        lifted_height: u32,\n264\t        height: u32,\n265\t    ) -> i32;\n266\t\n267\t    fn _frac_matrix_vertically_repeat_ext(\n268\t        out_numerators: *mut EF,\n269\t        out_denominators: *mut EF,\n270\t        in_numerators: *const EF,\n271\t        in_denominators: *const EF,\n272\t        width: u32,\n273\t        lifted_height: u32,\n274\t        height: u32,\n275\t    ) -> i32;\n276\t\n277\t    // gkr_input.cu\n278\t    fn _logup_gkr_input_eval(\n279\t        is_global: bool,\n280\t        fracs: *mut Frac<EF>,\n281\t        preprocessed: *const F,\n282\t        partitioned_main: *const u64,\n283\t        public_values: *const F,\n284\t        challenges: *const EF,\n285\t        intermediates: *const EF,\n286\t        rules: *const std::ffi::c_void,\n287\t        used_nodes: *const usize,\n288\t        pair_idxs: *const u32,\n289\t        used_nodes_len: usize,\n290\t        height: u32,\n291\t        num_rows_per_tile: u32,\n292\t    ) -> i32;\n293\t\n294\t    // logup_round0.cu\n295\t    pub fn _logup_r0_temp_sums_buffer_size(\n296\t        buffer_size: u32,\n297\t        skip_domain: u32,\n298\t        num_x: u32,\n299\t        num_cosets: u32,\n300\t        max_temp_bytes: usize,\n301\t    ) -> usize;\n302\t\n303\t    pub fn _logup_r0_intermediates_buffer_size(\n304\t        buffer_size: u32,\n305\t        skip_domain: u32,\n306\t        num_x: u32,\n307\t        num_cosets: u32,\n308\t        max_temp_bytes: usize,\n309\t    ) -> usize;\n310\t\n311\t    fn _logup_bary_eval_interactions_round0(\n312\t        tmp_sums_buffer: *mut Frac<EF>,\n313\t        output: *mut Frac<EF>,\n314\t        selectors_cube: *const F,\n315\t        preprocessed: *const F,\n316\t        main_parts: *const *const F,\n317\t        eq_cube: *const EF,\n318\t        public_values: *const F,\n319\t        numer_weights: *const EF,\n320\t        denom_weights: *const EF,\n321\t        denom_sum_init: EF,\n322\t        d_rules: *const std::ffi::c_void,\n323\t        rules_len: usize,\n324\t        buffer_size: u32,\n325\t        d_intermediates: *mut F,\n326\t        skip_domain: u32,\n327\t        num_x: u32,\n328\t        height: u32,\n329\t        num_cosets: u32,\n330\t        g_shift: F,\n331\t        max_temp_bytes: usize,\n332\t    ) -> i32;\n333\t\n334\t    // zerocheck_round0.cu\n335\t    pub fn _zerocheck_r0_temp_sums_buffer_size(\n336\t        buffer_size: u32,\n337\t        skip_domain: u32,\n338\t        num_x: u32,\n339\t        num_cosets: u32,\n340\t        max_temp_bytes: usize,\n341\t    ) -> usize;\n342\t\n343\t    pub fn _zerocheck_r0_intermediates_buffer_size(\n344\t        buffer_size: u32,\n345\t        skip_domain: u32,\n346\t        num_x: u32,\n347\t        num_cosets: u32,\n348\t        max_temp_bytes: usize,\n349\t    ) -> usize;\n350\t\n351\t    fn _zerocheck_ntt_eval_constraints(\n352\t        tmp_sums_buffer: *mut EF,\n353\t        output: *mut EF,\n354\t        selectors_cube: *const F,\n355\t        preprocessed: *const F,\n356\t        main_parts: *const *const F,\n357\t        eq_cube: *const EF,\n358\t        d_lambda_pows: *const EF,\n359\t        public_values: *const F,\n360\t        d_rules: *const std::ffi::c_void,\n361\t        rules_len: usize,\n362\t        d_used_nodes: *const usize,\n363\t        used_nodes_len: usize,\n364\t        lambda_len: usize,\n365\t        buffer_size: u32,\n366\t        d_intermediates: *mut F,\n367\t        skip_domain: u32,\n368\t        num_x: u32,\n369\t        height: u32,\n370\t        num_cosets: u32,\n371\t        g_shift: F,\n372\t        max_temp_bytes: usize,\n373\t    ) -> i32;\n374\t\n375\t    fn _fold_selectors_round0(\n376\t        out: *mut EF,\n377\t        input: *const F,\n378\t        is_first: EF,\n379\t        is_last: EF,\n380\t        num_x: u32,\n381\t    ) -> i32;\n382\t\n383\t    // mle.cu\n384\t    pub fn _zerocheck_mle_temp_sums_buffer_size(num_x: u32, num_y: u32) -> usize;\n385\t\n386\t    pub fn _zerocheck_mle_intermediates_buffer_size(\n387\t        buffer_size: u32,\n388\t        num_x: u32,\n389\t        num_y: u32,\n390\t    ) -> usize;\n391\t\n392\t    fn _zerocheck_eval_mle(\n393\t        tmp_sums_buffer: *mut EF,\n394\t        output: *mut EF,\n395\t        eq_xi: *const EF,\n396\t        selectors: *const EF,\n397\t        preprocessed: MainMatrixPtrs<EF>,\n398\t        main: *const MainMatrixPtrs<EF>,\n399\t        lambda_pows: *const EF,\n400\t        public_values: *const F,\n401\t        rules: *const std::ffi::c_void,\n402\t        rules_len: usize,\n403\t        used_nodes: *const usize,\n404\t        used_nodes_len: usize,\n405\t        lambda_len: usize,\n406\t        buffer_size: u32,\n407\t        intermediates: *mut EF,\n408\t        num_y: u32,\n409\t        num_x: u32,\n410\t    ) -> i32;\n411\t\n412\t    pub fn _logup_mle_temp_sums_buffer_size(num_x: u32, num_y: u32) -> usize;\n413\t\n414\t    pub fn _logup_mle_intermediates_buffer_size(buffer_size: u32, num_x: u32, num_y: u32) -> usize;\n415\t\n416\t    fn _logup_eval_mle(\n417\t        tmp_sums_buffer: *mut Frac<EF>,\n418\t        output: *mut Frac<EF>,\n419\t        eq_xi: *const EF,\n420\t        selectors: *const EF,\n421\t        preprocessed: MainMatrixPtrs<EF>,\n422\t        main: *const MainMatrixPtrs<EF>,\n423\t        challenges: *const EF,\n424\t        eq_3bs: *const EF,\n425\t        public_values: *const F,\n426\t        rules: *const std::ffi::c_void,\n427\t        used_nodes: *const usize,\n428\t        pair_idxs: *const u32,\n429\t        used_nodes_len: usize,\n430\t        buffer_size: u32,\n431\t        intermediates: *mut EF,\n432\t        num_y: u32,\n433\t        num_x: u32,\n434\t    ) -> i32;\n435\t\n436\t    // batch_mle.cu (batch kernels always use global intermediates when buffer_size > 0)\n437\t    pub fn _zerocheck_batch_mle_intermediates_buffer_size(\n438\t        buffer_size: u32,\n439\t        num_x: u32,\n440\t        num_y: u32,\n441\t    ) -> usize;\n442\t\n443\t    pub fn _logup_batch_mle_intermediates_buffer_size(\n444\t        buffer_size: u32,\n445\t        num_x: u32,\n446\t        num_y: u32,\n447\t    ) -> usize;\n448\t\n449\t    fn _zerocheck_batch_eval_mle(\n450\t        tmp_sums_buffer: *mut EF,\n451\t        output: *mut EF,\n452\t        block_ctxs: *const BlockCtx,\n453\t        zc_ctxs: *const ZerocheckCtx,\n454\t        air_block_offsets: *const u32,\n455\t        lambda_pows: *const EF,\n456\t        lambda_len: usize,\n457\t        num_blocks: u32,\n458\t        num_x: u32,\n459\t        num_airs: u32,\n460\t        threads_per_block: u32,\n461\t    ) -> i32;\n462\t\n463\t    fn _logup_batch_eval_mle(\n464\t        tmp_sums_buffer: *mut Frac<EF>,\n465\t        output: *mut Frac<EF>,\n466\t        block_ctxs: *const BlockCtx,\n467\t        logup_ctxs: *const LogupCtx,\n468\t        air_block_offsets: *const u32,\n469\t        num_blocks: u32,\n470\t        num_x: u32,\n471\t        num_airs: u32,\n472\t        threads_per_block: u32,\n473\t    ) -> i32;\n474\t\n475\t    fn _zerocheck_monomial_batched(\n476\t        tmp_sums: *mut EF,\n477\t        output: *mut EF,\n478\t        block_ctxs: *const BlockCtx,\n479\t        air_ctxs: *const MonomialAirCtx,\n480\t        air_block_offsets: *const u32,\n481\t        num_blocks: u32,\n482\t        num_x: u32,\n483\t        num_airs: u32,\n484\t        threads_per_block: u32,\n485\t    ) -> i32;\n486\t\n487\t    fn _zerocheck_monomial_par_y_batched(\n488\t        tmp_sums: *mut EF,\n489\t        output: *mut EF,\n490\t        block_ctxs: *const BlockCtx,\n491\t        air_ctxs: *const MonomialAirCtx,\n492\t        air_block_offsets: *const u32,\n493\t        num_blocks: u32,\n494\t        num_x: u32,\n495\t        num_airs: u32,\n496\t        chunk_size: u32,\n497\t        threads_per_block: u32,\n498\t    ) -> i32;\n499\t\n500\t    fn _precompute_lambda_combinations(\n501\t        out: *mut EF,\n502\t        headers: *const MonomialHeader,\n503\t        lambda_terms: *const LambdaTerm<F>,\n504\t        lambda_pows: *const EF,\n505\t        num_monomials: u32,\n506\t    ) -> i32;\n507\t\n508\t    // Logup monomial kernels\n509\t    fn _precompute_logup_numer_combinations(\n510\t        out: *mut EF,\n511\t        headers: *const MonomialHeader,\n512\t        terms: *const InteractionMonomialTerm<F>,\n513\t        eq_3bs: *const EF,\n514\t        num_monomials: u32,\n515\t    ) -> i32;\n516\t\n517\t    fn _precompute_logup_denom_combinations(\n518\t        out: *mut EF,\n519\t        headers: *const MonomialHeader,\n520\t        terms: *const InteractionMonomialTerm<F>,\n521\t        beta_pows: *const EF,\n522\t        eq_3bs: *const EF,\n523\t        num_monomials: u32,\n524\t    ) -> i32;\n525\t\n526\t    fn _logup_monomial_batched(\n527\t        tmp_sums: *mut Frac<EF>,\n528\t        output: *mut Frac<EF>,\n529\t        block_ctxs: *const BlockCtx,\n530\t        common_ctxs: *const LogupMonomialCommonCtx,\n531\t        numer_ctxs: *const LogupMonomialCtx,\n532\t        denom_ctxs: *const LogupMonomialCtx,\n533\t        air_block_offsets: *const u32,\n534\t        num_blocks: u32,\n535\t        num_x: u32,\n536\t        num_airs: u32,\n537\t        threads_per_block: u32,\n538\t    ) -> i32;\n539\t}\n540\t\n541\tpub unsafe fn interpolate_columns_gpu(\n542\t    interpolated: &DeviceBuffer<EF>,\n543\t    columns: &DeviceBuffer<*const EF>,\n544\t    s_deg: usize,\n545\t    num_y: usize,\n546\t) -> Result<(), CudaError> {\n547\t    CudaError::from_result(_interpolate_columns(\n548\t        interpolated.as_mut_ptr(),\n549\t        columns.as_ptr(),\n550\t        s_deg,\n551\t        num_y,\n552\t        columns.len(),\n553\t    ))\n554\t}\n555\t\n556\tpub unsafe fn batched_interpolate_columns_gpu(\n557\t    descs: &DeviceBuffer<InterpColDesc>,\n558\t    all_columns: &DeviceBuffer<*const EF>,\n559\t    s_deg: usize,\n560\t    total_blocks: usize,\n561\t) -> Result<(), CudaError> {\n562\t    CudaError::from_result(_batched_interpolate_columns(\n563\t        descs.as_ptr(),\n564\t        all_columns.as_ptr(),\n565\t        s_deg,\n566\t        descs.len(),\n567\t        total_blocks,\n568\t    ))\n569\t}\n570\t\n571\tpub unsafe fn frac_build_tree_layer(\n572\t    layer: &mut DeviceBuffer<Frac<EF>>,\n573\t    layer_size: usize,\n574\t    revert: bool,\n575\t    alpha: EF,\n576\t    apply_alpha: bool,\n577\t) -> Result<(), CudaError> {\n578\t    debug_assert!(layer.len() >= layer_size);\n579\t    CudaError::from_result(_frac_build_tree_layer(\n580\t        layer.as_mut_ptr(),\n581\t        layer_size,\n582\t        revert,\n583\t        alpha,\n584\t        apply_alpha,\n585\t    ))\n586\t}\n587\t\n588\t/// Fused two-layer tree build kernel.\n589\t/// `half_i1` = N >> (i+2), where i is the first of the two layers being fused.\n590\tpub unsafe fn frac_build_tree_two_layers(\n591\t    layer: &mut DeviceBuffer<Frac<EF>>,\n592\t    half_i1: usize,\n593\t) -> Result<(), CudaError> {\n594\t    CudaError::from_result(_frac_build_tree_two_layers(layer.as_mut_ptr(), half_i1))\n595\t}\n596\t\n597\t// `eq_xi` will not store evaluations for the first hypercube coordinate because the prover factors\n598\t// out the first eq term.\n599\t#[allow(clippy::too_many_arguments)]\n600\tpub unsafe fn frac_compute_round(\n601\t    eq_xi: &SqrtEqLayers,\n602\t    pq_buffer: &DeviceBuffer<Frac<EF>>,\n603\t    num_x: usize,\n604\t    lambda: EF,\n605\t    out_device: &mut DeviceBuffer<EF>,\n606\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n607\t) -> Result<(), CudaError> {\n608\t    let low_n = eq_xi.low_n();\n609\t    let high_n = eq_xi.high_n();\n610\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n611\t    debug_assert!(pq_buffer.len() >= 2 * num_x);\n612\t    #[cfg(debug_assertions)]\n613\t    {\n614\t        let len = tmp_block_sums.len();\n615\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n616\t        assert!(\n617\t            len >= required as usize,\n618\t            \"tmp_block_sums len={len} < required={required}\"\n619\t        );\n620\t    }\n621\t    CudaError::from_result(_frac_compute_round(\n622\t        eq_xi.low.get_ptr(low_n),\n623\t        eq_xi.high.get_ptr(high_n),\n624\t        pq_buffer.as_ptr(),\n625\t        num_x,\n626\t        1 << low_n,\n627\t        lambda,\n628\t        out_device.as_mut_ptr(),\n629\t        tmp_block_sums.as_mut_ptr(),\n630\t    ))\n631\t}\n632\t\n633\t/// Fused compute round + tree layer revert kernel.\n634\t///\n635\t/// Combines `frac_build_tree_layer(revert=true)` with `compute_round` for the first inner round.\n636\t/// The revert operation modifies `layer` in-place: `layer[i] = layer[i] - layer[i + half]` for `i <\n637\t/// half`.\n638\t///\n639\t/// This eliminates one kernel launch per outer round.\n640\t#[allow(clippy::too_many_arguments)]\n641\tpub unsafe fn frac_compute_round_and_revert(\n642\t    eq_xi: &SqrtEqLayers,\n643\t    layer: &mut DeviceBuffer<Frac<EF>>,\n644\t    num_x: usize,\n645\t    lambda: EF,\n646\t    out_device: &mut DeviceBuffer<EF>,\n647\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n648\t) -> Result<(), CudaError> {\n649\t    let low_n = eq_xi.low_n();\n650\t    let high_n = eq_xi.high_n();\n651\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n652\t    #[cfg(debug_assertions)]\n653\t    {\n654\t        let len = tmp_block_sums.len();\n655\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n656\t        assert!(\n657\t            len >= required as usize,\n658\t            \"tmp_block_sums len={len} < required={required}\"\n659\t        );\n660\t        assert!(layer.len() >= 2 * num_x, \"layer too small for pq_size\");\n661\t    }\n662\t    CudaError::from_result(_frac_compute_round_and_revert(\n663\t        eq_xi.low.get_ptr(low_n),\n664\t        eq_xi.high.get_ptr(high_n),\n665\t        layer.as_mut_ptr(),\n666\t        num_x,\n667\t        1 << low_n,\n668\t        lambda,\n669\t        out_device.as_mut_ptr(),\n670\t        tmp_block_sums.as_mut_ptr(),\n671\t    ))\n672\t}\n673\t\n674\t/// Folds `Frac<EF>` buffer. Pairs (idx, idx+quarter) and (idx+half, idx+3*quarter),\n675\t/// writes results to dst[idx] and dst[idx+quarter]. Output size is `size / 2`.\n676\t/// Safe for src == dst (in-place) because each thread handles disjoint indices.\n677\tpub unsafe fn fold_ef_frac_columns(\n678\t    src: &DeviceBuffer<Frac<EF>>,\n679\t    dst: &mut DeviceBuffer<Frac<EF>>,\n680\t    size: usize,\n681\t    r: EF,\n682\t) -> Result<(), CudaError> {\n683\t    debug_assert!(src.len() >= size);\n684\t    debug_assert!(dst.len() >= size / 2);\n685\t    CudaError::from_result(_frac_fold_fpext_columns(\n686\t        src.as_ptr(),\n687\t        dst.as_mut_ptr(),\n688\t        size,\n689\t        r,\n690\t    ))\n691\t}\n692\t\n693\t/// In-place fold. See [`fold_ef_frac_columns`] for details.\n694\tpub unsafe fn fold_ef_frac_columns_inplace(\n695\t    buffer: &mut DeviceBuffer<Frac<EF>>,\n696\t    size: usize,\n697\t    r: EF,\n698\t) -> Result<(), CudaError> {\n699\t    debug_assert!(buffer.len() >= size);\n700\t    let ptr = buffer.as_mut_ptr();\n701\t    CudaError::from_result(_frac_fold_fpext_columns(ptr, ptr, size, r))\n702\t}\n703\t\n704\t/// Fused compute round + fold kernel.\n705\t///\n706\t/// Reads from pre-fold `src_pq_buffer` (size `src_pq_size`), performs fold-on-the-fly using\n707\t/// `r_prev`, computes s' polynomial evaluations (degree 2), and writes folded output to\n708\t/// `dst_pq_buffer` (size `src_pq_size/2`).\n709\t///\n710\t/// This fuses the fold operation into the next round's compute, eliminating one kernel launch per\n711\t/// inner round and reducing memory traffic.\n712\t///\n713\t/// The eq_xi layers should have max_n = log2(src_pq_size / 4) = log2(post-fold num_x).\n714\t#[allow(clippy::too_many_arguments)]\n715\tpub unsafe fn frac_compute_round_and_fold(\n716\t    eq_xi: &SqrtEqLayers,\n717\t    src_pq_buffer: &DeviceBuffer<Frac<EF>>,\n718\t    dst_pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n719\t    src_pq_size: usize,\n720\t    lambda: EF,\n721\t    r_prev: EF,\n722\t    out_device: &mut DeviceBuffer<EF>,\n723\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n724\t) -> Result<(), CudaError> {\n725\t    let low_n = eq_xi.low_n();\n726\t    let high_n = eq_xi.high_n();\n727\t    // Post-fold: num_x = src_pq_size / 4\n728\t    let num_x = src_pq_size >> 2;\n729\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n730\t    #[cfg(debug_assertions)]\n731\t    {\n732\t        assert!(src_pq_size > 2, \"src_pq_size must be > 2\");\n733\t        let pq_size = src_pq_size >> 1;\n734\t        assert!(num_x > 0, \"num_x must be > 0\");\n735\t        assert!(\n736\t            src_pq_buffer.len() >= src_pq_size,\n737\t            \"src_pq_buffer too small: {} < {}\",\n738\t            src_pq_buffer.len(),\n739\t            src_pq_size\n740\t        );\n741\t        assert!(\n742\t            dst_pq_buffer.len() >= pq_size,\n743\t            \"dst_pq_buffer too small: {} < {}\",\n744\t            dst_pq_buffer.len(),\n745\t            pq_size\n746\t        );\n747\t        let len = tmp_block_sums.len();\n748\t        let required = _frac_compute_round_temp_buffer_size(num_x as u32);\n749\t        assert!(\n750\t            len >= required as usize,\n751\t            \"tmp_block_sums len={len} < required={required}\"\n752\t        );\n753\t    }\n754\t    CudaError::from_result(_frac_compute_round_and_fold(\n755\t        eq_xi.low.get_ptr(low_n),\n756\t        eq_xi.high.get_ptr(high_n),\n757\t        src_pq_buffer.as_ptr(),\n758\t        dst_pq_buffer.as_mut_ptr(),\n759\t        src_pq_size,\n760\t        1 << low_n,\n761\t        lambda,\n762\t        r_prev,\n763\t        out_device.as_mut_ptr(),\n764\t        tmp_block_sums.as_mut_ptr(),\n765\t    ))\n766\t}\n767\t\n768\t/// In-place fused compute round + fold kernel. See [`frac_compute_round_and_fold`] for details.\n769\t///\n770\t/// Uses a dedicated in-place kernel that doesn't have `__restrict__` on the pq pointer,\n771\t/// avoiding undefined behavior from aliased restrict pointers.\n772\t///\n773\t/// **IN-PLACE SAFETY:** Each thread writes only to indices it reads from in the first half of the\n774\t/// buffer, so there are no cross-thread conflicts. The second half is read-only.\n775\t#[allow(clippy::too_many_arguments)]\n776\tpub unsafe fn frac_compute_round_and_fold_inplace(\n777\t    eq_xi: &SqrtEqLayers,\n778\t    pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n779\t    src_pq_size: usize,\n780\t    lambda: EF,\n781\t    r_prev: EF,\n782\t    out_device: &mut DeviceBuffer<EF>,\n783\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n784\t) -> Result<(), CudaError> {\n785\t    let low_n = eq_xi.low_n();\n786\t    let high_n = eq_xi.high_n();\n787\t    // Post-fold: num_x = src_pq_size / 4\n788\t    let num_x = src_pq_size >> 2;\n789\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n790\t    #[cfg(debug_assertions)]\n791\t    {\n792\t        assert!(src_pq_size > 2, \"src_pq_size must be > 2\");\n793\t        assert!(num_x > 0, \"num_x must be > 0\");\n794\t        assert!(\n795\t            pq_buffer.len() >= src_pq_size,\n796\t            \"pq_buffer too small: {} < {}\",\n797\t            pq_buffer.len(),\n798\t            src_pq_size\n799\t        );\n800\t        let len = tmp_block_sums.len();"}]},"parent_tool_use_id":"toolu_01Dow5kdnwTUnFPtgNBsBTfw","session_id":"8752a685-980c-4a43-bd75-41a76d7996d5","uuid":"64d10fc8-5b91-492a-86a5-714e20bbcc48","timestamp":"2026-04-13T18:37:18.811Z"}
