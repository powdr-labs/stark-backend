{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0156fBHALzTy7rGATEqaCvSg","type":"tool_result","content":"1\t// GKR fractional sumcheck CUDA kernels. See docs/cuda-backend/gkr-prover.md (repo root)\n2\t// for the protocol and implementation details.\n3\t\n4\t#include \"fp.h\"\n5\t#include \"fpext.h\"\n6\t#include \"frac_ext.cuh\"\n7\t#include \"launcher.cuh\"\n8\t#include \"sumcheck.cuh\"\n9\t#include \"utils.cuh\"\n10\t#include <algorithm>\n11\t#include <cassert>\n12\t#include <cstddef>\n13\t#include <cstdint>\n14\t#include <cuda_runtime_api.h>\n15\t#include <driver_types.h>\n16\t#include <utility>\n17\t#include <vector_types.h>\n18\t\n19\t// Includes GKR for fractional sumcheck\n20\t// The LogUp specific input to GKR is calculated in interactions.cu\n21\tnamespace fractional_sumcheck_gkr {\n22\t// Degree of s' polynomial (factored out the first eq term)\n23\tconstexpr int GKR_SP_DEG = 2;\n24\t// ============================================================================\n25\t// KERNELS\n26\t// ============================================================================\n27\ttemplate <bool revert, bool apply_alpha = false>\n28\t__global__ void frac_build_tree_layer_kernel(\n29\t    FracExt *__restrict__ layer,\n30\t    uint32_t half,\n31\t    FpExt alpha = FpExt(Fp(0))\n32\t) {\n33\t    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;\n34\t    if (idx >= half) {\n35\t        return;\n36\t    }\n37\t\n38\t    if constexpr (apply_alpha) {\n39\t        // When applying alpha, we need to modify both operands before combining\n40\t        // Read both values, apply alpha to denominators, then combine\n41\t        FracExt lhs_val = layer[idx];\n42\t        FracExt rhs_val = layer[idx | half];\n43\t        lhs_val.q = lhs_val.q + alpha;\n44\t        rhs_val.q = rhs_val.q + alpha;\n45\t\n46\t        if constexpr (revert) {\n47\t            frac_unadd_inplace(lhs_val, rhs_val);\n48\t        } else {\n49\t            frac_add_inplace(lhs_val, rhs_val);\n50\t        }\n51\t\n52\t        layer[idx] = lhs_val;\n53\t    } else {\n54\t        // Original fast path: use references for in-place modification\n55\t        FracExt &lhs = layer[idx];\n56\t        FracExt const &rhs = layer[idx | half];\n57\t\n58\t        if constexpr (revert) {\n59\t            frac_unadd_inplace(lhs, rhs);\n60\t        } else {\n61\t            frac_add_inplace(lhs, rhs);\n62\t        }\n63\t    }\n64\t}\n65\t\n66\t// Reconstruct eq weight from sqrt-decomposed buffers.\n67\t// See docs/cuda-backend/gkr-prover.md § \"Eq buffer sqrt decomposition\".\n68\t__device__ __forceinline__ FpExt sqrt_buffer_get(\n69\t    const FpExt *__restrict__ eq_xi_low,\n70\t    const FpExt *__restrict__ eq_xi_high,\n71\t    uint32_t const log_eq_low_cap,\n72\t    uint32_t const idx\n73\t) {\n74\t    return eq_xi_low[idx & ((1u << log_eq_low_cap) - 1)] * eq_xi_high[idx >> log_eq_low_cap];\n75\t}\n76\t\n77\t// Accumulate GKR sumcheck contributions for s'_t(1) and s'_t(2).\n78\t// See docs/cuda-backend/gkr-prover.md § \"Sumcheck round implementation\".\n79\t__device__ __forceinline__ void accumulate_compute_contributions(\n80\t    const FpExt *__restrict__ eq_xi_low,\n81\t    const FpExt *__restrict__ eq_xi_high,\n82\t    uint32_t idx,\n83\t    uint32_t log_eq_low_cap,\n84\t    FpExt lambda,\n85\t    FpExt p0_even, FpExt q0_even, FpExt p0_odd, FpExt q0_odd,\n86\t    FpExt p1_even, FpExt q1_even, FpExt p1_odd, FpExt q1_odd,\n87\t    FpExt &local0, FpExt &local1\n88\t) {\n89\t    FpExt eq_val = sqrt_buffer_get(eq_xi_low, eq_xi_high, log_eq_low_cap, idx);\n90\t\n91\t    FpExt p0_diff = p0_odd - p0_even;\n92\t    FpExt q0_diff = q0_odd - q0_even;\n93\t    FpExt p1_diff = p1_odd - p1_even;\n94\t    FpExt q1_diff = q1_odd - q1_even;\n95\t\n96\t    FpExt p_j0 = p0_even + lambda * q0_even;\n97\t    FpExt q_j0 = q0_even;\n98\t    FpExt p_j1 = p1_even;\n99\t    FpExt q_j1 = q1_even;\n100\t\n101\t    auto const lambda_times_q0_diff = lambda * q0_diff;\n102\t\n103\t#pragma unroll\n104\t    for (int i = 0; i < GKR_SP_DEG; ++i) {\n105\t        p_j0 += p0_diff;\n106\t        p_j0 += lambda_times_q0_diff;\n107\t        q_j0 += q0_diff;\n108\t        p_j1 += p1_diff;\n109\t        q_j1 += q1_diff;\n110\t\n111\t        FpExt contrib = eq_val * (p_j0 * q_j1 + p_j1 * q_j0);\n112\t        if (i == 0) local0 += contrib;\n113\t        else local1 += contrib;\n114\t    }\n115\t}\n116\t\n117\t// Helper: Perform block reduction on two accumulators and write to block_sums.\n118\t__device__ __forceinline__ void reduce_block_sums(\n119\t    FpExt *shared,\n120\t    FpExt local0, FpExt local1,\n121\t    FpExt *__restrict__ block_sums\n122\t) {\n123\t    {\n124\t        FpExt reduced = sumcheck::block_reduce_sum(local0, shared);\n125\t        if (threadIdx.x == 0) block_sums[blockIdx.x * GKR_SP_DEG + 0] = reduced;\n126\t    }\n127\t    __syncthreads();\n128\t    {\n129\t        FpExt reduced = sumcheck::block_reduce_sum(local1, shared);\n130\t        if (threadIdx.x == 0) block_sums[blockIdx.x * GKR_SP_DEG + 1] = reduced;\n131\t    }\n132\t}\n133\t\n134\t// shared memory size requirement: max(num_warps,1) * sizeof(FpExt)\n135\t// Computes s' polynomial evaluations at 1 and 2 (first eq term factored out).\n136\t__global__ void compute_round_block_sum_kernel(\n137\t    const FpExt *__restrict__ eq_xi_low,\n138\t    const FpExt *__restrict__ eq_xi_high,\n139\t    const FracExt *__restrict__ pq_buffer,\n140\t    uint32_t num_x,\n141\t    uint32_t log_eq_low_cap,\n142\t    FpExt lambda,\n143\t    FpExt *__restrict__ block_sums // Output: [gridDim.x][2]\n144\t) {\n145\t    extern __shared__ FpExt shared[];\n146\t    const uint32_t pq_size = 2 * num_x;\n147\t\n148\t    const FpExt zero(Fp::zero());\n149\t    FpExt local[GKR_SP_DEG] = {zero, zero};\n150\t    uint32_t idx_base = threadIdx.x + blockIdx.x * blockDim.x;\n151\t    // Map phase: compute local sum by striding over grid\n152\t    for (uint32_t idx = idx_base; idx < num_x / 2; idx += blockDim.x * gridDim.x) {\n153\t        FpExt eq_val = sqrt_buffer_get(eq_xi_low, eq_xi_high, log_eq_low_cap, idx);\n154\t\n155\t        // \\hat p_j({0 or 1}, {even or odd}, ..y)\n156\t        // The {even=0, odd=1} evaluations are used to interpolate at 1, 2\n157\t        auto const &[p0_even, q0_even] = pq_buffer[idx];\n158\t        auto const &[p1_even, q1_even] = pq_buffer[with_rev_bits(idx, pq_size, 1, 0)];\n159\t        auto const &[p0_odd, q0_odd] = pq_buffer[with_rev_bits(idx, pq_size, 0, 1)];\n160\t        auto const &[p1_odd, q1_odd] = pq_buffer[with_rev_bits(idx, pq_size, 1, 1)];\n161\t\n162\t        FpExt p0_diff = p0_odd - p0_even;\n163\t        FpExt q0_diff = q0_odd - q0_even;\n164\t        FpExt p1_diff = p1_odd - p1_even;\n165\t        FpExt q1_diff = q1_odd - q1_even;\n166\t\n167\t        FpExt p_j0 = p0_even + lambda * q0_even;\n168\t        FpExt q_j0 = q0_even;\n169\t        FpExt p_j1 = p1_even;\n170\t        FpExt q_j1 = q1_even;\n171\t\n172\t        auto const lambda_times_q0_diff = lambda * q0_diff;\n173\t\n174\t#pragma unroll\n175\t        for (int i = 0; i < GKR_SP_DEG; ++i) {\n176\t            p_j0 += p0_diff;\n177\t            p_j0 += lambda_times_q0_diff;\n178\t            q_j0 += q0_diff;\n179\t            p_j1 += p1_diff;\n180\t            q_j1 += q1_diff;\n181\t\n182\t            local[i] += eq_val * (p_j0 * q_j1 + p_j1 * q_j0);\n183\t        }\n184\t    }\n185\t// Reduce phase: reduce all threadIdx.x in the same block, keeping 1,2 independent\n186\t#pragma unroll\n187\t    for (int i = 0; i < GKR_SP_DEG; ++i) {\n188\t        FpExt reduced = sumcheck::block_reduce_sum(local[i], shared);\n189\t\n190\t        if (threadIdx.x == 0) {\n191\t            block_sums[blockIdx.x * GKR_SP_DEG + i] = reduced;\n192\t        }\n193\t        __syncthreads();\n194\t    }\n195\t}\n196\t\n197\t// Fold kernel operating on FpExt* view of FracExt buffer.\n198\t// Since FracExt = {p, q} has p and q folded independently with the same formula,\n199\t// we can treat the