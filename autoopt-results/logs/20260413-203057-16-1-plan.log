8\t    assert(w > 0);\n1229\t    assert(t < w);\n1230\t\n1231\t    dim3 block(256);\n1232\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n1233\t    precompute_m_eval_round_kernel<<<1, block, shmem_bytes>>>(\n1234\t        m_total,\n1235\t        (uint32_t)w,\n1236\t        (uint32_t)t,\n1237\t        eq_r_prefix,\n1238\t        eq_suffix,\n1239\t        out\n1240\t    );\n1241\t    return CHECK_KERNEL();\n1242\t}\n1243\t\n1244\textern \"C\" int _frac_multifold(\n1245\t    const FracExt *src,\n1246\t    FracExt *dst,\n1247\t    size_t rem_n,\n1248\t    size_t w,\n1249\t    const FpExt *eq_r_window\n1250\t) {\n1251\t    assert(rem_n > 0);\n1252\t    assert(w > 0 && w <= rem_n);\n1253\t\n1254\t    size_t out_len = 1u << (rem_n - w);\n1255\t    auto [grid, block] = kernel_launch_params(out_len, 256);\n1256\t\n1257\t#define DISPATCH_MULTIFOLD(W) \\\n1258\t    multifold_kernel<W><<<grid, block>>>(src, dst, (uint32_t)out_len, eq_r_window); \\\n1259\t    return CHECK_KERNEL();\n1260\t\n1261\t    switch (w) {\n1262\t        case 2: { DISPATCH_MULTIFOLD(2) }\n1263\t        case 3: { DISPATCH_MULTIFOLD(3) }\n1264\t        case 4: { DISPATCH_MULTIFOLD(4) }\n1265\t        case 5: { DISPATCH_MULTIFOLD(5) }\n1266\t        default: assert(false && \"unsupported w for multifold\"); return -1;\n1267\t    }\n1268\t#undef DISPATCH_MULTIFOLD\n1269\t}\n1270\t\n1271\textern \"C\" int _frac_fold_fpext_columns(const FracExt *src, FracExt *dst, size_t size, FpExt r) {\n1272\t    if (size <= 2) {\n1273\t        return 0;\n1274\t    }\n1275\t    // FracExt = {p, q} = 2 FpExt elements.\n1276\t    // size is in FracExt; quarter_fpext is in FpExt.\n1277\t    // quarter_fpext = (size / 4) * 2 = size / 2\n1278\t    uint32_t quarter_fpext = size >> 1;\n1279\t    auto [grid, block] = kernel_launch_params(quarter_fpext);\n1280\t    fold_ef_columns_kernel<<<grid, block>>>(\n1281\t        reinterpret_cast<const FpExt *>(src), reinterpret_cast<FpExt *>(dst), quarter_fpext, r\n1282\t    );\n1283\t    return CHECK_KERNEL();\n1284\t}\n1285\t\n1286\textern \"C\" int _frac_add_alpha(FracExt *data, size_t len, FpExt alpha) {\n1287\t    auto [grid, block] = kernel_launch_params(len);\n1288\t    add_alpha_kernel<<<grid, block>>>(data, len, alpha);\n1289\t    return CHECK_KERNEL();\n1290\t}\n1291\t\n1292\textern \"C\" int _frac_vector_scalar_multiply_ext_fp(FracExt *frac_vec, Fp scalar, uint32_t length) {\n1293\t    auto [grid, block] = kernel_launch_params(length);\n1294\t    frac_vector_scalar_multiply_kernel<Fp, FpExt>\n1295\t        <<<grid, block>>>(reinterpret_cast<std::pair<FpExt, FpExt> *>(frac_vec), scalar, length);\n1296\t    return CHECK_KERNEL();\n1297\t}\n1298\t\n1299\t\n1300\t// ============================================================================\n1301\t// Fused bit-reversal + K=2 GKR tree-build\n1302\t// ============================================================================\n1303\t\n1304\t// bit_rev() and index_t redeclared from supra/include/ntt/{ntt.cuh,parameters.cuh}\n1305\t// because the supra include path is not on the cuda-backend build search path.\n1306\ttypedef unsigned int index_t;\n1307\ttemplate<typename T>\n1308\t__device__ __forceinline__\n1309\tT bit_rev(T i, unsigned int nbits)\n1310\t{\n1311\t    return __brev(i) >> (8 * sizeof(unsigned int) - nbits);\n1312\t}\n1313\t\n1314\t// Fused bit-reversal + K=2 GKR tree-build kernel for FracExt.\n1315\t//\n1316\t// DERIVED FROM: bit_rev_permutation_z<T, Z_COUNT> in supra/ntt_bitrev.cu.\n1317\t// Diff vs the original template kernel:\n1318\t//   - Z_COUNT = 8 hardcoded (not a template param)"}]},"parent_tool_use_id":"toolu_01PghPvmUt3KNf6ZWoFxogHs","session_id":"8752a685-980c-4a43-bd75-41a76d7996d5","uuid":"cf12f4c0-2b87-42e6-9454-17da1ce83a14","timestamp":"2026-04-13T18:37:45.818Z"}
