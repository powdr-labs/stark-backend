      let mut sp_head_zc = vec![EF::ZERO; constraint_degree];\n1531\t        let mut sp_head_logup = vec![EF::ZERO; constraint_degree];\n1532\t        let mut sp_tail = EF::ZERO;\n1533\t        for (trace_idx, &n) in self.n_per_trace.iter().enumerate() {\n1534\t            let n_lift = n.max(0) as usize;\n1535\t            let zc_idx = 2 * num_traces + trace_idx;\n1536\t            let numer_idx = 2 * trace_idx;\n1537\t            let denom_idx = numer_idx + 1;\n1538\t            if round == n_lift + 1 {\n1539\t                let eq_r_acc = *self.eq_ns.last().unwrap();\n1540\t                let eq_sharp_r_acc = *self.eq_sharp_ns.last().unwrap();\n1541\t                self.zerocheck_tilde_evals[trace_idx] *= eq_r_acc;\n1542\t                self.logup_tilde_evals[trace_idx][0] *= eq_sharp_r_acc;\n1543\t                self.logup_tilde_evals[trace_idx][1] *= eq_sharp_r_acc;\n1544\t            }\n1545\t            if round <= n_lift {\n1546\t                for i in 0..constraint_degree {\n1547\t                    sp_head_zc[i] += mu_pows[zc_idx] * sp_round_evals[zc_idx][i];\n1548\t                    sp_head_logup[i] += mu_pows[numer_idx] * sp_round_evals[numer_idx][i]\n1549\t                        + mu_pows[denom_idx] * sp_round_evals[denom_idx][i];\n1550\t                }\n1551\t            } else {\n1552\t                sp_tail += mu_pows[zc_idx] * self.zerocheck_tilde_evals[trace_idx]\n1553\t                    + mu_pows[numer_idx] * self.logup_tilde_evals[trace_idx][0]\n1554\t                    + mu_pows[denom_idx] * self.logup_tilde_evals[trace_idx][1];\n1555\t            }\n1556\t        }\n1557\t        let s_deg = constraint_degree + 1;\n1558\t        let l_skip = self.l_skip;\n1559\t        // With eq(xi,r) contributions\n1560\t        let mut sp_head_evals = vec![EF::ZERO; s_deg];\n1561\t        for i in 0..constraint_degree {\n1562\t            sp_head_evals[i + 1] = self.eq_ns[round - 1] * sp_head_zc[i]\n1563\t                + self.eq_sharp_ns[ro