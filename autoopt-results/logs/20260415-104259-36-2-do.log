mall AIRs (thread 0 gets items 0, N, 2N, ...; thread 1 gets\n1324\t            // items 1, N+1, 2N+1, ...). This balances both per-AIR fixed\n1325\t            // overhead (kernel launches) and height-proportional GPU kernel time\n1326\t            // without needing a calibrated cost model.\n1327\t            let mut thread_items: Vec<Vec<usize>> =\n1328\t                (0..num_threads).map(|_| Vec::new()).collect();\n1329\t            for (item_idx, _) in work_items.iter().enumerate() {\n1330\t                thread_items[item_idx % num_threads].push(item_idx);\n1331\t            }\n1332\t\n1333\t            // Capture shared references for the background precompute thread.\n1334\t            // All are immutable borrows that coexist with Round 0 work item borrows.\n1335\t            let pk_ref = self.pk;\n1336\t            let eq_3b_ref = &self.eq_3b_per_trace;\n1337\t            let d_beta_pows_ref = &self.d_beta_pows;\n1338\t            let beta_pows_ref = &self.beta_pows;\n1339\t            let per_trace_ref = &ctx.per_trace;\n1340\t\n1341\t            let precompute_result = std::thread::scope(|s| {\n1342\t                // Background thread: upload d_eq_3b + precompute logup combinations.\n1343\t                // These are only consumed during MLE rounds, not by Round 0, so they\n1344\t                // can run concurrently on the background thread's cudaStreamPerThread.\n1345\t                let precompute_handle = s.spawn(|| -> Result<(Vec<DeviceBuffer<EF>>, Vec<Option<LogupCombinations>>), LogupZerocheckError> {\n1346\t                    let d_eq_3b: Vec<DeviceBuffer<EF>> = eq_3b_ref\n1347\t                        .iter()\n1348\t                        .map(|eq_3bs| {\n1349\t                            if eq_3bs.is_empty() {\n1350\t                                Ok(DeviceBuffer::new())\n1351\t                            } else {\n1352\t                                eq_3bs.to_device().map_err(MemCopyError::from)\n1353\t                            