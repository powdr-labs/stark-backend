{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Va6EdPXc38p7zCmFgvpbHa","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    mem::size_of,\n15\t    sync::Arc,\n16\t};\n17\t\n18\tuse itertools::{izip, Itertools};\n19\tuse openvm_cuda_common::{\n20\t    copy::{MemCopyD2H, MemCopyH2D},\n21\t    d_buffer::DeviceBuffer,\n22\t    error::{CudaError, MemCopyError},\n23\t    memory_manager::MemTracker,\n24\t    stream::current_stream_sync,\n25\t};\n26\tuse openvm_stark_backend::{\n27\t    air_builders::symbolic::SymbolicConstraints,\n28\t    calculate_n_logup,\n29\t    dft::Radix2BowersSerial,\n30\t    p3_matrix::dense::RowMajorMatrix,\n31\t    poly_common::{\n32\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n33\t        UnivariatePoly,\n34\t    },\n35\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n36\t    prover::{\n37\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n38\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n39\t        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n40\t    },\n41\t};\n42\tuse p3_dft::TwoAdicSubgroupDft;\n43\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n44\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n45\tuse rustc_hash::FxHashMap;\n46\tuse tracing::{debug, info, info_span, instrument};\n47\t\n48\tuse crate::{\n49\t    base::DeviceMatrix,\n50\t    cuda::{\n51\t        logup_zerocheck::{\n52\t            batched_interpolate_columns_matrix_gpu, fold_selectors_round0, InterpMatrixInfo,\n53\t            InterpTraceDescM, MainMatrixPtrs,\n54\t        },\n55\t        sumcheck::batch_fold_mle,\n56\t    },\n57\t    data_transporter::transport_matrix_d2h_col_major,\n58\t    error::LogupZerocheckError,\n59\t    gpu_backend::GenericGpuBackend,\n60\t    hash_scheme::GpuHashScheme,\n61\t    cuda::logup_zerocheck::{\n62\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n63\t        _round0_extract_logup_polys, _round0_extract_zerocheck_poly,\n64\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n65\t    },\n66\t    logup_zerocheck::{\n67\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n68\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n69\t    },\n70\t    poly::EqEvalLayers,\n71\t    prelude::{EF, F},\n72\t    sponge::GpuFiatShamirTranscript,\n73\t    utils::compute_barycentric_inv_lagrange_denoms,\n74\t};\n75\t\n76\tpub(crate) mod batch_mle;\n77\tpub(crate) mod batch_mle_monomial;\n78\tmod errors;\n79\tpub(crate) mod fold_ple;\n80\t/// Fraction sumcheck via GKR\n81\tmod fractional;\n82\t/// Logup interaction evaluations for GKR input\n83\tmod gkr_input;\n84\tmod mle_round;\n85\tmod round0;\n86\tpub(crate) mod rules;\n87\t\n88\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n89\tuse batch_mle_monomial::{\n90\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n91\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n92\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n93\t};\n94\t