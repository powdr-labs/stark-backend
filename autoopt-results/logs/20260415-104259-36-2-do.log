uce_block.x, WARP_SIZE);\n    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n    dim3 reduce_grid(num_airs, d);\n    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n        reinterpret_cast<FpExt *>(tmp_sums_buffer),\n        reinterpret_cast<FpExt *>(output),\n        d_air_offsets, d\n    );\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _batched_logup_r0_eval_interactions(\n    FracExt *tmp_sums_buffer, FracExt *output,\n    const void *d_block_ctxs, const void *d_logup_ctxs,\n    const uint32_t *d_air_offsets,\n    uint32_t total_blocks, uint32_t num_airs,\n    uint32_t num_cosets, uint32_t skip_domain, uint32_t block_x\n) {\n    bool needs_shmem = skip_domain > WARP_SIZE;\n    if (needs_shmem) {\n        return launch_batched_logup_r0<true, true>(\n            tmp_sums_buffer, output,\n            reinterpret_cast<const Round0LogupBlockCtx *>(d_block_ctxs),\n            reinterpret_cast<const Round0LogupCtx *>(d_logup_ctxs),\n            d_air_offsets, total_blocks, num_airs, num_cosets, skip_domain, block_x\n        );\n    } else {\n        return launch_batched_logup_r0<true, false>(\n            tmp_sums_buffer, output,\n            reinterpret_cast<const Round0LogupBlockCtx *>(d_block_ctxs),\n            reinterpret_cast<const Round0LogupCtx *>(d_logup_ctxs),\n            d_air_offsets, total_blocks, num_airs, num_cosets, skip_domain, block_x\n        );\n    }\n}\n\n} // namespace logup_round0\n","structuredPatch":[{"oldStart":982,"oldLines":22,"newStart":982,"newLines":13,"lines":["     uint32_t total_blocks, uint32_t num_airs,","     uint32_t num_cosets, uint32_t skip_domain, uint32_t block_x"," ) {","-    bool needs_shmem = skip_domain > WARP_SIZE;","-    if (needs_shmem) {","-        return launch_batched_logup_r0<true, true>(","-            tmp_sums_buffer, output,","-            reinterpret_cast<const Round0LogupBlockCtx *>(d_block_ctxs),","-            reinterpret_cast<const Round0Log