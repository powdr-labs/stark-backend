compute buffer sizes for pre-allocation using a percentile threshold.\n1181\t        // Using the max would require enormous buffers (driven by a few large AIRs),\n1182\t        // causing GPU memory pressure that degrades all phases. The 95th percentile\n1183\t        // covers 95%+ of AIRs while keeping total allocation manageable. The few\n1184\t        // large AIRs above the threshold fall back to dynamic allocation.\n1185\t        let percentile_idx = |n: usize| -> usize { (n * 95 / 100).min(n.saturating_sub(1)) };\n1186\t        let (max_zc_intermed, max_zc_temp_sums, max_logup_intermed, max_logup_temp_sums) = {\n1187\t            let n = work_items.len();\n1188\t            let mut zc_i: Vec<usize> = work_items.iter().map(|w| w.zc_intermed_cap).collect();\n1189\t            let mut zc_t: Vec<usize> = work_items.iter().map(|w| w.zc_temp_sums_cap).collect();\n1190\t            let mut li: Vec<usize> = work_items.iter().map(|w| w.logup_intermed_cap).collect();\n1191\t            let mut lt: Vec<usize> = work_items.iter().map(|w| w.logup_temp_sums_cap).collect();\n1192\t            zc_i.sort_unstable();\n1193\t            zc_t.sort_unstable();\n1194\t            li.sort_unstable();\n1195\t            lt.sort_unstable();\n1196\t            let idx = percentile_idx(n);\n1197\t            (zc_i[idx], zc_t[idx], li[idx], lt[idx])\n1198\t        };\n1199\t\n1200\t        // Barrier: ensure all prior GPU work (trace uploads, pk data, selectors)\n1201\t        // is visible to worker thread streams.\n1202\t        current_stream_sync().map_err(MemCopyError::from)?;\n1203\t\n1204\t        // Phase 2: Process AIRs in parallel across N OS threads.\n1205\t        // Only use multi-threading when there are enough AIRs to benefit from concurrent\n1206\t        // kernel execution. With few large AIRs (e.g., APC 0 has ~20 per segment), each\n1207\t        // kernel already saturates the GPU and multi-threading adds memory pool overhead.\n1208\t        let mut num_threads = if