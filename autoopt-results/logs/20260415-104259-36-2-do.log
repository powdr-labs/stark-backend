{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018QXCHuUdFkkp4oz53avNxS","type":"tool_result","content":"1100\t                zc_intermed_cap,\n1101\t                zc_temp_sums_cap,\n1102\t                logup_intermed_cap,\n1103\t                logup_temp_sums_cap,\n1104\t                zc_batch_offset: 0,    // set after max_poly_len is computed\n1105\t                numer_batch_offset: 0,\n1106\t                denom_batch_offset: 0,\n1107\t            }\n1108\t        })\n1109\t        .collect();\n1110\t\n1111\t        // Sort by descending height for better load balance across thread chunks.\n1112\t        work_items.sort_by(|a, b| b.common_main.height().cmp(&a.common_main.height()));\n1113\t\n1114\t        // Pre-compute polynomial extraction transform matrices per unique constraint degree.\n1115\t        let skip_domain = 1usize << l_skip;\n1116\t        let mut extract_tables: FxHashMap<usize, Round0ExtractTables> = FxHashMap::default();\n1117\t        for w in &work_items {\n1118\t            let d = w.single_pk.vk.max_constraint_degree as usize;\n1119\t            if !extract_tables.contains_key(&d) {\n1120\t                extract_tables.insert(d, compute_round0_extract_tables(d, l_skip)?);\n1121\t            }\n1122\t        }\n1123\t\n1124\t        // Pre-allocate device batch polynomial array.\n1125\t        // All polynomial coefficients are written here by GPU extraction kernels,\n1126\t        // then copied to host in a single D2H transfer.\n1127\t        let max_poly_len = work_items\n1128\t            .iter()\n1129\t            .map(|w| {\n1130\t                let d = w.single_pk.vk.max_constraint_degree as usize;\n1131\t                let zc_len = sumcheck_round0_deg(l_skip, d) + 1;\n1132\t                let logup_len = d * skip_domain;\n1133\t                zc_len.max(logup_len)\n1134\t            })\n1135\t            .max()\n1136\t            .unwrap_or(0);\n1137\t\n1138\t        let batch_total = 3 * num