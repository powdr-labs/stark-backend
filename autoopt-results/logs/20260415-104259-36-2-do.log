{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QxrZRM1rPNRwcKZZd9gS9t","type":"tool_result","content":"244\tfn process_air_round0<HS: GpuHashScheme>(\n245\t    w: &Round0AirWorkItem<HS>,\n246\t    bufs: &mut round0::Round0ThreadBuffers,\n247\t    d_batch_ptr: *mut EF,\n248\t    extract_tables: &FxHashMap<usize, Round0ExtractTables>,\n249\t) -> Result<(), LogupZerocheckError> {\n250\t    let single_pk = w.single_pk;\n251\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n252\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n253\t    assert!(\n254\t        local_constraint_deg <= w.constraint_degree,\n255\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n256\t        w.constraint_degree\n257\t    );\n258\t\n259\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n260\t    let omega_root = F::two_adic_generator(log_large_domain);\n261\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n262\t\n263\t    let height = w.common_main.height();\n264\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n265\t    for committed in w.cached_mains {\n266\t        main_parts.push(committed.trace.buffer().as_ptr());\n267\t    }\n268\t    main_parts.push(w.common_main.buffer().as_ptr());\n269\t    let d_main_parts = main_parts.to_device()?;\n270\t\n271\t    let n_lift = w.n.max(0) as usize;\n272\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n273\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n274\t\n275\t    // Check if pre-allocated zerocheck buffers are large enough for this AIR\n276\t    let zc_prealloc_inter = if w.zc_intermed_cap > 0\n277\t        && bufs.zc_intermediates.len() >= w.zc_intermed_cap\n278\t    {\n279\t        Some(&mut bufs.zc_intermediates)\n280\t    } else {\n281\t        None\n282\t    };\n283\t    let zc_prealloc_temp = if w.zc_temp_sums_