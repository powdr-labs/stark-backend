54_enabled && path.file_name().is_some_and(|f| f == \"bn254_poseidon2.cu\") {\n            continue;\n        }\n        builder = builder.file(path);\n    }\n\n    builder.build();\n\n    common\n        .clone()\n        .library_name(\"supra_ntt\")\n        .include(\"cuda/supra/include\")\n        .files_from_glob(\"cuda/supra/*.cu\")\n        .build();\n}\n","structuredPatch":[{"oldStart":20,"oldLines":7,"newStart":20,"newLines":10,"lines":["         .clone()","         .library_name(\"cuda-backend\")","         .watch(\"cuda\")","-        .include(\"cuda/include\");","+        .include(\"cuda/include\")","+        // Prune NEEDS_SHMEM=true template variants from Round 0 kernels.","+        // Safe when skip_domain <= WARP_SIZE (l_skip <= 5, i.e., skip_domain <= 32).","+        .flag(\"-DPRUNE_SHMEM_KERNELS\");"," ","     // Collect .cu files, excluding bn254_poseidon2.cu unless the feature is enabled.","     let bn254_enabled = std::env::var(\"CARGO_FEATURE_BABY_BEAR_BN254_POSEIDON2\").is_ok();"]}],"userModified":false,"replaceAll":false}}
