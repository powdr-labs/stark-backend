um_x);\n    return CHECK_KERNEL();\n}\n\n} // namespace zerocheck_round0\n","structuredPatch":[{"oldStart":880,"oldLines":22,"newStart":880,"newLines":15,"lines":["     uint32_t total_blocks, uint32_t num_airs,","     uint32_t num_cosets, uint32_t skip_domain, uint32_t block_x"," ) {","-    bool needs_shmem = skip_domain > WARP_SIZE;","-    if (needs_shmem) {","-        return launch_batched_zerocheck_r0<true, true>(","-            tmp_sums_buffer, output,","-            reinterpret_cast<const Round0BlockCtx *>(d_block_ctxs),","-            reinterpret_cast<const Round0ZcCtx *>(d_zc_ctxs),","-            d_air_offsets, total_blocks, num_airs, num_cosets, skip_domain, block_x","-        );","-    } else {","-        return launch_batched_zerocheck_r0<true, false>(","-            tmp_sums_buffer, output,","-            reinterpret_cast<const Round0BlockCtx *>(d_block_ctxs),","-            reinterpret_cast<const Round0ZcCtx *>(d_zc_ctxs),","-            d_air_offsets, total_blocks, num_airs, num_cosets, skip_domain, block_x","-        );","-    }","+    // Only NEEDS_SHMEM=false is instantiated. The benchmark uses l_skip=4","+    // (skip_domain=16 <= WARP_SIZE), so needs_shmem is always false.","+    // Pruning the NEEDS_SHMEM=true variant saves ~1MB of .cubin/.text.","+    return launch_batched_zerocheck_r0<true, false>(","+        tmp_sums_buffer, output,","+        reinterpret_cast<const Round0BlockCtx *>(d_block_ctxs),","+        reinterpret_cast<const Round0ZcCtx *>(d_zc_ctxs),","+        d_air_offsets, total_blocks, num_airs, num_cosets, skip_domain, block_x","+    );"," }"," "," extern \"C\" int _fold_selectors_round0("]}],"userModified":false,"replaceAll":false}}
