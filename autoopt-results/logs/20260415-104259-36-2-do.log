essed, ctx.main_parts, ctx.public_values,","+        inter_buffer, ntt_buffer, {omega_shift},","+        skip_domain, ctx.height, buffer_stride, ctx.buffer_size, ntt_idx,","+    };","+","+    uint32_t x_int = x_int_base;","+    if (x_int < ctx.num_x) {","+        Fp is_first = is_first_mult * ctx.selectors_cube[x_int];","+        Fp is_last = is_last_mult * ctx.selectors_cube[2 * ctx.num_x + x_int];","+","+        FpExt constraint_sums[1];","+        acc_constraints<1, NEEDS_SHMEM>(","+            constraint_sums, eval_ctx, &is_first, &is_last, x_int,","+            ctx.lambda_pows, ctx.d_rules, ctx.rules_len,","+            ctx.d_used_nodes, ctx.used_nodes_len, ctx.lambda_len","+        );","+        sum = constraint_sums[0] * ctx.eq_cube[x_int];","+    }","+","+    Fp zerofier = exp_power_of_2(eval_point, l_skip) - Fp::one();","+    shared_sum[threadIdx.x] = sum * inv(zerofier);","+    __syncthreads();","+","+    if (threadIdx.x < skip_domain) {","+        FpExt tile_sum = shared_sum[threadIdx.x];","+        for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {","+            tile_sum += shared_sum[(lane << l_skip) + threadIdx.x];","+        }","+        tmp_sums_buffer[blockIdx.x * num_cosets * skip_domain + coset_idx * skip_domain + ntt_idx] =","+            tile_sum;","+    }","+}","+","+template <bool GLOBAL, bool NEEDS_SHMEM>","+int launch_batched_zerocheck_r0(","+    FpExt *tmp_sums_buffer, FpExt *output,","+    const Round0BlockCtx *d_block_ctxs, const Round0ZcCtx *d_zc_ctxs,","+    const uint32_t *d_air_offsets,","+    uint32_t total_blocks, uint32_t num_airs,","+    uint32_t num_cosets, uint32_t skip_domain, uint32_t block_x","+) {","+    if (total_blocks == 0) return 0;","+","+    dim3 grid(total_blocks);","+    dim3 block(block_x);","+    size_t shared_sum_size = sizeof(FpExt) * block_x;","+    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block_x : 0;","+    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;","+","+    batched_z