52\t    debug_assert!(omega_skip_pows.len() >= skip_domain);\n153\t    debug_assert!(inv_lagrange_denoms.len() >= skip_domain);\n154\t    check(_stacked_reduction_fold_ple(\n155\t        src,\n156\t        dst,\n157\t        omega_skip_pows.as_ptr(),\n158\t        inv_lagrange_denoms.as_ptr(),\n159\t        trace_height as u32,\n160\t        trace_width as u32,\n161\t        l_skip as u32,\n162\t    ))\n163\t}\n164\t\n165\t/// Initializes the `k_rot` evaluations after round 0 for `n = 0..=max_n`.\n166\t///\n167\t/// # Safety\n168\t/// - `eq_r_ns` and `k_rot_ns` should both have length `2 * 2^max_n` and be arranged in segments.\n169\t/// - This function will not initialize `k_rot_ns[0]`. This entry should never be used, and it is\n170\t///   the caller's responsibility to initialize it if needed.\n171\tpub unsafe fn initialize_k_rot_from_eq_segments(\n172\t    eq_r_ns: &EqEvalSegments<EF>,\n173\t    k_rot_ns: &mut DeviceBuffer<EF>,\n174\t    k_rot_uni_0: EF,\n175\t    k_rot_uni_1: EF,\n176\t    max_n: u32,\n177\t) -> Result<(), CudaError> {\n178\t    debug_assert_eq!(eq_r_ns.buffer.len(), 2 << max_n);\n179\t    debug_assert_eq!(k_rot_ns.len(), eq_r_ns.buffer.len());\n180\t\n181\t    check(_initialize_k_rot_from_eq_segments(\n182\t        eq_r_ns.buffer.as_ptr(),\n183\t        k_rot_ns.as_mut_ptr(),\n184\t        k_rot_uni_0,\n185\t        k_rot_uni_1,\n186\t        max_n,\n187\t    ))\n188\t}\n189\t\n190\t/// Analog of [stacked_reduction_sumcheck_round0] for MLE sumcheck rounds.\n191\t/// One important distinction is that `k_rot_ns` needs to be provided separately from `eq_r_ns`, but\n192\t/// in the same segmented memory layout.\n193\t///\n194\t/// Uses warp-aggregated atomics for reduction into u64 accumulators. The caller is responsible for\n195\t/// zero-initializing `output` before calling and reducing modulo P after kernel completion.\n196\t///\n197\t/// # Safety\n198\t/// - `q_evals` must be pointers to DeviceBuffer<EF> matrices all of the same height `q_heigh