{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PQDa4UsgNkGuYqT1ikxBJY","type":"tool_result","content":"1570\t    #[instrument(\n1571\t        name = \"LogupZerocheck::sumcheck_polys_batch_eval\",\n1572\t        level = \"info\",\n1573\t        skip_all,\n1574\t        fields(round = round)\n1575\t    )]\n1576\t    fn sumcheck_polys_batch_eval(\n1577\t        &mut self,\n1578\t        round: usize,\n1579\t        r_prev: EF,\n1580\t    ) -> Result<Vec<Vec<EF>>, LogupZerocheckError> {\n1581\t        let sp_deg = self.constraint_degree;\n1582\t\n1583\t        // Per-trace outputs (filled as we go)\n1584\t        let mut zc_out: Vec<Vec<EF>> = vec![vec![EF::ZERO; sp_deg]; self.n_per_trace.len()];\n1585\t        let mut logup_out: Vec<[Vec<EF>; 2]> =\n1586\t            vec![[vec![EF::ZERO; sp_deg], vec![EF::ZERO; sp_deg]]; self.n_per_trace.len()];\n1587\t\n1588\t        let mut late_eval: Vec<TraceCtx> = Vec::new(); // round == n_lift + 1\n1589\t        let mut early_eval: Vec<TraceCtx> = Vec::new(); // round <= n_lift\n1590\t\n1591\t        // ── Phase 1: Collect metadata, split into Case A / Case B (no CUDA calls) ──\n1592\t        // For Case B traces, we collect column pointers and sizing info to batch the\n1593\t        // interpolation into a single kernel launch.\n1594\t        struct CaseBMeta {\n1595\t            trace_idx: usize,\n1596\t            air_idx: usize,\n1597\t            n_lift: usize,\n1598\t            num_y: usize,\n1599\t            num_columns: usize, // total columns (selectors + preprocessed + mains)\n1600\t            interp_offset: usize, // element offset within the big interpolated buffer\n1601\t            matrix_offset: usize, // start index in the all_matrices array\n1602\t            num_matrices: usize,  // number of matrices for this trace\n1603\t            has_preprocessed: bool,\n1604\t            need_rot: bool,\n1605\t            has_constraints: bool,\n1606\t            has_interactions: bool,\n1607\t            norm_factor: F,\n1608\t        }\n1609\t        let mut case_b_traces: Vec<CaseBMeta> = Vec::new();\n1610\t        let mut all_matrices: Vec<InterpMatrixInfo> = Vec::new();\n1611\t        let mut total_interp_elems: usize = 0;\n1612\t\n1613\t        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n1614\t            self.n_per_trace.iter(),\n1615\t            self.mat_evals_per_trace.iter(),\n1616\t            self.sels_per_trace.iter(),\n1617\t            self.d_eq_3b_per_trace.iter(),\n1618\t            self.public_values_per_trace.iter(),\n1619\t            self.air_indices_per_trace.iter()\n1620\t        )\n1621\t        .enumerate()\n1622\t        {\n1623\t            let pk = &self.pk.per_air[air_idx];\n1624\t            let dag = &pk.vk.symbolic_constraints;\n1625\t            let has_constraints = dag.constraints.num_constraints() > 0;\n1626\t            let has_interactions = !dag.interactions.is_empty();\n1627\t            if !has_constraints && !has_interactions {\n1628\t                continue;\n1629\t            }\n1630\t\n1631\t            let n_lift = n.max(0) as usize;\n1632\t            let norm_factor_denom = 1 << (-n).max(0);\n1633\t            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n1634\t            let has_preprocessed = pk.preprocessed_data.is_some();\n1635\t            let need_rot = pk.vk.params.need_rot;\n1636\t            let first_main_idx = usize::from(has_preprocessed);\n1637\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n1638\t\n1639\t            if round > n_lift {\n1640\t                // Case A\n1641\t                if round == n_lift + 1 {\n1642\t                    // A.1: evaluate directly at (num_x=1, num_y=1)\n1643\t                    let prep_ptr = if has_preprocessed {\n1644\t                        MainMatrixPtrs {\n1645\t                            data: mats[0].buffer().as_ptr(),\n1646\t                            air_width: air_width_for_mat(need_rot, mats[0].width()),\n1647\t                        }\n1648\t                    } else {\n1649\t                        MainMatrixPtrs {\n1650\t                            data: std::ptr::null(),\n1651\t                            air_width: 0,\n1652\t                        }\n1653\t                    };\n1654\t                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1655\t                        .iter()\n1656\t                        .map(|m| MainMatrixPtrs {\n1657\t                            data: m.buffer().as_ptr(),\n1658\t                            air_width: air_width_for_mat(need_rot, m.width()),\n1659\t                        })\n1660\t                        .collect_vec();\n1661\t                    let main_ptrs_dev = main_ptrs.to_device()?;\n1662\t\n1663\t                    late_eval.push(TraceCtx {\n1664\t                        trace_idx,\n1665\t                        air_idx,\n1666\t                        n_lift,\n1667\t                        num_y: 1,\n1668\t                        has_constraints,\n1669\t                        has_interactions,\n1670\t                        norm_factor,\n1671\t                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n1672\t                        sels_ptr: sels.buffer().as_ptr(),\n1673\t                        prep_ptr,\n1674\t                        main_ptrs_dev,\n1675\t                        public_ptr: public_vals.as_ptr(),\n1676\t                        eq_3bs_ptr: eq_3bs.as_ptr(),\n1677\t                    });\n1678\t                } else {\n1679\t                    // A.2: scale tilde evals only\n1680\t                    if has_constraints {\n1681\t                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n1682\t                        *tilde_eval *= r_prev;\n1683\t                    }\n1684\t                    if has_interactions {\n1685\t                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n1686\t                            *x *= r_prev;\n1687\t                        }\n1688\t                    }\n1689\t                }\n1690\t            } else {\n1691\t                // Case B: collect metadata for batched interpolation\n1692\t                let log_num_y = n_lift - round;\n1693\t                let num_y = 1 << log_num_y;\n1694\t                let height = 2 * num_y;\n1695\t                debug_assert_eq!(height, mats[0].height());\n1696\t\n1697\t                let matrix_offset = all_matrices.len();\n1698\t                // Collect per-matrix base pointers: selectors + all matrices (preprocessed + mains)\n1699\t                debug_assert_eq!(sels.height(), height);\n1700\t                all_matrices.push(InterpMatrixInfo {\n1701\t                    base: sels.buffer().as_ptr(),\n1702\t                    width: sels.width() as u32,\n1703\t                });\n1704\t                for m in mats.iter() {\n1705\t                    debug_assert_eq!(m.height(), height);\n1706\t                    all_matrices.push(InterpMatrixInfo {\n1707\t                        base: m.buffer().as_ptr(),\n1708\t                        width: m.width() as u32,\n1709\t                    });\n1710\t                }\n1711\t                let num_matrices = 1 + mats.len();\n1712\t                let num_columns = sels.width() + mats.iter().map(|m| m.width()).sum::<usize>();\n1713\t                let interp_size = sp_deg * num_y * num_columns;\n1714\t\n1715\t                case_b_traces.push(CaseBMeta {\n1716\t                    trace_idx,\n1717\t                    air_idx,\n1718\t                    n_lift,\n1719\t                    num_y,\n1720\t                    num_columns,\n1721\t                    interp_offset: total_interp_elems,\n1722\t                    matrix_offset,\n1723\t                    num_matrices,\n1724\t                    has_preprocessed,\n1725\t                    need_rot,\n1726\t                    has_constraints,\n1727\t                    has_interactions,\n1728\t                    norm_factor,\n1729\t                });\n1730\t                total_interp_elems += interp_size;\n1731\t            }\n1732\t        }\n1733\t\n1734\t        // ── Phase 2: Batch allocate + single kernel launch ──\n1735\t        // One big buffer for all interpolated data, one kernel launch for all Case B traces.\n1736\t        let _keepalive_interpolated = if !case_b_traces.is_empty() {\n1737\t            let big_buf = DeviceBuffer::<EF>::with_capacity(total_interp_elems);\n1738\t            let big_ptr = big_buf.as_mut_ptr();\n1739\t\n1740\t            // Build descriptors with multi-block-per-trace assignment\n1741\t            const THREADS_PER_BLOCK: u32 = 512;\n1742\t            let mut block_offset: u32 = 0;\n1743\t            let descs: Vec<InterpTraceDescM> = case_b_traces\n1744\t                .iter()\n1745\t                .map(|meta| {\n1746\t                    let total_threads = (meta.num_y * meta.num_columns) as u32;\n1747\t                    let blocks = total_threads.div_ceil(THREADS_PER_BLOCK);\n1748\t                    let desc = InterpTraceDescM {\n1749\t                        output: unsafe { big_ptr.add(meta.interp_offset) },\n1750\t                        matrix_offset: meta.matrix_offset as u32,\n1751\t                        num_matrices: meta.num_matrices as u32,\n1752\t                        num_y: meta.num_y as u32,\n1753\t                        num_columns: meta.num_columns as u32,\n1754\t                        total_threads,\n1755\t                        block_start: block_offset,\n1756\t                    };\n1757\t                    block_offset += blocks;\n1758\t                    desc\n1759\t                })\n1760\t                .collect();\n1761\t            let total_blocks = block_offset as usize;\n1762\t\n1763\t            let d_matrices = all_matrices.to_device()?;\n1764\t            let d_descs = descs.to_device()?;\n1765\t            unsafe {\n1766\t                batched_interpolate_columns_matrix_gpu(\n1767\t                    &d_descs,\n1768\t                    &d_matrices,\n1769\t                    sp_deg,\n1770\t                    total_blocks,\n1771\t                )\n1772\t                .map_err(|e| LogupZerocheckError::InterpolateColumns(e.into()))?;\n1773\t            }\n1774\t\n1775\t            Some(big_buf)\n1776\t        } else {\n1777\t            None\n1778\t        };\n1779\t\n1780\t        // ── Phase 3: Build TraceCtx for each Case B trace ──\n1781\t        for meta in &case_b_traces {\n1782\t            let mats = &self.mat_evals_per_trace[meta.trace_idx];\n1783\t            let first_main_idx = usize::from(meta.has_preprocessed);\n1784\t            let eq_xi_tree = &self.eq_xis[&meta.n_lift];\n1785\t            let log_num_y = meta.n_lift - round;\n1786\t            let interpolated_height = sp_deg * meta.num_y;\n1787\t\n1788\t            let base_ptr = _keepalive_interpolated\n1789\t                .as_ref()\n1790\t                .unwrap()\n1791\t                .as_ptr()\n1792\t                .wrapping_add(meta.interp_offset);\n1793\t\n1794\t            let mut widths_so_far = 0usize;\n1795\t            let sels_ptr = base_ptr.wrapping_add(widths_so_far * interpolated_height);\n1796\t            widths_so_far += 3; // selector width is always 3\n1797\t\n1798\t            let prep_ptr = if meta.has_preprocessed {\n1799\t                MainMatrixPtrs {\n1800\t                    data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1801\t                    air_width: air_width_for_mat(meta.need_rot, mats[0].width()),\n1802\t                }\n1803\t            } else {\n1804\t                MainMatrixPtrs {\n1805\t                    data: std::ptr::null(),\n1806\t                    air_width: 0,\n1807\t                }\n1808\t            };\n1809\t            if meta.has_preprocessed {\n1810\t                widths_so_far += mats[0].width();\n1811\t            }\n1812\t            let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1813\t                .iter()\n1814\t                .map(|m| {\n1815\t                    let main_ptr = MainMatrixPtrs {\n1816\t                        data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1817\t                        air_width: air_width_for_mat(meta.need_rot, m.width()),\n1818\t                    };\n1819\t                    widths_so_far += m.width();\n1820\t                    main_ptr\n1821\t                })\n1822\t                .collect_vec();\n1823\t            debug_assert_eq!(widths_so_far, meta.num_columns);\n1824\t            let main_ptrs_dev = main_ptrs.to_device()?;\n1825\t\n1826\t            early_eval.push(TraceCtx {\n1827\t                trace_idx: meta.trace_idx,\n1828\t                air_idx: meta.air_idx,\n1829\t                n_lift: meta.n_lift,\n1830\t                num_y: meta.num_y as u32,\n1831\t                has_constraints: meta.has_constraints,\n1832\t                has_interactions: meta.has_interactions,\n1833\t                norm_factor: meta.norm_factor,\n1834\t                eq_xi_ptr: eq_xi_tree.get_ptr(log_num_y),\n1835\t                sels_ptr,\n1836\t                prep_ptr,\n1837\t                main_ptrs_dev,\n1838\t                public_ptr: self.public_values_per_trace[meta.trace_idx].as_ptr(),\n1839\t                eq_3bs_ptr: self.d_eq_3b_per_trace[meta.trace_idx].as_ptr(),\n1840\t            });\n1841\t        }\n1842\t\n1843\t        let d_challenges_ptr = self.d_challenges.as_ptr();\n1844\t\n1845\t        // Late traces (num_y=1): always use monomial\n1846\t        let late_logup_traces: Vec<_> = late_eval.iter().filter(|t| t.has_interactions).collect();\n1847\t        if !late_logup_traces.is_empty() {\n1848\t            let logup_combs: Vec<_> = late_logup_traces\n1849\t                .iter()\n1850\t                .map(|t| {\n1851\t                    self.logup_combinations[t.trace_idx]\n1852\t                        .as_ref()\n1853\t                        .expect(\"missing logup monomial combinations for late trace\")\n1854\t                })\n1855\t                .collect();\n1856\t            let batch =\n1857\t                LogupMonomialBatch::new(late_logup_traces.iter().copied(), self.pk, &logup_combs)?;\n1858\t            let out = batch\n1859\t                .evaluate(1)\n1860\t                .map_err(LogupZerocheckError::MleInteractionEval)?;\n1861\t            let host = out.to_host()?;\n1862\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1863\t                self.logup_tilde_evals[trace_idx][0] = host[i].p * late_logup_traces[i].norm_factor;\n1864\t                self.logup_tilde_evals[trace_idx][1] = host[i].q;\n1865\t            }\n1866\t        }\n1867\t        let late_mono_traces: Vec<_> = late_eval\n1868\t            .iter()\n1869\t            .filter(|t| trace_has_monomials(t, self.pk))\n1870\t            .collect();\n1871\t        if !late_mono_traces.is_empty() {\n1872\t            let lambda_combs: Vec<_> = late_mono_traces\n1873\t                .iter()\n1874\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1875\t                .collect();\n1876\t            let batch = ZerocheckMonomialBatch::new(late_mono_traces, self.pk, &lambda_combs)?;\n1877\t            let out = batch\n1878\t                .evaluate(1)\n1879\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1880\t            let host = out.to_host()?;\n1881\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1882\t                self.zerocheck_tilde_evals[trace_idx] = host[i];\n1883\t                // zc_out not set for num_x=1, handled from tilde_eval in compute_batch_s\n1884\t            }\n1885\t        }\n1886\t\n1887\t        // Logup for early traces: partition by num_y threshold\n1888\t        if !early_eval.is_empty() {\n1889\t            evaluate_logup_batched(\n1890\t                &early_eval,\n1891\t                self.pk,\n1892\t                d_challenges_ptr,\n1893\t                sp_deg as u32,\n1894\t                self.monomial_num_y_threshold,\n1895\t                &self.logup_combinations,\n1896\t                &mut logup_out,\n1897\t                &mut self.logup_tilde_evals,\n1898\t                self.memory_limit_bytes,\n1899\t            )\n1900\t            .map_err(LogupZerocheckError::MleInteractionEval)?;\n1901\t        }\n1902\t\n1903\t        // Early traces (num_y>1): partition by threshold for zerocheck path\n1904\t        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n1905\t            .iter()\n1906\t            .filter(|t| t.has_constraints)\n1907\t            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n1908\t\n1909\t        // Partition high num_y traces by monomial-to-rules ratio\n1910\t        // (traces without monomials are skipped - they contribute zero)\n1911\t        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n1912\t            high_early.iter().partition(|t| {\n1913\t                let num_monomials = get_num_monomials(t, self.pk);\n1914\t                let rules_len = get_zerocheck_rules_len(t, self.pk);\n1915\t                // Use DAG when monomial expansion significantly increased the term count\n1916\t                num_monomials as usize >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len\n1917\t            });\n1918\t\n1919\t        // DAG evaluation for high num_y traces with high monomial-to-rules ratio\n1920\t        if !high_dag_traces.is_empty() {\n1921\t            let lambda_pows = self.lambda_pows.as_ref().unwrap();\n1922\t            evaluate_zerocheck_batched(\n1923\t                high_dag_traces,\n1924\t                self.pk,\n1925\t                lambda_pows,\n1926\t                sp_deg as u32,\n1927\t                &mut zc_out,\n1928\t                self.memory_limit_bytes,\n1929\t            )\n1930\t            .map_err(LogupZerocheckError::MleConstraintEval)?;\n1931\t        }\n1932\t\n1933\t        // Par-Y monomial kernel for high num_y traces\n1934\t        if !high_mono_traces.is_empty() {\n1935\t            let lambda_combs: Vec<_> = high_mono_traces\n1936\t                .iter()\n1937\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1938\t                .collect();\n1939\t            let batch = ZerocheckMonomialParYBatch::new(\n1940\t                high_mono_traces,\n1941\t                self.pk,\n1942\t                &lambda_combs,\n1943\t                self.sm_count,\n1944\t                sp_deg as u32,\n1945\t                None,\n1946\t            )?;\n1947\t            let out = batch\n1948\t                .evaluate(sp_deg as u32)\n1949\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1950\t            let host = out.to_host()?;\n1951\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1952\t                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n1953\t            }\n1954\t        }\n1955\t\n1956\t        // Monomial zerocheck for low num_y traces\n1957\t        let low_mono_traces = low_early;\n1958\t        if !low_mono_traces.is_empty() {\n1959\t            let lambda_combs: Vec<_> = low_mono_traces\n1960\t                .iter()\n1961\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1962\t                .collect();\n1963\t            let batch = ZerocheckMonomialBatch::new(low_mono_traces, self.pk, &lambda_combs)?;\n1964\t            let out = batch\n1965\t                .evaluate(sp_deg as u32)\n1966\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1967\t            let host = out.to_host()?;\n1968\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1969\t                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n1970\t            }\n1971\t        }\n1972\t\n1973\t        Ok(logup_out.into_iter().flatten().chain(zc_out).collect())\n1974\t    }\n1975\t\n1976\t    #[instrument(level = \"debug\", skip_all, fields(round = round))]\n1977\t    fn compute_batch_s_poly(\n1978\t        &mut self,\n1979\t        sp_round_evals: Vec<Vec<EF>>,"}]},"parent_tool_use_id":"toolu_01J7JmRX3Q7dxkz9uS1mDyLK","session_id":"5bb7d674-211a-472f-a536-7708d797558d","uuid":"5830f0ab-86b9-4332-b4de-16e1e8ce9676","timestamp":"2026-04-15T02:59:12.038Z"}
