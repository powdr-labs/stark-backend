r * ELEM_PER_DIGEST;\n208\t    uint64_t output_layer_offset = layer_idx * ELEM_PER_DIGEST + elem_offset;\n209\t    d_digest_matrix[output_query_offset + output_layer_offset] = digest_elem;\n210\t}\n211\t\n212\t// LAUNCHERS\n213\t\n214\textern \"C\" int _poseidon2_compressing_row_hashes(\n215\t    digest_t *out,\n216\t    const Fp *matrix,\n217\t    size_t width,\n218\t    size_t query_stride,\n219\t    size_t log_rows_per_query\n220\t) {\n221\t    auto [grid, block] = kernel_launch_params(query_stride, 512 >> log_rows_per_query);\n222\t    block.y = 1 << log_rows_per_query;\n223\t    size_t shared_stride = block.x * div_ceil(block.y, 2);\n224\t    size_t shmem_bytes = CELLS_OUT * shared_stride * sizeof(Fp);\n225\t    auto height = query_stride << log_rows_per_query;\n226\t\n227\t    poseidon2_compressing_row_hashes_kernel<<<grid, block, shmem_bytes>>>(\n228\t        out, matrix, width, height, query_stride, log_rows_per_query\n229\t    );\n230\t    return CHECK_KERNEL();\n231\t}\n232\t\n233\textern \"C\" int _poseidon2_compressing_row_hashes_ext(\n234\t    digest_t *out,\n235\t    const FpExt *matrix,\n236\t    size_t width,\n237\t    size_t query_stride,\n238\t    size_t log_rows_per_query\n239\t) {\n240\t    auto [grid, block] = kernel_launch_params(query_stride, 512 >> log_rows_per_query);\n241\t    block.y = 1 << log_rows_per_query;\n242\t    size_t shared_stride = block.x * div_ceil(block.y, 2);\n243\t    size_t shmem_bytes = CELLS_OUT * shared_stride * sizeof(Fp);\n244\t    auto height = query_stride << log_rows_per_query;\n245\t\n246\t    poseidon2_compressing_row_hashes_ext_kernel<<<grid, block, shmem_bytes>>>(\n247\t        out, matrix, width, height, query_stride, log_rows_per_query\n248\t    );\n249\t    return CHECK_KERNEL();\n250\t}\n251\t\n252\textern \"C\" int _poseidon2_strided_compress_layer(\n253\t    digest_t *output,\n254\t    const digest_t *prev_layer,\n255\t    size_t output_size,\n256\t    size_t stride\n257\t) {\n258\t    auto [grid, block] = kernel_launch_params(output_size);\n259\t    poseidon2_strided_compress_layer_kernel<<<grid, block>>>(\n260\t        output, prev_layer, output_size, stride\n261\t    );\n262\t    return CHECK_KERNEL();\n263\t}\n264\t\n265\t// NOTE[jpw]: adding this function in CUDA to ensure the compiler can optimize stride = 1 (not sure this would happen across FFI boundary).\n266\t// For 32 byte digest, adjacent memory read still keeps memory coalesced in a warp\n267\textern \"C\" int _poseidon2_adjacent_compress_layer(\n268\t    digest_t *output,\n269\t    const digest_t *prev_layer,\n270\t    size_t output_size\n271\t) {\n272\t    auto [grid, block] = kernel_launch_params(output_size);\n273\t    poseidon2_strided_compress_layer_kernel<<<grid, block>>>(output, prev_layer, output_size, 1);\n274\t    return CHECK_KERNEL();\n275\t}\n276\t\n277\textern \"C\" int _query_digest_layers(\n278\t    Fp *d_digest_matrix,\n279\t    const uint64_t *d_layers_ptr,\n280\t    uint64_t *d_indices,\n281\t    uint64_t num_query,\n282\t    uint64_t num_layer\n283\t) {\n284\t    const size_t QUERY_DIGEST_THREADS = 128;\n285\t    const size_t DIGEST_WIDTH = 8;\n286\t\n287\t    auto block = QUERY_DIGEST_THREADS;\n288\t    dim3 grid = dim3(div_ceil(num_layer * DIGEST_WIDTH, block), num_query);\n289\t    query_digest_layers<<<grid, block>>>(\n290\t        d_digest_matrix, d_layers_ptr, d_indices, num_query, num_layer\n291\t    );\n292\t    return CHECK_KERNEL();\n293\t}\n294\t"}]},"parent_tool_use_id":"toolu_019qK3rZ2BfJTgiEvkAzzuJ3","session_id":"5bb7d674-211a-472f-a536-7708d797558d","uuid":"145a6416-3c2b-444d-ac3e-cba78c26a7c3","timestamp":"2026-04-15T02:30:23.891Z"}
