construct_s_evals(\n1127\t    d_sum_evals: &DeviceBuffer<EF>,\n1128\t    prev_s_eval: EF,\n1129\t    xi_j: EF,\n1130\t    eq_r_acc: EF,\n1131\t) -> Result<([EF; GKR_S_DEG], [EF; GKR_S_DEG]), FractionalSumcheckError> {\n1132\t    let sp_vec = d_sum_evals.to_host()?;\n1133\t    debug_assert_eq!(sp_vec.len(), GKR_S_DEG - 1);\n1134\t\n1135\t    // sp_evals holds evaluations of degree 2 poly `eq(xi_{j+1..}, r_{j+1..}) * s'(X)` at {0,1,2}\n1136\t    let mut sp_evals = [EF::ZERO; GKR_S_DEG];\n1137\t    sp_evals[1] = sp_vec[0] * eq_r_acc;\n1138\t    sp_evals[2] = sp_vec[1] * eq_r_acc;\n1139\t\n1140\t    // We use that s_j(0) + s_j(1) = s_{j-1}(r_{j-1})\n1141\t    // s_j(X) = eq(xi_j, X) * sp_j(X)\n1142\t    // s_j(0) = (1 - xi_j) * sp_j(0)\n1143\t    // s_j(1) = xi_j * sp_j(1)\n1144\t    // So: (1 - xi_j) * sp_j(0) + xi_j * sp_j(1) = prev_s_eval\n1145\t    // xi_j is randomly sampled so 1 - xi_j should be invertible\n1146\t    let eq_xi_0 = EF::ONE - xi_j;\n1147\t    debug_assert_ne!(eq_xi_0, EF::ZERO);\n1148\t    let eq_xi_1 = xi_j;\n1149\t    sp_evals[0] = (prev_s_eval - eq_xi_1 * sp_evals[1]) * eq_xi_0.inverse();\n1150\t\n1151\t    let s_evals: [EF; GKR_S_DEG] = from_fn(|i| {\n1152\t        // evaluate s at X = i + 1 (skip 0 evaluation)\n1153\t        let x = EF::from_usize(i + 1);\n1154\t        let sp_eval = if i < GKR_S_DEG - 1 {\n1155\t            sp_evals[i + 1]\n1156\t        } else {\n1157\t            interpolate_quadratic_at_012(&sp_evals, x)\n1158\t        };\n1159\t        eval_eq_mle(&[xi_j], &[x]) * sp_eval\n1160\t    });\n1161\t\n1162\t    Ok((s_evals, sp_evals))\n1163\t}\n1164\t\n1165\t/// Generate random fractional leaves on device for benchmarking.\n1166\tpub fn make_synthetic_leaves(n: usize) -> Result<DeviceBuffer<Frac<EF>>, FractionalSumcheckError> {\n1167\t    use openvm_cuda_common::copy::cuda_memcpy;\n1168\t    use rand::{rngs::StdRng, Rng, SeedableRng};\n1169\t\n1170\t    let size = 1usize << n;\n1171\t    let mut rng = StdRng::seed_from_u64(42);\n1172\t    let host: Vec<(EF, EF)> = (0..size)\n1173\t        .map(|_| (rng.random::<EF>(), rng.random::<EF>()))\n1174\t        .collect();\n1175\t    let d_leaves = DeviceBuffer::<Frac<EF>>::with_capacity(size);\n1176\t    unsafe {\n1177\t        cuda_memcpy::<false, true>(\n1178\t            d_leaves.as_mut_raw_ptr(),\n1179\t            host.as_ptr() as *const std::ffi::c_void,\n1180\t            std::mem::size_of_val(host.as_slice()),\n1181\t        )?;\n1182\t    }\n1183\t    Ok(d_leaves)\n1184\t}\n1185\t\n1186\t#[cfg(test)]\n1187\tmod tests {\n1188\t    use openvm_cuda_common::{memory_manager::MemTracker, stream::current_stream_sync};\n1189\t    use p3_field::PrimeCharacteristicRing;\n1190\t\n1191\t    use super::{\n1192\t        fractional_sumcheck_gpu, make_synthetic_leaves, FractionalSumcheckError, GkrRoundStrategy,\n1193\t        EF,\n1194\t    };\n1195\t    use crate::{prelude::SC, sponge::DuplexSpongeGpu};\n1196\t\n1197\t    /// Run fractional sumcheck with a given round strategy and return the proof + final randomness.\n1198\t    fn run_with_strategy(\n1199\t        n: usize,"}]},"parent_tool_use_id":"toolu_01AtdyzMWMsZyBSR8LM8TksV","session_id":"5bb7d674-211a-472f-a536-7708d797558d","uuid":"d463a4b8-43bb-410c-8e2e-9eab4327834f","timestamp":"2026-04-15T02:30:38.496Z"}
