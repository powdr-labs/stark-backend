{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MJvKsTvtBNNoNRs9ZZWRyD","type":"tool_result","content":"1\t//! Batched monomial-based MLE evaluation for zerocheck and logup.\n2\t//!\n3\t//! This module provides batch evaluators for monomial evaluations across multiple AIRs,\n4\t//! enabling efficient GPU kernel launches that process multiple traces in a single launch.\n5\t\n6\tuse openvm_cuda_common::{\n7\t    copy::MemCopyH2D,\n8\t    d_buffer::DeviceBuffer,\n9\t    error::{CudaError, MemCopyError},\n10\t};\n11\tuse openvm_stark_backend::prover::{fractional_sumcheck_gkr::Frac, DeviceMultiStarkProvingKey};\n12\tuse p3_field::PrimeCharacteristicRing;\n13\tuse tracing::debug;\n14\t\n15\tuse crate::{\n16\t    cuda::logup_zerocheck::{\n17\t        logup_monomial_batched, precompute_lambda_combinations,\n18\t        precompute_logup_denom_combinations, precompute_logup_numer_combinations,\n19\t        zerocheck_monomial_batched, zerocheck_monomial_par_y_batched, BlockCtx, EvalCoreCtx,\n20\t        LogupMonomialCommonCtx, LogupMonomialCtx, MonomialAirCtx,\n21\t    },\n22\t    error::KernelError,\n23\t    gpu_backend::GenericGpuBackend,\n24\t    hash_scheme::GpuHashScheme,\n25\t    logup_zerocheck::batch_mle::TraceCtx,\n26\t    prelude::EF,\n27\t};\n28\t\n29\tconst THREADS_PER_BLOCK: u32 = 256;\n30\t\n31\t/// Returns true if the trace can use the monomial evaluation path.\n32\t///\n33\t/// A trace is eligible if it has constraints and the AIR has expanded monomials.\n34\tpub(crate) fn trace_has_monomials<HS: GpuHashScheme>(\n35\t    trace: &TraceCtx,\n36\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n37\t) -> bool {\n38\t    trace.has_constraints\n39\t        && pk.per_air[trace.air_idx]\n40\t            .other_data\n41\t            .zerocheck_monomials\n42\t            .as_ref()\n43\t            .map(|m| m.num_monomials > 0)\n44\t            .unwrap_or(false)\n45\t}\n46\t\n47\t/// Get the number of monomials for a trace. Returns 0 if the trace has no monomials.\n48\tpub(crate) fn get_num_monomials<HS: GpuHashScheme>(\n49\t    trace: &TraceCtx,\n50\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n51\t) -> u32 {\n52\t    pk.per_air[trace.air_idx]\n53\t        .other_data\n54\t        .zerocheck_monomials\n55\t        .as_ref()\n56\t        .map(|m| m.num_monomials)\n57\t        .unwrap_or(0)\n58\t}\n59\t\n60\t/// Get the rules_len for a trace's zerocheck DAG.\n61\tpub(crate) fn get_zerocheck_rules_len<HS: GpuHashScheme>(\n62\t    trace: &TraceCtx,\n63\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n64\t) -> usize {\n65\t    pk.per_air[trace.air_idx]\n66\t        .other_data\n67\t        .zerocheck_mle\n68\t        .inner\n69\t        .d_rules\n70\t        .len()\n71\t}\n72\t\n73\t/// Precompute lambda combinations for a single AIR's monomials.\n74\t///\n75\t/// Returns a buffer of length `num_monomials` where each element is\n76\t/// `sum_l(coefficient_l * lambda_pows[constraint_idx_l])` for that monomial.\n77\t///\n78\t/// The AIR must have nonempty monomials.\n79\tpub(crate) fn compute_lambda_combinations<HS: GpuHashScheme>(\n80\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n81\t    air_idx: usize,\n82\t    lambda_pows: &DeviceBuffer<EF>,\n83\t) -> Result<DeviceBuffer<EF>, CudaError> {\n84\t    let monomials = pk.per_air[air_idx]\n85\t        .other_data\n86\t        .zerocheck_monomials\n87\t        .as_ref()\n88\t        .expect(\"AIR must have monomials\");\n89\t    let mut buf = DeviceBuffer::<EF>::with_capacity(monomials.num_monomials as usize);\n90\t    unsafe {\n91\t        precompute_lambda_combinations(\n92\t            &mut buf,\n93\t            monomials.d_headers.as_ptr(),\n94\t            monomials.d_lambda_terms.as_ptr(),\n95\t            lambda_pows,\n96\t            monomials.num_monomials,\n97\t        )?;\n98\t    }\n99\t    Ok(buf)\n100\t}"}]},"parent_tool_use_id":null,"session_id":"5bb7d674-211a-472f-a536-7708d797558d","uuid":"8ecbe52d-6cef-4f8f-bbd2-613e51c8c192","timestamp":"2026-04-15T02:49:07.863Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/batch_mle_monomial.rs","content":"//! Batched monomial-based MLE evaluation for zerocheck and logup.\n//!\n//! This module provides batch evaluators for monomial evaluations across multiple AIRs,\n//! enabling efficient GPU kernel launches that process multiple traces in a single launch.\n\nuse openvm_cuda_common::{\n    copy::MemCopyH2D,\n    d_buffer::DeviceBuffer,\n    error::{CudaError, MemCopyError},\n};\nuse openvm_stark_backend::prover::{fractional_sumcheck_gkr::Frac, DeviceMultiStarkProvingKey};\nuse p3_field::PrimeCharacteristicRing;\nuse tracing::debug;\n\nuse crate::{\n    cuda::logup_zerocheck::{\n        logup_monomial_batched, precompute_lambda_combinations,\n        precompute_logup_denom_combinations, precompute_logup_numer_combinations,\n        zerocheck_monomial_batched, zerocheck_monomial_par_y_batched, BlockCtx, EvalCoreCtx,\n        LogupMonomialCommonCtx, LogupMonomialCtx, MonomialAirCtx,\n    },\n    error::KernelError,\n    gpu_backend::GenericGpuBackend,\n    hash_scheme::GpuHashScheme,\n    logup_zerocheck::batch_mle::TraceCtx,\n    prelude::EF,\n};\n\nconst THREADS_PER_BLOCK: u32 = 256;\n\n/// Returns true if the trace can use the monomial evaluation path.\n///\n/// A trace is eligible if it has constraints and the AIR has expanded monomials.\npub(crate) fn trace_has_monomials<HS: GpuHashScheme>(\n    trace: &TraceCtx,\n    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n) -> bool {\n    trace.has_constraints\n        && pk.per_air[trace.air_idx]\n            .other_data\n            .zerocheck_monomials\n            .as_ref()\n            .map(|m| m.num_monomials > 0)\n            .unwrap_or(false)\n}\n\n/// Get the number of monomials for a trace. Returns 0 if the trace has no monomials.\npub(crate) fn get_num_monomials<HS: GpuHashScheme>(\n    trace: &TraceCtx,\n    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n) -> u32 {\n    pk.per_air[trace.air_idx]\n        .other_data\n        .zerocheck_monomials\n        .as_ref()\n        .map(|m| m.num_monomials)\n        .unwrap_or(0)\n}\n\n/// Get the rules_len for a trace's zerocheck DAG.\npub(crate) fn get_zerocheck_rules_len<HS: GpuHashScheme>(\n    trace: &TraceCtx,\n    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n) -> usize {\n    pk.per_air[trace.air_idx]\n        .other_data\n        .zerocheck_mle\n        .inner\n        .d_rules\n        .len()\n}\n\n/// Precompute lambda combinations for a single AIR's monomials.\n///\n/// Returns a buffer of length `num_monomials` where each element is\n/// `sum_l(coefficient_l * lambda_pows[constraint_idx_l])` for that monomial.\n///\n/// The AIR must have nonempty monomials.\npub(crate) fn compute_lambda_combinations<HS: GpuHashScheme>(\n    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n    air_idx: usize,\n    lambda_pows: &DeviceBuffer<EF>,\n) -> Result<DeviceBuffer<EF>, CudaError> {\n    let monomials = pk.per_air[air_idx]\n        .other_data\n        .zerocheck_monomials\n        .as_ref()\n        .expect(\"AIR must have monomials\");\n    let mut buf = DeviceBuffer::<EF>::with_capacity(monomials.num_monomials as usize);\n    unsafe {\n        precompute_lambda_combinations(\n            &mut buf,\n            monomials.d_headers.as_ptr(),\n            monomials.d_lambda_terms.as_ptr(),\n            lambda_pows,\n            monomials.num_monomials,\n        )?;\n    }\n    Ok(buf)\n}","numLines":100,"startLine":1,"totalLines":794}}}
