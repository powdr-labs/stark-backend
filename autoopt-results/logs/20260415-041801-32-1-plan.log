{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K3VBpNxLmqdes2WVsvBQfU","type":"tool_result","content":"1\t#![allow(dead_code)]\n2\tuse openvm_cuda_common::{\n3\t    copy::{MemCopyD2H, MemCopyH2D},\n4\t    d_buffer::DeviceBuffer,\n5\t};\n6\tuse openvm_stark_backend::{\n7\t    p3_util::log2_strict_usize,\n8\t    poly_common::UnivariatePoly,\n9\t    prover::sumcheck::{SumcheckCubeProof, SumcheckPrismProof},\n10\t    FiatShamirTranscript,\n11\t};\n12\tuse p3_field::{ExtensionField, Field};\n13\tuse tracing::{debug, info_span, instrument};\n14\t\n15\tuse crate::{\n16\t    cuda::{\n17\t        batch_ntt_small::batch_ntt_small,\n18\t        matrix::batch_expand_pad_wide,\n19\t        sumcheck::{fold_mle, fold_ple_from_coeffs, reduce_over_x_and_cols, sumcheck_mle_round},\n20\t    },\n21\t    error::SumcheckError,\n22\t    prelude::*,\n23\t    sponge::DuplexSpongeGpu,\n24\t};\n25\t\n26\t/// GPU implementation of multilinear sumcheck\n27\t///\n28\t/// Memory strategy: Ping-pong buffers (buffer_a ↔ buffer_b) alternate each round\n29\t/// - Round 0 (even): reads buffer_a, writes buffer_b\n30\t/// - Round 1 (odd):  reads buffer_b, writes buffer_a\n31\t/// - Final result in buffer determined by parity of n\n32\t/// - Memory footprint: ~1.5 * evals.len() * sizeof(EF)\n33\t#[allow(dead_code)]\n34\t#[instrument(name = \"sumcheck_multilinear_gpu\", level = \"info\", skip_all)]\n35\tpub fn sumcheck_multilinear_gpu<F: Field>(\n36\t    transcript: &mut DuplexSpongeGpu,\n37\t    evals: &[F],\n38\t) -> Result<(SumcheckCubeProof<EF>, Vec<EF>), SumcheckError>\n39\twhere\n40\t    EF: ExtensionField<F>,\n41\t{\n42\t    let n = log2_strict_usize(evals.len());\n43\t    let mut round_polys_eval = Vec::with_capacity(n);\n44\t    let mut r = Vec::with_capacity(n);\n45\t\n46\t    // Compute sum claim\n47\t    let sum_claim: EF = evals.iter().copied().sum::<F>().into();\n48\t    transcript.observe_ext(sum_claim);\n49\t\n50\t    // Convert to extension field\n51\t    let evals_ext: Vec<EF> = evals.iter().map(|&x| EF::from(x)).collect();\n52\t\n53\t    // Setup\n54\t    let mut current_height = 1 << n;\n55\t    let width = 1;\n56\t    let num_matrices = 1;\n57\t    let d = 1; // Degree for MLE\n58\t    const WD: usize = 1; // Number of output polynomials\n59\t\n60\t    // Allocate ping-pong buffers\n61\t    let total_size = width * current_height;\n62\t    let mut d_buffer_a = evals_ext.to_device()?;\n63\t    let mut d_buffer_b = DeviceBuffer::<EF>::with_capacity(total_size / 2);\n64\t\n65\t    // Set up pointer arrays on device\n66\t    let mut d_input_ptrs = DeviceBuffer::<*const EF>::with_capacity(num_matrices);\n67\t    let mut d_output_ptrs = DeviceBuffer::<*mut EF>::with_capacity(num_matrices);\n68\t    let d_widths = [width as u32].to_device()?;\n69\t\n70\t    // Buffer for round output [d * WD]\n71\t    let d_round_output = DeviceBuffer::<EF>::with_capacity(d * WD);\n72\t\n73\t    // Sumcheck rounds\n74\t    for round in 0..n {\n75\t        // Ping-pong buffers\n76\t        let (input_buf, output_buf) = if round % 2 == 0 {\n77\t            (&d_buffer_a, &mut d_buffer_b)\n78\t        } else {\n79\t            (&d_buffer_b, &mut d_buffer_a)\n80\t        };\n81\t\n82\t        // Update pointer arrays\n83\t        let input_ptr = input_buf.as_ptr();\n84\t        let output_ptr = output_buf.as_mut_ptr();\n85\t\n86\t        [input_ptr].copy_to(&mut d_input_ptrs)?;\n87\t        [output_ptr].copy_to(&mut d_output_ptrs)?;\n88\t\n89\t        // Call sumcheck_mle_round kernel (uses output_buf as tmp)\n90\t        unsafe {\n91\t            sumcheck_mle_round(\n92\t                &d_input_ptrs,\n93\t                &d_round_output,\n94\t                output_buf, // Reuse output buffer as tmp!\n95\t                &d_widths,\n96\t                num_matrices as u32,\n97\t                current_height as u32,\n98\t                d as u32,\n99\t            )\n100\t            .map_err(|e| SumcheckError::SumcheckMleRound(e.into()))?;\n101\t        }\n102\t\n103\t        // Copy result back to host\n104\t        let h_round_output = d_round_output.to_host()?;\n105\t\n106\t        // Observe in transcript\n107\t        let s = h_round_output[0..d].to_vec();\n108\t\n109\t        assert_eq!(s.len(), d);\n110\t        transcript.observe_ext(s[0]);\n111\t        round_polys_eval.push(s);\n112\t\n113\t        // Sample challenge from transcript\n114\t        let r_round = transcript.sample_ext();\n115\t        debug!(%round, %r_round);\n116\t        r.push(r_round);\n117\t\n118\t        // Fold using the challenge\n119\t        let output_height = (current_height >> 1) as u32;\n120\t        unsafe {\n121\t            fold_mle(\n122\t                &d_input_ptrs,\n123\t                &d_output_ptrs,\n124\t                &d_widths,\n125\t                num_matrices.try_into().unwrap(),\n126\t                output_height,\n127\t                width as u32 * output_height,\n128\t                r_round,\n129\t            )\n130\t            .map_err(|e| SumcheckError::FoldMle(e.into()))?;\n131\t        }\n132\t\n133\t        current_height >>= 1;\n134\t    }\n135\t\n136\t    // After all rounds, get final evaluation claim\n137\t    let final_buf = if n % 2 == 1 { &d_buffer_b } else { &d_buffer_a };\n138\t    let eval_claim_vec = final_buf.to_host()?;\n139\t    let eval_claim = eval_claim_vec[0];\n140\t\n141\t    transcript.observe_ext(eval_claim);\n142\t\n143\t    Ok((\n144\t        SumcheckCubeProof {\n145\t            sum_claim,\n146\t            round_polys_eval,\n147\t            eval_claim,\n148\t        },\n149\t        r,\n150\t    ))\n151\t}\n152\t\n153\t/// GPU implementation of prismalinear sumcheck with univariate skip\n154\t///\n155\t/// Memory strategy:\n156\t/// - Round 0: Uses DFT/iDFT pipeline, reuses buffers between steps\n157\t/// - Rounds 1..n: Standard MLE rounds with ping-pong buffers\n158\t/// - d_evals gets modified by iDFT in round 0, then reused for fold_ple\n159\t/// - Memory footprint: if evals.len() = 2^(l_skip +n), then 2 * evals.len() * sizeof(F) + 1.5 * 2^n\n160\t///   * sizeof(EF)\n161\t///\n162\t/// NOTE: batch_ntt expects a concrete type BabyBear, so I removed generic type parameters for now\n163\t#[allow(dead_code)]\n164\t#[instrument(name = \"sumcheck_prismalinear_gpu\", level = \"info\", skip_all)]\n165\tpub fn sumcheck_prismalinear_gpu(\n166\t    transcript: &mut DuplexSpongeGpu,\n167\t    l_skip: usize,\n168\t    evals: &[F],\n169\t) -> Result<(SumcheckPrismProof<EF>, Vec<EF>), SumcheckError> {\n170\t    let prism_dim = p3_util::log2_strict_usize(evals.len());\n171\t    assert!(prism_dim >= l_skip);\n172\t    let n = prism_dim - l_skip;\n173\t\n174\t    let mut round_polys_eval = Vec::with_capacity(n);\n175\t    let mut r = Vec::with_capacity(n + 1);\n176\t\n177\t    // Compute sum claim\n178\t    let sum_claim: EF = evals.iter().copied().sum::<F>().into();\n179\t    transcript.observe_ext(sum_claim);\n180\t\n181\t    // Setup\n182\t    let domain_size = 1 << l_skip;\n183\t    let num_x = 1 << n;\n184\t    let width = 1;\n185\t    let d = 1; // Degree for simple case\n186\t    let s_deg = d * (domain_size - 1); // d * (2^l_skip - 1)\n187\t    let log_large_domain = p3_util::log2_ceil_usize(s_deg + 1);\n188\t    let large_domain_size = 1 << log_large_domain;\n189\t\n190\t    // ========== Round 0: Special PLE round ==========\n191\t    let _round0_span = info_span!(\"sumcheck_prismalinear.round0\").entered();\n192\t\n193\t    let mut d_coeffs = evals.to_device()?;\n194\t    let mut d_s0_coeffs = DeviceBuffer::<F>::with_capacity(large_domain_size);\n195\t\n196\t    // Step 1: iDFT on skip domain (reinterpreting dimensions)\n197\t    // Input: [height=2^(l_skip+n), width=1]\n198\t    // Treat as: [height=2^l_skip, width=2^n]\n199\t    unsafe {\n200\t        batch_ntt_small(&mut d_coeffs, l_skip, num_x * width, true)\n201\t            .map_err(|e| SumcheckError::BatchNttSmall(e.into()))?;\n202\t    }\n203\t\n204\t    if domain_size == large_domain_size {\n205\t        unsafe {\n206\t            // Step 2-5: Sum over all x and columns\n207\t            reduce_over_x_and_cols(\n208\t                &d_coeffs,\n209\t                &d_s0_coeffs,\n210\t                num_x as u32,\n211\t                width as u32,\n212\t                large_domain_size as u32,\n213\t            )\n214\t            .map_err(|e| SumcheckError::ReduceOverXAndCols(e.into()))?;\n215\t        }\n216\t    } else {\n217\t        let mut d_coeffs_large =\n218\t            DeviceBuffer::<F>::with_capacity(num_x * width * large_domain_size);\n219\t\n220\t        // Step 2: Copy and pad each column to large domain size\n221\t        unsafe {\n222\t            batch_expand_pad_wide(\n223\t                d_coeffs_large.as_mut_ptr(),\n224\t                d_coeffs.as_ptr(),\n225\t                (num_x * width) as u32,\n226\t                large_domain_size as u32,\n227\t                domain_size as u32,\n228\t            )\n229\t            .map_err(|e| SumcheckError::BatchExpandPadWide(e.into()))?;\n230\t        }\n231\t\n232\t        // Step 3: DFT on large domain\n233\t        unsafe {\n234\t            batch_ntt_small(&mut d_coeffs_large, log_large_domain, num_x * width, false)\n235\t                .map_err(|e| SumcheckError::BatchNttSmall(e.into()))?;\n236\t        }\n237\t\n238\t        // Step 4: Sum over all x and columns\n239\t        unsafe {\n240\t            reduce_over_x_and_cols(\n241\t                &d_coeffs_large,\n242\t                &d_s0_coeffs,\n243\t                num_x as u32,\n244\t                width as u32,\n245\t                large_domain_size as u32,\n246\t            )\n247\t            .map_err(|e| SumcheckError::ReduceOverXAndCols(e.into()))?;\n248\t        }\n249\t        drop(d_coeffs_large);\n250\t\n251\t        // Step 5: iDFT to get coefficients\n252\t        unsafe {\n253\t            batch_ntt_small(&mut d_s0_coeffs, log_large_domain, 1, true)\n254\t                .map_err(|e| SumcheckError::BatchNttSmall(e.into()))?;\n255\t        }\n256\t    }\n257\t    // Step 6: Copy to host and convert to extension field\n258\t    let s0_coeffs_host: Vec<F> = d_s0_coeffs.to_host()?;\n259\t    drop(d_s0_coeffs);\n260\t    let s0_coeffs_ext: Vec<EF> = s0_coeffs_host[0..=s_deg]\n261\t        .iter()\n262\t        .map(|&x| EF::from(x))\n263\t        .collect();\n264\t\n265\t    // Step 7: Create polynomial and observe in transcript\n266\t    let s_0 = UnivariatePoly::new(s0_coeffs_ext.clone());\n267\t    for &coeff in &s0_coeffs_ext {\n268\t        transcript.observe_ext(coeff);\n269\t    }\n270\t\n271\t    // Step 8: Sample challenge r_0\n272\t    let r_0 = transcript.sample_ext();\n273\t    debug!(round = 0, r_round = %r_0);\n274\t    r.push(r_0);\n275\t\n276\t    // ========== Fold PLE: Evaluate at r_0 ==========\n277\t\n278\t    let d_folded = DeviceBuffer::<EF>::with_capacity(num_x);\n279\t    unsafe {\n280\t        fold_ple_from_coeffs(\n281\t            d_coeffs.as_ptr(),     // Original input (base field, but modified by iDFT)\n282\t            d_folded.as_mut_ptr(), // Output in extension field\n283\t            num_x as u32,\n284\t            width as u32,\n285\t            domain_size as u32,\n286\t            r_0,\n287\t        )\n288\t        .map_err(|e| SumcheckError::FoldPleFromCoeffs(e.into()))?;\n289\t    }\n290\t    drop(d_coeffs);\n291\t    drop(_round0_span);\n292\t\n293\t    // ========== Rounds 1..n: Regular MLE rounds ==========\n294\t    let _mle_rounds_span = info_span!(\"sumcheck_prismalinear.mle_rounds\").entered();\n295\t\n296\t    let mut current_height = num_x; // After fold_ple, height is 2^n\n297\t    let num_matrices = 1;\n298\t\n299\t    // Allocate ping-pong buffers for MLE rounds\n300\t    let mut d_buffer_a = d_folded; // Reuse folded result\n301\t    let mut d_buffer_b = DeviceBuffer::<EF>::with_capacity(current_height / 2);\n302\t\n303\t    let mut d_input_ptrs = DeviceBuffer::<*const EF>::with_capacity(num_matrices);\n304\t    let mut d_output_ptrs = DeviceBuffer::<*mut EF>::with_capacity(num_matrices);\n305\t    let d_widths = [width as u32].to_device()?;\n306\t    let d_round_output = DeviceBuffer::<EF>::with_capacity(d);\n307\t\n308\t    for round in 1..=n {\n309\t        let (input_buf, output_buf) = if round % 2 == 1 {\n310\t            (&d_buffer_a, &mut d_buffer_b)\n311\t        } else {\n312\t            (&d_buffer_b, &mut d_buffer_a)\n313\t        };\n314\t\n315\t        let input_ptr = input_buf.as_ptr();\n316\t        let output_ptr = output_buf.as_mut_ptr();\n317\t\n318\t        [input_ptr].copy_to(&mut d_input_ptrs)?;\n319\t        [output_ptr].copy_to(&mut d_output_ptrs)?;\n320\t\n321\t        // Sumcheck MLE round\n322\t        unsafe {\n323\t            sumcheck_mle_round(\n324\t                &d_input_ptrs,\n325\t                &d_round_output,\n326\t                output_buf,\n327\t                &d_widths,\n328\t                num_matrices as u32,\n329\t                current_height as u32,\n330\t                d as u32,\n331\t            )\n332\t            .map_err(|e| SumcheckError::SumcheckMleRound(e.into()))?;\n333\t        }\n334\t\n335\t        let h_round_output = d_round_output.to_host()?;\n336\t        let s = h_round_output[0..d].to_vec();\n337\t        assert_eq!(s.len(), d);\n338\t        transcript.observe_ext(s[0]);\n339\t        round_polys_eval.push(s);\n340\t\n341\t        let r_round = transcript.sample_ext();\n342\t        debug!(%round, %r_round);\n343\t        r.push(r_round);\n344\t\n345\t        // Fold MLE\n346\t        let output_height = (current_height >> 1) as u32;\n347\t        unsafe {\n348\t            fold_mle(\n349\t                &d_input_ptrs,\n350\t                &d_output_ptrs,\n351\t                &d_widths,\n352\t                num_matrices.try_into().unwrap(),\n353\t                output_height,\n354\t                width as u32 * output_height,\n355\t                r_round,\n356\t            )\n357\t            .map_err(|e| SumcheckError::FoldMle(e.into()))?;\n358\t        }\n359\t\n360\t        current_height >>= 1;\n361\t    }\n362\t    drop(_mle_rounds_span);\n363\t\n364\t    // Get final evaluation claim\n365\t    let final_buf = if n % 2 == 1 { &d_buffer_b } else { &d_buffer_a };\n366\t    let eval_claim_vec = final_buf.to_host()?;\n367\t    let eval_claim = eval_claim_vec[0];\n368\t\n369\t    transcript.observe_ext(eval_claim);\n370\t\n371\t    Ok((\n372\t        SumcheckPrismProof {\n373\t            sum_claim,\n374\t            s_0,\n375\t            round_polys_eval,\n376\t            eval_claim,\n377\t        },\n378\t        r,\n379\t    ))\n380\t}\n381\t"}]},"parent_tool_use_id":"toolu_01AtdyzMWMsZyBSR8LM8TksV","session_id":"5bb7d674-211a-472f-a536-7708d797558d","uuid":"72100ecb-2ca5-4dc2-b5d1-6373f6136e44","timestamp":"2026-04-15T02:30:30.764Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GyATbibp4NCPswBGRc5Smo","type":"tool_result","content":"1\tuse std::cmp::max;\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::{\n5\t    copy::MemCopyH2D,\n6\t    d_buffer::DeviceBuffer,\n7\t    stream::current_stream_sync,\n8\t};\n9\tuse openvm_stark_backend::prover::{\n10\t    fractional_sumcheck_gkr::Frac,\n11\t    stacked_pcs::{StackedLayout, StackedSlice},\n12\t    DeviceMultiStarkProvingKey, MatrixDimensions, ProvingContext,\n13\t};\n14\tuse p3_field::{Field, PrimeCharacteristicRing};\n15\tuse tracing::instrument;\n16\t\n17\tuse super::errors::InteractionGpuError;\n18\tuse crate::{\n19\t    cuda::logup_zerocheck::{\n20\t        frac_matrix_vertically_repeat, frac_vector_scalar_multiply_ext_fp, logup_gkr_input_eval,\n21\t    },\n22\t    gpu_backend::GenericGpuBackend,\n23\t    hash_scheme::GpuHashScheme,\n24\t    prelude::{EF, F},\n25\t};\n26\t\n27\tconst TASK_SIZE: u32 = 65536;\n28\t\n29\t/// Number of OS threads (and thus CUDA streams) for parallel GKR input evaluation.\n30\tconst NUM_GKR_INPUT_STREAMS: usize = 8;\n31\t\n32\tstruct SendPtr<T>(*mut T);\n33\tunsafe impl<T> Send for SendPtr<T> {}\n34\tunsafe impl<T> Sync for SendPtr<T> {}\n35\t\n36\tstruct GkrThreadBuffers {\n37\t    intermediates: DeviceBuffer<EF>,\n38\t    public_values: DeviceBuffer<F>,\n39\t    partition_ptrs: DeviceBuffer<u64>,\n40\t    tmp: DeviceBuffer<Frac<EF>>,\n41\t}\n42\t\n43\tstruct GkrInputWorkItem<'a, HS: GpuHashScheme> {\n44\t    air_ctx: &'a openvm_stark_backend::prover::AirProvingContext<GenericGpuBackend<HS>>,\n45\t    pk_air: &'a openvm_stark_backend::prover::DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n46\t    l_skip: usize,\n47\t    d_challenges: &'a DeviceBuffer<EF>,\n48\t    leaves_ptr: SendPtr<Frac<EF>>,\n49\t}\n50\t\n51\t#[allow(dead_code)]\n52\t#[derive(Clone)]\n53\tpub struct TraceInteractionMeta {\n54\t    pub trace_idx: usize,\n55\t    pub air_idx: usize,\n56\t    pub layout_slices: Vec<StackedSlice>,\n57\t}\n58\t\n59\t// TODO[jpw]: revisit if this function is needed\n60\tpub fn collect_trace_interactions<HS: GpuHashScheme>(\n61\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n62\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n63\t    layout: &StackedLayout,\n64\t) -> Vec<Option<TraceInteractionMeta>> {\n65\t    // Pre-group layout slices by trace to avoid repeated scans later.\n66\t    let mut slices_by_trace: Vec<Vec<(usize, StackedSlice)>> =\n67\t        vec![Vec::new(); ctx.per_trace.len()];\n68\t    for &(trace_idx, interaction_idx, ref slice) in &layout.sorted_cols {\n69\t        if let Some(entries) = slices_by_trace.get_mut(trace_idx) {\n70\t            entries.push((interaction_idx, *slice));\n71\t        }\n72\t    }\n73\t\n74\t    ctx.per_trace\n75\t        .iter()\n76\t        .enumerate()\n77\t        .map(|(trace_idx, (air_idx, _))| {\n78\t            let vk = &pk.per_air[*air_idx].vk;\n79\t            if !vk.has_interaction() {\n80\t                return None;\n81\t            }\n82\t\n83\t            let mut layout_entries = vec![None; vk.num_interactions()];\n84\t            for (interaction_idx, slice) in &slices_by_trace[trace_idx] {\n85\t                if let Some(slot) = layout_entries.get_mut(*interaction_idx) {\n86\t                    *slot = Some(*slice);\n87\t                }\n88\t            }\n89\t\n90\t            let layout_slices = layout_entries\n91\t                .into_iter()\n92\t                .enumerate()\n93\t                .map(|(idx, maybe_slice)| {\n94\t                    maybe_slice.unwrap_or_else(|| {\n95\t                        panic!(\n96\t                            \"missing stacked slice for interaction {} of trace {}\",\n97\t                            idx, trace_idx\n98\t                        )\n99\t                    })\n100\t                })\n101\t                .collect_vec();\n102\t\n103\t            Some(TraceInteractionMeta {\n104\t                trace_idx,\n105\t                air_idx: *air_idx,\n106\t                layout_slices,\n107\t            })\n108\t        })\n109\t        .collect()\n110\t}\n111\t\n112\tfn process_gkr_input_air<HS: GpuHashScheme>(\n113\t    w: &GkrInputWorkItem<HS>,\n114\t    buffers: &mut GkrThreadBuffers,\n115\t) -> Result<(), InteractionGpuError> {\n116\t    let null_preprocessed = DeviceBuffer::<F>::new();\n117\t    let air_ctx = w.air_ctx;\n118\t    let pk_air = w.pk_air;\n119\t\n120\t    let preprocessed_matrix = pk_air\n121\t        .preprocessed_data\n122\t        .as_ref()\n123\t        .map(|committed| &committed.trace);\n124\t\n125\t    let mut partitioned_main = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n126\t    for committed in &air_ctx.cached_mains {\n127\t        partitioned_main.push(&committed.trace);\n128\t    }\n129\t    partitioned_main.push(&air_ctx.common_main);\n130\t\n131\t    let rules = &pk_air.other_data.interaction_rules;\n132\t    let num_interactions = pk_air.vk.symbolic_constraints.interactions.len();\n133\t\n134\t    let d_preprocessed = preprocessed_matrix\n135\t        .as_ref()\n136\t        .map(|m| m.buffer())\n137\t        .unwrap_or(&null_preprocessed);\n138\t\n139\t    let null_pv = DeviceBuffer::<F>::new();\n140\t    let has_public_values = !air_ctx.public_values.is_empty();\n141\t    if has_public_values {\n142\t        air_ctx.public_values.copy_to(&mut buffers.public_values)?;\n143\t    }\n144\t    let d_public_values = if has_public_values {\n145\t        &buffers.public_values\n146\t    } else {\n147\t        &null_pv\n148\t    };\n149\t\n150\t    let height = air_ctx.height();\n151\t    debug_assert_eq!(height, partitioned_main[0].height());\n152\t    let partition_ptrs = partitioned_main\n153\t        .iter()\n154\t        .map(|m| m.buffer().as_ptr() as u64)\n155\t        .collect_vec();\n156\t    partition_ptrs.copy_to(&mut buffers.partition_ptrs)?;\n157\t\n158\t    let buffer_size = rules.inner.buffer_size;\n159\t    // TODO[jpw]: remove magic 10\n160\t    let is_global = buffer_size > 10;\n161\t\n162\t    let num_rows_per_tile = height.div_ceil(TASK_SIZE as usize).max(1);\n163\t\n164\t    let leaves_ptr = w.leaves_ptr.0;\n165\t    let l_skip = w.l_skip;\n166\t    let lifted_height = max(height, 1 << l_skip);\n167\t\n168\t    let trace_output = if height != lifted_height {\n169\t        buffers.tmp.as_mut_ptr()\n170\t    } else {\n171\t        leaves_ptr\n172\t    };\n173\t    unsafe {\n174\t        logup_gkr_input_eval(\n175\t            is_global,\n176\t            trace_output,\n177\t            d_preprocessed,\n178\t            &buffers.partition_ptrs,\n179\t            d_public_values,\n180\t            w.d_challenges,\n181\t            &buffers.intermediates,\n182\t            &rules.inner.d_rules,\n183\t            &rules.inner.d_used_nodes,\n184\t            &rules.d_pair_idxs,\n185\t            height as u32,\n186\t            num_rows_per_tile as u32,\n187\t        )?;\n188\t    }\n189\t    if height != lifted_height {\n190\t        debug_assert_eq!(lifted_height % height, 0);\n191\t        debug_assert!(!buffers.tmp.is_empty());\n192\t        let norm_factor_denom = lifted_height / height;\n193\t        let norm_factor = F::from_usize(norm_factor_denom).inverse();\n194\t        unsafe {\n195\t            frac_vector_scalar_multiply_ext_fp(\n196\t                buffers.tmp.as_mut_ptr(),\n197\t                norm_factor,\n198\t                (height * num_interactions) as u32,\n199\t            )?;\n200\t            frac_matrix_vertically_repeat(\n201\t                leaves_ptr,\n202\t                buffers.tmp.as_ptr(),\n203\t                num_interactions as u32,\n204\t                lifted_height as u32,\n205\t                height as u32,\n206\t            )?;\n207\t        }\n208\t    }\n209\t    Ok(())\n210\t}\n211\t\n212\t/// Evaluate interactions from trace evaluation matrices to get (p, q) fractional sumcheck input.\n213\t/// Returns leaves buffer (WITHOUT alpha applied) and alpha value to be applied in first tree layer.\n214\t#[instrument(name = \"prover.rap_constraints.logup_gkr.input_evals\", skip_all)]\n215\tpub fn log_gkr_input_evals<HS: GpuHashScheme>(\n216\t    trace_interactions: &[Option<TraceInteractionMeta>],\n217\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n218\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n219\t    l_skip: usize,\n220\t    alpha_logup: EF,\n221\t    d_challenges: &DeviceBuffer<EF>,\n222\t    total_leaves: usize,\n223\t) -> Result<(DeviceBuffer<Frac<EF>>, EF), InteractionGpuError> {\n224\t    if trace_interactions.iter().all(|meta| meta.is_none()) {\n225\t        return Ok((DeviceBuffer::new(), alpha_logup));\n226\t    }\n227\t\n228\t    let leaves = DeviceBuffer::<Frac<EF>>::with_capacity(total_leaves);\n229\t    leaves.fill_zero()?;\n230\t\n231\t    // Phase 1: Build work items and sort by descending height for load balance.\n232\t    let mut work_items: Vec<GkrInputWorkItem<HS>> = trace_interactions\n233\t        .iter()\n234\t        .flatten()\n235\t        .map(|meta| {\n236\t            let air_ctx = &ctx.per_trace[meta.trace_idx].1;\n237\t            let pk_air = &pk.per_air[meta.air_idx];\n238\t            let slice = meta.layout_slices.first().unwrap();\n239\t            assert_eq!(slice.col_idx, 0);\n240\t            let dst_offset = slice.row_idx;\n241\t            let leaves_ptr = unsafe { leaves.as_mut_ptr().add(dst_offset) };\n242\t            GkrInputWorkItem {\n243\t                air_ctx,\n244\t                pk_air,\n245\t                l_skip,\n246\t                d_challenges,\n247\t                leaves_ptr: SendPtr(leaves_ptr),\n248\t            }\n249\t        })\n250\t        .collect();\n251\t\n252\t    work_items.sort_by(|a, b| b.air_ctx.height().cmp(&a.air_ctx.height()));\n253\t\n254\t    // Pre-compute max buffer sizes across all work items.\n255\t    let mut max_intermediates_len: usize = 1;\n256\t    let mut max_public_values_len: usize = 0;\n257\t    let mut max_partition_ptrs_len: usize = 0;\n258\t    let mut max_tmp_len: usize = 0;\n259\t\n260\t    for w in &work_items {\n261\t        let rules = &w.pk_air.other_data.interaction_rules;\n262\t        let buffer_size = rules.inner.buffer_size as usize;\n263\t        let is_global = buffer_size > 10;\n264\t        if is_global {\n265\t            max_intermediates_len = max_intermediates_len.max(TASK_SIZE as usize * buffer_size);\n266\t        }\n267\t\n268\t        max_public_values_len = max_public_values_len.max(w.air_ctx.public_values.len());\n269\t\n270\t        let num_partitions = w.air_ctx.cached_mains.len() + 1;\n271\t        max_partition_ptrs_len = max_partition_ptrs_len.max(num_partitions);\n272\t\n273\t        let height = w.air_ctx.height();\n274\t        let lifted_height = height.max(1 << w.l_skip);\n275\t        if height != lifted_height {\n276\t            let num_interactions = w.pk_air.vk.symbolic_constraints.interactions.len();\n277\t            max_tmp_len = max_tmp_len.max(height * num_interactions);\n278\t        }\n279\t    }\n280\t\n281\t    // Barrier: ensure fill_zero() and all prior GPU work is visible to worker thread streams.\n282\t    current_stream_sync().map_err(InteractionGpuError::from)?;\n283\t\n284\t    // Phase 2: Process AIRs in parallel across N OS threads.\n285\t    let mut num_threads = if work_items.len() >= 100 {\n286\t        NUM_GKR_INPUT_STREAMS.min(work_items.len())\n287\t    } else {\n288\t        1\n289\t    };\n290\t\n291\t    // Memory budget check: reduce num_threads if pre-allocation would exceed 2 GB.\n292\t    let per_thread_bytes = max_intermediates_len * std::mem::size_of::<EF>()\n293\t        + max_public_values_len * std::mem::size_of::<F>()\n294\t        + max_partition_ptrs_len * std::mem::size_of::<u64>()\n295\t        + max_tmp_len * std::mem::size_of::<Frac<EF>>();\n296\t    while num_threads > 1 && num_threads * per_thread_bytes > 2_000_000_000 {\n297\t        num_threads /= 2;\n298\t        tracing::warn!(\n299\t            \"Reducing GKR input eval thread count to {} due to memory budget ({}MB per thread)\",\n300\t            num_threads,\n301\t            per_thread_bytes / (1024 * 1024)\n302\t        );\n303\t    }\n304\t\n305\t    // Pre-allocate per-thread buffer pools to avoid per-AIR mutex contention.\n306\t    let thread_buffers: Vec<GkrThreadBuffers> = (0..num_threads)\n307\t        .map(|_| GkrThreadBuffers {\n308\t            intermediates: DeviceBuffer::with_capacity(max_intermediates_len),\n309\t            public_values: if max_public_values_len > 0 {\n310\t                DeviceBuffer::with_capacity(max_public_values_len)\n311\t            } else {\n312\t                DeviceBuffer::new()\n313\t            },\n314\t            partition_ptrs: DeviceBuffer::with_capacity(max_partition_ptrs_len),\n315\t            tmp: if max_tmp_len > 0 {\n316\t                DeviceBuffer::with_capacity(max_tmp_len)\n317\t            } else {\n318\t                DeviceBuffer::new()\n319\t            },\n320\t        })\n321\t        .collect();\n322\t\n323\t    if num_threads <= 1 {\n324\t        let mut bufs = thread_buffers.into_iter().next().unwrap();\n325\t        for w in &work_items {\n326\t            process_gkr_input_air(w, &mut bufs)?;\n327\t        }\n328\t    } else {\n329\t        let chunk_size = work_items.len().div_ceil(num_threads);\n330\t        std::thread::scope(|s| {\n331\t            let handles: Vec<_> = thread_buffers\n332\t                .into_iter()\n333\t                .zip(work_items.chunks(chunk_size))\n334\t                .map(|(mut bufs, chunk)| {\n335\t                    s.spawn(move || -> Result<(), InteractionGpuError> {\n336\t                        for w in chunk {\n337\t                            process_gkr_input_air(w, &mut bufs)?;\n338\t                        }\n339\t                        current_stream_sync().map_err(InteractionGpuError::from)?;\n340\t                        Ok(())\n341\t                    })\n342\t                })\n343\t                .collect();\n344\t            for handle in handles {\n345\t                handle.join().unwrap()?;\n346\t            }\n347\t            Ok::<_, InteractionGpuError>(())\n348\t        })?;\n349\t    }\n350\t\n351\t    // NOTE: alpha is NO LONGER applied here - it will be fused into the first tree layer\n352\t    // in fractional_sumcheck_gpu for better performance (eliminates one memory pass)\n353\t    Ok((leaves, alpha_logup))\n354\t}\n355\t"}]},"parent_tool_use_id":"toolu_01AtdyzMWMsZyBSR8LM8TksV","session_id":"5bb7d674-211a-472f-a536-7708d797558d","uuid":"b568af69-1a17-479a-b8e9-dc4cfb8d5bce","timestamp":"2026-04-15T02:30:30.817Z"}
