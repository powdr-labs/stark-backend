\n697\t                    d_combinations: lc.d_numer_combinations.as_ptr(),\n698\t                    num_monomials: monomials.num_numer_monomials,\n699\t                }\n700\t            })\n701\t            .collect();\n702\t        let denom_ctxs_h: Vec<LogupMonomialCtx> = traces\n703\t            .iter()\n704\t            .zip(logup_combinations)\n705\t            .map(|(t, lc)| {\n706\t                let monomials = pk.per_air[t.air_idx]\n707\t                    .other_data\n708\t                    .interaction_monomials\n709\t                    .as_ref()\n710\t                    .unwrap();\n711\t                LogupMonomialCtx {\n712\t                    d_headers: monomials.d_denom_headers.as_ptr(),\n713\t                    d_variables: monomials.d_denom_variables.as_ptr(),\n714\t                    d_combinations: lc.d_denom_combinations.as_ptr(),\n715\t                    num_monomials: monomials.num_denom_monomials,\n716\t                }\n717\t            })\n718\t            .collect();\n719\t\n720\t        // Upload to device\n721\t        let block_ctxs = block_ctxs_h.to_device()?;\n722\t        let common_ctxs = common_ctxs_h.to_device()?;\n723\t        let numer_ctxs = numer_ctxs_h.to_device()?;\n724\t        let denom_ctxs = denom_ctxs_h.to_device()?;\n725\t        let air_offsets = air_offsets.to_device()?;\n726\t\n727\t        debug!(\n728\t            num_airs = traces.len(),\n729\t            num_blocks, \"LogupMonomialBatch created\"\n730\t        );\n731\t\n732\t        Ok(Self {\n733\t            traces,\n734\t            block_ctxs,\n735\t            common_ctxs,\n736\t            numer_ctxs,\n737\t            denom_ctxs,\n738\t            air_offsets,\n739\t            num_blocks,\n740\t        })\n741\t    }\n742\t\n743\t    /// Returns the trace indices in order.\n744\t    pub fn trace_indices(&self) -> impl Iterator<Item = usize> + '_ {\n745\t        self.traces.iter().map(|t| t.trace_idx)\n746\t    }\n747\t\n748\t    /// Eval