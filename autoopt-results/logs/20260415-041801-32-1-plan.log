{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01THZtvsUAgH2NRKeA9nRNnA","type":"tool_result","content":"300\t// LOGUP MONOMIAL KERNELS\n301\t// ============================================================================\n302\t\n303\ttemplate <bool IS_DENOM>\n304\t__global__ void precompute_logup_combinations_kernel(\n305\t    FpExt *__restrict__ out,\n306\t    const MonomialHeader *__restrict__ headers,\n307\t    const InteractionMonomialTerm *__restrict__ terms,\n308\t    const FpExt *__restrict__ beta_pows,\n309\t    const FpExt *__restrict__ eq_3bs,\n310\t    uint32_t num_monomials\n311\t) {\n312\t    uint32_t m = blockIdx.x * blockDim.x + threadIdx.x;\n313\t    if (m >= num_monomials)\n314\t        return;\n315\t\n316\t    MonomialHeader hdr = headers[m];\n317\t    FpExt sum(Fp::zero());\n318\t    for (uint16_t t = 0; t < hdr.num_terms; ++t) {\n319\t        InteractionMonomialTerm term = terms[hdr.term_offset + t];\n320\t        FpExt value = eq_3bs[term.interaction_idx] * term.coefficient;\n321\t        if constexpr (IS_DENOM) {\n322\t            value *= beta_pows[term.field_idx];\n323\t        }\n324\t        sum += value;\n325\t    }\n326\t    out[m] = sum;\n327\t}\n328\t\n329\textern \"C\" int _precompute_logup_numer_combinations(\n330\t    FpExt *out,\n331\t    const MonomialHeader *headers,\n332\t    const InteractionMonomialTerm *terms,\n333\t    const FpExt *eq_3bs,\n334\t    uint32_t num_monomials\n335\t) {\n336\t    if (num_monomials == 0)\n337\t        return 0;\n338\t\n339\t    constexpr uint32_t threads = 256;\n340\t    uint32_t blocks = div_ceil(num_monomials, threads);\n341\t    precompute_logup_combinations_kernel<false><<<blocks, threads>>>(\n342\t        out, headers, terms, nullptr, eq_3bs, num_monomials\n343\t    );\n344\t    return CHECK_KERNEL();\n345\t}\n346\t\n347\textern \"C\" int _precompute_logup_denom_combinations(\n348\t    FpExt *out,\n349\t    const MonomialHeader *headers,\n350\t    const InteractionMonomialTerm *terms,\n351\t    const FpExt *beta_pows,\n352\t    const FpExt *eq_3bs,\n353\t    uint32_t num_monomials\n354\t) {\n355\t    if (num_monomials == 0)\n356\t        return 0;\n357\t\n358\t    constexpr uint32_t threads = 256;\n359\t    uint32_t blocks = div_ceil(num_monomials, threads);\n360\t    precompute_logup_combinations_kernel<true><<<blocks, threads>>>(\n361\t        out, headers, terms, beta_pows, eq_3bs, num_monomials\n362\t    );\n363\t    return CHECK_KERNEL();\n364\t}\n365\t\n366\t// AIR context for logup monomial MLE evaluation\n367\t// Note: These structures match the Rust LogupMonomial*Ctx types\n368\tstruct LogupMonomialCommonCtx {\n369\t    EvalCoreCtx eval_ctx;\n370\t    const FpExt *__restrict__ d_eq_xi;\n371\t    FpExt bus_term_sum; // Precomputed sum_i(beta[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n372\t    uint32_t num_y;\n373\t    uint32_t mono_blocks;\n374\t};\n375\t\n376\tstruct LogupMonomialCtx {\n377\t    const MonomialHeader *__restrict__ d_headers;\n378\t    const PackedVar *__restrict__ d_variables;\n379\t    const FpExt *__restrict__ d_combinations;\n380\t    uint32_t num_monomials;\n381\t};\n382\t\n383\t// Logup monomial MLE kernel - evaluates numerator or denominator monomials per block.\n384\t// This produces FracExt output compatible with the standard reduction pattern.\n385\t//\n386\t// Block assignment: one block per (y_int, mono_block).\n387\t// Each block evaluates a chunk of monomials across threads.\n388\t//\n389\t// Template parameter IS_DENOM:\n390\t//   - false: numerator kernel, writes to tmp_sums[...].p\n391\t//   - true: denominator kernel, writes to tmp_sums[...].q and adds bus_term_sum when mono_block == 0\n392\ttemplate <bool IS_DENOM>\n393\t__global__ void logup_monomial_kernel(\n394\t    FracExt *__restrict__ tmp_sums,\n395\t    const BlockCtx *__restrict__ block_ctxs,\n396\t    const LogupMonomialCommonCtx *__restrict__ common_ctxs,\n397\t    const LogupMonomialCtx *__restrict__ ctxs\n398\t) {\n399\t    extern __shared__ char smem[];"}]},"parent_tool_use_id":"toolu_01Y6AgEssY221cRFMBZAZN47","session_id":"5bb7d674-211a-472f-a536-7708d797558d","uuid":"1765ba1a-0b2c-430a-b7c9-03c2d72fc630","timestamp":"2026-04-15T02:31:06.021Z"}
