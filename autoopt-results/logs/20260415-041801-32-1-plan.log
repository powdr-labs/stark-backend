{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JTb6GH8H4f9YexzMWafpja","type":"tool_result","content":"130\t            }\n131\t        }\n132\t    }\n133\t}\n134\t\n135\timpl Default for MemoryManager {\n136\t    fn default() -> Self {\n137\t        Self::new()\n138\t    }\n139\t}\n140\t\n141\tpub fn d_malloc(size: usize) -> Result<*mut c_void, MemoryError> {\n142\t    let manager = MEMORY_MANAGER.get().unwrap();\n143\t    let mut manager = manager.lock().map_err(|_| MemoryError::LockError)?;\n144\t    manager.d_malloc(size)\n145\t}\n146\t\n147\t/// # Safety\n148\t/// The pointer `ptr` must be a valid, previously allocated device pointer.\n149\t/// The caller must ensure that `ptr` is not used after this function is called.\n150\tpub unsafe fn d_free(ptr: *mut c_void) -> Result<(), MemoryError> {\n151\t    let manager = MEMORY_MANAGER.get().unwrap();\n152\t    let mut manager = manager.lock().map_err(|_| MemoryError::LockError)?;\n153\t    manager.d_free(ptr)\n154\t}\n155\t\n156\t#[derive(Debug, Clone)]\n157\tpub struct MemTracker {\n158\t    current: usize,\n159\t    label: &'static str,\n160\t}\n161\t\n162\timpl MemTracker {\n163\t    pub fn start(label: &'static str) -> Self {\n164\t        let current = MEMORY_MANAGER\n165\t            .get()\n166\t            .and_then(|m| m.lock().ok())\n167\t            .map(|m| m.current_size)\n168\t            .unwrap_or_default();\n169\t\n170\t        Self { current, label }\n171\t    }\n172\t\n173\t    pub fn start_and_reset_peak(label: &'static str) -> Self {\n174\t        let mut mem = Self::start(label);\n175\t        mem.reset_peak();\n176\t        mem\n177\t    }\n178\t\n179\t    pub fn emit_metrics(&self) {\n180\t        self.emit_metrics_with_label(self.label);\n181\t    }\n182\t\n183\t    pub fn emit_metrics_with_label(&self, label: &'static str) {\n184\t        let Some(manager) = MEMORY_MANAGER.get().and_then(|m| m.lock().ok()) else {\n185\t            return;\n186\t        };\n187\t\n188\t        let ts = SystemTime::now()\n189\t            .duration_since(UNIX_EPOCH)\n190\t            .unwrap()\n191\t            .as_secs_f64()\n192\t            * 1000.0;\n193\t        let current = manager.current_size;\n194\t        // local_peak is local maximum memory size, as observed by the manager, since the last\n195\t        // reset_peak call\n196\t        let local_peak = manager.max_used_size;\n197\t        let reserved = manager.pool.memory_usage();\n198\t        metrics::gauge!(\"gpu_mem.timestamp_ms\", \"module\" => label).set(ts);\n199\t        metrics::gauge!(\"gpu_mem.current_bytes\", \"module\" => label).set(current as f64);\n200\t        metrics::gauge!(\"gpu_mem.local_peak_bytes\", \"module\" => label).set(local_peak as f64);\n201\t        metrics::gauge!(\"gpu_mem.reserved_bytes\", \"module\" => label).set(reserved as f64);\n202\t    }\n203\t\n204\t    #[inline]\n205\t    pub fn tracing_info(&self, msg: impl Into<Option<&'static str>>) {\n206\t        let Some(manager) = MEMORY_MANAGER.get().and_then(|m| m.lock().ok()) else {\n207\t            tracing::error!(\"Memory manager not available\");\n208\t            return;\n209\t        };\n210\t        let current = manager.current_size;\n211\t        let peak = manager.max_used_size;\n212\t        let used = current as isize - self.current as isize;\n213\t        let sign = if used >= 0 { \"+\" } else { \"-\" };\n214\t        let pool_usage = manager.pool.memory_usage();\n215\t        tracing::info!(\n216\t            \"GPU mem: used={}{}, current={}, peak={}, in pool={} ({})\",\n217\t            sign,\n218\t            ByteSize::b(used.unsigned_abs() as u64),\n219\t            ByteSize::b(current as u64),\n220\t            ByteSize::b(peak as u64),\n221\t            ByteSize::b(pool_usage as u64),\n222\t            msg.into()\n223\t                .map_or(self.label.to_string(), |m| format!(\"{}:{}\", self.label, m))\n224\t        );\n225\t    }\n226\t\n227\t    pub fn reset_peak(&mut self