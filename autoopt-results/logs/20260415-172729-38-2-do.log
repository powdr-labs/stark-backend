{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JGb9nH2ws9v5rBfCjSfrTP","type":"tool_result","content":"commit 0d1bb2f9ab42cdb394540932f9048df1cf526a89\nAuthor: Claude <claude@anthropic.com>\nDate:   Wed Apr 15 15:36:26 2026 +0200\n\n    Batch Round 0 descriptor arrays with PRUNE_SHMEM_KERNELS\n    \n    Add batched descriptor-array CUDA kernels for Round 0 zerocheck and logup\n    evaluation of small AIRs, plus caller-level routing in sumcheck_uni_round0_polys.\n    \n    CUDA changes:\n    - Round0ZcCtx/Round0LogupCtx per-AIR descriptor structs\n    - batched_zerocheck_r0_coset_parallel_kernel: 1D grid with BlockCtx mapping\n    - batched_logup_r0_coset_parallel_kernel: same pattern with identity-coset\n    - Only GLOBAL=true, NEEDS_SHMEM=false instantiated to minimize cubin size\n    \n    Rust changes:\n    - #[repr(C)] FFI structs (Round0BlockCtx, Round0ZcCtx, Round0LogupCtx) and wrappers\n    - New round0_batched.rs module: identify_batchable_airs() + batch_round0_small_airs()\n      writes directly to d_batch_array via existing GPU extraction kernels\n    - Caller routing in sumcheck_uni_round0_polys (Phase 1b before multi-stream dispatch)\n    \n    Build changes:\n    - PRUNE_SHMEM_KERNELS compile flag halves Round 0 template instantiations\n      (safe when skip_domain <= WARP_SIZE, i.e. l_skip <= 5)\n    - Reduces libcuda-backend.a from 9.3M to 6.5M\n    \n    Co-Authored-By: Claude Opus 4.6 (1M context) <noreply@anthropic.com>\n\ndiff --git a/crates/cuda-backend/cuda/src/logup_zerocheck/zerocheck_round0.cu b/crates/cuda-backend/cuda/src/logup_zerocheck/zerocheck_round0.cu\nindex db8e8217..0c1aeb0e 100644\n--- a/crates/cuda-backend/cuda/src/logup_zerocheck/zerocheck_round0.cu\n+++ b/crates/cuda-backend/cuda/src/logup_zerocheck/zerocheck_round0.cu\n@@ -716,6 +716,181 @@ extern \"C\" int _zerocheck_ntt_eval_constraints(\n #undef KERNEL_ARGS\n }\n \n+// ============================================================================\n+// BATCHED Round 0 Zerocheck\n+// ============================================================================\n+\n+struct Round0ZcCtx {\n+    const Fp *selectors_cube;\n+    const Fp *preprocessed;\n+    const Fp *const *main_parts;\n+    const FpExt *eq_cube;\n+    const FpExt *lambda_pows;\n+    const Fp *public_values;\n+    const Rule *d_rules;\n+    const size_t *d_used_nodes;\n+    size_t rules_len;\n+    size_t used_nodes_len;\n+    size_t lambda_len;\n+    uint32_t buffer_size;\n+    Fp *d_intermediates;\n+    uint32_t buffer_stride;\n+    uint32_t num_x;\n+    uint32_t height;\n+    Fp g_shift;\n+};\n+\n+struct Round0BlockCtx {\n+    uint32_t local_block_idx;\n+    uint32_t air_idx;\n+};\n+\n+template <bool GLOBAL, bool NEEDS_SHMEM>\n+__global__ void batched_zerocheck_r0_coset_parallel_kernel(\n+    FpExt *__restrict__ tmp_sums_buffer,\n+    const Round0BlockCtx *__restrict__ d_block_ctxs,\n+    const Round0ZcCtx *__restrict__ d_zc_ctxs,\n+    uint32_t num_cosets,\n+    uint32_t skip_domain\n+) {\n+    extern __shared__ char smem[];\n+    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem);\n+    Fp *ntt_buffers_base =\n+        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FpExt)) : nullptr;\n+\n+    Round0BlockCtx block_ctx = d_block_ctxs[blockIdx.x];\n+    Round0ZcCtx ctx = d_zc_ctxs[block_ctx.air_idx];\n+\n+    uint32_t const l_skip = __ffs(skip_domain) - 1;\n+    uint32_t const x_per_block = blockDim.x >> l_skip;\n+    uint32_t const num_x_blocks = (ctx.num_x + x_per_block - 1) / x_per_block;\n+    uint32_t const coset_idx = block_ctx.local_block_idx / num_x_blocks;\n+    uint32_t const x_block_idx = block_ctx.local_block_idx % num_x_blocks;\n+\n+    if (coset_idx >= num_cosets) return;\n+\n+    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n+    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n+    uint32_t const ntt_idx = threadIdx.x & (skip_domain - 1);\n+    uint32_t const x_int_base = x_block_idx * x_per_block + x_int_in_block;\n+    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n+\n+    uint32_t const log_height_total = __ffs(ctx.height) - 1;\n+    uint32_t const log_segment = min(l_skip, log_height_total);\n+    uint32_t const segment_size = 1u << log_segment;\n+    uint32_t const log_stride = l_skip - log_segment;\n+\n+    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n+    Fp const omega_skip_ntt =\n+        (l_skip == 0) ? Fp::one() : device_ntt::get_twiddle(l_skip, ntt_idx);\n+\n+    Fp const g_coset = pow(ctx.g_shift, coset_idx + 1);\n+    Fp const eval_point = g_coset * omega_skip_ntt;\n+    Fp const omega = exp_power_of_2(eval_point, log_stride);\n+    Fp const is_first_mult = avg_gp(omega, segment_size);\n+    Fp const is_last_mult = avg_gp(omega * eta, segment_size);\n+    Fp const omega_shift = pow(g_coset, ntt_idx_rev);\n+\n+    Fp *inter_buffer;\n+    uint32_t buffer_stride;\n+    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD];\n+    if constexpr (GLOBAL) {\n+        uint32_t air_tidx = coset_idx * num_x_blocks * blockDim.x + x_block_idx * blockDim.x + threadIdx.x;\n+        inter_buffer = ctx.d_intermediates + air_tidx;\n+        buffer_stride = ctx.buffer_stride;\n+    } else {\n+        inter_buffer = local_buffer;\n+        buffer_stride = 1;\n+    }\n+\n+    FpExt sum = FpExt(Fp::zero());\n+\n+    NttEvalContext<1> eval_ctx{\n+        ctx.preprocessed, ctx.main_parts, ctx.public_values,\n+        inter_buffer, ntt_buffer, {omega_shift},\n+        skip_domain, ctx.height, buffer_stride, ctx.buffer_size, ntt_idx,\n+    };\n+\n+    uint32_t x_int = x_int_base;\n+    if (x_int < ctx.num_x) {\n+        Fp is_first = is_first_mult * ctx.selectors_cube[x_int];\n+        Fp is_last = is_last_mult * ctx.selectors_cube[2 * ctx.num_x + x_int];\n+\n+        FpExt constraint_sums[1];\n+        acc_constraints<1, NEEDS_SHMEM>(\n+            constraint_sums, eval_ctx, &is_first, &is_last, x_int,\n+            ctx.lambda_pows, ctx.d_rules, ctx.rules_len,\n+            ctx.d_used_nodes, ctx.used_nodes_len, ctx.lambda_len\n+        );\n+        sum = constraint_sums[0] * ctx.eq_cube[x_int];\n+    }\n+\n+    Fp zerofier = exp_power_of_2(eval_point, l_skip) - Fp::one();\n+    shared_sum[threadIdx.x] = sum * inv(zerofier);\n+    __syncthreads();\n+\n+    if (threadIdx.x < skip_domain) {\n+        FpExt tile_sum = shared_sum[threadIdx.x];\n+        for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n+            tile_sum += shared_sum[(lane << l_skip) + threadIdx.x];\n+        }\n+        tmp_sums_buffer[blockIdx.x * num_cosets * skip_domain + coset_idx * skip_domain + ntt_idx] =\n+            tile_sum;\n+    }\n+}\n+\n+template <bool GLOBAL, bool NEEDS_SHMEM>\n+int launch_batched_zerocheck_r0(\n+    FpExt *tmp_sums_buffer, FpExt *output,\n+    const Round0BlockCtx *d_block_ctxs, const Round0ZcCtx *d_zc_ctxs,\n+    const uint32_t *d_air_offsets,\n+    uint32_t total_blocks, uint32_t num_airs,\n+    uint32_t num_cosets, uint32_t skip_domain, uint32_t block_x\n+) {\n+    if (total_blocks == 0) return 0;\n+\n+    dim3 grid(total_blocks);\n+    dim3 block(block_x);\n+    size_t shared_sum_size = sizeof(FpExt) * block_x;\n+    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block_x : 0;\n+    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n+\n+    batched_zerocheck_r0_coset_parallel_kernel<GLOBAL, NEEDS_SHMEM>\n+        <<<grid, block, shmem_bytes>>>(\n+            tmp_sums_buffer, d_block_ctxs, d_zc_ctxs, num_cosets, skip_domain\n+        );\n+    int err = CHECK_KERNEL();\n+    if (err != 0) return err;\n+\n+    uint32_t d = num_cosets * skip_domain;\n+    auto [reduce_grid_unused, reduce_block] = kernel_launch_params(total_blocks);\n+    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n+    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n+    dim3 reduce_grid(num_airs, d);\n+    sumcheck::batched_final_reduce_block_sums