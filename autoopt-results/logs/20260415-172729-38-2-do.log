{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B7NhZWbA7Zq2hkJ7bQuASa","type":"tool_result","content":"1\t#include <algorithm>\n2\t#include <cassert>\n3\t#include <cmath>\n4\t#include <cstdint>\n5\t#include <cstdio>\n6\t#include <cstdlib>\n7\t#include <utility>\n8\t#include <vector_types.h>\n9\t\n10\t#include \"codec.cuh\"\n11\t#include \"dag_entry.cuh\"\n12\t#include \"eval_config.cuh\"\n13\t#include \"fp.h\"\n14\t#include \"fpext.h\"\n15\t#include \"launcher.cuh\"\n16\t#include \"sumcheck.cuh\"\n17\t#include \"utils.cuh\"\n18\t\n19\tusing namespace symbolic_dag;\n20\t\n21\tnamespace zerocheck_round0 {\n22\t\n23\tconstexpr uint32_t BUFFER_THRESHOLD = 16;\n24\t// Threshold for switching between coset-parallel and lockstep modes.\n25\t// When num_x * skip_domain < threshold, use coset-parallel (grid.y = num_cosets) for better GPU utilization.\n26\t// When >= threshold, use lockstep (single thread handles all cosets) to avoid redundant iNTT.\n27\tconstexpr uint32_t COSET_PARALLEL_THRESHOLD = 32768; // 2^15\n28\t\n29\t// Device function to compute constraint sums for all cosets in lockstep with DAG traversal.\n30\t// This computes: sum(lambda_i * constraint_i) for all constraints, for each coset.\n31\t// NOTE: Using __inline__ instead of __forceinline__ to let compiler decide based on register pressure.\n32\ttemplate <uint32_t NUM_COSETS, bool NEEDS_SHMEM>\n33\t__device__ __inline__ void acc_constraints(\n34\t    FpExt *__restrict__ constraint_sums, // output [NUM_COSETS]\n35\t    const NttEvalContext<NUM_COSETS> &eval_ctx,\n36\t    const Fp *is_first, // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n37\t    const Fp *is_last,  // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n38\t    uint32_t x_int,\n39\t    const FpExt *__restrict__ d_lambda_pows,\n40\t    const Rule *__restrict__ d_rules,\n41\t    size_t rules_len,\n42\t    const size_t *__restrict__ d_used_nodes,\n43\t    size_t used_nodes_len,\n44\t    size_t lambda_len\n45\t) {\n46\t    size_t lambda_idx = 0;\n47\t\n48\t    // Initialize constraint sums to zero\n49\t#pragma unroll\n50\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n51\t        constraint_sums[c] = FpExt(Fp::zero());\n52\t    }\n53\t\n54\t    for (size_t node = 0; node < rules_len; ++node) {\n55\t        Rule rule = d_rules[node];\n56\t        // Lazy decoding: only decode header (op, flags, x) upfront\n57\t        RuleHeader header = decode_rule_header(rule);\n58\t\n59\t        // Evaluate x operand for all cosets\n60\t        Fp x_vals[NUM_COSETS];\n61\t        ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(x_vals, header.x, eval_ctx, is_first, is_last, x_int);\n62\t\n63\t        switch (header.op) {\n64\t        case OP_ADD: {\n65\t            // Decode y only for binary ops\n66\t            SourceInfo y_src = decode_y(rule);\n67\t            Fp y_vals[NUM_COSETS];\n68\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n69\t#pragma unroll\n70\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n71\t                x_vals[c] += y_vals[c];\n72\t            }\n73\t            break;\n74\t        }\n75\t        case OP_SUB: {\n76\t            SourceInfo y_src = decode_y(rule);\n77\t            Fp y_vals[NUM_COSETS];\n78\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n79\t#pragma unroll\n80\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n81\t                x_vals[c] -= y_vals[c];\n82\t            }\n83\t            break;\n84\t        }\n85\t        case OP_MUL: {\n86\t            SourceInfo y_src = decode_y(rule);\n87\t            Fp y_vals[NUM_COSETS];\n88\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n89\t#pragma unroll\n90\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n91\t                x_vals[c] *= y_vals[c];\n92\t            }\n93\t            break;\n94\t        }\n95\t        case OP_NEG:\n96\t#pragma unroll\n97\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n98\t                x_vals[c] = -x_vals[c];\n99\t            }\n100\t            break;\n101\t        case OP_VAR:\n102\t            break;\n103\t        case OP_INV:\n104\t#pragma unroll\n105\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n106\t                x_vals[c] = inv(x_vals[c]);\n107\t            }\n108\t            break;\n109\t        }\n110\t\n111\t        // Store intermediate results for all cosets\n112\t        // Decode z_index only when buffering\n113\t        if (header.buffer_result && eval_ctx.buffer_size > 0) {\n114\t            uint32_t z_index = decode_z_index(rule);\n115\t#ifdef CUDA_DEBUG\n116\t            assert(z_index < eval_ctx.buffer_size);\n117\t#endif\n118\t            // Intermediate buffer layout: [buffer_size][NUM_COSETS] per thread\n119\t#pragma unroll\n120\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n121\t                eval_ctx.inter_buffer[z_index * eval_ctx.buffer_stride + c] = x_vals[c];\n122\t            }\n123\t        }\n124\t\n125\t        // Accumulate constraint sums\n126\t        if (header.is_constraint) {\n127\t            while (lambda_idx < lambda_len && lambda_idx < used_nodes_len &&\n128\t                   d_used_nodes[lambda_idx] == node) {\n129\t                FpExt lambda = d_lambda_pows[lambda_idx];\n130\t                lambda_idx++;\n131\t#pragma unroll\n132\t                for (uint32_t c = 0; c < NUM_COSETS; c++) {\n133\t                    constraint_sums[c] += lambda * x_vals[c];\n134\t                }\n135\t            }\n136\t        }\n137\t    }\n138\t}\n139\t\n140\t// NTT-based kernel: Each thread handles ALL cosets in lockstep.\n141\t// Grid: (num_x_blocks, 1) - no coset dimension\n142\t// Block: (skip_domain * x_per_block)\n143\t// Thread layout: ntt_idx = threadIdx.x % skip_domain, varies fastest\n144\t//\n145\t// Key optimization: iNTT is done ONCE per trace access, then coefficient is\n146\t// used for all coset shifts + forward NTTs.\n147\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n148\t__global__ void zerocheck_ntt_evaluate_constraints_kernel(\n149\t    FpExt *__restrict__ tmp_sums_buffer,   // [num_blocks][NUM_COSETS][skip_domain]\n150\t    const Fp *__restrict__ selectors_cube, // [3][num_x]"}]},"parent_tool_use_id":"toolu_01GTtX9XXugCmiUqZ9L7v5oN","session_id":"fa62649b-653a-4cec-aa74-3431ae869005","uuid":"7e6f7449-7f0d-4e59-b449-25569159cddd","timestamp":"2026-04-15T17:12:27.108Z"}
