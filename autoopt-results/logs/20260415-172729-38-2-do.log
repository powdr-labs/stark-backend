ts: logup.d_denom_weights.as_ptr(),\n            denom_sum_init: logup.denom_sum_init,\n            num_x: d.num_x,\n            height: d.height,\n            g_shift: d.g_shift,\n        });\n    }\n\n    let d_block_ctxs = block_ctxs_h.to_device()?;\n    let d_logup_ctxs = logup_ctxs_h.to_device()?;\n    let d_air_offsets = air_offsets_h.to_device()?;\n\n    let output_size = descs.len() * num_cosets as usize * skip_domain as usize;\n    let tmp_sums_size = total_blocks as usize * num_cosets as usize * skip_domain as usize;\n    let mut tmp_sums_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(tmp_sums_size);\n    let mut output = DeviceBuffer::<Frac<EF>>::with_capacity(output_size);\n\n    unsafe {\n        batched_logup_r0_eval_interactions(\n            &mut tmp_sums_buffer,\n            &mut output,\n            &d_block_ctxs,\n            &d_logup_ctxs,\n            &d_air_offsets,\n            total_blocks,\n            descs.len() as u32,\n            num_cosets,\n            skip_domain,\n            block_x,\n        )?;\n    }\n    Ok((output, intermediates))\n}\n","structuredPatch":[{"oldStart":226,"oldLines":6,"newStart":226,"newLines":15,"lines":["     skip_domain: u32,"," }"," ","+impl BatchEvalState {","+    /// Drop intermediates arenas to free GPU memory before Phase 2.","+    /// Safe to call after current_stream_sync() ensures all eval kernels are done.","+    pub fn drop_intermediates(&mut self) {","+        self._zc_intermediates.clear();","+        self._logup_intermediates.clear();","+    }","+}","+"," /// Execute batched Round 0 eval-only for all batchable AIRs."," ///"," /// Runs batched eval+reduce kernels for groups of small AIRs on the default"]}],"userModified":false,"replaceAll":false}}
