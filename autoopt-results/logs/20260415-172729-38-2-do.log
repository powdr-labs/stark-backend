m_init,\n            num_x: d.num_x,\n            height: d.height,\n            g_shift: d.g_shift,\n        });\n    }\n\n    let d_block_ctxs = block_ctxs_h.to_device()?;\n    let d_logup_ctxs = logup_ctxs_h.to_device()?;\n    let d_air_offsets = air_offsets_h.to_device()?;\n\n    let output_size = descs.len() * num_cosets as usize * skip_domain as usize;\n    let tmp_sums_size = total_blocks as usize * num_cosets as usize * skip_domain as usize;\n    let mut tmp_sums_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(tmp_sums_size);\n    let mut output = DeviceBuffer::<Frac<EF>>::with_capacity(output_size);\n\n    unsafe {\n        batched_logup_r0_eval_interactions(\n            &mut tmp_sums_buffer,\n            &mut output,\n            &d_block_ctxs,\n            &d_logup_ctxs,\n            &d_air_offsets,\n            total_blocks,\n            descs.len() as u32,\n            num_cosets,\n            skip_domain,\n            block_x,\n        )?;\n    }\n    Ok((output, intermediates))\n}\n","structuredPatch":[{"oldStart":344,"oldLines":7,"newStart":344,"newLines":7,"lines":["         });","     }"," ","-    tracing::info!(\"batch_round0: descriptors built in {}ms\", t_desc_start.elapsed().as_millis());","+    eprintln!(\"[BATCH_R0] descriptors built in {}ms\", t_desc_start.elapsed().as_millis());"," ","     // Group by num_cosets_zc, launch batched zerocheck eval.","     let mut zc_group_map: BTreeMap<u32, Vec<usize>> = BTreeMap::new();"]}],"userModified":false,"replaceAll":false}}
