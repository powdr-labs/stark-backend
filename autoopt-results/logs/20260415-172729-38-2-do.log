\tpub struct InterpTraceDescM {\n125\t    pub output: *mut EF,\n126\t    pub matrix_offset: u32,\n127\t    pub num_matrices: u32,\n128\t    pub num_y: u32,\n129\t    pub num_columns: u32,\n130\t    pub total_threads: u32,\n131\t    pub block_start: u32,\n132\t}\n133\t\n134\tunsafe impl Send for InterpTraceDescM {}\n135\tunsafe impl Sync for InterpTraceDescM {}\n136\t\n137\t// end of types for batch MLE\n138\t\n139\textern \"C\" {\n140\t    // gkr.cu\n141\t    fn _frac_build_tree_layer(\n142\t        layer: *mut Frac<EF>,\n143\t        layer_size: usize,\n144\t        revert: bool,\n145\t        alpha: EF,\n146\t        apply_alpha: bool,\n147\t    ) -> i32;\n148\t\n149\t    /// Fused two-layer tree build. Applies layers i and i+1 in one kernel pass,\n150\t    /// keeping intermediate right-half nodes for revert operations.\n151\t    /// `half_i1` = N >> (i+2), where i is the first of the two layers.\n152\t    fn _frac_build_tree_two_layers(layer: *mut Frac<EF>, half_i1: usize) -> i32;\n153\t\n154\t    pub fn _frac_compute_round_temp_buffer_size(stride: u32) -> u32;\n155\t\n156\t    fn _frac_compute_round(\n157\t        eq_xi_low: *const EF,\n158\t        eq_xi_high: *const EF,\n159\t        pq_buffer: *const Frac<EF>,\n160\t        num_x: usize,\n161\t        eq_low_cap: usize,\n162\t        lambda: EF,\n163\t        out_device: *mut EF,\n164\t        tmp_block_sums: *mut EF,\n165\t    ) -> i32;\n166\t\n167\t    /// Fused compute round + tree layer revert. Combines frac_build_tree_layer(revert=true)\n168\t    /// with compute_round for the first inner round. Modifies layer in-place for revert.\n169\t    fn _frac_compute_round_and_revert(\n170\t        eq_xi_low: *const EF,\n171\t        eq_xi_high: *const EF,\n172\t        layer: *mut Frac<EF>,\n173\t        num_x: usize,\n174\t        eq_low_cap: usize,\n175\t        lambda: EF,\n176\t        out_device: *mut EF,\n177\t        tmp_block_sums: *mut EF,\n178\t    ) -> i32;\n179\t\n180\t    fn _frac_fold_fpext_columns