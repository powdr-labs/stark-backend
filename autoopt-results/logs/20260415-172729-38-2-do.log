    }\n1398\t                            // Sync this thread's stream to ensure all extraction kernels\n1399\t                            // complete before the thread exits. Required so the main thread's\n1400\t                            // D2H copy sees the final data.\n1401\t                            current_stream_sync().map_err(MemCopyError::from)?;\n1402\t                            tracing::debug!(thread_id, elapsed_ms = t0.elapsed().as_millis(), num_airs = indices.len(), \"round0 thread done\");\n1403\t                            Ok(())\n1404\t                        })\n1405\t                    })\n1406\t                    .collect();\n1407\t\n1408\t                // Join Round 0 workers first.\n1409\t                for handle in handles {\n1410\t                    handle.join().unwrap()?;\n1411\t                }\n1412\t                // Join precompute thread.\n1413\t                let precompute = precompute_handle.join().unwrap()?;\n1414\t                Ok::<_, LogupZerocheckError>(precompute)\n1415\t            })?;\n1416\t\n1417\t            // Store precompute results into self (after scope exits, all threads done).\n1418\t            self.d_eq_3b_per_trace = precompute_result.0;\n1419\t            self.logup_combinations = precompute_result.1;\n1420\t        }\n1421\t\n1422\t        // Phase 3: Single D2H copy of the batch array, then reconstruct batch_sp_poly.\n1423\t        let host_batch = if batch_total > 0 {\n1424\t            d_batch_array.to_host()?\n1425\t        } else {\n1426\t            vec![]\n1427\t        };\n1428\t        for (trace_idx, &(zc_len, numer_len, denom_len)) in poly_lens.iter().enumerate() {\n1429\t            if zc_len > 0 {\n1430\t                let offset = (2 * num_present_airs + trace_idx) * max_poly_len;\n1431\t                batch_sp_poly[2 * num_present_airs + trace_idx] =\n1432\t                    UnivariatePoly::new(host_batch[offset..offset + zc_len].to_vec());\n1433\t            }\n1434\t            if numer_len > 0 {\n1435\t                let offset = (2 * trace_idx) * max_poly_len;\n1436\t                batch_sp_poly[2 * trace_idx] =\n1437\t                    UnivariatePoly::new(host_batch[offset..offset + numer_len].to_vec());\n1438\t            }\n1439\t            if denom_len > 0 {\n1440\t                let offset = (2 * trace_idx + 1) * max_poly_len;\n1441\t                batch_sp_poly[2 * trace_idx + 1] =\n1442\t                    UnivariatePoly::new(host_batch[offset..offset + denom_len].to_vec());\n1443\t            }\n1444\t        }\n1445\t        self.mem\n1446\t            .emit_metrics_with_label(\"prover.batch_constraints.round0\");\n1447\t        Ok(batch_sp_poly)\n1448\t    }\n1449\t"}]},"parent_tool_use_id":"toolu_01GTtX9XXugCmiUqZ9L7v5oN","session_id":"fa62649b-653a-4cec-aa74-3431ae869005","uuid":"50564687-3aeb-4eb9-b2fa-d29f901ba60c","timestamp":"2026-04-15T17:12:15.040Z"}
