 FpExt *__restrict__ d_challenges\n) {\n    BatchBlockCtx ctx = block_ctxs[blockIdx.x];\n    BatchGkrInputDesc desc = descs[ctx.air_idx];\n\n    uint32_t row = ctx.local_block_idx * blockDim.x + threadIdx.x;\n    if (row >= desc.permutation_height) return;\n\n    // Per-thread intermediates: contiguous scratch with stride=1\n    FpExt *intermediates_ptr = intermediates_base + desc.intermediates_offset + (size_t)row * desc.buffer_size;\n    uint32_t intermediate_stride = 1;\n\n    uint32_t rules_evaluated = 0;\n    for (uint32_t used_idx = 0; used_idx < desc.used_nodes_len; used_idx++) {\n        uint32_t node_idx = desc.d_used_nodes[used_idx];\n        FpExt result(0);\n        if (node_idx < rules_evaluated) {\n            Rule rule = desc.d_rules[node_idx];\n            RuleHeader header = decode_rule_header(rule);\n            if (header.op == OP_VAR) {\n                result = evaluate_dag_entry_gkr(\n                    header.x, row,\n                    desc.d_preprocessed, desc.d_main, desc.d_public_values,\n                    d_challenges, intermediates_ptr, intermediate_stride,\n                    desc.permutation_height\n                );\n            } else {\n                uint32_t z_index = decode_z_index(rule);\n                result = intermediates_ptr[z_index * intermediate_stride];\n            }\n        } else {\n            for (; rules_evaluated <= node_idx; rules_evaluated++) {\n                Rule rule = desc.d_rules[rules_evaluated];\n                RuleHeader header = decode_rule_header(rule);\n\n                FpExt x = evaluate_dag_entry_gkr(\n                    header.x, row,\n                    desc.d_preprocessed, desc.d_main, desc.d_public_values,\n                    d_challenges, intermediates_ptr, intermediate_stride,\n                    desc.permutation_height\n                );\n                FpExt y;\n\n                switch (header.op) {\n                case OP_ADD:\n                    y = evaluate_dag_entry_gkr(\n                        decode_y(rule), row,\n                        desc.d_preprocessed, desc.d_main, desc.d_public_values,\n                        d_challenges, intermediates_ptr, intermediate_stride,\n                        desc.permutation_height\n                    );\n                    result = x + y;\n                    break;\n                case OP_SUB:\n                    y = evaluate_dag_entry_gkr(\n                        decode_y(rule), row,\n                        desc.d_preprocessed, desc.d_main, desc.d_public_values,\n                        d_challenges, intermediates_ptr, intermediate_stride,\n                        desc.permutation_height\n                    );\n                    result = x - y;\n                    break;\n                case OP_MUL:\n                    y = evaluate_dag_entry_gkr(\n                        decode_y(rule), row,\n                        desc.d_preprocessed, desc.d_main, desc.d_public_values,\n                        d_challenges, intermediates_ptr, intermediate_stride,\n                        desc.permutation_height\n                    );\n                    x *= y;\n                    result = x;\n                    break;\n                case OP_NEG:\n                    result = -x;\n                    break;\n                case OP_VAR:\n                    result = x;\n                    break;\n                default:\n                    assert(0);\n                }\n\n                if (header.buffer_result) {\n                    uint32_t z_index = decode_z_index(rule);\n                    intermediates_ptr[z_index * intermediate_stride] = result;\n                }\n            }\n        }\n\n        uint32_t pair_idx = desc.d_pair_idxs[used_idx];\n        size_t interaction_idx = pair_idx >> 1;\n        size_t out_idx = (interaction_idx * desc.permutation_height + row) * 2;\n        reinterpret_cast<FpExt *>(desc.d_fracs)[out_idx + (pair_idx & 1)] = result;\n    }\n}\n\n// ============================================================================\n// LAUNCHERS\n// ============================================================================\n\nconstexpr uint32_t TASK_SIZE = 1 << 16;\n\nextern \"C\" int _logup_gkr_input_eval(\n    bool is_global,\n    FracExt *d_fracs,\n    const Fp *d_preprocessed,\n    const uint64_t *d_main,\n    const Fp *d_public_values,\n    const FpExt *d_challenges,\n    const FpExt *d_intermediates,\n    const Rule *d_rules,\n    const size_t *d_used_nodes,\n    const uint32_t *d_pair_idxs,\n    size_t used_nodes_len,\n    uint32_t permutation_height,\n    uint32_t num_rows_per_tile\n) {\n    auto count = is_global ? TASK_SIZE : permutation_height;\n    auto [grid, block] = kernel_launch_params(count, 256);\n    if (is_global) {\n        evaluate_interactions_gkr_kernel<true><<<grid, block>>>(\n            d_fracs,\n            d_preprocessed,\n            d_main,\n            d_public_values,\n            d_challenges,\n            d_intermediates,\n            d_rules,\n            d_used_nodes,\n            d_pair_idxs,\n            used_nodes_len,\n            permutation_height,\n            num_rows_per_tile\n        );\n    } else {\n        evaluate_interactions_gkr_kernel<false><<<grid, block>>>(\n            d_fracs,\n            d_preprocessed,\n            d_main,\n            d_public_values,\n            d_challenges,\n            d_intermediates,\n            d_rules,\n            d_used_nodes,\n            d_pair_idxs,\n            used_nodes_len,\n            permutation_height,\n            num_rows_per_tile\n        );\n    }\n    return CHECK_KERNEL();\n}\n\n} // namespace logup_gkr_input_evaluation\n","structuredPatch":[{"oldStart":387,"oldLines":4,"newStart":387,"newLines":18,"lines":["     return CHECK_KERNEL();"," }"," ","+extern \"C\" int _batched_gkr_input_eval(","+    const BatchGkrInputDesc *descs,","+    const BatchBlockCtx *block_ctxs,","+    uint32_t total_blocks,","+    FpExt *intermediates,","+    const FpExt *d_challenges","+) {","+    if (total_blocks == 0) return 0;","+    batched_gkr_input_eval_kernel<<<total_blocks, 256>>>(","+        descs, block_ctxs, intermediates, d_challenges","+    );","+    return CHECK_KERNEL();","+}","+"," } // namespace logup_gkr_input_evaluation"]}],"userModified":false,"replaceAll":false}}
