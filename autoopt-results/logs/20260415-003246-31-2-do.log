e);\n                result = x_val - y_val;\n                break;\n            }\n            case OP_MUL: {\n                FpExt y_val = evaluate_mle_entry(decoded.y, row, eval_ctx, buffer_stride);\n                result = x_val * y_val;\n                break;\n            }\n            case OP_NEG:\n                result = -x_val;\n                break;\n            case OP_VAR:\n                result = x_val;\n                break;","numLines":80,"startLine":100,"totalLines":451}}}
