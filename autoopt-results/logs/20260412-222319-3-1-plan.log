{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019aBPSe56UuGehN5UuY5PwL","type":"tool_result","content":"484\t    fn batch_sumcheck_uni_round0_poly(\n485\t        &mut self,\n486\t    ) -> Result<UnivariatePoly<EF>, StackedReductionError> {\n487\t        let l_skip = self.l_skip;\n488\t        let skip_domain = 1 << l_skip;\n489\t        let s_0_deg = sumcheck_round0_deg(l_skip, STACKED_REDUCTION_S_DEG);\n490\t\n491\t        // Accumulation buffers for G0, G1, G2 (on identity coset)\n492\t        // d_g_pos: for n >= 0 traces\n493\t        let mut d_g_pos = DeviceBuffer::<EF>::with_capacity(NUM_G * skip_domain);\n494\t        d_g_pos\n495\t            .fill_zero()\n496\t            .map_err(StackedReductionError::FillZero)?;\n497\t\n498\t        // d_g_neg[k]: for traces with |n| = k+1, where n < 0 and k in 0..l_skip\n499\t        let mut d_g_neg: Vec<DeviceBuffer<EF>> = (0..l_skip)\n500\t            .map(|_| {\n501\t                let b = DeviceBuffer::with_capacity(NUM_G * skip_domain);\n502\t                b.fill_zero().map_err(StackedReductionError::FillZero)?;\n503\t                Ok(b)\n504\t            })\n505\t            .collect::<Result<Vec<_>, StackedReductionError>>()?;\n506\t\n507\t        // Process each trace - call kernel for each, accumulating into appropriate bucket\n508\t        for ((trace_ptr, trace_height, trace_width), window) in zip(\n509\t            mem::take(&mut self.trace_ptrs),\n510\t            self.ht_diff_idxs.windows(2),\n511\t        ) {\n512\t            debug_assert_eq!(window[1] - window[0], trace_width);\n513\t            let log_height = trace_height.ilog2();\n514\t            let n = log_height as isize - l_skip as isize;\n515\t\n516\t            // Select output bucket based on n\n517\t            let d_g_output = if n >= 0 {\n518\t                &mut d_g_pos\n519\t            } else {\n520\t                &mut d_g_neg[(-n - 1) as usize]\n521\t            };\n522\t\n523\t            // Allocate block_sums buffer for intermediate reduction\n524\t            let block_sums_len = unsafe {\n525\t                _stacked_reduction_r0_required_temp_buffer_size(\n526\t                    trace_height as u32,\n527\t                    trace_width as u32,\n528\t                    l_skip as u32,\n529\t                )\n530\t            } as usize;\n531\t\n532\t            if block_sums_len > self.d_block_sums.len() {\n533\t                self.d_block_sums = DeviceBuffer::<EF>::with_capacity(block_sums_len);\n534\t            }\n535\t\n536\t            unsafe {\n537\t                // 2 per column for (eq, k_rot) - coeff_eq and coeff_rot\n538\t                let lambda_pows_ptr = self.d_lambda_pows.as_ptr().add(2 * window[0]);\n539\t\n540\t                stacked_reduction_sumcheck_round0(\n541\t                    &self.eq_r_ns,\n542\t                    trace_ptr,\n543\t                    lambda_pows_ptr,\n544\t                    &mut self.d_block_sums,\n545\t                    d_g_output,\n546\t                    trace_height,\n547\t                    trace_width,\n548\t                    l_skip,\n549\t                )\n550\t                .map_err(StackedReductionError::SumcheckRound0)?;\n551\t            };\n552\t        }\n553\t\n554\t        // CPU reconstruction: s₀(Z) = E0(Z)*G0(Z) + E1(Z)*G1(Z) + E2(Z)*G2(Z)\n555\t        let s_0 = self.reconstruct_s0_from_g(d_g_pos, d_g_neg, s_0_deg)?;\n556\t        self.mem.tracing_info(\"stacked_reduction_sumcheck round 0\");\n557\t\n558\t        Ok(s_0)\n559\t    }\n560\t\n561\t    /// Reconstructs s_0 from G0, G1, G2 using NTT-based polynomial multiplication.\n562\t    ///\n563\t    /// For n >= 0:\n564\t    /// - E0(Z) = eq_uni(l_skip, Z, r0)\n565\t    /// - E1(Z) = eq_uni(l_skip, Z, r0*ω_skip)\n566\t    /// - E2(Z) = eq_const * eq_uni_at_one(l_skip, Z)\n567\t    ///\n568\t    /// For n < 0: multiply each E by ind(Z) = eval_in_uni(l_skip, n, Z)\n569\t    fn reconstruct_s0_from_g(\n570\t        &self,\n571\t        d_g_pos: DeviceBuffer<EF>,\n572\t        d_g_neg: Vec<DeviceBuffer<EF>>,\n573\t        s_0_deg: usize,\n574\t    ) -> Result<UnivariatePoly<EF>, StackedReductionError> {\n575\t        let l_skip = self.l_skip;\n576\t        let skip_domain = 1 << l_skip;\n577\t        let large_uni_domain = (s_0_deg + 1).next_power_of_two(); // 2 * skip_domain\n578\t        let dft = Radix2BowersSerial;\n579\t\n580\t        // Accumulate s_0 coefficients across all buckets\n581\t        let mut s_0_coeffs = vec![EF::ZERO; large_uni_domain];\n582\t\n583\t        // --- Process n >= 0 bucket ---\n584\t        let g_pos = d_g_pos.to_host()?;\n585\t        if !g_pos.iter().all(|&x| x == EF::ZERO) {\n586\t            // Build E polynomials for n >= 0\n587\t            let e0 = eq_uni_poly::<F, EF>(l_skip, self.r_0);\n588\t            let e1 = eq_uni_poly::<F, EF>(l_skip, self.r_0 * self.omega_skip);\n589\t            let e2 = eq_uni_at_one_poly(l_skip, self.eq_const);\n590\t\n591\t            // NTT-based multiplication: s_0 += E0*G0 + E1*G1 + E2*G2\n592\t            Self::ntt_multiply_and_add(\n593\t                &dft,\n594\t                large_uni_domain,\n595\t                [e0.coeffs(), e1.coeffs(), e2.coeffs()],\n596\t                [\n597\t                    &g_pos[0..skip_domain],\n598\t                    &g_pos[skip_domain..2 * skip_domain],\n599\t                    &g_pos[2 * skip_domain..3 * skip_domain],\n600\t                ],\n601\t                &mut s_0_coeffs,\n602\t            );\n603\t        }\n604\t\n605\t        // --- Process n < 0 buckets ---\n606\t        for (bucket_idx, d_g_neg_bucket) in d_g_neg.into_iter().enumerate() {\n607\t            let n_abs = bucket_idx + 1;\n608\t            let g_neg = d_g_neg_bucket.to_host()?;\n609\t            if g_neg.iter().all(|&x| x == EF::ZERO) {\n610\t                continue;\n611\t            }\n612\t\n613\t            // Adjusted parameters for n < 0\n614\t            let l = l_skip - n_abs;\n615\t            let omega_l = self.omega_skip.exp_power_of_2(n_abs);\n616\t            let r_uni = self.r_0.exp_power_of_2(n_abs);\n617\t\n618\t            // Build E polynomials with indicator factor\n619\t            let ind = build_indicator_poly(l_skip, -(n_abs as isize));\n620\t            let e0_base = eq_uni_poly::<F, EF>(l, r_uni);\n621\t            let e1_base = eq_uni_poly::<F, EF>(l, r_uni * omega_l);\n622\t            let e2_base = eq_uni_at_one_poly(l, self.eq_const);\n623\t\n624\t            // E_neg = E_base * ind (polynomial multiplication)\n625\t            let e0_neg = poly_multiply_ntt(&dft, e0_base.coeffs(), ind.coeffs(), skip_domain);\n626\t            let e1_neg = poly_multiply_ntt(&dft, e1_base.coeffs(), ind.coeffs(), skip_domain);\n627\t            let e2_neg = poly_multiply_ntt(&dft, e2_base.coeffs(), ind.coeffs(), skip_domain);\n628\t\n629\t            Self::ntt_multiply_and_add(\n630\t                &dft,\n631\t                large_uni_domain,\n632\t                [&e0_neg, &e1_neg, &e2_neg],\n633\t                [\n634\t                    &g_neg[0..skip_domain],\n635\t                    &g_neg[skip_domain..2 * skip_domain],\n636\t                    &g_neg[2 * skip_domain..3 * skip_domain],\n637\t                ],\n638\t                &mut s_0_coeffs,\n639\t            );\n640\t        }\n641\t\n642\t        s_0_coeffs.truncate(s_0_deg + 1);\n643\t        Ok(UnivariatePoly::new(s_0_coeffs))\n644\t    }\n645\t\n646\t    /// NTT-based polynomial multiplication following logup pattern.\n647\t    /// Computes: out += sum_i E[i] * G[i]\n648\t    fn ntt_multiply_and_add(\n649\t        dft: &Radix2BowersSerial,\n650\t        domain_size: usize,\n651\t        e_coeffs: [&[EF]; 3],\n652\t        g_evals: [&[EF]; 3], // G evaluations on identity coset\n653\t        out: &mut [EF],\n654\t    ) {\n655\t        // 1. iDFT G evaluations to get G coefficients\n656\t        let g_coeffs: [Vec<EF>; 3] = std::array::from_fn(|i| dft.idft(g_evals[i].to_vec()));\n657\t\n658\t        // 2. Prepare coefficient matrices, resize to domain_size\n659\t        let mut e_padded = vec![EF::ZERO; domain_size * 3];\n660\t        let mut g_padded = vec![EF::ZERO; domain_size * 3];\n661\t        for i in 0..3 {\n662\t            for (j, &c) in e_coeffs[i].iter().enumerate() {\n663\t                e_padded[j * 3 + i] = c;\n664\t            }\n665\t            for (j, &c) in g_coeffs[i].iter().enumerate() {\n666\t                g_padded[j * 3 + i] = c;\n667\t            }\n668\t        }\n669\t\n670\t        // 3. DFT batch to evaluation domain\n671\t        let e_evals_mat = dft.dft_batch(RowMajorMatrix::new(e_padded, 3));\n672\t        let g_evals_mat = dft.dft_batch(RowMajorMatrix::new(g_padded, 3));\n673\t\n674\t        // 4. Pointwise multiply and sum: s[j] = sum_i e[j][i] * g[j][i]\n675\t        let mut s_evals = vec![EF::ZERO; domain_size];\n676\t        for (j, s_j) in s_evals.iter_mut().enumerate() {\n677\t            for i in 0..3 {\n678\t                *s_j += e_evals_mat.values[j * 3 + i] * g_evals_mat.values[j * 3 + i];\n679\t            }\n680\t        }\n681\t\n682\t        // 5. iDFT to get product coefficients\n683\t        let s_coeffs = dft.idft(s_evals);\n684\t\n685\t        // 6. Add to output\n686\t        for (o, c) in out.iter_mut().zip(s_coeffs) {\n687\t            *o += c;\n688\t        }\n689\t    }\n690\t\n691\t    #[instrument(\"stacked_reduction_fold_ple\", level = \"debug\", skip_all)]\n692\t    fn fold_ple_evals(&mut self, u_0: EF) -> Result<(), StackedReductionError> {\n693\t        let l_skip = self.l_skip;\n694\t        let n_stack = self.n_stack;\n695\t        let r_0 = self.r_0;\n696\t        let omega_skip = self.omega_skip;\n697\t        let n_max = self.n_max;\n698\t        self.q_evals.clear();\n699\t\n700\t        // Precompute Lagrange denominators once (shared across all traces)\n701\t        let skip_domain = 1 << l_skip;\n702\t        let inv_lagrange_denoms =\n703\t            compute_barycentric_inv_lagrange_denoms(l_skip, &self.omega_skip_pows, u_0);\n704\t        let d_inv_lagrange_denoms = inv_lagrange_denoms.to_device()?;\n705\t\n706\t        for stacked in &self.stacked_per_commit {\n707\t            let layout = stacked.layout();\n708\t            let num_x = 1 << n_stack;\n709\t            let stacked_width = layout.width();\n710\t            debug_assert_eq!(layout.height(), 1 << (l_skip + n_stack));\n711\t            let folded_evals = DeviceBuffer::<EF>::with_capacity(num_x * stacked_width);\n712\t            // We must fill with zeros because some parts will be left empty due to stacking\n713\t            folded_evals\n714\t                .fill_zero()\n715\t                .map_err(StackedReductionError::FillZero)?;\n716\t            let mut dst_offset = 0;\n717\t            for trace in &stacked.traces {\n718\t                if trace.width() == 0 || trace.height() == 0 {\n719\t                    continue;\n720\t                }\n721\t                let new_height = max(trace.height(), skip_domain) / skip_domain;\n722\t\n723\t                // Launch single-trace kernel for this trace\n724\t                // SAFETY:\n725\t                // - `trace.buffer()` is a valid device pointer for `trace.height() * trace.width()`\n726\t                //   elements\n727\t                // - `folded_evals` at `dst_offset` is valid for `new_height * trace.width()`\n728\t                //   elements since we allocated `num_x * stacked_width` and traces fill\n729\t                //   contiguously\n730\t                // - `d_omega_skip_pows` and `d_inv_lagrange_denoms` have length `>= skip_domain`\n731\t                unsafe {\n732\t                    let dst = folded_evals.as_mut_ptr().add(dst_offset);\n733\t                    stacked_reduction_fold_ple(\n734\t                        trace.buffer().as_ptr(),\n735\t                        dst,\n736\t                        &self.d_omega_skip_pows,\n737\t                        &d_inv_lagrange_denoms,\n738\t                        trace.height(),\n739\t                        trace.width(),\n740\t                        l_skip,\n741\t                    )\n742\t                    .map_err(StackedReductionError::FoldPle)?;\n743\t                }\n744\t\n745\t                dst_offset += new_height * trace.width();\n746\t            }\n747\t            self.q_evals.push(folded_evals);\n748\t        }\n749\t\n750\t        // fold PLEs into MLEs for \\eq and \\kappa_\\rot, using u_0\n751\t        let eq_uni_u0r0 = eval_eq_uni(l_skip, u_0, r_0);\n752\t        let eq_uni_u0r0_rot = eval_eq_uni(l_skip, u_0, r_0 * omega_skip);\n753\t        let eq_uni_u01 = eval_eq_uni_at_one(l_skip, u_0);\n754\t        debug_assert_eq!(self.eq_r_ns.buffer.len(), 2 << n_max);\n755\t        self.k_rot_ns.buffer = DeviceBuffer::with_capacity(2 << n_max);\n756\t        [EF::ZERO].copy_to(&mut self.k_rot_ns.buffer)?;\n757\t        unsafe {\n758\t            // SAFETY:\n759\t            // - We allocated `k_rot_ns` with same capacity as `eq_r_ns` above.\n760\t            initialize_k_rot_from_eq_segments(\n761\t                &self.eq_r_ns,\n762\t                &mut self.k_rot_ns.buffer,\n763\t                eq_uni_u0r0_rot,\n764\t                self.eq_const * eq_uni_u01,\n765\t                n_max as u32,\n766\t            )\n767\t            .map_err(StackedReductionError::InitKRot)?;\n768\t        }\n769\t        vector_scalar_multiply_ext(&mut self.eq_r_ns.buffer, eq_uni_u0r0)\n770\t            .map_err(StackedReductionError::VectorScalarMul)?;\n771\t\n772\t        // Compute the special eq values for n = -l_skip..0\n773\t        // First in order -n = 1..=l_skip, then reverse to order n = -l_skip..0 corresponding to\n774\t        // log_height = 0..l_skip\n775\t        (self.eq_stable, self.k_rot_stable) =\n776\t            zip(r_0.exp_powers_of_2(), omega_skip.exp_powers_of_2())\n777\t                .enumerate()\n778\t                .skip(1)\n779\t                .take(l_skip)\n780\t                .map(|(n_abs, (r, omega_l))| {\n781\t                    let l = l_skip - n_abs;\n782\t                    let eq_uni = eval_eq_uni(l, u_0, r);\n783\t                    let eq_uni_rot = eval_eq_uni(l, u_0, r * omega_l);\n784\t                    let ind = eval_in_uni(l_skip, -(n_abs as isize), u_0);\n785\t                    (ind * eq_uni, ind * eq_uni_rot)\n786\t                })\n787\t                .unzip();\n788\t        self.eq_stable.reverse();\n789\t        self.k_rot_stable.reverse();\n790\t        Ok(())\n791\t    }\n792\t\n793\t    #[instrument(\"stacked_reduction_sumcheck\", level = \"debug\", skip_all, fields(round = round))]"}]},"parent_tool_use_id":"toolu_01Xb4bGvtwS9Mwetygo8hVe2","session_id":"3f2fc226-1649-44e7-a922-02ccd916e4bc","uuid":"db77747b-e4ad-4c77-984e-61ecc47af21f","timestamp":"2026-04-12T20:29:31.774Z"}
