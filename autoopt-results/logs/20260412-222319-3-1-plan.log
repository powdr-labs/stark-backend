{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NGthzysZ5T6hMTqt6hkuXU","type":"tool_result","content":"370\t// ============================================================================\n371\t// LAUNCHERS\n372\t// ============================================================================\n373\t\n374\tinline std::pair<dim3, dim3> stacked_reduction_round0_launch_params(\n375\t    uint32_t trace_height,\n376\t    uint32_t trace_width,\n377\t    uint32_t l_skip\n378\t) {\n379\t    uint32_t skip_domain = 1u << l_skip;\n380\t    auto lifted_height = std::max(trace_height, skip_domain);\n381\t    // Entire skip domain must fit within a block\n382\t    auto max_threads = std::max(skip_domain, 256u);\n383\t    auto [grid, block] = kernel_launch_params(lifted_height, max_threads);\n384\t    // NOTE: lifted_height = skip_domain * num_x will always be divisible by block.x since num_x is a power of 2. Therefore all threads in a block will be active.\n385\t    grid.y = trace_width;\n386\t    return {grid, block};\n387\t}\n388\t\n389\t// (Not a launcher) Utility function to calculate required size of temp buffer.\n390\t// Required length of *block_sums in FpExt elements\n391\t// SP_DEG=1: outputs NUM_G=3 values per z (G0, G1, G2)\n392\textern \"C\" uint32_t _stacked_reduction_r0_required_temp_buffer_size(\n393\t    uint32_t trace_height,\n394\t    uint32_t trace_width,\n395\t    uint32_t l_skip\n396\t) {\n397\t    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n398\t    return ((grid.x * grid.y) << l_skip) * NUM_G;\n399\t}\n400\t\n401\t// SP_DEG=1: No z_packets needed, outputs G0, G1, G2 on identity coset only.\n402\t// Uses ADD_TO_OUTPUT=true to accumulate into output buffer (for bucket-based accumulation).\n403\textern \"C\" int _stacked_reduction_sumcheck_round0(\n404\t    const FpExt *eq_r_ns,\n405\t    const Fp *trace_ptr,\n406\t    const FpExt *lambda_pows,\n407\t    FpExt *block_sums,\n408\t    FpExt *output, // length should be NUM_G * skip_domain, ADD to existing values\n409\t    uint32_t trace_height,\n410\t    uint32_t trace_width,\n411\t    uint32_t l_skip,\n412\t    uint32_t num_x\n413\t) {\n414\t    uint32_t skip_domain = 1u << l_skip;\n415\t    uint32_t stride = std::max(skip_domain / trace_height, 1u);\n416\t    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n417\t\n418\t    // Use block.x + 1 stride for shared_sum to avoid bank conflicts\n419\t    // NUM_G=3 outputs per z (G0, G1, G2)\n420\t    size_t shmem_sum_size = sizeof(FpExt) * (block.x + 1) * NUM_G;\n421\t\n422\t    stacked_reduction_round0_block_sum_kernel<<<grid, block, shmem_sum_size>>>(\n423\t        eq_r_ns, trace_ptr, lambda_pows, block_sums,\n424\t        trace_height, trace_width, l_skip,\n425\t        skip_domain - 1, num_x, 31 - __builtin_clz(stride)\n426\t    );\n427\t\n428\t    int err = CHECK_KERNEL();\n429\t    if (err != 0)\n430\t        return err;\n431\t\n432\t    // Launch final reduction kernel - reads from block_sums, ADDs to output\n433\t    auto num_blocks = grid.x * grid.y;\n434\t    auto output_size = NUM_G * skip_domain;\n435\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n436\t    size_t reduce_shmem = div_ceil(reduce_block.x, WARP_SIZE) * sizeof(FpExt);\n437\t    sumcheck::final_reduce_block_sums<true>\n438\t        <<<output_size, reduce_block, reduce_shmem>>>(block_sums, output, num_blocks);\n439\t\n440\t    return CHECK_KERNEL();\n441\t}\n442\t\n443\t// Parallelizes barycentric interpolation across 2^l_skip threads per output cell\n444\textern \"C\" int _stacked_reduction_fold_ple(\n445\t    const Fp *src,\n446\t    FpExt *dst,\n447\t    const Fp *omega_skip_pows,\n448\t    const FpExt *inv_lagrange_denoms,\n449\t    uint32_t trace_height,\n450\t    uint32_t trace_width,\n451\t    uint32_t l_skip\n452\t) {\n453\t    uint32_t skip_domain = 1u << l_skip;\n454\t    uint32_t new_height = std::max(trace_height, skip_domain) / skip_domain;\n455\t\n456\t    // Block size: at least skip_domain, prefer 256 for occupancy\n457\t    uint32_t block_size = std::max(256u, skip_domain);\n458\t    uint32_t chunks_per_block = block_size / skip_domain;\n459\t\n460\t    // 2D grid: x-dim for rows, y-dim for columns\n461\t    dim3 grid(div_ceil(new_height, chunks_per_block), trace_width);\n462\t    dim3 block(block_size);\n463\t\n464\t    // Shared memory for cross-warp reduction (needed when skip_domain > 32)\n465\t    // Each warp in the block needs one FpExt slot for cross-warp reduction\n466\t    uint32_t total_warps_in_block = block_size / WARP_SIZE;\n467\t    size_t smem_bytes = (skip_domain > WARP_SIZE) ? total_warps_in_block * sizeof(FpExt) : 0;\n468\t\n469\t    stacked_reduction_fold_ple_kernel<<<grid, block, smem_bytes>>>(\n470\t        src, dst, omega_skip_pows, inv_lagrange_denoms, trace_height, new_height, skip_domain\n471\t    );\n472\t\n473\t    return CHECK_KERNEL();\n474\t}\n475\t\n476\textern \"C\" int _initialize_k_rot_from_eq_segments(\n477\t    const FpExt *eq_r_ns,\n478\t    FpExt *k_rot_ns,\n479\t    FpExt k_rot_uni_0,\n480\t    FpExt k_rot_uni_1,\n481\t    uint32_t max_n\n482\t) {\n483\t    auto [grid, block] = kernel_launch_params(1 << max_n);\n484\t    grid.y = max_n + 1;\n485\t\n486\t    initialize_k_rot_from_eq_segments_kernel<<<grid, block>>>(\n487\t        eq_r_ns, k_rot_ns, k_rot_uni_0, k_rot_uni_1\n488\t    );\n489\t\n490\t    return CHECK_KERNEL();\n491\t}\n492\t\n493\textern \"C\" int _stacked_reduction_sumcheck_mle_round(\n494\t    const FpExt *const *q_evals,\n495\t    const FpExt *eq_r_ns,\n496\t    const FpExt *k_rot_ns,\n497\t    const UnstackedSlice *unstacked_cols,\n498\t    const FpExt *lambda_pows,\n499\t    uint64_t *output, // [S_DEG * D_EF] - atomic accumulator, reduced on CPU\n500\t    uint32_t q_height,\n501\t    uint32_t window_len,\n502\t    uint32_t num_y,\n503\t    uint32_t sm_count\n504\t) {\n505\t    // Smaller b