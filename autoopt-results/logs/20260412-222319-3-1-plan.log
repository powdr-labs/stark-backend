 / 2^{n_abs}\n1008\tfn build_indicator_poly(l_skip: usize, n: isize) -> UnivariatePoly<EF> {\n1009\t    let n_abs = (-n) as usize;\n1010\t    let l = l_skip - n_abs;\n1011\t    let scale = EF::ONE.halve().exp_u64(n_abs as u64);\n1012\t    let mut coeffs = vec![EF::ZERO; 1 << l_skip];\n1013\t    for k in 0..(1 << n_abs) {\n1014\t        coeffs[k * (1 << l)] = scale;\n1015\t    }\n1016\t    UnivariatePoly::new(coeffs)\n1017\t}\n1018\t\n1019\t/// eq_uni_at_one polynomial: eq_D(Z, 1) as a polynomial in Z"}]},"parent_tool_use_id":"toolu_01DgSxHP24AnpHRvDz5reP2d","session_id":"3f2fc226-1649-44e7-a922-02ccd916e4bc","uuid":"9ca2d316-ad84-448c-a340-722bf8424d82","timestamp":"2026-04-12T20:40:02.989Z"}
