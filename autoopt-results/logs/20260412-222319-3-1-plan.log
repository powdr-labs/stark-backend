{\n62\t    Fp q = Fp::zero();\n63\t    uint32_t stride = evals_len >= skip_domain ? 1 : skip_domain / evals_len;\n64\t    if (z % expansion_factor == 0) {\n65\t        auto i = z / expansion_factor;\n66\t        if (i % stride == 0)\n67\t            q = evals[i / stride];\n68\t    } else {\n69\t        for (int idx = 0; idx < (skip_domain / stride); idx++) {\n70\t            q += evals[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n71\t        }\n72\t    }\n73\t    return q;\n74\t}\n75\t\n76\t// SP_DEG=1 kernel: compute 3 partial sums G0, G1, G2 on identity coset only.\n77\t// No iNTT/NTT operations - reconstruction happens on CPU via NTT-based polynomial multiplication.\n78\t//\n79\t// Each block covers a tile of z-values (threadIdx.x) and collaborates across threads\n80\t// to sum over x for a single column. Blocks stride over columns via gridDim.y.\n81\t//\n82\t// G0(Z) = Σ_{col,x} coeff_eq[col] * eq_cube(x) * q_{col,x}(Z)\n83\t// G1(Z) = Σ_{col,x} coeff_rot[col] * eq_cube(x) * q_{col,x}(Z)\n84\t// G2(Z) = Σ_{col,x} coeff_rot[col] * (eq_cube(rot_prev(x)) - eq_cube(x)) * q_{col,x}(Z)\n85\t//\n86\t// where coeff_eq[col] = lambda_pows[2*col], coeff_rot[col] = lambda_pows[2*col+1]\n87\t__global__ void stacked_reduction_round0_block_sum_kernel(\n88\t    const FpExt *__restrict__ eq_r_ns, // pointer to EqEvalSegments\n89\t    const Fp *__restrict__ trace_ptr,\n90\t    const FpExt *__restrict__ lambda_pows, // pointer to lambda_pows at window start\n91\t    FpExt *__restrict__ block_sums, // [gridDim.x * gridDim.y][NUM_G * skip_domain]\n92\t    uint32_t height,                // trace height\n93\t    uint32_t width,                 // trace width\n94\t    uint32_t l_skip,\n95\t    uint32_t skip_mask, // 2^l_skip - 1\n96\t    uint32_t num_x,     // 1 << n_lift\n97\t    uint32_t log_stride\n98\t) {\n99\t    extern __shared__ char smem[];\n100\t    // Use blockDim.x + 1 stride to avoid shared memory bank conflicts"}]},"parent_tool_use_id":null,"