        } else {\n711\t                return launch_logup_coset_parallel<true, false>(\n712\t                    tmp_sums_buffer,\n713\t                    output,\n714\t                    selectors_cube,\n715\t                    preprocessed,\n716\t                    main_parts,\n717\t                    eq_cube,\n718\t                    public_values,\n719\t                    numer_weights,\n720\t                    denom_weights,\n721\t                    denom_sum_init,\n722\t                    d_rules,\n723\t                    rules_len,\n724\t                    buffer_size,\n725\t                    d_intermediates,\n726\t                    skip_domain,\n727\t                    num_x,\n728\t                    height,\n729\t                    num_cosets,\n730\t                    g_shift,\n731\t                    max_temp_bytes\n732\t                );\n733\t            }\n734\t        } else {\n735\t            if (needs_shmem) {\n736\t                return launch_logup_coset_parallel<false, true>(\n737\t                    tmp_sums_buffer,\n738\t                    output,\n739\t                    selectors_cube,\n740\t                    preprocessed,\n741\t                    main_parts,\n742\t                    eq_cube,\n743\t                    public_values,\n744\t                    numer_weights,\n745\t                    denom_weights,\n746\t                    denom_sum_init,\n747\t                    d_rules,\n748\t                    rules_len,\n749\t                    buffer_size,\n750\t                    d_intermediates,\n751\t                    skip_domain,\n752\t                    num_x,\n753\t                    height,\n754\t                    num_cosets,\n755\t                    g_shift,\n756\t                    max_temp_bytes\n757\t                );\n758\t            } else {\n759\t                return launch_logup_coset_parallel<false, false>(\n760\t                    tmp_sums_buffer,\n761\t                    o