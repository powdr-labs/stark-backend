round0_block_sum_kernel<<<grid, block, shmem_sum_size>>>(\n503\t        eq_r_ns, trace_ptr, lambda_pows, block_sums,\n504\t        trace_height, trace_width, l_skip,\n505\t        skip_domain - 1, num_x, 31 - __builtin_clz(stride)\n506\t    );\n507\t\n508\t    int err = CHECK_KERNEL();\n509\t    if (err != 0)\n510\t        return err;\n511\t\n512\t    // Launch final reduction kernel - reads from block_sums, ADDs to output\n513\t    auto num_blocks = grid.x * grid.y;\n514\t    auto output_size = NUM_G * skip_domain;\n515\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n516\t    size_t reduce_shmem = div_ceil(reduce_block.x, WARP_SIZE) * sizeof(FpExt);\n517\t    sumcheck::final_reduce_block_sums<true>\n518\t        <<<output_size, reduce_block, reduce_shmem>>>(block_sums, output, num_blocks);\n519\t\n520\t    return CHECK_KERNEL();\n521\t}\n522\t\n523\t// Parallelizes barycentric interpolation across 2^l_skip threads per output cell\n524\textern \"C\" int _stacked_reduction_fold_ple(\n525\t    const Fp *src,\n526\t    FpExt *dst,\n527\t    const Fp *omega_skip_pows,\n528\t    const FpExt *inv_lagrange_denoms,\n529\t    uint32_t trace_height,\n530\t    uint32_t trace_width,\n531\t    uint32_t l_skip\n532\t) {\n533\t    uint32_t skip_domain = 1u << l_skip;\n534\t    uint32_t new_height = std::max(trace_height, skip_domain) / skip_domain;\n535\t\n536\t    // Block size: at least skip_domain, prefer 256 for occupancy\n537\t    uint32_t block_size = std::max(256u, skip_domain);\n538\t    uint32_t chunks_per_block = block_size / skip_domain;\n539\t\n540\t    // 2D grid: x-dim for rows, y-dim for columns\n541\t    dim3 grid(div_ceil(new_height, chunks_per_block), trace_width);\n542\t    dim3 block(block_size);\n543\t\n544\t    // Shared memory for cross-warp reduction (needed when skip_domain > 32)\n545\t    // Each warp in the block needs one FpExt slot for cross-warp reduction\n546\t    uint32_t total_warps_in_block = block_size / WARP_SIZE;\n547\t    size_t smem_bytes = (skip_domain > WARP_SIZE) ? total_warps_in_block * sizeof(FpExt) : 0;\n548\t\n549\t    stacked_reduction_fold_ple_kernel<<<grid, block, smem_bytes>>>(\n550\t        src, dst, omega_skip_pows, inv_lagrange_denoms, trace_height, new_height, skip_domain\n551\t    );\n552\t\n553\t    return CHECK_KERNEL();\n554\t}\n555\t\n556\textern \"C\" int _initialize_k_rot_from_eq_segments(\n557\t    const FpExt *eq_r_ns,\n558\t    FpExt *k_rot_ns,\n559\t    FpExt k_rot_uni_0,\n560\t    FpExt k_rot_uni_1,\n561\t    uint32_t max_n\n562\t) {\n563\t    auto [grid, block] = kernel_launch_params(1 << max_n);\n564\t    grid.y = max_n + 1;\n565\t\n566\t    initialize_k_rot_from_eq_segments_kernel<<<grid, block>>>(\n567\t        eq_r_ns, k_rot_ns, k_rot_uni_0, k_rot_uni_1\n568\t    );\n569\t\n570\t    return CHECK_KERNEL();\n571\t}\n572\t\n573\textern \"C\" int _stacked_reduction_sumcheck_mle_round(\n574\t    const FpExt *const *q_evals,\n575\t    const FpExt *eq_r_ns,\n576\t    const FpExt *k_rot_ns,\n577\t    const UnstackedSlice *unstacked_cols,\n578\t    const FpExt *lambda_pows,\n579\t    uint64_t *output, // [S_DEG * D_EF] - atomic accumulator, reduced on CPU\n580\t    uint32_t q_height,\n581\t    uint32_t window_len,\n582\t    uint32_t num_y,\n583\t    uint32_t sm_count\n584\t) {\n585\t    // Smaller block size for more eligible warps to hide latency\n586\t    auto [grid, block] = kernel_launch_params(num_y, 256);\n587\t    assert(sm_count);\n588\t\n589\t    // Heuristic auto-tuning for window-stride (grid.y):\n590\t    // - Increase work per thread (reduce atomics) by targeting multiple window iterations/thread\n591\t    // - Ensure enough total blocks to keep SMs busy when num_y is small\n592\t    constexpr uint32_t WAVES_TARGET = 4; // blocks/SM target\n593\t    constexpr uint32_t ITERS_MIN = 4;    // prefer >= this many window iterations/thread\n594\t    constexpr uint32_t ITERS_MAX = 16;   // prefer <= this many window iterations/thread\n595\t\n596\t    uint32_t stride_occ = div_ceil(sm_count * WAVES_TARGET, grid.x);\n597\t    uint32_t stride_loop_lo = div_ceil(window_len, ITERS_MAX);\n598\t    uint32_t stride_loop_hi = div_ceil(window_len, ITERS_MIN);\n599\t\n600\t    uint32_t lo = std::max(1u, std::max(stride_occ, stride_loop_lo));\n601\t    uint32_t hi = std::min(std::min(window_len, MAX_GRID_DIM), stride_loop_hi);\n602\t\n603\t    uint32_t tuned_stride = (lo <= hi) ? lo : std::min(lo, std::min(window_len, MAX_GRID_DIM));\n604\t    grid.y = tuned_stride;\n605\t\n606\t    // Ensure that atomic add does not overflow u64\n607\t    assert((size_t)num_y * grid.y < (size_t)1u << 32);\n608\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n609\t\n610\t    stacked_reduction_sumcheck_mle_round_kernel<<<grid, block, shmem_bytes>>>(\n611\t        q_evals, eq_r_ns, k_rot_ns, unstacked_cols, lambda_pows, output, q_height, window_len, num_y\n612\t    );\n613\t\n614\t    return CHECK_KERNEL();\n615\t}\n616\t\n617\textern \"C\" int _stacked_reduction_sumcheck_mle_round_degenerate(\n618\t    const FpExt *const *q_evals,\n619\t    const FpExt *eq_ub_ptr,\n620\t    FpExt eq_r,\n621\t    FpExt k_rot_r,\n622\t    const UnstackedSlice *unstacked_cols,\n623\t    const FpExt *lambda_pows,\n624\t    uint64_t *output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n625\t    uint32_t q_height,\n626\t    uint32_t window_len,\n627\t    uint32_t l_skip,\n628\t    uint32_t round\n629\t) {\n630\t    auto shift_factor = l_skip + round;\n631\t    dim3 block(std::min(window_len, 256u));\n632\t    dim3 grid(1);\n633\t    // block.x <= 512 < 2^32 so atomic u64 will not overflow\n634\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n635\t\n636\t    stacked_reduction_sumcheck_mle_round_degenerate_kernel<<<grid, block, shmem_bytes>>>(\n637\t        q_evals,\n638\t        eq_ub_ptr,\n639\t        eq_r,\n640\t        k_rot_r,\n641\t        unstacked_cols,\n642\t        lambda_pows,\n643\t        output