{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MP8HDKjLQXt8KnS348ehhm","type":"tool_result","content":"1\t#include \"device_ntt.cuh\"\n2\t#include \"fp.h\"\n3\t#include \"fpext.h\"\n4\t#include \"frac_ext.cuh\"\n5\t#include \"launcher.cuh\"\n6\t#include \"sumcheck.cuh\"\n7\t#include \"utils.cuh\"\n8\t#include <algorithm>\n9\t#include <cassert>\n10\t#include <cmath>\n11\t#include <cstddef>\n12\t#include <cstdint>\n13\t#include <cuda_runtime.h>\n14\t#include <utility>\n15\t#include <vector_types.h>\n16\t\n17\tusing namespace device_ntt;\n18\t\n19\tnamespace {\n20\t\n21\tconstexpr uint32_t MAX_GRID_DIM = 65535u;\n22\t// S_DEG=2 for MLE sumcheck rounds (kept for backward compatibility)\n23\tconstexpr int S_DEG = 2;\n24\t// Number of G outputs per z in round 0 (SP_DEG=1): G0, G1, G2\n25\tconstexpr int NUM_G = 3;\n26\t\n27\t} // namespace\n28\t\n29\tstruct UnstackedSlice {\n30\t    uint32_t commit_idx;\n31\t    uint32_t log_height;\n32\t    uint32_t stacked_row_idx;\n33\t    uint32_t stacked_col_idx;\n34\t};\n35\t\n36\tstruct DegenerateWindowMeta {\n37\t    uint32_t col_offset;\n38\t    uint32_t eq_ub_offset;\n39\t    uint32_t window_len;\n40\t    uint32_t _pad;\n41\t    FpExt eq_r;\n42\t    FpExt k_rot_r;\n43\t};\n44\t\n45\tstruct UnstackedPleFoldPacket {\n46\t    const Fp *__restrict__ src;\n47\t    FpExt *__restrict__ dst;\n48\t    uint32_t height;\n49\t    uint32_t width;\n50\t};\n51\t\n52\t__device__ __forceinline__ FpExt get_eq_cube(const FpExt *eq_r_ns, uint32_t cube_size, uint32_t x) {\n53\t    return eq_r_ns[cube_size + x];\n54\t}\n55\t\n56\t__device__ __forceinline__ uint32_t rot_prev(uint32_t x_int, uint32_t cube_size) {\n57\t    return x_int == 0 ? cube_size - 1 : x_int - 1;\n58\t}\n59\t\n60\t__device__ __forceinline__ Fp eq1(Fp x, Fp y) { return Fp::one() - x - y + Fp(2) * x * y; }\n61\t\n62\t__device__ __forceinline__ Fp barycentric_interpolate_strided(\n63\t    const Fp *evals,\n64\t    uint32_t evals_len,\n65\t    uint32_t z,\n66\t    uint32_t expansion_factor,     // large_domain / skip_domain\n67\t    const Fp *inv_lagrange_denoms, // denoms specifically for z\n68\t    const Fp *omega_skip_pows,\n69\t    uint32_t skip_domain\n70\t) {\n71\t    Fp q = Fp::zero();\n72\t    uint32_t stride = evals_len >= skip_domain ? 1 : skip_domain / evals_len;\n73\t    if (z % expansion_factor == 0) {\n74\t        auto i = z / expansion_factor;\n75\t        if (i % stride == 0)\n76\t            q = evals[i / stride];\n77\t    } else {\n78\t        for (int idx = 0; idx < (skip_domain / stride); idx++) {\n79\t            q += evals[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n80\t        }\n81\t    }\n82\t    return q;\n83\t}\n84\t\n85\t// SP_DEG=1 kernel: compute 3 partial sums G0, G1, G2 on identity coset only.\n86\t// No iNTT/NTT operations - reconstruction happens on CPU via NTT-based polynomial multiplication.\n87\t//\n88\t// Each block covers a tile of z-values (threadIdx.x) and collaborates across threads\n89\t// to sum over x for a single column. Blocks stride over columns via gridDim.y.\n90\t//\n91\t// G0(Z) = Σ_{col,x} coeff_eq[col] * eq_cube(x) * q_{col,x}(Z)\n92\t// G1(Z) = Σ_{col,x} coeff_rot[col] * eq_cube(x) * q_{col,x}(Z)\n93\t// G2(Z) = Σ_{col,x} coeff_rot[col] * (eq_cube(rot_prev(x)) - eq_cube(x)) * q_{col,x}(Z)\n94\t//\n95\t// where coeff_eq[col] = lambda_pows[2*col], coeff_rot[col] = lambda_pows[2*col+1]\n96\t__global__ void stacked_reduction_round0_block_sum_kernel(\n97\t    const FpExt *__restrict__ eq_r_ns, // pointer to EqEvalSegments\n98\t    const Fp *__restrict__ trace_ptr,\n99\t    const FpExt *__restrict__ lambda_pows, // pointer to lambda_pows at window start\n100\t    FpExt *__restrict__ block_sums, // [gridDim.x * gridDim.y][NUM_G * skip_domain]\n101\t    uint32_t height,                // trace height\n102\t    uint32_t width,                 // trace width\n103\t    uint32_t l_skip,\n104\t    uint32_t skip_mask, // 2^l_skip - 1\n105\t    uint32_t num_x,     // 1 << n_lift\n106\t    uint32_t log_stride\n107\t) {\n108\t    extern __shared__ char smem[];\n109\t    // Use blockDim.x + 1 stride to avoid shared memory bank conflicts\n110\t    const uint32_t PADDED_X = blockDim.x + 1;\n111\t    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem); // FpExt[NUM_G][PADDED_X]\n112\t\n113\t    uint32_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n114\t    uint32_t z_idx = tidx & skip_mask;\n115\t    uint32_t x_int = tidx >> l_skip;\n116\t    uint32_t col_idx = blockIdx.y;\n117\t\n118\t    // Compute G weights (no z-dependent packets needed)\n119\t    FpExt eq_cube = get_eq_cube(eq_r_ns, num_x, x_int);\n120\t    FpExt eq_cube_rot_prev = get_eq_cube(eq_r_ns, num_x, rot_prev(x_int, num_x));\n121\t    FpExt k_rot_diff = eq_cube_rot_prev - eq_cube;\n122\t\n123\t    FpExt coeff_eq = lambda_pows[2 * col_idx];      // for G0\n124\t    FpExt coeff_rot = lambda_pows[2 * col_idx + 1]; // for G1, G2\n125\t\n126\t    FpExt w0 = coeff_eq * eq_cube;      // weight for G0\n127\t    FpExt w1 = coeff_rot * eq_cube;     // weight for G1\n128\t    FpExt w2 = coeff_rot * k_rot_diff;  // weight for G2\n129\t\n130\t    // Load trace value (identity coset only, no NTT needed)\n131\t    auto evals = trace_ptr + col_idx * height + (x_int << (l_skip - log_stride));\n132\t    auto stride_mask = (1u << log_stride) - 1;\n133\t    Fp q = (z_idx & stride_mask) == 0 ? evals[z_idx >> log_stride] : Fp::zero();\n134\t\n135\t    // Store 3 partial sums to shared memory\n136\t    shared_sum[0 * PADDED_X + threadIdx.x] = w0 * q;\n137\t    shared_sum[1 * PADDED_X + threadIdx.x] = w1 * q;\n138\t    shared_sum[2 * PADDED_X + threadIdx.x] = w2 * q;\n139\t\n140\t    __syncthreads();\n141\t\n142\t    // Reduction: only threads in first x-slice participate\n143\t    if ((threadIdx.x >> l_skip) == 0) {\n144\t        FpExt g0 = shared_sum[0 * PADDED_X + z_idx];\n145\t        FpExt g1 = shared_sum[1 * PADDED_X + z_idx];\n146\t        FpExt g2 = shared_sum[2 * PADDED_X + z_idx];\n147\t\n148\t        for (int lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n149\t            g0 += shared_sum[0 * PADDED_X + (lane << l_skip) + z_idx];\n150\t            g1 += shared_sum[1 * PADDED_X + (lane << l_skip) + z_idx];\n151\t            g2 += shared_sum[2 * PADDED_X + (lane << l_skip) + z_idx];\n152\t        }\n153\t\n154\t        // Output: 3 values per z_idx, stored contiguously\n155\t        uint32_t skip_domain = 1u << l_skip;\n156\t        FpExt *out_ptr =\n157\t            block_sums + (col_idx * gridDim.x + blockIdx.x) * (NUM_G * skip_domain);\n158\t        out_ptr[0 * skip_domain + z_idx] = g0;\n159\t        out_ptr[1 * skip_domain + z_idx] = g1;\n160\t        out_ptr[2 * skip_domain + z_idx] = g2;\n161\t    }\n162\t}\n163\t\n164\t// Single-trace kernel: each chunk of skip_domain threads handles one output cell\n165\t// Parallelizes barycentric interpolation across threads for better performance\n166\t// Grid: (num_row_blocks, trace_width) where blockIdx.y selects the column\n167\t__global__ void stacked_reduction_fold_ple_kernel(\n168\t    const Fp *__restrict__ src,\n169\t    FpExt *__restrict__ dst,\n170\t    const Fp *__restrict__ omega_skip_pows,\n171\t    const FpExt *__restrict__ inv_lagrange_denoms,\n172\t    uint32_t trace_height,\n173\t    uint32_t new_height,\n174\t    uint32_t skip_domain\n175\t) {\n176\t    extern __shared__ char smem_raw[];\n177\t    FpExt *smem = reinterpret_cast<FpExt *>(smem_raw);\n178\t\n179\t    uint32_t col_idx = blockIdx.y;\n180\t    uint32_t chunks_per_block = blockDim.x / skip_domain;\n181\t    uint32_t chunk_in_block = threadIdx.x / skip_domain;\n182\t    uint32_t tid_in_chunk = threadIdx.x % skip_domain;\n183\t    uint32_t row_idx = blockIdx.x * chunks_per_block + chunk_in_block;\n184\t\n185\t    // Cannot early-return: all threads must participate in chunk_reduce_sum (uses __syncthreads)\n186\t    bool const active_chunk = (row_idx < new_height);\n187\t\n188\t    // Barycentric interpolation: each thread handles exactly ONE term\n189\t    // (since src_len <= skip_domain, each thread contributes at most one term)\n190\t    FpExt local_val(Fp::zero());\n191\t    if (active_chunk) {\n192\t        uint32_t src_len = std::min(trace_height, skip_domain);\n193\t        uint32_t stride = skip_domain / src_len;\n194\t        const Fp *cell_src = src + col_idx * trace_height + row_idx * src_len;\n195\t\n196\t        if (tid_in_chunk < src_len) {\n197\t            uint32_t idx = tid_in_chunk;\n198\t            local_val =\n199\t                cell_src[idx] * omega_skip_pows[idx * stride] * inv_lagrange_denoms[idx * stride];\n200\t        }\n201\t    }\n202\t\n203\t    // Reduce within chunk using the helper from sumcheck.cuh\n204\t    // All threads must participate; inactive chunks contribute zero\n205\t    FpExt result =\n206\t        sumcheck::chunk_reduce_sum(local_val, smem, tid_in_chunk, skip_domain, chunk_in_block);\n207\t\n208\t    // No __syncthreads() needed: each chunk writes to a distinct dst location\n209\t    // and kernel exits immediately after this write\n210\t    if (active_chunk && tid_in_chunk == 0) {\n211\t        dst[col_idx * new_height + row_idx] = result;\n212\t    }\n213\t}\n214\t\n215\t// Triangular sweep\n216\t__global__ void initialize_k_rot_from_eq_segments_kernel(\n217\t    const FpExt *eq_r_ns,\n218\t    FpExt *k_rot_ns,\n219\t    FpExt k_rot_uni_0,\n220\t    FpExt k_rot_uni_1\n221\t) {\n222\t    uint32_t x = blockIdx.x * blockDim.x + threadIdx.x;\n223\t    uint32_t n = blockIdx.y;\n224\t    uint32_t num_x = 1 << n;\n225\t\n226\t    if (x >= num_x)\n227\t        return;\n228\t\n229\t    auto eq_cube = get_eq_cube(eq_r_ns, num_x, x);\n230\t    auto k_rot_cube = get_eq_cube(eq_r_ns, num_x, rot_prev(x, num_x));\n231\t\n232\t    k_rot_ns[num_x + x] = k_rot_uni_0 * eq_cube + k_rot_uni_1 * (k_rot_cube - eq_cube);\n233\t}\n234\t\n235\t// Assumes we are not in degenerate case, in particular n = n_lift > 0\n236\t// Uses warp-aggregated atomics for reduction - no shared memory or __syncthreads() needed.\n237\t__global__ void stacked_reduction_sumcheck_mle_round_kernel(\n238\t    const FpExt *__restrict__ const\n239\t        *__restrict__ q_evals,          // pointers to matrices of same height, one per [commit_idx]\n240\t    const FpExt *__restrict__ eq_r_ns,  // pointer to EqEvalSegments\n241\t    const FpExt *__restrict__ k_rot_ns, // pointer to `k_rot` segments\n242\t    const UnstackedSlice *__restrict__ unstacked_cols, // pointer to unstacked_cols at window start\n243\t    const FpExt *__restrict__ lambda_pows,             // pointer to lambda_pows at window start\n244\t    uint64_t *__restrict__ output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n245\t    uint32_t q_height,             // height of each matrix in q_evals\n246\t    uint32_t window_len,\n247\t    uint32_t num_y\n248\t) {\n249\t    extern __shared__ char smem[];\n250\t    FpExt *shared = (FpExt *)smem;\n251\t    // Map phase: compute local sum by striding over window\n252\t    FpExt local_sums[S_DEG];\n253\t// Initialize accumulators\n254\t#pragma unroll\n255\t    for (int i = 0; i < S_DEG; i++) {\n256\t        local_sums[i] = FpExt(0);\n257\t    }\n258\t\n259\t    uint32_t window_idx_base = blockIdx.y;\n260\t    uint32_t y_int = blockIdx.x * blockDim.x + threadIdx.x;\n261\t    bool const active_thread = (y_int < num_y);\n262\t\n263\t    if (active_thread) {\n264\t        uint32_t num_evals = num_y * 2;\n265\t\n266\t        auto eq_0 = get_eq_cube(eq_r_ns, num_evals, y_int << 1);\n267\t        auto eq_1 = get_eq_cube(eq_r_ns, num_evals, (y_int << 1) | 1);\n268\t        auto eq_c1 = eq_1 - eq_0;\n269\t        auto k_rot_0 = get_eq_cube(k_rot_ns, num_evals, y_int << 1);\n270\t        auto k_rot_1 = get_eq_cube(k_rot_ns, num_evals, (y_int << 1) | 1);\n271\t        auto k_rot_c1 = k_rot_1 - k_rot_0;\n272\t\n273\t        // We sum over window at a stride, where stride = gridDim.y is tuned based on compute / memory\n274\t        // Currently assumes blockDim.y = 1\n275\t        for (uint32_t window_idx = window_idx_base; window_idx < window_len;\n276\t             window_idx += gridDim.y) {\n277\t            UnstackedSlice s = unstacked_cols[window_idx];\n278\t            const FpExt *__restrict__ q = q_evals[s.commit_idx];\n279\t\n280\t            auto log_height = s.log_height;\n281\t            auto col_idx = s.stacked_col_idx;\n282\t            auto row_start = (s.stacked_row_idx >> log_height) * num_evals;\n283\t            auto q_offset = col_idx * q_height + row_start;\n284\t\n285\t            auto q_0 = q[q_offset + (y_int << 1)];\n286\t            auto q_1 = q[q_offset + (y_int << 1) + 1];\n287\t            auto q_c1 = q_1 - q_0;\n288\t\n289\t#pragma unroll\n290\t            for (int x_int = 1; x_int <= S_DEG; ++x_int) {\n291\t                Fp x = Fp(x_int);\n292\t                auto q_x = q_0 + q_c1 * x;\n293\t                auto eq = eq_0 + eq_c1 * x;\n294\t                auto k_rot = k_rot_0 + k_rot_c1 * x;\n295\t\n296\t                local_sums[x_int - 1] +=\n297\t                    (lambda_pows[2 * window_idx] * eq + lambda_pows[2 * window_idx + 1] * k_rot) *\n298\t                    q_x;\n299\t            }\n300\t        }\n301\t    }\n302\t\n303\t#pragma unroll\n304\t    for (int idx = 0; idx < S_DEG; idx++) {\n305\t        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n306\t        if (threadIdx.x == 0) {\n307\t            sumcheck::atomic_add_fpext_to_u64(output + idx * 4, reduced);\n308\t        }\n309\t        __syncthreads();\n310\t    }\n311\t}\n312\t\n313\t// Degenerate case\n314\t// Uses warp-aggregated atomics for reduction - no shared memory or __syncthreads() needed.\n315\t__global__ void stacked_reduction_sumcheck_mle_round_degenerate_kernel(\n316\t    const FpExt *__restrict__ const\n317\t        *__restrict__ q_evals, // pointers to matrices of same height, one per [commit_idx]\n318\t    const FpExt *__restrict__ eq_ub_ptr, // pointer to `eq_ub_per_trace` at window start\n319\t    FpExt eq_r,                          // pointer to EqEvalSegments\n320\t    FpExt k_rot_r,                       // pointer to `k_rot` segments\n321\t    const UnstackedSlice *__restrict__ unstacked_cols, // pointer to unstacked_cols at window start\n322\t    const FpExt *__restrict__ lambda_pows,             // pointer to lambda_pows at window start\n323\t    uint64_t *__restrict__ output, // [S_DEG * 4] - atomic accumulator, reduced on CPU\n324\t    uint32_t q_height,             // height of each matrix in q_evals\n325\t    uint32_t window_len,\n326\t    uint32_t shift_factor // = l_skip + round\n327\t) {\n328\t    extern __shared__ char smem[];\n329\t    FpExt *shared = (FpExt *)smem;\n330\t\n331\t    FpExt local_sums[S_DEG];\n332\t#pragma unroll\n333\t    for (int i = 0; i < S_DEG; i++) {\n334\t        local_sums[i] = FpExt(0);\n335\t    }\n336\t\n337\t    for (uint32_t window_idx = threadIdx.x; window_idx < window_len; window_idx += blockDim.x) {\n338\t        UnstackedSlice s = unstacked_cols[window_idx];\n339\t        const FpExt *__restrict__ q = q_evals[s.commit_idx];\n340\t\n341\t        auto col_idx = s.stacked_col_idx;\n342\t        auto row_idx = s.stacked_row_idx;\n343\t        auto row_start = (row_idx >> shift_factor) << 1;\n344\t        auto q_offset = col_idx * q_height + row_start;\n345\t\n346\t        auto q_0 = q[q_offset];\n347\t        auto q_1 = q[q_offset + 1];\n348\t        auto q_c1 = q_1 - q_0;\n349\t\n350\t        uint32_t b_bool = (row_idx >> (shift_factor - 1)) & 1;\n351\t        Fp b = Fp(b_bool);\n352\t\n353\t        auto eq_ub = eq_ub_ptr[window_idx];\n354\t\n355\t#pragma unroll\n356\t        for (int x_int = 1; x_int <= S_DEG; ++x_int) {\n357\t            Fp x = Fp(x_int);\n358\t            auto eq_ub_x = eq_ub * eq1(x, b);\n359\t            auto eq = eq_r * eq_ub_x;\n360\t            auto k_rot = k_rot_r * eq_ub_x;\n361\t\n362\t            auto q_x = q_0 + q_c1 * x;\n363\t\n364\t            local_sums[x_int - 1] +=\n365\t                (lambda_pows[2 * window_idx] * eq + lambda_pows[2 * window_idx + 1] * k_rot) * q_x;\n366\t        }\n367\t    }\n368\t\n369\t#pragma unroll\n370\t    for (int idx = 0; idx < S_DEG; idx++) {\n371\t        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n372\t        if (threadIdx.x == 0) {\n373\t            sumcheck::atomic_add_fpext_to_u64(output + idx * 4, reduced);\n374\t        }\n375\t        __syncthreads();\n376\t    }\n377\t}\n378\t\n379\t// Batched degenerate case: one block per window, all atomically accumulate into shared output.\n380\t__global__ void stacked_reduction_sumcheck_mle_round_degenerate_batched_kernel(\n381\t    const FpExt *__restrict__ const *__restrict__ q_evals,\n382\t    const FpExt *__restrict__ eq_ub_all,\n383\t    const UnstackedSlice *__restrict__ unstacked_cols_global,\n384\t    const FpExt *__restrict__ lambda_pows_global,\n385\t    const DegenerateWindowMeta *__restrict__ metas,\n386\t    uint64_t *__restrict__ output,\n387\t    uint32_t q_height,\n388\t    uint32_t shift_factor\n389\t) {\n390\t    extern __shared__ char smem[];\n391\t    FpExt *shared = (FpExt *)smem;\n392\t\n393\t    // Each block handles one degenerate window\n394\t    DegenerateWindowMeta meta = metas[blockIdx.x];\n395\t    FpExt eq_r = meta.eq_r;\n396\t    FpExt k_rot_r = meta.k_rot_r;\n397\t    const UnstackedSlice *unstacked_cols = unstacked_cols_global + meta.col_offset;\n398\t    const FpExt *lambda_pows = lambda_pows_global + 2 * meta.col_offset;\n399\t    const FpExt *eq_ub_ptr = eq_ub_all + meta.eq_ub_offset;\n400\t    uint32_t window_len = meta.window_len;\n401\t\n402\t    FpExt local_sums[S_DEG];\n403\t#pragma unroll\n404\t    for (int i = 0; i < S_DEG; i++) {\n405\t        local_sums[i] = FpExt(0);\n406\t    }\n407\t\n408\t    for (uint32_t window_idx = threadIdx.x; window_idx < window_len; window_idx += blockDim.x) {\n409\t        UnstackedSlice s = unstacked_c