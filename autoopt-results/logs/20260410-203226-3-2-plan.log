{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KehBgzTVZhbZteEHeNTuzP","type":"tool_result","content":"376\t    }\n377\t}\n378\t\n379\t// Batched degenerate case: one block per window, all atomically accumulate into shared output.\n380\t__global__ void stacked_reduction_sumcheck_mle_round_degenerate_batched_kernel(\n381\t    const FpExt *__restrict__ const *__restrict__ q_evals,\n382\t    const FpExt *__restrict__ eq_ub_all,\n383\t    const UnstackedSlice *__restrict__ unstacked_cols_global,\n384\t    const FpExt *__restrict__ lambda_pows_global,\n385\t    const DegenerateWindowMeta *__restrict__ metas,\n386\t    uint64_t *__restrict__ output,\n387\t    uint32_t q_height,\n388\t    uint32_t shift_factor\n389\t) {\n390\t    extern __shared__ char smem[];\n391\t    FpExt *shared = (FpExt *)smem;\n392\t\n393\t    // Each block handles one degenerate window\n394\t    DegenerateWindowMeta meta = metas[blockIdx.x];\n395\t    FpExt eq_r = meta.eq_r;\n396\t    FpExt k_rot_r = meta.k_rot_r;\n397\t    const UnstackedSlice *unstacked_cols = unstacked_cols_global + meta.col_offset;\n398\t    const FpExt *lambda_pows = lambda_pows_global + 2 * meta.col_offset;\n399\t    const FpExt *eq_ub_ptr = eq_ub_all + meta.eq_ub_offset;\n400\t    uint32_t window_len = meta.window_len;\n401\t\n402\t    FpExt local_sums[S_DEG];\n403\t#pragma unroll\n404\t    for (int i = 0; i < S_DEG; i++) {\n405\t        local_sums[i] = FpExt(0);\n406\t    }\n407\t\n408\t    for (uint32_t window_idx = threadIdx.x; window_idx < window_len; window_idx += blockDim.x) {\n409\t        UnstackedSlice s = unstacked_cols[window_idx];\n410\t        const FpExt *__restrict__ q = q_evals[s.commit_idx];\n411\t\n412\t        auto col_idx = s.stacked_col_idx;\n413\t        auto row_idx = s.stacked_row_idx;\n414\t        auto row_start = (row_idx >> shift_factor) << 1;\n415\t        auto q_offset = col_idx * q_height + row_start;\n416\t\n417\t        auto q_0 = q[q_offset];\n418\t        auto q_1 = q[q_offset + 1];\n419\t        auto q_c1 = q_1 - q_0;\n420\t\n421\t        uint32_t b_bool = (row_idx >> (shift_factor - 1)) & 1;\n422\t        Fp b = Fp(b_bool);\n423\t\n424\t        auto eq_ub = eq_ub_ptr[window_idx];\n425\t\n426\t#pragma unroll\n427\t        for (int x_int = 1; x_int <= S_DEG; ++x_int) {\n428\t            Fp x = Fp(x_int);\n429\t            auto eq_ub_x = eq_ub * eq1(x, b);\n430\t            auto eq = eq_r * eq_ub_x;\n431\t            auto k_rot = k_rot_r * eq_ub_x;\n432\t\n433\t            auto q_x = q_0 + q_c1 * x;\n434\t\n435\t            local_sums[x_int - 1] +=\n436\t                (lambda_pows[2 * window_idx] * eq + lambda_pows[2 * window_idx + 1] * k_rot) * q_x;\n437\t        }\n438\t    }\n439\t\n440\t#pragma unroll\n441\t    for (int idx = 0; idx < S_DEG; idx++) {\n442\t        FpExt reduced = sumcheck::block_reduce_sum(local_sums[idx], shared);\n443\t        if (threadIdx.x == 0) {\n444\t            sumcheck::atomic_add_fpext_to_u64(output + idx * 4, reduced);\n445\t        }\n446\t        __syncthreads();\n447\t    }\n448\t}\n449\t\n450\t// ============================================================================\n451\t// LAUNCHERS\n452\t// ============================================================================\n453\t\n454\tinline std::pair<dim3, dim3> stacked_reduction_round0_launch_params(\n455\t    uint32_t trace_height,\n456\t    uint32_t trace_width,\n457\t    uint32_t l_skip\n458\t) {\n459\t    uint32_t skip_domain = 1u << l_skip;\n460\t    auto lifted_height = std::max(trace_height, skip_domain);\n461\t    // Entire skip domain must fit within a block\n462\t    auto max_threads = std::max(skip_domain, 256u);\n463\t    auto [grid, block] = kernel_launch_params(lifted_height, max_threads);\n464\t    // NOTE: lifted_height = skip_domain * num_x will always be divisible by block.x since num_x is a power of 2. Therefore all threads in a block will be active.\n465\t    grid.y = trace_width;\n466\t    return {grid, block};\n467\t}\n468\t\n469\t// (Not a launcher) Utility function to calculate required size of temp buffer.\n470\t// Required length of *block_sums in FpExt elements\n471\t// SP_DEG=1: outputs NUM_G=3 values per z (G0, G1, G2)\n472\textern \"C\" uint32_t _stacked_reduction_r0_required_temp_buffer_size(\n473\t    uint32_t trace_height,\n474\t    uint32_t trace_width,\n475\t    uint32_t l_skip\n476\t) {\n477\t    auto [grid, block] = stacked_reduction_round0_launch_params(trace_height, trace_width, l_skip);\n478\t    return ((grid.x * grid.y) << l_skip) * NUM_G;\n479\t}\n480\t\n481\t// SP_DEG=1: No z_packets needed, outputs G0, G1, G2 on identity coset only.\n482\t// Uses ADD_TO_OUTPUT=true to accumulate into output buffer (for bucket-based accumulation).\n483\textern \"C\" int _stacked_reduction_sumcheck_round0(\n484\t    const FpExt *eq_r_ns,\n485\t    const Fp *trace_ptr,\n486\t    const FpExt *lambda_pows,\n487\t    FpExt *block_sums,\n488\t    FpExt *output, // length should be NUM_G * skip_domain, ADD to existing values\n489\t    uint32_t trace_height,\n490\t    uint32_t trace_width,\n491\t    uint32_t l_skip,\n492\t    uint32_t num_x\n493\t) {\n494\t    uint32_t skip_domain = 1u << l_skip;\n495\t    uint32_t stride = std::max(skip_domain / trace_height, 1u);"}]},"parent_tool_use_id":"toolu_012TiSHWAPeHtSfM2cmShzFQ","session_id":"db10821c-17ee-4d4a-acd4-fd3a20fcece6","uuid":"b59c3923-a315-4100-8da1-59d095a41eca","timestamp":"2026-04-10T18:53:49.932Z"}
