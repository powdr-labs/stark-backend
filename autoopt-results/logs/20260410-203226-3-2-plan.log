{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VEN886yBApFLbgTgPeeedL","type":"tool_result","content":"1\tuse openvm_cuda_common::{\n2\t    d_buffer::DeviceBuffer,\n3\t    error::{check, CudaError},\n4\t};\n5\t\n6\tuse crate::{\n7\t    poly::EqEvalSegments,\n8\t    prelude::{D_EF, EF, F},\n9\t    stacked_reduction::{DegenerateWindowMeta, UnstackedSlice, STACKED_REDUCTION_S_DEG},\n10\t};\n11\t\n12\t/// Number of G outputs per z in round 0: G0, G1, G2\n13\tpub const NUM_G: usize = 3;\n14\t\n15\textern \"C\" {\n16\t    pub fn _stacked_reduction_r0_required_temp_buffer_size(\n17\t        trace_height: u32,\n18\t        trace_width: u32,\n19\t        l_skip: u32,\n20\t    ) -> u32;\n21\t\n22\t    // SP_DEG=1: no z_packets needed, outputs [NUM_G * skip_domain] to be ADDed\n23\t    fn _stacked_reduction_sumcheck_round0(\n24\t        eq_r_ns: *const EF,\n25\t        trace_ptr: *const F,\n26\t        lambda_pows: *const EF,\n27\t        block_sums: *mut EF,\n28\t        output: *mut EF,\n29\t        trace_height: u32,\n30\t        trace_width: u32,\n31\t        l_skip: u32,\n32\t        num_x: u32,\n33\t    ) -> i32;\n34\t\n35\t    fn _stacked_reduction_fold_ple(\n36\t        src: *const F,\n37\t        dst: *mut EF,\n38\t        omega_skip_pows: *const F,\n39\t        inv_lagrange_denoms: *const EF,\n40\t        trace_height: u32,\n41\t        trace_width: u32,\n42\t        l_skip: u32,\n43\t    ) -> i32;\n44\t\n45\t    fn _initialize_k_rot_from_eq_segments(\n46\t        eq_r_ns: *const EF,\n47\t        k_rot_ns: *mut EF,\n48\t        k_rot_uni_0: EF,\n49\t        k_rot_uni_1: EF,\n50\t        max_n: u32,\n51\t    ) -> i32;\n52\t\n53\t    fn _stacked_reduction_sumcheck_mle_round(\n54\t        q_evals: *const *const EF,\n55\t        eq_r_ns: *const EF,\n56\t        k_rot_ns: *const EF,\n57\t        unstacked_cols: *const UnstackedSlice,\n58\t        lambda_pows: *const EF,\n59\t        output: *mut u64, // atomic accumulator [S_DEG * D_EF]\n60\t        q_height: u32,\n61\t        window_len: u32,\n62\t        num_y: u32,\n63\t        sm_count: u32,\n64\t    ) -> i32;\n65\t\n66\t    fn _stacked_reduction_sumcheck_mle_round_degenerate(\n67\t        q_evals: *const *const EF,\n68\t        eq_ub_ptr: *const EF,\n69\t        eq_r: EF,\n70\t        k_rot_r: EF,\n71\t        unstacked_cols: *const UnstackedSlice,\n72\t        lambda_pows: *const EF,\n73\t        output: *mut u64, // atomic accumulator [S_DEG * D_EF]\n74\t        q_height: u32,\n75\t        window_len: u32,\n76\t        l_skip: u32,\n77\t        round: u32,\n78\t    ) -> i32;\n79\t\n80\t    fn _stacked_reduction_sumcheck_mle_round_degenerate_batched(\n81\t        q_evals: *const *const EF,\n82\t        eq_ub_all: *const EF,\n83\t        unstacked_cols: *const UnstackedSlice,\n84\t        lambda_pows: *const EF,\n85\t        metas: *const DegenerateWindowMeta,\n86\t        output: *mut u64,\n87\t        q_height: u32,\n88\t        num_windows: u32,\n89\t        shift_factor: u32,\n90\t    ) -> i32;\n91\t}\n92\t\n93\t/// SP_DEG=1 round 0 kernel: computes G0, G1, G2 partial sums on identity coset only.\n94\t///\n95\t/// This kernel computes three partial sums per z-coordinate:\n96\t/// - G0(Z) = Σ_{col,x} coeff_eq[col] * eq_cube(x) * q_{col,x}(Z)\n97\t/// - G1(Z) = Σ_{col,x} coeff_rot[col] * eq_cube(x) * q_{col,x}(Z)\n98\t/// - G2(Z) = Σ_{col,x} coeff_rot[col] * (eq_cube(rot_prev(x)) - eq_cube(x)) * q_{col,x}(Z)\n99\t///\n100\t/// The reconstruction s₀(Z) = E0(Z)*G0(Z) + E1(Z)*G1(Z) + E2(Z)*G2(Z) happens on CPU.\n101\t///\n102\t/// The reduction is done in two stages:\n103\t/// 1. Block-level reduction to `block_sums` (shared memory within block)\n104\t/// 2. Final reduction kernel that ADDs block sums into `output` (for bucket accumulation)\n105\t///\n106\t/// # Safety\n107\t/// - `trace_ptr` must be a pointer to a device buffer valid for `height * width` elements.\n108\t/// - `lambda_pows` should be pointer to DeviceBuffer<EF>, at an offset.\n109\t///   - `lambda_pows` must be initialized for at least `2 * window_len` elements (for rotations).\n110\t/// - `block_sums` should have length `>= _stacked_reduction_r0_required_temp_buffer_size(...)`.\n111\t/// - `output` should have length `>= NUM_G * 2^l_skip` and be zero-initialized before first call.\n112\t///   Values are ADDED to output for bucket-based accumulation.\n113\t#[allow(clippy::too_many_arguments)]\n114\tpub unsafe fn stacked_reduction_sumcheck_round0(\n115\t    eq_r_ns: &EqEvalSegments<EF>,\n116\t    trace_ptr: *const F,\n117\t    lambda_pows: *const EF,\n118\t    block_sums: &mut DeviceBuffer<EF>,\n119\t    output: &mut DeviceBuffer<EF>,\n120\t    height: usize,"}]},"parent_tool_use_id":"toolu_012TiSHWAPeHtSfM2cmShzFQ","session_id":"db10821c-17ee-4d4a-acd4-fd3a20fcece6","uuid":"17dd8fbe-658c-4728-8240-927f5ea961ee","timestamp":"2026-04-10T18:53:56.621Z"}
