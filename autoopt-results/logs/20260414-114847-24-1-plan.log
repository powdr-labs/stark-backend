280\\t    };\\n281\\t    let zc_prealloc_temp = if w.zc_temp_sums_cap > 0\\n282\\t        && bufs.zc_temp_sums.len() >= w.zc_temp_sums_cap\\n283\\t    {\\n284\\t        Some(&mut bufs.zc_temp_sums)\\n285\\t    } else {\\n286\\t        None\\n287\\t    };\\n288\\t\\n289\\t    let sum_buffer = evaluate_round0_constraints_gpu(\\n290\\t        single_pk,\\n291\\t        w.selectors_cube.buffer(),\\n292\\t        &d_main_parts,\\n293\\t        w.public_values,\\n294\\t        eq_xi_tree.get_ptr(n_lift),\\n295\\t        w.d_lambda_pows,\\n296\\t        1 << w.l_skip,\\n297\\t        1 << n_lift,\\n298\\t        height as u32,\\n299\\t        num_cosets_zc as u32,\\n300\\t        omega_root,\\n301\\t        w.max_temp_bytes,\\n302\\t        zc_prealloc_inter,\\n303\\t        zc_prealloc_temp,\\n304\\t    )?;\\n305\\t\\n306\\t    // GPU-side polynomial extraction: launch a small kernel to compute\\n307\\t    // iDFT + Lagrange interpolation + coefficient adjustment on-device,\\n308\\t    // writing directly into the batch array. No D2H sync needed.\\n309\\t    if !sum_buffer.is_empty() {\\n310\\t        let tables = &extract_tables[&local_constraint_deg];\\n311\\t        let err = unsafe {\\n312\\t            _round0_extract_zerocheck_poly(\\n313\\t                d_batch_ptr.add(w.zc_batch_offset),\\n314\\t                sum_buffer.as_ptr(),\\n315\\t                tables.zc_transform.as_ptr(),\\n316\\t                tables.zc_input_size,\\n317\\t                tables.zc_output_size,\\n318\\t            )\\n319\\t        };\\n320\\","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/home/georg/.claude/projects/-home-georg-stark-backend/a8941d98-8943-40ba-ba2b-e8ee56c821e0/tool-results/bn697wl18.txt","persistedOutputSize":78760}}
