470\t                Ok(results)\n1471\t            })\n1472\t            .collect::<Result<Vec<_>, FoldPleError>>()?;\n1473\t        if self.save_memory {\n1474\t            self.memory_limit_bytes = mem_limit;\n1475\t        }\n1476\t\n1477\t        // GPU folding for sels_per_trace (rotate=false, only need offset=0)\n1478\t        self.sels_per_trace = std::mem::take(&mut self.sels_per_trace_base)\n1479\t            .into_iter()\n1480\t            .enumerate()\n1481\t            .map(|(trace_idx, selectors_cube)| {\n1482\t                let n = self.n_per_trace[trace_idx];\n1483\t                let num_x = selectors_cube.height();\n1484\t                debug_assert_eq!(num_x, 1 << n.max(0));\n1485\t                debug_assert_eq!(selectors_cube.width(), 3);\n1486\t                let (l, r) = if n.is_negative() {\n1487\t                    (\n1488\t                        l_skip.wrapping_add_signed(n),\n1489\t                        r_0.exp_power_of_2(-n as usize),\n1490\t                    )\n1491\t                } else {\n1492\t                    (l_skip, r_0)\n1493\t                };\n1494\t                let omega = F::two_adic_generator(l);\n1495\t                let is_first = eval_eq_uni_at_one(l, r);\n1496\t                let is_last = eval_eq_uni_at_one(l, r * omega);\n1497\t                let folded_buf = DeviceBuffer::<EF>::with_capacity(num_x * 3);\n1498\t                unsafe {\n1499\t                    fold_selectors_round0(\n1500\t                        folded_buf.as_mut_ptr(),\n1501\t                        selectors_cube.buffer().as_ptr(),\n1502\t                        is_first,\n1503\t                        is_last,\n1504\t                        num_x,\n1505\t                    )\n1506\t                    .map_err(LogupZerocheckError::FoldSelectorsRound0)?;\n1507\t                }\n1508\t                Ok(DeviceMatrix::new(Arc::new(folded_buf), num_x, 3))\n1509\t            })\n1510\t            .collect::<Result<Vec<_>, Log