{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NTHY3rLoCUynrcDDQDtFbx","type":"tool_result","content":"1\tuse std::{ffi::c_void, fmt::Debug, ptr};\n2\t\n3\tuse crate::{\n4\t    copy::MemCopyD2H,\n5\t    error::{check, CudaError},\n6\t    memory_manager::{d_free, d_malloc},\n7\t    stream::{cudaStreamPerThread, cudaStream_t},\n8\t};\n9\t\n10\t#[link(name = \"cudart\")]\n11\textern \"C\" {\n12\t    pub fn cudaMemsetAsync(dst: *mut c_void, value: i32, count: usize, stream: cudaStream_t)\n13\t        -> i32;\n14\t}\n15\t\n16\t/// Struct that owns a buffer allocated on GPU device. The struct only holds the raw pointer and\n17\t/// length, but this struct has a `Drop` implementation which frees the associated device memory.\n18\t///\n19\t/// When `owns_memory` is false, the buffer is a non-owning view into device memory and will NOT\n20\t/// free the memory on drop. This is used for creating sub-region views into larger buffers.\n21\t#[repr(C)]\n22\tpub struct DeviceBuffer<T> {\n23\t    ptr: *mut T,\n24\t    len: usize,\n25\t    owns_memory: bool,\n26\t}\n27\t\n28\t/// A struct that packs a pointer with a size in bytes to pass on CUDA.\n29\t/// It holds `*const c_void` for being a universal simple type that can be read by CUDA.\n30\t/// Since it is hard to enforce immutability preservation, it just holds `*const`,\n31\t/// but has two separate constructors for more robustness from the usage perspective.\n32\t/// This is essentially a [DeviceBuffer] but without owning the data.\n33\t#[repr(C)]\n34\t#[derive(Debug, Copy, Clone)]\n35\tpub struct DeviceBufferView {\n36\t    pub ptr: *const c_void,\n37\t    pub size: usize,\n38\t}\n39\t\n40\tunsafe impl<T> Send for DeviceBuffer<T> {}\n41\tunsafe impl<T> Sync for DeviceBuffer<T> {}\n42\t\n43\timpl<T> DeviceBuffer<T> {\n44\t    /// Creates an \"empty\" DeviceBuffer with a null pointer and zero length.\n45\t    #[allow(clippy::new_without_default)]\n46\t    pub fn new() -> Self {\n47\t        DeviceBuffer {\n48\t            ptr: ptr::null_mut(),\n49\t            len: 0,\n50\t            owns_memory: true,\n51\t        }\n52\t    }\n53\t\n54\t    /// # Safety\n55\t    /// - The caller must ensure that the pointer `ptr` is valid for `len` elements of type `T` in\n56\t    ///   device memory.\n57\t    /// - Dropping the constructed buffer will attempt to free the memory. As such, `ptr` must\n58\t    ///   either have been allocated by the internal memory manager (VPMM) or the caller must use\n59\t    ///   `ManuallyDrop` to prevent double-free.\n60\t    pub unsafe fn from_raw_parts(ptr: *mut T, len: usize) -> Self {\n61\t        DeviceBuffer {\n62\t            ptr,\n63\t            len,\n64\t            owns_memory: true,\n65\t        }\n66\t    }\n67\t\n68\t    /// Creates a non-owning view into device memory. The view will NOT free the memory on drop.\n69\t    ///\n70\t    /// # Safety\n71\t    /// The caller must ensure that:\n72\t    /// - `ptr` points to valid device memory for `len` elements of type `T`\n73\t    /// - The underlying memory remains valid for the lifetime of this buffer\n74\t    pub unsafe fn non_owning(ptr: *mut T, len: usize) -> Self {\n75\t        DeviceBuffer {\n76\t            ptr,\n77\t            len,\n78\t            owns_memory: false,\n79\t        }\n80\t    }\n81\t\n82\t    /// Allocate device memory for `len` elements of type `T`.\n83\t    pub fn with_capacity(len: usize) -> Self {\n84\t        tracing::debug!(\n85\t            \"Creating device buffer of size {} (sizeof type = {})\",\n86\t            len,\n87\t            size_of::<T>()\n88\t        );\n89\t        assert_ne!(len, 0, \"Zero capacity request is wrong\");\n90\t        let size_bytes = std::mem::size_of::<T>() * len;\n91\t        let raw_ptr = d_malloc(size_bytes).expect(\"GPU allocation failed\");\n92\t        #[cfg(feature = \"touchemall\")]\n93\t        {\n94\t            // 0xffffffff is `Fp::invalid()` and shouldn't occur in a trace\n95\t            unsafe {\n96\t                cudaMemsetAsync(raw_ptr, 0xff, size_bytes, cudaStreamPerThread);\n97\t            }\n98\t        }\n99\t        let typed_ptr = raw_ptr as *mut T;\n100\t\n101\t        DeviceBuffer {\n102\t            ptr: typed_ptr,\n103\t            len,\n104\t            owns_memory: true,\n105\t        }\n106\t    }\n107\t\n108\t    /// Fills the buffer with zeros.\n109\t    pub fn fill_zero(&self) -> Result<(), CudaError> {\n110\t        assert_ne!(self.len, 0, \"Empty buffer\");\n111\t        let size_bytes = std::mem::size_of::<T>() * self.len;\n112\t        check(unsafe { cudaMemsetAsync(self.as_mut_raw_ptr(), 0, size_bytes, cudaStreamPerThread) })\n113\t    }\n114\t\n115\t    /// Fills a suffix of the buffer with zeros.\n116\t    /// The `start_idx` is the index in the buffer, in `T` elements.\n117\t    pub fn fill_zero_suffix(&self, start_idx: usize) -> Result<(), CudaError> {\n118\t        assert!(\n119\t            start_idx < self.len,\n120\t            \"start index has to be smaller than length\"\n121\t        );\n122\t        let size_bytes = std::mem::size_of::<T>() * (self.len - start_idx);\n123\t        check(unsafe {\n124\t            cudaMemsetAsync(\n125\t                self.as_mut_ptr().add(start_idx) as *mut c_void,\n126\t                0,\n127\t                size_bytes,\n128\t                cudaStreamPerThread,\n129\t            )\n130\t        })\n131\t    }\n132\t\n133\t    /// Returns the number of elements in this buffer.\n134\t    pub fn len(&self) -> usize {\n135\t        self.len\n136\t    }\n137\t\n138\t    /// Returns whether the buffer is empty (null pointer or zero length).\n139\t    pub fn is_empty(&self) -> bool {\n140\t        self.len == 0 || self.ptr.is_null()\n141\t    }\n142\t\n143\t    /// Returns a raw mutable pointer to the device data (typed).\n144\t    pub fn as_mut_ptr(&self) -> *mut T {\n145\t        self.ptr\n146\t    }\n147\t\n148\t    /// Returns a raw const pointer to the device data (typed).\n149\t    pub fn