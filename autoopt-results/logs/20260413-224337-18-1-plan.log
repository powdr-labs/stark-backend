4\t            unsafe {\n305\t                let ptr = matrix.mixed.as_ptr().add(offset);\n306\t                Some(DeviceMatrixView::from_raw_parts(ptr, lifted_height, width))\n307\t            }\n308\t        } else {\n309\t            None\n310\t        }\n311\t    }\n312\t}\n313\t\n314\t#[cfg(test)]\n315\tmod tests {\n316\t    use itertools::Itertools;\n317\t    use openvm_stark_backend::{\n318\t        prover::ColMajorMatrix,\n319\t        test_utils::{InteractionsFixture11, TestFixture},\n320\t    };\n321\t    use p3_field::PrimeCharacteristicRing;\n322\t\n323\t    use super::*;\n324\t    use crate::{\n325\t        data_transporter::{transport_matrix_d2h_col_major, transport_matrix_h2d_col_major},\n326\t        prelude::{F, SC},\n327\t    };\n328\t\n329\t    #[test]\n330\t    fn test_stacked_matrix_manual_0() {\n331\t        let columns = [vec![1, 2, 3, 4], vec![5, 6], vec![7]]\n332\t            .map(|v| v.into_iter().map(F::from_u32).collect_vec());\n333\t        let mats = columns\n334\t            .into_iter()\n335\t            .map(|c| transport_matrix_h2d_col_major(&ColMajorMatrix::new(c, 1)).unwrap())\n336\t            .collect_vec();\n337\t        let mat_refs = mats.iter().collect_vec();\n338\t        let l_skip = 0;\n339\t        let (stacked_mat, _layout) = stacked_matrix(0, 2, &mat_refs).unwrap();\n340\t        assert_eq!(stacked_mat.height(), 4);\n341\t        assert_eq!(stacked_mat.width(), 2);\n342\t        let stacked_h_mat =\n343\t            transport_matrix_d2h_col_major(&stacked_mat.to_evals(l_skip).unwrap()).unwrap();\n344\t        assert_eq!(\n345\t            stacked_h_mat.values,\n346\t            [1, 2, 3, 4, 5, 6, 7, 0].map(F::from_u32).to_vec()\n347\t        );\n348\t    }\n349\t\n350\t    #[test]\n351\t    fn test_stacked_matrix_manual_1() {\n352\t        let ctx = TestFixture::<SC>::generate_proving_ctx(&InteractionsFixture11);\n353\t        let [send_trace, rcv_trace] = [0, 1]\n354\t            .map(|i| transport_matrix_h2d_col_major(&ctx.per_trace[i].1.common_main).unwrap());\n355\t        let l_skip = 2;\n356\t        let n_stack = 8;\n357\t        let (stacked_mat, _layout) =\n358\t            stacked_matrix(l_skip, n_stack, &[&rcv_trace, &send_trace]).unwrap();\n359\t        assert_eq!(stacked_mat.height(), 1 << (l_skip + n_stack));\n360\t        assert_eq!(stacked_mat.width(), 1);\n361\t        let stacked_h_mat =\n362\t            transport_matrix_d2h_col_major(&stacked_mat.to_evals(l_skip).unwrap()).unwrap();\n363\t        let mut expected = vec![F::ZERO; 1 << (l_skip + n_stack)];\n364\t        expected[..24].copy_from_slice(\n365\t            &[\n366\t                1, 3, 4, 2, 0, 545, 1, 0, 5, 4, 4, 5, 123, 889, 889, 456, 0, 3, 7, 546, 1, 5, 4,\n367\t                889,\n368\t            ]\n369\t            .map(F::from_u32),\n370\t        );\n371\t        assert_eq!(stacked_h_mat.values, expected);\n372\t    }\n373\t\n374\t    #[test]\n375\t    fn test_stacked_matrix_manual_strided_0() {\n376\t        let columns = [vec![1, 2, 3, 4], vec![5, 6], vec![7]]\n377\t            .map(|v| v.into_iter().map(F::from_u32).collect_vec());\n378\t        let mats = columns\n379\t            .into_iter()\n380\t            .map(|c| transport_matrix_h2d_col_major(&ColMajorMatrix::new(c, 1)).unwrap())\n381\t            .collect_vec();\n382\t        let mat_refs = mats.iter().collect_vec();\n383\t        let l_skip = 2;\n384\t        let (stacked_mat, _layout) = stacked_matrix(l_skip, 0, &mat_refs).unwrap();\n385\t        assert_eq!(stacked_mat.height(), 4);\n386\t        assert_eq!(stacked_mat.width(), 3);\n387\t        let stacked_h_mat =\n388\t            transport_matrix_d2h_col_major(&stacked_mat.to_evals(l_skip).unwrap()).unwrap();\n389\t        assert_eq!(\n390\t            stacked_h_mat.values,\n391\t            [1, 2, 3, 4, 5, 0, 6, 0, 7, 0, 0, 0]\n392\t                .map(F::from_u32)\n393\t                .to_vec()\n394\t        );\n395\t    }\n396\t\n397\t    #[test]\n398\t    fn test_stacked_matrix_manual_strided_1() {\n399\t        let columns = [vec![1, 2, 3, 4], vec![5, 6], vec![7]]\n400\t            .map(|v| v.into_iter().map(F::from_u32).collect_vec());\n401\t        let mats = columns\n402\t            .into_iter()\n403\t            .map(|c| transport_matrix_h2d_col_major(&ColMajorMatrix::new(c, 1)).unwrap())\n404\t            .collect_vec();\n405\t        let mat_refs = mats.iter().collect_vec();\n406\t        let l_skip = 3;\n407\t        let (stacked_mat, _layout) = stacked_matrix(l_skip, 0, &mat_refs).unwrap();\n408\t        assert_eq!(stacked_mat.height(), 8);\n409\t        assert_eq!(stacked_mat.width(), 3);\n410\t        let stacked_h_mat =\n411\t            transport_matrix_d2h_col_major(&stacked_mat.to_evals(l_skip).unwrap()).unwrap();\n412\t        assert_eq!(\n413\t            stacked_h_mat.values,\n414\t            [\n415\t                [1, 0, 2, 0, 3, 0, 4, 0],\n416\t                [5, 0, 0, 0, 6, 0, 0, 0],\n417\t                [7, 0, 0, 0, 0, 0, 0, 0]\n418\t            ]\n419\t            .into_iter()\n420\t            .flatten()\n421\t            .map(F::from_u32)\n422\t            .collect_vec()\n423\t        );\n424\t    }\n425\t}\n426\t"}]},"parent_tool_use_id":"toolu_016bBTyVj4tx4GM8Q49P8JHn","session_id":"50e92e47-0cd3-4f35-91c1-5f23da5f72d3","uuid":"18698218-9505-4df0-9824-96b631dfdf7a","timestamp":"2026-04-13T20:50:50.590Z"}
