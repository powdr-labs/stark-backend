{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018Rzu1tvsf8XynaFvPXobry","type":"tool_result","content":"1\tuse std::array::from_fn;\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::{\n5\t    copy::{MemCopyD2H, MemCopyH2D},\n6\t    d_buffer::DeviceBuffer,\n7\t    memory_manager::MemTracker,\n8\t};\n9\tuse openvm_stark_backend::prover::MatrixDimensions;\n10\tuse p3_util::log2_strict_usize;\n11\tuse tracing::{info_span, instrument};\n12\t\n13\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n14\tuse crate::cuda::bn254_merkle_tree::Bn254Digest;\n15\tuse crate::{\n16\t    base::DeviceMatrix,\n17\t    cuda::{matrix::matrix_get_rows_fp_kernel, merkle_tree::query_digest_layers},\n18\t    hash_scheme::{GpuMerkleHash, Poseidon2MerkleHash},\n19\t    prelude::{Digest, DIGEST_SIZE, EF, F},\n20\t    MerkleTreeError,\n21\t};\n22\t\n23\t/// Trait for reconstructing a digest from a flat slice of F elements as\n24\t/// produced by the `query_digest_layers` CUDA kernel.\n25\t///\n26\t/// Both `Digest = [F; 8]` (BabyBear Poseidon2) and `Bn254Digest = [Bn254Scalar; 1]`\n27\t/// occupy exactly `DIGEST_SIZE * size_of::<F>()` = 32 bytes, so the same kernel\n28\t/// can be reused for both.\n29\tpub trait BatchQueryMerkle: Copy + Sized + 'static {\n30\t    /// Reconstruct one digest from `DIGEST_SIZE` consecutive F-valued words in `out`\n31\t    /// starting at index `base`.\n32\t    fn reconstruct_from_f(out: &[F], base: usize) -> Self;\n33\t}\n34\t\n35\timpl BatchQueryMerkle for Digest {\n36\t    fn reconstruct_from_f(out: &[F], base: usize) -> Self {\n37\t        from_fn(|i| out[base + i])\n38\t    }\n39\t}\n40\t\n41\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n42\timpl BatchQueryMerkle for Bn254Digest {\n43\t    fn reconstruct_from_f(out: &[F], base: usize) -> Self {\n44\t        // Safety: [F; DIGEST_SIZE] and Bn254Digest have the same size (32 bytes).\n45\t        const _: () =\n46\t            assert!(std::mem::size_of::<Bn254Digest>() == DIGEST_SIZE * std::mem::size_of::<F>());\n47\t        let f_arr: [F; DIGEST_SIZE] = from_fn(|i| out[base + i]);\n48\t        unsafe { std::ptr::read_unaligned(f_arr.as_ptr() as *const Bn254Digest) }\n49\t    }\n50\t}\n51\t\n52\tpub struct MerkleTreeGpu<F, Digest> {\n53\t    /// The matrix that is used to form the leaves of the Merkle tree, which are\n54\t    /// in turn hashed into the bottom digest layer.\n55\t    ///\n56\t    /// This matrix is optionally cached depending on the prover configuration:\n57\t    /// - Caching increases the peak GPU memory but avoids a recomputation of MLE eval-to-coeffs,\n58\t    ///   batch_expand, and forward NTT.\n59\t    /// - Not caching pays a performance penalty due to the above recomputation.\n60\t    pub(crate) backing_matrix: Option<DeviceMatrix<F>>,\n61\t    pub(crate) digest_layers: Vec<DeviceBuffer<Digest>>,\n62\t    pub(crate) rows_per_query: usize,\n63\t    pub(crate) root: Digest,\n64\t}\n65\t\n66\tpub trait MerkleTreeConstructor: GpuMerkleHash {\n67\t    fn new_merkle_tree(\n68\t        matrix: DeviceMatrix<F>,\n69\t        rows_per_query: usize,\n70\t        cache_backing_matrix: bool,\n71\t    ) -> Result<MerkleTreeGpu<F, Self::Digest>, MerkleTreeError>;\n72\t}\n73\t\n74\tpub trait MerkleProofQueryDigest: BatchQueryMerkle + Copy + Send + Sync + 'static {\n75\t    fn batch_query_merkle_proofs(\n76\t        trees: &[&MerkleTreeGpu<F, Self>],\n77\t        query_indices: &[usize],\n78\t    ) -> Result<Vec<Vec<Vec<Self>>>, MerkleTreeError>;\n79\t}\n80\t\n81\timpl<F, Digest> MerkleTreeGpu<F, Digest> {\n82\t    pub fn root(&self) -> Digest\n83\t    where\n84\t        Digest: Clone,\n85\t    {\n86\t        self.root.clone()\n87\t    }\n88\t\n89\t    pub fn query_stride(&self) -> usize {\n90\t        self.digest_layers[0].len()\n91\t    }\n92\t\n93\t    pub fn proof_depth(&self) -> usize {\n94\t        self.digest_layers.len() - 1\n95\t    }\n96\t}\n97\t\n98\t// Base field merkle tree — generic constructor\n99\timpl<D: Copy + Send + Sync + 'static> MerkleTreeGpu<F, D> {\n100\t    /// Build a Merkle tree using the given hash scheme `MH`.\n101\t    ///\n102\t    /// This is the primary constructor; `new()` is a convenience wrapper that\n103\t    /// fixes `MH = Poseidon2MerkleHash`.\n104\t    #[instrument(name = \"merkle_tree\", skip_all)]\n105\t    pub fn new_with_hash<MH: MerkleTreeConstructor<Digest = D>>(\n106\t        matrix: DeviceMatrix<F>,\n107\t        rows_per_query: usize,\n108\t        cache_backing_matrix: bool,\n109\t    ) -> Result<Self, MerkleTreeError> {\n110\t        MH::new_merkle_tree(matrix, rows_per_query, cache_backing_matrix)\n111\t    }\n112\t\n113\t    fn new_generic_with_hash<MH: GpuMerkleHash<Digest = D>>(\n114\t        matrix: DeviceMatrix<F>,\n115\t        rows_per_query: usize,\n116\t        cache_backing_matrix: bool,\n117\t    ) -> Result<Self, MerkleTreeError> {\n118\t        let mem = MemTracker::start(\"prover.merkle_tree\");\n119\t        let height = matrix.height();\n120\t        assert!(height.is_power_of_two());\n121\t        let k = log2_strict_usize(rows_per_query);\n122\t        assert!(\n123\t            rows_per_query <= height,\n124\t            \"rows_per_query ({rows_per_query}) must not exceed height ({height})\"\n125\t        );\n126\t        let query_stride = height / rows_per_query;\n127\t        let mut query_digest_layer = DeviceBuffer::<D>::with_capacity(query_stride);\n128\t        // SAFETY: query_digest_layer properly allocated\n129\t        unsafe {\n130\t            MH::compress_rows(\n131\t                &mut query_digest_layer,\n132\t                matrix.buffer(),\n133\t                matrix.width(),\n134\t                query_stride,\n135\t                k,\n136\t            )\n137\t            .map_err(MerkleTreeError::CompressingRowHashes)?;\n138\t        }\n139\t        // If not caching, drop the backing matrix at this point to save memory.\n140\t        let backing_matrix = cache_backing_matrix.then_some(matrix);\n141\t\n142\t        let mut digest_layers = vec![query_digest_layer];\n143\t        while digest_layers.last().unwrap().len() > 1 {\n144\t            let prev_layer = digest_layers.last().unwrap();\n145\t            let mut layer = DeviceBuffer::<D>::with_capacity(prev_layer.len() / 2);\n146\t            let layer_len = layer.len();\n147\t            let layer_idx = digest_layers.len();\n148\t            // SAFETY:\n149\t            // - `layer` is properly allocated with half the size of `prev_layer` and does not\n150\t            //   overlap with it.\n151\t            unsafe {\n152\t                MH::compress_layer(&mut layer, prev_layer, layer_len).map_err(|error| {\n153\t                    MerkleTreeError::AdjacentCompressLayer {\n154\t                        error,\n155\t                        layer: layer_idx,\n156\t                    }\n157\t                })?;\n158\t            }\n159\t            digest_layers.push(layer);\n160\t        }\n161\t        let d_root = digest_layers.last().unwrap();\n162\t        assert_eq!(d_root.len(), 1, \"Only one root is supported\");\n163\t        let root = d_root.to_host()?.pop().unwrap();\n164\t\n165\t        mem.emit_metrics();\n166\t        Ok(Self {\n167\t            backing_matrix,\n168\t            digest_layers,\n169\t            rows_per_query,\n170\t            root,\n171\t        })\n172\t    }\n173\t\n174\t    #[instrument(name = \"batch_open_rows\", skip_all)]\n175\t    pub fn batch_open_rows(\n176\t        backing_matrices: &[&DeviceMatrix<F>],\n177\t        query_indices: &[usize],\n178\t        query_stride: usize,\n179\t        rows_per_query: usize,\n180\t    ) -> Result<\n181\t        Vec<\n182\t            // per tree\n183\t            Vec<\n184\t                // per query index\n185\t                Vec<F>, // opened rows, concatenated for rows_per_query strided rows\n186\t            >,\n187\t        >,\n188\t        MerkleTreeError,\n189\t    > {\n190\t        let row_idxs = query_indices\n191\t            .iter()\n192\t            .flat_map(|&query_idx| {\n193\t                debug_assert!(query_idx < query_stride);\n194\t                (0..rows_per_query)\n195\t                    .map(move |row_offset| (row_offset * query_stride + query_idx) as u32)\n196\t            })\n197\t            .collect_vec();\n198\t        let d_row_idxs = row_idxs.to_device()?;\n199\t        // PERF[jpw]: I did not batch across trees into a single kernel call because widths are\n200\t        // different so it was inconvenient. Make a new kernel if slow.\n201\t        // NOTE: par_iter requires cross-stream waits, not worth the effort\n202\t        backing_matrices\n203\t            .iter()\n204\t            .enumerate()\n205\t            .map(|(matrix_idx, matrix)| {\n206\t                let d_out = DeviceBuffer::<F>::with_capacity(row_idxs.len() * matrix.width());\n207\t                // SAFETY:\n208\t                // - `output_rows` is allocated with row_idxs.len() * width\n209\t                // - row indices are within bounds\n210\t                unsafe {\n211\t                    matrix_get_rows_fp_kernel(\n212\t                        &d_out,\n213\t                        matrix.buffer(),\n214\t                        &d_row_idxs,\n215\t                        matrix.width() as u64,\n216\t                        matrix.height() as u64,\n217\t                        d_row_idxs.len() as u32,\n218\t                    )\n219\t                    .map_err(|error| MerkleTreeError::MatrixGetRows { error, matrix_idx })?;\n220\t                }\n221\t                let width = matrix.width();\n222\t                let out = info_span!(\"opened_rows_d2h\").in_scope(|| d_out.to_host())?;\n223\t                let opened_rows_per_query = out\n224\t                    .chunks_exact(rows_per_query * width)\n225\t                    .map(|rows| rows.to_vec())\n226\t                    .collect_vec();\n227\t                Ok(opened_rows_per_query)\n228\t            })\n229\t            .collect::<Result<Vec<_>, MerkleTreeError>>()\n230\t    }\n231\t}\n232\t\n233\timpl MerkleTreeConstructor for Poseidon2MerkleHash {\n234\t    fn new_merkle_tree(\n235\t        matrix: DeviceMatrix<F>,\n236\t        rows_per_query: usize,\n237\t        cache_backing_matrix: bool,\n238\t    ) -> Result<MerkleTreeGpu<F, Self::Digest>, MerkleTreeError> {\n239\t        MerkleTreeGpu::<F, Self::Digest>::new_generic_with_hash::<Self>(\n240\t            matrix,\n241\t            rows_per_query,\n242\t            cache_backing_matrix,\n243\t        )\n244\t    }\n245\t}\n246\t\n247\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n248\timpl MerkleTreeConstructor for crate::hash_scheme::Bn254Poseidon2MerkleHash {\n249\t    fn new_merkle_tree(\n250\t        matrix: DeviceMatrix<F>,\n251\t        rows_per_query: usize,\n252\t        cache_backing_matrix: bool,\n253\t    ) -> Result<MerkleTreeGpu<F, Self::Digest>, MerkleTreeError> {\n254\t        MerkleTreeGpu::<F, Self::Digest>::new_generic_with_hash::<Self>(\n255\t            matrix,\n256\t            rows_per_query,\n257\t            cache_backing_matrix,\n258\t        )\n259\t    }\n260\t}\n261\t\n262\t// Base field merkle tree — Poseidon2 default constructor\n263\timpl MerkleTreeGpu<F, Digest> {\n264\t    /// Build a Merkle tree using the default Poseidon2 hash.\n265\t    ///\n266\t    /// Equivalent to `new_with_hash::<Poseidon2MerkleHash>(...)`.\n267\t    pub fn new(\n268\t        matrix: DeviceMatrix<F>,\n269\t        rows_per_query: usize,\n270\t        cache_backing_matrix: bool,\n271\t    ) -> Result<Self, MerkleTreeError> {\n272\t        Self::new_with_hash::<Poseidon2MerkleHash>(matrix, rows_per_query, cache_backing_matrix)\n273\t    }\n274\t}\n275\t\n276\t// Base field merkle tree — generic batch query (works for any BatchQueryMerkle digest)\n277\timpl<D: BatchQueryMerkle + Send + Sync + 'static> MerkleTreeGpu<F, D> {\n278\t    fn batch_query_proofs(\n279\t        trees: &[&Self],\n280\t        query_indices: &[usize],\n281\t    ) -> Result<Vec<Vec<Vec<D>>>, MerkleTreeError> {\n282\t        // The kernel treats each layer as a separate array and does parallel accesses;\n283\t        // we lay out all the layer pointers flattened into a vec.\n284\t        let num_trees = trees.len();\n285\t        let num_queries = query_indices.len();\n286\t        let depth = trees[0].proof_depth();\n287\t        debug_assert!(\n288\t            trees.iter().all(|tree| tree.proof_depth() == depth),\n289\t            \"Merkle trees don't have same depth\"\n290\t        );\n291\t        let layers_ptr = trees\n292\t            .iter()\n293\t            .flat_map(|tree| {\n294\t                // skip root layer [depth]\n295\t                tree.digest_layers\n296\t                    .iter()\n297\t                    .take(depth)\n298\t                    .map(|layer| layer.as_ptr() as u64)\n299\t            })\n300\t            .collect_vec();\n301\t        let d_layers_ptr = layers_ptr.to_device()?;\n302\t        debug_assert_eq!(d_layers_ptr.len(), num_trees * depth);\n303\t\n304\t        // [query_idx] is the top level grouping\n305\t        let indices = query_indices\n306\t            .iter()\n307\t            .flat_map(|&index| {\n308\t                (0..num_trees).flat_map(move |tree_idx| {\n309\t                    (0..depth).map(move |layer_idx| {\n310\t                        debug_assert!(index < trees[tree_idx].query_stride());\n311\t                        ((index >> layer_idx) ^ 1) as u64\n312\t                    })\n313\t                })\n314\t            })\n315\t            .collect_vec();\n316\t        let d_indices = indices.to_device()?;\n317\t        debug_assert_eq!(d_indices.len(), d_layers_ptr.len() * num_queries);\n318\t\n319\t        let mut d_out =\n320\t            DeviceBuffer::<F>::with_capacity(d_layers_ptr.len() * num_queries * DIGEST_SIZE);\n321\t        // SAFETY:\n322\t        // - d_out has size num_trees * depth * num_queries * DIGEST_SIZE in `F` elements\n323\t        // - d_layers_ptr is size `num_trees * depth` device pointers\n324\t        // - d_indices is size `num_trees * depth * num_queries` indices for merkle proof sibling\n325\t        //   indices\n326\t        // - Both Digest=[F;8] and Bn254Digest=[Bn254Scalar;1] are 32 bytes == DIGEST_SIZE * 4, so\n327\t        //   the same kernel correctly copies the raw bytes for either digest type.\n328\t        unsafe {\n329\t            query_digest_layers(\n330\t                &mut d_out,\n331\t                &d_layers_ptr,\n332\t                &d_indices,\n333\t                num_queries as u64,\n334\t                d_layers_ptr.len() as u64,\n335\t            )\n336\t            .map_err(MerkleTreeError::QueryDigestLayers)?;\n337\t        }\n338\t        let out = d_out.to_host()?;\n339\t        // Chunk up the array using D::reconstruct_from_f\n340\t        let res = (0..num_trees)\n341\t            .map(|tree_idx| {\n342\t                (0..num_queries)\n343\t                    .map(|query_idx| {\n344\t                        (0..depth)\n345\t                            .map(|layer_idx| {\n346\t                                let base =\n347\t                                    (query_idx * num_trees * depth + tree_idx * depth + layer_idx)\n348\t                                        * DIGEST_SIZE;\n349\t                                D::reconstruct_from_f(&out, base)\n350\t                            })\n351\t                            .collect_vec()\n352\t                    })\n353\t                    .collect_vec()\n354\t            })\n355\t            .collect_vec();\n356\t        Ok(res)\n357\t    }\n358\t\n359\t    /// Batch queries multiple `trees` at _the same_ `query_indices` for merkle proofs.\n360\t    ///\n361\t    /// # Assumptions\n362\t    /// - All `trees` have the same depth.\n363\t    pub fn batch_query_merkle_proofs(\n364\t        trees: &[&Self],\n365\t        query_indices: &[usize],\n366\t    ) -> Result<\n367\t        Vec<\n368\t            // per tree\n369\t            Vec<\n370\t                // per query index\n371\t                Vec<D>, // merkle proof\n372\t            >,\n373\t        >,\n374\t        MerkleTreeError,\n375\t    >\n376\t    where\n377\t        D: MerkleProofQueryDigest,\n378\t    {\n379\t        D::batch_query_merkle_proofs(trees, query_indices)\n380\t    }\n381\t}\n382\t\n383\timpl MerkleProofQueryDigest for Digest {\n384\t    fn batch_query_merkle_proofs(\n385\t        trees: &[&MerkleTreeGpu<F, Self>],\n386\t        query_indices: &[usize],\n387\t    ) -> Result<Vec<Vec<Vec<Self>>>, MerkleTreeError> {\n388\t        MerkleTreeGpu::<F, Self>::batch_query_proofs(trees, query_indices)\n389\t    }\n390\t}\n391\t\n392\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n393\timpl MerkleProofQueryDigest for Bn254Digest {\n394\t    fn batch_query_merkle_proofs(\n395\t        trees: &[&MerkleTreeGpu<F, Self>],\n396\t        query_indices: &[usize],\n397\t    ) -> Result<Vec<Vec<Vec<Self>>>, MerkleTreeError> {\n398\t        MerkleTreeGpu::<F, Self>::batch_query_proofs(trees, query_indices)\n399\t    }\n400\t}\n401\t\n402\t// Extension field merkle tree — generic constructor\n403\timpl<D: Copy + Send + Sync + 'static> MerkleTreeGpu<EF, D> {\n404\t    /// Build a Merkle tree from an extension-field matrix using hash scheme `MH`.\n405\t    #[instrument(name = \"merkle_tree_ext\", skip_all)]\n406\t    pub fn new_with_hash<MH: GpuMerkleHash<Digest = D>>(\n407\t        matrix: DeviceMatrix<EF>,\n408\t        rows_per_query: usize,\n409\t        cache_backing_matrix: bool,\n410\t    ) -> Result<Self, MerkleTreeError> {\n411\t        let height = matrix.height();\n412\t        assert!(height.is_power_of_two());\n413\t        let k = log2_strict_usize(rows_per_query);\n414\t        assert!(\n415\t            rows_per_query <= height,\n416\t            \"rows_per_query ({rows_per_query}) must not exceed height ({height})\"\n417\t        );\n418\t        let query_stride = height / rows_per_query;\n419\t        let mut query_digest_layer = DeviceBuffer::<D>::with_capacity(query_stride);\n420\t        // SAFETY: query_digest_layer properly allocated\n421\t        unsafe {\n422\t            MH::compress_rows_ext(\n423\t                &mut query_digest_layer,\n424\t                matrix.buffer(),\n425\t                matrix.width(),\n426\t                query_stride,\n427\t                k,\n428\t            )\n429\t            .map_err(MerkleTreeError::CompressingRowHashesExt)?;\n430\t        }\n431\t        // If not caching, drop the backing matrix at this point to save memory.\n432\t        let backing_matrix = cache_backing_matrix.then_some(matrix);\n433\t\n434\t        let mut digest_layers = vec![query_digest_layer];\n435\t        while digest_layers.last().unwrap().len() > 1 {\n436\t            let prev_layer = digest_layers.last().unwrap();\n437\t            let mut layer = DeviceBuffer::<D>::with_capacity(prev_layer.len() / 2);\n438\t            let layer_len = layer.len();\n439\t            let layer_idx = digest_layers.len();\n440\t            // SAFETY:\n441\t            // - `layer` is properly allocated with half the size of `prev_layer` and does not\n442\t            //   overlap with it.\n443\t            unsafe {\n444\t                MH::compress_layer(&mut layer, prev_layer, layer_len).map_err(|error| {\n445\t                    MerkleTreeError::AdjacentCompressLayer {\n446\t                        error,\n447\t                        layer: layer_idx,\n448\t                    }\n449\t                })?;\n450\t            }\n451\t            digest_layers.push(layer);\n452\t        }\n453\t        let d_root = digest_layers.last().unwrap();\n454\t        assert_eq!(d_root.len(), 1, \"Only one root is supported\");\n455\t        let root = d_root.to_host()?.pop().unwrap();\n456\t\n457\t        Ok(Self {\n458\t            backing_matrix,\n459\t            digest_layers,\n460\t            rows_per_query,\n461\t            root,\n462\t        })\n463\t    }\n464\t}\n465\t\n466\t// Extension field merkle tree — Poseidon2 default constructor\n467\timpl MerkleTreeGpu<EF, Digest> {\n468\t    /// Build a Merkle tree from an extension-field matrix using Poseidon2.\n469\t    ///\n470\t    /// NOTE: currently unused because we transpose `DeviceMatrix<EF>` to\n471\t    /// `DeviceMatrix<F>` beforehand in our use cases.\n472\t    pub fn new(\n473\t        matrix: DeviceMatrix<EF>,\n474\t        rows_per_query: usize,\n475\t        cache_backing_matrix: bool,\n476\t    ) -> Result<Self, MerkleTreeError> {\n477\t        Self::new_with_hash::<Poseidon2MerkleHash>(matrix, rows_per_query, cache_backing_matrix)\n478\t    }\n479\t}\n480\t"}]},"parent_tool_use_id":"toolu_016bBTyVj4tx4GM8Q49P8JHn","session_id":"50e92e47-0cd3-4f35-91c1-5f23da5f72d3","uuid":"435cc9f4-0bfc-4215-9c2c-7150b52368d5","timestamp":"2026-04-13T20:50:52.493Z"}
