DeviceBuffer<Digest>,\n54\t    matrix: &DeviceBuffer<F>,\n55\t    width: usize,\n56\t    query_stride: usize,\n57\t    log_rows_per_query: usize,\n58\t) -> Result<(), CudaError> {\n59\t    debug_assert!(matrix.len() >= width * (query_stride << log_rows_per_query));\n60\t    debug_assert!(out.len() >= query_stride);\n61\t    CudaError::from_result(_poseidon2_compressing_row_hashes(\n62\t        out.as_mut_ptr(),\n63\t        matrix.as_ptr(),\n64\t        width,\n65\t        query_stride,\n66\t        log_rows_per_query,\n67\t    ))\n68\t}\n69\t\n70\t/// Computes row hashes of `matrix` of dimensions `width` x `height` using Poseidon2 and then takes\n71\t/// merkle root of `2^log_rows_per_query` strided row hashes and writes the digests to `out`, where\n72\t/// `height = query_stride * 2^log_rows_per_query`. Memory layout expects `matrix` to be column\n73\t/// major in `EF`, and `out` is buffer of `Digest`. Digests are written in order of rows.\n74\t///\n75\t/// Note: `matrix` column major in `EF` means that `EF::D` base field elements are contiguous in\n76\t/// memory.\n77\t///\n78\t/// # Safety\n79\t/// - `out` must have length `>= query_stride` in `Digest` elements.\n80\t/// - `out` and `matrix` must be non-overlapping.\n81\tpub unsafe fn poseidon2_compressing_row_hashes_ext(\n82\t    out: &mut DeviceBuffer<Digest>,\n83\t    matrix: &DeviceBuffer<EF>,\n84\t    width: usize,\n85\t    query_stride: usize,\n86\t    log_rows_per_query: usize,\n87\t) -> Result<(), CudaError> {\n88\t    debug_assert!(matrix.len() >= width * (query_stride << log_rows_per_query));\n89\t    debug_assert!(out.len() >= query_stride);\n90\t    CudaError::from_result(_poseidon2_compressing_row_hashes_ext(\n91\t        out.as_mut_ptr(),\n92\t        matrix.as_ptr(),\n93\t        width,\n94\t        query_stride,\n95\t        log_rows_per_query,\n96\t    ))\n97\t}\n98\t\n99\t/// Writes a new digest layer of `output_size` elements of type `Digest` to `output` by apply\n100\t/// poseidon2 compress function to pairs of digest elements from `prev_layer`. The pairs to compress\n101\t/// are selected with a `stride` between them.\n102\t///\n103\t/// # Safety\n104\t/// - `output` must have length `>= output_size` in `Digest` elements.\n105\t/// - `prev_layer` must have length `>= output_size * 2` in `Digest` elements.\n106\t/// - `output` and `prev_layer` must be non-overlapping.\n107\t/// - `stride` must be a power of two and `stride <= output_size`.\n108\tpub unsafe fn poseidon2_strided_compress_layer(\n109\t    output: &mut DeviceBuffer<Digest>,\n110\t    prev_layer: &DeviceBuffer<Digest>,\n111\t    output_size: usize,\n112\t    stride: usize,\n113\t) -> Result<(), CudaError> {\n114\t    debug_assert!(stride > 0 && stride <= output_size);\n115\t    debug_assert!(output.len() >= output_size);\n116\t    debug_assert!(prev_layer.len() >= output_size * 2);\n117\t    CudaError::from_result(_poseidon2_strided_compress_layer(\n118\t        output.as_mut_ptr(),\n119\t        prev_layer.as_ptr(),\n120\t        output_size,\n121\t        stride,\n122\t    ))\n123\t}\n124\t\n125\t/// Writes a new digest layer of `output_size` elements of type `Digest` to `output` by apply\n126\t/// poseidon2 compress function to adjacent pairs of digest elements from `prev_layer`.\n127\t///\n128\t/// # Safety\n129\t/// - `output` must have length `>= output_size` in `Digest` elements.\n130\t/// - `prev_layer` must have length `>= output_size * 2` in `Digest` elements.\n131\t/// - `output` and `prev_layer` must be non-overlapping.\n132\tpub unsafe fn poseidon2_adjacent_compress_layer(\n133\t    output: &mut DeviceBuffer<Digest>,\n134\t    prev_layer: &DeviceBuffer<Digest>,\n135\t    output_size: usize,\n136\t) -> Result<(), CudaError> {\n137\t    debug_assert!(output.len() >= output_size);\n138\t    debug_assert!(prev_layer.len() >= output_size * 2);\n139\t    CudaError::from_result(_poseidon2_adjacent_compress_layer(\n140\t        output.as_mut_ptr(),\n141\t        prev_layer.as_ptr(),\n142\t        output_size,\n143\t    ))\n144\t}\n145\t\n146\tpub unsafe fn query_digest_layers(\n147\t    d_digest_matrix: &mut DeviceBuffer<F>,\n148\t    d_layers_ptr: &DeviceBuffer<u64>,\n149\t    d_indices: &DeviceBuffer<u64>,\n150\t    num_query: u64,\n151\t    num_layer: u64,\n152\t) -> Result<(), CudaError> {\n153\t    CudaError::from_result(_query_digest_layers(\n154\t        d_digest_matrix.as_mut_ptr(),\n155\t        d_layers_ptr.as_ptr(),\n156\t        d_indices.as_ptr(),\n157\t        num_query,\n158\t        num_layer,\n159\t    ))\n160\t}\n161\t"}]},"parent_tool_use_id":"toolu_016bBTyVj4tx4GM8Q49P8JHn","session_id":"50e92e47-0cd3-4f35-91c1-5f23da5f72d3","uuid":"693d8070-e593-488b-a72c-87d74a7444f4","timestamp":"2026-04-13T20:50:56.396Z"}
