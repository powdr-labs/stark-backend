2\t                1 << n_lift,\n793\t                height as u32,\n794\t                num_cosets_zc as u32,\n795\t                omega_root,\n796\t                max_temp_bytes,\n797\t            )?;\n798\t            if !sum_buffer.is_empty() {\n799\t                let q_evals = sum_buffer.to_host()?;\n800\t                let q = {\n801\t                    // Make q_evals row-major, with columns <> cosets\n802\t                    let mut values = EF::zero_vec(num_cosets_zc << l_skip);\n803\t                    for coset_idx in 0..num_cosets_zc {\n804\t                        for i in 0..1 << l_skip {\n805\t                            values[i * num_cosets_zc + coset_idx] =\n806\t                                q_evals[(coset_idx << l_skip) + i];\n807\t                        }\n808\t                    }\n809\t                    UnivariatePoly::from_geometric_cosets_evals_idft(\n810\t                        RowMajorMatrix::new(values, num_cosets_zc),\n811\t                        omega_root,\n812\t                        omega_root,\n813\t                    )\n814\t                };\n815\t                // sp_0 = (Z^{2^l_skip} - 1) * q\n816\t                let sp_0_deg = sumcheck_round0_deg(l_skip, local_constraint_deg);\n817\t                let coeffs = (0..=sp_0_deg)\n818\t                    .map(|i| {\n819\t                        let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n820\t                        if i >= 1 << l_skip {\n821\t                            c += q.coeffs()[i - (1 << l_skip)];\n822\t                        }\n823\t                        c\n824\t                    })\n825\t                    .collect_vec();\n826\t                debug_assert_eq!(\n827\t                    coeffs.iter().step_by(1 << l_skip).copied().sum::<EF>(),\n828\t                    EF::ZERO,\n829\t                    \"Zerocheck sum is not zero for air_id: {}\",\n830\t                    ctx.per_trace[trace_idx].0\n831\t                );\n832\