EF>, Round0EvalError> {\n45\t    let constraints_dag = &pk.vk.symbolic_constraints;\n46\t    if constraints_dag.constraints.constraint_idx.is_empty() || num_cosets == 0 {\n47\t        // No plain AIR constraints, return empty buffer\n48\t        return Ok(DeviceBuffer::new());\n49\t    }\n50\t\n51\t    let rules = &pk.other_data.zerocheck_round0;\n52\t\n53\t    let buffer_size: u32 = rules.inner.buffer_size;\n54\t    let intermed_capacity = unsafe {\n55\t        _zerocheck_r0_intermediates_buffer_size(\n56\t            buffer_size,\n57\t            skip_domain,\n58\t            num_x,\n59\t            num_cosets,\n60\t            max_temp_bytes,\n61\t        )\n62\t    };\n63\t    let mut intermediates = if intermed_capacity > 0 {\n64\t        debug!(\"zerocheck:intermediates_capacity={intermed_capacity}\");\n65\t        DeviceBuffer::<F>::with_capacity(intermed_capacity)\n66\t    } else {\n67\t        DeviceBuffer::<F>::new()\n68\t    };\n69\t\n70\t    let temp_sums_buffer_capacity = unsafe {\n71\t        _zerocheck_r0_temp_sums_buffer_size(\n72\t            buffer_size,\n73\t            skip_domain,\n74\t            num_x,\n75\t            num_cosets,\n76\t            max_temp_bytes,\n77\t        )\n78\t    };\n79\t    debug!(\"zerocheck:temp_sums_buffer_capacity={temp_sums_buffer_capacity}\");\n80\t    let mut temp_sums_buffer = DeviceBuffer::<EF>::with_capacity(temp_sums_buffer_capacity);\n81\t    let used_temp_bytes =\n82\t        intermed_capacity * size_of::<F>() + temp_sums_buffer_capacity * size_of::<EF>();\n83\t    if used_temp_bytes > max_temp_bytes {\n84\t        // We do not error if the required bytes is greater than the requested max, but this may\n85\t        // lead to unexpected peak memory usage.\n86\t        warn!(\"zerocheck used_temp_bytes ({used_temp_bytes}) > max_temp_bytes ({max_temp_bytes})\");\n87\t    }\n88\t\n89\t    let preprocessed_ptr = pk\n90\t        .preprocessed_data\n91\t        .as_ref()\n92\t        .map(|cd| cd.trace.buffer().