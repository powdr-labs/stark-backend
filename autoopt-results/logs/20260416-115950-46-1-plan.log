{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q3rZKfNavFYNvbpZhBwXiz","type":"tool_result","content":"1\tuse std::sync::Once;\n2\t\n3\tuse openvm_cuda_common::d_buffer::DeviceBuffer;\n4\t\n5\tuse crate::{cuda::ntt, prelude::F};\n6\t\n7\tconst MAX_LG_DOMAIN_SIZE: usize = 27;\n8\tconst LG_WINDOW_SIZE: usize = MAX_LG_DOMAIN_SIZE.div_ceil(5);\n9\tconst WINDOW_SIZE: usize = 1 << LG_WINDOW_SIZE;\n10\tconst WINDOW_NUM: usize = MAX_LG_DOMAIN_SIZE.div_ceil(LG_WINDOW_SIZE);\n11\t\n12\tstatic INIT_FORWARD: Once = Once::new();\n13\tstatic INIT_INVERSE: Once = Once::new();\n14\t\n15\tfn ensure_initialized(inverse: bool) {\n16\t    let once = if inverse {\n17\t        &INIT_INVERSE\n18\t    } else {\n19\t        &INIT_FORWARD\n20\t    };\n21\t\n22\t    once.call_once(|| {\n23\t        let partial_twiddles = DeviceBuffer::<[F; WINDOW_SIZE]>::with_capacity(WINDOW_NUM);\n24\t        let twiddles = DeviceBuffer::<F>::with_capacity(32 + 64 + 128 + 256 + 512);\n25\t        unsafe {\n26\t            ntt::generate_all_twiddles(&twiddles, inverse).unwrap();\n27\t            ntt::generate_partial_twiddles(&partial_twiddles, inverse).unwrap();\n28\t        }\n29\t    });\n30\t}\n31\t\n32\tstruct NttImpl<'a> {\n33\t    buffer: &'a DeviceBuffer<F>,\n34\t    lg_domain_size: u32,\n35\t    padded_poly_size: u32,\n36\t    poly_count: u32,\n37\t    is_intt: bool,\n38\t    stage: u32,\n39\t}\n40\t\n41\timpl<'a> NttImpl<'a> {\n42\t    fn new(\n43\t        buffer: &'a DeviceBuffer<F>,\n44\t        lg_domain_size: u32,\n45\t        padded_poly_size: u32,\n46\t        poly_count: u32,\n47\t        is_intt: bool,\n48\t    ) -> Self {\n49\t        ensure_initialized(is_intt);\n50\t        Self {\n51\t            buffer,\n52\t            lg_domain_size,\n53\t            padded_poly_size,\n54\t            poly_count,\n55\t            is_intt,\n56\t            stage: 0,\n57\t        }\n58\t    }\n59\t\n60\t    fn step(&mut self, iterations: u32) {\n61\t        assert!(iterations <= 10);\n62\t        let radix = if iterations < 6 { 6 } else { iterations };\n63\t        unsafe {\n64\t            ntt::ct_mixed_radix_narrow(\n65\t                self.buffer,\n66\t                radix,\n67\t                self.lg_domain_size,\n68\t                self.stage,\n69\t                iterations,\n70\t                self.padded_poly_size,\n71\t                self.poly_count,\n72\t                self.is_intt,\n73\t            )\n74\t            .unwrap();\n75\t        }\n76\t        self.stage += iterations;\n77\t    }\n78\t}\n79\t\n80\t/// Performs column-wise batch NTT on `buffer`, where `buffer` is assumed to be column-major with\n81\t/// columns of height `2^(log_trace_height + log_blowup)`. The NTT are performed on the first\n82\t/// `2^log_trace_height` elements of each column. If `bit_reverse` is true, then the input columns\n83\t/// are assumed to be ordered in **natural** ordering, and a bit-reversal permutation is applied for\n84\t/// the internal algorithm of the NTT. If `bit_reverse` is false, then the input columns are assumed\n85\t/// to be in bit-reverse ordering. If `is_intt` is true, the inverse NTT is performed; otherwise,\n86\t/// the forward NTT is performed.\n87\tpub fn batch_ntt(\n88\t    buffer: &DeviceBuffer<F>,\n89\t    log_trace_height: u32,\n90\t    log_blowup: u32,\n91\t    width: u32,\n92\t    bit_reverse: bool,\n93\t    is_intt: bool,\n94\t) {\n95\t    if log_trace_height == 0 {\n96\t        return;\n97\t    }\n98\t\n99\t    let padded_poly_size = 1 << (log_trace_height + log_blowup);\n100\t\n101\t    if bit_reverse {\n102\t        unsafe {\n103\t            ntt::bit_rev(buffer, buffer, log_trace_height, padded_poly_size, width).unwrap();\n104\t        }\n105\t    }\n106\t\n107\t    let mut _impl = NttImpl::new(buffer, log_trace_height, padded_poly_size, width, is_intt);\n108\t    if log_trace_height <= 10 {\n109\t        _impl.step(log_trace_height);\n110\t    } else if log_trace_height <= 17 {\n111\t        let step = log_trace_height / 2;\n112\t        _impl.step(step + log_trace_height % 2);\n113\t        _impl.step(step);\n114\t    } else if log_trace_height <= 30 {\n115\t        let step = log_trace_height / 3;\n116\t        let rem = log_trace_height % 3;\n117\t        _impl.step(step);\n118\t        _impl.step(step + (if log_trace_height == 29 { 1 } else { 0 }));\n119\t        _impl.step(step + (if log_trace_height == 29 { 1 } else { rem }));\n120\t    } else if log_trace_height <= 40 {\n121\t        let step = log_trace_height / 4;\n122\t        let rem = log_trace_height % 4;\n123\t        _impl.step(step);\n124\t        _impl.step(step + (if rem > 2 { 1 } else { 0 }));\n125\t        _impl.step(step + (if rem > 1 { 1 } else { 0 }));\n126\t        _impl.step(step + (if rem > 0 { 1 } else { 0 }));\n127\t    } else {\n128\t        panic!(\"log_trace_height > 40 not supported\");\n129\t    }\n130\t}\n131\t"}]},"parent_tool_use_id":"toolu_01J1PSSGwTrH8SjJVxPqzM2B","session_id":"b4e113b8-a396-45cc-8e86-654a475f0e59","uuid":"74245134-511b-43e3-b142-f809fc23af08","timestamp":"2026-04-16T13:26:07.197Z"}
