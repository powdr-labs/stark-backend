{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AjFEYVmjYxWQXEMW17zyYm","type":"tool_result","content":"1\tuse std::marker::PhantomData;\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::memory_manager::MemTracker;\n5\tuse openvm_stark_backend::{\n6\t    poly_common::Squarable,\n7\t    proof::*,\n8\t    prover::{\n9\t        DeviceMultiStarkProvingKey, MultiRapProver, OpeningProver, ProverBackend, ProverDevice,\n10\t        ProvingContext, TraceCommitter,\n11\t    },\n12\t};\n13\tuse tracing::instrument;\n14\t\n15\tuse crate::{\n16\t    base::DeviceMatrix,\n17\t    hash_scheme::{DefaultHashScheme, GpuHashScheme},\n18\t    logup_zerocheck::prove_zerocheck_and_logup_gpu,\n19\t    merkle_tree::{MerkleProofQueryDigest, MerkleTreeConstructor},\n20\t    prelude::{D_EF, EF, F},\n21\t    sponge::GpuFiatShamirTranscript,\n22\t    stacked_pcs::{stacked_commit, StackedPcsDataGpu},\n23\t    stacked_reduction::prove_stacked_opening_reduction_gpu,\n24\t    whir::prove_whir_opening_gpu,\n25\t    AirDataGpu, GpuDevice, ProverError,\n26\t};\n27\t\n28\t/// Generic GPU prover backend parameterised by a hash scheme `HS`.\n29\t///\n30\t/// Use the [`GpuBackend`] type alias to refer to the concrete BabyBear-Poseidon2\n31\t/// backend without spelling out the generic parameter.\n32\t#[derive(Clone, Copy)]\n33\tpub struct GenericGpuBackend<HS: GpuHashScheme>(PhantomData<HS>);\n34\t\n35\timpl<HS: GpuHashScheme> Default for GenericGpuBackend<HS> {\n36\t    fn default() -> Self {\n37\t        Self(PhantomData)\n38\t    }\n39\t}\n40\t\n41\t/// Concrete GPU backend using the default BabyBear-Poseidon2 hash scheme.\n42\tpub type GpuBackend = GenericGpuBackend<DefaultHashScheme>;\n43\t\n44\timpl<HS: GpuHashScheme> ProverBackend for GenericGpuBackend<HS> {\n45\t    const CHALLENGE_EXT_DEGREE: u8 = D_EF as u8;\n46\t\n47\t    type Val = F;\n48\t    type Challenge = EF;\n49\t    type Commitment = HS::Digest;\n50\t    type Matrix = DeviceMatrix<F>;\n51\t    type PcsData = StackedPcsDataGpu<F, HS::Digest>;\n52\t    type OtherAirData = AirDataGpu;\n53\t}\n54\t\n55\timpl<HS: GpuHashScheme> TraceCommitter<GenericGpuBackend<HS>> for GpuDevice\n56\twhere\n57\t    HS::MerkleHash: MerkleTreeConstructor,\n58\t{\n59\t    type Error = ProverError;\n60\t\n61\t    fn commit(\n62\t        &self,\n63\t        traces: &[&DeviceMatrix<F>],\n64\t    ) -> Result<(HS::Digest, StackedPcsDataGpu<F, HS::Digest>), Self::Error> {\n65\t        stacked_commit::<HS::MerkleHash>(\n66\t            self.config.l_skip,\n67\t            self.config.n_stack,\n68\t            self.config.log_blowup,\n69\t            self.config.k_whir(),\n70\t            traces,\n71\t            self.prover_config,\n72\t        )\n73\t    }\n74\t}\n75\t\n76\timpl<HS: GpuHashScheme, TS: GpuFiatShamirTranscript<HS::SC>> ProverDevice<GenericGpuBackend<HS>, TS>\n77\t    for GpuDevice\n78\twhere\n79\t    HS::MerkleHash: MerkleTreeConstructor,\n80\t    HS::Digest: MerkleProofQueryDigest,\n81\t{\n82\t    type Error = ProverError;\n83\t}\n84\t\n85\timpl<HS: GpuHashScheme, TS: GpuFiatShamirTranscript<HS::SC>>\n86\t    MultiRapProver<GenericGpuBackend<HS>, TS> for GpuDevice\n87\t{\n88\t    type PartialProof = (GkrProof<HS::SC>, BatchConstraintProof<HS::SC>);\n89\t    /// The random opening point `r` where the batch constraint sumcheck reduces to evaluation\n90\t    /// claims of trace matrices `T, T_{rot}` at `r_{n_T}`.\n91\t    type Artifacts = Vec<EF>;\n92\t    type Error = ProverError;\n93\t\n94\t    #[allow(clippy::type_complexity)]\n95\t    #[instrument(name = \"prover.rap_constraints\", skip_all, fields(phase = \"prover\"))]\n96\t    fn prove_rap_constraints(\n97\t        &self,\n98\t        transcript: &mut TS,\n99\t        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n100\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n101\t        _common_main_pcs_data: &StackedPcsDataGpu<F, HS::Digest>,\n102\t    ) -> Result<((GkrProof<HS::SC>, BatchConstraintProof<HS::SC>), Vec<EF>), Self::Error> {\n103\t        let mem = MemTracker::start_and_reset_peak(\"prover.rap_constraints\");\n104\t        let save_memory = self.prover_config.zerocheck_save_memory;\n105\t        // Threshold for monomial evaluation path based on proof type:\n106\t        // - App proofs (log_blowup=1): higher threshold (512)\n107\t        // - Recursion proofs: lower threshold (64)\n108\t        let monomial_num_y_threshold = if self.config.log_blowup == 1 { 512 } else { 64 };\n109\t        let (gkr_proof, batch_constraint_proof, r) = prove_zerocheck_and_logup_gpu::<HS, TS>(\n110\t            transcript,\n111\t            mpk,\n112\t            ctx,\n113\t            save_memory,\n114\t            monomial_num_y_threshold,\n115\t            self.sm_count,\n116\t        )?;\n117\t        mem.emit_metrics();\n118\t        Ok(((gkr_proof, batch_constraint_proof), r))\n119\t    }\n120\t}\n121\t\n122\timpl<HS: GpuHashScheme, TS: GpuFiatShamirTranscript<HS::SC>>\n123\t    OpeningProver<GenericGpuBackend<HS>, TS> for GpuDevice\n124\twhere\n125\t    HS::MerkleHash: MerkleTreeConstructor,\n126\t    HS::Digest: MerkleProofQueryDigest,\n127\t{\n128\t    type OpeningProof = (StackingProof<HS::SC>, WhirProof<HS::SC>);\n129\t    /// The shared vector `r` where each trace matrix `T, T_{rot}` is opened at `r_{n_T}`.\n130\t    type OpeningPoints = Vec<EF>;\n131\t    type Error = ProverError;\n132\t\n133\t    #[instrument(name = \"prover.openings\", skip_all, fields(phase = \"prover\"))]\n134\t    fn prove_openings(\n135\t        &self,\n136\t        transcript: &mut TS,\n137\t        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n138\t        ctx: ProvingContext<GenericGpuBackend<HS>>,\n139\t        common_main_pcs_data: StackedPcsDataGpu<F, HS::Digest>,\n140\t        r: Vec<EF>,\n141\t    ) -> Result<Self::OpeningProof, Self::Error> {\n142\t        let mut mem = MemTracker::start_and_reset_peak(\"prover.openings\");\n143\t        let params = self.config();\n144\t        #[cfg(debug_assertions)]\n145\t        {\n146\t            let total_stacked_width: usize = std::iter::once(common_main_pcs_data.layout().width())\n147\t                .chain(ctx.per_trace.iter().flat_map(|(air_idx, air_ctx)| {\n148\t                    mpk.per_air[*air_idx]\n149\t                        .preprocessed_data\n150\t                        .iter()\n151\t                        .map(|committed| committed.data.layout().width())\n152\t                        .chain(\n153\t                            air_ctx\n154\t                                .cached_mains\n155\t                                .iter()\n156\t                                .map(|committed| committed.data.layout().width()),\n157\t                        )\n158\t                }))\n159\t                .sum();\n160\t            debug_assert!(\n161\t                total_stacked_width <= mpk.params.w_stack,\n162\t                \"total stacked width across commits ({total_stacked_width}) exceeds w_stack ({})\",\n163\t                mpk.params.w_stack\n164\t            );\n165\t        }\n166\t        let (stacking_proof, u_prisma, stacked_per_commit) =\n167\t            prove_stacked_opening_reduction_gpu::<HS, TS>(\n168\t                self,\n169\t                transcript,\n170\t                mpk,\n171\t                ctx,\n172\t                common_main_pcs_data,\n173\t                &r,\n174\t            )?;\n175\t\n176\t        let (&u0, u_rest) = u_prisma.split_first().unwrap();\n177\t        let u_cube = u0\n178\t            .exp_powers_of_2()\n179\t            .take(params.l_skip)\n180\t            .chain(u_rest.iter().copied())\n181\t            .collect_vec();\n182\t\n183\t        let whir_proof =\n184\t            prove_whir_opening_gpu::<HS, TS>(params, transcript, stacked_per_commit, &u_cube)?;\n185\t        mem.emit_metrics();\n186\t        mem.reset_peak();\n187\t        Ok((stacking_proof, whir_proof))\n188\t    }\n189\t}\n190\t"}]},"parent_tool_use_id":null,"session_id":"b4e113b8-a396-45cc-8e86-654a475f0e59","uuid":"a63abeca-81e2-4475-9793-73ad7c654256","timestamp":"2026-04-16T10:08:57.460Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/gpu_backend.rs","content":"use std::marker::PhantomData;\n\nuse itertools::Itertools;\nuse openvm_cuda_common::memory_manager::MemTracker;\nuse openvm_stark_backend::{\n    poly_common::Squarable,\n    proof::*,\n    prover::{\n        DeviceMultiStarkProvingKey, MultiRapProver, OpeningProver, ProverBackend, ProverDevice,\n        ProvingContext, TraceCommitter,\n    },\n};\nuse tracing::instrument;\n\nuse crate::{\n    base::DeviceMatrix,\n    hash_scheme::{DefaultHashScheme, GpuHashScheme},\n    logup_zerocheck::prove_zerocheck_and_logup_gpu,\n    merkle_tree::{MerkleProofQueryDigest, MerkleTreeConstructor},\n    prelude::{D_EF, EF, F},\n    sponge::GpuFiatShamirTranscript,\n    stacked_pcs::{stacked_commit, StackedPcsDataGpu},\n    stacked_reduction::prove_stacked_opening_reduction_gpu,\n    whir::prove_whir_opening_gpu,\n    AirDataGpu, GpuDevice, ProverError,\n};\n\n/// Generic GPU prover backend parameterised by a hash scheme `HS`.\n///\n/// Use the [`GpuBackend`] type alias to refer to the concrete BabyBear-Poseidon2\n/// backend without spelling out the generic parameter.\n#[derive(Clone, Copy)]\npub struct GenericGpuBackend<HS: GpuHashScheme>(PhantomData<HS>);\n\nimpl<HS: GpuHashScheme> Default for GenericGpuBackend<HS> {\n    fn default() -> Self {\n        Self(PhantomData)\n    }\n}\n\n/// Concrete GPU backend using the default BabyBear-Poseidon2 hash scheme.\npub type GpuBackend = GenericGpuBackend<DefaultHashScheme>;\n\nimpl<HS: GpuHashScheme> ProverBackend for GenericGpuBackend<HS> {\n    const CHALLENGE_EXT_DEGREE: u8 = D_EF as u8;\n\n    type Val = F;\n    type Challenge = EF;\n    type Commitment = HS::Digest;\n    type Matrix = DeviceMatrix<F>;\n    type PcsData = StackedPcsDataGpu<F, HS::Digest>;\n    type OtherAirData = AirDataGpu;\n}\n\nimpl<HS: GpuHashScheme> TraceCommitter<GenericGpuBackend<HS>> for GpuDevice\nwhere\n    HS::MerkleHash: MerkleTreeConstructor,\n{\n    type Error = ProverError;\n\n    fn commit(\n        &self,\n        traces: &[&DeviceMatrix<F>],\n    ) -> Result<(HS::Digest, StackedPcsDataGpu<F, HS::Digest>), Self::Error> {\n        stacked_commit::<HS::MerkleHash>(\n            self.config.l_skip,\n            self.config.n_stack,\n            self.config.log_blowup,\n            self.config.k_whir(),\n            traces,\n            self.prover_config,\n        )\n    }\n}\n\nimpl<HS: GpuHashScheme, TS: GpuFiatShamirTranscript<HS::SC>> ProverDevice<GenericGpuBackend<HS>, TS>\n    for GpuDevice\nwhere\n    HS::MerkleHash: MerkleTreeConstructor,\n    HS::Digest: MerkleProofQueryDigest,\n{\n    type Error = ProverError;\n}\n\nimpl<HS: GpuHashScheme, TS: GpuFiatShamirTranscript<HS::SC>>\n    MultiRapProver<GenericGpuBackend<HS>, TS> for GpuDevice\n{\n    type PartialProof = (GkrProof<HS::SC>, BatchConstraintProof<HS::SC>);\n    /// The random opening point `r` where the batch constraint sumcheck reduces to evaluation\n    /// claims of trace matrices `T, T_{rot}` at `r_{n_T}`.\n    type Artifacts = Vec<EF>;\n    type Error = ProverError;\n\n    #[allow(clippy::type_complexity)]\n    #[instrument(name = \"prover.rap_constraints\", skip_all, fields(phase = \"prover\"))]\n    fn prove_rap_constraints(\n        &self,\n        transcript: &mut TS,\n        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n        _common_main_pcs_data: &StackedPcsDataGpu<F, HS::Digest>,\n    ) -> Result<((GkrProof<HS::SC>, BatchConstraintProof<HS::SC>), Vec<EF>), Self::Error> {\n        let mem = MemTracker::start_and_reset_peak(\"prover.rap_constraints\");\n        let save_memory = self.prover_config.zerocheck_save_memory;\n        // Threshold for monomial evaluation path based on proof type:\n        // - App proofs (log_blowup=1): higher threshold (512)\n        // - Recursion proofs: lower threshold (64)\n        let monomial_num_y_threshold = if self.config.log_blowup == 1 { 512 } else { 64 };\n        let (gkr_proof, batch_constraint_proof, r) = prove_zerocheck_and_logup_gpu::<HS, TS>(\n            transcript,\n            mpk,\n            ctx,\n            save_memory,\n            monomial_num_y_threshold,\n            self.sm_count,\n        )?;\n        mem.emit_metrics();\n        Ok(((gkr_proof, batch_constraint_proof), r))\n    }\n}\n\nimpl<HS: GpuHashScheme, TS: GpuFiatShamirTranscript<HS::SC>>\n    OpeningProver<GenericGpuBackend<HS>, TS> for GpuDevice\nwhere\n    HS::MerkleHash: MerkleTreeConstructor,\n    HS::Digest: MerkleProofQueryDigest,\n{\n    type OpeningProof = (StackingProof<HS::SC>, WhirProof<HS::SC>);\n    /// The shared vector `r` where each trace matrix `T, T_{rot}` is opened at `r_{n_T}`.\n    type OpeningPoints = Vec<EF>;\n    type Error = ProverError;\n\n    #[instrument(name = \"prover.openings\", skip_all, fields(phase = \"prover\"))]\n    fn prove_openings(\n        &self,\n        transcript: &mut TS,\n        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n        ctx: ProvingContext<GenericGpuBackend<HS>>,\n        common_main_pcs_data: StackedPcsDataGpu<F, HS::Digest>,\n        r: Vec<EF>,\n    ) -> Result<Self::OpeningProof, Self::Error> {\n        let mut mem = MemTracker::start_and_reset_peak(\"prover.openings\");\n        let params = self.config();\n        #[cfg(debug_assertions)]\n        {\n            let total_stacked_width: usize = std::iter::once(common_main_pcs_data.layout().width())\n                .chain(ctx.per_trace.iter().flat_map(|(air_idx, air_ctx)| {\n                    mpk.per_air[*air_idx]\n                        .preprocessed_data\n                        .iter()\n                        .map(|committed| committed.data.layout().width())\n                        .chain(\n                            air_ctx\n                                .cached_mains\n                                .iter()\n                                .map(|committed| committed.data.layout().width()),\n                        )\n                }))\n                .sum();\n            debug_assert!(\n                total_stacked_width <= mpk.params.w_stack,\n                \"total stacked width across commits ({total_stacked_width}) exceeds w_stack ({})\",\n                mpk.params.w_stack\n            );\n        }\n        let (stacking_proof, u_prisma, stacked_per_commit) =\n            prove_stacked_opening_reduction_gpu::<HS, TS>(\n                self,\n                transcript,\n                mpk,\n                ctx,\n                common_main_pcs_data,\n                &r,\n            )?;\n\n        let (&u0, u_rest) = u_prisma.split_first().unwrap();\n        let u_cube = u0\n            .exp_powers_of_2()\n            .take(params.l_skip)\n            .chain(u_rest.iter().copied())\n            .collect_vec();\n\n        let whir_proof =\n            prove_whir_opening_gpu::<HS, TS>(params, transcript, stacked_per_commit, &u_cube)?;\n        mem.emit_metrics();\n        mem.reset_peak();\n        Ok((stacking_proof, whir_proof))\n    }\n}\n","numLines":190,"startLine":1,"totalLines":190}}}
