{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BBooeXPnDRpJbcYUbPZ8wV","type":"tool_result","content":"1\tuse std::cmp::max;\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::{\n5\t    copy::MemCopyH2D,\n6\t    d_buffer::DeviceBuffer,\n7\t    stream::current_stream_sync,\n8\t};\n9\tuse openvm_stark_backend::prover::{\n10\t    fractional_sumcheck_gkr::Frac,\n11\t    stacked_pcs::{StackedLayout, StackedSlice},\n12\t    DeviceMultiStarkProvingKey, MatrixDimensions, ProvingContext,\n13\t};\n14\tuse p3_field::{Field, PrimeCharacteristicRing};\n15\tuse tracing::instrument;\n16\t\n17\tuse super::errors::InteractionGpuError;\n18\tuse crate::{\n19\t    cuda::logup_zerocheck::{\n20\t        batched_gkr_input_eval_scatter, frac_matrix_vertically_repeat,\n21\t        frac_vector_scalar_multiply_ext_fp, logup_gkr_input_eval, BlockCtx,\n22\t        GkrInputScatterCtx,\n23\t    },\n24\t    gpu_backend::GenericGpuBackend,\n25\t    hash_scheme::GpuHashScheme,\n26\t    prelude::{EF, F},\n27\t};\n28\t\n29\tconst TASK_SIZE: u32 = 65536;\n30\t\n31\t/// Number of OS threads (and thus CUDA streams) for parallel GKR input evaluation.\n32\tconst NUM_GKR_INPUT_STREAMS: usize = 8;\n33\t\n34\tstruct SendPtr<T>(*mut T);\n35\tunsafe impl<T> Send for SendPtr<T> {}\n36\tunsafe impl<T> Sync for SendPtr<T> {}\n37\t\n38\tstruct GkrThreadBuffers {\n39\t    intermediates: DeviceBuffer<EF>,\n40\t    public_values: DeviceBuffer<F>,\n41\t    partition_ptrs: DeviceBuffer<u64>,\n42\t    tmp: DeviceBuffer<Frac<EF>>,\n43\t}\n44\t\n45\tstruct GkrInputWorkItem<'a, HS: GpuHashScheme> {\n46\t    air_ctx: &'a openvm_stark_backend::prover::AirProvingContext<GenericGpuBackend<HS>>,\n47\t    pk_air: &'a openvm_stark_backend::prover::DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n48\t    l_skip: usize,\n49\t    d_challenges: &'a DeviceBuffer<EF>,\n50\t    leaves_ptr: SendPtr<Frac<EF>>,\n51\t}\n52\t\n53\t#[allow(dead_code)]\n54\t#[derive(Clone)]\n55\tpub struct TraceInteractionMeta {\n56\t    pub trace_idx: usize,\n57\t    pub air_idx: usize,\n58\t    pub layout_slices: Vec<StackedSlice>,\n59\t}\n60\t\n61\t// TODO[jpw]: revisit if this function is needed\n62\tpub fn collect_trace_interactions<HS: GpuHashScheme>(\n63\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n64\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n65\t    layout: &StackedLayout,\n66\t) -> Vec<Option<TraceInteractionMeta>> {\n67\t    // Pre-group layout slices by trace to avoid repeated scans later.\n68\t    let mut slices_by_trace: Vec<Vec<(usize, StackedSlice)>> =\n69\t        vec![Vec::new(); ctx.per_trace.len()];\n70\t    for &(trace_idx, interaction_idx, ref slice) in &layout.sorted_cols {\n71\t        if let Some(entries) = slices_by_trace.get_mut(trace_idx) {\n72\t            entries.push((interaction_idx, *slice));\n73\t        }\n74\t    }\n75\t\n76\t    ctx.per_trace\n77\t        .iter()\n78\t        .enumerate()\n79\t        .map(|(trace_idx, (air_idx, _))| {\n80\t            let vk = &pk.per_air[*air_idx].vk;\n81\t            if !vk.has_interaction() {\n82\t                return None;\n83\t            }\n84\t\n85\t            let mut layout_entries = vec![None; vk.num_interactions()];\n86\t            for (interaction_idx, slice) in &slices_by_trace[trace_idx] {\n87\t                if let Some(slot) = layout_entries.get_mut(*interaction_idx) {\n88\t                    *slot = Some(*slice);\n89\t                }\n90\t            }\n91\t\n92\t            let layout_slices = layout_entries\n93\t                .into_iter()\n94\t                .enumerate()\n95\t                .map(|(idx, maybe_slice)| {\n96\t                    maybe_slice.unwrap_or_else(|| {\n97\t                        panic!(\n98\t                            \"missing stacked slice for interaction {} of trace {}\",\n99\t                            idx, trace_idx\n100\t                        )\n101\t                    })\n102\t                })\n103\t                .collect_vec();\n104\t\n105\t            Some(TraceInteractionMeta {\n106\t                trace_idx,\n107\t                air_idx: *air_idx,\n108\t                layout_slices,\n109\t            })\n110\t        })\n111\t        .collect()\n112\t}\n113\t\n114\tfn process_gkr_input_air<HS: GpuHashScheme>(\n115\t    w: &GkrInputWorkItem<HS>,\n116\t    buffers: &mut GkrThreadBuffers,\n117\t) -> Result<(), InteractionGpuError> {\n118\t    let null_preprocessed = DeviceBuffer::<F>::new();\n119\t    let air_ctx = w.air_ctx;\n120\t    let pk_air = w.pk_air;\n121\t\n122\t    let preprocessed_matrix = pk_air\n123\t        .preprocessed_data\n124\t        .as_ref()\n125\t        .map(|committed| &committed.trace);\n126\t\n127\t    let mut partitioned_main = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n128\t    for committed in &air_ctx.cached_mains {\n129\t        partitioned_main.push(&committed.trace);\n130\t    }\n131\t    partitioned_main.push(&air_ctx.common_main);\n132\t\n133\t    let rules = &pk_air.other_data.interaction_rules;\n134\t    let num_interactions = pk_air.vk.symbolic_constraints.interactions.len();\n135\t\n136\t    let d_preprocessed = preprocessed_matrix\n137\t        .as_ref()\n138\t        .map(|m| m.buffer())\n139\t        .unwrap_or(&null_preprocessed);\n140\t\n141\t    let null_pv = DeviceBuffer::<F>::new();\n142\t    let has_public_values = !air_ctx.public_values.is_empty();\n143\t    if has_public_values {\n144\t        air_ctx.public_values.copy_to(&mut buffers.public_values)?;\n145\t    }\n146\t    let d_public_values = if has_public_values {\n147\t        &buffers.public_values\n148\t    } else {\n149\t        &null_pv\n150\t    };\n151\t\n152\t    let height = air_ctx.height();\n153\t    debug_assert_eq!(height, partitioned_main[0].height());\n154\t    let partition_ptrs = partitioned_main\n155\t        .iter()\n156\t        .map(|m| m.buffer().as_ptr() as u64)\n157\t        .collect_vec();\n158\t    partition_ptrs.copy_to(&mut buffers.partition_ptrs)?;\n159\t\n160\t    let buffer_size = rules.inner.buffer_size;\n161\t    // TODO[jpw]: remove magic 10\n162\t    let is_global = buffer_size > 10;\n163\t\n164\t    let num_rows_per_tile = height.div_ceil(TASK_SIZE as usize).max(1);\n165\t\n166\t    let leaves_ptr = w.leaves_ptr.0;\n167\t    let l_skip = w.l_skip;\n168\t    let lifted_height = max(height, 1 << l_skip);\n169\t\n170\t    let trace_output = if height != lifted_height {\n171\t        buffers.tmp.as_mut_ptr()\n172\t    } else {\n173\t        leaves_ptr\n174\t    };\n175\t    unsafe {\n176\t        logup_gkr_input_eval(\n177\t            is_global,\n178\t            trace_output,\n179\t            d_preprocessed,\n180\t            &buffers.partition_ptrs,\n181\t            d_public_values,\n182\t            w.d_challenges,\n183\t            &buffers.intermediates,\n184\t            &rules.inner.d_rules,\n185\t            &rules.inner.d_used_nodes,\n186\t            &rules.d_pair_idxs,\n187\t            height as u32,\n188\t            num_rows_per_tile as u32,\n189\t        )?;\n190\t    }\n191\t    if height != lifted_height {\n192\t        debug_assert_eq!(lifted_height % height, 0);\n193\t        debug_assert!(!buffers.tmp.is_empty());\n194\t        let norm_factor_denom = lifted_height / height;\n195\t        let norm_factor = F::from_usize(norm_factor_denom).inverse();\n196\t        unsafe {\n197\t            frac_vector_scalar_multiply_ext_fp(\n198\t                buffers.tmp.as_mut_ptr(),\n199\t                norm_factor,\n200\t                (height * num_interactions) as u32,\n201\t            )?;\n202\t            frac_matrix_vertically_repeat(\n203\t                leaves_ptr,\n204\t                buffers.tmp.as_ptr(),\n205\t                num_interactions as u32,\n206\t                lifted_height as u32,\n207\t                height as u32,\n208\t            )?;\n209\t        }\n210\t    }\n211\t    Ok(())\n212\t}\n213\t\n214\t/// Evaluate interactions from trace evaluation matrices to get (p, q) fractional sumcheck input.\n215\t/// Returns leaves buffer (WITHOUT alpha applied) and alpha value to be applied in first tree layer.\n216\t#[instrument(name = \"prover.rap_constraints.logup_gkr.input_evals\", skip_all)]\n217\tpub fn log_gkr_input_evals<HS: GpuHashScheme>(\n218\t    trace_interactions: &[Option<TraceInteractionMeta>],\n219\t    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n220\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n221\t    l_skip: usize,\n222\t    alpha_logup: EF,\n223\t    d_challenges: &DeviceBuffer<EF>,\n224\t    total_leaves: usize,\n225\t) -> Result<(DeviceBuffer<Frac<EF>>, EF), InteractionGpuError> {\n226\t    if trace_interactions.iter().all(|meta| meta.is_none()) {\n227\t        return Ok((DeviceBuffer::new(), alpha_logup));\n228\t    }\n229\t\n230\t    let leaves = DeviceBuffer::<Frac<EF>>::with_capacity(total_leaves);\n231\t    leaves.fill_zero()?;\n232\t\n233\t    // Phase 1: Build work items and sort by descending height for load balance.\n234\t    let mut work_items: Vec<GkrInputWorkItem<HS>> = trace_interactions\n235\t        .iter()\n236\t        .flatten()\n237\t        .map(|meta| {\n238\t            let air_ctx = &ctx.per_trace[meta.trace_idx].1;\n239\t            let pk_air = &pk.per_air[meta.air_idx];\n240\t            let slice = meta.layout_slices.first().unwrap();\n241\t            assert_eq!(slice.col_idx, 0);\n242\t            let dst_offset = slice.row_idx;\n243\t            let leaves_ptr = unsafe { leaves.as_mut_ptr().add(dst_offset) };\n244\t            GkrInputWorkItem {\n245\t                air_ctx,\n246\t                pk_air,\n247\t                l_skip,\n248\t                d_challenges,\n249\t                leaves_ptr: SendPtr(leaves_ptr),\n250\t            }\n251\t        })\n252\t        .collect();\n253\t\n254\t    work_items.sort_by(|a, b| b.air_ctx.height().cmp(&a.air_ctx.height()));\n255\t\n256\t    // Partition into SCATTER (buffer_size <= 10) and GLOBAL (buffer_size > 10) indices.\n257\t    let mut scatter_indices: Vec<usize> = Vec::new();\n258\t    let mut global_indices: Vec<usize> = Vec::new();\n259\t    for (i, w) in work_items.iter().enumerate() {\n260\t        if w.pk_air.other_data.interaction_rules.inner.buffer_size > 10 {\n261\t            global_indices.push(i);\n262\t        } else {\n263\t            scatter_indices.push(i);\n264\t        }\n265\t    }\n266\t\n267\t    // Pre-compute max buffer sizes across all work items (needed for single-threaded fallback).\n268\t    let mut max_intermediates_len: usize = 1;\n269\t    let mut max_public_values_len: usize = 0;\n270\t    let mut max_partition_ptrs_len: usize = 0;\n271\t    let mut max_tmp_len: usize = 0;\n272\t\n273\t    for w in &work_items {\n274\t        let rules = &w.pk_air.other_data.interaction_rules;\n275\t        let buffer_size = rules.inner.buffer_size as usize;\n276\t        let is_global = buffer_size > 10;\n277\t        if is_global {\n278\t            max_intermediates_len = max_intermediates_len.max(TASK_SIZE as usize * buffer_size);\n279\t        }\n280\t\n281\t        max_public_values_len = max_public_values_len.max(w.air_ctx.public_values.len());\n282\t\n283\t        let num_partitions = w.air_ctx.cached_mains.len() + 1;\n284\t        max_partition_ptrs_len = max_partition_ptrs_len.max(num_partitions);\n285\t\n286\t        let height = w.air_ctx.height();\n287\t        let lifted_height = height.max(1 << w.l_skip);\n288\t        if height != lifted_height {\n289\t            let num_interactions = w.pk_air.vk.symbolic_constraints.interactions.len();\n290\t            max_tmp_len = max_tmp_len.max(height * num_interactions);\n291\t        }\n292\t    }\n293\t\n294\t    // Compute max scatter tmp for lifted SCATTER AIRs.\n295\t    let max_scatter_tmp = scatter_indices\n296\t        .iter()\n297\t        .filter_map(|&idx| {\n298\t            let w = &work_items[idx];\n299\t            let height = w.air_ctx.height();\n300\t            let lifted = max(height, 1 << w.l_skip);\n301\t            if height != lifted {\n302\t                let n_int = w.pk_air.vk.symbolic_constraints.interactions.len();\n303\t                Some(height * n_int)\n304\t            } else {\n305\t                None\n306\t            }\n307\t        })\n308\t        .max()\n309\t        .unwrap_or(0);\n310\t\n311\t    // Barrier: ensure fill_zero() and all prior GPU work is visible to worker thread streams.\n312\t    current_stream_sync().map_err(InteractionGpuError::from)?;\n313\t\n314\t    if work_items.len() < 100 {\n315\t        // Single-threaded path: process ALL AIRs (unchanged for APC 0 fallback).\n316\t        let mut bufs = GkrThreadBuffers {\n317\t            intermediates: DeviceBuffer::with_capacity(max_intermediates_len),\n318\t            public_values: if max_public_values_len > 0 {\n319\t                DeviceBuffer::with_capacity(max_public_values_len)\n320\t            } else {\n321\t                DeviceBuffer::new()\n322\t            },\n323\t            partition_ptrs: DeviceBuffer::with_capacity(max_partition_ptrs_len),\n324\t            tmp: if max_tmp_len > 0 {\n325\t                DeviceBuffer::with_capacity(max_tmp_len)\n326\t            } else {\n327\t                DeviceBuffer::new()\n328\t            },\n329\t        };\n330\t        for w in &work_items {\n331\t            process_gkr_input_air(w, &mut bufs)?;\n332\t        }\n333\t    } else {\n334\t        // Multi-threaded path with SCATTER batching.\n335\t        let mut num_global_threads = NUM_GKR_INPUT_STREAMS.min(global_indices.len().max(1));\n336\t\n337\t        // Memory budget check: reduce thread count if pre-allocation would exceed 2 GB.\n338\t        let per_thread_bytes = max_intermediates_len * std::mem::size_of::<EF>()\n339\t            + max_public_values_len * std::mem::size_of::<F>()\n340\t            + max_partition_ptrs_len * std::mem::size_of::<u64>()\n341\t            + max_tmp_len * std::mem::size_of::<Frac<EF>>();\n342\t        while num_global_threads > 1 && num_global_threads * per_thread_bytes > 2_000_000_000 {\n343\t            num_global_threads /= 2;\n344\t            tracing::warn!(\n345\t                \"Reducing GKR input eval thread count to {} due to memory budget ({}MB per thread)\",\n346\t                num_global_threads,\n347\t                per_thread_bytes / (1024 * 1024)\n348\t            );\n349\t        }\n350\t\n351\t        // Pre-allocate per-thread buffer pools for GLOBAL workers.\n352\t        let thread_buffers: Vec<GkrThreadBuffers> = (0..num_global_threads)\n353\t            .map(|_| GkrThreadBuffers {\n354\t                intermediates: DeviceBuffer::with_capacity(max_intermediates_len),\n355\t                public_values: if max_public_values_len > 0 {\n356\t                    DeviceBuffer::with_capacity(max_public_values_len)\n357\t                } else {\n358\t                    DeviceBuffer::new()\n359\t                },\n360\t                partition_ptrs: DeviceBuffer::with_capacity(max_partition_ptrs_len),\n361\t                tmp: if max_tmp_len > 0 {\n362\t                    DeviceBuffer::with_capacity(max_tmp_len)\n363\t                } else {\n364\t                    DeviceBuffer::new()\n365\t                },\n366\t            })\n367\t            .collect();\n368\t\n369\t        // Allocate scatter tmp buffer for lifted SCATTER AIRs.\n370\t        let d_scatter_tmp = if max_scatter_tmp > 0 {\n371\t            DeviceBuffer::<Frac<EF>>::with_capacity(max_scatter_tmp)\n372\t        } else {\n373\t            DeviceBuffer::<Frac<EF>>::new()\n374\t        };\n375\t\n376\t        std::thread::scope(|s| {\n377\t            // Spawn background thread for batched SCATTER processing.\n378\t            let scatter_handle = if !scatter_indices.is_empty() {\n379\t                Some(s.spawn(|| -> Result<(), InteractionGpuError> {\n380\t                    // Step 1: Concatenate host arrays for partition pointers and\n381\t                    // public values.\n382\t                    let mut all_partition_ptrs: Vec<u64> = Vec::new();\n383\t                    let mut all_public_values: Vec<F> = Vec::new();\n384\t                    let mut scatter_partition_offsets: Vec<usize> = Vec::new();\n385\t                    let mut scatter_pv_offsets: Vec<usize> = Vec::new();\n386\t\n387\t                    for &work_idx in &scatter_indices {\n388\t                        let w = &work_items[work_idx];\n389\t                        let air_ctx = w.air_ctx;\n390\t\n391\t                        scatter_partition_offsets.push(all_partition_ptrs.len());\n392\t                        for committed in &air_ctx.cached_mains {\n393\t                            all_partition_ptrs\n394\t                                .push(committed.trace.buffer().as_ptr() as u64);\n395\t                        }\n396\t                        all_partition_ptrs\n397\t                            .push(air_ctx.common_main.buffer().as_ptr() as u64);\n398\t\n399\t                        scatter_pv_offsets.push(all_public_values.len());\n400\t                        all_public_values.extend_from_slice(&air_ctx.public_values);\n401\t                    }\n402\t\n403\t                    // 2 bulk H2D uploads (on this thread's per-thread CUDA stream).\n404\t                    let d_all_partition_ptrs = all_partition_ptrs.to_device()?;\n405\t                    let d_all_public_values = if all_public_values.is_empty() {\n406\t                        DeviceBuffer::new()\n407\t                    } else {\n408\t                        all_public_values.to_device()?\n409\t                    };\n410\t\n411\t                    // Step 2: Build BlockCtx and GkrInputScatterCtx arrays.\n412\t                    let mut block_ctxs: Vec<BlockCtx> = Vec::new();\n413\t                    let mut air_ctxs: Vec<GkrInputScatterCtx> = Vec::new();\n414\t\n415\t                    for (air_local_idx, &work_idx) in\n416\t                        scatter_indices.iter().enumerate()\n417\t                    {\n418\t                        let w = &work_items[work_idx];\n419\t                        let air_ctx = w.air_ctx;\n420\t                        let pk_air = w.pk_air;\n421\t                        let height = air_ctx.height() as u32;\n422\t                        let num_air_blocks = height.div_ceil(256);\n423\t                        let rules = &pk_air.other_data.interaction_rules;\n424\t\n425\t                        for local_block in 0..num_air_blocks {\n426\t                            block_ctxs.push(BlockCtx {\n427\t                                local_block_idx_x: local_block,\n428\t                                air_idx: air_local_idx as u32,\n429\t                            });\n430\t                        }\n431\t\n432\t                        let preprocessed_ptr = pk_air\n433\t                            .preprocessed_data\n434\t                            .as_ref()\n435\t                            .map(|c| c.trace.buffer().as_ptr())\n436\t                            .unwrap_or(std::ptr::null());\n437\t\n438\t                        let pv_ptr = if air_ctx.public_values.is_empty() {\n439\t                            std::ptr::null()\n440\t                        } else {\n441\t                            unsafe {\n442\t                                d_all_public_values\n443\t                                    .as_ptr()\n444\t                                    .add(scatter_pv_offsets[air_local_idx])\n445\t                            }\n446\t                        };\n447\t\n448\t                        let height_usize = air_ctx.height();\n449\t                        let lifted_height = max(height_usize, 1 << w.l_skip);\n450\t                        let fracs_ptr = if height_usize != lifted_height {\n451\t                            d_scatter_tmp.as_mut_ptr()\n452\t                        } else {\n453\t                            w.leaves_ptr.0\n454\t                        };\n455\t\n456\t                        air_ctxs.push(GkrInputScatterCtx {\n457\t                            d_fracs: fracs_ptr,\n458\t                            d_preprocessed: preprocessed_ptr,\n459\t                            d_main: unsafe {\n460\t                                d_all_partition_ptrs\n461\t                                    .as_ptr()\n462\t                                    .add(scatter_partition_offsets[air_local_idx])\n463\t                            },\n464\t                            d_public_values: pv_ptr,\n465\t                            d_challenges: w.d_challenges.as_ptr(),\n466\t                            d_rules: rules.inner.d_rules.as_raw_ptr(),\n467\t                            d_used_nodes: rules.inner.d_used_nodes.as_ptr(),\n468\t                            d_pair_idxs: rules.d_pair_idxs.as_ptr(),\n469\t                            used_nodes_len: rules.inner.d_used_nodes.len(),\n470\t                            permutation_height: height,\n471\t                            num_blocks: num_air_blocks,\n472\t                        });\n473\t                    }\n474\t\n475\t                    let total_scatter_blocks = block_ctxs.len() as u32;\n476\t                    let d_block_ctxs = block_ctxs.to_device()?;\n477\t                    let d_air_ctxs = air_ctxs.to_device()?;\n478\t\n479\t                    // Step 3: Launch batched kernel.\n480\t                    unsafe {\n481\t                        batched_gkr_input_eval_scatter(\n482\t                            &d_block_ctxs,\n483\t                            &d_air_ctxs,\n484\t                            total_scatter_blocks,\n485\t                        )?;\n486\t                    }\n487\t\n488\t                    // Step 4: Sequential lifting for SCATTER AIRs that need it.\n489\t                    for &work_idx in &scatter_indices {\n490\t                        let w = &work_items[work_idx];\n491\t                        let height = w.air_ctx.height();\n492\t                        let lifted_height = max(height, 1 << w.l_skip);\n493\t                        if height != lifted_height {\n494\t                            let n_int = w\n495\t                                .pk_air\n496\t                                .vk\n497\t                                .symbolic_constraints\n498\t                                .interactions\n499\t                                .len();\n500\t                            let norm_factor =\n501\t                                F::from_usize(lifted_height / height).inverse();\n502\t                            unsafe {\n503\t                                frac_vector_scalar_multiply_ext_fp(\n504\t                                    d_scatter_tmp.as_mut_ptr(),\n505\t                                    norm_factor,\n506\t                                    (height * n_int) as u32,\n507\t                                )?;\n508\t                                frac_matrix_vertically_repeat(\n509\t                                    w.leaves_ptr.0,\n510\t                                    d_scatter_tmp.as_ptr(),\n511\t                                    n_int as u32,\n512\t                                    lifted_height as u32,\n513\t                                    height as u32,\n514\t                                )?;\n515\t                            }\n516\t                        }\n517\t                    }\n518\t\n519\t                    current_stream_sync().map_err(InteractionGpuError::from)?;\n520\t                    Ok(())\n521\t                }))\n522\t            } else {\n523\t                None\n524\t            };\n525\t\n526\t            // Spawn GLOBAL worker threads.\n527\t            let global_chunk_size = if global_indices.is_empty() {\n528\t                1\n529\t            } else {\n530\t                global_indices.len().div_ceil(num_global_threads)\n531\t            };\n532\t            let global_handles: Vec<_> = thread_buffers\n533\t                .into_iter()\n534\t                .zip(global_indices.chunks(global_chunk_size))\n535\t                .map(|(mut bufs, idx_chunk)| {\n536\t                    s.spawn(move || -> Result<(), InteractionGpuError> {\n537\t                        for &idx in idx_chunk {\n538\t                            process_gkr_input_air(&work_items[idx], &mut bufs)?;\n539\t                        }\n540\t                        current_stream_sync().map_err(InteractionGpuError::from)?;\n541\t                        Ok(())\n542\t                    })\n543\t                })\n544\t                .collect();\n545\t\n546\t            for handle in global_handles {\n547\t                handle.join().unwrap()?;\n548\t            }\n549\t            if let Some(handle) = scatter_handle {\n550\t                handle.join().unwrap()?;\n551\t            }\n552\t            Ok::<_, InteractionGpuError>(())\n553\t        })?;\n554\t    }\n555\t\n556\t    // NOTE: alpha is NO LONGER applied here - it will be fused into the first tree layer\n557\t    // in fractional_sumcheck_gpu for better performance (eliminates one memory pass)\n558\t    Ok((leaves, alpha_logup))\n559\t}\n560\t"}]},"parent_tool_use_id":null,"session_id":"8f65911c-bec8-4486-8d04-3600a654369d","uuid":"03846d03-4f3e-40f6-bd86-4f0e9ba6a6ab","timestamp":"2026-04-14T09:36:42.905Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/gkr_input.rs","content":"use std::cmp::max;\n\nuse itertools::Itertools;\nuse openvm_cuda_common::{\n    copy::MemCopyH2D,\n    d_buffer::DeviceBuffer,\n    stream::current_stream_sync,\n};\nuse openvm_stark_backend::prover::{\n    fractional_sumcheck_gkr::Frac,\n    stacked_pcs::{StackedLayout, StackedSlice},\n    DeviceMultiStarkProvingKey, MatrixDimensions, ProvingContext,\n};\nuse p3_field::{Field, PrimeCharacteristicRing};\nuse tracing::instrument;\n\nuse super::errors::InteractionGpuError;\nuse crate::{\n    cuda::logup_zerocheck::{\n        batched_gkr_input_eval_scatter, frac_matrix_vertically_repeat,\n        frac_vector_scalar_multiply_ext_fp, logup_gkr_input_eval, BlockCtx,\n        GkrInputScatterCtx,\n    },\n    gpu_backend::GenericGpuBackend,\n    hash_scheme::GpuHashScheme,\n    prelude::{EF, F},\n};\n\nconst TASK_SIZE: u32 = 65536;\n\n/// Number of OS threads (and thus CUDA streams) for parallel GKR input evaluation.\nconst NUM_GKR_INPUT_STREAMS: usize = 8;\n\nstruct SendPtr<T>(*mut T);\nunsafe impl<T> Send for SendPtr<T> {}\nunsafe impl<T> Sync for SendPtr<T> {}\n\nstruct GkrThreadBuffers {\n    intermediates: DeviceBuffer<EF>,\n    public_values: DeviceBuffer<F>,\n    partition_ptrs: DeviceBuffer<u64>,\n    tmp: DeviceBuffer<Frac<EF>>,\n}\n\nstruct GkrInputWorkItem<'a, HS: GpuHashScheme> {\n    air_ctx: &'a openvm_stark_backend::prover::AirProvingContext<GenericGpuBackend<HS>>,\n    pk_air: &'a openvm_stark_backend::prover::DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n    l_skip: usize,\n    d_challenges: &'a DeviceBuffer<EF>,\n    leaves_ptr: SendPtr<Frac<EF>>,\n}\n\n#[allow(dead_code)]\n#[derive(Clone)]\npub struct TraceInteractionMeta {\n    pub trace_idx: usize,\n    pub air_idx: usize,\n    pub layout_slices: Vec<StackedSlice>,\n}\n\n// TODO[jpw]: revisit if this function is needed\npub fn collect_trace_interactions<HS: GpuHashScheme>(\n    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n    layout: &StackedLayout,\n) -> Vec<Option<TraceInteractionMeta>> {\n    // Pre-group layout slices by trace to avoid repeated scans later.\n    let mut slices_by_trace: Vec<Vec<(usize, StackedSlice)>> =\n        vec![Vec::new(); ctx.per_trace.len()];\n    for &(trace_idx, interaction_idx, ref slice) in &layout.sorted_cols {\n        if let Some(entries) = slices_by_trace.get_mut(trace_idx) {\n            entries.push((interaction_idx, *slice));\n        }\n    }\n\n    ctx.per_trace\n        .iter()\n        .enumerate()\n        .map(|(trace_idx, (air_idx, _))| {\n            let vk = &pk.per_air[*air_idx].vk;\n            if !vk.has_interaction() {\n                return None;\n            }\n\n            let mut layout_entries = vec![None; vk.num_interactions()];\n            for (interaction_idx, slice) in &slices_by_trace[trace_idx] {\n                if let Some(slot) = layout_entries.get_mut(*interaction_idx) {\n                    *slot = Some(*slice);\n                }\n            }\n\n            let layout_slices = layout_entries\n                .into_iter()\n                .enumerate()\n                .map(|(idx, maybe_slice)| {\n                    maybe_slice.unwrap_or_else(|| {\n                        panic!(\n                            \"missing stacked slice for interaction {} of trace {}\",\n                            idx, trace_idx\n                        )\n                    })\n                })\n                .collect_vec();\n\n            Some(TraceInteractionMeta {\n                trace_idx,\n                air_idx: *air_idx,\n                layout_slices,\n            })\n        })\n        .collect()\n}\n\nfn process_gkr_input_air<HS: GpuHashScheme>(\n    w: &GkrInputWorkItem<HS>,\n    buffers: &mut GkrThreadBuffers,\n) -> Result<(), InteractionGpuError> {\n    let null_preprocessed = DeviceBuffer::<F>::new();\n    let air_ctx = w.air_ctx;\n    let pk_air = w.pk_air;\n\n    let preprocessed_matrix = pk_air\n        .preprocessed_data\n        .as_ref()\n        .map(|committed| &committed.trace);\n\n    let mut partitioned_main = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n    for committed in &air_ctx.cached_mains {\n        partitioned_main.push(&committed.trace);\n    }\n    partitioned_main.push(&air_ctx.common_main);\n\n    let rules = &pk_air.other_data.interaction_rules;\n    let num_interactions = pk_air.vk.symbolic_constraints.interactions.len();\n\n    let d_preprocessed = preprocessed_matrix\n        .as_ref()\n        .map(|m| m.buffer())\n        .unwrap_or(&null_preprocessed);\n\n    let null_pv = DeviceBuffer::<F>::new();\n    let has_public_values = !air_ctx.public_values.is_empty();\n    if has_public_values {\n        air_ctx.public_values.copy_to(&mut buffers.public_values)?;\n    }\n    let d_public_values = if has_public_values {\n        &buffers.public_values\n    } else {\n        &null_pv\n    };\n\n    let height = air_ctx.height();\n    debug_assert_eq!(height, partitioned_main[0].height());\n    let partition_ptrs = partitioned_main\n        .iter()\n        .map(|m| m.buffer().as_ptr() as u64)\n        .collect_vec();\n    partition_ptrs.copy_to(&mut buffers.partition_ptrs)?;\n\n    let buffer_size = rules.inner.buffer_size;\n    // TODO[jpw]: remove magic 10\n    let is_global = buffer_size > 10;\n\n    let num_rows_per_tile = height.div_ceil(TASK_SIZE as usize).max(1);\n\n    let leaves_ptr = w.leaves_ptr.0;\n    let l_skip = w.l_skip;\n    let lifted_height = max(height, 1 << l_skip);\n\n    let trace_output = if height != lifted_height {\n        buffers.tmp.as_mut_ptr()\n    } else {\n        leaves_ptr\n    };\n    unsafe {\n        logup_gkr_input_eval(\n            is_global,\n            trace_output,\n            d_preprocessed,\n            &buffers.partition_ptrs,\n            d_public_values,\n            w.d_challenges,\n            &buffers.intermediates,\n            &rules.inner.d_rules,\n            &rules.inner.d_used_nodes,\n            &rules.d_pair_idxs,\n            height as u32,\n            num_rows_per_tile as u32,\n        )?;\n    }\n    if height != lifted_height {\n        debug_assert_eq!(lifted_height % height, 0);\n        debug_assert!(!buffers.tmp.is_empty());\n        let norm_factor_denom = lifted_height / height;\n        let norm_factor = F::from_usize(norm_factor_denom).inverse();\n        unsafe {\n            frac_vector_scalar_multiply_ext_fp(\n                buffers.tmp.as_mut_ptr(),\n                norm_factor,\n                (height * num_interactions) as u32,\n            )?;\n            frac_matrix_vertically_repeat(\n                leaves_ptr,\n                buffers.tmp.as_ptr(),\n                num_interactions as u32,\n                lifted_height as u32,\n                height as u32,\n            )?;\n        }\n    }\n    Ok(())\n}\n\n/// Evaluate interactions from trace evaluation matrices to get (p, q) fractional sumcheck input.\n/// Returns leaves buffer (WITHOUT alpha applied) and alpha value to be applied in first tree layer.\n#[instrument(name = \"prover.rap_constraints.logup_gkr.input_evals\", skip_all)]\npub fn log_gkr_input_evals<HS: GpuHashScheme>(\n    trace_interactions: &[Option<TraceInteractionMeta>],\n    pk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n    l_skip: usize,\n    alpha_logup: EF,\n    d_challenges: &DeviceBuffer<EF>,\n    total_leaves: usize,\n) -> Result<(DeviceBuffer<Frac<EF>>, EF), InteractionGpuError> {\n    if trace_interactions.iter().all(|meta| meta.is_none()) {\n        return Ok((DeviceBuffer::new(), alpha_logup));\n    }\n\n    let leaves = DeviceBuffer::<Frac<EF>>::with_capacity(total_leaves);\n    leaves.fill_zero()?;\n\n    // Phase 1: Build work items and sort by descending height for load balance.\n    let mut work_items: Vec<GkrInputWorkItem<HS>> = trace_interactions\n        .iter()\n        .flatten()\n        .map(|meta| {\n            let air_ctx = &ctx.per_trace[meta.trace_idx].1;\n            let pk_air = &pk.per_air[meta.air_idx];\n            let slice = meta.layout_slices.first().unwrap();\n            assert_eq!(slice.col_idx, 0);\n            let dst_offset = slice.row_idx;\n            let leaves_ptr = unsafe { leaves.as_mut_ptr().add(dst_offset) };\n            GkrInputWorkItem {\n                air_ctx,\n                pk_air,\n                l_skip,\n                d_challenges,\n                leaves_ptr: SendPtr(leaves_ptr),\n            }\n        })\n        .collect();\n\n    work_items.sort_by(|a, b| b.air_ctx.height().cmp(&a.air_ctx.height()));\n\n    // Partition into SCATTER (buffer_size <= 10) and GLOBAL (buffer_size > 10) indices.\n    let mut scatter_indices: Vec<usize> = Vec::new();\n    let mut global_indices: Vec<usize> = Vec::new();\n    for (i, w) in work_items.iter().enumerate() {\n        if w.pk_air.other_data.interaction_rules.inner.buffer_size > 10 {\n            global_indices.push(i);\n        } else {\n            scatter_indices.push(i);\n        }\n    }\n\n    // Pre-compute max buffer sizes across all work items (needed for single-threaded fallback).\n    let mut max_intermediates_len: usize = 1;\n    let mut max_public_values_len: usize = 0;\n    let mut max_partition_ptrs_len: usize = 0;\n    let mut max_tmp_len: usize = 0;\n\n    for w in &work_items {\n        let rules = &w.pk_air.other_data.interaction_rules;\n        let buffer_size = rules.inner.buffer_size as usize;\n        let is_global = buffer_size > 10;\n        if is_global {\n            max_intermediates_len = max_intermediates_len.max(TASK_SIZE as usize * buffer_size);\n        }\n\n        max_public_values_len = max_public_values_len.max(w.air_ctx.public_values.len());\n\n        let num_partitions = w.air_ctx.cached_mains.len() + 1;\n        max_partition_ptrs_len = max_partition_ptrs_len.max(num_partitions);\n\n        let height = w.air_ctx.height();\n        let lifted_height = height.max(1 << w.l_skip);\n        if height != lifted_height {\n            let num_interactions = w.pk_air.vk.symbolic_constraints.interactions.len();\n            max_tmp_len = max_tmp_len.max(height * num_interactions);\n        }\n    }\n\n    // Compute max scatter tmp for lifted SCATTER AIRs.\n    let max_scatter_tmp = scatter_indices\n        .iter()\n        .filter_map(|&idx| {\n            let w = &work_items[idx];\n            let height = w.air_ctx.height();\n            let lifted = max(height, 1 << w.l_skip);\n            if height != lifted {\n                let n_int = w.pk_air.vk.symbolic_constraints.interactions.len();\n                Some(height * n_int)\n            } else {\n                None\n            }\n        })\n        .max()\n        .unwrap_or(0);\n\n    // Barrier: ensure fill_zero() and all prior GPU work is visible to worker thread streams.\n    current_stream_sync().map_err(InteractionGpuError::from)?;\n\n    if work_items.len() < 100 {\n        // Single-threaded path: process ALL AIRs (unchanged for APC 0 fallback).\n        let mut bufs = GkrThreadBuffers {\n            intermediates: DeviceBuffer::with_capacity(max_intermediates_len),\n            public_values: if max_public_values_len > 0 {\n                DeviceBuffer::with_capacity(max_public_values_len)\n            } else {\n                DeviceBuffer::new()\n            },\n            partition_ptrs: DeviceBuffer::with_capacity(max_partition_ptrs_len),\n            tmp: if max_tmp_len > 0 {\n                DeviceBuffer::with_capacity(max_tmp_len)\n            } else {\n                DeviceBuffer::new()\n            },\n        };\n        for w in &work_items {\n            process_gkr_input_air(w, &mut bufs)?;\n        }\n    } else {\n        // Multi-threaded path with SCATTER batching.\n        let mut num_global_threads = NUM_GKR_INPUT_STREAMS.min(global_indices.len().max(1));\n\n        // Memory budget check: reduce thread count if pre-allocation would exceed 2 GB.\n        let per_thread_bytes = max_intermediates_len * std::mem::size_of::<EF>()\n            + max_public_values_len * std::mem::size_of::<F>()\n            + max_partition_ptrs_len * std::mem::size_of::<u64>()\n            + max_tmp_len * std::mem::size_of::<Frac<EF>>();\n        while num_global_threads > 1 && num_global_threads * per_thread_bytes > 2_000_000_000 {\n            num_global_threads /= 2;\n            tracing::warn!(\n                \"Reducing GKR input eval thread count to {} due to memory budget ({}MB per thread)\",\n                num_global_threads,\n                per_thread_bytes / (1024 * 1024)\n            );\n        }\n\n        // Pre-allocate per-thread buffer pools for GLOBAL workers.\n        let thread_buffers: Vec<GkrThreadBuffers> = (0..num_global_threads)\n            .map(|_| GkrThreadBuffers {\n                intermediates: DeviceBuffer::with_capacity(max_intermediates_len),\n                public_values: if max_public_values_len > 0 {\n                    DeviceBuffer::with_capacity(max_public_values_len)\n                } else {\n                    DeviceBuffer::new()\n                },\n                partition_ptrs: DeviceBuffer::with_capacity(max_partition_ptrs_len),\n                tmp: if max_tmp_len > 0 {\n                    DeviceBuffer::with_capacity(max_tmp_len)\n                } else {\n                    DeviceBuffer::new()\n                },\n            })\n            .collect();\n\n        // Allocate scatter tmp buffer for lifted SCATTER AIRs.\n        let d_scatter_tmp = if max_scatter_tmp > 0 {\n            DeviceBuffer::<Frac<EF>>::with_capacity(max_scatter_tmp)\n        } else {\n            DeviceBuffer::<Frac<EF>>::new()\n        };\n\n        std::thread::scope(|s| {\n            // Spawn background thread for batched SCATTER processing.\n            let scatter_handle = if !scatter_indices.is_empty() {\n                Some(s.spawn(|| -> Result<(), InteractionGpuError> {\n                    // Step 1: Concatenate host arrays for partition pointers and\n                    // public values.\n                    let mut all_partition_ptrs: Vec<u64> = Vec::new();\n                    let mut all_public_values: Vec<F> = Vec::new();\n                    let mut scatter_partition_offsets: Vec<usize> = Vec::new();\n                    let mut scatter_pv_offsets: Vec<usize> = Vec::new();\n\n                    for &work_idx in &scatter_indices {\n                        let w = &work_items[work_idx];\n                        let air_ctx = w.air_ctx;\n\n                        scatter_partition_offsets.push(all_partition_ptrs.len());\n                        for committed in &air_ctx.cached_mains {\n                            all_partition_ptrs\n                                .push(committed.trace.buffer().as_ptr() as u64);\n                        }\n                        all_partition_ptrs\n                            .push(air_ctx.common_main.buffer().as_ptr() as u64);\n\n                        scatter_pv_offsets.push(all_public_values.len());\n                        all_public_values.extend_from_slice(&air_ctx.public_values);\n                    }\n\n                    // 2 bulk H2D uploads (on this thread's per-thread CUDA stream).\n                    let d_all_partition_ptrs = all_partition_ptrs.to_device()?;\n                    let d_all_public_values = if all_public_values.is_empty() {\n                        DeviceBuffer::new()\n                    } else {\n                        all_public_values.to_device()?\n                    };\n\n                    // Step 2: Build BlockCtx and GkrInputScatterCtx arrays.\n                    let mut block_ctxs: Vec<BlockCtx> = Vec::new();\n                    let mut air_ctxs: Vec<GkrInputScatterCtx> = Vec::new();\n\n                    for (air_local_idx, &work_idx) in\n                        scatter_indices.iter().enumerate()\n                    {\n                        let w = &work_items[work_idx];\n                        let air_ctx = w.air_ctx;\n                        let pk_air = w.pk_air;\n                        let height = air_ctx.height() as u32;\n                        let num_air_blocks = height.div_ceil(256);\n                        let rules = &pk_air.other_data.interaction_rules;\n\n                        for local_block in 0..num_air_blocks {\n                            block_ctxs.push(BlockCtx {\n                                local_block_idx_x: local_block,\n                                air_idx: air_local_idx as u32,\n                            });\n                        }\n\n                        let preprocessed_ptr = pk_air\n                            .preprocessed_data\n                            .as_ref()\n                            .map(|c| c.trace.buffer().as_ptr())\n                            .unwrap_or(std::ptr::null());\n\n                        let pv_ptr = if air_ctx.public_values.is_empty() {\n                            std::ptr::null()\n                        } else {\n                            unsafe {\n                                d_all_public_values\n                                    .as_ptr()\n                                    .add(scatter_pv_offsets[air_local_idx])\n                            }\n                        };\n\n                        let height_usize = air_ctx.height();\n                        let lifted_height = max(height_usize, 1 << w.l_skip);\n                        let fracs_ptr = if height_usize != lifted_height {\n                            d_scatter_tmp.as_mut_ptr()\n                        } else {\n                            w.leaves_ptr.0\n                        };\n\n                        air_ctxs.push(GkrInputScatterCtx {\n                            d_fracs: fracs_ptr,\n                            d_preprocessed: preprocessed_ptr,\n                            d_main: unsafe {\n                                d_all_partition_ptrs\n                                    .as_ptr()\n                                    .add(scatter_partition_offsets[air_local_idx])\n                            },\n                            d_public_values: pv_ptr,\n                            d_challenges: w.d_challenges.as_ptr(),\n                            d_rules: rules.inner.d_rules.as_raw_ptr(),\n                            d_used_nodes: rules.inner.d_used_nodes.as_ptr(),\n                            d_pair_idxs: rules.d_pair_idxs.as_ptr(),\n                            used_nodes_len: rules.inner.d_used_nodes.len(),\n                            permutation_height: height,\n                            num_blocks: num_air_blocks,\n                        });\n                    }\n\n                    let total_scatter_blocks = block_ctxs.len() as u32;\n                    let d_block_ctxs = block_ctxs.to_device()?;\n                    let d_air_ctxs = air_ctxs.to_device()?;\n\n                    // Step 3: Launch batched kernel.\n                    unsafe {\n                        batched_gkr_input_eval_scatter(\n                            &d_block_ctxs,\n                            &d_air_ctxs,\n                            total_scatter_blocks,\n                        )?;\n                    }\n\n                    // Step 4: Sequential lifting for SCATTER AIRs that need it.\n                    for &work_idx in &scatter_indices {\n                        let w = &work_items[work_idx];\n                        let height = w.air_ctx.height();\n                        let lifted_height = max(height, 1 << w.l_skip);\n                        if height != lifted_height {\n                            let n_int = w\n                                .pk_air\n                                .vk\n                                .symbolic_constraints\n                                .interactions\n                                .len();\n                            let norm_factor =\n                                F::from_usize(lifted_height / height).inverse();\n                            unsafe {\n                                frac_vector_scalar_multiply_ext_fp(\n                                    d_scatter_tmp.as_mut_ptr(),\n                                    norm_factor,\n                                    (height * n_int) as u32,\n                                )?;\n                                frac_matrix_vertically_repeat(\n                                    w.leaves_ptr.0,\n                                    d_scatter_tmp.as_ptr(),\n                                    n_int as u32,\n                                    lifted_height as u32,\n                                    height as u32,\n                                )?;\n                            }\n                        }\n                    }\n\n                    current_stream_sync().map_err(InteractionGpuError::from)?;\n                    Ok(())\n                }))\n            } else {\n                None\n            };\n\n            // Spawn GLOBAL worker threads.\n            let global_chunk_size = if global_indices.is_empty() {\n                1\n            } else {\n                global_indices.len().div_ceil(num_global_threads)\n            };\n            let global_handles: Vec<_> = thread_buffers\n                .into_iter()\n                .zip(global_indices.chunks(global_chunk_size))\n                .map(|(mut bufs, idx_chunk)| {\n                    s.spawn(move || -> Result<(), InteractionGpuError> {\n                        for &idx in idx_chunk {\n                            process_gkr_input_air(&work_items[idx], &mut bufs)?;\n                        }\n                        current_stream_sync().map_err(InteractionGpuError::from)?;\n                        Ok(())\n                    })\n                })\n                .collect();\n\n            for handle in global_handles {\n                handle.join().unwrap()?;\n            }\n            if let Some(handle) = scatter_handle {\n                handle.join().unwrap()?;\n            }\n            Ok::<_, InteractionGpuError>(())\n        })?;\n    }\n\n    // NOTE: alpha is NO LONGER applied here - it will be fused into the first tree layer\n    // in fractional_sumcheck_gpu for better performance (eliminates one memory pass)\n    Ok((leaves, alpha_logup))\n}\n","numLines":560,"startLine":1,"totalLines":560}}}
