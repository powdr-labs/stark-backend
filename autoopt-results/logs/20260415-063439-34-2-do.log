{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y9VAv1HafxtGg1nEKxhRB9","type":"tool_result","content":"1\t#![allow(non_camel_case_types, non_upper_case_globals, non_snake_case)]\n2\t\n3\tuse std::{\n4\t    collections::{BTreeMap, HashMap},\n5\t    ffi::c_void,\n6\t    sync::Arc,\n7\t};\n8\t\n9\tuse bytesize::ByteSize;\n10\t\n11\tuse super::cuda::*;\n12\tuse crate::{\n13\t    common::set_device,\n14\t    error::MemoryError,\n15\t    stream::{\n16\t        current_stream_id, current_stream_sync, default_stream_wait, CudaEvent, CudaStreamId,\n17\t    },\n18\t};\n19\t\n20\t#[link(name = \"cudart\")]\n21\textern \"C\" {\n22\t    fn cudaMemGetInfo(free_bytes: *mut usize, total_bytes: *mut usize) -> i32;\n23\t}\n24\t\n25\t// ============================================================================\n26\t// Configuration\n27\t// ============================================================================\n28\t\n29\tconst DEFAULT_VA_SIZE: usize = 8 << 40; // 8 TB\n30\t\n31\t/// Configuration for the Virtual Memory Pool.\n32\t///\n33\t/// Use `VpmmConfig::from_env()` to load from environment variables,\n34\t/// or construct directly for testing.\n35\t#[derive(Debug, Clone)]\n36\tpub(super) struct VpmmConfig {\n37\t    /// Page size override. If `None`, uses CUDA's minimum granularity for the device.\n38\t    pub page_size: Option<usize>,\n39\t    /// Virtual address space size per reserved chunk (default: 8 TB).\n40\t    pub va_size: usize,\n41\t    /// Number of pages to preallocate at startup (default: 0).\n42\t    pub initial_pages: usize,\n43\t}\n44\t\n45\timpl Default for VpmmConfig {\n46\t    fn default() -> Self {\n47\t        Self {\n48\t            page_size: None,\n49\t            va_size: DEFAULT_VA_SIZE,\n50\t            initial_pages: 0,\n51\t        }\n52\t    }\n53\t}\n54\t\n55\timpl VpmmConfig {\n56\t    /// Load configuration from environment variables:\n57\t    /// - `VPMM_PAGE_SIZE`: Page size in bytes (must be multiple of CUDA granularity)\n58\t    /// - `VPMM_VA_SIZE`: Virtual address space size per chunk (default: 8 TB)\n59\t    /// - `VPMM_PAGES`: Number of pages to preallocate (default: 0)\n60\t    pub fn from_env() -> Self {\n61\t        let page_size = std::env::var(\"VPMM_PAGE_SIZE\").ok().map(|val| {\n62\t            let size: usize = val.parse().expect(\"VPMM_PAGE_SIZE must be a valid number\");\n63\t            assert!(size > 0, \"VPMM_PAGE_SIZE must be > 0\");\n64\t            size\n65\t        });\n66\t\n67\t        let va_size = match std::env::var(\"VPMM_VA_SIZE\") {\n68\t            Ok(val) => {\n69\t                let size: usize = val.parse().expect(\"VPMM_VA_SIZE must be a valid number\");\n70\t                assert!(size > 0, \"VPMM_VA_SIZE must be > 0\");\n71\t                size\n72\t            }\n73\t            Err(_) => DEFAULT_VA_SIZE,\n74\t        };\n75\t\n76\t        let initial_pages = match std::env::var(\"VPMM_PAGES\") {\n77\t            Ok(val) => val.parse().expect(\"VPMM_PAGES must be a valid number\"),\n78\t            Err(_) => 0,\n79\t        };\n80\t\n81\t        Self {\n82\t            page_size,\n83\t            va_size,\n84\t            initial_pages,\n85\t        }\n86\t    }\n87\t}\n88\t\n89\t// ============================================================================\n90\t// Pool Implementation\n91\t// ============================================================================\n92\t\n93\t/// Metadata for a free region in the virtual address space.\n94\t#[derive(Debug, Clone)]\n95\tstruct FreeRegionMeta {\n96\t    size: usize,\n97\t    event: Arc<CudaEvent>,\n98\t    stream_id: CudaStreamId,\n99\t    id: usize,\n100\t}\n101\t\n102\t/// Remapped region that will be unmapped when the event completes.\n103\t#[derive(Debug)]\n104\tstruct ZombieRegion {\n105\t    ptr: CUdeviceptr,\n106\t    size: usize,\n107\t    event: Arc<CudaEvent>,\n108\t}\n109\t\n110\t/// Virtual memory pool implementation.\n111\tpub(super) struct VirtualMemoryPool {\n112\t    // Virtual address space roots\n113\t    pub(super) roots: Vec<CUdeviceptr>,\n114\t\n115\t    // Map for all active pages\n116\t    active_pages: HashMap<CUdeviceptr, CUmemGenericAllocationHandle>,\n117\t\n118\t    // Free regions in virtual space (sorted by address)\n119\t    free_regions: BTreeMap<CUdeviceptr, FreeRegionMeta>,\n120\t\n121\t    // Active allocations: (ptr, size)\n122\t    malloc_regions: HashMap<CUdeviceptr, usize>,\n123\t\n124\t    // Unmapped regions: (ptr, size)\n125\t    unmapped_regions: BTreeMap<CUdeviceptr, usize>,\n126\t\n127\t    // Zombie regions: (remapped, but not unmapped yet)\n128\t    zombie_regions: Vec<ZombieRegion>,\n129\t\n130\t    // Number of free calls (used to assign ids to free regions)\n131\t    free_num: usize,\n132\t\n133\t    // Granularity size: (page % 2MB must be 0)\n134\t    pub(super) page_size: usize,\n135\t\n136\t    // Reserved virtual address span in bytes\n137\t    va_size: usize,\n138\t\n139\t    // Device ordinal\n140\t    pub(super) device_id: i32,\n141\t}\n142\t\n143\t/// # Safety\n144\t/// `VirtualMemoryPool` is not internally synchronized. These impls are safe because\n145\t/// all access goes through `Mutex<MemoryManager>` in the parent module.\n146\tunsafe impl Send for VirtualMemoryPool {}\n147\tunsafe impl Sync for VirtualMemoryPool {}\n148\t\n149\timpl VirtualMemoryPool {\n150\t    pub(super) fn new(config: VpmmConfig) -> Self {\n151\t        let device_id = set_device().unwrap();\n152\t\n153\t        // Check VPMM support and resolve page_size\n154\t        let (root, page_size, va_size) = unsafe {\n155\t            match vpmm_check_support(device_id) {\n156\t                Ok(_) => {\n157\t                    let granularity = vpmm_min_granularity(device_id).unwrap();\n158\t\n159\t                    // Resolve page_size: use config override or device granularity\n160\t                    let page_size = match config.page_size {\n161\t                        Some(size) => {\n162\t                            assert!(\n163\t                                size > 0 && size % granularity == 0,\n164\t                                \"VPMM_PAGE_SIZE must be > 0 and multiple of {}\",\n165\t                                granularity\n166\t                            );\n167\t                            size\n168\t                        }\n169\t                        None => granularity,\n170\t                    };\n171\t\n172\t                    // Validate va_size\n173\t                    let va_size = config.va_size;\n174\t                    assert!(\n175\t                        va_size > 0 && va_size.is_multiple_of(page_size),\n176\t                        \"VPMM_VA_SIZE must be > 0 and multiple of page size ({})\",\n177\t                        page_size\n178\t                    );\n179\t\n180\t                    // Reserve initial VA chunk\n181\t                    let va_base = vpmm_reserve(va_size, page_size).unwrap();\n182\t                    tracing::debug!(\n183\t                        \"VPMM: Reserved virtual address space {} with page size {}\",\n184\t                        ByteSize::b(va_size as u64),\n185\t                        ByteSize::b(page_size as u64)\n186\t                    );\n187\t                    (va_base, page_size, va_size)\n188\t                }\n189\t                Err(_) => {\n190\t                    tracing::warn!(\"VPMM not supported, falling back to cudaMallocAsync\");\n191\t                    (0, usize::MAX, 0)\n192\t                }\n193\t            }\n194\t        };\n195\t\n196\t        let mut pool = Self {\n197\t            roots: vec![root],\n198\t            active_pages: HashMap::new(),\n199\t            free_regions: BTreeMap::new(),\n200\t            malloc_regions: HashMap::new(),\n201\t            unmapped_regions: if va_size > 0 {\n202\t                BTreeMap::from_iter([(root, va_size)])\n203\t            } else {\n204\t                BTreeMap::new()\n205\t            },\n206\t            zombie_regions: Vec::new(),\n207\t            free_num: 0,\n208\t            page_size,\n209\t            va_size,\n210\t            device_id,\n211\t        };\n212\t\n213\t        // Preallocate pages if requested (skip if VPMM not supported)\n214\t        if config.initial_pages > 0 && page_size != usize::MAX {\n215\t            let alloc_size = config.initial_pages * page_size;\n216\t            if let Err(e) =\n217\t                pool.defragment_or_create_new_pages(alloc_size, current_stream_id().unwrap())\n218\t            {\n219\t                let mut free_mem = 0usize;\n220\t                let mut total_mem = 0usize;\n221\t                unsafe {\n222\t                    cudaMemGetInfo(&mut free_mem, &mut total_mem);\n223\t                }\n224\t                panic!(\n225\t                    \"VPMM preallocation failed: {:?}\\n\\\n226\t                     Config: pages={}, page_size={}\\n\\\n227\t                     GPU Memory: free={}, total={}\",\n228\t                    e,\n229\t                    config.initial_pages,\n230\t                    ByteSize::b(page_size as u64),\n231\t                    ByteSize::b(free_mem as u64),\n232\t                    ByteSize::b(total_mem as u64)\n233\t                );\n234\t            }\n235\t        }\n236\t\n237\t        pool\n238\t    }\n239\t\n240\t    /// Allocates memory from the pool's free regions.\n241\t    /// Attempts defragmentation if no suitable free region exists.\n242\t    /// Returns an error if there's insufficient memory even after defragmentation.\n243\t    pub(super) fn malloc_internal(\n244\t        &mut self,\n245\t        requested: usize,\n246\t        stream_id: CudaStreamId,\n247\t    ) -> Result<*mut c_void, MemoryError> {\n248\t        debug_assert!(\n249\t            requested != 0 && requested.is_multiple_of(self.page_size),\n250\t            \"Requested size must be a multiple of the page size\"\n251\t        );\n252\t\n253\t        // Phase 0: Cleanup zombie regions\n254\t        self.cleanup_zombie_regions();\n255\t\n256\t        // Phase 1: Zero-cost attempts\n257\t        let mut best_region = self.find_best_fit(requested, stream_id);\n258\t\n259\t        if best_region.is_none() {\n260\t            // Phase 2: Defragmentation\n261\t            best_region = self.defragment_or_create_new_pages(requested, stream_id)?;\n262\t        }\n263\t\n264\t        if let Some(ptr) = best_region {\n265\t            let region = self\n266\t                .free_regions\n267\t                .remove(&ptr)\n268\t                .expect(\"BUG: free region address not found after find_best_fit\");\n269\t            debug_assert_eq!(region.stream_id, stream_id);\n270\t\n271\t            // If region is larger, return remainder to free list\n272\t            if region.size > requested {\n273\t                self.free_regions.insert(\n274\t                    ptr + requested as u64,\n275\t                    FreeRegionMeta {\n276\t                        size: region.size - requested,\n277\t                        event: region.event,\n278\t                        stream_id,\n279\t                        id: region.id,\n280\t                    },\n281\t                );\n282\t            }\n283\t\n284\t            self.malloc_regions.insert(ptr, requested);\n285\t            return Ok(ptr as *mut c_void);\n286\t        }\n287\t\n288\t        Err(MemoryError::OutOfMemory {\n289\t            requested,\n290\t            available: self.free_regions.values().map(|r| r.size).sum(),\n291\t        })\n292\t    }\n293\t\n294\t    /// Reclaims zombie regions whose events have completed.\n295\t    ///\n296\t    /// Zombies are old regions that have been double-mapped to new locations during defrag.\n297\t    /// Once the associated event completes (meaning no GPU work is using the old VA),\n298\t    /// we can safely unmap the old VA and return it to `unmapped_regions` for reuse.\n299\t    fn cleanup_zombie_regions(&mut self) {\n300\t        let mut i = 0;\n301\t        while i < self.zombie_regions.len() {\n302\t            if self.zombie_regions[i].event.completed() {\n303\t                let zombie = self.zombie_regions.swap_remove(i);\n304\t                if let Err(e) = unsafe { vpmm_unmap(zombie.ptr, zombie.size) } {\n305\t                    tracing::error!(\n306\t                        \"vpmm_unmap (zombie) failed: addr={:#x}, size={}: {:?}\",\n307\t                        zombie.ptr,\n308\t                        zombie.size,\n309\t                        e\n310\t                    );\n311\t                }\n312\t                self.insert_unmapped_region(zombie.ptr, zombie.size);\n313\t            } else {\n314\t                i += 1;\n315\t            }\n316\t        }\n317\t    }\n318\t\n319\t    /// Phase 1: Try to find a suitable free region without defragmentation\n320\t    /// Returns address if found, None otherwise\n321\t    fn find_best_fit(&mut self, requested: usize, stream_id: CudaStreamId) -> Option<CUdeviceptr> {\n322\t        let mut candidates: Vec<(CUdeviceptr, &mut FreeRegionMeta)> = self\n323\t            .free_regions\n324\t            .iter_mut()\n325\t            .filter(|(_, region)| region.size >= requested)\n326\t            .map(|(addr, region)| (*addr, region))\n327\t            .collect();\n328\t\n329\t        if candidates.is_empty() {\n330\t            return None;\n331\t        }\n332\t\n333\t        // 1a. Prefer current stream (smallest fit) - could be not completed\n334\t        if let Some((addr, _)) = candidates\n335\t            .iter()\n336\t            .filter(|(_, region)| region.stream_id == stream_id)\n337\t            .min_by_key(|(_, region)| region.size)\n338\t        {\n339\t            return Some(*addr);\n340\t        }\n341\t\n342\t        // 1b. Other streams (smallest fit) - ONLY if already completed (no sync)\n343\t        candidates\n344\t            .iter_mut()\n345\t            .filter(|(_, region)| region.event.completed())\n346\t            .min_by_key(|(_, region)| region.size)\n347\t            .map(|(addr, region)| {\n348\t                region.stream_id = stream_id;\n349\t                *addr\n350\t            })\n351\t    }\n352\t\n353\t    /// Frees a pointer and returns the size of the freed memory.\n354\t    /// Coalesces adjacent free regions.\n355\t    ///\n356\t    /// # Assumptions\n357\t    /// No CUDA streams will use the malloc region starting at `ptr` after the newly recorded event\n358\t    /// on `stream_id` at this point in time.\n359\t    pub(super) fn free_internal(\n360\t        &mut self,\n361\t        ptr: *mut c_void,\n362\t        stream_id: CudaStreamId,\n363\t    ) -> Result<usize, MemoryError> {\n364\t        let ptr = ptr as CUdeviceptr;\n365\t        let size = self\n366\t            .malloc_regions\n367\t            .remove(&ptr)\n368\t            .ok_or(MemoryError::InvalidPointer)?;\n369\t\n370\t        let _ = self.free_region_insert(ptr, size, stream_id);\n371\t\n372\t        Ok(size)\n373\t    }\n374\t\n375\t    /// Inserts a new free region for `(ptr, size)` into the free regions map, **possibly** merging\n376\t    /// with existing adjacent regions. Merges only occur if the regions are both adjacent in memory\n377\t    /// and on the same stream as `stream_id`. The new free region always records a new event on the\n378\t    /// stream.\n379\t    ///\n380\t    /// Returns the starting pointer and size of the (possibly merged) free region containing `(ptr,\n381\t    /// size)`.\n382\t    fn free_region_insert(\n383\t        &mut self,\n384\t        mut ptr: CUdeviceptr,\n385\t        mut size: usize,\n386\t        stream_id: CudaStreamId,\n387\t    ) -> (CUdeviceptr, usize) {\n388\t        // Potential merge with next neighbor\n389\t        if let Some((&next_ptr, next_region)) = self.free_regions.range(ptr + 1..).next() {\n390\t            if next_region.stream_id == stream_id && ptr + size as u64 == next_ptr {\n391\t                let next_region = self.free_regions.remove(&next_ptr).unwrap();\n392\t                size += next_region.size;\n393\t            }\n394\t        }\n395\t        // Potential merge with previous neighbor\n396\t        if let Some((&prev_ptr, prev_region)) = self.free_regions.range(..ptr).next_back() {\n397\t            if prev_region.stream_id == stream_id && prev_ptr + prev_region.size as u64 == ptr {\n398\t                let prev_region = self.free_regions.remove(&prev_ptr).unwrap();\n399\t                ptr = prev_ptr;\n400\t                size += prev_region.size;\n401\t            }\n402\t        }\n403\t        // Record a new event to capture the current point in the stream\n404\t        let event = Arc::new(CudaEvent::new().unwrap());\n405\t        event.record_on_this().unwrap();\n406\t        // Assign an id to the free region\n407\t        let id = self.free_num;\n408\t        self.free_num += 1;\n409\t\n410\t        self.free_regions.insert(\n411\t            ptr,\n412\t            FreeRegionMeta {\n413\t                size,\n414\t                event,\n415\t                stream_id,\n416\t                id,\n417\t            },\n418\t        );\n419\t        (ptr, size)\n420\t    }\n421\t\n422\t    /// Return the base address of a virtual hole large enough for `requested` bytes.\n423\t    ///\n424\t    /// The returned region is not inside `free_region` or `unmapped_region` map and must be\n425\t    /// properly handled.\n426\t    fn take_unmapped_region(&mut self, requested: usize) -> Result<CUdeviceptr, MemoryError> {\n427\t        debug_assert!(requested != 0);\n428\t        debug_assert_eq!(requested % self.page_size, 0);\n429\t\n430\t        if let Some((&addr, &size)) = self\n431\t            .unmapped_regions\n432\t            .iter()\n433\t            .filter(|(_, region_size)| **region_size >= requested)\n434\t            .min_by_key(|(_, region_size)| *region_size)\n435\t        {\n436\t            self.unmapped_regions.remove(&addr);\n437\t            if size > requested {\n438\t                self.unmapped_regions\n439\t                    .insert(addr + requested as u64, size - requested);\n440\t            }\n441\t            return Ok(addr);\n442\t        }\n443\t\n444\t        let addr = unsafe {\n445\t            vpmm_reserve(self.va_size, self.page_size).map_err(|_| MemoryError::ReserveFailed {\n446\t                size: self.va_size,\n447\t                page_size: self.page_size,\n448\t            })?\n449\t        };\n450\t        self.roots.push(addr);\n451\t        self.insert_unmapped_region(addr + requested as u64, self.va_size - requested);\n452\t        Ok(addr)\n453\t    }\n454\t\n455\t    /// Insert a hole back into the unmapped set, coalescing with neighbors.\n456\t    fn insert_unmapped_region(&mut self, mut addr: CUdeviceptr, mut size: usize) {\n457\t        if size == 0 {\n458\t            return;\n459\t        }\n460\t\n461\t        if let Some((&prev_addr, &prev_size)) = self.unmapped_regions.range(..addr).next_back() {\n462\t            if prev_addr + prev_size as u64 == addr {\n463\t                self.unmapped_regions.remove(&prev_addr);\n464\t                addr = prev_addr;\n465\t                size += prev_size;\n466\t            }\n467\t        }\n468\t\n469\t        if let Some((&next_addr, &next_size)) = self.unmapped_regions.range(addr + 1..).next() {\n470\t            if addr + size as u64 == next_addr {\n471\t                self.unmapped_regions.remove(&next_addr);\n472\t                size += next_size;\n473\t            }\n474\t        }\n475\t\n476\t        self.unmapped_regions.insert(addr, size);\n477\t    }\n478\t\n479\t    /// Roll back partially allocated pages when allocation fails.\n480\t    /// Unmaps and releases any mapped pages and restores the reserved VA span.\n481\t    fn rollback_new_pages(\n482\t        &mut self,\n483\t        reserved_ptr: CUdeviceptr,\n484\t        reserved_size: usize,\n485\t        allocated_pages: &[(CUdeviceptr, CUmemGenericAllocationHandle)],\n486\t    ) {\n487\t        for (addr, handle) in allocated_pages {\n488\t            if let Err(e) = unsafe { vpmm_unmap(*addr, self.page_size) } {\n489\t                tracing::error!(\n490\t                    \"rollback: vpmm_unmap failed: addr={:#x}, size={}: {:?}\",\n491\t                    addr,\n492\t                    self.page_size,\n493\t                    e\n494\t                );\n495\t            }\n496\t            self.active_pages.remove(addr);\n497\t            if let Err(e) = unsafe { vpmm_release(*handle) } {\n498\t                tracing::error!(\"rollback: vpmm_release failed: handle={}: {:?}\", handle, e);\n499\t            }\n500\t        }\n501\t        self.insert_unmapped_region(reserved_ptr, reserved_size);\n502\t    }\n503\t\n504\t    /// Defragments the pool by reusing existing holes and, if needed, reserving more VA space.\n505\t    /// Moves just enough pages to satisfy `requested`, keeping the remainder in place.\n506\t    ///\n507\t    /// The returned `pointer`, if not `None`, is guaranteed to exist as a key in the `free_regions`\n508\t    /// map. The corresponding free region will have size `>= requested`. Note the size _may_ be\n509\t    /// larger than requested.\n510\t    fn defragment_or_create_new_pages(\n511\t        &mut self,\n512\t        requested: usize,\n513\t        stream_id: CudaStreamId,\n514\t    ) -> Result<Option<CUdeviceptr>, MemoryError> {\n515\t        debug_assert_eq!(requested % self.page_size, 0);\n516\t        if requested == 0 {\n517\t            return Ok(None);\n518\t        }\n519\t\n520\t        let total_free_size = self.free_regions.values().map(|r| r.size).sum::<usize>();\n521\t        tracing::debug!(\n522\t            \"VPMM: Defragging or creating new pages: requested={}, free={} stream_id={}\",\n523\t            ByteSize::b(requested as u64),\n524\t            ByteSize::b(total_free_size as u64),\n525\t            stream_id\n526\t        );\n527\t\n528\t        // Find a best fit unmapped region\n529\t        let dst = self.take_unmapped_region(requested)?;\n530\t        // Sentinel value until we have a valid free region pointer from allocation\n531\t        let mut allocated_ptr = CUdeviceptr::MAX;\n532\t\n533\t        // Allocate new pages if we don't have enough free regions\n534\t        let mut allocated_dst = dst;\n535\t        let mut allocate_size = requested.saturating_sub(total_free_size);\n536\t        debug_assert_eq!(allocate_size % self.page_size, 0);\n537\t        let mut allocated_pages: Vec<(CUdeviceptr, CUmemGenericAllocationHandle)> = Vec::new();\n538\t        while allocated_dst < dst + allocate_size as u64 {\n539\t            let handle = unsafe {\n540\t                match vpmm_create_physical(self.device_id, self.page_size) {\n541\t                    Ok(handle) => handle,\n542\t                    Err(e) => {\n543\t                        tracing::error!(\n544\t                            \"vpmm_create_physical failed: device={}, page_size={}: {:?}\",\n545\t                            self.device_id,\n546\t                            self.page_size,\n547\t                            e\n548\t                        );\n549\t                        if e.is_out_of_memory() {\n550\t                            self.rollback_new_pages(dst, requested, &allocated_pages);\n551\t                            return Err(MemoryError::OutOfMemory {\n552\t                                requested: allocate_size,\n553\t                                available: (allocated_dst - dst) as usize,\n554\t                            });\n555\t                        } else {\n556\t                            return Err(MemoryError::from(e));\n557\t                        }\n558\t                    }\n559\t                }\n560\t            };\n561\t            unsafe {\n562\t                vpmm_map(allocated_dst, self.page_size, handle).map_err(|e| {\n563\t                    tracing::error!(\n564\t                        \"vpmm_map failed: addr={:#x}, page_size={}, handle={}: {:?}\",\n565\t                        allocated_dst,\n566\t                        self.page_size,\n567\t                        handle,\n568\t                        e\n569\t                    );\n570\t                    MemoryError::from(e)\n571\t                })?;\n572\t            }\n573\t            self.active_pages.insert(allocated_dst, handle);\n574\t            allocated_pages.push((allocated_dst, handle));\n575\t            allocated_dst += self.page_size as u64;\n576\t        }\n577\t        debug_assert_eq!(allocated_dst, dst + allocate_size as u64);\n578\t        if allocate_size > 0 {\n579\t            tracing::debug!(\n580\t                \"VPMM: Allocated {} bytes on stream {}. Total allocated: {}\",\n581\t                ByteSize::b(allocate_size as u64),\n582\t                stream_id,\n583\t                ByteSize::b(self.memory_usage() as u64)\n584\t            );\n585\t            unsafe {\n586\t                vpmm_set_access(dst, allocate_size, self.device_id).map_err(|e| {\n587\t                    tracing::error!(\n588\t                        \"vpmm_set_access failed: addr={:#x}, size={}, device={}: {:?}\",\n589\t                        dst,\n590\t                        allocate_size,\n591\t                        self.device_id,\n592\t                        e\n593\t                    );\n594\t                    MemoryError::from(e)\n595\t                })?;\n596\t            }\n597\t            let (merged_ptr, merged_size) = self.free_region_insert(dst, allocate_size, stream_id);\n598\t            debug_assert!(merged_size >= allocate_size);\n599\t            allocated_ptr = merged_ptr;\n600\t            allocate_size = merged_size;\n601\t        }\n602\t        // At this point, allocated_ptr is either\n603\t        // - CUdeviceptr::MAX if no allocations occurred\n604\t        // - or some pointer `<= dst` for the start of a free region (with VA-mapping) of at least\n605\t        //   `requested` bytes. The case `allocated_ptr < dst` happens if `free_region_insert`\n606\t        //   merged the allocated region with a previous free region. This only happens if the\n607\t        //   previous free region is on the same `stream_id`. In this case, we have\n608\t        //   [allocated_ptr..dst][dst..allocated_dst] which is all free and safe to use on the\n609\t        //   stream `stream_id` _without_ synchronization, because all events will be sequenced\n610\t        //   afterwards on the stream.\n611\t        let mut remaining = requested.saturating_sub(allocate_size);\n612\t        if remaining == 0 {\n613\t            debug_assert_ne!(\n614\t                allocated_ptr,\n615\t                CUdeviceptr::MAX,\n616\t                \"Allocation returned no valid free region\"\n617\t            );\n618\t            return Ok(Some(allocated_ptr));\n619\t        }\n620\t        debug_assert!(allocate_size == 0 || allocated_ptr <= dst);\n621\t\n622\t        // Pull free regions (current stream first, the other stream oldest first) until we've\n623\t        // gathered enough pages.\n624\t        let mut to_defrag: Vec<(CUdeviceptr, usize)> = Vec::new();\n625\t        let mut ordered_free_regions: Vec<_> = self\n626\t            .free_regions\n627\t            .iter()\n628\t            .filter(|(&addr, _)| allocate_size == 0 || addr != allocated_ptr)\n629\t            .map(|(&addr, region)| (region.stream_id != stream_id, region.id, addr))\n630\t            .collect();\n631\t        ordered_free_regions.sort_by_key(|(is_other, id, _)| (*is_other, *id));\n632\t        for (other_stream, _, addr) in ordered_free_regions {\n633\t            if remaining == 0 {\n634\t                break;\n635\t            }\n636\t\n637\t            let region = self\n638\t                .free_regions\n639\t                .remove(&addr)\n640\t                .expect(\"BUG: free region disappeared\");\n641\t\n642\t            if other_stream && !region.event.completed() {\n643\t                // default_stream_wait always uses current stream (= stream_id)\n644\t                default_stream_wait(&region.event)?;\n645\t            }\n646\t\n647\t            let take = remaining.min(region.size);\n648\t\n649\t            self.zombie_regions.push(ZombieRegion {\n650\t                ptr: addr,\n651\t                size: take,\n652\t                event: region.event.clone(),\n653\t            });\n654\t\n655\t            to_defrag.push((addr, take));\n656\t            remaining -= take;\n657\t\n658\t            if region.size > take {\n659\t                // Return the unused tail to the free list so it stays available.\n660\t                let leftover_addr = addr + take as u64;\n661\t                let leftover_size = region.size - take;\n662\t                let _ = self.free_region_insert(leftover_addr, leftover_size, region.stream_id);\n663\t            }\n664\t        }\n665\t        let remapped_ptr = self.remap_regions(to_defrag, allocated_dst, stream_id)?;\n666\t        // Take the minimum in case allocated_ptr is CUdeviceptr::MAX when allocate_size = 0\n667\t        let result = std::cmp::min(allocated_ptr, remapped_ptr);\n668\t        debug_assert!(allocate_size == 0 || allocated_ptr == remapped_ptr);\n669\t        debug_assert_ne!(\n670\t            result,\n671\t            CUdeviceptr::MAX,\n672\t            \"Both allocation and remapping returned no valid free region\"\n673\t        );\n674\t        Ok(Some(result))\n675\t    }\n676\t\n677\t    /// Remap a list of regions to a new base address via double-mapping.\n678\t    ///\n679\t    /// The regions are mapped consecutively starting at `dst`. The old regions remain mapped\n680\t    /// (double-mapped) and are added to `zombie_regions` by the caller for async unmap.\n681\t    ///\n682\t    /// Returns the starting pointer of the new remapped free region or `CUdeviceptr::MAX` if no\n683\t    /// remapping is needed.\n684\t    ///\n685\t    /// # Assumptions\n686\t    /// The regions are already removed from the free regions map.\n687\t    fn remap_regions(\n688\t        &mut self,\n689\t        regions: Vec<(CUdeviceptr, usize)>,\n690\t        dst: CUdeviceptr,\n691\t        stream_id: CudaStreamId,\n692\t    ) -> Result<CUdeviceptr, MemoryError> {\n693\t        if regions.is_empty() {\n694\t            // Nothing to remap; return sentinel so caller's min() picks the other operand\n695\t            return Ok(CUdeviceptr::MAX);\n696\t        }\n697\t\n698\t        let bytes_to_remap = regions.iter().map(|(_, size)| *size).sum::<usize>();\n699\t        tracing::debug!(\n700\t            \"VPMM: Remapping {} regions. Total size = {}\",\n701\t            regions.len(),\n702\t            ByteSize::b(bytes_to_remap as u64)\n703\t        );\n704\t\n705\t        let mut curr_dst = dst;\n706\t        for (region_addr, region_size) in regions {\n707\t            // Double-map: map pages to new VA (old VA remains mapped, will be cleaned up as zombie)\n708\t            let num_pages = region_size / self.page_size;\n709\t            for i in 0..num_pages {\n710\t                let page = region_addr + (i * self.page_size) as u64;\n711\t                let handle = self\n712\t                    .active_pages\n713\t                    .remove(&page)\n714\t                    .expect(\"BUG: active page not found during remapping\");\n715\t                unsafe {\n716\t                    vpmm_map(curr_dst, self.page_size, handle).map_err(|e| {\n717\t                        tracing::error!(\n718\t                            \"vpmm_map (remap) failed: dst={:#x}, page_size={}, handle={}: {:?}\",\n719\t                            curr_dst,\n720\t                            self.page_size,\n721\t                            handle,\n722\t                            e\n723\t                        );\n724\t                        MemoryError::from(e)\n725\t                    })?;\n726\t                }\n727\t                self.active_pages.insert(curr_dst, handle);\n728\t                curr_dst += self.page_size as u64;\n729\t            }\n730\t        }\n731\t\n732\t        debug_assert_eq!(curr_dst - dst, bytes_to_remap as u64);\n733\t\n734\t        // Set access permissions for the remapped region\n735\t        unsafe {\n736\t            vpmm_set_access(dst, bytes_to_remap, self.device_id).map_err(|e| {\n737\t                tracing::error!(\n738\t                    \"vpmm_set_access (remap) failed: addr={:#x}, size={}, device={}: {:?}\",\n739\t                    dst,\n740\t                    bytes_to_remap,\n741\t                    self.device_id,\n742\t                    e\n743\t                );\n744\t                MemoryError::from(e)\n745\t            })?;\n746\t        }\n747\t        let (remapped_ptr, _) = self.free_region_insert(dst, bytes_to_remap, stream_id);\n748\t        Ok(remapped_ptr)\n749\t    }\n750\t\n751\t    /// Returns the total physical memory currently mapped in this pool (in bytes).\n752\t    pub(super) fn memory_usage(&self) -> usize {\n753\t        self.active_pages.len() * self.page_size\n754\t    }\n755\t}\n756\t\n757\timpl Drop for VirtualMemoryPool {\n758\t    fn drop(&mut self) {\n759\t        current_stream_sync().unwrap();\n760\t\n761\t        // Unmap zombie regions first\n762\t        for zombie in self.zombie_regions.drain(..) {\n763\t            unsafe {\n764\t                vpmm_unmap(zombie.ptr, zombie.size).unwrap();\n765\t            }\n766\t        }\n767\t\n768\t        for (ptr, handle) in self.active_pages.drain() {\n769\t            unsafe {\n770\t                vpmm_unmap(ptr, self.page_size).unwrap();\n771\t                vpmm_release(handle).unwrap();\n772\t            }\n773\t        }\n774\t\n775\t        for root in self.roots.drain(..) {\n776\t            unsafe {\n777\t                vpmm_release_va(root, self.va_size).unwrap();\n778\t            }\n779\t        }\n780\t    }\n781\t}\n782\t\n783\timpl Default for VirtualMemoryPool {\n784\t    fn default() -> Self {\n785\t        Self::new(VpmmConfig::from_env())\n786\t    }\n787\t}\n788\t\n789\t#[allow(unused)]\n790\timpl std::fmt::Debug for VirtualMemoryPool {\n791\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n792\t        writeln!(\n793\t            f,\n794\t            \"VMPool (VA_SIZE={}, PAGE_SIZE={})\",\n795\t            ByteSize::b(self.va_size as u64),\n796\t            ByteSize::b(self.page_size as u64)\n797\t        )?;\n798\t\n799\t        let reserved = self.roots.len() * self.va_size;\n800\t        let allocated = self.memory_usage();\n801\t        let free_bytes: usize = self.free_regions.values().map(|r| r.size).sum();\n802\t        let malloc_bytes: usize = self.malloc_regions.values().sum();\n803\t        let unmapped_bytes: usize = self.unmapped_regions.values().sum();\n804\t        let zombies_bytes: usize = self.zombie_regions.iter().map(|r| r.size).sum();\n805\t\n806\t        writeln!(\n807\t            f,\n808\t            \"Total: reserved={}, allocated={}, free={}, malloc={}, unmapped={}, (zombies={})\",\n809\t            ByteSize::b(reserved as u64),\n810\t            ByteSize::b(allocated as u64),\n811\t            ByteSize::b(free_bytes as u64),\n812\t            ByteSize::b(malloc_bytes as u64),\n813\t            ByteSize::b(unmapped_bytes as u64),\n814\t            ByteSize::b(zombies_bytes as u64),\n815\t        )?;\n816\t\n817\t        let mut regions: Vec<(CUdeviceptr, usize, String)> = Vec::new();\n818\t        for (addr, region) in &self.free_regions {\n819\t            regions.push((*addr, region.size, format!(\"free (s {})\", region.stream_id)));\n820\t        }\n821\t        for (addr, size) in &self.malloc_regions {\n822\t            regions.push((*addr, *size, \"malloc\".to_string()));\n823\t        }\n824\t        for (addr, size) in &self.unmapped_regions {\n825\t            regions.push((*addr, *size, \"unmapped\".to_string()));\n826\t        }\n827\t        regions.sort_by_key(|(addr, _, _)| *addr);\n828\t\n829\t        write!(f, \"Regions: \")?;\n830\t        for (_, size, label) in regions.iter() {\n831\t            write!(f, \"[{} {}]\", label, ByteSize::b(*size as u64))?;\n832\t        }\n833\t        Ok(())\n834\t    }\n835\t}\n836\t"}]},"parent_tool_use_id":null,"session_id":"1981dd9d-874d-4abc-b721-069ca0555c62","uuid":"28fa47c5-41cb-4bb0-8022-2fe83e7c7577","timestamp":"2026-04-15T07:21:17.340Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-common/src/memory_manager/vm_pool.rs","content":"#![allow(non_camel_case_types, non_upper_case_globals, non_snake_case)]\n\nuse std::{\n    collections::{BTreeMap, HashMap},\n    ffi::c_void,\n    sync::Arc,\n};\n\nuse bytesize::ByteSize;\n\nuse super::cuda::*;\nuse crate::{\n    common::set_device,\n    error::MemoryError,\n    stream::{\n        current_stream_id, current_stream_sync, default_stream_wait, CudaEvent, CudaStreamId,\n    },\n};\n\n#[link(name = \"cudart\")]\nextern \"C\" {\n    fn cudaMemGetInfo(free_bytes: *mut usize, total_bytes: *mut usize) -> i32;\n}\n\n// ============================================================================\n// Configuration\n// ============================================================================\n\nconst DEFAULT_VA_SIZE: usize = 8 << 40; // 8 TB\n\n/// Configuration for the Virtual Memory Pool.\n///\n/// Use `VpmmConfig::from_env()` to load from environment variables,\n/// or construct directly for testing.\n#[derive(Debug, Clone)]\npub(super) struct VpmmConfig {\n    /// Page size override. If `None`, uses CUDA's minimum granularity for the device.\n    pub page_size: Option<usize>,\n    /// Virtual address space size per reserved chunk (default: 8 TB).\n    pub va_size: usize,\n    /// Number of pages to preallocate at startup (default: 0).\n    pub initial_pages: usize,\n}\n\nimpl Default for VpmmConfig {\n    fn default() -> Self {\n        Self {\n            page_size: None,\n            va_size: DEFAULT_VA_SIZE,\n            initial_pages: 0,\n        }\n    }\n}\n\nimpl VpmmConfig {\n    /// Load configuration from environment variables:\n    /// - `VPMM_PAGE_SIZE`: Page size in bytes (must be multiple of CUDA granularity)\n    /// - `VPMM_VA_SIZE`: Virtual address space size per chunk (default: 8 TB)\n    /// - `VPMM_PAGES`: Number of pages to preallocate (default: 0)\n    pub fn from_env() -> Self {\n        let page_size = std::env::var(\"VPMM_PAGE_SIZE\").ok().map(|val| {\n            let size: usize = val.parse().expect(\"VPMM_PAGE_SIZE must be a valid number\");\n            assert!(size > 0, \"VPMM_PAGE_SIZE must be > 0\");\n            size\n        });\n\n        let va_size = match std::env::var(\"VPMM_VA_SIZE\") {\n            Ok(val) => {\n                let size: usize = val.parse().expect(\"VPMM_VA_SIZE must be a valid number\");\n                assert!(size > 0, \"VPMM_VA_SIZE must be > 0\");\n                size\n            }\n            Err(_) => DEFAULT_VA_SIZE,\n        };\n\n        let initial_pages = match std::env::var(\"VPMM_PAGES\") {\n            Ok(val) => val.parse().expect(\"VPMM_PAGES must be a valid number\"),\n            Err(_) => 0,\n        };\n\n        Self {\n            page_size,\n            va_size,\n            initial_pages,\n        }\n    }\n}\n\n// ============================================================================\n// Pool Implementation\n// ============================================================================\n\n/// Metadata for a free region in the virtual address space.\n#[derive(Debug, Clone)]\nstruct FreeRegionMeta {\n    size: usize,\n    event: Arc<CudaEvent>,\n    stream_id: CudaStreamId,\n    id: usize,\n}\n\n/// Remapped region that will be unmapped when the event completes.\n#[derive(Debug)]\nstruct ZombieRegion {\n    ptr: CUdeviceptr,\n    size: usize,\n    event: Arc<CudaEvent>,\n}\n\n/// Virtual memory pool implementation.\npub(super) struct VirtualMemoryPool {\n    // Virtual address space roots\n    pub(super) roots: Vec<CUdeviceptr>,\n\n    // Map for all active pages\n    active_pages: HashMap<CUdeviceptr, CUmemGenericAllocationHandle>,\n\n    // Free regions in virtual space (sorted by address)\n    free_regions: BTreeMap<CUdeviceptr, FreeRegionMeta>,\n\n    // Active allocations: (ptr, size)\n    malloc_regions: HashMap<CUdeviceptr, usize>,\n\n    // Unmapped regions: (ptr, size)\n    unmapped_regions: BTreeMap<CUdeviceptr, usize>,\n\n    // Zombie regions: (remapped, but not unmapped yet)\n    zombie_regions: Vec<ZombieRegion>,\n\n    // Number of free calls (used to assign ids to free regions)\n    free_num: usize,\n\n    // Granularity size: (page % 2MB must be 0)\n    pub(super) page_size: usize,\n\n    // Reserved virtual address span in bytes\n    va_size: usize,\n\n    // Device ordinal\n    pub(super) device_id: i32,\n}\n\n/// # Safety\n/// `VirtualMemoryPool` is not internally synchronized. These impls are safe because\n/// all access goes through `Mutex<MemoryManager>` in the parent module.\nunsafe impl Send for VirtualMemoryPool {}\nunsafe impl Sync for VirtualMemoryPool {}\n\nimpl VirtualMemoryPool {\n    pub(super) fn new(config: VpmmConfig) -> Self {\n        let device_id = set_device().unwrap();\n\n        // Check VPMM support and resolve page_size\n        let (root, page_size, va_size) = unsafe {\n            match vpmm_check_support(device_id) {\n                Ok(_) => {\n                    let granularity = vpmm_min_granularity(device_id).unwrap();\n\n                    // Resolve page_size: use config override or device granularity\n                    let page_size = match config.page_size {\n                        Some(size) => {\n                            assert!(\n                                size > 0 && size % granularity == 0,\n                                \"VPMM_PAGE_SIZE must be > 0 and multiple of {}\",\n                                granularity\n                            );\n                            size\n                        }\n                        None => granularity,\n                    };\n\n                    // Validate va_size\n                    let va_size = config.va_size;\n                    assert!(\n                        va_size > 0 && va_size.is_multiple_of(page_size),\n                        \"VPMM_VA_SIZE must be > 0 and multiple of page size ({})\",\n                        page_size\n                    );\n\n                    // Reserve initial VA chunk\n                    let va_base = vpmm_reserve(va_size, page_size).unwrap();\n                    tracing::debug!(\n                        \"VPMM: Reserved virtual address space {} with page size {}\",\n                        ByteSize::b(va_size as u64),\n                        ByteSize::b(page_size as u64)\n                    );\n                    (va_base, page_size, va_size)\n                }\n                Err(_) => {\n                    tracing::warn!(\"VPMM not supported, falling back to cudaMallocAsync\");\n                    (0, usize::MAX, 0)\n                }\n            }\n        };\n\n        let mut pool = Self {\n            roots: vec![root],\n            active_pages: HashMap::new(),\n            free_regions: BTreeMap::new(),\n            malloc_regions: HashMap::new(),\n            unmapped_regions: if va_size > 0 {\n                BTreeMap::from_iter([(root, va_size)])\n            } else {\n                BTreeMap::new()\n            },\n            zombie_regions: Vec::new(),\n            free_num: 0,\n            page_size,\n            va_size,\n            device_id,\n        };\n\n        // Preallocate pages if requested (skip if VPMM not supported)\n        if config.initial_pages > 0 && page_size != usize::MAX {\n            let alloc_size = config.initial_pages * page_size;\n            if let Err(e) =\n                pool.defragment_or_create_new_pages(alloc_size, current_stream_id().unwrap())\n            {\n                let mut free_mem = 0usize;\n                let mut total_mem = 0usize;\n                unsafe {\n                    cudaMemGetInfo(&mut free_mem, &mut total_mem);\n                }\n                panic!(\n                    \"VPMM preallocation failed: {:?}\\n\\\n                     Config: pages={}, page_size={}\\n\\\n                     GPU Memory: free={}, total={}\",\n                    e,\n                    config.initial_pages,\n                    ByteSize::b(page_size as u64),\n                    ByteSize::b(free_mem as u64),\n                    ByteSize::b(total_mem as u64)\n                );\n            }\n        }\n\n        pool\n    }\n\n    /// Allocates memory from the pool's free regions.\n    /// Attempts defragmentation if no suitable free region exists.\n    /// Returns an error if there's insufficient memory even after defragmentation.\n    pub(super) fn malloc_internal(\n        &mut self,\n        requested: usize,\n        stream_id: CudaStreamId,\n    ) -> Result<*mut c_void, MemoryError> {\n        debug_assert!(\n            requested != 0 && requested.is_multiple_of(self.page_size),\n            \"Requested size must be a multiple of the page size\"\n        );\n\n        // Phase 0: Cleanup zombie regions\n        self.cleanup_zombie_regions();\n\n        // Phase 1: Zero-cost attempts\n        let mut best_region = self.find_best_fit(requested, stream_id);\n\n        if best_region.is_none() {\n            // Phase 2: Defragmentation\n            best_region = self.defragment_or_create_new_pages(requested, stream_id)?;\n        }\n\n        if let Some(ptr) = best_region {\n            let region = self\n                .free_regions\n                .remove(&ptr)\n                .expect(\"BUG: free region address not found after find_best_fit\");\n            debug_assert_eq!(region.stream_id, stream_id);\n\n            // If region is larger, return remainder to free list\n            if region.size > requested {\n                self.free_regions.insert(\n                    ptr + requested as u64,\n                    FreeRegionMeta {\n                        size: region.size - requested,\n                        event: region.event,\n                        stream_id,\n                        id: region.id,\n                    },\n                );\n            }\n\n            self.malloc_regions.insert(ptr, requested);\n            return Ok(ptr as *mut c_void);\n        }\n\n        Err(MemoryError::OutOfMemory {\n            requested,\n            available: self.free_regions.values().map(|r| r.size).sum(),\n        })\n    }\n\n    /// Reclaims zombie regions whose events have completed.\n    ///\n    /// Zombies are old regions that have been double-mapped to new locations during defrag.\n    /// Once the associated event completes (meaning no GPU work is using the old VA),\n    /// we can safely unmap the old VA and return it to `unmapped_regions` for reuse.\n    fn cleanup_zombie_regions(&mut self) {\n        let mut i = 0;\n        while i < self.zombie_regions.len() {\n            if self.zombie_regions[i].event.completed() {\n                let zombie = self.zombie_regions.swap_remove(i);\n                if let Err(e) = unsafe { vpmm_unmap(zombie.ptr, zombie.size) } {\n                    tracing::error!(\n                        \"vpmm_unmap (zombie) failed: addr={:#x}, size={}: {:?}\",\n                        zombie.ptr,\n                        zombie.size,\n                        e\n                    );\n                }\n                self.insert_unmapped_region(zombie.ptr, zombie.size);\n            } else {\n                i += 1;\n            }\n        }\n    }\n\n    /// Phase 1: Try to find a suitable free region without defragmentation\n    /// Returns address if found, None otherwise\n    fn find_best_fit(&mut self, requested: usize, stream_id: CudaStreamId) -> Option<CUdeviceptr> {\n        let mut candidates: Vec<(CUdeviceptr, &mut FreeRegionMeta)> = self\n            .free_regions\n            .iter_mut()\n            .filter(|(_, region)| region.size >= requested)\n            .map(|(addr, region)| (*addr, region))\n            .collect();\n\n        if candidates.is_empty() {\n            return None;\n        }\n\n        // 1a. Prefer current stream (smallest fit) - could be not completed\n        if let Some((addr, _)) = candidates\n            .iter()\n            .filter(|(_, region)| region.stream_id == stream_id)\n            .min_by_key(|(_, region)| region.size)\n        {\n            return Some(*addr);\n        }\n\n        // 1b. Other streams (smallest fit) - ONLY if already completed (no sync)\n        candidates\n            .iter_mut()\n            .filter(|(_, region)| region.event.completed())\n            .min_by_key(|(_, region)| region.size)\n            .map(|(addr, region)| {\n                region.stream_id = stream_id;\n                *addr\n            })\n    }\n\n    /// Frees a pointer and returns the size of the freed memory.\n    /// Coalesces adjacent free regions.\n    ///\n    /// # Assumptions\n    /// No CUDA streams will use the malloc region starting at `ptr` after the newly recorded event\n    /// on `stream_id` at this point in time.\n    pub(super) fn free_internal(\n        &mut self,\n        ptr: *mut c_void,\n        stream_id: CudaStreamId,\n    ) -> Result<usize, MemoryError> {\n        let ptr = ptr as CUdeviceptr;\n        let size = self\n            .malloc_regions\n            .remove(&ptr)\n            .ok_or(MemoryError::InvalidPointer)?;\n\n        let _ = self.free_region_insert(ptr, size, stream_id);\n\n        Ok(size)\n    }\n\n    /// Inserts a new free region for `(ptr, size)` into the free regions map, **possibly** merging\n    /// with existing adjacent regions. Merges only occur if the regions are both adjacent in memory\n    /// and on the same stream as `stream_id`. The new free region always records a new event on the\n    /// stream.\n    ///\n    /// Returns the starting pointer and size of the (possibly merged) free region containing `(ptr,\n    /// size)`.\n    fn free_region_insert(\n        &mut self,\n        mut ptr: CUdeviceptr,\n        mut size: usize,\n        stream_id: CudaStreamId,\n    ) -> (CUdeviceptr, usize) {\n        // Potential merge with next neighbor\n        if let Some((&next_ptr, next_region)) = self.free_regions.range(ptr + 1..).next() {\n            if next_region.stream_id == stream_id && ptr + size as u64 == next_ptr {\n                let next_region = self.free_regions.remove(&next_ptr).unwrap();\n                size += next_region.size;\n            }\n        }\n        // Potential merge with previous neighbor\n        if let Some((&prev_ptr, prev_region)) = self.free_regions.range(..ptr).next_back() {\n            if prev_region.stream_id == stream_id && prev_ptr + prev_region.size as u64 == ptr {\n                let prev_region = self.free_regions.remove(&prev_ptr).unwrap();\n                ptr = prev_ptr;\n                size += prev_region.size;\n            }\n        }\n        // Record a new event to capture the current point in the stream\n        let event = Arc::new(CudaEvent::new().unwrap());\n        event.record_on_this().unwrap();\n        // Assign an id to the free region\n        let id = self.free_num;\n        self.free_num += 1;\n\n        self.free_regions.insert(\n            ptr,\n            FreeRegionMeta {\n                size,\n                event,\n                stream_id,\n                id,\n            },\n        );\n        (ptr, size)\n    }\n\n    /// Return the base address of a virtual hole large enough for `requested` bytes.\n    ///\n    /// The returned region is not inside `free_region` or `unmapped_region` map and must be\n    /// properly handled.\n    fn take_unmapped_region(&mut self, requested: usize) -> Result<CUdeviceptr, MemoryError> {\n        debug_assert!(requested != 0);\n        debug_assert_eq!(requested % self.page_size, 0);\n\n        if let Some((&addr, &size)) = self\n            .unmapped_regions\n            .iter()\n            .filter(|(_, region_size)| **region_size >= requested)\n            .min_by_key(|(_, region_size)| *region_size)\n        {\n            self.unmapped_regions.remove(&addr);\n            if size > requested {\n                self.unmapped_regions\n                    .insert(addr + requested as u64, size - requested);\n            }\n            return Ok(addr);\n        }\n\n        let addr = unsafe {\n            vpmm_reserve(self.va_size, self.page_size).map_err(|_| MemoryError::ReserveFailed {\n                size: self.va_size,\n                page_size: self.page_size,\n            })?\n        };\n        self.roots.push(addr);\n        self.insert_unmapped_region(addr + requested as u64, self.va_size - requested);\n        Ok(addr)\n    }\n\n    /// Insert a hole back into the unmapped set, coalescing with neighbors.\n    fn insert_unmapped_region(&mut self, mut addr: CUdeviceptr, mut size: usize) {\n        if size == 0 {\n            return;\n        }\n\n        if let Some((&prev_addr, &prev_size)) = self.unmapped_regions.range(..addr).next_back() {\n            if prev_addr + prev_size as u64 == addr {\n                self.unmapped_regions.remove(&prev_addr);\n                addr = prev_addr;\n                size += prev_size;\n            }\n        }\n\n        if let Some((&next_addr, &next_size)) = self.unmapped_regions.range(addr + 1..).next() {\n            if addr + size as u64 == next_addr {\n                self.unmapped_regions.remove(&next_addr);\n                size += next_size;\n            }\n        }\n\n        self.unmapped_regions.insert(addr, size);\n    }\n\n    /// Roll back partially allocated pages when allocation fails.\n    /// Unmaps and releases any mapped pages and restores the reserved VA span.\n    fn rollback_new_pages(\n        &mut self,\n        reserved_ptr: CUdeviceptr,\n        reserved_size: usize,\n        allocated_pages: &[(CUdeviceptr, CUmemGenericAllocationHandle)],\n    ) {\n        for (addr, handle) in allocated_pages {\n            if let Err(e) = unsafe { vpmm_unmap(*addr, self.page_size) } {\n                tracing::error!(\n                    \"rollback: vpmm_unmap failed: addr={:#x}, size={}: {:?}\",\n                    addr,\n                    self.page_size,\n                    e\n                );\n            }\n            self.active_pages.remove(addr);\n            if let Err(e) = unsafe { vpmm_release(*handle) } {\n                tracing::error!(\"rollback: vpmm_release failed: handle={}: {:?}\", handle, e);\n            }\n        }\n        self.insert_unmapped_region(reserved_ptr, reserved_size);\n    }\n\n    /// Defragments the pool by reusing existing holes and, if needed, reserving more VA space.\n    /// Moves just enough pages to satisfy `requested`, keeping the remainder in place.\n    ///\n    /// The returned `pointer`, if not `None`, is guaranteed to exist as a key in the `free_regions`\n    /// map. The corresponding free region will have size `>= requested`. Note the size _may_ be\n    /// larger than requested.\n    fn defragment_or_create_new_pages(\n        &mut self,\n        requested: usize,\n        stream_id: CudaStreamId,\n    ) -> Result<Option<CUdeviceptr>, MemoryError> {\n        debug_assert_eq!(requested % self.page_size, 0);\n        if requested == 0 {\n            return Ok(None);\n        }\n\n        let total_free_size = self.free_regions.values().map(|r| r.size).sum::<usize>();\n        tracing::debug!(\n            \"VPMM: Defragging or creating new pages: requested={}, free={} stream_id={}\",\n            ByteSize::b(requested as u64),\n            ByteSize::b(total_free_size as u64),\n            stream_id\n        );\n\n        // Find a best fit unmapped region\n        let dst = self.take_unmapped_region(requested)?;\n        // Sentinel value until we have a valid free region pointer from allocation\n        let mut allocated_ptr = CUdeviceptr::MAX;\n\n        // Allocate new pages if we don't have enough free regions\n        let mut allocated_dst = dst;\n        let mut allocate_size = requested.saturating_sub(total_free_size);\n        debug_assert_eq!(allocate_size % self.page_size, 0);\n        let mut allocated_pages: Vec<(CUdeviceptr, CUmemGenericAllocationHandle)> = Vec::new();\n        while allocated_dst < dst + allocate_size as u64 {\n            let handle = unsafe {\n                match vpmm_create_physical(self.device_id, self.page_size) {\n                    Ok(handle) => handle,\n                    Err(e) => {\n                        tracing::error!(\n                            \"vpmm_create_physical failed: device={}, page_size={}: {:?}\",\n                            self.device_id,\n                            self.page_size,\n                            e\n                        );\n                        if e.is_out_of_memory() {\n                            self.rollback_new_pages(dst, requested, &allocated_pages);\n                            return Err(MemoryError::OutOfMemory {\n                                requested: allocate_size,\n                                available: (allocated_dst - dst) as usize,\n                            });\n                        } else {\n                            return Err(MemoryError::from(e));\n                        }\n                    }\n                }\n            };\n            unsafe {\n                vpmm_map(allocated_dst, self.page_size, handle).map_err(|e| {\n                    tracing::error!(\n                        \"vpmm_map failed: addr={:#x}, page_size={}, handle={}: {:?}\",\n                        allocated_dst,\n                        self.page_size,\n                        handle,\n                        e\n                    );\n                    MemoryError::from(e)\n                })?;\n            }\n            self.active_pages.insert(allocated_dst, handle);\n            allocated_pages.push((allocated_dst, handle));\n            allocated_dst += self.page_size as u64;\n        }\n        debug_assert_eq!(allocated_dst, dst + allocate_size as u64);\n        if allocate_size > 0 {\n            tracing::debug!(\n                \"VPMM: Allocated {} bytes on stream {}. Total allocated: {}\",\n                ByteSize::b(allocate_size as u64),\n                stream_id,\n                ByteSize::b(self.memory_usage() as u64)\n            );\n            unsafe {\n                vpmm_set_access(dst, allocate_size, self.device_id).map_err(|e| {\n                    tracing::error!(\n                        \"vpmm_set_access failed: addr={:#x}, size={}, device={}: {:?}\",\n                        dst,\n                        allocate_size,\n                        self.device_id,\n                        e\n                    );\n                    MemoryError::from(e)\n                })?;\n            }\n            let (merged_ptr, merged_size) = self.free_region_insert(dst, allocate_size, stream_id);\n            debug_assert!(merged_size >= allocate_size);\n            allocated_ptr = merged_ptr;\n            allocate_size = merged_size;\n        }\n        // At this point, allocated_ptr is either\n        // - CUdeviceptr::MAX if no allocations occurred\n        // - or some pointer `<= dst` for the start of a free region (with VA-mapping) of at least\n        //   `requested` bytes. The case `allocated_ptr < dst` happens if `free_region_insert`\n        //   merged the allocated region with a previous free region. This only happens if the\n        //   previous free region is on the same `stream_id`. In this case, we have\n        //   [allocated_ptr..dst][dst..allocated_dst] which is all free and safe to use on the\n        //   stream `stream_id` _without_ synchronization, because all events will be sequenced\n        //   afterwards on the stream.\n        let mut remaining = requested.saturating_sub(allocate_size);\n        if remaining == 0 {\n            debug_assert_ne!(\n                allocated_ptr,\n                CUdeviceptr::MAX,\n                \"Allocation returned no valid free region\"\n            );\n            return Ok(Some(allocated_ptr));\n        }\n        debug_assert!(allocate_size == 0 || allocated_ptr <= dst);\n\n        // Pull free regions (current stream first, the other stream oldest first) until we've\n        // gathered enough pages.\n        let mut to_defrag: Vec<(CUdeviceptr, usize)> = Vec::new();\n        let mut ordered_free_regions: Vec<_> = self\n            .free_regions\n            .iter()\n            .filter(|(&addr, _)| allocate_size == 0 || addr != allocated_ptr)\n            .map(|(&addr, region)| (region.stream_id != stream_id, region.id, addr))\n            .collect();\n        ordered_free_regions.sort_by_key(|(is_other, id, _)| (*is_other, *id));\n        for (other_stream, _, addr) in ordered_free_regions {\n            if remaining == 0 {\n                break;\n            }\n\n            let region = self\n                .free_regions\n                .remove(&addr)\n                .expect(\"BUG: free region disappeared\");\n\n            if other_stream && !region.event.completed() {\n                // default_stream_wait always uses current stream (= stream_id)\n                default_stream_wait(&region.event)?;\n            }\n\n            let take = remaining.min(region.size);\n\n            self.zombie_regions.push(ZombieRegion {\n                ptr: addr,\n                size: take,\n                event: region.event.clone(),\n            });\n\n            to_defrag.push((addr, take));\n            remaining -= take;\n\n            if region.size > take {\n                // Return the unused tail to the free list so it stays available.\n                let leftover_addr = addr + take as u64;\n                let leftover_size = region.size - take;\n                let _ = self.free_region_insert(leftover_addr, leftover_size, region.stream_id);\n            }\n        }\n        let remapped_ptr = self.remap_regions(to_defrag, allocated_dst, stream_id)?;\n        // Take the minimum in case allocated_ptr is CUdeviceptr::MAX when allocate_size = 0\n        let result = std::cmp::min(allocated_ptr, remapped_ptr);\n        debug_assert!(allocate_size == 0 || allocated_ptr == remapped_ptr);\n        debug_assert_ne!(\n            result,\n            CUdeviceptr::MAX,\n            \"Both allocation and remapping returned no valid free region\"\n        );\n        Ok(Some(result))\n    }\n\n    /// Remap a list of regions to a new base address via double-mapping.\n    ///\n    /// The regions are mapped consecutively starting at `dst`. The old regions remain mapped\n    /// (double-mapped) and are added to `zombie_regions` by the caller for async unmap.\n    ///\n    /// Returns the starting pointer of the new remapped free region or `CUdeviceptr::MAX` if no\n    /// remapping is needed.\n    ///\n    /// # Assumptions\n    /// The regions are already removed from the free regions map.\n    fn remap_regions(\n        &mut self,\n        regions: Vec<(CUdeviceptr, usize)>,\n        dst: CUdeviceptr,\n        stream_id: CudaStreamId,\n    ) -> Result<CUdeviceptr, MemoryError> {\n        if regions.is_empty() {\n            // Nothing to remap; return sentinel so caller's min() picks the other operand\n            return Ok(CUdeviceptr::MAX);\n        }\n\n        let bytes_to_remap = regions.iter().map(|(_, size)| *size).sum::<usize>();\n        tracing::debug!(\n            \"VPMM: Remapping {} regions. Total size = {}\",\n            regions.len(),\n            ByteSize::b(bytes_to_remap as u64)\n        );\n\n        let mut curr_dst = dst;\n        for (region_addr, region_size) in regions {\n            // Double-map: map pages to new VA (old VA remains mapped, will be cleaned up as zombie)\n            let num_pages = region_size / self.page_size;\n            for i in 0..num_pages {\n                let page = region_addr + (i * self.page_size) as u64;\n                let handle = self\n                    .active_pages\n                    .remove(&page)\n                    .expect(\"BUG: active page not found during remapping\");\n                unsafe {\n                    vpmm_map(curr_dst, self.page_size, handle).map_err(|e| {\n                        tracing::error!(\n                            \"vpmm_map (remap) failed: dst={:#x}, page_size={}, handle={}: {:?}\",\n                            curr_dst,\n                            self.page_size,\n                            handle,\n                            e\n                        );\n                        MemoryError::from(e)\n                    })?;\n                }\n                self.active_pages.insert(curr_dst, handle);\n                curr_dst += self.page_size as u64;\n            }\n        }\n\n        debug_assert_eq!(curr_dst - dst, bytes_to_remap as u64);\n\n        // Set access permissions for the remapped region\n        unsafe {\n            vpmm_set_access(dst, bytes_to_remap, self.device_id).map_err(|e| {\n                tracing::error!(\n                    \"vpmm_set_access (remap) failed: addr={:#x}, size={}, device={}: {:?}\",\n                    dst,\n                    bytes_to_remap,\n                    self.device_id,\n                    e\n                );\n                MemoryError::from(e)\n            })?;\n        }\n        let (remapped_ptr, _) = self.free_region_insert(dst, bytes_to_remap, stream_id);\n        Ok(remapped_ptr)\n    }\n\n    /// Returns the total physical memory currently mapped in this pool (in bytes).\n    pub(super) fn memory_usage(&self) -> usize {\n        self.active_pages.len() * self.page_size\n    }\n}\n\nimpl Drop for VirtualMemoryPool {\n    fn drop(&mut self) {\n        current_stream_sync().unwrap();\n\n        // Unmap zombie regions first\n        for zombie in self.zombie_regions.drain(..) {\n            unsafe {\n                vpmm_unmap(zombie.ptr, zombie.size).unwrap();\n            }\n        }\n\n        for (ptr, handle) in self.active_pages.drain() {\n            unsafe {\n                vpmm_unmap(ptr, self.page_size).unwrap();\n                vpmm_release(handle).unwrap();\n            }\n        }\n\n        for root in self.roots.drain(..) {\n            unsafe {\n                vpmm_release_va(root, self.va_size).unwrap();\n            }\n        }\n    }\n}\n\nimpl Default for VirtualMemoryPool {\n    fn default() -> Self {\n        Self::new(VpmmConfig::from_env())\n    }\n}\n\n#[allow(unused)]\nimpl std::fmt::Debug for VirtualMemoryPool {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        writeln!(\n            f,\n            \"VMPool (VA_SIZE={}, PAGE_SIZE={})\",\n            ByteSize::b(self.va_size as u64),\n            ByteSize::b(self.page_size as u64)\n        )?;\n\n        let reserved = self.roots.len() * self.va_size;\n        let allocated = self.memory_usage();\n        let free_bytes: usize = self.free_regions.values().map(|r| r.size).sum();\n        let malloc_bytes: usize = self.malloc_regions.values().sum();\n        let unmapped_bytes: usize = self.unmapped_regions.values().sum();\n        let zombies_bytes: usize = self.zombie_regions.iter().map(|r| r.size).sum();\n\n        writeln!(\n            f,\n            \"Total: reserved={}, allocated={}, free={}, malloc={}, unmapped={}, (zombies={})\",\n            ByteSize::b(reserved as u64),\n            ByteSize::b(allocated as u64),\n            ByteSize::b(free_bytes as u64),\n            ByteSize::b(malloc_bytes as u64),\n            ByteSize::b(unmapped_bytes as u64),\n            ByteSize::b(zombies_bytes as u64),\n        )?;\n\n        let mut regions: Vec<(CUdeviceptr, usize, String)> = Vec::new();\n        for (addr, region) in &self.free_regions {\n            regions.push((*addr, region.size, format!(\"free (s {})\", region.stream_id)));\n        }\n        for (addr, size) in &self.malloc_regions {\n            regions.push((*addr, *size, \"malloc\".to_string()));\n        }\n        for (addr, size) in &self.unmapped_regions {\n            regions.push((*addr, *size, \"unmapped\".to_string()));\n        }\n        regions.sort_by_key(|(addr, _, _)| *addr);\n\n        write!(f, \"Regions: \")?;\n        for (_, size, label) in regions.iter() {\n            write!(f, \"[{} {}]\", label, ByteSize::b(*size as u64))?;\n        }\n        Ok(())\n    }\n}\n","numLines":836,"startLine":1,"totalLines":836}}}
