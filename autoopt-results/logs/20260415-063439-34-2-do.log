               }","+                        self.active_pages.insert(va, (handle, 0));","+                        allocated_pages.push((va, handle, 0));","+                    }","+                }","+                Err(e) => return Err(MemoryError::from(e)),","+            }","+        } else {","+            // Single-page path: existing behavior for small allocations","+            for i in 0..num_new_pages {","+                let va = dst + (i * self.page_size) as u64;","+                let handle = match unsafe {","+                    vpmm_create_physical(self.device_id, self.page_size)","+                } {","+                    Ok(h) => h,","                     Err(e) => {","-                        tracing::error!(","-                            \"vpmm_create_physical failed: device={}, page_size={}: {:?}\",","-                            self.device_id,","-                            self.page_size,","-                            e","-                        );","                         if e.is_out_of_memory() {","                             self.rollback_new_pages(dst, requested, &allocated_pages);","                             return Err(MemoryError::OutOfMemory {","                                 requested: allocate_size,","-                                available: (allocated_dst - dst) as usize,","+                                available: i * self.page_size,","                             });","-                        } else {","-                            return Err(MemoryError::from(e));","                         }","+                        return Err(MemoryError::from(e));","                     }","+                };","+                unsafe {","+                    vpmm_map(va, self.page_size, handle)?;","                 }","-            };","-            unsafe {","-                vpmm_map(allocated_dst, self.page_size, handle).map_err(|e| {","-                    tracing::error!(","-                        \"vpmm_map faile