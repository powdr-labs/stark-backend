\n    prop.requestedHandleTypes = CU_MEM_HANDLE_TYPE_NONE;\n    return (int)cuMemCreate(out_h, bytes, &prop, 0);\n}\n\nint _vpmm_map(CUdeviceptr va, size_t bytes, CUmemGenericAllocationHandle h) {\n    return (int)cuMemMap(va, bytes, 0, h, 0);\n}\n\nint _vpmm_map_offset(CUdeviceptr va, size_t bytes, size_t offset, CUmemGenericAllocationHandle h) {\n    return (int)cuMemMap(va, bytes, offset, h, 0);\n}\n\nint _vpmm_set_access(CUdeviceptr va, size_t bytes, const int device_ordinal) {\n    const CUmemAccessDesc acc = {\n        .location = {\n            .type = CU_MEM_LOCATION_TYPE_DEVICE,\n            .id = device_ordinal\n        },\n        .flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE\n    };\n    return (int)cuMemSetAccess(va, bytes, &acc, 1);\n}\n\nint _vpmm_unmap(CUdeviceptr va, size_t bytes) {\n    return (int)cuMemUnmap(va, bytes);\n}\n\nint _vpmm_release(CUmemGenericAllocationHandle h) {\n    return (int)cuMemRelease(h);\n}\n\n} // extern \"C\"\n","structuredPatch":[{"oldStart":58,"oldLines":6,"newStart":58,"newLines":39,"lines":["     return (int)cuMemMap(va, bytes, offset, h, 0);"," }"," ","+// Diagnostic: test whether cuMemMap with non-zero offset works on this GPU.","+// Returns 0 on success, otherwise the failing step * 10000 + CUresult.","+int _vpmm_test_offset_mapping(int device_ordinal, size_t page_size) {","+    CUmemAllocationProp prop{};","+    prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;","+    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;","+    prop.location.id = device_ordinal;","+    prop.requestedHandleTypes = CU_MEM_HANDLE_TYPE_NONE;","+","+    size_t alloc_size = 2 * page_size;","+    CUmemGenericAllocationHandle handle;","+    CUresult r = cuMemCreate(&handle, alloc_size, &prop, 0);","+    if (r != CUDA_SUCCESS) return 10000 + (int)r;","+","+    CUdeviceptr va;","+    r = cuMemAddressReserve(&va, alloc_size, page_size, 0, 0);","+    if (r != CUDA_SUCCESS) { cuMemRelease(handle); return 20000 + (int)r; }","+","+    // Map page 0 (offset=0)