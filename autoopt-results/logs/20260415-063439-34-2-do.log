e page_size: use config override or device granularity\n                    let page_size = match config.page_size {\n                        Some(size) => {\n                            assert!(\n                                size > 0 && size % granularity == 0,\n                                \"VPMM_PAGE_SIZE must be > 0 and multiple of {}\",\n                                granularity\n                            );\n                            size\n                        }\n                        None => granularity,\n                    };\n\n                    // Validate va_size\n                    let va_size = config.va_size;\n                    assert!(\n                        va_size > 0 && va_size.is_multiple_of(page_size),\n                        \"VPMM_VA_SIZE must be > 0 and multiple of page size ({})\",","numLines":25,"startLine":152,"totalLines":836}}}
