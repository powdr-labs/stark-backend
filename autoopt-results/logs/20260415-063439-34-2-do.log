unmap(addr, self.page_size) } {\n                tracing::error!(\n                    \"rollback: vpmm_unmap failed: addr={:#x}, size={}: {:?}\",\n                    addr,\n                    self.page_size,\n                    e\n                );\n            }\n            self.active_pages.remove(&addr);\n            if released_handles.insert(handle) {\n                if let Err(e) = unsafe { vpmm_release(handle) } {\n                    tracing::error!(\n                        \"rollback: vpmm_release failed: handle={}: {:?}\",\n                        handle,\n                        e\n                    );\n                }\n            }\n        }\n        self.insert_unmapped_region(reserved_ptr, reserved_size);\n    }"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":272,"cache_read_input_tokens":59305,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":272},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"1981dd9d-874d-4abc-b721-069ca0555c62","uuid":"2b6a0c6a-8b29-4c51-a016-d9dbe4b1517b"}
