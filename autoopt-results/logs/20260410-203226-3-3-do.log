{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CoW11ZpWgJuvjW7NTJqNBU","type":"tool_result","content":"1\t#include <algorithm>\n2\t#include <cassert>\n3\t#include <cmath>\n4\t#include <cstdint>\n5\t#include <cstdio>\n6\t#include <cstdlib>\n7\t#include <utility>\n8\t#include <vector_types.h>\n9\t\n10\t#include \"codec.cuh\"\n11\t#include \"dag_entry.cuh\"\n12\t#include \"eval_config.cuh\"\n13\t#include \"fp.h\"\n14\t#include \"fpext.h\"\n15\t#include \"launcher.cuh\"\n16\t#include \"sumcheck.cuh\"\n17\t#include \"utils.cuh\"\n18\t\n19\tusing namespace symbolic_dag;\n20\t\n21\tnamespace zerocheck_round0 {\n22\t\n23\tconstexpr uint32_t BUFFER_THRESHOLD = 16;\n24\t// Threshold for switching between coset-parallel and lockstep modes.\n25\t// When num_x * skip_domain < threshold, use coset-parallel (grid.y = num_cosets) for better GPU utilization.\n26\t// When >= threshold, use lockstep (single thread handles all cosets) to avoid redundant iNTT.\n27\tconstexpr uint32_t COSET_PARALLEL_THRESHOLD = 32768; // 2^15\n28\t\n29\t// Device function to compute constraint sums for all cosets in lockstep with DAG traversal.\n30\t// This computes: sum(lambda_i * constraint_i) for all constraints, for each coset.\n31\t// NOTE: Using __inline__ instead of __forceinline__ to let compiler decide based on register pressure.\n32\ttemplate <uint32_t NUM_COSETS, bool NEEDS_SHMEM>\n33\t__device__ __inline__ void acc_constraints(\n34\t    FpExt *__restrict__ constraint_sums, // output [NUM_COSETS]\n35\t    const NttEvalContext<NUM_COSETS> &eval_ctx,\n36\t    const Fp *is_first, // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n37\t    const Fp *is_last,  // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n38\t    uint32_t x_int,\n39\t    const FpExt *__restrict__ d_lambda_pows,\n40\t    const Rule *__restrict__ d_rules,\n41\t    size_t rules_len,\n42\t    const size_t *__restrict__ d_used_nodes,\n43\t    size_t used_nodes_len,\n44\t    size_t lambda_len\n45\t) {\n46\t    size_t lambda_idx = 0;\n47\t\n48\t    // Initialize constraint sums to zero\n49\t#pragma unroll\n50\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n51\t        constraint_sums[c] = FpExt(Fp::zero());\n52\t    }\n53\t\n54\t    for (size_t node = 0; node < rules_len; ++node) {\n55\t        Rule rule = d_rules[node];\n56\t        // Lazy decoding: only decode header (op, flags, x) upfront\n57\t        RuleHeader header = decode_rule_header(rule);\n58\t\n59\t        // Evaluate x operand for all cosets\n60\t        Fp x_vals[NUM_COSETS];\n61\t        ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(x_vals, header.x, eval_ctx, is_first, is_last, x_int);\n62\t\n63\t        switch (header.op) {\n64\t        case OP_ADD: {\n65\t            // Decode y only for binary ops\n66\t            SourceInfo y_src = decode_y(rule);\n67\t            Fp y_vals[NUM_COSETS];\n68\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n69\t#pragma unroll\n70\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n71\t                x_vals[c] += y_vals[c];\n72\t            }\n73\t            break;\n74\t        }\n75\t        case OP_SUB: {\n76\t            SourceInfo y_src = decode_y(rule);\n77\t            Fp y_vals[NUM_COSETS];\n78\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n79\t#pragma unroll\n80\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n81\t                x_vals[c] -= y_vals[c];\n82\t            }\n83\t            break;\n84\t        }\n85\t        case OP_MUL: {\n86\t            SourceInfo y_src = decode_y(rule);\n87\t            Fp y_vals[NUM_COSETS];\n88\t            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n89\t#pragma unroll\n90\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n91\t                x_vals[c] *= y_vals[c];\n92\t            }\n93\t            break;\n94\t        }\n95\t        case OP_NEG:\n96\t#pragma unroll\n97\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n98\t                x_vals[c] = -x_vals[c];\n99\t            }\n100\t            break;\n101\t        case OP_VAR:\n102\t            break;\n103\t        case OP_INV:\n104\t#pragma unroll\n105\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n106\t                x_vals[c] = inv(x_vals[c]);\n107\t            }\n108\t            break;\n109\t        }\n110\t\n111\t        // Store intermediate results for all cosets\n112\t        // Decode z_index only when buffering\n113\t        if (header.buffer_result && eval_ctx.buffer_size > 0) {\n114\t            uint32_t z_index = decode_z_index(rule);\n115\t#ifdef CUDA_DEBUG\n116\t            assert(z_index < eval_ctx.buffer_size);\n117\t#endif\n118\t            // Intermediate buffer layout: [buffer_size][NUM_COSETS] per thread\n119\t#pragma unroll\n120\t            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n121\t                eval_ctx.inter_buffer[z_index * eval_ctx.buffer_stride + c] = x_vals[c];\n122\t            }\n123\t        }\n124\t\n125\t        // Accumulate constraint sums\n126\t        if (header.is_constraint) {\n127\t            while (lambda_idx < lambda_len && lambda_idx < used_nodes_len &&\n128\t                   d_used_nodes[lambda_idx] == node) {\n129\t                FpExt lambda = d_lambda_pows[lambda_idx];\n130\t                lambda_idx++;\n131\t#pragma unroll\n132\t                for (uint32_t c = 0; c < NUM_COSETS; c++) {\n133\t                    constraint_sums[c] += lambda * x_vals[c];\n134\t                }\n135\t            }\n136\t        }\n137\t    }\n138\t}\n139\t\n140\t// NTT-based kernel: Each thread handles ALL cosets in lockstep.\n141\t// Grid: (num_x_blocks, 1) - no coset dimension\n142\t// Block: (skip_domain * x_per_block)\n143\t// Thread layout: ntt_idx = threadIdx.x % skip_domain, varies fastest\n144\t//\n145\t// Key optimization: iNTT is done ONCE per trace access, then coefficient is\n146\t// used for all coset shifts + forward NTTs.\n147\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n148\t__global__ void zerocheck_ntt_evaluate_constraints_kernel(\n149\t    FpExt *__restrict__ tmp_sums_buffer,   // [num_blocks][NUM_COSETS][skip_domain]\n150\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n151\t    const Fp *__restrict__ preprocessed,\n152\t    const Fp *const *__restrict__ main_parts,\n153\t    const FpExt *__restrict__ eq_cube, // [num_x]\n154\t    const FpExt *__restrict__ d_lambda_pows,\n155\t    const Fp *__restrict__ public_values,\n156\t    const Rule *__restrict__ d_rules,\n157\t    size_t rules_len,\n158\t    const size_t *__restrict__ d_used_nodes,\n159\t    size_t used_nodes_len,\n160\t    size_t lambda_len,\n161\t    uint32_t buffer_size,\n162\t    Fp *__restrict__ d_intermediates,\n163\t    uint32_t skip_domain,\n164\t    uint32_t num_x,\n165\t    uint32_t height,\n166\t    Fp g_shift\n167\t) {\n168\t    extern __shared__ char smem[];\n169\t    // Shared memory layout:\n170\t    // - FpExt[blockDim.x]: shared_sum for reduction (reused per coset)\n171\t    // - Fp[blockDim.x]: ntt_buffers (one skip_domain-sized buffer per x_int group, only when NEEDS_SHMEM)\n172\t    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem);\n173\t    Fp *ntt_buffers_base =\n174\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FpExt)) : nullptr;\n175\t\n176\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n177\t\n178\t    // Each x_int group within the block gets its own ntt_buffer slice\n179\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n180\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n181\t\n182\t    // Thread layout: ntt_idx varies fastest, then x_int\n183\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n184\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n185\t    uint32_t const x_int_base = tidx >> l_skip;\n186\t\n187\t    // Precompute values needed for all cosets\n188\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n189\t\n190\t    // Compute is_first_mult, is_last_mult for all cosets\n191\t    uint32_t const log_height_total = __ffs(height) - 1;\n192\t    uint32_t const log_segment = min(l_skip, log_height_total);\n193\t    uint32_t const segment_size = 1u << log_segment;\n194\t    uint32_t const log_stride = l_skip - log_segment;\n195\t\n196\t    Fp is_first_mult[NUM_COSETS];\n197\t    Fp is_last_mult[NUM_COSETS];\n198\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n199\t    Fp const omega_skip_ntt =\n200\t        (l_skip == 0) ? Fp::one() : device_ntt::get_twiddle(l_skip, ntt_idx);\n201\t\n202\t    Fp g_coset = g_shift; // g^1, will iterate g^2, g^3, ...\n203\t#pragma unroll\n204\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n205\t        Fp eval_point = g_coset * omega_skip_ntt;\n206\t        Fp omega = exp_power_of_2(eval_point, log_stride);\n207\t        is_first_mult[c] = avg_gp(omega, segment_size);\n208\t        is_last_mult[c] = avg_gp(omega * eta, segment_size);\n209\t        g_coset *= g_shift; // g^(c+2) for next iteration\n210\t    }\n211\t\n212\t    // Intermediate buffer setup\n213\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD * NUM_COSETS];\n214\t    Fp *inter_buffer;\n215\t    uint32_t buffer_stride;\n216\t    if constexpr (GLOBAL) {\n217\t        // Layout: [buffer_size][num_threads][NUM_COSETS]\n218\t        inter_buffer = d_intermediates + tidx * NUM_COSETS;\n219\t        buffer_stride = gridDim.x * blockDim.x * NUM_COSETS;\n220\t    } else {\n221\t        inter_buffer = local_buffer;\n222\t        buffer_stride = NUM_COSETS;\n223\t    }\n224\t\n225\t    // Accumulate sums for all cosets\n226\t    FpExt sums[NUM_COSETS] = {};\n227\t\n228\t    // blockDim.x is guaranteed to be a multiple of 2^l_skip\n229\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n230\t\n231\t    // Initialize eval_ctx once with loop-invariant fields\n232\t    NttEvalContext<NUM_COSETS> eval_ctx{\n233\t        preprocessed,\n234\t        main_parts,\n235\t        public_values,\n236\t        inter_buffer,\n237\t        ntt_buffer,\n238\t        {}, // omega_shifts - set once below\n239\t        skip_domain,\n240\t        height,\n241\t        buffer_stride,\n242\t        buffer_size,\n243\t        ntt_idx,\n244\t    };\n245\t    // Compute omega_shifts directly into context using iterative multiplication\n246\t    Fp const omega_shift_base = pow(g_shift, ntt_idx_rev);\n247\t    Fp omega_shift = omega_shift_base;\n248\t#pragma unroll\n249\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n250\t        eval_ctx.omega_shifts[c] = omega_shift;\n251\t        omega_shift *= omega_shift_base;\n252\t    }\n253\t\n254\t    // Tile across x_int to save intermediate buffer size\n255\t    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n256\t        // Compute per-iteration selectors as fresh local values\n257\t        Fp is_first[NUM_COSETS];\n258\t        Fp is_last[NUM_COSETS];\n259\t#pragma unroll\n260\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n261\t            is_first[c] = is_first_mult[c] * selectors_cube[x_int];\n262\t            is_last[c] = is_last_mult[c] * selectors_cube[2 * num_x + x_int];\n263\t        }\n264\t\n265\t        FpExt constraint_sums[NUM_COSETS];\n266\t        acc_constraints<NUM_COSETS, NEEDS_SHMEM>(\n267\t            constraint_sums,\n268\t            eval_ctx,\n269\t            is_first,\n270\t            is_last,\n271\t            x_int,\n272\t            d_lambda_pows,\n273\t            d_rules,\n274\t            rules_len,\n275\t            d_used_nodes,\n276\t            used_nodes_len,\n277\t            lambda_len\n278\t        );\n279\t\n280\t        FpExt eq = eq_cube[x_int];\n281\t#pragma unroll\n282\t        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n283\t            sums[c] += constraint_sums[c] * eq;\n284\t        }\n285\t    }\n286\t\n287\t    // Reduction: one coset at a time to minimize shared memory\n288\t    // Recompute eval_point and zerofier on demand (saves registers during main loop)\n289\t    g_coset = g_shift; // reset to g^1\n290\t#pragma unroll\n291\t    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n292\t        Fp eval_point = g_coset * omega_skip_ntt;\n293\t        Fp zerofier = exp_power_of_2(eval_point, l_skip) - Fp::one();\n294\t\n295\t        // We assume g_shift is not in skip domain and since we use (c+1) power,\n296\t        // eval_point is never in skip domain. Hence zerofier is never zero.\n297\t        shared_sum[threadIdx.x] = sums[c] * inv(zerofier);\n298\t        __syncthreads();\n299\t\n300\t        if (threadIdx.x < skip_domain) {\n301\t            FpExt tile_sum = shared_sum[threadIdx.x];\n302\t            for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n303\t                tile_sum += shared_sum[(lane << l_skip) + threadIdx.x];\n304\t            }\n305\t            // Output layout: [num_blocks][NUM_COSETS * skip_domain]\n306\t            // This matches final_reduce_block_sums expected layout [num_blocks][d]\n307\t            tmp_sums_buffer[blockIdx.x * NUM_COSETS * skip_domain + c * skip_domain + ntt_idx] =\n308\t                tile_sum;\n309\t        }\n310\t        __syncthreads();\n311\t        g_coset *= g_shift;\n312\t    }\n313\t}\n314\t\n315\t__global__ void fold_selectors_round0_kernel(\n316\t    FpExt *out,\n317\t    const Fp *in,\n318\t    FpExt is_first,\n319\t    FpExt is_last,\n320\t    uint32_t num_x\n321\t) {\n322\t    size_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n323\t    if (tidx >= num_x)\n324\t        return;\n325\t\n326\t    out[tidx] = is_first * in[tidx];                              // is_first\n327\t    out[2 * num_x + tidx] = is_last * in[2 * num_x + tidx];       // is_last\n328\t    out[num_x + tidx] = FpExt(Fp::one()) - out[2 * num_x + tidx]; // is_transition\n329\t}\n330\t\n331\t// Coset-parallel kernel: grid.y = num_cosets, each block handles ONE coset.\n332\t// Uses acc_constraints<1, NEEDS_SHMEM> with explicit parameter passing.\n333\t// Use when num_x * skip_domain is small for better GPU utilization.\n334\ttemplate <bool GLOBAL, bool NEEDS_SHMEM>\n335\t__global__ void zerocheck_ntt_evaluate_constraints_coset_parallel_kernel(\n336\t    FpExt *__restrict__ tmp_sums_buffer,   // [num_blocks][num_cosets * skip_domain]\n337\t    const Fp *__restrict__ selectors_cube, // [3][num_x]\n338\t    const Fp *__restrict__ preprocessed,\n339\t    const Fp *const *__restrict__ main_parts,\n340\t    const FpExt *__restrict__ eq_cube, // [num_x]\n341\t    const FpExt *__restrict__ d_lambda_pows,\n342\t    const Fp *__restrict__ public_values,\n343\t    const Rule *__restrict__ d_rules,\n344\t    size_t rules_len,\n345\t    const size_t *__restrict__ d_used_nodes,\n346\t    size_t used_nodes_len,\n347\t    size_t lambda_len,\n348\t    uint32_t buffer_size,\n349\t    Fp *__restrict__ d_intermediates,\n350\t    uint32_t skip_domain,\n351\t    uint32_t num_x,\n352\t    uint32_t height,\n353\t    Fp g_shift\n354\t) {\n355\t    extern __shared__ char smem[];\n356\t    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem);\n357\t    Fp *ntt_buffers_base =\n358\t        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FpExt)) : nullptr;\n359\t\n360\t    uint32_t const l_skip = __ffs(skip_domain) - 1;\n361\t    uint32_t const num_cosets = gridDim.y;\n362\t\n363\t    // Each x_int group within the block gets its own ntt_buffer slice\n364\t    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n365\t    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n366\t\n367\t    // Thread layout: ntt_idx varies fastest, then x_int\n368\t    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n369\t    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n370\t    uint32_t const x_int_base = tidx >> l_skip;\n371\t\n372\t    // KEY DIFFERENCE: coset_idx from blockIdx.y\n373\t    uint32_t const coset_idx = blockIdx.y;\n374\t\n375\t    // Precompute values for this single coset\n376\t    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n377\t\n378\t    uint32_t const log_height_total = __ffs(height) - 1;\n379\t    uint32_t const log_segment = min(l_skip, log_height_total);\n380\t    uint32_t const segment_size = 1u << log_segment;\n381\t    uint32_t const log_stride = l_skip - log_segment;\n382\t\n383\t    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n384\t    Fp const omega_skip_ntt =\n385\t        (l_skip == 0) ? Fp::one() : device_ntt::get_twiddle(l_skip, ntt_idx);\n386\t\n387\t    // Compute for single coset: g^(coset_idx + 1)\n388\t    Fp const g_coset = pow(g_shift, coset_idx + 1);\n389\t    Fp const eval_point = g_coset * omega_skip_ntt;\n390\t    Fp const omega = exp_power_of_2(eval_point, log_stride);\n391\t    Fp const is_first_mult = avg_gp(omega, segment_size);\n392\t    Fp const is_last_mult = avg_gp(omega * eta, segment_size);\n393\t    Fp const omega_shift = pow(g_coset, ntt_idx_rev);\n394\t\n395\t    // Intermediate buffer setup (single coset, no NUM_COSETS multiplier)\n396\t    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD];\n397\t    Fp *inter_buffer;\n398\t    uint32_t buffer_stride;\n399\t    if constexpr (GLOBAL) {\n400\t        // Layout: [buffer_size][num_cosets * num_threads_per_coset]\n401\t        uint32_t global_tidx = coset_idx * gridDim.x * blockDim.x + tidx;\n402\t        inter_buffer = d_intermediates + global_tidx;\n403\t        buffer_stride = gridDim.x * gridDim.y * blockDim.x;\n404\t    } else {\n405\t        inter_buffer = local_buffer;\n406\t        buffer_stride = 1;\n407\t    }\n408\t\n409\t    FpExt sum = FpExt(Fp::zero());\n410\t\n411\t    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n412\t\n413\t    // Single-coset context (NUM_COSETS=1), loop-invariant fields only\n414\t    NttEvalContext<1> eval_ctx{\n415\t        preprocessed,\n416\t        main_parts,\n417\t        public_values,\n418\t        inter_buffer,\n419\t        ntt_buffer,\n420\t        {omega_shift}, // omega_shifts[1]\n421\t        skip_domain,\n422\t        height,\n423\t        buffer_stride,\n424\t        buffer_size,\n425\t        ntt_idx,\n426\t    };\n427\t\n428\t    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n429\t        Fp is_first = is_first_mult * selectors_cube[x_int];\n430\t        Fp is_last = is_last_mult * selectors_cube[2 * num_x + x_int];\n431\t\n432\t        FpExt constraint_sums[1];\n433\t        acc_constraints<1, NEEDS_SHMEM>(\n434\t            constraint_sums,\n435\t            eval_ctx,\n436\t            &is_first,\n437\t            &is_last,\n438\t            x_int,\n439\t            d_lambda_pows,\n440\t            d_rules,\n441\t            rules_len,\n442\t            d_used_nodes,\n443\t            used_nodes_len,\n444\t            lambda_len\n445\t        );\n446\t\n447\t        sum += constraint_sums[0] * eq_cube[x_int];\n448\t    }\n449\t\n450\t    // Single-coset reduction (no loop over cosets)\n451\t    Fp zerofier = exp_power_of_2(eval_point, l_skip) - Fp::one();\n452\t    // We assume g_shift is not in skip domain and since we use (c+1) power,\n453\t    // eval_point is never in skip domain. Hence zerofier is never zero.\n454\t    shared_sum[threadIdx.x] = sum * inv(zerofier);\n455\t    __syncthreads();\n456\t\n457\t    if (threadIdx.x < skip_domain) {\n458\t        FpExt tile_sum = shared_sum[threadIdx.x];\n459\t        for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n460\t            tile_sum += shared_sum[(lane << l_skip) + threadIdx.x];\n461\t        }\n462\t        // Output layout: [num_x_blocks][num_cosets * skip_domain]\n463\t        // Same as lockstep to ensure final_reduce_block_sums works unchanged\n464\t        tmp_sums_buffer[blockIdx.x * num_cosets * skip_domain + coset_idx * skip_domain + ntt_idx] =\n465\t            tile_sum;\n466\t    }\n467\t}\n468\t\n469\t// ============================================================================\n470\t// LAUNCHERS\n471\t// ============================================================================\n472\tconstexpr uint32_t MAX_THREADS = 128;\n473\t\n474\t// Helper to determine which mode to use based on threshold\n475\tinline bool use_coset_parallel_mode(uint32_t num_x, uint32_t skip_domain) {\n476\t    return (num_x * skip_domain) < COSET_PARALLEL_THRESHOLD;\n477\t}\n478\t\n479\t// (Not a launcher) Utility function to calculate required size of temp sum buffer.\n480\t// Required length of *temp_sum_buffer in FpExt elements\n481\textern \"C\" size_t _zerocheck_r0_temp_sums_buffer_size(\n482\t    uint32_t buffer_size,\n483\t    uint32_t skip_domain,\n484\t    uint32_t num_x,\n485\t    uint32_t num_cosets,\n486\t    size_t max_temp_bytes\n487\t) {\n488\t    // Both modes use the same buffer size formula\n489\t    return DISPATCH_BOOL(\n490\t        round0_config_impl::temp_sums_buffer_size,\n491\t        use_coset_parallel_mode(num_x, skip_domain),\n492\t        buffer_size,\n493\t        skip_domain,\n494\t        num_x,\n495\t        num_cosets,\n496\t        max_temp_bytes,\n497\t        BUFFER_THRESHOLD,\n498\t        MAX_THREADS\n499\t    );\n500\t}\n501\t\n502\textern \"C\" size_t _zerocheck_r0_intermediates_buffer_size(\n503\t    uint32_t buffer_size,\n504\t    uint32_t skip_domain,\n505\t    uint32_t num_x,\n506\t    uint32_t num_cosets,\n507\t    size_t max_temp_bytes\n508\t) {\n509\t    // Both modes use the same buffer size formula\n510\t    return DISPATCH_BOOL(\n511\t        round0_config_impl::intermediates_buffer_size,\n512\t        use_coset_parallel_mode(num_x, skip_domain),\n513\t        buffer_size,\n514\t        skip_domain,\n515\t        num_x,\n516\t        num_cosets,\n517\t        max_temp_bytes,\n518\t        BUFFER_THRESHOLD,\n519\t        MAX_THREADS\n520\t    );\n521\t}\n522\t\n523\ttemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n524\tint launch_zerocheck_ntt_evaluate_constraints(\n525\t    FpExt *tmp_sums_buffer,\n526\t    FpExt *output,\n527\t    const Fp *selectors_cube, // [3][num_x]\n528\t    const Fp *preprocessed,\n529\t    const Fp *const *main_parts,\n530\t    const FpExt *eq_cube, // [num_x]\n531\t    const FpExt *d_lambda_pows,\n532\t    const Fp *public_values,\n533\t    const Rule *d_rules,\n534\t    size_t rules_len,\n535\t    const size_t *d_used_nodes,\n536\t    size_t used_nodes_len,\n537\t    size_t lambda_len,\n538\t    uint32_t buffer_size,\n539\t    Fp *d_intermediates,\n540\t    uint32_t skip_domain,\n541\t    uint32_t num_x,\n542\t    uint32_t height,\n543\t    Fp g_shift,\n544\t    size_t max_temp_bytes\n545\t) {\n546\t    auto [grid, block] = coset_round0_config::eval_constraints_launch_params(\n547\t        buffer_size, skip_domain, num_x, NUM_COSETS, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n548\t    );\n549\t\n550\t    size_t shared_sum_size = sizeof(FpExt) * block.x;\n551\t    // NTT buffers: one skip_domain-sized buffer per x_int group in the block\n552\t    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n553\t    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n554\t\n555\t    zerocheck_ntt_evaluate_constraints_kernel<NUM_COSETS, GLOBAL, NEEDS_SHMEM>\n556\t        <<<grid, block, shmem_bytes>>>(\n557\t            tmp_sums_buffer,\n558\t            selectors_cube,\n559\t            preprocessed,\n560\t            main_parts,\n561\t            eq_cube,\n562\t            d_lambda_pows,\n563\t            public_values,\n564\t            d_rules,\n565\t            rules_len,\n566\t            d_used_nodes,\n567\t            used_nodes_len,\n568\t            lambda_len,\n569\t            buffer_size,\n570\t            d_intermediates,\n571\t            skip_domain,\n572\t            num_x,\n573\t            height,\n574\t            g_shift\n575\t        );\n576\t    int err = CHECK_KERNEL();\n577\t    if (err != 0) {\n578\t        return err;\n579\t    }\n580\t\n581\t    // Final reduction: sum across all x_int blocks for each (coset, ntt_idx)\n582\t    auto num_blocks = grid.x;\n583\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n584\t    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n585\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n586\t    sumcheck::final_reduce_block_sums<<<NUM_COSETS * skip_domain, reduce_block, reduce_shmem>>>(\n587\t        tmp_sums_buffer, output, num_blocks\n588\t    );\n589\t\n590\t    return CHECK_KERNEL();\n591\t}\n592\t\n593\t// Generate dispatcher for num_cosets (1-4) x is_global x needs_shmem\n594\tDEFINE_DISPATCH_N_B1_B2(dispatch_zerocheck, launch_zerocheck_ntt_evaluate_constraints, 4)\n595\t\n596\t// Coset-parallel launcher: uses grid.y = num_cosets, each block handles one coset\n597\ttemplate <bool GLOBAL, bool NEEDS_SHMEM>\n598\tint launch_zerocheck_coset_parallel(\n599\t    FpExt *tmp_sums_buffer,\n600\t    FpExt *output,\n601\t    const Fp *selectors_cube,\n602\t    const Fp *preprocessed,\n603\t    const Fp *const *main_parts,\n604\t    const FpExt *eq_cube,\n605\t    const FpExt *d_lambda_pows,\n606\t    const Fp *public_values,\n607\t    const Rule *d_rules,\n608\t    size_t rules_len,\n609\t    const size_t *d_used_nodes,\n610\t    size_t used_nodes_len,\n611\t    size_t lambda_len,\n612\t    uint32_t buffer_size,\n613\t    Fp *d_intermediates,\n614\t    uint32_t skip_domain,\n615\t    uint32_t num_x,\n616\t    uint32_t height,\n617\t    uint32_t num_cosets,\n618\t    Fp g_shift,\n619\t    size_t max_temp_bytes\n620\t) {\n621\t    auto [grid, block] = coset_parallel_round0_config::eval_constraints_launch_params(\n622\t        buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n623\t    );\n624\t\n625\t    size_t shared_sum_size = sizeof(FpExt) * block.x;\n626\t    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n627\t    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n628\t\n629\t    zerocheck_ntt_evaluate_constraints_coset_parallel_kernel<GLOBAL, NEEDS_SHMEM>\n630\t        <<<grid, block, shmem_bytes>>>(\n631\t            tmp_sums_buffer,\n632\t            selectors_cube,\n633\t            preprocessed,\n634\t            main_parts,\n635\t            eq_cube,\n636\t            d_lambda_pows,\n637\t            public_values,\n638\t            d_rules,\n639\t            rules_len,\n640\t            d_used_nodes,\n641\t            used_nodes_len,\n642\t            lambda_len,\n643\t            buffer_size,\n644\t            d_intermediates,\n645\t            skip_domain,\n646\t            num_x,\n647\t            height,\n648\t            g_shift\n649\t        );\n650\t    int err = CHECK_KERNEL();\n651\t    if (err != 0) {\n652\t        return err;\n653\t    }\n654\t\n655\t    // Final reduction: same as lockstep - sum across all x_int blocks for each (coset, ntt_idx)\n656\t    auto num_blocks = grid.x;\n657\t    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n658\t    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n659\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n660\t    sumcheck::final_reduce_block_sums<<<num_cosets * skip_domain, reduce_block, reduce_shmem>>>(\n661\t        tmp_sums_buffer, output, num_blocks\n662\t    );\n663\t\n664\t    return CHECK_KERNEL();\n665\t}\n666\t\n667\textern \"C\" int _zerocheck_ntt_eval_constraints(\n668\t    FpExt *tmp_sums_buffer,   // [num_blocks][num_cosets * skip_domain]\n669\t    FpExt *output,            // [num_cosets * skip_domain]\n670\t    const Fp *selectors_cube, // [3][num_x]\n671\t    const Fp *preprocessed,\n672\t    const Fp *const *main_parts,\n673\t    const FpExt *eq_cube, // [num_x]\n674\t    const FpExt *d_lambda_pows,\n675\t    const Fp *public_values,\n676\t    const Rule *d_rules,\n677\t    size_t rules_len,\n678\t    const size_t *d_used_nodes,\n679\t    size_t used_nodes_len,\n680\t    size_t lambda_len,\n681\t    uint32_t buffer_size,\n682\t    Fp *d_intermediates,\n683\t    uint32_t skip_domain,\n684\t    uint32_t num_x,\n685\t    uint32_t height,\n686\t    uint32_t num_cosets,\n687\t    Fp g_shift,\n688\t    size_t max_temp_bytes\n689\t) {\n690\t    bool is_global = buffer_size > BUFFER_THRESHOLD;\n691\t    bool needs_shmem = skip_domain > WARP_SIZE;\n692\t\n693\t#define KERNEL_ARGS                                                                                \\\n694\t    tmp_sums_buffer, output, selectors_cube, preprocessed, main_parts, eq_cube, d_lambda_pows,     \\\n695\t        public_values, d_rules, rules_len, d_used_nodes, used_nodes_len, lambda_len, buffer_size,  \\\n696\t        d_intermediates, skip_domain, num_x, height\n697\t\n698\t    // Threshold-based dispatch: use coset-parallel for small workloads\n699\t    if (use_coset_parallel_mode(num_x, skip_domain)) {\n700\t        // Coset-parallel mode: grid.y = num_cosets, each block handles one coset\n701\t        return DISPATCH_BOOL_PAIR(\n702\t            launch_zerocheck_coset_parallel,\n703\t            is_global,\n704\t            needs_shmem,\n705\t            KERNEL_ARGS,\n706\t            num_cosets,\n707\t            g_shift,\n708\t            max_temp_bytes\n709\t        );\n710\t    } else {\n711\t        // Lockstep mode: single thread handles all cosets\n712\t        return dispatch_zerocheck(\n713\t            num_cosets, is_global, needs_shmem, KERNEL_ARGS, g_shift, max_temp_bytes\n714\t        );\n715\t    }\n716\t#undef KERNEL_ARGS\n717\t}\n718\t\n719\textern \"C\" int _fold_selectors_round0(\n720\t    FpExt *out,\n721\t    const Fp *in,\n722\t    FpExt is_first,\n723\t    FpExt is_last,\n724\t    uint32_t num_x\n725\t) {\n726\t    auto [grid, block] = kernel_launch_params(num_x);\n727\t    fold_selectors_round0_kernel<<<grid, block>>>(out, in, is_first, is_last, num_x);\n728\t    return CHECK_KERNEL();\n729\t}\n730\t\n731\t} // namespace zerocheck_round0\n732\t"}]},"parent_tool_use_id":null,"session_id":"297e37a8-7de7-4f8d-9cb1-f45048fd2150","uuid":"e5afcfa6-565f-45b9-89a7-74382306922b","timestamp":"2026-04-10T22:01:22.199Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/cuda/src/logup_zerocheck/zerocheck_round0.cu","content":"#include <algorithm>\n#include <cassert>\n#include <cmath>\n#include <cstdint>\n#include <cstdio>\n#include <cstdlib>\n#include <utility>\n#include <vector_types.h>\n\n#include \"codec.cuh\"\n#include \"dag_entry.cuh\"\n#include \"eval_config.cuh\"\n#include \"fp.h\"\n#include \"fpext.h\"\n#include \"launcher.cuh\"\n#include \"sumcheck.cuh\"\n#include \"utils.cuh\"\n\nusing namespace symbolic_dag;\n\nnamespace zerocheck_round0 {\n\nconstexpr uint32_t BUFFER_THRESHOLD = 16;\n// Threshold for switching between coset-parallel and lockstep modes.\n// When num_x * skip_domain < threshold, use coset-parallel (grid.y = num_cosets) for better GPU utilization.\n// When >= threshold, use lockstep (single thread handles all cosets) to avoid redundant iNTT.\nconstexpr uint32_t COSET_PARALLEL_THRESHOLD = 32768; // 2^15\n\n// Device function to compute constraint sums for all cosets in lockstep with DAG traversal.\n// This computes: sum(lambda_i * constraint_i) for all constraints, for each coset.\n// NOTE: Using __inline__ instead of __forceinline__ to let compiler decide based on register pressure.\ntemplate <uint32_t NUM_COSETS, bool NEEDS_SHMEM>\n__device__ __inline__ void acc_constraints(\n    FpExt *__restrict__ constraint_sums, // output [NUM_COSETS]\n    const NttEvalContext<NUM_COSETS> &eval_ctx,\n    const Fp *is_first, // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n    const Fp *is_last,  // [NUM_COSETS] per-coset selectors, passed explicitly per x_int\n    uint32_t x_int,\n    const FpExt *__restrict__ d_lambda_pows,\n    const Rule *__restrict__ d_rules,\n    size_t rules_len,\n    const size_t *__restrict__ d_used_nodes,\n    size_t used_nodes_len,\n    size_t lambda_len\n) {\n    size_t lambda_idx = 0;\n\n    // Initialize constraint sums to zero\n#pragma unroll\n    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n        constraint_sums[c] = FpExt(Fp::zero());\n    }\n\n    for (size_t node = 0; node < rules_len; ++node) {\n        Rule rule = d_rules[node];\n        // Lazy decoding: only decode header (op, flags, x) upfront\n        RuleHeader header = decode_rule_header(rule);\n\n        // Evaluate x operand for all cosets\n        Fp x_vals[NUM_COSETS];\n        ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(x_vals, header.x, eval_ctx, is_first, is_last, x_int);\n\n        switch (header.op) {\n        case OP_ADD: {\n            // Decode y only for binary ops\n            SourceInfo y_src = decode_y(rule);\n            Fp y_vals[NUM_COSETS];\n            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                x_vals[c] += y_vals[c];\n            }\n            break;\n        }\n        case OP_SUB: {\n            SourceInfo y_src = decode_y(rule);\n            Fp y_vals[NUM_COSETS];\n            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                x_vals[c] -= y_vals[c];\n            }\n            break;\n        }\n        case OP_MUL: {\n            SourceInfo y_src = decode_y(rule);\n            Fp y_vals[NUM_COSETS];\n            ntt_eval_dag_entry<NUM_COSETS, NEEDS_SHMEM>(y_vals, y_src, eval_ctx, is_first, is_last, x_int);\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                x_vals[c] *= y_vals[c];\n            }\n            break;\n        }\n        case OP_NEG:\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                x_vals[c] = -x_vals[c];\n            }\n            break;\n        case OP_VAR:\n            break;\n        case OP_INV:\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                x_vals[c] = inv(x_vals[c]);\n            }\n            break;\n        }\n\n        // Store intermediate results for all cosets\n        // Decode z_index only when buffering\n        if (header.buffer_result && eval_ctx.buffer_size > 0) {\n            uint32_t z_index = decode_z_index(rule);\n#ifdef CUDA_DEBUG\n            assert(z_index < eval_ctx.buffer_size);\n#endif\n            // Intermediate buffer layout: [buffer_size][NUM_COSETS] per thread\n#pragma unroll\n            for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                eval_ctx.inter_buffer[z_index * eval_ctx.buffer_stride + c] = x_vals[c];\n            }\n        }\n\n        // Accumulate constraint sums\n        if (header.is_constraint) {\n            while (lambda_idx < lambda_len && lambda_idx < used_nodes_len &&\n                   d_used_nodes[lambda_idx] == node) {\n                FpExt lambda = d_lambda_pows[lambda_idx];\n                lambda_idx++;\n#pragma unroll\n                for (uint32_t c = 0; c < NUM_COSETS; c++) {\n                    constraint_sums[c] += lambda * x_vals[c];\n                }\n            }\n        }\n    }\n}\n\n// NTT-based kernel: Each thread handles ALL cosets in lockstep.\n// Grid: (num_x_blocks, 1) - no coset dimension\n// Block: (skip_domain * x_per_block)\n// Thread layout: ntt_idx = threadIdx.x % skip_domain, varies fastest\n//\n// Key optimization: iNTT is done ONCE per trace access, then coefficient is\n// used for all coset shifts + forward NTTs.\ntemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\n__global__ void zerocheck_ntt_evaluate_constraints_kernel(\n    FpExt *__restrict__ tmp_sums_buffer,   // [num_blocks][NUM_COSETS][skip_domain]\n    const Fp *__restrict__ selectors_cube, // [3][num_x]\n    const Fp *__restrict__ preprocessed,\n    const Fp *const *__restrict__ main_parts,\n    const FpExt *__restrict__ eq_cube, // [num_x]\n    const FpExt *__restrict__ d_lambda_pows,\n    const Fp *__restrict__ public_values,\n    const Rule *__restrict__ d_rules,\n    size_t rules_len,\n    const size_t *__restrict__ d_used_nodes,\n    size_t used_nodes_len,\n    size_t lambda_len,\n    uint32_t buffer_size,\n    Fp *__restrict__ d_intermediates,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t height,\n    Fp g_shift\n) {\n    extern __shared__ char smem[];\n    // Shared memory layout:\n    // - FpExt[blockDim.x]: shared_sum for reduction (reused per coset)\n    // - Fp[blockDim.x]: ntt_buffers (one skip_domain-sized buffer per x_int group, only when NEEDS_SHMEM)\n    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem);\n    Fp *ntt_buffers_base =\n        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FpExt)) : nullptr;\n\n    uint32_t const l_skip = __ffs(skip_domain) - 1;\n\n    // Each x_int group within the block gets its own ntt_buffer slice\n    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n\n    // Thread layout: ntt_idx varies fastest, then x_int\n    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n    uint32_t const x_int_base = tidx >> l_skip;\n\n    // Precompute values needed for all cosets\n    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n\n    // Compute is_first_mult, is_last_mult for all cosets\n    uint32_t const log_height_total = __ffs(height) - 1;\n    uint32_t const log_segment = min(l_skip, log_height_total);\n    uint32_t const segment_size = 1u << log_segment;\n    uint32_t const log_stride = l_skip - log_segment;\n\n    Fp is_first_mult[NUM_COSETS];\n    Fp is_last_mult[NUM_COSETS];\n    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n    Fp const omega_skip_ntt =\n        (l_skip == 0) ? Fp::one() : device_ntt::get_twiddle(l_skip, ntt_idx);\n\n    Fp g_coset = g_shift; // g^1, will iterate g^2, g^3, ...\n#pragma unroll\n    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n        Fp eval_point = g_coset * omega_skip_ntt;\n        Fp omega = exp_power_of_2(eval_point, log_stride);\n        is_first_mult[c] = avg_gp(omega, segment_size);\n        is_last_mult[c] = avg_gp(omega * eta, segment_size);\n        g_coset *= g_shift; // g^(c+2) for next iteration\n    }\n\n    // Intermediate buffer setup\n    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD * NUM_COSETS];\n    Fp *inter_buffer;\n    uint32_t buffer_stride;\n    if constexpr (GLOBAL) {\n        // Layout: [buffer_size][num_threads][NUM_COSETS]\n        inter_buffer = d_intermediates + tidx * NUM_COSETS;\n        buffer_stride = gridDim.x * blockDim.x * NUM_COSETS;\n    } else {\n        inter_buffer = local_buffer;\n        buffer_stride = NUM_COSETS;\n    }\n\n    // Accumulate sums for all cosets\n    FpExt sums[NUM_COSETS] = {};\n\n    // blockDim.x is guaranteed to be a multiple of 2^l_skip\n    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n\n    // Initialize eval_ctx once with loop-invariant fields\n    NttEvalContext<NUM_COSETS> eval_ctx{\n        preprocessed,\n        main_parts,\n        public_values,\n        inter_buffer,\n        ntt_buffer,\n        {}, // omega_shifts - set once below\n        skip_domain,\n        height,\n        buffer_stride,\n        buffer_size,\n        ntt_idx,\n    };\n    // Compute omega_shifts directly into context using iterative multiplication\n    Fp const omega_shift_base = pow(g_shift, ntt_idx_rev);\n    Fp omega_shift = omega_shift_base;\n#pragma unroll\n    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n        eval_ctx.omega_shifts[c] = omega_shift;\n        omega_shift *= omega_shift_base;\n    }\n\n    // Tile across x_int to save intermediate buffer size\n    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n        // Compute per-iteration selectors as fresh local values\n        Fp is_first[NUM_COSETS];\n        Fp is_last[NUM_COSETS];\n#pragma unroll\n        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n            is_first[c] = is_first_mult[c] * selectors_cube[x_int];\n            is_last[c] = is_last_mult[c] * selectors_cube[2 * num_x + x_int];\n        }\n\n        FpExt constraint_sums[NUM_COSETS];\n        acc_constraints<NUM_COSETS, NEEDS_SHMEM>(\n            constraint_sums,\n            eval_ctx,\n            is_first,\n            is_last,\n            x_int,\n            d_lambda_pows,\n            d_rules,\n            rules_len,\n            d_used_nodes,\n            used_nodes_len,\n            lambda_len\n        );\n\n        FpExt eq = eq_cube[x_int];\n#pragma unroll\n        for (uint32_t c = 0; c < NUM_COSETS; c++) {\n            sums[c] += constraint_sums[c] * eq;\n        }\n    }\n\n    // Reduction: one coset at a time to minimize shared memory\n    // Recompute eval_point and zerofier on demand (saves registers during main loop)\n    g_coset = g_shift; // reset to g^1\n#pragma unroll\n    for (uint32_t c = 0; c < NUM_COSETS; c++) {\n        Fp eval_point = g_coset * omega_skip_ntt;\n        Fp zerofier = exp_power_of_2(eval_point, l_skip) - Fp::one();\n\n        // We assume g_shift is not in skip domain and since we use (c+1) power,\n        // eval_point is never in skip domain. Hence zerofier is never zero.\n        shared_sum[threadIdx.x] = sums[c] * inv(zerofier);\n        __syncthreads();\n\n        if (threadIdx.x < skip_domain) {\n            FpExt tile_sum = shared_sum[threadIdx.x];\n            for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n                tile_sum += shared_sum[(lane << l_skip) + threadIdx.x];\n            }\n            // Output layout: [num_blocks][NUM_COSETS * skip_domain]\n            // This matches final_reduce_block_sums expected layout [num_blocks][d]\n            tmp_sums_buffer[blockIdx.x * NUM_COSETS * skip_domain + c * skip_domain + ntt_idx] =\n                tile_sum;\n        }\n        __syncthreads();\n        g_coset *= g_shift;\n    }\n}\n\n__global__ void fold_selectors_round0_kernel(\n    FpExt *out,\n    const Fp *in,\n    FpExt is_first,\n    FpExt is_last,\n    uint32_t num_x\n) {\n    size_t tidx = blockIdx.x * blockDim.x + threadIdx.x;\n    if (tidx >= num_x)\n        return;\n\n    out[tidx] = is_first * in[tidx];                              // is_first\n    out[2 * num_x + tidx] = is_last * in[2 * num_x + tidx];       // is_last\n    out[num_x + tidx] = FpExt(Fp::one()) - out[2 * num_x + tidx]; // is_transition\n}\n\n// Coset-parallel kernel: grid.y = num_cosets, each block handles ONE coset.\n// Uses acc_constraints<1, NEEDS_SHMEM> with explicit parameter passing.\n// Use when num_x * skip_domain is small for better GPU utilization.\ntemplate <bool GLOBAL, bool NEEDS_SHMEM>\n__global__ void zerocheck_ntt_evaluate_constraints_coset_parallel_kernel(\n    FpExt *__restrict__ tmp_sums_buffer,   // [num_blocks][num_cosets * skip_domain]\n    const Fp *__restrict__ selectors_cube, // [3][num_x]\n    const Fp *__restrict__ preprocessed,\n    const Fp *const *__restrict__ main_parts,\n    const FpExt *__restrict__ eq_cube, // [num_x]\n    const FpExt *__restrict__ d_lambda_pows,\n    const Fp *__restrict__ public_values,\n    const Rule *__restrict__ d_rules,\n    size_t rules_len,\n    const size_t *__restrict__ d_used_nodes,\n    size_t used_nodes_len,\n    size_t lambda_len,\n    uint32_t buffer_size,\n    Fp *__restrict__ d_intermediates,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t height,\n    Fp g_shift\n) {\n    extern __shared__ char smem[];\n    FpExt *shared_sum = reinterpret_cast<FpExt *>(smem);\n    Fp *ntt_buffers_base =\n        NEEDS_SHMEM ? reinterpret_cast<Fp *>(smem + blockDim.x * sizeof(FpExt)) : nullptr;\n\n    uint32_t const l_skip = __ffs(skip_domain) - 1;\n    uint32_t const num_cosets = gridDim.y;\n\n    // Each x_int group within the block gets its own ntt_buffer slice\n    uint32_t const x_int_in_block = threadIdx.x >> l_skip;\n    Fp *ntt_buffer = NEEDS_SHMEM ? (ntt_buffers_base + x_int_in_block * skip_domain) : nullptr;\n\n    // Thread layout: ntt_idx varies fastest, then x_int\n    uint32_t const tidx = threadIdx.x + blockIdx.x * blockDim.x;\n    uint32_t const ntt_idx = tidx & (skip_domain - 1);\n    uint32_t const x_int_base = tidx >> l_skip;\n\n    // KEY DIFFERENCE: coset_idx from blockIdx.y\n    uint32_t const coset_idx = blockIdx.y;\n\n    // Precompute values for this single coset\n    uint32_t const ntt_idx_rev = rev_len(ntt_idx, l_skip);\n\n    uint32_t const log_height_total = __ffs(height) - 1;\n    uint32_t const log_segment = min(l_skip, log_height_total);\n    uint32_t const segment_size = 1u << log_segment;\n    uint32_t const log_stride = l_skip - log_segment;\n\n    Fp const eta = TWO_ADIC_GENERATORS[l_skip - log_stride];\n    Fp const omega_skip_ntt =\n        (l_skip == 0) ? Fp::one() : device_ntt::get_twiddle(l_skip, ntt_idx);\n\n    // Compute for single coset: g^(coset_idx + 1)\n    Fp const g_coset = pow(g_shift, coset_idx + 1);\n    Fp const eval_point = g_coset * omega_skip_ntt;\n    Fp const omega = exp_power_of_2(eval_point, log_stride);\n    Fp const is_first_mult = avg_gp(omega, segment_size);\n    Fp const is_last_mult = avg_gp(omega * eta, segment_size);\n    Fp const omega_shift = pow(g_coset, ntt_idx_rev);\n\n    // Intermediate buffer setup (single coset, no NUM_COSETS multiplier)\n    Fp local_buffer[GLOBAL ? 1 : BUFFER_THRESHOLD];\n    Fp *inter_buffer;\n    uint32_t buffer_stride;\n    if constexpr (GLOBAL) {\n        // Layout: [buffer_size][num_cosets * num_threads_per_coset]\n        uint32_t global_tidx = coset_idx * gridDim.x * blockDim.x + tidx;\n        inter_buffer = d_intermediates + global_tidx;\n        buffer_stride = gridDim.x * gridDim.y * blockDim.x;\n    } else {\n        inter_buffer = local_buffer;\n        buffer_stride = 1;\n    }\n\n    FpExt sum = FpExt(Fp::zero());\n\n    uint32_t const x_int_stride = (gridDim.x * blockDim.x) >> l_skip;\n\n    // Single-coset context (NUM_COSETS=1), loop-invariant fields only\n    NttEvalContext<1> eval_ctx{\n        preprocessed,\n        main_parts,\n        public_values,\n        inter_buffer,\n        ntt_buffer,\n        {omega_shift}, // omega_shifts[1]\n        skip_domain,\n        height,\n        buffer_stride,\n        buffer_size,\n        ntt_idx,\n    };\n\n    for (uint32_t x_int = x_int_base; x_int < num_x; x_int += x_int_stride) {\n        Fp is_first = is_first_mult * selectors_cube[x_int];\n        Fp is_last = is_last_mult * selectors_cube[2 * num_x + x_int];\n\n        FpExt constraint_sums[1];\n        acc_constraints<1, NEEDS_SHMEM>(\n            constraint_sums,\n            eval_ctx,\n            &is_first,\n            &is_last,\n            x_int,\n            d_lambda_pows,\n            d_rules,\n            rules_len,\n            d_used_nodes,\n            used_nodes_len,\n            lambda_len\n        );\n\n        sum += constraint_sums[0] * eq_cube[x_int];\n    }\n\n    // Single-coset reduction (no loop over cosets)\n    Fp zerofier = exp_power_of_2(eval_point, l_skip) - Fp::one();\n    // We assume g_shift is not in skip domain and since we use (c+1) power,\n    // eval_point is never in skip domain. Hence zerofier is never zero.\n    shared_sum[threadIdx.x] = sum * inv(zerofier);\n    __syncthreads();\n\n    if (threadIdx.x < skip_domain) {\n        FpExt tile_sum = shared_sum[threadIdx.x];\n        for (uint32_t lane = 1; lane < (blockDim.x >> l_skip); ++lane) {\n            tile_sum += shared_sum[(lane << l_skip) + threadIdx.x];\n        }\n        // Output layout: [num_x_blocks][num_cosets * skip_domain]\n        // Same as lockstep to ensure final_reduce_block_sums works unchanged\n        tmp_sums_buffer[blockIdx.x * num_cosets * skip_domain + coset_idx * skip_domain + ntt_idx] =\n            tile_sum;\n    }\n}\n\n// ============================================================================\n// LAUNCHERS\n// ============================================================================\nconstexpr uint32_t MAX_THREADS = 128;\n\n// Helper to determine which mode to use based on threshold\ninline bool use_coset_parallel_mode(uint32_t num_x, uint32_t skip_domain) {\n    return (num_x * skip_domain) < COSET_PARALLEL_THRESHOLD;\n}\n\n// (Not a launcher) Utility function to calculate required size of temp sum buffer.\n// Required length of *temp_sum_buffer in FpExt elements\nextern \"C\" size_t _zerocheck_r0_temp_sums_buffer_size(\n    uint32_t buffer_size,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t num_cosets,\n    size_t max_temp_bytes\n) {\n    // Both modes use the same buffer size formula\n    return DISPATCH_BOOL(\n        round0_config_impl::temp_sums_buffer_size,\n        use_coset_parallel_mode(num_x, skip_domain),\n        buffer_size,\n        skip_domain,\n        num_x,\n        num_cosets,\n        max_temp_bytes,\n        BUFFER_THRESHOLD,\n        MAX_THREADS\n    );\n}\n\nextern \"C\" size_t _zerocheck_r0_intermediates_buffer_size(\n    uint32_t buffer_size,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t num_cosets,\n    size_t max_temp_bytes\n) {\n    // Both modes use the same buffer size formula\n    return DISPATCH_BOOL(\n        round0_config_impl::intermediates_buffer_size,\n        use_coset_parallel_mode(num_x, skip_domain),\n        buffer_size,\n        skip_domain,\n        num_x,\n        num_cosets,\n        max_temp_bytes,\n        BUFFER_THRESHOLD,\n        MAX_THREADS\n    );\n}\n\ntemplate <uint32_t NUM_COSETS, bool GLOBAL, bool NEEDS_SHMEM>\nint launch_zerocheck_ntt_evaluate_constraints(\n    FpExt *tmp_sums_buffer,\n    FpExt *output,\n    const Fp *selectors_cube, // [3][num_x]\n    const Fp *preprocessed,\n    const Fp *const *main_parts,\n    const FpExt *eq_cube, // [num_x]\n    const FpExt *d_lambda_pows,\n    const Fp *public_values,\n    const Rule *d_rules,\n    size_t rules_len,\n    const size_t *d_used_nodes,\n    size_t used_nodes_len,\n    size_t lambda_len,\n    uint32_t buffer_size,\n    Fp *d_intermediates,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t height,\n    Fp g_shift,\n    size_t max_temp_bytes\n) {\n    auto [grid, block] = coset_round0_config::eval_constraints_launch_params(\n        buffer_size, skip_domain, num_x, NUM_COSETS, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n    );\n\n    size_t shared_sum_size = sizeof(FpExt) * block.x;\n    // NTT buffers: one skip_domain-sized buffer per x_int group in the block\n    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n\n    zerocheck_ntt_evaluate_constraints_kernel<NUM_COSETS, GLOBAL, NEEDS_SHMEM>\n        <<<grid, block, shmem_bytes>>>(\n            tmp_sums_buffer,\n            selectors_cube,\n            preprocessed,\n            main_parts,\n            eq_cube,\n            d_lambda_pows,\n            public_values,\n            d_rules,\n            rules_len,\n            d_used_nodes,\n            used_nodes_len,\n            lambda_len,\n            buffer_size,\n            d_intermediates,\n            skip_domain,\n            num_x,\n            height,\n            g_shift\n        );\n    int err = CHECK_KERNEL();\n    if (err != 0) {\n        return err;\n    }\n\n    // Final reduction: sum across all x_int blocks for each (coset, ntt_idx)\n    auto num_blocks = grid.x;\n    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n    sumcheck::final_reduce_block_sums<<<NUM_COSETS * skip_domain, reduce_block, reduce_shmem>>>(\n        tmp_sums_buffer, output, num_blocks\n    );\n\n    return CHECK_KERNEL();\n}\n\n// Generate dispatcher for num_cosets (1-4) x is_global x needs_shmem\nDEFINE_DISPATCH_N_B1_B2(dispatch_zerocheck, launch_zerocheck_ntt_evaluate_constraints, 4)\n\n// Coset-parallel launcher: uses grid.y = num_cosets, each block handles one coset\ntemplate <bool GLOBAL, bool NEEDS_SHMEM>\nint launch_zerocheck_coset_parallel(\n    FpExt *tmp_sums_buffer,\n    FpExt *output,\n    const Fp *selectors_cube,\n    const Fp *preprocessed,\n    const Fp *const *main_parts,\n    const FpExt *eq_cube,\n    const FpExt *d_lambda_pows,\n    const Fp *public_values,\n    const Rule *d_rules,\n    size_t rules_len,\n    const size_t *d_used_nodes,\n    size_t used_nodes_len,\n    size_t lambda_len,\n    uint32_t buffer_size,\n    Fp *d_intermediates,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t height,\n    uint32_t num_cosets,\n    Fp g_shift,\n    size_t max_temp_bytes\n) {\n    auto [grid, block] = coset_parallel_round0_config::eval_constraints_launch_params(\n        buffer_size, skip_domain, num_x, num_cosets, max_temp_bytes, BUFFER_THRESHOLD, MAX_THREADS\n    );\n\n    size_t shared_sum_size = sizeof(FpExt) * block.x;\n    size_t ntt_buffers_size = NEEDS_SHMEM ? sizeof(Fp) * block.x : 0;\n    size_t shmem_bytes = shared_sum_size + ntt_buffers_size;\n\n    zerocheck_ntt_evaluate_constraints_coset_parallel_kernel<GLOBAL, NEEDS_SHMEM>\n        <<<grid, block, shmem_bytes>>>(\n            tmp_sums_buffer,\n            selectors_cube,\n            preprocessed,\n            main_parts,\n            eq_cube,\n            d_lambda_pows,\n            public_values,\n            d_rules,\n            rules_len,\n            d_used_nodes,\n            used_nodes_len,\n            lambda_len,\n            buffer_size,\n            d_intermediates,\n            skip_domain,\n            num_x,\n            height,\n            g_shift\n        );\n    int err = CHECK_KERNEL();\n    if (err != 0) {\n        return err;\n    }\n\n    // Final reduction: same as lockstep - sum across all x_int blocks for each (coset, ntt_idx)\n    auto num_blocks = grid.x;\n    auto [reduce_grid, reduce_block] = kernel_launch_params(num_blocks);\n    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n    sumcheck::final_reduce_block_sums<<<num_cosets * skip_domain, reduce_block, reduce_shmem>>>(\n        tmp_sums_buffer, output, num_blocks\n    );\n\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _zerocheck_ntt_eval_constraints(\n    FpExt *tmp_sums_buffer,   // [num_blocks][num_cosets * skip_domain]\n    FpExt *output,            // [num_cosets * skip_domain]\n    const Fp *selectors_cube, // [3][num_x]\n    const Fp *preprocessed,\n    const Fp *const *main_parts,\n    const FpExt *eq_cube, // [num_x]\n    const FpExt *d_lambda_pows,\n    const Fp *public_values,\n    const Rule *d_rules,\n    size_t rules_len,\n    const size_t *d_used_nodes,\n    size_t used_nodes_len,\n    size_t lambda_len,\n    uint32_t buffer_size,\n    Fp *d_intermediates,\n    uint32_t skip_domain,\n    uint32_t num_x,\n    uint32_t height,\n    uint32_t num_cosets,\n    Fp g_shift,\n    size_t max_temp_bytes\n) {\n    bool is_global = buffer_size > BUFFER_THRESHOLD;\n    bool needs_shmem = skip_domain > WARP_SIZE;\n\n#define KERNEL_ARGS                                                                                \\\n    tmp_sums_buffer, output, selectors_cube, preprocessed, main_parts, eq_cube, d_lambda_pows,     \\\n        public_values, d_rules, rules_len, d_used_nodes, used_nodes_len, lambda_len, buffer_size,  \\\n        d_intermediates, skip_domain, num_x, height\n\n    // Threshold-based dispatch: use coset-parallel for small workloads\n    if (use_coset_parallel_mode(num_x, skip_domain)) {\n        // Coset-parallel mode: grid.y = num_cosets, each block handles one coset\n        return DISPATCH_BOOL_PAIR(\n            launch_zerocheck_coset_parallel,\n            is_global,\n            needs_shmem,\n            KERNEL_ARGS,\n            num_cosets,\n            g_shift,\n            max_temp_bytes\n        );\n    } else {\n        // Lockstep mode: single thread handles all cosets\n        return dispatch_zerocheck(\n            num_cosets, is_global, needs_shmem, KERNEL_ARGS, g_shift, max_temp_bytes\n        );\n    }\n#undef KERNEL_ARGS\n}\n\nextern \"C\" int _fold_selectors_round0(\n    FpExt *out,\n    const Fp *in,\n    FpExt is_first,\n    FpExt is_last,\n    uint32_t num_x\n) {\n    auto [grid, block] = kernel_launch_params(num_x);\n    fold_selectors_round0_kernel<<<grid, block>>>(out, in, is_first, is_last, num_x);\n    return CHECK_KERNEL();\n}\n\n} // namespace zerocheck_round0\n","numLines":732,"startLine":1,"totalLines":732}}}
