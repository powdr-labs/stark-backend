{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FJLGALxTDYStTq7Psweyf7","type":"tool_result","content":"599\t    fn sumcheck_uni_round0_polys(\n600\t        &mut self,\n601\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n602\t        lambda: EF,\n603\t    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n604\t        self.mem\n605\t            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n606\t        self.mem.reset_peak();\n607\t        let n_logup = self.n_logup;\n608\t        let l_skip = self.l_skip;\n609\t        let xi = &self.xi;\n610\t        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n611\t        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n612\t            h_lambda_pows.to_device()?\n613\t        } else {\n614\t            DeviceBuffer::new()\n615\t        });\n616\t        // Precompute lambda combinations for all AIRs with monomials\n617\t        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n618\t        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n619\t            if air_pk.other_data.zerocheck_monomials.is_some() {\n620\t                self.lambda_combinations[air_idx] = Some(\n621\t                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n622\t                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n623\t                );\n624\t            }\n625\t        }\n626\t        let num_present_airs = ctx.per_trace.len();\n627\t        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n628\t\n629\t        self.eq_3b_per_trace = ctx\n630\t            .per_trace\n631\t            .iter()\n632\t            .enumerate()\n633\t            .map(|(trace_idx, (air_idx, _))| {\n634\t                let vk = &self.pk.per_air[*air_idx].vk;\n635\t                let num_interactions = vk.num_interactions();\n636\t                if num_interactions > 0 {\n637\t                    let n = self.n_per_trace[trace_idx];\n638\t                    let n_lift = n.max(0) as usize;\n639\t                    let mut b_vec = vec![F::ZERO; n_logup - n_lift];\n640\t                    let mut weights = Vec::with_capacity(num_interactions);\n641\t                    for interaction_idx in 0..num_interactions {\n642\t                        let stacked_idx = self\n643\t                            .interactions_layout\n644\t                            .get(trace_idx, interaction_idx)\n645\t                            .unwrap()\n646\t                            .row_idx;\n647\t                        let mut b_int = stacked_idx >> (l_skip + n_lift);\n648\t                        for bit in &mut b_vec {\n649\t                            *bit = F::from_bool(b_int & 1 == 1);\n650\t                            b_int >>= 1;\n651\t                        }\n652\t                        let weight =\n653\t                            eval_eq_mle(&self.xi[l_skip + n_lift..l_skip + n_logup], &b_vec);\n654\t                        weights.push(weight);\n655\t                    }\n656\t                    weights\n657\t                } else {\n658\t                    vec![]\n659\t                }\n660\t            })\n661\t            .collect_vec();\n662\t        self.d_eq_3b_per_trace = self\n663\t            .eq_3b_per_trace\n664\t            .iter()\n665\t            .map(|eq_3bs| {\n666\t                if eq_3bs.is_empty() {\n667\t                    Ok(DeviceBuffer::new())\n668\t                } else {\n669\t                    eq_3bs.to_device()\n670\t                }\n671\t            })\n672\t            .collect::<Result<Vec<_>, _>>()?;\n673\t\n674\t        // Precompute logup combinations for all traces with interaction monomials\n675\t        for (trace_idx, (air_idx, _)) in ctx.per_trace.iter().enumerate() {\n676\t            let air_pk = &self.pk.per_air[*air_idx];\n677\t            if air_pk.other_data.interaction_monomials.is_some()\n678\t                && !self.eq_3b_per_trace[trace_idx].is_empty()\n679\t            {\n680\t                self.logup_combinations[trace_idx] = Some(\n681\t                    compute_logup_combinations(\n682\t                        self.pk,\n683\t                        *air_idx,\n684\t                        &self.d_beta_pows,\n685\t                        &self.d_eq_3b_per_trace[trace_idx],\n686\t                        &self.eq_3b_per_trace[trace_idx],\n687\t                        &self.beta_pows,\n688\t                    )\n689\t                    .map_err(LogupZerocheckError::LogupCombinations)?,\n690\t                );\n691\t            }\n692\t        }\n693\t\n694\t        // PERF[jpw]: we could also build the layers for different n in a transposed way using\n695\t        // eq_nonoverlapping_stage_ext, which is more memory efficient\n696\t        for &n in &self.n_per_trace {\n697\t            let n_lift = n.max(0) as usize;\n698\t            if let Entry::Vacant(entry) = self.eq_xis.entry(n_lift) {\n699\t                let layers =\n700\t                    EqEvalLayers::new_rev(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n701\t                        .map_err(LogupZerocheckError::EqEvalLayers)?;\n702\t                entry.insert(layers);\n703\t            }\n704\t        }\n705\t\n706\t        self.sels_per_trace_base = self\n707\t            .n_per_trace\n708\t            .iter()\n709\t            .map(|&n| {\n710\t                let n_lift = n.max(0) as usize;\n711\t                let height = 1 << n_lift;\n712\t                let mut cols = F::zero_vec(3 * height);\n713\t                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n714\t                cols[0] = F::ONE; // is_first\n715\t                cols[2 * height + height - 1] = F::ONE; // is_last\n716\t                let d_cols = cols.to_device()?;\n717\t                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n718\t            })\n719\t            .collect::<Result<Vec<_>, MemCopyError>>()?;\n720\t\n721\t        let selectors_base = self.sels_per_trace_base.clone();\n722\t\n723\t        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n724\t        // present AIR\n725\t        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n726\t        let d_lambda_pows = self\n727\t            .lambda_pows\n728\t            .as_ref()\n729\t            .expect(\"lambda powers must be set before round-0 evaluation\");\n730\t\n731\t        // Metadata stored per AIR during Phase 1, consumed in Phase 2\n732\t        struct Round0Pending<F, EF> {\n733\t            trace_idx: usize,\n734\t            air_idx: usize,\n735\t            num_cosets_zc: usize,\n736\t            num_cosets_logup: usize,\n737\t            local_constraint_deg: usize,\n738\t            omega_root: F,\n739\t            n: isize,\n740\t            zc_result: DeviceBuffer<EF>,\n741\t            logup_result: DeviceBuffer<Frac<EF>>,\n742\t        }\n743\t\n744\t        // Phase 1: Launch all GPU kernels without blocking D2H transfers.\n745\t        // Collect result buffers and metadata for Phase 2 processing.\n746\t        let mut pending: Vec<Round0Pending<F, EF>> = Vec::with_capacity(num_present_airs);\n747\t        // Collect d_main_parts to keep them alive until all kernels complete.\n748\t        let mut d_main_parts_vec: Vec<DeviceBuffer<*const F>> = Vec::with_capacity(num_present_airs);\n749\t\n750\t        for (trace_idx, ((air_idx, air_ctx), &n, selectors_cube, public_values, eq_3bs)) in izip!(\n751\t            &ctx.per_trace,\n752\t            &self.n_per_trace,\n753\t            &selectors_base,\n754\t            &self.public_values_per_trace,\n755\t            &self.eq_3b_per_trace,\n756\t        )\n757\t        .enumerate()\n758\t        {\n759\t            debug!(\"starting batch constraints for air_idx={air_idx} (trace_idx={trace_idx})\");\n760\t            let single_pk = &self.pk.per_air[*air_idx];\n761\t            // Includes both plain AIR constraints and symbolic interactions\n762\t            let single_air_constraints =\n763\t                SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n764\t            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n765\t            debug_assert_eq!(\n766\t                single_air_constraints.max_constraint_degree(),\n767\t                local_constraint_deg\n768\t            );\n769\t            assert!(\n770\t                local_constraint_deg <= self.constraint_degree,\n771\t                \"Max constraint degree ({local_constraint_deg}) of AIR {air_idx} exceeds the global maximum {}\",\n772\t                self.constraint_degree\n773\t            );\n774\t\n775\t            let log_large_domain = log2_ceil_usize(local_constraint_deg << l_skip);\n776\t            let omega_root = F::two_adic_generator(log_large_domain);\n777\t\n778\t            assert!(!xi.is_empty(), \"xi vector must not be empty\");\n779\t\n780\t            let height = air_ctx.common_main.height();\n781\t            let mut main_parts = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n782\t            for committed in &air_ctx.cached_mains {\n783\t                main_parts.push(committed.trace.buffer().as_ptr());\n784\t            }\n785\t            main_parts.push(air_ctx.common_main.buffer().as_ptr());\n786\t            let d_main_parts = main_parts.to_device()?;\n787\t\n788\t            let n_lift = n.max(0) as usize;\n789\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n790\t            let max_temp_bytes = self.memory_limit_bytes;\n791\t            // local_constraint_deg = 0 means no constraints. The only way that linear constraints\n792\t            // on trace polynomials could vanish on 2^l_skip points is if the constraint polynomial\n793\t            // is identically zero. Thus for local_constraint_deg = 0 or 1, we must have `s'_0 = 0`.\n794\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n795\t            let zc_result = evaluate_round0_constraints_gpu(\n796\t                single_pk,\n797\t                selectors_cube.buffer(),\n798\t                &d_main_parts,\n799\t                public_values,\n800\t                eq_xi_tree.get_ptr(n_lift),\n801\t                d_lambda_pows,\n802\t                1 << l_skip,\n803\t                1 << n_lift,\n804\t                height as u32,\n805\t                num_cosets_zc as u32,\n806\t                omega_root,\n807\t                max_temp_bytes,\n808\t            )?;\n809\t\n810\t            // PERF: we could use an interaction-specific constraint degree here\n811\t            let num_cosets_logup = local_constraint_deg;\n812\t            let logup_result = evaluate_round0_interactions_gpu(\n813\t                single_pk,\n814\t                &single_air_constraints,\n815\t                selectors_cube.buffer(),\n816\t                &d_main_parts,\n817\t                public_values,\n818\t                eq_xi_tree.get_ptr(n_lift),\n819\t                &self.beta_pows,\n820\t                eq_3bs,\n821\t                1 << l_skip,\n822\t                1 << n_lift,\n823\t                height as u32,\n824\t                num_cosets_logup as u32,\n825\t                omega_root,\n826\t                max_temp_bytes,\n827\t            )?;\n828\t\n829\t            d_main_parts_vec.push(d_main_parts);\n830\t            pending.push(Round0Pending {\n831\t                trace_idx,\n832\t                air_idx: *air_idx,\n833\t                num_cosets_zc,\n834\t                num_cosets_logup,\n835\t                local_constraint_deg,\n836\t                omega_root,\n837\t                n,\n838\t                zc_result,\n839\t                logup_result,\n840\t            });\n841\t        }\n842\t\n843\t        // Phase 2: Explicit stream sync, then D2H transfers + CPU polynomial construction.\n844\t        current_stream_sync().map_err(|e| LogupZerocheckError::from(MemCopyError::from(e)))?;\n845\t\n846\t        // Release d_main_parts now that all kernels have completed\n847\t        drop(d_main_parts_vec);\n848\t\n849\t        for entry in pending {\n850\t            if !entry.zc_result.is_empty() {\n851\t                let q_evals = entry.zc_result.to_host()?;\n852\t                let q = {\n853\t                    // Make q_evals row-major, with columns <> cosets\n854\t                    let mut values = EF::zero_vec(entry.num_cosets_zc << l_skip);\n855\t                    for coset_idx in 0..entry.num_cosets_zc {\n856\t                        for i in 0..1 << l_skip {\n857\t                            values[i * entry.num_cosets_zc + coset_idx] =\n858\t                                q_evals[(coset_idx << l_skip) + i];\n859\t                        }\n860\t                    }\n861\t                    UnivariatePoly::from_geometric_cosets_evals_idft(\n862\t                        RowMajorMatrix::new(values, entry.num_cosets_zc),\n863\t                        entry.omega_root,\n864\t                        entry.omega_root,\n865\t                    )\n866\t                };\n867\t                // sp_0 = (Z^{2^l_skip} - 1) * q\n868\t                let sp_0_deg = sumcheck_round0_deg(l_skip, entry.local_constraint_deg);\n869\t                let coeffs = (0..=sp_0_deg)\n870\t                    .map(|i| {\n871\t                        let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n872\t                        if i >= 1 << l_skip {\n873\t                            c += q.coeffs()[i - (1 << l_skip)];\n874\t                        }\n875\t                        c\n876\t                    })\n877\t                    .collect_vec();\n878\t                debug_assert_eq!(\n879\t                    coeffs.iter().step_by(1 << l_skip).copied().sum::<EF>(),\n880\t                    EF::ZERO,\n881\t                    \"Zerocheck sum is not zero for air_id: {}\",\n882\t                    entry.air_idx\n883\t                );\n884\t\n885\t                batch_sp_poly[2 * num_present_airs + entry.trace_idx] =\n886\t                    UnivariatePoly::new(coeffs);\n887\t            }\n888\t\n889\t            if !entry.logup_result.is_empty() {\n890\t                let evals = entry.logup_result.to_host()?;\n891\t                let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n892\t                    evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n893\t                if entry.n.is_negative() {\n894\t                    // normalize for lifting\n895\t                    let norm_factor = F::from_u32(1 << entry.n.unsigned_abs()).inverse();\n896\t                    for s in &mut numer {\n897\t                        *s *= norm_factor;\n898\t                    }\n899\t                }\n900\t                let mut numer_values = EF::zero_vec(entry.num_cosets_logup << l_skip);\n901\t                let mut denom_values = EF::zero_vec(entry.num_cosets_logup << l_skip);\n902\t                for coset_idx in 0..entry.num_cosets_logup {\n903\t                    for i in 0..1 << l_skip {\n904\t                        let src = (coset_idx << l_skip) + i;\n905\t                        let dst = i * entry.num_cosets_logup + coset_idx;\n906\t                        numer_values[dst] = numer[src];\n907\t                        denom_values[dst] = denom[src];\n908\t                    }\n909\t                }\n910\t                // Logup uses cosets 1, g^1, g^2, ... (init = 1, shift = omega_root)\n911\t                batch_sp_poly[2 * entry.trace_idx] =\n912\t                    UnivariatePoly::from_geometric_cosets_evals_idft(\n913\t                        RowMajorMatrix::new(numer_values, entry.num_cosets_logup),\n914\t                        entry.omega_root,\n915\t                        F::ONE, // init = 1 for identity coset\n916\t                    );\n917\t                batch_sp_poly[2 * entry.trace_idx + 1] =\n918\t                    UnivariatePoly::from_geometric_cosets_evals_idft(\n919\t                        RowMajorMatrix::new(denom_values, entry.num_cosets_logup),\n920\t                        entry.omega_root,\n921\t                        F::ONE, // init = 1 for identity coset\n922\t                    );\n923\t            }\n924\t        }\n925\t        self.mem\n926\t            .emit_metrics_with_label(\"prover.batch_constraints.round0\");\n927\t        Ok(batch_sp_poly)\n928\t    }\n929\t\n930\t    // Note: there are no gpu sync points in this function, so span does not indicate kernel times\n931\t    #[instrument(name = \"LogupZerocheck::fold_ple_evals\", level = \"debug\", skip_all)]\n932\t    fn fold_ple_evals(\n933\t        &mut self,\n934\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n935\t        r_0: EF,\n936\t    ) -> Result<(), LogupZerocheckError> {\n937\t        let l_skip = self.l_skip;\n938\t        let inv_lagrange_denoms_r0 =\n939\t            compute_barycentric_inv_lagrange_denoms(l_skip, &self.omega_skip_pows, r_0);\n940\t        let d_inv_lagrange_denoms_r0 = inv_lagrange_denoms_r0.to_device()?;\n941\t\n942\t        let mut mem_limit = self.gkr_mem_contribution;\n943\t        // GPU folding for mat_evals_per_trace\n944\t        self.mat_evals_per_trace = ctx\n945\t            .per_trace\n946\t            .iter()\n947\t            .map(|(air_idx, air_ctx)| {\n948\t                let air_pk = &self.pk.per_air[*air_idx];"}]},"parent_tool_use_id":null,"session_id":"297e37a8-7de7-4f8d-9cb1-f45048fd2150","uuid":"c00cc68e-c192-42f4-b680-0812d1c1a5cb","timestamp":"2026-04-10T22:01:14.319Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/mod.rs","content":"    fn sumcheck_uni_round0_polys(\n        &mut self,\n        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n        lambda: EF,\n    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n        self.mem\n            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n        self.mem.reset_peak();\n        let n_logup = self.n_logup;\n        let l_skip = self.l_skip;\n        let xi = &self.xi;\n        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n            h_lambda_pows.to_device()?\n        } else {\n            DeviceBuffer::new()\n        });\n        // Precompute lambda combinations for all AIRs with monomials\n        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n            if air_pk.other_data.zerocheck_monomials.is_some() {\n                self.lambda_combinations[air_idx] = Some(\n                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n                );\n            }\n        }\n        let num_present_airs = ctx.per_trace.len();\n        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n\n        self.eq_3b_per_trace = ctx\n            .per_trace\n            .iter()\n            .enumerate()\n            .map(|(trace_idx, (air_idx, _))| {\n                let vk = &self.pk.per_air[*air_idx].vk;\n                let num_interactions = vk.num_interactions();\n                if num_interactions > 0 {\n                    let n = self.n_per_trace[trace_idx];\n                    let n_lift = n.max(0) as usize;\n                    let mut b_vec = vec![F::ZERO; n_logup - n_lift];\n                    let mut weights = Vec::with_capacity(num_interactions);\n                    for interaction_idx in 0..num_interactions {\n                        let stacked_idx = self\n                            .interactions_layout\n                            .get(trace_idx, interaction_idx)\n                            .unwrap()\n                            .row_idx;\n                        let mut b_int = stacked_idx >> (l_skip + n_lift);\n                        for bit in &mut b_vec {\n                            *bit = F::from_bool(b_int & 1 == 1);\n                            b_int >>= 1;\n                        }\n                        let weight =\n                            eval_eq_mle(&self.xi[l_skip + n_lift..l_skip + n_logup], &b_vec);\n                        weights.push(weight);\n                    }\n                    weights\n                } else {\n                    vec![]\n                }\n            })\n            .collect_vec();\n        self.d_eq_3b_per_trace = self\n            .eq_3b_per_trace\n            .iter()\n            .map(|eq_3bs| {\n                if eq_3bs.is_empty() {\n                    Ok(DeviceBuffer::new())\n                } else {\n                    eq_3bs.to_device()\n                }\n            })\n            .collect::<Result<Vec<_>, _>>()?;\n\n        // Precompute logup combinations for all traces with interaction monomials\n        for (trace_idx, (air_idx, _)) in ctx.per_trace.iter().enumerate() {\n            let air_pk = &self.pk.per_air[*air_idx];\n            if air_pk.other_data.interaction_monomials.is_some()\n                && !self.eq_3b_per_trace[trace_idx].is_empty()\n            {\n                self.logup_combinations[trace_idx] = Some(\n                    compute_logup_combinations(\n                        self.pk,\n                        *air_idx,\n                        &self.d_beta_pows,\n                        &self.d_eq_3b_per_trace[trace_idx],\n                        &self.eq_3b_per_trace[trace_idx],\n                        &self.beta_pows,\n                    )\n                    .map_err(LogupZerocheckError::LogupCombinations)?,\n                );\n            }\n        }\n\n        // PERF[jpw]: we could also build the layers for different n in a transposed way using\n        // eq_nonoverlapping_stage_ext, which is more memory efficient\n        for &n in &self.n_per_trace {\n            let n_lift = n.max(0) as usize;\n            if let Entry::Vacant(entry) = self.eq_xis.entry(n_lift) {\n                let layers =\n                    EqEvalLayers::new_rev(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n                        .map_err(LogupZerocheckError::EqEvalLayers)?;\n                entry.insert(layers);\n            }\n        }\n\n        self.sels_per_trace_base = self\n            .n_per_trace\n            .iter()\n            .map(|&n| {\n                let n_lift = n.max(0) as usize;\n                let height = 1 << n_lift;\n                let mut cols = F::zero_vec(3 * height);\n                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n                cols[0] = F::ONE; // is_first\n                cols[2 * height + height - 1] = F::ONE; // is_last\n                let d_cols = cols.to_device()?;\n                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n            })\n            .collect::<Result<Vec<_>, MemCopyError>>()?;\n\n        let selectors_base = self.sels_per_trace_base.clone();\n\n        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n        // present AIR\n        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n        let d_lambda_pows = self\n            .lambda_pows\n            .as_ref()\n            .expect(\"lambda powers must be set before round-0 evaluation\");\n\n        // Metadata stored per AIR during Phase 1, consumed in Phase 2\n        struct Round0Pending<F, EF> {\n            trace_idx: usize,\n            air_idx: usize,\n            num_cosets_zc: usize,\n            num_cosets_logup: usize,\n            local_constraint_deg: usize,\n            omega_root: F,\n            n: isize,\n            zc_result: DeviceBuffer<EF>,\n            logup_result: DeviceBuffer<Frac<EF>>,\n        }\n\n        // Phase 1: Launch all GPU kernels without blocking D2H transfers.\n        // Collect result buffers and metadata for Phase 2 processing.\n        let mut pending: Vec<Round0Pending<F, EF>> = Vec::with_capacity(num_present_airs);\n        // Collect d_main_parts to keep them alive until all kernels complete.\n        let mut d_main_parts_vec: Vec<DeviceBuffer<*const F>> = Vec::with_capacity(num_present_airs);\n\n        for (trace_idx, ((air_idx, air_ctx), &n, selectors_cube, public_values, eq_3bs)) in izip!(\n            &ctx.per_trace,\n            &self.n_per_trace,\n            &selectors_base,\n            &self.public_values_per_trace,\n            &self.eq_3b_per_trace,\n        )\n        .enumerate()\n        {\n            debug!(\"starting batch constraints for air_idx={air_idx} (trace_idx={trace_idx})\");\n            let single_pk = &self.pk.per_air[*air_idx];\n            // Includes both plain AIR constraints and symbolic interactions\n            let single_air_constraints =\n                SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n            debug_assert_eq!(\n                single_air_constraints.max_constraint_degree(),\n                local_constraint_deg\n            );\n            assert!(\n                local_constraint_deg <= self.constraint_degree,\n                \"Max constraint degree ({local_constraint_deg}) of AIR {air_idx} exceeds the global maximum {}\",\n                self.constraint_degree\n            );\n\n            let log_large_domain = log2_ceil_usize(local_constraint_deg << l_skip);\n            let omega_root = F::two_adic_generator(log_large_domain);\n\n            assert!(!xi.is_empty(), \"xi vector must not be empty\");\n\n            let height = air_ctx.common_main.height();\n            let mut main_parts = Vec::with_capacity(air_ctx.cached_mains.len() + 1);\n            for committed in &air_ctx.cached_mains {\n                main_parts.push(committed.trace.buffer().as_ptr());\n            }\n            main_parts.push(air_ctx.common_main.buffer().as_ptr());\n            let d_main_parts = main_parts.to_device()?;\n\n            let n_lift = n.max(0) as usize;\n            let eq_xi_tree = &self.eq_xis[&n_lift];\n            let max_temp_bytes = self.memory_limit_bytes;\n            // local_constraint_deg = 0 means no constraints. The only way that linear constraints\n            // on trace polynomials could vanish on 2^l_skip points is if the constraint polynomial\n            // is identically zero. Thus for local_constraint_deg = 0 or 1, we must have `s'_0 = 0`.\n            let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n            let zc_result = evaluate_round0_constraints_gpu(\n                single_pk,\n                selectors_cube.buffer(),\n                &d_main_parts,\n                public_values,\n                eq_xi_tree.get_ptr(n_lift),\n                d_lambda_pows,\n                1 << l_skip,\n                1 << n_lift,\n                height as u32,\n                num_cosets_zc as u32,\n                omega_root,\n                max_temp_bytes,\n            )?;\n\n            // PERF: we could use an interaction-specific constraint degree here\n            let num_cosets_logup = local_constraint_deg;\n            let logup_result = evaluate_round0_interactions_gpu(\n                single_pk,\n                &single_air_constraints,\n                selectors_cube.buffer(),\n                &d_main_parts,\n                public_values,\n                eq_xi_tree.get_ptr(n_lift),\n                &self.beta_pows,\n                eq_3bs,\n                1 << l_skip,\n                1 << n_lift,\n                height as u32,\n                num_cosets_logup as u32,\n                omega_root,\n                max_temp_bytes,\n            )?;\n\n            d_main_parts_vec.push(d_main_parts);\n            pending.push(Round0Pending {\n                trace_idx,\n                air_idx: *air_idx,\n                num_cosets_zc,\n                num_cosets_logup,\n                local_constraint_deg,\n                omega_root,\n                n,\n                zc_result,\n                logup_result,\n            });\n        }\n\n        // Phase 2: Explicit stream sync, then D2H transfers + CPU polynomial construction.\n        current_stream_sync().map_err(|e| LogupZerocheckError::from(MemCopyError::from(e)))?;\n\n        // Release d_main_parts now that all kernels have completed\n        drop(d_main_parts_vec);\n\n        for entry in pending {\n            if !entry.zc_result.is_empty() {\n                let q_evals = entry.zc_result.to_host()?;\n                let q = {\n                    // Make q_evals row-major, with columns <> cosets\n                    let mut values = EF::zero_vec(entry.num_cosets_zc << l_skip);\n                    for coset_idx in 0..entry.num_cosets_zc {\n                        for i in 0..1 << l_skip {\n                            values[i * entry.num_cosets_zc + coset_idx] =\n                                q_evals[(coset_idx << l_skip) + i];\n                        }\n                    }\n                    UnivariatePoly::from_geometric_cosets_evals_idft(\n                        RowMajorMatrix::new(values, entry.num_cosets_zc),\n                        entry.omega_root,\n                        entry.omega_root,\n                    )\n                };\n                // sp_0 = (Z^{2^l_skip} - 1) * q\n                let sp_0_deg = sumcheck_round0_deg(l_skip, entry.local_constraint_deg);\n                let coeffs = (0..=sp_0_deg)\n                    .map(|i| {\n                        let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n                        if i >= 1 << l_skip {\n                            c += q.coeffs()[i - (1 << l_skip)];\n                        }\n                        c\n                    })\n                    .collect_vec();\n                debug_assert_eq!(\n                    coeffs.iter().step_by(1 << l_skip).copied().sum::<EF>(),\n                    EF::ZERO,\n                    \"Zerocheck sum is not zero for air_id: {}\",\n                    entry.air_idx\n                );\n\n                batch_sp_poly[2 * num_present_airs + entry.trace_idx] =\n                    UnivariatePoly::new(coeffs);\n            }\n\n            if !entry.logup_result.is_empty() {\n                let evals = entry.logup_result.to_host()?;\n                let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n                    evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n                if entry.n.is_negative() {\n                    // normalize for lifting\n                    let norm_factor = F::from_u32(1 << entry.n.unsigned_abs()).inverse();\n                    for s in &mut numer {\n                        *s *= norm_factor;\n                    }\n                }\n                let mut numer_values = EF::zero_vec(entry.num_cosets_logup << l_skip);\n                let mut denom_values = EF::zero_vec(entry.num_cosets_logup << l_skip);\n                for coset_idx in 0..entry.num_cosets_logup {\n                    for i in 0..1 << l_skip {\n                        let src = (coset_idx << l_skip) + i;\n                        let dst = i * entry.num_cosets_logup + coset_idx;\n                        numer_values[dst] = numer[src];\n                        denom_values[dst] = denom[src];\n                    }\n                }\n                // Logup uses cosets 1, g^1, g^2, ... (init = 1, shift = omega_root)\n                batch_sp_poly[2 * entry.trace_idx] =\n                    UnivariatePoly::from_geometric_cosets_evals_idft(\n                        RowMajorMatrix::new(numer_values, entry.num_cosets_logup),\n                        entry.omega_root,\n                        F::ONE, // init = 1 for identity coset\n                    );\n                batch_sp_poly[2 * entry.trace_idx + 1] =\n                    UnivariatePoly::from_geometric_cosets_evals_idft(\n                        RowMajorMatrix::new(denom_values, entry.num_cosets_logup),\n                        entry.omega_root,\n                        F::ONE, // init = 1 for identity coset\n                    );\n            }\n        }\n        self.mem\n            .emit_metrics_with_label(\"prover.batch_constraints.round0\");\n        Ok(batch_sp_poly)\n    }\n\n    // Note: there are no gpu sync points in this function, so span does not indicate kernel times\n    #[instrument(name = \"LogupZerocheck::fold_ple_evals\", level = \"debug\", skip_all)]\n    fn fold_ple_evals(\n        &mut self,\n        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n        r_0: EF,\n    ) -> Result<(), LogupZerocheckError> {\n        let l_skip = self.l_skip;\n        let inv_lagrange_denoms_r0 =\n            compute_barycentric_inv_lagrange_denoms(l_skip, &self.omega_skip_pows, r_0);\n        let d_inv_lagrange_denoms_r0 = inv_lagrange_denoms_r0.to_device()?;\n\n        let mut mem_limit = self.gkr_mem_contribution;\n        // GPU folding for mat_evals_per_trace\n        self.mat_evals_per_trace = ctx\n            .per_trace\n            .iter()\n            .map(|(air_idx, air_ctx)| {\n                let air_pk = &self.pk.per_air[*air_idx];","numLines":350,"startLine":599,"totalLines":1649}}}
