 d\n            );\n    }\n    int err = CHECK_KERNEL();\n    if (err != 0) return err;\n\n    // Batched reduction: each AIR gets its own segment of the tmp_sums_buffer\n    // Find max blocks per segment for reduction block size\n    auto [reduce_grid_unused, reduce_block] = kernel_launch_params(total_x_blocks);\n    unsigned int reduce_warps = div_ceil(reduce_block.x, WARP_SIZE);\n    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n    dim3 reduce_grid(num_airs, d);\n    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n        tmp_sums_buffer, output, segment_offsets, d\n    );\n\n    return CHECK_KERNEL();\n}\n\nextern \"C\" int _fold_selectors_round0("},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2326,"cache_read_input_tokens":99717,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2326},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"297e37a8-7de7-4f8d-9cb1-f45048fd2150","uuid":"597cf27d-d451-4441-b8db-b06ad72a652d"}
