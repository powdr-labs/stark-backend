{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V15QS1LBeaGR4TsxAmQP2S","type":"tool_result","content":"1\tuse std::{ffi::c_void, fmt::Debug, ptr};\n2\t\n3\tuse crate::{\n4\t    copy::MemCopyD2H,\n5\t    error::{check, CudaError},\n6\t    memory_manager::{d_free, d_malloc},\n7\t    stream::{cudaStreamPerThread, cudaStream_t},\n8\t};\n9\t\n10\t#[link(name = \"cudart\")]\n11\textern \"C\" {\n12\t    pub fn cudaMemsetAsync(dst: *mut c_void, value: i32, count: usize, stream: cudaStream_t)\n13\t        -> i32;\n14\t}\n15\t\n16\t/// Struct that owns a buffer allocated on GPU device. The struct only holds the raw pointer and\n17\t/// length, but this struct has a `Drop` implementation which frees the associated device memory.\n18\t#[repr(C)]\n19\tpub struct DeviceBuffer<T> {\n20\t    ptr: *mut T,\n21\t    len: usize,\n22\t}\n23\t\n24\t/// A struct that packs a pointer with a size in bytes to pass on CUDA.\n25\t/// It holds `*const c_void` for being a universal simple type that can be read by CUDA.\n26\t/// Since it is hard to enforce immutability preservation, it just holds `*const`,\n27\t/// but has two separate constructors for more robustness from the usage perspective.\n28\t/// This is essentially a [DeviceBuffer] but without owning the data.\n29\t#[repr(C)]\n30\t#[derive(Debug, Copy, Clone)]\n31\tpub struct DeviceBufferView {\n32\t    pub ptr: *const c_void,\n33\t    pub size: usize,\n34\t}\n35\t\n36\tunsafe impl<T> Send for DeviceBuffer<T> {}\n37\tunsafe impl<T> Sync for DeviceBuffer<T> {}\n38\t\n39\timpl<T> DeviceBuffer<T> {\n40\t    /// Creates an \"empty\" DeviceBuffer with a null pointer and zero length.\n41\t    #[allow(clippy::new_without_default)]\n42\t    pub fn new() -> Self {\n43\t        DeviceBuffer {\n44\t            ptr: ptr::null_mut(),\n45\t            len: 0,\n46\t        }\n47\t    }\n48\t\n49\t    /// # Safety\n50\t    /// - The caller must ensure that the pointer `ptr` is valid for `len` elements of type `T` in\n51\t    ///   device memory.\n52\t    /// - Dropping the constructed buffer will attempt to free the memory. As such, `ptr` must\n53\t    ///   either have been allocated by the internal memory manager (VPMM) or the caller must use\n54\t    ///   `ManuallyDrop` to prevent double-free.\n55\t    pub unsafe fn from_raw_parts(ptr: *mut T, len: usize) -> Self {\n56\t        DeviceBuffer { ptr, len }\n57\t    }\n58\t\n59\t    /// Allocate device memory for `len` elements of type `T`.\n60\t    pub fn with_capacity(len: usize) -> Self {\n61\t        tracing::debug!(\n62\t            \"Creating device buffer of size {} (sizeof type = {})\",\n63\t            len,\n64\t            size_of::<T>()\n65\t        );\n66\t        assert_ne!(len, 0, \"Zero capacity request is wrong\");\n67\t        let size_bytes = std::mem::size_of::<T>() * len;\n68\t        let raw_ptr = d_malloc(size_bytes).expect(\"GPU allocation failed\");\n69\t        #[cfg(feature = \"touchemall\")]\n70\t        {\n71\t            // 0xffffffff is `Fp::invalid()` and shouldn't occur in a trace\n72\t            unsafe {\n73\t                cudaMemsetAsync(raw_ptr, 0xff, size_bytes, cudaStreamPerThread);\n74\t            }\n75\t        }\n76\t        let typed_ptr = raw_ptr as *mut T;\n77\t\n78\t        DeviceBuffer {\n79\t            ptr: typed_ptr,\n80\t            len,\n81\t        }\n82\t    }\n83\t\n84\t    /// Fills the buffer with zeros.\n85\t    pub fn fill_zero(&self) -> Result<(), CudaError> {\n86\t        assert_ne!(self.len, 0, \"Empty buffer\");\n87\t        let size_bytes = std::mem::size_of::<T>() * self.len;\n88\t        check(unsafe { cudaMemsetAsync(self.as_mut_raw_ptr(), 0, size_bytes, cudaStreamPerThread) })\n89\t    }\n90\t\n91\t    /// Fills a suffix of the buffer with zeros.\n92\t    /// The `start_idx` is the index in the buffer, in `T` elements.\n93\t    pub fn fill_zero_suffix(&self, start_idx: usize) -> Result<(), CudaError> {\n94\t        assert!(\n95\t            start_idx < self.len,\n96\t            \"start index has to be smaller than length\"\n97\t        );\n98\t        let size_bytes = std::mem::size_of::<T>() * (self.len - start_idx);\n99\t        check(unsafe {\n100\t            cudaMemsetAsync(\n101\t                self.as_mut_ptr().add(start_idx) as *mut c_void,\n102\t                0,\n103\t                size_bytes,\n104\t                cudaStreamPerThread,\n105\t            )\n106\t        })\n107\t    }\n108\t\n109\t    /// Returns the number of elements in this buffer.\n110\t    pub fn len(&self) -> usize {\n111\t        self.len\n112\t    }\n113\t\n114\t    /// Returns whether the buffer is empty (null pointer or zero length).\n115\t    pub fn is_empty(&self) -> bool {\n116\t        self.len == 0 || self.ptr.is_null()\n117\t    }\n118\t\n119\t    /// Returns a raw mutable pointer to the device data (typed).\n120\t    pub fn as_mut_ptr(&self) -> *mut T {\n121\t        self.ptr\n122\t    }\n123\t\n124\t    /// Returns a raw const pointer to the device data (typed).\n125\t    pub fn as_ptr(&self) -> *const T {\n126\t        self.ptr as *const T\n127\t    }\n128\t\n129\t    /// Returns a `*mut c_void` (untyped) pointer.\n130\t    pub fn as_mut_raw_ptr(&self) -> *mut c_void {\n131\t        self.ptr as *mut c_void\n132\t    }\n133\t\n134\t    /// Returns a `*const c_void` (untyped) pointer.\n135\t    pub fn as_raw_ptr(&self) -> *const c_void {\n136\t        self.ptr as *const c_void\n137\t    }\n138\t\n139\t    /// Converts the buffer to a buffer of different type.\n140\t    /// `T` must be composable of `U`s.\n141\t    pub fn as_buffer<U>(mut self) -> DeviceBuffer<U> {\n142\t        assert_eq!(\n143\t            size_of::<T>() % size_of::<U>(),\n144\t            0,\n145\t            \"the underlying type size must divide the former one\"\n146\t        );\n147\t        assert_eq!(\n148\t            align_of::<T>() % align_of::<U>(),\n149\t            0,\n150\t            \"the underlying type alignment must divide the former one\"\n151\t        );\n152\t        let res = DeviceBuffer {\n153\t            ptr: self.ptr as *mut U,\n154\t            len: self.len * (size_of::<T>() / size_of::<U>()),\n155\t        };\n156\t        self.ptr = ptr::null_mut(); // for safe drop\n157\t        self.len = 0;\n158\t        res\n159\t    }\n160\t\n161\t    pub fn view(&self) -> DeviceBufferView {\n162\t        DeviceBufferView {\n163\t            ptr: self.ptr as *const c_void,\n164\t            size: self.len * size_of::<T>(),\n165\t        }\n166\t    }\n167\t}\n168\t\n169\timpl<T> Drop for DeviceBuffer<T> {\n170\t    fn drop(&mut self) {\n171\t        if !self.ptr.is_null() {\n172\t            tracing::debug!(\n173\t                \"Freeing device buffer of size {} (sizeof type = {})\",\n174\t                self.len,\n175\t                size_of::<T>()\n176\t            );\n177\t            unsafe {\n178\t                d_free(self.ptr as *mut c_void).expect(\"GPU free failed\");\n179\t            }\n180\t            self.ptr = ptr::null_mut();\n181\t            self.len = 0;\n182\t        }\n183\t    }\n184\t}\n185\t\n186\timpl<T: Debug> Debug for DeviceBuffer<T> {\n187\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n188\t        let host_vec = self.to_host().unwrap();\n189\t        write!(f, \"DeviceBuffer (len = {}): {:?}\", self.len(), host_vec)\n190\t    }\n191\t}\n192\t\n193\t#[cfg(test)]\n194\tmod tests {\n195\t    use super::*;\n196\t    use crate::copy::MemCopyH2D;\n197\t\n198\t    #[test]\n199\t    fn test_device_buffer_float() {\n200\t        // Create a DeviceBuffer of 10 floats\n201\t        let db = DeviceBuffer::<f32>::with_capacity(10);\n202\t\n203\t        assert_eq!(db.len(), 10);\n204\t        assert!(!db.as_ptr().is_null());\n205\t        assert!(!db.is_empty());\n206\t\n207\t        // The buffer will be automatically freed at the end of this test\n208\t    }\n209\t\n210\t    #[test]\n211\t    fn test_device_buffer_fill_zero() {\n212\t        let v: Vec<u64> = (0..10).collect();\n213\t        let d_array = v.to_device().unwrap();\n214\t        d_array.fill_zero().unwrap();\n215\t        assert_eq!(d_array.to_host().unwrap(), vec![0; v.len()]);\n216\t    }\n217\t}\n218\t"}]},"parent_tool_use_id":"toolu_01DbPJiTkkS1bkckSRbLU2QH","session_id":"5a79019c-b2e6-4f68-9275-45a371b42d97","uuid":"febfb4b7-2cb8-48e3-adc0-dd72d868a888","timestamp":"2026-04-13T20:20:24.655Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ZuwLVyzyCzcg8zgqBPCdd","type":"tool_result","content":"1\tuse std::{ffi::c_void, sync::Mutex};\n2\t\n3\tuse lazy_static::lazy_static;\n4\t\n5\tuse crate::{\n6\t    d_buffer::DeviceBuffer,\n7\t    error::{check, MemCopyError},\n8\t    stream::{current_stream_sync, cudaStreamPerThread, cudaStream_t, CudaEvent},\n9\t};\n10\t\n11\tlazy_static! {\n12\t    static ref COPY_EVENT: Mutex<CudaEvent> = Mutex::new(CudaEvent::new().unwrap());\n13\t}\n14\t\n15\t#[repr(i32)]\n16\t#[non_exhaustive]\n17\t#[allow(non_camel_case_types)]\n18\t#[derive(Debug, Copy, Clone, Hash, PartialEq, Eq)]\n19\tpub enum cudaMemcpyKind {\n20\t    cudaMemcpyHostToHost = 0,\n21\t    cudaMemcpyHostToDevice = 1,\n22\t    cudaMemcpyDeviceToHost = 2,\n23\t    cudaMemcpyDeviceToDevice = 3,\n24\t    cudaMemcpyDefault = 4,\n25\t}\n26\t\n27\t#[link(name = \"cudart\")]\n28\textern \"C\" {\n29\t    fn cudaMemcpyAsync(\n30\t        dst: *mut c_void,\n31\t        src: *const c_void,\n32\t        count: usize,\n33\t        kind: cudaMemcpyKind,\n34\t        stream: cudaStream_t,\n35\t    ) -> i32;\n36\t}\n37\t\n38\t/// FFI binding for the `cudaMemcpyAsync` function on the default cuda stream.\n39\t///\n40\t/// # Safety\n41\t/// Must follow the rules of the `cudaMemcpyAsync` function from the CUDA runtime API.\n42\tpub unsafe fn cuda_memcpy<const SRC_DEVICE: bool, const DST_DEVICE: bool>(\n43\t    dst: *mut c_void,\n44\t    src: *const c_void,\n45\t    size_bytes: usize,\n46\t) -> Result<(), MemCopyError> {\n47\t    check(unsafe {\n48\t        cudaMemcpyAsync(\n49\t            dst,\n50\t            src,\n51\t            size_bytes,\n52\t            std::mem::transmute::<i32, cudaMemcpyKind>(\n53\t                if DST_DEVICE { 1 } else { 0 } + if SRC_DEVICE { 2 } else { 0 },\n54\t            ),\n55\t            cudaStreamPerThread,\n56\t        )\n57\t    })\n58\t    .map_err(MemCopyError::from)\n59\t}\n60\t\n61\t// Host -> Device\n62\tpub trait MemCopyH2D<T> {\n63\t    fn copy_to(&self, dst: &mut DeviceBuffer<T>) -> Result<(), MemCopyError>;\n64\t    fn to_device(&self) -> Result<DeviceBuffer<T>, MemCopyError>;\n65\t}\n66\t\n67\timpl<T> MemCopyH2D<T> for [T] {\n68\t    fn copy_to(&self, dst: &mut DeviceBuffer<T>) -> Result<(), MemCopyError> {\n69\t        if self.len() > dst.len() {\n70\t            return Err(MemCopyError::SizeMismatch {\n71\t                operation: \"copy_to_device\",\n72\t                host_len: self.len(),\n73\t                device_len: dst.len(),\n74\t            });\n75\t        }\n76\t        let size_bytes = std::mem::size_of_val(self);\n77\t        check(unsafe {\n78\t            cudaMemcpyAsync(\n79\t                dst.as_mut_raw_ptr(),\n80\t                self.as_ptr() as *const c_void,\n81\t                size_bytes,\n82\t                cudaMemcpyKind::cudaMemcpyHostToDevice,\n83\t                cudaStreamPerThread,\n84\t            )\n85\t        })\n86\t        .map_err(MemCopyError::from)\n87\t    }\n88\t\n89\t    fn to_device(&self) -> Result<DeviceBuffer<T>, MemCopyError> {\n90\t        let mut dst = DeviceBuffer::with_capacity(self.len());\n91\t        self.copy_to(&mut dst)?;\n92\t        Ok(dst)\n93\t    }\n94\t}\n95\t\n96\t// Device -> Host\n97\tpub trait MemCopyD2H<T> {\n98\t    fn to_host(&self) -> Result<Vec<T>, MemCopyError>;\n99\t}\n100\t\n101\timpl<T> MemCopyD2H<T> for DeviceBuffer<T> {\n102\t    fn to_host(&self) -> Result<Vec<T>, MemCopyError> {\n103\t        let mut host_vec = Vec::with_capacity(self.len());\n104\t        let size_bytes = std::mem::size_of::<T>() * self.len();\n105\t\n106\t        check(unsafe {\n107\t            cudaMemcpyAsync(\n108\t                host_vec.as_mut_ptr() as *mut c_void,\n109\t                self.as_raw_ptr(),\n110\t                size_bytes,\n111\t                cudaMemcpyKind::cudaMemcpyDeviceToHost,\n112\t                cudaStreamPerThread,\n113\t            )\n114\t        })?;\n115\t        unsafe {\n116\t            COPY_EVENT\n117\t                .lock()\n118\t                .unwrap()\n119\t                .record_and_wait(cudaStreamPerThread)?;\n120\t\n121\t            host_vec.set_len(self.len());\n122\t        }\n123\t\n124\t        Ok(host_vec)\n125\t    }\n126\t}\n127\t\n128\t/// Like [`MemCopyD2H`], but syncs on the calling thread's per-thread stream instead of the global\n129\t/// `COPY_EVENT` mutex. Safe to call from multiple threads without mutex contention.\n130\tpub trait MemCopyD2HStreamSync<T> {\n131\t    fn to_host_on_current_stream(&self) -> Result<Vec<T>, MemCopyError>;\n132\t}\n133\t\n134\timpl<T> MemCopyD2HStreamSync<T> for DeviceBuffer<T> {\n135\t    fn to_host_on_current_stream(&self) -> Result<Vec<T>, MemCopyError> {\n136\t        let mut host_vec = Vec::with_capacity(self.len());\n137\t        let size_bytes = std::mem::size_of::<T>() * self.len();\n138\t        check(unsafe {\n139\t            cudaMemcpyAsync(\n140\t                host_vec.as_mut_ptr() as *mut c_void,\n141\t                self.as_raw_ptr(),\n142\t                size_bytes,\n143\t                cudaMemcpyKind::cudaMemcpyDeviceToHost,\n144\t                cudaStreamPerThread,\n145\t            )\n146\t        })?;\n147\t        current_stream_sync().map_err(MemCopyError::from)?;\n148\t        unsafe {\n149\t            host_vec.set_len(self.len());\n150\t        }\n151\t        Ok(host_vec)\n152\t    }\n153\t}\n154\t\n155\tpub trait MemCopyD2D<T> {\n156\t    fn device_copy(&self) -> Result<DeviceBuffer<T>, MemCopyError>;\n157\t    fn device_copy_to(&self, dst: &mut DeviceBuffer<T>) -> Result<(), MemCopyError>;\n158\t}\n159\t\n160\timpl<T> MemCopyD2D<T> for DeviceBuffer<T> {\n161\t    fn device_copy(&self) -> Result<DeviceBuffer<T>, MemCopyError> {\n162\t        let mut dst = DeviceBuffer::<T>::with_capacity(self.len());\n163\t        self.device_copy_to(&mut dst)?;\n164\t        Ok(dst)\n165\t    }\n166\t\n167\t    fn device_copy_to(&self, dst: &mut DeviceBuffer<T>) -> Result<(), MemCopyError> {\n168\t        let size_bytes = std::mem::size_of::<T>() * self.len();\n169\t\n170\t        check(unsafe {\n171\t            cudaMemcpyAsync(\n172\t                dst.as_mut_raw_ptr(),\n173\t                self.as_raw_ptr(),\n174\t                size_bytes,\n175\t                cudaMemcpyKind::cudaMemcpyDeviceToDevice,\n176\t                cudaStreamPerThread,\n177\t            )\n178\t        })\n179\t        .map_err(MemCopyError::from)\n180\t    }\n181\t}\n182\t\n183\t#[cfg(test)]\n184\tmod tests {\n185\t    use super::*;\n186\t    use crate::d_buffer::DeviceBuffer;\n187\t\n188\t    #[test]\n189\t    fn test_mem_copy() {\n190\t        // Our source data on the host\n191\t        let h = vec![1, 2, 3, 4, 5];\n192\t\n193\t        // 1) Copy to a newly allocated device buffer\n194\t        let d1 = h.to_device().unwrap();\n195\t\n196\t        // 2) Create another device buffer of the same size\n197\t        let mut d2 = DeviceBuffer::<i32>::with_capacity(h.len());\n198\t\n199\t        // 3) Copy into that existing buffer\n200\t        h.copy_to(&mut d2).unwrap();\n201\t\n202\t        // 4) Copy both buffers back to host\n203\t        let h1 = d1.to_host().unwrap();\n204\t        let h2 = d2.to_host().unwrap();\n205\t\n206\t        assert_eq!(h, h1, \"First device buffer mismatch\");\n207\t        assert_eq!(h, h2, \"Second device buffer mismatch\");\n208\t    }\n209\t}\n210\t"}]},"parent_tool_use_id":"toolu_01DbPJiTkkS1bkckSRbLU2QH","session_id":"5a79019c-b2e6-4f68-9275-45a371b42d97","uuid":"9c2b4d18-358b-4f03-a190-7363da398f56","timestamp":"2026-04-13T20:20:24.655Z"}
