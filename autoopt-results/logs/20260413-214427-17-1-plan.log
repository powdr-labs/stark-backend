u32)\n1509\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1510\t            let host = out.to_host()?;\n1511\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1512\t                zc_out[trace_idx].copy_from_slice(&host[(i * sp_deg)..((i + 1) * sp_deg)]);\n1513\t            }\n1514\t        }\n1515\t\n1516\t        Ok(logup_out.into_iter().flatten().chain(zc_out).collect())\n1517\t    }\n1518\t\n1519\t    #[instrument(level = \"debug\", skip_all, fields(round = round))]\n1520\t    fn compute_batch_s_poly(\n1521\t        &mut self,\n1522\t        sp_round_evals: Vec<Vec<EF>>,\n1523\t        num_traces: usize,\n1524\t        round: usize,\n1525\t        mu_pows: &[EF],\n1526\t    ) -> UnivariatePoly<EF> {\n1527\t        debug_assert_eq!(sp_round_evals.len(), 3 * num_traces);\n1528\t        debug_assert_eq!(sp_round_evals.len(), mu_pows.len());\n1529\t        let constraint_degree = self.constraint_degree;\n1530\t        let mut sp_head_zc = vec![EF::ZERO; constraint_degree];\n1531\t        let mut sp_head_logup = vec![EF::ZERO; constraint_degree];\n1532\t        let mut sp_tail = EF::ZERO;\n1533\t        for (trace_idx, &n) in self.n_per_trace.iter().enumerate() {\n1534\t            let n_lift = n.max(0) as usize;\n1535\t            let zc_idx = 2 * num_traces + trace_idx;\n1536\t            let numer_idx = 2 * trace_idx;\n1537\t            let denom_idx = numer_idx + 1;\n1538\t            if round == n_lift + 1 {\n1539\t                let eq_r_acc = *self.eq_ns.last().unwrap();\n1540\t                let eq_sharp_r_acc = *self.eq_sharp_ns.last().unwrap();\n1541\t                self.zerocheck_tilde_evals[trace_idx] *= eq_r_acc;\n1542\t                self.logup_tilde_evals[trace_idx][0] *= eq_sharp_r_acc;\n1543\t                self.logup_tilde_evals[trace_idx][1] *= eq_sharp_r_acc;\n1544\t            }\n1545\t            if round <= n_lift {\n1546\t                for i in 0..constraint_degree {\n1547\t                    sp_head_zc[i] += mu_pows[zc_idx] * sp_round_evals[zc_idx][i];\n1548\t                    sp_head_logup[i] += mu_pows[numer_idx] * sp_round_evals[numer_idx][i]\n1549\t                        + mu_pows[denom_idx] * sp_round_evals[denom_idx][i];\n1550\t                }\n1551\t            } else {\n1552\t                sp_tail += mu_pows[zc_idx] * self.zerocheck_tilde_evals[trace_idx]\n1553\t                    + mu_pows[numer_idx] * self.logup_tilde_evals[trace_idx][0]\n1554\t                    + mu_pows[denom_idx] * self.logup_tilde_evals[trace_idx][1];\n1555\t            }\n1556\t        }\n1557\t        let s_deg = constraint_degree + 1;\n1558\t        let l_skip = self.l_skip;\n1559\t        // With eq(xi,r) contributions\n1560\t        let mut sp_head_evals = vec![EF::ZERO; s_deg];\n1561\t        for i in 0..constraint_degree {\n1562\t            sp_head_evals[i + 1] = self.eq_ns[round - 1] * sp_head_zc[i]\n1563\t                + self.eq_sharp_ns[round - 1] * sp_head_logup[i];\n1564\t        }\n1565\t        // We need to derive s'(0).\n1566\t        // We use that s_j(0) + s_j(1) = s_{j-1}(r_{j-1})\n1567\t        let xi_cur = self.xi[l_skip + round - 1];\n1568\t        {\n1569\t            let eq_xi_0 = EF::ONE - xi_cur;\n1570\t            let eq_xi_1 = xi_cur;\n1571\t            sp_head_evals[0] =\n1572\t                (self.prev_s_eval - eq_xi_1 * sp_head_evals[1] - sp_tail) * eq_xi_0.inverse();\n1573\t        }\n1574\t        // s' has degree s_deg - 1\n1575\t        let sp_head = UnivariatePoly::lagrange_interpolate(\n1576\t            &(0..s_deg).map(F::from_usize).collect_vec(),\n1577\t            &sp_head_evals,\n1578\t        );\n1579\t        // eq(xi, X) = (2 * xi - 1) * X + (1 - xi)\n1580\t        // Compute s(X) = eq(xi, X) * s'_head(X) + s'_tail * X (s'_head now contains eq(..,r))\n1581\t        // s(X) has degree s_deg\n1582\t        let mut coeffs = sp_head.into_coeffs();\n1583\t        coeffs.push(EF::ZERO);\n1584\t        let b = EF::ONE -