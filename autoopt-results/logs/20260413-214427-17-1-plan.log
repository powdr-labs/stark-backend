                }\n1039\t\n1040\t                // Cached mains\n1041\t                for committed in &air_ctx.cached_mains {\n1042\t                    let trace = &committed.trace;\n1043\t                    let folded = fold_ple_evals_rotate(\n1044\t                        l_skip,\n1045\t                        &self.d_omega_skip_pows,\n1046\t                        trace,\n1047\t                        &d_inv_lagrange_denoms_r0,\n1048\t                        need_rot,\n1049\t                    )?;\n1050\t                    results.push(folded);\n1051\t                }\n1052\t\n1053\t                // Common main\n1054\t                let trace = &air_ctx.common_main;\n1055\t                let folded = fold_ple_evals_rotate(\n1056\t                    l_skip,\n1057\t                    &self.d_omega_skip_pows,\n1058\t                    trace,\n1059\t                    &d_inv_lagrange_denoms_r0,\n1060\t                    need_rot,\n1061\t                )?;\n1062\t                mem_limit = mem_limit.saturating_sub(folded.buffer().len() * size_of::<EF>());\n1063\t                results.push(folded);\n1064\t\n1065\t                Ok(results)\n1066\t            })\n1067\t            .collect::<Result<Vec<_>, FoldPleError>>()?;\n1068\t        if self.save_memory {\n1069\t            self.memory_limit_bytes = mem_limit;\n1070\t        }\n1071\t\n1072\t        // GPU folding for sels_per_trace (rotate=false, only need offset=0)\n1073\t        self.sels_per_trace = std::mem::take(&mut self.sels_per_trace_base)\n1074\t            .into_iter()\n1075\t            .enumerate()\n1076\t            .map(|(trace_idx, selectors_cube)| {\n1077\t                let n = self.n_per_trace[trace_idx];\n1078\t                let num_x = selectors_cube.height();\n1079\t                debug_assert_eq!(num_x, 1 << n.max(0));\n1080\t                debug_assert_eq!(selectors_cube.width(), 3);\n1081\t                let (l, r) = if n.is_negative() {\n1082\t                 