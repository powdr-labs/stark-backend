n1667\t                    .map(|m| m.buffer().len() * size_of::<EF>())\n1668\t                    .sum(),\n1669\t            );\n1670\t        }\n1671\t\n1672\t        // Fold sels_per_trace: Vec<DeviceMatrix<EF>>\n1673\t        self.sels_per_trace = batch_fold(std::mem::take(&mut self.sels_per_trace))?;\n1674\t\n1675\t        for tree in self.eq_xis.values_mut() {\n1676\t            // trim the back (which corresponds to r_{j-1}) because we don't need it anymore\n1677\t            if tree.layers.len() > 1 {\n1678\t                tree.layers.pop();\n1679\t            }\n1680\t        }\n1681\t        let xi = self.xi[self.l_skip + round - 1];\n1682\t        let eq_r = eval_eq_mle(&[xi], &[r_round]);\n1683\t        self.eq_ns.push(self.eq_ns[round - 1] * eq_r);\n1684\t        self.eq_sharp_ns.push(self.eq_sharp_ns[round - 1] * eq_r);\n1685\t        Ok(())\n1686\t    }\n1687\t\n1688\t    #[instrument(\n1689\t        name = \"LogupZerocheck::into_column_openings\",\n1690\t        level = \"debug\",\n1691\t        skip_all\n1692\t    )]\n1693\t    fn into_column_openings(mut self) -> Result<Vec<Vec<Vec<EF>>>, LogupZerocheckError> {\n1694\t        let num_airs_present = self.mat_evals_per_trace.len();\n1695\t        let mut column_openings = Vec::with_capacity(num_airs_present);\n1696\t\n1697\t        // At the end, we've folded all MLEs so they only have one row equal to evaluation at `\\vec\n1698\t        // r`.\n1699\t        for (&need_rot, mat_evals) in self\n1700\t            .needs_next_per_trace\n1701\t            .iter()\n1702\t            .zip(std::mem::take(&mut self.mat_evals_per_trace))\n1703\t        {\n1704\t            // GPU matrices are doubled-width (original + rotated), so we need to split them\n1705\t            // First, copy all matrices to host and split them\n1706\t            let mut split_mats: Vec<Option<ColMajorMatrix<EF>>> = mat_evals\n1707\t                .into_iter()\n1708\t                .map(|mat| {\n1709\t                    let mat