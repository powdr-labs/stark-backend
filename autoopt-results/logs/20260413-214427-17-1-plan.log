ta.has_preprocessed);\n1327\t            let eq_xi_tree = &self.eq_xis[&meta.n_lift];\n1328\t            let log_num_y = meta.n_lift - round;\n1329\t            let interpolated_height = sp_deg * meta.num_y;\n1330\t\n1331\t            let base_ptr = _keepalive_interpolated\n1332\t                .as_ref()\n1333\t                .unwrap()\n1334\t                .as_ptr()\n1335\t                .wrapping_add(meta.interp_offset);\n1336\t\n1337\t            let mut widths_so_far = 0usize;\n1338\t            let sels_ptr = base_ptr.wrapping_add(widths_so_far * interpolated_height);\n1339\t            widths_so_far += 3; // selector width is always 3\n1340\t\n1341\t            let prep_ptr = if meta.has_preprocessed {\n1342\t                MainMatrixPtrs {\n1343\t                    data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1344\t                    air_width: air_width_for_mat(meta.need_rot, mats[0].width()),\n1345\t                }\n1346\t            } else {\n1347\t                MainMatrixPtrs {\n1348\t                    data: std::ptr::null(),\n1349\t                    air_width: 0,\n1350\t                }\n1351\t            };\n1352\t            if meta.has_preprocessed {\n1353\t                widths_so_far += mats[0].width();\n1354\t            }\n1355\t            let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1356\t                .iter()\n1357\t                .map(|m| {\n1358\t                    let main_ptr = MainMatrixPtrs {\n1359\t                        data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1360\t                        air_width: air_width_for_mat(meta.need_rot, m.width()),\n1361\t                    };\n1362\t                    widths_so_far += m.width();\n1363\t                    main_ptr\n1364\t                })\n1365\t                .collect_vec();\n1366\t            debug_assert_eq!(widths_so_far, meta.num_columns);\n1367\t            let main_ptrs_dev = main_ptrs.to_d