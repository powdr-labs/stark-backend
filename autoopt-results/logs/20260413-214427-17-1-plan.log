{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AzNvWLN5EAsF373rydbE9u","type":"tool_result","content":"300\t// LOGUP MONOMIAL KERNELS\n301\t// ============================================================================\n302\t\n303\ttemplate <bool IS_DENOM>\n304\t__global__ void precompute_logup_combinations_kernel(\n305\t    FpExt *__restrict__ out,\n306\t    const MonomialHeader *__restrict__ headers,\n307\t    const InteractionMonomialTerm *__restrict__ terms,\n308\t    const FpExt *__restrict__ beta_pows,\n309\t    const FpExt *__restrict__ eq_3bs,\n310\t    uint32_t num_monomials\n311\t) {\n312\t    uint32_t m = blockIdx.x * blockDim.x + threadIdx.x;\n313\t    if (m >= num_monomials)\n314\t        return;\n315\t\n316\t    MonomialHeader hdr = headers[m];\n317\t    FpExt sum(Fp::zero());\n318\t    for (uint16_t t = 0; t < hdr.num_terms; ++t) {\n319\t        InteractionMonomialTerm term = terms[hdr.term_offset + t];\n320\t        FpExt value = eq_3bs[term.interaction_idx] * term.coefficient;\n321\t        if constexpr (IS_DENOM) {\n322\t            value *= beta_pows[term.field_idx];\n323\t        }\n324\t        sum += value;\n325\t    }\n326\t    out[m] = sum;\n327\t}\n328\t\n329\textern \"C\" int _precompute_logup_numer_combinations(\n330\t    FpExt *out,\n331\t    const MonomialHeader *headers,\n332\t    const InteractionMonomialTerm *terms,\n333\t    const FpExt *eq_3bs,\n334\t    uint32_t num_monomials\n335\t) {\n336\t    if (num_monomials == 0)\n337\t        return 0;\n338\t\n339\t    constexpr uint32_t threads = 256;\n340\t    uint32_t blocks = div_ceil(num_monomials, threads);\n341\t    precompute_logup_combinations_kernel<false><<<blocks, threads>>>(\n342\t        out, headers, terms, nullptr, eq_3bs, num_monomials\n343\t    );\n344\t    return CHECK_KERNEL();\n345\t}\n346\t\n347\textern \"C\" int _precompute_logup_denom_combinations(\n348\t    FpExt *out,\n349\t    const MonomialHeader *headers,\n350\t    const InteractionMonomialTerm *terms,\n351\t    const FpExt *beta_pows,\n352\t    const FpExt *eq_3bs,\n353\t    uint32_t num_monomials\n354\t) {\n355\t    if (num_monomials == 0)\n356\t        return 0;\n357\t\n358\t    constexpr uint32_t threads = 256;\n359\t    uint32_t blocks = div_ceil(num_monomials, threads);\n360\t    precompute_logup_combinations_kernel<true><<<blocks, threads>>>(\n361\t        out, headers, terms, beta_pows, eq_3bs, num_monomials\n362\t    );\n363\t    return CHECK_KERNEL();\n364\t}\n365\t\n366\t// AIR context for logup monomial MLE evaluation\n367\t// Note: These structures match the Rust LogupMonomial*Ctx types\n368\tstruct LogupMonomialCommonCtx {\n369\t    EvalCoreCtx eval_ctx;\n370\t    const FpExt *__restrict__ d_eq_xi;\n371\t    FpExt bus_term_sum; // Precomputed sum_i(beta[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n372\t    uint32_t num_y;\n373\t    uint32_t mono_blocks;\n374\t};\n375\t\n376\tstruct LogupMonomialCtx {\n377\t    const MonomialHeader *__restrict__ d_headers;\n378\t    const PackedVar *__restrict__ d_variables;\n379\t    const FpExt *__restrict__ d_combinations;\n380\t    uint32_t num_monomials;\n381\t};\n382\t\n383\t// Logup monomial MLE kernel - evaluates numerator or denominator monomials per block.\n384\t// This produces FracExt output compatible with the standard reduction pattern.\n385\t//\n386\t// Block assignment: one block per (y_int, mono_block).\n387\t// Each block evaluates a chunk of monomials across threads.\n388\t//\n389\t// Template parameter IS_DENOM:\n390\t//   - false: numerator kernel, writes to tmp_sums[...].p\n391\t//   - true: denominator kernel, writes to tmp_sums[...].q and adds bus_term_sum when mono_block == 0\n392\ttemplate <bool IS_DENOM>\n393\t__global__ void logup_monomial_kernel(\n394\t    FracExt *__restrict__ tmp_sums,\n395\t    const BlockCtx *__restrict__ block_ctxs,\n396\t    const LogupMonomialCommonCtx *__restrict__ common_ctxs,\n397\t    const LogupMonomialCtx *__restrict__ ctxs\n398\t) {\n399\t    extern __shared__ char smem[];\n400\t    FpExt *shared = (FpExt *)smem;\n401\t\n402\t    BlockCtx bctx = block_ctxs[blockIdx.x];\n403\t    LogupMonomialCommonCtx common_ctx = common_ctxs[bctx.air_idx];\n404\t    LogupMonomialCtx ctx = ctxs[bctx.air_idx];\n405\t\n406\t    uint32_t num_x = gridDim.y;\n407\t    uint32_t x_int = blockIdx.y;\n408\t    uint32_t height = num_x * common_ctx.num_y;\n409\t\n410\t    uint32_t mono_blocks = common_ctx.mono_blocks;\n411\t#ifdef CUDA_DEBUG\n412\t    assert(mono_blocks > 0);\n413\t#endif\n414\t    uint32_t y_int = bctx.local_block_idx_x / mono_blocks;\n415\t    uint32_t mono_block = bctx.local_block_idx_x % mono_blocks;\n416\t    uint32_t row = x_int * common_ctx.num_y + y_int;\n417\t    uint32_t m = mono_block * blockDim.x + threadIdx.x;\n418\t\n419\t    FpExt sum(Fp::zero());\n420\t    if (y_int < common_ctx.num_y && m < ctx.num_monomials) {\n421\t        MonomialHeader hdr = ctx.d_headers[m];\n422\t        FpExt monomial = ctx.d_combinations[m];\n423\t        for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n424\t            PackedVar var = ctx.d_variables[hdr.var_offset + v];\n425\t            monomial *= eval_variable(var, row, common_ctx.eval_ctx, height);\n426\t        }\n427\t        sum = monomial * common_ctx.d_eq_xi[y_int];\n428\t    }\n429\t\n430\t    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n431\t\n432\t    if (threadIdx.x == 0) {\n433\t        if constexpr (IS_DENOM) {\n434\t            if (mono_block == 0 && y_int < common_ctx.num_y) {\n435\t                reduced += common_ctx.bus_term_sum * common_ctx.d_eq_xi[y_int];\n436\t            }\n437\t            tmp_sums[blockIdx.x * num_x + x_int].q = reduced;\n438\t        } else {\n439\t            tmp_sums[blockIdx.x * num_x + x_int].p = reduced;\n440\t        }\n441\t    }\n442\t}\n443\t\n444\textern \"C\" int _logup_monomial_batched(\n445\t    FracExt *tmp_sums,\n446\t    FracExt *output,\n447\t    const BlockCtx *block_ctxs,\n448\t    const LogupMonomialCommonCtx *common_ctxs,\n449\t    const LogupMonomialCtx *numer_ctxs,"}]},"parent_tool_use_id":"toolu_013KS8dQEC9gqE94zeTYmmbu","session_id":"5a79019c-b2e6-4f68-9275-45a371b42d97","uuid":"2129cf29-921e-42eb-b327-ee2c88f87e6c","timestamp":"2026-04-13T19:57:36.761Z"}
