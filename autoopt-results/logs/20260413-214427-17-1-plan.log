emit_metrics_with_label(\"prover.before_gkr_input_evals\");\n344\t    prover.mem.reset_peak();\n345\t    let (inputs, alpha) = if has_interactions {\n346\t        log_gkr_input_evals(\n347\t            &prover.trace_interactions,\n348\t            mpk,\n349\t            ctx,\n350\t            l_skip,\n351\t            alpha_logup,\n352\t            &prover.d_challenges,\n353\t            total_leaves,\n354\t        )?\n355\t    } else {\n356\t        (DeviceBuffer::new(), EF::ZERO)\n357\t    };\n358\t    // Set memory limit for batch MLE based on inputs buffer size\n359\t    prover.gkr_mem_contribution = inputs.len() * std::mem::size_of::<Frac<EF>>();\n360\t    prover.memory_limit_bytes = prover.gkr_mem_contribution;\n361\t    if !prover.save_memory {\n362\t        const DEFAULT_MEMORY_LIMIT: usize = 5 << 30; // 5GiB\n363\t        if prover.memory_limit_bytes > DEFAULT_MEMORY_LIMIT {\n364\t            tracing::warn!(\n365\t                \"prover.memory_limit_bytes {} already exceeds 5GiB\",\n366\t                prover.memory_limit_bytes\n367\t            );\n368\t        }\n369\t        prover.memory_limit_bytes = DEFAULT_MEMORY_LIMIT;\n370\t    }\n371\t    prover.mem.emit_metrics_with_label(\"prover.gkr_input_evals\");\n372\t\n373\t    let (frac_sum_proof, mut xi) =\n374\t        fractional_sumcheck_gpu(transcript, inputs, alpha, true, &mut prover.mem)?;\n375\t    while xi.len() != l_skip + n_global {\n376\t        xi.push(transcript.sample_ext());\n377\t    }\n378\t    debug!(?xi);\n379\t    prover.xi = xi;\n380\t\n381\t    logup_gkr_span.exit();\n382\t\n383\t    // Note: this span includes ple_fold, but that function has no cuda synchronization so it does\n384\t    // not include the kernel times for the actual folding\n385\t    let round0_span = info_span!(\"prover.rap_constraints.round0\", phase = \"prover\").entered();\n386\t    // begin batch sumcheck\n387\t    let mut sumcheck_round_polys = Vec::with_capacity(n_max);\n388\t    let mut r = Vec::with_capacity(n_max + 1);\n389\t    // batching randomness\n390\t    let lambda = transcript.sample_ext();\n391\t    debug!(%lambda);\n392\t\n393\t    let sp_0_polys = prover.sumcheck_uni_round0_polys(ctx, lambda)?;\n394\t    let s_0_cpu_span = info_span!(\"s'_0 -> s_0 cpu interpolations\").entered();\n395\t    let sp_0_deg = sumcheck_round0_deg(l_skip, constraint_degree);\n396\t    let s_deg = constraint_degree + 1;\n397\t    let s_0_deg = sumcheck_round0_deg(l_skip, s_deg);\n398\t    let large_uni_domain = (s_0_deg + 1).next_power_of_two();\n399\t    let dft = Radix2BowersSerial;\n400\t    let s_0_logup_polys = {\n401\t        let eq_sharp_uni = eq_sharp_uni_poly(&prover.xi[..l_skip]);\n402\t        let mut eq_coeffs = eq_sharp_uni.into_coeffs();\n403\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n404\t        let eq_evals = dft.dft(eq_coeffs);\n405\t\n406\t        let width = 2 * num_traces;\n407\t        let mut sp_coeffs_mat = EF::zero_vec(width * large_uni_domain);\n408\t        for (i, coeffs) in sp_0_polys[..2 * num_traces].iter().enumerate() {\n409\t            for (j, &c_j) in coeffs.coeffs().iter().enumerate().take(sp_0_deg + 1) {\n410\t                // SAFETY:\n411\t                // - coeffs length is <= sp_0_deg + 1 <= s_0_deg < large_uni_domain\n412\t                // - sp_coeffs_mat allocated for width\n413\t                unsafe {\n414\t                    *sp_coeffs_mat.get_unchecked_mut(j * width + i) = c_j;\n415\t                }\n416\t            }\n417\t        }\n418\t        let mut s_evals = dft.dft_batch(RowMajorMatrix::new(sp_coeffs_mat, width));\n419\t        for (eq, row) in zip(eq_evals, s_evals.values.chunks_mut(width)) {\n420\t            for x in row {\n421\t                *x *= eq;\n422\t            }\n423\t        }\n424\t        dft.idft_batch(s_evals)\n425\t    };\n426\t    let skip_domain_size = F::from_usize(1 << l_skip);\n427\t    // logup sum claims (sum_{\\hat p}, sum_{\\hat q}) per present AIR\n428\t    let (numerator_term_per_air, denominator_term_per_air): (Vec<_>, Vec<_>) = (0..num_traces)\n429\t        .map(|trace_idx| {\n430\t            let [sum_claim_p, sum_claim_q] = [0, 1].map(|is_denom| {\n431\t                // Compute sum over D of s_0(Z) to get the sum claim\n432\t                (0..=s_0_deg)\n433\t                    .step_by(1 << l_skip)\n434\t                    .map(|j| unsafe {\n435\t                        // SAFETY: matrix is 2 * num_trace x large_uni_domain, s_0_deg <\n436\t                        // large_uni_domain\n437\t                        *s_0_logup_polys\n438\t                            .values\n439\t                            .get_unchecked(j * 2 * num_traces + 2 * trace_idx + is_denom)\n440\t                    })\n441\t                    .sum::<EF>()\n442\t                    * skip_domain_size\n443\t            });\n444\t            transcript.observe_ext(sum_claim_p);\n445\t            transcript.observe_ext(sum_claim_q);\n446\t\n447\t            (sum_claim_p, sum_claim_q)\n448\t        })\n449\t        .unzip();\n450\t\n451\t    let mu = transcript.sample_ext();\n452\t    debug!(%mu);\n453\t    let mu_pows = mu.powers().take(3 * num_traces).collect_vec();\n454\t\n455\t    let s_0_zc_poly = {\n456\t        let eq_uni = eq_uni_poly::<F, _>(l_skip, prover.xi[0]);\n457\t        let mut eq_coeffs = eq_uni.into_coeffs();\n458\t        eq_coeffs.resize(large_uni_domain, EF::ZERO);\n459\t        let eq_evals = dft.dft(eq_coeffs);\n460\t\n461\t        // Algebraically batch\n462\t        let mut sp_coeffs = EF::zero_vec(large_uni_domain);\n463\t        let mus = &mu_pows[2 * num_traces..];\n464\t        let polys = &sp_0_polys[2 * num_traces..];\n465\t        for (j, batch_coeff) in sp_coeffs.iter_mut().enumerate().take(sp_0_deg + 1) {\n466\t            for (&mu, poly) in zip(mus, polys) {\n467\t                *batch_coeff += mu * *poly.coeffs().get(j).unwrap_or(&EF::ZERO);\n468\t            }\n469\t        }\n470\t        let mut s_evals = dft.dft(sp_coeffs);\n471\t        for (eq, x) in zip(eq_evals, &mut s_evals) {\n472\t            *x *= eq;\n473\t        }\n474\t        dft.idft(s_evals)\n475\t    };\n476\t\n477\t    // Algebraically batch\n478\t    let s_0_poly = UnivariatePoly::new(\n479\t        zip(\n480\t            s_0_logup_polys.values.chunks_exact(2 * num_traces),\n481\t            s_0_zc_poly,\n482\t        )\n483\t        .take(s_0_deg + 1)\n484\t        .map(|(logup_row, batched_zc)| {\n485\t            let coeff = batched_zc\n486\t                + zip(&mu_pows, logup_row)\n487\t                    .map(|(&mu_j, &x)| mu_j * x)\n488\t                    .sum::<EF>();\n489\t            transcript.observe_ext(coeff);\n490\t            coeff\n491\t        })\n492\t        .collect(),\n493\t    );\n494\t    drop(s_0_cpu_span);\n495\t\n496\t    let r_0 = transcript.sample_ext();\n497\t    r.push(r_0);\n498\t    debug!(round = 0, r_round = %r_0);\n499\t    prover.prev_s_eval = s_0_poly.eval_at_point(r_0);\n500\t    debug!(\"s_0(r_0) = {}\", prover.prev_s_eval);\n501\t\n502\t    prover.fold_ple_evals(ctx, r_0)?;\n503\t    drop(round0_span);\n504\t\n505\t    // Sumcheck rounds:\n506\t    // - each round the prover needs to compute univariate polynomial `s_round`. This poly is linear\n507\t    //   since we are taking MLE of `evals`.\n508\t    // - at end of each round, sample random `r_round` in `EF`\n509\t    //\n510\t    // `s_round` is degree `s_deg` so we evaluate it at `0, ..., =s_deg`. The prover skips\n511\t    // evaluation at `0` because the verifier can infer it from the previous round's\n512\t    // `s_{round-1}(r)` claim. The degree is constraint_degree + 1, where + 1 is from eq term\n513\t    let mle_rounds_span =\n514\t        info_span!(\"prover.rap_constraints.mle_rounds\", phase = \"prover\").entered();\n515\t    debug!(%s_deg);\n516\t    for round in 1..=n_max {\n517\t        let sp_round_evals = prover.sumcheck_polys_batch_eval(round, r[round - 1])?;\n518\t        let batch_s = prover.compute_batch_s_poly(sp_round_evals, num_traces, round, &mu_pows);\n519\t        let batch_s_evals = (1..=s_deg)\n520\t            .map(|i| batch_s.eval_at_point(EF::from_usize(i)))\n521\t            .collect_vec();\n522\t        for &eval in &batch_s_evals {\n523\t            transcript.observe_ext(eval);\n524\t        }\n525\t        sumcheck_round_polys.push(batch_s_evals);\n526\t\n527\t        let r_round = transcript.sample_ext();\n528\t        debug!(%round, %r_round);\n529\t        r.push(r_round);\n530\t        prover.prev_s_eval = batch_s.eval_at_point(r_round);\n531\t\n532\t        prover.fold_mle_evals(round, r_round)?;\n533\t    }\n534\t    assert_eq!(r.len(), n_max + 1);\n535\t\n536\t    let column_openings = prover.into_column_openings()?;\n537\t\n538\t    let need_rot_per_trace = ctx\n539\t        .per_trace\n540\t        .iter()\n541\t        .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n542\t        .collect::<Vec<_>>();\n543\t    // Observe common main openings first, and then preprocessed/cached\n544\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n545\t        for (claim, claim_rot) in column_openings_by_rot(&openings[0], *need_rot) {\n546\t            transcript.observe_ext(claim);\n547\t            transcript.observe_ext(claim_rot);\n548\t        }\n549\t    }\n550\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n551\t        for part in openings.iter().skip(1) {\n552\t            for (claim, claim_rot) in column_openings_by_rot(part, *need_rot) {\n553\t                transcript.observe_ext(claim);\n554\t                transcript.observe_ext(claim_rot);\n555\t            }\n556\t        }\n557\t    }\n558\t    drop(mle_rounds_span);\n559\t\n560\t    let batch_constraint_proof = BatchConstraintProof {\n561\t        numerator_term_per_air,\n562\t        denominator_term_per_air,\n563\t        univariate_round_coeffs: s_0_poly.into_coeffs(),\n564\t        sumcheck_round_polys,\n565\t        column_openings,\n566\t    };\n567\t    let gkr_proof = GkrProof {\n568\t        logup_pow_witness,\n569\t        q0_claim: frac_sum_proof.fractional_sum.1,\n570\t        claims_per_layer: frac_sum_proof.claims_per_layer,\n571\t        sumcheck_polys: frac_sum_proof.sumcheck_polys,\n572\t    };\n573\t    Ok((gkr_proof, batch_constraint_proof, r))\n574\t}\n575\t\n576\tpub struct LogupZerocheckGpu<'a, HS: GpuHashScheme> {\n577\t    pub alpha_logup: EF,\n578\t    pub beta_pows: Vec<EF>,\n579\t    // [alpha, beta^0, beta^1, .., beta^max_interaction_len]\n580\t    pub d_challenges: DeviceBuffer<EF>,\n581\t\n582\t    pub l_skip: usize,\n583\t    n_logup: usize,\n584\t    n_global: usize,\n585\t\n586\t    pub omega_skip: F,\n587\t    pub omega_skip_pows: Vec<F>,\n588\t    d_omega_skip_pows: DeviceBuffer<F>,\n589\t\n590\t    pub interactions_layout: StackedLayout,\n591\t    pub constraint_degree: usize,\n592\t    n_per_trace: Vec<isize>,\n593\t    max_num_constraints: usize,\n594\t    pub monomial_num_y_threshold: u32,\n595\t    sm_count: u32,\n596\t    // Available after GKR:\n597\t    pub xi: Vec<EF>,\n598\t    pub lambda_pows: Option<DeviceBuffer<EF>>,\n599\t    /// Precomputed lambda combinations per AIR (indexed by air_idx). Set when lambda is sampled.\n600\t    lambda_combinations: Vec<Option<DeviceBuffer<EF>>>,\n601\t    /// Beta powers on device for logup MLE rounds.\n602\t    d_beta_pows: DeviceBuffer<EF>,\n603\t    /// Precomputed logup combinations per trace (indexed by trace_idx). Set when xi is sampled.\n604\t    logup_combinations: Vec<Option<LogupCombinations>>,\n605\t\n606\t    // n_T => segment tree of eq(xi[j..1+n_T]) for j=1..={n_T-round+1} in _reverse_ layout\n607\t    eq_xis: FxHashMap<usize, EqEvalLayers<EF>>,\n608\t    eq_3b_per_trace: Vec<Vec<EF>>,\n609\t    d_eq_3b_per_trace: Vec<DeviceBuffer<EF>>,\n610\t    // Evaluations on hypercube only, for round 0\n611\t    sels_per_trace_base: Vec<DeviceMatrix<F>>,\n612\t    // After univariate round 0:\n613\t    mat_evals_per_trace: Vec<Vec<DeviceMatrix<EF>>>,\n614\t    sels_per_trace: Vec<DeviceMatrix<EF>>,\n615\t    // Store public_values per trace (similar to CPU's EvalHelper)\n616\t    public_values_per_trace: Vec<DeviceBuffer<F>>,\n617\t    air_indices_per_trace: Vec<usize>,\n618\t    zerocheck_tilde_evals: Vec<EF>,\n619\t    logup_tilde_evals: Vec<[EF; 2]>,\n620\t    needs_next_per_trace: Vec<bool>,\n621\t\n622\t    trace_interactions: Vec<Option<TraceInteractionMeta>>,\n623\t    // round0: Round0Buffers,\n624\t    pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n625\t\n626\t    // In round `j`, contains `s_{j-1}(r_{j-1})`\n627\t    pub(crate) prev_s_eval: EF,\n628\t    pub(crate) eq_ns: Vec<EF>,\n629\t    pub(crate) eq_sharp_ns: Vec<EF>,\n630\t\n631\t    mem: MemTracker,\n632\t    save_memory: bool,\n633\t\n634\t    gkr_mem_contribution: usize,\n635\t    /// Memory limit for batch MLE intermediate buffers (set after GKR input eval)\n636\t    memory_limit_bytes: usize,\n637\t}\n638\t\n639\timpl<'a, HS: GpuHashScheme> LogupZerocheckGpu<'a, HS> {\n640\t    #[allow(clippy::too_many_arguments)]\n641\t    fn new(\n642\t        pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n643\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n644\t        n_logup: usize,\n645\t        interactions_layout: StackedLayout,\n646\t        alpha_logup: EF,\n647\t        beta_logup: EF,\n648\t        save_memory: bool,\n649\t        monomial_num_y_threshold: u32,\n650\t        sm_count: u32,\n651\t    ) -> Result<Self, LogupZerocheckError> {\n652\t        let mem = MemTracker::start(\"prover.logup_zerocheck_prover\");\n653\t        let l_skip = pk.params.l_skip;\n654\t        let omega_skip = F::two_adic_generator(l_skip);\n655\t        let omega_skip_pows = omega_skip.powers().take(1 << l_skip).collect_vec();\n656\t        let d_omega_skip_pows = omega_skip_pows.to_device()?;\n657\t        let num_airs_present = ctx.per_trace.len();\n658\t\n659\t        let constraint_degree = pk.max_constraint_degree;\n660\t\n661\t        let max_interaction_length = pk\n662\t            .per_air\n663\t            .iter()\n664\t            .map(|air_pk| air_pk.other_data.interaction_rules.max_fields_len)\n665\t            .max()\n666\t            .unwrap_or(0);\n667\t        let beta_pows = beta_logup\n668\t            .powers()\n669\t            .take(max_interaction_length + 1)\n670\t            .collect_vec();\n671\t        let challenges = [&[alpha_logup], &beta_pows[..]].concat();\n672\t        let d_challenges = challenges.to_device()?;\n673\t        let d_beta_pows = beta_pows.to_device()?;\n674\t\n675\t        let n_per_trace: Vec<isize> = ctx\n676\t            .common_main_traces()\n677\t            .map(|(_, t)| log2_strict_usize(t.height()) as isize - l_skip as isize)\n678\t            .collect();\n679\t        let n_max = n_per_trace[0].max(0) as usize;\n680\t        let n_global = max(n_max, n_logup);\n681\t        info!(%n_global, %n_logup);\n682\t\n683\t        let max_num_constraints = pk\n684\t            .per_air\n685\t            .iter()\n686\t            .map(|air_pk| {\n687\t                air_pk\n688\t                    .vk\n689\t                    .symbolic_constraints\n690\t                    .constraints\n691\t                    .constraint_idx\n692\t                    .len()\n693\t            })\n694\t            .max()\n695\t            .unwrap_or(0);\n696\t\n697\t        // Collect interaction metadata for GPU execution (evaluations still run on CPU for now).\n698\t        let trace_interactions = collect_trace_interactions(pk, ctx, &interactions_layout);\n699\t\n700\t        let needs_next_per_trace = ctx\n701\t            .per_trace\n702\t            .iter()\n703\t            .map(|(air_idx, _)| pk.per_air[*air_idx].vk.params.need_rot)\n704\t            .collect::<Vec<_>>();\n705\t\n706\t        Ok(Self {\n707\t            alpha_logup,\n708\t            beta_pows,\n709\t            d_challenges,\n710\t            l_skip,\n711\t            n_logup,\n712\t            n_global,\n713\t            omega_skip,\n714\t            omega_skip_pows,\n715\t            d_omega_skip_pows,\n716\t            interactions_layout,\n717\t            constraint_degree,\n718\t            n_per_trace,\n719\t            max_num_constraints,\n720\t            sm_count,\n721\t            xi: vec![],\n722\t            lambda_pows: None,\n723\t            lambda_combinations: (0..pk.per_air.len()).map(|_| None).collect(),\n724\t            d_beta_pows,\n725\t            logup_combinations: (0..num_airs_present).map(|_| None).collect(),\n726\t            eq_xis: FxHashMap::default(),\n727\t            eq_3b_per_trace: vec![],\n728\t            d_eq_3b_per_trace: vec![],\n729\t            sels_per_trace_base: vec![],\n730\t            mat_evals_per_trace: vec![],\n731\t            sels_per_trace: vec![],\n732\t            public_values_per_trace: ctx\n733\t                .per_trace\n734\t                .iter()\n735\t                .map(|(_, air_ctx)| {\n736\t                    if air_ctx.public_values.is_empty() {\n737\t                        Ok(DeviceBuffer::new())\n738\t                    } else {\n739\t                        air_ctx.public_values.to_device()\n740\t                    }\n741\t                })\n742\t                .collect::<Result<Vec<_>, _>>()?,\n743\t            air_indices_per_trace: ctx\n744\t                .per_trace\n745\t                .iter()\n746\t                .map(|(air_idx, _)| *air_idx)\n747\t                .collect_vec(),\n748\t            zerocheck_tilde_evals: vec![EF::ZERO; num_airs_present],\n749\t            logup_tilde_evals: vec![[EF::ZERO; 2]; num_airs_present],\n750\t            needs_next_per_trace,\n751\t            trace_interactions,\n752\t            pk,\n753\t            prev_s_eval: EF::ZERO,\n754\t            eq_ns: Vec::with_capacity(n_max + 1),\n755\t            eq_sharp_ns: Vec::with_capacity(n_max + 1),\n756\t            mem,\n757\t            save_memory,\n758\t            gkr_mem_contribution: 0,\n759\t            memory_limit_bytes: 0, // Set after GKR input eval\n760\t            monomial_num_y_threshold,\n761\t        })\n762\t    }\n763\t\n764\t    // PERF[jpw]: we could return evals and batch zerocheck poly by degree before interpolating.\n765\t    // Cannot do it for logup because we need to calculate the sum claims.\n766\t    #[instrument(name = \"prover.rap_constraints.ple_round0\", level = \"info\", skip_all)]\n767\t    fn sumcheck_uni_round0_polys(\n768\t        &mut self,\n769\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n770\t        lambda: EF,\n771\t    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n772\t        self.mem\n773\t            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n774\t        self.mem.reset_peak();\n775\t        let n_logup = self.n_logup;\n776\t        let l_skip = self.l_skip;\n777\t        let xi = &self.xi;\n778\t        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n779\t        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n780\t            h_lambda_pows.to_device()?\n781\t        } else {\n782\t            DeviceBuffer::new()\n783\t        });\n784\t        // Precompute lambda combinations for all AIRs with monomials\n785\t        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n786\t        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n787\t            if air_pk.other_data.zerocheck_monomials.is_some() {\n788\t                self.lambda_combinations[air_idx] = Some(\n789\t                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n790\t                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n791\t                );\n792\t            }\n793\t        }\n794\t        let num_present_airs = ctx.per_trace.len();\n795\t        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n796\t\n797\t        self.eq_3b_per_trace = ctx\n798\t            .per_trace\n799\t            .iter()"}]},"parent_tool_use_id":"toolu_01F6BHXgyRZqHEtXgykifv6U","session_id":"5a79019c-b2e6-4f68-9275-45a371b42d97","uuid":"13ca4120-b0f3-4ac0-9f3e-3a34cbf45363","timestamp":"2026-04-13T19:57:11.855Z"}
