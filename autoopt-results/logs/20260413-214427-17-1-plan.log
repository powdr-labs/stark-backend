{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017sqjJMk1nGXGk67To93vCb","type":"tool_result","content":"1\tuse std::{array::from_fn, convert::TryInto, env, ffi::c_void, mem::transmute};\n2\t\n3\tuse openvm_cuda_common::{\n4\t    copy::{cuda_memcpy, MemCopyD2H},\n5\t    d_buffer::DeviceBuffer,\n6\t    memory_manager::MemTracker,\n7\t};\n8\tuse openvm_stark_backend::{\n9\t    poly_common::{eval_eq_mle, interpolate_linear_at_01, interpolate_quadratic_at_012},\n10\t    proof::GkrLayerClaims,\n11\t    prover::fractional_sumcheck_gkr::{Frac, FracSumcheckProof},\n12\t    FiatShamirTranscript, StarkProtocolConfig,\n13\t};\n14\tuse p3_field::{Field, PrimeCharacteristicRing};\n15\tuse p3_util::log2_strict_usize;\n16\tuse tracing::{debug_span, instrument};\n17\t\n18\tuse super::errors::FractionalSumcheckError;\n19\tuse crate::{\n20\t    cuda::{\n21\t        logup_zerocheck::{\n22\t            _frac_compute_round_temp_buffer_size, fold_ef_frac_columns,\n23\t            fold_ef_frac_columns_inplace, frac_build_tree_layer, frac_build_tree_two_layers,\n24\t            frac_compute_round, frac_compute_round_and_fold, frac_compute_round_and_fold_inplace,\n25\t            frac_compute_round_and_revert, frac_multifold_raw, frac_precompute_m_build_raw,\n26\t            frac_precompute_m_eval_round_raw,\n27\t        },\n28\t        ntt::{bit_rev_frac_ext, bit_rev_frac_ext_build_k2},\n29\t    },\n30\t    poly::SqrtEqLayers,\n31\t    prelude::EF,\n32\t};\n33\t\n34\tconst GKR_S_DEG: usize = 3;\n35\tconst GKR_WINDOW_SIZE: usize = 3;\n36\tconst GKR_WINDOW_DEFAULT_MIN_N: usize = 22;\n37\t\n38\t/// Describes which buffer operation to use for the next fused compute+fold round.\n39\t#[derive(Debug, Clone, Copy)]\n40\tenum BufferTarget {\n41\t    /// Out-of-place: layer → work_buffer\n42\t    LayerToWork,\n43\t    /// Out-of-place: work_buffer → layer\n44\t    WorkToLayer,\n45\t    /// In-place on layer buffer\n46\t    InPlaceLayer,\n47\t    /// In-place on work_buffer\n48\t    InPlaceWork,\n49\t}\n50\t\n51\t/// Encapsulates ping-pong buffer scheduling state for GKR inner rounds.\n52\t///\n53\t/// This struct manages the decision of whether to use in-place or out-of-place\n54\t/// (ping-pong) kernel variants based on buffer capacities and current data location.\n55\tstruct BufferScheduler {\n56\t    /// True if data currently resides in work_buffer, false if in layer.\n57\t    data_in_work_buffer: bool,\n58\t    /// Maximum capacity of work_buffer in elements.\n59\t    work_buffer_cap: usize,\n60\t}\n61\t\n62\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n63\tenum GkrRoundStrategy {\n64\t    FoldEval,\n65\t    PrecomputeM,\n66\t}\n67\t\n68\tconst PRECOMPUTE_M_TAIL_TILE: usize = 4096;\n69\tconst PRECOMPUTE_M_MIN_TAIL_TILE: usize = 256;\n70\tconst PRECOMPUTE_M_DEFAULT_MIN_BLOCKS: usize = 64;\n71\tconst PRECOMPUTE_M_DEFAULT_TARGET_BLOCKS: usize = 1024;\n72\t\n73\timpl BufferScheduler {\n74\t    /// Creates a new scheduler with data initially in layer buffer.\n75\t    fn new(work_buffer_cap: usize) -> Self {\n76\t        Self {\n77\t            data_in_work_buffer: false,\n78\t            work_buffer_cap,\n79\t        }\n80\t    }\n81\t\n82\t    /// Returns true if we can use ping-pong (out-of-place) for the given post-fold size.\n83\t    fn can_pingpong(&self, post_fold_size: usize) -> bool {\n84\t        post_fold_size <= self.work_buffer_cap\n85\t    }\n86\t\n87\t    /// Determines the next buffer target for a fused compute+fold operation.\n88\t    ///\n89\t    /// For last outer round: uses ping-pong when possible for __restrict__ optimization.\n90\t    /// For non-last outer rounds: preserves layer for tree revert operations.\n91\t    fn next_target(&mut self, post_fold_size: usize, last_outer_round: bool) -> BufferTarget {\n92\t        let can_pingpong = self.can_pingpong(post_fold_size);\n93\t\n94\t        if last_outer_round {\n95\t            if can_pingpong {\n96\t                // Ping-pong to other buffer\n97\t                if self.data_in_work_buffer {\n98\t                    self.data_in_work_buffer = false;\n99\t                    BufferTarget::WorkToLayer\n100\t                } else {\n101\t                    self.data_in_work_buffer = true;\n102\t                    BufferTarget::LayerToWork\n103\t                }\n104\t            } else {\n105\t                // In-place on layer (data must be in layer for early rounds of last outer round)\n106\t                debug_assert!(\n107\t                    !self.data_in_work_buffer,\n108\t                    \"in-place path requires data in layer\"\n109\t                );\n110\t                BufferTarget::InPlaceLayer\n111\t            }\n112\t        } else {\n113\t            // Non-last outer round: preserve layer for tree revert\n114\t            if self.data_in_work_buffer {\n115\t                // Already in work_buffer, stay there in-place\n116\t                BufferTarget::InPlaceWork\n117\t            } else {\n118\t                // Data in layer, move to work_buffer (out-of-place)\n119\t                self.data_in_work_buffer = true;\n120\t                BufferTarget::LayerToWork\n121\t            }\n122\t        }\n123\t    }\n124\t\n125\t    /// Returns the buffer target for the final fold (no fused compute).\n126\t    fn final_fold_target(&self, last_outer_round: bool) -> BufferTarget {\n127\t        if last_outer_round {\n128\t            if self.data_in_work_buffer {\n129\t                BufferTarget::InPlaceWork\n130\t            } else {\n131\t                BufferTarget::InPlaceLayer\n132\t            }\n133\t        } else {\n134\t            // Non-last outer round: fold into work_buffer to preserve layer\n135\t            if self.data_in_work_buffer {\n136\t                BufferTarget::InPlaceWork\n137\t            } else {\n138\t                BufferTarget::LayerToWork\n139\t            }\n140\t        }\n141\t    }\n142\t}\n143\t\n144\tfn precompute_m_enabled() -> bool {\n145\t    !matches!(\n146\t        env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M\"),\n147\t        Ok(val) if matches!(val.as_str(), \"0\" | \"false\" | \"FALSE\" | \"no\" | \"NO\")\n148\t    )\n149\t}\n150\t\n151\tfn precompute_m_min_blocks_threshold() -> usize {\n152\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_BLOCKS\")\n153\t        .ok()\n154\t        .and_then(|val| val.parse::<usize>().ok())\n155\t        .unwrap_or(PRECOMPUTE_M_DEFAULT_MIN_BLOCKS)\n156\t        .max(1)\n157\t}\n158\t\n159\tfn precompute_m_num_tail_blocks(rem_n: usize, w: usize, tail_tile: usize) -> usize {\n160\t    let tail_n = rem_n - w;\n161\t    (1usize << tail_n).div_ceil(tail_tile)\n162\t}\n163\t\n164\tfn precompute_m_target_blocks() -> usize {\n165\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_TARGET_BLOCKS\")\n166\t        .ok()\n167\t        .and_then(|val| val.parse::<usize>().ok())\n168\t        .unwrap_or(PRECOMPUTE_M_DEFAULT_TARGET_BLOCKS)\n169\t        .max(1)\n170\t}\n171\t\n172\tfn precompute_m_tail_tile_override() -> Option<usize> {\n173\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_TAIL_TILE\")\n174\t        .ok()\n175\t        .and_then(|val| val.parse::<usize>().ok())\n176\t        .map(|v| v.clamp(PRECOMPUTE_M_MIN_TAIL_TILE, PRECOMPUTE_M_TAIL_TILE))\n177\t}\n178\t\n179\tfn precompute_m_min_n() -> usize {\n180\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_N\")\n181\t        .ok()\n182\t        .and_then(|val| val.parse::<usize>().ok())\n183\t        .unwrap_or(GKR_WINDOW_DEFAULT_MIN_N)\n184\t}\n185\t\n186\tfn precompute_m_build_tail_tile(\n187\t    rem_n: usize,\n188\t    w: usize,\n189\t    min_blocks_threshold: usize,\n190\t    target_blocks: usize,\n191\t    tail_tile_override: Option<usize>,\n192\t) -> usize {\n193\t    if let Some(tile) = tail_tile_override {\n194\t        return tile;\n195\t    }\n196\t    let tail_n = rem_n - w;\n197\t    let k = 1usize << tail_n;\n198\t    let target_blocks = target_blocks.max(min_blocks_threshold).max(1);\n199\t    let desired_tile = k.div_ceil(target_blocks).max(1);\n200\t    desired_tile.clamp(PRECOMPUTE_M_MIN_TAIL_TILE, PRECOMPUTE_M_TAIL_TILE)\n201\t}\n202\t\n203\tfn choose_precompute_m_window_w(\n204\t    rem_n: usize,\n205\t    rounds_left: usize,\n206\t    min_blocks_threshold: usize,\n207\t    target_blocks: usize,\n208\t    tail_tile_override: Option<usize>,\n209\t    min_n: usize,\n210\t) -> Option<usize> {\n211\t    if rem_n < min_n || rounds_left < GKR_WINDOW_SIZE {\n212\t        return None;\n213\t    }\n214\t    let w = GKR_WINDOW_SIZE;\n215\t    let tail_tile = precompute_m_build_tail_tile(\n216\t        rem_n,\n217\t        w,\n218\t        min_blocks_threshold,\n219\t        target_blocks,\n220\t        tail_tile_override,\n221\t    );\n222\t    (precompute_m_num_tail_blocks(rem_n, w, tail_tile) >= min_blocks_threshold).then_some(w)\n223\t}\n224\t\n225\tfn choose_round_strategy(\n226\t    round: usize,\n227\t    precompute_m_env: bool,\n228\t    precompute_m_min_blocks_threshold: usize,\n229\t    precompute_m_target_blocks: usize,\n230\t    precompute_m_tail_tile_override: Option<usize>,\n231\t    precompute_m_min_n: usize,\n232\t) -> GkrRoundStrategy {\n233\t    if !precompute_m_env {\n234\t        return GkrRoundStrategy::FoldEval;\n235\t    }\n236\t    let start_base = 1usize;\n237\t    let stop = round.div_ceil(2);\n238\t    let rem_n = round - start_base;\n239\t    let rounds_left = stop - start_base;\n240\t    if choose_precompute_m_window_w(\n241\t        rem_n,\n242\t        rounds_left,\n243\t        precompute_m_min_blocks_threshold,\n244\t        precompute_m_target_blocks,\n245\t        precompute_m_tail_tile_override,\n246\t        precompute_m_min_n,\n247\t    )\n248\t    .is_none()\n249\t    {\n250\t        return GkrRoundStrategy::FoldEval;\n251\t    }\n252\t\n253\t    GkrRoundStrategy::PrecomputeM\n254\t}\n255\t\n256\tfn eval_mle_table(points: &[EF], out: &mut [EF]) {\n257\t    // w <= 5 so CPU builds are trivial; avoid GPU kernel/alloc overhead for tiny tables.\n258\t    let n = points.len();\n259\t    let size = 1usize << n;\n260\t    debug_assert!(out.len() >= size);\n261\t    for (bits, dst) in out.iter_mut().enumerate().take(size) {\n262\t        let mut acc = EF::ONE;\n263\t        for (i, &x) in points.iter().enumerate() {\n264\t            let bit = ((bits >> (n - 1 - i)) & 1) == 1;\n265\t            acc *= if bit { x } else { EF::ONE - x };\n266\t        }\n267\t        *dst = acc;\n268\t    }\n269\t}\n270\t\n271\t/// Get low/high eq pointers for the tail portion of the eq buffer, skipping `drop_count` layers.\n272\t/// See `docs/cuda-backend/gkr-prover.md` § \"Eq buffer sqrt decomposition\".\n273\tfn eq_tail_ptrs(\n274\t    eq_buffer: &SqrtEqLayers,\n275\t    drop_count: usize,\n276\t) -> (*const EF, *const EF, usize, usize) {\n277\t    let mut high_n = eq_buffer.high_n();\n278\t    let mut low_n = eq_buffer.low_n();\n279\t    let total_n = high_n + low_n;\n280\t    if drop_count >= total_n {\n281\t        return (std::ptr::null(), std::ptr::null(), 1, 0);\n282\t    }\n283\t    if drop_count <= high_n {\n284\t        high_n -= drop_count;\n285\t    } else {\n286\t        low_n -= drop_count - high_n;\n287\t        high_n = 0;\n288\t    }\n289\t    let tail_n = low_n + high_n;\n290\t    if tail_n == 0 {\n291\t        (std::ptr::null(), std::ptr::null(), 1, 0)\n292\t    } else {\n293\t        (\n294\t            eq_buffer.low.get_ptr(low_n),\n295\t            eq_buffer.high.get_ptr(high_n),\n296\t            1 << low_n,\n297\t            tail_n,\n298\t        )\n299\t    }\n300\t}\n301\t\n302\tfn copy_to_device_ptr<T: Copy>(dst: *mut T, src: &[T]) -> Result<(), FractionalSumcheckError> {\n303\t    if src.is_empty() {\n304\t        return Ok(());\n305\t    }\n306\t    unsafe {\n307\t        cuda_memcpy::<false, true>(\n308\t            dst as *mut c_void,\n309\t            src.as_ptr() as *const c_void,\n310\t            std::mem::size_of_val(src),\n311\t        )?;\n312\t    }\n313\t    Ok(())\n314\t}\n315\t\n316\t/// Observes s_evals in transcript, updates accumulators, and returns the sampled challenge.\n317\t#[allow(clippy::too_many_arguments)]\n318\tfn observe_and_update<SC, TS>(\n319\t    d_sum_evals: &DeviceBuffer<EF>,\n320\t    transcript: &mut TS,\n321\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n322\t    r_vec: &mut Vec<EF>,\n323\t    prev_s_eval: &mut EF,\n324\t    xi_j: EF,\n325\t    eq_r_acc: &mut EF,\n326\t) -> Result<EF, FractionalSumcheckError>\n327\twhere\n328\t    SC: StarkProtocolConfig<EF = EF>,\n329\t    TS: FiatShamirTranscript<SC>,\n330\t{\n331\t    let (s_evals, sp_evals) = reconstruct_s_evals(d_sum_evals, *prev_s_eval, xi_j, *eq_r_acc)?;\n332\t\n333\t    for &eval in &s_evals {\n334\t        transcript.observe_ext(eval);\n335\t    }\n336\t    round_polys_eval.push(s_evals);\n337\t\n338\t    let r = transcript.sample_ext();\n339\t    r_vec.push(r);\n340\t\n341\t    let eq_r = eval_eq_mle(&[xi_j], &[r]);\n342\t    *eq_r_acc *= eq_r;\n343\t    *prev_s_eval = eq_r * interpolate_quadratic_at_012(&sp_evals, r);\n344\t\n345\t    Ok(r)\n346\t}\n347\t\n348\t/// Fused revert + compute round: reverts the tree layer and computes s'_0(1) and s'_0(2).\n349\t///\n350\t/// See `docs/cuda-backend/gkr-prover.md` § \"Sumcheck round strategies\" for context.\n351\t#[allow(clippy::too_many_arguments)]\n352\tfn do_sumcheck_round_and_revert<SC, TS>(\n353\t    eq_buffer: &mut SqrtEqLayers,\n354\t    layer: &mut DeviceBuffer<Frac<EF>>,\n355\t    pq_size: usize,\n356\t    lambda: EF,\n357\t    transcript: &mut TS,\n358\t    d_sum_evals: &mut DeviceBuffer<EF>,\n359\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n360\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n361\t    r_vec: &mut Vec<EF>,\n362\t    prev_s_eval: &mut EF,\n363\t    xi_j: EF,\n364\t    eq_r_acc: &mut EF,\n365\t) -> Result<EF, FractionalSumcheckError>\n366\twhere\n367\t    SC: StarkProtocolConfig<EF = EF>,\n368\t    TS: FiatShamirTranscript<SC>,\n369\t{\n370\t    unsafe {\n371\t        frac_compute_round_and_revert(\n372\t            eq_buffer,\n373\t            layer,\n374\t            pq_size / 2,\n375\t            lambda,\n376\t            d_sum_evals,\n377\t            tmp_block_sums,\n378\t        )\n379\t        .map_err(FractionalSumcheckError::ComputeRound)?;\n380\t    }\n381\t    eq_buffer.drop_layer();\n382\t    observe_and_update(\n383\t        d_sum_evals,\n384\t        transcript,\n385\t        round_polys_eval,\n386\t        r_vec,\n387\t        prev_s_eval,\n388\t        xi_j,\n389\t        eq_r_acc,\n390\t    )\n391\t}\n392\t\n393\t/// Fused compute round: computes s' polynomial AND folds the pq_buffer for next round.\n394\t///\n395\t/// This kernel fuses the fold operation (using `r_prev` from the previous round) into the current\n396\t/// round's compute, eliminating one kernel launch and reducing memory traffic.\n397\t#[allow(clippy::too_many_arguments)]\n398\tfn do_fused_sumcheck_round<SC, TS>(\n399\t    eq_buffer: &mut SqrtEqLayers,\n400\t    src_pq_buffer: &DeviceBuffer<Frac<EF>>,"}]},"parent_tool_use_id":"toolu_01F6BHXgyRZqHEtXgykifv6U","session_id":"5a79019c-b2e6-4f68-9275-45a371b42d97","uuid":"69974251-fa09-4b0e-9b35-8f8f2aea0968","timestamp":"2026-04-13T19:57:16.167Z"}
