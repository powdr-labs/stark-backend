*)smem;\n110\t\n111\t    BlockCtx bctx = block_ctxs[blockIdx.x];\n112\t    MonomialAirCtx actx = air_ctxs[bctx.air_idx];\n113\t\n114\t    uint32_t num_x = gridDim.y;\n115\t    uint32_t x_int = blockIdx.y;\n116\t\n117\t    // Decode y_int and mono_block from local_block_idx_x\n118\t    uint32_t mono_blocks = (actx.num_monomials + threads_per_block - 1) / threads_per_block;\n119\t    uint32_t y_int = bctx.local_block_idx_x / mono_blocks;\n120\t    uint32_t mono_block = bctx.local_block_idx_x % mono_blocks;\n121\t\n122\t    uint32_t height = num_x * actx.num_y;\n123\t    uint32_t row = x_int * actx.num_y + y_int;\n124\t\n125\t    FpExt sum(Fp::zero());\n126\t\n127\t    // Each thread evaluates one monomial\n128\t    uint32_t m = mono_block * threads_per_block + threadIdx.x;\n129\t    if (m < actx.num_monomials) {\n130\t        MonomialHeader hdr = actx.d_headers[m];\n131\t\n132\t        // Evaluate product of variables\n133\t        FpExt product(Fp::one());\n134\t        for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n135\t            PackedVar var = actx.d_variables[hdr.var_offset + v];\n136\t            product *= eval_variable(var, row, actx.eval_ctx, height);\n137\t        }\n138\t\n139\t        sum = product * actx.d_lambda_combinations[m];\n140\t    }\n141\t\n142\t    // Block reduction\n143\t    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n144\t\n145\t    if (threadIdx.x == 0) {\n146\t        // Apply eq_xi here (eliminates separate phase 2)\n147\t        // eq_xi is eq(xi, y) which only depends on y, not x\n148\t        reduced *= actx.d_eq_xi[y_int];\n149\t        tmp_sums[blockIdx.x * num_x + x_int] = reduced;\n150\t    }\n151\t}\n152\t\n153\textern \"C\" int _zerocheck_monomial_batched(\n154\t    FpExt *tmp_sums,\n155\t    FpExt *output,\n156\t    const BlockCtx *block_ctxs,\n157\t    const MonomialAirCtx *air_ctxs,\n158\t    const uint32_t *air_block_offsets,\n159\t    uint32_t num_blocks,\n160\t    uint32_t num_x,\n161\t    uint32_t num_airs,\n162\t    uint32_t threads_per_block\n163\t) {\n164\t    if (num_blocks == 0) {\n165\t        return 0;\n166\t    }\n167\t\n168\t    dim3 grid(num_blocks, num_x);\n169\t    dim3 block(threads_per_block);\n170\t    size_t shmem = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n171\t\n172\t    // Phase 1: Main monomial evaluation kernel\n173\t    zerocheck_monomial_kernel<<<grid, block, shmem>>>(\n174\t        tmp_sums, block_ctxs, air_ctxs, threads_per_block\n175\t    );\n176\t    int err = CHECK_KERNEL();\n177\t    if (err != 0)\n178\t        return err;\n179\t\n180\t    // Phase 2: Batched reduction for all AIRs in single launch\n181\t    // Grid: (num_airs, num_x) - each block handles one (air, x) pair\n182\t    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n183\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n184\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n185\t\n186\t    dim3 reduce_grid(num_airs, num_x);\n187\t    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n188\t        tmp_sums, output, air_block_offsets, num_x\n189\t    );\n190\t\n191\t    return CHECK_KERNEL();\n192\t}\n193\t\n194\t// ============================================================================\n195\t// PAR-Y KERNEL (parallelizes over y_int, tiles monomials)\n196\t// ============================================================================\n197\t\n198\t__global__ void zerocheck_monomial_par_y_kernel(\n199\t    FpExt *__restrict__ tmp_sums,\n200\t    const BlockCtx *__restrict__ block_ctxs,\n201\t    const MonomialAirCtx *__restrict__ air_ctxs,\n202\t    uint32_t threads_per_block,\n203\t    uint32_t chunk_size // monomials per mono_chunk\n204\t) {\n205\t    extern __shared__ char smem[];\n206\t    FpExt *shared = (FpExt *)smem;\n207\t\n208\t    BlockCtx bctx = block_ctxs[blockIdx.x];\n209\t    MonomialAirCtx actx = air_ctxs[bctx.air_idx];\n210\t\n211\t    uint32_t num_x = gridDim.y;\n212\t    uint32_t x_int = blockIdx.y;\n213\t\n214\t    // Decode y_block and mono_chunk from local_block_idx_x\n215\t    // Encoding: local_block_idx_x = y_block * air_mono_chunks + mono_chunk\n216\t    uint32_t air_mono_chunks = (actx.num_monomials + chunk_size - 1) / chunk_size;\n217\t    uint32_t y_block = bctx.local_block_idx_x / air_mono_chunks;\n218\t    uint32_t mono_chunk = bctx.local_block_idx_x % air_mono_chunks;\n219\t\n220\t    // Decode y_int from thread position within y_block\n221\t    uint32_t y_int = threadIdx.x + y_block * threads_per_block;\n222\t    bool active = (y_int < actx.num_y);\n223\t\n224\t    uint32_t height = num_x * actx.num_y;\n225\t    uint32_t row = x_int * actx.num_y + y_int;\n226\t\n227\t    // Contiguous chunk of monomials for this mono_chunk\n228\t    uint32_t mono_start = mono_chunk * chunk_size;\n229\t    uint32_t mono_end = min(mono_start + chunk_size, actx.num_monomials);\n230\t\n231\t    FpExt sum(Fp::zero());\n232\t    if (active) {\n233\t        // Each thread loops over its chunk of monomials\n234\t        for (uint32_t m = mono_start; m < mono_end; ++m) {\n235\t            MonomialHeader hdr = actx.d_headers[m];\n236\t\n237\t            FpExt product(Fp::one());\n238\t            for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n239\t                PackedVar var = actx.d_variables[hdr.var_offset + v];\n240\t                product *= eval_variable(var, row, actx.eval_ctx, height);\n241\t            }\n242\t\n243\t            sum += product * actx.d_lambda_combinations[m];\n244\t        }\n245\t\n246\t        // Apply eq_xi\n247\t        sum *= actx.d_eq_xi[y_int];\n248\t    }\n249\t\n250\t    // Block reduction sums across y_int values in this block\n251\t    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n252\t\n253\t    if (threadIdx.x == 0) {\n254\t        tmp_sums[blockIdx.x * num_x + x_int] = reduced;\n255\t    }\n256\t}\n257\t\n258\textern \"C\" int _zerocheck_monomial_par_y_batched(\n259\t    FpExt *tmp_sums,"}]},"parent_tool_use_id":"toolu_013KS8dQEC9gqE94zeTYmmbu","session_id":"5a79019c-b2e6-4f68-9275-45a371b42d97","uuid":"e75c5767-442f-45c2-b52b-d5aab927b402","timestamp":"2026-04-13T19:57:23.248Z"}
