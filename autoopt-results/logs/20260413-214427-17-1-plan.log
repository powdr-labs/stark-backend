{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BTYpovdhhY5TBrNrGAjBoJ","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    sync::Arc,\n15\t};\n16\t\n17\tuse itertools::{izip, Itertools};\n18\tuse openvm_cuda_common::{\n19\t    copy::{MemCopyD2H, MemCopyD2HStreamSync, MemCopyH2D},\n20\t    d_buffer::DeviceBuffer,\n21\t    error::MemCopyError,\n22\t    memory_manager::MemTracker,\n23\t    stream::current_stream_sync,\n24\t};\n25\tuse openvm_stark_backend::{\n26\t    air_builders::symbolic::SymbolicConstraints,\n27\t    calculate_n_logup,\n28\t    dft::Radix2BowersSerial,\n29\t    p3_matrix::dense::RowMajorMatrix,\n30\t    poly_common::{\n31\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n32\t        UnivariatePoly,\n33\t    },\n34\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n35\t    prover::{\n36\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n37\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n38\t        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n39\t    },\n40\t};\n41\tuse p3_dft::TwoAdicSubgroupDft;\n42\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n43\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n44\tuse rustc_hash::FxHashMap;\n45\tuse tracing::{debug, info, info_span, instrument};\n46\t\n47\tuse crate::{\n48\t    base::DeviceMatrix,\n49\t    cuda::{\n50\t        logup_zerocheck::{\n51\t            batched_interpolate_columns_gpu, fold_selectors_round0, InterpColDesc, MainMatrixPtrs,\n52\t        },\n53\t        sumcheck::batch_fold_mle,\n54\t    },\n55\t    data_transporter::transport_matrix_d2h_col_major,\n56\t    error::LogupZerocheckError,\n57\t    gpu_backend::GenericGpuBackend,\n58\t    hash_scheme::GpuHashScheme,\n59\t    logup_zerocheck::{\n60\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n61\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n62\t    },\n63\t    poly::EqEvalLayers,\n64\t    prelude::{EF, F},\n65\t    sponge::GpuFiatShamirTranscript,\n66\t    utils::compute_barycentric_inv_lagrange_denoms,\n67\t};\n68\t\n69\tpub(crate) mod batch_mle;\n70\tpub(crate) mod batch_mle_monomial;\n71\tmod errors;\n72\tpub(crate) mod fold_ple;\n73\t/// Fraction sumcheck via GKR\n74\tmod fractional;\n75\t/// Logup interaction evaluations for GKR input\n76\tmod gkr_input;\n77\tmod mle_round;\n78\tmod round0;\n79\tpub(crate) mod rules;\n80\t\n81\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n82\tuse batch_mle_monomial::{\n83\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n84\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n85\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n86\t};\n87\tpub use errors::*;\n88\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n89\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n90\tuse round0::evaluate_round0_constraints_gpu;\n91\t\n92\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n93\t/// More threads = more concurrent kernels but more peak GPU memory and more\n94\t/// MemoryManager mutex contention. 8 provides good SM utilization on the RTX 4090.\n95\tconst NUM_ROUND0_STREAMS: usize = 8;\n96\t\n97\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n98\t/// instead of the monomial kernel for high num_y traces.\n99\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n100\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n101\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n102\t\n103\t#[inline]\n104\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n105\t    if need_rot {\n106\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n107\t        (mat_width / 2) as u32\n108\t    } else {\n109\t        mat_width as u32\n110\t    }\n111\t}\n112\t\n113\t/// Result of processing one AIR in Round 0.\n114\tstruct Round0AirResult {\n115\t    trace_idx: usize,\n116\t    zerocheck_poly: Option<UnivariatePoly<EF>>,\n117\t    logup_numer_poly: Option<UnivariatePoly<EF>>,\n118\t    logup_denom_poly: Option<UnivariatePoly<EF>>,\n119\t}\n120\t\n121\t/// All read-only references needed to process one AIR in Round 0.\n122\tstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n123\t    trace_idx: usize,\n124\t    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n125\t    n: isize,\n126\t    selectors_cube: &'a DeviceMatrix<F>,\n127\t    public_values: &'a DeviceBuffer<F>,\n128\t    eq_3bs: &'a [EF],\n129\t    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n130\t    common_main: &'a DeviceMatrix<F>,\n131\t    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n132\t    d_lambda_pows: &'a DeviceBuffer<EF>,\n133\t    beta_pows: &'a [EF],\n134\t    l_skip: usize,\n135\t    constraint_degree: usize,\n136\t    xi: &'a [EF],\n137\t    max_temp_bytes: usize,\n138\t}\n139\t\n140\tfn process_air_round0<HS: GpuHashScheme>(\n141\t    w: &Round0AirWorkItem<HS>,\n142\t) -> Result<Round0AirResult, LogupZerocheckError> {\n143\t    let single_pk = w.single_pk;\n144\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n145\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n146\t    assert!(\n147\t        local_constraint_deg <= w.constraint_degree,\n148\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n149\t        w.constraint_degree\n150\t    );\n151\t\n152\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n153\t    let omega_root = F::two_adic_generator(log_large_domain);\n154\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n155\t\n156\t    let height = w.common_main.height();\n157\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n158\t    for committed in w.cached_mains {\n159\t        main_parts.push(committed.trace.buffer().as_ptr());\n160\t    }\n161\t    main_parts.push(w.common_main.buffer().as_ptr());\n162\t    let d_main_parts = main_parts.to_device()?;\n163\t\n164\t    let n_lift = w.n.max(0) as usize;\n165\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n166\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n167\t\n168\t    let sum_buffer = evaluate_round0_constraints_gpu(\n169\t        single_pk,\n170\t        w.selectors_cube.buffer(),\n171\t        &d_main_parts,\n172\t        w.public_values,\n173\t        eq_xi_tree.get_ptr(n_lift),\n174\t        w.d_lambda_pows,\n175\t        1 << w.l_skip,\n176\t        1 << n_lift,\n177\t        height as u32,\n178\t        num_cosets_zc as u32,\n179\t        omega_root,\n180\t        w.max_temp_bytes,\n181\t    )?;\n182\t\n183\t    let zerocheck_poly = if !sum_buffer.is_empty() {\n184\t        let q_evals = sum_buffer.to_host_on_current_stream()?;\n185\t        let q = {\n186\t            let mut values = EF::zero_vec(num_cosets_zc << w.l_skip);\n187\t            for coset_idx in 0..num_cosets_zc {\n188\t                for i in 0..1 << w.l_skip {\n189\t                    values[i * num_cosets_zc + coset_idx] = q_evals[(coset_idx << w.l_skip) + i];\n190\t                }\n191\t            }\n192\t            UnivariatePoly::from_geometric_cosets_evals_idft(\n193\t                RowMajorMatrix::new(values, num_cosets_zc),\n194\t                omega_root,\n195\t                omega_root,\n196\t            )\n197\t        };\n198\t        let sp_0_deg = sumcheck_round0_deg(w.l_skip, local_constraint_deg);\n199\t        let coeffs = (0..=sp_0_deg)\n200\t            .map(|i| {\n201\t                let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n202\t                if i >= 1 << w.l_skip {\n203\t                    c += q.coeffs()[i - (1 << w.l_skip)];\n204\t                }\n205\t                c\n206\t            })\n207\t            .collect_vec();\n208\t        Some(UnivariatePoly::new(coeffs))\n209\t    } else {\n210\t        None\n211\t    };\n212\t\n213\t    let num_cosets_logup = local_constraint_deg;\n214\t    let sum = evaluate_round0_interactions_gpu(\n215\t        single_pk,\n216\t        &single_air_constraints,\n217\t        w.selectors_cube.buffer(),\n218\t        &d_main_parts,\n219\t        w.public_values,\n220\t        eq_xi_tree.get_ptr(n_lift),\n221\t        w.beta_pows,\n222\t        w.eq_3bs,\n223\t        1 << w.l_skip,\n224\t        1 << n_lift,\n225\t        height as u32,\n226\t        num_cosets_logup as u32,\n227\t        omega_root,\n228\t        w.max_temp_bytes,\n229\t    )?;\n230\t\n231\t    let (logup_numer_poly, logup_denom_poly) = if !sum.is_empty() {\n232\t        let evals = sum.to_host_on_current_stream()?;\n233\t        let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n234\t            evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n235\t        if w.n.is_negative() {\n236\t            let norm_factor = F::from_u32(1 << w.n.unsigned_abs()).inverse();\n237\t            for s in &mut numer {\n238\t                *s *= norm_factor;\n239\t            }\n240\t        }\n241\t        let mut numer_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n242\t        let mut denom_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n243\t        for coset_idx in 0..num_cosets_logup {\n244\t            for i in 0..1 << w.l_skip {\n245\t                let src = (coset_idx << w.l_skip) + i;\n246\t                let dst = i * num_cosets_logup + coset_idx;\n247\t                numer_values[dst] = numer[src];\n248\t                denom_values[dst] = denom[src];\n249\t            }\n250\t        }\n251\t        let numer_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n252\t            RowMajorMatrix::new(numer_values, num_cosets_logup),\n253\t            omega_root,\n254\t            F::ONE,\n255\t        );\n256\t        let denom_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n257\t            RowMajorMatrix::new(denom_values, num_cosets_logup),\n258\t            omega_root,\n259\t            F::ONE,\n260\t        );\n261\t        (Some(numer_poly), Some(denom_poly))\n262\t    } else {\n263\t        (None, None)\n264\t    };\n265\t\n266\t    Ok(Round0AirResult {\n267\t        trace_idx: w.trace_idx,\n268\t        zerocheck_poly,\n269\t        logup_numer_poly,\n270\t        logup_denom_poly,\n271\t    })\n272\t}\n273\t\n274\t#[allow(clippy::type_complexity)]\n275\t#[instrument(level = \"info\", skip_all)]\n276\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n277\t    transcript: &mut TS,\n278\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n279\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n280\t    save_memory: bool,\n281\t    monomial_num_y_threshold: u32,\n282\t    sm_count: u32,\n283\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n284\twhere\n285\t    HS: GpuHashScheme,\n286\t    TS: GpuFiatShamirTranscript<HS::SC>,\n287\t{\n288\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n289\t    let l_skip = mpk.params.l_skip;\n290\t    let constraint_degree = mpk.max_constraint_degree;\n291\t    let num_traces = ctx.per_trace.len();\n292\t\n293\t    // Traces are sorted\n294\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n295\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n296\t    // heights\n297\t    let mut total_interactions = 0u64;\n298\t    let interactions_meta: Vec<_> = ctx\n299\t        .per_trace\n300\t        .iter()"}]},"parent_tool_use_id":"toolu_01F6BHXgyRZqHEtXgykifv6U","session_id":"5a79019c-b2e6-4f68-9275-45a371b42d97","uuid":"15505d8f-a476-46a7-92ca-033397719923","timestamp":"2026-04-13T19:57:09.896Z"}
