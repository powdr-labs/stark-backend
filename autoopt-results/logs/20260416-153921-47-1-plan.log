{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QcduWQkjkqTEYakd9NEBx7","type":"tool_result","content":"1\t#pragma once\n2\t\n3\t#include <algorithm>\n4\t#include <cuda_runtime.h>\n5\t#ifdef CUDA_DEBUG\n6\t#include <cstdio>\n7\t#endif\n8\t\n9\tstatic const size_t MAX_THREADS = 1024;\n10\tstatic const size_t WARP_SIZE = 32;\n11\t\n12\tinline size_t div_ceil(size_t a, size_t b) { return (a + b - 1) / b; }\n13\t\n14\tinline std::pair<dim3, dim3> kernel_launch_params(\n15\t    size_t count,\n16\t    size_t threads_per_block = MAX_THREADS\n17\t) {\n18\t    size_t block = std::min(count, threads_per_block);\n19\t    size_t grid = div_ceil(count, block);\n20\t    return std::make_pair(dim3(grid, 1, 1), dim3(block, 1, 1));\n21\t}\n22\t\n23\tinline std::pair<dim3, dim3> kernel_launch_2d_params(size_t x, size_t y) {\n24\t    dim3 block = dim3(std::min(x, WARP_SIZE), std::min(y, WARP_SIZE));\n25\t    dim3 grid = dim3(div_ceil(x, block.x), div_ceil(y, block.y));\n26\t    return std::make_pair(grid, block);\n27\t}\n28\t\n29\t#define CUDA_OK(expr) do {                                  \\\n30\t    cudaError_t err = expr;                                 \\\n31\t    if (err != cudaSuccess) {                               \\\n32\t        fprintf(stderr, \"CUDA kernel error at %s:%d: %s\\n\", \\\n33\t            __FILE__, __LINE__, cudaGetErrorString(err));   \\\n34\t    }                                                       \\\n35\t} while(0)\n36\t\n37\t#ifdef CUDA_DEBUG\n38\t    inline int cuda_check_kernel(const char* kernel_name) {\n39\t        cudaError_t err = cudaDeviceSynchronize();\n40\t        if (err != cudaSuccess) {\n41\t            fprintf(stderr, \"[ERROR] Kernel '%s' failed: %s\\n\", \n42\t                    kernel_name, cudaGetErrorString(err));\n43\t        }\n44\t        return err;\n45\t    }\n46\t#   define CHECK_KERNEL() cuda_check_kernel(__func__)\n47\t#else\n48\t#   define CHECK_KERNEL() cudaGetLastError()\n49\t#endif\n50\t"}]},"par