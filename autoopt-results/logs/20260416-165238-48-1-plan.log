{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012R7o8fb4fy3EBAHScQL3Cj","type":"tool_result","content":"1\tuse std::{cmp::max, sync::Arc};\n2\t\n3\tuse openvm_cuda_common::d_buffer::DeviceBuffer;\n4\tuse openvm_stark_backend::prover::MatrixDimensions;\n5\t\n6\tuse super::errors::FoldPleError;\n7\tuse crate::{\n8\t    base::DeviceMatrix,\n9\t    cuda::logup_zerocheck::fold_ple_from_evals,\n10\t    prelude::{EF, F},\n11\t};\n12\t\n13\t/// Folds plain using mixed coefficients, folds rotation from evals.\n14\t/// - `mixed` should be mixed coefficient form of the _lifted_ trace.\n15\t/// - `trace_evals` should be unlifted (the original trace).\n16\tpub fn fold_ple_evals_rotate(\n17\t    l_skip: usize,\n18\t    d_omega_skip_pows: &DeviceBuffer<F>,\n19\t    trace_evals: &DeviceMatrix<F>,\n20\t    d_inv_lagrange_denoms_r0: &DeviceBuffer<EF>,\n21\t    need_rot: bool,\n22\t) -> Result<DeviceMatrix<EF>, FoldPleError> {\n23\t    let width = trace_evals.width();\n24\t    let height = trace_evals.height();\n25\t    let num_x = max(height >> l_skip, 1);\n26\t    let out_width = width * if need_rot { 2 } else { 1 };\n27\t    let folded_buf = DeviceBuffer::<EF>::with_capacity(num_x * out_width);\n28\t    // SAFETY:\n29\t    // - We allocated `folded_buf` for `num_x * width * (1 or 2)` elements.\n30\t    // - `trace_evals` is `height x width` unlighted matrix\n31\t    unsafe {\n32\t        fold_ple_evals_gpu(\n33\t            l_skip,\n34\t            d_omega_skip_pows,\n35\t            trace_evals,\n36\t            folded_buf.as_mut_ptr(),\n37\t            d_inv_lagrange_denoms_r0,\n38\t            false,\n39\t        )?;\n40\t\n41\t        if need_rot {\n42\t            // Fold the rotation from evals\n43\t            fold_ple_evals_gpu(\n44\t                l_skip,\n45\t                d_omega_skip_pows,\n46\t                trace_evals,\n47\t                folded_buf.as_mut_ptr().add(num_x * width),\n48\t                d_inv_lagrange_denoms_r0,\n49\t                true,\n50\t            )?;\n51\t        }\n52\t    }\n53\t    let folded = DeviceMatrix::new(Arc::new(folded_buf), num_x, out_width);\n54\t    Ok(folded)\n55\t}\n56\t\n57\t/// Folds PLE evaluations by interpolating univariate polynomials on coset D and evaluating at r_0.\n58\t/// Returns a single matrix of width `width`.\n59\t///\n60\t/// When `rotate` is true, returns the folding of the lift of the rotated matrix.\n61\t/// When `rotate` is false, returns the folding of the lift of the original matrix.\n62\t///\n63\t/// # Assumptions\n64\t/// - `mat` should be the unlifted original matrix of trace evaluations.\n65\t/// - `output` should be a valid pointer to a buffer of size at least `num_x * width` where `num_x =\n66\t///   max(height / 2^l_skip, 1)`.\n67\tpub unsafe fn fold_ple_evals_gpu(\n68\t    l_skip: usize,\n69\t    d_omega_skip_pows: &DeviceBuffer<F>,\n70\t    mat: &DeviceMatrix<F>,\n71\t    output: *mut EF,\n72\t    d_inv_lagrange_denoms_r0: &DeviceBuffer<EF>,\n73\t    rotate: bool,\n74\t) -> Result<(), FoldPleError> {\n75\t    let height = mat.height();\n76\t    let width = mat.width();\n77\t\n78\t    if height == 0 || width == 0 {\n79\t        return Ok(());\n80\t    }\n81\t\n82\t    let skip_domain = d_omega_skip_pows.len();\n83\t    debug_assert_eq!(skip_domain, 1 << l_skip);\n84\t    let lifted_height = max(skip_domain, height);\n85\t    let num_x = lifted_height / skip_domain;\n86\t\n87\t    // Launch kernel\n88\t    unsafe {\n89\t        fold_ple_from_evals(\n90\t            mat.buffer(),\n91\t            output,\n92\t            d_omega_skip_pows,\n93\t            d_inv_lagrange_denoms_r0,\n94\t            height as u32,\n95\t            width as u32,\n96\t            l_skip as u32,\n97\t            num_x as u32,\n98\t            rotate,\n99\t        )?;\n100\t    }\n101\t    Ok(())\n102\t}\n103\t"}]},"parent_tool_use_id":null,"session_id":"b6755d07-23c8-46a3-81f0-36e3b63f2ed6","uuid":"3801d9c1-4841-4133-a5c2-2e184f0e1276","timestamp":"2026-04-16T15:19:10.989Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/fold_ple.rs","content":"use std::{cmp::max, sync::Arc};\n\nuse openvm_cuda_common::d_buffer::DeviceBuffer;\nuse openvm_stark_backend::prover::MatrixDimensions;\n\nuse super::errors::FoldPleError;\nuse crate::{\n    base::DeviceMatrix,\n    cuda::logup_zerocheck::fold_ple_from_evals,\n    prelude::{EF, F},\n};\n\n/// Folds plain using mixed coefficients, folds rotation from evals.\n/// - `mixed` should be mixed coefficient form of the _lifted_ trace.\n/// - `trace_evals` should be unlifted (the original trace).\npub fn fold_ple_evals_rotate(\n    l_skip: usize,\n    d_omega_skip_pows: &DeviceBuffer<F>,\n    trace_evals: &DeviceMatrix<F>,\n    d_inv_lagrange_denoms_r0: &DeviceBuffer<EF>,\n    need_rot: bool,\n) -> Result<DeviceMatrix<EF>, FoldPleError> {\n    let width = trace_evals.width();\n    let height = trace_evals.height();\n    let num_x = max(height >> l_skip, 1);\n    let out_width = width * if need_rot { 2 } else { 1 };\n    let folded_buf = DeviceBuffer::<EF>::with_capacity(num_x * out_width);\n    // SAFETY:\n    // - We allocated `folded_buf` for `num_x * width * (1 or 2)` elements.\n    // - `trace_evals` is `height x width` unlighted matrix\n    unsafe {\n        fold_ple_evals_gpu(\n            l_skip,\n            d_omega_skip_pows,\n            trace_evals,\n            folded_buf.as_mut_ptr(),\n            d_inv_lagrange_denoms_r0,\n            false,\n        )?;\n\n        if need_rot {\n            // Fold the rotation from evals\n            fold_ple_evals_gpu(\n                l_skip,\n                d_omega_skip_pows,\n                trace_evals,\n                folded_buf.as_mut_ptr().add(num_x * width),\n                d_inv_lagrange_denoms_r0,\n                true,\n            )?;\n        }\n    }\n    let folded = DeviceMatrix::new(Arc::new(folded_buf), num_x, out_width);\n    Ok(folded)\n}\n\n/// Folds PLE evaluations by interpolating univariate polynomials on coset D and evaluating at r_0.\n/// Returns a single matrix of width `width`.\n///\n/// When `rotate` is true, returns the folding of the lift of the rotated matrix.\n/// When `rotate` is false, returns the folding of the lift of the original matrix.\n///\n/// # Assumptions\n/// - `mat` should be the unlifted original matrix of trace evaluations.\n/// - `output` should be a valid pointer to a buffer of size at least `num_x * width` where `num_x =\n///   max(height / 2^l_skip, 1)`.\npub unsafe fn fold_ple_evals_gpu(\n    l_skip: usize,\n    d_omega_skip_pows: &DeviceBuffer<F>,\n    mat: &DeviceMatrix<F>,\n    output: *mut EF,\n    d_inv_lagrange_denoms_r0: &DeviceBuffer<EF>,\n    rotate: bool,\n) -> Result<(), FoldPleError> {\n    let height = mat.height();\n    let width = mat.width();\n\n    if height == 0 || width == 0 {\n        return Ok(());\n    }\n\n    let skip_domain = d_omega_skip_pows.len();\n    debug_assert_eq!(skip_domain, 1 << l_skip);\n    let lifted_height = max(skip_domain, height);\n    let num_x = lifted_height / skip_domain;\n\n    // Launch kernel\n    unsafe {\n        fold_ple_from_evals(\n            mat.buffer(),\n            output,\n            d_omega_skip_pows,\n            d_inv_lagrange_denoms_r0,\n            height as u32,\n            width as u32,\n            l_skip as u32,\n            num_x as u32,\n            rotate,\n        )?;\n    }\n    Ok(())\n}\n","numLines":103,"startLine":1,"totalLines":103}}}
