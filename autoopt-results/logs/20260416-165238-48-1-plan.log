{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UwYEjsaS5pRXuPeH5ZC2gc","type":"tool_result","content":"180\t/// buffer.\n181\t#[instrument(skip_all)]\n182\tpub fn rs_code_matrix(\n183\t    log_blowup: usize,\n184\t    layout: &StackedLayout,\n185\t    traces: &[&DeviceMatrix<F>],\n186\t    stacked_matrix: &Option<PleMatrix<F>>,\n187\t) -> Result<DeviceMatrix<F>, RsCodeMatrixError> {\n188\t    let mem = MemTracker::start_and_reset_peak(\"prover.rs_code_matrix\");\n189\t    let l_skip = layout.l_skip();\n190\t    let height = layout.height();\n191\t    let width = layout.width();\n192\t    debug_assert!(height >= (1 << l_skip));\n193\t    let codeword_height = height.checked_shl(log_blowup as u32).unwrap();\n194\t    let mut codewords = DeviceBuffer::<F>::with_capacity(codeword_height * width);\n195\t    // The following kernels together perform MLE interpolation followed by coset NTT for\n196\t    // `width` polys from `height -> codeword_height` size domains.\n197\t    if let Some(stacked_matrix) = stacked_matrix.as_ref() {\n198\t        // SAFETY: `codewords` is allocated for `width` polys of `codeword_height` each, and we\n199\t        // expand from `matrix.mixed` which is `width` polys of `height` each.\n200\t        unsafe {\n201\t            batch_expand_pad(\n202\t                codewords.as_mut_ptr(),\n203\t                stacked_matrix.mixed.as_ptr(),\n204\t                width as u32,\n205\t                codeword_height as u32,\n206\t                height as u32,\n207\t            )\n208\t            .map_err(RsCodeMatrixError::BatchExpandPad)?;\n209\t        }\n210\t    } else {\n211\t        stack_traces_into_expanded(layout, traces, &mut codewords, codeword_height)\n212\t            .map_err(RsCodeMatrixError::StackTraces)?;\n213\t        // Currently codewords has the stacked matrix, batch expanded, in evaluation form on\n214\t        // hyperprism. We convert it to mixed form, i.e., unroll `PleMatrix::from_evals`.\n215\t        // PERF[jpw]: We do some wasted work on the padded zero part. A more specialized kernel\n216\t        // could be written to avoid this.\n217\t        if l_skip > 0 {\n218\t            // For univariate coordinate, perform inverse NTT for each 2^l_skip chunk per column:\n219\t            // (width cols) * (codeword_height / 2^l_skip chunks per col). Use natural ordering.\n220\t            let num_uni_poly = width * (codeword_height >> l_skip);\n221\t            unsafe {\n222\t                batch_ntt_small(&mut codewords, l_skip, num_uni_poly, true)\n223\t                    .map_err(RsCodeMatrixError::CustomBatchIntt)?;\n224\t            }\n225\t        }\n226\t    }\n227\t    // Eval-to-coeff RS encoding: Instead of full n-stage MLE evals→coeffs interpolation\n228\t    // (where n = log_height - l_skip), we only need l_skip stages of coeffs→evals\n229\t    // (subset-zeta transform) within each 2^l_skip chunk. This is a major optimization:\n230\t    // e.g. for log_height=17, l_skip=2: 2 stages instead of 15.\n231\t    let log_codeword_height = log2_strict_usize(codeword_height);\n232\t\n233\t    // Apply l_skip stages of coeffs_to_evals within each 2^l_skip chunk.\n234\t    // After iNTT, each chunk holds Z-monomial coefficients. We apply the subset-zeta\n235\t    // transform to convert to hypercube evaluations over the Z-bit variables.\n236\t    if l_skip > 0 {\n237\t        // SAFETY: `codewords` is properly initialized and parameters are valid.\n238\t        // Steps 2^0, 2^1, ..., 2^(l_skip-1) stay within chunk boundaries.\n239\t        unsafe {\n240\t            mle_interpolate_stages(\n241\t                codewords.as_mut_ptr(),\n242\t                width as u16,\n243\t                codeword_height as u32,\n244\t                log_blowup as u32,\n245\t                0,                 // start_log_step\n246\t                l_skip as u32 - 1, // end_log_step (inclusive)\n247\t                false,             // coeffs to evals (NOT eval to coeff)\n248\t                false,             // natural order\n249\t            )\n250\t            .map_err(|error| RsCodeMatrixError::MleInterpolateStage2d { error, step: 1 })?;\n251\t        }\n252\t    }\n253\t\n254\t    // Bit-reverse the entire buffer in-place (required for NTT)\n255\t    unsafe {\n256\t        bit_rev(\n257\t            &codewords,\n258\t            &codewords,\n259\t            log_codeword_height as u32,\n260\t            codeword_height as u32,\n261\t            width as u32,\n262\t        )\n263\t        .map_err(RsCodeMatrixError::BitRev)?;\n264\t    }\n265\t\n266\t    // Compute RS codeword via DFT on the smoothly-embedded domain.\n267\t    batch_ntt(\n268\t        &codewords,\n269\t        log_codeword_height as u32,\n270\t        0u32,\n271\t        width as u32,\n272\t        false, // bit-reversal already done\n273\t        false,\n274\t    );\n275\t    let code_matrix = DeviceMatrix::new(Arc::new(codewords), codeword_height, width);\n276\t    mem.emit_metrics();\n277\t\n278\t    Ok(code_matrix)\n279\t}\n280\t\n281\timpl<F, Digest> StackedPcsDataGpu<F, Digest> {\n282\t    /// Returns a view of the specified unstacked matrix in mixed form.\n283\t    ///\n284\t    /// # Notes\n285\t    /// - `width` must be the width of the unstacked matrix.\n286\t    /// - The unstacked matrix may be strided - this must be handled by the caller.\n287\t    pub fn mixed_view<'a>(\n288\t        &'a self,\n289\t        mat_idx: usize,\n290\t        width: usize,\n291\t    ) -> Option<DeviceMatrixView<'a, F>> {\n292\t        if let Some(matrix) = self.matrix.as_ref() {\n293\t            debug_assert_eq!(self.layout.width_of(mat_idx), width);\n294\t            let s = self\n295\t                .layout\n296\t                .get(mat_idx, 0)\n297\t                .unwrap_or_else(|| panic!(\"Invalid matrix index: {mat_idx}\"));\n298\t            let l_skip = self.layout.l_skip();\n299\t            let lifted_height = s.len(l_skip);\n300\t            let offset = s.col_idx * matrix.height() + s.row_idx;\n301\t            // SAFETY:\n302\t            // - by definition of stacked layout and stacked matrix, `ptr` is valid and allocated\n303\t            //   for `lifted_height * width` elements.\n304\t            unsafe {\n305\t                let ptr = matrix.mixed.as_ptr().add(offset);\n306\t                Some(DeviceMatrixView::from_raw_parts(ptr, lifted_height, width))\n307\t            }\n308\t        } else {\n309\t            None\n310\t        }\n311\t    }\n312\t}\n313\t\n314\t#[cfg(test)]\n315\tmod tests {\n316\t    use itertools::Itertools;\n317\t    use openvm_stark_backend::{\n318\t        prover::ColMajorMatrix,\n319\t        test_utils::{InteractionsFixture11, TestFixture},\n320\t    };\n321\t    use p3_field::PrimeCharacteristicRing;\n322\t\n323\t    use super::*;\n324\t    use crate::{\n325\t        data_transporter::{transport_matrix_d2h_col_major, transport_matrix_h2d_col_major},\n326\t        prelude::{F, SC},\n327\t    };\n328\t\n329\t    #[test]"}]},"parent_tool_use_id":"toolu_01Fz8REZyQSEpABv1W3jVCYw","session_id":"b6755d07-23c8-46a3-81f0-36e3b63f2ed6","uuid":"7295dc5d-e0d2-450b-a0a2-19f0ecca17a4","timestamp":"2026-04-16T14:57:49.872Z"}
