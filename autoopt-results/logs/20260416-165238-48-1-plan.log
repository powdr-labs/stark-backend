375\t    air_block_offsets: &DeviceBuffer<u32>,\n1376\t    num_blocks: u32,\n1377\t    num_x: u32,\n1378\t    num_airs: u32,\n1379\t    threads_per_block: u32,\n1380\t) -> Result<(), CudaError> {\n1381\t    CudaError::from_result(_logup_monomial_batched(\n1382\t        tmp_sums.as_mut_ptr(),\n1383\t        output.as_mut_ptr(),\n1384\t        block_ctxs.as_ptr(),\n1385\t        common_ctxs.as_ptr(),\n1386\t        numer_ctxs.as_ptr(),\n1387\t        denom_ctxs.as_ptr(),\n1388\t        air_block_offsets.as_ptr(),\n1389\t        num_blocks,\n1390\t        num_x,\n1391\t        num_airs,\n1392\t        threads_per_block,\n1393\t    ))\n1394\t}\n1395\t\n1396\tpub unsafe fn frac_vector_scalar_multiply_ext_fp(\n1397\t    frac_vec: *mut Frac<EF>,\n1398\t    scalar: F,\n1399\t    length: u32,\n1400\t) -> Result<(), CudaError> {\n1401\t    CudaError::from_result(_frac_vector_scalar_multiply_ext_fp(\n1402\t        frac_vec, scalar, length,\n1403\t    ))\n1404\t}\n1405\t\n1406\t/// Vertically repeats the rows of `input` and writes them to `out`. Both matrices are column-major.\n1407\t///\n1408\t/// # Safety\n1409\t/// - `out` must be a pointer to `DeviceBuffer<F>` with length at least `lifted_height * width`.\n1410\t/// - `input` must be a pointer to `DeviceBuffer<F>` with length at least `height * width`.\n1411\t/// - `out` and `input` must not overlap.\n1412\tpub unsafe fn frac_matrix_vertically_repeat(\n1413\t    out: *mut Frac<EF>,\n1414\t    input: *const Frac<EF>,\n1415\t    width: u32,\n1416\t    lifted_height: u32,\n1417\t    height: u32,\n1418\t) -> Result<(), CudaError> {\n1419\t    debug_assert!(lifted_height > height);\n1420\t    CudaError::from_result(_frac_matrix_vertically_repeat(\n1421\t        out,\n1422\t        input,\n1423\t        width,\n1424\t        lifted_height,\n1425\t        height,\n1426\t    ))\n1427\t}\n1428\t\n1429\tpub unsafe fn frac_matrix_vertically_repeat_ext(\n1430\t    out_numerators: *mut EF,\n1431\t    out_denominators: *mut EF,\n1432\t  