{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016M9MywQny6vemnxxVnrTtq","type":"tool_result","content":"1\tuse std::sync::Arc;\n2\t\n3\tuse serde::{de::DeserializeOwned, Serialize};\n4\t\n5\tuse crate::{\n6\t    keygen::types::MultiStarkProvingKey,\n7\t    prover::{\n8\t        stacked_pcs::StackedPcsData, AirProvingContext, ColMajorMatrix, CommittedTraceData,\n9\t        CpuColMajorBackend, DeviceMultiStarkProvingKey, ProvingContext,\n10\t    },\n11\t    StarkProtocolConfig,\n12\t};\n13\t\n14\tpub trait MatrixDimensions {\n15\t    fn height(&self) -> usize;\n16\t    fn width(&self) -> usize;\n17\t}\n18\t\n19\t/// Associated types needed by the prover, in the form of buffers and views,\n20\t/// specific to a specific hardware backend.\n21\t///\n22\t/// Memory allocation and copying is not handled by this trait.\n23\tpub trait ProverBackend {\n24\t    /// Extension field degree for the challenge field `Self::Challenge` over base field\n25\t    /// `Self::Val`.\n26\t    const CHALLENGE_EXT_DEGREE: u8;\n27\t    // ==== Host Types ====\n28\t    /// Base field type, on host.\n29\t    type Val: Copy + Send + Sync + Serialize + DeserializeOwned;\n30\t    /// Challenge field (extension field of base field), on host.\n31\t    type Challenge: Copy + Send + Sync + Serialize + DeserializeOwned;\n32\t    /// Single commitment on host.\n33\t    // Commitments are small in size and need to be transferred back to host to be included in\n34\t    // proof.\n35\t    type Commitment: Clone + Send + Sync + Serialize + DeserializeOwned;\n36\t\n37\t    // ==== Device Types ====\n38\t    /// Single matrix buffer on device together with dimension metadata. Owning this means nothing\n39\t    /// else has a shared reference to the buffer.\n40\t    type Matrix: MatrixDimensions + Send + Sync;\n41\t    /// Backend specific type for any pre-computed data associated with a single AIR. For example,\n42\t    /// it may contain prover-specific precomputations based on the AIR constraints (but\n43\t    /// independent from any trace data).\n44\t    type OtherAirData: Send + Sync;\n45\t    /// Owned buffer for the preimage of a PCS commitment on device, together with any metadata\n46\t    /// necessary for computing opening proofs.\n47\t    ///\n48\t    /// For example, multiple buffers for LDE matrices, their trace domain sizes, and pointer to\n49\t    /// mixed merkle tree.\n50\t    type PcsData: Send + Sync;\n51\t}\n52\t\n53\tpub trait ProverDevice<PB: ProverBackend, TS>:\n54\t    TraceCommitter<PB> + MultiRapProver<PB, TS> + OpeningProver<PB, TS>\n55\t{\n56\t    type Error: 'static\n57\t        + std::error::Error\n58\t        + Send\n59\t        + Sync\n60\t        + From<<Self as TraceCommitter<PB>>::Error>\n61\t        + From<<Self as MultiRapProver<PB, TS>>::Error>\n62\t        + From<<Self as OpeningProver<PB, TS>>::Error>;\n63\t}\n64\t\n65\t/// Provides functionality for committing to a batch of trace matrices, possibly of different\n66\t/// heights.\n67\tpub trait TraceCommitter<PB: ProverBackend> {\n68\t    type Error: std::fmt::Debug;\n69\t    fn commit(&self, traces: &[&PB::Matrix]) -> Result<(PB::Commitment, PB::PcsData), Self::Error>;\n70\t}\n71\t\n72\t/// This trait is responsible for all proving steps to prove a collection of trace matrices\n73\t/// satisfies all constraints of a Randomized AIR with Preprocessing. Such constraints include AIR\n74\t/// constraints as well as bus balancing constraints for interactions between AIRs. These\n75\t/// constraints may be grouped into challenge phases, where new randomness is sampled between phases\n76\t/// via Fiat-Shamir (which would involve committing to more data).\n77\t///\n78\t/// This trait is _not_ responsible for committing to the trace matrices or for proving polynomial\n79\t/// openings with respect to the committed trace matrices.\n80\tpub trait MultiRapProver<PB: ProverBackend, TS> {\n81\t    /// The partial proof is the proof that the trace matrices satisfy all constraints assuming that\n82\t    /// certain polynomial opening claims are validated. In other words, it is a proof that reduces\n83\t    /// the constraint satisfaction claim to certain polynomial opening claims.\n84\t    type PartialProof: Clone + Send + Sync + Serialize + DeserializeOwned;\n85\t    /// Other artifacts of the proof (e.g., sampled randomness) that may be passed to later stages\n86\t    /// of the protocol.\n87\t    type Artifacts;\n88\t\n89\t    type Error: std::fmt::Debug;\n90\t\n91\t    fn prove_rap_constraints(\n92\t        &self,\n93\t        transcript: &mut TS,\n94\t        mpk: &DeviceMultiStarkProvingKey<PB>,\n95\t        ctx: &ProvingContext<PB>,\n96\t        common_main_pcs_data: &PB::PcsData,\n97\t    ) -> Result<(Self::PartialProof, Self::Artifacts), Self::Error>;\n98\t}\n99\t\n100\t/// This trait is responsible for proving the evaluation claims of a collection of polynomials at a\n101\t/// collection of points. The opening point may be the same across polynomials. The polynomials may\n102\t/// be defined over different domains and are hence of \"mixed\" nature. The polynomials are already\n103\t/// committed and provided in their committed form.\n104\tpub trait OpeningProver<PB: ProverBackend, TS> {\n105\t    /// PCS opening proof on host. This should not be a reference.\n106\t    type OpeningProof: Clone + Send + Sync + Serialize + DeserializeOwned;\n107\t    type OpeningPoints;\n108\t\n109\t    /// Computes the opening proof.\n110\t    /// The `common_main_pcs_data` is the `PcsData` for the collection of common main trace\n111\t    /// matrices. It is owned by the function and may be mutated.\n112\t    /// The `pre_cached_pcs_data_per_commit` is the `PcsData` for the preprocessed and cached trace\n113\t    /// matrices. These are specified by their `PcsData` per commitment.\n114\t    type Error: std::fmt::Debug;\n115\t\n116\t    fn prove_openings(\n117\t        &self,\n118\t        transcript: &mut TS,\n119\t        mpk: &DeviceMultiStarkProvingKey<PB>,\n120\t        ctx: ProvingContext<PB>,\n121\t        common_main_pcs_data: PB::PcsData,\n122\t        points: Self::OpeningPoints,\n123\t    ) -> Result<Self::OpeningProof, Self::Error>;\n124\t}\n125\t\n126\t/// Trait to manage data transport of prover types from host to device.\n127\tpub trait DeviceDataTransporter<SC, PB>\n128\twhere\n129\t    SC: StarkProtocolConfig,\n130\t    PB: ProverBackend<Val = SC::F, Challenge = SC::EF, Commitment = SC::Digest>,\n131\t{\n132\t    /// Transport the proving key to the device, filtering for only the provided `air_ids`.\n133\t    fn transport_pk_to_device(\n134\t        &self,\n135\t        mpk: &MultiStarkProvingKey<SC>,\n136\t    ) -> DeviceMultiStarkProvingKey<PB>;\n137\t\n138\t    fn transport_matrix_to_device(&self, matrix: &ColMajorMatrix<SC::F>) -> PB::Matrix;\n139\t\n140\t    /// The `commitment` and `prover_data` are assumed to have been previously computed from the\n141\t    /// `trace`.\n142\t    fn transport_pcs_data_to_device(\n143\t        &self,\n144\t        pcs_data: &StackedPcsData<SC::F, SC::Digest>,\n145\t    ) -> PB::PcsData;\n146\t\n147\t    fn transport_committed_trace_data_to_device(\n148\t        &self,\n149\t        committed_trace: &CommittedTraceData<CpuColMajorBackend<SC>>,\n150\t    ) -> CommittedTraceData<PB> {"}]},"parent_tool_use_id":"toolu_01Fz8REZyQSEpABv1W3jVCYw","session_id":"b6755d07-23c8-46a3-81f0-36e3b63f2ed6","uuid":"777cf14a-ae0e-41bb-936f-005207f1529c","timestamp":"2026-04-16T14:57:37.222Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ts3gAmqLhqxskHhBX21VhE","type":"tool_result","content":"1\tuse super::*;\n2\tuse crate::{\n3\t    monomial::{InteractionMonomialTerm, LambdaTerm, MonomialHeader, PackedVar},\n4\t    poly::SqrtEqLayers,\n5\t};\n6\t\n7\t#[repr(C)]\n8\t#[derive(Clone, Copy, Debug)]\n9\tpub struct MainMatrixPtrs<T> {\n10\t    pub data: *const T,\n11\t    pub air_width: u32,\n12\t}\n13\t\n14\t// Types for batch MLE:\n15\t#[repr(C)]\n16\t#[derive(Clone, Copy, Debug)]\n17\tpub struct BlockCtx {\n18\t    pub local_block_idx_x: u32,\n19\t    /// Caution: this refers to the index within buffer of `ZerocheckCtx` or `LogupCtx`. It is\n20\t    /// hence a \"local\" AIR index and not the global AIR index within the proving key.\n21\t    pub air_idx: u32,\n22\t}\n23\t\n24\t/// Per-AIR context for batched monomial evaluation.\n25\t#[repr(C)]\n26\t#[derive(Clone, Copy, Debug)]\n27\tpub struct MonomialAirCtx {\n28\t    pub d_headers: *const MonomialHeader,\n29\t    pub d_variables: *const PackedVar,\n30\t    pub d_lambda_combinations: *const EF, // Precomputed per-monomial\n31\t    pub num_monomials: u32,\n32\t    pub eval_ctx: EvalCoreCtx,\n33\t    pub d_eq_xi: *const EF,\n34\t    pub num_y: u32,\n35\t}\n36\t\n37\t#[repr(C)]\n38\t#[derive(Clone, Copy, Debug)]\n39\tpub struct EvalCoreCtx {\n40\t    pub d_selectors: *const EF,\n41\t    pub d_preprocessed: MainMatrixPtrs<EF>,\n42\t    pub d_main: *const MainMatrixPtrs<EF>,\n43\t    pub d_public: *const F,\n44\t}\n45\t\n46\t#[repr(C)]\n47\t#[derive(Clone, Copy, Debug)]\n48\tpub struct ZerocheckCtx {\n49\t    pub eval_ctx: EvalCoreCtx,\n50\t    pub d_intermediates: *mut EF,\n51\t    pub num_y: u32,\n52\t    pub d_eq_xi: *const EF,\n53\t    pub d_rules: *const std::ffi::c_void,\n54\t    pub rules_len: usize,\n55\t    pub d_used_nodes: *const usize,\n56\t    pub used_nodes_len: usize,\n57\t    pub buffer_size: u32,\n58\t}\n59\t\n60\t#[repr(C)]\n61\t#[derive(Clone, Copy, Debug)]\n62\tpub struct LogupCtx {\n63\t    pub eval_ctx: EvalCoreCtx,\n64\t    pub d_intermediates: *mut EF,\n65\t    pub num_y: u32,\n66\t    pub d_eq_xi: *const EF,\n67\t    pub d_challenges: *const EF,\n68\t    pub d_eq_3bs: *const EF,\n69\t    pub d_rules: *const std::ffi::c_void,\n70\t    pub rules_len: usize,\n71\t    pub d_used_nodes: *const usize,\n72\t    pub d_pair_idxs: *const u32,\n73\t    pub used_nodes_len: usize,\n74\t    pub buffer_size: u32,\n75\t}\n76\t\n77\t/// Common per-AIR context for batched logup monomial evaluation.\n78\t#[repr(C)]\n79\t#[derive(Clone, Copy, Debug)]\n80\tpub struct LogupMonomialCommonCtx {\n81\t    pub eval_ctx: EvalCoreCtx,\n82\t    pub d_eq_xi: *const EF,\n83\t    pub bus_term_sum: EF, // Precomputed sum_i(beta[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n84\t    pub num_y: u32,\n85\t    pub mono_blocks: u32,\n86\t}\n87\t\n88\t/// Per-AIR context for batched logup monomial evaluation (numerator or denominator).\n89\t#[repr(C)]\n90\t#[derive(Clone, Copy, Debug)]\n91\tpub struct LogupMonomialCtx {\n92\t    pub d_headers: *const MonomialHeader,\n93\t    pub d_variables: *const PackedVar,\n94\t    pub d_combinations: *const EF,\n95\t    pub num_monomials: u32,\n96\t}\n97\t/// Descriptor for batched interpolation of columns across multiple traces.\n98\t#[repr(C)]\n99\t#[derive(Clone, Copy, Debug)]\n100\tpub struct InterpColDesc {\n101\t    pub output: *mut EF,\n102\t    pub columns_offset: u32,\n103\t    pub num_y: u32,\n104\t    pub num_columns: u32,\n105\t    pub total_threads: u32,\n106\t    pub block_start: u32,\n107\t}\n108\t\n109\tunsafe impl Send for InterpColDesc {}\n110\tunsafe impl Sync for InterpColDesc {}\n111\t\n112\t#[repr(C)]\n113\t#[derive(Clone, Copy, Debug)]\n114\tpub struct InterpMatrixInfo {\n115\t    pub base: *const EF,\n116\t    pub width: u32,\n117\t}\n118\t\n119\tunsafe impl Send for InterpMatrixInfo {}\n120\tunsafe impl Sync for InterpMatrixInfo {}\n121\t\n122\t#[repr(C)]\n123\t#[derive(Clone, Copy, Debug)]\n124\tpub struct InterpTraceDescM {\n125\t    pub output: *mut EF,\n126\t    pub matrix_offset: u32,\n127\t    pub num_matrices: u32,\n128\t    pub num_y: u32,\n129\t    pub num_columns: u32,\n130\t    pub total_threads: u32,\n131\t    pub block_start: u32,\n132\t}\n133\t\n134\tunsafe impl Send for InterpTraceDescM {}\n135\tunsafe impl Sync for InterpTraceDescM {}\n136\t\n137\t// end of types for batch MLE\n138\t\n139\textern \"C\" {\n140\t    // gkr.cu\n141\t    fn _frac_build_tree_layer(\n142\t        layer: *mut Frac<EF>,\n143\t        layer_size: usize,\n144\t        revert: bool,\n145\t        alpha: EF,\n146\t        apply_alpha: bool,\n147\t    ) -> i32;\n148\t\n149\t    /// Fused two-layer tree build. Applies layers i and i+1 in one kernel pass,\n150\t    /// keeping intermediate right-half nodes for revert operations.\n151\t    /// `half_i1` = N >> (i+2), where i is the first of the two layers.\n152\t    fn _frac_build_tree_two_layers(layer: *mut Frac<EF>, half_i1: usize) -> i32;\n153\t\n154\t    pub fn _frac_compute_round_temp_buffer_size(stride: u32) -> u32;\n155\t\n156\t    fn _frac_compute_round(\n157\t        eq_xi_low: *const EF,\n158\t        eq_xi_high: *const EF,\n159\t        pq_buffer: *const Frac<EF>,\n160\t        num_x: usize,\n161\t        eq_low_cap: usize,\n162\t        lambda: EF,\n163\t        out_device: *mut EF,\n164\t        tmp_block_sums: *mut EF,\n165\t    ) -> i32;\n166\t\n167\t    /// Fused compute round + tree layer revert. Combines frac_build_tree_layer(revert=true)\n168\t    /// with compute_round for the first inner round. Modifies layer in-place for revert.\n169\t    fn _frac_compute_round_and_revert(\n170\t        eq_xi_low: *const EF,\n171\t        eq_xi_high: *const EF,\n172\t        layer: *mut Frac<EF>,\n173\t        num_x: usize,\n174\t        eq_low_cap: usize,\n175\t        lambda: EF,\n176\t        out_device: *mut EF,\n177\t        tmp_block_sums: *mut EF,\n178\t    ) -> i32;\n179\t\n180\t    fn _frac_fold_fpext_columns(\n181\t        src: *const Frac<EF>,\n182\t        dst: *mut Frac<EF>,\n183\t        size: usize,\n184\t        r: EF,\n185\t    ) -> i32;\n186\t\n187\t    /// Fused compute round + fold (out-of-place). Reads from pre-fold src_pq_buffer (size\n188\t    /// src_pq_size), computes sumcheck sums, and writes folded output to dst_pq_buffer (size\n189\t    /// src_pq_size/2). IMPORTANT: src_pq_buffer and dst_pq_buffer must NOT alias.\n190\t    fn _frac_compute_round_and_fold(\n191\t        eq_xi_low: *const EF,\n192\t        eq_xi_high: *const EF,\n193\t        src_pq_buffer: *const Frac<EF>,\n194\t        dst_pq_buffer: *mut Frac<EF>,\n195\t        src_pq_size: usize,\n196\t        eq_low_cap: usize,\n197\t        lambda: EF,\n198\t        r_prev: EF,\n199\t        out_device: *mut EF,\n200\t        tmp_block_sums: *mut EF,\n201\t    ) -> i32;\n202\t\n203\t    /// Fused compute round + fold (in-place). Reads from pre-fold pq_buffer (size src_pq_size),\n204\t    /// computes sumcheck sums, and writes folded output to the same buffer (first src_pq_size/2\n205\t    /// elements).\n206\t    fn _frac_compute_round_and_fold_inplace(\n207\t        eq_xi_low: *const EF,\n208\t        eq_xi_high: *const EF,\n209\t        pq_buffer: *mut Frac<EF>,\n210\t        src_pq_size: usize,\n211\t        eq_low_cap: usize,\n212\t        lambda: EF,\n213\t        r_prev: EF,\n214\t        out_device: *mut EF,\n215\t        tmp_block_sums: *mut EF,\n216\t    ) -> i32;\n217\t\n218\t    fn _frac_precompute_m_build(\n219\t        pq: *const Frac<EF>,\n220\t        rem_n: usize,\n221\t        w: usize,\n222\t        lambda: EF,\n223\t        r_prev: EF,\n224\t        inline_fold: bool,\n225\t        eq_tail_low: *const EF,\n226\t        eq_tail_high: *const EF,\n227\t        eq_tail_low_cap: usize,\n228\t        tail_tile: usize,\n229\t        partial_out: *mut EF,\n230\t        partial_len: usize,\n231\t        m_total: *mut EF,\n232\t    ) -> i32;\n233\t\n234\t    fn _frac_precompute_m_eval_round(\n235\t        m_total: *const EF,\n236\t        w: usize,\n237\t        t: usize,\n238\t        eq_r_prefix: *const EF,\n239\t        eq_suffix: *const EF,\n240\t        out: *mut EF,\n241\t    ) -> i32;\n242\t\n243\t    fn _frac_multifold(\n244\t        src: *const Frac<EF>,\n245\t        dst: *mut Frac<EF>,\n246\t        rem_n: usize,\n247\t        w: usize,\n248\t        eq_r_window: *const EF,\n249\t    ) -> i32;\n250\t\n251\t    fn _frac_add_alpha(data: *mut std::ffi::c_void, len: usize, alpha: EF) -> i32;\n252\t\n253\t    fn _frac_vector_scalar_multiply_ext_fp(frac_vec: *mut Frac<EF>, scalar: F, length: u32) -> i32;\n254\t\n255\t    // utils.cu\n256\t    fn _fold_ple_from_evals(\n257\t        input_matrix: *const F,\n258\t        output_matrix: *mut EF,\n259\t        omega_skip_pows: *const F,\n260\t        inv_lagrange_denoms: *const EF,\n261\t        height: u32,\n262\t        width: u32,\n263\t        l_skip: u32,\n264\t        new_height: u32,\n265\t        rotate: bool,\n266\t    ) -> i32;\n267\t\n268\t    fn _interpolate_columns(\n269\t        interpolated: *mut EF,\n270\t        columns: *const *const EF,\n271\t        s_deg: usize,\n272\t        num_y: usize,\n273\t        num_columns: usize,\n274\t    ) -> i32;\n275\t\n276\t    fn _batched_interpolate_columns(\n277\t        descs: *const InterpColDesc,\n278\t        all_columns: *const *const EF,\n279\t        s_deg: usize,\n280\t        num_descs: usize,\n281\t        total_blocks: usize,\n282\t    ) -> i32;\n283\t\n284\t    fn _batched_interpolate_columns_matrix(\n285\t        descs: *const InterpTraceDescM,\n286\t        matrices: *const InterpMatrixInfo,\n287\t        s_deg: usize,\n288\t        num_descs: usize,\n289\t        total_blocks: usize,\n290\t    ) -> i32;\n291\t\n292\t    fn _frac_matrix_vertically_repeat(\n293\t        out: *mut Frac<EF>,\n294\t        input: *const Frac<EF>,\n295\t        width: u32,\n296\t        lifted_height: u32,\n297\t        height: u32,\n298\t    ) -> i32;\n299\t\n300\t    fn _frac_matrix_vertically_repeat_ext(\n301\t        out_numerators: *mut EF,\n302\t        out_denominators: *mut EF,\n303\t        in_numerators: *const EF,\n304\t        in_denominators: *const EF,\n305\t        width: u32,\n306\t        lifted_height: u32,\n307\t        height: u32,\n308\t    ) -> i32;\n309\t\n310\t    // gkr_input.cu\n311\t    fn _logup_gkr_input_eval(\n312\t        is_global: bool,\n313\t        fracs: *mut Frac<EF>,\n314\t        preprocessed: *const F,\n315\t        partitioned_main: *const u64,\n316\t        public_values: *const F,\n317\t        challenges: *const EF,\n318\t        intermediates: *const EF,\n319\t        rules: *const std::ffi::c_void,\n320\t        used_nodes: *const usize,\n321\t        pair_idxs: *const u32,\n322\t        used_nodes_len: usize,\n323\t        height: u32,\n324\t        num_rows_per_tile: u32,\n325\t    ) -> i32;\n326\t\n327\t    // logup_round0.cu\n328\t    pub fn _logup_r0_temp_sums_buffer_size(\n329\t        buffer_size: u32,\n330\t        skip_domain: u32,\n331\t        num_x: u32,\n332\t        num_cosets: u32,\n333\t        max_temp_bytes: usize,\n334\t    ) -> usize;\n335\t\n336\t    pub fn _logup_r0_intermediates_buffer_size(\n337\t        buffer_size: u32,\n338\t        skip_domain: u32,\n339\t        num_x: u32,\n340\t        num_cosets: u32,\n341\t        max_temp_bytes: usize,\n342\t    ) -> usize;\n343\t\n344\t    fn _logup_bary_eval_interactions_round0(\n345\t        tmp_sums_buffer: *mut Frac<EF>,\n346\t        output: *mut Frac<EF>,\n347\t        selectors_cube: *const F,\n348\t        preprocessed: *const F,\n349\t        main_parts: *const *const F,\n350\t        eq_cube: *const EF,\n351\t        public_values: *const F,\n352\t        numer_weights: *const EF,\n353\t        denom_weights: *const EF,\n354\t        denom_sum_init: EF,\n355\t        d_rules: *const std::ffi::c_void,\n356\t        rules_len: usize,\n357\t        buffer_size: u32,\n358\t        d_intermediates: *mut F,\n359\t        skip_domain: u32,\n360\t        num_x: u32,\n361\t        height: u32,\n362\t        num_cosets: u32,\n363\t        g_shift: F,\n364\t        max_temp_bytes: usize,\n365\t    ) -> i32;\n366\t\n367\t    // zerocheck_round0.cu\n368\t    pub fn _zerocheck_r0_temp_sums_buffer_size(\n369\t        buffer_size: u32,\n370\t        skip_domain: u32,\n371\t        num_x: u32,\n372\t        num_cosets: u32,\n373\t        max_temp_bytes: usize,\n374\t    ) -> usize;\n375\t\n376\t    pub fn _zerocheck_r0_intermediates_buffer_size(\n377\t        buffer_size: u32,\n378\t        skip_domain: u32,\n379\t        num_x: u32,\n380\t        num_cosets: u32,\n381\t        max_temp_bytes: usize,\n382\t    ) -> usize;\n383\t\n384\t    fn _zerocheck_ntt_eval_constraints(\n385\t        tmp_sums_buffer: *mut EF,\n386\t        output: *mut EF,\n387\t        selectors_cube: *const F,\n388\t        preprocessed: *const F,\n389\t        main_parts: *const *const F,\n390\t        eq_cube: *const EF,\n391\t        d_lambda_pows: *const EF,\n392\t        public_values: *const F,\n393\t        d_rules: *const std::ffi::c_void,\n394\t        rules_len: usize,\n395\t        d_used_nodes: *const usize,\n396\t        used_nodes_len: usize,\n397\t        lambda_len: usize,\n398\t        buffer_size: u32,\n399\t        d_intermediates: *mut F,\n400\t        skip_domain: u32,\n401\t        num_x: u32,\n402\t        height: u32,\n403\t        num_cosets: u32,\n404\t        g_shift: F,\n405\t        max_temp_bytes: usize,\n406\t    ) -> i32;\n407\t\n408\t    // round0_extract.cu\n409\t    pub fn _round0_extract_zerocheck_poly(\n410\t        d_out: *mut EF,\n411\t        d_evals: *const EF,\n412\t        d_transform: *const EF,\n413\t        input_size: u32,\n414\t        output_size: u32,\n415\t    ) -> i32;\n416\t\n417\t    pub fn _round0_extract_logup_polys(\n418\t        d_out_numer: *mut EF,\n419\t        d_out_denom: *mut EF,\n420\t        d_evals: *const Frac<EF>,\n421\t        d_transform: *const EF,\n422\t        input_size: u32,\n423\t        output_size: u32,\n424\t        norm_factor: EF,\n425\t    ) -> i32;\n426\t\n427\t    fn _fold_selectors_round0(\n428\t        out: *mut EF,\n429\t        input: *const F,\n430\t        is_first: EF,\n431\t        is_last: EF,\n432\t        num_x: u32,\n433\t    ) -> i32;\n434\t\n435\t    // mle.cu\n436\t    pub fn _zerocheck_mle_temp_sums_buffer_size(num_x: u32, num_y: u32) -> usize;\n437\t\n438\t    pub fn _zerocheck_mle_intermediates_buffer_size(\n439\t        buffer_size: u32,\n440\t        num_x: u32,\n441\t        num_y: u32,\n442\t    ) -> usize;\n443\t\n444\t    fn _zerocheck_eval_mle(\n445\t        tmp_sums_buffer: *mut EF,\n446\t        output: *mut EF,\n447\t        eq_xi: *const EF,\n448\t        selectors: *const EF,\n449\t        preprocessed: MainMatrixPtrs<EF>,\n450\t        main: *const MainMatrixPtrs<EF>,\n451\t        lambda_pows: *const EF,\n452\t        public_values: *const F,\n453\t        rules: *const std::ffi::c_void,\n454\t        rules_len: usize,\n455\t        used_nodes: *const usize,\n456\t        used_nodes_len: usize,\n457\t        lambda_len: usize,\n458\t        buffer_size: u32,\n459\t        intermediates: *mut EF,\n460\t        num_y: u32,\n461\t        num_x: u32,\n462\t    ) -> i32;\n463\t\n464\t    pub fn _logup_mle_temp_sums_buffer_size(num_x: u32, num_y: u32) -> usize;\n465\t\n466\t    pub fn _logup_mle_intermediates_buffer_size(buffer_size: u32, num_x: u32, num_y: u32) -> usize;\n467\t\n468\t    fn _logup_eval_mle(\n469\t        tmp_sums_buffer: *mut Frac<EF>,\n470\t        output: *mut Frac<EF>,\n471\t        eq_xi: *const EF,\n472\t        selectors: *const EF,\n473\t        preprocessed: MainMatrixPtrs<EF>,\n474\t        main: *const MainMatrixPtrs<EF>,\n475\t        challenges: *const EF,\n476\t        eq_3bs: *const EF,\n477\t        public_values: *const F,\n478\t        rules: *const std::ffi::c_void,\n479\t        used_nodes: *const usize,\n480\t        pair_idxs: *const u32,\n481\t        used_nodes_len: usize,\n482\t        buffer_size: u32,\n483\t        intermediates: *mut EF,\n484\t        num_y: u32,\n485\t        num_x: u32,\n486\t    ) -> i32;\n487\t\n488\t    // batch_mle.cu (batch kernels always use global intermediates when buffer_size > 0)\n489\t    pub fn _zerocheck_batch_mle_intermediates_buffer_size(\n490\t        buffer_size: u32,\n491\t        num_x: u32,\n492\t        num_y: u32,\n493\t    ) -> usize;\n494\t\n495\t    pub fn _logup_batch_mle_intermediates_buffer_size(\n496\t        buffer_size: u32,\n497\t        num_x: u32,\n498\t        num_y: u32,\n499\t    ) -> usize;\n500\t\n501\t    fn _zerocheck_batch_eval_mle(\n502\t        tmp_sums_buffer: *mut EF,\n503\t        output: *mut EF,\n504\t        block_ctxs: *const BlockCtx,\n505\t        zc_ctxs: *const ZerocheckCtx,\n506\t        air_block_offsets: *const u32,\n507\t        lambda_pows: *const EF,\n508\t        lambda_len: usize,\n509\t        num_blocks: u32,\n510\t        num_x: u32,\n511\t        num_airs: u32,\n512\t        threads_per_block: u32,\n513\t    ) -> i32;\n514\t\n515\t    fn _logup_batch_eval_mle(\n516\t        tmp_sums_buffer: *mut Frac<EF>,\n517\t        output: *mut Frac<EF>,\n518\t        block_ctxs: *const BlockCtx,\n519\t        logup_ctxs: *const LogupCtx,\n520\t        air_block_offsets: *const u32,\n521\t        num_blocks: u32,\n522\t        num_x: u32,\n523\t        num_airs: u32,\n524\t        threads_per_block: u32,\n525\t    ) -> i32;\n526\t\n527\t    fn _zerocheck_monomial_batched(\n528\t        tmp_sums: *mut EF,\n529\t        output: *mut EF,\n530\t        block_ctxs: *const BlockCtx,\n531\t        air_ctxs: *const MonomialAirCtx,\n532\t        air_block_offsets: *const u32,\n533\t        num_blocks: u32,\n534\t        num_x: u32,\n535\t        num_airs: u32,\n536\t        threads_per_block: u32,\n537\t    ) -> i32;\n538\t\n539\t    fn _zerocheck_monomial_par_y_batched(\n540\t        tmp_sums: *mut EF,\n541\t        output: *mut EF,\n542\t        block_ctxs: *const BlockCtx,\n543\t        air_ctxs: *const MonomialAirCtx,\n544\t        air_block_offsets: *const u32,\n545\t        num_blocks: u32,\n546\t        num_x: u32,\n547\t        num_airs: u32,\n548\t        chunk_size: u32,\n549\t        threads_per_block: u32,\n550\t    ) -> i32;\n551\t\n552\t    fn _precompute_lambda_combinations(\n553\t        out: *mut EF,\n554\t        headers: *const MonomialHeader,\n555\t        lambda_terms: *const LambdaTerm<F>,\n556\t        lambda_pows: *const EF,\n557\t        num_monomials: u32,\n558\t    ) -> i32;\n559\t\n560\t    // Logup monomial kernels\n561\t    fn _precompute_logup_numer_combinations(\n562\t        out: *mut EF,\n563\t        headers: *const MonomialHeader,\n564\t        terms: *const InteractionMonomialTerm<F>,\n565\t        eq_3bs: *const EF,\n566\t        num_monomials: u32,\n567\t    ) -> i32;\n568\t\n569\t    fn _precompute_logup_denom_combinations(\n570\t        out: *mut EF,\n571\t        headers: *const MonomialHeader,\n572\t        terms: *const InteractionMonomialTerm<F>,\n573\t        beta_pows: *const EF,\n574\t        eq_3bs: *const EF,\n575\t        num_monomials: u32,\n576\t    ) -> i32;\n577\t\n578\t    fn _logup_monomial_batched(\n579\t        tmp_sums: *mut Frac<EF>,\n580\t        output: *mut Frac<EF>,\n581\t        block_ctxs: *const BlockCtx,\n582\t        common_ctxs: *const LogupMonomialCommonCtx,\n583\t        numer_ctxs: *const LogupMonomialCtx,\n584\t        denom_ctxs: *const LogupMonomialCtx,\n585\t        air_block_offsets: *const u32,\n586\t        num_blocks: u32,\n587\t        num_x: u32,\n588\t        num_airs: u32,\n589\t        threads_per_block: u32,\n590\t    ) -> i32;\n591\t}\n592\t\n593\tpub unsafe fn interpolate_columns_gpu(\n594\t    interpolated: &DeviceBuffer<EF>,\n595\t    columns: &DeviceBuffer<*const EF>,\n596\t    s_deg: usize,\n597\t    num_y: usize,\n598\t) -> Result<(), CudaError> {\n599\t    CudaError::from_result(_interpolate_columns(\n600\t        interpolated.as_mut_ptr(),\n601\t        columns.as_ptr(),\n602\t        s_deg,\n603\t        num_y,\n604\t        columns.len(),\n605\t    ))\n606\t}\n607\t\n608\tpub unsafe fn batched_interpolate_columns_gpu(\n609\t    descs: &DeviceBuffer<InterpColDesc>,\n610\t    all_columns: &DeviceBuffer<*const EF>,\n611\t    s_deg: usize,\n612\t    total_blocks: usize,\n613\t) -> Result<(), CudaError> {\n614\t    CudaError::from_result(_batched_interpolate_columns(\n615\t        descs.as_ptr(),\n616\t        all_columns.as_ptr(),\n617\t        s_deg,\n618\t        descs.len(),\n619\t        total_blocks,\n620\t    ))\n621\t}\n622\t\n623\tpub unsafe fn batched_interpolate_columns_matrix_gpu(\n624\t    descs: &DeviceBuffer<InterpTraceDescM>,\n625\t    matrices: &DeviceBuffer<InterpMatrixInfo>,\n626\t    s_deg: usize,\n627\t    total_blocks: usize,\n628\t) -> Result<(), CudaError> {\n629\t    CudaError::from_result(_batched_interpolate_columns_matrix(\n630\t        descs.as_ptr(),\n631\t        matrices.as_ptr(),\n632\t        s_deg,\n633\t        descs.len(),\n634\t        total_blocks,\n635\t    ))\n636\t}\n637\t\n638\tpub unsafe fn frac_build_tree_layer(\n639\t    layer: &mut DeviceBuffer<Frac<EF>>,\n640\t    layer_size: usize,\n641\t    revert: bool,\n642\t    alpha: EF,\n643\t    apply_alpha: bool,\n644\t) -> Result<(), CudaError> {\n645\t    debug_assert!(layer.len() >= layer_size);\n646\t    CudaError::from_result(_frac_build_tree_layer(\n647\t        layer.as_mut_ptr(),\n648\t        layer_size,\n649\t        revert,\n650\t        alpha,\n651\t        apply_alpha,\n652\t    ))\n653\t}\n654\t\n655\t/// Fused two-layer tree build kernel.\n656\t/// `half_i1` = N >> (i+2), where i is the first of the two layers being fused.\n657\tpub unsafe fn frac_build_tree_two_layers(\n658\t    layer: &mut DeviceBuffer<Frac<EF>>,\n659\t    half_i1: usize,\n660\t) -> Result<(), CudaError> {\n661\t    CudaError::from_result(_frac_build_tree_two_layers(layer.as_mut_ptr(), half_i1))\n662\t}\n663\t\n664\t// `eq_xi` will not store evaluations for the first hypercube coordinate because the prover factors\n665\t// out the first eq term.\n666\t#[allow(clippy::too_many_arguments)]\n667\tpub unsafe fn frac_compute_round(\n668\t    eq_xi: &SqrtEqLayers,\n669\t    pq_buffer: &DeviceBuffer<Frac<EF>>,\n670\t    num_x: usize,\n671\t    lambda: EF,\n672\t    out_device: &mut DeviceBuffer<EF>,\n673\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n674\t) -> Result<(), CudaError> {\n675\t    let low_n = eq_xi.low_n();\n676\t    let high_n = eq_xi.high_n();\n677\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n678\t    debug_assert!(pq_buffer.len() >= 2 * num_x);\n679\t    #[cfg(debug_assertions)]\n680\t    {\n681\t        let len = tmp_block_sums.len();\n682\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n683\t        assert!(\n684\t            len >= required as usize,\n685\t            \"tmp_block_sums len={len} < required={required}\"\n686\t        );\n687\t    }\n688\t    CudaError::from_result(_frac_compute_round(\n689\t        eq_xi.low.get_ptr(low_n),\n690\t        eq_xi.high.get_ptr(high_n),\n691\t        pq_buffer.as_ptr(),\n692\t        num_x,\n693\t        1 << low_n,\n694\t        lambda,\n695\t        out_device.as_mut_ptr(),\n696\t        tmp_block_sums.as_mut_ptr(),\n697\t    ))\n698\t}\n699\t\n700\t/// Fused compute round + tree layer revert kernel.\n701\t///\n702\t/// Combines `frac_build_tree_layer(revert=true)` with `compute_round` for the first inner round.\n703\t/// The revert operation modifies `layer` in-place: `layer[i] = layer[i] - layer[i + half]` for `i <\n704\t/// half`.\n705\t///\n706\t/// This eliminates one kernel launch per outer round.\n707\t#[allow(clippy::too_many_arguments)]\n708\tpub unsafe fn frac_compute_round_and_revert(\n709\t    eq_xi: &SqrtEqLayers,\n710\t    layer: &mut DeviceBuffer<Frac<EF>>,\n711\t    num_x: usize,\n712\t    lambda: EF,\n713\t    out_device: &mut DeviceBuffer<EF>,\n714\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n715\t) -> Result<(), CudaError> {\n716\t    let low_n = eq_xi.low_n();\n717\t    let high_n = eq_xi.high_n();\n718\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n719\t    #[cfg(debug_assertions)]\n720\t    {\n721\t        let len = tmp_block_sums.len();\n722\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n723\t        assert!(\n724\t            len >= required as usize,\n725\t            \"tmp_block_sums len={len} < required={required}\"\n726\t        );\n727\t        assert!(layer.len() >= 2 * num_x, \"layer too small for pq_size\");\n728\t    }\n729\t    CudaError::from_result(_frac_compute_round_and_revert(\n730\t        eq_xi.low.get_ptr(low_n),\n731\t        eq_xi.high.get_ptr(high_n),\n732\t        layer.as_mut_ptr(),\n733\t        num_x,\n734\t        1 << low_n,\n735\t        lambda,\n736\t        out_device.as_mut_ptr(),\n737\t        tmp_block_sums.as_mut_ptr(),\n738\t    ))\n739\t}\n740\t\n741\t/// Folds `Frac<EF>` buffer. Pairs (idx, idx+quarter) and (idx+half, idx+3*quarter),\n742\t/// writes results to dst[idx] and dst[idx+quarter]. Output size is `size / 2`.\n743\t/// Safe for src == dst (in-place) because each thread handles disjoint indices.\n744\tpub unsafe fn fold_ef_frac_columns(\n745\t    src: &DeviceBuffer<Frac<EF>>,\n746\t    dst: &mut DeviceBuffer<Frac<EF>>,\n747\t    size: usize,\n748\t    r: EF,\n749\t) -> Result<(), CudaError> {\n750\t    debug_assert!(src.len() >= size);\n751\t    debug_assert!(dst.len() >= size / 2);\n752\t    CudaError::from_result(_frac_fold_fpext_columns(\n753\t        src.as_ptr(),\n754\t        dst.as_mut_ptr(),\n755\t        size,\n756\t        r,\n757\t    ))\n758\t}\n759\t\n760\t/// In-place fold. See [`fold_ef_frac_columns`] for details.\n761\tpub unsafe fn fold_ef_frac_columns_inplace(\n762\t    buffer: &mut DeviceBuffer<Frac<EF>>,\n763\t    size: usize,\n764\t    r: EF,\n765\t) -> Result<(), CudaError> {\n766\t    debug_assert!(buffer.len() >= size);\n767\t    let ptr = buffer.as_mut_ptr();\n768\t    CudaError::from_result(_frac_fold_fpext_columns(ptr, ptr, size, r))\n769\t}\n770\t\n771\t/// Fused compute round + fold kernel.\n772\t///\n773\t/// Reads from pre-fold `src_pq_buffer` (size `src_pq_size`), performs fold-on-the-fly using\n774\t/// `r_prev`, computes s' polynomial evaluations (degree 2), and writes folded output to\n775\t/// `dst_pq_buffer` (size `src_pq_size/2`).\n776\t///\n777\t/// This fuses the fold operation into the next round's compute, eliminating one kernel launch per\n778\t/// inner round and reducing memory traffic.\n779\t///\n780\t/// The eq_xi layers should have max_n = log2(src_pq_size / 4) = log2(post-fold num_x).\n781\t#[allow(clippy::too_many_arguments)]\n782\tpub unsafe fn frac_compute_round_and_fold(\n783\t    eq_xi: &SqrtEqLayers,\n784\t    src_pq_buffer: &DeviceBuffer<Frac<EF>>,\n785\t    dst_pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n786\t    src_pq_size: usize,\n787\t    lambda: EF,\n788\t    r_prev: EF,\n789\t    out_device: &mut DeviceBuffer<EF>,\n790\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n791\t) -> Result<(), CudaError> {\n792\t    let low_n = eq_xi.low_n();\n793\t    let high_n = eq_xi.high_n();\n794\t    // Post-fold: num_x = src_pq_size / 4\n795\t    let num_x = src_pq_size >> 2;\n796\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n797\t    #[cfg(debug_assertions)]\n798\t    {\n799\t        assert!(src_pq_size > 2, \"src_pq_size must be > 2\");\n800\t        let pq_size = src_pq_size >> 1;\n801\t        assert!(num_x > 0, \"num_x must be > 0\");\n802\t        assert!(\n803\t            src_pq_buffer.len() >= src_pq_size,\n804\t            \"src_pq_buffer too small: {} < {}\",\n805\t            src_pq_buffer.len(),\n806\t            src_pq_size\n807\t        );\n808\t        assert!(\n809\t            dst_pq_buffer.len() >= pq_size,\n810\t            \"dst_pq_buffer too small: {} < {}\",\n811\t            dst_pq_buffer.len(),\n812\t            pq_size\n813\t        );\n814\t        let len = tmp_block_sums.len();\n815\t        let required = _frac_compute_round_temp_buffer_size(num_x as u32);\n816\t        assert!(\n817\t            len >= required as usize,\n818\t            \"tmp_block_sums len={len} < required={required}\"\n819\t        );\n820\t    }\n821\t    CudaError::from_result(_frac_compute_round_and_fold(\n822\t        eq_xi.low.get_ptr(low_n),\n823\t        eq_xi.high.get_ptr(high_n),\n824\t        src_pq_buffer.as_ptr(),\n825\t        dst_pq_buffer.as_mut_ptr(),\n826\t        src_pq_size,\n827\t        1 << low_n,\n828\t        lambda,\n829\t        r_prev,\n830\t        out_device.as_mut_ptr(),\n831\t        tmp_block_sums.as_mut_ptr(),\n832\t    ))\n833\t}\n834\t\n835\t/// In-place fused compute round + fold kernel. See [`frac_compute_round_and_fold`] for details.\n836\t///\n837\t/// Uses a dedicated in-place kernel that doesn't have `__restrict__` on the pq pointer,\n838\t/// avoiding undefined behavior from aliased restrict pointers.\n839\t///\n840\t/// **IN-PLACE SAFETY:** Each thread writes only to indices it reads from in the first half of the\n841\t/// buffer, so there are no cross-thread conflicts. The second half is read-only.\n842\t#[allow(clippy::too_many_arguments)]\n843\tpub unsafe fn frac_compute_round_and_fold_inplace(\n844\t    eq_xi: &SqrtEqLayers,\n845\t    pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n846\t    src_pq_size: usize,\n847\t    lambda: EF,\n848\t    r_prev: EF,\n849\t    out_device: &mut DeviceBuffer<EF>,\n850\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n851\t) -> Result<(), CudaError> {\n852\t    let low_n = eq_xi.low_n();\n853\t    let high_n = eq_xi.high_n();\n854\t    // Post-fold: num_x = src_pq_size / 4\n855\t    let num_x = src_pq_size >> 2;\n856\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n857\t    #[cfg(debug_assertions)]\n858\t    {\n859\t        assert!(src_pq_size > 2, \"src_pq_size must be > 2\");\n860\t        assert!(num_x > 0, \"num_x must be > 0\");\n861\t        assert!(\n862\t            pq_buffer.len() >= src_pq_size,\n863\t            \"pq_buffer too small: {} < {}\",\n864\t            pq_buffer.len(),\n865\t            src_pq_size\n866\t        );\n867\t        let len = tmp_block_sums.len();\n868\t        let required = _frac_compute_round_temp_buffer_size(num_x as u32);\n869\t        assert!(\n870\t            len >= required as usize,\n871\t            \"tmp_block_sums len={len} < required={required}\"\n872\t        );\n873\t    }\n874\t    CudaError::from_result(_frac_compute_round_and_fold_inplace(\n875\t        eq_xi.low.get_ptr(low_n),\n876\t        eq_xi.high.get_ptr(high_n),\n877\t        pq_buffer.as_mut_ptr(),\n878\t        src_pq_size,\n879\t        1 << low_n,\n880\t        lambda,\n881\t        r_prev,\n882\t        out_device.as_mut_ptr(),\n883\t        tmp_block_sums.as_mut_ptr(),\n884\t    ))\n885\t}\n886\t\n887\t#[allow(clippy::too_many_arguments)]\n888\tpub unsafe fn frac_precompute_m_build_raw(\n889\t    pq: *const Frac<EF>,\n890\t    rem_n: usize,\n891\t    w: usize,\n892\t    lambda: EF,\n893\t    r_prev: EF,\n894\t    inline_fold: bool,\n895\t    eq_tail_low: *const EF,\n896\t    eq_tail_high: *const EF,\n897\t    eq_tail_low_cap: usize,\n898\t    tail_tile: usize,\n899\t    partial_out: *mut EF,\n900\t    partial_len: usize,\n901\t    m_total: *mut EF,\n902\t) -> Result<(), CudaError> {\n903\t    debug_assert!(rem_n > 0);\n904\t    debug_assert!(w > 0 && w <= rem_n);\n905\t    debug_assert!(eq_tail_low_cap.is_power_of_two());\n906\t    debug_assert!(tail_tile > 0);\n907\t    CudaError::from_result(_frac_precompute_m_build(\n908\t        pq,\n909\t        rem_n,\n910\t        w,\n911\t        lambda,\n912\t        r_prev,\n913\t        inline_fold,\n914\t        eq_tail_low,\n915\t        eq_tail_high,\n916\t        eq_tail_low_cap,\n917\t        tail_tile,\n918\t        partial_out,\n919\t        partial_len,\n920\t        m_total,\n921\t    ))\n922\t}\n923\t\n924\t#[allow(clippy::too_many_arguments)]\n925\tpub unsafe fn frac_precompute_m_eval_round_raw(\n926\t    m_total: *const EF,\n927\t    w: usize,\n928\t    t: usize,\n929\t    eq_r_prefix: *const EF,\n930\t    eq_suffix: *const EF,\n931\t    out: *mut EF,\n932\t) -> Result<(), CudaError> {\n933\t    debug_assert!(w > 0);\n934\t    debug_assert!(t < w);\n935\t    CudaError::from_result(_frac_precompute_m_eval_round(\n936\t        m_total,\n937\t        w,\n938\t        t,\n939\t        eq_r_prefix,\n940\t        eq_suffix,\n941\t        out,\n942\t    ))\n943\t}\n944\t\n945\tpub unsafe fn frac_multifold_raw(\n946\t    src: *const Frac<EF>,\n947\t    dst: *mut Frac<EF>,\n948\t    rem_n: usize,\n949\t    w: usize,\n950\t    eq_r_window: *const EF,\n951\t) -> Result<(), CudaError> {\n952\t    debug_assert!(rem_n > 0);\n953\t    debug_assert!(w > 0 && w <= rem_n);\n954\t    CudaError::from_result(_frac_multifold(src, dst, rem_n, w, eq_r_window))\n955\t}\n956\t\n957\t#[allow(clippy::too_many_arguments)]\n958\tpub unsafe fn fold_ple_from_evals(\n959\t    input_matrix: &DeviceBuffer<F>,\n960\t    output_matrix: *mut EF,\n961\t    omega_skip_pows: &DeviceBuffer<F>,\n962\t    inv_lagrange_denoms: &DeviceBuffer<EF>,\n963\t    height: u32,\n964\t    width: u32,\n965\t    l_skip: u32,\n966\t    new_height: u32,\n967\t    rotate: bool,\n968\t) -> Result<(), CudaError> {\n969\t    CudaError::from_result(_fold_ple_from_evals(\n970\t        input_matrix.as_ptr(),\n971\t        output_matrix,\n972\t        omega_skip_pows.as_ptr(),\n973\t        inv_lagrange_denoms.as_ptr(),\n974\t        height,\n975\t        width,\n976\t        l_skip,\n977\t        new_height,\n978\t        rotate,\n979\t    ))\n980\t}\n981\t\n982\t/// # Safety\n983\t/// - `fracs` must be a pointer to a device buffer with capacity at least `num_interactions *\n984\t///   height`.\n985\t#[allow(clippy::too_many_arguments)]\n986\tpub unsafe fn logup_gkr_input_eval(\n987\t    is_global: bool,\n988\t    fracs: *mut Frac<EF>,\n989\t    preprocessed: &DeviceBuffer<F>,\n990\t    partitioned_main: &DeviceBuffer<u64>,\n991\t    public_values: &DeviceBuffer<F>,\n992\t    challenges: &DeviceBuffer<EF>,\n993\t    intermediates: &DeviceBuffer<EF>,\n994\t    rules: &DeviceBuffer<u128>,\n995\t    used_nodes: &DeviceBuffer<usize>,\n996\t    pair_idxs: &DeviceBuffer<u32>,\n997\t    height: u32,\n998\t    num_rows_per_tile: u32,\n999\t) -> Result<(), CudaError> {\n1000\t    debug_assert_eq!(used_nodes.len(), pair_idxs.len());\n1001\t    CudaError::from_result(_logup_gkr_input_eval(\n1002\t        is_global,\n1003\t        fracs,\n1004\t        preprocessed.as_ptr(),\n1005\t        partitioned_main.as_ptr(),\n1006\t        public_values.as_ptr(),\n1007\t        challenges.as_ptr(),\n1008\t        intermediates.as_ptr(),\n1009\t        rules.as_raw_ptr(),\n1010\t        used_nodes.as_ptr(),\n1011\t        pair_idxs.as_ptr(),\n1012\t        used_nodes.len(),\n1013\t        height,\n1014\t        num_rows_per_tile,\n1015\t    ))\n1016\t}\n1017\t\n1018\tpub unsafe fn frac_add_alpha(data: &DeviceBuffer<Frac<EF>>, alpha: EF) -> Result<(), CudaError> {\n1019\t    CudaError::from_result(_frac_add_alpha(data.as_mut_raw_ptr(), data.len(), alpha))\n1020\t}\n1021\t\n1022\t/// # Safety\n1023\t/// - `buffer_size` does not refer to the capacity of `intermediates`. It refers to \"how many DAG\n1024\t///   nodes per row need to be buffered\". The capacity is a multiple of `buffer_size` which is\n1025\t///   runtime calculated based on `buffer_size`.\n1026\t/// - `eq_cube` must be a pointer to device buffer with at least `num_x` elements representing\n1027\t///   evaluations on hypercube.\n1028\t#[allow(clippy::too_many_arguments)]\n1029\tpub unsafe fn zerocheck_ntt_eval_constraints(\n1030\t    tmp_sums_buffer: &mut DeviceBuffer<EF>,\n1031\t    output: &mut DeviceBuffer<EF>,\n1032\t    selectors_cube: &DeviceBuffer<F>,\n1033\t    preprocessed: *const F,\n1034\t    main_ptrs: &DeviceBuffer<*const F>,\n1035\t    eq_cube: *const EF,\n1036\t    lambda_pows: &DeviceBuffer<EF>,\n1037\t    public_values: &DeviceBuffer<F>,\n1038\t    rules: &DeviceBuffer<u128>,\n1039\t    used_nodes: &DeviceBuffer<usize>,\n1040\t    buffer_size: u32,\n1041\t    intermediates: &mut DeviceBuffer<F>,\n1042\t    skip_domain: u32,\n1043\t    num_x: u32,\n1044\t    height: u32,\n1045\t    num_cosets: u32,\n1046\t    g_shift: F,\n1047\t    max_temp_bytes: usize,\n1048\t) -> Result<(), CudaError> {\n1049\t    CudaError::from_result(_zerocheck_ntt_eval_constraints(\n1050\t        tmp_sums_buffer.as_mut_ptr(),\n1051\t        output.as_mut_ptr(),\n1052\t        selectors_cube.as_ptr(),\n1053\t        preprocessed,\n1054\t        main_ptrs.as_ptr(),\n1055\t        eq_cube,\n1056\t        lambda_pows.as_ptr(),\n1057\t        public_values.as_ptr(),\n1058\t        rules.as_raw_ptr(),\n1059\t        rules.len(),\n1060\t        used_nodes.as_ptr(),\n1061\t        used_nodes.len(),\n1062\t        lambda_pows.len(),\n1063\t        buffer_size,\n1064\t        intermediates.as_mut_ptr(),\n1065\t        skip_domain,\n1066\t        num_x,\n1067\t        height,\n1068\t        num_cosets,\n1069\t        g_shift,\n1070\t        max_temp_bytes,\n1071\t    ))\n1072\t}\n1073\t\n1074\t/// # Safety\n1075\t/// - `buffer_size` does not refer to the capacity of `intermediates`. It refers to \"how many DAG\n1076\t///   nodes per row need to be buffered\". The capacity is a multiple of `buffer_size` which is\n1077\t///   runtime calculated based on `buffer_size`.\n1078\t/// - `eq_cube` must be a pointer to device buffer with at least `num_x` elements representing\n1079\t///   evaluations on hypercube.\n1080\t/// - `output` will not be written to by this function. Only `tmp_sums_buffer` is written.\n1081\t#[allow(clippy::too_many_arguments)]\n1082\tpub unsafe fn logup_bary_eval_interactions_round0(\n1083\t    tmp_sums_buffer: &mut DeviceBuffer<Frac<EF>>,\n1084\t    output: &mut DeviceBuffer<Frac<EF>>,\n1085\t    selectors_cube: &DeviceBuffer<F>,\n1086\t    preprocessed: *const F,\n1087\t    main_ptrs: &DeviceBuffer<*const F>,\n1088\t    eq_cube: *const EF,\n1089\t    public_values: &DeviceBuffer<F>,\n1090\t    numer_weights: &DeviceBuffer<EF>,\n1091\t    denom_weights: &DeviceBuffer<EF>,\n1092\t    denom_sum_init: EF,\n1093\t    rules: &DeviceBuffer<u128>,\n1094\t    buffer_size: u32,\n1095\t    intermediates: &mut DeviceBuffer<F>,\n1096\t    skip_domain: u32,\n1097\t    num_x: u32,\n1098\t    height: u32,\n1099\t    num_cosets: u32,\n1100\t    g_shift: F,\n1101\t    max_temp_bytes: usize,\n1102\t) -> Result<(), CudaError> {\n1103\t    CudaError::from_result(_logup_bary_eval_interactions_round0(\n1104\t        tmp_sums_buffer.as_mut_ptr(),\n1105\t        output.as_mut_ptr(),\n1106\t        selectors_cube.as_ptr(),\n1107\t        preprocessed,\n1108\t        main_ptrs.as_ptr(),\n1109\t        eq_cube,\n1110\t        public_values.as_ptr(),\n1111\t        numer_weights.as_ptr(),\n1112\t        denom_weights.as_ptr(),\n1113\t        denom_sum_init,\n1114\t        rules.as_raw_ptr(),\n1115\t        rules.len(),\n1116\t        buffer_size,\n1117\t        intermediates.as_mut_ptr(),\n1118\t        skip_domain,\n1119\t        num_x,\n1120\t        height,\n1121\t        num_cosets,\n1122\t        g_shift,\n1123\t        max_temp_bytes,\n1124\t    ))\n1125\t}\n1126\t\n1127\t/// Evaluate zerocheck MLE constraints on GPU with raw device pointers.\n1128\t#[allow(clippy::too_many_arguments)]\n1129\tpub unsafe fn zerocheck_eval_mle(\n1130\t    tmp_sums_buffer: &mut DeviceBuffer<EF>,\n1131\t    output: &mut DeviceBuffer<EF>,\n1132\t    eq_xi: *const EF,\n1133\t    selectors: *const EF,\n1134\t    preprocessed: MainMatrixPtrs<EF>,\n1135\t    main_ptrs: *const MainMatrixPtrs<EF>,\n1136\t    lambda_pows: *const EF,\n1137\t    lambda_len: usize,\n1138\t    public_values: *const F,\n1139\t    rules: *const std::ffi::c_void,\n1140\t    rules_len: usize,\n1141\t    used_nodes: *const usize,\n1142\t    used_nodes_len: usize,\n1143\t    buffer_size: u32,\n1144\t    intermediates: &mut DeviceBuffer<EF>,\n1145\t    num_y: u32,\n1146\t    num_x: u32,\n1147\t) -> Result<(), CudaError> {\n1148\t    CudaError::from_result(_zerocheck_eval_mle(\n1149\t        tmp_sums_buffer.as_mut_ptr(),\n1150\t        output.as_mut_ptr(),\n1151\t        eq_xi,\n1152\t        selectors,\n1153\t        preprocessed,\n1154\t        main_ptrs,\n1155\t        lambda_pows,\n1156\t        public_values,\n1157\t        rules,\n1158\t        rules_len,\n1159\t        used_nodes,\n1160\t        used_nodes_len,\n1161\t        lambda_len,\n1162\t        buffer_size,\n1163\t        intermediates.as_mut_ptr(),\n1164\t        num_y,\n1165\t        num_x,\n1166\t    ))\n1167\t}\n1168\t\n1169\t#[allow(clippy::too_many_arguments)]\n1170\tpub unsafe fn zerocheck_batch_eval_mle(\n1171\t    tmp_sums_buffer: &mut DeviceBuffer<EF>,\n1172\t    output: &mut DeviceBuffer<EF>,\n1173\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n1174\t    zc_ctxs: &DeviceBuffer<ZerocheckCtx>,\n1175\t    air_block_offsets: &DeviceBuffer<u32>,\n1176\t    lambda_pows: &DeviceBuffer<EF>,\n1177\t    lambda_len: usize,\n1178\t    num_blocks: u32,\n1179\t    num_x: u32,\n1180\t    num_airs: u32,\n1181\t    threads_per_block: u32,\n1182\t) -> Result<(), CudaError> {\n1183\t    CudaError::from_result(_zerocheck_batch_eval_mle(\n1184\t        tmp_sums_buffer.as_mut_ptr(),\n1185\t        output.as_mut_ptr(),\n1186\t        block_ctxs.as_ptr(),\n1187\t        zc_ctxs.as_ptr(),\n1188\t        air_block_offsets.as_ptr(),\n1189\t        lambda_pows.as_ptr(),\n1190\t        lambda_len,\n1191\t        num_blocks,\n1192\t        num_x,\n1193\t        num_airs,\n1194\t        threads_per_block,\n1195\t    ))\n1196\t}\n1197\t\n1198\t/// Evaluate logup MLE interactions on GPU with raw device pointers.\n1199\t#[allow(clippy::too_many_arguments)]\n1200\tpub unsafe fn logup_eval_mle(\n1201\t    tmp_sums_buffer: &mut DeviceBuffer<Frac<EF>>,\n1202\t    output: &mut DeviceBuffer<Frac<EF>>,\n1203\t    eq_xi: *const EF,\n1204\t    selectors: *const EF,\n1205\t    preprocessed: MainMatrixPtrs<EF>,\n1206\t    main_ptrs: *const MainMatrixPtrs<EF>,\n1207\t    challenges: *const EF,\n1208\t    eq_3bs: *const EF,\n1209\t    public_values: *const F,\n1210\t    rules: *const std::ffi::c_void,\n1211\t    used_nodes: *const usize,\n1212\t    pair_idxs: *const u32,\n1213\t    used_nodes_len: usize,\n1214\t    buffer_size: u32,\n1215\t    intermediates: &mut DeviceBuffer<EF>,\n1216\t    num_y: u32,\n1217\t    num_x: u32,\n1218\t) -> Result<(), CudaError> {\n1219\t    CudaError::from_result(_logup_eval_mle(\n1220\t        tmp_sums_buffer.as_mut_ptr(),\n1221\t        output.as_mut_ptr(),\n1222\t        eq_xi,\n1223\t        selectors,\n1224\t        preprocessed,\n1225\t        main_ptrs,\n1226\t        challenges,\n1227\t        eq_3bs,\n1228\t        public_values,\n1229\t        rules,\n1230\t        used_nodes,\n1231\t        pair_idxs,\n1232\t        used_nodes_len,\n1233\t        buffer_size,\n1234\t        intermediates.as_mut_ptr(),\n1235\t        num_y,\n1236\t        num_x,\n1237\t    ))\n1238\t}\n1239\t\n1240\t#[allow(clippy::too_many_arguments)]\n1241\tpub unsafe fn logup_batch_eval_mle(\n1242\t    tmp_sums_buffer: &mut DeviceBuffer<Frac<EF>>,\n1243\t    output: &mut DeviceBuffer<Frac<EF>>,\n1244\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n1245\t    logup_ctxs: &DeviceBuffer<LogupCtx>,\n1246\t    air_block_offsets: &DeviceBuffer<u32>,\n1247\t    num_blocks: u32,\n1248\t    num_x: u32,\n1249\t    num_airs: u32,\n1250\t    threads_per_block: u32,\n1251\t) -> Result<(), CudaError> {\n1252\t    CudaError::from_result(_logup_batch_eval_mle(\n1253\t        tmp_sums_buffer.as_mut_ptr(),\n1254\t        output.as_mut_ptr(),\n1255\t        block_ctxs.as_ptr(),\n1256\t        logup_ctxs.as_ptr(),\n1257\t        air_block_offsets.as_ptr(),\n1258\t        num_blocks,\n1259\t        num_x,\n1260\t        num_airs,\n1261\t        threads_per_block,\n1262\t    ))\n1263\t}\n1264\t\n1265\t#[allow(clippy::too_many_arguments)]\n1266\tpub unsafe fn zerocheck_monomial_batched(\n1267\t    tmp_sums: &mut DeviceBuffer<EF>,\n1268\t    output: &mut DeviceBuffer<EF>,\n1269\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n1270\t    air_ctxs: &DeviceBuffer<MonomialAirCtx>,\n1271\t    air_block_offsets: &DeviceBuffer<u32>,\n1272\t    num_blocks: u32,\n1273\t    num_x: u32,\n1274\t    num_airs: u32,\n1275\t    threads_per_block: u32,\n1276\t) -> Result<(), CudaError> {\n1277\t    CudaError::from_result(_zerocheck_monomial_batched(\n1278\t        tmp_sums.as_mut_ptr(),\n1279\t        output.as_mut_ptr(),\n1280\t        block_ctxs.as_ptr(),\n1281\t        air_ctxs.as_ptr(),\n1282\t        air_block_offsets.as_ptr(),\n1283\t        num_blocks,\n1284\t        num_x,\n1285\t        num_airs,\n1286\t        threads_per_block,\n1287\t    ))\n1288\t}\n1289\t\n1290\t#[allow(clippy::too_many_arguments)]\n1291\tpub unsafe fn zerocheck_monomial_par_y_batched(\n1292\t    tmp_sums: &mut DeviceBuffer<EF>,\n1293\t    output: &mut DeviceBuffer<EF>,\n1294\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n1295\t    air_ctxs: &DeviceBuffer<MonomialAirCtx>,\n1296\t    air_block_offsets: &DeviceBuffer<u32>,\n1297\t    num_blocks: u32,\n1298\t    num_x: u32,\n1299\t    num_airs: u32,\n1300\t    chunk_size: u32,\n1301\t    threads_per_block: u32,\n1302\t) -> Result<(), CudaError> {\n1303\t    CudaError::from_result(_zerocheck_monomial_par_y_batched(\n1304\t        tmp_sums.as_mut_ptr(),\n1305\t        output.as_mut_ptr(),\n1306\t        block_ctxs.as_ptr(),\n1307\t        air_ctxs.as_ptr(),\n1308\t        air_block_offsets.as_ptr(),\n1309\t        num_blocks,\n1310\t        num_x,\n1311\t        num_airs,\n1312\t        chunk_size,\n1313\t        threads_per_block,\n1314\t    ))\n1315\t}\n1316\t\n1317\tpub unsafe fn precompute_lambda_combinations(\n1318\t    out: &mut DeviceBuffer<EF>,\n1319\t    headers: *co