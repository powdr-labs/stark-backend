{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TrJhVysDG3HX6E6URN9Nbv","type":"tool_result","content":"1048\t        // Phase 1: Build work items with pre-computed buffer sizes (main thread, pure CPU)\n1049\t        let per_thread_temp_bytes = self.memory_limit_bytes / NUM_ROUND0_STREAMS.max(1);\n1050\t        let mut work_items: Vec<Round0AirWorkItem<HS>> = izip!(\n1051\t            &ctx.per_trace,\n1052\t            &self.n_per_trace,\n1053\t            &selectors_base,\n1054\t            &self.public_values_per_trace,\n1055\t            &self.eq_3b_per_trace,\n1056\t        )\n1057\t        .enumerate()\n1058\t        .map(|(trace_idx, ((air_idx, air_ctx), &n, sel, pv, eq3b))| {\n1059\t            let single_pk = &self.pk.per_air[*air_idx];\n1060\t            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n1061\t            let n_lift = n.max(0) as usize;\n1062\t            let skip_domain = 1u32 << l_skip;\n1063\t            let num_x = 1u32 << n_lift;\n1064\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1) as u32;\n1065\t            let num_cosets_logup = local_constraint_deg as u32;\n1066\t\n1067\t            // Pre-compute zerocheck buffer sizes\n1068\t            let zc_buffer_size = single_pk.other_data.zerocheck_round0.inner.buffer_size;\n1069\t            let zc_intermed_cap = if num_cosets_zc > 0 && !single_pk.vk.symbolic_constraints.constraints.constraint_idx.is_empty() {\n1070\t                unsafe {\n1071\t                    _zerocheck_r0_intermediates_buffer_size(\n1072\t                        zc_buffer_size, skip_domain, num_x, num_cosets_zc, per_thread_temp_bytes,\n1073\t                    )\n1074\t                }\n1075\t            } else {\n1076\t                0\n1077\t            };\n1078\t            let zc_temp_sums_cap = if num_cosets_zc > 0 && !single_pk.vk.symbolic_constraints.constraints.constraint_idx.is_empty() {\n1079\t                unsafe {\n1080\t                    _zerocheck_r0_temp_sums_buffer_size(\n1081\t                        zc_buffer_size, skip_domain, num_x, num_cosets_zc, per_thread_temp_bytes,\n1082\t                    )\n1083\t                }\n1084\t            } else {\n1085\t                0\n1086\t            };\n1087\t\n1088\t            // Pre-compute logup buffer sizes (using logup_round0_buffer_size from Step 1)\n1089\t            let logup_buffer_size = single_pk.other_data.logup_round0_buffer_size;\n1090\t            let has_interactions = !eq3b.is_empty();\n1091\t            let logup_intermed_cap = if has_interactions && logup_buffer_size > 0 {\n1092\t                unsafe {\n1093\t                    _logup_r0_intermediates_buffer_size(\n1094\t                        logup_buffer_size, skip_domain, num_x, num_cosets_logup, per_thread_temp_bytes,\n1095\t                    )\n1096\t                }\n1097\t            } else {\n1098\t                0\n1099\t            };\n1100\t            let logup_temp_sums_cap = if has_interactions && logup_buffer_size > 0 {\n1101\t                unsafe {\n1102\t                    _logup_r0_temp_sums_buffer_size(\n1103\t                        logup_buffer_size, skip_domain, num_x, num_cosets_logup, per_thread_temp_bytes,\n1104\t                    )\n1105\t                }\n1106\t            } else {\n1107\t                0\n1108\t            };\n1109\t\n1110\t            Round0AirWorkItem {\n1111\t                trace_idx,\n1112\t                single_pk,\n1113\t                n,\n1114\t                selectors_cube: sel,\n1115\t                public_values: pv,\n1116\t                eq_3bs: eq3b,\n1117\t                cached_mains: &air_ctx.cached_mains,\n1118\t                common_main: &air_ctx.common_main,\n1119\t                eq_xis: &self.eq_xis,\n1120\t                d_lambda_pows,\n1121\t                beta_pows: &self.beta_pows,\n1122\t                l_skip,\n1123\t                constraint_degree: self.constraint_degree,\n1124\t                xi: &self.xi,\n1125\t                max_temp_bytes: per_thread_temp_bytes,\n1126\t                zc_intermed_cap,\n1127\t                zc_temp_sums_cap,\n1128\t                logup_intermed_cap,\n1129\t                logup_temp_sums_cap,\n1130\t                zc_batch_offset: 0,    // set after max_poly_len is computed\n1131\t                numer_batch_offset: 0,\n1132\t                denom_batch_offset: 0,\n1133\t            }\n1134\t        })\n1135\t        .collect();\n1136\t\n1137\t        // Sort by descending height for better load balance across thread chunks.\n1138\t        work_items.sort_by(|a, b| b.common_main.height().cmp(&a.common_main.height()));\n1139\t\n1140\t        // Pre-compute polynomial extraction transform matrices per unique constraint degree.\n1141\t        let skip_domain = 1usize << l_skip;\n1142\t        let mut extract_tables: FxHashMap<usize, Round0ExtractTables> = FxHashMap::default();\n1143\t        for w in &work_items {\n1144\t            let d = w.single_pk.vk.max_constraint_degree as usize;\n1145\t            if !extract_tables.contains_key(&d) {\n1146\t                extract_tables.insert(d, compute_round0_extract_tables(d, l_skip)?);\n1147\t            }\n1148\t        }\n1149\t\n1150\t        // Pre-allocate device batch polynomial array.\n1151\t        // All polynomial coefficients are written here by GPU extraction kernels,\n1152\t        // then copied to host in a single D2H transfer.\n1153\t        let max_poly_len = work_items\n1154\t            .iter()\n1155\t            .map(|w| {\n1156\t                let d = w.single_pk.vk.max_constraint_degree as usize;\n1157\t                let zc_len = sumcheck_round0_deg(l_skip, d) + 1;\n1158\t                let logup_len = d * skip_domain;\n1159\t                zc_len.max(logup_len)\n1160\t            })\n1161\t            .max()\n1162\t            .unwrap_or(0);\n1163\t\n1164\t        let batch_total = 3 * num_present_airs * max_poly_len;\n1165\t        let d_batch_array = if batch_total > 0 {\n1166\t            let buf = DeviceBuffer::<EF>::with_capacity(batch_total);\n1167\t            buf.fill_zero().map_err(MemCopyError::from)?;\n1168\t            buf\n1169\t        } else {\n1170\t            DeviceBuffer::new()\n1171\t        };\n1172\t\n1173\t        // Set per-AIR batch offsets.\n1174\t        for w in &mut work_items {\n1175\t            w.zc_batch_offset = (2 * num_present_airs + w.trace_idx) * max_poly_len;\n1176\t            w.numer_batch_offset = (2 * w.trace_idx) * max_poly_len;\n1177\t            w.denom_batch_offset = (2 * w.trace_idx + 1) * max_poly_len;\n1178\t        }\n1179\t\n1180\t        // Track per-AIR polynomial lengths for host-side reconstruction.\n1181\t        let poly_lens: Vec<(usize, usize, usize)> = {\n1182\t            // Build a map from trace_idx to (zc_len, logup_len)\n1183\t            let mut lens = vec![(0usize, 0usize, 0usize); num_present_airs];\n1184\t            for w in &work_items {\n1185\t                let d = w.single_pk.vk.max_constraint_degree as usize;\n1186\t                let has_constraints = d > 1\n1187\t                    && !w\n1188\t                        .single_pk\n1189\t                        .vk\n1190\t                        .symbolic_constraints\n1191\t                        .constraints\n1192\t                        .constraint_idx\n1193\t                        .is_empty();\n1194\t                let has_interactions = !w.eq_3bs.is_empty();\n1195\t                let zc_len = if has_constraints {\n1196\t                    sumcheck_round0_deg(l_skip, d) + 1\n1197\t                } else {\n1198\t                    0\n1199\t                };\n1200\t                let logup_len = if has_interactions { d * skip_domain } else { 0 };\n1201\t                lens[w.trace_idx] = (zc_len, logup_len, logup_len);\n1202\t            }\n1203\t            lens\n1204\t        };\n1205\t\n1206\t        // Pre-compute buffer sizes for pre-allocation using a percentile threshold.\n1207\t        // Using the max would require enormous buffers (driven by a few large AIRs),\n1208\t        // causing GPU memory pressure that degrades all phases. The 95th percentile\n1209\t        // covers 95%+ of AIRs while keeping total allocation manageable. The few\n1210\t        // large AIRs above the threshold fall back to dynamic allocation.\n1211\t        let percentile_idx = |n: usize| -> usize { (n * 95 / 100).min(n.saturating_sub(1)) };\n1212\t        let (max_zc_intermed, max_zc_temp_sums, max_logup_intermed, max_logup_temp_sums) = {\n1213\t            let n = work_items.len();\n1214\t            let mut zc_i: Vec<usize> = work_items.iter().map(|w| w.zc_intermed_cap).collect();\n1215\t            let mut zc_t: Vec<usize> = work_items.iter().map(|w| w.zc_temp_sums_cap).collect();\n1216\t            let mut li: Vec<usize> = work_items.iter().map(|w| w.logup_intermed_cap).collect();\n1217\t            let mut lt: Vec<usize> = work_items.iter().map(|w| w.logup_temp_sums_cap).collect();\n1218\t            zc_i.sort_unstable();\n1219\t            zc_t.sort_unstable();\n1220\t            li.sort_unstable();\n1221\t            lt.sort_unstable();\n1222\t            let idx = percentile_idx(n);\n1223\t            (zc_i[idx], zc_t[idx], li[idx], lt[idx])\n1224\t        };\n1225\t\n1226\t        // Barrier: ensure all prior GPU work (trace uploads, pk data, selectors)\n1227\t        // is visible to worker thread streams.\n1228\t        current_stream_sync().map_err(MemCopyError::from)?;\n1229\t\n1230\t        // Phase 2: Process AIRs in parallel across N OS threads.\n1231\t        // Only use multi-threading when there are enough AIRs to benefit from concurrent\n1232\t        // kernel execution. With few large AIRs (e.g., APC 0 has ~20 per segment), each\n1233\t        // kernel already saturates the GPU and multi-threading adds memory pool overhead.\n1234\t        let mut num_threads = if work_items.len() >= 10