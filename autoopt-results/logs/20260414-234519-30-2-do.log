g Nsight Systems profiling...\"\n        nsys profile \\\n            --output \"${run_name}/nsys_report\" \\\n            --force-overwrite true \\\n            --trace cuda,nvtx,osrt \\\n            --sample none \\\n            --stats true \\","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
