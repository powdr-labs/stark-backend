intProof<SC>)>,\n    PD::OpeningProof: Into<(StackingProof<SC>, WhirProof<SC>)>,\n    TS: FiatShamirTranscript<SC>,\n{\n    #[instrument(\n        name = \"stark_prove_excluding_trace\",\n        level = \"info\",\n        skip_all,\n        fields(phase = \"prover\")\n    )]\n    fn prove_stark<'a>(\n        &'a mut self,\n        mpk: &'a DeviceMultiStarkProvingKey<PB>,\n        unsorted_ctx: ProvingContext<PB>,\n    ) -> Result<Proof<SC>, <PD as ProverDevice<PB, TS>>::Error> {\n        let transcript = &mut self.transcript;\n        transcript.observe_commit(mpk.vk_pre_hash);\n\n        let ctx = unsorted_ctx.into_sorted();"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":520,"cache_read_input_tokens":58206,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":520},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"277505aa-cc21-4c83-adf9-2b1f7130a97b","uuid":"c7785126-07fe-49cc-9372-9e170fdbdcba"}
