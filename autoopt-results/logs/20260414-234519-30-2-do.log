AIR constraints (but\n43\t    /// independent from any trace data).\n44\t    type OtherAirData: Send + Sync;\n45\t    /// Owned buffer for the preimage of a PCS commitment on device, together with any metadata\n46\t    /// necessary for computing opening proofs.\n47\t    ///\n48\t    /// For example, multiple buffers for LDE matrices, their trace domain sizes, and pointer to\n49\t    /// mixed merkle tree.\n50\t    type PcsData: Send + Sync;\n51\t}\n52\t\n53\tpub trait ProverDevice<PB: ProverBackend, TS>:\n54\t    TraceCommitter<PB> + MultiRapProver<PB, TS> + OpeningProver<PB, TS>\n55\t{\n56\t    type Error: 'static\n57\t        + std::error::Error\n58\t        + Send\n59\t        + Sync\n60\t        + From<<Self as TraceCommitter<PB>>::Error>\n61\t        + From<<Self as MultiRapProver<PB, TS>>::Error>\n62\t        + From<<Self as OpeningProver<PB, TS>>::Error>;\n63\t}\n64\t\n65\t/// Provides functionality for committing to a batch of trace matrices, possibly of different\n66\t/// heights.\n67\tpub trait TraceCommitter<PB: ProverBackend> {\n68\t    type Error: std::fmt::Debug;\n69\t    fn commit(&self, traces: &[&PB::Matrix]) -> Result<(PB::Commitment, PB::PcsData), Self::Error>;\n70\t}\n71\t\n72\t/// This trait is responsible for all proving steps to prove a collection of trace matrices\n73\t/// satisfies all constraints of a Randomized AIR with Preprocessing. Such constraints include AIR\n74\t/// constraints as well as bus balancing constraints for interactions between AIRs. These\n75\t/// constraints may be grouped into challenge phases, where new randomness is sampled between phases\n76\t/// via Fiat-Shamir (which would involve committing to more data).\n77\t///\n78\t/// This trait is _not_ responsible for committing to the trace matrices or for proving polynomial\n79\t/// openings with respect to the committed trace matrices.\n80\tpub trait MultiRapProver<PB: ProverBackend, TS> {\n81\t    /// The partial proof is the proof that the trace matrices satisfy all constraints assuming that\n82\t    /// certain polynomial opening claims are validated. In other words, it is a proof that reduces\n83\t    /// the constraint satisfaction claim to certain polynomial opening claims.\n84\t    type PartialProof: Clone + Send + Sync + Serialize + DeserializeOwned;\n85\t    /// Other artifacts of the proof (e.g., sampled randomness) that may be passed to later stages\n86\t    /// of the protocol.\n87\t    type Artifacts;\n88\t\n89\t    type Error: std::fmt::Debug;\n90\t\n91\t    fn prove_rap_constraints(\n92\t        &self,\n93\t        transcript: &mut TS,\n94\t        mpk: &DeviceMultiStarkProvingKey<PB>,\n95\t        ctx: &ProvingContext<PB>,\n96\t        common_main_pcs_data: &PB::PcsData,\n97\t    ) -> Result<(Self::PartialProof, Self::Artifacts), Self::Error>;\n98\t}\n99\t\n100\t/// This trait is responsible for proving the evaluation claims of a collection of polynomials at a\n101\t/// collection of points. The opening point may be the same across polynomials. The polynomials may\n102\t/// be defined over different domains and are hence of \"mixed\" nature. The polynomials are already\n103\t/// committed and provided in their committed form.\n104\tpub trait OpeningProver<PB: ProverBackend, TS> {\n105\t    /// PCS opening proof on host. This should not be a reference.\n106\t    type OpeningProof: Clone + Send + Sync + Serialize + DeserializeOwned;\n107\t    type OpeningPoints;\n108\t\n109\t    /// Computes the opening proof.\n110\t    /// The `common_main_pcs_data` is the `PcsData` for the collection of common main trace\n111\t    /// matrices. It is owned by the function and may be mutated.\n112\t    /// The `pre_cached_pcs_data_per_commit` is the `PcsData` for the preprocessed and cached trace\n113\t    /// matrices. These are specified by their `PcsData` per commitment.\n114\t    type Error: std::fmt::Debug;\n115\t\n116\t    fn prove_openings(\n117\t        &self,\n118\t        transcript: &mut TS,\n119\t        mpk: &DeviceMultiStarkProvingKey<PB>,\n120\t        ctx: ProvingContext<PB>,\n121\t        common_main_pcs_data: PB::PcsData,\n122\t        points: Self::OpeningPoints,\n123\t    ) -> Result<Self::OpeningProof, Self::Error>;\n124\t}\n125\t\n126\t/// Trait to manage data transport of prover types from host to device.\n127\tpub trait DeviceDataTransporter<SC, PB>\n128\twhere\n129\t    SC: StarkProtocolConfig,\n130\t    PB: ProverBackend<Val = SC::F, Challenge = SC::EF, Commitment = SC::Digest>,\n131\t{\n132\t    /// Transport the proving key to the device, filtering for only the provided `air_ids`.\n133\t    fn transport_pk_to_device(\n134\t        &self,\n135\t        mpk: &MultiStarkProvingKey<SC>,\n136\t    ) -> DeviceMultiStarkProvingKey<PB>;\n137\t\n138\t    fn transport_matrix_to_device(&self, matrix: &ColMajorMatrix<SC::F>) -> PB::Matrix;\n139\t\n140\t    /// The `commitment` and `prover_data` are assumed to have been previously computed from the\n141\t    /// `trace`.\n142\t    fn transport_pcs_data_to_device(\n143\t        &self,\n144\t        pcs_data: &StackedPcsData<SC::F, SC::Digest>,\n145\t    ) -> PB::PcsData;\n146\t\n147\t    fn transport_committed_trace_data_to_device(\n148\t        &self,\n149\t        committed_trace: &CommittedTraceData<CpuColMajorBackend<SC>>,\n150\t    ) -> CommittedTraceData<PB> {\n151\t        let trace = self.transport_matrix_to_device(&committed_trace.trace);\n152\t        let data = self.transport_pcs_data_to_device(committed_trace.data.as_ref());\n153\t\n154\t        CommittedTraceData {\n155\t            commitment: committed_trace.commitment,\n156\t            trace,\n157\t            data: Arc::new(data),\n158\t        }\n159\t    }\n160\t\n161\t    fn transport_proving_ctx_to_device(\n162\t        &self,\n163\t        ctx: &ProvingContext<CpuColMajorBackend<SC>>,\n164\t    ) -> ProvingContext<PB> {\n165\t        let per_trace = ctx\n166\t            .per_trace\n167\t            .iter()\n168\t            .map(|(air_idx, trace_ctx)| {\n169\t                let common_main = self.transport_matrix_to_device(&trace_ctx.common_main);\n170\t                let cached_mains = trace_ctx\n171\t                    .cached_mains\n172\t                    .iter()\n173\t                    .map(|cd| self.transport_committed_trace_data_to_device(cd))\n174\t                    .collect();\n175\t                let trace_ctx_gpu = AirProvingContext::new(\n176\t                    cached_mains,\n177\t                    common_main,\n178\t                    trace_ctx.public_values.clone(),\n179\t                );\n180\t                (*air_idx, trace_ctx_gpu)\n181\t            })\n182\t            .collect();\n183\t        ProvingContext::new(per_trace)\n184\t    }\n185\t\n186\t    // ==================================================================================\n187\t    // Device-to-Host methods below should only be used for testing / debugging purposes.\n188\t    // ==================================================================================\n189\t\n190\t    /// Transport a device matrix to host. This should only be used for testing / debugging\n191\t    /// purposes.\n192\t    fn transport_matrix_from_device_to_host(&self, matrix: &PB::Matrix) -> ColMajorMatrix<SC::F>;\n193\t}\n194\t"}]},"parent_tool_use_id":null,"session_id":"277505aa-cc21-4c83-adf9-2b1f7130a97b","uuid":"80546628-11f0-469a-8676-f991307a4fd7","timestamp":"2026-04-14T22:25:02.724Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/stark-backend/src/prover/hal.rs","content":"use std::sync::Arc;\n\nuse serde::{de::DeserializeOwned, Serialize};\n\nuse crate::{\n    keygen::types::MultiStarkProvingKey,\n    prover::{\n        stacked_pcs::StackedPcsData, AirProvingContext, ColMajorMatrix, CommittedTraceData,\n        CpuColMajorBackend, DeviceMultiStarkProvingKey, ProvingContext,\n    },\n    StarkProtocolConfig,\n};\n\npub trait MatrixDimensions {\n    fn height(&self) -> usize;\n    fn width(&self) -> usize;\n}\n\n/// Associated types needed by the prover, in the form of buffers and views,\n/// specific to a specific hardware backend.\n///\n/// Memory allocation and copying is not handled by this trait.\npub trait ProverBackend {\n    /// Extension field degree for the challenge field `Self::Challenge` over base field\n    /// `Self::Val`.\n    const CHALLENGE_EXT_DEGREE: u8;\n    // ==== Host Types ====\n    /// Base field type, on host.\n    type Val: Copy + Send + Sync + Serialize + DeserializeOwned;\n    /// Challenge field (extension field of base field), on host.\n    type Challenge: Copy + Send + Sync + Serialize + DeserializeOwned;\n    /// Single commitment on host.\n    // Commitments are small in size and need to be transferred back to host to be included in\n    // proof.\n    type Commitment: Clone + Send + Sync + Serialize + DeserializeOwned;\n\n    // ==== Device Types ====\n    /// Single matrix buffer on device together with dimension metadata. Owning this means nothing\n    /// else has a shared reference to the buffer.\n    type Matrix: MatrixDimensions + Send + Sync;\n    /// Backend specific type for any pre-computed data associated with a single AIR. For example,\n    /// it may contain prover-specific precomputations based on the AIR constraints (but\n    /// independent from any trace data).\n    type OtherAirData: Send + Sync;\n    /// Owned buffer for the preimage of a PCS commitment on device, together with any metadata\n    /// necessary for computing opening proofs.\n    ///\n    /// For example, multiple buffers for LDE matrices, their trace domain sizes, and pointer to\n    /// mixed merkle tree.\n    type PcsData: Send + Sync;\n}\n\npub trait ProverDevice<PB: ProverBackend, TS>:\n    TraceCommitter<PB> + MultiRapProver<PB, TS> + OpeningProver<PB, TS>\n{\n    type Error: 'static\n        + std::error::Error\n        + Send\n        + Sync\n        + From<<Self as TraceCommitter<PB>>::Error>\n        + From<<Self as MultiRapProver<PB, TS>>::Error>\n        + From<<Self as OpeningProver<PB, TS>>::Error>;\n}\n\n/// Provides functionality for committing to a batch of trace matrices, possibly of different\n/// heights.\npub trait TraceCommitter<PB: ProverBackend> {\n    type Error: std::fmt::Debug;\n    fn commit(&self, traces: &[&PB::Matrix]) -> Result<(PB::Commitment, PB::PcsData), Self::Error>;\n}\n\n/// This trait is responsible for all proving steps to prove a collection of trace matrices\n/// satisfies all constraints of a Randomized AIR with Preprocessing. Such constraints include AIR\n/// constraints as well as bus balancing constraints for interactions between AIRs. These\n/// constraints may be grouped into challenge phases, where new randomness is sampled between phases\n/// via Fiat-Shamir (which would involve committing to more data).\n///\n/// This trait is _not_ responsible for committing to the trace matrices or for proving polynomial\n/// openings with respect to the committed trace matrices.\npub trait MultiRapProver<PB: ProverBackend, TS> {\n    /// The partial proof is the proof that the trace matrices satisfy all constraints assuming that\n    /// certain polynomial opening claims are validated. In other words, it is a proof that reduces\n    /// the constraint satisfaction claim to certain polynomial opening claims.\n    type PartialProof: Clone + Send + Sync + Serialize + DeserializeOwned;\n    /// Other artifacts of the proof (e.g., sampled randomness) that may be passed to later stages\n    /// of the protocol.\n    type Artifacts;\n\n    type Error: std::fmt::Debug;\n\n    fn prove_rap_constraints(\n        &self,\n        transcript: &mut TS,\n        mpk: &DeviceMultiStarkProvingKey<PB>,\n        ctx: &ProvingContext<PB>,\n        common_main_pcs_data: &PB::PcsData,\n    ) -> Result<(Self::PartialProof, Self::Artifacts), Self::Error>;\n}\n\n/// This trait is responsible for proving the evaluation claims of a collection of polynomials at a\n/// collection of points. The opening point may be the same across polynomials. The polynomials may\n/// be defined over different domains and are hence of \"mixed\" nature. The polynomials are already\n/// committed and provided in their committed form.\npub trait OpeningProver<PB: ProverBackend, TS> {\n    /// PCS opening proof on host. This should not be a reference.\n    type OpeningProof: Clone + Send + Sync + Serialize + DeserializeOwned;\n    type OpeningPoints;\n\n    /// Computes the opening proof.\n    /// The `common_main_pcs_data` is the `PcsData` for the collection of common main trace\n    /// matrices. It is owned by the function and may be mutated.\n    /// The `pre_cached_pcs_data_per_commit` is the `PcsData` for the preprocessed and cached trace\n    /// matrices. These are specified by their `PcsData` per commitment.\n    type Error: std::fmt::Debug;\n\n    fn prove_openings(\n        &self,\n        transcript: &mut TS,\n        mpk: &DeviceMultiStarkProvingKey<PB>,\n        ctx: ProvingContext<PB>,\n        common_main_pcs_data: PB::PcsData,\n        points: Self::OpeningPoints,\n    ) -> Result<Self::OpeningProof, Self::Error>;\n}\n\n/// Trait to manage data transport of prover types from host to device.\npub trait DeviceDataTransporter<SC, PB>\nwhere\n    SC: StarkProtocolConfig,\n    PB: ProverBackend<Val = SC::F, Challenge = SC::EF, Commitment = SC::Digest>,\n{\n    /// Transport the proving key to the device, filtering for only the provided `air_ids`.\n    fn transport_pk_to_device(\n        &self,\n        mpk: &MultiStarkProvingKey<SC>,\n    ) -> DeviceMultiStarkProvingKey<PB>;\n\n    fn transport_matrix_to_device(&self, matrix: &ColMajorMatrix<SC::F>) -> PB::Matrix;\n\n    /// The `commitment` and `prover_data` are assumed to have been previously computed from the\n    /// `trace`.\n    fn transport_pcs_data_to_device(\n        &self,\n        pcs_data: &StackedPcsData<SC::F, SC::Digest>,\n    ) -> PB::PcsData;\n\n    fn transport_committed_trace_data_to_device(\n        &self,\n        committed_trace: &CommittedTraceData<CpuColMajorBackend<SC>>,\n    ) -> CommittedTraceData<PB> {\n        let trace = self.transport_matrix_to_device(&committed_trace.trace);\n        let data = self.transport_pcs_data_to_device(committed_trace.data.as_ref());\n\n        CommittedTraceData {\n            commitment: committed_trace.commitment,\n            trace,\n            data: Arc::new(data),\n        }\n    }\n\n    fn transport_proving_ctx_to_device(\n        &self,\n        ctx: &ProvingContext<CpuColMajorBackend<SC>>,\n    ) -> ProvingContext<PB> {\n        let per_trace = ctx\n            .per_trace\n            .iter()\n            .map(|(air_idx, trace_ctx)| {\n                let common_main = self.transport_matrix_to_device(&trace_ctx.common_main);\n                let cached_mains = trace_ctx\n                    .cached_mains\n                    .iter()\n                    .map(|cd| self.transport_committed_trace_data_to_device(cd))\n                    .collect();\n                let trace_ctx_gpu = AirProvingContext::new(\n                    cached_mains,\n                    common_main,\n                    trace_ctx.public_values.clone(),\n                );\n                (*air_idx, trace_ctx_gpu)\n            })\n            .collect();\n        ProvingContext::new(per_trace)\n    }\n\n    // ==================================================================================\n    // Device-to-Host methods below should only be used for testing / debugging purposes.\n    // ==================================================================================\n\n    /// Transport a device matrix to host. This should only be used for testing / debugging\n    /// purposes.\n    fn transport_matrix_from_device_to_host(&self, matrix: &PB::Matrix) -> ColMajorMatrix<SC::F>;\n}\n","numLines":194,"startLine":1,"totalLines":194}}}
