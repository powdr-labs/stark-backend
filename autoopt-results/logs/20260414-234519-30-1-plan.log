{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QkECzAXGSGcSAW9LNQKyj9","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"\n3\tAudit script for OpenVM metrics viewer.\n4\t\n5\tRecomputes the experiment details table from a metrics JSON file,\n6\tprinting all computed values so they can be verified against the web UI.\n7\t\n8\tUsage:\n9\t    python3 audit_metrics.py <metrics_file_or_url> [experiment_name]\n10\t\n11\tThe source can be a local file path or an HTTP(S) URL.\n12\tGitHub blob URLs are auto-converted to raw URLs.\n13\t\n14\tIf the input is a combined metrics file and no experiment is given,\n15\tlists available experiments.\n16\t\"\"\"\n17\t\n18\tfrom __future__ import annotations\n19\t\n20\timport json\n21\timport re\n22\timport sys\n23\timport urllib.request\n24\tfrom typing import Any, Callable, Literal\n25\t\n26\t# A single flattened metric entry: {\"group\": ..., \"air_name\": ..., \"air_id\": ..., \"metric\": ..., \"value\": ..., ...}\n27\tEntry = dict[str, str]\n28\t# Raw metrics JSON with \"counter\" and \"gauge\" arrays\n29\tMetricsJson = dict[str, Any]\n30\t# Computed metrics dict returned by extract_metrics\n31\tMetrics = dict[str, Any]\n32\t\n33\t\n34\t# ============================================================\n35\t# Computation — this is the code that needs to be audited.\n36\t# It must match the JS in index.html exactly.\n37\t# ============================================================\n38\t\n39\tdef load_metrics_dataframes(\n40\t    metrics_json: MetricsJson,\n41\t) -> tuple[list[Entry], list[Entry], list[Entry], list[Entry], list[Entry]]:\n42\t    \"\"\"Port of loadMetricsDataframes: flatten entries, split by group prefix.\"\"\"\n43\t    entries: list[Entry] = []\n44\t    for c in metrics_json[\"counter\"] + metrics_json[\"gauge\"]:\n45\t        obj = dict(c[\"labels\"])\n46\t        obj[\"metric\"] = c[\"metric\"]\n47\t        obj[\"value\"] = c[\"value\"]\n48\t        entries.append(obj)\n49\t\n50\t    app = [e for e in entries if e.get(\"group\", \"\").startswith(\"app_proof\")]\n51\t    if not app:\n52\t        app = [e for e in entries if e.get(\"group\", \"\").startswith(\"reth\")]\n53\t    leaf = [e for e in entries if e.get(\"group\", \"\").startswith(\"leaf\")]\n54\t    internal = [e for e in entries if e.get(\"group\", \"\").startswith(\"internal\")]\n55\t    compression = [e for e in entries if e.get(\"group\", \"\") == \"compression\"]\n56\t\n57\t    return entries, app, leaf, internal, compression\n58\t\n59\t\n60\tdef is_normal_instruction_air(name: str) -> bool:\n61\t    \"\"\"Port of isNormalInstructionAir.\"\"\"\n62\t    m = re.match(r\"^VmAirWrapper<[^,]+,\\s*([^>]+?)(?:<(\\d+)(?:,\\s*\\d+)*>)?\\s*>$\", name or \"\")\n63\t    if not m:\n64\t        return False\n65\t    if m.group(1) == \"FieldExpressionCoreAir\":\n66\t        return False\n67\t    if m.group(2) and int(m.group(2)) != 4:\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef sum_metric(entries: list[Entry], metric_name: str) -> float:\n73\t    \"\"\"Sum values for entries matching metric_name.\"\"\"\n74\t    return sum(float(e[\"value\"]) for e in entries if e[\"metric\"] == metric_name)\n75\t\n76\t\n77\tdef unique_metric(entries: list[Entry], metric_name: str) -> float:\n78\t    \"\"\"Get the value of a metric that must appear exactly once.\"\"\"\n79\t    matches = [e for e in entries if e[\"metric\"] == metric_name]\n80\t    assert len(matches) == 1, f\"Expected exactly 1 entry for '{metric_name}', found {len(matches)}\"\n81\t    return float(matches[0][\"value\"])\n82\t\n83\t\n84\tdef detect_version(metrics_json: MetricsJson) -> Literal[1, 2]:\n85\t    \"\"\"Returns 2 if any metric name contains 'logup_gkr' (V2-only), else 1.\"\"\"\n86\t    names = {e[\"metric\"] for e in metrics_json[\"counter\"] + metrics_json[\"gauge\"]}\n87\t    return 2 if any(\"logup_gkr\" in n for n in names) else 1\n88\t\n89\t\n90\tdef extract_metrics(run_name: str, metrics_json: MetricsJson) -> Metrics:\n91\t    \"\"\"Port of extractMetrics from index.html. Returns dict of all computed values.\"\"\"\n92\t    all_entries, app, leaf, internal, compression = load_metrics_dataframes(metrics_json)\n93\t    m: Metrics = {}\n94\t    m[\"name\"] = run_name\n95\t\n96\t    # --- Classify app AIRs ---\n97\t    powdr_air = [e for e in app if (e.get(\"air_name\") or \"\").startswith(\"PowdrAir\")]\n98\t    non_powdr = [e for e in app if not (e.get(\"air_name\") or \"\").startswith(\"PowdrAir\")]\n99\t    normal_air = [e for e in non_powdr if is_normal_instruction_air(e.get(\"air_name\", \"\"))]\n100\t    precompile_air = [e for e in non_powdr if not is_normal_instruction_air(e.get(\"air_name\", \"\"))]"}]},"parent_tool_use_id":null,"session_id":"00f14df6-1cef-48ea-af88-42c3b73a9be4","uuid":"99f8c1da-77a6-4b2a-9d5c-a59d180ea88b","timestamp":"2026-04-14T22:10:32.702Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/spec.py","content":"#!/usr/bin/env python3\n\"\"\"\nAudit script for OpenVM metrics viewer.\n\nRecomputes the experiment details table from a metrics JSON file,\nprinting all computed values so they can be verified against the web UI.\n\nUsage:\n    python3 audit_metrics.py <metrics_file_or_url> [experiment_name]\n\nThe source can be a local file path or an HTTP(S) URL.\nGitHub blob URLs are auto-converted to raw URLs.\n\nIf the input is a combined metrics file and no experiment is given,\nlists available experiments.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport re\nimport sys\nimport urllib.request\nfrom typing import Any, Callable, Literal\n\n# A single flattened metric entry: {\"group\": ..., \"air_name\": ..., \"air_id\": ..., \"metric\": ..., \"value\": ..., ...}\nEntry = dict[str, str]\n# Raw metrics JSON with \"counter\" and \"gauge\" arrays\nMetricsJson = dict[str, Any]\n# Computed metrics dict returned by extract_metrics\nMetrics = dict[str, Any]\n\n\n# ============================================================\n# Computation — this is the code that needs to be audited.\n# It must match the JS in index.html exactly.\n# ============================================================\n\ndef load_metrics_dataframes(\n    metrics_json: MetricsJson,\n) -> tuple[list[Entry], list[Entry], list[Entry], list[Entry], list[Entry]]:\n    \"\"\"Port of loadMetricsDataframes: flatten entries, split by group prefix.\"\"\"\n    entries: list[Entry] = []\n    for c in metrics_json[\"counter\"] + metrics_json[\"gauge\"]:\n        obj = dict(c[\"labels\"])\n        obj[\"metric\"] = c[\"metric\"]\n        obj[\"value\"] = c[\"value\"]\n        entries.append(obj)\n\n    app = [e for e in entries if e.get(\"group\", \"\").startswith(\"app_proof\")]\n    if not app:\n        app = [e for e in entries if e.get(\"group\", \"\").startswith(\"reth\")]\n    leaf = [e for e in entries if e.get(\"group\", \"\").startswith(\"leaf\")]\n    internal = [e for e in entries if e.get(\"group\", \"\").startswith(\"internal\")]\n    compression = [e for e in entries if e.get(\"group\", \"\") == \"compression\"]\n\n    return entries, app, leaf, internal, compression\n\n\ndef is_normal_instruction_air(name: str) -> bool:\n    \"\"\"Port of isNormalInstructionAir.\"\"\"\n    m = re.match(r\"^VmAirWrapper<[^,]+,\\s*([^>]+?)(?:<(\\d+)(?:,\\s*\\d+)*>)?\\s*>$\", name or \"\")\n    if not m:\n        return False\n    if m.group(1) == \"FieldExpressionCoreAir\":\n        return False\n    if m.group(2) and int(m.group(2)) != 4:\n        return False\n    return True\n\n\ndef sum_metric(entries: list[Entry], metric_name: str) -> float:\n    \"\"\"Sum values for entries matching metric_name.\"\"\"\n    return sum(float(e[\"value\"]) for e in entries if e[\"metric\"] == metric_name)\n\n\ndef unique_metric(entries: list[Entry], metric_name: str) -> float:\n    \"\"\"Get the value of a metric that must appear exactly once.\"\"\"\n    matches = [e for e in entries if e[\"metric\"] == metric_name]\n    assert len(matches) == 1, f\"Expected exactly 1 entry for '{metric_name}', found {len(matches)}\"\n    return float(matches[0][\"value\"])\n\n\ndef detect_version(metrics_json: MetricsJson) -> Literal[1, 2]:\n    \"\"\"Returns 2 if any metric name contains 'logup_gkr' (V2-only), else 1.\"\"\"\n    names = {e[\"metric\"] for e in metrics_json[\"counter\"] + metrics_json[\"gauge\"]}\n    return 2 if any(\"logup_gkr\" in n for n in names) else 1\n\n\ndef extract_metrics(run_name: str, metrics_json: MetricsJson) -> Metrics:\n    \"\"\"Port of extractMetrics from index.html. Returns dict of all computed values.\"\"\"\n    all_entries, app, leaf, internal, compression = load_metrics_dataframes(metrics_json)\n    m: Metrics = {}\n    m[\"name\"] = run_name\n\n    # --- Classify app AIRs ---\n    powdr_air = [e for e in app if (e.get(\"air_name\") or \"\").startswith(\"PowdrAir\")]\n    non_powdr = [e for e in app if not (e.get(\"air_name\") or \"\").startswith(\"PowdrAir\")]\n    normal_air = [e for e in non_powdr if is_normal_instruction_air(e.get(\"air_name\", \"\"))]\n    precompile_air = [e for e in non_powdr if not is_normal_instruction_air(e.get(\"air_name\", \"\"))]","numLines":100,"startLine":1,"totalLines":387}}}
