{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YFVELJxcAt3rbmUCdH2UCF","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    mem::size_of,\n15\t    sync::Arc,\n16\t};\n17\t\n18\tuse itertools::{izip, Itertools};\n19\tuse openvm_cuda_common::{\n20\t    copy::{MemCopyD2H, MemCopyH2D},\n21\t    d_buffer::DeviceBuffer,\n22\t    error::{CudaError, MemCopyError},\n23\t    memory_manager::MemTracker,\n24\t    stream::current_stream_sync,\n25\t};\n26\tuse openvm_stark_backend::{\n27\t    air_builders::symbolic::SymbolicConstraints,\n28\t    calculate_n_logup,\n29\t    dft::Radix2BowersSerial,\n30\t    p3_matrix::dense::RowMajorMatrix,\n31\t    poly_common::{\n32\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n33\t        UnivariatePoly,\n34\t    },\n35\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n36\t    prover::{\n37\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n38\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n39\t        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n40\t    },\n41\t};\n42\tuse p3_dft::TwoAdicSubgroupDft;\n43\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n44\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n45\tuse rustc_hash::FxHashMap;\n46\tuse tracing::{debug, info, info_span, instrument};\n47\t\n48\tuse crate::{\n49\t    base::DeviceMatrix,\n50\t    cuda::{\n51\t        logup_zerocheck::{\n52\t            batched_interpolate_columns_matrix_gpu, fold_selectors_round0, InterpMatrixInfo,\n53\t            InterpTraceDescM, MainMatrixPtrs,\n54\t        },\n55\t        sumcheck::batch_fold_mle,\n56\t    },\n57\t    data_transporter::transport_matrix_d2h_col_major,\n58\t    error::LogupZerocheckError,\n59\t    gpu_backend::GenericGpuBackend,\n60\t    hash_scheme::GpuHashScheme,\n61\t    cuda::logup_zerocheck::{\n62\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n63\t        _round0_extract_logup_polys, _round0_extract_zerocheck_poly,\n64\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n65\t    },\n66\t    logup_zerocheck::{\n67\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n68\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n69\t    },\n70\t    poly::EqEvalLayers,\n71\t    prelude::{EF, F},\n72\t    sponge::GpuFiatShamirTranscript,\n73\t    utils::compute_barycentric_inv_lagrange_denoms,\n74\t};\n75\t\n76\tpub(crate) mod batch_mle;\n77\tpub(crate) mod batch_mle_monomial;\n78\tmod errors;\n79\tpub(crate) mod fold_ple;\n80\t/// Fraction sumcheck via GKR\n81\tmod fractional;\n82\t/// Logup interaction evaluations for GKR input\n83\tmod gkr_input;\n84\tmod mle_round;\n85\tmod round0;\n86\tpub(crate) mod rules;\n87\t\n88\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n89\tuse batch_mle_monomial::{\n90\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n91\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n92\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n93\t};\n94\tpub use errors::*;\n95\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n96\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n97\tuse round0::evaluate_round0_constraints_gpu;\n98\t\n99\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n100\t/// More threads = more concurrent kernels but more peak GPU memory and more\n101\t/// MemoryManager mutex contention. 8 provides good SM utilization on the RTX 4090.\n102\tconst NUM_ROUND0_STREAMS: usize = 8;\n103\t\n104\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n105\t/// instead of the monomial kernel for high num_y traces.\n106\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n107\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n108\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n109\t\n110\t#[inline]\n111\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n112\t    if need_rot {\n113\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n114\t        (mat_width / 2) as u32\n115\t    } else {\n116\t        mat_width as u32\n117\t    }\n118\t}\n119\t\n120\t/// Pre-computed transformation matrices for GPU-side polynomial extraction in Round 0.\n121\t/// Captures the entire pipeline: transpose + iDFT + unshift + Lagrange interpolation\n122\t/// + coefficient adjustment (for zerocheck only).\n123\tstruct Round0ExtractTables {\n124\t    /// Zerocheck: maps eval values to final poly coefficients (with adjustment).\n125\t    /// Row-major [output_size × input_size].\n126\t    zc_transform: DeviceBuffer<EF>,\n127\t    zc_input_size: u32,\n128\t    zc_output_size: u32,\n129\t    /// Logup: maps eval values to poly coefficients (no adjustment).\n130\t    /// Row-major [size × size].\n131\t    logup_transform: DeviceBuffer<EF>,\n132\t    logup_size: u32,\n133\t}\n134\t\n135\t/// Compute transform matrices for a given constraint degree `d` and `l_skip`.\n136\t/// These are pre-computed on the CPU by running the polynomial extraction pipeline\n137\t/// on unit vectors, then uploaded to the GPU.\n138\tfn compute_round0_extract_tables(d: usize, l_skip: usize) -> Result<Round0ExtractTables, MemCopyError> {\n139\t    let skip_domain = 1usize << l_skip;\n140\t    let omega_root = F::two_adic_generator(log2_ceil_usize(d << l_skip));\n141\t\n142\t    // Zerocheck transform: input is (d-1)*skip_domain evals, output is sp_0_deg+1 coefficients\n143\t    let (zc_host, zc_in, zc_out) = {\n144\t        let w = d.saturating_sub(1); // num_cosets_zc\n145\t        if w == 0 {\n146\t            (vec![], 0u32, 0u32)\n147\t        } else {\n148\t            let input_size = w * skip_domain;\n149\t            let output_size = sumcheck_round0_deg(l_skip, d) + 1;\n150\t            let mut transform = vec![EF::ZERO; output_size * input_size];"}]},"parent_tool_use_id":null,"session_id":"00f14df6-1cef-48ea-af88-42c3b73a9be4","uuid":"dbd6c1ad-65df-4f00-aacd-76177865b04d","timestamp":"2026-04-14T21:54:50.878Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-backend/src/logup_zerocheck/mod.rs","content":"//! ## Async frees and peak memory\n//!\n//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n//! new allocations happen before the current stream is synchronized, physical peak memory can\n//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n//! by calling `to_host()` on outputs or `current_stream_sync()`).\n\nuse std::{\n    cmp::max,\n    collections::hash_map::Entry,\n    iter::{self, zip},\n    mem::size_of,\n    sync::Arc,\n};\n\nuse itertools::{izip, Itertools};\nuse openvm_cuda_common::{\n    copy::{MemCopyD2H, MemCopyH2D},\n    d_buffer::DeviceBuffer,\n    error::{CudaError, MemCopyError},\n    memory_manager::MemTracker,\n    stream::current_stream_sync,\n};\nuse openvm_stark_backend::{\n    air_builders::symbolic::SymbolicConstraints,\n    calculate_n_logup,\n    dft::Radix2BowersSerial,\n    p3_matrix::dense::RowMajorMatrix,\n    poly_common::{\n        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n        UnivariatePoly,\n    },\n    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n    prover::{\n        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n    },\n};\nuse p3_dft::TwoAdicSubgroupDft;\nuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\nuse p3_util::{log2_ceil_usize, log2_strict_usize};\nuse rustc_hash::FxHashMap;\nuse tracing::{debug, info, info_span, instrument};\n\nuse crate::{\n    base::DeviceMatrix,\n    cuda::{\n        logup_zerocheck::{\n            batched_interpolate_columns_matrix_gpu, fold_selectors_round0, InterpMatrixInfo,\n            InterpTraceDescM, MainMatrixPtrs,\n        },\n        sumcheck::batch_fold_mle,\n    },\n    data_transporter::transport_matrix_d2h_col_major,\n    error::LogupZerocheckError,\n    gpu_backend::GenericGpuBackend,\n    hash_scheme::GpuHashScheme,\n    cuda::logup_zerocheck::{\n        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n        _round0_extract_logup_polys, _round0_extract_zerocheck_poly,\n        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n    },\n    logup_zerocheck::{\n        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n    },\n    poly::EqEvalLayers,\n    prelude::{EF, F},\n    sponge::GpuFiatShamirTranscript,\n    utils::compute_barycentric_inv_lagrange_denoms,\n};\n\npub(crate) mod batch_mle;\npub(crate) mod batch_mle_monomial;\nmod errors;\npub(crate) mod fold_ple;\n/// Fraction sumcheck via GKR\nmod fractional;\n/// Logup interaction evaluations for GKR input\nmod gkr_input;\nmod mle_round;\nmod round0;\npub(crate) mod rules;\n\nuse batch_mle::{evaluate_logup_batched, TraceCtx};\nuse batch_mle_monomial::{\n    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n};\npub use errors::*;\npub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\nuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\nuse round0::evaluate_round0_constraints_gpu;\n\n/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n/// More threads = more concurrent kernels but more peak GPU memory and more\n/// MemoryManager mutex contention. 8 provides good SM utilization on the RTX 4090.\nconst NUM_ROUND0_STREAMS: usize = 8;\n\n/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n/// instead of the monomial kernel for high num_y traces.\n/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\nconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n\n#[inline]\npub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n    if need_rot {\n        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n        (mat_width / 2) as u32\n    } else {\n        mat_width as u32\n    }\n}\n\n/// Pre-computed transformation matrices for GPU-side polynomial extraction in Round 0.\n/// Captures the entire pipeline: transpose + iDFT + unshift + Lagrange interpolation\n/// + coefficient adjustment (for zerocheck only).\nstruct Round0ExtractTables {\n    /// Zerocheck: maps eval values to final poly coefficients (with adjustment).\n    /// Row-major [output_size × input_size].\n    zc_transform: DeviceBuffer<EF>,\n    zc_input_size: u32,\n    zc_output_size: u32,\n    /// Logup: maps eval values to poly coefficients (no adjustment).\n    /// Row-major [size × size].\n    logup_transform: DeviceBuffer<EF>,\n    logup_size: u32,\n}\n\n/// Compute transform matrices for a given constraint degree `d` and `l_skip`.\n/// These are pre-computed on the CPU by running the polynomial extraction pipeline\n/// on unit vectors, then uploaded to the GPU.\nfn compute_round0_extract_tables(d: usize, l_skip: usize) -> Result<Round0ExtractTables, MemCopyError> {\n    let skip_domain = 1usize << l_skip;\n    let omega_root = F::two_adic_generator(log2_ceil_usize(d << l_skip));\n\n    // Zerocheck transform: input is (d-1)*skip_domain evals, output is sp_0_deg+1 coefficients\n    let (zc_host, zc_in, zc_out) = {\n        let w = d.saturating_sub(1); // num_cosets_zc\n        if w == 0 {\n            (vec![], 0u32, 0u32)\n        } else {\n            let input_size = w * skip_domain;\n            let output_size = sumcheck_round0_deg(l_skip, d) + 1;\n            let mut transform = vec![EF::ZERO; output_size * input_size];","numLines":150,"startLine":1,"totalLines":2310}}}
