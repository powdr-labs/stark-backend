< log_rows_per_query; ++layer) {\n54\t        uint32_t mask = (1 << (layer + 1)) - 1;\n55\t        auto shared_offset = ((leaf_idx >> (layer + 1)) << layer) * blockDim.x + threadIdx.x;\n56\t        if ((leaf_idx & mask) == (1 << layer)) {\n57\t#pragma unroll\n58\t            for (int i = 0; i < CELLS_OUT; i++) {\n59\t                shared[i * shared_stride + shared_offset] = cells[i];\n60\t            }\n61\t        }\n62\t        __syncthreads();\n63\t        if ((leaf_idx & mask) == 0) {\n64\t#pragma unroll\n65\t            for (int i = 0; i < CELLS_OUT; i++) {\n66\t                cells[CELLS_OUT + i] = shared[i * shared_stride + shared_offset];\n67\t            }\n68\t            poseidon2::poseidon2_mix(cells);\n69\t        }\n70\t        __syncthreads(); // Ensure all reads complete before next iteration's writes\n71\t    }\n72\t\n73\t    if (leaf_idx == 0) {\n74\t#pragma unroll\n75\t        for (int i = 0; i < CELLS_OUT; i++) {\n76\t            out[stride_idx].cells[i] = cells[i];\n77\t        }\n78\t    }\n79\t}\n80\t\n81\t__global__ void poseidon2_compressing_row_hashes_ext_kernel(\n82\t    digest_t *out,\n83\t    const FpExt *matrix,\n84\t    size_t width,\n85\t    size_t height,\n86\t    size_t query_stride,\n87\t    size_t log_rows_per_query\n88\t) {\n89\t    extern __shared__ char smem[]; // Fp[CELLS_OUT][blockDim.y / 2 * blockDim.x]\n90\t    Fp *shared = reinterpret_cast<Fp *>(smem);\n91\t    const uint32_t shared_stride = blockDim.x * (blockDim.y >> 1);\n92\t\n93\t    const uint32_t stride_idx = blockDim.x * blockIdx.x + threadIdx.x;\n94\t    uint32_t leaf_idx = threadIdx.y;\n95\t    const uint32_t row = leaf_idx * query_stride + stride_idx;\n96\t\n97\t    size_t used = 0;\n98\t    Fp cells[CELLS];\n99\t#pragma unroll\n100\t    for (int i = 0; i < CELLS; i++) {\n101\t        cells[i] = Fp(0);\n102\t    }\n103\t\n104\t    if (stride_idx < query_stride) {\n105\t        // compute row hash\n106\t        for (int col = 0; col < width; col++) {\n107\t#pragma unroll\n108\t            // Extension field degree is 4\n109\t            for (int i = 0; i < 4; i++) {\n110\t                cells[used++] = matrix[col * height + row].elems[i];\n111\t            }\n112\t            if (used == CELLS_RATE) {\n113\t                poseidon2::poseidon2_mix(cells);\n114\t                used = 0;\n115\t            }\n116\t        }\n117\t        if (used != 0) {\n118\t            poseidon2::poseidon2_mix(cells);\n119\t        }\n120\t    }\n121\t\n122\t    // This part is same as for poseidon2_compressing_row_hashes_kernel\n123\t    for (int layer = 0; layer < log_rows_per_query; ++layer) {\n124\t        uint32_t mask = (1 << (layer + 1)) - 1;\n125\t        auto shared_offset = ((leaf_idx >> (layer + 1)) << layer) * blockDim.x + threadIdx.x;\n126\t        if ((leaf_idx & mask) == (1 << layer)) {\n127\t#pragma unroll\n128\t            for (int i = 0; i < CELLS_OUT; i++) {\n129\t                shared[i * shared_stride + shared_offset] = cells[i];\n130\t            }\n131\t        }\n132\t        __syncthreads();\n133\t        if ((leaf_idx & mask) == 0) {\n134\t#pragma unroll\n135\t            for (int i = 0; i < CELLS_OUT; i++) {\n136\t                cells[CELLS_OUT + i] = shared[i * shared_stride + shared_offset];\n137\t            }\n138\t            poseidon2::poseidon2_mix(cells);\n139\t        }\n140\t        __syncthreads(); // Ensure all reads complete before next iteration's writes\n141\t    }\n142\t\n143\t    if (leaf_idx == 0) {\n144\t#pragma unroll\n145\t        for (int i = 0; i < CELLS_OUT; i++) {\n146\t            out[stride_idx].cells[i] = cells[i];\n147\t        }\n148\t    }\n149\t}\n150\tstatic_assert(CELLS_RATE % 4 == 0, \"CELLS_RATE must be multiple of FpExt degree (4)\");\n151\t\n152\t// Striding keeps memory coalesced with two cache lines within a warp\n153\t__global__ void poseidon2_strided_compress_layer_kernel(\n154\t    digest_t *output,\n155\t    const digest_t *prev_layer,\n156\t    size_t output_size,\n157\t    size_t stride\n158\t) {\n159\t    uint32_t gid = blockDim.x * blockIdx.x + threadIdx.x;\n160\t    if (gid >= output_size) {\n161\t        return;\n162\t    }\n163\t    uint32_t x = gid / stride;\n164\t    uint32_t y = gid % stride;\n165\t\n166\t    Fp cells[CELLS];\n167\t    for (int i = 0; i < CELLS_OUT; i++) {\n168\t        cells[i] = prev_layer[2 * x * stride + y].cells[i];\n169\t        cells[i + CELLS_OUT] = prev_layer[(2 * x + 1) * stride + y].cells[i];\n170\t    }\n171\t\n172\t    poseidon2::poseidon2_mix(cells);\n173\t\n174\t    for (int i = 0; i < CELLS_OUT; i++) {\n175\t        output[gid].cells[i] = cells[i];\n176\t    }\n177\t}\n178\t\n179\t/*\n180\tquery[0][0,...layers-1]\n181\tquery[1][0,...layers-1]\n182\t...\n183\tquery[k][0,...layers-1]\n184\t*/\n185\t__global__ void query_digest_layers(\n186\t    Fp *d_digest_matrix,          // Fp*, also Digest: CELLS_OUT=8 Fp elements\n187\t    const uint64_t *d_layers_ptr, // array of Digest layers\n188\t    uint64_t *d_indices,          // uint64_t*, indices to query, size = num_query * num_layer\n189\t    uint64_t num_query,           // e.g. 100\n190\t    uint64_t num_layer\n191\t) // e.g. 23\n192\t{\n193\t    const uint32_t ELEM_PER_DIGEST = CELLS_OUT; // 8 * Fp\n194\t    uint64_t gidx = blockIdx.x * blockDim.x + threadIdx.x;\n195\t    uint64_t layer_idx = gidx / ELEM_PER_DIGEST;\n196\t    uint64_t elem_offset = gidx % ELEM_PER_DIGEST; // thread group: [0,..7]\n197\t    uint64_t query_idx = blockIdx.y;               // [0, num_query -1]\n198\t    if (layer_idx >= num_layer) {                  // [0, layers - 1]\n199\t        return;\n200\t    }\n201\t\n202\t    Fp *d_layer = (Fp *)d_layers_ptr[layer_idx];\n203\t    uint64_t digest_offset = d_indices[query_idx * num_layer + layer_idx];\n204\t    Fp digest_elem = d_layer[digest_offset * ELEM_PER_DIGEST + elem_offset];\n205\t    // now each thread get 1/ELEM_PER_DIGEST of the digest\n206\t\n207\t    uint64_t output_query_offset = query_idx * num_layer * ELEM_PER_DIGEST;\n208\t    uint64_t output_layer_offset = layer_idx * ELEM_PER_DIGEST + elem_offset;\n209\t    d_digest_matrix[output_query_offset + output_layer_offset] = digest_elem;\n210\t}\n211\t\n212\t// LAUNCHERS\n213\t\n214\textern \"C\" int _poseidon2_compressing_row_hashes(\n215\t    digest_t *out,\n216\t    const Fp *matrix,\n217\t    size_t width,\n218\t    size_t query_stride,\n219\t    size_t log_rows_per_query\n220\t) {\n221\t    auto [grid, block] = kernel_launch_params(query_stride, 512 >> log_rows_per_query);\n222\t    block.y = 1 << log_rows_per_query;\n223\t    size_t shared_stride = block.x * div_ceil(block.y, 2);\n224\t    size_t shmem_bytes = CELLS_OUT * shared_stride * sizeof(Fp);\n225\t    auto height = query_stride << log_rows_per_query;\n226\t\n227\t    poseidon2_compressing_row_hashes_kernel<<<grid, block, shmem_bytes>>>(\n228\t        out, matrix, width, height, query_stride, log_rows_per_query\n229\t    );\n230\t    return CHECK_KERNEL();\n231\t}\n232\t\n233\textern \"C\" int _poseidon2_compressing_row_hashes_ext(\n234\t    digest_t *out,\n235\t    const FpExt *matrix,\n236\t    size_t width,\n237\t    size_t query_stride,\n238\t    size_t log_rows_per_query\n239\t) {\n240\t    auto [grid, block] = kernel_launch_params(query_stride, 512 >> log_rows_per_query);\n241\t    block.y = 1 << log_rows_per_query;\n242\t    size_t shared_stride = block.x * div_ceil(block.y, 2);\n243\t    size_t shmem_bytes = CELLS_OUT * shared_stride * sizeof(Fp);\n244\t    auto height = query_stride << log_rows_per_query;\n245\t\n246\t    poseidon2_compressing_row_hashes_ext_kernel<<<grid, block, shmem_bytes>>>(\n247\t        out, matrix, width, height, query_stride, log_rows_per_query\n248\t    );\n249\t    return CHECK_KERNEL();\n250\t}\n251\t\n252\textern \"C\" int _poseidon2_strided_compress_layer(\n253\t    digest_t *output,\n254\t    const digest_t *prev_layer,\n255\t    size_t output_size,\n256\t    size_t stride\n257\t) {\n258\t    auto [grid, block] = kernel_launch_params(output_size);\n259\t    poseidon2_strided_compress_layer_kernel<<<grid, block>>>(\n260\t        output, prev_layer, output_size, stride\n261\t    );\n262\t    return CHECK_KERNEL();\n263\t}\n264\t\n265\t// NOTE[jpw]: adding this function in CUDA to ensure the compiler can optimize stride = 1 (not sure this would happen across FFI boundary).\n266\t// For 32 byte digest, adjacent memory read still keeps memory coalesced in a warp\n267\textern \"C\" int _poseidon2_adjacent_compress_layer(\n268\t    digest_t *output,\n269\t    const digest_t *prev_layer,\n270\t    size_t output_size\n271\t) {\n272\t    auto [grid, block] = kernel_launch_params(output_size);\n273\t    poseidon2_strided_compress_layer_kernel<<<grid, block>>>(output, prev_layer, output_size, 1);\n274\t    return CHECK_KERNEL();\n275\t}\n276\t\n277\textern \"C\" int _query_digest_layers(\n278\t    Fp *d_digest_matrix,\n279\t    const uint64_t *d_layers_ptr,\n280\t    uint64_t *d_indices,\n281\t    uint64_t num_query,\n282\t    uint64_t num_layer\n283\t) {\n284\t    const size_t QUERY_DIGEST_THREADS = 128;\n285\t    const size_t DIGEST_WIDTH = 8;\n286\t\n287\t    auto block = QUERY_DIGEST_THREADS;\n288\t    dim3 grid = dim3(div_ceil(num_layer * DIGEST_WIDTH, block), num_query);\n289\t    query_digest_layers<<<grid, block>>>(\n290\t        d_digest_matrix, d_layers_ptr, d_indices, num_query, num_layer\n291\t    );\n292\t    return CHECK_KERNEL();\n293\t}\n294\t"}]},"parent_tool_use_id":"toolu_019AiKF7fHCyAoKadia4XzX4","session_id":"00f14df6-1cef-48ea-af88-42c3b73a9be4","uuid":"83619f2b-0507-4a98-ad7a-6eee8d0b1eaa","timestamp":"2026-04-14T21:52:04.816Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CCM89AYShhYs2gcxFs9top","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    mem::size_of,\n15\t    sync::Arc,\n16\t};\n17\t\n18\tuse itertools::{izip, Itertools};\n19\tuse openvm_cuda_common::{\n20\t    copy::{MemCopyD2H, MemCopyH2D},\n21\t    d_buffer::DeviceBuffer,\n22\t    error::{CudaError, MemCopyError},\n23\t    memory_manager::MemTracker,\n24\t    stream::current_stream_sync,\n25\t};\n26\tuse openvm_stark_backend::{\n27\t    air_builders::symbolic::SymbolicConstraints,\n28\t    calculate_n_logup,\n29\t    dft::Radix2BowersSerial,\n30\t    p3_matrix::dense::RowMajorMatrix,\n31\t    poly_common::{\n32\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n33\t        UnivariatePoly,\n34\t    },\n35\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n36\t    prover::{\n37\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n38\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n39\t        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n40\t    },\n41\t};\n42\tuse p3_dft::TwoAdicSubgroupDft;\n43\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n44\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n45\tuse rustc_hash::FxHashMap;\n46\tuse tracing::{debug, info, info_span, instrument};\n47\t\n48\tuse crate::{\n49\t    base::DeviceMatrix,\n50\t    cuda::{\n51\t        logup_zerocheck::{\n52\t            batched_interpolate_columns_matrix_gpu, fold_selectors_round0, InterpMatrixInfo,\n53\t            InterpTraceDescM, MainMatrixPtrs,\n54\t        },\n55\t        sumcheck::batch_fold_mle,\n56\t    },\n57\t    data_transporter::transport_matrix_d2h_col_major,\n58\t    error::LogupZerocheckError,\n59\t    gpu_backend::GenericGpuBackend,\n60\t    hash_scheme::GpuHashScheme,\n61\t    cuda::logup_zerocheck::{\n62\t        _logup_r0_intermediates_buffer_size, _logup_r0_temp_sums_buffer_size,\n63\t        _round0_extract_logup_polys, _round0_extract_zerocheck_poly,\n64\t        _zerocheck_r0_intermediates_buffer_size, _zerocheck_r0_temp_sums_buffer_size,\n65\t    },\n66\t    logup_zerocheck::{\n67\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n68\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n69\t    },\n70\t    poly::EqEvalLayers,\n71\t    prelude::{EF, F},\n72\t    sponge::GpuFiatShamirTranscript,\n73\t    utils::compute_barycentric_inv_lagrange_denoms,\n74\t};\n75\t\n76\tpub(crate) mod batch_mle;\n77\tpub(crate) mod batch_mle_monomial;\n78\tmod errors;\n79\tpub(crate) mod fold_ple;\n80\t/// Fraction sumcheck via GKR\n81\tmod fractional;\n82\t/// Logup interaction evaluations for GKR input\n83\tmod gkr_input;\n84\tmod mle_round;\n85\tmod round0;\n86\tpub(crate) mod rules;\n87\t\n88\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n89\tuse batch_mle_monomial::{\n90\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n91\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n92\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n93\t};\n94\tpub use errors::*;\n95\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n96\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n97\tuse round0::evaluate_round0_constraints_gpu;\n98\t\n99\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n100\t/// More threads = more concurrent kernels but more peak GPU memory and more\n101\t/// MemoryManager mutex contention. 8 provides good SM utilization on the RTX 4090.\n102\tconst NUM_ROUND0_STREAMS: usize = 8;\n103\t\n104\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n105\t/// instead of the monomial kernel for high num_y traces.\n106\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n107\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n108\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n109\t\n110\t#[inline]\n111\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n112\t    if need_rot {\n113\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n114\t        (mat_width / 2) as u32\n115\t    } else {\n116\t        mat_width as u32\n117\t    }\n118\t}\n119\t\n120\t/// Pre-computed transformation matrices for GPU-side polynomial extraction in Round 0.\n121\t/// Captures the entire pipeline: transpose + iDFT + unshift + Lagrange interpolation\n122\t/// + coefficient adjustment (for zerocheck only).\n123\tstruct Round0ExtractTables {\n124\t    /// Zerocheck: maps eval values to final poly coefficients (with adjustment).\n125\t    /// Row-major [output_size × input_size].\n126\t    zc_transform: DeviceBuffer<EF>,\n127\t    zc_input_size: u32,\n128\t    zc_output_size: u32,\n129\t    /// Logup: maps eval values to poly coefficients (no adjustment).\n130\t    /// Row-major [size × size].\n131\t    logup_transform: DeviceBuffer<EF>,\n132\t    logup_size: u32,\n133\t}\n134\t\n135\t/// Compute transform matrices for a given constraint degree `d` and `l_skip`.\n136\t/// These are pre-computed on the CPU by running the polynomial extraction pipeline\n137\t/// on unit vectors, then uploaded to the GPU.\n138\tfn compute_round0_extract_tables(d: usize, l_skip: usize) -> Result<Round0ExtractTables, MemCopyError> {\n139\t    let skip_domain = 1usize << l_skip;\n140\t    let omega_root = F::two_adic_generator(log2_ceil_usize(d << l_skip));\n141\t\n142\t    // Zerocheck transform: input is (d-1)*skip_domain evals, output is sp_0_deg+1 coefficients\n143\t    let (zc_host, zc_in, zc_out) = {\n144\t        let w = d.saturating_sub(1); // num_cosets_zc\n145\t        if w == 0 {\n146\t            (vec![], 0u32, 0u32)\n147\t        } else {\n148\t            let input_size = w * skip_domain;\n149\t            let output_size = sumcheck_round0_deg(l_skip, d) + 1;\n150\t            let mut transform = vec![EF::ZERO; output_size * input_size];\n151\t            for j in 0..input_size {\n152\t                let src_c = j / skip_domain;\n153\t                let src_i = j % skip_domain;\n154\t                let mut values = EF::zero_vec(input_size);\n155\t                values[src_i * w + src_c] = EF::ONE; // transpose baked in\n156\t                let q = UnivariatePoly::<EF>::from_geometric_cosets_evals_idft(\n157\t                    RowMajorMatrix::new(values, w),\n158\t                    omega_root,\n159\t                    omega_root,\n160\t                );\n161\t                for i in 0..output_size {\n162\t                    let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n163\t                    if i >= skip_domain {\n164\t                        c += q.coeffs()[i - skip_domain];\n165\t                    }\n166\t                    transform[i * input_size + j] = c;\n167\t                }\n168\t            }\n169\t            (transform, input_size as u32, output_size as u32)\n170\t        }\n171\t    };\n172\t\n173\t    // Logup transform: input and output are both d*skip_domain\n174\t    let (logup_host, logup_sz) = {\n175\t        let w = d; // num_cosets_logup\n176\t        let size = w * skip_domain;\n177\t        let mut transform = vec![EF::ZERO; size * size];\n178\t        for j in 0..size {\n179\t            let src_c = j / skip_domain;\n180\t            let src_i = j % skip_domain;\n181\t            let mut values = EF::zero_vec(size);\n182\t            values[src_i * w + src_c] = EF::ONE;\n183\t            let poly = UnivariatePoly::<EF>::from_geometric_cosets_evals_idft(\n184\t                RowMajorMatrix::new(values, w),\n185\t                omega_root,\n186\t                F::ONE,\n187\t            );\n188\t            for i in 0..size {\n189\t                transform[i * size + j] = *poly.coeffs().get(i).unwrap_or(&EF::ZERO);\n190\t            }\n191\t        }\n192\t        (transform, size as u32)\n193\t    };\n194\t\n195\t    let d_zc = if zc_host.is_empty() {\n196\t        DeviceBuffer::new()\n197\t    } else {\n198\t        zc_host.to_device()?\n199\t    };\n200\t    let d_logup = logup_host.to_device()?;\n201\t\n202\t    Ok(Round0ExtractTables {\n203\t        zc_transform: d_zc,\n204\t        zc_input_size: zc_in,\n205\t        zc_output_size: zc_out,\n206\t        logup_transform: d_logup,\n207\t        logup_size: logup_sz,\n208\t    })\n209\t}\n210\t\n211\t/// All read-only references needed to process one AIR in Round 0.\n212\tstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n213\t    trace_idx: usize,\n214\t    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n215\t    n: isize,\n216\t    selectors_cube: &'a DeviceMatrix<F>,\n217\t    public_values: &'a DeviceBuffer<F>,\n218\t    eq_3bs: &'a [EF],\n219\t    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n220\t    common_main: &'a DeviceMatrix<F>,\n221\t    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n222\t    d_lambda_pows: &'a DeviceBuffer<EF>,\n223\t    beta_pows: &'a [EF],\n224\t    l_skip: usize,\n225\t    constraint_degree: usize,\n226\t    xi: &'a [EF],\n227\t    max_temp_bytes: usize,\n228\t    /// Pre-computed zerocheck intermediates buffer capacity needed\n229\t    zc_intermed_cap: usize,\n230\t    /// Pre-computed zerocheck temp sums buffer capacity needed\n231\t    zc_temp_sums_cap: usize,\n232\t    /// Pre-computed logup intermediates buffer capacity needed\n233\t    logup_intermed_cap: usize,\n234\t    /// Pre-computed logup temp sums buffer capacity needed\n235\t    logup_temp_sums_cap: usize,\n236\t    /// Offset into the device batch array for this AIR's zerocheck poly\n237\t    zc_batch_offset: usize,\n238\t    /// Offset for logup numerator poly\n239\t    numer_batch_offset: usize,\n240\t    /// Offset for logup denominator poly\n241\t    denom_batch_offset: usize,\n242\t}\n243\t\n244\tfn process_air_round0<HS: GpuHashScheme>(\n245\t    w: &Round0AirWorkItem<HS>,\n246\t    bufs: &mut round0::Round0ThreadBuffers,\n247\t    d_batch_ptr: *mut EF,\n248\t    extract_tables: &FxHashMap<usize, Round0ExtractTables>,\n249\t) -> Result<(), LogupZerocheckError> {\n250\t    let single_pk = w.single_pk;\n251\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n252\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n253\t    assert!(\n254\t        local_constraint_deg <= w.constraint_degree,\n255\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n256\t        w.constraint_degree\n257\t    );\n258\t\n259\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n260\t    let omega_root = F::two_adic_generator(log_large_domain);\n261\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n262\t\n263\t    let height = w.common_main.height();\n264\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n265\t    for committed in w.cached_mains {\n266\t        main_parts.push(committed