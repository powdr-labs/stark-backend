{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FQzqGbjscrQLGP26vgUtNm","type":"tool_result","content":"491\tpub fn fractional_sumcheck_gpu<SC, TS>(\n492\t    transcript: &mut TS,\n493\t    leaves: DeviceBuffer<Frac<EF>>,\n494\t    alpha: EF,\n495\t    assert_zero: bool,\n496\t    mem: &mut MemTracker,\n497\t) -> Result<(FracSumcheckProof<SC>, Vec<EF>), FractionalSumcheckError>\n498\twhere\n499\t    SC: StarkProtocolConfig<EF = EF>,\n500\t    TS: FiatShamirTranscript<SC>,\n501\t{\n502\t    let mut layer = leaves;\n503\t    if layer.is_empty() {\n504\t        return Ok((\n505\t            FracSumcheckProof {\n506\t                fractional_sum: (EF::ZERO, EF::ONE),\n507\t                claims_per_layer: vec![],\n508\t                sumcheck_polys: vec![],\n509\t            },\n510\t            vec![],\n511\t        ));\n512\t    };\n513\t    let total_leaves = layer.len();\n514\t    // total_rounds = l_skip + n_logup\n515\t    let total_rounds = log2_strict_usize(total_leaves);\n516\t    assert!(total_rounds > 0, \"n_logup > 0 when there are interactions\");\n517\t    // Build segment tree.\n518\t    // - We only maintain the current layer\n519\t    // - Input layer uses separate F and EF buffers to save memory\n520\t    // - First tree layer converts (F, EF) to FracExt (EF, EF)\n521\t\n522\t    // We store it in bit-reversal order for coalesced memory accesses.\n523\t    // For large N (> 1024), fuse bitrev + tree layers 0 and 1 into a single kernel pass,\n524\t    // eliminating ~1.5N global memory reads. For small N, fall back to separate operations.\n525\t    let start_layer_i = if total_leaves > 1024 {\n526\t        unsafe {\n527\t            // SAFETY: Frac<EF> has exact same memory layout and alignment as (EF, EF).\n528\t            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n529\t            bit_rev_frac_ext_build_k2(buf, total_rounds as u32, alpha)\n530\t                .map_err(FractionalSumcheckError::BitReversal)?;\n531\t        }\n532\t        2 // layers 0+1 already done\n533\t    } else {\n534\t        // Fallback: separate bitrev + layer 0.\n535\t        unsafe {\n536\t            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n537\t            bit_rev_frac_ext(\n538\t                buf,\n539\t                buf,\n540\t                total_rounds as u32,\n541\t                total_leaves.try_into().unwrap(),\n542\t                1,\n543\t            )\n544\t            .map_err(FractionalSumcheckError::BitReversal)?;\n545\t            frac_build_tree_layer(&mut layer, total_leaves, false, alpha, true)\n546\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n547\t            use crate::cuda::logup_zerocheck::frac_add_alpha;\n548\t            let half = total_leaves / 2;\n549\t            let second_half_ptr = layer.as_mut_raw_ptr() as *mut Frac<EF>;\n550\t            let second_half_buf =\n551\t                DeviceBuffer::<Frac<EF>>::from_raw_parts(second_half_ptr.add(half), half);\n552\t            frac_add_alpha(&second_half_buf, alpha)\n553\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n554\t            std::mem::forget(second_half_buf);\n555\t        }\n556\t        1 // layer 0 done; continue from layer 1\n557\t    };\n558\t\n559\t    // Remaining layers: fuse consecutive pairs via two-layer kernel (~33% traffic savings).\n560\t    let mut i = start_layer_i;\n561\t    while i + 1 < total_rounds {\n562\t        let half_i1 = total_leaves >> (i + 2);\n563\t        unsafe {\n564\t            frac_build_tree_two_layers(&mut layer, half_i1)\n565\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n566\t        }\n567\t        i += 2;\n568\t    }\n569\t    // Remaining single layer (if odd number of layers left).\n570\t    if i < total_rounds {\n571\t        unsafe {\n572\t            frac_build_tree_layer(&mut layer, total_leaves >> i, false, EF::ZERO, false)\n573\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n574\t        }\n575\t    }\n576\t    mem.emit_metrics_with_label(\"frac_sumcheck.segment_tree\");\n577\t    mem.tracing_info(\"fractional_sumcheck_gkr: after building segment tree\");\n578\t    let mut copy_scratch = DeviceBuffer::<Frac<EF>>::with_capacity(1);\n579\t    let root = copy_from_device(&layer, 0, &mut copy_scratch)?;\n580\t    unsafe {\n581\t        frac_build_tree_layer(&mut layer, 2, true, EF::ZERO, false)\n582\t            .map_err(FractionalSumcheckError::SegmentTree)?;\n583\t    }\n584\t    if assert_zero {\n585\t        if root.p != EF::ZERO {\n586\t            return Err(FractionalSumcheckError::NonzeroRootSum {\n587\t                p: root.p,\n588\t                q: root.q,\n589\t            });\n590\t        }\n591\t    } else {\n592\t        transcript.observe_ext(root.p);\n593\t    }\n594\t    transcript.observe_ext(root.q);\n595\t\n596\t    let mut claims_per_layer = Vec::with_capacity(total_rounds);\n597\t    let mut sumcheck_polys = Vec::with_capacity(total_rounds);\n598\t\n599\t    let first_left = copy_from_device(&layer, 0, &mut copy_scratch)?;\n600\t    let first_right = copy_from_device(&layer, 1, &mut copy_scratch)?;\n601\t    claims_per_layer.push(GkrLayerClaims {\n602\t        p_xi_0: first_left.p,\n603\t        q_xi_0: first_left.q,\n604\t        p_xi_1: first_right.p,\n605\t        q_xi_1: first_right.q,\n606\t    });\n607\t    for value in [\n608\t        claims_per_layer[0].p_xi_0,\n609\t        claims_per_layer[0].q_xi_0,\n610\t        claims_per_layer[0].p_xi_1,\n611\t        claims_per_layer[0].q_xi_1,\n612\t    ] {\n613\t        transcript.observe_ext(value);\n614\t    }\n615\t    let mu_1 = transcript.sample_ext();\n616\t    let mut xi_prev = vec![mu_1];\n617\t    let mut d_sum_evals = DeviceBuffer::<EF>::with_capacity(2);\n618\t\n619\t    let precompute_m_env = precompute_m_enabled();\n620\t\n621\t    // Work buffer to avoid revert operations on layer. Only needed for non-last rounds.\n622\t    // For the last round (round == total_rounds - 1), we fold in-place on layer.\n623\t    // When precompute-M is active, the first multifold folds w+1 variables at once\n624\t    // (pending r_prev + w window challenges), so the output is total_leaves >> (2 + w).\n625\t    // Fold-eval fallback rounds (rem_n < min_n) need at most 2^min_n elements.\n626\t    let max_work_size = if total_rounds > 2 {\n627\t        if precompute_m_env {\n628\t            (total_leaves >> (2 + GKR_WINDOW_SIZE)).max(1 << GKR_WINDOW_DEFAULT_MIN_N)\n629\t        } else {\n630\t            total_leaves >> 2\n631\t        }\n632\t    } else {\n633\t        0\n634\t    };\n635\t    let mut work_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(max_work_size);\n636\t    let max_tmp_buffer_capacity = if total_rounds > 1 {\n637\t        (unsafe { _frac_compute_round_temp_buffer_size((1 << (total_rounds - 1)) as u32) }) as usize\n638\t    } else {\n639\t        0\n640\t    };\n641\t    let mut tmp_block_sums = if max_tmp_buffer_capacity > 0 {\n642\t        DeviceBuffer::<EF>::with_capacity(max_tmp_buffer_capacity)\n643\t    } else {\n644\t        DeviceBuffer::new()\n645\t    };\n646\t    let precompute_m_min_blocks_threshold = precompute_m_min_blocks_threshold();\n647\t    let precompute_m_target_blocks = precompute_m_target_blocks();\n648\t    let precompute_m_tail_tile_override = precompute_m_tail_tile_override();\n649\t    let precompute_m_min_n = precompute_m_min_n();\n650\t    let mut m_buffer = DeviceBuffer::<EF>::new();\n651\t    let mut m_partial_buffer = DeviceBuffer::<EF>::new();\n652\t    let mut eq_r_prefix_buffer = DeviceBuffer::<EF>::new();\n653\t    let mut eq_suffix_buffer = DeviceBuffer::<EF>::new();\n654\t\n655\t    for round in 1..total_rounds {\n656\t        let gkr_round_span = debug_span!(\"GKR\", round).entered();\n657\t\n658\t        // Note: frac_build_tree_layer revert is now fused into do_sumcheck_round_and_revert below.\n659\t\n660\t        debug_assert_eq!(xi_prev.len(), round);\n661\t        // eq_buffer stores eq(xi_prev[j..], x) for x in H_{xi_prev.len()-j} for\n662\t        // j=1,...,xi_prev.len()-1.\n663\t        let mut eq_buffer = SqrtEqLayers::from_xi(&xi_prev[1..])\n664\t            .map_err(FractionalSumcheckError::EvalEqHypercube)?;\n665\t\n666\t        let mut round_polys_eval = Vec::with_capacity(round);\n667\t        let mut r_vec = Vec::with_capacity(round);\n668\t        let mut pq_size = 2 << round;\n669\t\n670\t        let lambda = transcript.sample_ext();\n671\t\n672\t        let tmp_buffer_capacity =\n673\t            unsafe { _frac_compute_round_temp_buffer_size((1 << round) as u32) } as usize;\n674\t        if tmp_buffer_capacity > tmp_block_sums.len() {\n675\t            tmp_block_sums = DeviceBuffer::<EF>::with_capacity(tmp_buffer_capacity);\n676\t        }\n677\t\n678\t        let last_outer_round = round == total_rounds - 1;\n679\t        debug_assert!(round > 0);\n680\t        let backend = choose_round_strategy(\n681\t            round,\n682\t            precompute_m_env,\n683\t            precompute_m_min_blocks_threshold,\n684\t            precompute_m_target_blocks,\n685\t            precompute_m_tail_tile_override,\n686\t            precompute_m_min_n,\n687\t        );\n688\t\n689\t        // In round `j`, contains `s_{j-1}(r_{j-1})`. Starts with the sumcheck's sum claim.\n690\t        let (numer_claim, denom_claim) =\n691\t            reduce_to_single_evaluation(claims_per_layer.last().unwrap(), /* mu */ xi_prev[0]);\n692\t        let mut prev_s_eval = numer_claim + lambda * denom_claim;\n693\t        let mut eq_r_acc = EF::ONE;\n694\t\n695\t        // Round 0: compute + revert fused. The pq_buffer fold will be fused into next round's\n696\t        // compute. This fuses frac_build_tree_layer(revert=true) with the first inner round\n697\t        // compute.\n698\t        let r0 = do_sumcheck_round_and_revert(\n699\t            &mut eq_buffer,\n700\t            &mut layer,\n701\t            pq_size,\n702\t            lambda,\n703\t            transcript,\n704\t            &mut d_sum_evals,\n705\t            &mut tmp_block_sums,\n706\t            &mut round_polys_eval,\n707\t            &mut r_vec,\n708\t            &mut prev_s_eval,\n709\t            xi_prev[0],\n710\t            &mut eq_r_acc,\n711\t        )?;\n712\t\n713\t        // Fused rounds 1..(round-1): compute + fold using prev_r.\n714\t        let mut prev_r = r0;\n715\t        let active: &mut DeviceBuffer<Frac<EF>>;\n716\t\n717\t        match backend {\n718\t            GkrRoundStrategy::FoldEval => {\n719\t                // Existing fused path.\n720\t                let mut scheduler = BufferScheduler::new(max_work_size);\n721\t                for &xi_j in xi_prev.iter().skip(1) {\n722\t                    let src_pq_size = pq_size;\n723\t                    let post_fold_size = pq_size >> 1;\n724\t\n725\t                    let r = match scheduler.next_target(post_fold_size, last_outer_round) {\n726\t                        BufferTarget::LayerToWork => do_fused_sumcheck_round(\n727\t                            &mut eq_buffer,\n728\t                            &layer,\n729\t                            &mut work_buffer,\n730\t                            src_pq_size,\n731\t                            lambda,\n732\t                            prev_r,\n733\t                            transcript,\n734\t                            &mut d_sum_evals,\n735\t                            &mut tmp_block_sums,\n736\t                            &mut round_polys_eval,\n737\t                            &mut r_vec,\n738\t                            &mut prev_s_eval,\n739\t                            xi_j,\n740\t                            &mut eq_r_acc,\n741\t                        )?,\n742\t                        BufferTarget::WorkToLayer => do_fused_sumcheck_round(\n743\t                            &mut eq_buffer,\n744\t                            &work_buffer,\n745\t                            &mut layer,\n746\t                            src_pq_size,\n747\t                            lambda,\n748\t                            prev_r,\n749\t                            transcript,\n750\t                            &mut d_sum_evals,\n751\t                            &mut tmp_block_sums,\n752\t                            &mut round_polys_eval,\n753\t                            &mut r_vec,\n754\t                            &mut prev_s_eval,\n755\t                            xi_j,\n756\t                            &mut eq_r_acc,\n757\t                        )?,\n758\t                        BufferTarget::InPlaceLayer => do_fused_sumcheck_round_inplace(\n759\t                            &mut eq_buffer,\n760\t                            &mut layer,\n761\t                            src_pq_size,\n762\t                            lambda,\n763\t                            prev_r,\n764\t                            transcript,\n765\t                            &mut d_sum_evals,\n766\t                            &mut tmp_block_sums,\n767\t                            &mut round_polys_eval,\n768\t                            &mut r_vec,\n769\t                            &mut prev_s_eval,\n770\t                            xi_j,\n771\t                            &mut eq_r_acc,\n772\t                        )?,\n773\t                        BufferTarget::InPlaceWork => do_fused_sumcheck_round_inplace(\n774\t                            &mut eq_buffer,\n775\t                            &mut work_buffer,\n776\t                            src_pq_size,\n777\t                            lambda,\n778\t                            prev_r,\n779\t                            transcript,\n780\t                            &mut d_sum_evals,\n781\t                            &mut tmp_block_sums,\n782\t                            &mut round_polys_eval,\n783\t                            &mut r_vec,\n784\t                            &mut prev_s_eval,\n785\t                            xi_j,\n786\t                            &mut eq_r_acc,\n787\t                        )?,\n788\t                    };\n789\t\n790\t                    pq_size >>= 1;\n791\t                    prev_r = r;\n792\t                }\n793\t\n794\t                // Final fold after last r (no next compute to fuse with).\n795\t                active = match scheduler.final_fold_target(last_outer_round) {\n796\t                    BufferTarget::InPlaceWork => {\n797\t                        unsafe {\n798\t                            fold_ef_frac_columns_inplace(&mut work_buffer, pq_size, prev_r)\n799\t                                .map_err(FractionalSumcheckError::FoldColumns)?;\n800\t                        }\n801\t                        &mut work_buffer\n802\t                    }\n803\t                    BufferTarget::InPlaceLayer => {\n804\t                        unsafe {\n805\t                            fold_ef_frac_columns_inplace(&mut layer, pq_size, prev_r)\n806\t                                .map_err(FractionalSumcheckError::FoldColumns)?;\n807\t                        }\n808\t                        &mut layer\n809\t                    }\n810\t                    BufferTarget::LayerToWork => {\n811\t                        unsafe {\n812\t                            fold_ef_frac_columns(&layer, &mut work_buffer, pq_size, prev_r)\n813\t                                .map_err(FractionalSumcheckError::FoldColumns)?;\n814\t                        }\n815\t                        &mut work_buffer\n816\t                    }\n817\t                    BufferTarget::WorkToLayer => unreachable!(),\n818\t                };\n819\t                pq_size >>= 1;\n820\t            }\n821\t            GkrRoundStrategy::PrecomputeM => {\n822\t                let base = 1usize;\n823\t                let stop = round.div_ceil(2);\n824\t\n825\t                // First window reads from `layer` with pending_fold=true\n826\t                // (M-build folds prev_r inline). Multifold writes to\n827\t                // `active_pq` (work_buffer for non-last rounds, layer for\n828\t                // last). After the first window, subsequent windows\n829\t                // read/write active_pq with pending_fold=false.\n830\t                let mut pending_fold = true;\n831\t                let layer_read_ptr = layer.as_ptr();\n832\t                let active_pq = if last_outer_round {\n833\t                    &mut layer\n834\t                } else {\n835\t                    &mut work_buffer\n836\t                };\n837\t\n838\t                // w+1 to accommodate r_prev prepended to window challenges\n839\t                // on the first iteration (inline fold on last outer round).\n840\t                let mut eq_r_window_host = vec![EF::ZERO; 1 << (GKR_WINDOW_SIZE + 1)];\n841\t                let mut eq_r_prefix_host = vec![EF::ZERO; 1 << GKR_WINDOW_SIZE];\n842\t                let mut eq_suffix_host = vec![EF::ZERO; 1 << GKR_WINDOW_SIZE];\n843\t\n844\t                if eq_r_prefix_buffer.is_empty() {\n845\t                    eq_r_prefix_buffer =\n846\t                        DeviceBuffer::<EF>::with_capacity(1usize << GKR_WINDOW_SIZE);\n847\t                }\n848\t                if eq_suffix_buffer.is_empty() {\n849\t                    eq_suffix_buffer = DeviceBuffer::<EF>::with_capacity(1usize << GKR_WINDOW_SIZE);\n850\t                }\n851\t\n852\t                let mut base = base;\n853\t                while base < stop {\n854\t                    let rem_n = round - base;\n855\t                    let rounds_left = stop - base;\n856\t                    let Some(w) = choose_precompute_m_window_w(\n857\t                        rem_n,\n858\t                        rounds_left,\n859\t                        precompute_m_min_blocks_threshold,\n860\t                        precompute_m_target_blocks,\n861\t                        precompute_m_tail_tile_override,\n862\t                        precompute_m_min_n,\n863\t                    ) else {\n864\t                        break;\n865\t                    };\n866\t                    if m_buffer.is_empty() {\n867\t                        let max_m_len = 1usize << (2 * GKR_WINDOW_SIZE);\n868\t                        m_buffer = DeviceBuffer::<EF>::with_capacity(max_m_len);\n869\t                    }\n870\t                    let m_ptr = m_buffer.as_mut_ptr();\n871\t                    // Reuse tmp_block_sums for eq_r_window upload.\n872\t                    // Safe: M eval rounds finish before multifold needs eq_r_window,\n873\t                    // and tmp_block_sums is not needed until next fold-eval round.\n874\t                    let max_eq_r_window_len = 1usize << (GKR_WINDOW_SIZE + 1);\n875\t                    debug_assert!(\n876\t                        tmp_block_sums.len() >= max_eq_r_window_len,\n877\t                        \"tmp_block_sums too small for eq_r_window: {} < {}\",\n878\t                        tmp_block_sums.len(),\n879\t                        max_eq_r_window_len,\n880\t                    );\n881\t                    let d_eq_r_window = tmp_block_sums.as_mut_ptr();\n882\t\n883\t                    // When pending_fold is true, the buffer has rem_n+1 variables\n884\t                    // and the kernel folds inline. The effective tail dimension\n885\t                    // for tiling is the same either way (rem_n - w).\n886\t                    let tail_tile = precompute_m_build_tail_tile(\n887\t                        rem_n,\n888\t                        w,\n889\t                        precompute_m_min_blocks_threshold,\n890\t                        precompute_m_target_blocks,\n891\t                        precompute_m_tail_tile_override,\n892\t                    );\n893\t                    let num_blocks = precompute_m_num_tail_blocks(rem_n, w, tail_tile);\n894\t                    let m_len = (1usize << w) * (1usize << w);\n895\t                    let partial_len = num_blocks * m_len;\n896\t                    if partial_len > m_partial_buffer.len() {\n897\t                        m_partial_buffer = DeviceBuffer::<EF>::with_capacity(partial_len);\n898\t                    }\n899\t\n900\t                    let (eq_tail_low, eq_tail_high, eq_low_cap, _) =\n901\t                        eq_tail_ptrs(&eq_buffer, w - 1);\n902\t\n903\t                    let r_fold = prev_r; // save before eval loop overwrites prev_r\n904\t                    let build_src = if pending_fold {\n905\t                        layer_read_ptr\n906\t                    } else {\n907\t                        active_pq.as_ptr()\n908\t                    };\n909\t                    unsafe {\n910\t                        frac_precompute_m_build_raw(\n911\t                            build_src,\n912\t                            rem_n,\n913\t                            w,\n914\t                            lambda,\n915\t                            r_fold,\n916\t                            pending_fold, // inline fold only on first iteration\n917\t                            eq_tail_low,\n918\t                            eq_tail_high,\n919\t                            eq_low_cap,\n920\t                            tail_tile,\n921\t                            m_partial_buffer.as_mut_ptr(),\n922\t                            partial_len,\n923\t                            m_ptr,\n924\t                        )\n925\t                        .map_err(FractionalSumcheckError::ComputeRound)?;\n926\t                    }\n927\t\n928\t                    let mut window_rs = Vec::with_capacity(w);\n929\t                    for t in 0..w {\n930\t                        let prefix_bits = t;\n931\t                        let suffix_bits = w - t - 1;\n932\t                        eval_mle_table(&window_rs, &mut eq_r_prefix_host);\n933\t                        eval_mle_table(&xi_prev[base + t + 1..base + w], &mut eq_suffix_host);\n934\t\n935\t                        copy_to_device_ptr(\n936\t                            eq_r_prefix_buffer.as_mut_ptr(),\n937\t                            &eq_r_prefix_host[..(1usize << prefix_bits)],\n938\t                        )?;\n939\t                        copy_to_device_ptr(\n940\t                            eq_suffix_buffer.as_mut_ptr(),\n941\t                            &eq_suffix_host[..(1usize << suffix_bits)],\n942\t                        )?;\n943\t                        unsafe {\n944\t                            frac_precompute_m_eval_round_raw(\n945\t                                m_ptr,\n946\t                                w,\n947\t                                t,\n948\t                                eq_r_prefix_buffer.as_ptr(),\n949\t                                eq_suffix_buffer.as_ptr(),\n950\t                                d_sum_evals.as_mut_ptr(),\n951\t                            )\n952\t                            .map_err(FractionalSumcheckError::ComputeRound)?;\n953\t                        }\n954\t                        eq_buffer.drop_layer();\n955\t                        let r = observe_and_update(\n956\t                            &d_sum_evals,\n957\t                            transcript,\n958\t                            &mut round_polys_eval,\n959\t                            &mut r_vec,\n960\t                            &mut prev_s_eval,\n961\t                            xi_prev[base + t],\n962\t                            &mut eq_r_acc,\n963\t                        )?;\n964\t                        prev_r = r;\n965\t                        window_rs.push(r);\n966\t                    }\n967\t\n968\t                    // Compute eq_r_window for the multifold.\n969\t                    let (buf_vars, w_fold) = if pending_fold {\n970\t                        let mut all_rs = Vec::with_capacity(w + 1);\n971\t                        all_rs.push(r_fold);\n972\t                        all_rs.extend_from_slice(&window_rs);\n973\t                        eval_mle_table(&all_rs, &mut eq_r_window_host);\n974\t                        copy_to_device_ptr(d_eq_r_window, &eq_r_window_host[..(1 << (w + 1))])?;\n975\t                        (rem_n + 1, w + 1)\n976\t                    } else {\n977\t                        eval_mle_table(&window_rs, &mut eq_r_window_host);\n978\t                        copy_to_device_ptr(d_eq_r_window, &eq_r_window_host[..(1 << w)])?;\n979\t                        (rem_n, w)\n980\t                    };\n981\t\n982\t                    let multifold_src = if pending_fold {\n983\t                        layer_read_ptr\n984\t                    } else {\n985\t                        active_pq.as_ptr()\n986\t                    };\n987\t                    unsafe {\n988\t                        frac_multifold_raw(\n989\t                            multifold_src,\n990\t                            active_pq.as_mut_ptr(),\n991\t                            buf_vars,\n992\t                            w_fold,\n993\t                            d_eq_r_window,\n994\t                        )\n995\t                        .map_err(FractionalSumcheckError::FoldColumns)?;\n996\t                    }\n997\t                    pq_size >>= w_fold;\n998\t                    pending_fold = false;\n999\t                    base += w;\n1000\t                }\n1001\t\n1002\t                if base < round {\n1003\t                    // First tail round is standalone compute,\n1004\t                    // subsequent rounds are fold+compute.\n1005\t                    unsafe {\n1006\t                        frac_compute_round(\n1007\t                            &eq_buffer,\n1008\t                            active_pq,\n1009\t                            pq_size / 2,\n1010\t                            lambda,\n1011\t                            &mut d_sum_evals,\n1012\t                            &mut tmp_block_sums,\n1013\t                        )\n1014\t                        .map_err(FractionalSumcheckError::ComputeRound)?;\n1015\t                    }\n1016\t                    eq_buffer.drop_layer();\n1017\t                    prev_r = observe_and_update(\n1018\t                        &d_sum_evals,\n1019\t                        transcript,\n1020\t                        &mut round_polys_eval,\n1021\t                        &mut r_vec,\n1022\t                        &mut prev_s_eval,\n1023\t                        xi_prev[base],\n1024\t                        &mut eq_r_acc,\n1025\t                    )?;\n1026\t\n1027\t                    for &xi_j in xi_prev.iter().skip(base + 1) {\n1028\t                        let src_pq_size = pq_size;\n1029\t                        prev_r = do_fused_sumcheck_round_inplace(\n1030\t                            &mut eq_buffer,\n1031\t                            active_pq,\n1032\t                            src_pq_size,\n1033\t                            lambda,\n1034\t                            prev_r,\n1035\t                            transcript,\n1036\t                            &mut d_sum_evals,\n1037\t                            &mut tmp_block_sums,\n1038\t                            &mut round_polys_eval,\n1039\t                            &mut r_vec,\n1040\t                            &mut prev_s_eval,\n1041\t                            xi_j,\n1042\t                            &mut eq_r_acc,\n1043\t                        )?;\n1044\t                        pq_size >>= 1;\n1045\t                    }\n1046\t                }\n1047\t\n1048\t                unsafe {\n1049\t                    fold_ef_frac_columns_inplace(active_pq, pq_size, prev_r)\n1050\t                        .map_err(FractionalSumcheckError::FoldColumns)?;\n1051\t                }\n1052\t                active = active_pq;\n1053\t                pq_size >>= 1;\n1054\t            }\n1055\t        }\n1056\t\n1057\t        let pq_host = [\n1058\t            copy_from_device(active, 0, &mut copy_scratch)?,\n1059\t            copy_from_device(active, pq_size / 2, &mut copy_scratch)?,\n1060\t        ];\n1061\t\n1062\t        claims_per_layer.push(GkrLayerClaims {\n1063\t            p_xi_0: pq_host[0].p,\n1064\t            q_xi_0: pq_host[0].q,\n1065\t            p_xi_1: pq_host[1].p,\n1066\t            q_xi_1: pq_host[1].q,\n1067\t        });\n1068\t\n1069\t        transcript.observe_ext(claims_per_layer[round].p_xi_0);\n1070\t        transcript.observe_ext(claims_per_layer[round].q_xi_0);\n1071\t        transcript.observe_ext(claims_per_layer[round].p_xi_1);\n1072\t        transcript.observe_ext(claims_per_layer[round].q_xi_1);\n1073\t\n1074\t        let mu = transcript.sample_ext();\n1075\t        xi_prev = [vec![mu], r_vec].concat();\n1076\t\n1077\t        sumcheck_polys.push(round_polys_eval);\n1078\t        gkr_round_span.exit();\n1079\t    }\n1080\t    mem.emit_metrics_with_label(\"frac_sumcheck.gkr_rounds\");\n1081\t    mem.tracing_info(\"after_fractional_sumcheck_gkr\");\n1082\t\n1083\t    Ok((\n1084\t        FracSumcheckProof {\n1085\t            fractional_sum: (root.p, root.q),\n1086\t            claims_per_layer,\n1087\t            sumcheck_polys,\n1088\t        },\n1089\t        xi_prev,\n1090\t    ))"}]},"parent_tool_use_id":"toolu_01Rnk8wYpuYMwBcrmjGUurAV","session_id":"00f14df6-1cef-48ea-af88-42c3b73a9be4","uuid":"278da8d6-9b93-4d1c-9971-dfd540058ebc","timestamp":"2026-04-14T21:51:49.987Z"}
