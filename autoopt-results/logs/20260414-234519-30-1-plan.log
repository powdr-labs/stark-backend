ld not block on them."},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2852,"cache_read_input_tokens":195897,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2852},"output_tokens":67,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"00f14df6-1cef-48ea-af88-42c3b73a9be4","uuid":"da7e7d8c-2d32-4ebc-a8f4-9f11692698cc"}
