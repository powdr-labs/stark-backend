 DIGEST_SIZE in `F` elements\n323\t        // - d_layers_ptr is size `num_trees * depth` device pointers\n324\t        // - d_indices is size `num_trees * depth * num_queries` indices for merkle proof sibling\n325\t        //   indices\n326\t        // - Both Digest=[F;8] and Bn254Digest=[Bn254Scalar;1] are 32 bytes == DIGEST_SIZE * 4, so\n327\t        //   the same kernel correctly copies the raw bytes for either digest type.\n328\t        unsafe {\n329\t            query_digest_layers(\n330\t                &mut d_out,\n331\t                &d_layers_ptr,\n332\t                &d_indices,\n333\t                num_queries as u64,\n334\t                d_layers_ptr.len() as u64,\n335\t            )\n336\t            .map_err(MerkleTreeError::QueryDigestLayers)?;\n337\t        }\n338\t        let out = d_out.to_host()?;\n339\t        // Chunk up the array using D::reconstruct_from_f\n340\t        let res = (0..num_trees)\n341\t            .map(|tree_idx| {\n342\t                (0..num_queries)\n343\t                    .map(|query_idx| {\n344\t                        (0..depth)\n345\t                            .map(|layer_idx| {\n346\t                                let base =\n347\t                                    (query_idx * num_trees * depth + tree_idx * depth + layer_idx)\n348\t                                        * DIGEST_SIZE;\n349\t                                D::reconstruct_from_f(&out, base)\n350\t                            })\n351\t                            .collect_vec()\n352\t                    })\n353\t                    .collect_vec()\n354\t            })\n355\t            .collect_vec();\n356\t        Ok(res)\n357\t    }\n358\t\n359\t    /// Batch queries multiple `trees` at _the same_ `query_indices` for merkle proofs.\n360\t    ///\n361\t    /// # Assumptions\n362\t    /// - All `trees` have the same depth.\n363\t    pub fn batch_query_merkle_proofs(\n364\t        trees: &[&Self],\n365\t        query_indices: &[usize],\n366\t    ) -> Result<\n367\t        Vec<\n368\t            // per tree\n369\t            Vec<\n370\t                // per query index\n371\t                Vec<D>, // merkle proof\n372\t            >,\n373\t        >,\n374\t        MerkleTreeError,\n375\t    >\n376\t    where\n377\t        D: MerkleProofQueryDigest,\n378\t    {\n379\t        D::batch_query_merkle_proofs(trees, query_indices)\n380\t    }\n381\t}\n382\t\n383\timpl MerkleProofQueryDigest for Digest {\n384\t    fn batch_query_merkle_proofs(\n385\t        trees: &[&MerkleTreeGpu<F, Self>],\n386\t        query_indices: &[usize],\n387\t    ) -> Result<Vec<Vec<Vec<Self>>>, MerkleTreeError> {\n388\t        MerkleTreeGpu::<F, Self>::batch_query_proofs(trees, query_indices)\n389\t    }\n390\t}\n391\t\n392\t#[cfg(feature = \"baby-bear-bn254-poseidon2\")]\n393\timpl MerkleProofQueryDigest for Bn254Digest {\n394\t    fn batch_query_merkle_proofs(\n395\t        trees: &[&MerkleTreeGpu<F, Self>],\n396\t        query_indices: &[usize],\n397\t    ) -> Result<Vec<Vec<Vec<Self>>>, MerkleTreeError> {\n398\t        MerkleTreeGpu::<F, Self>::batch_query_proofs(trees, query_indices)\n399\t    }\n400\t}\n401\t\n402\t// Extension field merkle tree — generic constructor\n403\timpl<D: Copy + Send + Sync + 'static> MerkleTreeGpu<EF, D> {\n404\t    /// Build a Merkle tree from an extension-field matrix using hash scheme `MH`.\n405\t    #[instrument(name = \"merkle_tree_ext\", skip_all)]\n406\t    pub fn new_with_hash<MH: GpuMerkleHash<Digest = D>>(\n407\t        matrix: DeviceMatrix<EF>,\n408\t        rows_per_query: usize,\n409\t        cache_backing_matrix: bool,\n410\t    ) -> Result<Self, MerkleTreeError> {\n411\t        let height = matrix.height();\n412\t        assert!(height.is_power_of_two());\n413\t        let k = log2_strict_usize(rows_per_query);\n414\t        assert!(\n415\t            rows_per_query <= height,\n416\t            \"rows_per_query ({rows_per_query}) must not exceed height ({height})\"\n417\t        );\n418\t    