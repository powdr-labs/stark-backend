{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PFr59M4ineZmytVe6yppRL","type":"tool_result","content":"1093\tfn copy_from_device<T: Copy>(\n1094\t    buf: &DeviceBuffer<T>,\n1095\t    index: usize,\n1096\t    scratch: &mut DeviceBuffer<T>,\n1097\t) -> Result<T, FractionalSumcheckError> {\n1098\t    debug_assert!(!scratch.is_empty());\n1099\t    unsafe {\n1100\t        cuda_memcpy::<true, true>(\n1101\t            scratch.as_mut_raw_ptr(),\n1102\t            buf.as_ptr().add(index) as *const std::ffi::c_void,\n1103\t            std::mem::size_of::<T>(),\n1104\t        )?;\n1105\t    }\n1106\t    let host = scratch.to_host()?;\n1107\t    Ok(host[0])\n1108\t}\n1109\t\n1110\t/// Reduces claims to a single evaluation point using linear interpolation.\n1111\tfn reduce_to_single_evaluation<SC: StarkProtocolConfig<EF = EF>>(\n1112\t    claims: &GkrLayerClaims<SC>,\n1113\t    mu: EF,\n1114\t) -> (EF, EF) {\n1115\t    let numer = interpolate_linear_at_01(&[claims.p_xi_0, claims.p_xi_1], mu);\n1116\t    let denom = interpolate_linear_at_01(&[claims.q_xi_0, claims.q_xi_1], mu);\n1117\t    (numer, denom)\n1118\t}\n1119\t\n1120\t/// Reconstructs the full s(1,2,3) evaluations from s'(1,2) evaluations returned by GPU.\n1121\t///\n1122\t/// Goal: compute s({1,2,3}) from s(X) = eq(xi_j, X) * s'(X).\n1123\t/// Reconstruct the full round polynomial s_t from GPU-computed s'_t(1), s'_t(2).\n1124\t///\n1125\t/// See `docs/cuda-backend/gkr-prover.md` § \"Sumcheck round implementation\" for the derivation.\n1126\tfn reconstruct_s_evals(\n1127\t    d_sum_evals: &DeviceBuffer<EF>,\n1128\t    prev_s_eval: EF,\n1129\t    xi_j: EF,\n1130\t    eq_r_acc: EF,\n1131\t) -> Result<([EF; GKR_S_DEG], [EF; GKR_S_DEG]), FractionalSumcheckError> {\n1132\t    let sp_vec = d_sum_evals.to_host()?;\n1133\t    debug_assert_eq!(sp_vec.len(), GKR_S_DEG - 1);\n1134\t\n1135\t    // sp_evals holds evaluations of degree 2 poly `eq(xi_{j+1..}, r_{j+1..}) * s'(X)` at {0,1,2}\n1136\t    let mut sp_evals = [EF::ZERO; GKR_S_DEG];\n1137\t    sp_evals[1] = sp_vec[0] * eq_r_acc;\n1138\t    sp_evals[2] = sp_vec[1] * eq_r_acc;\n1139\t\n1140\t    // We use that s_j(0) + s_j(1) = s_{j-1}(r_{j-1})\n1141\t    // s_j(X) = eq(xi_j, X) * sp_j(X)\n1142\t    // s_j(0) = (1 - xi_j) * sp_j(0)\n1143\t    // s_j(1) = xi_j * sp_j(1)\n1144\t    // So: (1 - xi_j) * sp_j(0) + xi_j * sp_j(1) = prev_s_eval\n1145\t    // xi_j is randomly sampled so 1 - xi_j should be invertible\n1146\t    let eq_xi_0 = EF::ONE - xi_j;\n1147\t    debug_assert_ne!(eq_xi_0, EF::ZERO);\n1148\t    let eq_xi_1 = xi_j;\n1149\t    sp_evals[0] = (prev_s_eval - eq_xi_1 * sp_evals[1]) * eq_xi_0.inverse();\n1150\t\n1151\t    let s_evals: [EF; GKR_S_DEG] = from_fn(|i| {\n1152\t        // evaluate s at X = i + 1 (skip 0 evaluation)\n1153\t        let x = EF::from_usize(i + 1);\n1154\t        let sp_eval = if i < GKR_S_DEG - 1 {\n1155\t            sp_evals[i + 1]\n1156\t        } else {\n1157\t            interpolate_quadratic_at_012(&sp_evals, x)\n1158\t        };\n1159\t        eval_eq_mle(&[xi_j], &[x]) * sp_eval\n1160\t    });\n1161\t\n1162\t    Ok((s_evals, sp_evals))\n1163\t}\n1164\t\n1165\t/// Generate random fractional leaves on device for benchmarking.\n1166\tpub fn make_synthetic_leaves(n: usize) -> Result<DeviceBuffer<Frac<EF>>, FractionalSumcheckError> {\n1167\t    use openvm_cuda_common::copy::cuda_memcpy;\n1168\t    use rand::{rngs::StdRng, Rng, SeedableRng};\n1169\t\n1170\t    let size = 1usize << n;\n1171\t    let mut rng = StdRng::seed_from_u64(42);\n1172\t    let host: Vec<(EF, EF)> = (0..size)\n1173\t        .map(|_| (rng.random::<EF>(), rng.random::<EF>()))\n1174\t        .collect();\n1175\t    let d_leaves = DeviceBuffer::<Frac<EF>>::with_capacity(size);\n1176\t    unsafe {\n1177\t        cuda_memcpy::<false, true>(\n1178\t            d_leaves.as_mut_raw_ptr(),\n1179\t            host.as_ptr() as *const std::ffi::c_void,\n1180\t            std::mem::size_of_val(host.as_slice()),\n1181\t        )?;\n1182\t    }\n1183\t    Ok(d_leaves)\n1184\t}\n1185\t\n1186\t#[cfg(test)]\n1187\tmod tests {\n1188\t    use openvm_cuda_common::{memory_manager::MemTracker, stream::current_stream_sync};\n1189\t    use p3_field::PrimeCharacteristicRing;\n1190\t\n1191\t    use super::{\n1192\t        fractional_sumcheck_gpu, make_synthetic_leaves, FractionalSumcheckError, GkrRoundStrategy,"}]},"parent_tool_use_id":"toolu_01Rnk8wYpuYMwBcrmjGUurAV","session_id":"00f14df6-1cef-48ea-af88-42c3b73a9be4","uuid":"8543e04c-7b17-4596-aaf3-3bb1b17d70e3","timestamp":"2026-04-14T21:51:53.040Z"}
