{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AbcMvRB2hSqU9RXfdrA4zs","type":"tool_result","content":"1\t#![allow(dead_code)]\n2\tuse openvm_cuda_common::{\n3\t    copy::{MemCopyD2H, MemCopyH2D},\n4\t    d_buffer::DeviceBuffer,\n5\t};\n6\tuse openvm_stark_backend::{\n7\t    p3_util::log2_strict_usize,\n8\t    poly_common::UnivariatePoly,\n9\t    prover::sumcheck::{SumcheckCubeProof, SumcheckPrismProof},\n10\t    FiatShamirTranscript,\n11\t};\n12\tuse p3_field::{ExtensionField, Field};\n13\tuse tracing::{debug, info_span, instrument};\n14\t\n15\tuse crate::{\n16\t    cuda::{\n17\t        batch_ntt_small::batch_ntt_small,\n18\t        matrix::batch_expand_pad_wide,\n19\t        sumcheck::{fold_mle, fold_ple_from_coeffs, reduce_over_x_and_cols, sumcheck_mle_round},\n20\t    },\n21\t    error::SumcheckError,\n22\t    prelude::*,\n23\t    sponge::DuplexSpongeGpu,\n24\t};\n25\t\n26\t/// GPU implementation of multilinear sumcheck\n27\t///\n28\t/// Memory strategy: Ping-pong buffers (buffer_a ↔ buffer_b) alternate each round\n29\t/// - Round 0 (even): reads buffer_a, writes buffer_b\n30\t/// - Round 1 (odd):  reads buffer_b, writes buffer_a\n31\t/// - Final result in buffer determined by parity of n\n32\t/// - Memory footprint: ~1.5 * evals.len() * sizeof(EF)\n33\t#[allow(dead_code)]\n34\t#[instrument(name = \"sumcheck_multilinear_gpu\", level = \"info\", skip_all)]\n35\tpub fn sumcheck_multilinear_gpu<F: Field>(\n36\t    transcript: &mut DuplexSpongeGpu,\n37\t    evals: &[F],\n38\t) -> Result<(SumcheckCubeProof<EF>, Vec<EF>), SumcheckError>\n39\twhere\n40\t    EF: ExtensionField<F>,\n41\t{\n42\t    let n = log2_strict_usize(evals.len());\n43\t    let mut round_polys_eval = Vec::with_capacity(n);\n44\t    let mut r = Vec::with_capacity(n);\n45\t\n46\t    // Compute sum claim\n47\t    let sum_claim: EF = evals.iter().copied().sum::<F>().into();\n48\t    transcript.observe_ext(sum_claim);\n49\t\n50\t    // Convert to extension field\n51\t    let evals_ext: Vec<EF> = evals.iter().map(|&x| EF::from(x)).collect();\n52\t\n53\t    // Setup\n54\t    let mut current_height = 1 << n;\n55\t    let width = 1;\n56\t    let num_matrices = 1;\n57\t    let d = 1; // Degree for MLE\n58\t    const WD: usize = 1; // Number of output polynomials\n59\t\n60\t    // Allocate ping-pong buffers\n61\t    let total_size = width * current_height;\n62\t    let mut d_buffer_a = evals_ext.to_device()?;\n63\t    let mut d_buffer_b = DeviceBuffer::<EF>::with_capacity(total_size / 2);\n64\t\n65\t    // Set up pointer arrays on device\n66\t    let mut d_input_ptrs = DeviceBuffer::<*const EF>::with_capacity(num_matrices);\n67\t    let mut d_output_ptrs = DeviceBuffer::<*mut EF>::with_capacity(num_matrices);\n68\t    let d_widths = [width as u32].to_device()?;\n69\t\n70\t    // Buffer for round output [d * WD]\n71\t    let d_round_output = DeviceBuffer::<EF>::with_capacity(d * WD);\n72\t\n73\t    // Sumcheck rounds\n74\t    for round in 0..n {\n75\t        // Ping-pong buffers\n76\t        let (input_buf, output_buf) = if round % 2 == 0 {\n77\t            (&d_buffer_a, &mut d_buffer_b)\n78\t        } else {\n79\t            (&d_buffer_b, &mut d_buffer_a)\n80\t        };\n81\t\n82\t        // Update pointer arrays\n83\t        let input_ptr = input_buf.as_ptr();\n84\t        let output_ptr = output_buf.as_mut_ptr();\n85\t\n86\t        [input_ptr].copy_to(&mut d_input_ptrs)?;\n87\t        [output_ptr].copy_to(&mut d_output_ptrs)?;\n88\t\n89\t        // Call sumcheck_mle_round kernel (uses output_buf as tmp)\n90\t        unsafe {\n91\t            sumcheck_mle_round(\n92\t                &d_input_ptrs,\n93\t                &d_round_output,\n94\t                output_buf, // Reuse output buffer as tmp!\n95\t                &d_widths,\n96\t                num_matrices as u32,\n97\t                current_height as u32,\n98\t                d as u32,\n99\t            )\n100\t            .map_err(|e| SumcheckError::SumcheckMleRound(e.into()))?;\n101\t        }\n102\t\n103\t        // Copy result back to host\n104\t        let h_round_output = d_round_output.to_host()?;\n105\t\n106\t        // Observe in transcript\n107\t        let s = h_round_output[0..d].to_vec();\n108\t\n109\t        assert_eq!(s.len(), d);\n110\t        transcript.observe_ext(s[0]);\n111\t        round_polys_eval.push(s);\n112\t\n113\t        // Sample challenge from transcript\n114\t        let r_round = transcript.sample_ext();\n115\t        debug!(%round, %r_round);\n116\t        r.push(r_round);\n117\t\n118\t        // Fold using the challenge\n119\t        let output_height = (current_height >> 1) as u32;\n120\t        unsafe {\n121\t            fold_mle(\n122\t                &d_input_ptrs,\n123\t                &d_output_ptrs,\n124\t                &d_widths,\n125\t                num_matrices.try_into().unwrap(),\n126\t                output_height,\n127\t                width as u32 * output_height,\n128\t                r_round,\n129\t            )\n130\t            .map_err(|e| SumcheckError::FoldMle(e.into()))?;\n131\t        }\n132\t\n133\t        current_height >>= 1;\n134\t    }\n135\t\n136\t    // After all rounds, get final evaluation claim\n137\t    let final_buf = if n % 2 == 1 { &d_buffer_b } else { &d_buffer_a };\n138\t    let eval_claim_vec = final_buf.to_host()?;\n139\t    let eval_claim = eval_claim_vec[0];\n140\t\n141\t    transcript.observe_ext(eval_claim);\n142\t\n143\t    Ok((\n144\t        SumcheckCubeProof {\n145\t            sum_claim,\n146\t            round_polys_eval,\n147\t            eval_claim,\n148\t        },\n149\t        r,\n150\t    ))\n151\t}\n152\t\n153\t/// GPU implementation of prismalinear sumcheck with univariate skip\n154\t///\n155\t/// Memory strategy:\n156\t/// - Round 0: Uses DFT/iDFT pipeline, reuses buffers between steps\n157\t/// - Rounds 1..n: Standard MLE rounds with ping-pong buffers\n158\t/// - d_evals gets modified by iDFT in round 0, then reused for fold_ple\n159\t/// - Memory footprint: if evals.len() = 2^(l_skip +n), then 2 * evals.len() * sizeof(F) + 1.5 * 2^n\n160\t///   * sizeof(EF)\n161\t///\n162\t/// NOTE: batch_ntt expects a concrete type BabyBear, so I removed generic type parameters for now\n163\t#[allow(dead_code)]\n164\t#[instrument(name = \"sumcheck_prismalinear_gpu\", level = \"info\", skip_all)]\n165\tpub fn sumcheck_prismalinear_gpu(\n166\t    transcript: &mut DuplexSpongeGpu,\n167\t    l_skip: usize,\n168\t    evals: &[F],\n169\t) -> Result<(SumcheckPrismProof<EF>, Vec<EF>), SumcheckError> {\n170\t    let prism_dim = p3_util::log2_strict_usize(evals.len());\n171\t    assert!(prism_dim >= l_skip);\n172\t    let n = prism_dim - l_skip;\n173\t\n174\t    let mut round_polys_eval = Vec::with_capacity(n);\n175\t    let mut r = Vec::with_capacity(n + 1);\n176\t\n177\t    // Compute sum claim\n178\t    let sum_claim: EF = evals.iter().copied().sum::<F>().into();\n179\t    transcript.observe_ext(sum_claim);\n180\t\n181\t    // Setup\n182\t    let domain_size = 1 << l_skip;\n183\t    let num_x = 1 << n;\n184\t    let width = 1;\n185\t    let d = 1; // Degree for simple case\n186\t    let s_deg = d * (domain_size - 1); // d * (2^l_skip - 1)\n187\t    let log_large_domain = p3_util::log2_ceil_usize(s_deg + 1);\n188\t    let large_domain_size = 1 << log_large_domain;\n189\t\n190\t    // ========== Round 0: Special PLE round ==========\n191\t    let _round0_span = info_span!(\"sumcheck_prismalinear.round0\").entered();\n192\t\n193\t    let mut d_coeffs = evals.to_device()?;\n194\t    let mut d_s0_coeffs = DeviceBuffer::<F>::with_capacity(large_domain_size);\n195\t\n196\t    // Step 1: iDFT on skip domain (reinterpreting dimensions)\n197\t    // Input: [height=2^(l_skip+n), width=1]\n198\t    // Treat as: [height=2^l_skip, width=2^n]\n199\t    unsafe {\n200\t        batch_ntt_small(&mut d_coeffs, l_skip, num_x * width, true)\n201\t            .map_err(|e| SumcheckError::BatchNttSmall(e.into()))?;\n202\t    }\n203\t\n204\t    if domain_size == large_domain_size {\n205\t        unsafe {\n206\t            // Step 2-5: Sum over all x and columns\n207\t            reduce_over_x_and_cols(\n208\t                &d_coeffs,\n209\t                &d_s0_coeffs,\n210\t                num_x as u32,\n211\t                width as u32,\n212\t                large_domain_size as u32,\n213\t            )\n214\t            .map_err(|e| SumcheckError::ReduceOverXAndCols(e.into()))?;\n215\t        }\n216\t    } else {\n217\t        let mut d_coeffs_large =\n218\t            DeviceBuffer::<F>::with_capacity(num_x * width * large_domain_size);\n219\t\n220\t        // Step 2: Copy and pad each column to large domain size\n221\t        unsafe {\n222\t            batch_expand_pad_wide(\n223\t                d_coeffs_large.as_mut_ptr(),\n224\t                d_coeffs.as_ptr(),\n225\t                (num_x * width) as u32,\n226\t                large_domain_size as u32,\n227\t                domain_size as u32,\n228\t            )\n229\t            .map_err(|e| SumcheckError::BatchExpandPadWide(e.into()))?;\n230\t        }\n231\t\n232\t        // Step 3: DFT on large domain\n233\t        unsafe {\n234\t            batch_ntt_small(&mut d_coeffs_large, log_large_domain, num_x * width, false)\n235\t                .map_err(|e| SumcheckError::BatchNttSmall(e.into()))?;\n236\t        }\n237\t\n238\t        // Step 4: Sum over all x and columns\n239\t        unsafe {\n240\t            reduce_over_x_and_cols(\n241\t                &d_coeffs_large,\n242\t                &d_s0_coeffs,\n243\t                num_x as u32,\n244\t                width as u32,\n245\t                large_domain_size as u32,\n246\t            )\n247\t            .map_err(|e| SumcheckError::ReduceOverXAndCols(e.into()))?;\n248\t        }\n249\t        drop(d_coeffs_large);\n250\t\n251\t        // Step 5: iDFT to get coefficients\n252\t        unsafe {\n253\t            batch_ntt_small(&mut d_s0_coeffs, log_large_domain, 1, true)\n254\t                .map_err(|e| SumcheckError::BatchNttSmall(e.into()))?;\n255\t        }\n256\t    }\n257\t    // Step 6: Copy to host and convert to extension field\n258\t    let s0_coeffs_host: Vec<F> = d_s0_coeffs.to_host()?;\n259\t    drop(d_s0_coeffs);\n260\t    let s0_coeffs_ext: Vec<EF> = s0_coeffs_host[0..=s_deg]\n261\t        .iter()\n262\t        .map(|&x| EF::from(x))\n263\t        .collect();\n264\t\n265\t    // Step 7: Create polynomial and observe in transcript\n266\t    let s_0 = UnivariatePoly::new(s0_coeffs_ext.clone());\n267\t    for &coeff in &s0_coeffs_ext {\n268\t        transcript.observe_ext(coeff);\n269\t    }\n270\t\n271\t    // Step 8: Sample challenge r_0\n272\t    let r_0 = transcript.sample_ext();\n273\t    debug!(round = 0, r_round = %r_0);\n274\t    r.push(r_0);\n275\t\n276\t    // ========== Fold PLE: Evaluate at r_0 ==========\n277\t\n278\t    let d_folded = DeviceBuffer::<EF>::with_capacity(num_x);\n279\t    unsafe {\n280\t        fold_ple_from_coeffs(\n281\t            d_coeffs.as_ptr(),     // Original input (base field, but modified by iDFT)\n282\t            d_folded.as_mut_ptr(), // Output in extension field\n283\t            num_x as u32,\n284\t            width as u32,\n285\t            domain_size as u32,\n286\t            r_0,\n287\t        )\n288\t        .map_err(|e| SumcheckError::FoldPleFromCoeffs(e.into()))?;\n289\t    }\n290\t    drop(d_coeffs);\n291\t    drop(_round0_span);\n292\t\n293\t    // ========== Rounds 1..n: Regular MLE rounds ==========\n294\t    let _mle_rounds_span = info_span!(\"sumcheck_prismalinear.mle_rounds\").entered();\n295\t\n296\t    let mut current_height = num_x; // After fold_ple, height is 2^n\n297\t    let num_matrices = 1;\n298\t\n299\t    // Allocate ping-pong buffers for MLE rounds\n300\t    let mut d_buffer_a = d_folded; // Reuse folded result\n301\t    let mut d_buffer_b = DeviceBuffer::<EF>::with_capacity(current_height / 2);\n302\t\n303\t    let mut d_input_ptrs = DeviceBuffer::<*const EF>::with_capacity(num_matrices);\n304\t    let mut d_output_ptrs = DeviceBuffer::<*mut EF>::with_capacity(num_matrices);\n305\t    let d_widths = [width as u32].to_device()?;\n306\t    let d_round_output = DeviceBuffer::<EF>::with_capacity(d);\n307\t\n308\t    for round in 1..=n {\n309\t        let (input_buf, output_buf) = if round % 2 == 1 {\n310\t            (&d_buffer_a, &mut d_buffer_b)\n311\t        } else {\n312\t            (&d_buffer_b, &mut d_buffer_a)\n313\t        };\n314\t\n315\t        let input_ptr = input_buf.as_ptr();\n316\t        let output_ptr = output_buf.as_mut_ptr();\n317\t\n318\t        [input_ptr].copy_to(&mut d_input_ptrs)?;\n319\t        [output_ptr].copy_to(&mut d_output_ptrs)?;\n320\t\n321\t        // Sumcheck MLE round\n322\t        unsafe {\n323\t            sumcheck_mle_round(\n324\t                &d_input_ptrs,\n325\t                &d_round_output,\n326\t                output_buf,\n327\t                &d_widths,\n328\t                num_matrices as u32,\n329\t                current_height as u32,\n330\t                d as u32,\n331\t            )\n332\t            .map_err(|e| SumcheckError::SumcheckMleRound(e.into()))?;\n333\t        }\n334\t\n335\t        let h_round_output = d_round_output.to_host()?;\n336\t        let s = h_round_output[0..d].to_vec();\n337\t        assert_eq!(s.len(), d);\n338\t        transcript.observe_ext(s[0]);\n339\t        round_polys_eval.push(s);\n340\t\n341\t        let r_round = transcript.sample_ext();\n342\t        debug!(%round, %r_round);\n343\t        r.push(r_round);\n344\t\n345\t        // Fold MLE\n346\t        let output_height = (current_height >> 1) as u32;\n347\t        unsafe {\n348\t            fold_mle(\n349\t                &d_input_ptrs,\n350\t                &d_output_ptrs,\n351\t                &d_widths,\n352\t                num_matrices.try_into().unwrap(),\n353\t                output_height,\n354\t                width as u32 * output_height,\n355\t                r_round,\n356\t            )\n357\t            .map_err(|e| SumcheckError::FoldMle(e.into()))?;\n358\t        }\n359\t\n360\t        current_height >>= 1;\n361\t    }\n362\t    drop(_mle_rounds_span);\n363\t\n364\t    // Get final evaluation claim\n365\t    let final_buf = if n % 2 == 1 { &d_buffer_b } else { &d_buffer_a };\n366\t    let eval_claim_vec = final_buf.to_host()?;\n367\t    let eval_claim = eval_claim_vec[0];\n368\t\n369\t    transcript.observe_ext(eval_claim);\n370\t\n371\t    Ok((\n372\t        SumcheckPrismProof {\n373\t            sum_claim,\n374\t            s_0,\n375\t            round_polys_eval,\n376\t            eval_claim,\n377\t        },\n378\t        r,\n379\t    ))\n380\t}\n381\t"}]},"parent_tool_use_id":"toolu_01Rnk8wYpuYMwBcrmjGUurAV","session_id":"00f14df6-1cef-48ea-af88-42c3b73a9be4","uuid":"5e619bfc-0cff-450f-8644-ad3a3eaaa0e6","timestamp":"2026-04-14T21:51:43.839Z"}
