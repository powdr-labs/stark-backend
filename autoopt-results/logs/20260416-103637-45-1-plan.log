{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KPm6rGjwJDE6kFNzfvHPkq","type":"tool_result","content":"1\tuse std::{ffi::c_void, fmt::Debug, ptr};\n2\t\n3\tuse crate::{\n4\t    copy::MemCopyD2H,\n5\t    error::{check, CudaError},\n6\t    memory_manager::{d_free, d_malloc},\n7\t    stream::{cudaStreamPerThread, cudaStream_t},\n8\t};\n9\t\n10\t#[link(name = \"cudart\")]\n11\textern \"C\" {\n12\t    pub fn cudaMemsetAsync(dst: *mut c_void, value: i32, count: usize, stream: cudaStream_t)\n13\t        -> i32;\n14\t}\n15\t\n16\t/// Struct that owns a buffer allocated on GPU device. The struct only holds the raw pointer and\n17\t/// length, but this struct has a `Drop` implementation which frees the associated device memory.\n18\t///\n19\t/// When `owns_memory` is false, the buffer is a non-owning view into device memory and will NOT\n20\t/// free the memory on drop. This is used for creating sub-region views into larger buffers.\n21\t#[repr(C)]\n22\tpub struct DeviceBuffer<T> {\n23\t    ptr: *mut T,\n24\t    len: usize,\n25\t    owns_memory: bool,\n26\t}\n27\t\n28\t/// A struct that packs a pointer with a size in bytes to pass on CUDA.\n29\t/// It holds `*const c_void` for being a universal simple type that can be read by CUDA.\n30\t/// Since it is hard to enforce immutability preservation, it just holds `*const`,\n31\t/// but has two separate constructors for more robustness from the usage perspective.\n32\t/// This is essentially a [DeviceBuffer] but without owning the data.\n33\t#[repr(C)]\n34\t#[derive(Debug, Copy, Clone)]\n35\tpub struct DeviceBufferView {\n36\t    pub ptr: *const c_void,\n37\t    pub size: usize,\n38\t}\n39\t\n40\tunsafe impl<T> Send for DeviceBuffer<T> {}\n41\tunsafe impl<T> Sync for DeviceBuffer<T> {}\n42\t\n43\timpl<T> DeviceBuffer<T> {\n44\t    /// Creates an \"empty\" DeviceBuffer with a null pointer and zero length.\n45\t    #[allow(clippy::new_without_default)]\n46\t    pub fn new() -> Self {\n47\t        DeviceBuffer {\n48\t            ptr: ptr::null_mut(),\n49\t            len: 0,\n50\t            owns_memory: true,\n51\t        }\n52\t    }\n53\t\n54\t    /// # Safety\n55\t    /// - The caller must ensure that the pointer `ptr` is valid for `len` elements of type `T` in\n56\t    ///   device memory.\n57\t    /// - Dropping the constructed buffer will attempt to free the memory. As such, `ptr` must\n58\t    ///   either have been allocated by the internal memory manager (VPMM) or the caller must use\n59\t    ///   `ManuallyDrop` to prevent double-free.\n60\t    pub unsafe fn from_raw_parts(ptr: *mut T, len: usize) -> Self {\n61\t        DeviceBuffer {\n62\t            ptr,\n63\t            len,\n64\t            owns_memory: true,\n65\t        }\n66\t    }\n67\t\n68\t    /// Creates a non-owning view into device memory. The view will NOT free the memory on drop.\n69\t    ///\n70\t    /// # Safety\n71\t    /// The caller must ensure that:\n72\t    /// - `ptr` points to valid device memory for `len` elements of type `T`\n73\t    /// - The underlying memory remains valid for the lifetime of this buffer\n74\t    pub unsafe fn non_owning(ptr: *mut T, len: usize) -> Self {\n75\t        DeviceBuffer {\n76\t            ptr,\n77\t            len,\n78\t            owns_memory: false,\n79\t        }\n80\t    }\n81\t\n82\t    /// Allocate device memory for `len` elements of type `T`.\n83\t    pub fn with_capacity(len: usize) -> Self {\n84\t        tracing::debug!(\n85\t            \"Creating device buffer of size {} (sizeof type = {})\",\n86\t            len,\n87\t            size_of::<T>()\n88\t        );\n89\t        assert_ne!(len, 0, \"Zero capacity request is wrong\");\n90\t        let size_bytes = std::mem::size_of::<T>() * len;\n91\t        let raw_ptr = d_malloc(size_bytes).expect(\"GPU allocation failed\");\n92\t        #[cfg(feature = \"touchemall\")]\n93\t        {\n94\t            // 0xffffffff is `Fp::invalid()` and shouldn't occur in a trace\n95\t            unsafe {\n96\t                cudaMemsetAsync(raw_ptr, 0xff, size_bytes, cudaStreamPerThread);\n97\t            }\n98\t        }\n99\t        let typed_ptr = raw_ptr as *mut T;\n100\t\n101\t        DeviceBuffer {\n102\t            ptr: typed_ptr,\n103\t            len,\n104\t            owns_memory: true,\n105\t        }\n106\t    }\n107\t\n108\t    /// Fills the buffer with zeros.\n109\t    pub fn fill_zero(&self) -> Result<(), CudaError> {\n110\t        assert_ne!(self.len, 0, \"Empty buffer\");\n111\t        let size_bytes = std::mem::size_of::<T>() * self.len;\n112\t        check(unsafe { cudaMemsetAsync(self.as_mut_raw_ptr(), 0, size_bytes, cudaStreamPerThread) })\n113\t    }\n114\t\n115\t    /// Fills a suffix of the buffer with zeros.\n116\t    /// The `start_idx` is the index in the buffer, in `T` elements.\n117\t    pub fn fill_zero_suffix(&self, start_idx: usize) -> Result<(), CudaError> {\n118\t        assert!(\n119\t            start_idx < self.len,\n120\t            \"start index has to be smaller than length\"\n121\t        );\n122\t        let size_bytes = std::mem::size_of::<T>() * (self.len - start_idx);\n123\t        check(unsafe {\n124\t            cudaMemsetAsync(\n125\t                self.as_mut_ptr().add(start_idx) as *mut c_void,\n126\t                0,\n127\t                size_bytes,\n128\t                cudaStreamPerThread,\n129\t            )\n130\t        })\n131\t    }\n132\t\n133\t    /// Returns the number of elements in this buffer.\n134\t    pub fn len(&self) -> usize {\n135\t        self.len\n136\t    }\n137\t\n138\t    /// Returns whether the buffer is empty (null pointer or zero length).\n139\t    pub fn is_empty(&self) -> bool {\n140\t        self.len == 0 || self.ptr.is_null()\n141\t    }\n142\t\n143\t    /// Returns a raw mutable pointer to the device data (typed).\n144\t    pub fn as_mut_ptr(&self) -> *mut T {\n145\t        self.ptr\n146\t    }\n147\t\n148\t    /// Returns a raw const pointer to the device data (typed).\n149\t    pub fn as_ptr(&self) -> *const T {\n150\t        self.ptr as *const T\n151\t    }\n152\t\n153\t    /// Returns a `*mut c_void` (untyped) pointer.\n154\t    pub fn as_mut_raw_ptr(&self) -> *mut c_void {\n155\t        self.ptr as *mut c_void\n156\t    }\n157\t\n158\t    /// Returns a `*const c_void` (untyped) pointer.\n159\t    pub fn as_raw_ptr(&self) -> *const c_void {\n160\t        self.ptr as *const c_void\n161\t    }\n162\t\n163\t    /// Converts the buffer to a buffer of different type.\n164\t    /// `T` must be composable of `U`s.\n165\t    pub fn as_buffer<U>(mut self) -> DeviceBuffer<U> {\n166\t        assert_eq!(\n167\t            size_of::<T>() % size_of::<U>(),\n168\t            0,\n169\t            \"the underlying type size must divide the former one\"\n170\t        );\n171\t        assert_eq!(\n172\t            align_of::<T>() % align_of::<U>(),\n173\t            0,\n174\t            \"the underlying type alignment must divide the former one\"\n175\t        );\n176\t        let res = DeviceBuffer {\n177\t            ptr: self.ptr as *mut U,\n178\t            len: self.len * (size_of::<T>() / size_of::<U>()),\n179\t            owns_memory: self.owns_memory,\n180\t        };\n181\t        self.ptr = ptr::null_mut(); // for safe drop\n182\t        self.len = 0;\n183\t        res\n184\t    }\n185\t\n186\t    pub fn view(&self) -> DeviceBufferView {\n187\t        DeviceBufferView {\n188\t            ptr: self.ptr as *const c_void,\n189\t            size: self.len * size_of::<T>(),\n190\t        }\n191\t    }\n192\t}\n193\t\n194\timpl<T> Drop for DeviceBuffer<T> {\n195\t    fn drop(&mut self) {\n196\t        if self.owns_memory && !self.ptr.is_null() {\n197\t            tracing::debug!(\n198\t                \"Freeing device buffer of size {} (sizeof type = {})\",\n199\t                self.len,\n200\t                size_of::<T>()\n201\t            );\n202\t            unsafe {\n203\t                d_free(self.ptr as *mut c_void).expect(\"GPU free failed\");\n204\t            }\n205\t            self.ptr = ptr::null_mut();\n206\t            self.len = 0;\n207\t        }\n208\t    }\n209\t}\n210\t\n211\timpl<T: Debug> Debug for DeviceBuffer<T> {\n212\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n213\t        let host_vec = self.to_host().unwrap();\n214\t        write!(f, \"DeviceBuffer (len = {}): {:?}\", self.len(), host_vec)\n215\t    }\n216\t}\n217\t\n218\t#[cfg(test)]\n219\tmod tests {\n220\t    use super::*;\n221\t    use crate::copy::MemCopyH2D;\n222\t\n223\t    #[test]\n224\t    fn test_device_buffer_float() {\n225\t        // Create a DeviceBuffer of 10 floats\n226\t        let db = DeviceBuffer::<f32>::with_capacity(10);\n227\t\n228\t        assert_eq!(db.len(), 10);\n229\t        assert!(!db.as_ptr().is_null());\n230\t        assert!(!db.is_empty());\n231\t\n232\t        // The buffer will be automatically freed at the end of this test\n233\t    }\n234\t\n235\t    #[test]\n236\t    fn test_device_buffer_fill_zero() {\n237\t        let v: Vec<u64> = (0..10).collect();\n238\t        let d_array = v.to_device().unwrap();\n239\t        d_array.fill_zero().unwrap();\n240\t        assert_eq!(d_array.to_host().unwrap(), vec![0; v.len()]);\n241\t    }\n242\t}\n243\t"}]},"parent_tool_use_id":"toolu_01FpUXj5rMDdJzQNh4MtL5WB","session_id":"78bbe79a-49aa-4ea3-b7e0-2913b403757d","uuid":"cb2cf178-da4a-4123-b4cf-b9cbdf178d17","timestamp":"2026-04-16T09:25:40.452Z"}
