{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VfhVyi61TexwSJ7tRRwce3","type":"tool_result","content":"650\t        alpha,\n651\t        apply_alpha,\n652\t    ))\n653\t}\n654\t\n655\t/// Fused two-layer tree build kernel.\n656\t/// `half_i1` = N >> (i+2), where i is the first of the two layers being fused.\n657\tpub unsafe fn frac_build_tree_two_layers(\n658\t    layer: &mut DeviceBuffer<Frac<EF>>,\n659\t    half_i1: usize,\n660\t) -> Result<(), CudaError> {\n661\t    CudaError::from_result(_frac_build_tree_two_layers(layer.as_mut_ptr(), half_i1))\n662\t}\n663\t\n664\t// `eq_xi` will not store evaluations for the first hypercube coordinate because the prover factors\n665\t// out the first eq term.\n666\t#[allow(clippy::too_many_arguments)]\n667\tpub unsafe fn frac_compute_round(\n668\t    eq_xi: &SqrtEqLayers,\n669\t    pq_buffer: &DeviceBuffer<Frac<EF>>,\n670\t    num_x: usize,\n671\t    lambda: EF,\n672\t    out_device: &mut DeviceBuffer<EF>,\n673\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n674\t) -> Result<(), CudaError> {\n675\t    let low_n = eq_xi.low_n();\n676\t    let high_n = eq_xi.high_n();\n677\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n678\t    debug_assert!(pq_buffer.len() >= 2 * num_x);\n679\t    #[cfg(debug_assertions)]\n680\t    {\n681\t        let len = tmp_block_sums.len();\n682\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n683\t        assert!(\n684\t            len >= required as usize,\n685\t            \"tmp_block_sums len={len} < required={required}\"\n686\t        );\n687\t    }\n688\t    CudaError::from_result(_frac_compute_round(\n689\t        eq_xi.low.get_ptr(low_n),\n690\t        eq_xi.high.get_ptr(high_n),\n691\t        pq_buffer.as_ptr(),\n692\t        num_x,\n693\t        1 << low_n,\n694\t        lambda,\n695\t        out_device.as_mut_ptr(),\n696\t        tmp_block_sums.as_mut_ptr(),\n697\t    ))\n698\t}\n699\t\n700\t/// Fused compute round + tree layer revert kernel.\n701\t///\n702\t/// Combines `frac_build_tree_layer(revert=true)` with `compute_round` for the first inner round.\n703\t/// The revert operation modifies `layer` in-place: `layer[i] = layer[i] - layer[i + half]` for `i <\n704\t/// half`.\n705\t///\n706\t/// This eliminates one kernel launch per outer round.\n707\t#[allow(clippy::too_many_arguments)]\n708\tpub unsafe fn frac_compute_round_and_revert(\n709\t    eq_xi: &SqrtEqLayers,\n710\t    layer: &mut DeviceBuffer<Frac<EF>>,\n711\t    num_x: usize,\n712\t    lambda: EF,\n713\t    out_device: &mut DeviceBuffer<EF>,\n714\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n715\t) -> Result<(), CudaError> {\n716\t    let low_n = eq_xi.low_n();\n717\t    let high_n = eq_xi.high_n();\n718\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n719\t    #[cfg(debug_assertions)]\n720\t    {\n721\t        let len = tmp_block_sums.len();\n722\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n723\t        assert!(\n724\t            len >= required as usize,\n725\t            \"tmp_block_sums len={len} < required={required}\"\n726\t        );\n727\t        assert!(layer.len() >= 2 * num_x, \"layer too small for pq_size\");\n728\t    }\n729\t    CudaError::from_result(_frac_compute_round_and_revert(\n730\t        eq_xi.low.get_ptr(low_n),\n731\t        eq_xi.high.get_ptr(high_n),\n732\t        layer.as_mut_ptr(),\n733\t        num_x,\n734\t        1 << low_n,\n735\t        lambda,\n736\t        out_device.as_mut_ptr(),\n737\t        tmp_block_sums.as_mut_ptr(),\n738\t    ))\n739\t}\n740\t\n741\t/// Folds `Frac<EF>` buffer. Pairs (idx, idx+quarter) and (idx+half, idx+3*quarter),\n742\t/// writes results to dst[idx] and dst[idx+quarter]. Output size is `size / 2`.\n743\t/// Safe for src == dst (in-place) because each thread handles disjoint indices.\n744\tpub unsafe fn fold_ef_frac_columns(\n745\t    src: &DeviceBuffer<Frac<EF>>,\n746\t    dst: &mut DeviceBuffer<Frac<EF>>,\n747\t    size: usize,\n748\t    r: EF,\n749\t) -> Result<(), CudaError> {\n750\t    debug_assert!(src.len() >= size);\n751\t    debug_assert!(dst.len() >= size / 2);\n752\t    CudaError::from_result(_frac_fold_fpext_columns(\n753\t        src.as_ptr(),\n754\t        dst.as_mut_ptr(),\n755\t        size,\n756\t        r,\n757\t    ))\n758\t}\n759\t\n760\t/// In-place fold. See [`fold_ef_frac_columns`] for details.\n761\tpub unsafe fn fold_ef_frac_columns_inplace(\n762\t    buffer: &mut DeviceBuffer<Frac<EF>>,\n763\t    size: usize,\n764\t    r: EF,\n765\t) -> Result<(), CudaError> {\n766\t    debug_assert!(buffer.len() >= size);\n767\t    let ptr = buffer.as_mut_ptr();\n768\t    CudaError::from_result(_frac_fold_fpext_columns(ptr, ptr, size, r))\n769\t}\n770\t\n771\t/// Fused compute round + fold kernel.\n772\t///\n773\t/// Reads from pre-fold `src_pq_buffer` (size `src_pq_size`), performs fold-on-the-fly using\n774\t/// `r_prev`, computes s' polynomial evaluations (degree 2), and writes folded output to\n775\t/// `dst_pq_buffer` (size `src_pq_size/2`).\n776\t///\n777\t/// This fuses the fold operation into the next round's compute, eliminating one kernel launch per\n778\t/// inner round and reducing memory traffic.\n779\t///\n780\t/// The eq_xi layers should have max_n = log2(src_pq_size / 4) = log2(post-fold num_x).\n781\t#[allow(clippy::too_many_arguments)]\n782\tpub unsafe fn frac_compute_round_and_fold(\n783\t    eq_xi: &SqrtEqLayers,\n784\t    src_pq_buffer: &DeviceBuffer<Frac<EF>>,\n785\t    dst_pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n786\t    src_pq_size: usize,\n787\t    lambda: EF,\n788\t    r_prev: EF,\n789\t    out_device: &mut DeviceBuffer<EF>,\n790\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n791\t) -> Result<(), CudaError> {\n792\t    let low_n = eq_xi.low_n();\n793\t    let high_n = eq_xi.high_n();\n794\t    // Post-fold: num_x = src_pq_size / 4\n795\t    let num_x = src_pq_size >> 2;\n796\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n797\t    #[cfg(debug_assertions)]\n798\t    {\n799\t        assert!(src_pq_size > 2, \"src_pq_size must be > 2\");\n800\t        let pq_size = src_pq_size >> 1;\n801\t        assert!(num_x > 0, \"num_x must be > 0\");\n802\t        assert!(\n803\t            src_pq_buffer.len() >= src_pq_size,\n804\t            \"src_pq_buffer too small: {} < {}\",\n805\t            src_pq_buffer.len(),\n806\t            src_pq_size\n807\t        );\n808\t        assert!(\n809\t            dst_pq_buffer.len() >= pq_size,\n810\t            \"dst_pq_buffer too small: {} < {}\",\n811\t            dst_pq_buffer.len(),\n812\t            pq_size\n813\t        );\n814\t        let len = tmp_block_sums.len();\n815\t        let required = _frac_compute_round_temp_buffer_size(num_x as u32);\n816\t        assert!(\n817\t            len >= required as usize,\n818\t            \"tmp_block_sums len={len} < required={required}\"\n819\t        );\n820\t    }\n821\t    CudaError::from_result(_frac_compute_round_and_fold(\n822\t        eq_xi.low.get_ptr(low_n),\n823\t        eq_xi.high.get_ptr(high_n),\n824\t        src_pq_buffer.as_ptr(),\n825\t        dst_pq_buffer.as_mut_ptr(),\n826\t        src_pq_size,\n827\t        1 << low_n,\n828\t        lambda,\n829\t        r_prev,\n830\t        out_device.as_mut_ptr(),\n831\t        tmp_block_sums.as_mut_ptr(),\n832\t    ))\n833\t}\n834\t\n835\t/// In-place fused compute round + fold kernel. See [`frac_compute_round_and_fold`] for details.\n836\t///\n837\t/// Uses a dedicated in-place kernel that doesn't have `__restrict__` on the pq pointer,\n838\t/// avoiding undefined behavior from aliased restrict pointers.\n839\t///\n840\t/// **IN-PLACE SAFETY:** Each thread writes only to indices it reads from in the first half of the\n841\t/// buffer, so there are no cross-thread conflicts. The second half is read-only.\n842\t#[allow(clippy::too_many_arguments)]\n843\tpub unsafe fn frac_compute_round_and_fold_inplace(\n844\t    eq_xi: &SqrtEqLayers,\n845\t    pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n846\t    src_pq_size: usize,\n847\t    lambda: EF,\n848\t    r_prev: EF,\n849\t    out_device: &mut DeviceBuffer<EF>,\n850\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n851\t) -> Result<(), CudaError> {\n852\t    let low_n = eq_xi.low_n();\n853\t    let high_n = eq_xi.high_n();\n854\t    // Post-fold: num_x = src_pq_size / 4\n855\t    let num_x = src_pq_size >> 2;\n856\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n857\t    #[cfg(debug_assertions)]\n858\t    {\n859\t        assert!(src_pq_size > 2, \"src_pq_size must be > 2\");\n860\t        assert!(num_x > 0, \"num_x must be > 0\");\n861\t        assert!(\n862\t            pq_buffer.len() >= src_pq_size,\n863\t            \"pq_buffer too small: {} < {}\",\n864\t            pq_buffer.len(),\n865\t            src_pq_size\n866\t        );\n867\t        let len = tmp_block_sums.len();\n868\t        let required = _frac_compute_round_temp_buffer_size(num_x as u32);\n869\t        assert!(\n870\t            len >= required as usize,\n871\t            \"tmp_block_sums len={len} < required={required}\"\n872\t        );\n873\t    }\n874\t    CudaError::from_result(_frac_compute_round_and_fold_inplace(\n875\t        eq_xi.low.get_ptr(low_n),\n876\t        eq_xi.high.get_ptr(high_n),\n877\t        pq_buffer.as_mut_ptr(),\n878\t        src_pq_size,\n879\t        1 << low_n,\n880\t        lambda,\n881\t        r_prev,\n882\t        out_device.as_mut_ptr(),\n883\t        tmp_block_sums.as_mut_ptr(),\n884\t    ))\n885\t}\n886\t\n887\t#[allow(clippy::too_many_arguments)]\n888\tpub unsafe fn frac_precompute_m_build_raw(\n889\t    pq: *const Frac<EF>,\n890\t    rem_n: usize,\n891\t    w: usize,\n892\t    lambda: EF,\n893\t    r_prev: EF,\n894\t    inline_fold: bool,\n895\t    eq_tail_low: *const EF,\n896\t    eq_tail_high: *const EF,\n897\t    eq_tail_low_cap: usize,\n898\t    tail_tile: usize,\n899\t    partial_out: *mut EF,\n900\t    partial_len: usize,\n901\t    m_total: *mut EF,\n902\t) -> Result<(),