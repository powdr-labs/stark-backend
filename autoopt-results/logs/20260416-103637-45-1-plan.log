{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bzqk4vXjKd8KhLYGWWoNGe","type":"tool_result","content":"200\t        current_log_step += 1;\n201\t    }\n202\t\n203\t    Ok(())\n204\t}\n205\t\n206\t/// Given vector `x` in `F^n`, populates `out` with `eq_n(x, y)` for `y` on hypercube `H_n`.\n207\t///\n208\t/// Note: This function launches `n` CUDA kernels.\n209\t///\n210\t/// The multilinear equality polynomial is defined as:\n211\t/// ```text\n212\t///     eq(x, z) = \\prod_{i=0}^{n-1} (x_i z_i + (1 - x_i)(1 - z_i)).\n213\t/// ```\n214\t///\n215\t/// # Safety\n216\t/// - `n` is set to the length of `xs`.\n217\t/// - `out` must have length `>= 2^n`.\n218\tpub unsafe fn evals_eq_hypercube(out: &mut DeviceBuffer<EF>, xs: &[EF]) -> Result<(), KernelError> {\n219\t    let n = xs.len();\n220\t    assert!(out.len() >= 1 << n);\n221\t    // Use memcpy instead of memset since EF will be in Montgomery form.\n222\t    [EF::ONE].copy_to(out).map_err(KernelError::MemCopy)?;\n223\t\n224\t    for (i, &x_i) in xs.iter().enumerate() {\n225\t        let step = 1 << i;\n226\t        eq_hypercube_stage_ext(out.as_mut_ptr(), x_i, step).map_err(KernelError::Kernel)?;\n227\t    }\n228\t    Ok(())\n229\t}\n230\t\n231\t/// Given vector `u_tilde` in `F^n`, populates `out` with `mobius_eq(u_tilde, y)` for `y` on\n232\t/// hypercube `H_n`.\n233\t///\n234\t/// The Möbius-adjusted equality kernel is defined as:\n235\t/// ```text\n236\t///     mobius_eq(u_tilde, y) = \\prod_{i=0}^{n-1} ((1 - 2*u_tilde_i)(1 - y_i) + u_tilde_i * y_i).\n237\t/// ```\n238\t///\n239\t/// Note: This function launches `n` CUDA kernels.\n240\t///\n241\t/// # Safety\n242\t/// - `n` is set to the length of `omega`.\n243\t/// - `out` must have length `>= 2^n`.\n244\tpub unsafe fn evals_mobius_eq_hypercube(\n245\t    out: &mut DeviceBuffer<EF>,\n246\t    omega: &[EF],\n247\t) -> Result<(), KernelError> {\n248\t    let n = omega.len();\n249\t    assert!(out.len() >= 1 << n);\n250\t    // Use memcpy instead of memset since EF will be in Montgomery form.\n251\t    [EF::ONE].copy_to(out).map_err(KernelError::MemCopy)?;\n252\t\n253\t    for (i, &omega_i) in omega.iter().enumerate() {\n254\t        let step = 1 << i;\n255\t        mobius_eq_hypercube_stage_ext(out.as_mut_ptr(), omega_i, step)\n256\t            .map_err(KernelError::Kernel)?;\n257\t    }\n258\t    Ok(())\n259\t}\n260\t\n261\t/// For a fixed `x` in `F^max_n`, stores the evaluations of `eq_n(x[..n], -)` on hypercube `H_n` for\n262\t/// `n = 0..=max_n`. The evaluations are stored contiguously in a single buffer of length `2^(max_n\n263\t/// + 1)`. We define `eq_0 = 1` always.\n264\t#[derive(Getters)]\n265\tpub struct EqEvalSegments<F> {\n266\t    /// Index 0 should never to read, but it will be initialized to zero.\n267\t    #[getset(get = \"pub\")]\n268\t    pub(crate) buffer: DeviceBuffer<F>,\n269\t    #[getset(get_copy = \"pub\")]\n270\t    max_n: usize,\n271\t}\n272\t\n273\timpl<F> EqEvalSegments<F> {\n274\t    /// Returns start pointer for buffer of length `2^n` corresponding to evaluations of `eq(x[..n],\n275\t    /// -)` on `H_n`.\n276\t    pub fn get_ptr(&self, n: usize) -> *const F {\n277\t        assert!(n <= self.max_n);\n278\t        // SAFETY: `buffer` has length `2^{max_n + 1}`\n279\t        unsafe { self.buffer.as_ptr().add(1 << n) }\n280\t    }\n281\t\n282\t    /// # Safety\n283\t    /// Caller must ensure that `buffer` has length `2^{max_n + 1}` and is properly initialized.\n284\t    pub unsafe fn from_raw_parts(buffer: DeviceBuffer<F>, max_n: usize) -> Self {\n285\t        Self { buffer, max_n }\n286\t    }\n287\t}\n288\t\n289\t// Currently only implement kernels for EF.\n290\timpl EqEvalSegments<EF> {\n291\t    /// Creates a new `EqEvalSegments` instance with `max_n = x.len()`.\n292\t    pub fn new(x: &[EF]) -> Result<Self, KernelError> {\n293\t        let max_n = x.len();\n294\t        let mut buffer = DeviceBuffer::with_capacity(2 << max_n);\n295\t        // Index 0 should never to be used, but we initialize it to zero.\n296\t        // Index 1 is set to eq_0 = 1 for initial state\n297\t        [EF::ZERO, EF::ONE]\n298\t            .copy_to(&mut buffer)\n299\t            .map_err(KernelError::MemCopy)?;\n300\t        // At step i, we populate `eq_{i+1}` starting at offset `2^{i+1}`\n301\t        for (i, &x_i) in x.iter().enumerate() {\n302\t            let step = 1 << i;\n303\t            // SAFETY:\n304\t            // - `buffer` has length `2^{max_n + 1}`\n305\t            // - `2 * 2^{i+1} <= 2^{max_n + 1}` ensures everything is in bounds\n306\t            unsafe {\n307\t                // The `eq_{i+1}` segment starts at offset `2^{i+1}`\n308\t                let dst = buffer.as_mut_ptr().add(2 * step);\n309\t                // The `eq_i` segment starts at offset `2^i`\n310\t                let src = buffer.as_ptr().add(step);\n311\t                eq_hypercube_nonoverlapping_stage_ext(dst, src, x_i, step as u32)\n312\t                    .map_err(KernelError::Kernel)?;\n313\t            }\n314\t        }\n315\t        Ok(Self { buffer, max_n })\n316\t    }\n317\t}\n318\t\n319\t/// Same as [EqEvalSegments] but keeping segment tree with buffers separated by layer to allow\n320\t/// dropping layers.\n321\t#[derive(Getters)]\n322\tpub struct EqEvalLayers<F> {\n323\t    /// Index 0 should never to read, but it will be initialized to zero.\n324\t    pub layers: Vec<DeviceBuffer<F>>,\n325\t}\n326\t\n327\timpl<F> EqEvalLayers<F> {\n328\t    /// Returns start pointer for buffer of length `2^n` corresponding to evaluations of `eq(x[..n],\n329\t    /// -)` on `H_n`.\n330\t    pub fn get_ptr(&self, n: usize) -> *const F {\n331\t        debug_assert_eq!(self.layers[n].len(), 1 << n);\n332\t        self.layers[n].as_ptr()\n333\t    }\n334\t}\n335\t\n336\t// Currently only implement kernels for EF.\n337\timpl EqEvalLayers<EF> {\n338\t    /// Creates a new `EqEvalLayers` instance with `layers.len() = x.len() + 1`.\n339\t    ///\n340\t    /// Inserts `x_i` from the front for each layer.\n341\t    pub fn new_rev<'a>(n: usize, x: impl IntoIterator<Item = &'a EF>) -> Result<Self, KernelError> {\n342\t        let mut layers = Vec::with_capacity(n + 1);\n343\t        let layer_0 = [EF::ONE].to_device().map_err(KernelError::MemCopy)?;\n344\t        layers.push(layer_0);\n345\t        for (i, &x_i) in x.into_iter().enumerate() {\n346\t            let step = 1 << i;\n347\t            let buffer = DeviceBuffer::with_capacity(2 * step);\n348\t            // SAFETY:\n349\t            // - `buffer` has length `2^{i+1}`\n350\t            unsafe {\n351\t                let dst = buffer.as_mut_ptr();\n352\t                let src = layers.last().unwrap().as_ptr();\n353\t                eq_hypercube_interleaved_stage_ext(dst, src, x_i, step as u32)\n354\t                    .map_err(KernelError::Kernel)?;\n355\t            }\n356\t            layers.push(buffer);\n357\t        }\n358\t        Ok(Self { layers })\n359\t    }\n360\t\n361\t    /// Creates a new `EqEvalLayers` instance with `layers.len() = x.len() + 1`.\n362\t    ///\n363\t    /// Inserts `x_i` from the back for each layer. This matches behavior of\n364\t    /// [`EqEvalSegments::new`].\n365\t    pub fn new<'a>(n: usize, x: impl IntoIterator<Item = &'a EF>) -> Result<Self, KernelError> {\n366\t        let mut layers = Vec::with_capacity(n + 1);\n367\t        let layer_0 = [EF::ONE].to_device().map_err(KernelError::MemCopy)?;\n368\t        layers.push(layer_0);\n369\t        for (i, &x_i) in x.into_iter().enumerate() {\n370\t            let step = 1 << i;\n371\t            let buffer = DeviceBuffer::with_capacity(2 * step);\n372\t            // SAFETY:\n373\t            // - `buffer` has length `2^{i+1}`\n374\t            unsafe {\n375\t                let dst = buffer.as_mut_ptr();\n376\t                let src = layers.last().unwrap().as_ptr();\n377\t                eq_hypercube_nonoverlapping_stage_ext(dst, src, x_i, step as u32)\n378\t                    .map_err(KernelError::Kernel)?;\n379\t            }\n380\t            layers.push(buffer);\n381\t        }\n382\t        Ok(Self { layers })\n383\t    }\n384\t}\n385\t\n386\t/// Square-root decomposition of hypercube equality buffer for memory optimization.\n387\t///\n388\t/// Instead of storing a single buffer of size 2^n, we store two buffers of size\n389\t/// 2^(n/2), reducing memory usage from O(2^n) to O(2*2^(n/2)). The full value at\n390\t/// index i is computed on-the-fly as: low[i % low_cap] * high[i / low_cap]\n391\tpub struct SqrtHyperBuffer {\n392\t    pub low: DeviceBuffer<EF>,\n393\t    pub high: DeviceBuffer<EF>,\n394\t    pub low_capacity: usize,\n395\t    pub size: usize,\n396\t}\n397\t\n398\timpl SqrtHyperBuffer {\n399\t    /// Build a buffer from `xi`. Note that last elements of `xi` correspond to the lowest index\n400\t    /// bits.\n401\t    pub fn from_xi(xi: &[EF]) -> Result<Self, KernelError> {\n402\t        let low = {\n403\t            let mut res = DeviceBuffer::with_capacity(1 << (xi.len() / 2));\n404\t            unsafe { evals_eq_hypercube(&mut res, &xi[..xi.len() / 2])? };\n405\t            res\n406\t        };\n407\t        let high = {\n408\t            let mut res = DeviceBuffer::with_capacity(1 << xi.len().div_ceil(2));\n409\t            unsafe { evals_eq_hypercube(&mut res, &xi[xi.len() / 2..])? };\n410\t            res\n411\t        };\n412\t        Ok(Self {\n413\t            low,\n414\t            high,\n415\t            low_capacity: 1 << (xi.len() / 2),\n416\t            size: 1 << xi.len(),\n417\t        })\n418\t    }\n419\t\n420\t    pub fn fold_columns(&mut self, r: EF) -> Result<(), CudaError> {\n421\t        assert!(self.size > 1);\n422\t        if self.size > self.low_capacity {\n423\t            unsafe {\n424\t                fold_mle_column(&mut self.high, self.size / self.low_capacity, r)?;\n425\t            }\n426\t        } else {\n427\t            unsafe {\n428\t                fold_mle_column(&mut self.low, self.size, r)?;\n429\t            }\n430\t        };\n431\t        self.size /= 2;\n432\t        Ok(())\n433\t    }\n434\t}\n435\t\n436\t/// Square-root decomposition using pre-computed eq evaluation layers.\n437\t///\n438\t/// Instead of folding columns on GPU, we pre-compute all layers of eq evaluations\n439\t/// and simply drop the highest layer each round (no GPU work needed).\n440\tpub struct SqrtEqLayers {\n441\t    /// Layers for `xi[(n + 1) / 2..]`. Layers insert `xi_i` from the front, so `low` contains the\n442\t    /// latter half of `xi`.\n443\t    pub low: EqEvalLayers<EF>,\n444\t    /// Layers for `xi[..(n + 1) / 2]`.\n445\t    /// Layers: [ eq(xi[j..(n+1)/2], ..) ] for j = (0..(n+1)/2).rev()\n446\t    pub high: EqEvalLayers<EF>,\n447\t}\n448\t\n449\timpl SqrtEqLayers {\n450\t    /// Build layers from `xi` values.\n451\t    ///\n452\t    /// This is meant to match behavior of [SqrtHyperBuffer::from_xi] but with layers.\n453\t    ///\n454\t    /// Example: This means `[a,b,c,d]` should be sent to `low: [[d], [d, c]], high: [[b], [b, a]]`.\n455\t    pub fn from_xi(xi: &[EF]) -> Result<Self, KernelError> {\n456\t        let n = xi.len();\n457\t        let low_n = n / 2;\n458\t        let high_n = n - low_n;\n459\t\n460\t        let low = EqEvalLayers::new(low_n, xi[high_n..].iter().rev())?;\n461\t        let high = EqEvalLayers::new(high_n, xi[..high_n].iter().rev())?;\n462\t\n463\t        Ok(Self { low, high })\n464\t    }\n465\t\n466\t    pub fn max_n(&self) -> usize {\n467\t        self.low_n() + self.high_n()\n468\t    }\n469\t\n470\t    pub fn low_n(&self) -> usize {\n471\t        self.low.layers.len() - 1\n472\t    }\n473\t\n474\t    pub fn high_n(&self) -> usize {\n475\t        self.high.layers.len() - 1\n476\t    }\n477\t\n478\t    /// Drop the highest layer. Drops from high first, then low. This corresponding to `pop_front`\n479\t    /// from `xi`.\n480\t    pub fn drop_layer(&mut self) {\n481\t        if self.high.layers.len() > 1 {\n482\t            self.high.layers.pop();\n483\t        } else if self.low.layers.len() > 1 {\n484\t            self.low.layers.pop();\n485\t        }\n486\t    }\n487\t}\n488\t"}]},"parent_tool_use_id":"toolu_0162mM37dPxajrNVmEiwG5wx","session_id":"78bbe79a-49aa-4ea3-b7e0-2913b403757d","uuid":"51183759-960a-44bf-939a-9e9983bdcb86","timestamp":"2026-04-16T09:21:48.315Z"}
