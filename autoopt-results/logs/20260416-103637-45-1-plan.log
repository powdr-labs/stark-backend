{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CLGkUYsiCUQ6RgapjJgNR5","type":"tool_result","content":"1\tuse std::marker::PhantomData;\n2\t\n3\tuse itertools::Itertools;\n4\tuse openvm_cuda_common::memory_manager::MemTracker;\n5\tuse openvm_stark_backend::{\n6\t    poly_common::Squarable,\n7\t    proof::*,\n8\t    prover::{\n9\t        DeviceMultiStarkProvingKey, MultiRapProver, OpeningProver, ProverBackend, ProverDevice,\n10\t        ProvingContext, TraceCommitter,\n11\t    },\n12\t};\n13\tuse tracing::instrument;\n14\t\n15\tuse crate::{\n16\t    base::DeviceMatrix,\n17\t    hash_scheme::{DefaultHashScheme, GpuHashScheme},\n18\t    logup_zerocheck::prove_zerocheck_and_logup_gpu,\n19\t    merkle_tree::{MerkleProofQueryDigest, MerkleTreeConstructor},\n20\t    prelude::{D_EF, EF, F},\n21\t    sponge::GpuFiatShamirTranscript,\n22\t    stacked_pcs::{stacked_commit, StackedPcsDataGpu},\n23\t    stacked_reduction::prove_stacked_opening_reduction_gpu,\n24\t    whir::prove_whir_opening_gpu,\n25\t    AirDataGpu, GpuDevice, ProverError,\n26\t};\n27\t\n28\t/// Generic GPU prover backend parameterised by a hash scheme `HS`.\n29\t///\n30\t/// Use the [`GpuBackend`] type alias to refer to the concrete BabyBear-Poseidon2\n31\t/// backend without spelling out the generic parameter.\n32\t#[derive(Clone, Copy)]\n33\tpub struct GenericGpuBackend<HS: GpuHashScheme>(PhantomData<HS>);\n34\t\n35\timpl<HS: GpuHashScheme> Default for GenericGpuBackend<HS> {\n36\t    fn default() -> Self {\n37\t        Self(PhantomData)\n38\t    }\n39\t}\n40\t\n41\t/// Concrete GPU backend using the default BabyBear-Poseidon2 hash scheme.\n42\tpub type GpuBackend = GenericGpuBackend<DefaultHashScheme>;\n43\t\n44\timpl<HS: GpuHashScheme> ProverBackend for GenericGpuBackend<HS> {\n45\t    const CHALLENGE_EXT_DEGREE: u8 = D_EF as u8;\n46\t\n47\t    type Val = F;\n48\t    type Challenge = EF;\n49\t    type Commitment = HS::Digest;\n50\t    type Matrix = DeviceMatrix<F>;\n51\t    type PcsData = StackedPcsDataGpu<F, HS::Digest>;\n52\t    type OtherAirData = AirDataGpu;\n53\t}\n54\t\n55\timpl<HS: GpuHashScheme> TraceCommitter<GenericGpuBackend<HS>> for GpuDevice\n56\twhere\n57\t    HS::MerkleHash: MerkleTreeConstructor,\n58\t{\n59\t    type Error = ProverError;\n60\t\n61\t    fn commit(\n62\t        &self,\n63\t        traces: &[&DeviceMatrix<F>],\n64\t    ) -> Result<(HS::Digest, StackedPcsDataGpu<F, HS::Digest>), Self::Error> {\n65\t        stacked_commit::<HS::MerkleHash>(\n66\t            self.config.l_skip,\n67\t            self.config.n_stack,\n68\t            self.config.log_blowup,\n69\t            self.config.k_whir(),\n70\t            traces,\n71\t            self.prover_config,\n72\t        )\n73\t    }\n74\t}\n75\t\n76\timpl<HS: GpuHashScheme, TS: GpuFiatShamirTranscript<HS::SC>> ProverDevice<GenericGpuBackend<HS>, TS>\n77\t    for GpuDevice\n78\twhere\n79\t    HS::MerkleHash: MerkleTreeConstructor,\n80\t    HS::Digest: MerkleProofQueryDigest,\n81\t{\n82\t    type Error = ProverError;\n83\t}\n84\t\n85\timpl<HS: GpuHashScheme, TS: GpuFiatShamirTranscript<HS::SC>>\n86\t    MultiRapProver<GenericGpuBackend<HS>, TS> for GpuDevice\n87\t{\n88\t    type PartialProof = (GkrProof<HS::SC>, BatchConstraintProof<HS::SC>);\n89\t    /// The random opening point `r` where the batch constraint sumcheck reduces to evaluation\n90\t    /// claims of trace matrices `T, T_{rot}` at `r_{n_T}`.\n91\t    type Artifacts = Vec<EF>;\n92\t    type Error = ProverError;\n93\t\n94\t    #[allow(clippy::type_complexity)]\n95\t    #[instrument(name = \"prover.rap_constraints\", skip_all, fields(phase = \"prover\"))]\n96\t    fn prove_rap_constraints(\n97\t        &self,\n98\t        transcript: &mut TS,\n99\t        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n100\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n101\t        _common_main_pcs_data: &StackedPcsDataGpu<F, HS::Digest>,\n102\t    ) -> Result<((GkrProof<HS::SC>, BatchConstraintProof<HS::SC>), Vec<EF>), Self::Error> {\n103\t        let mem = MemTracker::start_and_reset_peak(\"prover.rap_constraints\");\n104\t        let save_memory = self.prover_config.zerocheck_save_memory;\n105\t        // Threshold for monomial evaluation path based on proof type:\n106\t        // - App proofs (log_blowup=1): higher threshold (512)\n107\t        // - Recursion proofs: lower threshold (64)\n108\t        let monomial_num_y_threshold = if self.config.log_blowup == 1 { 512 } else { 64 };\n109\t        let (gkr_proof, batch_constraint_proof, r) = prove_zerocheck_and_logup_gpu::<HS, TS>(\n110\t            transcript,\n111\t            mpk,\n112\t            ctx,\n113\t            save_memory,\n114\t            monomial_num_y_threshold,\n115\t            self.sm_count,\n116\t        )?;\n117\t        mem.emit_metrics();\n118\t        Ok(((gkr_proof, batch_constraint_proof), r))\n119\t    }\n120\t}\n121\t\n122\timpl<HS: GpuHashScheme, TS: GpuFiatShamirTranscript<HS::SC>>\n123\t    OpeningProver<GenericGpuBackend<HS>, TS> for GpuDevice\n124\twhere\n125\t    HS::MerkleHash: MerkleTreeConstructor,\n126\t    HS::Digest: MerkleProofQueryDigest,\n127\t{\n128\t    type OpeningProof = (StackingProof<HS::SC>, WhirProof<HS::SC>);\n129\t    /// The shared vector `r` where each trace matrix `T, T_{rot}` is opened at `r_{n_T}`.\n130\t    type OpeningPoints = Vec<EF>;\n131\t    type Error = ProverError;\n132\t\n133\t    #[instrument(name = \"prover.openings\", skip_all, fields(phase = \"prover\"))]\n134\t    fn prove_openings(\n135\t        &self,\n136\t        transcript: &mut TS,\n137\t        mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n138\t        ctx: ProvingContext<GenericGpuBackend<HS>>,\n139\t        common_main_pcs_data: StackedPcsDataGpu<F, HS::Digest>,\n140\t        r: Vec<EF>,\n141\t    ) -> Result<Self::OpeningProof, Self::Error> {\n142\t        let mut mem = MemTracker::start_and_reset_peak(\"prover.openings\");\n143\t        let params = self.config();\n144\t        #[cfg(debug_assertions)]\n145\t        {\n146\t            let total_stacked_width: usize = std::iter::once(common_main_pcs_data.layout().width())\n147\t                .chain(ctx.per_trace.iter().flat_map(|(air_idx, air_ctx)| {\n148\t                    mpk.per_air[*air_idx]\n149\t                        .preprocessed_data\n150\t                        .iter()\n151\t                        .map(|committed| committed.data.layout().width())\n152\t                        .chain(\n153\t                            air_ctx\n154\t                                .cached_mains\n155\t                                .iter()\n156\t                                .map(|committed| committed.data.layout().width()),\n157\t                        )\n158\t                }))\n159\t                .sum();\n160\t            debug_assert!(\n161\t                total_stacked_width <= mpk.params.w_stack,\n162\t                \"total stacked width across commits ({total_stacked_width}) exceeds w_stack ({})\",\n163\t                mpk.params.w_stack\n164\t            );\n165\t        }\n166\t        let (stacking_proof, u_prisma, stacked_per_commit) =\n167\t            prove_stacked_opening_reduction_gpu::<HS, TS>(\n168\t                self,\n169\t                transcript,\n170\t                mpk,\n171\t                ctx,\n172\t                common_main_pcs_data,\n173\t                &r,\n174\t            )?;\n175\t\n176\t        let (&u0, u_rest) = u_prisma.split_first().unwrap();\n177\t        let u_cube = u0\n178\t            .exp_powers_of_2()\n179\t            .take(params.l_skip)\n180\t            .chain(u_rest.iter().copied())\n181\t            .collect_vec();\n182\t\n183\t        let whir_proof =\n184\t            prove_whir_opening_gpu::<HS, TS>(params, transcript, stacked_per_commit, &u_cube)?;\n185\t        mem.emit_metrics();\n186\t        mem.reset_peak();\n187\t        Ok((stacking_proof, whir_proof))\n188\t    }\n189\t}\n190\t"}]},"parent_tool_use_id":"toolu_01DNV7QFAWMTWjTMKovT8YJJ","session_id":"78bbe79a-49aa-4ea3-b7e0-2913b403757d","uuid":"ac2533e6-ce84-47c5-a09f-8a32f09deecb","timestamp":"2026-04-16T08:52:59.625Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KK7vog3oDWggLyyCBbwutC","type":"tool_result","content":"100\tpub(crate) fn get_stacked_layout(\n101\t    l_skip: usize,\n102\t    n_stack: usize,\n103\t    traces: &[&DeviceMatrix<F>],\n104\t) -> StackedLayout {\n105\t    let sorted_meta = traces\n106\t        .iter()\n107\t        .map(|trace| {\n108\t            // height cannot be zero:\n109\t            let log_height = log2_strict_usize(trace.height());\n110\t            (trace.width(), log_height)\n111\t        })\n112\t        .collect_vec();\n113\t    debug_assert!(sorted_meta.is_sorted_by(|a, b| a.1 >= b.1));\n114\t    StackedLayout::new(l_skip, l_skip + n_stack, sorted_meta).unwrap()\n115\t}\n116\t\n117\tpub(crate) fn stack_traces(\n118\t    layout: &StackedLayout,\n119\t    traces: &[&DeviceMatrix<F>],\n120\t) -> Result<PleMatrix<F>, StackTracesError> {\n121\t    let mem = MemTracker::start(\"prover.stack_traces\");\n122\t    let l_skip = layout.l_skip();\n123\t    let height = layout.height();\n124\t    let width = layout.width();\n125\t    let mut q_evals = DeviceBuffer::<F>::with_capacity(width.checked_mul(height).unwrap());\n126\t    stack_traces_into_expanded(layout, traces, &mut q_evals, height)?;\n127\t    mem.emit_metrics();\n128\t    Ok(PleMatrix::from_evals(l_skip, q_evals, height, width))\n129\t}\n130\t\n131\t/// `buffer` should be the buffer to write the stacked traces into.\n132\t/// `buffer` should be a matrix with dimensions `padded_height x width` where `width` is the stacked\n133\t/// width and `padded_height` must be a multiple of the stacked height.\n134\tpub(crate) fn stack_traces_into_expanded(\n135\t    layout: &StackedLayout,\n136\t    traces: &[&DeviceMatrix<F>],\n137\t    buffer: &mut DeviceBuffer<F>,\n138\t    padded_height: usize,\n139\t) -> Result<(), StackTracesError> {\n140\t    let l_skip = layout.l_skip();\n141\t    debug_assert_eq!(padded_height % layout.height(), 0);\n142\t    debug_assert_eq!(buffer.len() % padded_height, 0);\n143\t    debug_assert_eq!(buffer.len() / padded_height, layout.width());\n144\t    buffer.fill_zero().map_err(StackTracesError::FillZero)?;\n145\t\n146\t    // Phase 1: Build descriptor array on host (CPU-only, no CUDA API calls)\n147\t    let mut descs: Vec<StackColDesc> = Vec::with_capacity(layout.sorted_cols.len());\n148\t    for (mat_idx, j, s) in &layout.sorted_cols {\n149\t        let start = s.col_idx * padded_height + s.row_idx;\n150\t        let trace = traces[*mat_idx];\n151\t        let s_len = s.len(l_skip);\n152\t        debug_assert_eq!(trace.height(), 1 << s.log_height());\n153\t        let (src, height, stride) = if s.log_height() >= l_skip {\n154\t            debug_assert_eq!(trace.height(), s_len);\n155\t            let src = unsafe { trace.buffer().as_ptr().add(*j * s_len) };\n156\t            (src, s_len as u32, 1u32)\n157\t        } else {\n158\t            let stride = s.stride(l_skip);\n159\t            debug_assert_eq!(stride * trace.height(), s_len);\n160\t            let src = unsafe { trace.buffer().as_ptr().add(*j * trace.height()) };\n161\t            (src, trace.height() as u32, stride as u32)\n162\t        };\n163\t        let dst = unsafe { buffer.as_mut_ptr().add(start) };\n164\t        descs.push(StackColDesc { src, dst, height, stride });\n165\t    }\n166\t\n167\t    // Phase 2: Upload descriptors to GPU and launch single scatter kernel\n168\t    if !descs.is_empty() {\n169\t        let d_descs = descs.to_device().map_err(StackTracesError::DescriptorUpload)?;\n170\t        unsafe { stack_columns(&d_descs).map_err(StackTracesError::StackColumns)? };\n171\t    }\n172\t    Ok(())\n173\t}\n174\t\n175\t/// Computes the Reed-Solomon codeword of each column vector of `eval_matrix` where the rate is\n176\t/// `2^{-log_blowup}`. The column vectors are treated as evaluations of a prismalinear extension on\n177\t/// a hyperprism.\n178\t///\n179\t/// Uses `stacked_matrix` if available, or else stacks `traces` directly into final codeword matrix\n180\t/// buffer.\n181\t#[instrument(skip_all)]\n182\tpub fn rs_code_matrix(\n183\t    log_blowup: usize,\n184\t    layout: &StackedLayout,\n185\t    traces: &[&DeviceMatrix<F>],\n186\t    stacked_matrix: &Option<PleMatrix<F>>,\n187\t) -> Result<DeviceMatrix<F>, RsCodeMatrixError> {\n188\t    let mem = MemTracker::start_and_reset_peak(\"prover.rs_code_matrix\");\n189\t    let l_skip = layout.l_skip();\n190\t    let height = layout.height();\n191\t    let width = layout.width();\n192\t    debug_assert!(height >= (1 << l_skip));\n193\t    let codeword_height = height.checked_shl(log_blowup as u32).unwrap();\n194\t    let mut codewords = DeviceBuffer::<F>::with_capacity(codeword_height * width);\n195\t    // The following kernels together perform MLE interpolation followed by coset NTT for\n196\t    // `width` polys from `height -> codeword_height` size domains.\n197\t    if let Some(stacked_matrix) = stacked_matrix.as_ref() {\n198\t        // SAFETY: `codewords` is allocated for `width` polys of `codeword_height` each, and we\n199\t        // expand from `matrix.mixed` which is `width` polys of `height` each.\n200\t        unsafe {\n201\t            batch_expand_pad(\n202\t                codewords.as_mut_ptr(),\n203\t                stacked_matrix.mixed.as_ptr(),\n204\t                width as u32,\n205\t                codeword_height as u32,\n206\t                height as u32,\n207\t            )\n208\t            .map_err(RsCodeMatrixError::BatchExpandPad)?;\n209\t        }\n210\t    } else {\n211\t        stack_traces_into_expanded(layout, traces, &mut codewords, codeword_height)\n212\t            .map_err(RsCodeMatrixError::StackTraces)?;\n213\t        // Currently codewords has the stacked matrix, batch expanded, in evaluation form on\n214\t        // hyperprism. We convert it to mixed form, i.e., unroll `PleMatrix::from_evals`.\n215\t        // PERF[jpw]: We do some wasted work on the padded zero part. A more specialized kernel\n216\t        // could be written to avoid this.\n217\t        if l_skip > 0 {\n218\t            // For univariate coordinate, perform inverse NTT for each 2^l_skip chunk per column:\n219\t            // (width cols) * (codeword_height / 2^l_skip chunks per col). Use natural ordering.\n220\t            let num_uni_poly = width * (codeword_height >> l_skip);\n221\t            unsafe {\n222\t                batch_ntt_small(&mut codewords, l_skip, num_uni_poly, true)\n223\t                    .map_err(RsCodeMatrixError::CustomBatchIntt)?;\n224\t            }\n225\t        }\n226\t    }\n227\t    // Eval-to-coeff RS encoding: Instead of full n-stage MLE evals→coeffs interpolation\n228\t    // (where n = log_height - l_skip), we only need l_skip stages of coeffs→evals\n229\t    // (subset-zeta transform) within each 2^l_skip chunk. This is a major optimization:\n230\t    // e.g. for log_height=17, l_skip=2: 2 stages instead of 15.\n231\t    let log_codeword_height = log2_strict_usize(codeword_height);\n232\t\n233\t    // Apply l_skip stages of coeffs_to_evals within each 2^l_skip chunk.\n234\t    // After iNTT, each chunk holds Z-monomial coefficients. We apply the subset-zeta\n235\t    // transform to convert to hypercube evaluations over the Z-bit variables.\n236\t    if l_skip > 0 {\n237\t        // SAFETY: `codewords` is properly initialized and parameters are valid.\n238\t        // Steps 2^0, 2^1, ..., 2^(l_skip-1) stay within chunk boundaries.\n239\t        unsafe {\n240\t            mle_interpolate_stages(\n241\t                codewords.as_mut_ptr(),\n242\t                width as u16,\n243\t                codeword_height as u32,\n244\t                log_blowup as u32,\n245\t                0,                 // start_log_step\n246\t                l_skip as u32 - 1, // end_log_step (inclusive)\n247\t                false,             // coeffs to evals (NOT eval to coeff)\n248\t                false,             // natural order\n249\t            )\n250\t            .map_err(|error| RsCodeMatrixError::MleInterpolateStage2d { error, step: 1 })?;\n251\t        }\n252\t    }\n253\t\n254\t    // Bit-reverse the entire buffer in-place (required for NTT)\n255\t    unsafe {\n256\t        bit_rev(\n257\t            &codewords,\n258\t            &codewords,\n259\t            log_codeword_height as u32,\n260\t            codeword_height as u32,\n261\t            width as u32,\n262\t        )\n263\t        .map_err(RsCodeMatrixError::BitRev)?;\n264\t    }\n265\t\n266\t    // Compute RS codeword via DFT on the smoothly-embedded domain.\n267\t    batch_ntt(\n268\t        &codewords,\n269\t        log_codeword_height as u32,\n270\t        0u32,\n271\t        width as u32,\n272\t        false, // bit-reversal already done\n273\t        false,\n274\t    );\n275\t    let code_matrix = DeviceMatrix::new(Arc::new(codewords), codeword_height, width);\n276\t    mem.emit_metrics();\n277\t\n278\t    Ok(code_matrix)\n279\t}\n280\t\n281\timpl<F, Digest> StackedPcsDataGpu<F, Digest> {\n282\t    /// Returns a view of the specified unstacked matrix in mixed form.\n283\t    ///\n284\t    /// # Notes\n285\t    /// - `width` must be the width of the unstacked matrix.\n286\t    /// - The unstacked matrix may be strided - this must be handled by the caller.\n287\t    pub fn mixed_view<'a>(\n288\t        &'a self,\n289\t        mat_idx: usize,\n290\t        width: usize,\n291\t    ) -> Option<DeviceMatrixView<'a, F>> {\n292\t        if let Some(matrix) = self.matrix.as_ref() {\n293\t            debug_assert_eq!(self.layout.width_of(mat_idx), width);\n294\t            let s = self\n295\t                .layout\n296\t                .get(mat_idx, 0)\n297\t                .unwrap_or_else(|| panic!(\"Invalid matrix index: {mat_idx}\"));\n298\t            let l_skip = self.layout.l_skip();\n299\t            let lifted_height = s.len(l_skip);"}]},"parent_tool_use_id":"toolu_01FqrdEKaHWVJqmVBY5NQMkX","session_id":"78bbe79a-49aa-4ea3-b7e0-2913b403757d","uuid"