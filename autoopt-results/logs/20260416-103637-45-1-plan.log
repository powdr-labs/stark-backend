        max_output_cells: u32,\n62\t            r_val: EF,\n63\t        ) -> i32;\n64\t\n65\t        fn _reduce_over_x_and_cols(\n66\t            input: *const std::ffi::c_void,\n67\t            output: *mut std::ffi::c_void,\n68\t            num_x: u32,\n69\t            num_cols: u32,\n70\t            large_domain_size: u32,\n71\t        ) -> i32;\n72\t\n73\t        fn _fold_ple_from_coeffs(\n74\t            input_coeffs: *const std::ffi::c_void,\n75\t            output: *mut std::ffi::c_void,\n76\t            num_x: u32,\n77\t            width: u32,\n78\t            domain_size: u32,\n79\t            r: EF,\n80\t        ) -> i32;\n81\t\n82\t        fn _triangular_fold_mle(output: *mut EF, input: *const EF, r: EF, output_max_n: u32)\n83\t            -> i32;\n84\t    }\n85\t\n86\t    pub unsafe fn sumcheck_mle_round(\n87\t        input_matrices: &DeviceBuffer<*const EF>,\n88\t        output: &DeviceBuffer<EF>,\n89\t        tmp_block_sums: &DeviceBuffer<EF>,\n90\t        widths: &DeviceBuffer<u32>,\n91\t        num_matrices: u32,\n92\t        height: u32,\n93\t        d: u32,\n94\t    ) -> Result<(), CudaError> {\n95\t        CudaError::from_result(_sumcheck_mle_round(\n96\t            input_matrices.as_ptr(),\n97\t            output.as_mut_ptr(),\n98\t            tmp_block_sums.as_mut_ptr(),\n99\t            widths.as_ptr(),\n100\t            num_matrices,"}]},"parent_tool_use_id":"toolu_0162mM37dPxajrNVmEiwG5wx","session_id":"78bbe79a-49aa-4ea3-b7e0-2913b403757d","uuid":"b0a4e7d7-9f8c-4d6c-a28a-57128c676fab","timestamp":"2026-04-16T09:21:43.181Z"}
