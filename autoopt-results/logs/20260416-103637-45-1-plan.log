{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013bFbZe2sEzSfxuuQWb4NyD","type":"tool_result","content":"1\tuse std::{array::from_fn, convert::TryInto, env, ffi::c_void, mem::transmute};\n2\t\n3\tuse openvm_cuda_common::{\n4\t    copy::{cuda_memcpy, MemCopyD2H},\n5\t    d_buffer::DeviceBuffer,\n6\t    memory_manager::MemTracker,\n7\t};\n8\tuse openvm_stark_backend::{\n9\t    poly_common::{eval_eq_mle, interpolate_linear_at_01, interpolate_quadratic_at_012},\n10\t    proof::GkrLayerClaims,\n11\t    prover::fractional_sumcheck_gkr::{Frac, FracSumcheckProof},\n12\t    FiatShamirTranscript, StarkProtocolConfig,\n13\t};\n14\tuse p3_field::{Field, PrimeCharacteristicRing};\n15\tuse p3_util::log2_strict_usize;\n16\tuse tracing::{debug_span, instrument};\n17\t\n18\tuse super::errors::FractionalSumcheckError;\n19\tuse crate::{\n20\t    cuda::{\n21\t        logup_zerocheck::{\n22\t            _frac_compute_round_temp_buffer_size, fold_ef_frac_columns,\n23\t            fold_ef_frac_columns_inplace, frac_build_tree_layer, frac_build_tree_two_layers,\n24\t            frac_compute_round, frac_compute_round_and_fold, frac_compute_round_and_fold_inplace,\n25\t            frac_compute_round_and_revert, frac_multifold_raw, frac_precompute_m_build_raw,\n26\t            frac_precompute_m_eval_round_raw,\n27\t        },\n28\t        ntt::{bit_rev_frac_ext, bit_rev_frac_ext_build_k2},\n29\t    },\n30\t    poly::SqrtEqLayers,\n31\t    prelude::EF,\n32\t};\n33\t\n34\tconst GKR_S_DEG: usize = 3;\n35\tconst GKR_WINDOW_SIZE: usize = 3;\n36\tconst GKR_WINDOW_DEFAULT_MIN_N: usize = 22;\n37\t\n38\t/// Describes which buffer operation to use for the next fused compute+fold round.\n39\t#[derive(Debug, Clone, Copy)]\n40\tenum BufferTarget {\n41\t    /// Out-of-place: layer → work_buffer\n42\t    LayerToWork,\n43\t    /// Out-of-place: work_buffer → layer\n44\t    WorkToLayer,\n45\t    /// In-place on layer buffer\n46\t    InPlaceLayer,\n47\t    /// In-place on work_buffer\n48\t    InPlaceWork,\n49\t}\n50\t\n51\t/// Encapsulates ping-pong buffer scheduling state for GKR inner rounds.\n52\t///\n53\t/// This struct manages the decision of whether to use in-place or out-of-place\n54\t/// (ping-pong) kernel variants based on buffer capacities and current data location.\n55\tstruct BufferScheduler {\n56\t    /// True if data currently resides in work_buffer, false if in layer.\n57\t    data_in_work_buffer: bool,\n58\t    /// Maximum capacity of work_buffer in elements.\n59\t    work_buffer_cap: usize,\n60\t}\n61\t\n62\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n63\tenum GkrRoundStrategy {\n64\t    FoldEval,\n65\t    PrecomputeM,\n66\t}\n67\t\n68\tconst PRECOMPUTE_M_TAIL_TILE: usize = 4096;\n69\tconst PRECOMPUTE_M_MIN_TAIL_TILE: usize = 256;\n70\tconst PRECOMPUTE_M_DEFAULT_MIN_BLOCKS: usize = 64;\n71\tconst PRECOMPUTE_M_DEFAULT_TARGET_BLOCKS: usize = 1024;\n72\t\n73\timpl BufferScheduler {\n74\t    /// Creates a new scheduler with data initially in layer buffer.\n75\t    fn new(work_buffer_cap: usize) -> Self {\n76\t        Self {\n77\t            data_in_work_buffer: false,\n78\t            work_buffer_cap,\n79\t        }\n80\t    }\n81\t\n82\t    /// Returns true if we can use ping-pong (out-of-place) for the given post-fold size.\n83\t    fn can_pingpong(&self, post_fold_size: usize) -> bool {\n84\t        post_fold_size <= self.work_buffer_cap\n85\t    }\n86\t\n87\t    /// Determines the next buffer target for a fused compute+fold operation.\n88\t    ///\n89\t    /// For last outer round: uses ping-pong when possible for __restrict__ optimization.\n90\t    /// For non-last outer rounds: preserves layer for tree revert operations.\n91\t    fn next_target(&mut self, post_fold_size: usize, last_outer_round: bool) -> BufferTarget {\n92\t        let can_pingpong = self.can_pingpong(post_fold_size);\n93\t\n94\t        if last_outer_round {\n95\t            if can_pingpong {\n96\t                // Ping-pong to other buffer\n97\t                if self.data_in_work_buffer {\n98\t                    self.data_in_work_buffer = false;\n99\t                    BufferTarget::WorkToLayer\n100\t                } else {\n101\t                    self.data_in_work_buffer = true;\n102\t                    BufferTarget::LayerToWork\n103\t                }\n104\t            } else {\n105\t                // In-place on layer (data must be in layer for early rounds of last outer round)\n106\t                debug_assert!(\n107\t                    !self.data_in_work_buffer,\n108\t                    \"in-place path requires data in layer\"\n109\t                );\n110\t                BufferTarget::InPlaceLayer\n111\t            }\n112\t        } else {\n113\t            // Non-last outer round: preserve layer for tree revert\n114\t            if self.data_in_work_buffer {\n115\t                // Already in work_buffer, stay there in-place\n116\t                BufferTarget::InPlaceWork\n117\t            } else {\n118\t                // Data in layer, move to work_buffer (out-of-place)\n119\t                self.data_in_work_buffer = true;\n120\t                BufferTarget::LayerToWork\n121\t            }\n122\t        }\n123\t    }\n124\t\n125\t    /// Returns the buffer target for the final fold (no fused compute).\n126\t    fn final_fold_target(&self, last_outer_round: bool) -> BufferTarget {\n127\t        if last_outer_round {\n128\t            if self.data_in_work_buffer {\n129\t                BufferTarget::InPlaceWork\n130\t            } else {\n131\t                BufferTarget::InPlaceLayer\n132\t            }\n133\t        } else {\n134\t            // Non-last outer round: fold into work_buffer to preserve layer\n135\t            if self.data_in_work_buffer {\n136\t                BufferTarget::InPlaceWork\n137\t            } else {\n138\t                BufferTarget::LayerToWork\n139\t            }\n140\t        }\n141\t    }\n142\t}\n143\t\n144\tfn precompute_m_enabled() -> bool {\n145\t    !matches!(\n146\t        env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M\"),\n147\t        Ok(val) if matches!(val.as_str(), \"0\" | \"false\" | \"FALSE\" | \"no\" | \"NO\")\n148\t    )\n149\t}\n150\t\n151\tfn precompute_m_min_blocks_threshold() -> usize {\n152\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_BLOCKS\")\n153\t        .ok()\n154\t        .and_then(|val| val.parse::<usize>().ok())\n155\t        .unwrap_or(PRECOMPUTE_M_DEFAULT_MIN_BLOCKS)\n156\t        .max(1)\n157\t}\n158\t\n159\tfn precompute_m_num_tail_blocks(rem_n: usize, w: usize, tail_tile: usize) -> usize {\n160\t    let tail_n = rem_n - w;\n161\t    (1usize << tail_n).div_ceil(tail_tile)\n162\t}\n163\t\n164\tfn precompute_m_target_blocks() -> usize {\n165\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_TARGET_BLOCKS\")\n166\t        .ok()\n167\t        .and_then(|val| val.parse::<usize>().ok())\n168\t        .unwrap_or(PRECOMPUTE_M_DEFAULT_TARGET_BLOCKS)\n169\t        .max(1)\n170\t}\n171\t\n172\tfn precompute_m_tail_tile_override() -> Option<usize> {\n173\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_TAIL_TILE\")\n174\t        .ok()\n175\t        .and_then(|val| val.parse::<usize>().ok())\n176\t        .map(|v| v.clamp(PRECOMPUTE_M_MIN_TAIL_TILE, PRECOMPUTE_M_TAIL_TILE))\n177\t}\n178\t\n179\tfn precompute_m_min_n() -> usize {\n180\t    env::var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_N\")\n181\t        .ok()\n182\t        .and_then(|val| val.parse::<usize>().ok())\n183\t        .unwrap_or(GKR_WINDOW_DEFAULT_MIN_N)\n184\t}\n185\t\n186\tfn precompute_m_build_tail_tile(\n187\t    rem_n: usize,\n188\t    w: usize,\n189\t    min_blocks_threshold: usize,\n190\t    target_blocks: usize,\n191\t    tail_tile_override: Option<usize>,\n192\t) -> usize {\n193\t    if let Some(tile) = tail_tile_override {\n194\t        return tile;\n195\t    }\n196\t    let tail_n = rem_n - w;\n197\t    let k = 1usize << tail_n;\n198\t    let target_blocks = target_blocks.max(min_blocks_threshold).max(1);\n199\t    let desired_tile = k.div_ceil(target_blocks).max(1);\n200\t    desired_tile.clamp(PRECOMPUTE_M_MIN_TAIL_TILE, PRECOMPUTE_M_TAIL_TILE)\n201\t}\n202\t\n203\tfn choose_precompute_m_window_w(\n204\t    rem_n: usize,\n205\t    rounds_left: usize,\n206\t    min_blocks_threshold: usize,\n207\t    target_blocks: usize,\n208\t    tail_tile_override: Option<usize>,\n209\t    min_n: usize,\n210\t) -> Option<usize> {\n211\t    if rem_n < min_n || rounds_left < GKR_WINDOW_SIZE {\n212\t        return None;\n213\t    }\n214\t    let w = GKR_WINDOW_SIZE;\n215\t    let tail_tile = precompute_m_build_tail_tile(\n216\t        rem_n,\n217\t        w,\n218\t        min_blocks_threshold,\n219\t        target_blocks,\n220\t        tail_tile_override,\n221\t    );\n222\t    (precompute_m_num_tail_blocks(rem_n, w, tail_tile) >= min_blocks_threshold).then_some(w)\n223\t}\n224\t\n225\tfn choose_round_strategy(\n226\t    round: usize,\n227\t    precompute_m_env: bool,\n228\t    precompute_m_min_blocks_threshold: usize,\n229\t    precompute_m_target_blocks: usize,\n230\t    precompute_m_tail_tile_override: Option<usize>,\n231\t    precompute_m_min_n: usize,\n232\t) -> GkrRoundStrategy {\n233\t    if !precompute_m_env {\n234\t        return GkrRoundStrategy::FoldEval;\n235\t    }\n236\t    let start_base = 1usize;\n237\t    let stop = round.div_ceil(2);\n238\t    let rem_n = round - start_base;\n239\t    let rounds_left = stop - start_base;\n240\t    if choose_precompute_m_window_w(\n241\t        rem_n,\n242\t        rounds_left,\n243\t        precompute_m_min_blocks_threshold,\n244\t        precompute_m_target_blocks,\n245\t        precompute_m_tail_tile_override,\n246\t        precompute_m_min_n,\n247\t    )\n248\t    .is_none()\n249\t    {\n250\t        return GkrRoundStrategy::FoldEval;\n251\t    }\n252\t\n253\t    GkrRoundStrategy::PrecomputeM\n254\t}\n255\t\n256\tfn eval_mle_table(points: &[EF], out: &mut [EF]) {\n257\t    // w <= 5 so CPU builds are trivial; avoid GPU kernel/alloc overhead for tiny tables.\n258\t    let n = points.len();\n259\t    let size = 1usize << n;\n260\t    debug_assert!(out.len() >= size);\n261\t    for (bits, dst) in out.iter_mut().enumerate().take(size) {\n262\t        let mut acc = EF::ONE;\n263\t        for (i, &x) in points.iter().enumerate() {\n264\t            let bit = ((bits >> (n - 1 - i)) & 1) == 1;\n265\t            acc *= if bit { x } else { EF::ONE - x };\n266\t        }\n267\t        *dst = acc;\n268\t    }\n269\t}\n270\t\n271\t/// Get low/high eq pointers for the tail portion of the eq buffer, skipping `drop_count` layers.\n272\t/// See `docs/cuda-backend/gkr-prover.md` § \"Eq buffer sqrt decomposition\".\n273\tfn eq_tail_ptrs(\n274\t    eq_buffer: &SqrtEqLayers,\n275\t    drop_count: usize,\n276\t) -> (*const EF, *const EF, usize, usize) {\n277\t    let mut high_n = eq_buffer.high_n();\n278\t    let mut low_n = eq_buffer.low_n();\n279\t    let total_n = high_n + low_n;\n280\t    if drop_count >= total_n {\n281\t        return (std::ptr::null(), std::ptr::null(), 1, 0);\n282\t    }\n283\t    if drop_count <= high_n {\n284\t        high_n -= drop_count;\n285\t    } else {\n286\t        low_n -= drop_count - high_n;\n287\t        high_n = 0;\n288\t    }\n289\t    let tail_n = low_n + high_n;\n290\t    if tail_n == 0 {\n291\t        (std::ptr::null(), std::ptr::null(), 1, 0)\n292\t    } else {\n293\t        (\n294\t            eq_buffer.low.get_ptr(low_n),\n295\t            eq_buffer.high.get_ptr(high_n),\n296\t            1 << low_n,\n297\t            tail_n,\n298\t        )\n299\t    }\n300\t}\n301\t\n302\tfn copy_to_device_ptr<T: Copy>(dst: *mut T, src: &[T]) -> Result<(), FractionalSumcheckError> {\n303\t    if src.is_empty() {\n304\t        return Ok(());\n305\t    }\n306\t    unsafe {\n307\t        cuda_memcpy::<false, true>(\n308\t            dst as *mut c_void,\n309\t            src.as_ptr() as *const c_void,\n310\t            std::mem::size_of_val(src),\n311\t        )?;\n312\t    }\n313\t    Ok(())\n314\t}\n315\t\n316\t/// Observes s_evals in transcript, updates accumulators, and returns the sampled challenge.\n317\t#[allow(clippy::too_many_arguments)]\n318\tfn observe_and_update<SC, TS>(\n319\t    d_sum_evals: &DeviceBuffer<EF>,\n320\t    transcript: &mut TS,\n321\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n322\t    r_vec: &mut Vec<EF>,\n323\t    prev_s_eval: &mut EF,\n324\t    xi_j: EF,\n325\t    eq_r_acc: &mut EF,\n326\t) -> Result<EF, FractionalSumcheckError>\n327\twhere\n328\t    SC: StarkProtocolConfig<EF = EF>,\n329\t    TS: FiatShamirTranscript<SC>,\n330\t{\n331\t    let (s_evals, sp_evals) = reconstruct_s_evals(d_sum_evals, *prev_s_eval, xi_j, *eq_r_acc)?;\n332\t\n333\t    for &eval in &s_evals {\n334\t        transcript.observe_ext(eval);\n335\t    }\n336\t    round_polys_eval.push(s_evals);\n337\t\n338\t    let r = transcript.sample_ext();\n339\t    r_vec.push(r);\n340\t\n341\t    let eq_r = eval_eq_mle(&[xi_j], &[r]);\n342\t    *eq_r_acc *= eq_r;\n343\t    *prev_s_eval = eq_r * interpolate_quadratic_at_012(&sp_evals, r);\n344\t\n345\t    Ok(r)\n346\t}\n347\t\n348\t/// Fused revert + compute round: reverts the tree layer and computes s'_0(1) and s'_0(2).\n349\t///\n350\t/// See `docs/cuda-backend/gkr-prover.md` § \"Sumcheck round strategies\" for context.\n351\t#[allow(clippy::too_many_arguments)]\n352\tfn do_sumcheck_round_and_revert<SC, TS>(\n353\t    eq_buffer: &mut SqrtEqLayers,\n354\t    layer: &mut DeviceBuffer<Frac<EF>>,\n355\t    pq_size: usize,\n356\t    lambda: EF,\n357\t    transcript: &mut TS,\n358\t    d_sum_evals: &mut DeviceBuffer<EF>,\n359\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n360\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n361\t    r_vec: &mut Vec<EF>,\n362\t    prev_s_eval: &mut EF,\n363\t    xi_j: EF,\n364\t    eq_r_acc: &mut EF,\n365\t) -> Result<EF, FractionalSumcheckError>\n366\twhere\n367\t    SC: StarkProtocolConfig<EF = EF>,\n368\t    TS: FiatShamirTranscript<SC>,\n369\t{\n370\t    unsafe {\n371\t        frac_compute_round_and_revert(\n372\t            eq_buffer,\n373\t            layer,\n374\t            pq_size / 2,\n375\t            lambda,\n376\t            d_sum_evals,\n377\t            tmp_block_sums,\n378\t        )\n379\t        .map_err(FractionalSumcheckError::ComputeRound)?;\n380\t    }\n381\t    eq_buffer.drop_layer();\n382\t    observe_and_update(\n383\t        d_sum_evals,\n384\t        transcript,\n385\t        round_polys_eval,\n386\t        r_vec,\n387\t        prev_s_eval,\n388\t        xi_j,\n389\t        eq_r_acc,\n390\t    )\n391\t}\n392\t\n393\t/// Fused compute round: computes s' polynomial AND folds the pq_buffer for next round.\n394\t///\n395\t/// This kernel fuses the fold operation (using `r_prev` from the previous round) into the current\n396\t/// round's compute, eliminating one kernel launch and reducing memory traffic.\n397\t#[allow(clippy::too_many_arguments)]\n398\tfn do_fused_sumcheck_round<SC, TS>(\n399\t    eq_buffer: &mut SqrtEqLayers,\n400\t    src_pq_buffer: &DeviceBuffer<Frac<EF>>,\n401\t    dst_pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n402\t    src_pq_size: usize,\n403\t    lambda: EF,\n404\t    r_prev: EF,\n405\t    transcript: &mut TS,\n406\t    d_sum_evals: &mut DeviceBuffer<EF>,\n407\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n408\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n409\t    r_vec: &mut Vec<EF>,\n410\t    prev_s_eval: &mut EF,\n411\t    xi_j: EF,\n412\t    eq_r_acc: &mut EF,\n413\t) -> Result<EF, FractionalSumcheckError>\n414\twhere\n415\t    SC: StarkProtocolConfig<EF = EF>,\n416\t    TS: FiatShamirTranscript<SC>,\n417\t{\n418\t    unsafe {\n419\t        frac_compute_round_and_fold(\n420\t            eq_buffer,\n421\t            src_pq_buffer,\n422\t            dst_pq_buffer,\n423\t            src_pq_size,\n424\t            lambda,\n425\t            r_prev,\n426\t            d_sum_evals,\n427\t            tmp_block_sums,\n428\t        )\n429\t        .map_err(FractionalSumcheckError::ComputeRound)?;\n430\t    }\n431\t    eq_buffer.drop_layer();\n432\t    observe_and_update(\n433\t        d_sum_evals,\n434\t        transcript,\n435\t        round_polys_eval,\n436\t        r_vec,\n437\t        prev_s_eval,\n438\t        xi_j,\n439\t        eq_r_acc,\n440\t    )\n441\t}\n442\t\n443\t/// In-place variant of [`do_fused_sumcheck_round`]. Reads and writes to the same buffer.\n444\t#[allow(clippy::too_many_arguments)]\n445\tfn do_fused_sumcheck_round_inplace<SC, TS>(\n446\t    eq_buffer: &mut SqrtEqLayers,\n447\t    pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n448\t    src_pq_size: usize,\n449\t    lambda: EF,\n450\t    r_prev: EF,\n451\t    transcript: &mut TS,\n452\t    d_sum_evals: &mut DeviceBuffer<EF>,\n453\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n454\t    round_polys_eval: &mut Vec<[EF; GKR_S_DEG]>,\n455\t    r_vec: &mut Vec<EF>,\n456\t    prev_s_eval: &mut EF,\n457\t    xi_j: EF,\n458\t    eq_r_acc: &mut EF,\n459\t) -> Result<EF, FractionalSumcheckError>\n460\twhere\n461\t    SC: StarkProtocolConfig<EF = EF>,\n462\t    TS: FiatShamirTranscript<SC>,\n463\t{\n464\t    unsafe {\n465\t        frac_compute_round_and_fold_inplace(\n466\t            eq_buffer,\n467\t            pq_buffer,\n468\t            src_pq_size,\n469\t            lambda,\n470\t            r_prev,\n471\t            d_sum_evals,\n472\t            tmp_block_sums,\n473\t        )\n474\t        .map_err(FractionalSumcheckError::ComputeRound)?;\n475\t    }\n476\t    eq_buffer.drop_layer();\n477\t    observe_and_update(\n478\t        d_sum_evals,\n479\t        transcript,\n480\t        round_polys_eval,\n481\t        r_vec,\n482\t        prev_s_eval,\n483\t        xi_j,\n484\t        eq_r_acc,\n485\t    )\n486\t}\n487\t\n488\t/// GKR fractional sumcheck prover. See `docs/cuda-backend/gkr-prover.md` (repo root) for the\n489\t/// protocol and implementation details.\n490\t#[instrument(skip_all)]\n491\tpub fn fractional_sumcheck_gpu<SC, TS>(\n492\t    transcript: &mut TS,\n493\t    leaves: DeviceBuffer<Frac<EF>>,\n494\t    alpha: EF,\n495\t    assert_zero: bool,\n496\t    mem: &mut MemTracker,\n497\t) -> Result<(FracSumcheckProof<SC>, Vec<EF>), FractionalSumcheckError>\n498\twhere\n499\t    SC: StarkProtocolConfig<EF = EF>,\n500\t    TS: FiatShamirTranscript<SC>,\n501\t{\n502\t    let mut layer = leaves;\n503\t    if layer.is_empty() {\n504\t        return Ok((\n505\t            FracSumcheckProof {\n506\t                fractional_sum: (EF::ZERO, EF::ONE),\n507\t                claims_per_layer: vec![],\n508\t                sumcheck_polys: vec![],\n509\t            },\n510\t            vec![],\n511\t        ));\n512\t    };\n513\t    let total_leaves = layer.len();\n514\t    // total_rounds = l_skip + n_logup\n515\t    let total_rounds = log2_strict_usize(total_leaves);\n516\t    assert!(total_rounds > 0, \"n_logup > 0 when there are interactions\");\n517\t    // Build segment tree.\n518\t    // - We only maintain the current layer\n519\t    // - Input layer uses separate F and EF buffers to save memory\n520\t    // - First tree layer converts (F, EF) to FracExt (EF, EF)\n521\t\n522\t    // We store it in bit-reversal order for coalesced memory accesses.\n523\t    // For large N (> 1024), fuse bitrev + tree layers 0 and 1 into a single kernel pass,\n524\t    // eliminating ~1.5N global memory reads. For small N, fall back to separate operations.\n525\t    let start_layer_i = if total_leaves > 1024 {\n526\t        unsafe {\n527\t            // SAFETY: Frac<EF> has exact same memory layout and alignment as (EF, EF).\n528\t            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n529\t            bit_rev_frac_ext_build_k2(buf, total_rounds as u32, alpha)\n530\t                .map_err(FractionalSumcheckError::BitReversal)?;\n531\t        }\n532\t        2 // layers 0+1 already done\n533\t    } else {\n534\t        // Fallback: separate bitrev + layer 0.\n535\t        unsafe {\n536\t            let buf = transmute::<&DeviceBuffer<Frac<EF>>, &DeviceBuffer<(EF, EF)>>(&layer);\n537\t            bit_rev_frac_ext(\n538\t                buf,\n539\t                buf,\n540\t                total_rounds as u32,\n541\t                total_leaves.try_into().unwrap(),\n542\t                1,\n543\t            )\n544\t            .map_err(FractionalSumcheckError::BitReversal)?;\n545\t            frac_build_tree_layer(&mut layer, total_leaves, false, alpha, true)\n546\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n547\t            use crate::cuda::logup_zerocheck::frac_add_alpha;\n548\t            let half = total_leaves / 2;\n549\t            let second_half_ptr = layer.as_mut_raw_ptr() as *mut Frac<EF>;\n550\t            let second_half_buf =\n551\t                DeviceBuffer::<Frac<EF>>::from_raw_parts(second_half_ptr.add(half), half);\n552\t            frac_add_alpha(&second_half_buf, alpha)\n553\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n554\t            std::mem::forget(second_half_buf);\n555\t        }\n556\t        1 // layer 0 done; continue from layer 1\n557\t    };\n558\t\n559\t    // Remaining layers: fuse consecutive pairs via two-layer kernel (~33% traffic savings).\n560\t    let mut i = start_layer_i;\n561\t    while i + 1 < total_rounds {\n562\t        let half_i1 = total_leaves >> (i + 2);\n563\t        unsafe {\n564\t            frac_build_tree_two_layers(&mut layer, half_i1)\n565\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n566\t        }\n567\t        i += 2;\n568\t    }\n569\t    // Remaining single layer (if odd number of layers left).\n570\t    if i < total_rounds {\n571\t        unsafe {\n572\t            frac_build_tree_layer(&mut layer, total_leaves >> i, false, EF::ZERO, false)\n573\t                .map_err(FractionalSumcheckError::SegmentTree)?;\n574\t        }\n575\t    }\n576\t    mem.emit_metrics_with_label(\"frac_sumcheck.segment_tree\");\n577\t    mem.tracing_info(\"fractional_sumcheck_gkr: after building segment tree\");\n578\t    let mut copy_scratch = DeviceBuffer::<Frac<EF>>::with_capacity(1);\n579\t    let root = copy_from_device(&layer, 0, &mut copy_scratch)?;\n580\t    unsafe {\n581\t        frac_build_tree_layer(&mut layer, 2, true, EF::ZERO, false)\n582\t            .map_err(FractionalSumcheckError::SegmentTree)?;\n583\t    }\n584\t    if assert_zero {\n585\t        if root.p != EF::ZERO {\n586\t            return Err(FractionalSumcheckError::NonzeroRootSum {\n587\t                p: root.p,\n588\t                q: root.q,\n589\t            });\n590\t        }\n591\t    } else {\n592\t        transcript.observe_ext(root.p);\n593\t    }\n594\t    transcript.observe_ext(root.q);\n595\t\n596\t    let mut claims_per_layer = Vec::with_capacity(total_rounds);\n597\t    let mut sumcheck_polys = Vec::with_capacity(total_rounds);\n598\t\n599\t    let first_left = copy_from_device(&layer, 0, &mut copy_scratch)?;\n600\t    let first_right = copy_from_device(&layer, 1, &mut copy_scratch)?;\n601\t    claims_per_layer.push(GkrLayerClaims {\n602\t        p_xi_0: first_left.p,\n603\t        q_xi_0: first_left.q,\n604\t        p_xi_1: first_right.p,\n605\t        q_xi_1: first_right.q,\n606\t    });\n607\t    for value in [\n608\t        claims_per_layer[0].p_xi_0,\n609\t        claims_per_layer[0].q_xi_0,\n610\t        claims_per_layer[0].p_xi_1,\n611\t        claims_per_layer[0].q_xi_1,\n612\t    ] {\n613\t        transcript.observe_ext(value);\n614\t    }\n615\t    let mu_1 = transcript.sample_ext();\n616\t    let mut xi_prev = vec![mu_1];\n617\t    let mut d_sum_evals = DeviceBuffer::<EF>::with_capacity(2);\n618\t\n619\t    let precompute_m_env = precompute_m_enabled();\n620\t\n621\t    // Work buffer to avoid revert operations on layer. Only needed for non-last rounds.\n622\t    // For the last round (round == total_rounds - 1), we fold in-place on layer.\n623\t    // When precompute-M is active, the first multifold folds w+1 variables at once\n624\t    // (pending r_prev + w window challenges), so the output is total_leaves >> (2 + w).\n625\t    // Fold-eval fallback rounds (rem_n < min_n) need at most 2^min_n elements.\n626\t    let max_work_size = if total_rounds > 2 {\n627\t        if precompute_m_env {\n628\t            (total_leaves >> (2 + GKR_WINDOW_SIZE)).max(1 << GKR_WINDOW_DEFAULT_MIN_N)\n629\t        } else {\n630\t            total_leaves >> 2\n631\t        }\n632\t    } else {\n633\t        0\n634\t    };\n635\t    let mut work_buffer = DeviceBuffer::<Frac<EF>>::with_capacity(max_work_size);\n636\t    let max_tmp_buffer_capacity = if total_rounds > 1 {\n637\t        (unsafe { _frac_compute_round_temp_buffer_size((1 << (total_rounds - 1)) as u32) }) as usize\n638\t    } else {\n639\t        0\n640\t    };\n641\t    let mut tmp_block_sums = if max_tmp_buffer_capacity > 0 {\n642\t        DeviceBuffer::<EF>::with_capacity(max_tmp_buffer_capacity)\n643\t    } else {\n644\t        DeviceBuffer::new()\n645\t    };\n646\t    let precompute_m_min_blocks_threshold = precompute_m_min_blocks_threshold();\n647\t    let precompute_m_target_blocks = precompute_m_target_blocks();\n648\t    let precompute_m_tail_tile_override = precompute_m_tail_tile_override();\n649\t    let precompute_m_min_n = precompute_m_min_n();\n650\t    let mut m_buffer = DeviceBuffer::<EF>::new();\n651\t    let mut m_partial_buffer = DeviceBuffer::<EF>::new();\n652\t    let mut eq_r_prefix_buffer = DeviceBuffer::<EF>::new();\n653\t    let mut eq_suffix_buffer = DeviceBuffer::<EF>::new();\n654\t\n655\t    for round in 1..total_rounds {\n656\t        let gkr_round_span = debug_span!(\"GKR\", round).entered();\n657\t\n658\t        // Note: frac_build_tree_layer revert is now fused into do_sumcheck_round_and_revert below.\n659\t\n660\t        debug_assert_eq!(xi_prev.len(), round);\n661\t        // eq_buffer stores eq(xi_prev[j..], x) for x in H_{xi_prev.len()-j} for\n662\t        // j=1,...,xi_prev.len()-1.\n663\t        let mut eq_buffer = SqrtEqLayers::from_xi(&xi_prev[1..])\n664\t            .map_err(FractionalSumcheckError::EvalEqHypercube)?;\n665\t\n666\t        let mut round_polys_eval = Vec::with_capacity(round);\n667\t        let mut r_vec = Vec::with_capacity(round);\n668\t        let mut pq_size = 2 << round;\n669\t\n670\t        let lambda = transcript.sample_ext();\n671\t\n672\t        let tmp_buffer_capacity =\n673\t            unsafe { _frac_compute_round_temp_buffer_size((1 << round) as u32) } as usize;\n674\t        if tmp_buffer_capacity > tmp_block_sums.len() {\n675\t            tmp_block_sums = DeviceBuffer::<EF>::with_capacity(tmp_buffer_capacity);\n676\t        }\n677\t\n678\t        let last_outer_round = round == total_rounds - 1;\n679\t        debug_assert!(round > 0);\n680\t        let backend = choose_round_strategy(\n681\t            round,\n682\t            precompute_m_env,\n683\t            precompute_m_min_blocks_threshold,\n684\t            precompute_m_target_blocks,\n685\t            precompute_m_tail_tile_override,\n686\t            precompute_m_min_n,\n687\t        );\n688\t\n689\t        // In round `j`, contains `s_{j-1}(r_{j-1})`. Starts with the sumcheck's sum claim.\n690\t        let (numer_claim, denom_claim) =\n691\t            reduce_to_single_evaluation(claims_per_layer.last().unwrap(), /* mu */ xi_prev[0]);\n692\t        let mut prev_s_eval = numer_claim + lambda * denom_claim;\n693\t        let mut eq_r_acc = EF::ONE;\n694\t\n695\t        // Round 0: compute + revert fused. The pq_buffer fold will be fused into next round's\n696\t        // compute. This fuses frac_build_tree_layer(revert=true) with the first inner round\n697\t        // compute.\n698\t        let r0 = do_sumcheck_round_and_revert(\n699\t            &mut eq_buffer,\n700\t            &mut layer,\n701\t            pq_size,\n702\t            lambda,\n703\t            transcript,\n704\t            &mut d_sum_evals,\n705\t            &mut tmp_block_sums,\n706\t            &mut round_polys_eval,\n707\t            &mut r_vec,\n708\t            &mut prev_s_eval,\n709\t            xi_prev[0],\n710\t            &mut eq_r_acc,\n711\t        )?;\n712\t\n713\t        // Fused rounds 1..(round-1): compute + fold using prev_r.\n714\t        let mut prev_r = r0;\n715\t        let active: &mut DeviceBuffer<Frac<EF>>;\n716\t\n717\t        match backend {\n718\t            GkrRoundStrategy::FoldEval => {\n719\t                // Existing fused path.\n720\t                let mut scheduler = BufferScheduler::new(max_work_size);\n721\t                for &xi_j in xi_prev.iter().skip(1) {\n722\t                    let src_pq_size = pq_size;\n723\t                    let post_fold_size = pq_size >> 1;\n724\t\n725\t                    let r = match scheduler.next_target(post_fold_size, last_outer_round) {\n726\t                        BufferTarget::LayerToWork => do_fused_sumcheck_round(\n727\t                            &mut eq_buffer,\n728\t                            &layer,\n729\t                            &mut work_buffer,\n730\t                            src_pq_size,\n731\t                            lambda,\n732\t                            prev_r,\n733\t                            transcript,\n734\t                            &mut d_sum_evals,\n735\t                            &mut tmp_block_sums,\n736\t                            &mut round_polys_eval,\n737\t                            &mut r_vec,\n738\t                            &mut prev_s_eval,\n739\t                            xi_j,\n740\t                            &mut eq_r_acc,\n741\t                        )?,\n742\t                        BufferTarget::WorkToLayer => do_fused_sumcheck_round(\n743\t                            &mut eq_buffer,\n744\t                            &work_buffer,\n745\t                            &mut layer,\n746\t                            src_pq_size,\n747\t                            lambda,\n748\t                            prev_r,\n749\t                            transcript,\n750\t                            &mut d_sum_evals,\n751\t                            &mut tmp_block_sums,\n752\t                            &mut round_polys_eval,\n753\t                            &mut r_vec,\n754\t                            &mut prev_s_eval,\n755\t                            xi_j,\n756\t                            &mut eq_r_acc,\n757\t                        )?,\n758\t                        BufferTarget::InPlaceLayer => do_fused_sumcheck_round_inplace(\n759\t                            &mut eq_buffer,\n760\t                            &mut layer,\n761\t                            src_pq_size,\n762\t                            lambda,\n763\t                            prev_r,\n764\t                            transcript,\n765\t                            &mut d_sum_evals,\n766\t                            &mut tmp_block_sums,\n767\t                            &mut round_polys_eval,\n768\t                            &mut r_vec,\n769\t                            &mut prev_s_eval,\n770\t                            xi_j,\n771\t                            &mut eq_r_acc,\n772\t                        )?,\n773\t                        BufferTarget::InPlaceWork => do_fused_sumcheck_round_inplace(\n774\t                            &mut eq_buffer,\n775\t                            &mut work_buffer,\n776\t                            src_pq_size,\n777\t                            lambda,\n778\t                            prev_r,\n779\t                            transcript,\n780\t                            &mut d_sum_evals,\n781\t                            &mut tmp_block_sums,\n782\t                            &mut round_polys_eval,\n783\t                            &mut r_vec,\n784\t                            &mut prev_s_eval,\n785\t                            xi_j,\n786\t                            &mut eq_r_acc,\n787\t                        )?,\n788\t                    };\n789\t\n790\t                    pq_size >>= 1;\n791\t                    prev_r = r;\n792\t                }\n793\t\n794\t                // Final fold after last r (no next compute to fuse with).\n795\t                active = match scheduler.final_fold_target(last_outer_round) {\n796\t                    BufferTarget::InPlaceWork => {\n797\t                        unsafe {\n798\t                            fold_ef_frac_columns_inplace(&mut work_buffer, pq_size, prev_r)\n799\t                                .map_err(FractionalSumcheckError::FoldColumns)?;\n800\t                        }\n801\t                        &mut work_buffer\n802\t                    }\n803\t                    BufferTarget::InPlaceLayer => {\n804\t                        unsafe {\n805\t                            fold_ef_frac_columns_inplace(&mut layer, pq_size, prev_r)\n806\t                                .map_err(FractionalSumcheckError::FoldColumns)?;\n807\t                        }\n808\t                        &mut layer\n809\t                    }\n810\t                    BufferTarget::LayerToWork => {\n811\t                        unsafe {\n812\t                            fold_ef_frac_columns(&layer, &mut work_buffer, pq_size, prev_r)\n813\t                                .map_err(FractionalSumcheckError::FoldColumns)?;\n814\t                        }\n815\t                        &mut work_buffer\n816\t                    }\n817\t                    BufferTarget::WorkToLayer => unreachable!(),\n818\t                };\n819\t                pq_size >>= 1;\n820\t            }\n821\t            GkrRoundStrategy::PrecomputeM => {\n822\t                let base = 1usize;\n823\t                let stop = round.div_ceil(2);\n824\t\n825\t                // First window reads from `layer` with pending_fold=true\n826\t                // (M-build folds prev_r inline). Multifold writes to\n827\t                // `active_pq` (work_buffer for non-last rounds, layer for\n828\t                // last). After the first window, subsequent windows\n829\t                // read/write active_pq with pending_fold=false.\n830\t                let mut pending_fold = true;\n831\t                let layer_read_ptr = layer.as_ptr();\n832\t                let active_pq = if last_outer_round {\n833\t                    &mut layer\n834\t                } else {\n835\t                    &mut work_buffer\n836\t                };\n837\t\n838\t                // w+1 to accommodate r_prev prepended to window challenges\n839\t                // on the first iteration (inline fold on last outer round).\n840\t                let mut eq_r_window_host = vec![EF::ZERO; 1 << (GKR_WINDOW_SIZE + 1)];\n841\t                let mut eq_r_prefix_host = vec![EF::ZERO; 1 << GKR_WINDOW_SIZE];\n842\t                let mut eq_suffix_host = vec![EF::ZERO; 1 << GKR_WINDOW_SIZE];\n843\t\n844\t                if eq_r_prefix_buffer.is_empty() {\n845\t                    eq_r_prefix_buffer =\n846\t                        DeviceBuffer::<EF>::with_capacity(1usize << GKR_WINDOW_SIZE);\n847\t                }\n848\t                if eq_suffix_buffer.is_empty() {\n849\t                    eq_suffix_buffer = DeviceBuffer::<EF>::with_capacity(1usize << GKR_WINDOW_SIZE);\n850\t                }\n851\t\n852\t                let mut base = base;\n853\t                while base < stop {\n854\t                    let rem_n = round - base;\n855\t                    let rounds_left = stop - base;\n856\t                    let Some(w) = choose_precompute_m_window_w(\n857\t                        rem_n,\n858\t                        rounds_left,\n859\t                        precompute_m_min_blocks_threshold,\n860\t                        precompute_m_target_blocks,\n861\t                        precompute_m_tail_tile_override,\n862\t                        precompute_m_min_n,\n863\t                    ) else {\n864\t                        break;\n865\t                    };\n866\t                    if m_buffer.is_empty() {\n867\t                        let max_m_len = 1usize << (2 * GKR_WINDOW_SIZE);\n868\t                        m_buffer = DeviceBuffer::<EF>::with_capacity(max_m_len);\n869\t                    }\n870\t                    let m_ptr = m_buffer.as_mut_ptr();\n871\t                    // Reuse tmp_block_sums for eq_r_window upload.\n872\t                    // Safe: M eval rounds finish before multifold needs eq_r_window,\n873\t                    // and tmp_block_sums is not needed until next fold-eval round.\n874\t                    let max_eq_r_window_len = 1usize << (GKR_WINDOW_SIZE + 1);\n875\t                    debug_assert!(\n876\t                        tmp_block_sums.len() >= max_eq_r_window_len,\n877\t                        \"tmp_block_sums too small for eq_r_window: {} < {}\",\n878\t                        tmp_block_sums.len(),\n879\t                        max_eq_r_window_len,\n880\t                    );\n881\t                    let d_eq_r_window = tmp_block_sums.as_mut_ptr();\n882\t\n883\t                    // When pending_fold is true, the buffer has rem_n+1 variables\n884\t                    // and the kernel folds inline. The effective tail dimension\n885\t                    // for tiling is the same either way (rem_n - w).\n886\t                    let tail_tile = precompute_m_build_tail_tile(\n887\t                        rem_n,\n888\t                        w,\n889\t                        precompute_m_min_blocks_threshold,\n890\t                        precompute_m_target_blocks,\n891\t                        precompute_m_tail_tile_override,\n892\t                    );\n893\t                    let num_blocks = precompute_m_num_tail_blocks(rem_n, w, tail_tile);\n894\t                    let m_len = (1usize << w) * (1usize << w);\n895\t                    let partial_len = num_blocks * m_len;\n896\t                    if partial_len > m_partial_buffer.len() {\n897\t                        m_partial_buffer = DeviceBuffer::<EF>::with_capacity(partial_len);\n898\t                    }\n899\t\n900\t                    let (eq_tail_low, eq_tail_high, eq_low_cap, _) =\n901\t                        eq_tail_ptrs(&eq_buffer, w - 1);\n902\t\n903\t                    let r_fold = prev_r; // save before eval loop overwrites prev_r\n904\t                    let build_src = if pending_fold {\n905\t                        layer_read_ptr\n906\t                    } else {\n907\t                        active_pq.as_ptr()\n908\t                    };\n909\t                    unsafe {\n910\t                        frac_precompute_m_build_raw(\n911\t                            build_src,\n912\t                            rem_n,\n913\t                            w,\n914\t                            lambda,\n915\t                            r_fold,\n916\t                            pending_fold, // inline fold only on first iteration\n917\t                            eq_tail_low,\n918\t                            eq_tail_high,\n919\t                            eq_low_cap,\n920\t                            tail_tile,\n921\t                            m_partial_buffer.as_mut_ptr(),\n922\t                            partial_len,\n923\t                            m_ptr,\n924\t                        )\n925\t                        .map_err(FractionalSumcheckError::ComputeRound)?;\n926\t                    }\n927\t\n928\t                    let mut window_rs = Vec::with_capacity(w);\n929\t                    for t in 0..w {\n930\t                        let prefix_bits = t;\n931\t                        let suffix_bits = w - t - 1;\n932\t                        eval_mle_table(&window_rs, &mut eq_r_prefix_host);\n933\t                        eval_mle_table(&xi_prev[base + t + 1..base + w], &mut eq_suffix_host);\n934\t\n935\t                        copy_to_device_ptr(\n936\t                            eq_r_prefix_buffer.as_mut_ptr(),\n937\t                            &eq_r_prefix_host[..(1usize << prefix_bits)],\n938\t                        )?;\n939\t                        copy_to_device_ptr(\n940\t                            eq_suffix_buffer.as_mut_ptr(),\n941\t                            &eq_suffix_host[..(1usize << suffix_bits)],\n942\t                        )?;\n943\t                        unsafe {\n944\t                            frac_precompute_m_eval_round_raw(\n945\t                                m_ptr,\n946\t                                w,\n947\t                                t,\n948\t                                eq_r_prefix_buffer.as_ptr(),\n949\t                                eq_suffix_buffer.as_ptr(),\n950\t                                d_sum_evals.as_mut_ptr(),\n951\t                            )\n952\t                            .map_err(FractionalSumcheckError::ComputeRound)?;\n953\t                        }\n954\t                        eq_buffer.drop_layer();\n955\t                        let r = observe_and_update(\n956\t                            &d_sum_evals,\n957\t                            transcript,\n958\t                            &mut round_polys_eval,\n959\t                            &mut r_vec,\n960\t                            &mut prev_s_eval,\n961\t                            xi_prev[base + t],\n962\t                            &mut eq_r_acc,\n963\t                        )?;\n964\t                        prev_r = r;\n965\t                        window_rs.push(r);\n966\t                    }\n967\t\n968\t                    // Compute eq_r_window for the multifold.\n969\t                    let (buf_vars, w_fold) = if pending_fold {\n970\t                        let mut all_rs = Vec::with_capacity(w + 1);\n971\t                        all_rs.push(r_fold);\n972\t                        all_rs.extend_from_slice(&window_rs);\n973\t                        eval_mle_table(&all_rs, &mut eq_r_window_host);\n974\t                        copy_to_device_ptr(d_eq_r_window, &eq_r_window_host[..(1 << (w + 1))])?;\n975\t                        (rem_n + 1, w + 1)\n976\t                    } else {\n977\t                        eval_mle_table(&window_rs, &mut eq_r_window_host);\n978\t                        copy_to_device_ptr(d_eq_r_window, &eq_r_window_host[..(1 << w)])?;\n979\t                        (rem_n, w)\n980\t                    };\n981\t\n982\t                    let multifold_src = if pending_fold {\n983\t                        layer_read_ptr\n984\t                    } else {\n985\t                        active_pq.as_ptr()\n986\t                    };\n987\t                    unsafe {\n988\t                        frac_multifold_raw(\n989\t                            multifold_src,\n990\t                            active_pq.as_mut_ptr(),\n991\t                            buf_vars,\n992\t                            w_fold,\n993\t                            d_eq_r_window,\n994\t                        )\n995\t                        .map_err(FractionalSumcheckError::FoldColumns)?;\n996\t                    }\n997\t                    pq_size >>= w_fold;\n998\t                    pending_fold = false;\n999\t                    base += w;\n1000\t                }\n1001\t\n1002\t                if base < round {\n1003\t                    // First tail round is standalone compute,\n1004\t                    // subsequent rounds are fold+compute.\n1005\t                    unsafe {\n1006\t                        frac_compute_round(\n1007\t                            &eq_buffer,\n1008\t                            active_pq,\n1009\t                            pq_size / 2,\n1010\t                            lambda,\n1011\t                            &mut d_sum_evals,\n1012\t                            &mut tmp_block_sums,\n1013\t                        )\n1014\t                        .map_err(FractionalSumcheckError::ComputeRound)?;\n1015\t                    }\n1016\t                    eq_buffer.drop_layer();\n1017\t                    prev_r = observe_and_update(\n1018\t                        &d_sum_evals,\n1019\t                        transcript,\n1020\t                        &mut round_polys_eval,\n1021\t                        &mut r_vec,\n1022\t                        &mut prev_s_eval,\n1023\t                        xi_prev[base],\n1024\t                        &mut eq_r_acc,\n1025\t                    )?;\n1026\t\n1027\t                    for &xi_j in xi_prev.iter().skip(base + 1) {\n1028\t                        let src_pq_size = pq_size;\n1029\t                        prev_r = do_fused_sumcheck_round_inplace(\n1030\t                            &mut eq_buffer,\n1031\t                            active_pq,\n1032\t                            src_pq_size,\n1033\t                            lambda,\n1034\t                            prev_r,\n1035\t                            transcript,\n1036\t                            &mut d_sum_evals,\n1037\t                            &mut tmp_block_sums,\n1038\t                            &mut round_polys_eval,\n1039\t                            &mut r_vec,\n1040\t                            &mut prev_s_eval,\n1041\t                            xi_j,\n1042\t                            &mut eq_r_acc,\n1043\t                        )?;\n1044\t                        pq_size >>= 1;\n1045\t                    }\n1046\t                }\n1047\t\n1048\t                unsafe {\n1049\t                    fold_ef_frac_columns_inplace(active_pq, pq_size, prev_r)\n1050\t                        .map_err(FractionalSumcheckError::FoldColumns)?;\n1051\t                }\n1052\t                active = active_pq;\n1053\t                pq_size >>= 1;\n1054\t            }\n1055\t        }\n1056\t\n1057\t        let pq_host = [\n1058\t            copy_from_device(active, 0, &mut copy_scratch)?,\n1059\t            copy_from_device(active, pq_size / 2, &mut copy_scratch)?,\n1060\t        ];\n1061\t\n1062\t        claims_per_layer.push(GkrLayerClaims {\n1063\t            p_xi_0: pq_host[0].p,\n1064\t            q_xi_0: pq_host[0].q,\n1065\t            p_xi_1: pq_host[1].p,\n1066\t            q_xi_1: pq_host[1].q,\n1067\t        });\n1068\t\n1069\t        transcript.observe_ext(claims_per_layer[round].p_xi_0);\n1070\t        transcript.observe_ext(claims_per_layer[round].q_xi_0);\n1071\t        transcript.observe_ext(claims_per_layer[round].p_xi_1);\n1072\t        transcript.observe_ext(claims_per_layer[round].q_xi_1);\n1073\t\n1074\t        let mu = transcript.sample_ext();\n1075\t        xi_prev = [vec![mu], r_vec].concat();\n1076\t\n1077\t        sumcheck_polys.push(round_polys_eval);\n1078\t        gkr_round_span.exit();\n1079\t    }\n1080\t    mem.emit_metrics_with_label(\"frac_sumcheck.gkr_rounds\");\n1081\t    mem.tracing_info(\"after_fractional_sumcheck_gkr\");\n1082\t\n1083\t    Ok((\n1084\t        FracSumcheckProof {\n1085\t            fractional_sum: (root.p, root.q),\n1086\t            claims_per_layer,\n1087\t            sumcheck_polys,\n1088\t        },\n1089\t        xi_prev,\n1090\t    ))\n1091\t}\n1092\t\n1093\tfn copy_from_device<T: Copy>(\n1094\t    buf: &DeviceBuffer<T>,\n1095\t    index: usize,\n1096\t    scratch: &mut DeviceBuffer<T>,\n1097\t) -> Result<T, FractionalSumcheckError> {\n1098\t    debug_assert!(!scratch.is_empty());\n1099\t    unsafe {\n1100\t        cuda_memcpy::<true, true>(\n1101\t            scratch.as_mut_raw_ptr(),\n1102\t            buf.as_ptr().add(index) as *const std::ffi::c_void,\n1103\t            std::mem::size_of::<T>(),\n1104\t        )?;\n1105\t    }\n1106\t    let host = scratch.to_host()?;\n1107\t    Ok(host[0])\n1108\t}\n1109\t\n1110\t/// Reduces claims to a single evaluation point using linear interpolation.\n1111\tfn reduce_to_single_evaluation<SC: StarkProtocolConfig<EF = EF>>(\n1112\t    claims: &GkrLayerClaims<SC>,\n1113\t    mu: EF,\n1114\t) -> (EF, EF) {\n1115\t    let numer = interpolate_linear_at_01(&[claims.p_xi_0, claims.p_xi_1], mu);\n1116\t    let denom = interpolate_linear_at_01(&[claims.q_xi_0, claims.q_xi_1], mu);\n1117\t    (numer, denom)\n1118\t}\n1119\t\n1120\t/// Reconstructs the full s(1,2,3) evaluations from s'(1,2) evaluations returned by GPU.\n1121\t///\n1122\t/// Goal: compute s({1,2,3}) from s(X) = eq(xi_j, X) * s'(X).\n1123\t/// Reconstruct the full round polynomial s_t from GPU-computed s'_t(1), s'_t(2).\n1124\t///\n1125\t/// See `docs/cuda-backend/gkr-prover.md` § \"Sumcheck round implementation\" for the derivation.\n1126\tfn reconstruct_s_evals(\n1127\t    d_sum_evals: &DeviceBuffer<EF>,\n1128\t    prev_s_eval: EF,\n1129\t    xi_j: EF,\n1130\t    eq_r_acc: EF,\n1131\t) -> Result<([EF; GKR_S_DEG], [EF; GKR_S_DEG]), FractionalSumcheckError> {\n1132\t    let sp_vec = d_sum_evals.to_host()?;\n1133\t    debug_assert_eq!(sp_vec.len(), GKR_S_DEG - 1);\n1134\t\n1135\t    // sp_evals holds evaluations of degree 2 poly `eq(xi_{j+1..}, r_{j+1..}) * s'(X)` at {0,1,2}\n1136\t    let mut sp_evals = [EF::ZERO; GKR_S_DEG];\n1137\t    sp_evals[1] = sp_vec[0] * eq_r_acc;\n1138\t    sp_evals[2] = sp_vec[1] * eq_r_acc;\n1139\t\n1140\t    // We use that s_j(0) + s_j(1) = s_{j-1}(r_{j-1})\n1141\t    // s_j(X) = eq(xi_j, X) * sp_j(X)\n1142\t    // s_j(0) = (1 - xi_j) * sp_j(0)\n1143\t    // s_j(1) = xi_j * sp_j(1)\n1144\t    // So: (1 - xi_j) * sp_j(0) + xi_j * sp_j(1) = prev_s_eval\n1145\t    // xi_j is randomly sampled so 1 - xi_j should be invertible\n1146\t    let eq_xi_0 = EF::ONE - xi_j;\n1147\t    debug_assert_ne!(eq_xi_0, EF::ZERO);\n1148\t    let eq_xi_1 = xi_j;\n1149\t    sp_evals[0] = (prev_s_eval - eq_xi_1 * sp_evals[1]) * eq_xi_0.inverse();\n1150\t\n1151\t    let s_evals: [EF; GKR_S_DEG] = from_fn(|i| {\n1152\t        // evaluate s at X = i + 1 (skip 0 evaluation)\n1153\t        let x = EF::from_usize(i + 1);\n1154\t        let sp_eval = if i < GKR_S_DEG - 1 {\n1155\t            sp_evals[i + 1]\n1156\t        } else {\n1157\t            interpolate_quadratic_at_012(&sp_evals, x)\n1158\t        };\n1159\t        eval_eq_mle(&[xi_j], &[x]) * sp_eval\n1160\t    });\n1161\t\n1162\t    Ok((s_evals, sp_evals))\n1163\t}\n1164\t\n1165\t/// Generate random fractional leaves on device for benchmarking.\n1166\tpub fn make_synthetic_leaves(n: usize) -> Result<DeviceBuffer<Frac<EF>>, FractionalSumcheckError> {\n1167\t    use openvm_cuda_common::copy::cuda_memcpy;\n1168\t    use rand::{rngs::StdRng, Rng, SeedableRng};\n1169\t\n1170\t    let size = 1usize << n;\n1171\t    let mut rng = StdRng::seed_from_u64(42);\n1172\t    let host: Vec<(EF, EF)> = (0..size)\n1173\t        .map(|_| (rng.random::<EF>(), rng.random::<EF>()))\n1174\t        .collect();\n1175\t    let d_leaves = DeviceBuffer::<Frac<EF>>::with_capacity(size);\n1176\t    unsafe {\n1177\t        cuda_memcpy::<false, true>(\n1178\t            d_leaves.as_mut_raw_ptr(),\n1179\t            host.as_ptr() as *const std::ffi::c_void,\n1180\t            std::mem::size_of_val(host.as_slice()),\n1181\t        )?;\n1182\t    }\n1183\t    Ok(d_leaves)\n1184\t}\n1185\t\n1186\t#[cfg(test)]\n1187\tmod tests {\n1188\t    use openvm_cuda_common::{memory_manager::MemTracker, stream::current_stream_sync};\n1189\t    use p3_field::PrimeCharacteristicRing;\n1190\t\n1191\t    use super::{\n1192\t        fractional_sumcheck_gpu, make_synthetic_leaves, FractionalSumcheckError, GkrRoundStrategy,\n1193\t        EF,\n1194\t    };\n1195\t    use crate::{prelude::SC, sponge::DuplexSpongeGpu};\n1196\t\n1197\t    /// Run fractional sumcheck with a given round strategy and return the proof + final randomness.\n1198\t    fn run_with_strategy(\n1199\t        n: usize,\n1200\t        strategy: GkrRoundStrategy,\n1201\t    ) -> Result<(super::FracSumcheckProof<SC>, Vec<EF>), FractionalSumcheckError> {\n1202\t        // SAFETY: test sets process env; run with --test-threads=1.\n1203\t        let enable_precompute_m = matches!(strategy, GkrRoundStrategy::PrecomputeM);\n1204\t        unsafe {\n1205\t            std::env::set_var(\n1206\t                \"SWIRL_CUDA_GKR_PRECOMPUTE_M\",\n1207\t                if enable_precompute_m { \"1\" } else { \"0\" },\n1208\t            );\n1209\t        }\n1210\t        let mut transcript = DuplexSpongeGpu::default();\n1211\t        let leaves = make_synthetic_leaves(n)?;\n1212\t        let mut mem = MemTracker::start(\"test.precompute_m\");\n1213\t        let result = fractional_sumcheck_gpu(&mut transcript, leaves, EF::ZERO, false, &mut mem)?;\n1214\t        current_stream_sync().expect(\"sync\");\n1215\t        Ok(result)\n1216\t    }\n1217\t\n1218\t    fn assert_proofs_equal(\n1219\t        a: &(super::FracSumcheckProof<SC>, Vec<EF>),\n1220\t        b: &(super::FracSumcheckProof<SC>, Vec<EF>),\n1221\t    ) {\n1222\t        assert_eq!(\n1223\t            a.0.fractional_sum, b.0.fractional_sum,\n1224\t            \"fractional_sum mismatch\"\n1225\t        );\n1226\t        assert_eq!(\n1227\t            a.0.claims_per_layer, b.0.claims_per_layer,\n1228\t            \"claims_per_layer mismatch\"\n1229\t        );\n1230\t        assert_eq!(\n1231\t            a.0.sumcheck_polys, b.0.sumcheck_polys,\n1232\t            \"sumcheck_polys mismatch\"\n1233\t        );\n1234\t        assert_eq!(a.1, b.1, \"final randomness mismatch\");\n1235\t    }\n1236\t\n1237\t    /// Compares precompute-M against FoldEval at n=24,25,26.\n1238\t    /// n=24: top layer rem_n=22 (one window).\n1239\t    /// n=25: top layer rem_n=23 (one window, more tail).\n1240\t    /// n=26: top layer rem_n=24 (one window, even more tail).\n1241\t    #[test]\n1242\t    fn test_precompute_m_matches_fused() -> Result<(), FractionalSumcheckError> {\n1243\t        for n in [24, 25, 26] {\n1244\t            eprintln!(\"--- testing n={n} ---\");\n1245\t            let fused = run_with_strategy(n, GkrRoundStrategy::FoldEval)?;\n1246\t            let precompute = run_with_strategy(n, GkrRoundStrategy::PrecomputeM)?;\n1247\t            assert_proofs_equal(&fused, &precompute);\n1248\t        }\n1249\t        Ok(())\n1250\t    }\n1251\t\n1252\t    /// Compares precompute-M against FoldEval with lowered thresholds to force multi-window\n1253\t    /// iteration at small n. At n=16, round=15: stop=8, window 1 at base=1 (rem_n=14),\n1254\t    /// window 2 at base=4 (rem_n=11), then fold-eval tail for the remaining round.\n1255\t    #[test]\n1256\t    fn test_precompute_m_multi_window_matches_fused() -> Result<(), FractionalSumcheckError> {\n1257\t        unsafe {\n1258\t            std::env::set_var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_N\", \"8\");\n1259\t            std::env::set_var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_BLOCKS\", \"1\");\n1260\t        }\n1261\t        let fused = run_with_strategy(16, GkrRoundStrategy::FoldEval)?;\n1262\t        let precompute = run_with_strategy(16, GkrRoundStrategy::PrecomputeM)?;\n1263\t        assert_proofs_equal(&fused, &precompute);\n1264\t        unsafe {\n1265\t            std::env::remove_var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_N\");\n1266\t            std::env::remove_var(\"SWIRL_CUDA_GKR_PRECOMPUTE_M_MIN_BLOCKS\");\n1267\t        }\n1268\t        Ok(())\n1269\t    }\n1270\t}\n1271\t"}]},"parent_tool_use_id":"toolu_01EWbNRnNyxKKhF893EuGF7j","session_id":"78bbe79a-49aa-4ea3-b7e0-2913b403757d","uuid":"fd3df05e-dbf3-4e6b-a510-ad79210b587f","timestamp":"2026-04-16T08:52:37.771Z"}
