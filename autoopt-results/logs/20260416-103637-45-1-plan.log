grid(num_blocks, num_x);\n    dim3 block(threads_per_block);\n    size_t shmem = div_ceil(threads_per_block, WARP_SIZE) * sizeof(FpExt);\n\n    // Phase 1: Evaluate numerator monomials\n    logup_monomial_kernel<false><<<grid, block, shmem>>>(","numLines":100,"startLine":366,"totalLines":498}}}
