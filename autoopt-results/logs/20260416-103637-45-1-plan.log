{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AfrEbCkxquQCgJnwFee2Nx","type":"tool_result","content":"1225\t\n1226\t        // Barrier: ensure all prior GPU work (trace uploads, pk data, selectors)\n1227\t        // is visible to worker thread streams.\n1228\t        current_stream_sync().map_err(MemCopyError::from)?;\n1229\t\n1230\t        // Phase 2: Process AIRs in parallel across N OS threads.\n1231\t        // Only use multi-threading when there are enough AIRs to benefit from concurrent\n1232\t        // kernel execution. With few large AIRs (e.g., APC 0 has ~20 per segment), each\n1233\t        // kernel already saturates the GPU and multi-threading adds memory pool overhead.\n1234\t        let mut num_threads = if work_items.len() >= 100 {\n1235\t            NUM_ROUND0_STREAMS.min(work_items.len())\n1236\t        } else {\n1237\t            1\n1238\t        };\n1239\t\n1240\t        // Memory budget check: reduce num_threads if pre-allocation would exceed budget.\n1241\t        let per_thread_bytes = max_zc_intermed * size_of::<F>()\n1242\t            + max_zc_temp_sums * size_of::<EF>()\n1243\t            + max_logup_intermed * size_of::<F>()\n1244\t            + max_logup_temp_sums * size_of::<Frac<EF>>();\n1245\t        while num_threads > 1 && num_threads * per_thread_bytes > 2_000_000_000 {\n1246\t            num_threads /= 2;\n1247\t            tracing::warn!(\n1248\t                \"Reducing Round 0 thread count to {} due to memory budget ({}MB per thread)\",\n1249\t                num_threads,\n1250\t                per_thread_bytes / (1024 * 1024),\n1251\t            );\n1252\t        }\n1253\t\n1254\t        // Pre-allocate per-thread buffer pools to avoid per-AIR mutex contention.\n1255\t        let skip_prealloc = num_threads == 1 && per_thread_bytes > 2_000_000_000;\n1256\t        let thread_buffers: Vec<round0::Round0ThreadBuffers> = if skip_prealloc {\n1257\t            tracing::warn!(\n1258\t                \"Skipping Round 0 pre-allocation: {}MB exceeds 2GB budget\",\n1259\t                per_thread_bytes / (1024 * 1024),\n1260\t            );\n1261\t            (0..num_threads)\n1262\t                .map(|_| round0::Round0ThreadBuffers {\n1263\t                    zc_intermediates: DeviceBuffer::new(),\n1264\t                    zc_temp_sums: DeviceBuffer::new(),\n1265\t                    logup_intermediates: DeviceBuffer::new(),\n1266\t                    logup_temp_sums: DeviceBuffer::new(),\n1267\t                })\n1268\t                .collect()\n1269\t        } else {\n1270\t            tracing::debug!(\n1271\t                \"Pre-allocating Round 0 buffers: {}MB per thread × {} threads\",\n1272\t                per_thread_bytes / (1024 * 1024),\n1273\t                num_threads,\n1274\t            );\n1275\t            (0..num_threads)\n1276\t                .map(|_| round0::Round0ThreadBuffers {\n1277\t                    zc_intermediates: if max_zc_intermed > 0 {\n1278\t                        DeviceBuffer::with_capacity(max_zc_intermed)\n1279\t                    } else {\n1280\t                        DeviceBuffer::new()\n1281\t                    },\n1282\t                    zc_temp_sums: if max_zc_temp_sums > 0 {\n1283\t                        DeviceBuffer::with_capacity(max_zc_temp_sums)\n1284\t                    } else {\n1285\t                        DeviceBuffer::new()\n1286\t                    },\n1287\t                    logup_intermediates: if max_logup_intermed > 0 {\n1288\t                        DeviceBuffer::with_capacity(max_logup_intermed)\n1289\t                    } else {\n1290\t                        DeviceBuffer::new()\n1291\t                    },\n1292\t                    logup_temp_sums: if max_logup_temp_sums > 0 {\n1293\t                        DeviceBuffer::with_capacity(max_logup_temp_sums)\n1294\t                    } else {\n1295\t                        DeviceBuffer::new()\n1296\t                    },\n1297\t                })\n1298\t                .collect()\n1299\t        };\n1300\t\n1301\t        // Transmit batch array pointer as usize for thread-safety.\n1302\t        // Worker threads write to non-overlapping offsets (by unique trace_idx),\n1303\t        // and CUDA guarantees non-overlapping device writes from different streams are safe.\n1304\t        let batch_ptr_val = d_batch_array.as_mut_ptr() as usize;\n1305\t\n1306\t        if num_threads <= 1 {\n1307\t            // Single-threaded path: run d_eq_3b upload + logup precompute sequentially,\n1308\t            // then process Round 0 AIRs. No overlap benefit here since few large AIRs\n1309\t            // already saturate the GPU.\n1310\t            self.d_eq_3b_per_trace = self\n1311\t                .eq_3b_per_trace\n1312\t                .iter()\n1313\t                .map(|eq_3bs| {\n1314\t                    if eq_3bs.is_empty() {\n1315\t                        Ok(DeviceBuffer::new())\n1316\t                    } else {\n1317\t                        eq_3bs.to_device()\n1318\t                    }\n1319\t                })\n1320\t                .collect::<Result<Vec<_>, _>>()?;\n1321\t            for (trace_idx, (air_idx, _)) in ctx.per_trace.iter().enumerate() {\n1322\t                let air_pk = &self.pk.per_air[*air_idx];\n1323\t                if air_pk.other_data.interaction_monomials.is_some()\n1324\t                    && !self.eq_3b_per_trace[trace_idx].is_empty()\n1325\t                {\n1326\t                    self.logup_combinations[trace_idx] = Some(\n1327\t                        compute_logup_combinations(\n1328\t                            self.pk,\n1329\t                            *air_idx,\n1330\t                            &self.d_beta_pows,\n1331\t                            &self.d_eq_3b_per_trace[trace_idx],\n1332\t                            &self.eq_3b_per_trace[trace_idx],\n1333\t                            &self.beta_pows,\n1334\t                        )\n1335\t                  