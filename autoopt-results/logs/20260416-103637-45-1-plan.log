{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015YwY2x6dnq9b7XLAhwk5yf","type":"tool_result","content":"1\t//! Defines the symbolic rule data to precompute and store in the GPU proving key\n2\tuse itertools::Itertools;\n3\tuse openvm_cuda_common::{copy::MemCopyH2D, d_buffer::DeviceBuffer, error::MemCopyError};\n4\tuse openvm_stark_backend::{\n5\t    air_builders::symbolic::{\n6\t        symbolic_expression::SymbolicExpression,\n7\t        symbolic_variable::{Entry, SymbolicVariable},\n8\t        SymbolicConstraints, SymbolicDagBuilder, SymbolicExpressionDag,\n9\t    },\n10\t    keygen::types::StarkProvingKey,\n11\t    StarkProtocolConfig,\n12\t};\n13\tuse p3_field::PrimeCharacteristicRing;\n14\t\n15\tuse crate::{\n16\t    logup_zerocheck::rules::{codec::Codec, SymbolicRulesGpu},\n17\t    monomial::{\n18\t        ExpandedInteractionMonomials, ExpandedMonomials, InteractionMonomialTerm, LambdaTerm,\n19\t        MonomialHeader, PackedVar,\n20\t    },\n21\t    prelude::F,\n22\t};\n23\t\n24\tpub struct AirDataGpu {\n25\t    pub interaction_rules: InteractionEvalRules,\n26\t    /// Whether to buffer vars depends on the performance and memory access patterns of the kernel.\n27\t    /// This may be tuned.\n28\t    pub zerocheck_round0: ConstraintOnlyRules<true>,\n29\t    pub zerocheck_mle: ConstraintOnlyRules<false>,\n30\t    pub zerocheck_monomials: Option<ZerocheckMonomials>,\n31\t    pub interaction_monomials: Option<InteractionMonomials>,\n32\t    /// Buffer size for the logup round0 interaction evaluation DAG.\n33\t    /// Pre-computed at keygen time so Round 0 work item preparation can\n34\t    /// determine per-AIR buffer sizes without rebuilding the DAG.\n35\t    pub logup_round0_buffer_size: u32,\n36\t}\n37\t\n38\t/// Used for GKR input evaluation and logup MLE sumcheck rounds.\n39\tpub struct InteractionEvalRules {\n40\t    pub(crate) inner: EvalRules,\n41\t    /// Constraints consist of all `(numer, denom)` pairs **topologically sorted**. We map the\n42\t    /// constraint idx back to unsorted order. ```text\n43\t    /// constraint_idx => 2 * interaction_idx + is_denom\n44\t    /// ```\n45\t    pub(crate) d_pair_idxs: DeviceBuffer<u32>,\n46\t    pub(crate) max_fields_len: usize,\n47\t}\n48\t\n49\t/// Constraints only, no interactions\n50\tpub struct ConstraintOnlyRules<const BUFFER_VARS: bool> {\n51\t    pub(crate) inner: EvalRules,\n52\t}\n53\t\n54\tpub struct EvalRules {\n55\t    /// Encoded rules\n56\t    pub d_rules: DeviceBuffer<u128>,\n57\t    pub d_used_nodes: DeviceBuffer<usize>,\n58\t    pub buffer_size: u32,\n59\t}\n60\t\n61\tpub struct ZerocheckMonomials {\n62\t    pub d_headers: DeviceBuffer<MonomialHeader>,\n63\t    pub d_variables: DeviceBuffer<PackedVar>,\n64\t    pub d_lambda_terms: DeviceBuffer<LambdaTerm<F>>,\n65\t    pub num_monomials: u32,\n66\t}\n67\t\n68\tpub struct InteractionMonomials {\n69\t    pub d_numer_headers: DeviceBuffer<MonomialHeader>,\n70\t    pub d_numer_variables: DeviceBuffer<PackedVar>,\n71\t    pub d_numer_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n72\t    pub num_numer_monomials: u32,\n73\t    pub d_denom_headers: DeviceBuffer<MonomialHeader>,\n74\t    pub d_denom_variables: DeviceBuffer<PackedVar>,\n75\t    pub d_denom_terms: DeviceBuffer<InteractionMonomialTerm<F>>,\n76\t    pub num_denom_monomials: u32,\n77\t    pub max_fields_len: usize,\n78\t    pub num_interactions: u32,\n79\t}\n80\t\n81\tfn to_device_or_empty<T>(data: &[T]) -> Result<DeviceBuffer<T>, MemCopyError> {\n82\t    if data.is_empty() {\n83\t        Ok(DeviceBuffer::new())\n84\t    } else {\n85\t        data.to_device()\n86\t    }\n87\t}\n88\t\n89\timpl AirDataGpu {\n90\t    pub fn new<S: StarkProtocolConfig<F = F>>(\n91\t        pk: &StarkProvingKey<S>,\n92\t    ) -> Result<Self, MemCopyError> {\n93\t        let dag = &pk.vk.symbolic_constraints;\n94\t        let symbolic_constraints = SymbolicConstraints::from(dag);\n95\t        let interaction_rules = InteractionEvalRules::new(&symbolic_constraints)?;\n96\t        let zerocheck_round0 = ConstraintOnlyRules::<true>::new(&dag.constraints)?;\n97\t        let zerocheck_mle = ConstraintOnlyRules::<false>::new(&dag.constraints)?;\n98\t\n99\t        let zerocheck_monomials = if dag.constraints.num_constraints() > 0 {\n100\t            let expanded = ExpandedMonomials::from_dag(&dag.constraints);\n101\t            Some(ZerocheckMonomials::from_expanded(&expanded)?)\n102\t        } else {\n103\t            None\n104\t        };\n105\t        let interaction_monomials = if !symbolic_constraints.interactions.is_empty() {\n106\t            let expanded =\n107\t                ExpandedInteractionMonomials::from_symbolic_constraints(&symbolic_constraints);\n108\t            Some(InteractionMonomials::from_expanded(&expanded)?)\n109\t        } else {\n110\t            None\n111\t        };\n112\t\n113\t        // Pre-compute the logup round0 buffer_size from the interaction DAG.\n114\t        // This mirrors the DAG construction in evaluate_round0_interactions_gpu\n115\t        // but only extracts the buffer_size (no weights or device uploads needed).\n116\t        let logup_round0_buffer_size = if !symbolic_constraints.interactions.is_empty() {\n117\t            let mut dag_builder = SymbolicDagBuilder::new();\n118\t            let mut sorted_used_dag_idxs = Vec::new();\n119\t            for interaction in &symbolic_constraints.interactions {\n120\t                let count = dag_builder.add_expr(&interaction.count);\n121\t                sorted_used_dag_idxs.push(count);\n122\t                sorted_used_dag_idxs.extend(\n123\t                    interaction\n124\t                        .message\n125\t                        .iter()\n126\t                        .map(|field_expr| dag_builder.add_expr(field_expr)),\n127\t                );\n128\t            }\n129\t            sorted_used_dag_idxs.sort();\n130\t            sorted_used_dag_idxs.dedup();\n131\t            let dag = SymbolicExpressionDag {\n132\t                nodes: dag_builder.nodes,\n133\t                constraint_idx: sorted_used_dag_idxs,\n134\t            };\n135\t            let rules = SymbolicRulesGpu::new(&dag, true);\n136\t            rules\n137\t                .buffer_size\n138\t                .try_into()\n139\t                .expect(\"logup round0 buffer_size exceeds u32\")\n140\t        } else {\n141\t            0\n142\t        };\n143\t\n144\t        Ok(Self {\n145\t            interaction_rules,\n146\t            zerocheck_round0,\n147\t            zerocheck_mle,\n148\t            zerocheck_monomials,\n149\t            interaction_monomials,\n150\t            logup_round0_buffer_size,"}]},"parent_tool_use_id":"toolu_0156BKHSAA1fLaJTAd7AdjfB","session_id":"78bbe79a-49aa-4ea3-b7e0-2913b403757d","uuid":"860aec77-cb29-46a4-8ba2-8b86fa7f0d06","timestamp":"2026-04-16T09:09:26.758Z"}
