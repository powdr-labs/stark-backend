y(sel_total_cells));\n645\t            prover.fold_sel_buf_b = Some(DeviceBuffer::<EF>::with_capacity(sel_total_cells));\n646\t        }\n647\t    }\n648\t\n649\t    // Pre-allocate device buffers for per-trace main_ptrs uploads in MLE rounds.\n650\t    // Eliminates per-round cudaMallocAsync/cudaFreeAsync cycles (~8400 at APC 300).\n651\t    {\n652\t        let num_traces = prover.mat_evals_per_trace.len();\n653\t        prover.d_main_ptrs_pool = (0..num_traces)\n654\t            .map(|trace_idx| {\n655\t                let air_idx = prover.air_indices_per_trace[trace_idx];\n656\t                let has_preprocessed =\n657\t                    prover.pk.per_air[air_idx].preprocessed_data.is_some();\n658\t                let first_main_idx = usize::from(has_preprocessed);\n659\t                let num_main_mats =\n660\t                    prover.mat_evals_per_trace[trace_idx].len() - first_main_idx;\n661\t                if num_main_mats > 0 {\n662\t                    DeviceBuffer::with_capacity(num_main_mats)\n663\t                } else {\n664\t                    DeviceBuffer::new()\n665\t                }\n666\t            })\n667\t            .collect();\n668\t    }\n669\t\n670\t    // Sumcheck rounds:\n671\t    // - each round the prover needs to compute univariate polynomial `s_round`. This poly is linear\n672\t    //   since we are taking MLE of `evals`.\n673\t    // - at end of each round, sample random `r_round` in `EF`\n674\t    //\n675\t    // `s_round` is degree `s_deg` so we evaluate it at `0, ..., =s_deg`. The prover skips\n676\t    // evaluation at `0` because the verifier can infer it from the previous round's\n677\t    // `s_{round-1}(r)` claim. The degree is constraint_degree + 1, where + 1 is from eq term\n678\t    let mle_rounds_span =\n679\t        info_span!(\"prover.rap_constraints.mle_rounds\", phase = \"prover\").entered();\n680\t    debug!(%s_deg);\n681\t    for round in 1..=n_max {\n682\t        let sp_round_evals = prover.sumcheck_polys_batch_eval(round, r[round - 1])?;\n683\t        let batch_s = prover.compute_batch_s_poly(sp_round_evals, num_traces, round, &mu_pows);\n684\t        let batch_s_evals = (1..=s_deg)\n685\t            .map(|i| batch_s.eval_at_point(EF::from_usize(i)))\n686\t            .collect_vec();\n687\t        for &eval in &batch_s_evals {\n688\t            transcript.observe_ext(eval);\n689\t        }\n690\t        sumcheck_round_polys.push(batch_s_evals);\n691\t\n692\t        let r_round = transcript.sample_ext();\n693\t        debug!(%round, %r_round);\n694\t        r.push(r_round);\n695\t        prover.prev_s_eval = batch_s.eval_at_point(r_round);\n696\t\n697\t        prover.fold_mle_evals(round, r_round)?;\n698\t    }\n699\t    assert_eq!(r.len(), n_max + 1);\n700\t\n701\t    let column_openings = prover.into_column_openings()?;\n702\t\n703\t    let need_rot_per_trace = ctx\n704\t        .per_trace\n705\t        .iter()\n706\t        .map(|(air_idx, _)| mpk.per_air[*air_idx].vk.params.need_rot)\n707\t        .collect::<Vec<_>>();\n708\t    // Observe common main openings first, and then preprocessed/cached\n709\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n710\t        for (claim, claim_rot) in column_openings_by_rot(&openings[0], *need_rot) {\n711\t            transcript.observe_ext(claim);\n712\t            transcript.observe_ext(claim_rot);\n713\t        }\n714\t    }\n715\t    for (need_rot, openings) in need_rot_per_trace.iter().zip(column_openings.iter()) {\n716\t        for part in openings.iter().skip(1) {\n717\t            for (claim, claim_rot) in column_openings_by_rot(part, *need_rot) {\n718\t                transcript.observe_ext(claim);\n719\t                transcript.observe_ext(claim_rot);\n720\t            }\n721\t        }\n722\t    }\n723\t    drop(mle_rounds_span);\n724\t\n725\t    let batch_constraint_proof = BatchConstraintProof {\n726\t        numerator_term_per_air,\n727\t        denominator_term_per_air,\n728\t        univariate_round_coeffs: s_0_poly.into_coeffs(),\n729\t        sumcheck_round_polys,\n730\t        column_openings,\n731\t    };\n732\t    let gkr_proof = GkrProof {\n733\t        logup_pow_witness,\n734\t        q0_claim: frac_sum_proof.fractional_sum.1,\n735\t        claims_per_layer: frac_sum_proof.claims_per_layer,\n736\t        sumcheck_polys: frac_sum_proof.sumcheck_polys,\n737\t    };\n738\t    Ok((gkr_proof, batch_constraint_proof, r))\n739\t}\n740\t\n741\tpub struct LogupZerocheckGpu<'a, HS: GpuHashScheme> {\n742\t    pub alpha_logup: EF,\n743\t    pub beta_pows: Vec<EF>,\n744\t    // [alpha, beta^0, beta^1, .., beta^max_interaction_len]\n745\t    pub d_challenges: DeviceBuffer<EF>,\n746\t\n747\t    pub l_skip: usize,\n748\t    n_logup: usize,\n749\t    n_global: usize,\n750\t\n751\t    pub omega_skip: F,\n752\t    pub omega_skip_pows: Vec<F>,\n753\t    d_omega_skip_pows: DeviceBuffer<F>,\n754\t\n755\t    pub interactions_layout: StackedLayout,\n756\t    pub constraint_degree: usize,\n757\t    n_per_trace: Vec<isize>,\n758\t    max_num_constraints: usize,\n759\t    pub monomial_num_y_threshold: u32,\n760\t    sm_count: u32,\n761\t    // Available after GKR:\n762\t    pub xi: Vec<EF>,\n763\t    pub lambda_pows: Option<DeviceBuffer<EF>>,\n764\t    /// Precomputed lambda combinations per AIR (indexed by air_idx). Set when lambda is sampled.\n765\t    lambda_combinations: Vec<Option<DeviceBuffer<EF>>>,\n766\t    /// Beta powers on device for logup MLE rounds.\n767\t    d_beta_pows: DeviceBuffer<EF>,\n768\t    /// Precomputed logup combinations per trace (indexed by trace_idx). Set when xi is sampled.\n769\t    logup_combinations: Vec<Option<LogupCombinations>>,\n770\t\n771\t    // n_T => segment tree of eq(xi[j..1+n_T]) for j=1..={n_T-round+1} in _reverse_ layout\n772\t    eq_xis: FxHashMap<usize, EqEvalLayers<EF>>,\n773\t    eq_3b_per_trace: Vec<Vec<EF>>,\n774\t    d_eq_3b_per_trace: Vec<DeviceBuffer<EF>>,\n775\t    // Evaluations on hypercube only, for round 0\n776\t    sels_per_trace_base: Vec<DeviceMatrix<F>>,\n777\t    // After univariate round 0:\n778\t    mat_evals_per_trace: Vec<Vec<DeviceMatrix<EF>>>,\n779\t    sels_per_trace: Vec<DeviceMatrix<EF>>,\n780\t    // Store public_values per trace (similar to CPU's EvalHelper)\n781\t    public_values_per_trace: Vec<DeviceBuffer<F>>,\n782\t    air_indices_per_trace: Vec<usize>,\n783\t    zerocheck_tilde_evals: Vec<EF>,\n784\t    logup_tilde_evals: Vec<[EF; 2]>,\n785\t    needs_next_per_trace: Vec<bool>,\n786\t\n787\t    trace_interactions: Vec<Option<TraceInteractionMeta>>,\n788\t    // round0: Round0Buffers,\n789\t    pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n790\t\n791\t    // In round `j`, contains `s_{j-1}(r_{j-1})`\n792\t    pub(crate) prev_s_eval: EF,\n793\t    pub(crate) eq_ns: Vec<EF>,\n794\t    pub(crate) eq_sharp_ns: Vec<EF>,\n795\t\n796\t    mem: MemTracker,\n797\t    save_memory: bool,\n798\t\n799\t    gkr_mem_contribution: usize,\n800\t    /// Memory limit for batch MLE intermediate buffers (set after GKR input eval)\n801\t    memory_limit_bytes: usize,\n802\t\n803\t    /// Ping-pong buffers for MLE fold. When active, mat_evals_per_trace and sels_per_trace\n804\t    /// contain non-owning DeviceMatrix views into these buffers.\n805\t    fold_mat_buf_a: Option<DeviceBuffer<EF>>,\n806\t    fold_mat_buf_b: Option<DeviceBuffer<EF>>,\n807\t    fold_sel_buf_a: Option<DeviceBuffer<EF>>,\n808\t    fold_sel_buf_b: Option<DeviceBuffer<EF>>,\n809\t\n810\t    /// Pre-allocated device buffers for per-trace main_ptrs uploads in MLE rounds.\n811\t    /// Indexed by trace_idx. Eliminates per-round cudaMallocAsync/cudaFreeAsync cycles.\n812\t    d_main_ptrs_pool: Vec<DeviceBuffer<MainMatrixPtrs<EF>>>,\n813\t}\n814\t\n815\timpl<'a, HS: GpuHashScheme> LogupZerocheckGpu<'a, HS> {\n816\t    #[allow(clippy::too_many_arguments)]\n817\t    fn new(\n818\t        pk: &'a DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n819\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n820\t        n_logup: usize,\n821\t        interactions_layout: StackedLayout,\n822\t        alpha_logup: EF,\n823\t        beta_logup: EF,\n824\t        save_memory: bool,\n825\t        monomial_num_y_threshold: u32,\n826\t        sm_count: u32,\n827\t    ) -> Result<Self, LogupZerocheckError> {\n828\t        let mem = MemTracker::start(\"prover.logup_zerocheck_prover\");\n829\t        let l_skip = pk.params.l_skip;\n830\t        let omega_skip = F::two_adic_generator(l_skip);\n831\t        let omega_skip_pows = omega_skip.powers().take(1 << l_skip).collect_vec();\n832\t        let d_omega_skip_pows = omega_skip_pows.to_device()?;\n833\t        let num_airs_present = ctx.per_trace.len();\n834\t\n835\t        let constraint_degree = pk.max_constraint_degree;\n836\t\n837\t        let max_interaction_length = pk\n838\t            .per_air\n839\t            .iter()\n840\t            .map(|air_pk| air_pk.other_data.interaction_rules.max_fields_len)\n841\t            .max()\n842\t            .unwrap_or(0);\n843\t        let beta_pows = beta_logup\n844\t            .powers()\n845\t            .take(max_interaction_length + 1)\n846\t            .collect_vec();\n847\t        let challenges = [&[alpha_logup], &beta_pows[..]].concat();\n848\t        let d_challenges = challenges.to_device()?;\n849\t        let d_beta_pows = beta_pows.to_device()?;\n850\t\n851\t        let n_per_trace: Vec<isize> = ctx\n852\t            .common_main_traces()\n853\t            .map(|(_, t)| log2_strict_usize(t.height()) as isize - l_skip as isize)\n854\t            .collect();\n855\t        let n_max = n_per_trace[0].max(0) as usize;\n856\t        let n_global = max(n_max, n_logup);\n857\t        info!(%n_global, %n_logup);\n858\t\n859\t        let max_num_constraints = pk\n860\t            .per_air\n861\t            .iter()\n862\t            .map(|air_pk| {\n863\t                air_pk\n864\t                    .vk\n865\t                    .symbolic_constraints\n866\t                    .constraints\n867\t                    .constraint_idx\n868\t                    .len()\n869\t            })\n870\t            .max()\n871\t            .unwrap_or(0);\n872\t\n873\t        // Collect interaction metadata for GPU execution (evaluations still run on CPU for now).\n874\t        let trace_interactions = collect_trace_interactions(pk, ctx, &interactions_layout);\n875\t\n876\t        let needs_next_per_trace = ctx\n877\t            .per_trace\n878\t            .iter()\n879\t            .map(|(air_idx, _)| pk.per_air[*air_idx].vk.params.need_rot)\n880\t            .collect::<Vec<_>>();\n881\t\n882\t        Ok(Self {\n883\t            alpha_logup,\n884\t            beta_pows,\n885\t            d_challenges,\n886\t            l_skip,\n887\t            n_logup,\n888\t            n_global,\n889\t            omega_skip,\n890\t            omega_skip_pows,\n891\t            d_omega_skip_pows,\n892\t            interactions_layout,\n893\t            constraint_degree,\n894\t            n_per_trace,\n895\t            max_num_constraints,\n896\t            sm_count,\n897\t            xi: vec![],\n898\t            lambda_pows: None,\n899\t            lambda_combinations: (0..pk.per_air.len()).map(|_| None).collect(),\n900\t            d_beta_pows,\n901\t            logup_combinations: (0..num_airs_present).map(|_| None).collect(),\n902\t            eq_xis: FxHashMap::default(),\n903\t            eq_3b_per_trace: vec![],\n904\t            d_eq_3b_per_trace: vec![],\n905\t            sels_per_trace_base: vec![],\n906\t            mat_evals_per_trace: vec![],\n907\t            sels_per_trace: vec![],\n908\t            public_values_per_trace: ctx\n909\t                .per_trace\n910\t                .iter()\n911\t                .map(|(_, air_ctx)| {\n912\t                    if air_ctx.public_values.is_empty() {\n913\t                        Ok(DeviceBuffer::new())\n914\t                    } else {\n915\t                        air_ctx.public_values.to_device()\n916\t                    }\n917\t                })\n918\t                .collect::<Result<Vec<_>, _>>()?,\n919\t            air_indices_per_trace: ctx\n920\t                .per_trace\n921\t                .iter()\n922\t                .map(|(air_idx, _)| *air_idx)\n923\t                .collect_vec(),\n924\t            zerocheck_tilde_evals: vec![EF::ZERO; num_airs_present],\n925\t            logup_tilde_evals: vec![[EF::ZERO; 2]; num_airs_present],\n926\t            needs_next_per_trace,\n927\t            trace_interactions,\n928\t            pk,\n929\t            prev_s_eval: EF::ZERO,\n930\t            eq_ns: Vec::with_capacity(n_max + 1),\n931\t            eq_sharp_ns: Vec::with_capacity(n_max + 1),\n932\t            mem,\n933\t            save_memory,\n934\t            gkr_mem_contribution: 0,\n935\t            memory_limit_bytes: 0, // Set after GKR input eval\n936\t            monomial_num_y_threshold,\n937\t            fold_mat_buf_a: None,\n938\t            fold_mat_buf_b: None,\n939\t            fold_sel_buf_a: None,\n940\t            fold_sel_buf_b: None,\n941\t            d_main_ptrs_pool: Vec::new(),\n942\t        })\n943\t    }\n944\t\n945\t    // PERF[jpw]: we could return evals and batch zerocheck poly by degree before interpolating.\n946\t    // Cannot do it for logup because we need to calculate the sum claims.\n947\t    #[instrument(name = \"prover.rap_constraints.ple_round0\", level = \"info\", skip_all)]\n948\t    fn sumcheck_uni_round0_polys(\n949\t        &mut self,\n950\t        ctx: &ProvingContext<GenericGpuBackend<HS>>,\n951\t        lambda: EF,\n952\t    ) -> Result<Vec<UnivariatePoly<EF>>, LogupZerocheckError> {\n953\t        self.mem\n954\t            .emit_metrics_with_label(\"prover.batch_constraints.before_round0\");\n955\t        self.mem.reset_peak();\n956\t        let n_logup = self.n_logup;\n957\t        let l_skip = self.l_skip;\n958\t        let xi = &self.xi;\n959\t        let h_lambda_pows = lambda.powers().take(self.max_num_constraints).collect_vec();\n960\t        self.lambda_pows = Some(if !h_lambda_pows.is_empty() {\n961\t            h_lambda_pows.to_device()?\n962\t        } else {\n963\t            DeviceBuffer::new()\n964\t        });\n965\t        // Precompute lambda combinations for all AIRs with monomials\n966\t        let lambda_pows_ref = self.lambda_pows.as_ref().unwrap();\n967\t        for (air_idx, air_pk) in self.pk.per_air.iter().enumerate() {\n968\t            if air_pk.other_data.zerocheck_monomials.is_some() {\n969\t                self.lambda_combinations[air_idx] = Some(\n970\t                    compute_lambda_combinations(self.pk, air_idx, lambda_pows_ref)\n971\t                        .map_err(LogupZerocheckError::LambdaCombinations)?,\n972\t                );\n973\t            }\n974\t        }\n975\t        let num_present_airs = ctx.per_trace.len();\n976\t        debug_assert_eq!(num_present_airs, self.n_per_trace.len());\n977\t\n978\t        self.eq_3b_per_trace = ctx\n979\t            .per_trace\n980\t            .iter()\n981\t            .enumerate()\n982\t            .map(|(trace_idx, (air_idx, _))| {\n983\t                let vk = &self.pk.per_air[*air_idx].vk;\n984\t                let num_interactions = vk.num_interactions();\n985\t                if num_interactions > 0 {\n986\t                    let n = self.n_per_trace[trace_idx];\n987\t                    let n_lift = n.max(0) as usize;\n988\t                    let mut b_vec = vec![F::ZERO; n_logup - n_lift];\n989\t                    let mut weights = Vec::with_capacity(num_interactions);\n990\t                    for interaction_idx in 0..num_interactions {\n991\t                        let stacked_idx = self\n992\t                            .interactions_layout\n993\t                            .get(trace_idx, interaction_idx)\n994\t                            .unwrap()\n995\t                            .row_idx;\n996\t                        let mut b_int = stacked_idx >> (l_skip + n_lift);\n997\t                        for bit in &mut b_vec {\n998\t                            *bit = F::from_bool(b_int & 1 == 1);\n999\t                            b_int >>= 1;"}]},"parent_tool_use_id":"toolu_0162mM37dPxajrNVmEiwG5wx","session_id":"78bbe79a-49aa-4ea3-b7e0-2913b403757d","uuid":"3b4b4961-ab9b-4fff-9fa1-e4f0cfd55ec8","timestamp":"2026-04-16T09:22:08.139Z"}
