rom_result(_fold_ple_from_evals(\n970\t        input_matrix.as_ptr(),\n971\t        output_matrix,\n972\t        omega_skip_pows.as_ptr(),\n973\t        inv_lagrange_denoms.as_ptr(),\n974\t        height,\n975\t        width,\n976\t        l_skip,\n977\t        new_height,\n978\t        rotate,\n979\t    ))\n980\t}\n981\t\n982\t/// # Safety\n983\t/// - `fracs` must be a pointer to a device buffer with capacity at least `num_interactions *\n984\t///   height`.\n985\t#[allow(clippy::too_many_arguments)]\n986\tpub unsafe fn logup_gkr_input_eval(\n987\t    is_global: bool,\n988\t    fracs: *mut Frac<EF>,\n989\t    preprocessed: &DeviceBuffer<F>,\n990\t    partitioned_main: &DeviceBuffer<u64>,\n991\t    public_values: &DeviceBuffer<F>,\n992\t    challenges: &DeviceBuffer<EF>,\n993\t    intermediates: &DeviceBuffer<EF>,\n994\t    rules: &DeviceBuffer<u128>,\n995\t    used_nodes: &DeviceBuffer<usize>,\n996\t    pair_idxs: &DeviceBuffer<u32>,\n997\t    height: u32,\n998\t    num_rows_per_tile: u32,\n999\t) -> Result<(), CudaError> {"}]},"parent_tool_use_id":"toolu_01EWbNRnNyxKKhF893EuGF7j","session_id":"78bbe79a-49aa-4ea3-b7e0-2913b403757d","uuid":"172cb161-6ea4-4fc0-92e3-f65616cef039","timestamp":"2026-04-16T08:52:42.057Z"}
