{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011Lb4zgdHabF8yvxQqhRuPH","type":"tool_result","content":"150\t    pub(super) fn new(config: VpmmConfig) -> Self {\n151\t        let device_id = set_device().unwrap();\n152\t\n153\t        // Check VPMM support and resolve page_size\n154\t        let (root, page_size, va_size) = unsafe {\n155\t            match vpmm_check_support(device_id) {\n156\t                Ok(_) => {\n157\t                    let granularity = vpmm_min_granularity(device_id).unwrap();\n158\t\n159\t                    // Resolve page_size: use config override or device granularity\n160\t                    let page_size = match config.page_size {\n161\t                        Some(size) => {\n162\t                            assert!(\n163\t                                size > 0 && size % granularity == 0,\n164\t                                \"VPMM_PAGE_SIZE must be > 0 and multiple of {}\",\n165\t                                granularity\n166\t                            );\n167\t                            size\n168\t                        }\n169\t                        None => {\n170\t                            // Use 8x the minimum granularity (typically 16 MiB) to reduce\n171\t                            // the number of cuMemCreate calls for large allocations.\n172\t                            // Each cuMemCreate has ~0.4ms driver overhead; with 2 MiB pages\n173\t                            // a 256 MiB allocation requires 128 calls (~51ms). With 16 MiB\n174\t                            // pages it requires only 16 calls (~6ms).\n175\t                            // Allocations smaller than the page size use cudaMallocAsync.\n176\t                            8 * granularity\n177\t                        }\n178\t                    };\n179\t\n180\t                    // Validate va_size\n181\t                    let va_size = config.va_size;\n182\t                    assert!(\n183\t                        va_size > 0 && va_size.is_multiple_of(page_size),\n184\t                        \"VPMM_VA_SIZE must be > 0 and multiple of page size ({})\",\n185\t                        page_size\n186\t                    );\n187\t\n188\t                    // Reserve initial VA chunk\n189\t                    let va_base = vpmm_reserve(va_size, page_size).unwrap();\n190\t                    tracing::debug!(\n191\t                        \"VPMM: Reserved virtual address space {} with page size {}\",\n192\t                        ByteSize::b(va_size as u64),\n193\t                        ByteSize::b(page_size as u64)\n194\t                    );\n195\t                    (va_base, page_size, va_size)\n196\t                }\n197\t                Err(_) => {\n198\t                    tracing::warn!(\"VPMM not supported, falling back to cudaMallocAsync\");\n199\t                    (0, usize::MAX, 0)\n200\t                }\n201\t            }\n202\t        };\n203\t\n204\t        let mut pool = Self {\n205\t            roots: vec![root],\n206\t            active_pages: HashMap::new(),\n207\t            free_regions: BTreeMap::new(),\n208\t            malloc_regions: HashMap::new(),\n209\t            unmapped_regions: if va_size > 0 {\n210\t                BTreeMap::from_iter([(root, va_size)])\n211\t            } else {\n212\t                BTreeMap::new()\n213\t            },\n214\t            zombie_regions: Vec::new(),\n215\t            free_num: 0,\n216\t            page_size,\n217\t            va_size,\n218\t            device_id,\n219\t        };\n220\t\n221\t        // Preallocate pages if requested (skip if VPMM not supported)\n222\t        if config.initial_pages > 0 && page_size != usize::MAX {\n223\t            let alloc_size = config.initial_pages * page_size;\n224\t            if let Err(e) =\n225\t                pool.defragment_or_create_new_pages(alloc_size, current_stream_id().unwrap())\n226\t            {\n227\t                let mut free_mem = 0usize;\n228\t                let mut total_mem = 0usize;\n229\t                unsafe {\n230\t                    cudaMemGetInfo(&mut free_mem, &mut total_mem);\n231\t                }\n232\t                panic!(\n233\t                    \"VPMM preallocation failed: {:?}\\n\\\n234\t                     Config: pages={}, page_size={}\\n\\\n235\t                     GPU Memory: free={}, total={}\",\n236\t                    e,\n237\t                    config.initial_pages,\n238\t                    ByteSize::b(page_size as u64),\n239\t                    ByteSize::b(free_mem as u64),\n240\t                    ByteSize::b(total_mem as u64)\n241\t                );\n242\t            }\n243\t        }\n244\t\n245\t        pool\n246\t    }\n247\t\n248\t    /// Allocates memory from the pool's free regions.\n249\t    /// Attempts defragmentation if no suitable free region exists.\n250\t    /// Returns an error if there's insufficient memory even after defragmentation.\n251\t    pub(super) fn malloc_internal(\n252\t        &mut self,\n253\t        requested: usize,\n254\t        stream_id: CudaStreamId,\n255\t    ) -> Result<*mut c_void, MemoryError> {\n256\t        debug_assert!(\n257\t            requested != 0 && requested.is_multiple_of(self.page_size),\n258\t            \"Requested size must be a multiple of the page size\"\n259\t        );\n260\t\n261\t        // Phase 0: Cleanup zombie regions\n262\t        self.cleanup_zombie_regions();\n263\t\n264\t        // Phase 1: Zero-cost attempts\n265\t        let mut best_region = self.find_best_fit(requested, stream_id);\n266\t\n267\t        if best_region.is_none() {\n268\t            // Phase 2: Defragmentation\n269\t            best_region = self.defragment_or_create_new_pages(requested, stream_id)?;\n270\t        }\n271\t\n272\t        if let Some(ptr) = best_region {\n273\t            let region = self\n274\t                .free_regions\n275\t                .remove(&ptr)\n276\t                .expect(\"BUG: free region address not found after find_best_fit\");\n277\t            debug_assert_eq!(region.stream_id, stream_id);\n278\t\n279\t            // If region is larger, return remainder to free list\n280\t            if region.size > requested {\n281\t                self.free_regions.insert(\n282\t                    ptr + requested as u64,\n283\t                    FreeRegionMeta {\n284\t                        size: region.size - requested,\n285\t                        event: region.event,\n286\t                        stream_id,\n287\t                        id: region.id,\n288\t                    },\n289\t                );\n290\t            }\n291\t\n292\t            self.malloc_regions.insert(ptr, requested);\n293\t            return Ok(ptr as *mut c_void);\n294\t        }\n295\t\n296\t        Err(MemoryError::OutOfMemory {\n297\t            requested,\n298\t            available: self.free_regions.values().map(|r| r.size).sum(),\n299\t        })\n300\t    }\n301\t\n302\t    /// Reclaims zombie regions whose events have completed.\n303\t    ///\n304\t    /// Zombies are old regions that have been double-mapped to new locations during defrag.\n305\t    /// Once the associated event completes (meaning no GPU work is using the old VA),\n306\t    /// we can safely unmap the old VA and return it to `unmapped_regions` for reuse.\n307\t    fn cleanup_zombie_regions(&mut self) {\n308\t        let mut i = 0;\n309\t        while i < self.zombie_regions.len() {\n310\t            if self.zombie_regions[i].event.completed() {\n311\t                let zombie = self.zombie_regions.swap_remove(i);\n312\t                if let Err(e) = unsafe { vpmm_unmap(zombie.ptr, zombie.size) } {\n313\t                    tracing::error!(\n314\t                        \"vpmm_unmap (zombie) failed: addr={:#x}, size={}: {:?}\",\n315\t                        zombie.ptr,\n316\t                        zombie.size,\n317\t                        e\n318\t                    );\n319\t                }\n320\t                self.insert_unmapped_region(zombie.ptr, zombie.size);\n321\t            } else {\n322\t                i += 1;\n323\t            }\n324\t        }\n325\t    }\n326\t\n327\t    /// Phase 1: Try to find a suitable free region without defragmentation\n328\t    /// Returns address if found, None otherwise\n329\t    fn find_best_fit(&mut self, requested: usize, stream_id: CudaStreamId) -> Option<CUdeviceptr> {\n330\t        let mut candidates: Vec<(CUdeviceptr, &mut FreeRegionMeta)> = self\n331\t            .free_regions\n332\t            .iter_mut()\n333\t            .filter(|(_, region)| region.size >= requested)\n334\t            .map(|(addr, region)| (*addr, region))\n335\t            .collect();\n336\t\n337\t        if candidates.is_empty() {\n338\t            return None;\n339\t        }\n340\t\n341\t        // 1a. Prefer current stream (smallest fit) - could be not completed\n342\t        if let Some((addr, _)) = candidates\n343\t            .iter()\n344\t            .filter(|(_, region)| region.stream_id == stream_id)\n345\t            .min_by_key(|(_, region)| region.size)\n346\t        {\n347\t            return Some(*addr);\n348\t        }\n349\t\n350\t        // 1b. Other streams (smallest fit) - ONLY if already completed (no sync)\n351\t        candidates\n352\t            .iter_mut()\n353\t            .filter(|(_, region)| region.event.completed())\n354\t            .min_by_key(|(_, region)| region.size)\n355\t            .map(|(addr, region)| {\n356\t                region.stream_id = stream_id;\n357\t                *addr\n358\t            })\n359\t    }\n360\t\n361\t    /// Frees a pointer and returns the size of the freed memory.\n362\t    /// Coalesces adjacent free regions.\n363\t    ///\n364\t    /// # Assumptions\n365\t    /// No CUDA streams will use the malloc region starting at `ptr` after the newly recorded event\n366\t    /// on `stream_id` at this point in time.\n367\t    pub(super) fn free_internal(\n368\t        &mut self,\n369\t        ptr: *mut c_void,\n370\t        stream_id: CudaStreamId,\n371\t    ) -> Result<usize, MemoryError> {\n372\t        let ptr = ptr as CUdeviceptr;\n373\t        let size = self\n374\t            .malloc_regions\n375\t            .remove(&ptr)\n376\t            .ok_or(MemoryError::InvalidPointer)?;\n377\t\n378\t        let _ = self.free_region_insert(ptr, size, stream_id);\n379\t\n380\t        Ok(size)\n381\t    }\n382\t\n383\t    /// Inserts a new free region for `(ptr, size)` into the free regions map, **possibly** merging\n384\t    /// with existing adjacent regions. Merges only occur if the regions are both adjacent in memory\n385\t    /// and on the same stream as `stream_id`. The new free region always records a new event on the\n386\t    /// stream.\n387\t    ///\n388\t    /// Returns the starting pointer and size of the (possibly merged) free region containing `(ptr,\n389\t    /// size)`.\n390\t    fn free_region_insert(\n391\t        &mut self,\n392\t        mut ptr: CUdeviceptr,\n393\t        mut size: usize,\n394\t        stream_id: CudaStreamId,\n395\t    ) -> (CUdeviceptr, usize) {\n396\t        // Potential merge with next neighbor\n397\t        if let Some((&next_ptr, next_region)) = self.free_regions.range(ptr + 1..).next() {\n398\t            if next_region.stream_id == stream_id && ptr + size as u64 == next_ptr {\n399\t                let next_region = self.free_regions.remove(&next_ptr).unwrap();"}]},"parent_tool_use_id":"toolu_01FpUXj5rMDdJzQNh4MtL5WB","session_id":"78bbe79a-49aa-4ea3-b7e0-2913b403757d","uuid":"aac40b52-818a-4218-8f5f-d4da08b0bce4","timestamp":"2026-04-16T09:26:02.794Z"}
