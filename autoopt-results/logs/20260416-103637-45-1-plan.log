8\t        MerkleTreeError,\n189\t    > {\n190\t        let row_idxs = query_indices\n191\t            .iter()\n192\t            .flat_map(|&query_idx| {\n193\t                debug_assert!(query_idx < query_stride);\n194\t                (0..rows_per_query)\n195\t                    .map(move |row_offset| (row_offset * query_stride + query_idx) as u32)\n196\t            })\n197\t            .collect_vec();\n198\t        let d_row_idxs = row_idxs.to_device()?;\n199\t        // PERF[jpw]: I did not batch across trees into a single kernel call because widths are"}]},"parent_tool_use_id":"toolu_01PitNSRWhugZaW1me6ZTYZB","session_id":"78bbe79a-49aa-4ea3-b7e0-2913b403757d","uuid":"31c4d9ff-8d80-45ed-b389-ec09dfa6eb7d","timestamp":"2026-04-16T09:32:01.938Z"}
