{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AivSSn6Y4AVi7he67oe2nC","type":"tool_result","content":"1\tuse std::{fmt::Debug, marker::PhantomData, sync::Arc};\n2\t\n3\tuse openvm_cuda_common::{copy::MemCopyD2H, d_buffer::DeviceBuffer, error::MemCopyError};\n4\tuse openvm_stark_backend::prover::MatrixDimensions;\n5\t\n6\tpub struct DeviceMatrix<T> {\n7\t    buffer: Arc<DeviceBuffer<T>>,\n8\t    height: usize,\n9\t    width: usize,\n10\t}\n11\t\n12\tunsafe impl<T> Send for DeviceMatrix<T> {}\n13\tunsafe impl<T> Sync for DeviceMatrix<T> {}\n14\t\n15\timpl<T> Clone for DeviceMatrix<T> {\n16\t    fn clone(&self) -> Self {\n17\t        Self {\n18\t            buffer: Arc::clone(&self.buffer),\n19\t            height: self.height,\n20\t            width: self.width,\n21\t        }\n22\t    }\n23\t}\n24\t\n25\timpl<T> Drop for DeviceMatrix<T> {\n26\t    fn drop(&mut self) {\n27\t        tracing::debug!(\n28\t            \"Dropping DeviceMatrix of size {} with Arc strong count={}\",\n29\t            self.buffer.len(),\n30\t            self.strong_count()\n31\t        );\n32\t    }\n33\t}\n34\t\n35\timpl<T> DeviceMatrix<T> {\n36\t    pub fn new(buffer: Arc<DeviceBuffer<T>>, height: usize, width: usize) -> Self {\n37\t        assert_ne!(\n38\t            height * width,\n39\t            0,\n40\t            \"Zero dimensions h {} w {} are wrong\",\n41\t            height,\n42\t            width\n43\t        );\n44\t        assert_eq!(\n45\t            buffer.len(),\n46\t            height * width,\n47\t            \"Buffer size must match dimensions\"\n48\t        );\n49\t        Self {\n50\t            buffer,\n51\t            height,\n52\t            width,\n53\t        }\n54\t    }\n55\t\n56\t    pub fn with_capacity(height: usize, width: usize) -> Self {\n57\t        Self {\n58\t            buffer: Arc::new(DeviceBuffer::with_capacity(height * width)),\n59\t            height,\n60\t            width,\n61\t        }\n62\t    }\n63\t\n64\t    /// Creates a non-owning view into a sub-region of device memory.\n65\t    /// The view will NOT free the underlying memory on drop.\n66\t    ///\n67\t    /// # Safety\n68\t    /// The caller must ensure `ptr` points to valid device memory for `height * width` elements\n69\t    /// and that the underlying memory outlives this view.\n70\t    pub unsafe fn non_owning_view(ptr: *mut T, height: usize, width: usize) -> Self {\n71\t        Self {\n72\t            buffer: Arc::new(DeviceBuffer::non_owning(ptr, height * width)),\n73\t            height,\n74\t            width,\n75\t        }\n76\t    }\n77\t\n78\t    pub fn dummy() -> Self {\n79\t        Self {\n80\t            buffer: Arc::new(DeviceBuffer::new()),\n81\t            height: 0,\n82\t            width: 0,\n83\t        }\n84\t    }\n85\t\n86\t    pub fn buffer(&self) -> &DeviceBuffer<T> {\n87\t        &self.buffer\n88\t    }\n89\t\n90\t    pub fn strong_count(&self) -> usize {\n91\t        Arc::strong_count(&self.buffer)\n92\t    }\n93\t\n94\t    pub fn as_view(&self) -> DeviceMatrixView<'_, T> {\n95\t        // SAFETY: buffer is borrowed for lifetime 'a of the view\n96\t        unsafe { DeviceMatrixView::from_raw_parts(self.buffer.as_ptr(), self.height, self.width) }\n97\t    }\n98\t}\n99\t\n100\timpl<T> MatrixDimensions for DeviceMatrix<T> {\n101\t    #[inline]\n102\t    fn height(&self) -> usize {\n103\t        self.height\n104\t    }\n105\t\n106\t    #[inline]\n107\t    fn width(&self) -> usize {\n108\t        self.width\n109\t    }\n110\t}\n111\t\n112\timpl<T> MemCopyD2H<T> for DeviceMatrix<T> {\n113\t    fn to_host(&self) -> Result<Vec<T>, MemCopyError> {\n114\t        self.buffer.to_host()\n115\t    }\n116\t}\n117\t\n118\timpl<T: Debug> Debug for DeviceMatrix<T> {\n119\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n120\t        write!(\n121\t            f,\n122\t            \"DeviceMatrix (height = {}, width = {}): {:?}\",\n123\t            self.height(),\n124\t            self.width(),\n125\t            self.buffer()\n126\t        )\n127\t    }\n128\t}\n129\t\n130\t/// View of a device matrix. Dropping does not free memory.\n131\t#[derive(Clone, Copy)]\n132\tpub struct DeviceMatrixView<'a, T> {\n133\t    ptr: *const T,\n134\t    height: usize,\n135\t    width: usize,\n136\t    _ptr_lifetime: PhantomData<&'a T>,\n137\t}\n138\t\n139\tunsafe impl<T> Send for DeviceMatrixView<'_, T> {}\n140\tunsafe impl<T> Sync for DeviceMatrixView<'_, T> {}\n141\t\n142\timpl<T> DeviceMatrixView<'_, T> {\n143\t    /// # Safety\n144\t    /// - The pointer must be valid for the lifetime of the view.\n145\t    /// - The pointer must have memory allocated for the following `height * width` elements of `T`.\n146\t    pub unsafe fn from_raw_parts(ptr: *const T, height: usize, width: usize) -> Self {\n147\t        Self {\n148\t            ptr,\n149\t            height,\n150\t            width,\n151\t            _ptr_lifetime: PhantomData,\n152\t        }\n153\t    }\n154\t\n155\t    pub fn as_ptr(&self) -> *const T {\n156\t        self.ptr\n157\t    }\n158\t}\n159\t\n160\timpl<T> MatrixDimensions for DeviceMatrixView<'_, T> {\n161\t    #[inline]\n162\t    fn height(&self) -> usize {\n163\t        self.height\n164\t    }\n165\t\n166\t    #[inline]\n167\t    fn width(&self) -> usize {\n168\t        self.width\n169\t    }\n170\t}\n171\t\n172\t/// The following trait and types are borrowed from [halo2](https:://github.com/zcash/halo2).\n173\t/// The basis over which a polynomial is described.\n174\tpub trait Basis: Copy + Debug + Send + Sync {}\n175\t\n176\t/// The polynomial is defined as coefficients\n177\t#[derive(Clone, Copy, Debug)]\n178\tpub struct Coeff;\n179\timpl Basis for Coeff {}\n180\t\n181\t/// The polynomial is defined as coefficients of Lagrange basis polynomials\n182\t#[derive(Clone, Copy, Debug)]\n183\tpub struct LagrangeCoeff;\n184\timpl Basis for LagrangeCoeff {}\n185\t\n186\t/// The polynomial is defined as coefficients of Lagrange basis polynomials in\n187\t/// an extended size domain which supports multiplication\n188\t#[derive(Clone, Copy, Debug)]\n189\tpub struct ExtendedLagrangeCoeff;\n190\timpl Basis for ExtendedLagrangeCoeff {}\n191\t\n192\tpub struct DevicePoly<T, B> {\n193\t    pub is_bit_reversed: bool,\n194\t    pub coeff: DeviceBuffer<T>,\n195\t    _marker: PhantomData<B>,\n196\t}\n197\t\n198\timpl<T, B> DevicePoly<T, B> {\n199\t    pub fn new(is_bit_reversed: bool, coeff: DeviceBuffer<T>) -> Self {\n200\t        Self {\n201\t            is_bit_reversed,\n202\t            coeff,\n203\t            _marker: PhantomData,\n204\t        }\n205\t    }\n206\t\n207\t    #[inline]\n208\t    pub fn len(&self) -> usize {\n209\t        self.coeff.len()\n210\t    }\n211\t\n212\t    #[inline]\n213\t    pub fn is_empty(&self) -> bool {\n214\t        self.len() == 0\n215\t    }\n216\t}\n217\t\n218\t#[cfg(test)]\n219\tmod tests {\n220\t    use super::*;\n221\t\n222\t    #[test]\n223\t    fn test_device_matrix() {\n224\t        let buffer = Arc::new(DeviceBuffer::<i32>::with_capacity(12));\n225\t        let matrix = DeviceMatrix::<i32>::new(buffer, 3, 4);\n226\t        assert_eq!(matrix.height(), 3);\n227\t        assert_eq!(matrix.width(), 4);\n228\t    }\n229\t}\n230\t"}]},"parent_tool_use_id":"toolu_01FpUXj5rMDdJzQNh4MtL5WB","session_id":"78bbe79a-49aa-4ea3-b7e0-2913b403757d","uuid":"956bd206-c967-44af-953f-42852514f2e0","timestamp":"2026-04-16T09:25:48.376Z"}
