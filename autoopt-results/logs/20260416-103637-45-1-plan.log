{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Not2GqVtDd1fndaSvsd3Zj","type":"tool_result","content":"1\tuse super::*;\n2\tuse crate::{\n3\t    monomial::{InteractionMonomialTerm, LambdaTerm, MonomialHeader, PackedVar},\n4\t    poly::SqrtEqLayers,\n5\t};\n6\t\n7\t#[repr(C)]\n8\t#[derive(Clone, Copy, Debug)]\n9\tpub struct MainMatrixPtrs<T> {\n10\t    pub data: *const T,\n11\t    pub air_width: u32,\n12\t}\n13\t\n14\t// Types for batch MLE:\n15\t#[repr(C)]\n16\t#[derive(Clone, Copy, Debug)]\n17\tpub struct BlockCtx {\n18\t    pub local_block_idx_x: u32,\n19\t    /// Caution: this refers to the index within buffer of `ZerocheckCtx` or `LogupCtx`. It is\n20\t    /// hence a \"local\" AIR index and not the global AIR index within the proving key.\n21\t    pub air_idx: u32,\n22\t}\n23\t\n24\t/// Per-AIR context for batched monomial evaluation.\n25\t#[repr(C)]\n26\t#[derive(Clone, Copy, Debug)]\n27\tpub struct MonomialAirCtx {\n28\t    pub d_headers: *const MonomialHeader,\n29\t    pub d_variables: *const PackedVar,\n30\t    pub d_lambda_combinations: *const EF, // Precomputed per-monomial\n31\t    pub num_monomials: u32,\n32\t    pub eval_ctx: EvalCoreCtx,\n33\t    pub d_eq_xi: *const EF,\n34\t    pub num_y: u32,\n35\t}\n36\t\n37\t#[repr(C)]\n38\t#[derive(Clone, Copy, Debug)]\n39\tpub struct EvalCoreCtx {\n40\t    pub d_selectors: *const EF,\n41\t    pub d_preprocessed: MainMatrixPtrs<EF>,\n42\t    pub d_main: *const MainMatrixPtrs<EF>,\n43\t    pub d_public: *const F,\n44\t}\n45\t\n46\t#[repr(C)]\n47\t#[derive(Clone, Copy, Debug)]\n48\tpub struct ZerocheckCtx {\n49\t    pub eval_ctx: EvalCoreCtx,\n50\t    pub d_intermediates: *mut EF,\n51\t    pub num_y: u32,\n52\t    pub d_eq_xi: *const EF,\n53\t    pub d_rules: *const std::ffi::c_void,\n54\t    pub rules_len: usize,\n55\t    pub d_used_nodes: *const usize,\n56\t    pub used_nodes_len: usize,\n57\t    pub buffer_size: u32,\n58\t}\n59\t\n60\t#[repr(C)]\n61\t#[derive(Clone, Copy, Debug)]\n62\tpub struct LogupCtx {\n63\t    pub eval_ctx: EvalCoreCtx,\n64\t    pub d_intermediates: *mut EF,\n65\t    pub num_y: u32,\n66\t    pub d_eq_xi: *const EF,\n67\t    pub d_challenges: *const EF,\n68\t    pub d_eq_3bs: *const EF,\n69\t    pub d_rules: *const std::ffi::c_void,\n70\t    pub rules_len: usize,\n71\t    pub d_used_nodes: *const usize,\n72\t    pub d_pair_idxs: *const u32,\n73\t    pub used_nodes_len: usize,\n74\t    pub buffer_size: u32,\n75\t}\n76\t\n77\t/// Common per-AIR context for batched logup monomial evaluation.\n78\t#[repr(C)]\n79\t#[derive(Clone, Copy, Debug)]\n80\tpub struct LogupMonomialCommonCtx {\n81\t    pub eval_ctx: EvalCoreCtx,\n82\t    pub d_eq_xi: *const EF,\n83\t    pub bus_term_sum: EF, // Precomputed sum_i(beta[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n84\t    pub num_y: u32,\n85\t    pub mono_blocks: u32,\n86\t}\n87\t\n88\t/// Per-AIR context for batched logup monomial evaluation (numerator or denominator).\n89\t#[repr(C)]\n90\t#[derive(Clone, Copy, Debug)]\n91\tpub struct LogupMonomialCtx {\n92\t    pub d_headers: *const MonomialHeader,\n93\t    pub d_variables: *const PackedVar,\n94\t    pub d_combinations: *const EF,\n95\t    pub num_monomials: u32,\n96\t}\n97\t/// Descriptor for batched interpolation of columns across multiple traces.\n98\t#[repr(C)]\n99\t#[derive(Clone, Copy, Debug)]\n100\tpub struct InterpColDesc {\n101\t    pub output: *mut EF,\n102\t    pub columns_offset: u32,\n103\t    pub num_y: u32,\n104\t    pub num_columns: u32,\n105\t    pub total_threads: u32,\n106\t    pub block_start: u32,\n107\t}\n108\t\n109\tunsafe impl Send for InterpColDesc {}\n110\tunsafe impl Sync for InterpColDesc {}\n111\t\n112\t#[repr(C)]\n113\t#[derive(Clone, Copy, Debug)]\n114\tpub struct InterpMatrixInfo {\n115\t    pub base: *const EF,\n116\t    pub width: u32,\n117\t}\n118\t\n119\tunsafe impl Send for InterpMatrixInfo {}\n120\tunsafe impl Sync for InterpMatrixInfo {}\n121\t\n122\t#[repr(C)]\n123\t#[derive(Clone, Copy, Debug)]\n124\tpub struct InterpTraceDescM {\n125\t    pub output: *mut EF,\n126\t    pub matrix_offset: u32,\n127\t    pub num_matrices: u32,\n128\t    pub num_y: u32,\n129\t    pub num_columns: u32,\n130\t    pub total_threads: u32,\n131\t    pub block_start: u32,\n132\t}\n133\t\n134\tunsafe impl Send for InterpTraceDescM {}\n135\tunsafe impl Sync for InterpTraceDescM {}\n136\t\n137\t// end of types for batch MLE\n138\t\n139\textern \"C\" {\n140\t    // gkr.cu\n141\t    fn _frac_build_tree_layer(\n142\t        layer: *mut Frac<EF>,\n143\t        layer_size: usize,\n144\t        revert: bool,\n145\t        alpha: EF,\n146\t        apply_alpha: bool,\n147\t    ) -> i32;\n148\t\n149\t    /// Fused two-layer tree build. Applies layers i and i+1 in one kernel pass,\n150\t    /// keeping intermediate right-half nodes for revert operations.\n151\t    /// `half_i1` = N >> (i+2), where i is the first of the two layers.\n152\t    fn _frac_build_tree_two_layers(layer: *mut Frac<EF>, half_i1: usize) -> i32;\n153\t\n154\t    pub fn _frac_compute_round_temp_buffer_size(stride: u32) -> u32;\n155\t\n156\t    fn _frac_compute_round(\n157\t        eq_xi_low: *const EF,\n158\t        eq_xi_high: *const EF,\n159\t        pq_buffer: *const Frac<EF>,\n160\t        num_x: usize,\n161\t        eq_low_cap: usize,\n162\t        lambda: EF,\n163\t        out_device: *mut EF,\n164\t        tmp_block_sums: *mut EF,\n165\t    ) -> i32;\n166\t\n167\t    /// Fused compute round + tree layer revert. Combines frac_build_tree_layer(revert=true)\n168\t    /// with compute_round for the first inner round. Modifies layer in-place for revert.\n169\t    fn _frac_compute_round_and_revert(\n170\t        eq_xi_low: *const EF,\n171\t        eq_xi_high: *const EF,\n172\t        layer: *mut Frac<EF>,\n173\t        num_x: usize,\n174\t        eq_low_cap: usize,\n175\t        lambda: EF,\n176\t        out_device: *mut EF,\n177\t        tmp_block_sums: *mut EF,\n178\t    ) -> i32;\n179\t\n180\t    fn _frac_fold_fpext_columns(\n181\t        src: *const Frac<EF>,\n182\t        dst: *mut Frac<EF>,\n183\t        size: usize,\n184\t        r: EF,\n185\t    ) -> i32;\n186\t\n187\t    /// Fused compute round + fold (out-of-place). Reads from pre-fold src_pq_buffer (size\n188\t    /// src_pq_size), computes sumcheck sums, and writes folded output to dst_pq_buffer (size\n189\t    /// src_pq_size/2). IMPORTANT: src_pq_buffer and dst_pq_buffer must NOT alias.\n190\t    fn _frac_compute_round_and_fold(\n191\t        eq_xi_low: *const EF,\n192\t        eq_xi_high: *const EF,\n193\t        src_pq_buffer: *const Frac<EF>,\n194\t        dst_pq_buffer: *mut Frac<EF>,\n195\t        src_pq_size: usize,\n196\t        eq_low_cap: usize,\n197\t        lambda: EF,\n198\t        r_prev: EF,\n199\t        out_device: *mut EF,\n200\t        tmp_block_sums: *mut EF,\n201\t    ) -> i32;\n202\t\n203\t    /// Fused compute round + fold (in-place). Reads from pre-fold pq_buffer (size src_pq_size),\n204\t    /// computes sumcheck sums, and writes folded output to the same buffer (first src_pq_size/2\n205\t    /// elements).\n206\t    fn _frac_compute_round_and_fold_inplace(\n207\t        eq_xi_low: *const EF,\n208\t        eq_xi_high: *const EF,\n209\t        pq_buffer: *mut Frac<EF>,\n210\t        src_pq_size: usize,\n211\t        eq_low_cap: usize,\n212\t        lambda: EF,\n213\t        r_prev: EF,\n214\t        out_device: *mut EF,\n215\t        tmp_block_sums: *mut EF,\n216\t    ) -> i32;\n217\t\n218\t    fn _frac_precompute_m_build(\n219\t        pq: *const Frac<EF>,\n220\t        rem_n: usize,\n221\t        w: usize,\n222\t        lambda: EF,\n223\t        r_prev: EF,\n224\t        inline_fold: bool,\n225\t        eq_tail_low: *const EF,\n226\t        eq_tail_high: *const EF,\n227\t        eq_tail_low_cap: usize,\n228\t        tail_tile: usize,\n229\t        partial_out: *mut EF,\n230\t        partial_len: usize,\n231\t        m_total: *mut EF,\n232\t    ) -> i32;\n233\t\n234\t    fn _frac_precompute_m_eval_ro