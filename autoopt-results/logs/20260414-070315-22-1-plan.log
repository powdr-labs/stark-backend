{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01339Xwq2GpDb2gTiiNPCZ7r","type":"tool_result","content":"1219\t\n1220\t        // Pre-allocate per-thread buffer pools to avoid per-AIR mutex contention.\n1221\t        let skip_prealloc = num_threads == 1 && per_thread_bytes > 2_000_000_000;\n1222\t        let thread_buffers: Vec<round0::Round0ThreadBuffers> = if skip_prealloc {\n1223\t            tracing::warn!(\n1224\t                \"Skipping Round 0 pre-allocation: {}MB exceeds 2GB budget\",\n1225\t                per_thread_bytes / (1024 * 1024),\n1226\t            );\n1227\t            (0..num_threads)\n1228\t                .map(|_| round0::Round0ThreadBuffers {\n1229\t                    zc_intermediates: DeviceBuffer::new(),\n1230\t                    zc_temp_sums: DeviceBuffer::new(),\n1231\t                    logup_intermediates: DeviceBuffer::new(),\n1232\t                    logup_temp_sums: DeviceBuffer::new(),\n1233\t                })\n1234\t                .collect()\n1235\t        } else {\n1236\t            tracing::debug!(\n1237\t                \"Pre-allocating Round 0 buffers: {}MB per thread × {} threads\",\n1238\t                per_thread_bytes / (1024 * 1024),\n1239\t                num_threads,\n1240\t            );\n1241\t            (0..num_threads)\n1242\t                .map(|_| round0::Round0ThreadBuffers {\n1243\t                    zc_intermediates: if max_zc_intermed > 0 {\n1244\t                        DeviceBuffer::with_capacity(max_zc_intermed)\n1245\t                    } else {\n1246\t                        DeviceBuffer::new()\n1247\t                    },\n1248\t                    zc_temp_sums: if max_zc_temp_sums > 0 {\n1249\t                        DeviceBuffer::with_capacity(max_zc_temp_sums)\n1250\t                    } else {\n1251\t                        DeviceBuffer::new()\n1252\t                    },\n1253\t                    logup_intermediates: if max_logup_intermed > 0 {\n1254\t                        DeviceBuffer::with_capacity(max_logup_intermed)\n1255\t                    } else {\n1256\t                        DeviceBuffer::new()\n1257\t                    },\n1258\t                    logup_temp_sums: if max_logup_temp_sums > 0 {\n1259\t                        DeviceBuffer::with_capacity(max_logup_temp_sums)\n1260\t                    } else {\n1261\t                        DeviceBuffer::new()\n1262\t                    },\n1263\t                })\n1264\t                .collect()\n1265\t        };\n1266\t\n1267\t        // Transmit batch array pointer as usize for thread-safety.\n1268\t        // Worker threads write to non-overlapping offsets (by unique trace_idx),\n1269\t        // and CUDA guarantees non-overlapping device writes from different streams are safe.\n1270\t        let batch_ptr_val = d_batch_array.as_mut_ptr() as usize;\n1271\t\n1272\t        if num_threads <= 1 {\n1273\t            let mut bufs = thread_buffers.into_iter().next().unwrap();\n1274\t            for w in &work_items {\n1275\t                process_air_round0(w, &mut bufs, batch_ptr_val as *mut EF, &extract_tables)?;\n1276\t            }\n1277\t            current_stream_sync().map_err(MemCopyError::from)?;\n1278\t        } else {\n1279\t            // Interleaved (round-robin) assignment on the height-sorted list.\n1280\t            // Work items are already sorted by descending height. Round-robin\n1281\t            // distributes them so each thread gets a balanced mix of large and\n1282\t            // small AIRs (thread 0 gets items 0, N, 2N, ...; thread 1 gets\n1283\t            // items 1, N+1, 2N+1, ...). This balances both per-AIR fixed\n1284\t            // overhead (kernel launches) and height-proportional GPU kernel time\n1285\t            // without needing a calibrated cost model.\n1286\t            let mut thread_items: Vec<Vec<usize>> =\n1287\t                (0..num_threads).map(|_| Vec::new()).collect();\n1288\t            for (item_idx, _) in work_items.iter().enumerate() {\n1289\t                thread_items[item_idx % num_threads].push(item_idx);\n1290\t            }\n1291\t\n1292\t            std::thread::scope(|s| {\n1293\t                let handles: Vec<_> = thread_buffers\n1294\t                    .into_iter()\n1295\t                    .zip(thread_items.into_iter())\n1296\t                    .enumerate()\n1297\t                    .map(|(thread_id, (mut bufs, indices))| {\n1298\t                        let items = &work_items;\n1299\t                        let tables = &extract_tables;\n1300\t                        s.spawn(move || -> Result<(), LogupZerocheckError> {\n1301\t                            let t0 = std::time::Instant::now();\n1302\t                            let d_batch_ptr = batch_ptr_val as *mut EF;\n1303\t                            for &idx in &indices {\n1304\t                                process_air_round0(&items[idx], &mut bufs, d_batch_ptr, tables)?;\n1305\t                            }\n1306\t                            // Sync this thread's stream to ensure all extraction kernels\n1307\t                            // complete before the thread exits. Required so the main thread's\n1308\t                            // D2H copy sees the final data.\n1309\t                            current_stream_sync().map_err(MemCopyError::from)?;\n1310\t                            tracing::debug!(thread_id, elapsed_ms = t0.elapsed().as_millis(), num_airs = indices.len(), \"round0 thread done\");\n1311\t                            Ok(())\n1312\t                        })\n1313\t                    })\n1314\t                    .collect();\n1315\t                for handle in handles {\n1316\t                    handle.join().unwrap()?;\n1317\t                }\n1318\t                Ok::<_, LogupZerocheckError>(())\n1319\t            })?;\n1320\t        }\n1321\t\n1322\t        // Phase 3: Single D2H copy of the batch array, then reconstruct batch_sp_poly.\n1323\t        let host