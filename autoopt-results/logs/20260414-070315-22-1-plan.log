{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0159RKmiAy4zXUZE4hayvrzS","type":"tool_result","content":"1\t/*\n2\t * Source: https://github.com/scroll-tech/plonky3-gpu (private repo)\n3\t * Status: BASED ON plonky3-gpu/gpu-backend/src/cuda/kernels/matrix.cu\n4\t * Imported: 2025-01-25 by @gaxiom\n5\t */\n6\t\n7\t#include \"fp.h\"\n8\t#include \"fpext.h\"\n9\t#include \"launcher.cuh\"\n10\t#include <algorithm>\n11\t#include <cassert>\n12\t#include <cstdint>\n13\t#include <utility>\n14\t\n15\tconst size_t TILE_SIZE = 32; // do not change,\n16\t// const uint64_t GROUP_SIZE = 32; // do not change,\n17\t\n18\ttemplate <typename T>\n19\t__global__ void __launch_bounds__(\n20\t    TILE_SIZE\n21\t) matrix_transpose_kernel(T *output, const T *input, size_t col_size, size_t row_size) {\n22\t\n23\t    // NOTE: This is what builds, we need to use this for clang-tidy to work\n24\t    // __shared__ T s_mem[TILE_SIZE][TILE_SIZE + 1];\n25\t    __shared__ __align__(\n26\t        alignof(T)\n27\t    ) unsigned char s_mem_raw[TILE_SIZE * (TILE_SIZE + 1) * sizeof(T)];\n28\t    T(*s_mem)[TILE_SIZE + 1] = reinterpret_cast<T(*)[TILE_SIZE + 1]>(s_mem_raw);\n29\t\n30\t    size_t dim_x = (col_size + TILE_SIZE - 1) / TILE_SIZE;\n31\t    size_t bid = blockIdx.x; // (x, 1, 1)\n32\t    size_t bid_y = bid / dim_x;\n33\t    size_t bid_x = bid % dim_x; // (bid_x, bid_y, 1)\n34\t\n35\t    size_t tid = threadIdx.x;\n36\t    size_t index_i = bid_y * TILE_SIZE * col_size + bid_x * TILE_SIZE + tid;\n37\t    size_t index_o = bid_x * TILE_SIZE * row_size + bid_y * TILE_SIZE + tid;\n38\t\n39\t    // input\n40\t    bool boundray_column = bid_x * TILE_SIZE + tid < col_size;\n41\t    size_t row_offset = bid_y * TILE_SIZE + 0;\n42\t    for (auto i = 0; i < TILE_SIZE; ++i) {\n43\t        bool boundray = boundray_column && (row_offset + i < row_size);\n44\t        s_mem[i][tid] = (boundray) ? input[index_i + i * col_size] : T(0);\n45\t    }\n46\t    __syncthreads();\n47\t\n48\t    // output\n49\t    boundray_column = bid_y * TILE_SIZE + tid < row_size;\n50\t    row_offset = bid_x * TILE_SIZE + 0;\n51\t    for (auto i = 0; i < TILE_SIZE; ++i) {\n52\t        bool boundray = boundray_column && (row_offset + i < col_size);\n53\t        if (boundray)\n54\t            output[index_o + i * row_size] = s_mem[tid][i];\n55\t    }\n56\t}\n57\t\n58\t// Explicit instantiations\n59\ttemplate __global__ void matrix_transpose_kernel<Fp>(Fp *, const Fp *, size_t, size_t);\n60\ttemplate __global__ void matrix_transpose_kernel<FpExt>(FpExt *, const FpExt *, size_t, size_t);\n61\t\n62\t__global__ void matrix_get_rows_fp_kernel(\n63\t    Fp *__restrict__ output,\n64\t    const Fp *__restrict__ input,\n65\t    uint32_t *__restrict__ row_indices,\n66\t    uint64_t matrix_width,\n67\t    uint64_t matrix_height\n68\t) {\n69\t    uint32_t col_idx = blockIdx.x * blockDim.x + threadIdx.x;\n70\t    if (col_idx >= matrix_width) {\n71\t        return;\n72\t    }\n73\t    // Note: blockIdx.y may >= matrix_height, do not assert\n74\t\n75\t    uint64_t input_row = row_indices[blockIdx.y];\n76\t    uint64_t output_row = blockIdx.y;\n77\t    uint64_t input_idx = col_idx * matrix_height + input_row;  // col-major matrix\n78\t    uint64_t output_idx = output_row * matrix_width + col_idx; // row-major matrix\n79\t    output[output_idx] = input[input_idx];\n80\t}\n81\t\n82\t__global__ void split_ext_to_base_col_major_matrix_kernel(\n83\t    Fp *__restrict__ d_matrix,\n84\t    const FpExt *__restrict__ d_poly,\n85\t    uint64_t poly_len,\n86\t    uint32_t matrix_height\n87\t) {\n88\t    uint32_t row_idx = blockIdx.x * blockDim.x + threadIdx.x;\n89\t    if (row_idx >= matrix_height) {\n90\t        return;\n91\t    }\n92\t\n93\t    uint32_t col_num = (poly_len / matrix_height); // SPLIT_FACTOR = 2\n94\t    for (uint32_t col_idx = 0; col_idx < col_num; col_idx++) {\n95\t        FpExt ext_val = d_poly[col_idx * matrix_height + row_idx];\n96\t        d_matrix[(col_idx * 4 + 0) * matrix_height + row_idx] = ext_val.elems[0];\n97\t        d_matrix[(col_idx * 4 + 1) * matrix_height + row_idx] = ext_val.elems[1];\n98\t        d_matrix[(col_idx * 4 + 2) * matrix_height + row_idx] = ext_val.elems[2];\n99\t        d_matrix[(col_idx * 4 + 3) * matrix_height + row_idx] = ext_val.elems[3];\n100\t    }\n101\t}\n102\t\n103\t// `in` has width equal to `width` and height `domain_size * num_x`.\n104\t// `out` has width equal to `width` and height `padded_size * num_x`.\n105\t//\n106\t// CAUTION: rotation is with respect to `domain_size * num_x`, but padding is with respect to `domain_size` to `padded_size`.\n107\t__global__ void batch_rotate_pad_kernel(\n108\t    Fp *__restrict__ out,\n109\t    const Fp *__restrict__ in,\n110\t    uint32_t width,\n111\t    uint32_t num_x,\n112\t    uint32_t domain_size,\n113\t    uint32_t padded_size\n114\t) {\n115\t    auto tidx = threadIdx.x + blockIdx.x * blockDim.x;\n116\t    auto pidx = blockIdx.y + blockIdx.z * gridDim.y;\n117\t\n118\t    if (pidx >= width * num_x) {\n119\t        return;\n120\t    }\n121\t    if (tidx < domain_size) {\n122\t        auto tidx_rot = tidx + 1;\n123\t        auto pidx_rot = pidx;\n124\t        if (tidx_rot == domain_size) {\n125\t            tidx_rot = 0;\n126\t            pidx_rot += 1;\n127\t            // NOTE: rotation is over `domain_size * num_x`\n128\t            if (pidx_rot % num_x == 0) {\n129\t                pidx_rot -= num_x;\n130\t            }\n131\t        }\n132\t        out[padded_size * pidx + tidx] = in[domain_size * pidx_rot + tidx_rot];\n133\t    } else if (tidx < padded_size) {\n134\t        out[padded_size * pidx + tidx] = Fp(0);\n135\t    }\n136\t}\n137\t\n138\t// `matrix` is `padded_height x width` matrix.\n139\t// This kernel cyclically repeats the first `height` rows of the matrix vertically for `lifted_height` rows.\n140\t// The rows `lifted_height..padded_height` are left untouched.\n141\t__global__ void lift_padded_matrix_evals_kernel(\n142\t    Fp *__restrict__ matrix,\n143\t    uint32_t width,\n144\t    uint32_t height,\n145\t    uint32_t lifted_height,\n146\t    uint32_t padded_height\n147\t) {\n148\t    auto tidx = threadIdx.x + blockIdx.x * blockDim.x;\n149\t    auto col = threadIdx.y + blockIdx.y * blockDim.y;\n150\t    if (tidx >= lifted_height || col >= width) {\n151\t        return;\n152\t    }\n153\t    // lhs = rhs when tidx < height\n154\t    matrix[col * padded_height + tidx] = matrix[col * padded_height + (tidx % height)];\n155\t}\n156\t\n157\t// Required: lifted_height = height * stride\n158\t__global__ void collapse_strided_matrix_kernel(\n159\t    Fp *__restrict__ out,\n160\t    const Fp *__restrict__ in,\n161\t    const uint32_t width,\n162\t    const uint32_t lifted_height,\n163\t    const uint32_t height,\n164\t    const uint32_t stride\n165\t) {\n166\t    auto row = threadIdx.x + blockIdx.x * blockDim.x;\n167\t    auto col = threadIdx.y + blockIdx.y * blockDim.y;\n168\t    if (row >= height || col >= width) {\n169\t        return;\n170\t    }\n171\t\n172\t    out[col * height + row] = in[col * lifted_height + row * stride];\n173\t}\n174\t\n175\t// memory layout of in: column-major\n176\t// if polyCount = 4, then the layout of in is expected to be\n177\t// in:  |  poly0  |  poly1  |  poly2  |  poly3  |\n178\t//\n179\t// if outSize / inSize = 2, then the layout of out is expected to be\n180\t// out: |  poly0  |    0    |  poly1  |    0    |   poly2  |    0    |  poly3  |    0    |\n181\t__global__ void batch_expand_pad_kernel(\n182\t    Fp *out,\n183\t    const Fp *in,\n184\t    const uint32_t polyCount,\n185\t    const uint32_t outSize,\n186\t    const uint32_t inSize\n187\t) {\n188\t    uint idx = blockIdx.x * blockDim.x + threadIdx.x;\n189\t    if (idx < outSize) {\n190\t        for (uint32_t i = 0; i < polyCount; i++) {\n191\t            Fp res = Fp(0);\n192\t            if (idx < inSize) {\n193\t                res = in[i * inSize + idx];\n194\t            }\n195\t            out[i * outSize + idx] = res;\n196\t        }\n197\t    }\n198\t}\n199\t\n200\t// `out` is `padded_height x width` column-major matrix.\n201\t// `in` is `height x width` column-major matrix.\n202\t//\n203\t// This kernel is for use when `width` is large (~2^20) while `height` is small (<2^10)\n204\t__global__ void batch_expand_pad_wide_kernel(\n205\t    Fp *__restrict__ out,\n206\t    const Fp *__restrict__ in,\n207\t    const uint32_t width,\n208\t    const uint32_t padded_height,\n209\t    const uint32_t height\n210\t) {\n211\t    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;\n212\t    uint32_t col = blockIdx.y + blockIdx.z * gridDim.y;\n213\t    if (col >= width) {\n214\t        return;\n215\t    }\n216\t    if (row < height) {\n217\t        out[col * padded_height + row] = in[col * height + row];\n218\t    } else if (row < padded_height) {\n219\t        out[col * padded_height + row] = Fp(0);\n220\t    }\n221\t}\n222\t\n223\tstruct StackColDesc {\n224\t    const Fp* src;\n225\t    Fp* dst;\n226\t    uint32_t height;\n227\t    uint32_t stride;\n228\t};\n229\t\n230\t// Each block handles one column descriptor. Threads cooperatively copy elements\n231\t// from src to dst with the given stride.\n232\t__global__ void stack_columns_kernel(\n233\t    const StackColDesc* descs,\n234\t    uint32_t num_descs\n235\t) {\n236\t    uint32_t desc_idx = blockIdx.x;\n237\t    if (desc_idx >= num_descs) return;\n238\t\n239\t    const StackColDesc& d = descs[desc_idx];\n240\t    for (uint32_t i = threadIdx.x; i < d.height; i += blockDim.x) {\n241\t        d.dst[i * d.stride] = d.src[i];\n242\t    }\n243\t}\n244\t\n245\t// ============================================================================\n246\t// LAUNCHERS\n247\t// ============================================================================\n248\t\n249\tconstexpr uint32_t MAX_GRID_DIM = 65535u;\n250\t\n251\ttemplate <typename T>\n252\tint matrix_transpose_impl(T *output, const T *input, size_t col_size, size_t row_size) {\n253\t    uint32_t grid_x = (col_size + TILE_SIZE - 1) / TILE_SIZE;\n254\t    uint32_t grid_y = (row_size + TILE_SIZE - 1) / TILE_SIZE;\n255\t\n256\t    dim3 grid(grid_x * grid_y);\n257\t    dim3 block(TILE_SIZE);\n258\t\n259\t    matrix_transpose_kernel<T><<<grid, block>>>(output, input, col_size, row_size);\n260\t\n261\t    return CHECK_KERNEL();\n262\t}\n263\t\n264\textern \"C\" int _matrix_transpose_fp(Fp *output, const Fp *input, size_t col_size, size_t row_size) {\n265\t    return matrix_transpose_impl(output, input, col_size, row_size);\n266\t}\n267\t\n268\textern \"C\" int _matrix_transpose_fpext(\n269\t    FpExt *output,\n270\t    const FpExt *input,\n271\t    size_t col_size,\n272\t    size_t row_size\n273\t) {\n274\t    return matrix_transpose_impl(output, input, col_size, row_size);\n275\t}\n276\t\n277\textern \"C\" int _matrix_get_rows_fp(\n278\t    Fp *output,\n279\t    const Fp *input,\n280\t    uint32_t *row_indices,\n281\t    uint64_t matrix_width,\n282\t    uint64_t matrix_height,\n283\t    uint32_t row_indices_len\n284\t) {\n285\t    auto block = WARP_SIZE;\n286\t    dim3 grid = dim3(div_ceil(matrix_width, WARP_SIZE), row_indices_len);\n287\t    matrix_get_rows_fp_kernel<<<grid, block>>>(\n288\t        output, input, row_indices, matrix_width, matrix_height\n289\t    );\n290\t    return CHECK_KERNEL();\n291\t}\n292\t\n293\textern \"C\" int _split_ext_to_base_col_major_matrix(\n294\t    Fp *d_matrix,\n295\t    FpExt *d_poly,\n296\t    uint64_t poly_len,\n297\t    uint32_t matrix_height\n298\t) {\n299\t    auto [grid, block] = kernel_launch_params(matrix_height);\n300\t    split_ext_to_base_col_major_matrix_kernel<<<grid, block>>>(\n301\t        d_matrix, d_poly, poly_len, matrix_height\n302\t    );\n303\t    return CHECK_KERNEL();\n304\t}\n305\t\n306\textern \"C\" int _batch_rotate_pad(\n307\t    Fp *out,\n308\t    const Fp *in,\n309\t    uint32_t width,\n310\t    uint32_t num_x, // = (in.height() / domain_size)\n311\t    uint32_t domain_size,\n312\t    uint32_t padded_size\n313\t) {\n314\t    auto [grid, block] = kernel_launch_params(padded_size);\n315\t    auto num_poly = width * num_x;\n316\t    grid.y = std::min(num_poly, MAX_GRID_DIM);\n317\t    grid.z = (num_poly + grid.y - 1) / grid.y;\n318\t    batch_rotate_pad_kernel<<<grid, block>>>(out, in, width, num_x, domain_size, padded_size);\n319\t    return CHECK_KERNEL();\n320\t}\n321\t\n322\textern \"C\" int _lift_padded_matrix_evals(\n323\t    Fp *matrix,\n324\t    uint32_t width,\n325\t    uint32_t height,\n326\t    uint32_t lifted_height,\n327\t    uint32_t padded_height\n328\t) {\n329\t    auto [grid, block] = kernel_launch_2d_params(lifted_height, width);\n330\t    lift_padded_matrix_evals_kernel<<<grid, block>>>(\n331\t        matrix, width, height, lifted_height, padded_height\n332\t    );\n333\t    return CHECK_KERNEL();\n334\t}\n335\t\n336\textern \"C\" int _collapse_strided_matrix(\n337\t    Fp *out,\n338\t    const Fp *in,\n339\t    uint32_t width,\n340\t    uint32_t height,\n341\t    uint32_t stride\n342\t) {\n343\t    auto lifted_height = height * stride;\n344\t    auto [grid, block] = kernel_launch_2d_params(height, width);\n345\t    collapse_strided_matrix_kernel<<<grid, block>>>(out, in, width, lifted_height, height, stride);\n346\t    return CHECK_KERNEL();\n347\t}\n348\t\n349\textern \"C\" int _batch_expand_pad(\n350\t    Fp *out,\n351\t    const Fp *in,\n352\t    const uint32_t polyCount,\n353\t    const uint32_t outSize,\n354\t    const uint32_t inSize\n355\t) {\n356\t    auto [grid, block] = kernel_launch_params(outSize);\n357\t    batch_expand_pad_kernel<<<grid, block>>>(out, in, polyCount, outSize, inSize);\n358\t    return CHECK_KERNEL();\n359\t}\n360\t\n361\textern \"C\" int _batch_expand_pad_wide(\n362\t    Fp *out,\n363\t    const Fp *in,\n364\t    const uint32_t width,\n365\t    const uint32_t padded_height,\n366\t    const uint32_t height\n367\t) {\n368\t    auto [grid, block] = kernel_launch_params(padded_height);\n369\t    grid.y = std::min(width, MAX_GRID_DIM);\n370\t    grid.z = (width + grid.y - 1) / grid.y;\n371\t    assert(grid.z <= MAX_GRID_DIM);\n372\t    batch_expand_pad_wide_kernel<<<grid, block>>>(out, in, width, padded_height, height);\n373\t    return CHECK_KERNEL();\n374\t}\n375\t\n376\textern \"C\" int _stack_columns(\n377\t    const StackColDesc* descs,\n378\t    uint32_t num_descs\n379\t) {\n380\t    if (num_descs == 0) return 0;\n381\t    dim3 grid(num_descs);\n382\t    dim3 block(256);\n383\t    stack_columns_kernel<<<grid, block>>>(descs, num_descs);\n384\t    return CHECK_KERNEL();\n385\t}\n386\t"}]},"parent_tool_use_id":"toolu_01D4gDZrAY1XdvhKesTMUn8g","session_id":"ff03fa2a-06a9-4cae-9336-eb9eb1af38e2","uuid":"3b79b40b-b559-468b-8e6a-6262d678e9ff","timestamp":"2026-04-14T05:09:25.368Z"}
