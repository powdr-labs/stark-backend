{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017JvYghrAoWbH7F3PUgSqgi","type":"tool_result","content":"1471\t        name = \"LogupZerocheck::sumcheck_polys_batch_eval\",\n1472\t        level = \"info\",\n1473\t        skip_all,\n1474\t        fields(round = round)\n1475\t    )]\n1476\t    fn sumcheck_polys_batch_eval(\n1477\t        &mut self,\n1478\t        round: usize,\n1479\t        r_prev: EF,\n1480\t    ) -> Result<Vec<Vec<EF>>, LogupZerocheckError> {\n1481\t        let sp_deg = self.constraint_degree;\n1482\t\n1483\t        // Per-trace outputs (filled as we go)\n1484\t        let mut zc_out: Vec<Vec<EF>> = vec![vec![EF::ZERO; sp_deg]; self.n_per_trace.len()];\n1485\t        let mut logup_out: Vec<[Vec<EF>; 2]> =\n1486\t            vec![[vec![EF::ZERO; sp_deg], vec![EF::ZERO; sp_deg]]; self.n_per_trace.len()];\n1487\t\n1488\t        let mut late_eval: Vec<TraceCtx> = Vec::new(); // round == n_lift + 1\n1489\t        let mut early_eval: Vec<TraceCtx> = Vec::new(); // round <= n_lift\n1490\t\n1491\t        // ── Phase 1: Collect metadata, split into Case A / Case B (no CUDA calls) ──\n1492\t        // For Case B traces, we collect column pointers and sizing info to batch the\n1493\t        // interpolation into a single kernel launch.\n1494\t        struct CaseBMeta {\n1495\t            trace_idx: usize,\n1496\t            air_idx: usize,\n1497\t            n_lift: usize,\n1498\t            num_y: usize,\n1499\t            num_columns: usize, // total columns (selectors + preprocessed + mains)\n1500\t            interp_offset: usize, // element offset within the big interpolated buffer\n1501\t            col_start: usize,   // start index in the flat all_columns array\n1502\t            has_preprocessed: bool,\n1503\t            need_rot: bool,\n1504\t            has_constraints: bool,\n1505\t            has_interactions: bool,\n1506\t            norm_factor: F,\n1507\t        }\n1508\t        let mut case_b_traces: Vec<CaseBMeta> = Vec::new();\n1509\t        let mut all_columns: Vec<*const EF> = Vec::new();\n1510\t        let mut total_interp_elems: usize = 0;\n1511\t\n1512\t        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n1513\t            self.n_per_trace.iter(),\n1514\t            self.mat_evals_per_trace.iter(),\n1515\t            self.sels_per_trace.iter(),\n1516\t            self.d_eq_3b_per_trace.iter(),\n1517\t            self.public_values_per_trace.iter(),\n1518\t            self.air_indices_per_trace.iter()\n1519\t        )\n1520\t        .enumerate()\n1521\t        {\n1522\t            let pk = &self.pk.per_air[air_idx];\n1523\t            let dag = &pk.vk.symbolic_constraints;\n1524\t            let has_constraints = dag.constraints.num_constraints() > 0;\n1525\t            let has_interactions = !dag.interactions.is_empty();\n1526\t            if !has_constraints && !has_interactions {\n1527\t                continue;\n1528\t            }\n1529\t\n1530\t            let n_lift = n.max(0) as usize;\n1531\t            let norm_factor_denom = 1 << (-n).max(0);\n1532\t            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n1533\t            let has_preprocessed = pk.preprocessed_data.is_some();\n1534\t            let need_rot = pk.vk.params.need_rot;\n1535\t            let first_main_idx = usize::from(has_preprocessed);\n1536\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n1537\t\n1538\t            if round > n_lift {\n1539\t                // Case A\n1540\t                if round == n_lift + 1 {\n1541\t                    // A.1: evaluate directly at (num_x=1, num_y=1)\n1542\t                    let prep_ptr = if has_preprocessed {\n1543\t                        MainMatrixPtrs {\n1544\t                            data: mats[0].buffer().as_ptr(),\n1545\t                            air_width: air_width_for_mat(need_rot, mats[0].width()),\n1546\t                        }\n1547\t                    } else {\n1548\t                        MainMatrixPtrs {\n1549\t                            data: std::ptr::null(),\n1550\t                            air_width: 0,\n1551\t                        }\n1552\t                    };\n1553\t                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1554\t                        .iter()\n1555\t                        .map(|m| MainMatrixPtrs {\n1556\t                            data: m.buffer().as_ptr(),\n1557\t                            air_width: air_width_for_mat(need_rot, m.width()),\n1558\t                        })\n1559\t                        .collect_vec();\n1560\t                    let main_ptrs_dev = main_ptrs.to_device()?;\n1561\t\n1562\t                    late_eval.push(TraceCtx {\n1563\t                        trace_idx,\n1564\t                        air_idx,\n1565\t                        n_lift,\n1566\t                        num_y: 1,\n1567\t                        has_constraints,\n1568\t                        has_interactions,\n1569\t                        norm_factor,\n1570\t                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n1571\t                        sels_ptr: sels.buffer().as_ptr(),\n1572\t                        prep_ptr,\n1573\t                        main_ptrs_dev,\n1574\t                        public_ptr: public_vals.as_ptr(),\n1575\t                        eq_3bs_ptr: eq_3bs.as_ptr(),\n1576\t                    });\n1577\t                } else {\n1578\t                    // A.2: scale tilde evals only\n1579\t                    if has_constraints {\n1580\t                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n1581\t                        *tilde_eval *= r_prev;\n1582\t                    }\n1583\t                    if has_interactions {\n1584\t                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n1585\t                            *x *= r_prev;\n1586\t                        }\n1587\t                    }\n1588\t                }\n1589\t            } else {\n1590\t                // Case B: collect metadata for batched interpolation\n1591\t                let log_num_y = n_lift - round;\n1592\t                let num_y = 1 << log_num_y;\n1593\t                let height = 2 * num_y;\n1594\t                debug_assert_eq!(height, mats[0].height());\n1595\t\n1596\t                let col_start = all_columns.len();\n1597\t                // Collect all column pointers: selectors + all matrices (preprocessed + mains)\n1598\t                all_columns.extend(\n1599\t                    iter::once(sels)\n1600\t                        .chain(mats.iter())\n1601\t                        .flat_map(|m| {\n1602\t                            assert_eq!(m.height(), height);\n1603\t                            (0..m.width())\n1604\t                                .map(|col| m.buffer().as_ptr().wrapping_add(col * m.height()))\n1605\t                        }),\n1606\t                );\n1607\t                let num_columns = all_columns.len() - col_start;\n1608\t                let interp_size = sp_deg * num_y * num_columns;\n1609\t\n1610\t                case_b_traces.push(CaseBMeta {\n1611\t                    trace_idx,\n1612\t                    air_idx,\n1613\t                    n_lift,\n1614\t                    num_y,\n1615\t                    num_columns,\n1616\t                    interp_offset: total_interp_elems,\n1617\t                    col_start,\n1618\t                    has_preprocessed,\n1619\t                    need_rot,\n1620\t                    has_constraints,\n1621\t                    has_interactions,\n1622\t                    norm_factor,\n1623\t                });\n1624\t                total_interp_elems += interp_size;\n1625\t            }\n1626\t        }\n1627\t\n1628\t        // ── Phase 2: Batch allocate + single kernel launch ──\n1629\t        // One big buffer for all interpolated data, one kernel launch for all Case B traces.\n1630\t        let _keepalive_interpolated = if !case_b_traces.is_empty() {\n1631\t            let big_buf = DeviceBuffer::<EF>::with_capacity(total_interp_elems);\n1632\t            let big_ptr = big_buf.as_mut_ptr();\n1633\t\n1634\t            // Build descriptors with multi-block-per-trace assignment\n1635\t            const THREADS_PER_BLOCK: u32 = 512;\n1636\t            let mut block_offset: u32 = 0;\n1637\t            let descs: Vec<InterpColDesc> = case_b_traces\n1638\t                .iter()\n1639\t                .map(|meta| {\n1640\t                    let total_threads = (meta.num_y * meta.num_columns) as u32;\n1641\t                    let blocks = total_threads.div_ceil(THREADS_PER_BLOCK);\n1642\t                    let desc = InterpColDesc {\n1643\t                        output: unsafe { big_ptr.add(meta.interp_offset) },\n1644\t                        columns_offset: meta.col_start as u32,\n1645\t                        num_y: meta.num_y as u32,\n1646\t                        num_columns: meta.num_columns as u32,\n1647\t                        total_threads,\n1648\t                        block_start: block_offset,\n1649\t                    };\n1650\t                    block_offset += blocks;\n1651\t                    desc\n1652\t                })\n1653\t                .collect();\n1654\t            let total_blocks = block_offset as usize;\n1655\t\n1656\t            let d_descs = descs.to_device()?;\n1657\t            let d_all_columns = all_columns.to_device()?;\n1658\t            unsafe {\n1659\t                batched_interpolate_columns_gpu(&d_descs, &d_all_columns, sp_deg, total_blocks)\n1660\t                    .map_err(|e| LogupZerocheckError::InterpolateColumns(e.into()))?;\n1661\t            }\n1662\t\n1663\t            Some(big_buf)\n1664\t        } else {\n1665\t            None\n1666\t        };\n1667\t\n1668\t        // ── Phase 3: Build TraceCtx for each Case B trace ──\n1669\t        for meta in &case_b_traces {\n1670\t            let mats = &self.mat_evals_per_trace[meta.trace_idx];\n1671\t            let first_main_idx = usize::from(meta.has_preprocessed);\n1672\t            let eq_xi_tree = &self.eq_xis[&meta.n_lift];\n1673\t            let log_num_y = meta.n_lift - round;\n1674\t            let interpolated_height = sp_deg * meta.num_y;\n1675\t\n1676\t            let base_ptr = _keepalive_interpolated\n1677\t                .as_ref()\n1678\t                .unwrap()\n1679\t                .as_ptr()\n1680\t                .wrapping_add(meta.interp_offset);\n1681\t\n1682\t            let mut widths_so_far = 0usize;\n1683\t            let sels_ptr = base_ptr.wrapping_add(widths_so_far * interpolated_height);\n1684\t            widths_so_far += 3; // selector width is always 3\n1685\t\n1686\t            let prep_ptr = if meta.has_preprocessed {\n1687\t                MainMatrixPtrs {\n1688\t                    data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1689\t                    air_width: air_width_for_mat(meta.need_rot, mats[0].width()),\n1690\t                }\n1691\t            } else {\n1692\t                MainMatrixPtrs {\n1693\t                    data: std::ptr::null(),\n1694\t                    air_width: 0,\n1695\t                }\n1696\t            };\n1697\t            if meta.has_preprocessed {\n1698\t                widths_so_far += mats[0].width();\n1699\t            }\n1700\t            let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1701\t                .iter()\n1702\t                .map(|m| {\n1703\t                    let main_ptr = MainMatrixPtrs {\n1704\t                        data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1705\t                        air_width: air_width_for_mat(meta.need_rot, m.width()),\n1706\t                    };\n1707\t                    widths_so_far += m.width();\n1708\t                    main_ptr\n1709\t                })\n1710\t                .collect_vec();\n1711\t            debug_assert_eq!(widths_so_far, meta.num_columns);\n1712\t            let main_ptrs_dev = main_ptrs.to_device()?;\n1713\t\n1714\t            early_eval.push(TraceCtx {\n1715\t                trace_idx: meta.trace_idx,\n1716\t                air_idx: meta.air_idx,\n1717\t                n_lift: meta.n_lift,\n1718\t                num_y: meta.num_y as u32,\n1719\t                has_constraints: meta.has_constraints,\n1720\t                has_interactions: meta.has_interactions,\n1721\t                norm_factor: meta.norm_factor,\n1722\t                eq_xi_ptr: eq_xi_tree.get_ptr(log_num_y),\n1723\t                sels_ptr,\n1724\t                prep_ptr,\n1725\t                main_ptrs_dev,\n1726\t                public_ptr: self.public_values_per_trace[meta.trace_idx].as_ptr(),\n1727\t                eq_3bs_ptr: self.d_eq_3b_per_trace[meta.trace_idx].as_ptr(),\n1728\t            });\n1729\t        }\n1730\t\n1731\t        let d_challenges_ptr = self.d_challenges.as_ptr();\n1732\t\n1733\t        // Late traces (num_y=1): always use monomial\n1734\t        let late_logup_traces: Vec<_> = late_eval.iter().filter(|t| t.has_interactions).collect();\n1735\t        if !late_logup_traces.is_empty() {\n1736\t            let logup_combs: Vec<_> = late_logup_traces\n1737\t                .iter()\n1738\t                .map(|t| {\n1739\t                    self.logup_combinations[t.trace_idx]\n1740\t                        .as_ref()\n1741\t                        .expect(\"missing logup monomial combinations for late trace\")\n1742\t                })\n1743\t                .collect();\n1744\t            let batch =\n1745\t                LogupMonomialBatch::new(late_logup_traces.iter().copied(), self.pk, &logup_combs)?;\n1746\t            let out = batch\n1747\t                .evaluate(1)\n1748\t                .map_err(LogupZerocheckError::MleInteractionEval)?;\n1749\t            let host = out.to_host()?;\n1750\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1751\t                self.logup_tilde_evals[trace_idx][0] = host[i].p * late_logup_traces[i].norm_factor;\n1752\t                self.logup_tilde_evals[trace_idx][1] = host[i].q;\n1753\t            }\n1754\t        }\n1755\t        let late_mono_traces: Vec<_> = late_eval\n1756\t            .iter()\n1757\t            .filter(|t| trace_has_monomials(t, self.pk))\n1758\t            .collect();\n1759\t        if !late_mono_traces.is_empty() {\n1760\t            let lambda_combs: Vec<_> = late_mono_traces\n1761\t                .iter()\n1762\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1763\t                .collect();\n1764\t            let batch = ZerocheckMonomialBatch::new(late_mono_traces, self.pk, &lambda_combs)?;\n1765\t            let out = batch\n1766\t                .evaluate(1)\n1767\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1768\t            let host = out.to_host()?;\n1769\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1770\t                self.zerocheck_tilde_evals[trace_idx] = host[i];"}]},"parent_tool_use_id":"toolu_019YnUpgk3m5d5BKR957PaPv","session_id":"ff03fa2a-06a9-4cae-9336-eb9eb1af38e2","uuid":"4dc25a2e-598c-4b44-9922-e7d1d72c3d5f","timestamp":"2026-04-14T05:13:37.998Z"}
