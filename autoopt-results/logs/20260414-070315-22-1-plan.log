{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FRMmWgsAe12swMES4d6WL4","type":"tool_result","content":"600\t        layer_size,\n601\t        revert,\n602\t        alpha,\n603\t        apply_alpha,\n604\t    ))\n605\t}\n606\t\n607\t/// Fused two-layer tree build kernel.\n608\t/// `half_i1` = N >> (i+2), where i is the first of the two layers being fused.\n609\tpub unsafe fn frac_build_tree_two_layers(\n610\t    layer: &mut DeviceBuffer<Frac<EF>>,\n611\t    half_i1: usize,\n612\t) -> Result<(), CudaError> {\n613\t    CudaError::from_result(_frac_build_tree_two_layers(layer.as_mut_ptr(), half_i1))\n614\t}\n615\t\n616\t// `eq_xi` will not store evaluations for the first hypercube coordinate because the prover factors\n617\t// out the first eq term.\n618\t#[allow(clippy::too_many_arguments)]\n619\tpub unsafe fn frac_compute_round(\n620\t    eq_xi: &SqrtEqLayers,\n621\t    pq_buffer: &DeviceBuffer<Frac<EF>>,\n622\t    num_x: usize,\n623\t    lambda: EF,\n624\t    out_device: &mut DeviceBuffer<EF>,\n625\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n626\t) -> Result<(), CudaError> {\n627\t    let low_n = eq_xi.low_n();\n628\t    let high_n = eq_xi.high_n();\n629\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n630\t    debug_assert!(pq_buffer.len() >= 2 * num_x);\n631\t    #[cfg(debug_assertions)]\n632\t    {\n633\t        let len = tmp_block_sums.len();\n634\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n635\t        assert!(\n636\t            len >= required as usize,\n637\t            \"tmp_block_sums len={len} < required={required}\"\n638\t        );\n639\t    }\n640\t    CudaError::from_result(_frac_compute_round(\n641\t        eq_xi.low.get_ptr(low_n),\n642\t        eq_xi.high.get_ptr(high_n),\n643\t        pq_buffer.as_ptr(),\n644\t        num_x,\n645\t        1 << low_n,\n646\t        lambda,\n647\t        out_device.as_mut_ptr(),\n648\t        tmp_block_sums.as_mut_ptr(),\n649\t    ))\n650\t}\n651\t\n652\t/// Fused compute round + tree layer revert kernel.\n653\t///\n654\t/// Combines `frac_build_tree_layer(revert=true)` with `compute_round` for the first inner round.\n655\t/// The revert operation modifies `layer` in-place: `layer[i] = layer[i] - layer[i + half]` for `i <\n656\t/// half`.\n657\t///\n658\t/// This eliminates one kernel launch per outer round.\n659\t#[allow(clippy::too_many_arguments)]\n660\tpub unsafe fn frac_compute_round_and_revert(\n661\t    eq_xi: &SqrtEqLayers,\n662\t    layer: &mut DeviceBuffer<Frac<EF>>,\n663\t    num_x: usize,\n664\t    lambda: EF,\n665\t    out_device: &mut DeviceBuffer<EF>,\n666\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n667\t) -> Result<(), CudaError> {\n668\t    let low_n = eq_xi.low_n();\n669\t    let high_n = eq_xi.high_n();\n670\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n671\t    #[cfg(debug_assertions)]\n672\t    {\n673\t        let len = tmp_block_sums.len();\n674\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n675\t        assert!(\n676\t            len >= required as usize,\n677\t            \"tmp_block_sums len={len} < required={required}\"\n678\t        );\n679\t        assert!(layer.len() >= 2 * num_x, \"layer too small for pq_size\");\n680\t    }\n681\t    CudaError::from_result(_frac_compute_round_and_revert(\n682\t        eq_xi.low.get_ptr(low_n),\n683\t        eq_xi.high.get_ptr(high_n),\n684\t        layer.as_mut_ptr(),\n685\t        num_x,\n686\t        1 << low_n,\n687\t        lambda,\n688\t        out_device.as_mut_ptr(),\n689\t        tmp_block_sums.as_mut_ptr(),\n690\t    ))\n691\t}\n692\t\n693\t/// Folds `Frac<EF>` buffer. Pairs (idx, idx+quarter) and (idx+half, idx+3*quarter),\n694\t/// writes results to dst[idx] and dst[idx+quarter]. Output size is `size / 2`.\n695\t/// Safe for src == dst (in-place) because each thread handles disjoint indices.\n696\tpub unsafe fn fold_ef_frac_columns(\n697\t    src: &DeviceBuffer<Frac<EF>>,\n698\t    dst: &mut DeviceBuffer<Frac<EF>>,\n699\t    size: usize,\n700\t    r: EF,\n701\t) -> Result<(), CudaError> {\n702\t    debug_assert!(src.len() >= size);\n703\t    debug_assert!(dst.len() >= size / 2);\n704\t    CudaError::from_result(_frac_fold_fpext_columns(\n705\t        src.as_ptr(),\n706\t        dst.as_mut_ptr(),\n707\t        size,\n708\t        r,\n709\t    ))\n710\t}\n711\t\n712\t/// In-place fold. See [`fold_ef_frac_columns`] for details.\n713\tpub unsafe fn fold_ef_frac_columns_inplace(\n714\t    buffer: &mut DeviceBuffer<Frac<EF>>,\n715\t    size: usize,\n716\t    r: EF,\n717\t) -> Result<(), CudaError> {\n718\t    debug_assert!(buffer.len() >= size);\n719\t    let ptr = buffer.as_mut_ptr();\n720\t    CudaError::from_result(_frac_fold_fpext_columns(ptr, ptr, size, r))\n721\t}\n722\t\n723\t/// Fused compute round + fold kernel.\n724\t///\n725\t/// Reads from pre-fold `src_pq_buffer` (size `src_pq_size`), performs fold-on-the-fly using\n726\t/// `r_prev`, computes s' polynomial evaluations (degree 2), and writes folded output to\n727\t/// `dst_pq_buffer` (size `src_pq_size/2`).\n728\t///\n729\t/// This fuses the fold operation into the next round's compute, eliminating one kernel launch per\n730\t/// inner round and reducing memory traffic.\n731\t///\n732\t/// The eq_xi layers should have max_n = log2(src_pq_size / 4) = log2(post-fold num_x).\n733\t#[allow(clippy::too_many_arguments)]\n734\tpub unsafe fn frac_compute_round_and_fold(\n735\t    eq_xi: &SqrtEqLayers,\n736\t    src_pq_buffer: &DeviceBuffer<Frac<EF>>,\n737\t    dst_pq_buffer: &mut DeviceBuffer<Frac<EF>>,\n738\t    src_pq_size: usize,\n739\t    lambda: EF,\n740\t    r_prev: EF,\n741\t    out_device: &mut DeviceBuffer<EF>,\n742\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n743\t) -> Result<(), CudaError> {\n744\t    let low_n = eq_xi.low_n();\n745\t    let high_n = eq_xi.high_n();\n746\t    // Post-fold: num_x = src_pq_size / 4\n747\t    let num_x = src_pq_size >> 2;\n748\t    debug_assert_