{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HWrfEM16tRHLSSn56pT7rA","type":"tool_result","content":"1\t// GKR fractional sumcheck CUDA kernels. See docs/cuda-backend/gkr-prover.md (repo root)\n2\t// for the protocol and implementation details.\n3\t\n4\t#include \"fp.h\"\n5\t#include \"fpext.h\"\n6\t#include \"frac_ext.cuh\"\n7\t#include \"launcher.cuh\"\n8\t#include \"sumcheck.cuh\"\n9\t#include \"utils.cuh\"\n10\t#include <algorithm>\n11\t#include <cassert>\n12\t#include <cstddef>\n13\t#include <cstdint>\n14\t#include <cuda_runtime_api.h>\n15\t#include <driver_types.h>\n16\t#include <utility>\n17\t#include <vector_types.h>\n18\t\n19\t// Includes GKR for fractional sumcheck\n20\t// The LogUp specific input to GKR is calculated in interactions.cu\n21\tnamespace fractional_sumcheck_gkr {\n22\t// Degree of s' polynomial (factored out the first eq term)\n23\tconstexpr int GKR_SP_DEG = 2;\n24\t// ============================================================================\n25\t// KERNELS\n26\t// ============================================================================\n27\ttemplate <bool revert, bool apply_alpha = false>\n28\t__global__ void frac_build_tree_layer_kernel(\n29\t    FracExt *__restrict__ layer,\n30\t    uint32_t half,\n31\t    FpExt alpha = FpExt(Fp(0))\n32\t) {\n33\t    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;\n34\t    if (idx >= half) {\n35\t        return;\n36\t    }\n37\t\n38\t    if constexpr (apply_alpha) {\n39\t        // When applying alpha, we need to modify both operands before combining\n40\t        // Read both values, apply alpha to denominators, then combine\n41\t        FracExt lhs_val = layer[idx];\n42\t        FracExt rhs_val = layer[idx | half];\n43\t        lhs_val.q = lhs_val.q + alpha;\n44\t        rhs_val.q = rhs_val.q + alpha;\n45\t\n46\t        if constexpr (revert) {\n47\t            frac_unadd_inplace(lhs_val, rhs_val);\n48\t        } else {\n49\t            frac_add_inplace(lhs_val, rhs_val);\n50\t        }\n51\t\n52\t        layer[idx] = lhs_val;\n53\t    } else {\n54\t        // Original fast path: use references for in-place modification\n55\t        FracExt &lhs = layer[idx];\n56\t        FracExt const &rhs = layer[idx | half];\n57\t\n58\t        if constexpr (revert) {\n59\t            frac_unadd_inplace(lhs, rhs);\n60\t        } else {\n61\t            frac_add_inplace(lhs, rhs);\n62\t        }\n63\t    }\n64\t}\n65\t\n66\t// Reconstruct eq weight from sqrt-decomposed buffers.\n67\t// See docs/cuda-backend/gkr-prover.md § \"Eq buffer sqrt decomposition\".\n68\t__device__ __forceinline__ FpExt sqrt_buffer_get(\n69\t    const FpExt *__restrict__ eq_xi_low,\n70\t    const FpExt *__restrict__ eq_xi_high,\n71\t    uint32_t const log_eq_low_cap,\n72\t    uint32_t const idx\n73\t) {\n74\t    return eq_xi_low[idx & ((1u << log_eq_low_cap) - 1)] * eq_xi_high[idx >> log_eq_low_cap];\n75\t}\n76\t\n77\t// Accumulate GKR sumcheck contributions for s'_t(1) and s'_t(2).\n78\t// See docs/cuda-backend/gkr-prover.md § \"Sumcheck round implementation\".\n79\t__device__ __forceinline__ void accumulate_compute_contributions(\n80\t    const FpExt *__restrict__ eq_xi_low,\n81\t    const FpExt *__restrict__ eq_xi_high,\n82\t    uint32_t idx,\n83\t    uint32_t log_eq_low_cap,\n84\t    FpExt lambda,\n85\t    FpExt p0_even, FpExt q0_even, FpExt p0_odd, FpExt q0_odd,\n86\t    FpExt p1_even, FpExt q1_even, FpExt p1_odd, FpExt q1_odd,\n87\t    FpExt &local0, FpExt &local1\n88\t) {\n89\t    FpExt eq_val = sqrt_buffer_get(eq_xi_low, eq_xi_high, log_eq_low_cap, idx);\n90\t\n91\t    FpExt p0_diff = p0_odd - p0_even;\n92\t    FpExt q0_diff = q0_odd - q0_even;\n93\t    FpExt p1_diff = p1_odd - p1_even;\n94\t    FpExt q1_diff = q1_odd - q1_even;\n95\t\n96\t    FpExt p_j0 = p0_even + lambda * q0_even;\n97\t    FpExt q_j0 = q0_even;\n98\t    FpExt p_j1 = p1_even;\n99\t    FpExt q_j1 = q1_even;\n100\t\n101\t    auto const lambda_times_q0_diff = lambda * q0_diff;\n102\t\n103\t#pragma unroll\n104\t    for (int i = 0; i < GKR_SP_DEG; ++i) {\n105\t        p_j0 += p0_diff;\n106\t        p_j0 += lambda_times_q0_diff;\n107\t        q_j0 += q0_diff;\n108\t        p_j1 += p1_diff;\n109\t        q_j1 += q1_diff;\n110\t\n111\t        FpExt contrib = eq_val * (p_j0 * q_j1 + p_j1 * q_j0);\n112\t        if (i == 0) local0 += contrib;\n113\t        else local1 += contrib;\n114\t    }\n115\t}\n116\t\n117\t// Helper: Perform block reduction on two accumulators and write to block_sums.\n118\t__device__ __forceinline__ void reduce_block_sums(\n119\t    FpExt *shared,\n120\t    FpExt local0, FpExt local1,\n121\t    FpExt *__restrict__ block_sums\n122\t) {\n123\t    {\n124\t        FpExt reduced = sumcheck::block_reduce_sum(local0, shared);\n125\t        if (threadIdx.x == 0) block_sums[blockIdx.x * GKR_SP_DEG + 0] = reduced;\n126\t    }\n127\t    __syncthreads();\n128\t    {\n129\t        FpExt reduced = sumcheck::block_reduce_sum(local1, shared);\n130\t        if (threadIdx.x == 0) block_sums[blockIdx.x * GKR_SP_DEG + 1] = reduced;\n131\t    }\n132\t}\n133\t\n134\t// shared memory size requirement: max(num_warps,1) * sizeof(FpExt)\n135\t// Computes s' polynomial evaluations at 1 and 2 (first eq term factored out).\n136\t__global__ void compute_round_block_sum_kernel(\n137\t    const FpExt *__restrict__ eq_xi_low,\n138\t    const FpExt *__restrict__ eq_xi_high,\n139\t    const FracExt *__restrict__ pq_buffer,\n140\t    uint32_t num_x,\n141\t    uint32_t log_eq_low_cap,\n142\t    FpExt lambda,\n143\t    FpExt *__restrict__ block_sums // Output: [gridDim.x][2]\n144\t) {\n145\t    extern __shared__ FpExt shared[];\n146\t    const uint32_t pq_size = 2 * num_x;\n147\t\n148\t    const FpExt zero(Fp::zero());\n149\t    FpExt local[GKR_SP_DEG] = {zero, zero};\n150\t    uint32_t idx_base = threadIdx.x + blockIdx.x * blockDim.x;\n151\t    // Map phase: compute local sum by striding over grid\n152\t    for (uint32_t idx = idx_base; idx < num_x / 2; idx += blockDim.x * gridDim.x) {\n153\t        FpExt eq_val = sqrt_buffer_get(eq_xi_low, eq_xi_high, log_eq_low_cap, idx);\n154\t\n155\t        // \\hat p_j({0 or 1}, {even or odd}, ..y)\n156\t        // The {even=0, odd=1} evaluations are used to interpolate at 1, 2\n157\t        auto const &[p0_even, q0_even] = pq_buffer[idx];\n158\t        auto const &[p1_even, q1_even] = pq_buffer[with_rev_bits(idx, pq_size, 1, 0)];\n159\t        auto const &[p0_odd, q0_odd] = pq_buffer[with_rev_bits(idx, pq_size, 0, 1)];\n160\t        auto const &[p1_odd, q1_odd] = pq_buffer[with_rev_bits(idx, pq_size, 1, 1)];\n161\t\n162\t        FpExt p0_diff = p0_odd - p0_even;\n163\t        FpExt q0_diff = q0_odd - q0_even;\n164\t        FpExt p1_diff = p1_odd - p1_even;\n165\t        FpExt q1_diff = q1_odd - q1_even;\n166\t\n167\t        FpExt p_j0 = p0_even + lambda * q0_even;\n168\t        FpExt q_j0 = q0_even;\n169\t        FpExt p_j1 = p1_even;\n170\t        FpExt q_j1 = q1_even;\n171\t\n172\t        auto const lambda_times_q0_diff = lambda * q0_diff;\n173\t\n174\t#pragma unroll\n175\t        for (int i = 0; i < GKR_SP_DEG; ++i) {\n176\t            p_j0 += p0_diff;\n177\t            p_j0 += lambda_times_q0_diff;\n178\t            q_j0 += q0_diff;\n179\t            p_j1 += p1_diff;\n180\t            q_j1 += q1_diff;\n181\t\n182\t            local[i] += eq_val * (p_j0 * q_j1 + p_j1 * q_j0);\n183\t        }\n184\t    }\n185\t// Reduce phase: reduce all threadIdx.x in the same block, keeping 1,2 independent\n186\t#pragma unroll\n187\t    for (int i = 0; i < GKR_SP_DEG; ++i) {\n188\t        FpExt reduced = sumcheck::block_reduce_sum(local[i], shared);\n189\t\n190\t        if (threadIdx.x == 0) {\n191\t            block_sums[blockIdx.x * GKR_SP_DEG + i] = reduced;\n192\t        }\n193\t        __syncthreads();\n194\t    }\n195\t}\n196\t\n197\t// Fold kernel operating on FpExt* view of FracExt buffer.\n198\t// Since FracExt = {p, q} has p and q folded independently with the same formula,\n199\t// we can treat the buffer as FpExt* with 2x the elements.\n200\t//\n201\t// Pairs (idx, idx+quarter) and (idx+half, idx+3*quarter),\n202\t// writes results to dst[idx] and dst[idx+quarter].\n203\t// Safe for src == dst (in-place) because each thread reads before writing to the same index.\n204\t__global__ void fold_ef_columns_kernel(const FpExt *src, FpExt *dst, uint32_t quarter, FpExt r) {\n205\t    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;\n206\t    if (idx >= quarter) {\n207\t        return;\n208\t    }\n209\t\n210\t    FpExt v0 = src[idx];\n211\t    FpExt v1 = src[idx | quarter];\n212\t    dst[idx] = v0 + r * (v1 - v0);\n213\t\n214\t    uint32_t half = quarter << 1;\n215\t\n216\t    FpExt v2 = src[idx | half];\n217\t    FpExt v3 = src[idx | half | quarter];\n218\t    dst[idx | quarter] = v2 + r * (v3 - v2);\n219\t}\n220\t\n221\t// Fused compute round + fold kernel (OUT-OF-PLACE version).\n222\t// Reads from pre-fold src_pq buffer (size 2*pq_size), computes s' polynomial at 1 and 2,\n223\t// and writes folded output to dst_pq buffer (size pq_size).\n224\t//\n225\t// This kernel fuses the fold operation into the next round's compute, eliminating\n226\t// one kernel launch per inner round and reducing memory traffic.\n227\t//\n228\t// IMPORTANT: src_pq and dst_pq must NOT alias. Use compute_round_and_fold_inplace_kernel\n229\t// when src == dst.\n230\t//\n231\t// Register-optimized: uses tight scopes for pair loads and writes folded values\n232\t// immediately to reduce live register ranges.\n233\t//\n234\t// shared memory size requirement: max(num_warps,1) * sizeof(FpExt)\n235\t__global__ void compute_round_and_fold_kernel(\n236\t    const FpExt *__restrict__ eq_xi_low,\n237\t    const FpExt *__restrict__ eq_xi_high,\n238\t    const FracExt *__restrict__ src_pq,  // Pre-fold buffer (2*pq_size FracExt)\n239\t    uint32_t num_x,                      // post-fold num_x (= pq_size / 2)\n240\t    uint32_t log_eq_low_cap,\n241\t    FpExt lambda,\n242\t    FpExt r_prev,                        // Previous round's challenge for folding\n243\t    FpExt *__restrict__ block_sums,      // Output: [gridDim.x * 2]\n244\t    FracExt *__restrict__ dst_pq         // Post-fold buffer (pq_size FracExt)\n245\t) {\n246\t    extern __shared__ FpExt shared[];\n247\t    const uint32_t pq_size = 2 * num_x;\n248\t\n249\t    // Index offsets for fold pattern (see detailed comments in inplace kernel)\n250\t    const uint32_t half = pq_size;              // src_pq_size / 2\n251\t    const uint32_t quarter = pq_size >> 1;      // pq_size / 2\n252\t    const uint32_t eighth = pq_size >> 2;       // pq_size / 4\n253\t    const uint32_t three_eighths = eighth * 3;  // 3 * pq_size / 4\n254\t\n255\t    // Use scalar accumulators instead of array to help register allocation\n256\t    const FpExt zero(Fp::zero());\n257\t    FpExt local0 = zero, local1 = zero;\n258\t    uint32_t idx_base = threadIdx.x + blockIdx.x * blockDim.x;\n259\t\n260\t    // Map phase: compute local sum by striding over grid\n261\t    for (uint32_t idx = idx_base; idx < num_x / 2; idx += blockDim.x * gridDim.x) {\n262\t        // Scalars for folded values used in compute\n263\t        FpExt p0_even, q0_even, p1_even, q1_even;\n264\t        FpExt p0_odd, q0_odd, p1_odd, q1_odd;\n265\t\n266\t        // Load pairs in tight scopes, fold, write immediately to reduce register pressure\n267\t        // f00 at post-fold idx\n268\t        {\n269\t            FracExt a = src_pq[idx];\n270\t            FracExt b = src_pq[idx + quarter];\n271\t            p0_even = a.p + r_prev * (b.p - a.p);\n272\t            q0_even = a.q + r_prev * (b.q - a.q);\n273\t            dst_pq[idx] = {p0_even, q0_even};\n274\t        }\n275\t        // f10 at post-fold idx + quarter\n276\t        {\n277\t            FracExt a = src_pq[idx + half];\n278\t            FracExt b = src_pq[idx + half + quarter];\n279\t            p1_even = a.p + r_prev * (b.p - a.p);\n280\t            q1_even = a.q + r_prev * (b.q - a.q);\n281\t            dst_pq[idx + quarter] = {p1_even, q1_even};\n282\t        }\n283\t        // f01 at post-fold idx + eighth\n284\t        {\n285\t            FracExt a = src_pq[idx + eighth];\n286\t            FracExt b = src_pq[idx + three_eighths];\n287\t            p0_odd = a.p + r_prev * (b.p - a.p);\n288\t            q0_odd = a.q + r_prev * (b.q - a.q);\n289\t            dst_pq[idx + eighth] = {p0_odd, q0_odd};\n290\t        }\n291\t        // f11 at post-fold idx + three_eighths\n292\t        {\n293\t            FracExt a = src_pq[idx + half + eighth];\n294\t            FracExt b = src_pq[idx + half + three_eighths];\n295\t            p1_odd = a.p + r_prev * (b.p - a.p);\n296\t            q1_odd = a.q + r_prev * (b.q - a.q);\n297\t            dst_pq[idx + three_eighths] = {p1_odd, q1_odd};\n298\t        }\n299\t\n300\t        accumulate_compute_contributions(\n301\t            eq_xi_low, eq_xi_high, idx, log_eq_low_cap, lambda,\n302\t            p0_even, q0_even, p0_odd, q0_odd,\n303\t            p1_even, q1_even, p1_odd, q1_odd,\n304\t            local0, local1\n305\t        );\n306\t    }\n307\t\n308\t    reduce_block_sums(shared, local0, local1, block_sums);\n309\t}\n310\t\n311\t// Fused compute round + fold kernel (IN-PLACE version).\n312\t// Reads from pre-fold pq buffer (size 2*pq_size), computes s' polynomial at 1 and 2,\n313\t// and writes folded output back to the same buffer (first pq_size elements).\n314\t//\n315\t// IN-PLACE SAFETY: Each thread writes only to indices it reads from in the first\n316\t// half of the buffer {idx, idx+quarter, idx+eighth, idx+three_eighths}. No cross-thread\n317\t// conflicts because different threads have disjoint idx values. Reads from the second\n318\t// half [pq_size, 2*pq_size) are never written to.\n319\t//\n320\t// NOTE: No __restrict__ on pq pointer since we read and write to the same buffer.\n321\t//\n322\t// shared memory size requirement: max(num_warps,1) * sizeof(FpExt)\n323\t__global__ void compute_round_and_fold_inplace_kernel(\n324\t    const FpExt *__restrict__ eq_xi_low,\n325\t    const FpExt *__restrict__ eq_xi_high,\n326\t    FracExt *pq,                         // In-place buffer: reads 2*pq_size, writes pq_size\n327\t    uint32_t num_x,                      // post-fold num_x (= pq_size / 2)\n328\t    uint32_t log_eq_low_cap,\n329\t    FpExt lambda,\n330\t    FpExt r_prev,                        // Previous round's challenge for folding\n331\t    FpExt *__restrict__ block_sums       // Output: [gridDim.x * 2]\n332\t) {\n333\t    extern __shared__ FpExt shared[];\n334\t    const uint32_t pq_size = 2 * num_x;\n335\t\n336\t    // Fold pattern analysis:\n337\t    // The fold kernel operates on FpExt* view where FracExt[i] = (FpExt[2i], FpExt[2i+1]).\n338\t    // For pre-fold size N = 2*pq_size FracExt = 4*pq_size FpExt, the fold kernel uses:\n339\t    //   quarter = 2*pq_size / 2 = pq_size (in FpExt)\n340\t    //   half = 2 * quarter = 2*pq_size (in FpExt)\n341\t    //\n342\t    // The fold produces output FracExt with this mapping:\n343\t    //   For j in [0, pq_size/2): output[j] = fold(input[j], input[j + pq_size/2])\n344\t    //   For j in [pq_size/2, pq_size): output[j] = fold(input[j + pq_size/2], input[j + pq_size])\n345\t    //\n346\t    // Post-fold indices for compute: idx, idx+quarter, idx+eighth, idx+three_eighths\n347\t    // where quarter = pq_size/2, eighth = pq_size/4\n348\t    const uint32_t half = pq_size;              // src_pq_size / 2\n349\t    const uint32_t quarter = pq_size >> 1;      // pq_size / 2\n350\t    const uint32_t eighth = pq_size >> 2;       // pq_size / 4\n351\t    const uint32_t three_eighths = eighth * 3;  // 3 * pq_size / 4\n352\t\n353\t    // Use scalar accumulators instead of array to help register allocation\n354\t    const FpExt zero(Fp::zero());\n355\t    FpExt local0 = zero, local1 = zero;\n356\t    uint32_t idx_base = threadIdx.x + blockIdx.x * blockDim.x;\n357\t\n358\t    // Map phase: compute local sum by striding over grid\n359\t    for (uint32_t idx = idx_base; idx < num_x / 2; idx += blockDim.x * gridDim.x) {\n360\t        // OPTIMIZATION: Staged load-fold pattern to reduce register pressure.\n361\t        // For in-place operation, we must read all 8 source values before writing.\n362\t        // BUT we fold and write immediately after each pair to minimize live register count.\n363\t        // This reduces peak register usage from ~107 to ~60-70 regs/thread.\n364\t\n365\t        // Declare output scalars for folded values\n366\t        FpExt p0_even, q0_even, p1_even, q1_even;\n367\t        FpExt p0_odd, q0_odd, p1_odd, q1_odd;\n368\t\n369\t        // Pair 1: f00 (idx -> p0_even, q0_even)\n370\t        {\n371\t            FracExt a = pq[idx];\n372\t            FracExt b = pq[idx + quarter];\n373\t            p0_even = a.p + r_prev * (b.p - a.p);\n374\t            q0_even = a.q + r_prev * (b.q - a.q);\n375\t        }\n376\t\n377\t        // Pair 2: f10 (idx + half -> p1_even, q1_even)\n378\t        {\n379\t            FracExt a = pq[idx + half];\n380\t            FracExt b = pq[idx + half + quarter];\n381\t            p1_even = a.p + r_prev * (b.p - a.p);\n382\t            q1_even = a.q + r_prev * (b.q - a.q);\n383\t        }\n384\t\n385\t        // Pair 3: f01 (idx + eighth -> p0_odd, q0_odd)\n386\t        {\n387\t            FracExt a = pq[idx + eighth];\n388\t            FracExt b = pq[idx + three_eighths];\n389\t            p0_odd = a.p + r_prev * (b.p - a.p);\n390\t            q0_odd = a.q + r_prev * (b.q - a.q);\n391\t        }\n392\t\n393\t        // Pair 4: f11 (idx + half + eighth -> p1_odd, q1_odd)\n394\t        {\n395\t            FracExt a = pq[idx + half + eighth];\n396\t            FracExt b = pq[idx + half + three_eighths];\n397\t            p1_odd = a.p + r_prev * (b.p - a.p);\n398\t            q1_odd = a.q + r_prev * (b.q - a.q);\n399\t        }\n400\t"}]},"parent_tool_use_id":"toolu_01YShXMYZRFzdoB8HZpzPWbY","session_id":"ff03fa2a-06a9-4cae-9336-eb9eb1af38e2","uuid":"48b672e1-b652-43a3-90da-78d23a4acff7","timestamp":"2026-04-14T05:09:41.908Z"}
