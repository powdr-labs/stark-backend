mem_contribution;\n1363\t        // GPU folding for mat_evals_per_trace\n1364\t        self.mat_evals_per_trace = ctx\n1365\t            .per_trace\n1366\t            .iter()\n1367\t            .map(|(air_idx, air_ctx)| {\n1368\t                let air_pk = &self.pk.per_air[*air_idx];\n1369\t                let need_rot = air_pk.vk.params.need_rot;\n1370\t                let mut results: Vec<DeviceMatrix<EF>> = Vec::new();\n1371\t\n1372\t                // Preprocessed (if exists)\n1373\t                if let Some(committed) = &air_pk.preprocessed_data {\n1374\t                    let trace = &committed.trace;\n1375\t                    let folded = fold_ple_evals_rotate(\n1376\t                        l_skip,\n1377\t                        &self.d_omega_skip_pows,\n1378\t                        trace,\n1379\t                        &d_inv_lagrange_denoms_r0,\n1380\t                        need_rot,\n1381\t                    )?;\n1382\t                    results.push(folded);\n1383\t                }\n1384\t\n1385\t                // Cached mains\n1386\t                for committed in &air_ctx.cached_mains {\n1387\t                    let trace = &committed.trace;\n1388\t                    let folded = fold_ple_evals_rotate(\n1389\t                        l_skip,\n1390\t                        &self.d_omega_skip_pows,\n1391\t                        trace,\n1392\t                        &d_inv_lagrange_denoms_r0,\n1393\t                        need_rot,\n1394\t                    )?;\n1395\t                    results.push(folded);\n1396\t                }\n1397\t\n1398\t                // Common main\n1399\t                let trace = &air_ctx.common_main;\n1400\t                let folded = fold_ple_evals_rotate(\n1401\t                    l_skip,\n1402\t                    &self.d_omega_skip_pows,\n1403\t                    trace,\n1404\t                    &d_inv_lagrange_denoms_r0,\n1405\t                    need_rot,\n1406\t                )?;\n1407\t                mem_limit = mem_limit.saturating_sub(folded.buffer().len() * size_of::<EF>());\n1408\t                results.push(folded);\n1409\t\n1410\t                Ok(results)\n1411\t            })\n1412\t            .collect::<Result<Vec<_>, FoldPleError>>()?;\n1413\t        if self.save_memory {\n1414\t            self.memory_limit_bytes = mem_limit;\n1415\t        }\n1416\t\n1417\t        // GPU folding for sels_per_trace (rotate=false, only need offset=0)\n1418\t        self.sels_per_trace = std::mem::take(&mut self.sels_per_trace_base)\n1419\t            .into_iter()\n1420\t            .enumerate()\n1421\t            .map(|(trace_idx, selectors_cube)| {\n1422\t                let n = self.n_per_trace[trace_idx];\n1423\t                let num_x = selectors_cube.height();\n1424\t                debug_assert_eq!(num_x, 1 << n.max(0));\n1425\t                debug_assert_eq!(selectors_cube.width(), 3);\n1426\t                let (l, r) = if n.is_negative() {\n1427\t                    (\n1428\t                        l_skip.wrapping_add_signed(n),\n1429\t                        r_0.exp_power_of_2(-n as usize),\n1430\t                    )\n1431\t                } else {\n1432\t                    (l_skip, r_0)\n1433\t                };\n1434\t                let omega = F::two_adic_generator(l);\n1435\t                let is_first = eval_eq_uni_at_one(l, r);\n1436\t                let is_last = eval_eq_uni_at_one(l, r * omega);\n1437\t                let folded_buf = DeviceBuffer::<EF>::with_capacity(num_x * 3);\n1438\t                unsafe {\n1439\t                    fold_selectors_round0(\n1440\t                        folded_buf.as_mut_ptr(),\n1441\t                        selectors_cube.buffer().as_ptr(),\n1442\t                        is_first,\n1443\t                        is_last,\n1444\t                        num_x,\n1445\t                    )\n1446\t                    .map_err(LogupZerocheckError::FoldSelectorsRound0)?;\n1447\t                }\n1448\t                Ok(DeviceMatrix::new(Arc::new(folded_buf), num_x, 3))\n1449\t            })\n1450\t            .collect::<Result<Vec<_>, LogupZerocheckError>>()?;\n1451\t\n1452\t        // GPU scalar multiplication for eq_xi_per_trace and eq_sharp_per_trace\n1453\t        // Compute scalars on CPU (small computation)\n1454\t        let eq_r0 = eval_eq_uni(l_skip, self.xi[0], r_0);\n1455\t        let eq_sharp_r0 = eval_eq_sharp_uni(&self.omega_skip_pows, &self.xi[..l_skip], r_0);\n1456\t        self.eq_ns.push(eq_r0);\n1457\t        self.eq_sharp_ns.push(eq_sharp_r0);\n1458\t        for tree in self.eq_xis.values_mut() {\n1459\t            // trim the back (which corresponds to r_{j-1}) because we don't need it anymore\n1460\t            if tree.layers.len() > 1 {\n1461\t                tree.layers.pop();\n1462\t            }\n1463\t        }\n1464\t\n1465\t        self.mem\n1466\t            .emit_metrics_with_label(\"prover.batch_constraints.fold_ple_evals\");\n1467\t        Ok(())\n1468\t    }"}]},"parent_tool_use_id":"toolu_01F8yjQCrAPMh3D8xeAEeUrv","session_id":"ff03fa2a-06a9-4cae-9336-eb9eb1af38e2","uuid":"c6a690b9-d5d9-44ac-920f-814c9f9c88b9","timestamp":"2026-04-14T05:29:29.019Z"}
