f (gid != 0) {\n383\t        return;\n384\t    }\n385\t    digest_t **subtrees = reinterpret_cast<digest_t **>(d_subtrees);\n386\t    for (size_t i = 0; i < layer_size; ++i) {\n387\t        auto const idx = layer_ids[i];\n388\t        auto const address_space_idx = layer[idx].address_space_idx;\n389\t        layer[idx].label = num_roots - 1 + address_space_idx;\n390\t        if (subtrees[address_space_idx]) {\n391\t            COPY_DIGEST(subtrees[address_space_idx], layer[idx].digest_raw);\n392\t        }\n393\t    }\n394\t\n395\t    Fp cells[CELLS];\n396\t    Poseidon2Buffer poseidon2(\n397\t        reinterpret_cast<FpArray<16> *>(poseidon2_buffer), poseidon2_buffer_idx, poseidon2_capacity\n398\t    );\n399\t    for (auto out_idx = num_roots - 1; out_idx-- > 0;) {\n400\t        size_t const h = root_height - (31 - __clz((uint32_t)out_idx + 1));\n401\t        uint32_t children_ids[2] = {MISSING_CHILD, MISSING_CHILD};\n402\t        for (size_t i = 0; i < layer_size; ++i) {\n403\t            if (auto local_idx = layer[layer_ids[i]].label - 2 * out_idx;\n404\t                local_idx == 1 || local_idx == 2) {\n405\t                children_ids[local_idx - 1] = i;\n406\t            }\n407\t        }\n408\t        if (children_ids[0] == MISSING_CHILD && children_ids[1] == MISSING_CHILD) {\n409\t            continue;\n410\t        }\n411\t        merkle_trace_offset -= 2;\n412\t        {\n413\t            RowSlice row(merkle_trace + merkle_trace_offset, trace_height);\n414\t            COPY_DIGEST(cells, &out[2 * out_idx + 1]);\n415\t            COPY_DIGEST(cells + CELLS_OUT, &out[2 * out_idx + 2]);\n416\t            fill_merkle_trace_row(\n417\t                row, false, drop_highest_bit(out_idx + 1), 0, h, cells, false, false, poseidon2\n418\t            );\n419\t            COL_WRITE_VALUE(row, MerkleCols, height_section, true);\n420\t        }\n421\t        for (auto i : {0, 1}) {\n422\t            if (children_ids[i] != MISSING_CHILD) {\n423\t                COPY_DIGEST(\n424\t                    &out[2 * out_idx + 1 + i], layer[layer_ids[children_ids[i]]].digest_raw\n425\t                );\n426\t            }\n427\t            COPY_DIGEST(cells + CELLS_OUT * i, &out[2 * out_idx + 1 + i]);\n428\t        }\n429\t\n430\t        size_t const surely_surviving_child = std::min(children_ids[0], children_ids[1]);\n431\t        if (children_ids[0] != MISSING_CHILD && children_ids[1] != MISSING_CHILD) {\n432\t            size_t const max_idx = children_ids[children_ids[0] == surely_surviving_child];\n433\t            layer_ids[max_idx] = layer_ids[--layer_size];\n434\t        }\n435\t        layer[layer_ids[surely_surviving_child]].label = out_idx;\n436\t        {\n437\t            RowSlice row(merkle_trace + merkle_trace_offset + 1, trace_height);\n438\t            fill_merkle_trace_row(\n439\t                row,\n440\t                true,\n441\t                drop_highest_bit(out_idx + 1),\n442\t                0,\n443\t                h,\n444\t                cells,\n445\t                children_ids[0] != MISSING_CHILD,\n446\t                children_ids[1] != MISSING_CHILD,\n447\t                poseidon2\n448\t            );\n449\t            COPY_DIGEST(layer[layer_ids[surely_surviving_child]].digest_raw, cells);\n450\t            COL_WRITE_VALUE(row, MerkleCols, height_section, true);\n451\t        }\n452\t    }\n453\t    COPY_DIGEST(out, layer[layer_ids[0]].digest_raw);\n454\t    for (auto i : {0, 1}) {\n455\t        RowSlice row(merkle_trace + i, trace_height);\n456\t        COL_WRITE_VALUE(row, MerkleCols, is_root, true);\n457\t    }\n458\t    assert(layer_size == 1);\n459\t}\n460\t\n461\t// ================== Merkle tree update routine end ==================\n462\t\n463\t__global__ void get_subtree_root(\n464\t    digest_t *const *subtrees,\n465\t    size_t const address_space_idx,\n466\t    Fp *out\n467\t) {\n468\t    auto gid = blockDim.x * blockIdx.x + threadIdx.x;\n469\t    if (gid != 0) {\n470\t        return;\n471\t    }\n472\t    COPY_DIGEST(out, subtrees[address_space_idx]);\n473\t}\n474\t\n475\t#undef COPY_DIGEST\n476\t\n477\t// `addr_space_idx` is the address space _shifted_ by ADDR_SPACE_OFFSET = 1\n478\textern \"C\" int _build_merkle_subtree(\n479\t    uint8_t *data,\n480\t    const size_t size,\n481\t    digest_t *buffer,\n482\t    const size_t tree_offset,\n483\t    const uint addr_space_idx,\n484\t    cudaStream_t stream\n485\t) {\n486\t    digest_t *tree = buffer + tree_offset;\n487\t    assert((size & (size - 1)) == 0);\n488\t    {\n489\t        auto [grid, block] = kernel_launch_params(size);\n490\t        switch (addr_space_idx) { // TODO: revisit when we sort out address space handling\n491\t        case 0:\n492\t            merkle_tree_init<0><<<grid, block, 0, stream>>>(data, tree + (size - 1));\n493\t            break;\n494\t        case 1:\n495\t            merkle_tree_init<1><<<grid, block, 0, stream>>>(data, tree + (size - 1));\n496\t            break;\n497\t        case 2:\n498\t            merkle_tree_init<2><<<grid, block, 0, stream>>>(data, tree + (size - 1));\n499\t            break;\n500\t        case 3:\n501\t            merkle_tree_init<3><<<grid, block, 0, stream>>>(data, tree + (size - 1));\n502\t            break;\n503\t        default:\n504\t            return -1;\n505\t        }\n506\t    }\n507\t    for (auto i = size / 2; i > 0; i /= 2) {\n508\t        auto [grid, block] = kernel_launch_params(i);\n509\t        merkle_tree_compress<<<grid, block, 0, stream>>>(tree + (2 * i - 1), tree + (i - 1), i);\n510\t    }\n511\t    return CHECK_KERNEL();\n512\t}\n513\t\n514\textern \"C\" int _restore_merkle_subtree_path(\n515\t    digest_t *in_out,\n516\t    digest_t *zero_hash,\n517\t    const size_t remaining_size,\n518\t    const size_t full_size,\n519\t    cudaStream_t stream\n520\t) {\n521\t    merkle_tree_restore_path<<<1, 1, 0, stream>>>(\n522\t        in_out, zero_hash + full_size - remaining_size, remaining_size\n523\t    );\n524\t    return CHECK_KERNEL();\n525\t}\n526\t\n527\textern \"C\" int _finalize_merkle_tree(\n528\t    uintptr_t *in,\n529\t    digest_t *out,\n530\t    const size_t num_roots,\n531\t    cudaStream_t stream\n532\t) {\n533\t    assert((num_roots & (num_roots - 1)) == 0);\n534\t    merkle_tree_root<<<1, 1, 0, stream>>>(in, out, num_roots);\n535\t    return CHECK_KERNEL();\n536\t}\n537\t\n538\textern \"C\" int _calculate_zero_hash(digest_t *zero_hash, const size_t size) {\n539\t    calculate_zero_hash<<<1, 1>>>(zero_hash, size);\n540\t    return CHECK_KERNEL();\n541\t}\n542\t\n543\textern \"C\" int _get_prefix_scan_temp_bytes(uint32_t *d_arr, size_t n, size_t *h_temp_n) {\n544\t    size_t temp_bytes = 0;\n545\t    cub::DeviceScan::InclusiveSum(nullptr, temp_bytes, d_arr, d_arr, n, cudaStreamPerThread);\n546\t    *h_temp_n = temp_bytes;\n547\t    return CHECK_KERNEL();\n548\t}\n549\t\n550\t/// Updates the digests in `subtrees`, replacing them with the new ones,\n551\t/// while also producing the trace.\n552\t/// Here, `layer` is obtained from the touched memory.\n553\t/// We go layer by layer, from the leaves to the root,\n554\t/// without reordering the layer and only updating its digests,\n555\t/// and maintaining the indices of its values that are still relevant.\n556\t///\n557\t/// After we reach the address space subtree roots, we call a single `update_to_root` function\n558\t/// to do the remaining work there.\n559\textern \"C\" int _update_merkle_tree(\n560\t    size_t const num_leaves,\n561\t    LabeledDigest *layer,\n562\t    size_t subtree_height,\n563\t    uint32_t *child_buf,\n564\t    uint32_t *tmp_buf,\n565\t    uint8_t *d_temp_storage,\n566\t    size_t need_tmp_storage_bytes,\n567\t    Fp *const merkle_trace,\n568\t    size_t const unpadded_trace_height,\n569\t    size_t const num_subtrees,\n570\t    uintptr_t *subtrees,\n571\t    digest_t *top_roots,\n572\t    digest_t const *zero_hash,\n573\t    size_t const *actual_subtree_heights,\n574\t    Fp *d_poseidon2_raw_buffer,\n575\t    uint32_t *d_poseidon2_buffer_idx,\n576\t    size_t poseidon2_capacity\n577\t) {\n578\t    assert(num_leaves > 0);\n579\t    // poseidon2_capacity arrives from Rust in units of Fp elements; convert to record count.\n580\t    assert(poseidon2_capacity % 16 == 0 && \"poseidon2_capacity must be a multiple of 16\");\n581\t    size_t poseidon2_record_capacity = poseidon2_capacity / 16;\n582\t    uint32_t num_children = num_leaves;\n583\t    size_t const trace_height = [](uint32_t x) {\n584\t        return x ? (1u << (32 - __builtin_clz(x - 1))) : 0;\n585\t    }(unpadded_trace_height);\n586\t\n587\t    {\n588\t        auto [grid, block] = kernel_launch_params(num_leaves, 256);\n589\t        prepare_for_updating<<<grid, block>>>(child_buf, layer, num_children);\n590\t    }\n591\t    {\n592\t        auto [grid, block] = kernel_launch_params(num_subtrees);\n593\t        initial_subtrees_advance<<<grid, block>>>(\n594\t            subtrees, actual_subtree_heights, num_subtrees, subtree_height\n595\t        );\n596\t    }\n597\t\n598\t    uint32_t merkle_trace_offset = unpadded_trace_height;\n599\t    for (uint32_t h = 1; h <= subtree_height; ++h) {\n600\t        uint32_t* parent_ids = tmp_buf + 2 * num_children;\n601\t        // First, find for each child whether it has a different parent from the previous one\n602\t        {\n603\t            auto [grid, block] = kernel_launch_params(num_children);\n604\t            set_parent_id_adjacent_differences<<<grid, block>>>(child_buf, parent_ids, layer, num_children, h);\n605\t            if (int err = CHECK_KERNEL(); err) {\n606\t                return err;\n607\t            }\n608\t        }\n609\t        // Then, convert it to the partial sum\n610\t        {\n611\t            // Now, perform the inclusive sum in-place\n612\t            cub::DeviceScan::InclusiveSum(\n613\t                d_temp_storage, need_tmp_storage_bytes,\n614\t                parent_ids, parent_ids, num_children,\n615\t                cudaStreamPerThread\n616\t            );\n617\t            if (int err = CHECK_KERNEL(); err) {\n618\t                return err;\n619\t            }\n620\t        }\n621\t        // Finally, reorder the children\n622\t        {\n623\t            auto [grid, block] = kernel_launch_params(num_children);\n624\t            group_by_parent<<<grid, block>>>(\n625\t                child_buf,\n626\t                parent_ids,\n627\t                tmp_buf,\n628\t                layer,\n629\t                num_children,\n630\t                h\n631\t            );\n632\t            if (int err = CHECK_KERNEL(); err) {\n633\t                return err;\n634\t            }\n635\t        }\n636\t        uint32_t num_parents;\n637\t        cudaMemcpyAsync(\n638\t            &num_parents,\n639\t            parent_ids + (num_children - 1),\n640\t            sizeof(uint32_t),\n641\t            cudaMemcpyDeviceToHost,\n642\t            cudaStreamPerThread\n643\t        );\n644\t        if (int err = CHECK_KERNEL(); err) {\n645\t            return err;\n646\t        }\n647\t        cudaStreamSynchronize(cudaStreamPerThread);\n648\t        ++num_parents;\n649\t        {\n650\t            auto [grid, block] = kernel_launch_params(num_subtrees);\n651\t            adjust_subtrees_before_layer_update<<<grid, block>>>(\n652\t                subtrees, actual_subtree_heights, num_subtrees, h\n653\t            );\n654\t        }\n655\t        merkle_trace_offset -= 2 * num_parents;\n656\t        auto [grid, block] = kernel_launch_params(num_parents, 256);\n657\t        update_merkle_layer<<<grid, block>>>(\n658\t            h,\n659\t            zero_hash,\n660\t            actual_subtree_heights,\n661\t            layer,\n662\t            tmp_buf,\n663\t            child_buf,\n664\t            num_parents,\n665\t            subtrees,\n666\t            merkle_trace + merkle_trace_offset,\n667\t            trace_height,\n668\t            d_poseidon2_raw_buffer,\n669\t            d_poseidon2_buffer_idx,\n670\t            poseidon2_record_capacity\n671\t        );\n672\t        num_children = num_parents;\n673\t    }\n674\t    update_to_root<<<1, 1>>>(\n675\t        child_buf,\n676\t        layer,\n677\t        num_children,\n678\t        num_subtrees,\n679\t        subtrees,\n680\t        top_roots,\n681\t        merkle_trace,\n682\t        merkle_trace_offset,\n683\t        trace_height,\n684\t        subtree_height + __builtin_ctz(num_subtrees),\n685\t        d_poseidon2_raw_buffer,\n686\t        d_poseidon2_buffer_idx,\n687\t        poseidon2_record_capacity\n688\t    );\n689\t\n690\t    return CHECK_KERNEL();\n691\t}\n692\t"}]},"parent_tool_use_id":null,"session_id":"ff03fa2a-06a9-4cae-9336-eb9eb1af38e2","uuid":"bb593130-7f2f-43ef-a8ea-354f3f90cc93","timestamp":"2026-04-14T05:10:57.041Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/openvm/crates/vm/cuda/src/system/memory/merkle_tree.cu","content":"#include \"launcher.cuh\"\n#include \"poseidon2.cuh\"\n#include \"primitives/shared_buffer.cuh\"\n#include \"primitives/trace_access.h\"\n\n#include <cub/cub.cuh>\n\nusing poseidon2::poseidon2_mix;\n\nstruct alignas(32) digest_t {\n    Fp cells[CELLS_OUT];\n};\n\n#define COPY_DIGEST(dst, src) memcpy(dst, src, sizeof(digest_t))\n\n// `ADDR_SPACE_IDX` is the address space minus `ADDR_SPACE_OFFSET` (which is 1)\ntemplate <int ADDR_SPACE_IDX>\n__global__ void merkle_tree_init(uint8_t *__restrict__ data, digest_t *__restrict__ out) {\n    auto gid = blockDim.x * blockIdx.x + threadIdx.x;\n\n    Fp cells[CELLS] = {0};\n    // TODO: revisit when we sort out address space handling\n#pragma unroll\n    for (size_t i = 0; i < CELLS_OUT; ++i) {\n        if constexpr (ADDR_SPACE_IDX < 3) {\n            cells[i] = Fp(data[CELLS_OUT * gid + i]);\n        } else {\n            cells[i] = reinterpret_cast<Fp *>(data)[CELLS_OUT * gid + i];\n        }\n    }\n\n    poseidon2_mix(cells);\n\n    COPY_DIGEST(&out[gid], cells);\n}\n\n__global__ void merkle_tree_compress(\n    digest_t *__restrict__ in,\n    digest_t *__restrict__ out,\n    size_t num_compressions\n) {\n    auto gid = blockDim.x * blockIdx.x + threadIdx.x;\n    if (gid >= num_compressions) {\n        return;\n    }\n\n    Fp cells[CELLS];\n    COPY_DIGEST(cells, &in[2 * gid]);\n    COPY_DIGEST(cells + CELLS_OUT, &in[2 * gid + 1]);\n\n    poseidon2_mix(cells);\n\n    COPY_DIGEST(&out[gid], cells);\n}\n\n__global__ void merkle_tree_restore_path(\n    digest_t *__restrict__ in_out,\n    digest_t *__restrict__ zero_hash,\n    const size_t remaining_size\n) {\n    auto gid = blockDim.x * blockIdx.x + threadIdx.x;\n    if (gid != 0) {\n        return;\n    }\n\n    Fp cells[CELLS];\n    COPY_DIGEST(cells, &in_out[remaining_size]);\n\n    for (auto i = 0; i < remaining_size; i++) {\n        COPY_DIGEST(cells + CELLS_OUT, &zero_hash[i]);\n        poseidon2_mix(cells);\n        COPY_DIGEST(&in_out[remaining_size - i - 1], cells);\n    }\n}\n\n__global__ void calculate_zero_hash(digest_t *zero_hash, const size_t size) {\n    auto gid = blockDim.x * blockIdx.x + threadIdx.x;\n    if (gid != 0) {\n        return;\n    }\n\n    Fp cells[CELLS] = {0};\n    poseidon2_mix(cells);\n    COPY_DIGEST(zero_hash, cells);\n\n    for (auto i = 0; i < size; i++) {\n        COPY_DIGEST(cells + CELLS_OUT, &zero_hash[i]);\n        poseidon2_mix(cells);\n        COPY_DIGEST(&zero_hash[i + 1], cells);\n    }\n}\n\n__global__ void merkle_tree_root(\n    uintptr_t *__restrict__ in_roots, // aka digest_t**\n    digest_t *__restrict__ out,\n    const size_t num_roots\n) {\n    auto gid = blockDim.x * blockIdx.x + threadIdx.x;\n    if (gid != 0) {\n        return;\n    }\n    digest_t **in = reinterpret_cast<digest_t **>(in_roots);\n    for (auto i = 0; i < num_roots; ++i) {\n        COPY_DIGEST(&out[num_roots - 1 + i], in[i]);\n    }\n\n    Fp cells[CELLS];\n    for (auto out_idx = num_roots - 1; out_idx-- > 0;) {\n        COPY_DIGEST(cells, &out[2 * out_idx + 1]);\n        COPY_DIGEST(cells + CELLS_OUT, &out[2 * out_idx + 2]);\n        poseidon2_mix(cells);\n        COPY_DIGEST(&out[out_idx], cells);\n    }\n}\n\n// ================== Merkle tree update routine ==================\n\n__global__ void initial_subtrees_advance(\n    uintptr_t *d_subtrees,\n    size_t const *actual_subtree_heights,\n    size_t const num_subtrees,\n    size_t const subtree_height\n) {\n    auto gid = blockDim.x * blockIdx.x + threadIdx.x;\n    if (gid >= num_subtrees) {\n        return;\n    }\n    digest_t **subtrees = reinterpret_cast<digest_t **>(d_subtrees);\n    auto const h = actual_subtree_heights[gid];\n    subtrees[gid] += (1 << (h + 1)) - 1 + (subtree_height - h);\n}\n\n__global__ void adjust_subtrees_before_layer_update(\n    uintptr_t *d_subtrees,\n    size_t const *actual_subtree_heights,\n    size_t const num_subtrees,\n    size_t const h\n) {\n    auto gid = blockDim.x * blockIdx.x + threadIdx.x;\n    if (gid >= num_subtrees) {\n        return;\n    }\n    digest_t **subtrees = reinterpret_cast<digest_t **>(d_subtrees);\n    subtrees[gid] -=\n        h <= actual_subtree_heights[gid] ? 1 << (actual_subtree_heights[gid] - h + 1) : 1;\n}\n\ntemplate <typename T> struct MerkleCols {\n    T expand_direction;\n    T height_section;\n    T parent_height;\n    T is_root;\n    T parent_as_label;\n    T parent_address_label;\n    T parent_hash[CELLS_OUT];\n    T left_child_hash[CELLS_OUT];\n    T right_child_hash[CELLS_OUT];\n    T left_direction_different;\n    T right_direction_different;\n};\n\nstruct LabeledDigest {\n    uint32_t address_space_idx;\n    uint32_t label;\n    uint32_t timestamp; // unused\n    uint32_t digest_raw[CELLS_OUT];\n};\n\n__global__ void prepare_for_updating(\n    uint32_t *child_buf,\n    LabeledDigest *leaves,\n    uint32_t const num_leaves\n) {\n    auto gid = blockDim.x * blockIdx.x + threadIdx.x;\n    if (gid >= num_leaves) {\n        return;\n    }\n    child_buf[gid] = gid;\n    Fp cells[CELLS] = {0};\n    COPY_DIGEST(cells, leaves[gid].digest_raw);\n    poseidon2_mix(cells);\n    COPY_DIGEST(leaves[gid].digest_raw, cells);\n    leaves[gid].address_space_idx -= 1;\n    leaves[gid].label /= CELLS_OUT;\n}\n\n__global__ void set_parent_id_adjacent_differences(\n    uint32_t const *current_layer_ptrs,\n    uint32_t *parent_ids,\n    LabeledDigest const *layer,\n    uint32_t const num_children,\n    uint32_t const h\n) {\n    auto gid = blockDim.x * blockIdx.x + threadIdx.x;\n    if (gid >= num_children) {\n        return;\n    }\n    if (gid == 0) {\n        parent_ids[gid] = 0;\n    } else {\n        auto const ptr1 = current_layer_ptrs[gid - 1];\n        auto const ptr2 = current_layer_ptrs[gid];\n        parent_ids[gid] = layer[ptr1].address_space_idx != layer[ptr2].address_space_idx\n            || (layer[ptr1].label >> h) != (layer[ptr2].label >> h);\n    }\n}\n\nuint32_t const MISSING_CHILD = UINT_MAX;\n\n__global__ void group_by_parent(\n    uint32_t const *current_layer_ptrs,\n    uint32_t const *parent_ids,\n    uint32_t *child_ptrs,\n    LabeledDigest const *layer,\n    uint32_t const num_children,\n    uint32_t const h\n) {\n    auto gid = blockDim.x * blockIdx.x + threadIdx.x;\n    if (gid >= num_children) {\n        return;\n    }\n\n    uint32_t const ptr = current_layer_ptrs[gid];\n    uint32_t const my_place = parent_ids[gid] * 2 + (layer[ptr].label >> (h - 1)) % 2;\n    uint32_t const siblings_place = my_place ^ 1;\n\n    child_ptrs[my_place] = ptr;\n    // Mark the sibling as absent if we are the only child\n    {\n        uint32_t const sibling_id = gid + (siblings_place - my_place);\n        if (sibling_id >= num_children || parent_ids[sibling_id] != parent_ids[gid]) {\n            child_ptrs[siblings_place] = MISSING_CHILD;\n        }\n    }\n}\n\n__device__ void fill_merkle_trace_row(\n    RowSlice row,\n    bool new_values,\n    uint32_t as_label,\n    uint32_t parent_label,\n    uint32_t parent_height,\n    Fp *digests,\n    bool left_new,\n    bool right_new,\n    Poseidon2Buffer &poseidon2\n) {\n    COL_WRITE_VALUE(row, MerkleCols, expand_direction, new_values ? Fp::neg_one() : Fp::one());\n    COL_WRITE_VALUE(row, MerkleCols, height_section, false);\n    COL_WRITE_VALUE(row, MerkleCols, parent_height, parent_height);\n    COL_WRITE_VALUE(row, MerkleCols, is_root, false);\n    COL_WRITE_VALUE(row, MerkleCols, parent_as_label, as_label);\n    COL_WRITE_VALUE(row, MerkleCols, parent_address_label, parent_label);\n    COL_WRITE_ARRAY(row, MerkleCols, left_child_hash, digests);\n    COL_WRITE_ARRAY(row, MerkleCols, right_child_hash, digests + CELLS_OUT);\n    poseidon2.compress_and_record_inplace(digests);\n    COL_WRITE_ARRAY(row, MerkleCols, parent_hash, digests);\n    COL_WRITE_VALUE(row, MerkleCols, left_direction_different, left_new != new_values);\n    COL_WRITE_VALUE(row, MerkleCols, right_direction_different, right_new != new_values);\n}\n\n__device__ __forceinline__ digest_t const *layer_value_on_height(\n    digest_t const *subtree_layer,\n    digest_t const *zero_hash,\n    uint32_t const height,\n    uint32_t const layer_actual_height,\n    size_t const label\n) {\n    auto const layer_size =\n        1 << (height <= layer_actual_height ? (layer_actual_height - height) : 0);\n    return label < layer_size ? subtree_layer + label : zero_hash + height;\n}\n\n__global__ void update_merkle_layer(\n    uint32_t layer_height,\n    digest_t const *zero_hash,\n    size_t const *actual_subtree_heights,\n    LabeledDigest *layer,\n    uint32_t const *child_ptrs,\n    uint32_t *parent_ptrs,\n    size_t const num_parents,\n    uintptr_t *d_subtree_layers,\n    Fp *const merkle_trace,\n    size_t const trace_height,\n    Fp *poseidon2_buffer,\n    uint32_t *poseidon2_buffer_idx,\n    size_t poseidon2_capacity\n) {\n    auto idx = blockDim.x * blockIdx.x + threadIdx.x;\n    if (idx >= num_parents) {\n        return;\n    }\n    Fp cells[CELLS];\n    digest_t **subtree_layers = reinterpret_cast<digest_t **>(d_subtree_layers);\n\n    uint32_t con