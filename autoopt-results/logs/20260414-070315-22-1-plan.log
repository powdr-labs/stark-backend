fn _logup_r0_temp_sums_buffer_size(\n296\t        buffer_size: u32,\n297\t        skip_domain: u32,\n298\t        num_x: u32,\n299\t        num_cosets: u32,\n300\t        max_temp_bytes: usize,\n301\t    ) -> usize;\n302\t\n303\t    pub fn _logup_r0_intermediates_buffer_size(\n304\t        buffer_size: u32,\n305\t        skip_domain: u32,\n306\t        num_x: u32,\n307\t        num_cosets: u32,\n308\t        max_temp_bytes: usize,\n309\t    ) -> usize;\n310\t\n311\t    fn _logup_bary_eval_interactions_round0(\n312\t        tmp_sums_buffer: *mut Frac<EF>,\n313\t        output: *mut Frac<EF>,\n314\t        selectors_cube: *const F,\n315\t        preprocessed: *const F,\n316\t        main_parts: *const *const F,\n317\t        eq_cube: *const EF,\n318\t        public_values: *const F,\n319\t        numer_weights: *const EF,\n320\t        denom_weights: *const EF,\n321\t        denom_sum_init: EF,\n322\t        d_rules: *const std::ffi::c_void,\n323\t        rules_len: usize,\n324\t        buffer_size: u32,\n325\t        d_intermediates: *mut F,\n326\t        skip_domain: u32,\n327\t        num_x: u32,\n328\t        height: u32,\n329\t        num_cosets: u32,\n330\t        g_shift: F,\n331\t        max_temp_bytes: usize,\n332\t    ) -> i32;\n333\t\n334\t    // zerocheck_round0.cu\n335\t    pub fn _zerocheck_r0_temp_sums_buffer_size(\n336\t        buffer_size: u32,\n337\t        skip_domain: u32,\n338\t        num_x: u32,\n339\t        num_cosets: u32,\n340\t        max_temp_bytes: usize,\n341\t    ) -> usize;\n342\t\n343\t    pub fn _zerocheck_r0_intermediates_buffer_size(\n344\t        buffer_size: u32,\n345\t        skip_domain: u32,\n346\t        num_x: u32,\n347\t        num_cosets: u32,\n348\t        max_temp_bytes: usize,\n349\t    ) -> usize;\n350\t\n351\t    fn _zerocheck_ntt_eval_constraints(\n352\t        tmp_sums_buffer: *mut EF,\n353\t        output: *mut EF,\n354\t        selectors_cube: *const F,\n355\t        preprocessed: *const F,\n356\t        main_part