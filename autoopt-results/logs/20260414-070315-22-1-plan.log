sed two-layer tree build. Applies layers i and i+1 in one kernel pass,\n125\t    /// keeping intermediate right-half nodes for revert operations.\n126\t    /// `half_i1` = N >> (i+2), where i is the first of the two layers.\n127\t    fn _frac_build_tree_two_layers(layer: *mut Frac<EF>, half_i1: usize) -> i32;\n128\t\n129\t    pub fn _frac_compute_round_temp_buffer_size(stride: u32) -> u32;\n130\t\n131\t    fn _frac_compute_round(\n132\t        eq_xi_low: *const EF,\n133\t        eq_xi_high: *const EF,\n134\t        pq_buffer: *const Frac<EF>,\n135\t        num_x: usize,\n136\t        eq_low_cap: usize,\n137\t        lambda: EF,\n138\t        out_device: *mut EF,\n139\t        tmp_block_sums: *mut EF,\n140\t    ) -> i32;\n141\t\n142\t    /// Fused compute round + tree layer revert. Combines frac_build_tree_layer(revert=true)\n143\t    /// with compute_round for the first inner round. Modifies layer in-place for revert.\n144\t    fn _frac_compute_round_and_revert(\n145\t        eq_xi_low: *const EF,\n146\t        eq_xi_high: *const EF,\n147\t        layer: *mut Frac<EF>,\n148\t        num_x: usize,\n149\t        eq_low_cap: usize,\n150\t        lambda: EF,\n151\t        out_device: *mut EF,\n152\t        tmp_block_sums: *mut EF,\n153\t    ) -> i32;\n154\t\n155\t    fn _frac_fold_fpext_columns(\n156\t        src: *const Frac<EF>,\n157\t        dst: *mut Frac<EF>,\n158\t        size: usize,\n159\t        r: EF,\n160\t    ) -> i32;\n161\t\n162\t    /// Fused compute round + fold (out-of-place). Reads from pre-fold src_pq_buffer (size\n163\t    /// src_pq_size), computes sumcheck sums, and writes folded output to dst_pq_buffer (size\n164\t    /// src_pq_size/2). IMPORTANT: src_pq_buffer and dst_pq_buffer must NOT alias.\n165\t    fn _frac_compute_round_and_fold(\n166\t        eq_xi_low: *const EF,\n167\t        eq_xi_high: *const EF,\n168\t        src_pq_buffer: *const Frac<EF>,\n169\t        dst_pq_buffer: *mut Frac<EF>,\n170\t        src_pq_size: usize,\n171\t        eq