map(|eq_3bs| {\n949\t                if eq_3bs.is_empty() {\n950\t                    Ok(DeviceBuffer::new())\n951\t                } else {\n952\t                    eq_3bs.to_device()\n953\t                }\n954\t            })\n955\t            .collect::<Result<Vec<_>, _>>()?;\n956\t\n957\t        // Precompute logup combinations for all traces with interaction monomials\n958\t        for (trace_idx, (air_idx, _)) in ctx.per_trace.iter().enumerate() {\n959\t            let air_pk = &self.pk.per_air[*air_idx];\n960\t            if air_pk.other_data.interaction_monomials.is_some()\n961\t                && !self.eq_3b_per_trace[trace_idx].is_empty()\n962\t            {\n963\t                self.logup_combinations[trace_idx] = Some(\n964\t                    compute_logup_combinations(\n965\t                        self.pk,\n966\t                        *air_idx,\n967\t                        &self.d_beta_pows,\n968\t                        &self.d_eq_3b_per_trace[trace_idx],\n969\t                        &self.eq_3b_per_trace[trace_idx],\n970\t                        &self.beta_pows,\n971\t                    )\n972\t                    .map_err(LogupZerocheckError::LogupCombinations)?,\n973\t                );\n974\t            }\n975\t        }\n976\t\n977\t        // PERF[jpw]: we could also build the layers for different n in a transposed way using\n978\t        // eq_nonoverlapping_stage_ext, which is more memory efficient\n979\t        for &n in &self.n_per_trace {\n980\t            let n_lift = n.max(0) as usize;\n981\t            if let Entry::Vacant(entry) = self.eq_xis.entry(n_lift) {\n982\t                let layers =\n983\t                    EqEvalLayers::new_rev(n_lift, xi[l_skip..l_skip + n_lift].iter().rev())\n984\t                        .map_err(LogupZerocheckError::EqEvalLayers)?;\n985\t                entry.insert(layers);\n986\t            }\n987\t        }\n988\t\n989\t        self.sels_per_trace_base = self\n990\t            .n_per_trace\n991\t            .iter()\n992\t            .map(|&n| {\n993\t                let n_lift = n.max(0) as usize;\n994\t                let height = 1 << n_lift;\n995\t                let mut cols = F::zero_vec(3 * height);\n996\t                cols[height..2 * height - 1].fill(F::ONE); // is_transition\n997\t                cols[0] = F::ONE; // is_first\n998\t                cols[2 * height + height - 1] = F::ONE; // is_last\n999\t                let d_cols = cols.to_device()?;\n1000\t                Ok(DeviceMatrix::new(Arc::new(d_cols), height, 3))\n1001\t            })\n1002\t            .collect::<Result<Vec<_>, MemCopyError>>()?;\n1003\t\n1004\t        let selectors_base = self.sels_per_trace_base.clone();\n1005\t\n1006\t        // All (numer, denom) pairs per present AIR for logup, followed by 1 zerocheck poly per\n1007\t        // present AIR\n1008\t        let mut batch_sp_poly = vec![UnivariatePoly::new(vec![]); 3 * num_present_airs];\n1009\t        let d_lambda_pows = self\n1010\t            .lambda_pows\n1011\t            .as_ref()\n1012\t            .expect(\"lambda powers must be set before round-0 evaluation\");\n1013\t\n1014\t        // Phase 1: Build work items with pre-computed buffer sizes (main thread, pure CPU)\n1015\t        let per_thread_temp_bytes = self.memory_limit_bytes / NUM_ROUND0_STREAMS.max(1);\n1016\t        let mut work_items: Vec<Round0AirWorkItem<HS>> = izip!(\n1017\t            &ctx.per_trace,\n1018\t            &self.n_per_trace,\n1019\t            &selectors_base,\n1020\t            &self.public_values_per_trace,\n1021\t            &self.eq_3b_per_trace,\n1022\t        )\n1023\t        .enumerate()\n1024\t        .map(|(trace_idx, ((air_idx, air_ctx), &n, sel, pv, eq3b))| {\n1025\t            let single_pk = &self.pk.per_air[*air_idx];\n1026\t            let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n1027\t            let n_lift = n.max(0) as usize;\n1028\t            let skip_domain = 1u32 << l_skip;\n1029\t            let num_x = 1u32 << n_lift;\n1030\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1) as u32;\n1031\t            let num_cosets_logup = local_constraint_deg as u32;\n1032\t\n1033\t            // Pre-compute zerocheck buffer sizes\n1034\t            let zc_buffer_size = single_pk.other_data.zerocheck_round0.inner.buffer_size;\n1035\t            let zc_intermed_cap = if num_cosets_zc > 0 && !single_pk.vk.symbolic_constraints.constraints.constraint_idx.is_empty() {\n1036\t                unsafe {\n1037\t                    _zerocheck_r0_intermediates_buffer_size(\n1038\t                        zc_buffer_size, skip_domain, num_x, num_cosets_zc, per_thread_temp_bytes,\n1039\t                    )\n1040\t                }\n1041\t            } else {\n1042\t                0\n1043\t            };\n1044\t            let zc_temp_sums_cap = if num_cosets_zc > 0 && !single_pk.vk.symbolic_constraints.constraints.constraint_idx.is_empty() {\n1045\t                unsafe {\n1046\t                    _zerocheck_r0_temp_sums_buffer_size(\n1047\t                        zc_buffer_size, skip_domain, num_x, num_cosets_zc, per_thread_temp_bytes,\n1048\t                    )\n1049\t                }\n1050\t            } else {\n1051\t                0\n1052\t            };\n1053\t\n1054\t            // Pre-compute logup buffer sizes (using logup_round0_buffer_size from Step 1)\n1055\t            let logup_buffer_size = single_pk.other_data.logup_round0_buffer_size;\n1056\t            let has_interactions = !eq3b.is_empty();\n1057\t            let logup_intermed_cap = if has_interactions && logup_buffer_size > 0 {\n1058\t                unsafe {\n1059\t                    _logup_r0_intermediates_buffer_size(\n1060\t                        logup_buffer_size, skip_domain, num_x, num_cosets_logup, per_thread_temp_bytes,\n1061\t                    )\n1062\t                }\n1063\t            } else {\n1064\t                0\n1065\t            };\n1066\t            let logup_temp_sums_cap = if has_interactions && logup_buffer_size > 0 {\n1067\t                unsafe {\n1068\t                    _logup_r0_temp_sums_buffer_size(\n1069\t                        logup_buffer_size, skip_domain, num_x, num_cosets_logup, per_thread_temp_bytes,\n1070\t                    )\n1071\t                }\n1072\t            } else {\n1073\t                0\n1074\t            };\n1075\t\n1076\t            Round0AirWorkItem {\n1077\t                trace_idx,\n1078\t                single_pk,\n1079\t                n,\n1080\t                selectors_cube: sel,\n1081\t                public_values: pv,\n1082\t                eq_3bs: eq3b,\n1083\t                cached_mains: &air_ctx.cached_mains,\n1084\t                common_main: &air_ctx.common_main,\n1085\t                eq_xis: &self.eq_xis,\n1086\t                d_lambda_pows,\n1087\t                beta_pows: &self.beta_pows,\n1088\t                l_skip,\n1089\t                constraint_degree: self.constraint_degree,\n1090\t                xi: &self.xi,\n1091\t                max_temp_bytes: per_thread_temp_bytes,\n1092\t                zc_intermed_cap,\n1093\t                zc_temp_sums_cap,\n1094\t                logup_intermed_cap,\n1095\t                logup_temp_sums_cap,\n1096\t                zc_batch_offset: 0,    // set after max_poly_len is computed\n1097\t                numer_batch_offset: 0,\n1098\t                denom_batch_offset: 0,\n1099\t            }\n1100\t        })\n1101\t        .collect();\n1102\t\n1103\t        // Sort by descending height for better load balance across thread chunks.\n1104\t        work_items.sort_by(|a, b| b.common_main.height().cmp(&a.common_main.height()));\n1105\t\n1106\t        // Pre-compute polynomial extraction transform matrices per unique constraint degree.\n1107\t        let skip_domain = 1usize << l_skip;\n1108\t        let mut extract_tables: FxHashMap<usize, Round0ExtractTables> = FxHashMap::default();\n1109\t        for w in &work_items {\n1110\t            let d = w.single_pk.vk.max_constraint_degree as usize;\n1111\t            if !extract_tables.contains_key(&d) {\n1112\t                extract_tables.insert(d, compute_round0_extract_tables(d, l_skip)?);\n1113\t            }\n1114\t        }\n1115\t\n1116\t        // Pre-allocate device batch polynomial array.\n1117\t        // All polynomial coefficients are written here by GPU extraction kernels,\n1118\t        // then copied to host in a single D2H transfer.\n1119\t        let max_poly_len = work_items\n1120\t            .iter()\n1121\t            .map(|w| {\n1122\t                let d = w.single_pk.vk.max_constraint_degree as usize;\n1123\t                let zc_len = sumcheck_round0_deg(l_skip, d) + 1;\n1124\t                let logup_len = d * skip_domain;\n1125\t                zc_len.max(logup_len)\n1126\t            })\n1127\t            .max()\n1128\t            .unwrap_or(0);\n1129\t\n1130\t        let batch_total = 3 * num_present_airs * max_poly_len;\n1131\t        let d_batch_array = if batch_total > 0 {\n1132\t            let buf = DeviceBuffer::<EF>::with_capacity(batch_total);\n1133\t            buf.fill_zero().map_err(MemCopyError::from)?;\n1134\t            buf\n1135\t        } else {\n1136\t            DeviceBuffer::new()\n1137\t        };\n1138\t\n1139\t        // Set per-AIR batch offsets.\n1140\t        for w in &mut work_items {\n1141\t            w.zc_batch_offset = (2 * num_present_airs + w.trace_idx) * max_poly_len;\n1142\t            w.numer_batch_offset = (2 * w.trace_idx) * max_poly_len;\n1143\t            w.denom_batch_offset = (2 * w.trace_idx + 1) * max_poly_len;\n1144\t        }\n1145\t\n1146\t        // Track per-AIR polynomial lengths for host-side reconstruction.\n1147\t        let poly_lens: Vec<(usize, usize, usize)> = {\n1148\t            // Build a map from trace_idx to (zc_len, logup_len)\n1149\t            let mut lens = vec![(0usize, 0usize, 0usize); num_present_airs];\n1150\t            for w in &work_items {\n1151\t                let d = w.single_pk.vk.max_constraint_degree as usize;\n1152\t                let has_constraints = d > 1\n1153\t                    && !w\n1154\t                        .single_pk\n1155\t                        .vk\n1156\t                        .symbolic_constraints\n1157\t                        .constraints\n1158\t                        .constraint_idx\n1159\t                        .is_empty();\n1160\t                let has_interactions = !w.eq_3bs.is_empty();\n1161\t                let zc_len = if has_constraints {\n1162\t                    sumcheck_round0_deg(l_skip, d) + 1\n1163\t                } else {\n1164\t                    0\n1165\t                };\n1166\t                let logup_len = if has_interactions { d * skip_domain } else { 0 };\n1167\t                lens[w.trace_idx] = (zc_len, logup_len, logup_len);\n1168\t            }\n1169\t            lens\n1170\t        };\n1171\t\n1172\t        // Pre-compute buffer sizes for pre-allocation using a percentile threshold.\n1173\t        // Using the max would require enormous buffers (driven by a few large AIRs),\n1174\t        // causing GPU memory pressure that degrades all phases. The 95th percentile\n1175\t        // covers 95%+ of AIRs while keeping total allocation manageable. The few\n1176\t        // large AIRs above the threshold fall back to dynamic allocation.\n1177\t        let percentile_idx = |n: usize| -> usize { (n * 95 / 100).min(n.saturating_sub(1)) };\n1178\t        let (max_zc_intermed, max_zc_temp_sums, max_logup_intermed, max_logup_temp_sums) = {\n1179\t            let n = work_items.len();\n1180\t            let mut zc_i: Vec<usize> = work_items.iter().map(|w| w.zc_intermed_cap).collect();\n1181\t            let mut zc_t: Vec<usize> = work_items.iter().map(|w| w.zc_temp_sums_cap).collect();\n1182\t            let mut li: Vec<usize> = work_items.iter().map(|w| w.logup_intermed_cap).collect();\n1183\t            let mut lt: Vec<usize> = work_items.iter().map(|w| w.logup_temp_sums_cap).collect();\n1184\t            zc_i.sort_unstable();\n1185\t            zc_t.sort_unstable();\n1186\t            li.sort_unstable();\n1187\t            lt.sort_unstable();\n1188\t            let idx = percentile_idx(n);\n1189\t            (zc_i[idx], zc_t[idx], li[idx], lt[idx])\n1190\t        };\n1191\t\n1192\t        // Barrier: ensure all prior GPU work (trace uploads, pk data, selectors)\n1193\t        // is visible to worker thread streams.\n1194\t        current_stream_sync().map_err(MemCopyError::from)?;\n1195\t\n1196\t        // Phase 2: Process AIRs in parallel across N OS threads.\n1197\t        // Only use multi-threading when there are enough AIRs to benefit from concurrent\n1198\t        // kernel execution. With few large AIRs (e.g., APC 0 has ~20 per segment), each\n1199\t        // kernel already saturates the GPU and multi-threading adds memory pool overhead.\n1200\t        let mut num_threads = if work_items.len() >= 100 {\n1201\t            NUM_ROUND0_STREAMS.min(work_items.len())\n1202\t        } else {\n1203\t            1\n1204\t        };\n1205\t\n1206\t        // Memory budget check: reduce num_threads if pre-allocation would exceed budget.\n1207\t        let per_thread_bytes = max_zc_intermed * size_of::<F>()\n1208\t            + max_zc_temp_sums * size_of::<EF>()\n1209\t            + max_logup_intermed * size_of::<F>()\n1210\t            + max_logup_temp_sums * size_of::<Frac<EF>>();\n1211\t        while num_threads > 1 && num_threads * per_thread_bytes > 2_000_000_000 {\n1212\t            num_threads /= 2;\n1213\t            tracing::warn!(\n1214\t                \"Reducing Round 0 thread count to {} due to memory budget ({}MB per thread)\",\n1215\t                num_threads,\n1216\t                per_thread_bytes / (1024 * 1024),\n1217\t            );\n1218\t        }\n1219\t"}]},"parent_tool_use_id":"toolu_01F8yjQCrAPMh3D8xeAEeUrv","session_id":"ff03fa2a-06a9-4cae-9336-