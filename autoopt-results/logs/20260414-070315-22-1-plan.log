{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017NG5KSquN7NvGgPxqgeJzB","type":"tool_result","content":"242\tfn process_air_round0<HS: GpuHashScheme>(\n243\t    w: &Round0AirWorkItem<HS>,\n244\t    bufs: &mut round0::Round0ThreadBuffers,\n245\t    d_batch_ptr: *mut EF,\n246\t    extract_tables: &FxHashMap<usize, Round0ExtractTables>,\n247\t) -> Result<(), LogupZerocheckError> {\n248\t    let single_pk = w.single_pk;\n249\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n250\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n251\t    assert!(\n252\t        local_constraint_deg <= w.constraint_degree,\n253\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n254\t        w.constraint_degree\n255\t    );\n256\t\n257\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n258\t    let omega_root = F::two_adic_generator(log_large_domain);\n259\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n260\t\n261\t    let height = w.common_main.height();\n262\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n263\t    for committed in w.cached_mains {\n264\t        main_parts.push(committed.trace.buffer().as_ptr());\n265\t    }\n266\t    main_parts.push(w.common_main.buffer().as_ptr());\n267\t    let d_main_parts = main_parts.to_device()?;\n268\t\n269\t    let n_lift = w.n.max(0) as usize;\n270\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n271\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n272\t\n273\t    // Check if pre-allocated zerocheck buffers are large enough for this AIR\n274\t    let zc_prealloc_inter = if w.zc_intermed_cap > 0\n275\t        && bufs.zc_intermediates.len() >= w.zc_intermed_cap\n276\t    {\n277\t        Some(&mut bufs.zc_intermediates)\n278\t    } else {\n279\t        None\n280\t    };\n281\t    let zc_prealloc_temp = if w.zc_temp_sums_cap > 0\n282\t        && bufs.zc_temp_sums.len() >= w.zc_temp_sums_cap\n283\t    {\n284\t        Some(&mut bufs.zc_temp_sums)\n285\t    } else {\n286\t        None\n287\t    };\n288\t\n289\t    let sum_buffer = evaluate_round0_constraints_gpu(\n290\t        single_pk,\n291\t        w.selectors_cube.buffer(),\n292\t        &d_main_parts,\n293\t        w.public_values,\n294\t        eq_xi_tree.get_ptr(n_lift),\n295\t        w.d_lambda_pows,\n296\t        1 << w.l_skip,\n297\t        1 << n_lift,\n298\t        height as u32,\n299\t        num_cosets_zc as u32,\n300\t        omega_root,\n301\t        w.max_temp_bytes,\n302\t        zc_prealloc_inter,\n303\t        zc_prealloc_temp,\n304\t    )?;\n305\t\n306\t    // GPU-side polynomial extraction: launch a small kernel to compute\n307\t    // iDFT + Lagrange interpolation + coefficient adjustment on-device,\n308\t    // writing directly into the batch array. No D2H sync needed.\n309\t    if !sum_buffer.is_empty() {\n310\t        let tables = &extract_tables[&local_constraint_deg];\n311\t        let err = unsafe {\n312\t            _round0_extract_zerocheck_poly(\n313\t                d_batch_ptr.add(w.zc_batch_offset),\n314\t                sum_buffer.as_ptr(),\n315\t                tables.zc_transform.as_ptr(),\n316\t                tables.zc_input_size,\n317\t                tables.zc_output_size,\n318\t            )\n319\t        };\n320\t        if err != 0 {\n321\t            return Err(Round0EvalError::Cuda(CudaError::new(err)).into());\n322\t        }\n323\t    }\n324\t    // sum_buffer dropped here; cudaFreeAsync is ordered after the kernel on the same stream\n325\t\n326\t    let num_cosets_logup = local_constraint_deg;\n327\t\n328\t    // Check if pre-allocated logup buffers are large enough for this AIR\n329\t    let logup_prealloc_inter = if w.logup_intermed_cap > 0\n330\t        && bufs.logup_intermediates.len() >= w.logup_intermed_cap\n331\t    {\n332\t        Some(&mut bufs.logup_intermediates)\n333\t    } else {\n334\t        None\n335\t    };\n336\t    let logup_prealloc_temp = if w.logup_temp_sums_cap > 0\n337\t        && bufs.logup_temp_sums.len() >= w.logup_temp_sums_cap\n338\t    {\n339\t        Some(&mut bufs.logup_temp_sums)\n340\t    } else {\n341\t        None\n342\t    };\n343\t\n344\t    let sum = evaluate_round0_interactions_gpu(\n345\t        single_pk,\n346\t        &single_air_constraints,\n347\t        w.selectors_cube.buffer(),\n348\t        &d_main_parts,\n349\t        w.public_values,\n350\t        eq_xi_tree.get_ptr(n_lift),\n351\t        w.beta_pows,\n352\t        w.eq_3bs,\n353\t        1 << w.l_skip,\n354\t        1 << n_lift,\n355\t        height as u32,\n356\t        num_cosets_logup as u32,\n357\t        omega_root,\n358\t        w.max_temp_bytes,\n359\t        logup_prealloc_inter,\n360\t        logup_prealloc_temp,\n361\t    )?;\n362\t\n363\t    if !sum.is_empty() {\n364\t        let tables = &extract_tables[&local_constraint_deg];\n365\t        let norm_factor: EF = if w.n.is_negative() {\n366\t            EF::from(F::from_u32(1 << w.n.unsigned_abs()).inverse())\n367\t        } else {\n368\t            EF::ONE\n369\t        };\n370\t        let err = unsafe {\n371\t            _round0_extract_logup_polys(\n372\t                d_batch_ptr.add(w.numer_batch_offset),\n373\t                d_batch_ptr.add(w.denom_batch_offset),\n374\t                sum.as_ptr(),\n375\t                tables.logup_transform.as_ptr(),\n376\t                tables.logup_size,\n377\t                tables.logup_size,\n378\t                norm_factor,\n379\t            )\n380\t        };\n381\t        if err != 0 {\n382\t            return Err(Round0EvalError::Cuda(CudaError::new(err)).into());\n383\t        }\n384\t    }\n385\t\n386\t    Ok(())\n387\t}\n388\t\n389\t#[allow(clippy::type_complexity)]\n390\t#[instrument(level = \"info\", skip_all)]\n391\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n392\t    transcript: &mut TS,\n393\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n394\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n395\t    save_memory: bool,\n396\t    monomial_num_y_threshold: u32,\n397\t    sm_count: u32,\n398\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n399\twhere\n400\t    HS: GpuHashScheme,\n401\t    TS: GpuFiatShamirTranscript<HS::SC>,\n402\t{\n403\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n404\t    let l_skip = mpk.params.l_skip;\n405\t    let constraint_degree = mpk.max_constraint_degree;\n406\t    let num_traces = ctx.per_trace.len();\n407\t\n408\t    // Traces are sorted\n409\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n410\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n411\t    // heights\n412\t    let mut total_interactions = 0u64;\n413\t    let interactions_meta: Vec<_> = ctx\n414\t        .per_trace\n415\t        .iter()\n416\t        .map(|(air_idx, air_ctx)| {\n417\t            let pk = &mpk.per_air[*air_idx];\n418\t\n419\t            let num_interactions = pk.vk.symbolic_constraints.interactions.len();\n420\t            let height = air_ctx.common_main.height();\n421\t            let log_height = log2_strict_usize(height);\n422\t            let log_lifted_height = log_height.max(l_skip);\n423\t            total_interactions += (num_interactions as u64) << log_lifted_height;\n424\t            (num_interactions, log_lifted_height)\n425\t        })\n426\t        .collect();\n427\t    // Implicitly, the width of this stacking should be 1\n428\t    let n_logup = calculate_n_logup(l_skip, total_interactions);\n429\t    // There's no stride threshold for `interactions_layout` because there's no univariate skip for\n430\t    // GKR\n431\t    let interactions_layout = StackedLayout::new(0, l_skip + n_logup, interactions_meta).unwrap();\n432\t\n433\t    // Grind to increase soundness of random sampling for LogUp\n434\t    let logup_pow_witness = transcript\n435\t        .grind_gpu(mpk.params.logup.pow_bits)\n436\t        .map_err(LogupZerocheckError::Grind)?;\n437\t    let alpha_logup = transcript.sample_ext();\n438\t    let beta_logup = transcript.sample_ext();\n439\t    debug!(%alpha_logup, %beta_logup);\n440\t\n441\t    let has_interactions = !interactions_layout.sorted_cols.is_empty();"}]},"parent_tool_use_id":"toolu_01F8yjQCrAPMh3D8xeAEeUrv","session_id":"ff03fa2a-06a9-4cae-9336-eb9eb1af38e2","uuid":"17098a52-324a-4ad1-8a35-8cf881c23e41","timestamp":"2026-04-14T05:29:37.580Z"}
