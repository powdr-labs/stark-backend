Buffer<Frac<EF>>,\n565\t    num_x: usize,\n566\t    lambda: EF,\n567\t    out_device: &mut DeviceBuffer<EF>,\n568\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n569\t) -> Result<(), CudaError> {\n570\t    let low_n = eq_xi.low_n();\n571\t    let high_n = eq_xi.high_n();\n572\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n573\t    debug_assert!(pq_buffer.len() >= 2 * num_x);\n574\t    #[cfg(debug_assertions)]\n575\t    {\n576\t        let len = tmp_block_sums.len();\n577\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n578\t        assert!(\n579\t            len >= required as usize,\n580\t            \"tmp_block_sums len={len} < required={required}\"\n581\t        );\n582\t    }\n583\t    CudaError::from_result(_frac_compute_round(\n584\t        eq_xi.low.get_ptr(low_n),\n585\t        eq_xi.high.get_ptr(high_n),\n586\t        pq_buffer.as_ptr(),\n587\t        num_x,\n588\t        1 << low_n,\n589\t        lambda,\n590\t        out_device.as_mut_ptr(),\n591\t        tmp_block_sums.as_mut_ptr(),\n592\t    ))\n593\t}\n594\t\n595\t/// Fused compute round + tree layer revert kernel.\n596\t///\n597\t/// Combines `frac_build_tree_layer(revert=true)` with `compute_round` for the first inner round.\n598\t/// The revert operation modifies `layer` in-place: `layer[i] = layer[i] - layer[i + half]` for `i <\n599\t/// half`.\n600\t///\n601\t/// This eliminates one kernel launch per outer round.\n602\t#[allow(clippy::too_many_arguments)]\n603\tpub unsafe fn frac_compute_round_and_revert(\n604\t    eq_xi: &SqrtEqLayers,\n605\t    layer: &mut DeviceBuffer<Frac<EF>>,\n606\t    num_x: usize,\n607\t    lambda: EF,\n608\t    out_device: &mut DeviceBuffer<EF>,\n609\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n610\t) -> Result<(), CudaError> {\n611\t    let low_n = eq_xi.low_n();\n612\t    let high_n = eq_xi.high_n();\n613\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n614\t    #[cfg(debug_assertions)]\n615\t    {\n616\t        let len = tmp_block_sums.len();\n617\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n618\t        assert!(\n619\t            len >= required as usize,\n620\t            \"tmp_block_sums len={len} < required={required}\"\n621\t        );\n622\t        assert!(layer.len() >= 2 * num_x, \"layer too small for pq_size\");\n623\t    }\n624\t    CudaError::from_result(_frac_compute_round_and_revert(\n625\t        eq_xi.low.get_ptr(low_n),\n626\t        eq_xi.high.get_ptr(high_n),\n627\t        layer.as_mut_ptr(),\n628\t        num_x,\n629\t        1 << low_n,\n630\t        lambda,\n631\t        out_device.as_mut_ptr(),\n632\t        tmp_block_sums.as_mut_ptr(),\n633\t    ))\n634\t}\n635\t\n636\t/// Folds `Frac<EF>` buffer. Pairs (idx, idx+quarter) and (idx+half, idx+3*quarter),\n637\t/// writes results to dst[idx] and dst[idx+quarter]. Output size is `size / 2`.\n638\t/// Safe for src == dst (in-place) because each thread handles disjoint indices.\n639\tpub unsafe fn fold_ef_frac_columns(\n640\t    src: &DeviceBuffer<Frac<EF>>,\n641\t    dst: &mut DeviceBuffer<Frac<EF>>,\n642\t    size: usize,\n643\t    r: EF,\n644\t) -> Result<(), CudaError> {\n645\t    debug_assert!(src.len() >= size);\n646\t    debug_assert!(dst.len() >= size / 2);\n647\t    CudaError::from_result(_frac_fold_fpext_columns(\n648\t        src.as_ptr(),\n649\t        dst.as_mut_ptr(),\n650\t        size,\n651\t        r,\n652\t    ))\n653\t}\n654\t\n655\t/// In-place fold. See [`fold_ef_frac_columns`] for details.\n656\tpub unsafe fn fold_ef_frac_columns_inplace(\n657\t    buffer: &mut DeviceBuffer<Frac<EF>>,\n658\t    size: usize,\n659\t    r: EF,\n660\t) -> Result<(), CudaError> {\n661\t    debug_assert!(buffer.len() >= size);\n662\t    let ptr = buffer.as_mut_ptr();\n663\t    CudaError::from_result(_frac_fold_fpext_columns(ptr, ptr, size, r))\n664\t}\n665\t\n666\t/// Fused compute round + fold kernel.\n667\t///\n668\t/// Reads from pre-fold `src_pq_buffer` (size `src_pq