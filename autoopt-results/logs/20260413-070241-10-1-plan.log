{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KwhU4Y82tXCopq7Kp3qWA5","type":"tool_result","content":"1\t//! ## Async frees and peak memory\n2\t//!\n3\t//! Many logup/zerocheck GPU helpers allocate temporary device buffers and launch kernels. Those\n4\t//! buffers are freed via cudaFreeAsync through the VPMM pool, so frees are only stream-ordered. If\n5\t//! new allocations happen before the current stream is synchronized, physical peak memory can\n6\t//! temporarily include both the old and new buffers even though MemTracker only sees the logical\n7\t//! max. Callers that care about physical peak should ensure a current-stream sync after use (e.g.\n8\t//! by calling `to_host()` on outputs or `current_stream_sync()`).\n9\t\n10\tuse std::{\n11\t    cmp::max,\n12\t    collections::hash_map::Entry,\n13\t    iter::{self, zip},\n14\t    sync::Arc,\n15\t};\n16\t\n17\tuse itertools::{izip, Itertools};\n18\tuse openvm_cuda_common::{\n19\t    copy::{MemCopyD2H, MemCopyD2HStreamSync, MemCopyH2D},\n20\t    d_buffer::DeviceBuffer,\n21\t    error::MemCopyError,\n22\t    memory_manager::MemTracker,\n23\t    stream::current_stream_sync,\n24\t};\n25\tuse openvm_stark_backend::{\n26\t    air_builders::symbolic::SymbolicConstraints,\n27\t    calculate_n_logup,\n28\t    dft::Radix2BowersSerial,\n29\t    p3_matrix::dense::RowMajorMatrix,\n30\t    poly_common::{\n31\t        eq_uni_poly, eval_eq_mle, eval_eq_sharp_uni, eval_eq_uni, eval_eq_uni_at_one,\n32\t        UnivariatePoly,\n33\t    },\n34\t    proof::{column_openings_by_rot, BatchConstraintProof, GkrProof},\n35\t    prover::{\n36\t        fractional_sumcheck_gkr::Frac, poly::eq_sharp_uni_poly, stacked_pcs::StackedLayout,\n37\t        sumcheck::sumcheck_round0_deg, ColMajorMatrix, CommittedTraceData,\n38\t        DeviceMultiStarkProvingKey, DeviceStarkProvingKey, MatrixDimensions, ProvingContext,\n39\t    },\n40\t};\n41\tuse p3_dft::TwoAdicSubgroupDft;\n42\tuse p3_field::{Field, PrimeCharacteristicRing, TwoAdicField};\n43\tuse p3_util::{log2_ceil_usize, log2_strict_usize};\n44\tuse rustc_hash::FxHashMap;\n45\tuse tracing::{debug, info, info_span, instrument};\n46\t\n47\tuse crate::{\n48\t    base::DeviceMatrix,\n49\t    cuda::{\n50\t        logup_zerocheck::{fold_selectors_round0, interpolate_columns_gpu, MainMatrixPtrs},\n51\t        sumcheck::batch_fold_mle,\n52\t    },\n53\t    data_transporter::transport_matrix_d2h_col_major,\n54\t    error::LogupZerocheckError,\n55\t    gpu_backend::GenericGpuBackend,\n56\t    hash_scheme::GpuHashScheme,\n57\t    logup_zerocheck::{\n58\t        batch_mle::evaluate_zerocheck_batched, fold_ple::fold_ple_evals_rotate,\n59\t        gkr_input::TraceInteractionMeta, round0::evaluate_round0_interactions_gpu,\n60\t    },\n61\t    poly::EqEvalLayers,\n62\t    prelude::{EF, F},\n63\t    sponge::GpuFiatShamirTranscript,\n64\t    utils::compute_barycentric_inv_lagrange_denoms,\n65\t};\n66\t\n67\tpub(crate) mod batch_mle;\n68\tpub(crate) mod batch_mle_monomial;\n69\tmod errors;\n70\tpub(crate) mod fold_ple;\n71\t/// Fraction sumcheck via GKR\n72\tmod fractional;\n73\t/// Logup interaction evaluations for GKR input\n74\tmod gkr_input;\n75\tmod mle_round;\n76\tmod round0;\n77\tpub(crate) mod rules;\n78\t\n79\tuse batch_mle::{evaluate_logup_batched, TraceCtx};\n80\tuse batch_mle_monomial::{\n81\t    compute_lambda_combinations, compute_logup_combinations, get_num_monomials,\n82\t    get_zerocheck_rules_len, trace_has_monomials, LogupCombinations, LogupMonomialBatch,\n83\t    ZerocheckMonomialBatch, ZerocheckMonomialParYBatch,\n84\t};\n85\tpub use errors::*;\n86\tpub use fractional::{fractional_sumcheck_gpu, make_synthetic_leaves};\n87\tuse gkr_input::{collect_trace_interactions, log_gkr_input_evals};\n88\tuse round0::evaluate_round0_constraints_gpu;\n89\t\n90\t/// Number of OS threads (and thus CUDA streams) for parallel Round 0 processing.\n91\t/// More threads = more concurrent kernels but more peak GPU memory and more\n92\t/// MemoryManager mutex contention. 8 provides good SM utilization on the RTX 4090.\n93\tconst NUM_ROUND0_STREAMS: usize = 8;\n94\t\n95\t/// When `num_monomials >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len`, use DAG evaluation\n96\t/// instead of the monomial kernel for high num_y traces.\n97\t/// This ratio can be tuned. Currently it is set to prefer the monomial kernel except for the\n98\t/// Poseidon2Air where the DAG node size is much smaller than number of monomials.\n99\tconst DAG_FALLBACK_MONOMIAL_RATIO: usize = 2;\n100\t\n101\t#[inline]\n102\tpub(crate) fn air_width_for_mat(need_rot: bool, mat_width: usize) -> u32 {\n103\t    if need_rot {\n104\t        debug_assert_eq!(mat_width % 2, 0, \"rotated matrices should have even width\");\n105\t        (mat_width / 2) as u32\n106\t    } else {\n107\t        mat_width as u32\n108\t    }\n109\t}\n110\t\n111\t/// Result of processing one AIR in Round 0.\n112\tstruct Round0AirResult {\n113\t    trace_idx: usize,\n114\t    zerocheck_poly: Option<UnivariatePoly<EF>>,\n115\t    logup_numer_poly: Option<UnivariatePoly<EF>>,\n116\t    logup_denom_poly: Option<UnivariatePoly<EF>>,\n117\t}\n118\t\n119\t/// All read-only references needed to process one AIR in Round 0.\n120\tstruct Round0AirWorkItem<'a, HS: GpuHashScheme> {\n121\t    trace_idx: usize,\n122\t    single_pk: &'a DeviceStarkProvingKey<GenericGpuBackend<HS>>,\n123\t    n: isize,\n124\t    selectors_cube: &'a DeviceMatrix<F>,\n125\t    public_values: &'a DeviceBuffer<F>,\n126\t    eq_3bs: &'a [EF],\n127\t    cached_mains: &'a [CommittedTraceData<GenericGpuBackend<HS>>],\n128\t    common_main: &'a DeviceMatrix<F>,\n129\t    eq_xis: &'a FxHashMap<usize, EqEvalLayers<EF>>,\n130\t    d_lambda_pows: &'a DeviceBuffer<EF>,\n131\t    beta_pows: &'a [EF],\n132\t    l_skip: usize,\n133\t    constraint_degree: usize,\n134\t    xi: &'a [EF],\n135\t    max_temp_bytes: usize,\n136\t}\n137\t\n138\tfn process_air_round0<HS: GpuHashScheme>(\n139\t    w: &Round0AirWorkItem<HS>,\n140\t) -> Result<Round0AirResult, LogupZerocheckError> {\n141\t    let single_pk = w.single_pk;\n142\t    let single_air_constraints = SymbolicConstraints::from(&single_pk.vk.symbolic_constraints);\n143\t    let local_constraint_deg = single_pk.vk.max_constraint_degree as usize;\n144\t    assert!(\n145\t        local_constraint_deg <= w.constraint_degree,\n146\t        \"Max constraint degree ({local_constraint_deg}) of AIR exceeds the global maximum {}\",\n147\t        w.constraint_degree\n148\t    );\n149\t\n150\t    let log_large_domain = log2_ceil_usize(local_constraint_deg << w.l_skip);\n151\t    let omega_root = F::two_adic_generator(log_large_domain);\n152\t    assert!(!w.xi.is_empty(), \"xi vector must not be empty\");\n153\t\n154\t    let height = w.common_main.height();\n155\t    let mut main_parts = Vec::with_capacity(w.cached_mains.len() + 1);\n156\t    for committed in w.cached_mains {\n157\t        main_parts.push(committed.trace.buffer().as_ptr());\n158\t    }\n159\t    main_parts.push(w.common_main.buffer().as_ptr());\n160\t    let d_main_parts = main_parts.to_device()?;\n161\t\n162\t    let n_lift = w.n.max(0) as usize;\n163\t    let eq_xi_tree = &w.eq_xis[&n_lift];\n164\t    let num_cosets_zc = local_constraint_deg.saturating_sub(1);\n165\t\n166\t    let sum_buffer = evaluate_round0_constraints_gpu(\n167\t        single_pk,\n168\t        w.selectors_cube.buffer(),\n169\t        &d_main_parts,\n170\t        w.public_values,\n171\t        eq_xi_tree.get_ptr(n_lift),\n172\t        w.d_lambda_pows,\n173\t        1 << w.l_skip,\n174\t        1 << n_lift,\n175\t        height as u32,\n176\t        num_cosets_zc as u32,\n177\t        omega_root,\n178\t        w.max_temp_bytes,\n179\t    )?;\n180\t\n181\t    let zerocheck_poly = if !sum_buffer.is_empty() {\n182\t        let q_evals = sum_buffer.to_host_on_current_stream()?;\n183\t        let q = {\n184\t            let mut values = EF::zero_vec(num_cosets_zc << w.l_skip);\n185\t            for coset_idx in 0..num_cosets_zc {\n186\t                for i in 0..1 << w.l_skip {\n187\t                    values[i * num_cosets_zc + coset_idx] = q_evals[(coset_idx << w.l_skip) + i];\n188\t                }\n189\t            }\n190\t            UnivariatePoly::from_geometric_cosets_evals_idft(\n191\t                RowMajorMatrix::new(values, num_cosets_zc),\n192\t                omega_root,\n193\t                omega_root,\n194\t            )\n195\t        };\n196\t        let sp_0_deg = sumcheck_round0_deg(w.l_skip, local_constraint_deg);\n197\t        let coeffs = (0..=sp_0_deg)\n198\t            .map(|i| {\n199\t                let mut c = -*q.coeffs().get(i).unwrap_or(&EF::ZERO);\n200\t                if i >= 1 << w.l_skip {\n201\t                    c += q.coeffs()[i - (1 << w.l_skip)];\n202\t                }\n203\t                c\n204\t            })\n205\t            .collect_vec();\n206\t        Some(UnivariatePoly::new(coeffs))\n207\t    } else {\n208\t        None\n209\t    };\n210\t\n211\t    let num_cosets_logup = local_constraint_deg;\n212\t    let sum = evaluate_round0_interactions_gpu(\n213\t        single_pk,\n214\t        &single_air_constraints,\n215\t        w.selectors_cube.buffer(),\n216\t        &d_main_parts,\n217\t        w.public_values,\n218\t        eq_xi_tree.get_ptr(n_lift),\n219\t        w.beta_pows,\n220\t        w.eq_3bs,\n221\t        1 << w.l_skip,\n222\t        1 << n_lift,\n223\t        height as u32,\n224\t        num_cosets_logup as u32,\n225\t        omega_root,\n226\t        w.max_temp_bytes,\n227\t    )?;\n228\t\n229\t    let (logup_numer_poly, logup_denom_poly) = if !sum.is_empty() {\n230\t        let evals = sum.to_host_on_current_stream()?;\n231\t        let (mut numer, denom): (Vec<EF>, Vec<EF>) =\n232\t            evals.into_iter().map(|frac| (frac.p, frac.q)).unzip();\n233\t        if w.n.is_negative() {\n234\t            let norm_factor = F::from_u32(1 << w.n.unsigned_abs()).inverse();\n235\t            for s in &mut numer {\n236\t                *s *= norm_factor;\n237\t            }\n238\t        }\n239\t        let mut numer_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n240\t        let mut denom_values = EF::zero_vec(num_cosets_logup << w.l_skip);\n241\t        for coset_idx in 0..num_cosets_logup {\n242\t            for i in 0..1 << w.l_skip {\n243\t                let src = (coset_idx << w.l_skip) + i;\n244\t                let dst = i * num_cosets_logup + coset_idx;\n245\t                numer_values[dst] = numer[src];\n246\t                denom_values[dst] = denom[src];\n247\t            }\n248\t        }\n249\t        let numer_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n250\t            RowMajorMatrix::new(numer_values, num_cosets_logup),\n251\t            omega_root,\n252\t            F::ONE,\n253\t        );\n254\t        let denom_poly = UnivariatePoly::from_geometric_cosets_evals_idft(\n255\t            RowMajorMatrix::new(denom_values, num_cosets_logup),\n256\t            omega_root,\n257\t            F::ONE,\n258\t        );\n259\t        (Some(numer_poly), Some(denom_poly))\n260\t    } else {\n261\t        (None, None)\n262\t    };\n263\t\n264\t    Ok(Round0AirResult {\n265\t        trace_idx: w.trace_idx,\n266\t        zerocheck_poly,\n267\t        logup_numer_poly,\n268\t        logup_denom_poly,\n269\t    })\n270\t}\n271\t\n272\t#[allow(clippy::type_complexity)]\n273\t#[instrument(level = \"info\", skip_all)]\n274\tpub fn prove_zerocheck_and_logup_gpu<HS, TS>(\n275\t    transcript: &mut TS,\n276\t    mpk: &DeviceMultiStarkProvingKey<GenericGpuBackend<HS>>,\n277\t    ctx: &ProvingContext<GenericGpuBackend<HS>>,\n278\t    save_memory: bool,\n279\t    monomial_num_y_threshold: u32,\n280\t    sm_count: u32,\n281\t) -> Result<(GkrProof<HS::SC>, BatchConstraintProof<HS::SC>, Vec<EF>), LogupZerocheckError>\n282\twhere\n283\t    HS: GpuHashScheme,\n284\t    TS: GpuFiatShamirTranscript<HS::SC>,\n285\t{\n286\t    let logup_gkr_span = info_span!(\"prover.rap_constraints.logup_gkr\", phase = \"prover\").entered();\n287\t    let l_skip = mpk.params.l_skip;\n288\t    let constraint_degree = mpk.max_constraint_degree;\n289\t    let num_traces = ctx.per_trace.len();\n290\t\n291\t    // Traces are sorted\n292\t    let n_max = log2_strict_usize(ctx.per_trace[0].1.common_main.height()).saturating_sub(l_skip);\n293\t    // Gather interactions metadata, including interactions stacked layout which depends on trace\n294\t    // heights\n295\t    let mut total_interactions = 0u64;\n296\t    let interactions_meta: Vec<_> = ctx\n297\t        .per_trace\n298\t        .iter()\n299\t        .map(|(air_idx, air_ctx)| {\n300\t            let pk = &mpk.per_air[*air_idx];"}]},"parent_tool_use_id":"toolu_01JTVGwtF77pZsD2nHDbTJA7","session_id":"e16bd043-1446-4590-8b8f-e55946754639","uuid":"d075399d-f795-42c4-a3f5-bb4eacc826fe","timestamp":"2026-04-13T05:08:15.250Z"}
