and might even be\n187\t            // used as `count` in one, but message field in another. We only care about their\n188\t            // weighted sum with eq_3b, so we compute the weights ahead of time.\n189\t            let count_dag_idx =\n190\t                dag_builder.expr_to_idx[&(&interaction.count as *const SymbolicExpression<_>)];\n191\t            let count_rule_idx = rules.dag_idx_to_rule_idx[&count_dag_idx];\n192\t            numer_weights[count_rule_idx] += eq_3bs[interaction_idx];\n193\t            denom_sum_init += eq_3bs[interaction_idx]\n194\t                * beta_pows[interaction.message.len()]\n195\t                * F::from_u32(interaction.bus_index as u32 + 1);\n196\t\n197\t            for (message_idx, message) in interaction.message.iter().enumerate() {\n198\t                let message_dag_idx =\n199\t                    dag_builder.expr_to_idx[&(message as *const SymbolicExpression<_>)];\n200\t                let message_rule_idx = rules.dag_idx_to_rule_idx[&message_dag_idx];\n201\t                denom_weights[message_rule_idx] += eq_3bs[interaction_idx] * beta_pows[message_idx];\n202\t            }\n203\t        }\n204\t        let d_numer_weights = numer_weights.to_device()?;\n205\t        let d_denom_weights = denom_weights.to_device()?;\n206\t        (rules, d_numer_weights, d_denom_weights, denom_sum_init)\n207\t    };\n208\t\n209\t    let encoded_rules = rules.rules.iter().map(|c| c.encode()).collect_vec();\n210\t    let d_rules = encoded_rules.to_device()?;\n211\t\n212\t    let buffer_size: u32 = rules.buffer_size.try_into().unwrap();\n213\t    let intermed_capacity = unsafe {\n214\t        _logup_r0_intermediates_buffer_size(\n215\t            buffer_size,\n216\t            skip_domain,\n217\t            num_x,\n218\t            num_cosets,\n219\t            max_temp_bytes,\n220\t        )\n221\t    };\n222\t    let mut intermediates = if intermed_capacity > 0 {\n223\t        debug!(\"logup_r0:intermediates_capacity={intermed_ca