{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011EascbDnCfMrW7fiDQB2GD","type":"tool_result","content":"1\textern crate alloc;\n2\t\n3\tuse alloc::vec::Vec;\n4\tuse std::{cmp::Ordering, collections::BinaryHeap};\n5\t\n6\tuse getset::Getters;\n7\tuse itertools::Itertools;\n8\tuse openvm_stark_backend::air_builders::symbolic::{\n9\t    symbolic_variable::SymbolicVariable, SymbolicExpressionDag, SymbolicExpressionNode,\n10\t};\n11\tuse p3_field::{Field, PrimeField32};\n12\tuse rustc_hash::FxHashMap;\n13\t\n14\tpub mod codec;\n15\t\n16\t#[derive(Clone, Debug, Eq, PartialEq)]\n17\tpub enum Source<F> {\n18\t    Intermediate(usize),\n19\t    TerminalIntermediate,\n20\t    Var(SymbolicVariable<F>),\n21\t    IsFirst,\n22\t    IsLast,\n23\t    IsTransition,\n24\t    Constant(F),\n25\t}\n26\t\n27\t/// Rule representing a single operation for the GPU kernel to interpret.\n28\t#[derive(Clone, Debug, PartialEq)]\n29\tpub enum Rule<F> {\n30\t    // three-address code\n31\t    // (x, y, z) => z = x op y\n32\t    Add(Source<F>, Source<F>, Source<F>),\n33\t    Sub(Source<F>, Source<F>, Source<F>),\n34\t    Mul(Source<F>, Source<F>, Source<F>),\n35\t    // (x, z) => z = -x\n36\t    Neg(Source<F>, Source<F>),\n37\t    Variable(Source<F>),\n38\t    // (x, z) => z = x\n39\t    BufferVar(Source<F>, Source<F>),\n40\t}\n41\t\n42\t#[derive(derive_new::new, Clone, Debug, PartialEq)]\n43\tpub struct RuleWithFlag<F> {\n44\t    /// Raw rule\n45\t    pub inner: Rule<F>,\n46\t    /// Flag for whether the rule represents a constraint node that should be included in the\n47\t    /// accumulator.\n48\t    pub need_accumulate: bool,\n49\t}\n50\t\n51\t#[derive(Debug, Copy, Clone)]\n52\tstruct StaticExpressionInfo {\n53\t    // smallest dag_idx of a descendant\n54\t    pub first_descendant: usize,\n55\t    pub accumulate: bool,\n56\t    pub intermediate: bool,\n57\t    pub buffer_var: bool,\n58\t}\n59\t\n60\t#[derive(Debug, Copy, Clone)]\n61\tstruct LiveExpressionInfo {\n62\t    pub use_count: usize,\n63\t    /// Last dag_idx (inclusive) that uses this expr\n64\t    pub last_use: usize,\n65\t    /// Index within intermediate buffer to store, usize::MAX if not stored\n66\t    pub buffer_idx: usize,\n67\t}\n68\t\n69\timpl LiveExpressionInfo {\n70\t    pub fn update(&mut self, dag_idx: usize) {\n71\t        self.last_use = self.last_use.max(dag_idx);\n72\t        self.use_count += 1;\n73\t    }\n74\t}\n75\t\n76\t#[derive(Debug, Copy, Clone, PartialEq, Eq)]\n77\tstruct BufferEntry {\n78\t    buffer_idx: usize,\n79\t    last_use: usize,\n80\t}\n81\t\n82\timpl Ord for BufferEntry {\n83\t    fn cmp(&self, other: &Self) -> Ordering {\n84\t        other\n85\t            .last_use\n86\t            .cmp(&self.last_use)\n87\t            .then_with(|| other.buffer_idx.cmp(&self.buffer_idx))\n88\t    }\n89\t}\n90\t\n91\timpl PartialOrd for BufferEntry {\n92\t    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n93\t        Some(self.cmp(other))\n94\t    }\n95\t}\n96\t\n97\t#[derive(Debug, Clone)]\n98\tpub struct SymbolicRulesGpu<F> {\n99\t    /// Vector consisting of rules to be sequentially evaluated in a single GPU thread.\n100\t    pub rules: Vec<RuleWithFlag<F>>,\n101\t    /// Number of `F` elements in the intermediate buffer required for rule evaluation.\n102\t    pub buffer_size: usize,\n103\t    /// Map from dag_idx to rule_idx for accumulated nodes. Unlike `used_nodes`, this has no\n104\t    /// duplicates.\n105\t    pub dag_idx_to_rule_idx: FxHashMap<usize, usize>,\n106\t}\n107\t\n108\t/// Stateful rule builder that schedules buffer allocation and reuse using a priority queue.\n109\t///\n110\t/// At any given time, the builder will determine the buffer scheduling for a contiguous range of\n111\t/// nodes in a global DAG, where the DAG is already topologically sorted.\n112\t#[derive(Getters)]\n113\tpub struct SymbolicRulesBuilder<'a, F> {\n114\t    /// Global dag that all symbolic expressions will be referenced with respect to.\n115\t    dag_nodes: &'a [SymbolicExpressionNode<F>],\n116\t\n117\t    // Contains every node in the DAG.\n118\t    // dag_idx => StaticExpressionInfo\n119\t    static_expr_info: Vec<StaticExpressionInfo>,\n120\t\n121\t    // Stateful info about node with respect to buffer usage. Changes if nodes are added or removed\n122\t    // from what the intermediate buffer needs to account for. dag_idx => LiveExpressionInfo\n123\t    live_expr_info: FxHashMap<usize, LiveExpressionInfo>,\n124\t    buffer: BinaryHeap<BufferEntry>,\n125\t\n126\t    // Effective range after set_range (inclusive start, exclusive end)\n127\t    effective_start: usize,\n128\t    effective_end: usize,\n129\t}\n130\t\n131\timpl<'a, F: Field> SymbolicRulesBuilder<'a, F> {\n132\t    /// The `dag.constraint_idx` must be topologically sorted.\n133\t    pub fn new(dag: &'a SymbolicExpressionDag<F>, buffer_vars: bool) -> Self {\n134\t        debug_assert!(dag.constraint_idx.iter().is_sorted());\n135\t        let mut expr_info = vec![\n136\t            StaticExpressionInfo {\n137\t                first_descendant: usize::MAX,\n138\t                accumulate: false,\n139\t                intermediate: false,\n140\t                buffer_var: false,\n141\t            };\n142\t            dag.nodes.len()\n143\t        ];\n144\t        for &idx in &dag.constraint_idx {\n145\t            expr_info[idx].accumulate = true;\n146\t        }\n147\t\n148\t        for (i, node) in dag.nodes.iter().enumerate() {\n149\t            expr_info[i].first_descendant = expr_info[i].first_descendant.min(i);\n150\t            match node {\n151\t                SymbolicExpressionNode::Add {\n152\t                    left_idx,\n153\t                    right_idx,\n154\t                    ..\n155\t                }\n156\t                | SymbolicExpressionNode::Sub {\n157\t                    left_idx,\n158\t                    right_idx,\n159\t                    ..\n160\t                }\n161\t                | SymbolicExpressionNode::Mul {\n162\t                    left_idx,\n163\t                    right_idx,\n164\t                    ..\n165\t                } => {\n166\t                    expr_info[i].intermediate = true;\n167\t                    expr_info[i].first_descendant = expr_info[i]\n168\t                        .first_descendant\n169\t                        .min(expr_info[*left_idx].first_descendant)\n170\t                        .min(expr_info[*right_idx].first_descendant);\n171\t                }\n172\t                SymbolicExpressionNode::Neg { idx, .. } => {\n173\t                    expr_info[i].intermediate = true;\n174\t                    expr_info[i].first_descendant = expr_info[i]\n175\t                        .first_descendant\n176\t                        .min(expr_info[*idx].first_descendant);\n177\t                }\n178\t                SymbolicExpressionNode::Variable(_) => {\n179\t                    if buffer_vars {\n180\t                        expr_info[i].buffer_var = true;\n181\t                    }\n182\t                }\n183\t                _ => {}\n184\t            }\n185\t        }\n186\t        Self {\n187\t            dag_nodes: &dag.nodes,\n188\t            static_expr_info: expr_info,\n189\t            live_expr_info: FxHashMap::default(),\n190\t            buffer: BinaryHeap::new(),\n191\t            effective_start: 0,\n192\t            effective_end: 0,\n193\t        }\n194\t    }\n195\t\n196\t    /// Schedules buffer usage for nodes in `[start_dag_idx, end_dag_idx)` (non-inclusive end). Any\n197\t    /// previous range is cleared. Any nodes that are needed prior to the start of the range are\n198\t    /// also scheduled.\n199\t    pub fn set_range(&mut self, mut start_dag_idx: usize, end_dag_idx: usize) {\n200\t        debug_assert!(start_dag_idx < end_dag_idx);"}]},"parent_tool_use_id":"toolu_01UMVFWGFbmaaci5g5QBo8YB","session_id":"39e8685b-d752-4f1d-86a0-2956436bbd44","uuid":"76d41c8f-854a-4361-b8bd-5a84aad2eb55","timestamp":"2026-04-13T