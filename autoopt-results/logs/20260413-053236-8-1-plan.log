T:\n54\t        result = make_bool_ext(row_index == height - 1);\n55\t        break;\n56\t    case SRC_IS_TRANSITION:\n57\t        result = make_bool_ext(row_index != height - 1);\n58\t        break;\n59\t    default:\n60\t        assert(0);\n61\t    }\n62\t    return result;\n63\t}\n64\t\n65\ttemplate <bool GLOBAL>\n66\t__global__ void evaluate_interactions_gkr_kernel(\n67\t    FracExt *__restrict__ d_fracs,\n68\t    const Fp *__restrict__ d_preprocessed,\n69\t    const uint64_t *__restrict__ d_main,\n70\t    const Fp *__restrict__ d_public_values,\n71\t    const FpExt *__restrict__ d_challenges,\n72\t    const FpExt *__restrict__ d_intermediates,\n73\t    const Rule *__restrict__ d_rules,\n74\t    const size_t *__restrict__ d_used_nodes,\n75\t    const uint32_t *__restrict__ d_pair_idxs,\n76\t    const size_t used_nodes_len,\n77\t    const uint32_t permutation_height,\n78\t    const uint32_t num_rows_per_tile\n79\t) {\n80\t    uint32_t task_offset = blockIdx.x * blockDim.x + threadIdx.x;\n81\t    uint32_t task_stride = gridDim.x * blockDim.x;\n82\t\n83\t    FpExt *intermediates_ptr;\n84\t    uint32_t intermediate_stride;\n85\t    if constexpr (GLOBAL) {\n86\t        intermediates_ptr = (FpExt *)d_intermediates + task_offset;\n87\t        intermediate_stride = task_stride;\n88\t    } else {\n89\t        FpExt intermediates[10];\n90\t        intermediates_ptr = intermediates;\n91\t        intermediate_stride = 1;\n92\t    }\n93\t\n94\t    for (uint32_t j = 0; j < num_rows_per_tile; j++) {\n95\t        uint32_t row = task_offset + j * task_stride;\n96\t\n97\t        if (row < permutation_height) {\n98\t            uint32_t rules_evaluated = 0;\n99\t            // Iterate through used_nodes (alternates: numer, denom, numer, denom, ...)\n100\t            for (uint32_t used_idx = 0; used_idx < used_nodes_len; used_idx++) {\n101\t                uint32_t node_idx = d_used_nodes[used_idx];\n102\t                FpExt result(0);\n103\t                if (node_idx < rules_evaluated) {\n104\t                    Rule rule = d_rules[node_idx];\n105\t                    RuleHeader header = decode_rule_header(rule);\n106\t                    if (header.op == OP_VAR) {\n107\t                        result = evaluate_dag_entry_gkr(\n108\t                            header.x,\n109\t                            row,\n110\t                            d_preprocessed,\n111\t                            d_main,\n112\t                            d_public_values,\n113\t                            d_challenges,\n114\t                            intermediates_ptr,\n115\t                            intermediate_stride,\n116\t                            permutation_height\n117\t                        );\n118\t                    } else {\n119\t                        uint32_t z_index = decode_z_index(rule);\n120\t                        result = intermediates_ptr[z_index * intermediate_stride];\n121\t                    }\n122\t                } else {\n123\t                    for (; rules_evaluated <= node_idx; rules_evaluated++) {\n124\t                        Rule rule = d_rules[rules_evaluated];\n125\t                        RuleHeader header = decode_rule_header(rule);\n126\t\n127\t                        FpExt x = evaluate_dag_entry_gkr(\n128\t                            header.x,\n129\t                            row,\n130\t                            d_preprocessed,\n131\t                            d_main,\n132\t                            d_public_values,\n133\t                            d_challenges,\n134\t                            intermediates_ptr,\n135\t                            intermediate_stride,\n136\t                            permutation_height\n137\t                        );\n138\t                        FpExt y;\n139\t\n140\t                        switch (header.op) {\n141\t                        case OP_ADD:\n142\t                            y = evaluate_dag_entry_gkr(\n143\t                                decode_y(rule),