{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K21JH2Csw7E61rv9kUotp6","type":"tool_result","content":"1\tuse std::{ffi::c_void, fmt::Debug, ptr};\n2\t\n3\tuse crate::{\n4\t    copy::MemCopyD2H,\n5\t    error::{check, CudaError},\n6\t    memory_manager::{d_free, d_malloc},\n7\t    stream::{cudaStreamPerThread, cudaStream_t},\n8\t};\n9\t\n10\t#[link(name = \"cudart\")]\n11\textern \"C\" {\n12\t    pub fn cudaMemsetAsync(dst: *mut c_void, value: i32, count: usize, stream: cudaStream_t)\n13\t        -> i32;\n14\t}\n15\t\n16\t/// Struct that owns a buffer allocated on GPU device. The struct only holds the raw pointer and\n17\t/// length, but this struct has a `Drop` implementation which frees the associated device memory.\n18\t#[repr(C)]\n19\tpub struct DeviceBuffer<T> {\n20\t    ptr: *mut T,\n21\t    len: usize,\n22\t}\n23\t\n24\t/// A struct that packs a pointer with a size in bytes to pass on CUDA.\n25\t/// It holds `*const c_void` for being a universal simple type that can be read by CUDA.\n26\t/// Since it is hard to enforce immutability preservation, it just holds `*const`,\n27\t/// but has two separate constructors for more robustness from the usage perspective.\n28\t/// This is essentially a [DeviceBuffer] but without owning the data.\n29\t#[repr(C)]\n30\t#[derive(Debug, Copy, Clone)]\n31\tpub struct DeviceBufferView {\n32\t    pub ptr: *const c_void,\n33\t    pub size: usize,\n34\t}\n35\t\n36\tunsafe impl<T> Send for DeviceBuffer<T> {}\n37\tunsafe impl<T> Sync for DeviceBuffer<T> {}\n38\t\n39\timpl<T> DeviceBuffer<T> {\n40\t    /// Creates an \"empty\" DeviceBuffer with a null pointer and zero length.\n41\t    #[allow(clippy::new_without_default)]\n42\t    pub fn new() -> Self {\n43\t        DeviceBuffer {\n44\t            ptr: ptr::null_mut(),\n45\t            len: 0,\n46\t        }\n47\t    }\n48\t\n49\t    /// # Safety\n50\t    /// - The caller must ensure that the pointer `ptr` is valid for `len` elements of type `T` in\n51\t    ///   device memory.\n52\t    /// - Dropping the constructed buffer will attempt to free the memory. As such, `ptr` must\n53\t    ///   either have been allocated by the internal memory manager (VPMM) or the caller must use\n54\t    ///   `ManuallyDrop` to prevent double-free.\n55\t    pub unsafe fn from_raw_parts(ptr: *mut T, len: usize) -> Self {\n56\t        DeviceBuffer { ptr, len }\n57\t    }\n58\t\n59\t    /// Allocate device memory for `len` elements of type `T`.\n60\t    pub fn with_capacity(len: usize) -> Self {\n61\t        tracing::debug!(\n62\t            \"Creating device buffer of size {} (sizeof type = {})\",\n63\t            len,\n64\t            size_of::<T>()\n65\t        );\n66\t        assert_ne!(len, 0, \"Zero capacity request is wrong\");\n67\t        let size_bytes = std::mem::size_of::<T>() * len;\n68\t        let raw_ptr = d_malloc(size_bytes).expect(\"GPU allocation failed\");\n69\t        #[cfg(feature = \"touchemall\")]\n70\t        {\n71\t            // 0xffffffff is `Fp::invalid()` and shouldn't occur in a trace\n72\t            unsafe {\n73\t                cudaMemsetAsync(raw_ptr, 0xff, size_bytes, cudaStreamPerThread);\n74\t            }\n75\t        }\n76\t        let typed_ptr = raw_ptr as *mut T;\n77\t\n78\t        DeviceBuffer {\n79\t            ptr: typed_ptr,\n80\t            len,\n81\t        }\n82\t    }\n83\t\n84\t    /// Fills the buffer with zeros.\n85\t    pub fn fill_zero(&self) -> Result<(), CudaError> {\n86\t        assert_ne!(self.len, 0, \"Empty buffer\");\n87\t        let size_bytes = std::mem::size_of::<T>() * self.len;\n88\t        check(unsafe { cudaMemsetAsync(self.as_mut_raw_ptr(), 0, size_bytes, cudaStreamPerThread) })\n89\t    }\n90\t"}]},"parent_tool_use_id":null,"session_id":"39e8685b-d752-4f1d-86a0-2956436bbd44","uuid":"e77de3cf-35b4-4277-8d54-87cea8c220f5","timestamp":"2026-04-13T04:02:48.926Z","tool_use_result":{"type":"text","file":{"filePath":"/home/georg/stark-backend/crates/cuda-common/src/d_buffer.rs","content":"use std::{ffi::c_void, fmt::Debug, ptr};\n\nuse crate::{\n    copy::MemCopyD2H,\n    error::{check, CudaError},\n    memory_manager::{d_free, d_malloc},\n    stream::{cudaStreamPerThread, cudaStream_t},\n};\n\n#[link(name = \"cudart\")]\nextern \"C\" {\n    pub fn cudaMemsetAsync(dst: *mut c_void, value: i32, count: usize, stream: cudaStream_t)\n        -> i32;\n}\n\n/// Struct that owns a buffer allocated on GPU device. The struct only holds the raw pointer and\n/// length, but this struct has a `Drop` implementation which frees the associated device memory.\n#[repr(C)]\npub struct DeviceBuffer<T> {\n    ptr: *mut T,\n    len: usize,\n}\n\n/// A struct that packs a pointer with a size in bytes to pass on CUDA.\n/// It holds `*const c_void` for being a universal simple type that can be read by CUDA.\n/// Since it is hard to enforce immutability preservation, it just holds `*const`,\n/// but has two separate constructors for more robustness from the usage perspective.\n/// This is essentially a [DeviceBuffer] but without owning the data.\n#[repr(C)]\n#[derive(Debug, Copy, Clone)]\npub struct DeviceBufferView {\n    pub ptr: *const c_void,\n    pub size: usize,\n}\n\nunsafe impl<T> Send for DeviceBuffer<T> {}\nunsafe impl<T> Sync for DeviceBuffer<T> {}\n\nimpl<T> DeviceBuffer<T> {\n    /// Creates an \"empty\" DeviceBuffer with a null pointer and zero length.\n    #[allow(clippy::new_without_default)]\n    pub fn new() -> Self {\n        DeviceBuffer {\n            ptr: ptr::null_mut(),\n            len: 0,\n        }\n    }\n\n    /// # Safety\n    /// - The caller must ensure that the pointer `ptr` is valid for `len` elements of type `T` in\n    ///   device memory.\n    /// - Dropping the constructed buffer will attempt to free the memory. As such, `ptr` must\n    ///   either have been allocated by the internal memory manager (VPMM) or the caller must use\n    ///   `ManuallyDrop` to prevent double-free.\n    pub unsafe fn from_raw_parts(ptr: *mut T, len: usize) -> Self {\n        DeviceBuffer { ptr, len }\n    }\n\n    /// Allocate device memory for `len` elements of type `T`.\n    pub fn with_capacity(len: usize) -> Self {\n        tracing::debug!(\n            \"Creating device buffer of size {} (sizeof type = {})\",\n            len,\n            size_of::<T>()\n        );\n        assert_ne!(len, 0, \"Zero capacity request is wrong\");\n        let size_bytes = std::mem::size_of::<T>() * len;\n        let raw_ptr = d_malloc(size_bytes).expect(\"GPU allocation failed\");\n        #[cfg(feature = \"touchemall\")]\n        {\n            // 0xffffffff is `Fp::invalid()` and shouldn't occur in a trace\n            unsafe {\n                cudaMemsetAsync(raw_ptr, 0xff, size_bytes, cudaStreamPerThread);\n            }\n        }\n        let typed_ptr = raw_ptr as *mut T;\n\n        DeviceBuffer {\n            ptr: typed_ptr,\n            len,\n        }\n    }\n\n    /// Fills the buffer with zeros.\n    pub fn fill_zero(&self) -> Result<(), CudaError> {\n        assert_ne!(self.len, 0, \"Empty buffer\");\n        let size_bytes = std::mem::size_of::<T>() * self.len;\n        check(unsafe { cudaMemsetAsync(self.as_mut_raw_ptr(), 0, size_bytes, cudaStreamPerThread) })\n    }\n","numLines":90,"startLine":1,"totalLines":218}}}
