completed() {\n643\t                // default_stream_wait always uses current stream (= stream_id)\n644\t                default_stream_wait(&region.event)?;\n645\t            }\n646\t\n647\t            let take = remaining.min(region.size);\n648\t\n649\t            self.zombie_regions.push(ZombieRegion {\n650\t                ptr: addr,\n651\t                size: take,\n652\t                event: region.event.clone(),\n653\t            });\n654\t\n655\t            to_defrag.push((addr, take));\n656\t            remaining -= take;\n657\t\n658\t            if region.size > take {\n659\t                // Return the unused tail to the free list so it stays available.\n660\t                let leftover_addr = addr + take as u64;\n661\t                let leftover_size = region.size - take;\n662\t                let _ = self.free_region_insert(leftover_addr, leftover_size, region.stream_id);\n663\t            }\n664\t        }\n665\t        let remapped_ptr = self.remap_regions(to_defrag, allocated_dst, stream_id)?;\n666\t        // Take the minimum in case allocated_ptr is CUdeviceptr::MAX when allocate_size = 0\n667\t        let result = std::cmp::min(allocated_ptr, remapped_ptr);\n668\t        debug_assert!(allocate_size == 0 || allocated_ptr == remapped_ptr);\n669\t        debug_assert_ne!(\n670\t            result,\n671\t            CUdeviceptr::MAX,\n672\t            \"Both allocation and remapping returned no valid free region\"\n673\t        );\n674\t        Ok(Some(result))\n675\t    }\n676\t\n677\t    /// Remap a list of regions to a new base address via double-mapping.\n678\t    ///\n679\t    /// The regions are mapped consecutively starting at `dst`. The old regions remain mapped\n680\t    /// (double-mapped) and are added to `zombie_regions` by the caller for async unmap.\n681\t    ///\n682\t    /// Returns the starting pointer of the new remapped free region or `CUdeviceptr::MAX` if no\n683\t    /// remapping is needed.\n684\t    ///\n685\t    /// # Assumptions\n686\t    /// The regions are already removed from the free regions map.\n687\t    fn remap_regions(\n688\t        &mut self,\n689\t        regions: Vec<(CUdeviceptr, usize)>,\n690\t        dst: CUdeviceptr,\n691\t        stream_id: CudaStreamId,\n692\t    ) -> Result<CUdeviceptr, MemoryError> {\n693\t        if regions.is_empty() {\n694\t            // Nothing to remap; return sentinel so caller's min() picks the other operand\n695\t            return Ok(CUdeviceptr::MAX);\n696\t        }\n697\t\n698\t        let bytes_to_remap = regions.iter().map(|(_, size)| *size).sum::<usize>();\n699\t        tracing::debug!(\n700\t            \"VPMM: Remapping {} regions. Total size = {}\",\n701\t            regions.len(),\n702\t            ByteSize::b(bytes_to_remap as u64)\n703\t        );\n704\t\n705\t        let mut curr_dst = dst;\n706\t        for (region_addr, region_size) in regions {\n707\t            // Double-map: map pages to new VA (old VA remains mapped, will be cleaned up as zombie)\n708\t            let num_pages = region_size / self.page_size;\n709\t            for i in 0..num_pages {\n710\t                let page = region_addr + (i * self.page_size) as u64;\n711\t                let handle = self\n712\t                    .active_pages\n713\t                    .remove(&page)\n714\t                    .expect(\"BUG: active page not found during remapping\");\n715\t                unsafe {\n716\t                    vpmm_map(curr_dst, self.page_size, handle).map_err(|e| {\n717\t                        tracing::error!(\n718\t                            \"vpmm_map (remap) failed: dst={:#x}, page_size={}, handle={}: {:?}\",\n719\t                            curr_dst,\n720\t                            self.page_size,\n721\t                            handle,\n722\t                            e\n723\t                        );\n724\t                        MemoryError::from(e)\n725\t                    })?;\n726\t                }\n727\t                self.active_pages.insert(curr_dst, handle);\n728\t                curr_dst += self.page_size as u64;\n729\t            }\n730\t        }\n731\t\n732\t        debug_assert_eq!(curr_dst - dst, bytes_to_remap as u64);\n733\t\n734\t        // Set access permissions for the remapped region\n735\t        unsafe {\n736\t            vpmm_set_access(dst, bytes_to_remap, self.device_id).map_err(|e| {\n737\t                tracing::error!(\n738\t                    \"vpmm_set_access (remap) failed: addr={:#x}, size={}, device={}: {:?}\",\n739\t                    dst,\n740\t                    bytes_to_remap,\n741\t                    self.device_id,\n742\t                    e\n743\t                );\n744\t                MemoryError::from(e)\n745\t            })?;\n746\t        }\n747\t        let (remapped_ptr, _) = self.free_region_insert(dst, bytes_to_remap, stream_id);\n748\t        Ok(remapped_ptr)\n749\t    }\n750\t\n751\t    /// Returns the total physical memory currently mapped in this pool (in bytes).\n752\t    pub(super) fn memory_usage(&self) -> usize {\n753\t        self.active_pages.len() * self.page_size\n754\t    }\n755\t}\n756\t\n757\timpl Drop for VirtualMemoryPool {\n758\t    fn drop(&mut self) {\n759\t        current_stream_sync().unwrap();\n760\t\n761\t        // Unmap zombie regions first\n762\t        for zombie in self.zombie_regions.drain(..) {\n763\t            unsafe {\n764\t                vpmm_unmap(zombie.ptr, zombie.size).unwrap();\n765\t            }\n766\t        }\n767\t\n768\t        for (ptr, handle) in self.active_pages.drain() {\n769\t            unsafe {\n770\t                vpmm_unmap(ptr, self.page_size).unwrap();\n771\t                vpmm_release(handle).unwrap();\n772\t            }\n773\t        }\n774\t\n775\t        for root in self.roots.drain(..) {\n776\t            unsafe {\n777\t                vpmm_release_va(root, self.va_size).unwrap();\n778\t            }\n779\t        }\n780\t    }\n781\t}\n782\t\n783\timpl Default for Vi