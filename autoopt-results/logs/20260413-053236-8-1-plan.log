{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BRJRgZbyrHDPyLZcZU7gUW","type":"tool_result","content":"1\t//! Tests for memory_manager - focused on edge cases and dangerous scenarios\n2\t\n3\tuse super::vm_pool::{VirtualMemoryPool, VpmmConfig};\n4\tuse crate::{\n5\t    d_buffer::DeviceBuffer,\n6\t    stream::{current_stream_id, current_stream_sync},\n7\t};\n8\t\n9\t#[link(name = \"cudart\")]\n10\textern \"C\" {\n11\t    fn cudaMemGetInfo(free_bytes: *mut usize, total_bytes: *mut usize) -> i32;\n12\t}\n13\t\n14\tfn get_gpu_free_memory() -> usize {\n15\t    let mut free = 0usize;\n16\t    let mut total = 0usize;\n17\t    let err = unsafe { cudaMemGetInfo(&mut free, &mut total) };\n18\t    assert_eq!(err, 0, \"cudaMemGetInfo failed: {}\", err);\n19\t    free\n20\t}\n21\t\n22\t// ============================================================================\n23\t// Coalescing: free B first, then A, then C - should coalesce into one region\n24\t// ============================================================================\n25\t#[test]\n26\tfn test_coalescing_via_combined_alloc() {\n27\t    let len = 2 << 30; // 2 GB per allocation\n28\t    let buf_a = DeviceBuffer::<u8>::with_capacity(len);\n29\t    let buf_b = DeviceBuffer::<u8>::with_capacity(len);\n30\t    let buf_c = DeviceBuffer::<u8>::with_capacity(len);\n31\t\n32\t    let addr_a = buf_a.as_raw_ptr();\n33\t\n34\t    // Free in order: B, A, C - this tests both next and prev neighbor coalescing\n35\t    drop(buf_b);\n36\t    drop(buf_a);\n37\t    drop(buf_c);\n38\t\n39\t    // Request combined size - if coalescing worked, this should reuse from A's start\n40\t    let combined_len = 3 * len;\n41\t    let buf_combined = DeviceBuffer::<u8>::with_capacity(combined_len);\n42\t    assert_eq!(\n43\t        addr_a,\n44\t        buf_combined.as_raw_ptr(),\n45\t        \"Should reuse coalesced region starting at A\"\n46\t    );\n47\t}\n48\t\n49\t// ============================================================================\n50\t// VA exhaustion: use tiny VA size to force multiple VA reservations\n51\t// ============================================================================\n52\t#[test]\n53\tfn test_va_exhaustion_reserves_more() {\n54\t    // Create pool with very small VA (4 MB) - will exhaust quickly\n55\t    let config = VpmmConfig {\n56\t        page_size: None,\n57\t        va_size: 4 << 20, // 4 MB VA per chunk\n58\t        initial_pages: 0,\n59\t    };\n60\t    let mut pool = VirtualMemoryPool::new(config);\n61\t\n62\t    if pool.page_size == usize::MAX {\n63\t        println!(\"VPMM not supported, skipping test\");\n64\t        return;\n65\t    }\n66\t\n67\t    let page_size = pool.page_size;\n68\t    let stream_id = current_stream_id().unwrap();\n69\t\n70\t    // Initial state: 1 VA root\n71\t    assert_eq!(pool.roots.len(), 1);\n72\t\n73\t    // Allocate enough pages to exhaust first VA chunk and trigger second reservation\n74\t    // 4MB VA / 2MB page = 2 pages max in first chunk\n75\t    let mut ptrs = Vec::new();\n76\t    for _ in 0..4 {\n77\t        // Allocate 4 pages total → needs 2 VA chunks\n78\t        match pool.malloc_internal(page_size, stream_id) {\n79\t            Ok(ptr) => ptrs.push(ptr),\n80\t            Err(e) => panic!(\"Allocation failed: {:?}\", e),\n81\t        }\n82\t    }\n83\t\n84\t    assert!(\n85\t        pool.roots.len() >= 2,\n86\t        \"Should have reserved additional VA chunks. Got {} roots\",\n87\t        pool.roots.len()\n88\t    );\n89\t\n90\t    // Cleanup\n91\t    for ptr in ptrs {\n92\t        pool.free_internal(ptr, stream_id).unwrap();\n93\t    }\n94\t}\n95\t\n96\t// ============================================================================\n97\t// Defragmentation scenario from vpmm_spec.md:\n98\t//   +10  >  +1  >  -10  >  +4  >  +11 (in units of PAGE_SIZE)\n99\t//\n100\t// X = PAGES - 11 determines behavior:\n101\t//   Case A: X ≥ 11 (PAGES ≥ 22) - enough free pages, no defrag\n102\t//   Case B: 5 ≤ X < 11 (16 ≤ PAGES < 22) - defrag for +11, no new pages\n103\t//   Case C: X == 4 (PAGES = 15) - defrag + allocate 1 new page\n104\t//   Case D: 0 ≤ X < 4 (11 ≤ PAGES < 15) - different layout, defrag + new pages\n105\t// ============================================================================\n106\t\n107\t/// Helper to run the doc scenario and return final state\n108\tfn run_doc_scenario(\n109\t    initial_pages: usize,\n110\t) -> (\n111\t    VirtualMemoryPool,\n112\t    usize,                 // page_size\n113\t    *mut std::ffi::c_void, // ptr_1 (kept)\n114\t    *mut std::ffi::c_void, // ptr_4\n115\t    *mut std::ffi::c_void, // ptr_11\n116\t) {\n117\t    let config = VpmmConfig {\n118\t        page_size: None,  // Use device granularity\n119\t        va_size: 1 << 30, // 1 GB VA space\n120\t        initial_pages,\n121\t    };\n122\t    let mut pool = VirtualMemoryPool::new(config);\n123\t\n124\t    if pool.page_size == usize::MAX {\n125\t        panic!(\"VPMM not supported\");\n126\t    }\n127\t\n128\t    let page_size = pool.page_size;\n129\t    let stream_id = current_stream_id().unwrap();\n130\t\n131\t    // Step 1: +10 pages\n132\t    let ptr_10 = pool.malloc_internal(10 * page_size, stream_id).unwrap();\n133\t    assert!(!ptr_10.is_null());\n134\t\n135\t    // Step 2: +1 page\n136\t    let ptr_1 = pool.malloc_internal(page_size, stream_id).unwrap();\n137\t    assert!(!ptr_1.is_null());\n138\t    // Should be right after the 10-page allocation\n139\t    assert_eq!(ptr_1 as usize, ptr_10 as usize + 10 * page_size);\n140\t\n141\t    // Step 3: -10 pages\n142\t    pool.free_internal(ptr_10, stream_id).unwrap();\n143\t\n144\t    // Step 4: +4 pages\n145\t    let ptr_4 = pool.malloc_internal(4 * page_size, stream_id).unwrap();\n146\t    assert!(!ptr_4.is_null());\n147\t\n148\t    // Step 5: +11 pages\n149\t    let ptr_11 = pool.malloc_internal(11 * page_size, stream_id).unwrap();\n150\t    assert!(!ptr_11.is_null());\n151\t\n152\t    (pool, page_size, ptr_1, ptr_4, ptr_11)\n153\t}\n154\t\n155\t#[test]\n156\tfn test_defrag_case_a_enough_free_pages() {\n157\t    // Case A: X ≥ 11, so PAGES ≥ 22\n158\t    // After +10 +1 we use 11 pages, leaving X=11 free\n159\t    // +4 takes from the freed 10-page region (best fit)\n160\t    // +11 can fit in remaining preallocated space\n161\t    let initial_pages = 22; // X = 22 - 11 = 11\n162\t\n163\t    let (pool, page_size, ptr_1, ptr_4, ptr_11) = run_doc_scenario(initial_pages);\n164\t    let stream_id = current_stream_id().unwrap();\n165\t\n166\t    // Memory usage should be exactly 22 pages (no new allocation needed)\n167\t    assert_eq!(\n168\t        pool.memory_usage(),\n169\t        22 * page_size,\n170\t        \"Case A: no new pages allocated\"\n171\t    );\n172\t\n173\t    // Step 4 layout: [+4][-6][1][-X] - 4 takes start of freed 10\n174\t    assert_eq!(ptr_4 as usize, pool.roots[0] as usize, \"4 at VA start\");\n175\t\n176\t    // Step 5 layout: [4][-6][1][+11][...] - 11 goes after the 1\n177\t    assert!(\n178\t        ptr_11 as usize > ptr_1 as usize,\n179\t        \"Case A: 11 should be after 1 (no defrag)\"\n180\t    );\n181\t\n182\t    // Cleanup\n183\t    let mut pool = pool;\n184\t    pool.free_internal(ptr_1, stream_id).unwrap();\n185\t    pool.free_internal(ptr_4, stream_id).unwrap();\n186\t    pool.free_internal(ptr_11, stream_id).unwrap();\n187\t}\n188\t\n189\t#[test]\n190\tfn test_defrag_case_b_defrag_no_new_pages() {\n191\t    // Case B: 5 ≤ X < 11, so 16 ≤ PAGES < 22\n192\t    // After +10 +1, we have X free pages (5 ≤ X < 11)\n193\t    // +4 goes after 1 (fits in X pages)\n194\t    // +11 needs defrag: remap the 10-page free region\n195\t    let initial_pages = 18; // X = 18 - 11 = 7\n196\t\n197\t    let (pool, page_size, ptr_1, ptr_4, ptr_11) = run_doc_scenario(initial_pages);\n198\t    let stream_id = current_stream_id().unwrap();\n199\t\n200\t    // Memory usage should still be 18 pages (defrag reuses existing)\n201\t    assert_eq!(\n202\t        pool.memory_usage(),\n203\t        18 * page_size,\n204\t        \"Case B: no new pages allocated\"\n205\t    );\n206\t\n207\t    // In Case B, +4 goes after 1: [-10][1][+4][-(X-4)]\n208\t    assert_eq!(\n209\t        ptr_4 as usize,\n210\t        ptr_1 as usize + page_size,\n211\t        \"Case B: 4 right after 1\"\n212\t    );\n213\t\n214\t    // Cleanup\n215\t    let mut pool = pool;\n216\t    pool.free_internal(ptr_1, stream_id).unwrap();\n217\t    pool.free_internal(ptr_4, stream_id).unwrap();\n218\t    pool.free_internal(ptr_11, stream_id).unwrap();\n219\t}\n220\t\n221\t#[test]\n222\tfn test_defrag_case_c_defrag_plus_new_page() {\n223\t    // Case C: X == 4, so PAGES = 15\n224\t    // After +10 +1, we have exactly 4 free pages\n225\t    // +4 takes all free pages: [-10][1][+4] (no leftover)\n226\t    // +11 needs defrag (remap 10) + allocate 1 new page\n227\t    let initial_pages = 15; // X = 15 - 11 = 4\n228\t\n229\t    let (pool, page_size, ptr_1, ptr_4, ptr_11) = run_doc_scenario(initial_pages);\n230\t    let stream_id = current_stream_id().unwrap();\n231\t\n232\t    // Memory usage: 15 original + 1 new = 16 pages\n233\t    assert_eq!(\n234\t        pool.memory_usage(),\n235\t        16 * page_size,\n236\t        \"Case C: 1 new page allocated\"\n237\t    );\n238\t\n239\t    // +4 goes after 1 (uses all remaining X=4 pages)\n240\t    assert_eq!(\n241\t        ptr_4 as usize,\n242\t        ptr_1 as usize + page_size,\n243\t        \"Case C: 4 right after 1\"\n244\t    );\n245\t\n246\t    // Cleanup\n247\t    let mut pool = pool;\n248\t    pool.free_internal(ptr_1, stream_id).unwrap();\n249\t    pool.free_internal(ptr_4, stream_id).unwrap();\n250\t    pool.free_internal(ptr_11, stream_id).unwrap();\n251\t}\n252\t\n253\t#[test]\n254\tfn test_defrag_case_d_not_enough_for_4() {\n255\t    // Case D: 0 ≤ X < 4, so 11 ≤ PAGES < 15\n256\t    // After +10 +1, we have X < 4 free pages\n257\t    // +4 cannot fit after 1, so it takes from freed 10: [+4][-6][1][-X]\n258\t    // +11 needs defrag of the 6 + allocate (11-X-6) new pages\n259\t    let initial_pages = 12; // X = 12 - 11 = 1\n260\t\n261\t    let (pool, page_size, ptr_1, ptr_4, ptr_11) = run_doc_scenario(initial_pages);\n262\t    let stream_id = current_stream_id().unwrap();\n263\t\n264\t    // Memory usage: need 11 more pages but only have 6+1=7 free\n265\t    // So allocate 11-7=4 new pages → 12 + 4 = 16 total\n266\t    assert_eq!(\n267\t        pool.memory_usage(),\n268\t        16 * page_size,\n269\t        \"Case D: 4 new pages allocated\"\n270\t    );\n271\t\n272\t    // +4 at VA start (takes from freed 10 since X < 4)\n273\t    assert_eq!(\n274\t        ptr_4 as usize, pool.roots[0] as usize,\n275\t        \"Case D: 4 at VA start\"\n276\t    );\n277\t\n278\t    // Cleanup\n279\t    let mut pool = pool;\n280\t    pool.free_internal(ptr_1, stream_id).unwrap();\n281\t    pool.free_internal(ptr_4, stream_id).unwrap();\n282\t    pool.free_internal(ptr_11, stream_id).unwrap();\n283\t}\n284\t\n285\t// ============================================================================\n286\t// Mixed allocations: small (cudaMallocAsync) and large (VPMM) across threads\n287\t// ============================================================================\n288\t#[test]\n289\tfn test_mixed_allocations() {\n290\t    let runtime = tokio::runtime::Builder::new_multi_thread()\n291\t        .worker_threads(4)\n292\t        .max_blocking_threads(4)\n293\t        .enable_all()\n294\t        .build()\n295\t        .unwrap();\n296\t\n297\t    runtime.block_on(async {\n298\t        let mut handles = Vec::new();\n299\t\n300\t        for thread_idx in 0..4 {\n301\t            let handle = tokio::task::spawn_blocking(move || {\n302\t                let mut buffers: Vec<DeviceBuffer<u8>> = Vec::new();\n303\t\n304\t                for op in 0..15 {\n305\t                    let len = if op % 3 == 0 {\n306\t                        // Small: 1KB - 100KB (cudaMallocAsync path)\n307\t                        ((thread_idx + 1) * (op + 1) * 1024) % (100 << 10) + 1024\n308\t                    } else {\n309\t                        // Large: 100MB - 400MB (VPMM path)\n310\t                        ((thread_idx + 1) * (op + 1) % 4 + 1) * (100 << 20)\n311\t                    };\n312\t\n313\t                    let buf = DeviceBuffer::<u8>::with_capacity(len);\n314\t                    buffers.push(buf);\n315\t\n316\t                    if op % 2 == 0 && !buffers.is_empty() {\n317\t                        buffers.remove(0);\n318\t                    }\n319\t                }\n320\t            });\n321\t            handles.push(handle);\n322\t        }\n323\t\n324\t        for handle in handles {\n325\t            handle.await.expect(\"thread failed\");\n326\t        }\n327\t    });\n328\t\n329\t    // Verify pool is functional after mixed operations\n330\t    current_stream_sync().expect(\"stream sync failed\");\n331\t    let large = DeviceBuffer::<u8>::with_capacity(1 << 30);\n332\t    assert!(\n333\t        !large.as_ptr().is_null(),\n334\t        \"Large allocation should work after mixed operations\"\n335\t    );\n336\t}\n337\t\n338\t// ============================================================================\n339\t// OOM recovery: allocator should still work after an OOM event\n340\t// ============================================================================\n341\t#[test]\n342\t#[ignore] // Heavy: intentionally exhausts GPU memory\n343\tfn test_oom_recovery_after_error() {\n344\t    use super::d_malloc;\n345\t    use crate::error::MemoryError;\n346\t\n347\t    // Allocate large chunks to drive the device near OOM. Keep them alive to\n348\t    // simulate a server that retains existing allocations.\n349\t    let chunk_size = 2 << 30; // 2 GB\n350\t    let mut buffers: Vec<*mut std::ffi::c_void> = Vec::new();\n351\t\n352\t    // Fill GPU memory until we hit OOM on a 2 GB request\n353\t    loop {\n354\t        match d_malloc(chunk_size) {\n355\t            Ok(ptr) => buffers.push(ptr),\n356\t            Err(MemoryError::OutOfMemory { .. }) => break,\n357\t            Err(e) => panic!(\"Expected OOM, got {:?}\", e),\n358\t        }\n359\t    }\n360\t\n361\t    // After OOM, allocator should still succeed for smaller requests without\n362\t    // freeing the large buffers we already hold.\n363\t    let small = d_malloc(1 << 20).expect(\"Small allocation after OOM failed\"); // 1 MB (cudaMallocAsync path)\n364\t\n365\t    // Request just under the currently free memory to exercise the pool path.\n366\t    let free_after_oom = get_gpu_free_memory();\n367\t    let safety = 64 << 20; // leave 64 MB headroom to avoid rounding issues\n368\t    assert!(\n369\t        free_after_oom > safety + (2 << 20),\n370\t        \"Not enough free memory to attempt medium alloc after OOM\"\n371\t    );\n372\t    let medium_req = free_after_oom - safety;\n373\t    let medium = d_malloc(medium_req).expect(\"Pool allocation after OOM failed\");\n374\t\n375\t    // Cleanup\n376\t    unsafe { super::d_free(small).unwrap() };\n377\t    unsafe { super::d_free(medium).unwrap() };\n378\t    for ptr in buffers {\n379\t        unsafe { super::d_free(ptr).unwrap() };\n380\t    }\n381\t    current_stream_sync().expect(\"stream sync after cleanup\");\n382\t}\n383\t\n384\t// ============================================================================\n385\t// Edge Case Tests for Defragmentation\n386\t// ============================================================================\n387\t\n388\t// Helper to create a small test pool\n389\tfn create_test_pool(initial_pages: usize) -> VirtualMemoryPool {\n390\t    let config = VpmmConfig {\n391\t        page_size: None,  // Use device granularity\n392\t        va_size: 1 << 30, // 1 GB VA space\n393\t        initial_pages,\n394\t    };\n395\t    let pool = VirtualMemoryPool::new(config);\n396\t    if pool.page_size == usize::MAX {\n397\t        panic!(\"VPMM not supported, cannot run this test\");\n398\t    }\n399\t    pool\n400\t}\n401\t\n402\t// ============================================================================\n403\t// Test: Multiple consecutive defragmentation operations\n404\t// ============================================================================\n405\t#[test]\n406\tfn test_multiple_defrag_cycles() {\n407\t    let mut pool = create_test_pool(8);\n408\t    let page_size = pool.page_size;\n409\t    let stream_id = current_stream_id().unwrap();\n410\t\n411\t    for cycle in 0..3 {\n412\t        // Create fragmentation\n413\t        let ptrs: Vec<_> = (0..4)\n414\t            .map(|_| pool.malloc_internal(2 * page_size, stream_id).unwrap())\n415\t            .collect();\n416\t\n417\t        // Free alternating\n418\t        pool.free_internal(ptrs[0], stream_id).unwrap();\n419\t        pool.free_internal(ptrs[2], stream_id).unwrap();\n420\t\n421\t        // Request contiguous that requires defrag\n422\t        let ptr_big = pool.malloc_internal(4 * page_size, stream_id).unwrap();\n423\t        assert!(!ptr_big.is_null(), \"Cycle {} failed to allocate\", cycle);\n424\t\n425\t        // Cleanup for next cycle\n426\t        pool.free_internal(ptrs[1], stream_id).unwrap();\n427\t        pool.free_internal(ptrs[3], stream_id).unwrap();\n428\t        pool.free_internal(ptr_big, stream_id).unwrap();\n429\t    }\n430\t}\n431\t\n432\t// ============================================================================\n433\t// Additional Edge Case Tests for Complete Coverage\n434\t// ============================================================================\n435\t\n436\t// ============================================================================\n437\t// Test: Comprehensive coalescing verification for prev, next, and both neighbors\n438\t// Tests that merged regions have correct sizes and addresses\n439\t// ============================================================================\n440\t#[test]\n441\tfn test_coalesce_all_neighbor_cases() {\n442\t    let mut pool = create_test_pool(6);\n443\t    let page_size = pool.page_size;\n444\t    let stream_id = current_stream_id().unwrap();\n445\t\n446\t    // --- Case 1: Coalesce with PREV neighbor ---\n447\t    // Allocate: [A(2)][B(2)][C(2)]\n448\t    let ptr_a = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n449\t    let ptr_b = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n450\t    let ptr_c = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n451\t\n452\t    // Free B, then A -> A merges with B (prev neighbor)\n453\t    pool.free_internal(ptr_b, stream_id).unwrap();\n454\t    pool.free_internal(ptr_a, stream_id).unwrap();\n455\t\n456\t    // Verify 4 pages available from coalesced A+B\n457\t    let ptr_4 = pool.malloc_internal(4 * page_size, stream_id).unwrap();\n458\t    assert_eq!(ptr_4 as usize, ptr_a as usize, \"Prev: should start at A\");\n459\t    assert_eq!(pool.memory_usage(), 6 * page_size, \"Prev: no new alloc\");\n460\t\n461\t    // Reset for next case\n462\t    pool.free_internal(ptr_c, stream_id).unwrap();\n463\t    pool.free_internal(ptr_4, stream_id).unwrap();\n464\t\n465\t    // --- Case 2: Coalesce with NEXT neighbor ---\n466\t    let ptr_a = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n467\t    let ptr_b = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n468\t    let ptr_c = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n469\t\n470\t    // Free A, then B -> B merges with A (next neighbor from A's POV)\n471\t    pool.free_internal(ptr_a, stream_id).unwrap();\n472\t    pool.free_internal(ptr_b, stream_id).unwrap();\n473\t\n474\t    let ptr_4 = pool.malloc_internal(4 * page_size, stream_id).unwrap();\n475\t    assert_eq!(ptr_4 as usize, ptr_a as usize, \"Next: should start at A\");\n476\t\n477\t    // Reset for next case\n478\t    pool.free_internal(ptr_c, stream_id).unwrap();\n479\t    pool.free_internal(ptr_4, stream_id).unwrap();\n480\t\n481\t    // --- Case 3: Coalesce with BOTH neighbors ---\n482\t    let ptr_a = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n483\t    let ptr_b = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n484\t    let ptr_c = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n485\t\n486\t    // Free A, C, then B (middle) -> B merges with both\n487\t    pool.free_internal(ptr_a, stream_id).unwrap();\n488\t    pool.free_internal(ptr_c, stream_id).unwrap();\n489\t    pool.free_internal(ptr_b, stream_id).unwrap();\n490\t\n491\t    let ptr_6 = pool.malloc_internal(6 * page_size, stream_id).unwrap();\n492\t    assert_eq!(ptr_6 as usize, ptr_a as usize, \"Both: should start at A\");\n493\t    assert_eq!(pool.memory_usage(), 6 * page_size, \"Both: no new alloc\");\n494\t\n495\t    pool.free_internal(ptr_6, stream_id).unwrap();\n496\t}\n497\t\n498\t// ============================================================================\n499\t// Test: NO coalescing across different streams; defrag still works\n500\t// ============================================================================\n501\t#[test]\n502\tfn test_no_coalesce_across_streams() {\n503\t    let mut pool = create_test_pool(6);\n504\t    let page_size = pool.page_size;\n505\t    let stream_id_1 = current_stream_id().unwrap();\n506\t    let stream_id_2 = stream_id_1 + 1000; // Simulate different stream\n507\t\n508\t    // Allocate: [A(2)][B(2)][C(2)]\n509\t    let ptr_a = pool.malloc_internal(2 * page_size, stream_id_1).unwrap();\n510\t    let ptr_b = pool.malloc_internal(2 * page_size, stream_id_1).unwrap();\n511\t    let ptr_c = pool.malloc_internal(2 * page_size, stream_id_1).unwrap();\n512\t\n513\t    // Free A on stream_1, B on stream_2, C on stream_1\n514\t    // B should NOT coalesce with A or C (different stream)\n515\t    pool.free_internal(ptr_a, stream_id_1).unwrap();\n516\t    pool.free_internal(ptr_b, stream_id_2).unwrap();\n517\t    pool.free_internal(ptr_c, stream_id_1).unwrap();\n518\t\n519\t    // Requesting 4 pages needs defrag to combine A + C (skipping B)\n520\t    let memory_before = pool.memory_usage();\n521\t    let ptr_4 = pool.malloc_internal(4 * page_size, stream_id_1).unwrap();\n522\t    assert!(!ptr_4.is_null());\n523\t    assert_eq!(pool.memory_usage(), memory_before, \"Defrag reused existing\");\n524\t\n525\t    pool.free_internal(ptr_4, stream_id_1).unwrap();\n526\t}\n527\t\n528\t// ============================================================================\n529\t// Test: Tail free regions are properly returned and usable after defrag\n530\t// Covers: oldest-first ordering, partial consumption, tail verification\n531\t// ============================================================================\n532\t#[test]\n533\tfn test_defrag_tail_regions_returned() {\n534\t    let mut pool = create_test_pool(10);\n535\t    let page_size = pool.page_size;\n536\t    let stream_id = current_stream_id().unwrap();\n537\t\n538\t    // Allocate 5 x 2-page regions\n539\t    let ptrs: Vec<_> = (0..5)\n540\t        .map(|_| pool.malloc_internal(2 * page_size, stream_id).unwrap())\n541\t        .collect();\n542\t\n543\t    // Free alternating to create fragmentation with 6 free pages in 3 regions\n544\t    // Layout: [2 free][2 alloc][2 free][2 alloc][2 free]\n545\t    pool.free_internal(ptrs[0], stream_id).unwrap();\n546\t    pool.free_internal(ptrs[2], stream_id).unwrap();\n547\t    pool.free_internal(ptrs[4], stream_id).unwrap();\n548\t\n549\t    // Request 5 pages -> defrag takes 2+2+1, leaving 1 page as tail\n550\t    let memory_before = pool.memory_usage();\n551\t    let ptr_5 = pool.malloc_internal(5 * page_size, stream_id).unwrap();\n552\t    assert_eq!(pool.memory_usage(), memory_before, \"No new pages needed\");\n553\t\n554\t    // Verify tail exists: can allocate 1 more without new allocation\n555\t    let ptr_1 = pool.malloc_internal(page_size, stream_id).unwrap();\n556\t    assert_eq!(pool.memory_usage(), memory_before, \"Tail page reused\");\n557\t\n558\t    // Now requesting more requires new allocation\n559\t    let ptr_extra = pool.malloc_internal(page_size, stream_id).unwrap();\n560\t    assert_eq!(\n561\t        pool.memory_usage(),\n562\t        memory_before + page_size,\n563\t        \"New page allocated\"\n564\t    );\n565\t\n566\t    // Cleanup\n567\t    pool.free_internal(ptrs[1], stream_id).unwrap();\n568\t    pool.free_internal(ptrs[3], stream_id).unwrap();\n569\t    pool.free_internal(ptr_5, stream_id).unwrap();\n570\t    pool.free_internal(ptr_1, stream_id).unwrap();\n571\t    pool.free_internal(ptr_extra, stream_id).unwrap();\n572\t}\n573\t\n574\t// ============================================================================\n575\t// Test: Unmapped region coalescing during remap operations\n576\t// ============================================================================\n577\t#[test]\n578\tfn test_unmapped_region_coalescing_comprehensive() {\n579\t    let mut pool = create_test_pool(6);\n580\t    let page_size = pool.page_size;\n581\t    let stream_id = current_stream_id().unwrap();\n582\t\n583\t    // Allocate: [A(2)][B(2)][C(2)]\n584\t    let ptr_a = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n585\t    let ptr_b = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n586\t    let ptr_c = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n587\t\n588\t    // Free A and B -> should coalesce to 4 free pages\n589\t    pool.free_internal(ptr_a, stream_id).unwrap();\n590\t    pool.free_internal(ptr_b, stream_id).unwrap();\n591\t\n592\t    // Request 4 pages from coalesced region\n593\t    let ptr_4 = pool.malloc_internal(4 * page_size, stream_id).unwrap();\n594\t    assert_eq!(ptr_4 as usize, ptr_a as usize);\n595\t\n596\t    // Free everything\n597\t    pool.free_internal(ptr_4, stream_id).unwrap();\n598\t    pool.free_internal(ptr_c, stream_id).unwrap();\n599\t\n600\t    // Request 7 pages -> needs remap + 1 new page\n601\t    // Unmapped regions from remap should coalesce properly\n602\t    let memory_before = pool.memory_usage();\n603\t    let ptr_7 = pool.malloc_internal(7 * page_size, stream_id).unwrap();\n604\t    assert_eq!(pool.memory_usage(), memory_before + page_size);\n605\t\n606\t    pool.free_internal(ptr_7, stream_id).unwrap();\n607\t}\n608\t\n609\t// ============================================================================\n610\t// Test: Defrag with new pages merging with existing free regions\n611\t// ============================================================================\n612\t#[test]\n613\tfn test_defrag_new_pages_merge_with_existing() {\n614\t    let config = VpmmConfig {\n615\t        page_size: None,\n616\t        va_size: 1 << 30,\n617\t        initial_pages: 0,\n618\t    };\n619\t    let mut pool = VirtualMemoryPool::new(config);\n620\t\n621\t    if pool.page_size == usize::MAX {\n622\t        println!(\"VPMM not supported, skipping test\");\n623\t        return;\n624\t    }\n625\t\n626\t    let page_size = pool.page_size;\n627\t    let stream_id = current_stream_id().unwrap();\n628\t\n629\t    // Allocate 2 pages, then free them\n630\t    let ptr_2 = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n631\t    assert_eq!(pool.memory_usage(), 2 * page_size);\n632\t    pool.free_internal(ptr_2, stream_id).unwrap();\n633\t\n634\t    // Request 4 pages -> allocates 2 new + uses 2 free (merge)\n635\t    let ptr_4 = pool.malloc_internal(4 * page_size, stream_id).unwrap();\n636\t    assert_eq!(pool.memory_usage(), 4 * page_size);\n637\t    assert!(!ptr_4.is_null());\n638\t\n639\t    // Test with preallocated pool: alloc merges with prev free\n640\t    pool.free_internal(ptr_4, stream_id).unwrap();\n641\t\n642\t    let ptr_a = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n643\t    let ptr_b = pool.malloc_internal(2 * page_size, stream_id).unwrap();\n644\t    pool.free_internal(ptr_a, stream_id).unwrap();\n645\t\n646\t    // Request 4 pages with 2 free -> need 2 more\n647\t    let ptr_req = pool.malloc_internal(4 * page_size, stream_id).unwrap();\n648\t    assert!(!ptr_req.is_null());\n649\t    assert_eq!(pool.memory_usage(), 6 * page_size);\n650\t\n651\t    pool.free_internal(ptr_b, stream_id).unwrap();\n652\t    pool.free_internal(ptr_req, stream_id).unwrap();\n653\t}\n654\t\n655\t// ============================================================================\n656\t// Test: Multiple defrag scenarios in sequence\n657\t// Covers: exact fit (no tail), remap with new page allocation, combining regions\n658\t// ============================================================================\n659\t#[test]\n660\tfn test_defrag_various_scenarios() {\n661\t    let mut pool = create_test_pool(10);\n662\t    let page_size = pool.page_size;\n663\t    let stream_id = current_stream_id().unwrap();\n664\t\n665\t    // --- Scenario 1: Exact fit, no tail ---\n666\t    let ptrs: Vec<_> = (0..5)\n667\t        .map(|_| pool.malloc_internal(2 * page_size, stream_id).unwrap())\n668\t        .collect();\n669\t\n670\t    // Free all in scattered order -> should coalesce completely\n671\t    pool.free_internal(ptrs[1], stream_id).unwrap();\n672\t    pool.free_internal(ptrs[3], stream_id).unwrap();\n673\t    pool.free_internal(ptrs[0], stream_id).unwrap();\n674\t    pool.free_internal(ptrs[4], stream_id).unwrap();\n675\t    pool.free_internal(ptrs[2], stream_id).unwrap();\n676\t\n677\t    // Request all 10 pages (exact fit)\n678\t    let ptr_10 = pool.malloc_internal(10 * page_size, stream_id).unwrap();\n679\t    assert!(!ptr_10.is_null());\n680\t    assert_eq!(pool.memory_usage(), 10 * page_size);\n681\t\n682\t    // --- Scenario 2: Remap with new page allocation (reuse same pool state) ---\n683\t    // Layout now: [10 malloc]\n684\t    // Free the 10-page region, then create fragmentation\n685\t    pool.free_internal(ptr_10, stream_id).unwrap();\n686\t\n687\t    // Allocate 6 + 4 pages\n688\t    let ptr_a = pool.malloc_internal(6 * page_size, stream_id).unwrap();\n689\t    let ptr_b = pool.malloc_internal(4 * page_size, stream_id).unw