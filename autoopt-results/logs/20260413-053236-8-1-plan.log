{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QFFCLyxYrL55AUbwgqN1va","type":"tool_result","content":"875\t}\n876\t\n877\t/// # Safety\n878\t/// - `fracs` must be a pointer to a device buffer with capacity at least `num_interactions *\n879\t///   height`.\n880\t#[allow(clippy::too_many_arguments)]\n881\tpub unsafe fn logup_gkr_input_eval(\n882\t    is_global: bool,\n883\t    fracs: *mut Frac<EF>,\n884\t    preprocessed: &DeviceBuffer<F>,\n885\t    partitioned_main: &DeviceBuffer<u64>,\n886\t    public_values: &DeviceBuffer<F>,\n887\t    challenges: &DeviceBuffer<EF>,\n888\t    intermediates: &DeviceBuffer<EF>,\n889\t    rules: &DeviceBuffer<u128>,\n890\t    used_nodes: &DeviceBuffer<usize>,\n891\t    pair_idxs: &DeviceBuffer<u32>,\n892\t    height: u32,\n893\t    num_rows_per_tile: u32,\n894\t) -> Result<(), CudaError> {\n895\t    debug_assert_eq!(used_nodes.len(), pair_idxs.len());\n896\t    CudaError::from_result(_logup_gkr_input_eval(\n897\t        is_global,\n898\t        fracs,\n899\t        preprocessed.as_ptr(),\n900\t        partitioned_main.as_ptr(),\n901\t        public_values.as_ptr(),\n902\t        challenges.as_ptr(),\n903\t        intermediates.as_ptr(),\n904\t        rules.as_raw_ptr(),\n905\t        used_nodes.as_ptr(),\n906\t        pair_idxs.as_ptr(),\n907\t        used_nodes.len(),\n908\t        height,\n909\t        num_rows_per_tile,\n910\t    ))\n911\t}\n912\t\n913\tpub unsafe fn frac_add_alpha(data: &DeviceBuffer<Frac<EF>>, alpha: EF) -> Result<(), CudaError> {\n914\t    CudaError::from_result(_frac_add_alpha(data.as_mut_raw_ptr(), data.len(), alpha))\n915\t}\n916\t\n917\t/// # Safety\n918\t/// - `buffer_size` does not refer to the capacity of `intermediates`. It refers to \"how many DAG\n919\t///   nodes per row need to be buffered\". The capacity is a multiple of `buffer_size` which is\n920\t///   runtime calculated based on `buffer_size`.\n921\t/// - `eq_cube` must be a pointer to device buffer with at least `num_x` elements representing\n922\t///   evaluations on hypercube.\n923\t#[allow(clippy::too_many_arguments)]\n924\tpub unsafe fn zerocheck_ntt_eval_constraints(\n925\t    tmp_sums_buffer: &mut DeviceBuffer<EF>,\n926\t    output: &mut DeviceBuffer<EF>,\n927\t    selectors_cube: &DeviceBuffer<F>,\n928\t    preprocessed: *const F,\n929\t    main_ptrs: &DeviceBuffer<*const F>,\n930\t    eq_cube: *const EF,\n931\t    lambda_pows: &DeviceBuffer<EF>,\n932\t    public_values: &DeviceBuffer<F>,\n933\t    rules: &DeviceBuffer<u128>,\n934\t    used_nodes: &DeviceBuffer<usize>,\n935\t    buffer_size: u32,\n936\t    intermediates: &mut DeviceBuffer<F>,\n937\t    skip_domain: u32,\n938\t    num_x: u32,\n939\t    height: u32,\n940\t    num_cosets: u32,\n941\t    g_shift: F,\n942\t    max_temp_bytes: usize,\n943\t) -> Result<(), CudaError> {\n944\t    CudaError::from_result(_zerocheck_ntt_eval_constraints(\n945\t        tmp_sums_buffer.as_mut_ptr(),\n946\t        output.as_mut_ptr(),\n947\t        selectors_cube.as_ptr(),\n948\t        preprocessed,\n949\t        main_ptrs.as_ptr(),\n950\t        eq_cube,\n951\t        lambda_pows.as_ptr(),\n952\t        public_values.as_ptr(),\n953\t        rules.as_raw_ptr(),\n954\t        rules.len(),\n955\t        used_nodes.as_ptr(),\n956\t        used_nodes.len(),\n957\t        lambda_pows.len(),\n958\t        buffer_size,\n959\t        intermediates.as_mut_ptr(),\n960\t        skip_domain,\n961\t        num_x,\n962\t        height,\n963\t        num_cosets,\n964\t        g_shift,\n965\t        max_temp_bytes,\n966\t    ))\n967\t}\n968\t\n969\t/// # Safety\n970\t/// - `buffer_size` does not refer to the capacity of `intermediates`. It refers to \"how many DAG\n971\t///   nodes per row need to be buffered\". The capacity is a multiple of `buffer_size` which is\n972\t///   runtime calculated based on `buffer_size`.\n973\t/// - `eq_cube` must be a pointer to device buffer with at least `num_x` elements representing\n974\t///   evaluations on hype