343\t}\n1344\t\n1345\t/// Create folded selectors around round 0 from hypercube evaluations and univariate factors.\n1346\t///\n1347\t/// Note: `is_transition` is not a product of univariate and hypercube factors.\n1348\tpub unsafe fn fold_selectors_round0(\n1349\t    out: *mut EF,\n1350\t    input: *const F,\n1351\t    is_first: EF,\n1352\t    is_last: EF,\n1353\t    num_x: usize,\n1354\t) -> Result<(), CudaError> {\n1355\t    CudaError::from_result(_fold_selectors_round0(\n1356\t        out,\n1357\t        input,\n1358\t        is_first,\n1359\t        is_last,\n1360\t        num_x as u32,\n1361\t    ))\n1362\t}\n1363\t"}]},"parent_tool_use_id":"toolu_01UMVFWGFbmaaci5g5QBo8YB","session_id":"39e8685b-d752-4f1d-86a0-2956436bbd44","uuid":"958c13c3-be22-49a4-9cd3-10f868db2749","timestamp":"2026-04-13T03:52:28.559Z"}
