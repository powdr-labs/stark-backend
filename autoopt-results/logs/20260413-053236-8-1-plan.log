   break;\n184\t                        case OP_NEG:\n185\t                            result = -x;\n186\t                            break;\n187\t                        case OP_VAR:\n188\t                            result = x;\n189\t                            break;\n190\t                        default:\n191\t                            assert(0);\n192\t                        }\n193\t\n194\t                        if (header.buffer_result) {\n195\t                            uint32_t z_index = decode_z_index(rule);\n196\t                            intermediates_ptr[z_index * intermediate_stride] = result;\n197\t                        }\n198\t                    }\n199\t                }\n200\t\n201\t                uint32_t pair_idx = d_pair_idxs[used_idx];\n202\t                size_t interaction_idx = pair_idx >> 1;\n203\t                size_t out_idx = (interaction_idx * permutation_height + row) * 2;\n204\t                reinterpret_cast<FpExt *>(d_fracs)[out_idx + (pair_idx & 1)] = result;\n205\t            }\n206\t        }\n207\t    }\n208\t}\n209\t\n210\t// ============================================================================\n211\t// LAUNCHERS\n212\t// ============================================================================\n213\t\n214\tconstexpr uint32_t TASK_SIZE = 1 << 16;\n215\t\n216\textern \"C\" int _logup_gkr_input_eval(\n217\t    bool is_global,\n218\t    FracExt *d_fracs,\n219\t    const Fp *d_preprocessed,\n220\t    const uint64_t *d_main,\n221\t    const Fp *d_public_values,\n222\t    const FpExt *d_challenges,\n223\t    const FpExt *d_intermediates,\n224\t    const Rule *d_rules,\n225\t    const size_t *d_used_nodes,\n226\t    const uint32_t *d_pair_idxs,\n227\t    size_t used_nodes_len,\n228\t    uint32_t permutation_height,\n229\t    uint32_t num_rows_per_tile\n230\t) {\n231\t    auto count = is_global ? TASK_SIZE : permutation_height;\n232\t    auto [grid, block] = kernel_launch_params(count, 256);\n233\t    if (is_global) {\n234\t        evaluate_interactions_gkr_kernel<true><<<grid, block>>>(\n235\t            d_fracs,\n236\t            d_preprocessed,\n237\t            d_main,\n238\t            d_public_values,\n239\t            d_challenges,\n240\t            d_intermediates,\n241\t            d_rules,\n242\t            d_used_nodes,\n243\t            d_pair_idxs,\n244\t            used_nodes_len,\n245\t            permutation_height,\n246\t            num_rows_per_tile\n247\t        );\n248\t    } else {\n249\t        evaluate_interactions_gkr_kernel<false><<<grid, block>>>(\n250\t            d_fracs,\n251\t            d_preprocessed,\n252\t            d_main,\n253\t            d_public_values,\n254\t            d_challenges,\n255\t            d_intermediates,\n256\t            d_rules,\n257\t            d_used_nodes,\n258\t            d_pair_idxs,\n259\t            used_nodes_len,\n260\t            permutation_height,\n261\t            num_rows_per_tile\n262\t        );\n263\t    }\n264\t    return CHECK_KERNEL();\n265\t}\n266\t\n267\t} // namespace logup_gkr_input_evaluation\n268\t"}]},"parent_tool_use_id":"toolu_01UMVFWGFbmaaci5g5QBo8YB","session_id":"39e8685b-d752-4f1d-86a0-2956436bbd44","uuid":"4709d11d-ae3e-4555-9f90-4f4ff40acff4","timestamp":"2026-04-13T03:51:51.325Z"}
