           partial_out\n1199\t        );\n1200\t    }\n1201\t    if (launch_err != 0) {\n1202\t        return launch_err;\n1203\t    }\n1204\t    int err = CHECK_KERNEL();\n1205\t    if (err != 0) {\n1206\t        return err;\n1207\t    }\n1208\t\n1209\t    dim3 reduce_block(128);\n1210\t    dim3 reduce_grid(div_ceil((uint32_t)total_entries, reduce_block.x));\n1211\t    precompute_m_reduce_partials_kernel<<<reduce_grid, reduce_block>>>(\n1212\t        partial_out,\n1213\t        num_blocks,\n1214\t        (uint32_t)total_entries,\n1215\t        m_total\n1216\t    );\n1217\t    return CHECK_KERNEL();\n1218\t}\n1219\t\n1220\textern \"C\" int _frac_precompute_m_eval_round(\n1221\t    const FpExt *m_total,\n1222\t    size_t w,\n1223\t    size_t t,\n1224\t    const FpExt *eq_r_prefix,\n1225\t    const FpExt *eq_suffix,\n1226\t    FpExt *out\n1227\t) {\n1228\t    assert(w > 0);\n1229\t    assert(t < w);\n1230\t\n1231\t    dim3 block(256);\n1232\t    size_t shmem_bytes = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n1233\t    precompute_m_eval_round_kernel<<<1, block, shmem_bytes>>>(\n1234\t        m_total,\n1235\t        (uint32_t)w,\n1236\t        (uint32_t)t,\n1237\t        eq_r_prefix,\n1238\t        eq_suffix,\n1239\t        out\n1240\t    );\n1241\t    return CHECK_KERNEL();\n1242\t}\n1243\t\n1244\textern \"C\" int _frac_multifold(\n1245\t    const FracExt *src,\n1246\t    FracExt *dst,\n1247\t    size_t rem_n,\n1248\t    size_t w,\n1249\t    const FpExt *eq_r_window\n1250\t) {\n1251\t    assert(rem_n > 0);\n1252\t    assert(w > 0 && w <= rem_n);\n1253\t\n1254\t    size_t out_len = 1u << (rem_n - w);\n1255\t    auto [grid, block] = kernel_launch_params(out_len, 256);\n1256\t\n1257\t#define DISPATCH_MULTIFOLD(W) \\\n1258\t    multifold_kernel<W><<<grid, block>>>(src, dst, (uint32_t)out_len, eq_r_window); \\\n1259\t    return CHECK_KERNEL();\n1260\t\n1261\t    switch (w) {\n1262\t        case 2: { DISPATCH_MULTIFOLD(2) }\n1263\t        case 3: { DISPATCH_MULTIFOLD(3) }\n1264\t        case 4: { DISPATCH_MULTIFOLD(4) }\n1265\t        case 5: { DISPATCH_MULTIFOLD(5) }\n1266\t        default: assert(false && \"unsupported w for multifold\"); return -1;\n1267\t    }\n1268\t#undef DISPATCH_MULTIFOLD\n1269\t}\n1270\t\n1271\textern \"C\" int _frac_fold_fpext_columns(const FracExt *src, FracExt *dst, size_t size, FpExt r) {\n1272\t    if (size <= 2) {\n1273\t        return 0;\n1274\t    }\n1275\t    // FracExt = {p, q} = 2 FpExt elements.\n1276\t    // size is in FracExt; quarter_fpext is in FpExt.\n1277\t    // quarter_fpext = (size / 4) * 2 = size / 2\n1278\t    uint32_t quarter_fpext = size >> 1;\n1279\t    auto [grid, block] = kernel_launch_params(quarter_fpext);\n1280\t    fold_ef_columns_kernel<<<grid, block>>>(\n1281\t        reinterpret_cast<const FpExt *>(src), reinterpret_cast<FpExt *>(dst), quarter_fpext, r\n1282\t    );\n1283\t    return CHECK_KERNEL();\n1284\t}\n1285\t\n1286\textern \"C\" int _frac_add_alpha(FracExt *data, size_t len, FpExt alpha) {\n1287\t    auto [grid, block] = kernel_launch_params(len);\n1288\t    add_alpha_kernel<<<grid, block>>>(data, len, alpha);\n1289\t    return CHECK_KERNEL();\n1290\t}\n1291\t\n1292\textern \"C\" int _frac_vector_scalar_multiply_ext_fp(FracExt *frac_vec, Fp scalar, uint32_t length) {\n1293\t    auto [grid, block] = kernel_launch_params(length);\n1294\t    frac_vector_scalar_multiply_kernel<Fp, FpExt>\n1295\t        <<<grid, block>>>(reinterpret_cast<std::pair<FpExt, FpExt> *>(frac_vec), scalar, length);\n1296\t    return CHECK_KERNEL();\n1297\t}\n1298\t\n1299\t"}]},"parent_tool_use_id":"toolu_01UMVFWGFbmaaci5g5QBo8YB","session_id":"39e8685b-d752-4f1d-86a0-2956436bbd44","uuid":"f61bd45b-93a7-498f-a52a-713fff484953","timestamp":"2026-04-13T03:52:03.789Z"}
