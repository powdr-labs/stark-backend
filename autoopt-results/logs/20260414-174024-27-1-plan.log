{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KMufLhpWsEm7nbRh2FeW7L","type":"tool_result","content":"938\tpub unsafe fn logup_gkr_input_eval(\n939\t    is_global: bool,\n940\t    fracs: *mut Frac<EF>,\n941\t    preprocessed: &DeviceBuffer<F>,\n942\t    partitioned_main: &DeviceBuffer<u64>,\n943\t    public_values: &DeviceBuffer<F>,\n944\t    challenges: &DeviceBuffer<EF>,\n945\t    intermediates: &DeviceBuffer<EF>,\n946\t    rules: &DeviceBuffer<u128>,\n947\t    used_nodes: &DeviceBuffer<usize>,\n948\t    pair_idxs: &DeviceBuffer<u32>,\n949\t    height: u32,\n950\t    num_rows_per_tile: u32,\n951\t) -> Result<(), CudaError> {\n952\t    debug_assert_eq!(used_nodes.len(), pair_idxs.len());\n953\t    CudaError::from_result(_logup_gkr_input_eval(\n954\t        is_global,\n955\t        fracs,\n956\t        preprocessed.as_ptr(),\n957\t        partitioned_main.as_ptr(),\n958\t        public_values.as_ptr(),\n959\t        challenges.as_ptr(),\n960\t        intermediates.as_ptr(),\n961\t        rules.as_raw_ptr(),\n962\t        used_nodes.as_ptr(),\n963\t        pair_idxs.as_ptr(),\n964\t        used_nodes.len(),\n965\t        height,\n966\t        num_rows_per_tile,\n967\t    ))\n968\t}\n969\t\n970\tpub unsafe fn frac_add_alpha(data: &DeviceBuffer<Frac<EF>>, alpha: EF) -> Result<(), CudaError> {\n971\t    CudaError::from_result(_frac_add_alpha(data.as_mut_raw_ptr(), data.len(), alpha))\n972\t}\n973\t\n974\t/// # Safety\n975\t/// - `buffer_size` does not refer to the capacity of `intermediates`. It refers to \"how many DAG\n976\t///   nodes per row need to be buffered\". The capacity is a multiple of `buffer_size` which is\n977\t///   runtime calculated based on `buffer_size`.\n978\t/// - `eq_cube` must be a pointer to device buffer with at least `num_x` elements representing\n979\t///   evaluations on hypercube.\n980\t#[allow(clippy::too_many_arguments)]\n981\tpub unsafe fn zerocheck_ntt_eval_constraints(\n982\t    tmp_sums_buffer: &mut DeviceBuffer<EF>,\n983\t    output: &mut DeviceBuffer<EF>,\n984\t    selectors_cube: &DeviceBuffer<F>,\n985\t    preprocessed: *const F,\n986\t    main_ptrs: &DeviceBuffer<*const F>,\n987\t    eq_cube: *const EF,\n988\t    lambda_pows: &DeviceBuffer<EF>,\n989\t    public_values: &DeviceBuffer<F>,\n990\t    rules: &DeviceBuffer<u128>,\n991\t    used_nodes: &DeviceBuffer<usize>,\n992\t    buffer_size: u32,\n993\t    intermediates: &mut DeviceBuffer<F>,\n994\t    skip_domain: u32,\n995\t    num_x: u32,\n996\t    height: u32,\n997\t    num_cosets: u32,\n998\t    g_shift: F,\n999\t    max_temp_bytes: usize,\n1000\t) -> Result<(), CudaError> {\n1001\t    CudaError::from_result(_zerocheck_ntt_eval_constraints(\n1002\t        tmp_sums_buffer.as_mut_ptr(),\n1003\t        output.as_mut_ptr(),\n1004\t        selectors_cube.as_ptr(),\n1005\t        preprocessed,\n1006\t        main_ptrs.as_ptr(),\n1007\t        eq_cube,\n1008\t        lambda_pows.as_ptr(),\n1009\t        public_values.as_ptr(),\n1010\t        rules.as_raw_ptr(),\n1011\t        rules.len(),\n1012\t        used_nodes.as_ptr(),\n1013\t        used_nodes.len(),\n1014\t        lambda_pows.len(),\n1015\t        buffer_size,\n1016\t        intermediates.as_mut_ptr(),\n1017\t        skip_domain,\n1018\t        num_x,\n1019\t        height,\n1020\t        num_cosets,\n1021\t        g_shift,\n1022\t        max_temp_bytes,\n1023\t    ))\n1024\t}\n1025\t\n1026\t/// # Safety\n1027\t/// - `buffer_size` does not refer to the capacity of `intermediates`. It refers to \"how many DAG\n1028\t///   nodes per row need to be buffered\". The capacity is a multiple of `buffer_size` which is\n1029\t///   runtime calculated based on `buffer_size`.\n1030\t/// - `eq_cube` must be a pointer to device buffer with at least `num_x` elements representing\n1031\t///   evaluations on hypercube.\n1032\t/// - `output` will not be written to by this function. Only `tmp_sums_buffer` is written.\n1033\t#[allow(clippy::too_many_arguments)]\n1034\tpub unsafe fn logup_bary_eval_interactions_round0(\n1035\t    tmp_sums_buffer: &mut DeviceBuffer<Frac<EF>>,\n1036\t    output: &mut DeviceBuffer<Frac<EF>>,\n1037\t    selectors_cube: &DeviceBuffer<F>,\n1038\t    preprocessed: *const F,\n1039\t    main_ptrs: &DeviceBuffer<*const F>,\n1040\t    eq_cube: *const EF,\n1041\t    public_values: &DeviceBuffer<F>,\n1042\t    numer_weights: &DeviceBuffer<EF>,\n1043\t    denom_weights: &DeviceBuffer<EF>,\n1044\t    denom_sum_init: EF,\n1045\t    rules: &DeviceBuffer<u128>,\n1046\t    buffer_size: u32,\n1047\t    intermediates: &mut DeviceBuffer<F>,\n1048\t    skip_domain: u32,\n1049\t    num_x: u32,\n1050\t    height: u32,\n1051\t    num_cosets: u32,\n1052\t    g_shift: F,\n1053\t    max_temp_bytes: usize,\n1054\t) -> Result<(), CudaError> {\n1055\t    CudaError::from_result(_logup_bary_eval_interactions_round0(\n1056\t        tmp_sums_buffer.as_mut_ptr(),\n1057\t        output.as_mut_ptr(),\n1058\t        selectors_cube.as_ptr(),\n1059\t        preprocessed,\n1060\t        main_ptrs.as_ptr(),\n1061\t        eq_cube,\n1062\t        public_values.as_ptr(),\n1063\t        numer_weights.as_ptr(),\n1064\t        denom_weights.as_ptr(),\n1065\t        denom_sum_init,\n1066\t        rules.as_raw_ptr(),\n1067\t        rules.len(),\n1068\t        buffer_size,\n1069\t        intermediates.as_mut_ptr(),\n1070\t        skip_domain,\n1071\t        num_x,\n1072\t        height,\n1073\t        num_cosets,\n1074\t        g_shift,\n1075\t        max_temp_bytes,\n1076\t    ))\n1077\t}\n1078\t\n1079\t/// Evaluate zerocheck MLE constraints on GPU with raw device pointers.\n1080\t#[allow(clippy::too_many_arguments)]\n1081\tpub unsafe fn zerocheck_eval_mle(\n1082\t    tmp_sums_buffer: &mut DeviceBuffer<EF>,\n1083\t    output: &mut DeviceBuffer<EF>,\n1084\t    eq_xi: *const EF,\n1085\t    selectors: *const EF,\n1086\t    preprocessed: MainMatrixPtrs<EF>,\n1087\t    main_ptrs: *const MainMatrixPtrs<EF>,\n1088\t    lambda_pows: *const EF,\n1089\t    lambda_len: usize,\n1090\t    public_values: *const F,\n1091\t    rules: *const std::ffi::c_void,\n1092\t    rules_len: usize,\n1093\t    used_nodes: *const usize,\n1094\t    used_nodes_len: usize,\n1095\t    buffer_size: u32,\n1096\t    intermediates: &mut DeviceBuffer<EF>,\n1097\t    num_y: u32,\n1098\t    num_x: u32,\n1099\t) -> Result<(), CudaError> {\n1100\t    CudaError::from_result(_zerocheck_eval_mle(\n1101\t        tmp_sums_buffer.as_mut_ptr(),\n1102\t        output.as_mut_ptr(),\n1103\t        eq_xi,\n1104\t        selectors,\n1105\t        preprocessed,\n1106\t        main_ptrs,\n1107\t        lambda_pows,\n1108\t        public_values,\n1109\t        rules,\n1110\t        rules_len,\n1111\t        used_nodes,\n1112\t        used_nodes_len,\n1113\t        lambda_len,\n1114\t        buffer_size,\n1115\t        intermediates.as_mut_ptr(),\n1116\t        num_y,\n1117\t        num_x,\n1118\t    ))\n1119\t}\n1120\t\n1121\t#[allow(clippy::too_many_arguments)]\n1122\tpub unsafe fn zerocheck_batch_eval_mle(\n1123\t    tmp_sums_buffer: &mut DeviceBuffer<EF>,\n1124\t    output: &mut DeviceBuffer<EF>,\n1125\t    block_ctxs: &DeviceBuffer<BlockCtx>,\n1126\t    zc_ctxs: &DeviceBuffer<ZerocheckCtx>,\n1127\t    air_block_offsets: &DeviceBuffer<u32>,\n1128\t    lambda_pows: &DeviceBuffer<EF>,\n1129\t    lambda_len: usize,\n1130\t    num_blocks: u32,\n1131\t    num_x: u32,\n1132\t    num_airs: u32,\n1133\t    threads_per_block: u32,\n1134\t) -> Result<(), CudaError> {\n1135\t    CudaError::from_result(_zerocheck_batch_eval_mle(\n1136\t        tmp_sums_buffer.as_mut_ptr(),\n1137\t        output.as_mut_ptr(),"}]},"parent_tool_use_id":"toolu_01LqZEAzySQ6DL5ByEqkfKgi","session_id":"e33616ae-361c-4ad4-bcb1-e94f2f710e44","uuid":"4f163574-4866-404d-8eb9-ec098a19ba4e","timestamp":"2026-04-14T15:47:17.912Z"}
