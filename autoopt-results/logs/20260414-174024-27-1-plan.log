      let mut eq_r_acc = EF::ONE;\n694\t\n695\t        // Round 0: compute + revert fused. The pq_buffer fold will be fused into next round's\n696\t        // compute. This fuses frac_build_tree_layer(revert=true) with the first inner round\n697\t        // compute.\n698\t        let r0 = do_sumcheck_round_and_revert(\n699\t            &mut eq_buffer,\n700\t            &mut layer,\n701\t            pq_size,\n702\t            lambda,\n703\t            transcript,\n704\t            &mut d_sum_evals,\n705\t            &mut tmp_block_sums,\n706\t            &mut round_polys_eval,\n707\t            &mut r_vec,\n708\t            &mut prev_s_eval,\n709\t            xi_prev[0],\n710\t            &mut eq_r_acc,\n711\t        )?;\n712\t\n713\t        // Fused rounds 1..(round-1): compute + fold using prev_r.\n714\t        let mut prev_r = r0;\n715\t        let active: &mut DeviceBuffer<Frac<EF>>;\n716\t\n717\t        match backend {\n718\t            GkrRoundStrategy::FoldEval => {\n719\t                // Existing fused path.\n720\t                let mut scheduler = BufferScheduler::new(max_work_size);\n721\t                for &xi_j in xi_prev.iter().skip(1) {\n722\t                    let src_pq_size = pq_size;\n723\t                    let post_fold_size = pq_size >> 1;\n724\t\n725\t                    let r = match scheduler.next_target(post_fold_size, last_outer_round) {\n726\t                        BufferTarget::LayerToWork => do_fused_sumcheck_round(\n727\t                            &mut eq_buffer,\n728\t                            &layer,\n729\t                            &mut work_buffer,\n730\t                            src_pq_size,\n731\t                            lambda,\n732\t                            prev_r,\n733\t                            transcript,\n734\t                            &mut d_sum_evals,\n735\t                            &mut tmp_block_sums,\n736\t                            &mut round_polys_eval,\n737\t                            &mut r