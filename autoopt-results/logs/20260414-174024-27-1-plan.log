&self.logup_combinations,\n1883\t                &mut logup_out,\n1884\t                &mut self.logup_tilde_evals,\n1885\t                self.memory_limit_bytes,\n1886\t            )\n1887\t            .map_err(LogupZerocheckError::MleInteractionEval)?;\n1888\t        }\n1889\t\n1890\t        // Early traces (num_y>1): partition by threshold for zerocheck path\n1891\t        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n1892\t            .iter()\n1893\t            .filter(|t| t.has_constraints)\n1894\t            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n1895\t\n1896\t        // Partition high num_y traces by monomial-to-rules ratio\n1897\t        // (traces without monomials are skipped - they contribute zero)\n1898\t        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n1899\t            high_early.iter().partition(|t| {\n1900\t                let num_monomials = get_num_monomials(t, self.pk);\n1901\t                let rules_len = get_zerocheck_rules_len(t, self.pk);\n1902\t                // Use DAG when monomial expansion significantly increased the term count\n1903\t                num_monomials as usize >= DAG_FALLBACK_MONOMIAL_RATIO * rules_len\n1904\t            });\n1905\t\n1906\t        // DAG evaluation for high num_y traces with high monomial-to-rules ratio\n1907\t        if !high_dag_traces.is_empty() {\n1908\t            let lambda_pows = self.lambda_pows.as_ref().unwrap();\n1909\t            evaluate_zerocheck_batched(\n1910\t                high_dag_traces,\n1911\t                self.pk,\n1912\t                lambda_pows,\n1913\t                sp_deg as u32,\n1914\t                &mut zc_out,\n1915\t                self.memory_limit_bytes,\n1916\t            )\n1917\t            .map_err(LogupZerocheckError::MleConstraintEval)?;\n1918\t        }\n1919\t\n1920\t        // Par-Y monomial kernel for high num_y traces\n1921\t        if !high_mono_traces.is_empty() {\n192