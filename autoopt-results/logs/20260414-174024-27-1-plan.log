5310000000 AND k.start < 6900000000\nORDER BY k.start\n''')\nrows = cur.fetchall()\nprint(f'\\\\nSeg0 frac sumcheck kernels ({len(rows)} total):')\nprint(f'  First: {rows[0][0]:.1f}ms  dur={rows[0][1]:.0f}us  {rows[0][2][:50]}')\nprint(f'  Last:  {rows[-1][0]:.1f}ms  dur={rows[-1][1]:.0f}us  {rows[-1][2][:50]}')\nprint(f'  Wall time: {rows[-1][0] - rows[0][0]:.1f}ms (first to last start)')\n\n# Count gaps > 100us between consecutive kernels\ngaps = []\nfor i in range(1, len(rows)):\n    gap = rows[i][0] - (rows[i-1][0] + rows[i-1][1]/1000)\n    gaps.append(gap)\ngaps.sort(reverse=True)\nprint(f'  Top 5 gaps between kernels: {[f\\\"{g:.1f}ms\\\" for g in gaps[:5]]}')\nprint(f'  Total gap time: {sum(gaps):.1f}ms')\nprint(f'  Mean gap: {sum(gaps)/len(gaps):.2f}ms')\n\n# Repeat for seg1\ncur.execute('''\nSELECT k.start/1e6 as s_ms, (k.end-k.start)/1e3 as dur_us, s.value\nFROM CUPTI_ACTIVITY_KIND_KERNEL k\nJOIN StringIds s ON k.shortName = s.id\nWHERE (s.value LIKE '%compute_round_and_revert%' OR s.value LIKE '%multifold%' OR s.value LIKE '%precompute_m_build%')\nAND k.start >= 7005000000 AND k.start < 7600000000\nORDER BY k.start\n''')\nrows = cur.fetchall()\nprint(f'\\\\nSeg1 frac sumcheck kernels ({len(rows)} total):')\nprint(f'  First: {rows[0][0]:.1f}ms  dur={rows[0][1]:.0f}us  {rows[0][2][:50]}')\nprint(f'  Last:  {rows[-1][0]:.1f}ms  dur={rows[-1][1]:.0f}us  {rows[-1][2][:50]}')\nprint(f'  Wall time: {rows[-1][0] - rows[0][0]:.1f}ms (first to last start)')\ngaps2 = []\nfor i in range(1, len(rows)):\n    gap = rows[i][0] - (rows[i-1][0] + rows[i-1][1]/1000)\n    gaps2.append(gap)\ngaps2.sort(reverse=True)\nprint(f'  Top 5 gaps: {[f\\\"{g:.1f}ms\\\" for g in gaps2[:5]]}')\nprint(f'  Total gap time: {sum(gaps2):.1f}ms')\nprint(f'  Mean gap: {sum(gaps2)/len(gaps2):.2f}ms')\n\nconn.close()\n\"","description":"Detailed per-segment fractional sumcheck analysis"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_token