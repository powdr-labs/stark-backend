mbs)?;\n1864\t            let out = batch\n1865\t                .evaluate(1)\n1866\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1867\t            let host = out.to_host()?;\n1868\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1869\t                self.zerocheck_tilde_evals[trace_idx] = host[i];\n1870\t                // zc_out not set for num_x=1, handled from tilde_eval in compute_batch_s\n1871\t            }\n1872\t        }\n1873\t\n1874\t        // Logup for early traces: partition by num_y threshold\n1875\t        if !early_eval.is_empty() {\n1876\t            evaluate_logup_batched(\n1877\t                &early_eval,\n1878\t                self.pk,\n1879\t                d_challenges_ptr,\n1880\t                sp_deg as u32,\n1881\t                self.monomial_num_y_threshold,\n1882\t                &self.logup_combinations,\n1883\t                &mut logup_out,\n1884\t                &mut self.logup_tilde_evals,\n1885\t                self.memory_limit_bytes,\n1886\t            )\n1887\t            .map_err(LogupZerocheckError::MleInteractionEval)?;\n1888\t        }\n1889\t\n1890\t        // Early traces (num_y>1): partition by threshold for zerocheck path\n1891\t        let (low_early, high_early): (Vec<&TraceCtx>, Vec<&TraceCtx>) = early_eval\n1892\t            .iter()\n1893\t            .filter(|t| t.has_constraints)\n1894\t            .partition(|t| t.num_y <= self.monomial_num_y_threshold);\n1895\t\n1896\t        // Partition high num_y traces by monomial-to-rules ratio\n1897\t        // (traces without monomials are skipped - they contribute zero)\n1898\t        let (high_dag_traces, high_mono_traces): (Vec<&TraceCtx>, Vec<&TraceCtx>) =\n1899\t            high_early.iter().partition(|t| {\n1900\t                let num_monomials = get_num_monomials(t, self.pk);\n1901\t                let rules_len = get_zerocheck_rules_len(t, self.pk);\n1902\t                // Use DAG when monomial expansion signif