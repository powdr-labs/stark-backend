{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JsoV9zGGCtzy8CjBtygvbU","type":"tool_result","content":"0\t//! GPU-accelerated duplex sponge with host/device state synchronization.\n1\t//!\n2\t//! This module provides [`DuplexSpongeGpu`], a transcript implementation that maintains\n3\t//! state on both host and device with explicit synchronization methods.\n4\t\n5\tuse std::ffi::c_void;\n6\t\n7\tuse openvm_cuda_common::{\n8\t    copy::cuda_memcpy,\n9\t    d_buffer::DeviceBuffer,\n10\t    error::{CudaError, MemCopyError},\n11\t};\n12\tuse openvm_stark_backend::{\n13\t    p3_challenger::{CanObserve, CanSample},\n14\t    FiatShamirTranscript, StarkProtocolConfig,\n15\t};\n16\tuse openvm_stark_sdk::config::baby_bear_poseidon2::poseidon2_perm;\n17\tuse p3_baby_bear::default_babybear_poseidon2_16;\n18\tuse p3_field::{PrimeCharacteristicRing, PrimeField32};\n19\tuse p3_symmetric::Permutation;\n20\t\n21\tuse crate::types::{Challenger, Digest, CHUNK, F, SC, WIDTH};\n22\t\n23\t/// Device-side sponge state, matching the CUDA `DeviceSpongeState` struct.\n24\t///\n25\t/// This struct is `#[repr(C)]` to ensure ABI compatibility with the CUDA kernel.\n26\t/// The state layout matches the Poseidon2 duplex sponge with overwrite mode.\n27\t///\n28\t/// This struct implements the same logic as `DuplexSponge` from openvm_stark_backend,\n29\t/// but with public fields so we can sync state to/from GPU.\n30\t#[repr(C)]\n31\t#[derive(Clone, Debug)]\n32\tpub struct DeviceSpongeState {\n33\t    /// Full Poseidon2 state (WIDTH = 16 elements)\n34\t    pub state: [F; WIDTH],\n35\t    /// Current absorb position (0 <= absorb_idx < CHUNK)\n36\t    pub absorb_idx: u32,\n37\t    /// Current sample position (0 <= sample_idx <= CHUNK)\n38\t    pub sample_idx: u32,\n39\t}\n40\t\n41\timpl Default for DeviceSpongeState {\n42\t    fn default() -> Self {\n43\t        Self {\n44\t            state: [F::default(); WIDTH],\n45\t            absorb_idx: 0,\n46\t            sample_idx: 0,\n47\t        }\n48\t    }\n49\t}\n50\t\n51\timpl DeviceSpongeState {\n52\t    /// Observe a value into the sponge (absorb phase).\n53\t    ///\n54\t    /// This matches the behavior of `DuplexSponge::observe`.\n55\t    #[inline]\n56\t    pub fn observe(&mut self, value: F) {\n57\t        self.state[self.absorb_idx as usize] = value;\n58\t        self.absorb_idx += 1;\n59\t        if self.absorb_idx == CHUNK as u32 {\n60\t            poseidon2_perm().permute_mut(&mut self.state);\n61\t            self.absorb_idx = 0;\n62\t            self.sample_idx = CHUNK as u32;\n63\t        }\n64\t    }\n65\t\n66\t    /// Sample a value from the sponge (squeeze phase).\n67\t    ///\n68\t    /// This matches the behavior of `DuplexSponge::sample`.\n69\t    #[inline]\n70\t    pub fn sample(&mut self) -> F {\n71\t        if self.absorb_idx != 0 || self.sample_idx == 0 {\n72\t            poseidon2_perm().permute_mut(&mut self.state);\n73\t            self.absorb_idx = 0;\n74\t            self.sample_idx = CHUNK as u32;\n75\t        }\n76\t        self.sample_idx -= 1;\n77\t        self.state[self.sample_idx as usize]\n78\t    }\n79\t}"}]},"parent_tool_use_id":"toolu_01Bk2X7Ug1SRvaG861UVxTFP","session_id":"e33616ae-361c-4ad4-bcb1-e94f2f710e44","uuid":"66984bb8-af67-4df4-bb37-22dc253abaef","timestamp":"2026-04-14T16:29:08.803Z"}
