{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UzprExrcpJJQjtyTC97b6g","type":"tool_result","content":"0\tuse super::*;\n1\tuse crate::{\n2\t    monomial::{InteractionMonomialTerm, LambdaTerm, MonomialHeader, PackedVar},\n3\t    poly::SqrtEqLayers,\n4\t};\n5\t\n6\t#[repr(C)]\n7\t#[derive(Clone, Copy, Debug)]\n8\tpub struct MainMatrixPtrs<T> {\n9\t    pub data: *const T,\n10\t    pub air_width: u32,\n11\t}\n12\t\n13\t// Types for batch MLE:\n14\t#[repr(C)]\n15\t#[derive(Clone, Copy, Debug)]\n16\tpub struct BlockCtx {\n17\t    pub local_block_idx_x: u32,\n18\t    /// Caution: this refers to the index within buffer of `ZerocheckCtx` or `LogupCtx`. It is\n19\t    /// hence a \"local\" AIR index and not the global AIR index within the proving key.\n20\t    pub air_idx: u32,\n21\t}\n22\t\n23\t/// Per-AIR context for batched monomial evaluation.\n24\t#[repr(C)]\n25\t#[derive(Clone, Copy, Debug)]\n26\tpub struct MonomialAirCtx {\n27\t    pub d_headers: *const MonomialHeader,\n28\t    pub d_variables: *const PackedVar,\n29\t    pub d_lambda_combinations: *const EF, // Precomputed per-monomial\n30\t    pub num_monomials: u32,\n31\t    pub eval_ctx: EvalCoreCtx,\n32\t    pub d_eq_xi: *const EF,\n33\t    pub num_y: u32,\n34\t}\n35\t\n36\t#[repr(C)]\n37\t#[derive(Clone, Copy, Debug)]\n38\tpub struct EvalCoreCtx {\n39\t    pub d_selectors: *const EF,\n40\t    pub d_preprocessed: MainMatrixPtrs<EF>,\n41\t    pub d_main: *const MainMatrixPtrs<EF>,\n42\t    pub d_public: *const F,\n43\t}\n44\t\n45\t#[repr(C)]\n46\t#[derive(Clone, Copy, Debug)]\n47\tpub struct ZerocheckCtx {\n48\t    pub eval_ctx: EvalCoreCtx,\n49\t    pub d_intermediates: *mut EF,\n50\t    pub num_y: u32,\n51\t    pub d_eq_xi: *const EF,\n52\t    pub d_rules: *const std::ffi::c_void,\n53\t    pub rules_len: usize,\n54\t    pub d_used_nodes: *const usize,\n55\t    pub used_nodes_len: usize,\n56\t    pub buffer_size: u32,\n57\t}\n58\t\n59\t#[repr(C)]\n60\t#[derive(Clone, Copy, Debug)]\n61\tpub struct LogupCtx {\n62\t    pub eval_ctx: EvalCoreCtx,\n63\t    pub d_intermediates: *mut EF,\n64\t    pub num_y: u32,\n65\t    pub d_eq_xi: *const EF,\n66\t    pub d_challenges: *const EF,\n67\t    pub d_eq_3bs: *const EF,\n68\t    pub d_rules: *const std::ffi::c_void,\n69\t    pub rules_len: usize,\n70\t    pub d_used_nodes: *const usize,\n71\t    pub d_pair_idxs: *const u32,\n72\t    pub used_nodes_len: usize,\n73\t    pub buffer_size: u32,\n74\t}\n75\t\n76\t/// Common per-AIR context for batched logup monomial evaluation.\n77\t#[repr(C)]\n78\t#[derive(Clone, Copy, Debug)]\n79\tpub struct LogupMonomialCommonCtx {"}]},"parent_tool_use_id":"toolu_01Bk2X7Ug1SRvaG861UVxTFP","session_id":"e33616ae-361c-4ad4-bcb1-e94f2f710e44","uuid":"4607154d-2415-432f-b334-9ec2a32c6ca1","timestamp":"2026-04-14T16:29:30.719Z"}
