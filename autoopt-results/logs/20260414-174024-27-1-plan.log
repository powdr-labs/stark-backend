rint(f'Seg0 MLE StreamSync calls: {row[0]}, CPU time: {row[1]:.1f}ms')\n\n# Kernel launches\ncur.execute('''\nSELECT COUNT(*), SUM(end-start)/1e6 as total_ms\nFROM CUPTI_ACTIVITY_KIND_RUNTIME\nWHERE nameId IN (SELECT id FROM StringIds WHERE value LIKE '%LaunchKernel%')\nAND start >= 5402000000000 AND start < 5620000000000\n''')\nrow = cur.fetchone()\nprint(f'Seg0 MLE LaunchKernel calls: {row[0]}, CPU time: {row[1]:.1f}ms')\n\n# Malloc/Free\ncur.execute('''\nSELECT COUNT(*), SUM(end-start)/1e6 as total_ms\nFROM CUPTI_ACTIVITY_KIND_RUNTIME\nWHERE nameId IN (SELECT id FROM StringIds WHERE value LIKE '%MallocAsync%' OR value LIKE '%FreeAsync%')\nAND start >= 5402000000000 AND start < 5620000000000\n''')\nrow = cur.fetchone()\nprint(f'Seg0 MLE Malloc/Free calls: {row[0]}, CPU time: {row[1]:.1f}ms')\n\nconn.close()\n\"","description":"Quantify MLE Rounds CUDA API overhead"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3383,"cache_read_input_tokens":157011,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3383},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e33616ae-361c-4ad4-bcb1-e94f2f710e44","uuid":"15737f63-48cc-4cff-9c5d-dcd237e05145"}
