                           w,\n947\t                                t,\n948\t                                eq_r_prefix_buffer.as_ptr(),\n949\t                                eq_suffix_buffer.as_ptr(),\n950\t                                d_sum_evals.as_mut_ptr(),\n951\t                            )\n952\t                            .map_err(FractionalSumcheckError::ComputeRound)?;\n953\t                        }\n954\t                        eq_buffer.drop_layer();\n955\t                        let r = observe_and_update(\n956\t                            &d_sum_evals,\n957\t                            transcript,\n958\t                            &mut round_polys_eval,\n959\t                            &mut r_vec,\n960\t                            &mut prev_s_eval,\n961\t                            xi_prev[base + t],\n962\t                            &mut eq_r_acc,\n963\t                        )?;\n964\t                        prev_r = r;\n965\t                        window_rs.push(r);\n966\t                    }\n967\t\n968\t                    // Compute eq_r_window for the multifold.\n969\t                    let (buf_vars, w_fold) = if pending_fold {\n970\t                        let mut all_rs = Vec::with_capacity(w + 1);\n971\t                        all_rs.push(r_fold);\n972\t                        all_rs.extend_from_slice(&window_rs);\n973\t                        eval_mle_table(&all_rs, &mut eq_r_window_host);\n974\t                        copy_to_device_ptr(d_eq_r_window, &eq_r_window_host[..(1 << (w + 1))])?;\n975\t                        (rem_n + 1, w + 1)\n976\t                    } else {\n977\t                        eval_mle_table(&window_rs, &mut eq_r_window_host);\n978\t                        copy_to_device_ptr(d_eq_r_window, &eq_r_window_host[..(1 << w)])?;\n979\t                        (rem_n, w)\n980\t                    };\n981\t\n982\t                    let multifold_src = if pending_fold {\n983\t                        layer_read_ptr\n984\t                    } else {\n985\t                        active_pq.as_ptr()\n986\t                    };\n987\t                    unsafe {\n988\t                        frac_multifold_raw(\n989\t                            multifold_src,\n990\t                            active_pq.as_mut_ptr(),\n991\t                            buf_vars,\n992\t                            w_fold,\n993\t                            d_eq_r_window,\n994\t                        )\n995\t                        .map_err(FractionalSumcheckError::FoldColumns)?;\n996\t                    }\n997\t                    pq_size >>= w_fold;\n998\t                    pending_fold = false;\n999\t                    base += w;"}]},"parent_tool_use_id":"toolu_01RAfV4P8puVUmVVW47UfM8T","session_id":"e33616ae-361c-4ad4-bcb1-e94f2f710e44","uuid":"56e72080-1736-4bd9-9e33-791356d9c24e","timestamp":"2026-04-14T16:38:02.516Z"}
