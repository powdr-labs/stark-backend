<< l_skip;\n1036\t            let num_x = 1u32 << n_lift;\n1037\t            let num_cosets_zc = local_constraint_deg.saturating_sub(1) as u32;\n1038\t            let num_cosets_logup = local_constraint_deg as u32;\n1039\t\n1040\t            // Pre-compute zerocheck buffer sizes\n1041\t            let zc_buffer_size = single_pk.other_data.zerocheck_round0.inner.buffer_size;\n1042\t            let zc_intermed_cap = if num_cosets_zc > 0 && !single_pk.vk.symbolic_constraints.constraints.constraint_idx.is_empty() {\n1043\t                unsafe {\n1044\t                    _zerocheck_r0_intermediates_buffer_size(\n1045\t                        zc_buffer_size, skip_domain, num_x, num_cosets_zc, per_thread_temp_bytes,\n1046\t                    )\n1047\t                }\n1048\t            } else {\n1049\t                0\n1050\t            };\n1051\t            let zc_temp_sums_cap = if num_cosets_zc > 0 && !single_pk.vk.symbolic_constraints.constraints.constraint_idx.is_empty() {\n1052\t                unsafe {\n1053\t                    _zerocheck_r0_temp_sums_buffer_size(\n1054\t                        zc_buffer_size, skip_domain, num_x, num_cosets_zc, per_thread_temp_bytes,\n1055\t                    )\n1056\t                }\n1057\t            } else {\n1058\t                0\n1059\t            };\n1060\t\n1061\t            // Pre-compute logup buffer sizes (using logup_round0_buffer_size from Step 1)\n1062\t            let logup_buffer_size = single_pk.other_data.logup_round0_buffer_size;\n1063\t            let has_interactions = !eq3b.is_empty();\n1064\t            let logup_intermed_cap = if has_interactions && logup_buffer_size > 0 {\n1065\t                unsafe {\n1066\t                    _logup_r0_intermediates_buffer_size(\n1067\t                        logup_buffer_size, skip_domain, num_x, num_cosets_logup, per_thread_temp_bytes,\n1068\t                    )\n1069\t                }\n1070\t            } else {"}]},"parent_tool_use_id":"toolu_01LqZEAzyS