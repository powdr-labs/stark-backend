{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014LVHp1MGN2dUCYmqPeP9Gf","type":"tool_result","content":"619\tpub unsafe fn frac_compute_round(\n620\t    eq_xi: &SqrtEqLayers,\n621\t    pq_buffer: &DeviceBuffer<Frac<EF>>,\n622\t    num_x: usize,\n623\t    lambda: EF,\n624\t    out_device: &mut DeviceBuffer<EF>,\n625\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n626\t) -> Result<(), CudaError> {\n627\t    let low_n = eq_xi.low_n();\n628\t    let high_n = eq_xi.high_n();\n629\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n630\t    debug_assert!(pq_buffer.len() >= 2 * num_x);\n631\t    #[cfg(debug_assertions)]\n632\t    {\n633\t        let len = tmp_block_sums.len();\n634\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n635\t        assert!(\n636\t            len >= required as usize,\n637\t            \"tmp_block_sums len={len} < required={required}\"\n638\t        );\n639\t    }\n640\t    CudaError::from_result(_frac_compute_round(\n641\t        eq_xi.low.get_ptr(low_n),\n642\t        eq_xi.high.get_ptr(high_n),\n643\t        pq_buffer.as_ptr(),\n644\t        num_x,\n645\t        1 << low_n,\n646\t        lambda,\n647\t        out_device.as_mut_ptr(),\n648\t        tmp_block_sums.as_mut_ptr(),\n649\t    ))\n650\t}\n651\t\n652\t/// Fused compute round + tree layer revert kernel.\n653\t///\n654\t/// Combines `frac_build_tree_layer(revert=true)` with `compute_round` for the first inner round.\n655\t/// The revert operation modifies `layer` in-place: `layer[i] = layer[i] - layer[i + half]` for `i <\n656\t/// half`.\n657\t///\n658\t/// This eliminates one kernel launch per outer round.\n659\t#[allow(clippy::too_many_arguments)]\n660\tpub unsafe fn frac_compute_round_and_revert(\n661\t    eq_xi: &SqrtEqLayers,\n662\t    layer: &mut DeviceBuffer<Frac<EF>>,\n663\t    num_x: usize,\n664\t    lambda: EF,\n665\t    out_device: &mut DeviceBuffer<EF>,\n666\t    tmp_block_sums: &mut DeviceBuffer<EF>,\n667\t) -> Result<(), CudaError> {\n668\t    let low_n = eq_xi.low_n();\n669\t    let high_n = eq_xi.high_n();\n670\t    debug_assert_eq!(2 << (low_n + high_n), num_x);\n671\t    #[cfg(debug_assertions)]\n672\t    {\n673\t        let len = tmp_block_sums.len();\n674\t        let required = _frac_compute_round_temp_buffer_size(num_x.try_into().unwrap());\n675\t        assert!(\n676\t            len >= required as usize,\n677\t            \"tmp_block_sums len={len} < required={required}\"\n678\t        );\n679\t        assert!(layer.len() >= 2 * num_x, \"layer too small for pq_size\");\n680\t    }\n681\t    CudaError::from_result(_frac_compute_round_and_revert(\n682\t        eq_xi.low.get_ptr(low_n),\n683\t        eq_xi.high.get_ptr(high_n),\n684\t        layer.as_mut_ptr(),\n685\t        num_x,\n686\t        1 << low_n,\n687\t        lambda,\n688\t        out_device.as_mut_ptr(),\n689\t        tmp_block_sums.as_mut_ptr(),\n690\t    ))\n691\t}\n692\t\n693\t/// Folds `Frac<EF>` buffer. Pairs (idx, idx+quarter) and (idx+half, idx+3*quarter),\n694\t/// writes results to dst[idx] and dst[idx+quarter]. Output size is `size / 2`.\n695\t/// Safe for src == dst (in-place) because each thread handles disjoint indices.\n696\tpub unsafe fn fold_ef_frac_columns(\n697\t    src: &DeviceBuffer<Frac<EF>>,\n698\t    dst: &mut DeviceBuffer<Frac<EF>>,"}]},"parent_tool_use_id":"toolu_01LqZEAzySQ6DL5ByEqkfKgi","session_id":"e33616ae-361c-4ad4-bcb1-e94f2f710e44","uuid":"0a81f39b-6525-425b-b0ea-f0377f0b2c3f","timestamp":"2026-04-14T15:47:38.731Z"}
