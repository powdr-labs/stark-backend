{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ewVCneQwD23y1h9mXvqHt","type":"tool_result","content":"1\t//! GPU-accelerated duplex sponge with host/device state synchronization.\n2\t//!\n3\t//! This module provides [`DuplexSpongeGpu`], a transcript implementation that maintains\n4\t//! state on both host and device with explicit synchronization methods.\n5\t\n6\tuse std::ffi::c_void;\n7\t\n8\tuse openvm_cuda_common::{\n9\t    copy::cuda_memcpy,\n10\t    d_buffer::DeviceBuffer,\n11\t    error::{CudaError, MemCopyError},\n12\t};\n13\tuse openvm_stark_backend::{\n14\t    p3_challenger::{CanObserve, CanSample},\n15\t    FiatShamirTranscript, StarkProtocolConfig,\n16\t};\n17\tuse openvm_stark_sdk::config::baby_bear_poseidon2::poseidon2_perm;\n18\tuse p3_baby_bear::default_babybear_poseidon2_16;\n19\tuse p3_field::{PrimeCharacteristicRing, PrimeField32};\n20\tuse p3_symmetric::Permutation;\n21\t\n22\tuse crate::types::{Challenger, Digest, CHUNK, F, SC, WIDTH};\n23\t\n24\t/// Device-side sponge state, matching the CUDA `DeviceSpongeState` struct.\n25\t///\n26\t/// This struct is `#[repr(C)]` to ensure ABI compatibility with the CUDA kernel.\n27\t/// The state layout matches the Poseidon2 duplex sponge with overwrite mode.\n28\t///\n29\t/// This struct implements the same logic as `DuplexSponge` from openvm_stark_backend,\n30\t/// but with public fields so we can sync state to/from GPU.\n31\t#[repr(C)]\n32\t#[derive(Clone, Debug)]\n33\tpub struct DeviceSpongeState {\n34\t    /// Full Poseidon2 state (WIDTH = 16 elements)\n35\t    pub state: [F; WIDTH],\n36\t    /// Current absorb position (0 <= absorb_idx < CHUNK)\n37\t    pub absorb_idx: u32,\n38\t    /// Current sample position (0 <= sample_idx <= CHUNK)\n39\t    pub sample_idx: u32,\n40\t}\n41\t\n42\timpl Default for DeviceSpongeState {\n43\t    fn default() -> Self {\n44\t        Self {\n45\t            state: [F::default(); WIDTH],\n46\t            absorb_idx: 0,\n47\t            sample_idx: 0,\n48\t        }\n49\t    }\n50\t}\n51\t\n52\timpl DeviceSpongeState {\n53\t    /// Observe a value into the sponge (absorb phase).\n54\t    ///\n55\t    /// This matches the behavior of `DuplexSponge::observe`.\n56\t    #[inline]\n57\t    pub fn observe(&mut self, value: F) {\n58\t        self.state[self.absorb_idx as usize] = value;\n59\t        self.absorb_idx += 1;\n60\t        if self.absorb_idx == CHUNK as u32 {\n61\t            poseidon2_perm().permute_mut(&mut self.state);\n62\t            self.absorb_idx = 0;\n63\t            self.sample_idx = CHUNK as u32;\n64\t        }\n65\t    }\n66\t\n67\t    /// Sample a value from the sponge (squeeze phase).\n68\t    ///\n69\t    /// This matches the behavior of `DuplexSponge::sample`.\n70\t    #[inline]\n71\t    pub fn sample(&mut self) -> F {\n72\t        if self.absorb_idx != 0 || self.sample_idx == 0 {\n73\t            poseidon2_perm().permute_mut(&mut self.state);\n74\t            self.absorb_idx = 0;\n75\t            self.sample_idx = CHUNK as u32;\n76\t        }\n77\t        self.sample_idx -= 1;\n78\t        self.state[self.sample_idx as usize]\n79\t    }\n80\t}\n81\t\n82\timpl FiatShamirTranscript<SC> for DeviceSpongeState {\n83\t    #[inline]\n84\t    fn observe(&mut self, value: F) {\n85\t        DeviceSpongeState::observe(self, value);\n86\t    }\n87\t\n88\t    #[inline]\n89\t    fn sample(&mut self) -> F {\n90\t        DeviceSpongeState::sample(self)\n91\t    }\n92\t\n93\t    #[inline]\n94\t    fn observe_commit(&mut self, digest: Digest) {\n95\t        for x in digest {\n96\t            self.observe(x);\n97\t        }\n98\t    }\n99\t}\n100\t\n101\t/// GPU-accelerated duplex sponge that maintains state on both host and device.\n102\t///\n103\t/// The host-side state uses [`DeviceSpongeState`] which matches the behavior of\n104\t/// `DuplexSponge` from openvm_stark_backend (and `p3_challenger::DuplexChallenger`).\n105\t/// The device-side state is stored in GPU memory for CUDA kernel operations.\n106\t///\n107\t/// # State Synchronization\n108\t///\n109\t/// The host and device states are **independent** and must be explicitly synchronized:\n110\t/// - Use [`sync_h2d`](Self::sync_h2d) to copy host state to device before GPU operations\n111\t/// - Use [`sync_d2h`](Self::sync_d2h) to copy device state back to host after GPU operations\n112\t///\n113\t/// # Usage Example\n114\t///\n115\t/// ```ignore\n116\t/// let mut sponge = DuplexSpongeGpu::default();\n117\t///\n118\t/// // Do some host operations\n119\t/// sponge.observe(some_value);\n120\t/// let challenge = sponge.sample();\n121\t///\n122\t/// // Sync to device before GPU grinding\n123\t/// sponge.sync_h2d()?;\n124\t///\n125\t/// // ... GPU grinding kernel runs ...\n126\t///\n127\t/// // Sync back after GPU modifies state\n128\t/// sponge.sync_d2h()?;\n129\t///\n130\t/// // Continue with host operations\n131\t/// let next_challenge = sponge.sample();\n132\t/// ```\n133\t#[derive(Debug)]\n134\tpub struct DuplexSpongeGpu {\n135\t    /// Host-side structure\n136\t    host: Challenger,\n137\t    /// Device-side state buffer (allocated lazily on first sync)\n138\t    device: DeviceBuffer<DeviceSpongeState>,\n139\t}\n140\t\n141\timpl Default for DuplexSpongeGpu {\n142\t    fn default() -> Self {\n143\t        Self::new()\n144\t    }\n145\t}\n146\t\n147\timpl Clone for DuplexSpongeGpu {\n148\t    fn clone(&self) -> Self {\n149\t        let mut new = Self {\n150\t            host: self.host.clone(),\n151\t            device: DeviceBuffer::new(),\n152\t        };\n153\t        // Sync cloned host state to device if device was allocated\n154\t        if !self.device.is_empty() {\n155\t            let _ = new.sync_h2d();\n156\t        }\n157\t        new\n158\t    }\n159\t}\n160\t\n161\timpl DuplexSpongeGpu {\n162\t    /// Create a new GPU-accelerated duplex sponge with default (zeroed) state.\n163\t    pub fn new() -> Self {\n164\t        Self {\n165\t            host: Challenger::new(default_babybear_poseidon2_16()),\n166\t            device: DeviceBuffer::new(),\n167\t        }\n168\t    }\n169\t\n170\t    /// Returns true if the device buffer has been allocated.\n171\t    pub fn is_device_allocated(&self) -> bool {\n172\t        !self.device.is_empty()\n173\t    }\n174\t\n175\t    /// Ensure the device buffer is allocated.\n176\t    fn ensure_device_allocated(&mut self) {\n177\t        if self.device.is_empty() {\n178\t            self.device = DeviceBuffer::with_capacity(1);\n179\t        }\n180\t    }\n181\t\n182\t    /// Synchronize state from host to device (H2D memcpy).\n183\t    ///\n184\t    /// Call this before running GPU kernels that read/modify the sponge state.\n185\t    ///\n186\t    /// This converts from `DuplexChallenger`'s representation (with buffered input/output)\n187\t    /// to `DeviceSpongeState`'s representation (with indices pointing into state).\n188\t    pub fn sync_h2d(&mut self) -> Result<(), MemCopyError> {\n189\t        self.ensure_device_allocated();\n190\t\n191\t        // Convert DuplexChallenger state to DeviceSpongeState format:\n192\t        // - DuplexChallenger buffers input values before writing to sponge_state\n193\t        // - DeviceSpongeState writes directly to state[absorb_idx]\n194\t        // We need to overlay the input_buffer onto state[0..len]\n195\t\n196\t        let mut device_state = DeviceSpongeState {\n197\t            state: self.host.sponge_state,\n198\t            absorb_idx: self.host.input_buffer.len() as u32,\n199\t            sample_idx: self.host.output_buffer.len() as u32,\n200\t        };\n201\t\n202\t        // Overlay pending input_buffer values onto the beginning of state\n203\t        // (DuplexChallenger writes to state[0..N] during duplexing, so pending\n204\t        // values that haven't been duplexed yet need to be placed there)\n205\t        for (i, &val) in self.host.input_buffer.iter().enumerate() {\n206\t            device_state.state[i] = val;\n207\t        }\n208\t\n209\t        // SAFETY: Copying a single DeviceSpongeState from host to device\n210\t        // - Both pointers are valid and properly aligned\n211\t        // - The size matches the struct size\n212\t        unsafe {\n213\t            cuda_memcpy::<false, true>(\n214\t                self.device.as_mut_ptr() as *mut c_void,\n215\t                &device_state as *const DeviceSpongeState as *const c_void,\n216\t                std::mem::size_of::<DeviceSpongeState>(),\n217\t            )\n218\t        }\n219\t    }\n220\t\n221\t    /// Get a pointer to the device state buffer.\n222\t    ///\n223\t    /// Returns `None` if the device buffer hasn't been allocated yet.\n224\t    /// Call [`sync_h2d`](Self::sync_h2d) to allocate and initialize the device buffer.\n225\t    pub fn device_ptr(&self) -> Option<*const DeviceSpongeState> {\n226\t        if self.device.is_empty() {\n227\t            None\n228\t        } else {\n229\t            Some(self.device.as_ptr())\n230\t        }\n231\t    }\n232\t\n233\t    /// Get a mutable pointer to the device state buffer.\n234\t    ///\n235\t    /// Returns `None` if the device buffer hasn't been allocated yet.\n236\t    /// Call [`sync_h2d`](Self::sync_h2d) to allocate and initialize the device buffer.\n237\t    pub fn device_ptr_mut(&mut self) -> Option<*mut DeviceSpongeState> {\n238\t        if self.device.is_empty() {\n239\t            None\n240\t        } else {\n241\t            Some(self.device.as_mut_ptr())\n242\t        }\n243\t    }\n244\t\n245\t    /// Perform GPU-accelerated grinding to find a proof-of-work witness.\n246\t    ///\n247\t    /// This syncs state to device, runs the grinding kernel, and updates\n248\t    /// the host state with the witness.\n249\t    ///\n250\t    /// # Arguments\n251\t    /// * `bits` - Number of bits that must be zero in the sampled value\n252\t    ///\n253\t    /// # Returns\n254\t    ///\n255\t    /// The PoW witness value that satisfies `sample_bits(bits) == 0` after observing it.\n256\t    ///\n257\t    /// # Note\n258\t    ///\n259\t    /// After this call, the host state will have observed the witness and sampled,\n260\t    /// matching the state after calling `check_witness(bits, witness)`.\n261\t    pub fn grind_gpu(&mut self, bits: usize) -> Result<F, GrindError> {\n262\t        // Trivial case: 0 bits mean no PoW is required and any witness is valid.\n263\t        if bits == 0 {\n264\t            return Ok(F::ZERO);\n265\t        }\n266\t        // 1. Sync host state to device\n267\t        self.sync_h2d()?;\n268\t\n269\t        // 2. Launch grinding kernel\n270\t        let witness_u32 = unsafe {\n271\t            crate::cuda::sponge::sponge_grind(self.device.as_ptr(), bits as u32, F::ORDER_U32 - 1)?\n272\t        };\n273\t\n274\t        let witness = F::from_u32(witness_u32);\n275\t\n276\t        // 3. Update host state to match (observe the witness + sample)\n277\t        // This is cheaper than syncing the full state back from device\n278\t        debug_assert!(self.clone().check_witness(bits, witness));\n279\t        self.host.observe(witness);\n280\t        let _: F = self.host.sample(); // Consume the sample to advance state\n281\t\n282\t        Ok(witness)\n283\t    }\n284\t}\n285\t\n286\t/// Error type for GPU grinding operations.\n287\t#[derive(Debug, thiserror::Error)]\n288\tpub enum GrindError {\n289\t    #[error(\"Memory copy error: {0}\")]\n290\t    MemCopy(#[from] MemCopyError),\n291\t\n292\t    #[error(\"CUDA error: {0}\")]\n293\t    Cuda(#[from] CudaError),\n294\t\n295\t    #[error(\"Failed to find PoW witness within search space\")]\n296\t    WitnessNotFound,\n297\t}\n298\t\n299\timpl FiatShamirTranscript<SC> for DuplexSpongeGpu {\n300\t    #[inline]\n301\t    fn observe(&mut self, value: F) {\n302\t        self.host.observe(value);\n303\t    }\n304\t\n305\t    #[inline]\n306\t    fn sample(&mut self) -> F {\n307\t        self.host.sample()\n308\t    }\n309\t\n310\t    #[inline]\n311\t    fn observe_commit(&mut self, digest: Digest) {\n312\t        for x in digest {\n313\t            self.observe(x);\n314\t        }\n315\t    }\n316\t}\n317\t\n318\t/// Marker trait for GPU-compatible Fiat-Shamir transcripts.\n319\t///\n320\t/// Extends [`FiatShamirTranscript`] with a GPU-accelerated proof-of-work grind method.\n321\t/// Implementers maintain a device-side state buffer and can off-load the grinding loop\n322\t/// to a CUDA kernel.\n323\tpub trait GpuFiatShamirTranscript<Config: StarkProtocolConfig>:\n324\t    FiatShamirTranscript<Config>\n325\t{\n326\t    /// GPU-accelerated proof-of-work grinding.\n327\t    ///\n328\t    /// Finds a witness value `w` of type `Config::F` such that after observing `w` and\n329\t    /// sampling, the result has `bits` trailing zero bits.  Implementations should sync\n330\t    /// host state to device, launch a CUDA grinding kernel, then update the host state\n331\t    /// to match (observe witness + consume one sample).\n332\t    fn grind_gpu(&mut self, bits: usize) -> Result<Config::F, GrindError>;\n333\t}\n334\t\n335\timpl GpuFiatShamirTranscript<SC> for DuplexSpongeGpu {\n336\t    fn grind_gpu(&mut self, bits: usize) -> Result<F, GrindError> {\n337\t        DuplexSpongeGpu::grind_gpu(self, bits)\n338\t    }\n339\t}\n340\t\n341\t#[cfg(test)]\n342\tmod tests {\n343\t    use std::time::Instant;\n344\t\n345\t    use openvm_stark_sdk::config::baby_bear_poseidon2::default_duplex_sponge;\n346\t    use p3_field::PrimeCharacteristicRing;\n347\t\n348\t    use super::*;\n349\t    use crate::prelude::SC;\n350\t\n351\t    #[test]\n352\t    fn test_device_sponge_state_size() {\n353\t        // Verify the struct size is what we expect for FFI\n354\t        let expected_size = std::mem::size_of::<[F; WIDTH]>() // state\n355\t            + std::mem::size_of::<u32>() // absorb_idx\n356\t            + std::mem::size_of::<u32>(); // sample_idx\n357\t\n358\t        assert_eq!(\n359\t            std::mem::size_of::<DeviceSpongeState>(),\n360\t            expected_size,\n361\t            \"DeviceSpongeState size mismatch - check repr(C) and padding\"\n362\t        );\n363\t    }\n364\t\n365\t    #[test]\n366\t    fn test_device_sponge_state_alignment() {\n367\t        // Verify alignment for CUDA compatibility\n368\t        assert!(\n369\t            std::mem::align_of::<DeviceSpongeState>() >= 4,\n370\t            \"DeviceSpongeState should be at least 4-byte aligned\"\n371\t        );\n372\t    }\n373\t\n374\t    #[test]\n375\t    fn test_default_state() {\n376\t        let state = DeviceSpongeState::default();\n377\t        assert_eq!(state.absorb_idx, 0);\n378\t        assert_eq!(state.sample_idx, 0);\n379\t        for elem in state.state.iter() {\n380\t            assert_eq!(*elem, F::default());\n381\t        }\n382\t    }\n383\t\n384\t    #[test]\n385\t    fn test_sponge_gpu_new() {\n386\t        let sponge = DuplexSpongeGpu::new();\n387\t        assert!(!sponge.is_device_allocated());\n388\t    }\n389\t\n390\t    #[test]\n391\t    fn test_device_sponge_state_matches_duplex_sponge() {\n392\t        // Verify our implementation matches DuplexSponge exactly\n393\t        let mut device_state = DeviceSpongeState::default();\n394\t        let mut duplex_sponge = default_duplex_sponge();\n395\t\n396\t        // Test observe/sample sequence\n397\t        for i in 0..20 {\n398\t            let val = F::from_u32(i * 42 + 17);\n399\t            device_state.observe(val);\n400\t            FiatShamirTranscript::<SC>::observe(&mut duplex_sponge, val);\n401\t        }\n402\t\n403\t        for _ in 0..10 {\n404\t            let device_sample = device_state.sample();\n405\t            let duplex_sample = FiatShamirTranscript::<SC>::sample(&mut duplex_sponge);\n406\t            assert_eq!(device_sample, duplex_sample);\n407\t        }\n408\t\n409\t        // Interleaved observe/sample\n410\t        for i in 0..5 {\n411\t            let val = F::from_u32(i * 100);\n412\t            device_state.observe(val);\n413\t            FiatShamirTranscript::<SC>::observe(&mut duplex_sponge, val);\n414\t\n415\t            let device_sample = device_state.sample();\n416\t            let duplex_sample = FiatShamirTranscript::<SC>::sample(&mut duplex_sponge);\n417\t            assert_eq!(device_sample, duplex_sample);\n418\t        }\n419\t\n420\t        // Many samples in a row\n421\t        for _ in 0..15 {\n422\t            let device_sample = device_state.sample();\n423\t            let duplex_sample = FiatShamirTranscript::<SC>::sample(&mut duplex_sponge);\n424\t            assert_eq!(device_sample, duplex_sample);\n425\t        }\n426\t    }\n427\t\n428\t    #[test]\n429\t    fn test_sponge_gpu_uses_host_transcript() {\n430\t        let mut gpu_sponge = DuplexSpongeGpu::default();\n431\t        let mut cpu_sponge = default_duplex_sponge();\n432\t\n433\t        // Test that host operations match DuplexSponge\n434\t        for i in 0..10 {\n435\t            let val = F::from_u32(i * 42 + 17);\n436\t            gpu_sponge.observe(val);\n437\t            FiatShamirTranscript::<SC>::observe(&mut cpu_sponge, val);\n438\t        }\n439\t\n440\t        for _ in 0..5 {\n441\t            let gpu_sample = gpu_sponge.sample();\n442\t            let cpu_sample = FiatShamirTranscript::<SC>::sample(&mut cpu_sponge);\n443\t            assert_eq!(gpu_sample, cpu_sample);\n444\t        }\n445\t    }\n446\t\n447\t    /// Benchmark test comparing CPU vs GPU grinding performance.\n448\t    ///\n449\t    /// Run with: `cargo test -p openvm-cuda-backend test_grind_cpu_vs_gpu -- --nocapture`\n450\t    ///\n451\t    /// Note: GPU has ~20ms fixed overhead for kernel launch + sync. CPU wins for\n452\t    /// small search spaces (low bit counts). GPU wins for larger search spaces\n453\t    /// where parallelism amortizes the overhead.\n454\t    #[test]\n455\t    fn test_grind_cpu_vs_gpu() {\n456\t        // Warmup: run one GPU grind to initialize CUDA context\n457\t        {\n458\t            let mut warmup = DuplexSpongeGpu::default();\n459\t            let _ = warmup.grind_gpu(8);\n460\t        }\n461\t\n462\t        // Test multiple bit counts to see scaling\n463\t        let bit_counts = [8, 12, 16, 18, 20]\n464\t            .iter()\n465\t            .flat_map(|x| std::iter::repeat_n(*x, 5))\n466\t            .collect::<Vec<_>>();\n467\t\n468\t        eprintln!(\"\\n{}\", \"=\".repeat(60));\n469\t        eprintln!(\"Grinding Performance: CPU vs GPU\");\n470\t        eprintln!(\"{}\", \"=\".repeat(60));\n471\t        eprintln!(\n472\t            \"{:>6} {:>12} {:>12} {:>10}\",\n473\t            \"bits\", \"CPU (ms)\", \"GPU (ms)\", \"speedup\"\n474\t        );\n475\t        eprintln!(\"{:->6} {:->12} {:->12} {:->10}\", \"\", \"\", \"\", \"\");\n476\t\n477\t        let mut seed = 265;\n478\t        for bits in bit_counts {\n479\t            let mut cpu_sponge = default_duplex_sponge();\n480\t            let mut gpu_sponge = DuplexSpongeGpu::default();\n481\t\n482\t            // Add some initial state\n483\t            for _ in 0..5 {\n484\t                let val = F::from_u32(seed);\n485\t                seed += 228;\n486\t                FiatShamirTranscript::<SC>::observe(&mut cpu_sponge, val);\n487\t                gpu_sponge.observe(val);\n488\t            }\n489\t\n490\t            // Time CPU grinding\n491\t            let cpu_start = Instant::now();\n492\t            let cpu_witness = FiatShamirTranscript::<SC>::grind(&mut cpu_sponge, bits);\n493\t            let cpu_time = cpu_start.elapsed();\n494\t\n495\t            // Time GPU grinding\n496\t            let gpu_start = Instant::now();\n497\t            let gpu_witness = gpu_sponge.grind_gpu(bits).expect(\"GPU grinding failed\");\n498\t            let gpu_time = gpu_start.elapsed();\n499\t\n500\t            // Verify both found valid witnesses (witnesses may differ but both should be valid)\n501\t            // We already validated inside grind_gpu with debug_assert\n502\t\n503\t            let speedup = cpu_time.as_secs_f64() / gpu_time.as_secs_f64();\n504\t\n505\t            eprintln!(\n506\t                \"{:>6} {:>12.2} {:>12.2} {:>10.2}x\",\n507\t                bits,\n508\t                cpu_time.as_secs_f64() * 1000.0,\n509\t                gpu_time.as_secs_f64() * 1000.0,\n510\t                speedup\n511\t            );\n512\t\n513\t            // Verify the witnesses are valid by checking with a fresh sponge\n514\t            // (grind() and grind_gpu() already do this internally via check_witness)\n515\t            let _ = (cpu_witness, gpu_witness); // suppress unused warnings\n516\t        }\n517\t\n518\t        eprintln!(\"{}\\n\", \"=\".repeat(60));\n519\t    }\n520\t}\n521\t"}]},"parent_tool_use_id":"toolu_018d7aaZfiYC2rMye6NqePyf","session_id":"e33616ae-361c-4ad4-bcb1-e94f2f710e44","uuid":"b9221f90-61b2-4f63-87d6-543ed7a459ab","timestamp":"2026-04-14T16:24:03.408Z"}
