r * interpolated_height),\n1788\t                    air_width: air_width_for_mat(meta.need_rot, mats[0].width()),\n1789\t                }\n1790\t            } else {\n1791\t                MainMatrixPtrs {\n1792\t                    data: std::ptr::null(),\n1793\t                    air_width: 0,\n1794\t                }\n1795\t            };\n1796\t            if meta.has_preprocessed {\n1797\t                widths_so_far += mats[0].width();\n1798\t            }\n1799\t            let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1800\t                .iter()\n1801\t                .map(|m| {\n1802\t                    let main_ptr = MainMatrixPtrs {\n1803\t                        data: base_ptr.wrapping_add(widths_so_far * interpolated_height),\n1804\t                        air_width: air_width_for_mat(meta.need_rot, m.width()),\n1805\t                    };\n1806\t                    widths_so_far += m.width();\n1807\t                    main_ptr\n1808\t                })\n1809\t                .collect_vec();\n1810\t            debug_assert_eq!(widths_so_far, meta.num_columns);\n1811\t            let main_ptrs_dev = main_ptrs.to_device()?;\n1812\t\n1813\t            early_eval.push(TraceCtx {\n1814\t                trace_idx: meta.trace_idx,\n1815\t                air_idx: meta.air_idx,\n1816\t                n_lift: meta.n_lift,\n1817\t                num_y: meta.num_y as u32,\n1818\t                has_constraints: meta.has_constraints,\n1819\t                has_interactions: meta.has_interactions,\n1820\t                norm_factor: meta.norm_factor,\n1821\t                eq_xi_ptr: eq_xi_tree.get_ptr(log_num_y),\n1822\t                sels_ptr,\n1823\t                prep_ptr,\n1824\t                main_ptrs_dev,\n1825\t                public_ptr: self.public_values_per_trace[meta.trace_idx].as_ptr(),\n1826\t                eq_3bs_ptr: self.d_eq_3b_per_trace[meta.trace_idx].as_ptr(),\n1827\t            });\n1828\t        }\n1829\t"}]},"