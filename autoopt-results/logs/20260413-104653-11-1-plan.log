{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JJ7TQSew1cXRJhQGVrdP2n","type":"tool_result","content":"1100\t        Ok(())\n1101\t    }\n1102\t\n1103\t    #[instrument(\n1104\t        name = \"LogupZerocheck::sumcheck_polys_batch_eval\",\n1105\t        level = \"info\",\n1106\t        skip_all,\n1107\t        fields(round = round)\n1108\t    )]\n1109\t    fn sumcheck_polys_batch_eval(\n1110\t        &mut self,\n1111\t        round: usize,\n1112\t        r_prev: EF,\n1113\t    ) -> Result<Vec<Vec<EF>>, LogupZerocheckError> {\n1114\t        let sp_deg = self.constraint_degree;\n1115\t\n1116\t        // Per-trace outputs (filled as we go)\n1117\t        let mut zc_out: Vec<Vec<EF>> = vec![vec![EF::ZERO; sp_deg]; self.n_per_trace.len()];\n1118\t        let mut logup_out: Vec<[Vec<EF>; 2]> =\n1119\t            vec![[vec![EF::ZERO; sp_deg], vec![EF::ZERO; sp_deg]]; self.n_per_trace.len()];\n1120\t\n1121\t        // Keep early interpolations alive for duration of kernels\n1122\t        let mut _keepalive_interpolated: Vec<DeviceMatrix<EF>> = Vec::new();\n1123\t\n1124\t        let mut late_eval: Vec<TraceCtx> = Vec::new(); // round == n_lift + 1\n1125\t        let mut early_eval: Vec<TraceCtx> = Vec::new(); // round <= n_lift\n1126\t\n1127\t        // First, handle traces in original order and split into cases\n1128\t        for (trace_idx, (&n, mats, sels, eq_3bs, public_vals, &air_idx)) in izip!(\n1129\t            self.n_per_trace.iter(),\n1130\t            self.mat_evals_per_trace.iter(),\n1131\t            self.sels_per_trace.iter(),\n1132\t            self.d_eq_3b_per_trace.iter(),\n1133\t            self.public_values_per_trace.iter(),\n1134\t            self.air_indices_per_trace.iter()\n1135\t        )\n1136\t        .enumerate()\n1137\t        {\n1138\t            let pk = &self.pk.per_air[air_idx];\n1139\t            let dag = &pk.vk.symbolic_constraints;\n1140\t            let has_constraints = dag.constraints.num_constraints() > 0;\n1141\t            let has_interactions = !dag.interactions.is_empty();\n1142\t            if !has_constraints && !has_interactions {\n1143\t                continue;\n1144\t            }\n1145\t\n1146\t            let n_lift = n.max(0) as usize;\n1147\t            let norm_factor_denom = 1 << (-n).max(0);\n1148\t            let norm_factor = F::from_usize(norm_factor_denom).inverse();\n1149\t            let has_preprocessed = pk.preprocessed_data.is_some();\n1150\t            let need_rot = pk.vk.params.need_rot;\n1151\t            let first_main_idx = usize::from(has_preprocessed);\n1152\t            let eq_xi_tree = &self.eq_xis[&n_lift];\n1153\t\n1154\t            if round > n_lift {\n1155\t                // Case A\n1156\t                if round == n_lift + 1 {\n1157\t                    // A.1: evaluate directly at (num_x=1, num_y=1)\n1158\t                    let prep_ptr = if has_preprocessed {\n1159\t                        MainMatrixPtrs {\n1160\t                            data: mats[0].buffer().as_ptr(),\n1161\t                            air_width: air_width_for_mat(need_rot, mats[0].width()),\n1162\t                        }\n1163\t                    } else {\n1164\t                        MainMatrixPtrs {\n1165\t                            data: std::ptr::null(),\n1166\t                            air_width: 0,\n1167\t                        }\n1168\t                    };\n1169\t                    let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1170\t                        .iter()\n1171\t                        .map(|m| MainMatrixPtrs {\n1172\t                            data: m.buffer().as_ptr(),\n1173\t                            air_width: air_width_for_mat(need_rot, m.width()),\n1174\t                        })\n1175\t                        .collect_vec();\n1176\t                    let main_ptrs_dev = main_ptrs.to_device()?;\n1177\t\n1178\t                    late_eval.push(TraceCtx {\n1179\t                        trace_idx,\n1180\t                        air_idx,\n1181\t                        n_lift,\n1182\t                        num_y: 1,\n1183\t                        has_constraints,\n1184\t                        has_interactions,\n1185\t                        norm_factor,\n1186\t                        eq_xi_ptr: eq_xi_tree.get_ptr(0),\n1187\t                        sels_ptr: sels.buffer().as_ptr(),\n1188\t                        prep_ptr,\n1189\t                        main_ptrs_dev,\n1190\t                        public_ptr: public_vals.as_ptr(),\n1191\t                        eq_3bs_ptr: eq_3bs.as_ptr(),\n1192\t                    });\n1193\t                } else {\n1194\t                    // A.2: scale tilde evals only\n1195\t                    if has_constraints {\n1196\t                        let tilde_eval = &mut self.zerocheck_tilde_evals[trace_idx];\n1197\t                        *tilde_eval *= r_prev;\n1198\t                        // zc_out not set, will be handled directly from tilde eval in\n1199\t                        // compute_batch_s\n1200\t                    }\n1201\t                    if has_interactions {\n1202\t                        for x in self.logup_tilde_evals[trace_idx].iter_mut() {\n1203\t                            *x *= r_prev;\n1204\t                        }\n1205\t                        // logup_out not set, will be handled directly from tilde eval in\n1206\t                        // compute_batch_s\n1207\t                    }\n1208\t                }\n1209\t            } else {\n1210\t                // Case B: interpolate columns and evaluate (num_x = s_deg, num_y = height/2)\n1211\t                let log_num_y = n_lift - round;\n1212\t                let num_y = 1 << log_num_y;\n1213\t                let height = 2 * num_y;\n1214\t                debug_assert_eq!(height, mats[0].height());\n1215\t\n1216\t                let mut columns: Vec<*const EF> = Vec::new();\n1217\t                columns.extend(\n1218\t                    iter::once(sels)\n1219\t                        .chain(mats.iter())\n1220\t                        .flat_map(|m| {\n1221\t                            assert_eq!(m.height(), height);\n1222\t                            (0..m.width())\n1223\t                                .map(|col| m.buffer().as_ptr().wrapping_add(col * m.height()))\n1224\t                        })\n1225\t                        .collect_vec(),\n1226\t                );\n1227\t                let interpolated = DeviceMatrix::<EF>::with_capacity(sp_deg * num_y, columns.len());\n1228\t                let d_columns = columns.to_device()?;\n1229\t                unsafe {\n1230\t                    interpolate_columns_gpu(interpolated.buffer(), &d_columns, sp_deg, num_y)\n1231\t                        .map_err(|e| LogupZerocheckError::InterpolateColumns(e.into()))?;\n1232\t                }\n1233\t\n1234\t                let interpolated_height = interpolated.height();\n1235\t                let mut widths_so_far = 0usize;\n1236\t                let sels_ptr = interpolated\n1237\t                    .buffer()\n1238\t                    .as_ptr()\n1239\t                    .wrapping_add(widths_so_far * interpolated_height);\n1240\t                widths_so_far += 3;\n1241\t                let prep_ptr = if has_preprocessed {\n1242\t                    MainMatrixPtrs {\n1243\t                        data: interpolated\n1244\t                            .buffer()\n1245\t                            .as_ptr()\n1246\t                            .wrapping_add(widths_so_far * interpolated_height),\n1247\t                        air_width: air_width_for_mat(need_rot, mats[0].width()),\n1248\t                    }\n1249\t                } else {\n1250\t                    MainMatrixPtrs {\n1251\t                        data: std::ptr::null(),\n1252\t                        air_width: 0,\n1253\t                    }\n1254\t                };\n1255\t                if has_preprocessed {\n1256\t                    widths_so_far += mats[0].width();\n1257\t                }\n1258\t                let main_ptrs: Vec<MainMatrixPtrs<EF>> = mats[first_main_idx..]\n1259\t                    .iter()\n1260\t                    .map(|m| {\n1261\t                        let main_ptr = MainMatrixPtrs {\n1262\t                            data: interpolated\n1263\t                                .buffer()\n1264\t                                .as_ptr()\n1265\t                                .wrapping_add(widths_so_far * interpolated_height),\n1266\t                            air_width: air_width_for_mat(need_rot, m.width()),\n1267\t                        };\n1268\t                        widths_so_far += m.width();\n1269\t                        main_ptr\n1270\t                    })\n1271\t                    .collect_vec();\n1272\t                debug_assert_eq!(widths_so_far, interpolated.width());\n1273\t                let main_ptrs_dev = main_ptrs.to_device()?;\n1274\t\n1275\t                _keepalive_interpolated.push(interpolated);\n1276\t                let eq_xi_ptr = eq_xi_tree.get_ptr(log_num_y);\n1277\t\n1278\t                early_eval.push(TraceCtx {\n1279\t                    trace_idx,\n1280\t                    air_idx,\n1281\t                    n_lift,\n1282\t                    num_y: num_y as u32,\n1283\t                    has_constraints,\n1284\t                    has_interactions,\n1285\t                    norm_factor,\n1286\t                    eq_xi_ptr,\n1287\t                    sels_ptr,\n1288\t                    prep_ptr,\n1289\t                    main_ptrs_dev,\n1290\t                    public_ptr: public_vals.as_ptr(),\n1291\t                    eq_3bs_ptr: eq_3bs.as_ptr(),\n1292\t                });\n1293\t            }\n1294\t        }\n1295\t\n1296\t        let d_challenges_ptr = self.d_challenges.as_ptr();\n1297\t\n1298\t        // Late traces (num_y=1): always use monomial\n1299\t        let late_logup_traces: Vec<_> = late_eval.iter().filter(|t| t.has_interactions).collect();\n1300\t        if !late_logup_traces.is_empty() {\n1301\t            let logup_combs: Vec<_> = late_logup_traces\n1302\t                .iter()\n1303\t                .map(|t| {\n1304\t                    self.logup_combinations[t.trace_idx]\n1305\t                        .as_ref()\n1306\t                        .expect(\"missing logup monomial combinations for late trace\")\n1307\t                })\n1308\t                .collect();\n1309\t            let batch =\n1310\t                LogupMonomialBatch::new(late_logup_traces.iter().copied(), self.pk, &logup_combs)?;\n1311\t            let out = batch\n1312\t                .evaluate(1)\n1313\t                .map_err(LogupZerocheckError::MleInteractionEval)?;\n1314\t            let host = out.to_host()?;\n1315\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1316\t                self.logup_tilde_evals[trace_idx][0] = host[i].p * late_logup_traces[i].norm_factor;\n1317\t                self.logup_tilde_evals[trace_idx][1] = host[i].q;\n1318\t            }\n1319\t        }\n1320\t        let late_mono_traces: Vec<_> = late_eval\n1321\t            .iter()\n1322\t            .filter(|t| trace_has_monomials(t, self.pk))\n1323\t            .collect();\n1324\t        if !late_mono_traces.is_empty() {\n1325\t            let lambda_combs: Vec<_> = late_mono_traces\n1326\t                .iter()\n1327\t                .map(|t| self.lambda_combinations[t.air_idx].as_ref().unwrap())\n1328\t                .collect();\n1329\t            let batch = ZerocheckMonomialBatch::new(late_mono_traces, self.pk, &lambda_combs)?;\n1330\t            let out = batch\n1331\t                .evaluate(1)\n1332\t                .map_err(LogupZerocheckError::MleConstraintEval)?;\n1333\t            let host = out.to_host()?;\n1334\t            for (i, trace_idx) in batch.trace_indices().enumerate() {\n1335\t                self.zerocheck_tilde_evals[trace_idx] = host[i];\n1336\t                // zc_out not set for num_x=1, handled from tilde_eval in compute_batch_s\n1337\t            }\n1338\t        }\n1339\t\n1340\t        // Logup for early traces: partition by num_y threshold\n1341\t        if !early_eval.is_empty() {\n1342\t            evaluate_logup_batched(\n1343\t                &early_eval,\n1344\t                self.pk,\n1345\t                d_challenges_ptr,\n1346\t                sp_deg as u32,\n1347\t                self.monomial_num_y_threshold,\n1348\t                &self.logup_combinations,\n1349\t                &mut logup_out,"}]},"parent_tool_use_id":"toolu_01QdAwdK9iEEPvqdC2KQBxkz","session_id":"d96bd5ad-dc55-4cdf-ae15-7b7ce8dfed52","uuid":"d388dc8d-3746-4d0f-9df2-ec24f871e2e9","timestamp":"2026-04-13T08:51:01.806Z"}
