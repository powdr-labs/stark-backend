{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ptdgx5SVrN9TJqNfBWz41Q","type":"tool_result","content":"1\t#include \"fp.h\"\n2\t#include \"fpext.h\"\n3\t#include \"launcher.cuh\"\n4\t#include \"sumcheck.cuh\"\n5\t#include <algorithm>\n6\t#include <cassert>\n7\t#include <cstddef>\n8\t#include <cstdint>\n9\t#include <utility>\n10\t\n11\tnamespace {\n12\t\n13\t// ============================================================================\n14\t// KERNELS\n15\t// ============================================================================\n16\t\n17\t// Folds PLE evaluations by interpolating univariate polynomials on coset D and evaluating at r_0\n18\t// Input: column-major matrix [height * width] of evaluations\n19\t// Output: column-major matrix [new_height * width] of folded evaluations (original OR rotated)\n20\t// For each (x, col), collects 2^l_skip evaluations on coset D and interpolates\n21\t// Parallelizes barycentric interpolation: each chunk of skip_domain threads handles one output cell\n22\t// Grid: (num_row_blocks, width) where blockIdx.y selects the column\n23\ttemplate <bool ROTATE>\n24\t__global__ void fold_ple_from_evals_kernel(\n25\t    const Fp *__restrict__ input_matrix, // [height * width] column-major\n26\t    FpExt *__restrict__ output_matrix,   // [new_height * width] column-major\n27\t    const Fp *__restrict__ omega_skip_pows, // [skip_domain]\n28\t    const FpExt *inv_lagrange_denoms,       // [skip_domain]\n29\t    uint32_t height,\n30\t    uint32_t skip_domain, // 2^l_skip\n31\t    uint32_t l_skip,      // log2(domain_size)\n32\t    uint32_t new_height   // lifted_height >> l_skip\n33\t) {\n34\t    extern __shared__ char smem_raw[];\n35\t    FpExt *smem = reinterpret_cast<FpExt *>(smem_raw);\n36\t\n37\t    uint32_t col = blockIdx.y;\n38\t    uint32_t chunks_per_block = blockDim.x / skip_domain;\n39\t    uint32_t chunk_in_block = threadIdx.x / skip_domain;\n40\t    uint32_t tid_in_chunk = threadIdx.x % skip_domain;\n41\t    uint32_t x = blockIdx.x * chunks_per_block + chunk_in_block; // row index in output\n42\t\n43\t    // Cannot early-return: all threads must participate in chunk_reduce_sum (uses __syncthreads)\n44\t    bool const active_chunk = (x < new_height);\n45\t\n46\t    // Each thread handles exactly ONE term of the barycentric interpolation\n47\t    FpExt local_val(Fp::zero());\n48\t    if (active_chunk) {\n49\t        uint32_t z = tid_in_chunk;\n50\t        uint32_t offset = ROTATE ? 1 : 0;\n51\t        uint32_t row_idx = ((x << l_skip) + z + offset) % height;\n52\t        uint32_t input_idx = col * height + row_idx;\n53\t        Fp eval = input_matrix[input_idx];\n54\t\n55\t        // Lagrange interpolation: eval * omega_skip_pows[z] * inv_lagrange_denoms[z]\n56\t        local_val = inv_lagrange_denoms[z] * omega_skip_pows[z] * eval;\n57\t    }\n58\t\n59\t    // Reduce within chunk\n60\t    // All threads must participate; inactive chunks contribute zero\n61\t    FpExt result =\n62\t        sumcheck::chunk_reduce_sum(local_val, smem, tid_in_chunk, skip_domain, chunk_in_block);\n63\t\n64\t    // No __syncthreads() needed: each chunk writes to a distinct output location\n65\t    // and kernel exits immediately after this write\n66\t    if (active_chunk && tid_in_chunk == 0) {\n67\t        output_matrix[col * new_height + x] = result;\n68\t    }\n69\t}\n70\t\n71\t__global__ void interpolate_columns_kernel(\n72\t    FpExt *__restrict__ interpolated,\n73\t    const FpExt *__restrict__ const *__restrict__ columns,\n74\t    uint32_t s_deg,\n75\t    uint32_t num_y,\n76\t    uint32_t num_columns\n77\t) {\n78\t    uint32_t tidx = threadIdx.x + blockIdx.x * blockDim.x;\n79\t    uint32_t y = tidx % num_y;\n80\t    uint32_t col_idx = tidx / num_y;\n81\t    if (col_idx >= num_columns)\n82\t        return;\n83\t\n84\t    const FpExt *__restrict__ column = columns[col_idx];\n85\t    auto t0 = column[y << 1];\n86\t    auto t1 = column[(y << 1) | 1];\n87\t    FpExt *__restrict__ this_interpolated = interpolated + col_idx * s_deg * num_y;\n88\t\n89\t    for (int x = 0; x < s_deg; x++) {\n90\t        this_interpolated[x * num_y + y] = t0 + (t1 - t0) * Fp(x + 1u);\n91\t    }\n92\t}\n93\t\n94\t__global__ void frac_matrix_vertically_repeat_kernel(\n95\t    std::pair<FpExt, FpExt> *__restrict__ out,\n96\t    const std::pair<FpExt, FpExt> *__restrict__ in,\n97\t    const uint32_t width,\n98\t    const uint32_t lifted_height,\n99\t    const uint32_t height\n100\t) {\n101\t    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;\n102\t    uint32_t col = blockIdx.y + blockIdx.z * gridDim.y;\n103\t    if (col >= width) {\n104\t        return;\n105\t    }\n106\t    out[col * lifted_height + row].first = in[col * height + (row % height)].first;\n107\t    out[col * lifted_height + row].second = in[col * height + (row % height)].second;\n108\t}\n109\t\n110\t// Vertically repeat separate (F, EF) buffers (for GKR input optimization)\n111\t__global__ void frac_matrix_vertically_repeat_mixed_kernel(\n112\t    FpExt *__restrict__ out_numerators,\n113\t    FpExt *__restrict__ out_denominators,\n114\t    const FpExt *__restrict__ in_numerators,\n115\t    const FpExt *__restrict__ in_denominators,\n116\t    const uint32_t width,\n117\t    const uint32_t lifted_height,\n118\t    const uint32_t height\n119\t) {\n120\t    uint32_t row = blockIdx.x * blockDim.x + threadIdx.x;\n121\t    uint32_t col = blockIdx.y + blockIdx.z * gridDim.y;\n122\t    if (col >= width) {\n123\t        return;\n124\t    }\n125\t    uint32_t src_row = row % height;\n126\t    size_t src_idx = col * height + src_row;\n127\t    size_t dst_idx = col * lifted_height + row;\n128\t    out_numerators[dst_idx] = in_numerators[src_idx];\n129\t    out_denominators[dst_idx] = in_denominators[src_idx];\n130\t}\n131\t\n132\t// ============================================================================\n133\t// LAUNCHERS\n134\t// ============================================================================\n135\t\n136\tconstexpr uint32_t MAX_GRID_DIM = 65535u;\n137\t\n138\textern \"C\" int _fold_ple_from_evals(\n139\t    const Fp *input_matrix,\n140\t    FpExt *output_matrix,\n141\t    const Fp *omega_skip_pows,\n142\t    const FpExt *inv_lagrange_denoms,\n143\t    uint32_t height,\n144\t    uint32_t width,\n145\t    uint32_t l_skip,\n146\t    uint32_t new_height,\n147\t    bool rotate\n148\t) {\n149\t    uint32_t skip_domain = 1u << l_skip;\n150\t\n151\t    // Block size: at least skip_domain, prefer 256 for occupancy\n152\t    uint32_t block_size = std::max(256u, skip_domain);\n153\t    uint32_t chunks_per_block = block_size / skip_domain;\n154\t\n155\t    // 2D grid: x-dim for rows, y-dim for columns\n156\t    dim3 grid(div_ceil(new_height, chunks_per_block), width);\n157\t    dim3 block(block_size);\n158\t\n159\t    // Shared memory for cross-warp reduction (needed when skip_domain > 32)\n160\t    // Each warp in the block needs one FpExt slot for cross-warp reduction\n161\t    uint32_t total_warps_in_block = block_size / WARP_SIZE;\n162\t    size_t smem_bytes = (skip_domain > WARP_SIZE) ? total_warps_in_block * sizeof(FpExt) : 0;\n163\t\n164\t    if (rotate) {\n165\t        fold_ple_from_evals_kernel<true><<<grid, block, smem_bytes>>>(\n166\t            input_matrix,\n167\t            output_matrix,\n168\t            omega_skip_pows,\n169\t            inv_lagrange_denoms,\n170\t            height,\n171\t            skip_domain,\n172\t            l_skip,\n173\t            new_height\n174\t        );\n175\t    } else {\n176\t        fold_ple_from_evals_kernel<false><<<grid, block, smem_bytes>>>(\n177\t            input_matrix,\n178\t            output_matrix,\n179\t            omega_skip_pows,\n180\t            inv_lagrange_denoms,\n181\t            height,\n182\t            skip_domain,\n183\t            l_skip,\n184\t            new_height\n185\t        );\n186\t    }\n187\t    return CHECK_KERNEL();\n188\t}\n189\t\n190\textern \"C\" int _interpolate_columns(\n191\t    FpExt *interpolated,\n192\t    const FpExt *const *columns,\n193\t    size_t s_deg,\n194\t    size_t num_y,\n195\t    size_t num_columns\n196\t) {\n197\t    auto [grid, block] = kernel_launch_params(num_y * num_columns, 512);\n198\t\n199\t    interpolate_columns_kernel<<<grid, block>>>(interpolated, columns, s_deg, num_y, num_columns);\n200\t    return CHECK_KERNEL();\n201\t}\n202\t\n203\textern \"C\" int _frac_matrix_vertically_repeat(\n204\t    std::pair<FpExt, FpExt> *out,\n205\t    const std::pair<FpExt, FpExt> *in,\n206\t    const uint32_t width,\n207\t    const uint32_t lifted_height,\n208\t    const uint32_t height\n209\t) {\n210\t    auto [grid, block] = kernel_launch_params(lifted_height);\n211\t    grid.y = std::min(width, MAX_GRID_DIM);\n212\t    grid.z = (width + grid.y - 1) / grid.y;\n213\t    assert(grid.z <= MAX_GRID_DIM);\n214\t    frac_matrix_vertically_repeat_kernel<<<grid, block>>>(out, in, width, lifted_height, height);\n215\t    return CHECK_KERNEL();\n216\t}\n217\t\n218\textern \"C\" int _frac_matrix_vertically_repeat_ext(\n219\t    FpExt *out_numerators,\n220\t    FpExt *out_denominators,\n221\t    const FpExt *in_numerators,\n222\t    const FpExt *in_denominators,\n223\t    const uint32_t width,\n224\t    const uint32_t lifted_height,\n225\t    const uint32_t height\n226\t) {\n227\t    auto [grid, block] = kernel_launch_params(lifted_height);\n228\t    grid.y = std::min(width, MAX_GRID_DIM);\n229\t    grid.z = (width + grid.y - 1) / grid.y;\n230\t    assert(grid.z <= MAX_GRID_DIM);\n231\t    frac_matrix_vertically_repeat_mixed_kernel<<<grid, block>>>(\n232\t        out_numerators,\n233\t        out_denominators,\n234\t        in_numerators,\n235\t        in_denominators,\n236\t        width,\n237\t        lifted_height,\n238\t        height\n239\t    );\n240\t    return CHECK_KERNEL();\n241\t}\n242\t\n243\t} // namespace\n244\t"}]},"parent_tool_use_id":"toolu_01TBXL1cbLrEpWJbK7DkJuPK","session_id":"d96bd5ad-dc55-4cdf-ae15-7b7ce8dfed52","uuid":"cf2f9917-80bd-4aa4-9804-51ab1fb38882","timestamp":"2026-04-13T08:52:53.014Z"}
