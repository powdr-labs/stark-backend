  ) -> UnivariatePoly<EF> {\n1437\t        debug_assert_eq!(sp_round_evals.len(), 3 * num_traces);\n1438\t        debug_assert_eq!(sp_round_evals.len(), mu_pows.len());\n1439\t        let constraint_degree = self.constraint_degree;\n1440\t        let mut sp_head_zc = vec![EF::ZERO; constraint_degree];\n1441\t        let mut sp_head_logup = vec![EF::ZERO; constraint_degree];\n1442\t        let mut sp_tail = EF::ZERO;\n1443\t        for (trace_idx, &n) in self.n_per_trace.iter().enumerate() {\n1444\t            let n_lift = n.max(0) as usize;\n1445\t            let zc_idx = 2 * num_traces + trace_idx;\n1446\t            let numer_idx = 2 * trace_idx;\n1447\t            let denom_idx = numer_idx + 1;\n1448\t            if round == n_lift + 1 {\n1449\t                let eq_r_acc = *self.eq_ns.last().unwrap();\n1450\t                let eq_sharp_r_acc = *self.eq_sharp_ns.last().unwrap();\n1451\t                self.zerocheck_tilde_evals[trace_idx] *= eq_r_acc;\n1452\t                self.logup_tilde_evals[trace_idx][0] *= eq_sharp_r_acc;\n1453\t                self.logup_tilde_evals[trace_idx][1] *= eq_sharp_r_acc;\n1454\t            }\n1455\t            if round <= n_lift {\n1456\t                for i in 0..constraint_degree {\n1457\t                    sp_head_zc[i] += mu_pows[zc_idx] * sp_round_evals[zc_idx][i];\n1458\t                    sp_head_logup[i] += mu_pows[numer_idx] * sp_round_evals[numer_idx][i]\n1459\t                        + mu_pows[denom_idx] * sp_round_evals[denom_idx][i];\n1460\t                }\n1461\t            } else {\n1462\t                sp_tail += mu_pows[zc_idx] * self.zerocheck_tilde_evals[trace_idx]\n1463\t                    + mu_pows[numer_idx] * self.logup_tilde_evals[trace_idx][0]\n1464\t                    + mu_pows[denom_idx] * self.logup_tilde_evals[trace_idx][1];\n1465\t            }\n1466\t        }\n1467\t        let s_deg = constraint_degree + 1;\n1468\t        let l_skip = self.l_skip;\n1469\t        // With eq(xi,r) contributions\n1470\t        let mut sp_head_evals = vec![EF::ZERO; s_deg];\n1471\t        for i in 0..constraint_degree {\n1472\t            sp_head_evals[i + 1] = self.eq_ns[round - 1] * sp_head_zc[i]\n1473\t                + self.eq_sharp_ns[round - 1] * sp_head_logup[i];\n1474\t        }\n1475\t        // We need to derive s'(0).\n1476\t        // We use that s_j(0) + s_j(1) = s_{j-1}(r_{j-1})\n1477\t        let xi_cur = self.xi[l_skip + round - 1];\n1478\t        {\n1479\t            let eq_xi_0 = EF::ONE - xi_cur;\n1480\t            let eq_xi_1 = xi_cur;\n1481\t            sp_head_evals[0] =\n1482\t                (self.prev_s_eval - eq_xi_1 * sp_head_evals[1] - sp_tail) * eq_xi_0.inverse();\n1483\t        }\n1484\t        // s' has degree s_deg - 1\n1485\t        let sp_head = UnivariatePoly::lagrange_interpolate(\n1486\t            &(0..s_deg).map(F::from_usize).collect_vec(),\n1487\t            &sp_head_evals,\n1488\t        );\n1489\t        // eq(xi, X) = (2 * xi - 1) * X + (1 - xi)\n1490\t        // Compute s(X) = eq(xi, X) * s'_head(X) + s'_tail * X (s'_head now contains eq(..,r))\n1491\t        // s(X) has degree s_deg\n1492\t        let mut coeffs = sp_head.into_coeffs();\n1493\t        coeffs.push(EF::ZERO);\n1494\t        let b = EF::ONE - xi_cur;\n1495\t        let a = xi_cur - b;\n1496\t        for i in (0..s_deg).rev() {\n1497\t            coeffs[i + 1] = a * coeffs[i] + b * coeffs[i + 1];\n1498\t        }\n1499\t        coeffs[0] *= b;\n1500\t        coeffs[1] += sp_tail;\n1501\t        UnivariatePoly::new(coeffs)\n1502\t    }\n1503\t\n1504\t    #[instrument(name = \"LogupZerocheck::fold_mle_evals\", level = \"debug\", skip_all, fields(round = round))]\n1505\t    fn fold_mle_evals(&mut self, round: usize, r_round: EF) -> Result<(), LogupZerocheckError> {\n1506\t        // Assumes that input_mats are sorted by height\n1507\t        let batch_fold = |input_mats: Vec<DeviceMatrix<EF>>| -> Result<Vec<DeviceMatrix<EF>>, LogupZerocheckError> {\n1508\t            let num_matrices = input_mats.partition_point(|mat| mat.height() > 1);\n1509\t            let mut max_output_cells = 0;\n1510\t            let (log_output_heights, widths, mut output_mats): (Vec<_>, Vec<_>, Vec<_>) =\n1511\t                input_mats\n1512\t                    .iter()\n1513\t                    .take(num_matrices)\n1514\t                    .map(|mat| {\n1515\t                        let height = mat.height();\n1516\t                        let width = mat.width();\n1517\t                        let output_height = height >> 1;\n1518\t                        max_output_cells = max(max_output_cells, output_height * width);\n1519\t                        let output_mat = DeviceMatrix::<EF>::with_capacity(output_height, width);\n1520\t                        (output_height.ilog2() as u8, width as u32, output_mat)\n1521\t                    })\n1522\t                    .multiunzip();\n1523\t\n1524\t            let input_ptrs = input_mats\n1525\t                .iter()\n1526\t                .take(num_matrices)\n1527\t                .map(|mat| mat.buffer().as_ptr())\n1528\t                .collect_vec();\n1529\t            let output_ptrs = output_mats\n1530\t                .iter()\n1531\t                .map(|mat| mat.buffer().as_mut_ptr())\n1532\t                .collect_vec();\n1533\t\n1534\t            let d_input_ptrs = input_ptrs.to_device()?;\n1535\t            let d_output_ptrs = output_ptrs.to_device()?;\n1536\t            let d_log_output_heights = log_output_heights.to_device()?;\n1537\t            let d_widths = widths.to_device()?;\n1538\t\n1539\t            unsafe {\n1540\t                batch_fold_mle(\n1541\t                    &d_input_ptrs,\n1542\t                    &d_output_ptrs,\n1543\t                    &d_widths,\n1544\t                    num_matrices.try_into().unwrap(),\n1545\t                    &d_log_output_heights,\n1546\t                    max_output_cells.try_into().unwrap(),\n1547\t                    r_round,\n1548\t                )\n1549\t                .map_err(LogupZerocheckError::BatchFoldMle)?;\n1550\t            }\n1551\t            output_mats.extend_from_slice(&input_mats[num_matrices..]);\n1552\t            Ok(output_mats)\n1553\t        };\n1554\t\n1555\t        // Fold mat_evals_per_trace: Vec<Vec<DeviceMatrix<EF>>>\n1556\t        self.mat_evals_per_trace = {\n1557\t            let lengths = self\n1558\t                .mat_evals_per_trace\n1559\t                .iter()\n1560\t                .map(|v| v.len())\n1561\t                .collect_vec();\n1562\t            let input_mats = std::mem::take(&mut self.mat_evals_per_trace)\n1563\t                .into_iter()\n1564\t                .flatten()\n1565\t                .collect_vec();\n1566\t            let mut output_mats = batch_fold(input_mats)?.into_iter();\n1567\t            lengths\n1568\t                .into_iter()\n1569\t                .map(|len| output_mats.by_ref().take(len).collect())\n1570\t                .collect()\n1571\t        };\n1572\t        if self.save_memory {\n1573\t            self.memory_limit_bytes = self.gkr_mem_contribution.saturating_sub(\n1574\t                self.mat_evals_per_trace\n1575\t                    .iter()\n1576\t                    .flatten()\n1577\t                    .map(|m| m.buffer().len() * size_of::<EF>())\n1578\t                    .sum(),\n1579\t            );\n1580\t        }\n1581\t\n1582\t        // Fold sels_per_trace: Vec<DeviceMatrix<EF>>\n1583\t        self.sels_per_trace = batch_fold(std::mem::take(&mut self.sels_per_trace))?;\n1584\t\n1585\t        for tree in self.eq_xis.values_mut() {\n1586\t            // trim the back (which corresponds to r_{j-1}) because we don't need it anymore\n1587\t            if tree.layers.len() > 1 {\n1588\t                tree.layers.pop();\n1589\t            }\n1590\t        }\n1591\t        let xi = self.xi[self.l_skip + round - 1];\n1592\t        let eq_r = eval_eq_mle(&[xi], &[r_round]);\n1593\t        self.eq_ns.push(self.eq_ns[round - 1] * eq_r);\n1594\t        self.eq_sharp_ns.push(self.eq_sharp_ns[round - 1] * eq_r);"}]},"parent_tool_use_id":"toolu_01GbmVqWFPEx1xu6NL2M1b4t","session_id":"d96bd5ad-dc55-4cdf-ae15-7b7ce8dfed52","uuid":"9362d031-f105-446c-90a2-8a577614c81c","timestamp":"2026-04-13T08:52:44.189Z"}
