{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N2yhhQGVmKtj35RqrBe7m3","type":"tool_result","content":"1\t#include \"eval_ctx.cuh\"\n2\t#include \"frac_ext.cuh\"\n3\t#include \"launcher.cuh\"\n4\t#include \"monomial.cuh\"\n5\t#include \"sumcheck.cuh\"\n6\t\n7\t#include <cassert>\n8\t#include <cstdint>\n9\t\n10\tnamespace logup_zerocheck_mle {\n11\t\n12\t__device__ __forceinline__ FpExt\n13\teval_variable(PackedVar var, uint32_t row, const EvalCoreCtx &ctx, uint32_t height) {\n14\t    uint8_t entry_type = var.entry_type();\n15\t    uint8_t offset = var.offset();\n16\t\n17\t    switch (entry_type) {\n18\t    case 1: { // MAIN\n19\t        auto main_ptr = ctx.d_main[var.part_index()];\n20\t        const auto stride = height * main_ptr.air_width;\n21\t        const FpExt *__restrict__ matrix = main_ptr.data + stride * offset;\n22\t        const FpExt *__restrict__ column = matrix + height * var.col_index();\n23\t        return column[row];\n24\t    }\n25\t    case 0: { // PREPROCESSED\n26\t        const auto stride = height * ctx.d_preprocessed.air_width;\n27\t        const FpExt *__restrict__ matrix = ctx.d_preprocessed.data + stride * offset;\n28\t        const FpExt *__restrict__ column = matrix + height * var.col_index();\n29\t        return column[row];\n30\t    }\n31\t    case 3: // PUBLIC\n32\t        return FpExt(ctx.d_public[var.col_index()]);\n33\t    case 8: // IS_FIRST\n34\t        return ctx.d_selectors[row];\n35\t    case 9: // IS_LAST\n36\t        return ctx.d_selectors[2 * height + row];\n37\t    case 10: // IS_TRANSITION\n38\t        return ctx.d_selectors[height + row];\n39\t    default:\n40\t        assert(false);\n41\t    }\n42\t    return FpExt(Fp::zero());\n43\t}\n44\t\n45\t// For batched monomial evaluation across multiple AIRs\n46\tstruct MonomialAirCtx {\n47\t    const MonomialHeader *__restrict__ d_headers;\n48\t    const PackedVar *__restrict__ d_variables;\n49\t    const FpExt *__restrict__ d_lambda_combinations; // Precomputed per-monomial\n50\t    uint32_t num_monomials;\n51\t    EvalCoreCtx eval_ctx;\n52\t    const FpExt *__restrict__ d_eq_xi;\n53\t    uint32_t num_y;\n54\t};\n55\t\n56\t// ============================================================================\n57\t// PRECOMPUTE LAMBDA COMBINATIONS (once per AIR after lambda is sampled)\n58\t// ============================================================================\n59\t\n60\t__global__ void precompute_lambda_combinations_kernel(\n61\t    FpExt *__restrict__ out,\n62\t    const MonomialHeader *__restrict__ headers,\n63\t    const LambdaTerm *__restrict__ lambda_terms,\n64\t    const FpExt *__restrict__ lambda_pows,\n65\t    uint32_t num_monomials\n66\t) {\n67\t    uint32_t m = blockIdx.x * blockDim.x + threadIdx.x;\n68\t    if (m >= num_monomials)\n69\t        return;\n70\t\n71\t    MonomialHeader hdr = headers[m];\n72\t    FpExt sum(Fp::zero());\n73\t    for (uint16_t l = 0; l < hdr.num_terms; ++l) {\n74\t        LambdaTerm term = lambda_terms[hdr.term_offset + l];\n75\t        sum += lambda_pows[term.constraint_idx] * term.coefficient;\n76\t    }\n77\t    out[m] = sum;\n78\t}\n79\t\n80\textern \"C\" int _precompute_lambda_combinations(\n81\t    FpExt *out,\n82\t    const MonomialHeader *headers,\n83\t    const LambdaTerm *lambda_terms,\n84\t    const FpExt *lambda_pows,\n85\t    uint32_t num_monomials\n86\t) {\n87\t    if (num_monomials == 0)\n88\t        return 0;\n89\t\n90\t    constexpr uint32_t threads = 256;\n91\t    uint32_t blocks = div_ceil(num_monomials, threads);\n92\t    precompute_lambda_combinations_kernel<<<blocks, threads>>>(\n93\t        out, headers, lambda_terms, lambda_pows, num_monomials\n94\t    );\n95\t    return CHECK_KERNEL();\n96\t}\n97\t\n98\t// ============================================================================\n99\t// BATCHED KERNEL (multiple AIRs in single launch)\n100\t// ============================================================================\n101\t\n102\t__global__ void zerocheck_monomial_kernel(\n103\t    FpExt *__restrict__ tmp_sums,\n104\t    const BlockCtx *__restrict__ block_ctxs,\n105\t    const MonomialAirCtx *__restrict__ air_ctxs,\n106\t    uint32_t threads_per_block\n107\t) {\n108\t    extern __shared__ char smem[];\n109\t    FpExt *shared = (FpExt *)smem;\n110\t\n111\t    BlockCtx bctx = block_ctxs[blockIdx.x];\n112\t    MonomialAirCtx actx = air_ctxs[bctx.air_idx];\n113\t\n114\t    uint32_t num_x = gridDim.y;\n115\t    uint32_t x_int = blockIdx.y;\n116\t\n117\t    // Decode y_int and mono_block from local_block_idx_x\n118\t    uint32_t mono_blocks = (actx.num_monomials + threads_per_block - 1) / threads_per_block;\n119\t    uint32_t y_int = bctx.local_block_idx_x / mono_blocks;\n120\t    uint32_t mono_block = bctx.local_block_idx_x % mono_blocks;\n121\t\n122\t    uint32_t height = num_x * actx.num_y;\n123\t    uint32_t row = x_int * actx.num_y + y_int;\n124\t\n125\t    FpExt sum(Fp::zero());\n126\t\n127\t    // Each thread evaluates one monomial\n128\t    uint32_t m = mono_block * threads_per_block + threadIdx.x;\n129\t    if (m < actx.num_monomials) {\n130\t        MonomialHeader hdr = actx.d_headers[m];\n131\t\n132\t        // Evaluate product of variables\n133\t        FpExt product(Fp::one());\n134\t        for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n135\t            PackedVar var = actx.d_variables[hdr.var_offset + v];\n136\t            product *= eval_variable(var, row, actx.eval_ctx, height);\n137\t        }\n138\t\n139\t        sum = product * actx.d_lambda_combinations[m];\n140\t    }\n141\t\n142\t    // Block reduction\n143\t    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n144\t\n145\t    if (threadIdx.x == 0) {\n146\t        // Apply eq_xi here (eliminates separate phase 2)\n147\t        // eq_xi is eq(xi, y) which only depends on y, not x\n148\t        reduced *= actx.d_eq_xi[y_int];\n149\t        tmp_sums[blockIdx.x * num_x + x_int] = reduced;\n150\t    }\n151\t}\n152\t\n153\textern \"C\" int _zerocheck_monomial_batched(\n154\t    FpExt *tmp_sums,\n155\t    FpExt *output,\n156\t    const BlockCtx *block_ctxs,\n157\t    const MonomialAirCtx *air_ctxs,\n158\t    const uint32_t *air_block_offsets,\n159\t    uint32_t num_blocks,\n160\t    uint32_t num_x,\n161\t    uint32_t num_airs,\n162\t    uint32_t threads_per_block\n163\t) {\n164\t    if (num_blocks == 0) {\n165\t        return 0;\n166\t    }\n167\t\n168\t    dim3 grid(num_blocks, num_x);\n169\t    dim3 block(threads_per_block);\n170\t    size_t shmem = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n171\t\n172\t    // Phase 1: Main monomial evaluation kernel\n173\t    zerocheck_monomial_kernel<<<grid, block, shmem>>>(\n174\t        tmp_sums, block_ctxs, air_ctxs, threads_per_block\n175\t    );\n176\t    int err = CHECK_KERNEL();\n177\t    if (err != 0)\n178\t        return err;\n179\t\n180\t    // Phase 2: Batched reduction for all AIRs in single launch\n181\t    // Grid: (num_airs, num_x) - each block handles one (air, x) pair\n182\t    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n183\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n184\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n185\t\n186\t    dim3 reduce_grid(num_airs, num_x);\n187\t    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n188\t        tmp_sums, output, air_block_offsets, num_x\n189\t    );\n190\t\n191\t    return CHECK_KERNEL();\n192\t}\n193\t\n194\t// ============================================================================\n195\t// PAR-Y KERNEL (parallelizes over y_int, tiles monomials)\n196\t// ============================================================================\n197\t\n198\t__global__ void zerocheck_monomial_par_y_kernel(\n199\t    FpExt *__restrict__ tmp_sums,\n200\t    const BlockCtx *__restrict__ block_ctxs,\n201\t    const MonomialAirCtx *__restrict__ air_ctxs,\n202\t    uint32_t threads_per_block,\n203\t    uint32_t chunk_size // monomials per mono_chunk\n204\t) {\n205\t    extern __shared__ char smem[];\n206\t    FpExt *shared = (FpExt *)smem;\n207\t\n208\t    BlockCtx bctx = block_ctxs[blockIdx.x];\n209\t    MonomialAirCtx actx = air_ctxs[bctx.air_idx];\n210\t\n211\t    uint32_t num_x = gridDim.y;\n212\t    uint32_t x_int = blockIdx.y;\n213\t\n214\t    // Decode y_block and mono_chunk from local_block_idx_x\n215\t    // Encoding: local_block_idx_x = y_block * air_mono_chunks + mono_chunk\n216\t    uint32_t air_mono_chunks = (actx.num_monomials + chunk_size - 1) / chunk_size;\n217\t    uint32_t y_block = bctx.local_block_idx_x / air_mono_chunks;\n218\t    uint32_t mono_chunk = bctx.local_block_idx_x % air_mono_chunks;\n219\t\n220\t    // Decode y_int from thread position within y_block\n221\t    uint32_t y_int = threadIdx.x + y_block * threads_per_block;\n222\t    bool active = (y_int < actx.num_y);\n223\t\n224\t    uint32_t height = num_x * actx.num_y;\n225\t    uint32_t row = x_int * actx.num_y + y_int;\n226\t\n227\t    // Contiguous chunk of monomials for this mono_chunk\n228\t    uint32_t mono_start = mono_chunk * chunk_size;\n229\t    uint32_t mono_end = min(mono_start + chunk_size, actx.num_monomials);\n230\t\n231\t    FpExt sum(Fp::zero());\n232\t    if (active) {\n233\t        // Each thread loops over its chunk of monomials\n234\t        for (uint32_t m = mono_start; m < mono_end; ++m) {\n235\t            MonomialHeader hdr = actx.d_headers[m];\n236\t\n237\t            FpExt product(Fp::one());\n238\t            for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n239\t                PackedVar var = actx.d_variables[hdr.var_offset + v];\n240\t                product *= eval_variable(var, row, actx.eval_ctx, height);\n241\t            }\n242\t\n243\t            sum += product * actx.d_lambda_combinations[m];\n244\t        }\n245\t\n246\t        // Apply eq_xi\n247\t        sum *= actx.d_eq_xi[y_int];\n248\t    }\n249\t\n250\t    // Block reduction sums across y_int values in this block\n251\t    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n252\t\n253\t    if (threadIdx.x == 0) {\n254\t        tmp_sums[blockIdx.x * num_x + x_int] = reduced;\n255\t    }\n256\t}\n257\t\n258\textern \"C\" int _zerocheck_monomial_par_y_batched(\n259\t    FpExt *tmp_sums,\n260\t    FpExt *output,\n261\t    const BlockCtx *block_ctxs,\n262\t    const MonomialAirCtx *air_ctxs,\n263\t    const uint32_t *air_block_offsets,\n264\t    uint32_t num_blocks,\n265\t    uint32_t num_x,\n266\t    uint32_t num_airs,\n267\t    uint32_t chunk_size,\n268\t    uint32_t threads_per_block\n269\t) {\n270\t    if (num_blocks == 0) {\n271\t        return 0;\n272\t    }\n273\t\n274\t    dim3 grid(num_blocks, num_x);\n275\t    dim3 block(threads_per_block);\n276\t    size_t shmem = div_ceil(block.x, WARP_SIZE) * sizeof(FpExt);\n277\t\n278\t    // Phase 1: Main par-y kernel\n279\t    zerocheck_monomial_par_y_kernel<<<grid, block, shmem>>>(\n280\t        tmp_sums, block_ctxs, air_ctxs, threads_per_block, chunk_size\n281\t    );\n282\t    int err = CHECK_KERNEL();\n283\t    if (err != 0)\n284\t        return err;\n285\t\n286\t    // Phase 2: Batched reduction for all AIRs in single launch\n287\t    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n288\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n289\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n290\t\n291\t    dim3 reduce_grid(num_airs, num_x);\n292\t    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n293\t        tmp_sums, output, air_block_offsets, num_x\n294\t    );\n295\t\n296\t    return CHECK_KERNEL();\n297\t}\n298\t\n299\t// ============================================================================\n300\t// LOGUP MONOMIAL KERNELS\n301\t// ============================================================================\n302\t\n303\ttemplate <bool IS_DENOM>\n304\t__global__ void precompute_logup_combinations_kernel(\n305\t    FpExt *__restrict__ out,\n306\t    const MonomialHeader *__restrict__ headers,\n307\t    const InteractionMonomialTerm *__restrict__ terms,\n308\t    const FpExt *__restrict__ beta_pows,\n309\t    const FpExt *__restrict__ eq_3bs,\n310\t    uint32_t num_monomials\n311\t) {\n312\t    uint32_t m = blockIdx.x * blockDim.x + threadIdx.x;\n313\t    if (m >= num_monomials)\n314\t        return;\n315\t\n316\t    MonomialHeader hdr = headers[m];\n317\t    FpExt sum(Fp::zero());\n318\t    for (uint16_t t = 0; t < hdr.num_terms; ++t) {\n319\t        InteractionMonomialTerm term = terms[hdr.term_offset + t];\n320\t        FpExt value = eq_3bs[term.interaction_idx] * term.coefficient;\n321\t        if constexpr (IS_DENOM) {\n322\t            value *= beta_pows[term.field_idx];\n323\t        }\n324\t        sum += value;\n325\t    }\n326\t    out[m] = sum;\n327\t}\n328\t\n329\textern \"C\" int _precompute_logup_numer_combinations(\n330\t    FpExt *out,\n331\t    const MonomialHeader *headers,\n332\t    const InteractionMonomialTerm *terms,\n333\t    const FpExt *eq_3bs,\n334\t    uint32_t num_monomials\n335\t) {\n336\t    if (num_monomials == 0)\n337\t        return 0;\n338\t\n339\t    constexpr uint32_t threads = 256;\n340\t    uint32_t blocks = div_ceil(num_monomials, threads);\n341\t    precompute_logup_combinations_kernel<false><<<blocks, threads>>>(\n342\t        out, headers, terms, nullptr, eq_3bs, num_monomials\n343\t    );\n344\t    return CHECK_KERNEL();\n345\t}\n346\t\n347\textern \"C\" int _precompute_logup_denom_combinations(\n348\t    FpExt *out,\n349\t    const MonomialHeader *headers,\n350\t    const InteractionMonomialTerm *terms,\n351\t    const FpExt *beta_pows,\n352\t    const FpExt *eq_3bs,\n353\t    uint32_t num_monomials\n354\t) {\n355\t    if (num_monomials == 0)\n356\t        return 0;\n357\t\n358\t    constexpr uint32_t threads = 256;\n359\t    uint32_t blocks = div_ceil(num_monomials, threads);\n360\t    precompute_logup_combinations_kernel<true><<<blocks, threads>>>(\n361\t        out, headers, terms, beta_pows, eq_3bs, num_monomials\n362\t    );\n363\t    return CHECK_KERNEL();\n364\t}\n365\t\n366\t// AIR context for logup monomial MLE evaluation\n367\t// Note: These structures match the Rust LogupMonomial*Ctx types\n368\tstruct LogupMonomialCommonCtx {\n369\t    EvalCoreCtx eval_ctx;\n370\t    const FpExt *__restrict__ d_eq_xi;\n371\t    FpExt bus_term_sum; // Precomputed sum_i(beta[message_len_i] * (bus_idx[i]+1) * eq_3bs[i])\n372\t    uint32_t num_y;\n373\t    uint32_t mono_blocks;\n374\t};\n375\t\n376\tstruct LogupMonomialCtx {\n377\t    const MonomialHeader *__restrict__ d_headers;\n378\t    const PackedVar *__restrict__ d_variables;\n379\t    const FpExt *__restrict__ d_combinations;\n380\t    uint32_t num_monomials;\n381\t};\n382\t\n383\t// Logup monomial MLE kernel - evaluates numerator or denominator monomials per block.\n384\t// This produces FracExt output compatible with the standard reduction pattern.\n385\t//\n386\t// Block assignment: one block per (y_int, mono_block).\n387\t// Each block evaluates a chunk of monomials across threads.\n388\t//\n389\t// Template parameter IS_DENOM:\n390\t//   - false: numerator kernel, writes to tmp_sums[...].p\n391\t//   - true: denominator kernel, writes to tmp_sums[...].q and adds bus_term_sum when mono_block == 0\n392\ttemplate <bool IS_DENOM>\n393\t__global__ void logup_monomial_kernel(\n394\t    FracExt *__restrict__ tmp_sums,\n395\t    const BlockCtx *__restrict__ block_ctxs,\n396\t    const LogupMonomialCommonCtx *__restrict__ common_ctxs,\n397\t    const LogupMonomialCtx *__restrict__ ctxs\n398\t) {\n399\t    extern __shared__ char smem[];\n400\t    FpExt *shared = (FpExt *)smem;\n401\t\n402\t    BlockCtx bctx = block_ctxs[blockIdx.x];\n403\t    LogupMonomialCommonCtx common_ctx = common_ctxs[bctx.air_idx];\n404\t    LogupMonomialCtx ctx = ctxs[bctx.air_idx];\n405\t\n406\t    uint32_t num_x = gridDim.y;\n407\t    uint32_t x_int = blockIdx.y;\n408\t    uint32_t height = num_x * common_ctx.num_y;\n409\t\n410\t    uint32_t mono_blocks = common_ctx.mono_blocks;\n411\t#ifdef CUDA_DEBUG\n412\t    assert(mono_blocks > 0);\n413\t#endif\n414\t    uint32_t y_int = bctx.local_block_idx_x / mono_blocks;\n415\t    uint32_t mono_block = bctx.local_block_idx_x % mono_blocks;\n416\t    uint32_t row = x_int * common_ctx.num_y + y_int;\n417\t    uint32_t m = mono_block * blockDim.x + threadIdx.x;\n418\t\n419\t    FpExt sum(Fp::zero());\n420\t    if (y_int < common_ctx.num_y && m < ctx.num_monomials) {\n421\t        MonomialHeader hdr = ctx.d_headers[m];\n422\t        FpExt monomial = ctx.d_combinations[m];\n423\t        for (uint16_t v = 0; v < hdr.num_vars; ++v) {\n424\t            PackedVar var = ctx.d_variables[hdr.var_offset + v];\n425\t            monomial *= eval_variable(var, row, common_ctx.eval_ctx, height);\n426\t        }\n427\t        sum = monomial * common_ctx.d_eq_xi[y_int];\n428\t    }\n429\t\n430\t    FpExt reduced = sumcheck::block_reduce_sum(sum, shared);\n431\t\n432\t    if (threadIdx.x == 0) {\n433\t        if constexpr (IS_DENOM) {\n434\t            if (mono_block == 0 && y_int < common_ctx.num_y) {\n435\t                reduced += common_ctx.bus_term_sum * common_ctx.d_eq_xi[y_int];\n436\t            }\n437\t            tmp_sums[blockIdx.x * num_x + x_int].q = reduced;\n438\t        } else {\n439\t            tmp_sums[blockIdx.x * num_x + x_int].p = reduced;\n440\t        }\n441\t    }\n442\t}\n443\t\n444\textern \"C\" int _logup_monomial_batched(\n445\t    FracExt *tmp_sums,\n446\t    FracExt *output,\n447\t    const BlockCtx *block_ctxs,\n448\t    const LogupMonomialCommonCtx *common_ctxs,\n449\t    const LogupMonomialCtx *numer_ctxs,\n450\t    const LogupMonomialCtx *denom_ctxs,\n451\t    const uint32_t *air_block_offsets,\n452\t    uint32_t num_blocks,\n453\t    uint32_t num_x,\n454\t    uint32_t num_airs,\n455\t    uint32_t threads_per_block\n456\t) {\n457\t    if (num_blocks == 0)\n458\t        return 0;\n459\t\n460\t    dim3 grid(num_blocks, num_x);\n461\t    dim3 block(threads_per_block);\n462\t    size_t shmem = div_ceil(threads_per_block, WARP_SIZE) * sizeof(FpExt);\n463\t\n464\t    // Phase 1: Evaluate numerator monomials\n465\t    logup_monomial_kernel<false><<<grid, block, shmem>>>(\n466\t        tmp_sums, block_ctxs, common_ctxs, numer_ctxs\n467\t    );\n468\t    int err = CHECK_KERNEL();\n469\t    if (err != 0)\n470\t        return err;\n471\t\n472\t    // Phase 1b: Evaluate denominator monomials\n473\t    logup_monomial_kernel<true><<<grid, block, shmem>>>(\n474\t        tmp_sums, block_ctxs, common_ctxs, denom_ctxs\n475\t    );\n476\t    err = CHECK_KERNEL();\n477\t    if (err != 0)\n478\t        return err;\n479\t\n480\t    // Phase 2: Batched reduction\n481\t    // FracExt = (FpExt, FpExt) so treat as 2 * num_x elements per AIR\n482\t    auto [_, reduce_block] = kernel_launch_params(num_blocks / num_airs + 1);\n483\t    unsigned int reduce_warps = (reduce_block.x + WARP_SIZE - 1) / WARP_SIZE;\n484\t    size_t reduce_shmem = std::max(1u, reduce_warps) * sizeof(FpExt);\n485\t\n486\t    dim3 reduce_grid(num_airs, 2 * num_x);\n487\t    sumcheck::batched_final_reduce_block_sums<<<reduce_grid, reduce_block, reduce_shmem>>>(\n488\t        reinterpret_cast<FpExt *>(tmp_sums),\n489\t        reinterpret_cast<FpExt *>(output),\n490\t        air_block_offsets,\n491\t        2 * num_x\n492\t    );\n493\t\n494\t    return CHECK_KERNEL();\n495\t}\n496\t\n497\t} // namespace logup_zerocheck_mle\n498\t"}]},"parent_tool_use_id":"toolu_01TBXL1cbLrEpWJbK7DkJuPK","session_id":"d96bd5ad-dc55-4cdf-ae15-7b7ce8dfed52","uuid":"e93428ee-c71f-45bc-b079-254f8083ef1e","timestamp":"2026-04-13T08:52:56.391Z"}
