      return launch_mle_interpolate_stage<Fp, true>(buffer, buffer_len, step);\n244\t    } else {\n245\t        return launch_mle_interpolate_stage<Fp, false>(buffer, buffer_len, step);\n246\t    }\n247\t}\n248\t\n249\textern \"C\" int _mle_interpolate_stage_ext(\n250\t    FpExt *buffer,\n251\t    size_t buffer_len,\n252\t    uint32_t step,\n253\t    bool is_eval_to_coeff\n254\t) {\n255\t    if (buffer_len < 2 || step == 0) {\n256\t        return 0;\n257\t    }\n258\t\n259\t    if (is_eval_to_coeff) {\n260\t        return launch_mle_interpolate_stage<FpExt, true>(buffer, buffer_len, step);\n261\t    } else {\n262\t        return launch_mle_interpolate_stage<FpExt, false>(buffer, buffer_len, step);\n263\t    }\n264\t}\n265\t\n266\ttemplate <typename Field, bool EvalToCoeff>\n267\tint launch_mle_interpolate_stage_2d(\n268\t    Field *buffer,\n269\t    uint16_t width,\n270\t    uint32_t height,\n271\t    uint32_t padded_height,\n272\t    uint32_t step\n273\t) {\n274\t    auto span = step * 2;\n275\t    auto [grid, block] = kernel_launch_params(height >> 1);\n276\t    grid.y = width;\n277\t    mle_interpolate_stage_2d_kernel<Field, EvalToCoeff>\n278\t        <<<grid, block>>>(buffer, padded_height, span, step);\n279\t    return CHECK_KERNEL();\n280\t}\n281\t\n282\textern \"C\" int _mle_interpolate_stage_2d(\n283\t    Fp *buffer,\n284\t    uint16_t width,\n285\t    uint32_t height,\n286\t    uint32_t padded_height,\n287\t    uint32_t step,\n288\t    bool is_eval_to_coeff\n289\t) {\n290\t    if (is_eval_to_coeff) {\n291\t        return launch_mle_interpolate_stage_2d<Fp, true>(\n292\t            buffer, width, height, padded_height, step\n293\t        );\n294\t    } else {\n295\t        return launch_mle_interpolate_stage_2d<Fp, false>(\n296\t            buffer, width, height, padded_height, step\n297\t        );\n298\t    }\n299\t}\n300\t\n301\t// Launcher for fused MLE interpolation that processes multiple stages via warp shuffle.\n302\t// num_stages: number of consecutive stages to fuse (1-5)\n303\t// start_step: the step for the first stage (must be power of 2, <= 16 / (1 << (num_stages-1)))\n304\t// log_stride: meaningful_count = padded_height >> log_stride\n305\t// RightPad: if true, physical index = tidx << log_stride; if false, physical index = tidx\n306\ttemplate <bool EvalToCoeff, int NumStages, bool RightPad>\n307\tint launch_mle_interpolate_fused_2d(\n308\t    Fp *buffer,\n309\t    uint16_t width,\n310\t    uint32_t padded_height,\n311\t    uint32_t log_stride,\n312\t    uint32_t start_step\n313\t) {\n314\t    uint32_t meaningful_count = padded_height >> log_stride;\n315\t    auto [grid, block] = kernel_launch_params(meaningful_count);\n316\t    grid.y = width;\n317\t    mle_interpolate_fused_2d_kernel<EvalToCoeff, NumStages, RightPad>\n318\t        <<<grid, block>>>(buffer, padded_height, log_stride, start_step);\n319\t    return CHECK_KERNEL();\n320\t}\n321\t\n322\t// Recursive template dispatch for num_stages (1-5)\n323\ttemplate <bool EvalToCoeff, bool RightPad, int N = LOG_WARP_SIZE>\n324\tint dispatch_mle_interpolate_fused_2d(\n325\t    Fp *buffer,\n326\t    uint16_t width,\n327\t    uint32_t padded_height,\n328\t    uint32_t log_stride,\n329\t    uint32_t start_step,\n330\t    uint32_t num_stages\n331\t) {\n332\t    if constexpr (N == 0) {\n333\t        return cudaErrorInvalidValue;\n334\t    } else {\n335\t        if (num_stages == N) {\n336\t            return launch_mle_interpolate_fused_2d<EvalToCoeff, N, RightPad>(\n337\t                buffer, width, padded_height, log_stride, start_step\n338\t            );\n339\t        }\n340\t        return dispatch_mle_interpolate_fused_2d<EvalToCoeff, RightPad, N - 1>(\n341\t            buffer, width, padded_height, log_stride, start_step, num_stages\n342\t        );\n343\t    }\n344\t}\n345\t\n346\textern \"C\" int _mle_interpolate_fused_2d(\n347\t    Fp *buffer,\n348\t    uint16_t width,\n349\t    uint32_t padded_height,\n350\t    uint32_t log_stride,\n351\t    uint32_t start_step,\n352\t    uint32_t num_stages,\n353\t    bool is_eval_to_coeff,\n354\t    bool right_pad\n355\t) {\n356\t    return DISPATCH_BOOL_PAIR(\n357\t        dispatch_mle_interpolate_fused_2d,\n358\t        is_eval_to_coeff,\n359\t        right_pad,\n360\t        buffer,\n361\t        width,\n362\t        padded_height,\n363\t        log_stride,\n364\t        start_step,\n365\t        num_stages\n366\t    );\n367\t}\n368\t\n369\t// Default tile log size for shared memory kernel.\n370\t// tile_size = 2^12 = 4096 elements = 16KB shared memory (for Fp = 4 bytes).\n371\t// This allows processing stages with log_step up to 11 (step up to 2048).\n372\t// Trade-off: larger tile = more stages fused, but lower occupancy.\n373\tconstexpr int MLE_SHARED_TILE_LOG_SIZE = 12;\n374\t\n375\ttemplate <bool EvalToCoeff, bool RightPad>\n376\tint launch_mle_interpolate_shared_2d(\n377\t    Fp *buffer,\n378\t    uint16_t width,\n379\t    uint32_t padded_height,\n380\t    uint32_t log_stride,\n381\t    uint32_t start_log_step,\n382\t    uint32_t end_log_step\n383\t) {\n384\t    constexpr uint32_t tile_size = 1 << MLE_SHARED_TILE_LOG_SIZE;\n385\t    constexpr uint32_t block_size = 256;\n386\t    // Add bank conflict padding: 1 extra element per 32 elements\n387\t    size_t smem_size = (tile_size + tile_size / 32) * sizeof(Fp);\n388\t\n389\t    uint32_t meaningful_count = padded_height >> log_stride;\n390\t    uint32_t num_tiles = (meaningful_count + tile_size - 1) / tile_size;\n391\t    dim3 grid(num_tiles, width);\n392\t\n393\t    mle_interpolate_shared_2d_kernel<EvalToCoeff, MLE_SHARED_TILE_LOG_SIZE, RightPad>\n394\t        <<<grid, block_size, smem_size>>>(\n395\t            buffer, padded_height, log_stride, start_log_step, end_log_step\n396\t        );\n397\t    return CHECK_KERNEL();\n398\t}\n399\t\n400\textern \"C\" int _mle_interpolate_shared_2d(\n401\t    Fp *buffer,\n402\t    uint16_t width,\n403\t    uint32_t padded_height,\n404\t    uint32_t log_stride,\n405\t    uint32_t start_log_step,\n406\t    uint32_t end_log_step,\n407\t    bool is_eval_to_coeff,\n408\t    bool right_pad\n409\t) {\n410\t    // Validate: end_log_step must be < MLE_SHARED_TILE_LOG_SIZE (step < tile_size)\n411\t    if (end_log_step >= MLE_SHARED_TILE_LOG_SIZE) {\n412\t        return cudaErrorInvalidValue;\n413\t    }\n414\t    return DISPATCH_BOOL_PAIR(\n415\t        launch_mle_interpolate_shared_2d,\n416\t        is_eval_to_coeff,\n417\t        right_pad,\n418\t        buffer,\n419\t        width,\n420\t        padded_height,\n421\t        log_stride,\n422\t        start_log_step,\n423\t        end_log_step\n424\t    );\n425\t}\n426\t"}]},"parent_tool_use_id":"toolu_01TBXL1cbLrEpWJbK7DkJuPK","session_id":"d96bd5ad-dc55-4cdf-ae15-7b7ce8dfed52","uuid":"bddbc66f-4868-4a7c-868a-be1a15e7d0ad","timestamp":"2026-04-13T08:52:49.701Z"}
